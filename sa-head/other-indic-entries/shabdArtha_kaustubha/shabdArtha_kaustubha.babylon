
#stripmethod=keep
#sametypesequence=h
#bookname=शब्दार्थकौस्तुभः shabdArtha-kaustubha (sa-kn)

अ
अ<br><br><b>कन्नडार्थः - </b>ಅ<br><b>विस्तारः - </b>ಇದು ವರ್ಣಮಾಲೆ (ಸಮಾಮ್ನಾಯ)ಯಲ್ಲಿ ಮೊದಲನೆಯ ಅಕ್ಷರ. ಉದಾತ್ತ, ಅನುದಾತ್ತ, ಮತ್ತು ಸ್ವರಿತಗಳೆಂಬ ಮೂರು ಭೇದಗಳುಳ್ಳ ಈ ಹ್ರಸ್ವಾಕಾರವು ಪುನಃ ಅನುನಾಸಿಕ ಮತ್ತು ಅನನು ನಾಸಿಕಗಳೆಂಬ ಭೇದದಿಂದ ಎರಡು ವಿಧವಾಗಿ ಒಟ್ಟು ಆರು ವಿಧವಾಗುವುದು.<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು / ವಾಸುದೇವ.<br><b>विस्तारः - </b>"अकारो वासुदेवः स्यात्" |<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚತುರ್ಮುಖ ಬ್ರಹ್ಮ.<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ / ಮಹಾದೇವ.<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಠ / ಆಮೆ.<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗಳ<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ / ಸಂಗ್ರಾಮ<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೌರವ / ಮರ್ಯಾದೆ<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತಃಪುರ / ರಾಣಿವಾಸ.<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೇತು / ಕಾರಣ<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಷಣ / ಒಡವೆ<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚರಣ / ಪಾದ / ಕಾಲು<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರ್ವತಿ / ಗೌರಿ<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗ / ಯಜ್ಞ<br><b>विस्तारः - </b>."अकारो ब्रह्मविष्णवीशकलठेय्वङ्गणे रणे । गौरवेऽन्तःपुरे हेतौ भूषणेऽङ् घ्रावुमज्ययः" || - नानार्थर ।<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಖ<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನ / ತಿಳಿವಳಿಕೆ<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಗೆ / ಶತ್ರು<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಿರಿ / ಬೆಟ್ಟ<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿ<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಕ್ಷ / ಮರ<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭ್ರಮರ / ದುಂಬಿ<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೃಗ / ಜಿಂಕೆ<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಿಂಹ<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರಾಹ / ಹಂದಿ<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರಡಿ<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತೆ ಕಿರುಬ / ಶಿವಂಗಿ<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೀಮೆಹಸು / ಕಾಡುಹಸು<br><b>विस्तारः - </b>"सुखज्ञानमुमारातिगिरभूमिद्रमलिषु । मृगसंहवराहर्क्षतरक्षुगदयेष्वपि" ||- मेदि० ।<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಕೃತ್ ಪ್ರತ್ಯಯ<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಾವ<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಷೇಧ<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಲ್ಪ / ಸ್ವಲ್ಪ<br><br>अ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಕಂಪ / ದಯೆ<br><b>विस्तारः - </b>“नव” ಸಂಬಂಧವಾದ “अ” ಕಾರವು ಆರು ವಿಧವಾದ ಅರ್ಥವನ್ನು ತಿಳಿಸುವುದೆ. 1. ಸಾದೃಶ್ಯ, 2. ಅಭಾವ. 3. ಅನ್ಯತ್ವ, ಭೇದ. 4. ಅಲ್ಪತ್ವ. 5. ಅಪ್ರಾಶಸ್ತ್ಯ ಮತ್ತು 6. ವಿರೋಧ. ಉದಾ: 1. अब्राह्मणः । 2. अपापम् । 3. अनश्वः । 4. अनुदरा कन्या । 5. अपशवः । ಮತ್ತು 6. अधर्मः । “तत्सादृश्यमभावश्च तदन्यत्वं तदल्पता । अप्राशस्त्यं विरोधश्च नञर्थाः षट् प्रकीर्तिताः । 1. "अः” स्वल्पार्थेऽप्यभावेऽपि” - हेम । 2. “अशब्दः स्यादभावेऽपि स्वल्पार्थप्रतिपेधयोः । अनुकम्पायां च तथा वासुदेवेत्वनव्ययः” | - मेदि ।<br><br>

अऋणिन्
अऋणिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಋಣವಿಲ್ಲದ / ಸಾಲವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न ऋणी |<br><b>प्रयोगाः - </b>“दिवसस्याष्टमे भागे शाकं पचति यो नरः । अऋणी चाप्रवासी च स रात्रिञ्चर मोदते” ||<br><b>उल्लेखाः - </b>भा० ।<br><b>विस्तारः - </b>[ऋ ಕಾರಕ್ಕೆ ವ್ಯಂಜನತ್ವವನ್ನು ಒಪ್ಪುವುದರಿಂದ ಇಲ್ಲಿ “नृट्” ಆಗಮವು ಬಂದಿರುವುದಿಲ್ಲ.]<br><br>

अंश
अंश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಭಾಗ / ಪಾಲು<br><b>निष्पत्तिः - </b>कर्म “घञ्” (३-३-१९) ।<br><b>व्युत्पत्तिः - </b>अंश्यते-अंश (विभाजने)<br><br>अंश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಸ್ತುವಿನ ಭಾಗ<br><b>प्रयोगाः - </b>“षष्ठांशवृतेरपि धर्म एषः” |<br><b>उल्लेखाः - </b>शाकुं ५-४ ।<br><b>विस्तारः - </b>“अंशो विभाजने प्रोक्त एकदेशेऽपि वस्तुनः” - हेम० ।<br><br>अंश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವಯವ / ಶರೀರದ ಒಂದು ಭಾಗ.<br><b>विस्तारः - </b>“अंशस्त्ववयवो भागं एकदेशः” - वैज० ।<br><br>

अंशक
अंशक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಭಾಗ / ಪಾಲು<br><b>निष्पत्तिः - </b>अंश “कन्” (५-३-७५) ।<br><br>अंशक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಾಯಾದ / ಪಾಲುದಾರ<br><b>निष्पत्तिः - </b>अंशहारी “कन्” (५-२-३९) ।<br><b>विस्तारः - </b>“अथांशकः । सगन्धज्ञातिदायादौ” ॥ - त्रिकाण्ड० ।<br><br>अंशक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಿನ / ದಿವಸ<br><b>विस्तारः - </b>वास्रो व्युष्टांशके दिनम्” ।- त्रिकाण्ड० ।<br><br>अंशक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಾಗಕೊಡತಕ್ಕವನು<br><b>निष्पत्तिः - </b>अंश (विभाजने) “ण्वुल्” (३-१-१३३) । स्त्रियां “टाप्” (४-१-४) ।<br><b>व्युत्पत्तिः - </b>अंशिका ।<br><br>

अंशयितृ
अंशयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>निष्पत्तिः - </b>अंश (विभाजने) + णिच् “तृव्” (३-१-१३३) । स्त्रियां “डीप्” (४-१-५) ।<br><b>व्युत्पत्तिः - </b>अंशयित्री ।<br><br>

अंशल
अंशल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಾಗದಾರ / ಪಾಲುದಾರ<br><b>निष्पत्तिः - </b>अंश लाति-ला (आदाने) “कः” (३-२-३) ।<br><br>अंशल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಲಶಾಲಿ<br><br>

अंशिन्
अंशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಾಗದಾರ / ಪಾಲುದಾರ<br><b>निष्पत्तिः - </b>अंश “इनिः” (५-२-११५) ।<br><b>व्युत्पत्तिः - </b>अंशोऽस्यास्ति ।<br><br>

अंशहर
अंशहर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಾಗದಾರ / ಪಾಲುದಾರ<br><b>निष्पत्तिः - </b>हृञ् (हरणे) “अच्” (३-२-१) ।<br><b>व्युत्पत्तिः - </b>अंशं हरति ।<br><br>

अंशावतार
अंशावतार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆಗಳ ಅಂಶದಿಂದ ಭೂಮಿಯಲ್ಲಿ ಮನುಷ್ಯಾದಿ ರೂಪದಿಂದ ಹುಟ್ಟುವುದು<br><b>व्युत्पत्तिः - </b>अंशस्य अवतारः ।<br><br>

अंशु
अंशु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಣ<br><br>अंशु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಭೆ / ರಶ್ಮಿ<br><b>निष्पत्तिः - </b>अंश (विभाजने) “कु.” (उ०१-३७) ।<br><b>व्युत्पत्तिः - </b>अंशयति ।<br><b>प्रयोगाः - </b>1. “उन्मूलितं तूलिकयेव चित्रं सूर्याशुभिर्भिन्नमिवारविन्दम्” । 2. “अजस्रमास्फालितवल्लकीगुणक्षतोज्ज्वलाङ्गुष्ठनडांशुभिन्नया” ।<br><b>उल्लेखाः - </b>1. कुमा० १-३२ । 2. माघ० १-९ ।<br><br>अंशु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಾರದ ಸೂಕ್ಷ್ಮವಾದ ಭಾಗ<br><br>अंशु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇಗ<br><br>अंशु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶ<br><br>अंशु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>विस्तारः - </b>“हृद्याशुरंशुरब्जारिरमृतांशुः कलानिधिः” - वैज० ।<br><br>अंशु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>विस्तारः - </b>“चण्डांशुरंशुमानंशुस्सहस्रांशुः सदागतिः” - वैज० ।<br><br>

अंशुक
अंशुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಣ<br><br>अंशुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಭೆ<br><b>निष्पत्तिः - </b>अंशु स्वार्थे “कः” ।<br><br>अंशुक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಸ್ತ್ರ<br><b>निष्पत्तिः - </b>काशृ (दीप्तौ) “डः” (३-२-१०१) ।<br><b>व्युत्पत्तिः - </b>अंशुभिः काशते |<br><b>प्रयोगाः - </b>१ “यत्रांशुकाक्षेपविलज्जितानां यदृच्छया किम्पुरुषाङ्गनानाम्” | २. “अंशुकं हृतवता तनुवाहुस्वस्तिका-पिहितमुग्धकुचाग्रा” |<br><b>उल्लेखाः - </b>१. कुमा० १-१४ । २. माघ० १०-४३ ।<br><b>विस्तारः - </b>1. “अंशुकं श्लक्ष्णवस्वे स्याद्वस्त्रमात्रोत्तरीययोः” - मेदि० ।<br><br>

अंशुधर
अंशुधर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>धरति-धृञ् (धारणे) “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अंशूनां धरः ।<br><br>अंशुधर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇಗವುಳ್ಳ<br><br>अंशुधर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿರಣವನ್ನು ಧರಿಸಿರುವ<br><br>

अंशुपट्ट
अंशुपट्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ದಾರದಿಂದ ತಯಾರಿಸಿದ ಪಟ್ಟೆ ವಸ್ತ್ರ / ರೇಷ್ಮೆ ವಸ್ತ್ರ.<br><b>व्युत्पत्तिः - </b>अंशुना युक्तं पट्टम् ।<br><br>

अंशुमत्
अंशुमत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>“मतुप्” (५-२-९४) ।<br><b>व्युत्पत्तिः - </b>अंशवोऽस्य सन्ति |<br><b>प्रयोगाः - </b>“अदिभिद्य निशाकृतं तमः प्रभया नांशुमताप्युदीयते” |<br><b>उल्लेखाः - </b>किरा० २-३६ ।<br><br>अंशुमत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಗರ ಚಕ್ರವರ್ತಿಯ ಮೊಮ್ಮಗ / ಅಸಮಂಜಸನ ಮಗ.<br><br>अंशुमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶವುಳ್ಳ / ಹೊಳೆಯುವ<br><br>

अंशुमती
अंशुमती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂರೆಲೆ ಹೊನ್ನೆ ಮರ<br><br>अंशुमती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಮುನಾ ನದಿ<br><br>

अंशुमत्फला
अंशुमत्फला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಳೆಗಿಡ<br><br>

अंशुमाला
अंशुमाला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಭಾವಳಿ / ಕಿರಣಗಳ ಮಾಲೆ<br><br>

अंशुमालिन्
अंशुमालिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>“इनिः” (५-२-११६) ।<br><b>व्युत्पत्तिः - </b>अंशवः मालेव, स्राऽस्यास्ति |<br><br>अंशुमालिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಲೆಯಂತಿರುವ ಕಿರಣಗಳುಳ್ಳ<br><b>निष्पत्तिः - </b>स्त्रियां “डीप्” (४-१-५) ।<br><b>व्युत्पत्तिः - </b>अंशुमालिनी |<br><br>

अंशुहस्त
अंशुहस्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>अंशुः हस्त इव यस्य ।<br><b>विस्तारः - </b>[ಸೂರ್ಯನು ಕಿರಣರೂಪವಾದ ತನ್ನ ಸಾವಿರ ಹಸ್ತಗಳಿಂದ ಭೂಮಿಯಿಂದ ನೀರನ್ನು ಎಳೆಯುವನು.]<br><br>

अंस
अंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಾಗ / ಅಂಶ / ಪಾಲು<br><b>निष्पत्तिः - </b>अंस (समाघाते) कर्म० “घञ्” (३-३-१९) ।<br><b>व्युत्पत्तिः - </b>अंस्यते समाहन्यते भारादिना |<br><b>प्रयोगाः - </b>“अंसलम्बिभिरंसलः” ।<br><b>उल्लेखाः - </b>याद० १६-५१ ।<br><br>अंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಕಂಧ / ಹೆಗಲು<br><br>

अंसकूट
अंसकूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತಿನ ಹಿರಳು<br><b>व्युत्पत्तिः - </b>अंसः कूट इव ।<br><br>अंसकूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಗಲು<br><b>प्रयोगाः - </b>“राजन्योच्चांसकूटक्रयनपटुरटद्बोरधारः कुठारः” |<br><b>उल्लेखाः - </b>प्रबोध० १-७ ।<br><br>

अंसत्र
अंसत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ ಕವಚ<br><b>निष्पत्तिः - </b>“ष्ठन्” (४-४-१६) । स्त्रियां “डीष्” (४-१-४१) ।<br><b>व्युत्पत्तिः - </b>अंसभारेण हरति | अंसभारिकी |<br><br>

अंसल
अंसल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಲಶಾಲಿ / ಶಕ್ತಿವಂತ<br><b>प्रयोगाः - </b>“अंसलम्बिभिरंसलः” |<br><b>उल्लेखाः - </b>याद० १६-५१ ।<br><br>

अंस्य
अंस्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಗಲಿನಲ್ಲಿರುವ / ಹೆಗಲಿನಲ್ಲಿ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>“यत्” (४-३-५५) ।<br><b>व्युत्पत्तिः - </b>अंसे भवः |<br><br>अंस्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಭಾಗಿಸಲ್ಪಡುವ / ಭಾಗಮಾಡಲ್ಪಡತಕ್ಕ<br><b>निष्पत्तिः - </b>अंस (समाघाते) कर्म० “यत्” (३-१-९७) ।<br><br>

अंहति
अंहति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಾನ / ಪಾಪ ನಿವಾರಣೆಗಾಗಿ ಮಾಡುವ ದಾನ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) “अतिः” अंहदेशश्च (उ० ४-६२) ।<br><b>व्युत्पत्तिः - </b>हन्ति दुरितमनया |<br><br>अंहति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗ / ವ್ಯಾಧಿ<br><b>विस्तारः - </b>“अंहतिस्त्यागरोगयोः” |- हेम० ।<br><br>

अंहस्
अंहस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ.<br><b>निष्पत्तिः - </b>अहि (गतौ) “असुन्” (उ० ४-१८८) ।<br><b>व्युत्पत्तिः - </b>अंहते गच्छति दानादिना |<br><br>अंहस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಂದರೆ / ಆಯಾಸ<br><b>प्रयोगाः - </b>1. “सहसा संहितमंहसां विहन्तुम्” | 2. “कृतः कृतार्थोऽस्मि निवहितांहंसा” |<br><b>उल्लेखाः - </b>1. किरा० ५-१७ । 2. माघ० १-२९ ।<br><br>

अंहस्वत्
अंहस्वत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪಿಷ್ಠ<br><b>निष्पत्तिः - </b>अंहोऽस्यास्ति “मतुप्” (५-२-९४) ।<br><b>व्युत्पत्तिः - </b>अंहोऽस्यास्ति |<br><br>

अंहिति
अंहिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಾನ<br><b>निष्पत्तिः - </b>अहि (गतौ) “क्तिन्” (३-३-९४) |<br><br>

अंह्रि
अंह्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾದ / ಕಾಲು.<br><b>निष्पत्तिः - </b>अहि (गतौ) “क्तिन्” (उ० ४-६६) |<br><b>व्युत्पत्तिः - </b>अंहते गच्छत्यनेन |<br><br>अंह्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರದ ಬೇರು<br><br>अंह्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಲ್ಕು ಸಂಖ್ಯೆ<br><br>

अंह्रिप
अंह्रिप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಕ್ಷ / ಮರ<br><b>निष्पत्तिः - </b>पा (पाने) “कः” (३-२-४) ।<br><b>व्युत्पत्तिः - </b>अंह्रिण मूलेन पिबति |<br><br>

अंह्रिस्कन्ध
अंह्रिस्कन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗಾಲಿನ ಮೇಲು ಭಾಗ<br><b>व्युत्पत्तिः - </b>अह्रेः स्कन्ध इव ।<br><br>

अक
अक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದುಃಖ<br><b>व्युत्पत्तिः - </b>न कं सुखम् ।<br><br>अक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><b>व्युत्पत्तिः - </b>न कंसुखं यस्मात् ।<br><br>अक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪವಿಲ್ಲದ<br><br>अक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುಃಖವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न कं यस्य ।<br><b>विस्तारः - </b>“अकं पापदुःखयोः” । - मेदि० ।<br><br>

अकम्पन
अकम्पन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಕ್ಷಸ<br><br>अकम्पन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಕವಿಲ್ಲದ / ಚಲಿಸದಿರುವ<br><br>

अकम्पित
अकम्पित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಬೌದ್ಧ ಬಿಕ್ಷು<br><br>अकम्पित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ತಚಾಂಚಲ್ಯವಿಲ್ಲದ, / ಸ್ಥಿರಮನಸ್ಸುಳ್ಳ<br><br>अकम्पित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಕವಿಲ್ಲದಿರುವ / ಚಲನೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न कम्पितं यस्य ।<br><br>

अकर
अकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಸ್ತವಿಲ್ಲದ / ಕೈಯಿಲ್ಲದ<br><br>अकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪ್ಪವಿಲ್ಲದ / ತೆರಿಗೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति करो यस्य ।<br><br>अकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯವಿಲ್ಲದ / ಕೆಲಸ ಮಾಡದಿರುವ<br><b>निष्पत्तिः - </b>करोति-कुञ् अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>न करः । स्त्रियाम् -अकरा ।<br><br>

अकरण
अकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>क्रियते- डु कृञ् (करणे) “त्युट्” (३-३-११५) ।<br><b>व्युत्पत्तिः - </b>न कारणम् ।<br><br>

अकरणि
अकरणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>निष्पत्तिः - </b>न + डु कृञ् (करणे) “अनिः” (३-३-११२) ।<br><br>

अकरुण
अकरुण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯೆಯಿಲ್ಲದ / ಕನಿಕರವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति करुणा यस्य ।<br><br>

अकर्ण
अकर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ / ಹಾವು<br><br>अकर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿವಿಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न विद्येते कर्णौ यस्य ।<br><br>अकर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರ್ಣನಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न कर्णः यत्र ।<br><b>प्रयोगाः - </b>“अनर्जुनमकर्णं वा जगदद्येति निश्चितम्” ।<br><b>उल्लेखाः - </b>भा० ।<br><br>

अकर्ण्य
अकर्ण्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿವಿಗೆ ಯೋಗ್ಯವಲ್ಲದ<br><br>अकर्ण्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿವಿಯಲ್ಲಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न कर्ण्यम् ।<br><br>

अकर्तन
अकर्तन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬ್ಜ / ವಾಮನ / ಕುಳ್ಳ<br><br>अकर्तन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸದಿರುವ<br><b>निष्पत्तिः - </b>कृतो (छदने) भावे “स्युट्” (३-३-११५) ।<br><b>व्युत्पत्तिः - </b>न कर्तनं यस्य ।<br><br>

अकर्तृ
अकर्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡದಿರುವವನು / ಅಸ್ವತಂತ್ರ / ಅಡಿಯಾಳು.<br><b>व्युत्पत्तिः - </b>न कर्ता ।<br><br>

अकर्तृत्व
अकर्तृत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸ್ವತಂತ್ರತೆ / ಪರಾಧೀನತೆ<br><br>

अकर्मक
अकर्मक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರ್ಮಪದವಿಲ್ಲದ ಧಾತು<br><b>निष्पत्तिः - </b>“कप्” ।<br><b>व्युत्पत्तिः - </b>नास्ति कर्म यस्य । [फलव्यापारयोरेकनिष्ठत्वे धातोरकर्मकत्वम् । स्त्रियाम् अकर्मिका]<br><b>विस्तारः - </b>ಧಾತುಗಳಲ್ಲಿ ಕೆಲವಕ್ಕೆ ಕರ್ಮಪದವಿರುವುದಿಲ್ಲ. ಕೆಲವಕ್ಕೆ ಕರ್ಮಪದದ ವಿವಕ್ಷೆಯಿರುವುದಿಲ್ಲ. <br>ಮೊದಲನೆಯದು ಕೇವಲ ಅಕರ್ಮಕವೆಂದೂ ಧಾತ್ವರ್ಥಸಂಗೃಹೀತವಾದ ಕರ್ಮವುಳ್ಳದ್ದೆಂದೂ ಎರಡು ವಿಧ. <br>ಉದಾ: (1) ಅಕರ್ಮಕ आस्ते, शेते ಇತ್ಯಾದಿ.<br>(2) ಧಾತ್ವರ್ಥಸಂಗೃಹೀತಕರ್ಮವುಳ್ಳದ್ದು जीवति-प्राणं धारयति, नृत्यति-गात्रं विक्षिपति ಇತ್ಯಾದಿ. ಇಲ್ಲಿ जीव ಧಾತುವಿನಲ್ಲಿ ಪ್ರಾಣರೂಪವಾದ ಅರ್ಥವೂ नृती ಧಾತುವಿನಲ್ಲಿ ಗಾತ್ರವಿಕ್ಷೇಪಣ ರೂಪವಾದ ಅರ್ಥವೂ ಸಂಗೃಹೀತವಾಗಿದೆ. <br>ಕೆಲವು ಧಾತುಗಳು ಸಕರ್ಮಕವಾದರೂ ಬೇರೆ ಬೇರೆ ಅರ್ಥಗಳಲ್ಲಿ ಅಕರ್ಮಕವಾಗುವುವು.<br>ಉದಾ: वहति भारम् । नदी वहति । ಇಲ್ಲಿ ಮೊದಲನೆಯ वह ಧಾತುವು ಸಕರ್ಮಕ. ಎರಡನೆಯದು ಅಕರ್ಮಕ. “हिताव्र यः संशृणुते स किम्प्रभुः” ಇತ್ಯಾದಿ ಸ್ಥಳಗಳಲ್ಲಿ ಕರ್ಮಪದದ ವಿವಕ್ಷೆಯಿಲ್ಲದಿರುವುದರಿಂದ शृणु ಧಾತುವು ಸಕರ್ಮಕವಾದರೂ ಅಕರ್ಮಕವಾಗಿರುವುದು. प्रसिद्धेरविवक्षातः कर्मणोऽकर्मिका क्रिया” सि० कौ० ।<br><br>

अकर्मण्य
अकर्मण्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸಕ್ಕೆ ಅರ್ಹನಲ್ಲದ<br><b>निष्पत्तिः - </b>“यत्” (४-४-९८) ।<br><b>व्युत्पत्तिः - </b>न कर्मणि साधुः ।<br><br>

अकर्मन्
अकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न कर्म ।<br><b>प्रयोगाः - </b>“अकर्मणश्च बोद्धव्यं गहना कर्मणो गतिः” ।<br><b>उल्लेखाः - </b>गीता ४-१७ ।<br><br>अकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಕಾರ್ಯ<br><br>अकर्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸವಿಲ್ಲದ / ಸೋಮಾರಿಯಾದ<br><br>अकर्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರ್ತವ್ಯವನ್ನು ಮಾಡಲು ಯೋಗ್ಯತೆಯಿಲ್ಲದ<br><br>अकर्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರ್ಮಪದವಿಲ್ಲದ (ಧಾತು)<br><br>

अकर्मकृत्
अकर्मकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡದಿರುವ<br><b>निष्पत्तिः - </b>डु कृञ् (करणे) “क्विप्” (३-२-७६) ।<br><b>व्युत्पत्तिः - </b>न कर्म करोति ।<br><br>अकर्मकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಕಾರ್ಯವನ್ನು ಮಾಡುವ<br><b>निष्पत्तिः - </b>कृञ् “क्विप्” (३-२-७६) ।<br><b>व्युत्पत्तिः - </b>अकर्म करोति ।<br><br>

अकर्मशील
अकर्मशील<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೋಮಾರಿ / ಆಲಸ<br><br>

अकल
अकल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>नास्ति कला अवयवो यस्य ।<br><br>अकल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚತುಃಷಷ್ಟಿ ಕಲಾಶೂನ್ಯ<br><br>अकल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಯವಗಳಿಲ್ಲದ<br><br>

अकलुष
अकलुष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪವಿಲ್ಲದ<br><br>अकलुष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಚ್ಛವಾದ / ನಿರ್ಮಲವಾದ<br><br>अकलुष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಳೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न कलुषं यस्य ।<br><br>

अकल्क
अकल्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಚ್ಛವಾದ / ಗಸಿಯಿಲ್ಲದ<br><br>अकल्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪವಿಲ್ಲದ<br><br>अकल्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಹಂಕಾರವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न कल्को यस्य ।<br><br>

अकल्कता
अकल्कता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಯಸಂಧತೆ / ಪ್ರಾಮಾಣಿಕತೆ<br><br>

अकल्कन
अकल्कन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗರ್ವವಿಲ್ಲದ / ಅಹಂಕಾರವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति कल्कनं दम्भो यस्य ।<br><br>अकल्कन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೋಸವಿಲ್ಲದ / ಪ್ರಾಮಾಣಿಕ<br><br>

अकल्का
अकल्का<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರಿಕೆ / ಬೆಳದಿಂಗಳು<br><b>व्युत्पत्तिः - </b>न कल्को मलं यस्याः ।<br><br>

अकल्प
अकल्प<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಮವಿಲ್ಲದ<br><br>अकल्प<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಯಮಕ್ಕೆ ವಿಷಯವಲ್ಲದ<br><br>अकल्प<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸದೃಶವಾದ / ಹೋಲಿಕೆಯಿಲ್ಲದ<br><br>अकल्प<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನ್ಯಾಯವಲ್ಲದ<br><b>विस्तारः - </b>“कल्पः शास्त्रे विधौ न्याये” । - शाश्व० ।<br><br>

अकल्पित
अकल्पित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಸರ್ಗವಾದ / ಸ್ವಾಭಾವಿಕ / ಅಕೃತ್ರಿಮ<br><b>प्रयोगाः - </b>“अकल्पितप्रश्निकमन्ववैक्षत” ।<br><b>उल्लेखाः - </b>याद० १४-१० ।<br><br>

अकल्य
अकल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸ್ವಸ್ಥ / ಆರೋಗ್ಯವಿಲ್ಲದ<br><b>निष्पत्तिः - </b>कलासु साधुः “यत्” (४-४-९८) ।<br><b>व्युत्पत्तिः - </b>न कल्यः ।<br><br>अकल्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಯ / ನಿಜ<br><b>निष्पत्तिः - </b>कल्यते-कल (सङ्ख्याने) “यत्” ।<br><b>व्युत्पत्तिः - </b>कल्यं मिथ्याभूतं – न कल्यम् ।<br><b>प्रयोगाः - </b>“अनीनयदक्ल्यसन्धो बन्धनागारम्” ।<br><b>उल्लेखाः - </b>दशकु० ।<br><br>

अकल्याण
अकल्याण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅದೃಷ್ಟಹೀನ / ನಿರ್ಭಾಗ್ಯ<br><br>अकल्याण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಾರೋಗ್ಯ<br><br>अकल्याण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದುಃಖ / ಕಷ್ಟ<br><br>

अकस्मात्
अकस्मात्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹಠಾತ್ತಾಗಿ / ಅನಿರೀಕ್ಷಿತವಾಗಿ<br><b>व्युत्पत्तिः - </b>न कस्मात् किञ्चित्कारणाधीनत्वं यत्र ।<br><b>प्रयोगाः - </b>“अकस्मादागन्तुना सह विश्वासो न कर्तव्यः” ।<br><b>उल्लेखाः - </b>हितो० ।<br><br>अकस्मात्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕಾರಣವಿಲ್ಲದೆ<br><b>प्रयोगाः - </b>नाकस्मात् शाण्डली माता विक्रीणाति तिलैस्तिलान्” ।<br><b>उल्लेखाः - </b>पञ्चत० ।<br><br>

अकाण्ड
अकाण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೆಂಬೆಯಿಲ್ಲದ ಮರ<br><br>अकाण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನವಸರ / ಅಸಮಯ / ಅಕಾಲ<br><b>प्रयोगाः - </b>“अकाण्डे प्रथनं छेदश्च रसदोषो” ।<br><b>उल्लेखाः - </b>सा० द० ।<br><b>विस्तारः - </b>(1) ಅಕಾಲದಲ್ಲಿ ಪ್ರಥನ: ವೇಣೀಸಂಹಾರದ ಎರಡನೇ ಅಂಕದಲ್ಲಿ ಅನೇಕ ರಾಜರು ಯುದ್ಧದಲ್ಲಿ ನಾಶವಾಗುತ್ತಿರುವಾಗ ಭಾನುಮತಿಯೊಡನೆ ದುರ್ಯೋಧನನ ಶೃಂಗಾರವರ್ಣನೆ.<br>(2) ಅಕಾಲದಲ್ಲಿ ಭೇದ: ಮಹಾವೀರಚರಿತದಲ್ಲಿ ಶ್ರೀರಾಮ ಮತ್ತು ಪರಶುರಾಮರಿಗೆ ಯುದ್ಧ ನಡೆದು ವೀರರಸವು ಉದಯಿಸಿರುವಾಗ ಶ್ರೀರಾಮನನ್ನು ವೈವಾಹಿಕ ಕಂಕಣ ವಿಸರ್ಜನೆಗಾಗಿ ಕಳುಹಿಸುವುದು. [ಯುದ್ಧಸಮಯದಲ್ಲಿ ಕಂಕಣವಿಸರ್ಜನೆಯ ಪ್ರಸ್ತಾವವು, ಶ್ರೀರಾಮನು ಆ ವ್ಯಾಜದಿಂದ ಹೆದರಿ ಓಡಿ ಹೋಗುವನೆಂಬ ಅರ್ಥಕೊಡುವುದರಿಂದ ಶ್ರೀರಾಮನಲ್ಲಿ ಅದೈರ್ಯವನ್ನು ಹೇಳಿದಂತಾಗುವುದು.]<br><br>अकाण्ड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಿರೀಕ್ಷಿತವಾದ / ಅನವಸರವಾದ / ಸಮಯವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति काण्डं अवसरः यस्य ।<br><b>प्रयोगाः - </b>“पुनरकाण्डविवर्तनदारुणः” ।<br><br>

अकाण्डे
अकाण्डे<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನಿರೀಕ್ಷಿತವಾಗಿ / ಕಾರಣವಿಲ್ಲದೆ<br><b>प्रयोगाः - </b>“दर्भाङ्कुरेण चरणः क्षत इत्यकाण्डे” ।<br><b>उल्लेखाः - </b>शाकु० २-१२ ।<br><br>

अकाम
अकाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆಯಿಲ್ಲದ / ಇಚ್ಛೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति कामोऽभिलाषो यस्य ।<br><br>अकाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿಯಿಲ್ಲದ<br><br>अकाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟವಲ್ಲದ / ಸಮ್ಮತವಲ್ಲದ<br><br>अकाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿವಳಿಕೆಯಿಲ್ಲದ / ಪ್ರಾಮಾದಿಕವಾದ<br><b>प्रयोगाः - </b>“अकामोपनतेनैव साधोर्हृदयमेनसा” ।<br><b>उल्लेखाः - </b>रघु० १०-३९ ।<br><br>

अकामतस्
अकामतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟವಿಲ್ಲದೆ / ಮನಸ್ಸಿಲ್ಲದೆ<br><br>अकामतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅರಿವಿಲ್ಲದೆ / ತಿಳಿವಳಿಕೆಯಿಲ್ಲದೆ<br><b>निष्पत्तिः - </b>अकाम “तसिल्” (५-३-७) ।<br><b>प्रयोगाः - </b>अकामतः कृतं पापं वेदाभ्यासेन शुध्यति” ।<br><b>उल्लेखाः - </b>मनु० ११-४६ ।<br><br>

अकाय
अकाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಹು<br><br>अकाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>नास्ति कायो यस्य ।<br><br>अकाय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶರೀರವಲ್ಲದ<br><br>

अकार
अकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>“ಅ” ವರ್ಣ / ವರ್ಣಮಾಲೆಯ ಮೊದಲನೆಯ ಅಕ್ಷರ.<br><b>विस्तारः - </b>[ವಿವರಕ್ಕೆ अ ಮತ್ತು आ ಪದಗಳಲ್ಲಿ ನೋಡಿ.]<br><br>अकार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡದಿರುವ<br><b>व्युत्पत्तिः - </b>कारः क्रिया । नास्ति कारो यस्य ।<br><br>

अकारण
अकारण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರಣವಿಲ್ಲದ<br><br>अकारण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ದೇಶ್ಯವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति कारणं यस्य ।<br><b>प्रयोगाः - </b>“ततोऽकाअणवैरी नः कारणादपरे परे” ।<br><b>उल्लेखाः - </b>नैष० ।<br><br>अकारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರಣವಿಲ್ಲದಿರುವಿಕೆ<br><br>अकारण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರಣವಿಲ್ಲದೆ<br><b>प्रयोगाः - </b>“किमकाअणमेव दर्शनं विलपन्त्यै रतये न दीयते” ।<br><b>उल्लेखाः - </b>कुमा० ४-७ ।<br><br>

अकार्य
अकार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಕೆಲಸ<br><br>अकार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಷಿದ್ಧವಾದ ಕೆಲಸ<br><b>प्रयोगाः - </b>1. “किमकार्य कदर्याणाम्” | 2. “मा नाम वैकल्व्यादकार्य कुर्यात्” |<br><b>उल्लेखाः - </b>1. हितो० । 2. मृच्छक० ।<br><br>

अकाल
अकाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಷಿದ್ಧ ಕಾಲ<br><br>अकाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಮಯ / ಅನುಚಿತ ಕಾಲ.<br><b>प्रयोगाः - </b>“अकाले बोधितो भ्रात्रा” |<br><b>उल्लेखाः - </b>रघु० १२-८१ |<br><br>अकाल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಲೋಚಿತವಲ್ಲದ / ಅಸಮಯದಲ್ಲಿ ಸಂಭವಿಸಿದ<br><b>प्रयोगाः - </b>“न ह्यकालभवो मृत्युरिक्ष्वाकुपदमस्पृशत्” |<br><b>उल्लेखाः - </b>रघु० १५-४४ ।<br><br>अकाल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪ್ಪಲ್ಲದ / ಬಿಳುಪಾದ<br><b>व्युत्पत्तिः - </b>न कालः ।<br><br>

अकिञ्चन
अकिञ्चन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದರಿದ್ರ / ಬಡವ<br><b>व्युत्पत्तिः - </b>नास्ति किञ्चन यस्य ।<br><b>प्रयोगाः - </b>“अकिञ्चनः सन् प्रभवः स सम्पदाम्” |<br><b>उल्लेखाः - </b>कुमा० ५-७७ ।<br><br>

अकिञ्चनता
अकिञ्चनता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂನ್ಯಾಸಕ್ಕೆ ಬೇಕಾದ ಸರ್ವದ್ರವ್ಯಪರಿತ್ಯಾಗ<br><b>प्रयोगाः - </b>“व्रतं दानं परिव्रज्या तपस्या नियमस्थितिः । अहिंसाऽसूयतास्तेयब्रह्माकिञ्चनता यमः” ।<br><br>अकिञ्चनता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಾರಿದ್ರ್ಯ<br><br>

अकिञ्चनत्व
अकिञ्चनत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ವದ್ರವ್ಯ ಪರಿತ್ಯಾಗ<br><br>अकिञ्चनत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಾರಿದ್ರ್ಯ / ನಿರ್ಧನತ್ವ / ಬಡತನ<br><b>प्रयोगाः - </b>“स्थाने भवानेकनराधिपः सन्नकिञ्चनत्वं मखजं व्यनक्ति” |<br><b>उल्लेखाः - </b>रघु० ५-१६ ।<br><br>

अकिञ्चिनिमन्
अकिञ्चिनिमन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಾರಿದ್ರ್ಯ / ಬಡತನ<br><b>निष्पत्तिः - </b>अकिञ्चन् “इमनिच्” (५-१-१२२) ।<br><br>

अकिञ्चिज्ज्ञ
अकिञ्चिज्ज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏನೂ ತಿಳಿಯದ / ಅರಿವಿಲ್ಲದ<br><b>निष्पत्तिः - </b>ज्ञा (अवबोधने) “कः” (३-२-३) ।<br><b>व्युत्पत्तिः - </b>न किञ्चित् जानाति |<br><br>

अकिञ्चित्कर
अकिञ्चित्कर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯೋಜನವಿಲ್ಲದ / ಕೆಲಸಮಾಡಲು ಸಾಮರ್ಥ್ಯವಿಲ್ಲದ<br><br>अकिञ्चित्कर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವ ಕಾರ್ಯವನ್ನೂ ಮಾಡದಿರುವ<br><b>निष्पत्तिः - </b>डु कृञ् (करणे) “अच्” (३-११३४) ।<br><b>व्युत्पत्तिः - </b>न किञ्चित् करोति |<br><br>

अकीर्ति
अकीर्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಯಶಸ್ಸು / ಕಳಂಕ / ಅಪಖ್ಯಾತಿ<br><br>

अकुण्ठ
अकुण्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಯಿಲ್ಲದ / ಪ್ರತಿಬಂಧಕವಿಲ್ಲದ<br><br>अकुण्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸದಲ್ಲಿ ಸಮರ್ಥವಾದ<br><b>व्युत्पत्तिः - </b>नास्ति कुण्ठा यस्य ।<br><br>अकुण्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಿತವಾದ / ಹದವಾದ<br><b>प्रयोगाः - </b>आशस्त्रग्रहणादकुण्ठपरशोह्” |<br><b>उल्लेखाः - </b>वेणी० २-२ ।<br><br>

अकुण्ठित
अकुण्ठित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಯಿಲ್ಲದ<br><br>अकुण्ठित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚುರುಕಾದ / ತೀಕ್ಷ್ಣವಾದ<br><b>प्रयोगाः - </b>“शास्त्रेष्वकुण्ठिता बुद्धिर्मैर्वी धनुषि चातता” |<br><b>उल्लेखाः - </b>रघु० १-१९ ।<br><br>

अकुतोभय
अकुतोभय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾರಿಂದಲೂ ಯಾವ ಕಡೆಯಿಂದಲೂ ಭಯವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति कुतोऽपि भयं यस्य ।<br><br>अकुतोभय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಾಯರಹಿತವಾದ<br><b>प्रयोगाः - </b>“मादुशानामपि अकृतोभयः सञ्चारो जातः” |<br><b>उल्लेखाः - </b>उ० रा० २ ।<br><br>

अकुप्य
अकुप्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿನ್ನ<br><br>अकुप्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಳ್ಳಿ<br><b>व्युत्पत्तिः - </b>कुप्यादन्यत् ।<br><b>प्रयोगाः - </b>“कुख्नकुप्यं वसु वासवोपमः” |<br><b>उल्लेखाः - </b>किरा० १-३५ ।<br><br>

अकूपार
अकूपार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ<br><b>निष्पत्तिः - </b>पृ (पालनपूरणयोः) “अण्” (३-२-१) । दीर्घः (६-३-१३७) ।<br><b>व्युत्पत्तिः - </b>न कुं पृथ्वीं पिबति |<br><br>अकूपार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೊಡ್ಡ ಆಮೆ<br><b>विस्तारः - </b>“अकूपारः कूर्मराजसमुद्रयोः” । - हेम० ।<br><br>अकूपार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>

अकृच्छ्र
अकृच्छ्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಷ್ಟವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न कृच्छ्रम् ।<br><br>

अकृत
अकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಲ್ಪಡದಿರುವ<br><b>निष्पत्तिः - </b>डु कृञ् (करणे) कर्म० “क्तः” (३-२-१०२) ।<br><b>व्युत्पत्तिः - </b>न कृतम् ।<br><b>प्रयोगाः - </b>“अकृतस्वसद्मगमनादरः क्षणम्” ।<br><b>उल्लेखाः - </b>माड० १३-४७ ।<br><br>अकृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿವೃತ್ತಿ / ಕೆಲಸದ ಅಭಾವ<br><b>निष्पत्तिः - </b>कृञ् भावे “क्तः” (३-३-११४) ।<br><br>

अकृतज्ञ
अकृतज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಕೃತಜ್ಞ / ಮಾಡಿದ ಉಪಕಾರವನ್ನು ನೆನೆಯದವನು<br><b>निष्पत्तिः - </b>ज्ञा (अवबोधने) “कः” (३-२-३) ।<br><b>व्युत्पत्तिः - </b>न कृतं जानाति |<br><br>

अकृतिन्
अकृतिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದಲ್ಲಿ ಅಸಮರ್ಥ<br><b>व्युत्पत्तिः - </b>न कृती ।<br><br>

अकृत्य
अकृत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಕೆಲಸ / ಅಯೋಗ್ಯ ಕೆಲಸ.<br><b>प्रयोगाः - </b>“अकृत्यमपि कुर्वाणो भुञ्जानो वा यतस्ततः” ।<br><br>अकृत्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न कृत्यं यस्य ।<br><br>

अकृत्रिम
अकृत्रिम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಸರ್ಗವಾದ / ಸ್ವಾಭಾವಿಕ / ಸಹಜ<br><b>व्युत्पत्तिः - </b>क्रियया निर्वृत्तम् । न कृत्रिमम् ।<br><b>प्रयोगाः - </b>“अकृत्रिमप्रेमरसाभिरामम्” |<br><b>उल्लेखाः - </b>किरा० ३-३७ ।<br><br>

अकृश
अकृश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಪ್ಪವಾದ<br><br>अकृश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಲಶಾಲಿಯಾದ<br><br>अकृश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣ / ತುಂಬಿದ<br><b>व्युत्पत्तिः - </b>न कृशः ।<br><b>प्रयोगाः - </b>“अकृशं कुचयोः कृशं विलग्ने” |<br><b>उल्लेखाः - </b>कुव० ।<br><br>

अकृष्ट
अकृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಳಲ್ಪಡದೆ ಇರುವ<br><br>अकृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯಲ್ಪಡದಿರುವ<br><b>व्युत्पत्तिः - </b>न कष्टम् ।<br><br>

अकृष्टपच्य
अकृष्टपच्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಳಲ್ಪಡದ ಭೂಮಿಯಲ್ಲಿ ಬೆಳೆದ<br><b>निष्पत्तिः - </b>डु पचषु (पाके) “ब—प्” (३-१-११४) ।<br><b>व्युत्पत्तिः - </b>अकृष्टे क्षेत्रे पच्यन्ते |<br><b>प्रयोगाः - </b>अकुष्टपच्या इव सस्यसम्पदः” |<br><b>उल्लेखाः - </b>किरा० १-१७ ।<br><br>

अकृष्ण
अकृष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><br>अकृष्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶುಭ್ರವಾದ / ಬಿಳುಪಾದ<br><b>व्युत्पत्तिः - </b>न कृष्णः ।<br><br>

अकृष्णकर्मन्
अकृष्णकर्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳ್ಳೆಯ ಕಾರ್ಯವುಳ್ಳ / ಸದಾಚಾರಸಂಪನ್ನನಾದ<br><b>व्युत्पत्तिः - </b>न कृष्णं कर्म यस्य ।<br><br>

अकोट
अकोट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಡಕೆ ಮರ<br><br>

अक्का
अक्का<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಯಿ<br><br>

अक्त
अक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲೇಪನಮಾಡಲ್ಪಟ್ಟ / ಬಳಿಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अञ्जू (व्य----यादौ) “क्तः” (उ० ३-८९) ।<br><b>व्युत्पत्तिः - </b>अज्यते |<br><br>

अक्त्र
अक्त्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕವಚ<br><b>निष्पत्तिः - </b>अञ्जू “ष्टन्” (उ० ४-१५८) |<br><br>

अक्रम
अक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಮವಿಲ್ಲದಿರುವಿಕೆ.<br><b>विस्तारः - </b>ಇದೊಂದು ಕಾವ್ಯದೋಷ-ವಿವಕ್ಷಿತಾರ್ಥವನ್ನು ಕೊಡುವ ಪದವನ್ನು ಆಯಾಸ್ಥಾನದಲ್ಲಿ ಹೇಳದೆ ಬೇರೆ ಸ್ಥಾನದಲ್ಲಿ ಹೇಳುವುದು ಅಕ್ರಮವೆನಿಸುವುದು. ಇದರಿಂದ ಜಾಗ್ರತೆಯಾಗಿ ವಿವಕ್ಷಿತಾರ್ಥಬೋಧವಾಗುವುದಿಲ್ಲ. “कला च सा त्वं च” ಎಂದು ಹೇಳುವುದಕ್ಕೆ ಬದಲಾಗಿ “कला च सा त्वमस्य लोकस्य च नेत्रकोमुदी” ಎಂದು “च” ಪದವನ್ನು ದೂರದಲ್ಲಿ ಹೇಳಿರುವುದರಿಂದ ಅಕ್ರಮವೆಂಬ ಕಾವ್ಯದೋಷದಿಂದ ಕೂಡಿರುವುದು.<br><br>अक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಲನವಿಲ್ಲದಿರುವಿಕೆ<br><br>अक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ರಮಣವಿಲ್ಲದಿರುವಿಕೆ<br><br>अक्रम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ರಮರಹಿತ<br><br>अक्रम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಲನವಿಲ್ಲದ<br><br>अक्रम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಣವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति क्रमः परिपाटीपादः क्रमणं वा यस्य ।<br><br>

अक्रान्त
अक्रान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಿಸಲ್ಪಡದ / ಜಯಿಸಲ್ಪಡದ<br><br>

अक्रान्ता
अक्रान्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಗ್ಗುಳ್ಳಗಿಡ / ಮುಳ್ಳು ಬದನೆಯ ಗಿಡ<br><br>

अक्रिय
अक्रिय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>अक्रिय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸವಿಲ್ಲದ / ಆಲಸ / ಮಂದಬುದ್ಧಿಯುಳ್ಳ<br><br>अक्रिय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರ್ಮರಹಿತ<br><b>व्युत्पत्तिः - </b>स्त्रियाम् - अक्रिया ।<br><b>विस्तारः - </b>(ಮತಸಂಬಂಧವಾದ ಸಂಸ್ಕಾರ)<br><br>अक्रिय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚೇಷೆ / ಸೋಮಾರಿತನ<br><br>

अक्रूर
अक्रूर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣನ ಸ್ನೇಹಿತನಾದ ಒಬ್ಬ ಯಾದವ.<br><b>विस्तारः - </b>ಈತನು ಕಂಸನನ್ನು ಆಶ್ರಯಿಸಿ ಜೀವಿಸುತ್ತಿದ್ದನು. ಕಂಸನು ನಾರದರ ಮುಖದಿಂದ ರಾಮಕೃಷ್ಣರ ವೃತ್ತಾಂತವನ್ನು ತಿಳಿದು ಚಾಣೂರ ಮತ್ತು ಮುಷ್ಟಿಕರಿಂದ ಜಟ್ಟಿಯ ಕಾಳಗದಲ್ಲಿ ಕೊಲ್ಲಿಸುವ ಉದ್ದೇಶದಿಂದ ಶ್ರೀರಾಮಕೃಷ್ಣರನ್ನು ಕರೆತರಲು ಈ ಯಾದವನನ್ನು ಕಳುಹಿಸಿದನು. ಈ ಅಕ್ರೂರನು ಪರಮಾತ್ಮನ ಅಂಶದಿಂದ ಅವತರಿಸಿರುವ ಶ್ರೀಕೃಷ್ಣನನ್ನು ಮನಸ್ಸಿನಲ್ಲೇ ಧ್ಯಾನಮಾಡುತ್ತಾ ಭಕ್ತಿಯಿಂದ ಶ್ರೀಕೃಷ್ಣನನ್ನು ಸಂದರ್ಶಿಸಲು ರಾತ್ರಿ ರಥವನ್ನು ಏರಿ ಹೊರಟು ಪ್ರಾತಃಕಾಲವೇ ನಂದಗೋಕುಲಕ್ಕೆ ಬಂದನು. ಅಲ್ಲಿ ಗೋವುಗಳನ್ನು ಕರೆಯುತ್ತಾ ಅವುಗಳ ಮಧ್ಯೆ ನಿಂತಿದ್ದ ಶ್ರೀಕೃಷ್ಣನನ್ನೂ ಬಲರಾಮನನ್ನೂ ಕಂಡು ನಮಸ್ಕರಿಸಿ ಅವರಿಂದ ಯಥೋಚಿತವಾದ ಸತ್ಕಾರವನ್ನು ಹೊಂದಿ ತಾನು ಬಂದ ಕಾರ್ಯವನ್ನು ವಿವರವಾಗಿ ತಿಳಿಸಿದನು. ಅನಂತರ ಅವರ ಅಪ್ಪಣೆ ಪಡೆದು ಅವರನ್ನು ರಥದಲ್ಲಿ ಕುಳ್ಳಿರಿಸಿ ತಾನು ರಥವನ್ನು ಬಿಡುತ್ತಾ ಬರುತ್ತಿರುವಾಗ ಯಮುನಾತೀರದಲ್ಲಿ ಮಧ್ಯಾಹ್ನಿಕಕ್ಕಾಗಿ ಅವರ ಅನುಮತಿಹೊಂದಿ ಅವರನ್ನು ರಥದಲ್ಲೇ ಕುಳ್ಳಿರಿಸಿ ತಾನು ಯಮುನಾ ಜಲದಲ್ಲಿಳಿದು ಸ್ನಾನಮಾಡುತ್ತಿರುವಾಗ ನೀರಿನೊಳಗೆ ರಾಮಕೃಷ್ಣರಿಬ್ಬರನ್ನೂ ನೋಡುವನು. ರಥದಲ್ಲಿದ್ದವರು ಇಲ್ಲಿಗೆ ಬರಲು ಕಾರಣವೇನೆಂದು ಆಶ್ಚರ್ಯದಿಂದ ರಥದ ಹತ್ತಿರಕ್ಕೆ ಬಂದು ನೋಡಲು ರಾಮಕೃಷ್ಣರಿಬ್ಬರೂ ಅಲ್ಲೇ ಕುಳಿತಿದ್ದರು. ಪುನಃ ನೀರಿನಲ್ಲಿಳಿದು ಸ್ನಾನಮಾಡುತ್ತಿದ್ದಾಗ ಶ್ರೀಕೃಷ್ಣನು ತನ್ನ ದಿವ್ಯರೂಪವನ್ನು ತೋರಿಸಲು ನಿಜವಾಗಿಯೂ ಇವರು ಪರಮಾತ್ಮನ ಅವತಾರವೆಂದು ಅವರನ್ನು ಬಹಳವಾಗಿ ಸ್ತೋತ್ರಮಾಡಿ ಪೂಜಿಸಿ ಸಾಯಂಕಾಲದೊಳಗೆ ಮಧುರೆಯನ್ನು ತಲುಪಿ ಊರಹೊರಗೆ ಅವರನ್ನು ಇಳಿಸಿ ಅವರ ಅಪ್ಪಣೆಯಂತೆ ನಗರವನ್ನು ಪ್ರವೇಶಿಸುವನು.<br><br>अक्रूर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ರೂರನಲ್ಲದ / ಸರಳನಾದ<br><b>व्युत्पत्तिः - </b>न क्रूरः ।<br><br>

अक्रोध
अक्रोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न क्रोधः ।<br><br>अक्रोध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪವಿಲ್ಲದ / ಶಾಂತನಾದ<br><b>व्युत्पत्तिः - </b>न क्रोधो यस्य ।<br><br>

अक्रोधन
अक्रोधन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಜಕುಮಾರ / ಅಯುತಾಯುವಿನ ಮಗ<br><br>अक्रोधन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪವಿಲ್ಲದ<br><br>

अक्लम
अक्लम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರಮವಿಲ್ಲದಿರುವಿಕೆ<br><br>अक्लम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರಮವಿಲ್ಲದ / ಆಯಾಸವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न क्लमो यस्य ।<br><br>

अक्लिष्ट
अक्लिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ಲೇಶಪಡದಿರುವ / ದಣಿಯದಿರುವ / ಆಯಾಸಪಡದಿರುವ<br><br>अक्लिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಡದಿರುವ / ಶಕ್ತಿ ಕುಂದದಿರುವ<br><b>व्युत्पत्तिः - </b>न क्लिष्टः ।<br><b>प्रयोगाः - </b>“अक्लिष्टबालतरुपत्लवलोभनीयम्” ।<br><b>उल्लेखाः - </b>शाकु० ६-२० ।<br><br>

अक्ष
अक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾರೆಗಿಡ<br><b>निष्पत्तिः - </b>अक्षू (व्याप्तौ) “अच्” (३-१-१३४) |<br><b>व्युत्पत्तिः - </b>अक्षति ।<br><br>अक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಡಿ / ಗಾಡಿ<br><br>अक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಡಿಯ ಅಚ್ಚು<br><br>अक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಡಿಯ ಚಕ್ರ / ಗಾಲಿ<br><br>अक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮ<br><br>अक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಗಡೆಕಾಯಿ<br><b>निष्पत्तिः - </b>अशू (व्याप्तौ) “सः” (उ० ३-६५) ।<br><br>अक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರುದ್ರಾಕ್ಷ<br><b>प्रयोगाः - </b>“अक्षदामरचनोचितैः फलैः” ।<br><b>उल्लेखाः - </b>याद० १७-३३ |<br><br>अक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ / ಹಾವು<br><br>अक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾವಣನ ಮಗ<br><br>अक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರುಡ<br><br>अक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನ<br><br>अक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನ್ಯಾಯ / ವ್ಯವಹಾರ<br><br>अक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಾತ್ಯಂಧ / ಹುಟ್ಟುಕುರುಡ<br><br>अक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹದಿನಾರು ಮಾಷಗಳ ತೂಕ<br><br>अक्ष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯ<br><b>निष्पत्तिः - </b>अक्ष् “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अक्ष्णोति व्याप्नोति विषयान् ।<br><br>अक्ष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌವರ್ಚಲವಣ<br><br>अक्ष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೇತ್ರ / ಕಣ್ಣು<br><b>प्रयोगाः - </b>“सर्वे तेऽनिमिषैरक्षैस्तमनुद्रुतचेतसः” ।<br><b>उल्लेखाः - </b>रामा० ।<br><b>विस्तारः - </b>(ಅಕ್ಷಿಶಬ್ದವು ಸಮಾಸಾಂತ್ಯದಲ್ಲಿ जलजाक्षः, पुण्डरीकाक्षः ಎಂದಾಗುವುದು).<br><br>अक्ष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಸಾಂಜನ<br><b>विस्तारः - </b>1. “अक्षो स्थस्यावयवे व्यवहारे विभीतके । पाशके शकटे कर्षे ज्ञाने चात्मनि रावणौ । अक्षं सौवर्चले तुत्थे हषीके” - हेम० | 2. “अक्षो ज्ञातार्थशकट्व्यबहारेषु पाशके । रुद्राक्षेन्द्राक्षयोः सर्पे बिभीतकतरावपि । चक्रे कर्षे पुमान् ब----- तुत्थे सौवर्चलेन्द्रिये” - मेदि० | 3. “न्यायोऽक्षो व्यवहारोऽथ” - वैज० |<br><br>

अक्षक
अक्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿನಿಶವೃಕ್ಷ / ಹುಲಿಗೆಮರ<br><b>निष्पत्तिः - </b>कं (शब्दे) “कः” (३-२-३)।<br><b>व्युत्पत्तिः - </b>अक्ष इव कायति |<br><br>

अक्षकील
अक्षकील<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಡಿಯ ಕಡಾಣಿ<br><b>व्युत्पत्तिः - </b>अक्षस्य कीलः ।<br><b>विस्तारः - </b>“अक्षकौले त्वणि.” - वैज० |<br><br>

अक्षकूट
अक्षकूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣುಗುಡ್ಡೆಯೊಳಗಿನ ಬೊಂಬೆ / ಪಾಪೆ<br><br>

अक्षग्लह
अक्षग्लह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೂಜಿನ ಪಂದ್ಯದ ವಸ್ತು<br><b>व्युत्पत्तिः - </b>अक्षस्य ग्लहः ।<br><br>

अक्षज
अक्षज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>अक्षज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನರ್ತನ / ಕುಣಿತ<br><b>विस्तारः - </b>“ताण्डवोऽस्त्री नृत्तलास्यनटनाक्षजनर्तनम्” - वैज० |<br><br>अक्षज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯಕ್ಷಜ್ಞಾನ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) “ड” (३-२-९८) ।<br><b>व्युत्पत्तिः - </b>अक्षात् इन्द्रियसन्निकर्षात् जायते |<br><br>अक्षज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಿಡಿಲು / ವಜ್ರಾಯುಧ<br><br>अक्षज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಜ್ರ<br><br>

अक्षत
अक्षत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯವಧಾನ್ಯ<br><b>व्युत्पत्तिः - </b>पुल्लिङ्ग-बहुवचनम् ।<br><br>अक्षत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಿಶಿನ ಹಚ್ಚಿದ ಅಕ್ಕಿ / ಶೋಭನಾಕ್ಷತೆ<br><br>अक्षत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ಷತೆ / ಮುರುಕಿಲ್ಲದ ಅಕ್ಕಿ<br><br>अक्षत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಜ / ಪುರಿ / ಅರಳು<br><b>निष्पत्तिः - </b>क्षणु (हिंसायाम्) भावे “क्तः” (३-३—११४ ।<br><b>व्युत्पत्तिः - </b>न क्षतं येषां ते ।<br><b>प्रयोगाः - </b>1. “सुदक्षिणा साक्षतपात्रहस्ता” |<br><b>उल्लेखाः - </b>1. रघु० २-२१<br><b>विस्तारः - </b>“लाजाः पुम्भूम्निचाक्षताः” - अम० । । (स्वीन०) वैज० ।<br><br>अक्षत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯ / ಕಾಳು<br><br>अक्षत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ಕಿ<br><b>विस्तारः - </b>“क्ल्यक्षतं तण्डुले धान्ये नना लाजेष ना यवे” - वैज०।<br><br>अक्षत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಷಂಡ / ನಪುಂಸಕ<br><br>अक्षत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಾಯಹೊಂದದಿರುವ / ವ್ರಣವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न क्षतम् ।<br><b>प्रयोगाः - </b>“विनाश्य रक्ष्यं क्षतमक्षतेन” |<br><b>उल्लेखाः - </b>रघु० २-५६ |<br><br>अक्षत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಡೆಯದಿರುವ / ಮುರಿಯದಿರುವ / ಪೂರ್ಣವಾದ<br><b>विस्तारः - </b>“अक्षतं चापि लाजेषु तृतीयप्रकृतावपि । अहिंसितेऽपि च” - विश्व० ।<br><br>

अक्षता
अक्षता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ಯೆ / ಪುಷ್ಪವತಿಯಾಗದ ಹುಡುಗಿ / ಪರಿಶುದ್ಧಳಾದವಳು / ಅನುಭವಿಸಲ್ಪಡದವಳು.<br><br>

अक्षतयोनि
अक्षतयोनि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ಯೆ / ಪುಷ್ಪವತಿಯಾಗದ ಹುಡುಗಿ / ಅನುಭವಿಸಲ್ಪಡದವಳು / ಪರಿಶುದ್ಧಳಾದವಳು<br><b>प्रयोगाः - </b>“सा चेदक्षतयोनिः स्यात्” |<br><b>उल्लेखाः - </b>मनु० ९-१७६ ।<br><br>

अक्षत्र
अक्षत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಸ್ತಕ / ತಲೆ<br><b>विस्तारः - </b>“उष्णीषं शीर्षमक्षत्रम्” - वैज० ।<br><br>अक्षत्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ಷತ್ರಿಯನಿಲ್ಲದ / ರಾಜನಿಲ್ಲದ (ದೇಶ)<br><b>व्युत्पत्तिः - </b>नास्ति क्षत्रं यत्र ।<br><b>प्रयोगाः - </b>“नाब्रह्म क्षत्रमुध्नोति नाक्षत्रं ब्रह्म वर्धते” |<br><b>उल्लेखाः - </b>मनु० ९-३२२ |<br><br>

अक्षदर्शक
अक्षदर्शक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನ್ಯಾಯಾಧಿಪತಿ / ವ್ಯವಹಾರದ ತೀರ್ಪುಗಾರ<br><b>निष्पत्तिः - </b>दृशिर् (प्रेक्षणे) “ष्वुल्” (३-१-१३३) ।<br><b>व्युत्पत्तिः - </b>अक्षणां ऋणादानादि व्यवहाराणां दर्शकः |<br><b>विस्तारः - </b>“इष्टरि व्यवहाराणां प्राड्विवाकोऽक्षदर्शकः” - वैज० ।<br><br>अक्षदर्शक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಟದ ಮೇಲ್ವಿಚಾರಕ<br><br>

अक्षदृश्
अक्षदृश्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನ್ಯಾಯಾಧಿಪತಿ<br><br>अक्षदृश्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಟದ ಮೇಲ್ವಿಚಾರಕ<br><b>निष्पत्तिः - </b>दृशिर् (प्रेक्षणे) “क्विप्” (३-२-७६) |<br><b>व्युत्पत्तिः - </b>अक्षान् पश्यति |<br><br>

अक्षदेविन्
अक्षदेविन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಟಗಾರ / ಜೂಜುಗಾರ<br><b>निष्पत्तिः - </b>दिवु (कीडायाम्) “णिनिः” (३-२-७८) ।<br><b>व्युत्पत्तिः - </b>अक्षैर्दीव्यति |<br><br>

अक्षद्यू
अक्षद्यू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಟಗಾರ / ಜೂಜುಗಾರ<br><br>

अक्षद्यूत
अक्षद्यूत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಟಗಾರ / ಜೂಜುಗಾರ<br><b>व्युत्पत्तिः - </b>अक्ष्यैर्द्यूतं यस्य ।<br><br>अक्षद्यूत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಗಡೆಯಾಟ / ಜೂಜು<br><b>व्युत्पत्तिः - </b>अक्ष्यैर्द्यूतम् ।<br><br>

अक्षधर
अक्षधर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>धरति-धृञ् (धारणे) “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अक्षस्य धरः ।<br><br>अक्षधर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಕ್ರ<br><br>अक्षधर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರೆಗಿಡ<br><br>अक्षधर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಕ್ರವನ್ನು ಧರಿಸಿರುವ<br><br>

अक्षधुर्
अक्षधुर्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಡಿಯ ನೊಗ<br><b>व्युत्पत्तिः - </b>अक्षस्य धूः ।<br><br>

अक्षधूर्त
अक्षधूर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಗಡೆಯಾಟದಲ್ಲಿ ಮೋಸಗಾರ<br><b>व्युत्पत्तिः - </b>अक्षे धूर्तः ।<br><br>

अक्षधूर्तिल
अक्षधूर्तिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಡಿಯ ಭಾರವನ್ನು ಹೊತ್ತಿರುವ ಎತ್ತು<br><b>निष्पत्तिः - </b>ला (आदाने) “कः” (३-२-३) ।<br><b>व्युत्पत्तिः - </b>अक्षस्य शकटस्य धूर्तिभारं लाति |<br><br>

अक्षपरि
अक्षपरि<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಪಗಡೆಯಾಟದಲ್ಲಿ ಸೋಲುಂಟಾಗುವಂತೆ ದಾಳ ಬೀಳುವುದು<br><b>व्युत्पत्तिः - </b>अक्षेण विपरीतं वृत्तम् |<br><br>

अक्षपाटक
अक्षपाटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯವಹಾರದಲ್ಲಿ ನಿಪುಣ / ನ್ಯಾಯಾಧಿಪತಿ / ತೀರ್ಪುಗಾರ<br><b>निष्पत्तिः - </b>पट (भाषाथे) “ऊवुल्” (३-१-१३३) |<br><b>व्युत्पत्तिः - </b>अक्षे पाटयति |<br><br>

अक्षपाद
अक्षपाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೌತಮಮುನಿ / ನ್ಯಾಯದರ್ಶನ ಪ್ರವರ್ತಕ<br><b>व्युत्पत्तिः - </b>अक्षं नेत्रं दर्शनसाधनतया जातः पादोऽस्य ।<br><b>विस्तारः - </b>[ಗೌತಮಮುನಿಯು, ತನ್ನ ಮತವನ್ನು ದೂಷಿಸಿದ ವ್ಯಾಸಮಹರ್ಷಿಯನ್ನು ಕಣ್ಣಿನಿಂದ ನೋಡಕೂಡದೆಂದು ಕಾಲಿನಲ್ಲಿ ನೇತ್ರವನ್ನು ತೆರೆದು ಅವರನ್ನು ನೋಡಿದುದಾಗಿ ಪ್ರಸಿದ್ಧಿಯುಂಟು.]<br><br>

अक्षभार
अक्षभार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಡಿಯ ಹೊರೆ<br><br>

अक्षम
अक्षम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಮರ್ಥ / ಅಶಕ್ತ<br><b>निष्पत्तिः - </b>क्षमूष् (सहने) “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>न क्षमते |<br><br>अक्षम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಹನೆಯಿಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>न क्षमा यस्य । (स्त्री०)–मा |<br><br>अक्षम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಹನೆ / ಕೋಪ<br><b>निष्पत्तिः - </b>क्षमूष् भावे “अङ्” (३-३-३-१०४) ।<br><b>व्युत्पत्तिः - </b>न क्षमा ।<br><br>

अक्षमाला
अक्षमाला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಪಮಾಲಿಕೆ / ರುದ್ರಾಕ್ಷಮಾಲೆ<br><b>व्युत्पत्तिः - </b>अक्षणां माला ।<br><br>अक्षमाला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಸಿಷ್ಠ ಮಹರ್ಷಿಯ ಪತ್ನಿ / ಅರುಂಧತೀದೇವಿ<br><b>प्रयोगाः - </b>“विभान्तमच्छस्फटिकाक्षमालया” |<br><b>उल्लेखाः - </b>माघ० १-९ ।<br><b>विस्तारः - </b>अक्षस्य सप्तर्षि नक्षत्रचक्रस्य मालेव भूषणत्वात् ।<br><br>

अक्षय
अक्षय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><br>अक्षय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ಷಯ ಸಂವತ್ಸರ<br><br>अक्षय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನೆಯಿಲ್ಲದವನು / ಸಂನ್ಯಾಸಿ<br><br>अक्षय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದರಿದ್ರ<br><b>व्युत्पत्तिः - </b>क्षयो वासः नास्त्यस्य ।<br><br>अक्षय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶರಹಿತ / ಹಾಳಾಗದ<br><b>प्रयोगाः - </b>"सदोपयोगेऽपि गुरुस्त्वमक्षयः” |<br><b>उल्लेखाः - </b>माघ० १-२८ ।<br><br>

अक्षया
अक्षया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಣ್ಯಪ್ರದವಾದ ತಿಥಿ<br><b>प्रयोगाः - </b>“अमा वै सोमवारेण रविवारेण सप्तमी । चतुर्थी भौमवारेण अक्षयादपि चाक्षया “ |<br><b>उल्लेखाः - </b>भविष्य० ।<br><br>

अक्षयतृतीया
अक्षयतृतीया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೈಶಾಖಶುಕ್ಲ ತದಿಗೆ<br><b>प्रयोगाः - </b>“वैशाखस्य सिते पक्षे तृतीयाक्षयसञ्ज्ञिता” |<br><b>उल्लेखाः - </b>स्कान्द० ।<br><br>

अक्षयलोक
अक्षयलोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಶ್ವತಲೋಕ / ಸತ್ಯಲೋಕ<br><br>

अक्षय्य
अक्षय्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶರಹಿತ / ಶಾಶ್ವತ<br><br>अक्षय्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸಲಶಕ್ಯವಾದ<br><b>व्युत्पत्तिः - </b>क्षेतुं शक्यं क्षय्यम्-न क्षय्यम् ।<br><b>प्रयोगाः - </b>“तपःषड्भागमक्षय्यं ददत्यारण्यका हि नः” |<br><b>उल्लेखाः - </b>शाकु० २-१३ |<br><br>

अक्षर
अक्षर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಬ್ರಹ್ಮ / ಪರಮಾತ್ಮ<br><b>निष्पत्तिः - </b>क्षर (चलने) “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>न क्षरति |<br><b>प्रयोगाः - </b>“क्षरः सर्वाणि भूतानि कूटस्थोऽक्षर उच्यते” |<br><b>उल्लेखाः - </b>गीता १५-१६ ।<br><br>अक्षर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>अक्षर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ / ಈಶ್ವರ<br><br>अक्षर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ / ಚತುರ್ಮುಖ<br><br>अक्षर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಓಂಕಾರ<br><br>अक्षर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧರ್ಮ<br><br>अक्षर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕೃತಿ<br><br>अक्षर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಪಸ್ಸು<br><br>अक्षर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗ<br><br>अक्षर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಕಾರಾದಿವರ್ಣ<br><b>प्रयोगाः - </b>1. “प्रयत्नलिखितान्यपि श्रोत्रियाक्षराण्यस्फुटान्येव भवन्ति” | 2. “यदेकमक्षरं ब्रह्म” | 3. “अक्षराणामकारोऽस्मि” | 4. “अहो सन्दीपनान्यक्षराणि” |<br><b>उल्लेखाः - </b>1. मुद्रा० १ । 2. याद० १-५१ । 3. गीता १०-३३ । 4. उ० रा० ४।<br><br>अक्षर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಕ್ಷ / ಮುಕ್ತಿ / ಅಪವರ್ಗ<br><b>विस्तारः - </b>अक्षरं प्रणवे धर्मे प्रकृतौ तपसि ऋतौ । वर्णे मोक्षे च नात्वेष शिवविष्णु विरिञ्चिषु” - नानार्थरं ।<br><br>अक्षर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಗನ / ಆಕಾಶ<br><br>अक्षर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಾಮಾರ್ಗ / ಉತ್ತರಣೆಗಿಡ<br><br>अक्षर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಲಕಾರಣ<br><b>विस्तारः - </b>“अक्षरं स्यादपामार्गे परमब्रह्मवर्णयोः । गगने धर्मतपसोरध्वरे मूलकारणे” - हेम० ।<br><br>

अक्षरचण
अक्षरचण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಿಪಿಕಾರ / ಗುಮಾಸ್ತ / ಬರವಣಿಗೆಯಲ್ಲಿ ನಿಪುಣ<br><b>निष्पत्तिः - </b>अक्षर “चणप्” (५-२-५६) ।<br><b>व्युत्पत्तिः - </b>अक्षरेण वित्तः |<br><br>

अक्षरचुञ्चु
अक्षरचुञ्चु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಿಪಿಕಾರ / ಗುಮಾಸ್ತ / ಬರವಣಿಗೆಯಲ್ಲಿ ನಿಪುಣ<br><b>निष्पत्तिः - </b>अक्षर “चुञ्चुप्” (५-२-५६) ।<br><b>व्युत्पत्तिः - </b>अक्षरेण वित्तः |<br><br>

अक्षरच्युतक
अक्षरच्युतक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ಷರವನ್ನು ತೆಗೆದುಹಾಕುವುದರಿಂದ ಬೇರೆ ಅರ್ಥವನ್ನು ಕೊಡತಕ್ಕ ವಾಕ್ಯ<br><b>विस्तारः - </b>. “देव यौष्माकसेनायाः करेणुः प्रसरत्यसौ” ಇಲ್ಲಿ “क” ತೆಗೆದರೂ रेणः ಎಂಬ ಅರ್ಥವನ್ನು ಕೊಟ್ಟು ವಾಕ್ಯಾರ್ಥವು ಸಂಗತವಾಗಿರುವುದು.<br><br>

अक्षरच्छन्दस्
अक्षरच्छन्दस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಣವೃತ್ತ / ಅಕ್ಷರಸಂಖ್ಯೆಯಿಂದ ರಚಿತವಾದ ವೃತ್ತ<br><br>

अक्षरजननी
अक्षरजननी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲೇಖನಿ<br><br>

अक्षरजीविन्
अक्षरजीविन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬರವಣಿಗೆಯಿಂದ ಜೀವಿಸುವವನು<br><b>निष्पत्तिः - </b>जीव (प्राणधारणे) “णिनिः” (३-१-१३४) । स्त्रियां “डीप्”।<br><b>व्युत्पत्तिः - </b>अक्षरेण तत्लेखनेन जीवति | जीविनी |<br><br>

अक्षरतूलिका
अक्षरतूलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲೇಖನಿ<br><br>

अक्षरमुख
अक्षरमुख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿದ್ಯಾವಂತ / ಪಂಡಿತ / ವಿದ್ಯಾರ್ಥಿ<br><b>व्युत्पत्तिः - </b>अक्षराणि मुखे यस्य ।<br><br>अक्षरमुख<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>अ” ವರ್ಣ / ವರ್ಣಮಾಲೆಯಲ್ಲಿ ಮೊದಲನೆಯ ಅಕ್ಷರ<br><br>

अक्षरविन्यास
अक्षरविन्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೇಖನ / ಬರವಣಿಗೆ<br><br>

अक्षरशस्
अक्षरशस्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಪ್ರತಿಯೊಂದು ಅಕ್ಷರಕ್ಕೂ<br><b>निष्पत्तिः - </b>अक्षरमक्षरम् “शस्” (५-४-४३) ।<br><br>

अक्षरशिक्षा
अक्षरशिक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ಷರಶಾಸ್ತ್ರ<br><br>अक्षरशिक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಜ್ಞಾನ<br><br>

अक्षरसमाम्नाय
अक्षरसमाम्नाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣಶಾಸ್ತ್ರಕ್ಕೆ ಮೂಲಭೂತವಾದ ಹದಿನಾಲ್ಕು ಸೂತ್ರಗಳು<br><b>व्युत्पत्तिः - </b>(चतुर्दशसूत्री) ।<br><b>विस्तारः - </b>“अइउण् ऋलृक् एओङ् ऐऔच् हयवरट् लण् ञमङणनम् झभञ् घढधष् जवगडदश् खफछठथचटतव् कपय् शषसर् हल्” ಈ ಹದಿನಾಲ್ಕು ಸೂತ್ರಗಳೂ ಪಾಣಿನಿಮಹರ್ಷಿಯ ತಪಸ್ಸಿನಿಂದ ಸಂತುಷ್ಟನಾದ ಪರಮೇಶ್ವರನು ನರ್ತನದ ಕೊನೆಯಲ್ಲಿ ಬಾರಿಸಿದ ಢಕ್ಕೆಯ ಅನುಗ್ರಹದಿಂದ ಲಬ್ಧವಾದುವು.<br><br>

अक्षरसंस्थान
अक्षरसंस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬರವಣಿಗೆಯ ಕ್ರಮ<br><br>

अक्षराज
अक्षराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೂಜಿನಲ್ಲಿ ಆಸಕ್ತನಾದವನು / ಜೂಜುಕೋರ<br><br>

अक्षराभ्यास
अक्षराभ्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ಷರವನ್ನು ಗ್ರಹಿಸುವುದು / ಅಕ್ಷರಸ್ವೀಕಾರ<br><b>विस्तारः - </b>ಮಕ್ಕಳಿಗೆ ಪ್ರಪ್ರಥಮವಾಗಿ ಅಕ್ಷರವನ್ನು ಕಲಿಸುವ ಒಂದು ಕರ್ಮ. ಅಕ್ಷರಾಭ್ಯಾಸವನ್ನು ಮಕ್ಕಳಿಗೆ ಐದನೆಯ ವರ್ಷದಲ್ಲಿ ಮಾಡಿಸಬೇಕು. ಇದಕ್ಕೆ ಉತ್ತರಾಯಣವೂ ದ್ವಿತೀಯಾ, ತೃತೀಯಾ, ಪಂಚಮೀ, ಸಪ್ತಮೀ, ದಶಮೀ, ಏಕಾದಶೀ, ದ್ವಾದಶೀ, ತ್ರಯೋದಶೀ ಮತ್ತು ಪೂರ್ಣಿಮೆಗಳೂ ಸೋಮ, ಬುಧ, ಗುರು ಮತ್ತು ಶುಕ್ರವಾರಗಳೂ ಅಶ್ವಿನಿ, ಪುನರ್ವಸು, ಪುಷ್ಯ ಹಸ್ತ, ಚಿತ್ತೆ, ಸ್ವಾತಿ, ಅನುರಾಧಾ, ಶ್ರವಣ ಮತ್ತು ರೇವತೀ ನಕ್ಷತ್ರಗಳೂ ಪ್ರಶಸ್ತವು. ಗುರು ಶುಕ್ರರು ಅಸ್ತರಾಗದಿರುವಾಗಲೂ ಸೂರ್ಯನು ಚರ ಅಥವಾ ಸ್ಥಿರರಾಶಿಯಲ್ಲಿರುವಾಗಲೂ ಅಷ್ಟಮಶುದ್ಧಿಯಿರುವ ಚರಲಗ್ನದಲ್ಲೂ ಅಕ್ಷರಾಭ್ಯಾಸವನ್ನು ನಡೆಯಿಸಬೇಕು.<br><br>

अक्षरी
अक्षरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಷಋತು / ಮಳೆಗಾಲ<br><b>निष्पत्तिः - </b>अशू(व्याप्तौ) “सर.” (उ० ३-७०) |<br><b>व्युत्पत्तिः - </b>अश्नुते गगनाभोगं |<br><br>

अक्षवती
अक्षवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದ್ಯೂತ, ಜೂಜು<br><b>निष्पत्तिः - </b>“मतुप्” (५-२-९४) ।<br><b>व्युत्पत्तिः - </b>अक्षाः साधनत्वेन सन्त्यत्र |<br><b>विस्तारः - </b>“द्युतॊऽस्त्रियामक्षवतो तद्भेदाः पञ्चिनकादयः” - वैज० ।<br><br>

अक्षवाट
अक्षवाट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೂಜಿನ ಮನೆ<br><br>अक्षवाट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಗಡೆಯ ಹಾಸು / ಪಗಡೆಯಾಟದ ಹಲಗೆ<br><b>व्युत्पत्तिः - </b>अक्षाणां वाटः ।<br><br>अक्षवाट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧರಂಗ / ಮಲ್ಲಭೂಮಿ / ಕುಸ್ತಿಯಾಡುವ ಜಾಗ<br><br>

अक्षविद्
अक्षविद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಟವನ್ನು ತಿಳಿದಿರುವವನು<br><br>अक्षविद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯವಹಾರ್ಅವನ್ನು ತಿಳಿದಿರುವವನು / ನ್ಯಾಯದಲ್ಲಿ ನಿಪುಣನಾಡವನು<br><b>निष्पत्तिः - </b>विद (ज्ञाने) “क्विप्” (३-२-७६) ।<br><b>व्युत्पत्तिः - </b>अक्षं वेत्ति |<br><br>

अक्षविद्या
अक्षविद्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜೂಜಿನವಿದ್ಯೆ / ದ್ಯೂತಕಲೆ<br><br>

अक्षवृत्त
अक्षवृत्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ಯೂತದಲ್ಲಿ ನಿಪುಣನಾದವನು<br><b>व्युत्पत्तिः - </b>अक्षे वृत्तः ।<br><br>

अक्षशौण्ड
अक्षशौण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ಯೂತದಲ್ಲಿ ನಿಪುಣನಾದವನು<br><b>व्युत्पत्तिः - </b>अक्षेषु शौण्डः ।<br><br>

अक्षसूत्र
अक्षसूत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಪಮಾಲೆ<br><br>अक्षसूत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಪಮಾಲೆಯನ್ನು ತಯಾರಿಸುವ ದಾರ<br><b>प्रयोगाः - </b>“कृतोऽक्षसूत्रप्रणयो तया करः” |<br><b>उल्लेखाः - </b>कुमा० ५-११ ।<br><br>

अक्षाग्रकीलक
अक्षाग्रकीलक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಡಿಯ ಕಡಾಣಿ / ಚಕ್ರದ ತಡೆಗಾಗಿ ಹಾಕುವ ಮೊಳೆ<br><b>व्युत्पत्तिः - </b>अक्षस्य अग्रे अन्ते कीलकः ।<br><br>

अक्षानह्
अक्षानह्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಡಿಯ ಅಚ್ಚುಮರ<br><br>

अक्षान्ति
अक्षान्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಈರ್ಷ್ಯೆ / ಅಸೂಯೆ<br><b>व्युत्पत्तिः - </b>ना क्षान्तिः ।<br><br>अक्षान्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಹಿಷ್ಣುತೆ / ಹೊಟ್ಟೆಕಿಚ್ಚು<br><b>व्युत्पत्तिः - </b>न क्षान्तिः यस्य ।<br><br>

अक्षारलवण
अक्षारलवण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರದ ಉಪ್ಪು / ಅಕೃತ್ರಿಮವಾದ ಉಪ್ಪು<br><b>व्युत्पत्तिः - </b>क्षारं ऊषरमृत्तिकया निर्वृत्तं लवणम् । न क्षारलवणम् ।<br><br>

अक्षावपन
अक्षावपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಗಡೆಯ ಹಾಸು<br><br>

अक्षावाप
अक्षावाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಗಡೆಯಾಡುವವನು / ಜೂಜುಗಾರ<br><b>निष्पत्तिः - </b>आ+डु वप् (बीज-सन्ताने) “आण्” (३-२-१) ।<br><b>व्युत्पत्तिः - </b>अक्षान् आवपति |<br><br>

अक्षि
अक्षि<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೇತ್ರ / ಕಣ್ಣು<br><b>निष्पत्तिः - </b>अशू (व्याप्तौ) “---“ (उ० ३-१५६)।<br><b>व्युत्पत्तिः - </b>अश्नेते विषयान् |<br><b>विस्तारः - </b>ಬಹುವ್ರೀಹಿ ಸಮಾಸಾಂತ್ಯದಲ್ಲಿ “पच्” ಎಂದಾಗುವುದು. (५-४-११३) । “अक्ष” ಎಂದಾಗುವುದು. जलजाक्षः पुण्डरीकाक्षः ಇತ್ಯಾದಿ.<br><br>अक्षि<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎರಡು ಸಂಖ್ಯೆ<br><br>

अक्षिकम्प
अक्षिकम्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೇತ್ರಸ್ಫುರಣ / ಕಣ್ಣಿನ ರೆಪ್ಪೆ ಹಾರುವುದು (ಚಲಿಸುವುದು)<br><br>

अक्षिकूट
अक्षिकूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣುಗುಡ್ಡೆ<br><br>अक्षिकूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣು ಗುಡ್ಡೆಯೊಳಗಿನ ಬೊಂಬೆ / ಪಾಪೆ<br><br>

अक्षिगत
अक्षिगत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೈರಿ / ಶತ್ರು<br><b>व्युत्पत्तिः - </b>अक्ष्णि गतः ।<br><b>विस्तारः - </b>“द्वेष्यस्त्वक्षिगतोऽनिष्टः” - वैज० ।<br><br>अक्षिगत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣಿಗೆ ಕಾಣಿಸಿಕೊಳ್ಳುವ<br><b>प्रयोगाः - </b>“ न विभावयत्यक्षिगतामपि” |<br><b>उल्लेखाः - </b>माघ० ९-८१ ।<br><br>

अक्षीब
अक्षीब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನುಗ್ಗೆ ಮರ<br><br>अक्षीब<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರದ ಉಪ್ಪು<br><br>अक्षीब<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮದವಿಲ್ಲದ<br><b>विस्तारः - </b>“अक्षीबं वशिरे शिग्नौ नामत्तेऽभिवेयवत्” - मेदि० ।<br><br>

अक्षुण्ण
अक्षुण्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಡೆಯದಿರುವ<br><br>अक्षुण्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಯಿಸಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न क्षुण्णः ।<br><br>अक्षुण्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಳಗದಿರುವ / ಸವೆಯದಿರುವ / ಅಭ್ಯಾಸವಾಗದ<br><b>प्रयोगाः - </b>“अभीक्ष्णमक्षुण्णतयातिदुर्गमम्” |<br><b>उल्लेखाः - </b>माघ० १-३२ ।<br><br>

अक्षुद्र
अक्षुद्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಣ್ಣದಲ್ಲದ / ದೊಡ್ಡದಾದ<br><br>अक्षुद्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀಚವಲ್ಲದ / ಗಂಭೀರವಾದ<br><b>प्रयोगाः - </b>“अक्षुद्रगतिशालिन्योः” |<br><b>उल्लेखाः - </b>याद० १-३२ ।<br><br>

अक्षेत्र
अक्षेत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಯೋಗವಿಲ್ಲದ ಭೂಮಿ<br><br>अक्षेत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯವಾದ ಭೂಮಿ<br><br>अक्षेत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯ ವಿದ್ಯಾರ್ಥಿ<br><br>अक्षेत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಾನಕ್ಕೆ ಯೋಗ್ಯನಲ್ಲದ ಮನುಷ್ಯ<br><b>व्युत्पत्तिः - </b>अप्रशस्तं क्षेत्रम् ।<br><br>

अक्षेत्रिन्
अक्षेत्रिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿಯಿಲ್ಲದವನು<br><br>

अक्षोट
अक्षोट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಟ್ಟಗೋಣಿಮರ<br><b>व्युत्पत्तिः - </b>अक्षस्येवोटाः पर्णान्यस्य ।<br><br>

अक्षोभ
अक्षोभ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ವೇಗವಿಲ್ಲದ / ಕಳವಳವಿಲ್ಲದ / ಗಾಬರಿಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति क्षोभो यस्य ।<br><br>

अक्षोभ्य
अक्षोभ्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ಷೋಭ್ಯಮುನಿ<br><br>अक्षोभ्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧದೇವ<br><br>अक्षोभ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಶಾಂತ / ಕದಲಿಸಲು ಅಶಕ್ಯ / ತಿರಸ್ಕರಿಸಲು ಅಸಾಧ್ಯ<br><b>निष्पत्तिः - </b>क्षुभ (सञ्चलने) + णिच् “ष्यत्” (३-१-१२४) ।<br><b>व्युत्पत्तिः - </b>क्षोभ्यते विचाल्यते | न क्षोभ्यः ।<br><b>प्रयोगाः - </b>“अक्षोभ्यः स नवोऽप्यासीद्दृढमूल इव द्रुमः” |<br><b>उल्लेखाः - </b>रघु० १७-४४ ।<br><br>

अक्षौहिणी
अक्षौहिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಅಕ್ಷೌಹಿಣೀ ಸೈನ್ಯ<br><b>विस्तारः - </b>21,870 ರಥಗಳು, 21,870 ಆನೆಗಳು, 65,610 ಕುದುರೆಗಳು ಮತ್ತು 1,09,350 ಕಾಲಾಳುಗಳುಳ್ಲ ಸೇನೆ. ಹತ್ತು ಅನೀಕಿನೀ ಸೇನೆ ಸೇರಿದರೆ ಒಂದುಅಕ್ಷೌಹಿಣೀ ಸೈನ್ಯ. [ವಿವರಕ್ಕೆ “अनौकिनी” अक्षाणामूहिनी-ऊहः समूहः सोऽस्यामस्ति ।]<br><br>

अक्ष्ण
अक्ष्ण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲ / ಸಮಯ<br><b>निष्पत्तिः - </b>अशू (व्याप्तौ) “क्ष्नः” (उ०३-१७) ।<br><b>व्युत्पत्तिः - </b>अश्नुते व्याप्नोति |<br><br>अक्ष्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಖಂಡವಾದ / ಒಡೆಯದಿರುವ<br><br>

अखण्ड
अखण्ड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣವಾದ<br><b>निष्पत्तिः - </b>खडि (भेदने) “घञ्” (३-३-१९) ।<br><b>व्युत्पत्तिः - </b>न खण्ड्यते |<br><b>प्रयोगाः - </b>“अखण्डं उण्यानां फलमिव च तद्रूपमनघम्” |<br><b>उल्लेखाः - </b>शाकु० २-१० ।<br><br>अखण्ड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಿಚ್ಛಿನ್ನವಾಗಿ / ಸತತವಾಗಿ<br><b>प्रयोगाः - </b>“अखण्डमाखण्डलतुल्यधामभिः” |<br><b>उल्लेखाः - </b>किरा० १-२९ ।<br><br>

अखण्डित
अखण्डित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಡೆಯಲ್ಪಡದಿರುವ / ಸಂಪೂರ್ಣವಾದ<br><b>व्युत्पत्तिः - </b>न खण्डितम् ।<br><br>अखण्डित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಸ್ಯೂತ / ಸತತವಾದ<br><b>प्रयोगाः - </b>“अखण्डितं प्रेम लभस्व पत्युः” |<br><b>उल्लेखाः - </b>कुमा० ७-२८ ।<br><br>

अखात
अखात<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಕೃತ್ರಿಮ ಜಲಾಶಯ / ಮನುಷ್ಯರಿಂದ ತೋಡಲ್ಪಡದ ಜಲಾಶಯ<br><br>अखात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗೆಯಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न खातम् ।<br><br>

अखाद्य
अखाद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿನ್ನಲು ಯೋಗ್ಯವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न खाद्यम् ।<br><br>

अखिन्न
अखिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ಲೇಶವಿಲ್ಲದವನು / ಆಯಾಸವಿಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>न खिन्नः ।<br><b>प्रयोगाः - </b>“मखेष्वखिन्नोऽनुमतः पुरोधसा” |<br><b>उल्लेखाः - </b>किरा० १-२२ ।<br><br>

अखिल
अखिल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಸ್ತವಾದ / ಸಂಪೂರ್ಣವಾದ<br><b>व्युत्पत्तिः - </b>न खिलमस्य ।<br><b>प्रयोगाः - </b>“तेन सिंहासनं पित्र्यमखिलं चारिमण्डलम्” |<br><b>उल्लेखाः - </b>रघु० ४-४ ।<br><br>

अखिला
अखिला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೇಗಿಲಿನಿಂದ ಉಳಲ್ಪಟ್ಟ ಭೂಮಿ<br><b>निष्पत्तिः - </b>खिल (उञ्छे) “घञ्” (३-३-१२१) ।<br><b>व्युत्पत्तिः - </b>खिल्यते कणशं आदीयतेऽत्र | न खिला ।<br><br>

अग
अग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಕ್ಷ / ಮರ<br><br>अग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತ / ಬೆಟ್ಟ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) “डः” (वा० ३-२-४८) ।<br><b>व्युत्पत्तिः - </b>न गच्छति |<br><b>प्रयोगाः - </b>“भग्नो निवासोऽयमिहास्य पुष्पैः सदानतो येन विषाणिनाऽगः” |<br><b>उल्लेखाः - </b>माघ० ४-६३ ।<br><br>अग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ / ಹಾವು<br><br>अग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>न गच्छति वक्रगत्या पश्चिमम् ।<br><br>अग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಲಿಸದಿರುವ / ನಡೆಯದಿರುವ<br><b>निष्पत्तिः - </b>गम्लृ “डः” (वा० ३-२-४८) ।<br><b>विस्तारः - </b>“अगो महीरुहे शैले भास्करे पवनाशने” - मेदि० ।<br><br>अग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಭಿ / ಹೊಕ್ಕಳು<br><b>विस्तारः - </b>“अगो नगश्च भुजगे नाभौ भूरुहि भूधरे” - नानार्थर० ।<br><br>

अगज
अगज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಲಾಜತು<br><br>अगज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರ್ವತದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) “डः” (३-२-९८) ।<br><b>व्युत्पत्तिः - </b>अगाज्जायते ।<br><b>विस्तारः - </b>(स्त्री०) –जा-ಜಾ. ಪಾರ್ವತಿ<br><br>

अगद
अगद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಔಷಧ<br><b>व्युत्पत्तिः - </b>न गदो यस्मात् ।<br><br>अगद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೋಗವಿಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>न गदो यस्य ।<br><br>

अगदङ्कार
अगदङ्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೈದ್ಯ<br><b>निष्पत्तिः - </b>डु कृञ् (करणे) “अण्” (३-२-१) । “मुम्” (६-३-७०) ।<br><b>व्युत्पत्तिः - </b>अगदं अरोगं करोति ।<br><br>

अगम
अगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಕ್ಷ / ಮರ<br><br>अगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತ / ಬೆಟ್ಟ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>न गच्छति ।<br><br>अगम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಲಿಸದಿರುವ / ನಡೆಯದಿರುವ<br><br>

अगम्य
अगम्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಗಲು ಯೋಗ್ಯವಲ್ಲದ / ಹೊಂದಲು ಅರ್ಹವಲ್ಲದ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) “यत्” (३-१-९८) ।<br><b>व्युत्पत्तिः - </b>न गम्यः ।<br><b>प्रयोगाः - </b>“अगम्यरूपां पदवीं प्रपित्सुना” ।<br><b>उल्लेखाः - </b>किरा० १-९ ।<br><br>अगम्य<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೀಳು ಜಾತಿಯ ಹೆಂಗಸು<br><br>

अगम्यागमन
अगम्यागमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೀಳುಜಾತಿಯ ಹೆಂಗಸಿನ ಸಂಬಂಧ / ಅನರ್ಹಳಾದ ಹೆಂಗಸಿನ ಸಂಬಂಧ<br><br>

अगरी
अगरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತಾಳೆ ಮರ<br><b>व्युत्पत्तिः - </b>नास्ति गरो विषं यस्याः ।<br><b>विस्तारः - </b>[ದೇವತಾಳೆಮರವು ಇಲಿ ಮತ್ತು ಹೆಗ್ಗಣಗಳ ವಿಷವನ್ನು ಹೋಗಲಾಡಿಸುವುದು.]<br><br>अगरी<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಷಹರವಾದ / ವಿಷವನ್ನು ಹೋಗಲಾಡಿಸುವ<br><br>

अगरु
अगरु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗರು ಚಂದನ<br><br>

अगर्हित
अगर्हित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿತವಲ್ಲದ / ಶುದ್ಧವಾದ<br><b>व्युत्पत्तिः - </b>न गर्हितम् ।<br><br>

अगस्ति
अगस्ति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸ್ತ್ಯಮುನಿ<br><b>निष्पत्तिः - </b>असु (क्षेपणे) “क्तिच्” (३-३-१७४) । शक० ।<br><b>व्युत्पत्तिः - </b>अगं विन्ध्यपर्वतं अस्यति।<br><br>

अगस्त्य
अगस्त्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸ್ತ್ಯಮುನಿ<br><b>निष्पत्तिः - </b>स्त्यै (शब्दसङ्घातयोः) “कः” (३-२-३)।<br><b>व्युत्पत्तिः - </b>अगं विन्ध्यपर्वतं स्त्यायति ।<br><b>प्रयोगाः - </b>1. “अगस्त्यवरितामाशामनाशास्यजयो ययौ” ।<br><b>उल्लेखाः - </b>1. रघु० ४-४४<br><b>विस्तारः - </b>ಅಗಸ್ತ್ಯ ಮಹರ್ಷಯ ಚರಿತ್ರೆ ಪುಸ್ತಕದಲ್ಲಿ ಪೂರ್ತಿ ಕೊಟ್ಟಿದೆ. ಆದರೆ, ಇಲ್ಲಿ ಸ್ಥಳಾವಕಾಶವಿಲ್ಲದುದರಿಂದ ಅದನ್ನು ಕೊಟ್ಟಿಲ್ಲ. ಅಗಸ್ತ್ಯಮಹರ್ಷಿಯು ಗೋತ್ರಪ್ರವರ್ತಕರಾದ ಎಂಟುಮಂದಿ ಋಷಿಗಳಲ್ಲೊಬ್ಬರು: ಜಮದಗ್ನಿ, ಭರದ್ವಾಜ, ವಿಶ್ವಾಮಿತ್ರ, ಅತ್ರಿ, ಗೌತಮ, ವಸಿಷ್ಠ, ಕಶ್ಯಪ ಮತ್ತು ಅಗಸ್ತ್ಯ ಈ ಎಂಟುಮಂದಿ ಋಷಿಗಳು ಗೋತ್ರಪ್ರವರ್ತಕರು. “जमदग्निभरद्वाज विश्वामित्रात्रि गौतमाः । वसिष्ठकश्यपागस्त्याः ऋषयो गोत्रकारकाः” | “अगस्त्यस्तु मुनिद्रुमः । - कल्पद्रु०<br><br>

अगस्त्यवट
अगस्त्यवट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಮಾಲಯದಲ್ಲಿರುವ ಒಂದು ಪವಿತ್ರ ಸ್ಥಳ<br><br>

अगस्त्यसंहिता
अगस्त्यसंहिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸ್ತ್ಯಮುನಿಯು ರಚಿಸಿದ ಭಗವತ್ಪೂಜಾಶಾಸ್ತ್ರ<br><br>

अगस्त्योदय
अगस्त्योदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸ್ತ್ಯನಕ್ಷತ್ರದ ಉದಯ<br><b>प्रयोगाः - </b>"प्रससादोदयादम्भः कुम्भयोनेर्महौजसः” |<br><b>उल्लेखाः - </b>रघु ४-४-२१ |<br><b>विस्तारः - </b>ಅಗಸ್ತ್ಯನಕ್ಷತ್ರದ ಉದಯಕಾಲದಲ್ಲಿ ನೀರೆಲ್ಲವೂ ಪ್ರಸನ್ನ(ತಿಳಿ)ವಾಗುವುದು.<br><br>

अगाध
अगाध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಂಭೀರವಾದ<br><br>अगाध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಳವಾದ<br><b>निष्पत्तिः - </b>गाधृ (प्रतिष्ठायाम्) “घञ्” ।<br><b>व्युत्पत्तिः - </b>नाति गाध: स्थितिरत्र ।<br><b>प्रयोगाः - </b>“शिथिलवसुमगाधे मग्नमापत्ययोघौ” |<br><b>उल्लेखाः - </b>किरा० १-४६ ।<br><br>

अगार
अगार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆ / ಗೃಹ<br><b>निष्पत्तिः - </b>ऋ (गतौ) “अण्” (३-२-१) ।<br><b>व्युत्पत्तिः - </b>अगं ऋच्छति ।<br><b>प्रयोगाः - </b>“दीप्रैरगारमणिभिर्दिवसायमानैः” ।<br><b>उल्लेखाः - </b>चं भा० ।<br><br>

अगुण
अगुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೋಷ<br><b>व्युत्पत्तिः - </b>न गुणः ।<br><b>प्रयोगाः - </b>“अगुणेषु तस्य घियमस्तवतः” ।<br><b>उल्लेखाः - </b>किरा० ६-२१ ।<br><br>अगुण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರ್ಗುಣ / ಗುಣಶೂನ್ಯ<br><br>

अगुणा
अगुणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಣಶೂನ್ಯೆ<br><br>

अगूढ
अगूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಕ್ತವಾದ / ಸ್ಪಷ್ಟವಾದ<br><b>व्युत्पत्तिः - </b>न गूढः ।<br><b>प्रयोगाः - </b>“अगूढहासस्फुटदन्तकैसरम्” ।<br><b>उल्लेखाः - </b>किरा० ८-३६ ।<br><b>विस्तारः - </b>ಅಲಂಕಾರಶಾಸ್ತ್ರದಲ್ಲಿ ವ್ಯಂಗ್ಯದ ಒಂದು ಭೇದ. ಎಂಟು ವಿಧವಾಗಿ ಹೇಳಲ್ಪಟ್ಟ ಪ್ರಯೋಜನಲಕ್ಷಣೆಯು ಮತ್ತೆ ಗೂಢವ್ಯಂಗ್ಯ ಅಗೂಢವ್ಯಂಗ್ಯಗಳೆಂದು ಎರಡು ವಿಧವಾಗುವುದು. “व्यङ्यस्य मूढामूढत्वाद् द्विधा स्युः फललक्षणाः” सा० द० २-१० । ಗೂಢ ವ್ಯಂಗ್ಯವು ಸಹೃದಯಮಾತ್ರವೇದ್ಯವು. ಅಗೂಢ ವ್ಯಂಗ್ಯವು ಸ್ಪಷ್ಟವಾಗಿರುವುದರಿಂದ ಎಲ್ಲರಿಗೂ ಚೆನ್ನಾಗಿ ಅರ್ಥವಾಗತಕ್ಕುದು. “उपदिशति कामिनीनां योवनमद एव ललितानि” ಇಲ್ಲಿ ಸ್ತ್ರೀಯರ ಯೌವನಮದವೇ ಅವರ ಲೀಲೆಗಳನ್ನು ಪ್ರಕಟಿಸುತ್ತದೆ ಎಂದು ಅರ್ಥವು. ಅಚೇತನವಾದ ಯೌವನಮದಕ್ಕೆ ಉಪದೇಶ ಸಾಮರ್ಥ್ಯವು ಇಲ್ಲವಾದುದರಿಂದ ಅದು ಬಾಧಿತವಾಗಿ ಲಕ್ಷಣೆಯಿಂದ उपदिशति ಎಂಬ ಪದಕ್ಕೆ ಆವಿಷ್ಕಾರವೆಂಬ ಅರ್ಥವು ಅತಿಸ್ಫುಟವಾಗಿ ತೋರುವುದರಿಂದ ಈ ವ್ಯಂಗವು ಅಗೂಢವು.<br><br>

अगूढगन्ध
अगूढगन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಗು<br><b>व्युत्पत्तिः - </b>न गूढो गन्धो यस्य ।<br><br>

अगूढभाव
अगूढभाव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಪಷ್ಟವಾದ ಅಭಿಪ್ರಾಯವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अगूढो भावो यस्य ।<br><b>प्रयोगाः - </b>“अगूढभावापि विलोकने सा न लोचने मौलयितुं विषेहे” ।<br><b>उल्लेखाः - </b>किरा० ३-३६ ।<br><br>

अगूढभावा
अगूढभावा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಪಷ್ಟವಾದ ಅಭಿಪ್ರಾಯವುಳ್ಳ<br><br>

अगोचर
अगोचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೃಷ್ಟಿಗೆ ಬೀಳದ / ಕಣ್ಣಿಗೆ ಕಾಣಿಸದ / ಅಸ್ಪಷ್ಟವಾದ<br><br>अगोचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯಗಳಿಗೂ ತಿಳಿಯದಿರುವ<br><br>

अग्नायी
अग्नायी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಪತ್ನಿ / ಸ್ವಾಹಾದೇವಿ<br><b>निष्पत्तिः - </b>अग्नेः स्त्री “ऐ” “डीप्” च (४-१-३७) ।<br><br>

अग्नाविष्णु
अग्नाविष्णु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಹವಿಸ್ಸನ್ನು ಸ್ವೀಕರಿಸುವ ಅಗ್ನಿ ಮತ್ತು ವಿಷ್ಣು ದೇವತೆಗಳು<br><b>निष्पत्तिः - </b>“आनङ्” ।<br><br>

अग्नि
अग्नि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆಂಕಿ<br><b>निष्पत्तिः - </b>अगि (गतौ) “निः” (उ० ४-५०) ।<br><b>व्युत्पत्तिः - </b>अङ्गति ।<br><b>प्रयोगाः - </b>“शमीतरुं शुष्कमिवाग्निरुच्छिखः” ।<br><b>उल्लेखाः - </b>किरा० १-३२ ।<br><br>अग्नि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿದೇವತೆ<br><br>अग्नि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣ, ಗಾರ್ಹಪತ್ಯ ಮತ್ತು ಆಹವನೀಯಗಳೆಂಬ ಅಗ್ನಿತ್ರಯ<br><br>अग्नि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಾಠರಾಗ್ನಿ / ಆಹಾರವನ್ನು ಜೀರ್ಣಮಾಡುವ ಒಂದು ಶಕ್ತಿ<br><br>अग्नि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂರು ಸಂಖ್ಯೆ<br><br>अग्नि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿನ್ನ<br><br>अग्नि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರಕ / ಚಿತ್ರಮೂಲ<br><br>अग्नि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಳುಗಿಡ<br><b>विस्तारः - </b>“अग्निर्वैश्वानरेऽपि स्याच्चित्रकाख्यौषधौ पुमान्” - मेदि० ।<br><br>अग्नि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೇರುಮರ<br><b>उल्लेखाः - </b>कल्पद्रु० ।<br><br>

अग्निकण
अग्निकण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಕಿಯ ಕಿಡಿ<br><b>व्युत्पत्तिः - </b>अग्नेः कणः ।<br><br>

अग्निकर्मन्
अग्निकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಕಾರ್ಯ / ಹೋಮ / ಅಗ್ನಿಹೋತ್ರ<br><br>अग्निकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಪೂಜೆ<br><br>अग्निकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿವೈದ್ಯ / ಅಗ್ನಿರಕ್ಷೆ / ಬರೆಹಾಕುವುದು<br><br>

अग्निकला
अग्निकला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಕಿಯ ಒಂದು ಭಾಗ<br><br>

अग्निकाष्ठ
अग्निकाष्ठ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಕಿಯನ್ನುಂಟು ಮಾಡುವ ಕಟ್ಟಿಗೆ / ಹೋಮಾಗ್ನಿಯನ್ನು ಉತ್ಪತ್ತಿಮಾಡುವ ಅರಣಿ<br><br>अग्निकाष्ठ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗುರುಕಾಷ್ಠ<br><b>व्युत्पत्तिः - </b>अग्नेरुद्दीपनं काष्ठम् ।<br><br>

अग्निकुण्ड
अग्निकुण्ड<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೋಮಕ್ಕಾಗಿ ಅಗ್ನಿಯನ್ನು ಪ್ರತಿಷ್ಠಿಸುವ (ಇಡುವ) ಸ್ಥಾನ (ಒಂದು ಜಾಗ)<br><b>व्युत्पत्तिः - </b>अग्नेराधानार्थं कुण्डम् ।<br><br>

अग्निकुमार
अग्निकुमार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ತಿಕೇಯ / ಷಣ್ಮುಖ<br><b>व्युत्पत्तिः - </b>अग्नेः केतुरिव ।<br><br>

अग्निकेतु
अग्निकेतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧೂಮ / ಹೊಗೆ<br><b>व्युत्पत्तिः - </b>अग्नेः केतुरिव ।<br><br>

अग्निकोण
अग्निकोण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಗ್ನೇಯ ದಿಕ್ಕು / ಪೂರ್ವ ಮತ್ತು ದಕ್ಷಿಣದಿಕ್ಕುಗಳ ಮಧ್ಯದ ವಿದಿಕ್ಕು<br><b>व्युत्पत्तिः - </b>अग्निदेवताकः कोणः ।<br><br>

अग्निगर्भ
अग्निगर्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯಕಾಂತ ಶಿಲೆ<br><br>अग्निगर्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಣಿ / ಯಜ್ಞದ ಅಗ್ನಿಯನ್ನು ಉತ್ಪತ್ತಿ ಮಾಡುವ ಕಾಷ್ಠ (ಮರದ ತುಂಡು)<br><b>व्युत्पत्तिः - </b>अग्निगर्भे यस्य ।<br><br>अग्निगर्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಜಾರದ ಮರ<br><br>

अग्निगर्भा
अग्निगर्भा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಮೀಲತೆ<br><b>प्रयोगाः - </b>“अवेहि तनयां ब्रह्मन्निग्निगर्भां शमीमिव” ।<br><b>उल्लेखाः - </b>शाकु० ४-३ ।<br><br>अग्निगर्भा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೃಥ್ವಿ / ಭೂಮಿ<br><b>व्युत्पत्तिः - </b>अग्निः अग्नेर्वा गर्भो यस्याः ।<br><br>अग्निगर्भा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಷ್ಮತೀಲತೆ<br><b>व्युत्पत्तिः - </b>अग्निरिव गर्भो मध्यभागो यस्याः ।<br><br>

अग्निगृह
अग्निगृह<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೋಮಗೃಹ / ಅಗ್ನಿಕಾರ್ಯ ಮಾಡುವ ಮನೆ<br><br>

अग्निचित्
अग्निचित्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯನ್ನು (ಉಪಾಸಿಸುವವನು) ಪೂಜಿಸುವವನು / ಅಗ್ನಿಹೋತ್ರಿ<br><b>निष्पत्तिः - </b>चिञ् (चयने) “क्विप्” (३-२-९१) ।<br><b>व्युत्पत्तिः - </b>अग्निमचैषीत् ।<br><b>प्रयोगाः - </b>“यतिभिः सार्धमनग्निमग्निचित्” ।<br><b>उल्लेखाः - </b>रघु० ८-२५ ।<br><br>

अग्निचित्या
अग्निचित्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯನ್ನು ರಕ್ಷಿಸುವುದು / ಯಾಗಾಗ್ನಿಯನ್ನು ಕಾಪಾಡಿಡುವುದು<br><br>

अग्निज
अग्निज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ತಿಕೇಯ / ಷಣ್ಮುಖ<br><br>अग्निज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯಿಂದ ಉತ್ಪನ್ನವಾದ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) “डः” (३-२-९८) ।<br><b>व्युत्पत्तिः - </b>अग्नेर्जायते ।<br><br>

अग्निजन्मन्
अग्निजन्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ತಿಕೇಯ / ಷಣ್ಮುಖ<br><br>अग्निजन्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುವರ್ಣ / ಚಿನ್ನ<br><b>निष्पत्तिः - </b>अग्नेर्जन्म यस्य ।<br><br>अग्निजन्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯಿಂದ ಹುಟ್ಟಿದ<br><br>

अग्निजिह्व
अग्निजिह्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರಾಹರೂಪಿಯಾದ ವಿಷ್ಣು<br><br>अग्निजिह्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><br>अग्निजिह्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯಂತೆ ನಾಲಿಗೆಯುಳ್ಳವನು<br><br>

अग्निजिह्वा
अग्निजिह्वा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಶಿಖೆ / ಅಗ್ನಿಯ ನಾಲಿಗೆ<br><b>विस्तारः - </b>ಅಗ್ನಿಯ ಏಳು ಜಿಹ್ವೆಗಳು: “कराली धूमिनी श्वेता लोहिता नीललोहिता । सुवर्णा पद्मरागा च जिह्वाः सप्त विभावसोः” ।<br><br>

अग्निज्वाला
अग्निज्वाला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಜಿಹ್ವೆ / ಬೆಂಕಿಯ ಉರಿ<br><b>विस्तारः - </b>“अथ भल्लातकी त्रिषु । पर्यायोऽन्यर्कयोश्चापि वातारिः स्यादरुष्करः” । - कल्पद्रु० ।<br><br>अग्निज्वाला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಜಹಿಪ್ಪಲಿ<br><br>

अग्नितपस्
अग्नितपस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಂಚಾಗ್ನಿಗಳ ಮಧ್ಯದಲ್ಲಿ ನಿಂತು ತಪಸ್ಸುಮಾಡುವವನು<br><b>निष्पत्तिः - </b>तप (सन्तापे) “असुन्” (उ० ४-१८८) ।<br><b>व्युत्पत्तिः - </b>अग्निभिः तप्यते ।<br><br>अग्नितपस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>व्युत्पत्तिः - </b>अग्निरिव तपति ।<br><br>

अग्नितेजस्
अग्नितेजस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಪ್ರಕಾಶ<br><br>अग्नितेजस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯಂತೆ ಪ್ರಕಾಶವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अग्नेरिव तेजो यस्य ।<br><br>

अग्नित्रय
अग्नित्रय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣಾಗ್ನಿ, ಗಾರ್ಹಪತ್ಯ ಮತ್ತು ಆಹವನೀಯಗಳೆಂಬ ಮೂರು ಅಗ್ನಿ<br><br>

अग्निद
अग्निद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆಗೆ ಬೆಂಕಿಯಿಟ್ಟು ಸುಡುವವನು<br><b>निष्पत्तिः - </b>डु दाञ् (दाने) “कः” (३-२-३)।<br><b>व्युत्पत्तिः - </b>अग्नि गृहादौ ददाति ।<br><b>विस्तारः - </b>[ಈತನಿಗೆ ಆತತಾಯಿಯೆಂದು ಹೆಸರು.] “अग्निदो गरदश्चैव शस्त्रपाणिर्धनापहः । क्षेत्रदारापहारी च षडेते ह्याततायिनः” ಎಂದು ಆತತಾಯಿಗಳು ಆರು ಬಗೆ.<br><br>अग्निद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಾಠರಾಗ್ನಿಯನ್ನು ಹೆಚ್ಚುಮಾಡುವ ಔಷಧ; ಲೇಹ್ಯ ಮುಂತಾದುದು<br><br>

अग्निदग्ध
अग्निदग्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರೋಕ್ತವಾಗಿ ಅಗ್ನಿಯಿಂದ ಸುಡಲ್ಪಟ್ಟ<br><br>अग्निदग्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆಂಕಿಯಿಂದ ಸುಡಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>अग्निना दग्धः ।<br><br>

अग्निदमनी
अग्निदमनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯನ್ನು ಆರಿಸುವ ಒಂದು ಜಾತಿಯ ಮುಳ್ಳುಗಿಡ<br><b>निष्पत्तिः - </b>दमु (उपशमे) कर० “ल्युट्” (३-३-११७) ।<br><b>व्युत्पत्तिः - </b>अग्निर्दम्यतेऽनया ।<br><br>

अग्निदातृ
अग्निदातृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರೋಕ್ತವಾಗಿ ಅಗ್ನಿಯಿಂದ ಸುಡುವವನು<br><br>

अग्निदीपन्
अग्निदीपन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಾಠರಾಗ್ನಿಯನ್ನು ಹೆಚ್ಚಿಸುವ ಔಷಧ<br><br>

अग्निदीप्ता
अग्निदीप्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಷ್ಮಶೀಲತೆ / ಮಿಂಚುಬಳ್ಳಿಗಿಡ<br><b>व्युत्पत्तिः - </b>अग्निः जठराग्निः दीप्तो यस्याः ।<br><br>

अग्निदूत
अग्निदूत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯೇ ದೂತನಾಗಿ ಉಳ್ಳ ಯಜ್ಞ<br><br>अग्निदूत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><b>व्युत्पत्तिः - </b>अग्निः दूतो यस्मिन् यस्य वा ।<br><br>

अग्निदेव
अग्निदेव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ<br><br>अग्निदेव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಉಪಾಸಕ<br><b>व्युत्पत्तिः - </b>अग्निर्देवोऽस्य ।<br><br>

अग्निदेवा
अग्निदेवा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತ್ತಿಕಾ ನಕ್ಷತ್ರ<br><b>व्युत्पत्तिः - </b>अग्निर्देवोऽस्याः ।<br><b>विस्तारः - </b>[ಕೃತಿಕಾನಕ್ಷತ್ರಕ್ಕೆ ಅಗ್ನಿಯು ದೇವತೆ.]<br><br>

अग्निनक्षत्र
अग्निनक्षत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತ್ತಿಕಾ ನಕ್ಷತ್ರ<br><b>व्युत्पत्तिः - </b>अग्नेः नक्षत्रम् ।<br><br>

अग्निनेतृ
अग्निनेतृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><b>व्युत्पत्तिः - </b>अग्निः नेता यस्य ।<br><br>

अग्निपद
अग्निपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯನ್ನು ಪ್ರತಿಷ್ಠಿಸುವ ಸ್ಥಳ<br><b>व्युत्पत्तिः - </b>अग्नेः पदम् ।<br><br>अग्निपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿವಾಚಕಪದ / ಅಗ್ನಿಯೆಂಬ ಅರ್ಥವನ್ನು ಕೊಡುವ ಪದ<br><br>

अग्निपर्वत
अग्निपर्वत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ವಾಲಾಮುಖಿ / ಬೆಂಕಿಯನ್ನು ಹೊಂದಿರುವ ಬೆಟ್ಟ<br><br>

अग्निपुच्छ
अग्निपुच्छ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞಶಾಲೆಯ ಹಿಂಭಾಗ<br><br>

अग्निपुराण
अग्निपुराण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹದಿನೆಂಟು ಪುರಾಣಗಳಲ್ಲೊಂದು<br><b>विस्तारः - </b>ವ್ಯಾಸಮಹರ್ಷಿಪ್ರಣೀತವಾದ ಹದಿನೆಂಟು ಪುರಾಣಗಳಲ್ಲಿ ಎಂಟನೆಯ ಪುರಾಣ. ಈ ಪುರಾಣದಲ್ಲಿ ಪರಮಾತ್ಮನ ಅವತಾರ, ಸೃಷ್ಟಿಕ್ರಮ, ವಿಷ್ಣುಪೂಜೆ, ಅಗ್ನಿಪೂಜೆ, ದೀಕ್ಷೆ, ಅಭಿಷೇಕ, ಮಂಟಪಲಕ್ಷಣ, ದೇವಾಲಯನಿರ್ಮಾಣಕ್ರಮ, ಸಾಲಗ್ರಾಮಲಕ್ಷಣ ಮತ್ತು ಪೂಜೆ, ದೇವರಪ್ರತಿಷ್ಠೆ, ಗಂಗಾದಿಪುಣ್ಯತೀರ್ಥಗಳ ಮಹಿಮೆ, ಉರ್ಧ್ವಾಧೋ ಲೋಕವರ್ಣನೆ, ಯಂತ್ರ ಮಂತ್ರ ಔಷಧಗಳು, ಬ್ರಹ್ಮಚರ್ಯಧರ್ಮ, ವೈದಿಕ ಮತ್ತು ಸ್ಮಾತ್ರಕರ್ಮಗಳು, ಪ್ರಾಯಶ್ಚಿತ್ತ, ನರಕನಿರೂಪಣ, ಸಂಧ್ಯಾವಿಧಿ, ಗಾಯತ್ರಿಯ ಅರ್ಥ, ರಾಜ್ಯಾಭಿಷೇಕಕ್ರಮ, ರಾಜಧರ್ಮ, ರತ್ನಲಕ್ಷಣ, ಧನುರ್ವಿದ್ಯೆ, ಛಂದಶ್ಶಾಸ್ತ್ರ, ಸಾಹಿತ್ಯ, ಪುರಾಣಮಾಹಾತ್ಮ್ಯ ಮುಂತಾದ ವಿಷಯಗಳು ಹೇಳಲ್ಪಟ್ಟಿವೆ.<br><br>

अग्निप्रणयन
अग्निप्रणयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರಕ್ರಮದಲ್ಲಿ ಅಗ್ನಿಯ ಸಂಸರಣ<br><br>अग्निप्रणयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯನ್ನು ಬೇರೆ ಕಡೆಗೆ ಒಯ್ಯುವುದು<br><b>व्युत्पत्तिः - </b>अग्नेः प्रणयनम् ।<br><br>

अग्निबाहु
अग्निबाहु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧೂಮ / ಹೊಗೆ<br><b>व्युत्पत्तिः - </b>अग्नेः बाहुरिव ।<br><br>

अग्निभ
अग्निभ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಣ / ಚಿನ್ನ<br><b>निष्पत्तिः - </b>भा (दीप्तौ) “कः” (३-२-४) ।<br><b>व्युत्पत्तिः - </b>अग्निरिव भाति |<br><br>अग्निभ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತ್ತಿಕಾ ನಕ್ಷತ್ರ<br><b>व्युत्पत्तिः - </b>अग्नेः भम् ।<br><br>

अग्निभु
अग्निभु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಣ / ಚಿನ್ನ<br><br>

अग्निभू
अग्निभू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ತಿಕೇಯ / ಷಣ್ಮುಖ<br><b>निष्पत्तिः - </b>भू (सत्तायाम्) “क्विप्” (३-२-१७९) ।<br><b>व्युत्पत्तिः - </b>अग्नेर्भवति |<br><br>अग्निभू<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯಿಂದ ಹುಟ್ಟಿದ<br><br>

अग्निभूति
अग्निभूति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನೆಯತೀರ್ಥಂಕರರ ಶಿಷ್ಯ<br><br>अग्निभूति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಶಕ್ತಿ<br><br>अग्निभूति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂತಿ<br><br>अग्निभूति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯಿಂದ ಹುಟ್ಟಿದ<br><br>

अग्निमणि
अग्निमणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯಕಾಂತಶಿಲೆ<br><b>व्युत्पत्तिः - </b>अग्न्युत्थापको मणिः ।<br><br>

अग्निमत्
अग्निमत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಹಿತಾಗ್ನಿ / ಶಾಸ್ತ್ರೀಯವಾದ ಅಗ್ನಿಯುಳ್ಳವನು / ಪತ್ನಿಯುಳ್ಳ ದ್ವಿಜ<br><b>निष्पत्तिः - </b>“मतप्” (५-२-९४) ।<br><b>व्युत्पत्तिः - </b>अग्निरस्त्यस्य |<br><b>प्रयोगाः - </b>“दारास्वग्निं विनिक्षिप्य प्रवसेदग्निमान् द्विजः” ।<br><br>अग्निमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳ್ಳೆಯ ಜಾಠರಾಗ್ನಿ ಶಕ್ತಿಯುಳ್ಳ / ಜೀರ್ಣಶಕ್ತಿಯುಳ್ಳ<br><br>

अग्निमथ्
अग्निमथ्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗಕ್ಕಾಗಿ ಅರಣಿಯಿಂದ ಅಗ್ನಿಯನ್ನು ಕಡೆಯುವ ಯಾಜ್ಞಿಕ<br><br>अग्निमथ्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಣಿಯನ್ನು ಕಡೆಯುವ ಮಂತ್ರ<br><b>निष्पत्तिः - </b>मन्थ (विलोडने) “क्विप्” (३-२-७६) । मन्थ कर० “क्विप्” (३-२-७६) ।<br><b>व्युत्पत्तिः - </b>अग्निमथ्नाति | अग्निः मथ्यतेऽनेन |<br><br>

अग्निमन्थ
अग्निमन्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನರುವಲುಗಿಡ / ನೆಲ್ಲಿಗಿಡ<br><b>निष्पत्तिः - </b>मन्थ (विलोडने) “घञ्” (३-३-१२१) ।<br><b>व्युत्पत्तिः - </b>अग्निः मथ्यतेऽनेन |<br><br>अग्निमन्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಣಿಯನ್ನು ಕಡೆಯುವ ಮಂತ್ರ<br><br>

अग्निमान्द्य
अग्निमान्द्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಠರಾಗ್ನಿಯ ಶಕ್ತಿಯು ಕಡಿಮೆಯಾಗುವಿಕೆ<br><b>व्युत्पत्तिः - </b>अग्नेः जठरानलस्य मान्द्यम् ।<br><br>

अग्निमित्र
अग्निमित्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಜ / ಪುಷ್ಪಮಿತ್ರನ ಮಗ<br><br>

अग्निमुख
अग्निमुख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><b>व्युत्पत्तिः - </b>अग्निर्मुखमिव यस्य ।<br><b>प्रयोगाः - </b>“अग्निमुखावै देवाः” |<br><b>उल्लेखाः - </b>श्रुतिः ।<br><b>विस्तारः - </b>[ಯಾಗಗಳಲ್ಲಿ ದೇವತೆಗಳನ್ನುದ್ದೇಶಿಸಿ ಕೊಡುವ ಹವಿಸ್ಸನ್ನು ಅಗ್ನಿಯು ಸ್ವೀಕರಿಸಿ ದೇವತೆಗಳಿಗೆ ಒಪ್ಪಿಸುವುದರಿಂದ ಈ ಹೆಸರು.]<br><br>अग्निमुख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಹೋತ್ರಿಯಾದ ಬ್ರಾಹ್ಮಣ<br><b>व्युत्पत्तिः - </b>अग्निः मुखं प्रधानं यस्य ।<br><br>अग्निमुख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣ<br><b>व्युत्पत्तिः - </b>अग्निः शापाग्निः मुखे यस्य ।<br><br>अग्निमुख<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಾಠರಾಗ್ನಿಯನ್ನುಂಟುಮಾಡುವ ಒಂದು ಔಷಧ, ಒಂದು ಚೂರ್ಣ, ಲೇಹ್ಯ ಮುಂತಾದುದು<br><b>व्युत्पत्तिः - </b>अग्नैर्जाठरानलस्य मुखम् ।<br><b>विस्तारः - </b>ಈ ಚೂರ್ಣದ ಯೋಗ: ಇಂಗು 1 ಭಾಗ ಬಜೆ 2 ಭಾಗ ಹಿಪ್ಪಲಿ 3 ಭಾಗ ಹಸಿಶುಂಠಿ 4 ಭಾಗ ಓಮ 5 ಭಾಗ ಅಳಲೆಕಾಯಿ 6 ಭಾಗ ಚಿತ್ರಮೂಲ 7 ಭಾಗ ಮತ್ತು ಚಂಗಲುಕೋಷ್ಠ 8 ಭಾಗ. ಇವುಗಳನ್ನು ಚೂರ್ಣಮಾಡಿ ಮೊಸರಿನಕೆನೆ ಮದ್ಯ ಅಥವಾ ಬಿಸಿನೀರಿನಲ್ಲಿ ಸೇರಿಸಿ ಸೇವಿಸಬೇಕು. ಇದರಿಂದ ಅಜೀರ್ಣ, ಪ್ಲೀಹ, ಅರ್ಶಸ್ಸು (ಮೂಲವ್ಯಾಧಿ), ಶ್ಲೇಷ್ಮರೋಗ, ಗುಲ್ಮ, ಕಾಸ, ಶ್ವಾಸ ಮತ್ತು ಕ್ಷಯ ಇವುಗಳ ಪರಿಹಾರವಾಗುವುದು. 5. ಪಾಕಶಾಲೆ, 6. ಕುಂಕುಮಕೇಸರಿ. 7. ಚಿತ್ರಮೂಲದಗಿಡ. 8. ಕುಸುಂಭದ ಹೂವು. “भवेदग्निमुखो देवे विप्रे भल्लातके स्त्रियाम् । अथाग्निमुखमुद्दिष्टं कुसुम्भे कुङ्कुमेऽपि च” - मेदि० ।<br><br>

अग्निमुखी
अग्निमुखी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೇರುಮರ<br><b>निष्पत्तिः - </b>“डीप्” (४-१-४१) ।<br><b>व्युत्पत्तिः - </b>अग्निरिव मुखं यस्याः |<br><br>अग्निमुखी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಯತ್ರೀಮಂತ್ರ<br><b>व्युत्पत्तिः - </b>अग्नेरिव मुखं मुखत्वेन कल्पितं यस्याः ।<br><b>प्रयोगाः - </b>“कदाचिदपि नो विद्वान् गायत्रीमुदके जपेत् । गायत्र्यग्निमुखी यस्मात्तस्मादुत्थाय तां जपेत्” |<br><b>उल्लेखाः - </b>गोभिलः ।<br><br>अग्निमुखी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರುಹಿಪ್ಪಲಿ<br><br>अग्निमुखी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಣ್ಣೆಬಿದಿರುಸೊಪ್ಪು<br><br>अग्निमुखी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರನ ಸೂಕ್ಷ್ಮವಾದ ರೇಖೆ<br><br>अग्निमुखी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮೃತಬಳ್ಳಿ<br><br>अग्निमुखी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೋಮಲತೆ<br><br>अग्निमुखी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರನ ಕಲೆ (ಹದಿನಾರನೆಯ ಒಂದು ಭಾಗ)<br><b>विस्तारः - </b>“लाङ्गलिकाख्यैपदौ च विशल्यायां च योषिति । इन्दुलेखामृतासोमलताशशिकलासु च” - मेदि० ।<br><br>

अग्निरजस्
अग्निरजस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಪುಬಣ್ಣದ ಇಂದ್ರಗೋಪವೆಂಬ ಹುಳ<br><b>निष्पत्तिः - </b>रञ्ज (रागे) “असुन्” (उ० ४-१८८) ।<br><b>व्युत्पत्तिः - </b>अग्निरिव रज्यते दीप्यते |<br><br>अग्निरजस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಣ / ಚಿನ್ನ<br><br>अग्निरजस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಶಕ್ತಿ<br><br>

अग्निरहस्य
अग्निरहस्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಉಪಾಸನೆಯ ಕ್ರಮವನ್ನು ತಿಳಿಸುವ ಶಾಸ್ತ್ರ<br><br>

अग्निरूप
अग्निरूप<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಕಿಯ ಸ್ವಭಾವ<br><br>अग्निरूप<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಪುರುಷನ ಸ್ವರೂಪ<br><br>अग्निरूप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಗೆ ಸಮಾನವಾದ ರೂಪವುಳ್ಳ<br><br>

अग्निवधू
अग्निवधू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯಪತ್ನಿ / ಸ್ವಾಹಾದೇವಿ<br><br>

अग्निवर्ण
अग्निवर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯವಂಶದ ಒಬ್ಬ ರಾಜ<br><b>प्रयोगाः - </b>“अग्निवर्णमभिषिच्य राघवः” |<br><b>उल्लेखाः - </b>रघु० १९-१ ।<br><br>अग्निवर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಕಿಯ ಬಣ್ಣ<br><br>अग्निवर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆಂಕಿಗೆ ಸಮಾನವಾದ ವರ್ಣವುಳ್ಳ<br><br>

अग्निवर्धक
अग्निवर्धक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಾಠರಾಗ್ನಿಯನ್ನು ಬಲಪಡಿಸುವ ಔಷಧ<br><br>अग्निवर्धक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುಷ್ಟಿಕರವಾದ<br><br>

अग्निवाह
अग्निवाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧೂಮ / ಹೊಗೆ<br><br>अग्निवाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಕೆ / ಆಡು<br><b>निष्पत्तिः - </b>वह (प्रापणे)+णिच् “अण्” (३-२-१) ।<br><b>व्युत्पत्तिः - </b>अग्निं वाहयति गमयति|<br><br>अग्निवाह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯನ್ನು ವಹಿಸಿರುವ<br><br>

अग्निवाहन
अग्निवाहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಕೆ / ಆಡು<br><b>व्युत्पत्तिः - </b>अग्नेः वाहनम् ।<br><br>

अग्निविद्
अग्निविद्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಹೋತ್ರಿ<br><br>अग्निविद्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಉಪಾಸನಾಶಾಸ್ತ್ರವನ್ನರಿತವನು<br><b>निष्पत्तिः - </b>विद (ज्ञाने) “क्विप्” (३-२-६१) ।<br><b>व्युत्पत्तिः - </b>अग्निं वेत्ति |<br><br>

अग्निविश्
अग्निविश्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇದ್ದಿಲು<br><b>विस्तारः - </b>“अङ्गारोऽस्त्री प्रशान्ताचिरिङ्गालः कारिकाग्निविट्” - वैज० ।<br><br>

अग्निवीर्य
अग्निवीर्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಣ / ಚಿನ್ನ<br><br>अग्निवीर्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಶಕ್ತಿ<br><br>

अग्निशरण
अग्निशरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಕಾರ್ಯವನ್ನು ಮಾಡುವ ಗೃಹ / ಹೋಮಗೃಹ / ಯಜ್ಞಶಾಲೆ<br><br>

अग्निशाला
अग्निशाला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೋಮಗೃಹ / ಯಜ್ಞಶಾಲೆ<br><br>

अग्निशिख
अग्निशिख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೀಪ<br><br>अग्निशिख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾಶಬಾಣ<br><br>अग्निशिख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣ<br><br>अग्निशिख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಸುಬೆಗಿಡ<br><br>अग्निशिख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಕುಮಕೇಸರಿ<br><br>अग्निशिख<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಣ / ಚಿನ್ನ<br><br>अग्निशिख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯಂತೆ ಅಗ್ರವುಳ್ಳ<br><br>अग्निशिख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯಂತೆ ಜಟೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अग्निरिव शिखा यस्य ।<br><br>

अग्निशिखा
अग्निशिखा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಜ್ವಾಲೆ / ಬೆಂಕಿಯ ಉರಿ<br><br>अग्निशिखा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ಹಿಪ್ಪಲಿ<br><br>अग्निशिखा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಲು ಕುಟುಕನ ಗಿಡ<br><br>अग्निशिखा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಣ್ಣೆ ಬಿದಿರಿನ ಸೊಪ್ಪು<br><br>अग्निशिखा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೋಮಲತೆ<br><br>अग्निशिखा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮೃತಬಳ್ಳಿ<br><br>अग्निशिखा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರನ ಸೂಕ್ಷ್ಮವಾದ ರೇಖೆ<br><br>अग्निशिखा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರನ ಕಲೆ (ಹದಿನಾರನೆಯ ಒಂದು ಭಾಗ)<br><b>विस्तारः - </b>“अग्निशिखा लाङ्गलिक्यामिन्दुलेखेन्दुखण्डके । गूडुचीसोमलतयोह्” - हेम० ।<br><br>

अग्निष्टोम
अग्निष्टोम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯನ್ನು ಸ್ತೋತ್ರಮಾಡುವ ಯಾಗ / ಜ್ಯೋತಿಷ್ಟೋಮದ ಒಂದು ಅಂಗಯಾಗ<br><b>व्युत्पत्तिः - </b>अग्नेः स्तोमः स्तुतिसाघनं यत्र ।<br><br>अग्निष्टोम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆರನೇ ಮನುವಿನ ಮಗ<br><br>

अग्निसंस्कार
अग्निसंस्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರೋಕ್ತವಾಗಿ ಅಗ್ನಿಯಿಂದ ಮಾಡುವ ಸಂಸ್ಕಾರ<br><br>

अग्निसङ्काश
अग्निसङ्काश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಗೆ ಸಮಾನವಾದ ವರ್ಣವುಳ್ಳ / ಅಗ್ನಿಗೆ ಸಮಾನವಾದ ತೇಜಸ್ಸುಳ್ಳ<br><br>

अग्निसम्भव
अग्निसम्भव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಣ / ಚಿನ್ನ<br><br>अग्निसम्भव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯಿಂದ ಹುಟ್ಟಿದ<br><br>

अग्निसख
अग्निसख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯು / ಗಾಳಿ<br><b>निष्पत्तिः - </b>“टच्” (५-४-९१) ।<br><b>व्युत्पत्तिः - </b>अग्नेः सखा |<br><br>

अग्निसाक्षिक
अग्निसाक्षिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯೇ ಸಾಕ್ಷಿಯಾಗಿ ಉಳ್ಳ ಕೆಲಸ / ಅಗ್ನಿಯ ಮುಂದೆ ಮಾಡುವ ಕಾರ್ಯ<br><b>व्युत्पत्तिः - </b>अग्निः साक्षी यत्र ।<br><b>प्रयोगाः - </b>“चक्रेऽग्निसाक्षिकं सख्यम्” |<br><b>उल्लेखाः - </b>रामा० ।<br><br>

अग्निसात्
अग्निसात्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಗೆ ಅಧೀನವಾಗಿ<br><b>प्रयोगाः - </b>“न चकार शरीरमग्निसात्” |<br><b>उल्लेखाः - </b>रघु० ८-७२ ।<br><br>

अग्निसार
अग्निसार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಸಾಂಜನ / ಕಣ್ಣಿನ ಮುಲಾಮು / ಕಣ್ಣಿಗೆ ಹಾಕುವ ಅಂಜನ<br><br>

अग्निसूत्र
अग्निसूत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೌಂಜೀಮೇಖಲೆ / ಬ್ರಹ್ಮಚಾರಿಗಳು ನಡುವಿಗೆ ಕಟ್ಟುವ ಮೌಂಜಿ<br><br>

अग्निस्तम्भ
अग्निस्तम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಶಕ್ತಿಯ ತಡೆ<br><br>अग्निस्तम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಶಕ್ತಿಯನ್ನು ತಡೆಗಟ್ಟುವ ಮಂತ್ರ<br><br>अग्निस्तम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಶಕ್ತಿಯನ್ನು ತಡೆಗಟ್ಟುವ ಮಂತ್ರ<br><br>अग्निस्तम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಶಕ್ತಿಯನ್ನು ತಡೆಗಟ್ಟುವ ಔಷಧ<br><b>निष्पत्तिः - </b>स्तन्भु (रोधने) (सौत्रो धातुः) “घञ्” (३-३-१२१) ।<br><b>व्युत्पत्तिः - </b>अग्निः स्तभ्यतेऽनेन |<br><br>

अग्निहोत्र
अग्निहोत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ<br><br>अग्निहोत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹವಿಸ್ಸು<br><b>विस्तारः - </b>“अग्निहोत्रोऽग्निहविषोः” - मेदि० ।<br><br>अग्निहोत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಕಾರ್ಯ / ಹೋಮ<br><b>व्युत्पत्तिः - </b>अग्निः हूयतेऽव ।<br><br>

अग्निहोत्रहवनी
अग्निहोत्रहवनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>. ಹೋಮದಲ್ಲಿ ಹವಿಸ್ಸನ್ನು ತೆಗೆಯಲು ಉಪಯೋಗಿಸುವ ಸವಟು<br><br>अग्निहोत्रहवनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹವಿಸ್ಸನ್ನು ತೆಗೆಯುವ ಋಕ್ಕು / ಮಂತ್ರ<br><b>निष्पत्तिः - </b>हु(दानादनयोः) “ल्युट्” (३-३-११७) |<br><b>व्युत्पत्तिः - </b>अग्निहोत्रः अग्निःहूयतेऽनया |<br><br>

अग्निहोत्रिन्
अग्निहोत्रिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಹೋತ್ರವುಳ್ಳವನು / ವಿಹಿತಕಾಲದಲ್ಲಿ ಅಗ್ನಿಕಾರ್ಯವನ್ನು ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>“इनिः” (५-२-११५) ।<br><b>व्युत्पत्तिः - </b>अग्निहोत्रमस्यास्ति ।<br><br>

अग्नीध्
अग्नीध्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಋತ್ವಿಕ್ಕು / ಯಾಜಕ<br><b>निष्पत्तिः - </b>ञि इन्धी (दीप्तौ) :क्विप्: (३-२-७६) ।<br><b>व्युत्पत्तिः - </b>अग्निमिन्धे ।<br><br>

अग्नीवरुण
अग्नीवरुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಹವಿಸ್ಸನ್ನು ಸ್ವೀಕರಿಸುವ ಅಗ್ನಿ ಮತ್ತು ವರುಣ ದೇವತೆಗಳು<br><b>निष्पत्तिः - </b>“ईत्” (६-३-२७) ।<br><b>व्युत्पत्तिः - </b>अग्निश्च वरुणश्च ।<br><br>

अग्नीषोम
अग्नीषोम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಹವಿಸ್ಸನ್ನು ಸ್ವೀಕರಿಸುವ ಅಗ್ನಿ ಮತ್ತು ಸೋಮದೇವತೆಗಳು<br><b>निष्पत्तिः - </b>(६-३-२७) ।<br><b>व्युत्पत्तिः - </b>अग्निश्च सोमश्च ।<br><br>

अग्नीषोमीय
अग्नीषोमीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ ಮತ್ತು ಸೋಮದೇವತೆಗಳಿಗೆ ಸಂಬಂಧಿಸಿದ<br><b>निष्पत्तिः - </b>“छः” (४-२-३२) ।<br><b>व्युत्पत्तिः - </b>अग्नीषोमौ देवते अस्य ।<br><br>

अग्नेन्द्र
अग्नेन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಹವಿಸ್ಸನ್ನು ಸ್ವೀಕರಿಸುವ ಅಗ್ನಿ ಮತ್ತು ಇಂದ್ರದೇವತೆಗಳು<br><b>निष्पत्तिः - </b>“आनङ्” । गुणः (६-१-८७) ।<br><b>व्युत्पत्तिः - </b>अग्निश्च इन्द्रश्च ।<br><br>

अग्न्यगार
अग्न्यगार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಗೃಹ / ಹೋಮಾಗ್ನಿಯನ್ನು ರಕ್ಷಿಸಿಡುವ ಗೃಹ<br><b>व्युत्पत्तिः - </b>अग्नेः अगारम् ।<br><b>प्रयोगाः - </b>“वसंश्चतुर्थोऽग्निरिवाग्न्यगारे” ।<br><b>उल्लेखाः - </b>रघु० ५-२५ ।<br><br>

अग्न्याधान
अग्न्याधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಸ್ಥಾಪನೆ / ಅಗ್ನಿಯ ಪ್ರತಿಷ್ಠೆ<br><b>व्युत्पत्तिः - </b>अग्नेराधानम् ।<br><br>

अग्न्याहित
अग्न्याहित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಹೋತ್ರಿ / ವೈದಿಕಾಗ್ನಿಯುಳ್ಳ ಬ್ರಾಹ್ಮಣ<br><b>निष्पत्तिः - </b>परिनिपातः (२-२-३७) ।<br><b>व्युत्पत्तिः - </b>आहिताः आधानेन संस्कृताः अग्नयो येन ।<br><br>

अग्न्युत्पात
अग्न्युत्पात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯಿಂದ ಸೂಚಿತವಾದ ಅನಿಷ್ಟ<br><br>अग्न्युत्पात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನಿಷ್ಟಸೂಚಕವಾದ ಬೆಂಕಿಯ ಸುರಿಮಳೆ<br><br>अग्न्युत्पात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧೂಮಕೇತು<br><b>व्युत्पत्तिः - </b>अग्नेः उत्पातः ।<br><br>

अग्न्युपस्थान
अग्न्युपस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಪೂಜೆ<br><b>व्युत्पत्तिः - </b>अग्नेरूपस्थानम् ।<br><br>अग्न्युपस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಪೂಜೆಯ ಮಂತ್ರ<br><b>निष्पत्तिः - </b>ष्ठा (गतिनिवृत्तौ) “ल्युट्” (३-३-११७) ।<br><b>व्युत्पत्तिः - </b>अग्निरूपस्थीयतेऽनेन ।<br><br>

अग्र
अग्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೋಡದಿರುವ ವಸ್ತುವನ್ನು ಕಾಣುವ ಸ್ವಪ್ನ / ಕನಸು<br><b>विस्तारः - </b>“संस्कारमात्रजः स्वप्नः कामिको रसकोऽपि च । अदुष्टजस्त्वत्रचाग्रः” - वैज० ।<br><br>अग्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಊರ್ಧ್ವಭಾಗ / ಮೇಲುಭಾಗ<br><b>निष्पत्तिः - </b>अग (कुटिलायां गतौ) “रन्” (उ० २-२९) ।<br><b>प्रयोगाः - </b>“पद्मानि यस्याग्रसरोरुहाणि” ।<br><b>उल्लेखाः - </b>कुमा० १-१६ ।<br><br>अग्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂಭಾಗ / ಎದುರು ಭಾಗ<br><b>प्रयोगाः - </b>“आनीतमग्रे निजबन्धनार्थम्” ।<br><b>उल्लेखाः - </b>याद० ४-३४ ।<br><br>अग्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಲಂಬನ / ವಿಶ್ರಾಂತಿಸ್ಥಾನ<br><br>अग्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೂಹ / ಗುಂಪು<br><br>अग्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ರಭಾಗ / ತುದಿ<br><b>प्रयोगाः - </b>“प्रणर्तितानेकलताभुजाग्रान्” ।<br><b>उल्लेखाः - </b>माघ० ४-७ ।<br><br>अग्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಪಲದ ತೂಕ<br><br>अग्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣಭೋಜನ / ಬ್ರಾಹ್ಮಣಭೋಜನಕ್ಕಾಗಿ ಬಿಟ್ಟಿರುವ ವೃತ್ತಿ, ದಾನ<br><br>अग्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಕರ್ಷ / ಶ್ರೇಷ್ಠತೆ / ಮೇಲ್ಮೆ<br><br>अग्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಂತಭಾಗ / ಸಮೀಪಪ್ರದೇಶ<br><b>प्रयोगाः - </b>“हर्म्याग्रसंरूढतृणाङ्कुरेषु” ।<br><b>उल्लेखाः - </b>रघु० ६-४७ ।<br><br>अग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊದಲನೆಯ / ಪ್ರಧಾನ / ಮುಖ್ಯ / ಪ್ರಮುಖ<br><br>अग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕ / ಹೆಚ್ಚಾದ<br><br>अग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊದಲನೆಯ / ಒಂದನೆಯ<br><b>विस्तारः - </b>“अग्रं पुरस्तादुपरि परिमाणे पलस्य च । आलम्बने समूहे च प्राण्ते च स्यान्नपुंसकम् । अधिके च प्रधाने च प्रथमे चाभिधेयवत्” - मेदि० ।<br><br>

अग्रकाय
अग्रकाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹದ ಪುರ್ವಭಾಗ<br><b>व्युत्पत्तिः - </b>अग्रश्चासौ कायश्च ।<br><br>

अग्रग
अग्रग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದೆ ಹೋಗುವ / ಮುಂದೆ ನಡೆಯುವ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) “डः” (वा० ३-२-४८) ।<br><b>व्युत्पत्तिः - </b>अग्रे गच्छति ।<br><br>

अग्रगण्य
अग्रगण्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಧಾನ / ಮುಖ್ಯ<br><br>अग्रगण्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊದಲು ಎಣಿಸಲು ಅರ್ಹವಾದ<br><b>निष्पत्तिः - </b>गण (सङ्ख्याने) “यत्” (३-१-९७) ।<br><b>व्युत्पत्तिः - </b>अग्रे गण्यते ।<br><br>

अग्रगामिन्
अग्रगामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದೆ ಹೋಗುವ / ಮುಂದೆ ನಡೆಯುವ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) ।<br><b>व्युत्पत्तिः - </b>अग्रे गच्छति । अग्रगामिनी ।<br><br>

अग्रज
अग्रज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠ ಸಹೋದರ / ಹಿರಿಯಣ್ಣ<br><b>प्रयोगाः - </b>“अग्रजेन हरिणा हरिः स्वयम्” ।<br><b>उल्लेखाः - </b>याद० १७-५ ।<br><br>

अग्रजन्मन्
अग्रजन्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣ<br><br>अग्रजन्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠ ಸಹೋದರ<br><br>अग्रजन्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊದಲು ಹುಟ್ಟಿದ<br><b>व्युत्पत्तिः - </b>अग्रे जन्म यस्य ।<br><br>

अग्रजात
अग्रजात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣ<br><br>अग्रजात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠ ಸಹೋದರ<br><b>व्युत्पत्तिः - </b>अग्रे जातः ।<br><br>अग्रजात<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠ ಸಹೋದರಿ<br><br>अग्रजात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊದಲು ಹುಟ್ಟಿದ<br><br>

अग्रजाति
अग्रजाति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣ<br><b>व्युत्पत्तिः - </b>अग्रा श्रेष्ठा जातिर्यस्य ।<br><br>

अग्रणी
अग्रणी<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ / ಬೆಂಕಿ<br><b>व्युत्पत्तिः - </b>अग्रं नयति देवेभ्यः ।<br><br>अग्रणी<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಭು / ಯಜಮಾನ<br><br>अग्रणी<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>“अग्रणीर्ग्रामिणीं श्रीमान्” ।<br><b>उल्लेखाः - </b>वि० स० ।<br><br>अग्रणी<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠ<br><br>अग्रणी<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದಾಳು<br><b>प्रयोगाः - </b>“अथाङ्गिरसमग्रण्यम्” ।<br><b>उल्लेखाः - </b>कुमा० ६-६५ ।<br><br>

अग्रतस्
अग्रतस्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಮುಂದೆ / ಮುಂಭಾಗದಲ್ಲಿ<br><b>निष्पत्तिः - </b>अग्रे “तसिः” (५-४-४४) ।<br><b>प्रयोगाः - </b>“धनुर्भृतामग्रत एव रक्षिणाम्” ।<br><b>उल्लेखाः - </b>रघु० ३-३९ ।<br><br>

अग्रतःसर
अग्रतःसर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದೆ ನಡೆಯುವ / ಮುಂದಾಳಾಗಿರುವ<br><b>निष्पत्तिः - </b>सृ(गतौ) “टः” (३-२-१८) ।<br><b>व्युत्पत्तिः - </b>अग्रतः सरति गच्छति ।<br><br>

अग्रनासिका
अग्रनासिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಗಿನ ತುದಿ<br><br>

अग्रपाद
अग्रपाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂಗಾಲು / ಕಾಲಿನ ಮುಂಭಾಗ<br><b>प्रयोगाः - </b>“नवकिसलयरागेणाग्रपादेन बाला” ।<br><b>उल्लेखाः - </b>माल० ३-१२ ।<br><br>

अग्रपूजा
अग्रपूजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ರಮರ್ಯಾದೆ / ಮೊದಲನೆಯ ಮರ್ಯಾದೆ<br><b>व्युत्पत्तिः - </b>अग्रे पूजा ।<br><br>

अग्रभागिन्
अग्रभागिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊದಲನೇ ಹಕ್ಕುದಾರ / ವಾರಸುದಾರ<br><b>व्युत्पत्तिः - </b>अग्रे भागी ।<br><br>

अग्रभागिनी
अग्रभागिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಾರಸುದಾರೆ<br><b>निष्पत्तिः - </b>स्त्रियां “डीप्” (४-१-५) ।<br><br>

अग्रभुज्
अग्रभुज्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>(ಎಲ್ಲರಿಗಿಂತಲೂ) ಮುಂಚೆ ಊಟಮಾಡುವವನು / ತಿಂಡಿಪೋತ / ಹೊಟ್ಟೇಬಾಕ<br><b>निष्पत्तिः - </b>भुज(पालनाभ्यवहाअयोः) “क्विप्” (३-२-७६) ।<br><b>व्युत्पत्तिः - </b>अग्रे भुङ्क्ते ।<br><br>

अग्रभू
अग्रभू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿರಿಯವನು / ಮೊದಲು ಹುಟ್ಟಿದವನು / ಜ್ಯೇಷ್ಠ ಸಹೋದರ<br><b>निष्पत्तिः - </b>भू (सत्तायाम्) “क्विप्” (३-२-७६) ।<br><b>व्युत्पत्तिः - </b>अग्रे भवति ।<br><br>

अग्रमांस
अग्रमांस<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೃದಯದೊಳಗಿನ (ಮುಖ್ಯವಾದ) ಮಾಂಸ<br><b>व्युत्पत्तिः - </b>अग्रं मुख्यं मांसम् ।<br><br>

अग्रयण
अग्रयण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾರ್ಗಶಿರಮಾಸದಲ್ಲಿ ಹೊಸಧ್ಯಾನ ಬಂದಮೇಲೆ ಮಾಡುವ ಯಾಗ<br><b>निष्पत्तिः - </b>“अच्” (५-२-१२७) ।<br><b>व्युत्पत्तिः - </b>अग्रं अयनात् उत्तरायणात् । शक० । तत्कालोऽस्यास्ति ।<br><b>विस्तारः - </b>[ಪ್ರತಿವರ್ಷದಲ್ಲೂ ಹೊಸಧಾನ್ಯ ಬಂದಾಗ ಮೊದಲು ದೇವತೆಗಳಿಗೆ ಅರ್ಪಿಸಿ ಅನಂತರ ನಾವು ಉಪಯೋಗಿಸಬೇಕು. ಇದಕ್ಕೆ “ನವಾಗ್ರಯಣ” ಸ್ಥಾಲೀಪಾಕವೆಂದು ಹೆಸರು.]<br><br>

अग्रयान
अग्रयान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂದೆಹೋಗುವ ಸೈನ್ಯ<br><br>अग्रयान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದೆಹೋಗುವ<br><b>व्युत्पत्तिः - </b>अग्रे यानं यस्य ।<br><br>

अग्रयायिन्
अग्रयायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದೆ ಹೋಗುವ<br><br>अग्रयायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠನಾದ<br><b>निष्पत्तिः - </b>या (प्रापणे) “णिनिः” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अग्रे याति ।<br><br>

अग्रयोधिन्
अग्रयोधिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಖ್ಯವೀರ / ಸೈನ್ಯದ ಮುಂದೆ ನಿಂತು ಯುದ್ಧಮಾಡುವವನು<br><b>निष्पत्तिः - </b>युध (सम्प्रहारे) “णिनिः” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अग्रे स्थित्वा युध्यति ।<br><br>

अग्ररन्ध्र
अग्ररन्ध्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂಭಾಗದ ರಂಧ್ರ / ಮುಂದಿನ ಸಂದು<br><b>प्रयोगाः - </b>“त्रासान्नासाग्ररन्ध्रं विशति फणिपतौ भोगसङ्कोचभाजि” ।<br><b>उल्लेखाः - </b>मालती० १-२ ।<br><br>

अग्रसन्धानी
अग्रसन्धानी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಮರಾಜನ ಪಟ್ಟ / ಪ್ರಾಣಿಗಳ ಪೂರ್ವಜನ್ಮದ ಕರ್ಮಕ್ಕೆ ತಕ್ಕ ಫಲಗಳನ್ನು ಸೂಚಿಸುವ ಪಟ್ಟ<br><b>निष्पत्तिः - </b>सम् + डु घाञ् (धारणे) “ल्युट्” (३-३-११७) । “डीप्” (४-१-१५) ।<br><b>व्युत्पत्तिः - </b>अग्रे फलोत्पत्तेः प्राक् सन्धीयते शुभाशुभफलं ज्ञायतेऽनया ।<br><br>

अग्रसन्ध्या
अग्रसन्ध्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಧ್ಯಾಕಾಲದ ಮುಂಚಿನ ಕಾಲ<br><b>व्युत्पत्तिः - </b>अग्रं सन्ध्यायाः ।<br><br>अग्रसन्ध्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾತಃಸಂಧ್ಯಾ ಸಮಯ<br><b>व्युत्पत्तिः - </b>अग्रा चासौ सन्ध्या च ।<br><br>

अग्रसर
अग्रसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂದಾಳು / ಮುಂದೆ ಹೋರಾಡುವ ವೀರ<br><b>निष्पत्तिः - </b>सृ (गतौ) “टः” बाहु० ।<br><b>व्युत्पत्तिः - </b>अग्रे सरति ।<br><b>प्रयोगाः - </b>“हरिहयाघ्रसरेण धनुर्भृता” ।<br><b>उल्लेखाः - </b>रघु० ९-२३ ।<br><br>

अग्रह
अग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯತಿ / ಸಂನ್ಯಾಸಿ<br><b>व्युत्पत्तिः - </b>न ग्रहः परिग्रहो यस्य ।<br><br>अग्रह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜ್ಞಾನಶೂನ್ಯ / ತಿಳಿವಳಿಕೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न ग्रहो ज्ञानं यस्य ।<br><br>

अग्रहस्त
अग्रहस्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂಗೈ / ಕೈಯ ತುದಿ<br><b>व्युत्पत्तिः - </b>अग्रश्चासौ हस्तश्च ।<br><b>प्रयोगाः - </b>“अथाग्रहस्ते मुकुलीकृताङ्गुलौ” ।<br><b>उल्लेखाः - </b>कुमा० ५-६३ ।<br><br>

अग्रहायण
अग्रहायण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾರ್ಗಶೀರ್ಷಮಾಸ / ಹೊಸಧಾನ್ಯ ಬರುವ ಕಾಲ / ವರ್ಷಾರಂಭ<br><b>निष्पत्तिः - </b>णत्वम् (८-४-३) ।<br><b>व्युत्पत्तिः - </b>अग्रः श्रेष्ठः हायनो व्रीहिरत्र ।<br><br>

अग्रहार
अग्रहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜರುಗಳಿಂದ ಬ್ರಾಹ್ಮಣರಿಗೆ ದಾನವಾಗಿ ಕೊಡಲ್ಪಡುವ ಜಮೀನು ಅಥವಾ ಗ್ರಾಮ<br><b>निष्पत्तिः - </b>अग्र+हृञ् (हरणे) कर्म० “घञ्” (३-३-१९) ।<br><b>व्युत्पत्तिः - </b>अग्रं ब्राह्मणभोजनं तदर्थं ह्रियते पृथक् क्रियते राजधनात् ।<br><br>अग्रहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>(ಜಮೀನಿನ ಬೆಳೆಯಿಂದ ಬ್ರಾಹ್ಮಣರಿಗೆ ದಾನಕೊಡುವ ಉದ್ದೇಶದಿಂದ ತೆಗೆದಿಡುವ) ಧಾನ್ಯ<br><br>अग्रहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>(ಗುರುಕುಲದಿಂದ ವಿದ್ಯಾಭ್ಯಾಸ ಮುಗಿಸಿಕೊಂಡು ಬಂದ) ಬ್ರಹ್ಮಚಾರಿಗೆ ಕೊಡುವ ಭೂಮಿ, ಗ್ರಾಮ ಅಥವಾ ವೃತ್ತಿ<br><br>

अग्राक्षि
अग्राक्षि<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಾಂಗ / ಕಡೆಗಣ್ಣು<br><b>व्युत्पत्तिः - </b>अग्रं च तत् अक्षि च ।<br><b>प्रयोगाः - </b>“अग्राक्ष्या वीक्षमाणस्तु तिर्यग्भ्रातरमब्रवीत्” ।<br><b>उल्लेखाः - </b>रामा० ।<br><br>

अग्राम्य
अग्राम्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಗರದಲ್ಲಿ ಹುಟ್ಟಿದ / ಸುಶಿಕ್ಷಿತನಾದ / ಸಭ್ಯತೆಯಿಂದಕೂಡಿದ<br><br>अग्राम्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಂದರವಾದ / ಚೆಲುವಾಗಿರುವ<br><b>निष्पत्तिः - </b>ग्रामे भवः “यः” (४-२-९४) ।<br><b>व्युत्पत्तिः - </b>न ग्राम्यः ।<br><br>

अग्रासन
अग्रासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರಾದ್ಧದಲ್ಲಿ ಬ್ರಾಹ್ಮಣನಿಗೆ ಕಲ್ಪಿತವಾದ ಆಸನ<br><b>व्युत्पत्तिः - </b>अग्रं अर्धादिदानात् पूर्वं कल्पितमासनम् ।<br><br>अग्रासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂಭಾಗದಲ್ಲಿರುವ ಆಸನ / ಮೊದಲನೆಯ ಆಸನ<br><b>प्रयोगाः - </b>“मामग्रासनतोऽवकुष्टमवशं ये दुष्टवन्तः पुरा” ।<br><b>उल्लेखाः - </b>मुद्रा० १-१२ ।<br><br>

अग्राह्य
अग्राह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಳ್ಳಲು ಅಯೋಗ್ಯವಾದ<br><br>अग्राह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಗ್ರಹಕ್ಕೆ ಅನರ್ಹವಾದ<br><b>व्युत्पत्तिः - </b>न ग्राह्यम् ।<br><br>

अग्रिम
अग्रिम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊದಲನೆಯವನು / ಜ್ಯೇಷ್ಠ ಸಹೋದರ<br><b>निष्पत्तिः - </b>“डिमच्” (वा० ४-३-२३) ।<br><b>व्युत्पत्तिः - </b>अग्रे भवः ।<br><br>अग्रिम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತಮ / ಶ್ರೇಷ್ಠ<br><br>अग्रिम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊದಲನೆಯ<br><b>प्रयोगाः - </b>“अग्रिमं विशतां स्कन्धमामूलमहितां चमूम्” ।<br><b>उल्लेखाः - </b>याद० १६-९२ ।<br><br>

अग्रिय
अग्रिय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠ ಸಹೋದರ<br><b>निष्पत्तिः - </b>“घः” (४-४-११७) ।<br><b>व्युत्पत्तिः - </b>अग्रे भवः ।<br><br>अग्रिय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ / ಉತ್ತಮವಾದ<br><br>अग्रिय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊದಲು ಹುಟ್ಟಿದ<br><br>

अग्रीय
अग्रीय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠ ಸಹೋದರ<br><br>अग्रीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ / ಉತ್ತಮವಾದ<br><b>निष्पत्तिः - </b>“छः” (४-४-११७) ।<br><b>व्युत्पत्तिः - </b>अग्रे भवः ।<br><br>अग्रीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊದಲು ಹುಟ್ಟಿದ<br><br>

अग्रे
अग्रे<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಮುಂಭಾಗದಲ್ಲಿ / ಎದುರಿಗೆ<br><br>अग्रे<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭದಲ್ಲಿ / ಮೊದಲು<br><b>प्रयोगाः - </b>“प्रतापोऽये ततः शब्दः परागस्तदनन्तरम्” ।<br><b>उल्लेखाः - </b>रघु० ४-३० ।<br><br>अग्रे<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಮುಂಚಿತವಾಗಿ / ಪೂರ್ವದಲ್ಲಿ<br><br>अग्रे<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಅನಂತರ / ಬಳಿಕ / ತರುವಾಯ<br><br>अग्रे<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಸಮಕ್ಷದಲ್ಲಿ / ಸಾನ್ನಿಧ್ಯದಲ್ಲಿ<br><br>

अग्रेग
अग्रेग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದೆಹೋಗುವ / ಮುಂದೆ ನಡೆಯುವ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) “डः” (वा० ३-२-४८) ।<br><b>व्युत्पत्तिः - </b>अग्रे गच्छति ।<br><br>अग्रेग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದಾಳು / ಯಜಮಾನ<br><br>

अग्रेगू
अग्रेगू<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂಭಾಗದಲ್ಲಿ ಹೋಗುವ. (ಸೇವಕ ಮುಂತಾದವನು)<br><br>

अग्रेदिधिषु|अग्रेदिधिषू
अग्रेदिधिषु / अग्रेदिधिषू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಿಧಿಷುವನ್ನು ಮದುವೆಯಾದವನು / ಜ್ಯೇಷ್ಠ ಸಹೋದರನ ಮರಣಾನಂತರ ಅವನ ಪತ್ನಿಯನ್ನು ಮದುವೆಯಾದವನು / ದಿಧಿಷುವೇ ಯಾವನ ಮನೆಯಲ್ಲಿ ಯಜಮಾನೆಯೋ ಅವನು<br><b>निष्पत्तिः - </b>षो (अन्तकर्मणि) “कू” (उ० १-९३) ।<br><b>व्युत्पत्तिः - </b>दिधिं धैर्यं स्यति स्यजति इन्द्रियदौर्बल्यात् । अग्रे प्रधानं दिधिषूर्यस्य ।<br><b>विस्तारः - </b>(ಎರಡುಸಲ ಮದುವೆಯಾದವಳು ದಿಧಿಷು) 1. ‘भ्रातुर्मृतस्य जायायं संसक्तो दिढिषूपतिः । स तु स्यादग्रदिधिषुर्योऽनुजो रमते तया । स्यादग्रेदिधिषुश्चासौ स्यादग्रेदिधिषूरपि” - वैज० । 2. “स तु द्विजोऽयेदिधिषूः सैव यस्य कुटुम्बिनी” - अम० ।<br><br>

अग्रेदिधिषू
अग्रेदिधिषू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠ ಸಹೋದರಿಯು ಮದುವೆಯಾಗುವುದಕ್ಕೆ ಮುಂಚೆ ಮದುವೆಯಾದವಳು<br><b>विस्तारः - </b>“या ज्येष्ठायामनूढायामूढग्रेदिधिषूरसौ” - वैज० ।<br><br>

अग्रेदिधिषूपति
अग्रेदिधिषूपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ಕನ ಮದುವೆಗೆ ಮುಂಚೆ ಮದುವೆಯಾದವಳ ಗಂಡ<br><br>

अग्रेवण
अग्रेवण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರಣ್ಯದ ಮುಂಭಾಗದಲ್ಲಿ<br><b>निष्पत्तिः - </b>परनिपातः (२-२-३१) । णत्वम् (८-४-४-) ।<br><b>व्युत्पत्तिः - </b>वनस्याग्रे ।<br><b>प्रयोगाः - </b>“रुध्वाध्वानमनल्पकोपमकरोदग्रेवणं रावणम्” ।<br><b>उल्लेखाः - </b>च० रा० ३-५७ ।<br><br>

अग्रेसर
अग्रेसर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದೆ ಹೋಗುವ / ಮುಂದೆ ನಡೆಯುವ<br><b>निष्पत्तिः - </b>सृ (गतौ) “टः” (३-२-१८) ।<br><b>व्युत्पत्तिः - </b>अग्रे सरति ।<br><b>प्रयोगाः - </b>“बिभूतिमग्रेसरखेदवादाः” ।<br><b>उल्लेखाः - </b>याद० २-३५ ।<br><br>

अग्रेसरी
अग्रेसरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂದೆ ಹೋಗುವ / ಮುಂದೆ ನಡೆಯುವ<br><b>निष्पत्तिः - </b>स्त्रियां “डीप्” (४-१-१५) ।<br><br>

अग्र्य
अग्र्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠ ಸಹೋದರ<br><b>निष्पत्तिः - </b>“यत्” (४-४-११६) ।<br><b>व्युत्पत्तिः - </b>अग्र भवः ।<br><b>प्रयोगाः - </b>“स्वसुतमग्न्यमसूयत रोहिणी” ।<br><b>उल्लेखाः - </b>याद० ३-४५ ।<br><br>अग्र्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ / ಉತ್ತಮವಾದ<br><b>प्रयोगाः - </b>“वधूवरं पुष्यति कान्तिमभ्याम्” ।<br><b>उल्लेखाः - </b>कुमा० ७-७८ ।<br><br>अग्र्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊದಲು ಹುಟ್ಟಿದ<br><br>

अघ
अघ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಘಾಸುರ / ಒಬ್ಬ ರಾಕ್ಷಸ<br><br>अघ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><b>निष्पत्तिः - </b>अघि (गतौ) “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अङ्घते गच्छति दानादिना ।<br><b>प्रयोगाः - </b>“अघौघविध्वंसविधौ पटीयसीः” ।<br><b>उल्लेखाः - </b>माघ० १-१८ ।<br><br>अघ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದುಃಖ<br><b>प्रयोगाः - </b>“श्रियं विकर्षत्यपहन्त्यधानि श्रेयः परिस्नौति तनोति कीर्तिम्” ।<br><b>उल्लेखाः - </b>किरा ३-७ ।<br><br>अघ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಶೌಚ<br><br>

अघकृत्
अघकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪಕಾರ್ಯವನ್ನು ನಡೆಸುವವನು<br><br>अघकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೇಡಿಗ / ಕೇಡಾಳಿ<br><b>निष्पत्तिः - </b>डु कृञ् (करणे) “क्विप्” (३-२-१७८) ।<br><b>व्युत्पत्तिः - </b>अघं पापं करोति ।<br><br>

अघघ्न|अघनाशन
अघघ्न-नाशन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣ<br><br>अघघ्न-नाशन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪವನ್ನು ನಾಶಪಡಿಸುವ ಜಪ ಮತ್ತು ದಾನ<br><b>निष्पत्तिः - </b>हन (हिंसादौ) “कः” (वा० ३-२-५) । णश (अदर्शने) + णिच् “स्युः” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अघं हन्ति । अघं नाशयति ।<br><br>

अघभोजिन्
अघभोजिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವರು ಮತ್ತು ಅತಿಥಿಗಳ ಉದ್ದೇಶವಿಲ್ಲದೆ ಕೇವಲ ಆತ್ಮಾರ್ಥ (ತನಗಾಗಿ) ಪಾಕಮಾಡಿ ತಿನ್ನುವವನು<br><b>निष्पत्तिः - </b>भुज (पालनादौ) “णिनिः” (३-२-७८) ।<br><b>व्युत्पत्तिः - </b>अघं भुङ्क्ते ।<br><b>प्रयोगाः - </b>“भुञ्जते ते त्वघं पापा ये पचन्त्यात्मकारणात्” ।<br><b>उल्लेखाः - </b>गीता ३-१३ ।<br><br>

अघमर्षण
अघमर्षण<br><br><b>पदविभागः - </b>त्रिलिङ्गः<br><b>कन्नडार्थः - </b>ಸಕಲ ಪಾಪಗಳ ನಾಶಕ್ಕಾಗಿ ಜಪಿಸುವ ಮಂತ್ರ<br><b>निष्पत्तिः - </b>मृष (तितिक्षायाम) “ल्युट्” (३-३-११७) ।<br><b>व्युत्पत्तिः - </b>मृश्यतेऽनेन । अघस्य मर्षणः ।<br><br>अघमर्षण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಕಲ ಪಾಪಗಳ ನಾಶಕ್ಕಾಗಿ ಜಪಿಸುವ ಮಂತ್ರ<br><b>विस्तारः - </b>अघमर्षणो मन्त्रः ।<br><br>

अघमर्षणी
अघमर्षणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಕಲ ಪಾಪಗಳ ನಾಶಕ್ಕಾಗಿ ಜಪಿಸುವ ಮಂತ್ರ<br><b>निष्पत्तिः - </b>टित्वात् “डीप्” (४-१-१५) ।<br><b>विस्तारः - </b>अघमर्षणी ऋक् ।<br><br>

अघरुद्
अघरुद्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪವನ್ನು ಹೋಗಲಾಡಿಸುವ ಮಂತ್ರ<br><b>निष्पत्तिः - </b>रुदिर् (अश्रुविमोचने) “क्विप्” (३-२-७६) ।<br><b>व्युत्पत्तिः - </b>अघं रोदिति यस्मात् स्वकर्माक्षमतया ।<br><br>अघरुद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪವನ್ನು ತುಳಿಯಲು ಪ್ರತಿಕ್ರಿಯೆ ಮಾಡುವ ಶಕ್ತಿಯಿಲ್ಲದೆ ದುಃಖಿಸುವ<br><b>निष्पत्तिः - </b>रुदिर् कर्त० “क्विप्” (३-२-७६) ।<br><b>व्युत्पत्तिः - </b>अघे रोदिति ।<br><br>

अघर्म
अघर्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಷ್ಣತೆ / ಶೈತ್ಯ<br><b>विस्तारः - </b>न० त०।<br><br>अघर्म<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶೀತವಾಗಿರುವ<br><b>प्रयोगाः - </b>“अधर्मधर्मोदकविन्दुमौक्तिकैरलञ्चकारास्य वधूरहस्करः” ।<br><b>उल्लेखाः - </b>माघ ० १-५८ ।<br><br>

अघल
अघल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪನಾಶಕ / ಪಾಪವನ್ನು ಹೋಗಲಾಡಿಸುವ<br><b>निष्पत्तिः - </b>ला (आदाने) “कः” (३-२-३) ।<br><b>व्युत्पत्तिः - </b>अघं निवर्तयितुं लाति ।<br><br>

अघवत्
अघवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪದಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>“मतुप्” (५-२-९४) ।<br><b>व्युत्पत्तिः - </b>अघमस्यास्ति<br><br>

अघायुस्
अघायुस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪಕೃತ್ಯದಿಂದ ಜೀವಿಸಿರುವವನು<br><b>व्युत्पत्तिः - </b>अघं पापसाधनमायुरस्य ।<br><br>

अघ्न्य
अघ्न्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಜಾಪತಿ / ಬ್ರಹ್ಮ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) “यक्” (उ० ४-१११) निषा० ।<br><b>व्युत्पत्तिः - </b>न हन्यते ।<br><br>

अघ्न्या
अघ्न्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸು /ಆಕಳು<br><br>

अघ्रेय
अघ्रेय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ<br><br>अघ्रेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುರ್ಗಂಧ ವಸ್ತು<br><b>निष्पत्तिः - </b>घ्रा(गन्धोपादाने) “यत्” (३-१-९८) ।<br><b>व्युत्पत्तिः - </b>न घ्रातुमर्हः ।<br><br>

अङ्क
अङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಂಛನ / ಗುರುತು / ಚಿಹ್ನೆ<br><b>प्रयोगाः - </b>“रतिबलयपदाङ्के चापमासज्य कण्ठे” ।<br><b>उल्लेखाः - </b>कुमा० २-६४ ।<br><br>अङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಳಂಕ<br><b>निष्पत्तिः - </b>अकि (लक्षणे) “घञ्” (३-३-१२१) ।<br><b>व्युत्पत्तिः - </b>अङ्क्यतेऽनेन ।<br><b>प्रयोगाः - </b>“एको हि दोषो गुणसन्निपाते निमज्जतीन्दोः किरणेष्विवाङ्कः” ।<br><b>उल्लेखाः - </b>कुमा० १-३ ।<br><br>अङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಸಂಗ / ತೊಡೆ<br><b>प्रयोगाः - </b>“अङ्काद्ययावङ्कमुदीरिताशीः सा मण्डनान्मण्डनमन्वभुङ्क्त” ।<br><b>उल्लेखाः - </b>कुमा० ७-५ ।<br><br>अङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಟಕದ ಒಂದು ಭಾಗ<br><b>प्रयोगाः - </b>“प्रत्यक्षनेतृचरितो विन्दुव्यक्तिपुरस्कृतः । अङ्को नानाप्रकारार्थसंविधानरसाश्रयः” ।<br><br>अङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಟಕಾದಿ ಹತ್ತು ರೂಪಕಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>“उत्सृष्टिकाङ्क एकाङ्को नेतारः प्राकृतानराः । रसोऽत्र करुणः स्थायी बहुस्त्रीपरिदेवितम् । प्रख्यातमितिवृत्तं च कविर्बुद्ध्या प्रपञ्चयेत्” ।<br><b>उल्लेखाः - </b>सा० द० ।<br><br>अङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರಯುದ್ಧ<br><br>अङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪ<br><b>प्रयोगाः - </b>“प्रेम्णोपकण्ठं मुहुरङ्कभाजो रत्नावलीरम्बुधिराबबन्ध”।<br><b>उल्लेखाः - </b>माघ० ३-३६ ।<br><br>अङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಾನ<br><br>अङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><br>अङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದುಃಖ<br><br>अङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪರಾಧ / ತಪ್ಪು<br><br>अङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರೇಖೆ / ಗೆರೆ<br><br>अङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲಂಕಾರ / ಒಡವೆ / ಭೂಷಣ<br><b>विस्तारः - </b>1. “अङ्कः स्थानेऽन्तिके मन्तौ रूपकोत्सङ्गलक्ष्मसु । नाटकाडिपरिच्छेद चित्रयुद्धे च भूषणे” - विश्व० । 2. “अङ्को रूपकभेदागश्चिह्नरेखाजिभूषणे । रूपकांशान्तिकोत्सङ्गे स्थानेऽङ्कं पापदुःखयोः” - मेदि० ।<br><br>अङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶರೀರ / ದೇಹ<br><br>अङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತ / ಬೆಟ್ಟ<br><br>अङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಖ್ಯೆ / ಅಂಕಿ<br><br>अङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿ<br><b>विस्तारः - </b>ಮೇದಿನಿಯಲ್ಲಿ ಪಾಪ ಮತ್ತು ದುಃಖ ಎಂಬ ಅರ್ಥಗಳಲ್ಲಿ ನಪುಂಸಕಲಿಂಗದಲ್ಲಿದೆ. “अङ्को नाटकविच्छेदे सङ्ख्यायां युधिभूषणे । समीपे रूपके स्थाने मतावुत्सङ्गचिह्नयोः” -नानार्थर० ।<br><br>

अङ्कति
अङ्कति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯು / ಗಾಳಿ<br><b>निष्पत्तिः - </b>अञ्चु (गतौ) “अतिः” कादेशश्च (उ० ४-६१) ।<br><b>व्युत्पत्तिः - </b>अञ्चति गच्छति |<br><b>विस्तारः - </b>“नभः प्राणोऽङ्कतिः सरः । आशुगः पवनः स्पर्शः” - वैज० ।<br><br>अङ्कति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ / ಬೆಂಕಿ<br><br>अङ्कति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ / ಚತುರ್ಮುಖ<br><br>अङ्कति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಹೋತ್ರಿ<br><b>विस्तारः - </b>“अङ्कुतिर्वह्निवेधसोः । अग्निहोत्रिणि” - हेम० ।<br><br>

अङ्कधारण
अङ्कधारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುರುತನ್ನು ಹೊಂದುವುದು / ಗುರುತು ಹಾಕಿಕೊಳ್ಳುವುದು<br><br>अङ्कधारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಪ್ತ ಮುದ್ರಾಧಾರಣ / ವೈಷ್ಣವಮತದ ಗುರುತಾದ ಶಂಖ ಚಕ್ರಾದಿಧಾರ್ಅಣ<br><b>निष्पत्तिः - </b>धृञ् (धाअणे) + णिव् भावे “ल्युट्” (३-३-११५) । भावे युचिस्त्रियाम् ।<br><b>व्युत्पत्तिः - </b>अङ्कस्य धारणम् । अङ्कधारणा ।<br><br>

अङ्कन
अङ्कन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುರುತು / ಚಿಹ್ನೆ<br><b>निष्पत्तिः - </b>अकि (लक्षणे) “ल्युट्” (३-३-११७) ।<br><b>व्युत्पत्तिः - </b>अङ्क्यतेऽनेन ।<br><b>प्रयोगाः - </b>“स्नेहाङ्कनानि मम मुग्धदृशश्च कण्ठे” ।<br><b>उल्लेखाः - </b>मालती० ९-४८ ।<br><br>अङ्कन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುರುತು ಹಾಕುವುದು / ಮುದ್ರೆ ಹಾಕುವುದು<br><b>निष्पत्तिः - </b>अकि भावे “ल्युट्” (३-३-११५) । भावे युचि ।<br><b>व्युत्पत्तिः - </b>अङ्क्यते । अङ्कना ।<br><br>

अङ्कपालि|अङ्कपाली
अङ्कपालि / ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಡೆಯ ತುದಿ / ಅಂಕಪೀಠ<br><b>व्युत्पत्तिः - </b>अङ्कस्य पालिः ।<br><br>अङ्कपालि / ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಔಷಧ<br><br>अङ्कपालि / ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಾದಿ / ಉಪಮಾತೆ<br><b>विस्तारः - </b>“अथ गदद्रुहि । धाभ्यां पाल्यां चाङ्कपालिः” - वैज० ।<br><br>अङ्कपालि / ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಲಿಂಗನ<br><b>प्रयोगाः - </b>“तावद्राढं वितर सकृदप्यङ्कपालि प्रसीद” ।<br><b>उल्लेखाः - </b>मालती० ८-२ ।<br><br>

अङ्कपूरण
अङ्कपूरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಕಿಗಳನ್ನು ತುಂಬುವುದು<br><b>व्युत्पत्तिः - </b>अङ्कानां पूरणम् ।<br><br>

अङ्कबन्ध
अङ्कबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೊಡೆಯನ್ನು ಕಟ್ಟಿಕೊಂಡು ಕುಳಿತುಕೊಳ್ಳುವುದು<br><b>व्युत्पत्तिः - </b>अङ्कस्य बन्धः ।<br><br>

अङ्कलोप
अङ्कलोप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಳಿಯುವಿಕೆ / ವಜಾ ಮಾಡುವುದು / ವ್ಯವಕಲನ<br><b>व्युत्पत्तिः - </b>अङ्कस्य वियोज्यसङ्ख्य़ायाः लोपः ।<br><br>

अङ्कस्
अङ्कस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶರೀರ / ದೇಹ<br><br>अङ्कस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಹ್ನೆ / ಗುರುತು<br><b>निष्पत्तिः - </b>अञ्चु (गतौ) “असुन्” कादेशश्च (उ० ४-२१५) ।<br><br>

अङ्कावतार
अङ्कावतार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಟಕ (ರೂಪಕ)ಗಳಲ್ಲಿ ಮುಂದಿನ ಅಂಕದ ಪ್ರಾರಂಭದ ವಿಷಯವನ್ನು ಸೂಚಿಸುವ ಒಂದು ಕಥಾಭಾಗ / ಹಿಂದಿನ ಅಂಕದ ಕೊನೆಯ ಕಥಾಭಾಗವೇ ಮುಂದಿನ ಅಂಕದ ಪ್ರಾರಂಭದಲ್ಲೂ ಸೇರಿದಹಾಗೆ ವರ್ಣಿಸಲ್ಪಡುವಂತೆ ಪೂರ್ವಾಂಕಾಂತ ಪಾತ್ರದಿಂದ ಮಾಡುವ ಮುನ್ಸೂಚನೆ<br><b>निष्पत्तिः - </b>अव + तु (प्लवनतरणयोः) भावे “घञ्” (३-३-१८) । अव + तु (प्लवनतरणयोः) भावे “ल्युट्” (३-३-११५) ।<br><b>व्युत्पत्तिः - </b>अवतरणम् ।<br><b>प्रयोगाः - </b>“अङ्कान्ते सूचितः पात्रैस्तदङ्कस्याविभागतः । यत्राङ्कोऽवतरत्येषोऽङ्कावतार इति स्मृतः” ।<br><b>उल्लेखाः - </b>सा० द० ६०५८ ।<br><b>विस्तारः - </b>ಮಾಲವಿಕಾಗ್ನಿಮಿತ್ರದಲ್ಲಿ “तेन हि द्वावेव वर्गौ प्रेक्षागृहे सङ्गीतरचनां कृत्वा तत्रभवतोर्दूतं प्रे---- । अथवा मृदङ्गशब्द एव न उपस्थापयिष्यति” ಎಂಬ ಮೊದಲನೇ ಅಂಕದ ಕೊನೆಯಲ್ಲಿ ವಿದೂಷಕನ ವಾಕ್ಯವು ಅಂಕಾವತಾರವು.<br><br>

अङ्कित
अङ्कित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುರುತು / ಚಿಹ್ನೆ<br><b>निष्पत्तिः - </b>अकि (लक्षणे) भावे “क्तः” (३-३-११४) ।<br><br>अङ्कित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುರುತುಹಾಕಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अकि (लक्षणे) “क्तः” (३-२-१०२) ।<br><br>

अङ्किन्
अङ्किन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೃದಂಗ ಮದ್ದಳೆ (ಮುಂತಾದುದು)<br><b>निष्पत्तिः - </b>“इनिः” (५-२-११५) ।<br><b>व्युत्पत्तिः - </b>अङ्कः आलिङ्गनसाधनत्वेत्नास्य अस्ति ।<br><br>

अङ्कुर
अङ्कुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಳಿಕೆ<br><b>निष्पत्तिः - </b>अकि (लक्षणे) “उरच्” (उ० १-३८) ।<br><b>प्रयोगाः - </b>“बीजाङ्करः प्रागुदयादिवाम्भः” ।<br><b>उल्लेखाः - </b>कुमा० ३-१८ ।<br><br>अङ्कुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ / ನೀರು<br><br>अङ्कुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ತ<br><br>अङ्कुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೂದಲು<br><br>अङ्कुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಗ್ಗು<br><b>प्रयोगाः - </b>1. “चूताङ्कुरास्वादकषायकण्ठः पुस्कोकिलो यन्मधुरं चुकूज” |<br><b>उल्लेखाः - </b>1. कुमा० ३-३२ ।<br><b>विस्तारः - </b>“अङ्कुरो रुधिरे लोम्नि पानीयेऽभिनवोद्भिदि” - मेदि० ।<br><br>

अङ्कुरक
अङ्कुरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಶುಪಕ್ಷ್ಯಾದಿಗಳ ವಾಸಸ್ಥಾನ<br><br>

अङ्कुरित
अङ्कुरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊಳಿಕೆ ಹೊರಟಿರುವ / ಅಂಕುರಿಸಿದ<br><b>निष्पत्तिः - </b>“इतच्” (५-२-३६) ।<br><b>व्युत्पत्तिः - </b>अङ्कुरोऽस्य सञ्जातः |<br><br>

अङ्कुश
अङ्कुश<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯನ್ನು ಶಿಕ್ಷಿಸಲು ಉಪಯೋಗಿಸುವ ಮುಳ್ಳುಕೋಲು / ಮೊನೆಯಾದ ಮತ್ತು ತುದಿಯಲ್ಲಿ ಬಗ್ಗಿದ ಕಬ್ಬಿಣದ ಆಯುಧ<br><b>निष्पत्तिः - </b>अकि (लक्षणे) “उशच्” (उ० ४-१०७) |<br><b>व्युत्पत्तिः - </b>अङ्क्यतेऽनेन |<br><b>प्रयोगाः - </b>“अङ्कुशेन निशितेन हस्तिपः” |<br><b>उल्लेखाः - </b>याद० १७-६७ ।<br><br>

अङ्कुशग्रह
अङ्कुशग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾವಟಿಗ<br><b>निष्पत्तिः - </b>ग्रह (उपादाने) “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अङ्कुशस्य ग्रहः |<br><b>प्रयोगाः - </b>“अन्वेतुकामोऽवमताङ्कुशग्रहः” |<br><b>उल्लेखाः - </b>माघ० १२-१६ ।<br><br>

अङ्कुशदुर्धर
अङ्कुशदुर्धर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುಷ್ಟಗಜ / ಅಂಕುಶಕ್ಕೂ ಅಡಗದ ಆನೆ<br><b>व्युत्पत्तिः - </b>आङ्कुशेन दुर्धरः ।<br><br>

अङ्कुशधारिन्
अङ्कुशधारिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾವಟಿಗ<br><b>निष्पत्तिः - </b>धृञ् (धारणे)<br><b>व्युत्पत्तिः - </b>धरति ।<br><br>

अङ्कुशमुद्रा
अङ्कुशमुद्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಕುಶಾಕಾರದ ಮುದ್ರೆ / ತಂತ್ರೋಕ್ತವಾದ ಒಂದು ಮುದ್ರೆ<br><b>प्रयोगाः - </b>“ऋज्वीं च मध्यमां कृत्वा तन्मध्यं पर्वमूलतः । तर्जनीं किञ्चिदाकुञ्चेत् सा मुद्राऽङ्कुशसञ्ज्ञिता ।<br><b>विस्तारः - </b>[ನೆಟ್ಟಗೆ ಬಿಚ್ಚಿದ ಮಧ್ಯಮ ಬೆರಳಿನ ಮಧ್ಯದ ಗಿಣ್ಣಿಗೆ ಸರಿಯಾಗಿ ತರ್ಜನೀ ಬೆರಳನ್ನು ಸ್ವಲ್ಪ ಬಗ್ಗಿಸಿ ತೋರುವುದು ಅಂಕುಶ ಮುದ್ರೆಯು.]<br><br>

अङ्कूर
अङ्कूर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಳಿಕೆ<br><b>निष्पत्तिः - </b>अकि (लक्षणे) “ऊराः” (उ० ४-९०) ।<br><b>प्रयोगाः - </b>“वाताङ्कूराजिहीर्षादरविवृ--- फणाशृङ्गभूषाभुजङ्गम्”<br><b>उल्लेखाः - </b>चं० भा० ।<br><br>अङ्कूर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ / ನೀರು<br><br>अङ्कूर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಗ್ಗು<br><br>अङ्कूर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ತ,<br><br>अङ्कूर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೂದಲು<br><b>प्रयोगाः - </b>"अङ्कूरसवङ्कुरस्तुल्यौ” ।<br><b>उल्लेखाः - </b>द्विरूप० ।<br><br>

अङ्कोट
अङ्कोट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಕೋಲೆಗಿಡ<br><b>निष्पत्तिः - </b>अकि (लक्षणे) “ओटः” बाहु० ।<br><br>

अङ्क्य
अङ्क्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೃದಂಗ / ತೊಡೆಯಮೇಲಿಟ್ಟು ಬಾರಿಸುವ ವಾದ್ಯ<br><b>निष्पत्तिः - </b>“यत्” (४-३-५५) ।<br><b>व्युत्पत्तिः - </b>अङ्के उत्सङ्गे भवः।<br><b>विस्तारः - </b>“मृदङ्गा मुरजाभेदास्त्वङ्यालिङ्योर्ध्वकास्त्रयः” - अम० ।<br><br>

अङ्ग
अङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವಯವ<br><br>अङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹ / ಶರೀರ<br><b>निष्पत्तिः - </b>अगि (गतौ) “अच्” (३-१-१३४) ।<br><b>प्रयोगाः - </b>“अङ्गानि वध्वाः कुलवृद्धनायः प्रसाधनैरन्तरयाम्बभूवुः” ।<br><b>उल्लेखाः - </b>याद० १३-८२ ।<br><br>अङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಾಯ<br><b>प्रयोगाः - </b>“सर्वकायशरीरेषु मुक्त्वाङ्गस्कन्धपञ्चकम्” । “मन्त्रो योधः इवधीरः सर्वाङ्गैः संवृत्तैरपि” | “सर्वैर्बलाङ्गैर्द्विरदप्रधानैः” |<br><b>उल्लेखाः - </b>माघ० २-२८ । माघ० २-२९ । रघु० ७-५९ ।<br><b>विस्तारः - </b>“हस्त्यश्वरथपादातं सेनाङ्गम्” - अम० ।<br><br>अङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಭಾಗ / ವಸ್ತುವಿನ ಒಂದು ಅಂಶ / ಸಂಸ್ಥೆಯ ಒಂದು ಭಾಗ<br><b>विस्तारः - </b>ಉದಾ: (क) ಸೇನಾಂಗಳು ನಾಲ್ಕು: (೧) ಆನೆ, 2) ಕುದುರೆ, (೩) ರಥ ಮತ್ತು (4) ಕಾಲಾಳು. (ख) (1) ಮಂತ್ರಾಂಗಗಳು ಐದು: (1) १. सहायाः, २.साधनोपायाः ३. देशकालविभागः, ४. विनिपातप्रतीकारः ५. सिद्धिः । [(೧) ಕಾರ್ಯದ ಆರಂಭೋಪಾಯ, (೨) ಪುರುಷಸಂಪತ್ತು ಮತ್ತು ದ್ರವ್ಯಸಂಪತ್ತು, (೩) ದೇಶ ಮತ್ತು ಕಾಲಗಳ ವಿಭಾಗ, (೪) ಅನರ್ಥಗಳ ಪ್ರತಿಕ್ರಿಯೆ ಮತ್ತು (೫) ಕಾರ್ಯ ಸಿದ್ದಿ.] (2) ಜ್ಯೋತಿಶ್ಶಾಸ್ತ್ರದಲ್ಲಿ ಪಂಚಾಂಗಗಳು: (1) ತಿಥಿ, (೨) ವಾರ, (೩) ನಕ್ಷತ್ರ, (೪) ಯೋಗ ಮತ್ತು (೫) ಕರಣ. (3) ಸಂಗೀತದ ತಾಳಾಂಗಗಳು ಐದು: (1) ಅನುದ್ರುತ, (2) ದ್ರುತ, (3) ಲಘು, (4) ಗುರು ಮತ್ತು (5) ಪ್ಲುತ. (ग) ವೇದಾಂಗಗಳು ಆರು” (1) ಶಿಕ್ಷೆ, (೨) ವ್ಯಾಕರಣ, (೩) ಛಂದಸ್ಸು, (೪) ನಿರುಕ್ತ, (೫) ಜ್ಯೋತಿಷ ಮತ್ತು (೬) ಕಲ್ಪ. (घ) (1) ರಾಜ್ಯಾಂಗಗಳು ಏಳು: (1) ಸ್ವಾಮಿ,(2) ಅಮಾತ್ಯ, 3) ಸುಹೃತ್ತು, (4) ಕೋಶ (ಬೊಕ್ಕಸ), (5) ರಾಷ್ಟ್ರ, (6) ದುರ್ಗ (ಕೋಟೆ) ಮತ್ತು (7) ಬಲ (ಸೈನ್ಯ). (2) ವೃಕ್ಷಾಂಗಗಳು ಏಳು: (1) ಸ್ಕಂಧ (ಬುಡದಿಂದ ಕೊಂಬೆಯವರೆಗೂ ಇರುವ ದೂಲ), (2) ಕೊಂಬೆ, (3) ಪರ್ಣ (ಎಲೆ), (4) ಪುಷ್ಪ, (5) ಫಲ, (6) ಮೂಲ (ಬೇರು) ಮತ್ತು (7) ವಲ್ಕಲ (ತೊಗಟೆ ಸಿಪ್ಪೆ). (ङ) (1) ಯೋಗಾಂಗಳು ಎಂಟು: (1)ಯಮ, (2)ನಿಯಮ, (3) ಆಸನ, (4) ಪ್ರಾಣಾಯಾಮ, (5) ಪ್ರತ್ಯಾಹಾರ, (6) ಧಾರಣ, (7) ಧ್ಯಾನ ಮತ್ತು (8) ಸಮಾಧಿ. (೨) ನಮಸ್ಕಾರದ ಅಂಗಗಳು ಎಂಟು: (1) ಭುಜಗಳು, (2) ಪಾದಗಳು, (3) ಮಂಡಿಗಳು, (4) ವಕ್ಷಸ್ಸು (ಎದೆ), (5) ಲಲಾಟ (ಹಣೆ), (6) ದೃಷ್ಟಿ, (7) ಮನಸ್ಸು ಮತ್ತು (8) ಮಾತು. [ಈ ಎಂಟು ಅಂಗಗಳಿಂದ ಮಾಡುವ ನಮಸ್ಕಾರವು ಸಾಷ್ಟಾಂಗಪ್ರಣಾಮವೆನಿಸಿಕೊಳ್ಳುವುದು.] “दोर्म्यां पद्भ्यां च जानुभ्यामुरसा शिरसा दृशा । मनस वचसा चेति प्रणामोऽष्टाङ्ग ईरितः” वैद्यना० आह्निक० । (च) ನಾಟಕೀಯಾಂಗಗಳು ಅರವತ್ತನಾಲ್ಕು: उपक्षेपः, परिकरः, परिन्यासः, विलोभनम्, युक्तिः, प्राप्तिः ಇತ್ಯಾದಿ ೬೪ ಅಂಗಗಳು. [सा० द० 6ನೇ ಪರಿಚ್ಛೇದ ನೋಡಿ.]<br><br>अङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ರಧಾನ / ಅಮುಖ್ಯ<br><b>प्रयोगाः - </b>“अङ्गी रौद्ररसस्तत्र सर्वेऽङ्गानि रसाः पुनः” |<br><b>उल्लेखाः - </b>सा० द० ६-२४२ ।<br><b>विस्तारः - </b>ಉದಾ: ಅಂಗರಸಗಳು<br><br>अङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣಶಾಸ್ತ್ರೋಕ್ತವಾದ ಅಂಗಸಂಜ್ಞೆ<br><b>विस्तारः - </b>ಯಾವುದಾದರೊಂದು ಶಬ್ದಸ್ವರೂಪವು ಅದರೆ ಮುಂದೆ ಒಂದು ಪ್ರತ್ಯಯವು ವಿಹಿತವಾದರೆ ಅಂಗಸಂಜ್ಞೆಯನ್ನು ಹೊಂದುವುದು. ಉದಾ: राम ಶಬ್ದಕ್ಕ “टा” ಪ್ರತ್ಯಯವು ವಿಹಿತವಾದಾಗ राम ಎಂಬ ಶಬ್ದ ಸ್ವರೂಪವು ಅಂಗಸಂಜ್ಞ್ಯನ್ನು ಹೊಂದುವುದು.<br><br>अङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ತ / ಮನಸ್ಸು<br><br>अङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಗ್ನ<br><br>अङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗದೇಶ ಮತ್ತು ಅಂಗದೇಶವಾಸಿಗಳು<br><br>अङ्ग<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಸಂಬೋಧನ ಮತ್ತು ಕೋಶಕಾರರು<br><b>प्रयोगाः - </b>“अङ्ग, अस्ति कश्चिद्विमर्दको नामात्रभवतः” |<br><b>उल्लेखाः - </b>दशकु० ।<br><br>अङ्ग<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಜಾಗ್ರತೆಯಾಗಿ<br><br>अङ्ग<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಪುನಃ / ಮತ್ತೆ<br><br>अङ्ग<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಸಂಗಮ<br><br>अङ्ग<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಅಸೂಯೆ<br><br>अङ्ग<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಹರ್ಷ / ಸಂತೋಷ<br><b>प्रयोगाः - </b>“क्षिप्रे च पुनरर्थे च सङ्गमासूययोस्तथा । हर्षे संशोधने चैव ह्यङ्गशब्दः प्रयुज्यते” ।<br><br>अङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>निष्पत्तिः - </b>“अच्” (५-२-१२७) ।<br><b>व्युत्पत्तिः - </b>अङ्गान्यस्य सन्ति अङ्गमस्यास्ति वा |<br><b>विस्तारः - </b>“उपायगात्रयोरङ्गवानङ्ग उच्यते” - शाश्व० ।<br><br>

अङ्गकर्मन्
अङ्गकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹಾಲಂಕಾರ / ಮೈಯನ್ನು ಉಜ್ಜಿ ಗಂಧ ಮೊದಲಾದವುಗಳನ್ನು ಬಳಿಯುವುದು<br><b>व्युत्पत्तिः - </b>अङ्गस्य कर्म मर्दनानुलेपनादिपरिकर्म ।<br><br>अङ्गकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಧಾನವಾದ ಯಾಗಕ್ಕೆ ಅಂಗಭೂತವಾದ ಇತರ ಕಾರ್ಯ<br><br>

अङ्गज
अङ्गज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರ / ಮಗ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) “डः” (३-२-९८) ।<br><b>व्युत्पत्तिः - </b>अङ्गात् जायते |<br><br>अङ्गज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೋಮ / ಮೈಕೂದಲು<br><br>अङ्गज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ / ಮನ್ಮಥ<br><b>व्युत्पत्तिः - </b>अङ्गात् मनसः जायते ।<br><br>अङ्गज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗ / ವ್ಯಾಧಿ<br><br>अङ्गज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ತ<br><br>अङ्गज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೇಹದಿಂದ ಹುಟ್ಟಿದ<br><b>विस्तारः - </b>“अङ्गजं रुधिरेऽनङ्गकेशपुत्रगदेषु ना” - मेदि० ।<br><br>

अङ्गजा
अङ्गजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರಿ, ಮಗಳು<br><b>निष्पत्तिः - </b>स्त्रियाम् “टाप्” (४-१-४) ।<br><br>

अङ्गण
अङ्गण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗಳ / ತೊಟ್ಟಿ / ಗೋಡೆಗಳಿಂದ ಅಥವಾ ಕಟ್ಟಡಗಳಿಂದ ಸುತ್ತುವರಿದಿರುವ ಪ್ರದೇಶ<br><b>निष्पत्तिः - </b>अगि (गतौ) अधि०) “ल्युट्” (३-३-११७) ।<br><b>व्युत्पत्तिः - </b>अङ्गत्यत्र ।<br><b>प्रयोगाः - </b>“आरोहणान्यङ्गणवेदिकानाम्” ।<br><b>उल्लेखाः - </b>याद० ४-२५ ।<br><br>अङ्गण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಡಿ / ರಥ / ವಾಹನ<br><b>निष्पत्तिः - </b>कर० “ल्युट्” (३-३-११७) ।<br><b>व्युत्पत्तिः - </b>अङ्ग्यतेऽनेन ।<br><br>अङ्गण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಮನ / ಸಂಚಾರ<br><b>निष्पत्तिः - </b>भावे “ल्युट्” (३-३-११५) ।<br><b>व्युत्पत्तिः - </b>अङ्ग्यते ।<br><br>अङ्गण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೈದಾನ / ಅಂಗಳ<br><b>विस्तारः - </b>क्रीडाङ्गणम्, सभाङ्गणम् ।<br><br>

अङगति
अङगति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಡಿ / ರಥ<br><b>निष्पत्तिः - </b>अगि (गतौ) “अतिः” बाहु० ।<br><b>व्युत्पत्तिः - </b>अङ्गति यात्यनेन ।<br><br>अङगति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>अङगति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ<br><br>अङगति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ<br><br>अङगति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಹೋತ್ರಿ<br><br>

अङ्गद
अङ्गद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಲಿಯ ಮಗ<br><br>अङ्गद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೋಳಿನ ಆಭರಣ / ವಂಕಿ<br><b>निष्पत्तिः - </b>दैप् (शोधने) “कः” (३-२-३) ।<br><b>व्युत्पत्तिः - </b>अङ्गं दायति शोधयति ।<br><b>प्रयोगाः - </b>“तमङ्गदे मन्दरकूटकोटिव्याघट्टनोत्तेजनया मणीनाम्”।<br><b>उल्लेखाः - </b>माघ० ३-६ ।<br><br>अङ्गद<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣದದಿಗ್ಗಜದ ಪತ್ನಿ<br><br>अङ्गद<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುರುಷನನ್ನು ಅಪೇಕ್ಷಿಸುವ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>डु दाञ् (दाने) “कः” (३-२-३) ।<br><b>व्युत्पत्तिः - </b>अङ्गं ददाति ।<br><br>अङ्गद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೇಹವನ್ನು ಕೊಡುವ / ದೇಹವನ್ನು ಒಪ್ಪಿಸುವ<br><br>

अङ्गदा
अङ्गदा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗದಾ<br><b>निष्पत्तिः - </b>(स्त्री०)<br><br>

अङ्गना
अङ्गना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸು<br><br>अङ्गना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಂದರವಾದ ದೇಹವುಳ್ಳ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>अङ्गात्कल्याणे (ग०) “नः” (५-२-१००) ।<br><b>व्युत्पत्तिः - </b>प्रशस्तान्यङ्गान्यस्याः ।<br><b>प्रयोगाः - </b>“तरुकिसलयजालमग्रहस्तैः प्रसभमनीयत भङ्गमङ्गनानाम्” ।<br><b>उल्लेखाः - </b>माघ० ७-२९ ।<br><br>

अङ्गनाप्रिय
अङ्गनाप्रिय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶೋಕ ವೃಕ್ಷ<br><br>

अङ्गन्यास
अङ्गन्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂತ್ರೋಚ್ಚಾರಣ ಪೂರ್ವಕ ಹೃದಯ ಮುಂತಾದ ಸ್ಥಾನಗಳಲ್ಲಿ ಹಸ್ತ ಸ್ಪರ್ಶದಿಂದ ಮಾಡುವ ನ್ಯಾಸ<br><br>

अङ्गपालि
अङ्गपालि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಲಿಂಗನ<br><b>निष्पत्तिः - </b>पाल (रक्षणे) “इः” (उ० ४-१३९) ।<br><b>व्युत्पत्तिः - </b>अङ्गपाल्यतेऽत्र<br><br>

अङ्गपालिका
अङ्गपालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಾದಿ / ಉಪಮಾತೆ / ಸಾಕುತಾಯಿ<br><b>निष्पत्तिः - </b>पाल (रक्षणे) “ल्युट्” (३-१-१३३) ।<br><b>व्युत्पत्तिः - </b>पालयति । अङ्गस्य पालिका ।<br><br>

अङ्गभू
अङ्गभू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರ / ಮಗ<br><b>निष्पत्तिः - </b>भू (सत्तायाम्) “क्विप्” (३-२-७६) ।<br><b>व्युत्पत्तिः - </b>अङ्गात् देहात् भवति ।<br><b>प्रयोगाः - </b>“हिरण्यगर्भाङ्गभुवं मुनिं हरिः” ।<br><b>उल्लेखाः - </b>माघ० १-१ ।<br><br>अङ्गभू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ / ಮನ್ಮಥ<br><b>निष्पत्तिः - </b>भू (सत्तायाम्) “क्विप्” (३-२-१७९) ।<br><b>व्युत्पत्तिः - </b>अङ्गात् मनसः भवति ।<br><br>अङ्गभू<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೇಹದಿಂದ ಹುಟ್ಟಿದ<br><br>

अङ्गभङ्ग
अङ्गभङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಮುರಿಯುವಿಕೆ / ನಿದ್ರೆಯಿಂದ ಎದ್ದ ಬಳಿಕ ಮೈಯನ್ನು ಚಾಚಿ ಮುರಿಯುವಿಕೆ<br><b>व्युत्पत्तिः - </b>अङ्गानां भङ्गः ।<br><b>प्रयोगाः - </b>“आत्मव्यापारगुर्वी जनितजललवा जृम्भितैः साङ्गभङ्गैः” ।<br><b>उल्लेखाः - </b>मुद्रा० ३-२१ ।<br><br>

अङ्गमर्द
अङ्गमर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಯನ್ನುಜ್ಜುವ ಸೇವಕ<br><b>निष्पत्तिः - </b>मृद (क्षोदे) “अण्” (३-२-१) ।<br><b>व्युत्पत्तिः - </b>अङ्गं मृद्राति ।<br><br>अङ्गमर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಯನ್ನುಜ್ಜುವಿಕೆ<br><b>निष्पत्तिः - </b>भावे “घञ्” (३-३-१८) ।<br><br>

अङ्गमर्दक
अङ्गमर्दक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಯನ್ನುಜ್ಜುವ ಸೇವಕ<br><b>निष्पत्तिः - </b>मृद (क्षोदे) “ण्वुल्” (३-१-१३३) ।<br><b>व्युत्पत्तिः - </b>अङ्गस्य मर्दक ।<br><br>अङ्गमर्दक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೈಯನ್ನುಜ್ಜುವವನು<br><br>

अङ्गमर्दिन्
अङ्गमर्दिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಯನ್ನುಜ್ಜುವ ಸೇವಕ<br><b>निष्पत्तिः - </b>मृद (क्षोदे) “णिनिः” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अङ्गस्य मर्दी ।<br><br>अङ्गमर्दिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೈಯನ್ನುಜ್ಜುವವನು<br><br>

अङ्गमर्दिनी
अङ्गमर्दिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಯನ್ನುಜ್ಜುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियाम् “डीप्” (५-१-५) ।<br><br>

अङ्गयज्ञ
अङ्गयज्ञ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗಭೂತವಾದ ಪಂಚವಿಧ ಯಜ್ಞ / ಪ್ರಧಾನಯಾಗಕ್ಕೆ ಸಾಧನವಾದ ಯಜ್ಞ<br><b>प्रयोगाः - </b>“रक्षांसि वेदीं परितो निरास्थदङ्गान्य-याक्षीदभितः प्रधानम्” ।<br><b>उल्लेखाः - </b>भट्टि० १-१२ ।<br><br>

अङ्गरक्षक
अङ्गरक्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಗಾವಲುಗಾರ<br><b>निष्पत्तिः - </b>रक्ष (पालने) “ण्वुल्” (३-१-१३३) ।<br><b>व्युत्पत्तिः - </b>अङ्गस्य रक्षकः ।<br><br>

अङ्गरक्षण
अङ्गरक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹಸಂರಕ್ಷಣೆ / ಶರೀರವನ್ನು ಕಾಪಾಡುವುದು<br><b>व्युत्पत्तिः - </b>अङ्गस्य रक्षणम् ।<br><br>

अङ्गरक्षिणी
अङ्गरक्षिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕವಚ<br><b>निष्पत्तिः - </b>रक्ष(पालने) कर० “ल्युट्” (३-३-११७) ।<br><b>व्युत्पत्तिः - </b>अङ्गं रक्ष्यतेऽनया ।<br><br>

अङ्गराग
अङ्गराग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹಕ್ಕೆ ಪೂಸಿಕೊಳ್ಳುವ ಸುಗಂಧದ್ರವ್ಯ / ವಾಸನೆಯ ಪುಡಿ<br><b>निष्पत्तिः - </b>रञ्ज (रागे) कर० “घञ्” (३-३-१२१) ।<br><b>व्युत्पत्तिः - </b>अङ्गं रज्यतेऽनेन ।<br><b>प्रयोगाः - </b>“पाण्ड्योऽयमंसार्पितलम्बहारः क्लृप्ताङ्गरागो हरिचन्दनेन” ।<br><b>उल्लेखाः - </b>रघु० ६-६० ।<br><br>अङ्गराग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸನೆಯ ಪುಡಿಯನ್ನು ಮೈಗೆ ಹಚ್ಚುವುದು<br><br>

अङ्गराज्
अङ्गराज्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗದೇಶದ ದೊರೆ<br><br>अङ्गराज्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣ<br><b>निष्पत्तिः - </b>राजृ (दीप्तौ) “क्विप्” (३-२-६१) ।<br><b>व्युत्पत्तिः - </b>अङ्गेषु राजते ।<br><br>

अङ्गराज
अङ्गराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗದೇಶದ ದೊರೆ<br><br>अङ्गराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣ<br><b>निष्पत्तिः - </b>“टच्” (५-४-९१) ।<br><b>व्युत्पत्तिः - </b>अङ्गानां राजा ।<br><br>

अङ्गरुह
अङ्गरुह<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶರೀರದಲ್ಲಿ ಹುಟ್ಟಿದ ಕೂದಲು<br><b>निष्पत्तिः - </b>रुह (बीजजन्मनि प्रादुर्भावे च ) “क्विप्” ।<br><b>व्युत्पत्तिः - </b>अङ्गे रोहति ।<br><br>

अङ्गरुह
अङ्गरुह<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶರೀರದಲ್ಲಿ ಹುಟ್ಟಿದ ಕೂದಲು<br><b>निष्पत्तिः - </b>रुह (बीजजन्मनि प्रादुर्भावे च ) “कः” (३-१-१३५) ।<br><b>व्युत्पत्तिः - </b>अङ्गे रोहति ।<br><b>प्रयोगाः - </b>“विहङ्गराजाङ्गरुहैरिवायतैः” ।<br><b>उल्लेखाः - </b>माघ० १-७ ।<br><br>

अङ्गलेप
अङ्गलेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಗಂಧದ್ರವ್ಯ / ವಾಸನೆಯ ಪುಡಿ<br><b>निष्पत्तिः - </b>लिप (उपदेहे) कर० “घञ्” (३-३-१२१) ।<br><b>व्युत्पत्तिः - </b>अङ्गं लिप्यतेऽनेन ।<br><br>अङ्गलेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಗೆ ಸುಗಂಧದ್ರವ್ಯವನ್ನು ಹಚ್ಚುವುದು<br><b>निष्पत्तिः - </b>लिप भावे “घञ्” ।<br><b>व्युत्पत्तिः - </b>अङ्गस्य लेपः ।<br><br>

अङ्गविकल
अङ्गविकल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗಹೀನ<br><b>व्युत्पत्तिः - </b>अङ्गेन विकलः ।<br><br>

अङ्गविक्षेप
अङ्गविक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೃತ್ಯ<br><b>व्युत्पत्तिः - </b>अङ्गस्य विक्षेपः चलनं यत्र ।<br><br>अङ्गविक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಯನ್ನು ಆಡಿಸುವಿಕೆ<br><b>व्युत्पत्तिः - </b>अङ्गस्य विक्षेपः ।<br><br>

अङ्गविद्या
अङ्गविद्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇದಾಂಗಗಳು<br><b>विस्तारः - </b>[ವಿವರಕ್ಕೆ अङ्ग ಪದದಲ್ಲಿ ನೋಡಿ.]<br><br>

अङ्गविधि
अङ्गविधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಧಾನಕಾರ್ಯಕ್ಕೆ ಅಂಗಭೂತವಾದ ಕಾರ್ಯ<br><b>व्युत्पत्तिः - </b>अङ्गस्य प्रधानोपकारिणः विधिः विधानम् ।<br><br>

अङ्गवैकृत
अङ्गवैकृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮನೋಭಾವವನ್ನು ತಿಳಿಸುವ ಅಭಿನಯ / ಕಣ್ಣು ಕೈ ಮೊದಲಾದವುಗಳಿಂದ ಮಾಡುವ ಸನ್ನೆ<br><b>व्युत्पत्तिः - </b>अङ्गेन अङ्गचेष्टया वैकृतम् ।<br><br>

अङ्गवैगुण्य
अङ्गवैगुण्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗಭೂತವಾದ ಕಾರ್ಯಕ್ಕೆ ಕುಂದನ್ನುಂಟುಮಾಡುವುದು<br><b>व्युत्पत्तिः - </b>अङ्गस्य वैगुण्यम् अन्यथाकरणम् ।<br><br>

अङ्गशुद्धि
अङ्गशुद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಯನ್ನು ಶುದ್ಧಿಗೊಳಿಸುವ ಸಾಬೂನು ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>(शुध (शौचे) कर० “क्तिच्” (३-३-१७४) ।<br><br>अङ्गशुद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಯನ್ನು ತೊಳೆದುಕೊಳ್ಳುವುದು<br><b>व्युत्पत्तिः - </b>अङ्गस्य शुद्धिः ।<br><br>

अङ्गसंस्कार
अङ्गसंस्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹವನ್ನು ಶುದ್ಧಿಮಾಡುವ ಸ್ನಾನ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>सम् + डु कृञ् (करणे) कर० “घञ्” (३-३-१२१) ।<br><b>व्युत्पत्तिः - </b>अङ्गं संस्क्रियतेऽनेन ।<br><br>अङ्गसंस्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸನೆಪುಡಿಯಿಂದ ದೇಹಕ್ಕೆ ಲೇಪನಮಾಡುವುದು / ದೇಹವನ್ನು ಶೃಂಗರಿಸುವುದು<br><b>निष्पत्तिः - </b>सम् + कृञ् भावे “घञ्” (३-३-१८)।<br><b>व्युत्पत्तिः - </b>अङ्गस्य संस्कारः ।<br><br>अङ्गसंस्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹವನ್ನು ಶೃಂಗರಿಸುವವನು<br><b>निष्पत्तिः - </b>सम् + कृञ् “अण्” (३-२-१) ।<br><b>व्युत्पत्तिः - </b>अङ्गस्य संस्कारः ।<br><br>

अङ्गसंस्क्रिया
अङ्गसंस्क्रिया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹವನ್ನು ಅಲಂಕರಿಸುವುದು / ದೇಹದ ಶೃಂಗಾರ<br><b>व्युत्पत्तिः - </b>अङ्गस्य संस्क्रिया ।<br><br>

अङ्गसंहति
अङ्गसंहति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಯವಗಳ ಸಮೂಹ<br><b>व्युत्पत्तिः - </b>अङ्गानां अवयवानां संहतिः ।<br><b>प्रयोगाः - </b>“स्थेयसीं दधतमङ्गसंहितम्” ।<br><b>उल्लेखाः - </b>किरा० १३-५० ।<br><br>

अङ्गहानि
अङ्गहानि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗಭೂತವಾದ ಕಾರ್ಯದ ನ್ಯೂನತೆ (ಕೊರತೆ)<br><br>अङ्गहानि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಯವನಾಶ<br><br>

अङ्गहार
अङ्गहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೃತ್ಯವಿಶೇಷ / ಹಸ್ತಾದಿಗಳಿಂದ ಮಾಡುವ ಅಭಿನಯ<br><b>निष्पत्तिः - </b>हृञ् (हरणे) “घञ्” (३-३-१८) ।<br><b>व्युत्पत्तिः - </b>अङ्गस्य हारः हरणम् ।<br><b>प्रयोगाः - </b>“प्रयोगमाद्यं ललिताङ्गहाअम्” ।<br><b>उल्लेखाः - </b>कुमा० ७-९१ ।<br><br>

अङ्गहीन
अङ्गहीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮ / ಮನ್ಮಥ<br><br>अङ्गहीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಯವಗಳಿಂದ ಹೀನನಾದ / ಅಂಗಶೂನ್ಯ<br><b>व्युत्पत्तिः - </b>अङ्गेन हीनः ।<br><b>प्रयोगाः - </b>“इन्द्रियार्थास्तु यान् यान् सा भोक्तुमिच्छति गर्भिणी । गर्भाबाधभयात्तांस्तान् भिषगाहृत्य दापयेत् ॥ सा प्राप्तदौहृदा पुत्रं जनयेत गुणान्वितम् । अलब्धदौहृदा गर्भे लभेतात्मनि वा भयम् । येषु येष्विन्द्रियार्थेषु दौहृदे वै विमानना । जायेत तत्सुतस्यार्तिस्तर्स्मिस्तर्स्मिस्तयेन्द्रिये” ।<br><b>उल्लेखाः - </b>सुश्रु० ।<br><b>विस्तारः - </b>[ತಾಯಿಯು ಗರ್ಭಧರಿಸಿದಾಗ ಅಪೇಕ್ಷಿಸಿದುದನ್ನು (ಬಯಕೆಯನ್ನು) ಒದಗಿಸದಿದ್ದರೆ ಜನಿಸುವ ಮಗುವು ಅಂಗಹೀನವಾಗುವುದು.]<br><br>अङ्गहीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗಕ್ಕೆ ಲೋಪವುಂಟಾದ ಪ್ರಧಾನಕಾರ್ಯ<br><br>

अङ्गाङ्गिभाव
अङ्गाङ्गिभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೌಣಮುಖ್ಯಭಾವ / ಉಪಕಾರ್ಯೋಪಕಾರಕಭಾವ / ಪ್ರಧಾನ ಕಾರ್ಯಕ್ಕೂ ಅಂಗಕಾರ್ಯಕ್ಕೂ ಇರುವ ಸಂಬಂಧ<br><b>व्युत्पत्तिः - </b>अङ्गस्य अङ्गिनश्च भावः ।<br><br>

अङ्गाधिप
अङ्गाधिप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗದೇಶದ ದೊರೆ / ಕರ್ಣ<br><br>अङ्गाधिप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಗ್ನಾಧಿಪತಿ<br><b>प्रयोगाः - </b>“अङ्गाधिपे बलिनि सर्वविभूतिसम्पत्” ।<br><br>

अङ्गाधीश
अङ्गाधीश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗದೇಶದ ದೊರೆ / ಕರ್ಣ<br><br>अङ्गाधीश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಗ್ನಾಧಿಪತಿ<br><br>

अङ्गाधीश्वर
अङ्गाधीश्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗದೇಶದ ದೊರೆ / ಕರ್ಣ<br><br>अङ्गाधीश्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಗ್ನಾಧಿಪತಿ<br><br>

अङ्गार
अङ्गार<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇದ್ದಲು<br><br>अङ्गार<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧ ಬೆಂದಿರುವ ಕಟ್ಟಿಗೆ / ಕೊಳ್ಳಿ<br><b>निष्पत्तिः - </b>अगि (गतौ) “आरन्” (उ० ३-१३४) ।<br><b>व्युत्पत्तिः - </b>अङ्गति गच्छत्यङ्गारः ।<br><b>प्रयोगाः - </b>1. “अङ्गारचुम्बितमिव व्यथमानमास्ते” | 2. “उष्णो दहति चाङ्गारः शीतः कृष्णायते करम्” ।<br><b>उल्लेखाः - </b>1. मालती० १-२२ ।<br><br>अङ्गार<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಕಿಯ ಕೆಂಡ<br><br>अङ्गार<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗಾರಕ / ಕುಜಗ್ರಹ<br><b>विस्तारः - </b>1. “कुजारमङ्गलाङ्गाराः” - वैज० । 2. “अङ्गारोऽस्त्री प्रशान्तार्चिरिङ्गालः कारिकाग्निविट्” - वैज० । 3. “अङ्गारकः कुजेऽपि स्याद्द्ग्धकाष्टे कुरण्टके” - मेदि० ।<br><br>

अङ्गारक
अङ्गारक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇದ್ದಲು<br><br>अङ्गारक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧ ಬೆಂದಿರುವ ಕಟ್ಟಿಗೆ / ಕೊಳ್ಳಿ<br><br>अङ्गारक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಜಗ್ರಹ<br><b>विस्तारः - </b>ಅಂಗಾರಕಗ್ರಹದಶಾಸಂವತ್ಸರಗಳು ಏಳು (7).<br>ಇತರ ಗ್ರಹಗಳ ದಶೆಗಳಲ್ಲಿ ಅಂಗಾರಕನ ಅಂತರ್ದಶಾ (ಭುಕ್ತಿ) ಮಾನ:<br> ದಶೆ ವರ್ಷ ಮಾಸಗಳು ದಿನಗಳು<br>ರವಿದಶೆ - 4 6<br>ಚಂದ್ರದಶೆ - 7 -<br>ಅಂಗಾರಕದಶೆ - 4 27 <br>ರಾಹುದಶೆ 1 - 18 <br>ಗುರುದಶೆ - 11 6 <br>ಶನಿದಶೆ 1 1 9<br>ಬುಧದಶೆ - 11 27<br>ಕೇತುದಶೆ - 4 27<br>ಶುಕ್ರದಶೆ 1 2 -<br>ಅಂಗಾರಕ ಮಹಾದಶೆಯಲ್ಲಿ ತನ್ನ (ಸ್ವ) ಮತ್ತು ಇತರ ಗ್ರಹಗಳ ಅಂತರ್ದಶಾ (ಭುಕ್ತಿ) ಮಾನ:<br> ವರ್ಷ ಮಾಸಗಳು ದಿನಗಳು<br>ಸ್ವಭುಕ್ತಿ - 4 27<br>ರಾಹುಭುಕ್ತಿ 1 - 18<br>ಗುರುಭಕ್ತಿ - 11 6<br>ಶನಿಭುಕ್ತಿ 1 1 9<br>ಬುಧಭುಕ್ತಿ - 11 27<br>ಕೇತುಭುಕ್ತಿ - 4 27<br>ಶುಕ್ರಭುಕ್ತಿ - 2 -<br>ರವಿಭುಕ್ತಿ - 4 6<br>ಚಂದ್ರಭುಕ್ತಿ - 7 -<br><br>अङ्गारक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಗಳವಾರ<br><br>अङ्गारक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೋರಂಟಿಮರ<br><b>प्रयोगाः - </b>“अङ्गारकः कुजेऽपि स्याद्द्ग्धकाष्टे कुरण्टके” |<br><b>उल्लेखाः - </b>मेदि० ।<br><br>

अङ्गारकारिन्
अङ्गारकारिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾರಾಟಕ್ಕಾಗಿ ಇದ್ದಲನ್ನು ತಯಾರಿಸುವವನು<br><b>निष्पत्तिः - </b>डु कृञ् (करणे) “णिनिः” (३-२-७८) ।<br><b>व्युत्पत्तिः - </b>अङ्गारं करोति ।<br><br>

अङारकमणि
अङारकमणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>व्युत्पत्तिः - </b>अङ्गारकस्य प्रियः मणिः ।<br><b>प्रयोगाः - </b>"माणिक्यं भास्करे देयं चन्द्रे मुक्ताम्प्रदापयेत् । प्रवालं च कुजे दद्यात्” ।<br><br>

अङ्गारधानी
अङ्गारधानी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ಗಿಷ್ಟಿಕೆ<br><b>निष्पत्तिः - </b>डु घाञ् (धारणे) “ल्युट्” (३-३-११७) । “डीप्” (४-१-१५) ।<br><b>व्युत्पत्तिः - </b>अङ्गारा धीयन्तेऽस्याम् ।<br><br>

अङ्गारधानिका
अङ्गारधानिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ಗಿಷ್ಟಿಕೆ<br><b>निष्पत्तिः - </b>डु घाञ् (धारणे) “ल्युट्” (३-३-११७) । “डीप्” (४-१-१५) । “कन्” (५-४-५) ।<br><b>व्युत्पत्तिः - </b>अङ्गारा धीयन्तेऽस्याम् ।<br><br>

अङ्गारशकटी
अङ्गारशकटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ಗಿಷ್ಟಿಕೆ<br><b>व्युत्पत्तिः - </b>अङ्गाराणां शकटी ।<br><br>

अङ्गारावक्षेपण
अङ्गारावक्षेपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಕಿಕೆಂಡವನ್ನು ತೆಗೆದುಹಾಕುವ ದೊಡ್ಡ ಆಪೆ<br><b>निष्पत्तिः - </b>क्षिपु कर०” “ल्युट्” (३-३-११७) ।<br><b>व्युत्पत्तिः - </b>अङ्गारोऽवक्षिप्यतेऽनेन ।<br><br>

अङ्गारिका
अङ्गारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿನ ಜಲ್ಲೆ<br><br>अङ्गारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುತ್ತುಗದ ಮೊಗ್ಗು<br><b>विस्तारः - </b>‘भवेदङ्गारिकाचेक्षुदण्डे किंशुककोरके” - मेदि० ।<br><br>

अङ्गारीय
अङ्गारीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇದ್ದಲಿಗೆ ಸಂಬಂಧಿಸಿದ / ಇದ್ದಲನ್ನು ತಯಾರಿಸಲು ಉಪಯೋಗಿಸುವ (ಮರ)<br><b>निष्पत्तिः - </b>“छः” (५-१-१२) ।<br><b>व्युत्पत्तिः - </b>अङ्गारेभ्यः एतानि ।<br><br>

अङ्गार्या
अङ्गार्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇದ್ದಲಿನ ರಾಶಿ<br><b>निष्पत्तिः - </b>“यः” (४-२-४९ ।<br><b>व्युत्पत्तिः - </b>अङ्गाराणां समूहः ।<br><br>

अङ्गिका
अङ्गिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗಿ / ರವಿಕೆ / ಕುಪ್ಪಸ<br><b>निष्पत्तिः - </b>“इनिः” (५-२-११५) । स्वार्थे “कन्” (५-४-२९) ।<br><b>व्युत्पत्तिः - </b>अङ्गमस्यास्ति ।<br><br>

अङ्गिन्
अङ्गिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಯವಗಳಿಂದ ಕೂಡಿದ<br><br>अङ्गिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೇಹದಿಂದ ಕೂಡಿದ<br><br>अङ्गिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಧಾನ / ಮುಖ್ಯ<br><b>निष्पत्तिः - </b>“इनिः” (५-२-११५) ।<br><b>व्युत्पत्तिः - </b>अङ्गान्यस्य सन्ति ।<br><br>

अङ्गिरस्
अङ्गिरस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗಿರಸ್ಸೆಂಬ ಋಷಿ<br><b>निष्पत्तिः - </b>अगि (गतौ) “असिः” इरुडागमश्च (उ० ४-२३५) ।<br><b>प्रयोगाः - </b>“अथाङ्गिरसमग्रण्यम्” ।<br><b>उल्लेखाः - </b>कुमा० ६-६५ ।<br><b>विस्तारः - </b>[ಈ ಋಷಿಯು ಬ್ರಹ್ಮನ ಮಾನಸಪುತ್ರರಲ್ಲೊಬ್ಬರು. ಮಹಾಭಾರತದಲ್ಲಿ ಈ ಋಷಿಯು ಅಗ್ನಿಪುತ್ರರೆಂದು ಹೇಳಿರುತ್ತೆ.]<br><br>

अङ्गीकरण
अङ्गीकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ / ಸ್ವೀಕಾರ<br><br>अङ्गीकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಪ್ಪಿಗೆ / ಸಮ್ಮತಿ<br><br>अङ्गीकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರಾರು<br><b>निष्पत्तिः - </b>अङ्गीकृ “ल्युट्” (३-३-११५) ।<br><br>

अङ्गीकार
अङ्गीकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವೀಕಾರ / ತೆಗೆದುಕೊಳ್ಳುವುದು<br><br>अङ्गीकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಪ್ಪಿಗೆ / ಸಮ್ಮತಿ<br><br>अङ्गीकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರಾರು<br><b>निष्पत्तिः - </b>डु कृञ् (करणे) भावे “घञ्” (३-३-१८) ।<br><b>व्युत्पत्तिः - </b>अङ्गीक्रियते ।<br><br>

अङ्गीकृत
अङ्गीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವೀಕರಿಸಲ್ಪಟ್ಟ / ತೆಗೆದುಕೊಳ್ಳಲ್ಪಟ್ಟ<br><br>अङ्गीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಪ್ಪಲ್ಪಟ್ಟ / ಸಮ್ಮತಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अङ्गीकृ “क्तः” (३-२-१०२) ।<br><b>प्रयोगाः - </b>“अङ्गीकृतामादिमदम्पतीभ्याम्” ।<br><b>उल्लेखाः - </b>याद० १३-१०१ ।<br><br>

अङ्गीकृता
अङ्गीकृता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಪ್ಪಲ್ಪಟ್ಟ / ಸಮ್ಮತಿಸಲ್ಪಟ್ಟ<br><br>

अङ्गु
अङ्गु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಸ್ತ / ಕೈ<br><br>अङ्गु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಕ್ಷಿ / ಹಕ್ಕಿ<br><b>विस्तारः - </b>“पतङ्गः पतगः प्लावी पतत्र्यङ्गुपतत्रयः” - वैज० ।<br><br>

अङ्गुल
अङ्गुल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆರಳು<br><b>निष्पत्तिः - </b>ला (आदाने) “कः” (३-२-३) ।<br><b>व्युत्पत्तिः - </b>अङ्गुलाति ।<br><br>अङ्गुल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವತ್ಥವೃಕ್ಷ / ಅರಳೀಮರ<br><b>विस्तारः - </b>“श्रीवृक्षे पिप्पलोऽश्वत्थः प्लक्षश्चलदलोऽगुलः” - वैज० ।<br><br>अङ्गुल<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗುಷ್ಠ / ಹೆಬ್ಬೆರಳು<br><b>निष्पत्तिः - </b>लीड् (संश्लेषणे) “डः” बाहु० ।<br><b>व्युत्पत्तिः - </b>अङ्गौ पाणी लीयते ।<br><b>विस्तारः - </b>“ज्येष्ठा तु मध्यमाङ्गुष्ठस्त्वङ्गुलः” - वैज० ।<br><br>अङ्गुल<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಅಂಗುಲ / ಎಂಟು ಬಾರ್ಲಿಕಾಳುಗಳ ಉದ್ದ<br><b>विस्तारः - </b>“अङ्गुलोऽस्त्री यवा अष्टौ” - वैज० ।<br><br>

अङ्गुलि
अङ्गुलि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆರಳು<br><b>निष्पत्तिः - </b>अगि (गतौ) “उलिः” (उ० ४-२) ।<br><b>प्रयोगाः - </b>“उद्वेजयत्यङ्गुलिपार्ष्णिभागान्” ।<br><b>उल्लेखाः - </b>कुमा० १-११ ।<br><br>अङ्गुलि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಸೊಂಡಿಲಿನ ತುದಿ<br><br>

अङ्गुलित्र
अङ्गुलित्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>(ಬಿಲ್ಲಿನ ಹೆದೆಯನ್ನು ಎಳೆಯುವಾಗ ಗಾಯವಾಗದಿರಲು) ಬೆರಳಿಗೆ ಹಾಕಿಕೊಳ್ಳುವ ಚರ್ಮದ ಮುಚ್ಚಳ<br><b>निष्पत्तिः - </b>त्रैङ् (पालने) “कः” (३-२-३) ।<br><b>व्युत्पत्तिः - </b>अङ्गुलि त्रायते ।<br><br>

अङ्गुलित्राण
अङ्गुलित्राण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆರಳಿಗೆ ಹಾಕಿಕೊಳ್ಳುವ ಚರ್ಮದ ಮುಚ್ಚಳ<br><b>निष्पत्तिः - </b>त्रङ् (पालने) “ल्युट्” (३-३-११७) ।<br><b>व्युत्पत्तिः - </b>अङ्गुलिः त्रायतेऽनेन ।<br><br>

अङ्गुलिमुद्रा
अङ्गुलिमुद्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುದ್ರೆಯ ಉಂಗುರ / ಸಂಕೇತಾಕ್ಷರಗಳಿಂದ ಕೂಡಿದ ಅಂಗುಳ್ಯಾಭರಣ<br><b>निष्पत्तिः - </b>रा (दाने) “कः” (३-२-३) ।<br><b>व्युत्पत्तिः - </b>अङ्गुलेः मुदं राति ।<br><br>

अङ्गुलिमॊटिन
अङ्गुलिमॊटिन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚುಟಕಿ / ಶಬ್ದವಾಗುವಂತೆ ಬೆರಳುಗಳ ಉಜ್ಜುವಿಕೆ<br><b>व्युत्पत्तिः - </b>अङ्गुल्योर्मोटनं मर्दनम् ।<br><br>

अङ्गुलिसञ्ज्ञा
अङ्गुलिसञ्ज्ञा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆರಳಿನ ಸನ್ನೆ<br><br>

अङ्गुलिसन्देश
अङ्गुलिसन्देश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆರಳಿನ ಸನ್ನೆಯಿಂದ ಮಾಡುವ ಆಜ್ಞೆ<br><b>निष्पत्तिः - </b>सम् + दिश (अतिसजण्मे) भावे “घञ्” (३-३-१८) ।<br><b>व्युत्पत्तिः - </b>अङ्गुल्या सन्दिश्यते ।<br><br>

अङ्गुली
अङ्गुली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆರಳು<br><b>निष्पत्तिः - </b>अगि (गतौ) “उलिः” (उ० ४-२-) ।<br><b>व्युत्पत्तिः - </b>अङ्गति<br><b>प्रयोगाः - </b>"त्याज्यो दुष्टः प्रियोऽप्यासीदङ्गुलीवोरगक्षता” ।<br><b>उल्लेखाः - </b>रघु० १-२८ ।<br><br>

अङ्गुलीय
अङ्गुलीय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಂಗುರ<br><b>निष्पत्तिः - </b>“छः” (४-३-६२) ।<br><b>व्युत्पत्तिः - </b>अङ्गुली भवम् ।<br><b>प्रयोगाः - </b>“तव सुचरितमङ्गुलीय नूनम्” ।<br><b>उल्लेखाः - </b>शाकु० ६-११ ।<br><br>

अङ्गुलीयक
अङ्गुलीयक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಂಗುರ<br><b>निष्पत्तिः - </b>अङ्गुलीय स्वार्थे “कन्” ।<br><b>प्रयोगाः - </b>“देशापेक्षास्तथा यूयं याताऽऽदायाऽग्गुलीयकम्” ।<br><b>उल्लेखाः - </b>भट्टि० ७-४९ ।<br><br>

अङ्गुष्ठ
अङ्गुष्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಬ್ಬೆರಳು<br><b>निष्पत्तिः - </b>ष्ठा (गतिनिवृत्तौ) “कः” (३-२-४) ।<br><b>व्युत्पत्तिः - </b>अङ्गौ पाणी तिष्ठति ।<br><b>प्रयोगाः - </b>“अभ्युन्नताङ्गुष्ठनखप्रभाभिः” ।<br><b>उल्लेखाः - </b>कुमा० १-३३ ।<br><br>

अङ्गुष्ठ्य
अङ्गुष्ठ्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಬ್ಬೆರಳಿನ ಉಗುರು<br><b>निष्पत्तिः - </b>“यत्” (४-३-५५) ।<br><b>व्युत्पत्तिः - </b>अङ्गुष्ठे भवः ।<br><br>

अंङ्गूष
अंङ्गूष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣ<br><br>अंङ्गूष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಕುಲ / ಕೀರ / ಮುಂಗುಸಿ<br><b>निष्पत्तिः - </b>अगि (गतौ ) “ऊषन्” बाहु० ।<br><br>

अङ्घस्
अङ्घस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><b>निष्पत्तिः - </b>अघि (गतौ) “अमुन्” (उ० ४-१८८) ।<br><b>व्युत्पत्तिः - </b>अङ्घते नरकमनेन ।<br><br>

अङ्घ्रि
अङ्घ्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾದ / ಕಾಲು<br><b>निष्पत्तिः - </b>अघि (गतौ) “क्रिन्” (उ० ४-६६) ।<br><br>अङ्घ्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರದ ಬೇರು<br><br>अङ्घ्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ಲೋಕದ ನಾಲ್ಕನೇ ಒಂದು ಭಾಗ / ಪಾದ<br><br>

अङ्घ्रिप
अङ्घ्रिप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಕ್ಷ / ಮರ<br><b>निष्पत्तिः - </b>पा (पाने) “कः” (३-२-४) ।<br><b>व्युत्पत्तिः - </b>अङ्घ्रिणा मूलेन पिबति ।<br><br>

अङ्घ्रिवल्ली
अङ्घ्रिवल्ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನರಿಹೊನ್ನೆಗಿಡ<br><br>

अचक्षुस्
अचक्षुस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಣ್ಣಿಲ್ಲದವನು / ಕುರುಡ<br><b>व्युत्पत्तिः - </b>न विद्येते चक्षुषी यस्य ।<br><br>

अचण्ड
अचण्ड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಧು / ಸೌಮ್ಯ / ಶಾಂತ<br><br>

अचण्डी
अचण्डी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಧುವಾದ ಹಸು<br><b>विस्तारः - </b>“स्यादचण्डी तु सुकरा” - अम० ।<br><br>

अचतुर
अचतुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಲ್ಕು ಇಲ್ಲದ<br><b>निष्पत्तिः - </b>निपा० (५-४-७७) |<br><b>व्युत्पत्तिः - </b>अविद्यमानानि चत्वारि यस्य।<br><br>अचतुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಡ್ಡ<br><b>व्युत्पत्तिः - </b>न चतुरः ।<br><br>

अचपल
अचपल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಾಪಲ್ಯವಿಲ್ಲದ / ಸ್ಥಿರಮನಸ್ಸುಳ್ಳ<br><b>व्युत्पत्तिः - </b>न चपलः ।<br><br>

अचर
अचर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಿರ ಲಗ್ನ / ಸ್ಥಿರ ರಾಶಿ<br><b>विस्तारः - </b>[ವೃಷಭ, ಸಿಂಹ, ವೃಶ್ಚಿಕ ಮತ್ತು ಕುಂಭ ಇವು ಸ್ಥಿರರಾಶಿಗಳು.]<br><br>अचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಥಿರವಾದ / ಚಂಚಲವಲ್ಲದ<br><br>अचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಲನೆಯಿಲ್ಲದ / ಸಂಚಾರವಿಲ್ಲದ / ಸ್ಥಾವರ<br><b>निष्पत्तिः - </b>चर (गतौ) “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>न चरति ।<br><b>प्रयोगाः - </b>“अतश्चराचरं विश्वम्” ।<br><b>उल्लेखाः - </b>कुमा० २-५ ।<br><br>

अचल
अचल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಟ್ಟ / ಪರ್ವತ<br><b>निष्पत्तिः - </b>चल (कम्पने) “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>न चलति ।<br><b>प्रयोगाः - </b>“अचल एष भवानिव राजते” ।<br><b>उल्लेखाः - </b>माघ० ४-२१ ।<br><br>अचल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ / ಶಿವ<br><br>अचल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಏಳು / ಸಪ್ತಸಂಖ್ಯೆ<br><br>अचल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಳಿ / ಚಿಲಕ<br><b>विस्तारः - </b>“अचलस्तु गिरिकीलयोः” - हेम० ।<br><br>अचल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಲಿಸದಿರುವ / ಸ್ಥಿರವಾದ<br><b>प्रयोगाः - </b>1. “अचलनलिनलक्ष्मीहारि नालं बभूव” | 2. “अचला कमला कस्य कस्य मित्रं महीपतिः । शरीरं च स्थिरं कस्य कस्य वश्या वराङ्गना” ।<br><b>उल्लेखाः - </b>1. किरा० ६-४७ ।<br><br>

अचलकन्या
अचलकन्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರ್ವತಿ / ಪರ್ವತ ರಾಜನ ಮಗಳು<br><b>व्युत्पत्तिः - </b>अचलस्य कन्या ।<br><br>

अचलकीला
अचलकीला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೃಥ್ವಿ / ಭೂಮಿ<br><b>व्युत्पत्तिः - </b>अचलाः कीला इव यस्याः ।<br><br>

अचलज
अचलज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆಟ್ಟದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) “डः” (३-२-९७) ।<br><b>व्युत्पत्तिः - </b>अचले जायते ।<br><br>

अचलजा
अचलजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರ್ವತಿ<br><b>निष्पत्तिः - </b>जनी “डः” (३-२-९८) ।<br><b>व्युत्पत्तिः - </b>अचलात् हिमाचलात् जायते ।<br><br>

अचलत्विष्
अचलत्विष्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><b>व्युत्पत्तिः - </b>अचला स्थिरा त्विट् कान्तिर्यस्य ।<br><br>अचलत्विष्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಬಣ್ಣ<br><b>व्युत्पत्तिः - </b>अचला च सा त्विट् च ।<br><br>अचलत्विष्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿ ಬಣ್ಣವುಳ್ಲ<br><b>व्युत्पत्तिः - </b>अचला त्विट् वर्णः यस्य ।<br><br>

अचलद्विष्
अचलद्विष्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ / ಪರ್ವತಗಳ ಶತ್ರು<br><b>निष्पत्तिः - </b>द्विष (अप्रीतौय्) “क्विप्” (३-२-६१)<br><b>व्युत्पत्तिः - </b>अचलानां द्वेष्टि ।<br><br>

अचलराज
अचलराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತರಾಜ / ಹಿಮಾಲಯ<br><b>निष्पत्तिः - </b>“टच्” (५-४-९१) ।<br><b>व्युत्पत्तिः - </b>अचलानां राजा ।<br><br>

अचला
अचला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿ<br><b>निष्पत्तिः - </b>चल (कम्पने) “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>न चलति ।<br><br>

अचापल
अचापल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಿರತೆ<br><b>निष्पत्तिः - </b>“अण्” (५-१-१२२) ।<br><b>व्युत्पत्तिः - </b>चपलस्य भावः । न चापलम् ।<br><br>अचापल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಚಂಚಲವಾದ / ಸ್ಥಿರವಾದ<br><b>व्युत्पत्तिः - </b>न चापलं यस्य ।<br><br>

अचापल्य
अचापल्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಿರತೆ<br><b>निष्पत्तिः - </b>“ष्यञ्” (५-१-१२४) ।<br><b>व्युत्पत्तिः - </b>चपलस्य भावः ।<br><br>अचापल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಚಂಚಲವಾದ / ಸ್ಥಿರವಾದ<br><b>व्युत्पत्तिः - </b>न चापलं यस्य ।<br><br>

अचिक्कण
अचिक्कण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೇಮವಿಲ್ಲದ / ಸ್ನೇಹವಿಲ್ಲದ<br><br>अचिक्कण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನುಣುಪಲ್ಲದ<br><br>अचिक्कण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒರಟಾಗಿರುವ<br><br>

अचित्
अचित्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಡವಾದ / ಚೇತನವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न चित् ।<br><br>

अचित्त
अचित्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿಯಿಲ್ಲದವನು / ಮಂಕನು<br><b>व्युत्पत्तिः - </b>नास्ति चित्तं यस्य । नास्ति चित्तं यत्र ।<br><br>

अचिन्तनीय
अचिन्तनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿಗೆಮೀರಿದ / ಯೋಚಿಸಲು ಅಶಕ್ಯವಾದ / ಊಹಿಸಲು ಅಸಾಧ್ಯವಾದ<br><b>निष्पत्तिः - </b>चिति (स्मृत्याम्) “अनीयर्” (३-१-९६) ।<br><b>व्युत्पत्तिः - </b>चिन्तयितुमशक्यः ।<br><b>प्रयोगाः - </b>“अचिन्तनीयस्तु तव प्रभावः” ।<br><b>उल्लेखाः - </b>रघु० ५-३३ ।<br><br>

अचिन्तित
अचिन्तित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯೋಚಿಸಲ್ಪಡದಿರುವ / ಅನಿರೀಕ್ಷಿತ / ಆಕಸ್ಮಿಕ<br><b>व्युत्पत्तिः - </b>न चिन्तितः ।<br><b>प्रयोगाः - </b>“अचिन्तितानि दुःखानि यथैवायान्ति देहिनाम् । सुखान्यपि तथा मन्ये” ।<br><b>उल्लेखाः - </b>व्यासः ।<br><br>

अचिन्त्य
अचिन्त्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿಗೆ ಮೀರಿದ / ಊಹಿಸಲು ಸಾಧ್ಯವಿಲ್ಲದ<br><b>निष्पत्तिः - </b>चिति (स्मृत्याम्) + णिच् कर्म० “यत्” (३-१-९७) ।<br><b>व्युत्पत्तिः - </b>न चिन्तयितुं शक्यः ।<br><b>प्रयोगाः - </b>“अचिन्त्यचिन्त्यैरवतारनाटकैः” ।<br><b>उल्लेखाः - </b>याद० १४-३५ ।<br><br>

अचिर
अचिर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಈಚಿನಕಾಲ / ಸಮೀಪಕಾಲ / ಅಲ್ಪಕಾಲ<br><br>अचिर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ಷಣಿಕ / ಸ್ವಲ್ಪಕಾಲದ<br><br>अचिर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನವೀನ / ಹೊಸದಾದ<br><br>अचिर<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಜಾಗ್ರತೆಯಾಗಿ<br><br>अचिर<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಹೊಸದಾಗಿ<br><b>प्रयोगाः - </b>“अचिराधिष्ठिराज्यः प्रकृतिष्वरूढमूलत्वात्” ।<br><b>उल्लेखाः - </b>माल० १-८ ।<br><br>

अचिरद्युति
अचिरद्युति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿದ್ಯುತ್ತು / ಮಿಂಚು<br><b>व्युत्पत्तिः - </b>अचिरा द्युतिर्यस्याः ।<br><b>प्रयोगाः - </b>“अचिरद्युतिभास्वरोऽथ चैद्यः” ।<br><b>उल्लेखाः - </b>गाद० १५-११९ ।<br><br>अचिरद्युति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ಷಣಿಕವಾದ ಕಾಂತಿ<br><b>व्युत्पत्तिः - </b>अचिरा च सा द्युतिश्च ।<br><br>अचिरद्युति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ಷಣಿಕವಾದ ಕಾಂತಿಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अचिरा द्युतिर्यस्य ।<br><br>

अचिरप्रभा
अचिरप्रभा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿದ್ಯುತ್ತು / ಮಿಂಚು<br><b>व्युत्पत्तिः - </b>अचिरा प्रभा यस्याः ।<br><br>अचिरप्रभा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ಷಣಿಕವಾದ ಕಾಂತಿ<br><b>व्युत्पत्तिः - </b>अचिरा च सा प्रभा च ।<br><br>

अचिरस्य
अचिरस्य<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಅಲ್ಪಕಾಲ<br><br>

अचिरांशु
अचिरांशु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿದ್ಯುತ್ತು / ಮಿಂಚು<br><b>व्युत्पत्तिः - </b>अचिराः अंशवो यस्याः ।<br><b>प्रयोगाः - </b>“अचिरांशुविलासचञ्चला ननु लक्ष्मीः फलमानुषङ्गिकम्” ।<br><b>उल्लेखाः - </b>किरा० २-१९ ।<br><br>

अचिरात्
अचिरात्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಜಾಗ್ರತೆಯಾಗಿ / ತಡವಿಲ್ಲದೆ<br><b>प्रयोगाः - </b>“अचिराज्जितमीनकेतनो विलसन् वृण्णिगणैनैमस्कृतः”<br><b>उल्लेखाः - </b>माघ० १६-५८ ।<br><br>

अचिराभा
अचिराभा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿದ್ಯುತ್ತು / ಮಿಂಚು<br><b>व्युत्पत्तिः - </b>अचिरा आभा यस्याः ।<br><br>

अचिराय
अचिराय<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಜಾಗ್ರತೆಯಾಗಿ / ತಡವಿಲ್ಲದೆ<br><b>व्युत्पत्तिः - </b>न चिराय ।<br><br>

अचिरेण
अचिरेण<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಜಾಗ್ರತೆಯಾಗಿ / ತಡವಿಲ್ಲದೆ<br><b>प्रयोगाः - </b>“अचिरेण परस्य भूयसीं विपरीतां विगणय्य चात्मनः”<br><b>उल्लेखाः - </b>किरा० २-९ ।<br><br>

अचेतन
अचेतन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೇತನವಿಲ್ಲದ / ಪ್ರಜ್ಞೆಯಿಲ್ಲದ / ಜ್ಞಾನವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न चेतना ज्ञानं यस्य ।<br><br>अचेतन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೀವವಿಲ್ಲದ / ಜಡವಾದ<br><b>प्रयोगाः - </b>“कामार्ता हिर् प्रकृतिकृपणाश्चेतनाचेतनेषु” ।<br><b>उल्लेखाः - </b>मेघ० १-५ ।<br><br>अचेतन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಿವಿಲ್ಲದ / ತಿಳಿವಳಿಕೆಯಿಲ್ಲದ<br><b>प्रयोगाः - </b>“बुद्धिशतमचेतने नष्टम्” ।<br><b>उल्लेखाः - </b>हितो० २-१६१ ।<br><br>

अचेतस्
अचेतस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಜ್ಞೆಯಿಲ್ಲದ / ಜ್ಞಾನವಿಲ್ಲದ<br><br>

अचेतस्
अचेतस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೀವವಿಲ್ಲದ / ಜಡ<br><br>अचेतस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನಸ್ಸಿನಲ್ಲದ<br><br>अचेतस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಿವಿಲ್ಲದ / ತಿಳಿವಳಿಕೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न विद्यते चेतो यस्य ।<br><br>

अचेष्ट
अचेष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನಶೂನ್ಯ / ವ್ಯಾಪಾರ ಶೂನ್ಯ<br><b>व्युत्पत्तिः - </b>नास्ति चेष्टा यस्य ।<br><br>

अचैतन्य
अचैतन्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಡತೆ / ಅರಿವಿಲ್ಲದಿರುವಿಕೆ / ಜ್ಞಾನಶೂನ್ಯತೆ<br><b>व्युत्पत्तिः - </b>न चैतन्यम् ।<br><br>अचैतन्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಡ / ನಿರ್ಜೀವ / ಜ್ಞಾನಶೂನ್ಯ<br><b>व्युत्पत्तिः - </b>न चैतन्यं यस्य ।<br><br>

अच्छ
अच्छ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರಡಿ<br><br>अच्छ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಫುಟಿಕ<br><br>अच्छ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರ್ಮಲ / ಶುದ್ಧ / ಪ್ರಸನ್ನ / ತಿಳಿಯಾದ<br><b>निष्पत्तिः - </b>छो (छेदने) “कः” (३-२-४) ।<br><b>व्युत्पत्तिः - </b>न च्छ्यति दृष्टिम् ।<br><b>प्रयोगाः - </b>“विभान्तमच्छस्फटिकाक्षमालया” ।<br><b>उल्लेखाः - </b>माघ० १-९ ।<br><br>अच्छ<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಅಭಿಮುಖ್ಯ / ಎದುರು<br><b>निष्पत्तिः - </b>छो (छेदने) “कः” (३-२-४) ।<br><b>व्युत्पत्तिः - </b>न च्छयति दृष्टिं सम्मुखत्वात् ।<br><b>विस्तारः - </b>“अच्छो भल्लूके स्फटिकेऽमलेऽच्छोऽभिमुखेऽव्ययम्” - हेम० ।<br><br>

अच्छगत्य
अच्छगत्य<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಅಭಿಮುಖವಾಗಿ ಹೋಗಿ / ಎದುರಾಗಿ ಹೋಗಿ<br><b>निष्पत्तिः - </b>(१-४-६९) ।<br><b>व्युत्पत्तिः - </b>अच्छं अभिमुखं गत्वा<br><br>

अच्छन्दस्
अच्छन्दस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇದಾಧ್ಯಯನವಿಲ್ಲದವನು / ಉಪನಯನವಾಗದಿರುವ (ಹುಡುಗ)<br><br>अच्छन्दस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇದಾಧ್ಯಯನವಿಲ್ಲದ (ಶೂದ್ರ)<br><b>व्युत्पत्तिः - </b>नास्ति छन्दो वेदोऽस्य ।<br><br>अच्छन्दस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಛಂದಸ್ಸಿಲ್ಲದ / ವೃತ್ತನಿಯಮವಿಲ್ಲದ / (ಗದ್ಯಕಾವ್ಯ)<br><b>व्युत्पत्तिः - </b>नास्ति छन्दो यत्र ।<br><br>

अच्छभल्ल
अच्छभल्ल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರಡಿ<br><b>निष्पत्तिः - </b>भल्ल (हिंसायाम्) “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अच्छं आभिमुख्येन भल्लते ।<br><br>

अच्छावाक
अच्छावाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊರೆಯಿಡುವವನು / ಪ್ರಾರ್ಥನೆಮಾಡುವವನು / ಋತ್ವಿಕ್ಕು<br><b>निष्पत्तिः - </b>वच (परिभाषणे) “घञ्” (३-३-१८) । पृषो० ।<br><b>व्युत्पत्तिः - </b>उच्यते । अच्छं वाको यस्य ।<br><br>अच्छावाक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರು ಮಾತನಾಡುವವನು<br><br>

अच्छावाकीय
अच्छावाकीय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಋತ್ವಿಕ್ಕಿಗೆ ಸಂಬಂಧಿಸಿದ ಕಾರ್ಯ / ಪ್ರಾರ್ಥನೆ<br><b>निष्पत्तिः - </b>“छः” (५-१-१३५) ।<br><b>व्युत्पत्तिः - </b>अच्छावाकस्य भावः कर्म वा ।<br><br>अच्छावाकीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಚ್ಛಾವಾಕಶಬದಿಂದ ಕೂಡಿದ (ಸೂಕ್ತ)<br><b>निष्पत्तिः - </b>मर्त्वर्थे “छः” (५-२-५९) ।<br><b>व्युत्पत्तिः - </b>अच्छावाकशब्दोऽस्मिन्नस्ति ।<br><br>

अच्छिद्र
अच्छिद्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೋಷವಿಲ್ಲದಿರುವಿಕೆ / ತಪ್ಪಿಲ್ಲದಿರುವಿಕೆ<br><br>अच्छिद्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಡೆಯದಿರುವ / ಅಖಂಡವಾದ / ಸಂಪೂರ್ಣವಾದ<br><br>अच्छिद्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಂಧ್ರವಿಲ್ಲದ / ತೂತಿಲ್ಲದಿರುವ<br><br>अच्छिद्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಡದಿರುವ / ನಾಶವಾಗದಿರುವ / ದೋಷವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न च्छिद्रं यत्र ।<br><br>

अच्छिन्न
अच्छिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಿಚ್ಛಿನ್ನವಾದ / ಸತತವಾದ / ತಡೆಯಿಲ್ಲದ / ಎಡಬಿಡದ<br><b>व्युत्पत्तिः - </b>न च्छिन्नम् ।<br><b>प्रयोगाः - </b>“अच्छिन्नामलसन्तानाः समुद्रोर्म्यनिवारिताः । पुनन्ति लोकान् पुण्यत्वात् कीर्तयः सरितश्च ते” ।<br><b>उल्लेखाः - </b>कुमा० ६-६९ ।<br><br>अच्छिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸಲ್ಪಡದ<br><br>

अच्छेद्य
अच्छेद्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮ / ಜೀವ<br><b>व्युत्पत्तिः - </b>न च्छेत्तुमर्हति ।<br><b>प्रयोगाः - </b>“अच्छेद्योऽयमदाह्योऽयम्” ।<br><b>उल्लेखाः - </b>गीता २-२४ ।<br><br>अच्छेद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸಲು ಯೋಗ್ಯವಲ್ಲದ<br><br>

अच्छैदिक
अच्छैदिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸಲು ಯೋಗ್ಯವಲ್ಲದ<br><b>निष्पत्तिः - </b>छेदं नित्यमर्हति “ठक्” (५-१-६४) ।<br><b>व्युत्पत्तिः - </b>न च्छैदिकः ।<br><br>

अच्छोद
अच्छोद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸರಸ್ಸು<br><b>व्युत्पत्तिः - </b>अच्छमुदकं यत्र ।<br><br>

अच्छोद्य
अच्छोद्य<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಎದುರಿನಲ್ಲಿ ಹೇಳಿ<br><b>निष्पत्तिः - </b>अच्छ+वद (व्यक्तायां वाचि) “क्त्वा” “ल्यप्” (१-४-६९) ।<br><b>व्युत्पत्तिः - </b>अच्छम् अभिमुखम् उदित्वा ।<br><br>

अच्युत
अच्युत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು / ನಾರಾಯಣ / ಶ್ರೀಕೃಷ್ಣ<br><b>व्युत्पत्तिः - </b>नास्ति च्युतं स्वपदात् यस्य ।<br><b>प्रयोगाः - </b>“जवेन पीठादुदतिष्ठदच्युतः” ।<br><b>उल्लेखाः - </b>माघ० १-१२ ।<br><br>अच्युत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಥಿರವಾದ / ಶಾಶ್ವತವಾದ<br><b>व्युत्पत्तिः - </b>न च्युतः ।<br><br>अच्युत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೀಳದಿರುವ / ಕಳಚಿಕೊಳ್ಳದ<br><br>

अच्युताग्रज
अच्युताग्रज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲರಾಮ<br><b>व्युत्पत्तिः - </b>अच्युतस्याग्रजः ।<br><br>अच्युताग्रज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><b>विस्तारः - </b>[ಉಪೇಂದ್ರಾವತಾರದಲ್ಲಿ; “उपेन्द्र” ಪದದಲ್ಲಿ ನೋಡಿ.]<br><br>

अच्युतात्मज
अच्युतात्मज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ / ಮನ್ಮಥ<br><b>व्युत्पत्तिः - </b>अच्युतस्यात्मजः ।<br><br>

अच्युतावास
अच्युतावास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವತ್ಥವೃಕ್ಷ / ಅರಳಿ ಮರ<br><br>

अच्युति
अच्युति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚ್ಯುತಿಯಿಲ್ಲದಿರುವಿಕೆ / ಬೀಳದಿರುವಿಕೆ<br><br>अच्युति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚ್ಯುತಿಯಿಲ್ಲದ / ನಾಶವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति च्यतिर्यस्य ।<br><br>

अज
अज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>अज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ<br><br>अज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ<br><br>अज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೀವ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) “डः” (३-२-१-१) ।<br><b>व्युत्पत्तिः - </b>न जायते |<br><b>प्रयोगाः - </b>1. “न हि जातो न जायेऽहं न जनिष्ये कदाचन । क्षेत्रज्ञः सर्वभूतानां तस्मादहमजः स्मृतः” || 2. “अजः स्वजन्मार्हतयानुमेने यामष्टमीं यादवभावमिच्छान्” || 3. “अजो नित्यः शाश्वतोऽयं पुराणो न हन्यते हन्यमाने शरीरे” ||<br><b>उल्लेखाः - </b>1. भा० । 2. याद० २-९५ । 3. गीता २-२० ।<br><br>अज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಡು / ಹೋತ<br><b>निष्पत्तिः - </b>अज (गतौ) “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अजति |<br><br>अज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಷರಾಶಿ<br><br>अज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><br>अज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ / ಮನ್ಮಥ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) “डः (३-२-९८) ।<br><b>व्युत्पत्तिः - </b>आत् विष्णोर्जायते |<br><br>अज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತರಿಕ್ಷ / ಆಕಾಶ<br><br>अज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಜಮಹಾರಾಜ / ರಘುವಿನ ಮಗ / ದಶರಥನ ತಂದೆ / ಶ್ರೀರಾಮನ ತಾತ<br><b>प्रयोगाः - </b>“ब्राह्मे मुहूर्ते किल तस्य देवी कुमारकल्पं सुषुवे कुमारम् । अतः पिता ब्रह्मण एव नाम्ना तमात्मजन्मानमजं चकार” ||<br><b>उल्लेखाः - </b>रघु० ५-३६ ।<br><br>अज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರವಿ / ಸೂರ್ಯ<br><b>विस्तारः - </b>1. “अजः पितामहेऽनादौ छागे विष्णौ हरे रवौ” - वैज० । 2. “अजश्छागे हरे विष्णौ रघुजे वेधसि स्मरे” - हेम०।<br><br>अज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಟ್ಟದಿರುವ<br><br>

अजकव
अजकव<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವಧನುಸ್ಸು<br><b>निष्पत्तिः - </b>वा (गतिगन्धनयोः) “कः” (३-२-३) ।<br><b>व्युत्पत्तिः - </b>अजकौ वाति |<br><br>

अजका
अजका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಡು<br><b>निष्पत्तिः - </b>अज- स्वार्थे “कन्” ।<br><br>अजका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಡಿನ ಹಿಕ್ಕೆ / ಆಡಿನ ಸಗಣಿ<br><br>अजका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಜಾಗಲಸ್ತನ / ಆಡಿನ ಕತ್ತಿನಲ್ಲಿ ಜೋಲಾಡುವ ಮಾಂಸಖಂಡ<br><br>

अजकाव
अजकाव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>(ಮರದಿಂದ ತಯಾರಿಸಿದ) ಯಜ್ಞಪಾತ್ರೆ<br><br>अजकाव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣುಗುಡ್ಡೆಯೊಳಗಿನ ಒಂದು ರೋಗ<br><br>अजकाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವಧನುಸ್ಸು<br><br>

अजग
अजग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>गै (शब्दे) “कः” (३-२-४) ।<br><b>व्युत्पत्तिः - </b>अजेन ब्रह्मणा गीयते ।<br><br>अजग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ / ಬೆಂಕಿ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) “डः” (वा० ३-२-४८) ।<br><b>व्युत्पत्तिः - </b>अजेन गच्छाति ।<br><br>

अजगन्धा
अजगन्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾರಂಬೇಳೆಗಿಡ<br><b>व्युत्पत्तिः - </b>अजस्येव गन्धोऽस्याः ।<br><br>

अजगन्धिनी
अजगन्धिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುಟಿಗೆಗಿಡ<br><b>निष्पत्तिः - </b>“इनिः” (५-२-११५) । “डीप्” (४-१-५) ।<br><b>व्युत्पत्तिः - </b>अजस्य गन्धो लेशोऽस्त्यस्याः।<br><br>

अजगर
अजगर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೊಡ್ಡಹಾವು<br><b>निष्पत्तिः - </b>गृ (निगरणे) “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>गिरति । अजस्य गरः ।<br><br>

अजगव
अजगव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರನ ಧನುಸ್ಸು<br><b>निष्पत्तिः - </b>“वः” (५-२-११०) ।<br><b>व्युत्पत्तिः - </b>अजगो विष्णुः शरत्वेनास्त्यस्य।<br><br>

अजजीव
अजजीव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುಬ / ಕುರಿಗಳಿಂದ ಜೀವಿಸುವವನು<br><b>व्युत्पत्तिः - </b>अजैर्जीवः जीवनमस्य ।<br><br>

अजजीविक
अजजीविक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುಬ / ಕುರಿಗಳಿಂದ ಜೀವಿಸುವವನು<br><b>व्युत्पत्तिः - </b>अजाः जीविका जीवनोपायोऽस्य।<br><br>

अजड
अजड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಡವಲ್ಲದ / ಸ್ವಯಂಪ್ರಕಾಶವಾದ<br><b>व्युत्पत्तिः - </b>न जडः अजडः आत्मा । अजडा धीः । अजडं ब्रह्म ।<br><br>

अजडा
अजडा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಸುಗುನ್ನಿಗಿಡ<br><br>

अजथ्या
अजथ्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>(ಆಡುಗಳಿಗೆ ಹಿತವಾದ) ಜಾಜಿಗಿಡ<br><b>निष्पत्तिः - </b>अज (गतिक्षेपणयोः) “थ्यन्” (५-१-८) ।<br><b>व्युत्पत्तिः - </b>अजेभ्यो हिता ।<br><br>

अजदेवता
अजदेवता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ / ಬೆಂಕಿ / ಆಡುಗಳ ದೇವತೆ<br><b>व्युत्पत्तिः - </b>अजस्य देवता ।<br><b>प्रयोगाः - </b>“रौद्री धेनुर्विनिर्दिष्ट छाग आग्नेय उच्यते” ।<br><b>उल्लेखाः - </b>वि० घ० ।<br><br>

अजननि
अजननि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜನ್ಮವಿಲ್ಲದಿರುವಿಕೆ / ಹುಟ್ಟದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) “अनिः” (३-३-११२) ।<br><b>प्रयोगाः - </b>न जननिः “ तस्याजननिरेवास्तु जननीक्लेशकारिणः” ।<br><b>उल्लेखाः - </b>माघ० २-४५ ।<br><br>

अजन्मन्
अजन्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಕ್ಷ / ಪುನರ್ಜನ್ಮವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>नास्ति जन्म यत्र ।<br><b>प्रयोगाः - </b>“तस्मात्स योगादधिगम्य योगमजन्मनेऽकल्पत जन्मभीरुः” ।<br><b>उल्लेखाः - </b>रघु० १८-३३ ।<br><br>अजन्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜನ್ಮವಿಲ್ಲದ / ಉತ್ಪತ್ತಿರಹಿತ / ಹುಟ್ಟಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति जन्म यस्य ।<br><b>प्रयोगाः - </b>“पुरुषस्य पदेष्वजन्मनः समतीतं च भवच्च भावि च”।<br><b>उल्लेखाः - </b>रघु० ८-७८ ।<br><br>

अजन्य
अजन्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪಾತ / ಅನಿಷ್ಟಸೂಚಕ ಧೂಮಕೇತು ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>“यत्” (४-४-९८) ।<br><b>व्युत्पत्तिः - </b>न जने साधु ।<br><b>विस्तारः - </b>“अजन्यं क्लीबमुत्पातः” - अम० ।<br><br>

अजप
अजप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುಬ / ಕುರಿಗಳಿಂದ ಜೀವಿಸುವವನು<br><b>निष्पत्तिः - </b>पा (रक्षणे) “कः” (३-२-३) ।<br><b>व्युत्पत्तिः - </b>अजान् पाति ।<br><br>अजप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಪಷ್ಟವಾಗಿ ಜಪಿಸದವನು<br><br>

अजपति
अजपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ ಮೇಕೆ<br><br>अजपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಷರಾಶಿಯ ಅಧಿಪತಿ, ಕುಜಗ್ರಹ<br><br>

अजपथ
अजपथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಡುಗಳು ಕಾಲಿಡಲು ಯೋಗ್ಯವಾದ ದಾರಿ / ಆಡು ಸಂಚರಿಸಲು ತಕ್ಕ ದಾರಿ<br><b>निष्पत्तिः - </b>“अः” (५-४-७४) ।<br><b>व्युत्पत्तिः - </b>अजस्य तच्चरणयोग्यः पन्थाः ।<br><br>

अजपद
अजपद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>“ಅಜೈಕಪಾದ್” ಎಂಬ ರುದ್ರ<br><b>व्युत्पत्तिः - </b>अजस्येव पदमस्य ।<br><br>

अजपा
अजपा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>“ಹಂಸ”ವೆಂಬ ಮಂತ್ರ<br><b>निष्पत्तिः - </b>जप (मानसे व्यक्तायां वाचि) + णिच् “अच्” ।<br><b>व्युत्पत्तिः - </b>प्रयत्नेन न जप्या ।<br><b>विस्तारः - </b>(ಪ್ರಯತ್ನವಿಲ್ಲದೆ ಉಚ್ಚರಿಸಬಹುದಾದ ಮಂತ್ರ.)<br><br>

अजपाद
अजपाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>“ಅಜೈಕಪಾದ್” ಎಂಬ ರುದ್ರ<br><br>अजपाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರುದ್ರದೇವತಾಕವಾದ ಪೂರ್ವಾಭಾದ್ರಾ ನಕ್ಷತ್ರ<br><br>

अजपाल
अजपाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುಬ / ಕುರಿಕಾಪಾಡುವವನು<br><b>निष्पत्तिः - </b>पाल (रक्षणे) + णिच् “अण्” (३-२-१)।<br><b>व्युत्पत्तिः - </b>अजान् पालयति ।<br><br>

अजबन्धु
अजबन्धु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಕ / ದಡ್ಡ / ಕುರಿಯಂತೆ ಮಂಕುಬುದ್ಧಿಯುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>अजस्य बन्धुरिव ।<br><br>

अजभक्ष
अजभक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾರಂಬೇಳೆಗಿಡ<br><b>निष्पत्तिः - </b>भक्ष (अदने) “घञ्” (३-३-१९) ।<br><b>व्युत्पत्तिः - </b>अजैर्भक्ष्यते ।<br><b>विस्तारः - </b>[ಇದರ ಸೊಪ್ಪನ್ನು ಆಡುಗಳು ಬಹಳ ಪ್ರೀತಿಯಿಂದ ತಿನ್ನುವುವು.]<br><br>

अजमार
अजमार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಟುಕ / ಆಡುಗಳನ್ನು ಕೊಂದು ಜೀವಿಸುವವನು<br><b>निष्पत्तिः - </b>मृङ् (प्राणत्यागे) + णिच् “अण्” (३-२-१) ।<br><b>व्युत्पत्तिः - </b>अजान् मारयति ।<br><br>अजमार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಟುಕರ ದೇಶ / ಈಗಿನ ಅಜ್ಮೀರ<br><b>विस्तारः - </b>[ಈ ದೇಶದಲ್ಲಿ ಪೂರ್ವದಲ್ಲಿ ಇಂತಹ ಕಟುಕರೇ ಹೆಚ್ಚಾಗಿ ವಾಸಿಸುತ್ತಿದ್ದರು]<br><br>

अजमीढ
अजमीढ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಜ್ಮೀರ<br><br>अजमीढ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುರುವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದ ಹಸ್ತಿಯೆಂಬ ರಾಜನ ಮಗ<br><br>अजमीढ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುಧಿಷ್ಠಿರ / ಧರ್ಮರಾಜ<br><b>विस्तारः - </b>“धर्मपुत्रोऽजमीढः स्यात् कर्णानुजयुधिष्ठिरौ” - त्रिकाण्ड० ।<br><br>

अजमुख
अजमुख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷಬ್ರಹ್ಮ<br><b>व्युत्पत्तिः - </b>अजस्य मुखमेव मुखं यस्य ।<br><b>विस्तारः - </b>[ದಕ್ಷ ಯಜ್ಞದಲ್ಲಿ ವೀರಭದ್ರನು ಈಶ್ವರನ ಆಜ್ಞೆಯಂತೆ ದಕ್ಷನ ಕುತ್ತಿಗೆಯನ್ನು ಕತ್ತರಿಸಿ ಬಿಸಾಡಿದಾಗ ಪರಶಿವನು ಒಂದು ಟಗರಿನ ಕುತ್ತಿಗೆಯನ್ನು ದಕ್ಷನ ಮುಂಡಕ್ಕೆ ಜೋಡಿಸಿದನು.]<br><br>

अजमोदा
अजमोदा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಜವಾನ / ಓಮ<br><b>व्युत्पत्तिः - </b>अजस्य मोद इव मोदो यस्य ।<br><br>

अजम्भ
अजम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>अजम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪೆ<br><br>अजम्भ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಂತವಿಲ್ಲದ / ಹಲ್ಲಿಲ್ಲದಿರುವ<br><br>अजम्भ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಟದಿಲ್ಲರುವ<br><b>व्युत्पत्तिः - </b>नास्ति जम्भो दन्तो यस्य ।<br><b>विस्तारः - </b>“रदाभ्यवहृती जम्भौ” - शाश्व० ।<br><br>

अजय
अजय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ<br><b>निष्पत्तिः - </b>या (प्रापणे) “कः” (३-२-४) ।<br><b>व्युत्पत्तिः - </b>अजेन च्छागेन याति |<br><br>अजय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಾಜಯ / ಸೋಲು<br><br>अजय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಯವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति जयो यस्य ।<br><br>अजय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಾಜಯವಿಲ್ಲದ / ಸೋಲಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति परैर्जयो यस्य । न जीयते इति वा ।<br><br>

अजय्य
अजय्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಯಿಸಲು ಅಶಕ್ಯನಾದ<br><b>व्युत्पत्तिः - </b>जेतुं शक्यः – न जय्यः ।<br><b>प्रयोगाः - </b>“राज्ञामजय्योऽजनि पुण्डरीकः” |<br><b>उल्लेखाः - </b>रघु० १८-८ ।<br><br>

अजर
अजर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><b>व्युत्पत्तिः - </b>नास्ति जरा यस्य ।<br><br>अजर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><br>अजर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜರೆಯಿಲ್ಲದ / ಮುಪ್ಪಿಲ್ಲದ / ನಾಶವಿಲ್ಲದ<br><b>प्रयोगाः - </b>“पुराणमनघस्पृष्टं दयालुमजरं विदुः” |<br><b>उल्लेखाः - </b>रघु० १०-१९ ।<br><br>

अजरा
अजरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಂತನ ಗೊಂಡೆಸೊಪ್ಪು<br><b>व्युत्पत्तिः - </b>नास्ति जरा यस्याः ।<br><b>विस्तारः - </b>[ಈ ಸೊಪ್ಪು ಧಾತುವೃದ್ಧಿಯನ್ನುಂಟುಮಾಡಿ ಜರೆಯನ್ನು ಹೋಗಲಾಡಿಸುವುದು.]<br><br>अजरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಲ್ಲಿ / ಗೌಳಿ<br><br>अजरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನ್ನಾರಿಗೆಡ್ಡೆಯ ಒಂದು ಭೇದ<br><br>

अजर्य
अजर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶವಾಗದ (ಸ್ನೇಹ) / ಅಪಾಯವಿಲ್ಲದ (ಮೈತ್ರಿ)<br><b>निष्पत्तिः - </b>जृष् (वयोहानौ) “यत्” (३-१-१०५) ।<br><b>व्युत्पत्तिः - </b>न जीर्यति ।<br><b>प्रयोगाः - </b>“तेन सङ्गतनार्येण रामाजय कुरु द्रुतम्” ।<br><b>उल्लेखाः - </b>भट्टि० ६-५३ ।<br><br>

अजशृङ्गी
अजशृङ्गी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಲಮುತಿಗಿಡ<br><b>व्युत्पत्तिः - </b>अजस्येव शृङ्गमस्याः ।<br><br>

अजस्र
अजस्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸತತವಾದ / ಅವಿಚ್ಛಿನ್ನವಾದ / ಎಡಬಿಡದ<br><b>निष्पत्तिः - </b>जसु (मोक्षणे) “र” (३-२-१६७) ।<br><b>व्युत्पत्तिः - </b>न जस्यति ।<br><b>प्रयोगाः - </b>“अजस्रदीक्षाप्रयतस्य मद्गुरोः” ।<br><b>उल्लेखाः - </b>रघु० ३-४४ ।<br><br>अजस्र<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಸತತವಾಗಿ / ಅವಿಚ್ಛಿನ್ನವಾಗಿ / ಎಡಬಿಡದೆ<br><b>प्रयोगाः - </b>“अजस्रमास्फालितवल्लकीगुणक्षतोज्ज्वलाङ्गुष्ठ-नखांशुभिन्नया” ।<br><b>उल्लेखाः - </b>माघ० १-९ ।<br><br>

अजहस्त्वार्था
अजहस्त्वार्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಾರ್ಥವನ್ನು ಬಿಡದೆ ಬೇರೆ ಅರ್ಥವನ್ನು ಬೋಧಿಸುವ ಲಕ್ಷಣೆ<br><b>व्युत्पत्तिः - </b>अजहत् स्वार्थो मुख्यार्थो याम् ।<br><b>विस्तारः - </b>“कुन्ताः प्रविशन्ति” ಇಲ್ಲಿ ಅಚೇತನವಾದ ಕುಂತಗಳಿಗೆ ಪ್ರವೇಶವು ಅಸಂಭವವಾದ್ದರಿಂದ ಕುಂತಧಾರಿಗಳಾದ ಪುರುಷರು ಲಕ್ಷಣೆಯಿಂದ್ ಅಬೋಧಿಸಲ್ಪಡುವರು. ಇಲ್ಲಿ ಮುಖ್ಯವಾದ ಕುಂತಪದಾರ್ಥಕ್ಕೂ ಉಪಾದಾನವಿರುವುದರಿಂದ ಇದು ಅಜಹ್ತಸ್ವಾರ್ಥಲಕ್ಷಣೆಯೆನಿಸುವುದು.<br><br>

अजहल्लिङ्ग
अजहल्लिङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಯತಲಿಂಗವುಳ್ಳ ಶಬ್ದ / ವಿಶೇಷ್ಯವು ಬೇರೆ ಲಿಂಗವಾದರೂ ತನ್ನ ಲಿಂಗವನ್ನು ಬಿಡದಿರುವ ವಿಶೇಷಣ ಶಬ್ದ<br><b>व्युत्पत्तिः - </b>अजहत् लिङ्गं यं सः ।<br><b>विस्तारः - </b>ಉದಾ: “वेदाः प्रमाणम्” ಇಲ್ಲಿ ವೇದ ಶಬ್ದವು ಪುಲ್ಲಿಂಗವಾದರೂ ಪ್ರಮಾಣ ಶಬ್ದವು ನಿಯತಲಿಂಗವಾದ್ದರಿಂದ “प्रमाणम्” ಎಂದೇ ಇರುವುದು. ಪುಲ್ಲಿಂಗವಾಗಿ ಮಾರ್ಪಡುವುದಿಲ್ಲ.<br><br>

अजा
अजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಡು / ಮೇಕೆ<br><br>अजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುರಿ<br><b>निष्पत्तिः - </b>अज “टाप्” (४-१-४) ।<br><br>अजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಹುಜಿಗೆ ಗಿಡ<br><br>अजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಬಜೆ<br><b>विस्तारः - </b>“अजा महौषधी ज्ञेया” - कल्पद्रु० ।<br><br>अजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾವುಮೆಕ್ಕೆಗಿಡ<br><b>विस्तारः - </b>“पयोष्ण्यजाभारती स्याद्विशाला मुकुलाप्यथ” -कल्पद्रु० ।<br><br>

अजागर
अजागर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಚ್ಚರವಿಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>नास्ति जागरो यस्य । नास्ति जागरो यस्मात् ।<br><br>

अजागलस्तन
अजागलस्तन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಡಿನ ಕುತ್ತಿಗೆಯಲ್ಲಿ ಜೋಲಾಡುವ ಮಾಂಸಖಂಡ<br><b>प्रयोगाः - </b>“अजागलस्तनस्येव तस्य जन्म निरर्थकम्” ।<br><b>विस्तारः - </b>[ಯೋಗ್ಯತೆಯಿಲ್ಲದ್ದು, ಪ್ರಯೋಜನವಿಲ್ಲದ್ದು ಎಂಬ ಅರ್ಥದಲ್ಲಿ ಇದರ ಪ್ರಯೋಗ.]<br><br>

अजाजी
अजाजी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜೀರಿಗೆ<br><b>निष्पत्तिः - </b>अज (गतिक्षेपणयोः) “अण्” (३-२-१)। “डीप्” (४-१-१५) ।<br><b>व्युत्पत्तिः - </b>अजमजति क्षिपति ।<br><br>अजाजी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಲುಹತ್ತಿಗಿಡ<br><br>

अजाजीव
अजाजीव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುಬ / ಕುರಿಯನ್ನು ಕಾಯುವವನು<br><br>अजाजीव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರಿಯನ್ನು ಮಾರಿ ಜೀವಿಸುವವನು<br><b>व्युत्पत्तिः - </b>अजा आजीवो यस्य ।<br><br>

अजात
अजात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಟ್ಟದಿರುವ / ಜನ್ಮತಾಳದಿರುವ<br><b>व्युत्पत्तिः - </b>न जातः ।<br><br>

अजातककुद्
अजातककुद्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆರಳು ಸಂಪೂರ್ಣವಾಗಿ ಬೆಳೆಯದಿರುವ ಕರು / ಹೋರಿ<br><b>निष्पत्तिः - </b>“अ” लोपः (५-४-१४६) ।<br><b>व्युत्पत्तिः - </b>न जातं ककुदं यस्य ।<br><br>

अजातदन्त
अजातदन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಲ್ಲು ಹುಟ್ಟದಿರುವ ಮಗು<br><b>व्युत्पत्तिः - </b>न जाता दन्ता यस्य ।<br><br>अजातदन्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಲ್ಲು ಹುಟ್ಟದಿರುವ ವಯಸ್ಸು<br><b>व्युत्पत्तिः - </b>न जाता दन्ता यस्मिन् वयसि ।<br><br>

अजातशत्रु
अजातशत्रु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುಧಿಷ್ಠಿರ / ಧರ್ಮರಾಜ<br><b>व्युत्पत्तिः - </b>न जातः शत्रुरस्य ।<br><br>

अजातारि
अजातारि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುಧಿಷ್ಠಿರ / ಧರ್ಮರಾಜ<br><b>व्युत्पत्तिः - </b>न जातोऽरिः यस्य ।<br><b>प्रयोगाः - </b>“हन्त जातमजातारे प्रथमेन त्वयारिणा” ।<br><b>उल्लेखाः - </b>माघ० २-१०२ ।<br><br>

अजाति
अजाति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುತ್ಪತ್ತಿ / ಜನ್ಮಾಭಾವ / ಹುಟ್ಟದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>जनी (प्राद्रुभावे) “क्तिन्” (३-३-९४) । न० त० ।<br><br>अजाति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜನ್ಮವಿಲ್ಲದ / ಹುಟ್ಟಿಲ್ಲದ<br><br>अजाति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಾತಿಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न जातिर्यस्य ।<br><br>अजाति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸನಾತನ / ನಿತ್ಯ<br><br>

अजादनी
अजादनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಳ್ಳುಗುಳ್ಳದ ಗಿಡ<br><b>निष्पत्तिः - </b>अद (भक्षणे) कर्म० “ल्युट्” (३-३-११३) । “डीप्” (४-१-१५) ।<br><b>व्युत्पत्तिः - </b>अजैरद्यते ।<br><br>

अजानत्
अजानत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯದಿರುವ<br><b>निष्पत्तिः - </b>ज्ञा (अवबोधने) “शतृ” (३-२-१२४) ।<br><b>व्युत्पत्तिः - </b>न जानाति ।<br><b>प्रयोगाः - </b>“गुणान्तरमजानन् किन्निमित्तं त्वमाभरणं ददासि?” ।<br><b>उल्लेखाः - </b>माल० २ ।<br><br>

अजानिक
अजानिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುಬ / ಕುರಿಯಿಂದ ಜೀವಿಸುವವನು<br><b>निष्पत्तिः - </b>“ठन्” (५-२-११५) ।<br><b>व्युत्पत्तिः - </b>अजेन आनो जीवनं अस्त्यस्य ।<br><br>

अजाविक
अजाविक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಡು ಮತ್ತು ಕುರಿ<br><b>निष्पत्तिः - </b>निपा० (२-४-११) ।<br><b>व्युत्पत्तिः - </b>अजाश्च अवयश्च ।<br><b>प्रयोगाः - </b>“अजाविकं सैकशफं न जातु विषमं भजेत्” ।<br><b>उल्लेखाः - </b>मनु० ९-११९ ।<br><br>

अजापक्व
अजापक्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಔಷಧ<br><b>प्रयोगाः - </b>“छागशकृत्समूत्रक्षीरैर्दध्ना च साधितं सर्पिः । सक्षारं यक्ष्महरं कासश्वासोपशान्तये परमम्” ।<br><b>उल्लेखाः - </b>चक्र० ।<br><b>विस्तारः - </b>ಕ್ಷಯ ಕಾಸ ಮತ್ತು ಕೆಮ್ಮಲು ಇವುಗಳಿಗಾಗಿ ಆಡಿನ ಹಾಲು ಮತ್ತು ಮೂತ್ರ ಮುಂತಾದವುಗಳಿಂದ ತಯಾರಿಸುವ ಒಂದು ತುಪ್ಪ.<br><br>

अजि
अजि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಚಾರ / ಗಮನ / ನಡೆ<br><b>निष्पत्तिः - </b>अज क्तिन् (३-३-९४) ।<br><br>अजि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಲಿಸುವ / ಹೋಗುವ / ನಡೆಯುವ<br><b>निष्पत्तिः - </b>अज (गतिक्षेपणयोः) “इः” (उ० ४-१३९) ।<br><b>व्युत्पत्तिः - </b>अजति ।<br><br>

अजित
अजित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>न जितः ।<br><b>प्रयोगाः - </b>“अजितमेकमगोचरयत् स्वयम्” ।<br><b>उल्लेखाः - </b>याद० ३-३ ।<br><br>अजित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ / ಈಶ್ವರ<br><br>अजित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ತೀರ್ಥಂಕರರು<br><br>अजित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧದೇವ<br><br>अजित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಯಿಸಲ್ಪಡದ<br><b>विस्तारः - </b>“अजतिस्तीथङ्कृद्भेदे बुद्धे विष्णावनिर्जिते” -हेम० ।<br><br>

अजिन
अजिन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚರ್ಮ / ತೊಗಲು<br><br>अजिन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಂಕೆಯ ಚರ್ಮ<br><b>निष्पत्तिः - </b>अज (गतिक्षेपणयोः) “इनच्” (उ० २-४९) ।<br><b>व्युत्पत्तिः - </b>अजति ।<br><b>प्रयोगाः - </b>“अथाजिनाषाढधरः प्रगल्भवाक्” |<br><b>उल्लेखाः - </b>कुमा० ५-३० ।<br><b>विस्तारः - </b>“अजिनं चर्म कृत्तिः स्त्री” -अम० ।<br><br>

अजिनपत्रा
अजिनपत्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಟದ ಹಕ್ಕಿ / ಕತ್ತಲೆಹಕ್ಕಿ / ಬಾವಲಿ<br><b>व्युत्पत्तिः - </b>अजिनमिव पत्रमस्याः ।<br><br>

अजिनयोनि
अजिनयोनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಂಕೆ<br><b>व्युत्पत्तिः - </b>अजिनस्य योनिः प्रभवः ।<br><br>अजिनयोनि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣುಜಿಂಕೆ<br><br>

अजिर
अजिर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚತ್ವರ / ಅಂಗಳ / ಮನೆಯ ಮುಂಭಾಗದ ಬಯಲು<br><b>निष्पत्तिः - </b>अज (गतिक्षेपणयोः) “किरच्” (उ० १-५३) ।<br><b>व्युत्पत्तिः - </b>अजन्ति क्षिपन्त्यत्र धान्यादिकम् ।<br><b>प्रयोगाः - </b>“तदीयमास्थाननिकेतनाजिरम्” ।<br><b>उल्लेखाः - </b>किरा० १-१६ ।<br><br>अजिर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪೆ<br><br>अजिर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಳಿ<br><br>अजिर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನಕ್ಕೆ ಗೋಚರವಾಗುವ ವಿಷಯ<br><br>अजिर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹ / ಶರೀರ<br><br>अजिर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇಗವಾಗಿ ನಡೆಯುವ<br><br>अजिर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ<br><b>विस्तारः - </b>“अजिरं प्राङ्गणे वाते विषये दुर्दरे तनौ । स्त्री चण्ड्याम्” - मेदि० ।<br><br>

अजिरा
अजिरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अजिर ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><br>

अजिह्म
अजिह्म<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸರಳವಾದ / ವಕ್ರವಲ್ಲದ<br><b>निष्पत्तिः - </b>ओ हाक् (त्यागे) “मन्” (उ० १-१४१)।<br><b>व्युत्पत्तिः - </b>न जिह्मः ।<br><b>प्रयोगाः - </b>“अजिह्ममोजिष्टममोघमवलमम्” ।<br><b>उल्लेखाः - </b>किरा० १४-५७ ।<br><br>

अजिह्मग
अजिह्मग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) “डः” (वा० ३-२-४८) ।<br><b>व्युत्पत्तिः - </b>अजिह्ममृजु गच्छति ।<br><br>अजिह्मग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸರಳವಾಗಿ ನಡೆಯುವ / ನೇರವಾಗಿ ನಡೆಯುವ<br><br>

अजिह्व
अजिह्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಡೂಕ / ಕಪ್ಪೆ<br><b>व्युत्पत्तिः - </b>नास्ति जिह्वा यस्य ।<br><b>विस्तारः - </b>[ಅಗ್ನಿಯು ರಸಾತಲದಲ್ಲಿರುವ ವಿಷಯವನ್ನು ಕಪ್ಪೆಗಳು ದೇವತೆಗಳಿಗೆ ತಿಳಿಸಲು ಅಗ್ನಿಗೆ ಕೋಪವುಂಟಾಗಿ ಕಪ್ಪೆಗಳಿಗೆ ನಾಲಿಗೆ ಹೋಗಲೆಂದು ಶಾಪಕೊಟ್ಟುದಾಗಿ ಭಾರತದ ಅನುಶಾಸನಿಕ ಪರ್ವದಲ್ಲಿ ಕಥೆಯಿರುವುದು.]<br><br>अजिह्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಲಿಗೆಯಿಲ್ಲದಿರುವ<br><br>

अजीर्ण
अजीर्ण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯು ಕಡಿಮೆಯಾಗುವುದರಿಂದ ಆಹಾರವು ಅರಗದಿರುವುದು<br><b>प्रयोगाः - </b>“अजीर्णे भेषजं वारिजीर्णे वारि बलप्रदम्” ।<br><br>अजीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಚನವಾಗದ / ಅರಗದಿರುವ<br><br>

अजीव
अजीव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೀವವಿಲ್ಲದ / ಅಚೇತನ<br><b>व्युत्पत्तिः - </b>नास्ति जीवो यस्य ।<br><b>विस्तारः - </b>(ಘಟ, ಪಟ ಮುಂತಾದುದು.)<br><br>

अजेय
अजेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಹರವಾದ ಒಂದು ತುಪ್ಪ / ಔಷಧ<br><b>प्रयोगाः - </b>“पिबेद्घृतमजेयाख्यम्” ।<br><b>उल्लेखाः - </b>सुश्रु० ।<br><br>अजेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಯಿಸಲು ಯೋಗ್ಯವಲ್ಲದ<br><b>निष्पत्तिः - </b>जि (जये) “यत्” (३-३-१६९) ।<br><b>व्युत्पत्तिः - </b>न जेतुं योग्यः ।<br><br>

अजैकपाद्
अजैकपाद्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರುದ್ರದೇವತಾಕವಾದ ಪೂರ್ವಾಭಾದ್ರಾ ನಕ್ಷತ್ರ<br><b>व्युत्पत्तिः - </b>अजस्य एकः पाद इव पादो यस्य ।<br><br>अजैकपाद्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಕಾದಶರುದ್ರರಲ್ಲಿ ನಾಲ್ಕನೇ ರುದ್ರ<br><br>

अज्जुका
अज्जुका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>(ನಾಟ್ಯ ಸಂಕೇತದಲ್ಲಿ) ವೇಶ್ಯಾಂಗನೆ<br><b>निष्पत्तिः - </b>अर्ज (प्रतियत्ने) “उकन्” रस्य जः बाहु० ।<br><b>व्युत्पत्तिः - </b>अर्जयति ।<br><b>विस्तारः - </b>[ನಾಟಕದಲ್ಲಿ ಮಾತ್ರ ಇದರ ಪ್ರಯೋಗ.]<br><br>

अज्झटा
अज्झटा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಿನೆಲ್ಲಿಗಿಡ<br><b>व्युत्पत्तिः - </b>अत् (आश्चर्येऽव्ययम्) झटः सङ्घातोऽस्याम् ।<br><br>

अज्झल
अज्झल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುರಾಣಿ / ಶತ್ರುಗಳ ಕತ್ತಿಯ ಏಟನ್ನು ತಡೆಯುವ ಚರ್ಮದ ಹಲಗೆ<br><br>

अज्ञ
अज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜ್ಞಾನಶೂನ್ಯ / ಅರಿವಿಲ್ಲದವನು<br><b>निष्पत्तिः - </b>ज्ञा (अवबोधने) “कः” (३-१-१३५) ।<br><b>व्युत्पत्तिः - </b>न जानाति ।<br><br>अज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂರ್ಖ / ಮೂಢ / ತಿಳಿಗೇಡಿ<br><b>प्रयोगाः - </b>“अज्ञः सुखमाराध्यः सुखतरमाराध्यते विशेषज्ञः” ।<br><b>उल्लेखाः - </b>भर्त० ।<br><br>अज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೀವವಿಲ್ಲದ / ಜಡ / ಅಚೇತನ<br><br>

अज्ञात
अज्ञात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न ज्ञातः ।<br><b>प्रयोगाः - </b>“अज्ञातकुलशीलस्य वासो देयो न कस्यचित्”<br><b>उल्लेखाः - </b>हितो० ।<br><br>

अज्ञातवास
अज्ञातवास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾರಿಗೂ ತಿಳಿಯದೆ ವಾಸಮಾಡುವುದು<br><br>

अज्ञान
अज्ञान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿಳಿಗೇಡಿತನ / ಮೂರ್ಖತನ<br><br>अज्ञान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಿದ್ಯೆ<br><b>व्युत्पत्तिः - </b>न ज्ञानम् ।<br><b>विस्तारः - </b>[ವಿವರಕ್ಕೆ “अविद्या” ಪದದಲ್ಲಿ ನೋಡಿ.]<br><br>अज्ञान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜ್ಞಾನವಿಲ್ಲದ / ತಿಳಿವಳಿಕೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति ज्ञानं यस्य ।<br><br>

अज्ञानिन्
अज्ञानिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿವಳಿಕೆಯಿಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>न ज्ञानी ।<br><br>

अज्मन्
अज्मन्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸು<br><b>निष्पत्तिः - </b>अग (गतिक्षेपणयोः) कर० “मनिन्” (उ० ४-१४४) ।<br><b>व्युत्पत्तिः - </b>अजति गच्छति स्वर्गमनया ।<br><br>

अञ्चति
अञ्चति<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯು / ಗಾಳಿ<br><br>अञ्चति<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ / ಬೆಂಕಿ<br><br>अञ्चति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಗತಕ್ಕ / ಸಂಚರಿಸುವ<br><b>निष्पत्तिः - </b>अञ्चुं (गतौ) “अतिः” (उ० ४-६१) ।<br><b>विस्तारः - </b>“कुशानुर्वातसारथिः । ब्रमिर्भुजिः पचिस्साचिश्चिरिवञ्चतिरञ्चतिः” - वैज० ।<br><br>

अञ्चन
अञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಚನೆ / ಪೂಜೆ<br><b>निष्पत्तिः - </b>अञ्चु (गतिपूजनयोः) “ल्युट्” (३-३-११५) ।<br><b>विस्तारः - </b>“पूजार्चना नमस्यार्चा सपर्येज्यार्हणाञ्चनम्” - वैज० ।<br><br>

अञ्चल
अञ्चल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನೆ / ಪೂಜೆ<br><b>निष्पत्तिः - </b>अञ्चु (गतिपूजनयोः) “कलः” (उ० १-१०६) ।<br><b>व्युत्पत्तिः - </b>अञ्चति प्रान्तम् ।<br><br>

अञ्चित
अञ्चित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अञ्चु (गतिपूजनयॊः) “क्तः” (३-२-१०२) ।<br><b>प्रयोगाः - </b>“गतेषु लीलाञ्चितविक्रमेषु” ।<br><b>उल्लेखाः - </b>कुमा० १-३४ ।<br><br>अञ्चित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>“उन्नद्धचूडोऽञ्चितसव्यजानुः” ।<br><b>उल्लेखाः - </b>रघु० १८-५१ ।<br><br>अञ्चित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನೋಹರವಾದ<br><b>प्रयोगाः - </b>“दिवसमुखोचितमञ्चिताक्षिपक्ष्मा” ।<br><b>उल्लेखाः - </b>रघु० ५-७६ ।<br><br>

अञ्जन
अञ्जन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಶ್ಚಿಮದಿಕ್ಕಿನ ದಿಗ್ಗಜ<br><br>अञ्जन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಪರ್ವತ<br><b>निष्पत्तिः - </b>“अच्” (५-२-१२७) ।<br><b>व्युत्पत्तिः - </b>अञ्जनवर्णोऽस्त्यस्य |<br><br>अञ्जन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಲ್ಲಿ / ಗೌಳಿ<br><br>अञ्जन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿರತೆ<br><br>अञ्जन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ / ಈಶ್ವರ<br><br>अञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣಿನ ಕಪ್ಪು / ಕಾಡಿಗೆ<br><b>निष्पत्तिः - </b>अञ्जू (व्यक्तिश्लक्ष्णकान्तिगतिषु) “ल्युट्” (३-३-११७) ।<br><b>व्युत्पत्तिः - </b>अज्यतेऽनेन नयनम् |<br><b>प्रयोगाः - </b>“विलोचनं दक्षिणमञ्जनेन सम्भाव्य तद्विञ्चितवामनेत्रा” |<br><b>उल्लेखाः - </b>रघु० ७-८ ।<br><br>अञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌವೀರಾಂಜನ<br><br>अञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣಿಗೆ ಹಾಕುವ ಬಣ್ಣ<br><br>अञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಸಾಂಜನ<br><b>विस्तारः - </b>“अञ्जनं कज्जले चाक्तौ सौवीरे च रसाञ्जने । पुंसि ज्येष्ठादिगजयोः” - मेदि० ।<br><br>अञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಾತ್ರಿ<br><br>अञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಂಜನಾ ವೃತ್ತಿ / ಆಲಂಕಾರಿಕರು ಹೇಳಿರುವ ಅಭಿಧಾ ಮತ್ತು ಲಕ್ಷಣಾವೃತ್ತಿಗಿಂತಲೂ ಬೇರೆಯಾದ (ಶಬ್ದದ) ಒಂದು ಶಕ್ತಿ<br><b>प्रयोगाः - </b>“अनेकार्थस्य शब्दस्य वाचकत्वे नियन्त्रिते । संयोगाद्यैरवाच्यार्थधीकृद्व्यापृतिरञ्जनम्” |<br><b>उल्लेखाः - </b>काव्यप्र० ।<br><br>अञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಲಿನ್ಯ / ಮಾಸಲು<br><br>अञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಸಿ / ಶಾಯಿ<br><b>विस्तारः - </b>1. “अञ्जनं मसौ । रसाञ्जनेऽक्तौ सौवीरेऽथाञ्जनो दिङ्मतङ्गजे” - हेम० । 2. “अञ्जनस्तु चित्रको लोहलाहलः” - त्रिकाण्ड० । 3. “अहिर्बुघ्न्यो रेरिहाणोऽहिबुन्ध्नः कपिशोऽञ्जनः” - कल्पद्रु० ।<br><br>

अञ्जना
अञ्जना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರದಿಗ್ಗಜದ ಪತ್ನಿ<br><br>अञ्जना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹನುಮಂತನ ತಾಯಿ<br><br>

अञ्जनगिरि
अञ्जनगिरि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇಂಕಟಾಚಲ / ತಿರುಪತಿ ಬೆಟ್ಟ<br><br>

अञ्जनाद्रि
अञ्जनाद्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇಂಕಟಾಚಲ / ತಿರುಪತಿ ಬೆಟ್ಟ<br><br>

अञ्जनावती
अञ्जनावती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಈಶಾನ್ಯದಿಗ್ಗಜದ ಪತ್ನಿ<br><b>निष्पत्तिः - </b>“मतुप्” (५-२-९४) । दीर्घः (६-३-११९)।<br><b>व्युत्पत्तिः - </b>अञ्जनमस्त्यस्याः |<br><br>

अञ्जलि
अञ्जलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೊಗಸೆ / ಜೋಡಿಸಿದ ಕೈಗಳ ಸಂಪುಟ<br><b>निष्पत्तिः - </b>अञ्जू (व्यक्तिश्लक्ष्णकान्तिगतिषु) “अलिच्” (उ० ४-२)।<br><b>व्युत्पत्तिः - </b>अज्यते व्यज्यते भक्तिरनेन |<br><b>प्रयोगाः - </b>“आसां जहासाञ्जलिमप्यपूर्वम्” |<br><b>उल्लेखाः - </b>याद० ४-४८ ।<br><br>अञ्जलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಳ್ಳ<br><b>विस्तारः - </b>“प्रसृतोऽस्त्री द्विमुष्टिके । प्रसृतौ द्वावञ्जलिः स्यात्”- वैज० ।<br><br>अञ्जलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಲ್ಕು ಹಿಡಿ / ನಾಲ್ಕುಮುಷ್ಟಿ<br><b>विस्तारः - </b>“माषः शाणस्तलं मुष्टिरञ्जलिः प्रस्थ आढकः । द्रोणो गोणी च खारी च क्रमादेतच्चतुर्गुणम्” - वैज० ।<br><br>

अञ्जलिका
अञ्जलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಟ್ಟಲಿ / ಸುಂಡಿಲಿ<br><br>

अञ्जस्
अञ्जस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೇಗ<br><br>अञ्जस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಲ<br><br>अञ्जस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯುಕ್ತತೆ / ಔಚಿತ್ಯ<br><b>निष्पत्तिः - </b>अञ्जू (व्यत्तयादौ) “असुन्” (उ० ४-१८८) । अञ्जसाकृतम् । (६-३-३) ಸೂತ್ರ ನೋಡಿ<br><br>

अञ्जस
अञ्जस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸರಳವಾದ / ವಕ್ರಬಲ್ಲದ / ಪ್ರಾಮಾಣಿಕವಾದ<br><br>

अञ्जसा
अञ्जसा<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ವೇಗವಾಗಿ / ಜಾಗ್ರತೆಯಾಗಿ<br><b>निष्पत्तिः - </b>अञ्जू (व्यक्त्यादौ) “अच्” (३-१-१३४)। षो (अन्तकर्मणि) “अच्” (३-१-१३४)।<br><b>व्युत्पत्तिः - </b>अञ्जनं | अञ्जं स्यति |<br><br>अञ्जसा<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ನಿಜವಾಗಿ / ವಾಸ್ತವವಾಗಿ<br><b>प्रयोगाः - </b>“साक्षाद्दृष्टोऽसि न पुनर्विद्मस्त्वां वयमञ्जसा” |<br><b>उल्लेखाः - </b>कुमा० ६-२२ ।<br><br>

अञ्जिष्ठ
अञ्जिष्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>अञ्जू (व्यक्त्यादौ) “इष्टच्” (उ० ४-२)।<br><br>

अञ्जी
अञ्जी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರೆಯುವ ಕಲ್ಲು / ಬೀಸುವ ಕಲ್ಲು / ಪುಡಿಮಾಡುವ ಯಂತ್ರ<br><br>

अट
अट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಚರಿಸುವ / ಅಲೆಡಾಡುವ<br><b>निष्पत्तिः - </b>अट (गतौ) “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अटति |<br><br>

अटन
अटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಚಾರ / ಅಲೆದಾಟ / ಓಡಾಟ<br><b>निष्पत्तिः - </b>अट (गतौ) भावे “ल्युट्” (३-३-११५) ।<br><b>प्रयोगाः - </b>“सर्वज्ञत्वमधीश्वरत्वमगमत्त्वां मां च भिक्षाटनम्” |<br><b>उल्लेखाः - </b>कुव० पु० ५१ ।<br><br>

अटनी
अटनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಧನುಸ್ಸಿನ ಅಗ್ರಭಾಗ / ಬಿಲ್ಲಿನ ತುದಿ<br><b>निष्पत्तिः - </b>अट (गतौ) “अनिः” बाहु० ।<br><b>व्युत्पत्तिः - </b>अटति गुणोऽत्र |<br><br>

अटरूष
अटरूष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಡುಸೋಗೆಗಿಡ<br><b>निष्पत्तिः - </b>रुष (हिंसायाम्) “कः” (३-१-१३५) । पुषो० ।<br><b>व्युत्पत्तिः - </b>अटान् व्याप्तान् रोगान् रोषति |<br><br>

अटवी
अटवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರಣ್ಯ / ಕಾಡು<br><b>निष्पत्तिः - </b>अट (गतौ) “अविः” ।<br><b>व्युत्पत्तिः - </b>अटन्त्यत्र |<br><b>प्रयोगाः - </b>“अटवीसम्पदमम्बुवाहयन्तीम्” |<br><b>उल्लेखाः - </b>याद० १५-८९ ।<br><br>

अटाट्या
अटाट्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಿರುಗಾಟ / ಅಲೆದಾಟ / ಸಂಚಾರ<br><b>निष्पत्तिः - </b>अट (गतौ) “शः” यक् च (वा० ३-३-१०१) निपा० ।<br><b>व्युत्पत्तिः - </b>अटनम् |<br><br>

अट्ट
अट्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಡಿಯ ಮೇಲುಭಾಗ / ಉಪ್ಪರಿಗೆಯ ಕೋಣೆ / ಮೇಲಣ ಕೊಠಡಿ<br><b>निष्पत्तिः - </b>अट्ट (अनादरे) “घञ्” (३-३-१२१) ।<br><b>व्युत्पत्तिः - </b>अट्यते अनाद्रियतेऽन्यद्यत्र |<br><br>अट्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಚ<br><br>अट्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೇಷ್ಮೆವಸ್ತ್ರ<br><br>अट्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪ್ಪರಿಗೆ ಮನೆ<br><br>अट्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರವಾಹ<br><br>अट्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗಡಿ ಬೀದಿ / ವ್ಯಾಪಾರಸ್ಥಳ<br><br>अट्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನ<br><br>अट्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎತ್ತರವಾದ<br><br>अट्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾದ<br><br>अट्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶುಷ್ಕವಾದ / ಒಣಗಿದ<br><b>विस्तारः - </b>1. “अट्टं भक्ते च शुष्के च क्षोमेऽत्यर्थे गृहान्तरे” - विश्व० । 2. “अट्टो हट्टाऽट्टालकयोर्भृशे । चतुष्कभक्तयोः”- हेम० । 3. “अट्टस्त्वट्टालके पूरे भृशशुष्केऽप्ययं त्रिषु । अट्टन्त्वन्ने”- नानार्थर० ।<br><br>

अट्टस्थली
अट्टस्थली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪ್ಪರಿಗೆ ಮನೆಗಳುಳ್ಳ ಪಟ್ಟಣ<br><b>व्युत्पत्तिः - </b>अट्टप्रधाना स्थली ।<br><br>

अट्टहास
अट्टहास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾದ ನಗು / ಶಬ್ದವಾಗುವಂತೆ ನಗುವಿಕೆ<br><b>निष्पत्तिः - </b>हसे (हसने) “घञ्” (३-३-१८) ।<br><b>व्युत्पत्तिः - </b>अट्टेन अतिशयेन हासः |<br><br>

अट्टहासिन्
अट्टहासिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ / ಶಿವ<br><br>अट्टहासिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ ನಗುವವನು<br><b>निष्पत्तिः - </b>“णिनिः” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अट्टं हसति |<br><br>

अट्टालक
अट्टालक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಿನ ಕೊಠಡಿ / ಉಪ್ಪರಿಗೆ<br><br>

अट्टालिका
अट्टालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಳಿಗೆಮನೆಯ ಮೇಲು ಭಾಗ / ಮಹಡಿಯ ಮೇಲಿನ ಬಯಲು ಪ್ರದೇಶ<br><b>विस्तारः - </b>“तलिन्यट्टालिके समे । चन्द्रशाला शिरोगृहम्” - वैज० ।<br><br>

अट्टालिकाकार
अट्टालिकाकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮಾಟಿಗ / ಗಾರೆ-ಕೆಲಸದವನು<br><br>

अणक
अणक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಮ / ನೀಚ / ಅಲ್ಪ / ಕೆಟ್ಟವನು<br><b>निष्पत्तिः - </b>अण (शब्दे) “ण्वुल्” (३-१-१३३) ।<br><b>व्युत्पत्तिः - </b>अणति |<br><b>विस्तारः - </b>“निष्कृष्टाणककुत्सिताः” - वैज० ।<br><br>

अणवीन
अणवीन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರುನವಣೆ ಬೆಳೆಯಲು ಯೋಗ್ಯವಾದ ಭೂಮಿ<br><b>निष्पत्तिः - </b>अणु “खञ्” (५-२-४) ।<br><b>व्युत्पत्तिः - </b>अणुनां भवनं क्षेत्रम् |<br><br>

अणव्य
अणव्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರುನವಣೆ ಬೆಳೆಯಲು ಯೋಗ್ಯವಾದ ಭೂಮಿ<br><b>निष्पत्तिः - </b>अणु “यत्” (५-२-४) ।<br><b>व्युत्पत्तिः - </b>अणुनां भवनं क्षेत्रम् |<br><br>

अणि
अणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಡಾಣಿ / ಬಂಡಿಯ ಚಕ್ರದ ತಡೆಗಾಗಿ ಹಾಕುವ ಆಣಿ<br><br>अणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಜಿ ಮೊದಲಾದುವುಗಳ ತುದಿ<br><br>अणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಲ್ಲೆ / ಗಡಿ<br><b>निष्पत्तिः - </b>अण (शब्दे) “इन्” (उ० ४-११८) ।<br><b>व्युत्पत्तिः - </b>अणति |<br><b>विस्तारः - </b>“अणिराणिवदक्षाग्रकीलाश्रिसीमसु द्वयोः” मेदि०।<br><br>

अणिमन्
अणिमन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಕ್ಷ್ಮತೆ / ತೆಳುವಾಗಿರುವಿಕೆ<br><br>अणिमन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾಣುರೂಪ<br><br>अणिमन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರನ ಎಂಟು ಸಿದ್ಧಿಗಳಲ್ಲೊಂದು<br><b>निष्पत्तिः - </b>“इमनिच्” (५-१-११२) ।<br><b>व्युत्पत्तिः - </b>अणोर्भावः |<br><b>प्रयोगाः - </b>“अणिमादिगुणोपेतमस्पृष्टपुरुषान्तरम्” |<br><b>उल्लेखाः - </b>कुमा० ६-७५ ।<br><br>

अणिमाण्डव्य
अणिमाण्डव्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಮಹರ್ಷಿ<br><b>विस्तारः - </b>[ಈತನು ಚಿಕ್ಕಿಂದಿನಲ್ಲಿ ನೊಣಗಳನ್ನು ಹಿಡಿದು ಸಾಯಿಸುತ್ತಿದ್ದನು. ವಯಸ್ಸಾದ ಮೇಲೆ ಈತನು ಸಮಾಧಿಯಲ್ಲಿದ್ದಾಗ ಒಂದು ದಿನ ಕೆಲವು ಕಳ್ಳರು ಇವನ ಆಶ್ರಮದಲ್ಲಿ ಅವಿತುಕೊಳ್ಳಲು ರಾಜಪುರುಷರು ಆ ಕಳ್ಳರೊಡನೆ ಈತನನ್ನೂ ಎಳೆದುಕೊಂಡು ರಾಜನಲ್ಲಿಗೆ ಕರೆದೊಯ್ದು ರಾಜನ ಅಪ್ಪಣೆಯಂತೆ ಈತನನ್ನೂ ಅವರೊಡನೆ ಶೂಲಕ್ಕೇರಿಸಿದರು. ಕಳ್ಳರೆಲ್ಲರೂ ಸತ್ತರೂ ಈತನು ಬದುಕಿದ್ದುದನ್ನು ಕಂಡು ರಾಜನು ಹೆದರಿ ಶೂಲದಿಂದಿಳಿಸಿ ನಮಸ್ಕರಿಸಿ ಕ್ಷಮೆಯನ್ನು ಬೇಡಿದನು. ಅಣಿಮಾಂಡವ್ಯನು ಶೂಲವನ್ನು ಮುರಿದು ಕೈಯಲ್ಲಿ ಹಿಡಿದುಕೊಂಡು ಹೊರಟು ಶರೀರವನ್ನು ತ್ಯಜಿಸಿದನು. ಆಗ ಯಮದೂತರು ಬಂದು ಈತನನ್ನು ಯಮನಲ್ಲಿಗೆ ಕರೆದೊಯ್ಯಲಾಗಿ “ನಾನು ಯಾವ ಪಾಪವನ್ನೂ ಮಾಡದಿದ್ದರೂ ನನ್ನನ್ನೇಕೆ ಇಲ್ಲಿಗೆ ಕರೆತಂದರು” ಎಂದು ಕೇಳಿದನು. “ನೀನು ಬಾಲ್ಯದಲ್ಲಿ ನೊಣಗಳನ್ನು ಹಿಡಿದು ಕೊಲ್ಲುತ್ತಿದ್ದೆಯಾದ್ದರಿಂದ ನಿನಗೆ ನರಕ ಪ್ರಾಪ್ತವಾಯಿತು” ಎಂದು ಯಮಧರ್ಮರಾಯನು ಹೇಳಲು, “ಬಾಲ್ಯದಲ್ಲಿ ಮಕ್ಕಳು ಮಾಡುವ ಪಾಪಕ್ಕೆ ತಾಯಿತಂದೆಗಳು ಭಾಗಿಗಳೆಂಬ ಧರ್ಮಸೂಕ್ಷ್ಮವನ್ನರಿಯದೆ ನನಗೆ ಈ ಶಿಕ್ಷೆಯನ್ನು ಕೊಟ್ಟಿದ್ದರಿಂದ ನೀನು ಭೂಲೋಕದಲ್ಲಿ ಶೂದ್ರನಾಗಿ ಹುಟ್ಟು” ಎಂದು ಶಾಪವಿತ್ತನು. ಅದರಿಂದ ಯಮನು ಭೂಮಿಯಲ್ಲಿ ವಿದುರನಾಗಿ ಹುಟ್ಟಿದನು.]<br><br>

अणिष्ठ
अणिष्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಸಣ್ಣದಾದ / ಬಹಳ ತೆಳುವಾದ<br><b>निष्पत्तिः - </b>“इष्ठन्” (५-३-५५) ।<br><b>व्युत्पत्तिः - </b>अतिशयेन अणुः |<br><br>

अणीयस्
अणीयस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಸಣ್ಣದಾದ / ಬಹಳ ತೆಳುವಾದ<br><b>निष्पत्तिः - </b>“ईयसुन्”(५-३-५७) ।<br><b>व्युत्पत्तिः - </b>अतिशयेन अणुः |<br><b>प्रयोगाः - </b>“अणीयसे विश्वविधारिणे नमः” |<br><b>उल्लेखाः - </b>किरा० १८-४१ ।<br><br>

अणु
अणु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರುನವಣೆ / ಸಣ್ಣ ಭತ್ತ<br><b>निष्पत्तिः - </b>अण (शब्दे) “उः” (उ० १०८) ।<br><b>व्युत्पत्तिः - </b>अणति |<br><br>अणु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಭಾಗ / ಸೂಕ್ಷ್ಮ ಭಾಗ<br><br>अणु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಲ್ಪ / ಸೂಕ್ಷ್ಮ / ಸಣ್ಣ<br><b>प्रयोगाः - </b>“अणुरप्यपहन्ति विग्रहः” |<br><b>उल्लेखाः - </b>किरा० २-५१ ।<br><b>विस्तारः - </b>“अणुर्व्रीहिविशेषे स्यात्पुंसि सूक्ष्मेऽभिधेयवत्” - मेदि० ।<br><br>

अणुक
अणुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರುನವಣೆ, ಸಣ್ಣ ಭತ್ತ, ಶಾಮೆ ಮೊದಲಾದ ಧಾನ್ಯ<br><b>निष्पत्तिः - </b>अणु स्वार्थे “कन्” ।<br><br>अणुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೂಕ್ಷ್ಮ / ಅಲ್ಪ / ಸಣ್ಣ<br><br>

अणुत्व
अणुत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣದಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>“त्वः” (५-१-११९) ।<br><b>व्युत्पत्तिः - </b>अणोर्भावः |<br><br>

अणुधर्म
अणुधर्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಕ್ಷ್ಮವಾದ ಧರ್ಮ / ತಿಳಿಯಲಾಗದ ಧರ್ಮ<br><br>

अणुभा
अणुभा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿದ್ಯುತ್ತು / ಮಿಂಚು<br><b>व्युत्पत्तिः - </b>अण्वीभा कान्तिः यस्याः ।<br><br>

अणुमात्र
अणुमात्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಣುವಿನ ಗಾತ್ರವುಳ್ಳ / ಸೂಕ್ಷ್ಮ ಪರಿಮಾಣವುಳ್ಳ<br><b>निष्पत्तिः - </b>अणु “मात्रच्” (५-२-३७) ।<br><b>व्युत्पत्तिः - </b>अणुः परिमाणं यस्य |<br><b>प्रयोगाः - </b>“अणुमात्रमिदं सहेत वोढुं न हि विश्वम्भरमद्य मामितीव” |<br><b>उल्लेखाः - </b>चं० भा० ३-६६ ।<br><br>

अणुवीक्षण
अणुवीक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಕ್ಷ್ಮದರ್ಶಕಯಂತ್ರ / ಭೂತಗನ್ನಡಿ<br><b>निष्पत्तिः - </b>वि + ईक्ष (दर्शने) कर० “ल्युट्” (३-३-११७) ।<br><b>व्युत्पत्तिः - </b>अणुः वीक्ष्यतेऽनेन |<br><br>

अणुव्रीहि
अणुव्रीहि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಕ್ಷ್ಮ ಧಾನ್ಯ, ಸಣ್ಣ ಭತ್ತ, ಕಿರುನೆಲ್ಲು, ನವಣೆ ಮೊದಲಾದುದು<br><b>व्युत्पत्तिः - </b>अणुश्चासौ व्रीहिश्च ।<br><br>

अण्ड
अण्ड<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೃಷಣ / ಬೀಜ<br><br>अण्ड<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಟ್ಟೆ / ತತ್ತಿ<br><b>निष्पत्तिः - </b>अम (गतिशब्दसम्भक्तिषु) “डः” (उ० १-१११) ।<br><b>व्युत्पत्तिः - </b>अमत्यस्मात् |<br><br>अण्ड<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಾಂಡ / ಪ್ರಪಂಚಕ್ಕೆ ಆಶ್ರಯವಾದ ಕೋಶ<br><b>प्रयोगाः - </b>“तदण्डमभवद्धैमं सहस्रांशुसमप्रभम्” |<br><b>उल्लेखाः - </b>मनु० १-९ ।<br><br>अण्ड<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೀರ್ಯ / ಧಾತು<br><br>अण्ड<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಸ್ತೂರಿಮೃಗದ ಹೊಕ್ಕಳಿನ ಗ್ರಂಥಿ<br><b>विस्तारः - </b>1. “अण्डं मुष्के च पेश्यां च” - मेदि० । 2. “अण्डं खगादिकंषेस्यान्मुष्के वीर्योऽपि च क्वचित्” - विश्व० ।<br><br>

अण्डक
अण्डक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಾಂಡ / ಜಗತ್ತಿಗೆ ಆಶ್ರಯವಾದ ಕೋಶ<br><b>प्रयोगाः - </b>“जगदण्डकैकतरखण्डमिव” |<br><b>उल्लेखाः - </b>माघ० ९-९ ।<br><br>

अण्डकटाह
अण्डकटाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಾಂಡದಮೇಲಿನ ಹೊದ್ದಿಕೆ / -ಆವರಣ<br><br>

अण्डकोश
अण्डकोश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಷಣ / ಬೀಜ<br><b>व्युत्पत्तिः - </b>अण्डयोः कोशः ।<br><br>

अण्डज
अण्डज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಕ್ಷಿ / ಹಕ್ಕಿ<br><br>अण्डज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ<br><br>अण्डज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೀನು<br><br>अण्डज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಓತಿಕೇತ<br><br>अण्डज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಸ್ತೂರಿ<br><br>अण्डज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊಟ್ಟೆಯಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) “डः” (३-२-९७) ।<br><b>व्युत्पत्तिः - </b>अण्डे जायते |<br><b>विस्तारः - </b>ಮೇದಿನೀಕಾರರು “ಕಸ್ತೂರಿ” ಎಂಬರ್ಥದಲ್ಲಿಯೂ ಪುಲ್ಲಿಂಗವೆಂದು ಹೇಳಿರುತ್ತಾರೆ. 1. “अण्डजो मत्स्ये खगे कस्तूरिकाण्डजा” वैज० । 2. “अण्डजो मृगनाभौ स्यात्सरटेऽहौ खगे झषे” - मेदि० |<br><br>

अण्डजा
अण्डजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಓತಿಕೇತ<br><br>

अण्डजात
अण्डजात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>“अण्डज” ಪದದ ಅರ್ಥ<br><br>

अण्डालु
अण्डालु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೀನು<br><br>

अण्डुक
अण्डुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಡೂಕ / ಕಪ್ಪೆ<br><b>विस्तारः - </b>“भेके शालुः प्लवव्यङ्गशालूराण्डुककेण्डुकाः” - वैज० ।<br><br>अण्डुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಟಿಟ್ಟಭ ಪಕ್ಷಿ<br><b>विस्तारः - </b>“टिट्टिभस्तु कटुववाण उत्पादशयनोण्डुकः” - वैज० ।<br><br>अण्डुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಡಕೋಶ<br><b>विस्तारः - </b>“फेलुको वृषणोऽण्डुकः” - वैज० ।<br><br>

अत्
अत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸತತ ಗಮನ / ಎಡಬಿಡದ ಸಂಚಾರ<br><b>निष्पत्तिः - </b>अत (सातत्यगमने) “क्विप्” (वा० ३-३-१०८) ।<br><br>

अतट
अतट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಟ್ಟದ ಎತ್ತರವಾದ ಜಾಗ / ಕಮರಿ<br><b>व्युत्पत्तिः - </b>नास्ति तटं यस्य ।<br><b>प्रयोगाः - </b>“असन्निवृत्त्यै तदतीतमेते मनोरथानामतटाः प्रपातः” |<br><b>उल्लेखाः - </b>शाकु० ६-१० ।<br><br>अतट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಡವಿಲ್ಲದ / ತೀರವಿಲ್ಲದ<br><br>

अतटप्रपात
अतटप्रपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭರದಿಂದ ಬೀಳುವ ಪ್ರವಾಹ / ದಡವಿಲ್ಲದೆ ಹದ್ದುಮೀರಿದ ಜಲಪಾತ<br><b>व्युत्पत्तिः - </b>अतटश्चासौ प्रपातश्च ।<br><br>

अतथा
अतथा<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಹಾಗಲ್ಲದೆ / ಆ ರೀತಿಯಲ್ಲಲ್ಲದೆ<br><b>व्युत्पत्तिः - </b>न तथा ।<br><br>

अतथोचित
अतथोचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಾಗೆ ಯೋಗ್ಯವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न तथा उचितः ।<br><br>

अतदर्ह
अतदर्ह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅದಕ್ಕೆ ಯೋಗ್ಯವಲ್ಲದ<br><br>अतदर्ह<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಅದಕ್ಕೆ ತಕ್ಕುದಲ್ಲದೆ / ಅಯೋಗ್ಯ ರೀತಿಯಲ್ಲಿ<br><br>

अतद्गुण
अतद्गुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಅಲಂಕಾರ / ಅರ್ಥಾಲಂಕಾರದ ಒಂದು ಭೇದ<br><b>प्रयोगाः - </b>“सङ्गतान्यगुणानङ्गीकारमाहुरतद्गुणम्” |<br><b>उल्लेखाः - </b>कुव० पु० १५० ।<br><b>विस्तारः - </b>ತನ್ನೊಡನೆ ಸಂಬಂಧಿಸಿದ ಮತ್ತೊಂದು ವಸ್ತುವಿನ ಗುಣವನ್ನು ಹೊಂದದಿರುವುದು ಅತದ್ಗುಣವು.<br><br>

अतद्गुणसंविज्ञान
अतद्गुणसंविज्ञान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಹುವ್ರೀಹಿಸಮಾಸದ ಒಂದು ಭೇದ<br><b>व्युत्पत्तिः - </b>तस्य गुणाः । तद्गुणानां संविज्ञानं न यत्र ।<br><b>विस्तारः - </b>“दृष्टसमुद्रमानय” ಎಂಬಲ್ಲಿ ಸಮುದ್ರ ಪದಾರ್ಥಕ್ಕೆ ಆನಯನದಲ್ಲಿ ಅನ್ವಯವಿಲ್ಲದೆ ಸಮುದ್ರವನ್ನು ನೋಡಿದವನಲ್ಲಿ ಮಾತ್ರ ಅನ್ವಯವಿರುವುದರಿಂದ “अतद्गुणसंविज्ञान” ಬಹುವ್ರೀಹಿ.<br><br>

अतनु
अतनु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥ / ಕಾಮದೇವ<br><br>अतनु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೊಡ್ಡದಾದ<br><b>प्रयोगाः - </b>“अतनुकचरानतेन भूयः” |<br><b>उल्लेखाः - </b>माघ० ७-६६ ।<br><br>अतनु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾದ<br><br>

अतन्त्र
अतन्त्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರಣಕ್ಕೆ ಅಧೀನವಲ್ಲದ / ನಿಯಮಕ್ಕೆ ವಿಷಯವಲ್ಲದ / ಅಂಕೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न तन्त्रं कारणं यस्य ।<br><br>अतन्त्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಿವಕ್ಷಿತ / ಪ್ರಕೃತವಲ್ಲದ / ಪ್ರಧಾನವಲ್ಲದ<br><br>

अतन्द्र
अतन्द्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿದ್ರೆಯಿಲ್ಲದ<br><br>अतन्द्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೋಮಾರಿತನವಿಲ್ಲದ<br><br>अतन्द्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಣಿವಿಲ್ಲದ / ಆಯಾಸವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति तन्द्रा यस्य ।<br><br>

अतन्द्रित
अतन्द्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿದ್ರೆಬಾರದ<br><b>निष्पत्तिः - </b>“इतच्” (५-२-३६) ।<br><b>व्युत्पत्तिः - </b>न तन्द्रा जाताऽस्य |<br><br>अतन्द्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಲಸ್ಯವಿಲ್ಲದ / ಸೋಮಾರಿತನವಿಲ್ಲದ<br><b>प्रयोगाः - </b>1. “ददुरशेषमतन्द्रितचेतसः” | 2. “अतन्द्रिता सा स्वयमेव वृक्षकान्” |<br><b>उल्लेखाः - </b>1. याद० ३-६ । 2. कुमा० ५-१४ ।<br><br>

अतपस्
अतपस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಪಸ್ಸಿಲ್ಲದವನು<br><br>अतपस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಾರ್ಮಿಕ<br><br>अतपस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮತಸಂಬಂಧವಾದ ನಿಯಮವನ್ನಾಚರಿಸದವನು<br><br>

अतप्त
अतप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಡಲ್ಪಡದ / ಬಿಸಿಮಾಡಲ್ಪಡದ / ಕಾಯಿಸಲ್ಪಡದ<br><br>

अतप्ततनु
अतप्ततनु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಪ್ತ ಮುದ್ರಾಧಾರಣವಿಲ್ಲದವನು / ವೈಷ್ಣವ ಗುರುತಾದ ಶಂಖ ಚಕ್ರಾದಿಗಳನ್ನು ಧರಿಸದ ಶರೀರವುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>अतप्ता तनुर्यस्य ।<br><br>

अतर्क
अतर्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಶಯವಿಲ್ಲದ<br><br>अतर्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರಣವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति तर्को यस्य ।<br><br>अतर्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಹೆಯಿಲ್ಲದ<br><br>अतर्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆಯಿಲ್ಲದ<br><b>विस्तारः - </b>“तर्काः काङ्क्षावितर्कोहाः” -वैज० ।<br><br>

अतर्कित
अतर्कित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಿರೀಕ್ಷಿತವಾದ / ಆಕಸ್ಮಿಕ / ಊಹಿಸಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न तर्कितम् ।<br><br>

अतल
अतल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾತಾಳಲೋಕದ್ಕ ಏಳು ವಿಭಾಗಗಳಲ್ಲೊಂದು / ಏಳು ಪಾತಾಳಲೋಕಗಳಲ್ಲಿ ಮೊದಲನೆಯ ಲೋಕ<br><b>व्युत्पत्तिः - </b>अस्य भूखण्डस्य तलम् । पुषो० । इदमोऽत्वम् ।<br><b>विस्तारः - </b>ಸಪ್ತ ಪಾತಾಳಲೋಕಗಳು: ಅತಲ, ವಿತಲ, ಸುತಲ, ತಲಾತಲ, ಮಹಾತಲ, ರಸಾತಲ ಮತ್ತು ಪಾತಾಳ.<br><br>अतल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>|||<br><b>व्युत्पत्तिः - </b>नास्ति तलं यस्य ।<br><br>

अतलस्पर्श
अतलस्पर्श<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಳವಾದ / ನೆಲ ಕಾಣಿಸದ / ತಳಭಾಗವು ಕಾಣದಿರುವ<br><b>व्युत्पत्तिः - </b>न तलस्य स्पर्शो यत्र ।<br><br>

अतलस्पर्शिन्
अतलस्पर्शिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬುಡವನ್ನು ಮುಟ್ಟದ<br><b>निष्पत्तिः - </b>स्पृश (संस्पर्शने) “णिनिः” (३-२-७८) |<br><b>व्युत्पत्तिः - </b>न तलं स्पृशति |<br><br>

अतलस्पृश्
अतलस्पृश्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬುಡವನ್ನು ಮುಟ್ಟದ<br><b>निष्पत्तिः - </b>स्पृश (संस्पर्शने) “क्वन्” (३-२-५८) ।<br><b>व्युत्पत्तिः - </b>न तलं स्पृशति |<br><br>

अतस्
अतस्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಈ ಕಾರಣದಿಂದ / ಇವನಿಂದ / ಇವಳಿಂದ / ಇದರಿಂದ<br><b>निष्पत्तिः - </b>इदम् “तसिल्” (५-३-७) ।<br><b>प्रयोगाः - </b>“अतोऽत्र किञ्चिद्भवतीं बहुक्षमाम्” |<br><b>उल्लेखाः - </b>कुमा० ५-४० ।<br><br>अतस्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಇವನಿ(ಳಿ)ಗಿಂತಲೂ / ಇದಕ್ಕಿಂತಲೂ<br><b>प्रयोगाः - </b>“त्वय्यतोऽन्यन्न जाने” |<br><b>उल्लेखाः - </b>मु० मा० ।<br><br>

अतस
अतस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯು / ಗಾಳಿ<br><b>निष्पत्तिः - </b>अत (सातत्यगमने) “असच्” (उ० ३-११७) ।<br><b>व्युत्पत्तिः - </b>अतति |<br><br>अतस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮ / ಜೀವ<br><b>विस्तारः - </b>“अततीत्यतसो वायुरात्मा च” - सि० कौ० ।<br><br>अतस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾರುಮಡಿ<br><br>अतस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಯುಧ<br><b>प्रयोगाः - </b>“अतसः क्ष्ॐअं प्रहरणं वायुश्च” |<br><b>उल्लेखाः - </b>माघ० धातु० ।<br><br>

अतसी
अतसी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಜಿಯನಾರು<br><br>अतसी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸೆಗಿಡ<br><br>अतसी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸೆನಾರು<br><b>निष्पत्तिः - </b>अत (सातत्यगमने) “असच्” (उ० ३-११७) “डीष्” (४-१-४१) ।<br><b>प्रयोगाः - </b>“लक्ष्मीविद्युल्लसितमतसीगृच्छसच्छायकायम्” |<br><b>उल्लेखाः - </b>चं रा० १-२२ ।<br><br>

अति
अति<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಬಹಳ / ಮಿತಿಮೀರಿದ<br><b>प्रयोगाः - </b>“अतिकोमलमेकमन्यतः” |<br><b>उल्लेखाः - </b>माघ० १६-१८ ।<br><b>विस्तारः - </b>ಈ ಕೆಳಗಿನ ಅರ್ಥಗಳಿಗೆ ದ್ಯೋತಕವಾಗಿ ಪದಗಳ ಹಿಂದೆ ಸೇರಿಸಲ್ಪಡುವ ಒಂದು ಅವ್ಯಯ<br><br>अति<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಉತ್ಕರ್ಷ / ಶ್ರೇಷ್ಠತೆ<br><br>अति<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಪೂಜೆ / ಗೌರವ / ಮರ್ಯಾದೆ<br><br>अति<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮಣ / ಮೀರುವಿಕೆ<br><br>अति<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಪರಾಕ್ರಮ / ಶಕ್ತಿ<br><b>प्रयोगाः - </b>1. “अतिराघवरावणं तदानीम्” |<br><b>उल्लेखाः - </b>1. याद० १५-१२१ ।<br><b>विस्तारः - </b>“अतिशब्दः प्रशंसायां प्रक्रषे लङ्घनेऽपि च । नितान्तासम्प्रतिक्षेपवाचकोऽप्येष दर्शितः” - मेदि० ।<br><br>

अतिकथ
अतिकथ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲು ಯೋಗ್ಯವಲ್ಲದ<br><br>अतिकथ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಂಬಲು ಅರ್ಹವಲ್ಲದ<br><br>अतिकथ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಳೆದುಹೋದ<br><br>

अतिकथा
अतिकथा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಶಯೋಕ್ತಿ / ಸ್ವಭಾವವನ್ನು ಮೀರಿ ಹೇಳುವುದು<br><b>व्युत्पत्तिः - </b>अत्युत्कटा कथा ।<br><br>

अतिकश
अतिकश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುಷ್ಟತುರಗ / ಅಡಗಿಸಲಾಗದ ಕುದುರೆ / ಚಾವಟಿಯ ಏಟಿಗೂ ಬಗ್ಗದ ಕುದುರೆ<br><b>व्युत्पत्तिः - </b>अतिक्रान्तः कशाम् ।<br><br>

अतिकाय
अतिकाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾವಣನ ಮಗ<br><br>अतिकाय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಳತೆ ಮೀರಿದ ದೇಹವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अत्युत्कटः कायो यस्य ।<br><br>

अतिकृच्छ्र
अतिकृच्छ्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಂದ್ರಾಯಣ ವ್ರತವನ್ನೂ ಮೀರಿದ ಒಂದು ವ್ರತ / ಹನ್ನೆರಡು ದಿವಸಗಳಲ್ಲಿ ನಡೆಸಬಹುದಾದ ಒಂದು ಪ್ರಾಯಶ್ಚಿತ್ತ<br><b>व्युत्पत्तिः - </b>अतिक्रान्तं कृच्छ्रम् ।<br><b>प्रयोगाः - </b>“एकैकं ग्रासमश्नीयात् त्र्यहाणि त्रीणि पूर्ववत् । त्र्यहं चोपवसेदन्त्यमतिकृच्छ्रं चरन् द्विजः” ||<br><b>उल्लेखाः - </b>मनु० ११-११३ ।<br><br>अतिकृच्छ्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಕಷ್ಟ<br><b>व्युत्पत्तिः - </b>अतिशयितं कृच्छ्रम् ।<br><br>अतिकृच्छ्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕಷ್ಟವುಳ್ಳ<br><br>

अतिकृत
अतिकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲೆ ಮೀರಿ ನಡೆಸಿದ / ಹೆಚ್ಚಾಗಿ ಮಾಡಿದ<br><b>व्युत्पत्तिः - </b>अतिक्रमेण कृतम् ।<br><br>

अतिकृति
अतिकृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಲ್ಲೆಮೀರಿ ಕೆಲಸಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>अति+डु कृञ् (करणे) “क्तिन्” (३-३-९४) ।<br><br>

अतिक्रम
अतिक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಮವನ್ನು ಬಿಟ್ಟು ನಡೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>अति + क्रमु (पादविक्षेपे) “घञ्” (३-३-१८) ।<br><b>व्युत्पत्तिः - </b>अतिक्रान्तः क्रमम् |<br><br>अतिक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಲ್ಲಂಘನೆ / ಶಿಸ್ತು ಮೀರುವಿಕೆ<br><br>अतिक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಜ್ಞಾಭಂಗ<br><br>अतिक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮ ಪವೇಶ / ಅಪ್ಪಣೆಮೀರಿ ನಡೆಯುವಿಕೆ<br><br>अतिक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಳೆದು ಹೋಗುವಿಕೆ (ಕಾಲ)<br><b>व्युत्पत्तिः - </b>कालातिक्रमः ।<br><br>अतिक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂದುಳಿಸುವಿಕೆ / ದಾಟಿಹೋಗುವಿಕೆ / ಮುಂದೆ ಸಾಗುವಿಕೆ<br><br>

अतिक्रमण
अतिक्रमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>“अतिक्रम” ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अति+क्रमु भावे” ल्युट्” (३-३-११५) ।<br><br>

अतिक्रमणीय
अतिक्रमणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೀರಬಹುದಾದ / ಉಲ್ಲಂಘಿಸಲು ಅರ್ಹವಾದ<br><b>प्रयोगाः - </b>“अनतिक्रमणीयं मे सुहृद्वाक्यम्” |<br><b>उल्लेखाः - </b>शाकु० २ ।<br><br>

अतिक्रान्त
अतिक्रान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೀರಲ್ಪಟ್ಟ / ಉಲ್ಲಂಘಿಸಲ್ಪಟ್ಟ<br><br>अतिक्रान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಳೆದುಹೋದ / ಗತಿಸಿದ<br><b>प्रयोगाः - </b>“अतिक्रान्तपार्थिदगुणान्” |<br><b>उल्लेखाः - </b>मुद्रा० १ ।<br><br>

अतिक्रान्ति
अतिक्रान्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>“अतिक्रम” ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अति+क्रमु (पादविक्षेपे) “क्तिन्” (३-३-९४) ।<br><br>

अतिक्रुद्ध
अतिक्रुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕೋಪಗೊಂಡ<br><b>निष्पत्तिः - </b>अति+कृध (कोपे) “क्तः” (३-२-१०२) ।<br><br>

अतिक्रूर
अतिक्रूर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕ್ರೂರ / ನಿರ್ದಯ / ಕರುಣೆಯಿಲ್ಲದವನು<br><br>

अतिगण्ड
अतिगण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೊಡ್ಡಗಲ್ಲ / ಅಗಲವಾದ ಕೆನ್ನೆ<br><br>अतिगण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಕಂಭ ಮೊದಲಾದ ಇಪ್ಪತ್ತೇಳು ಯೋಗಗಳಲ್ಲೊಂದು<br><b>विस्तारः - </b>[ವಿವರಕ್ಕೆ “योग” ಪದದಲ್ಲಿ ನೋಡಿ.]<br><br>अतिगण्ड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗಲವಾದ ಕೆನ್ನೆಯುಳ್ಳವನು<br><br>

अतिगन्ध
अतिगन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪಿಗೆಮರ<br><b>व्युत्पत्तिः - </b>अतिशयितो गन्धो यस्य ।<br><br>अतिगन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಧಕ<br><br>अतिगन्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ವಾಸನೆಯುಳ್ಳ<br><br>

अतिगर्वित
अतिगर्वित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಗರ್ವದಿಂದ ಕೂಡಿದವನು / ಹೆಚ್ಚು ಕೊಬ್ಬಿದವನು<br><br>

अतिगव
अतिगव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಮೂರ್ಖ / ಮಂಕ / ಹೆಡ್ಡ / ವಿವೇಚನಾಶಕ್ತಿಯಿಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>अतिक्रान्तो गाम् । अतिक्रान्तो गाम् वाचम् ।<br><b>विस्तारः - </b>[ಬುದ್ಧಿಯಲ್ಲಿ ಹಸುವನ್ನೂ ಮೀರಿದವನು.]<br><br>अतिगव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವರ್ಣನೀಯ / ವರ್ಣನಾತೀತ / ವರ್ಣಿಸಲಾಗದ<br><br>

अतिगुरु
अतिगुरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜ್ಯ / ಗೌರವಕ್ಕೆ ಅರ್ಹನಾದವನು<br><b>व्युत्पत्तिः - </b>अतिशयितो गुरुः |<br><b>प्रयोगाः - </b>“त्रयः पुरुषस्यातिगुरवो भवन्ति पिता माताचार्यश्च” ।<br><b>विस्तारः - </b>[ತಾಯಿ, ತಂದೆ ಮತ್ತು ಆಚಾರ್ಯ ಇವರು ಅತಿಗುರುಗಳು.]<br><br>अतिगुरु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಭಾರವುಳ್ಳ<br><br>

अतिगुर्वी|अतिगुरु
अतिगुर्वी-गुरु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अतिगुरु ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><br>

अतिग्रह
अतिग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನೇಂದ್ರಿಯ ಮತ್ತು ಕರ್ಮೇಂದ್ರಿಯಗಳು<br><b>व्युत्पत्तिः - </b>अतिशयितो ग्रहो ज्ञानं येषाम् ।<br><br>अतिग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಜ್ಞಾನ / ಉತ್ತಮವಾದ ಜ್ಞಾನ<br><b>व्युत्पत्तिः - </b>अतिशयितो ग्रहः ।<br><br>अतिग्रह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲು ಅಶಕ್ಯವಾದ / ತಿಳಿವಳಿಕೆಯನ್ನು ಮೀರಿದ<br><b>व्युत्पत्तिः - </b>अतिक्रान्तो ग्रहम् ।<br><br>

अतिचरा
अतिचरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಟ್ಟದಾವರೆ<br><b>निष्पत्तिः - </b>अति+चर (गतौ) “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अत्यर्थं चरति व्याप्नोति |<br><br>अतिचरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೆಲದಾವರೆ<br><br>

अतिचार
अतिचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಹಗಳು ಬೇರೆ ರಾಶಿಗಳಲ್ಲಿ ಸಂಚರಿಸುವುದು / ಕುಜಾದಿಗ್ರಹಗಳು ಆಯಾ ರಾಶಿಗಳಲ್ಲಿ ಕ್ಲೃಪ್ತಕಾಲದಲ್ಲಿರದೆ ಬೇರೆ ರಾಶಿಗಳಿಗೆ ಹೋಗಿ ಸೇರುವುದು<br><b>व्युत्पत्तिः - </b>अतिक्रम्य चारः राश्यन्तरगमनम् ।<br><br>

अतिचारिन्
अतिचारिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಚಾರವುಳ್ಳ ಗ್ರಹ / ಕ್ಲೃಪ್ತಕಾಲದಲ್ಲಿ ತಾನಿರಬೇಕಾದ ರಾಶಿಯನ್ನು ಬಿಟ್ಟು ಬೇರೆ ರಾಶಿಗೆ ಹೋಗುವ ಗ್ರಹ<br><b>निष्पत्तिः - </b>चर (गतौ) “णिनिः” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अतिक्रम्य चरति |<br><br>

अतिचिर
अतिचिर<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಬಹಳ ಕಾಲ<br><br>

अतिच्छत्र
अतिच्छत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನಲ್ಲಿ ಬೆಳೆಯುವ ಛತ್ರಿಯಂತಿರುವ ಒಂದು ಜಾತಿಯ ಹುಲ್ಲು<br><b>व्युत्पत्तिः - </b>अतिक्रान्तश्छनम् ।<br><br>

अतिच्छत्रा
अतिच्छत्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಸಬ್ಬಸಿಗೆ<br><br>

अतिच्छन्द
अतिच्छन्द<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಛಂದಸ್ಸಿನ ನಿಯಮವನ್ನು ಬಿಟ್ಟು ಬರೆದ ವೃತ್ತ<br><b>व्युत्पत्तिः - </b>अतिक्रान्तं छन्दः ।<br><br>अतिच्छन्द<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿಪ್ರಾಯವನ್ನು ಮೀರಿದವನು<br><br>अतिच्छन्द<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇದವಿಹಿತವಾದ ಕರ್ಮಗಳನ್ನು ಬಿಟ್ಟವನು<br><b>व्युत्पत्तिः - </b>छन्दः अभिप्रायो वेदो वा तं-तदतिक्रान्तः ।<br><br>

अतिजव
अतिजव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ವೇಗ<br><b>व्युत्पत्तिः - </b>अतिशयितो जवः ।<br><br>अतिजव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ವೇಗವಾದ<br><b>व्युत्पत्तिः - </b>अतिशयितो जवो यस्य ।<br><br>

अतिजागर
अतिजागर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಬಕಪಕ್ಷಿ<br><b>व्युत्पत्तिः - </b>अतिशयितो जागरो निद्राभवो यस्य ।<br><br>अतिजागर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿದ್ರೆಯಿಲ್ಲದವನು / ನಿದ್ರೆ ಬಾರದವನು<br><br>

अतितमाम्
अतितमाम्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಬಹಳವಾಗಿ / ಹೆಚ್ಚಾಗಿ<br><b>निष्पत्तिः - </b>अति+तमप् “आमुः” (५-४-११) ।<br><br>

अतितराम्
अतितराम्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಬಹಳವಾಗಿ / ಹೆಚ್ಚಾಗಿ<br><b>निष्पत्तिः - </b>अति+तरप् “आमुः” (५-४-११) ।<br><b>प्रयोगाः - </b>“नृत्तादस्याः स्थितमतितरां कान्तमृज्वायतार्थम्” |<br><b>उल्लेखाः - </b>माल० २-६ ।<br><br>

अतितीक्ष्ण
अतितीक्ष्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಚುರುಕಾದ / ಬಹಳ ಹರಿತವಾದ<br><b>व्युत्पत्तिः - </b>अतिशयेन तीक्ष्णम् ।<br><br>

अतितृष्णा
अतितृष्णा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅತ್ಯಾಶೆ / ಕಾರ್ಪಣ್ಯ / ದುರಾಸೆ<br><br>

अतिथि
अतिथि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>(ಪಥಿಕನಾಗಿ ಮಾರ್ಗಮಧ್ಯದಲ್ಲಿ) ಅನಿರೀಕ್ಷಿತವಾಗಿ ಮನೆಗೆ ಬಂದು ತಂಗಿದವನು<br><b>निष्पत्तिः - </b>अत (सातत्यगमने) “इथिन्” (उ० ४-२)।<br><b>व्युत्पत्तिः - </b>अतति |<br><b>प्रयोगाः - </b>1. “अध्वनीनोऽतिथिर्ज्ञेयः” | 2. “एकरात्रं हि निवसन् ह्यतिथिर्ब्राह्मणः स्मृतः । अनित्यास्य स्थितिर्यस्मात् तस्मादतिथिरुच्यते” || 3. “इमं जीवितसर्वस्वेनाप्यतिधिविशेषं कृतार्थं करिष्यति” |<br><b>उल्लेखाः - </b>1. स्मृतिः । 2. मनु० ३-११२ । 3. शाकु० १ ।<br><br>अतिथि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಶಮಹಾರಾಜನ ಮಗ<br><br>

अतिथिपूजा
अतिथिपूजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಥಿ ಸತ್ಕಾರ / ಅತಿಥಿಗಳನ್ನು ಆದರಿಸುವುದು<br><br>

अतिथिसत्क्रिया
अतिथिसत्क्रिया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>“अतिथिपूजा” ಪದದ ಅರ್ಥ<br><br>

अतिथिसत्कारः
अतिथिसत्कारः<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>“अतिथिपूजा” ಪದದ ಅರ್ಥ<br><br>

अतिदान
अतिदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಿಕವಾಗಿ ಕೊಡುವಿಕೆ / ಎಲ್ಲೆ ಮೀರಿದ ದಾನ<br><b>व्युत्पत्तिः - </b>अतिशयितं दानम् ।<br><br>

अतिदाह
अतिदाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ದೊಡ್ಡ ಉರಿ / ಉಗ್ರವಾದ ಉರಿ<br><b>निष्पत्तिः - </b>दह (भस्मीकरणे) कर० “घञ्” (३-३-१२१) ।<br><b>व्युत्पत्तिः - </b>अतिशयेन दह्यतेऽनेन |<br><br>

अतिदिष्ट
अतिदिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿದೇಶ ಮಾಡಲ್ಪಟ್ಟ / ವರ್ಗಾಯಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अति+दिश (अतिसर्जने) “क्तः” (३-२-१०२) ।<br><b>विस्तारः - </b>[ಒಂದರ ಧರ್ಮವನ್ನು ಮತ್ತೊಂದರಲ್ಲಿ ಹೇಳುವುದು ಅತಿದೇಶ]<br><br>

अतिदेश
अतिदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಗಾಯಿಸುವಿಕೆ / ಒಂದರ ಧರ್ಮವನ್ನು ಮತ್ತೊಂದರಲ್ಲಿ ಹೇಳುವುದು<br><b>निष्पत्तिः - </b>अति+दिश (अतिसर्जने) कर्म० “घञ्” (३-३-१९)।<br><b>व्युत्पत्तिः - </b>अतिदिश्यते |<br><b>प्रयोगाः - </b>“अन्यत्रैव प्रणीतायाः कृत्स्नाया धर्मसंहतेः । अन्यत्र कार्यतः प्राप्तिरतिदेशस्स उच्यते” ।<br><b>विस्तारः - </b>ಮೀಮಾಂಸಕ ಮತರೀತ್ಯಾ: (೧) ಶಾಸ್ತ್ರಾತಿದೇಶ. (೨) ಕಾರ್ಯಾತಿದೇಶ. (೩) ನಿಮಿತ್ತಾತಿದೇಶ. (೪) ವ್ಯಪದೇಶಾತಿದೇಶ ಮತ್ತು (೫) ರೂಪಾದೇಶಗಳೆಂದು ಅತಿದೇಶವು ಐದು ವಿಧ. ವೈಯಾಕರಣ ಮತದಲ್ಲಿ ತಾದಾತ್ಮ್ಯಾತಿ ದೇಶವೂ ಸೇರಿ ಆರು ವಿಧ.<br><br>

अतिदूर
अतिदूर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ದೂರದ<br><br>

अतिदूरतस्
अतिदूरतस्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಬಹಳ ದೂರದಿಂದ<br><br>

अतिधन्वन्
अतिधन्वन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠನಾದ ಯೋಧ<br><b>निष्पत्तिः - </b>“अनङ्ग” (५-४-१३२) ।<br><b>व्युत्पत्तिः - </b>अत्युत्कुष्टं धनुर्यस्य |<br><br>अतिधन्वन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರುಭೂಮಿಯನ್ನು ದಾಟಿದವನು<br><b>व्युत्पत्तिः - </b>अतिक्रान्तः धन्वानम् ।<br><br>

अतिधृति
अतिधृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಧೈರ್ಯ<br><br>अतिधृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಸಂತೋಷ<br><br>अतिधृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತೊಂಭತ್ತನೆಯ ಛಂದಸ್ಸು<br><br>अतिधृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತೊಂಭತ್ತು ಸಂಖ್ಯೆ<br><br>अतिधृति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಧೈರ್ಯವುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>अतिशयिता धृतिर्यस्य ।<br><br>

अतिनिद्रम्
अतिनिद्रम्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ನಿದ್ರೆಗೆ ಯೋಗ್ಯವಲ್ಲದ ಕಾಲ<br><b>निष्पत्तिः - </b>निद्रा सम्प्रति न युज्यते (२-१-६)<br><br>अतिनिद्रम्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿದ್ರೆಯಿಲ್ಲದ / ನಿದ್ರೆಯನ್ನು ಮೀರಿದ<br><b>निष्पत्तिः - </b>–द्र-ದ್ರ<br><b>व्युत्पत्तिः - </b>अतिक्रान्तो निद्राम् ।<br><br>अतिनिद्रम्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ನಿದ್ರೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अतिशयिता निद्रा यस्य ।<br><br>

अतिनिद्रा
अतिनिद्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ನಿದ್ರೆ / ಹೆಚ್ಚು ನಿದ್ರೆ<br><b>व्युत्पत्तिः - </b>अतिशयिता निद्रा ।<br><br>

अतिनिर्हारिन्
अतिनिर्हारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಮನೋಹರವಾದ / ಆಕರ್ಷಕವಾದ / ಮನಸ್ಸನ್ನು ಸೆಳೆಯುವ<br><br>

अतिनु
अतिनु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾವೆಯನ್ನು ಮೀರಿದ / ಹಡಗನ್ನು ದಾಟಿದ (ವಸ್ತು)<br><b>व्युत्पत्तिः - </b>नावमतिक्रान्तम् ।<br><br>

अतिपतन
अतिपतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೀರುವಿಕೆ<br><br>अतिपतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಳೆಯುವಿಕೆ (ಕಾಲ)<br><br>अतिपतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹದ್ದುಮೀರುವಿಕೆ / ಎಲ್ಲೆ ಮೀರುವಿಕೆ<br><br>

अतिपत्ति
अतिपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>(ಕಾಲ) ಮೀರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>कालातिपत्तिः ।<br><br>अतिपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಿಷ್ಪತ್ತಿ / (ಕೆಲಸವು) ನೆರವೇರದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>क्रियातिपत्तिः ।<br><b>विस्तारः - </b>“क्रियाया अनिष्पत्तिः” - सि० कौ० ।<br><br>अतिपत्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇನೆಯನ್ನು ಮೀರಿದ<br><b>व्युत्पत्तिः - </b>पत्ति सेनां (पदार्तिं) अतिक्रान्तः।<br><br>

अतिपथिन्
अतिपथिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಪಥ / ಒಳ್ಳೆಯ ದಾರಿ<br><b>व्युत्पत्तिः - </b>अति पूजितः पन्थाः ।<br><br>

अतिपन्न
अतिपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮಿಸಲ್ಪಟ್ಟ / ಮೀರಲ್ಪಟ್ಟ<br><br>अतिपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಳೆಯಲ್ಪಟ್ಟ<br><br>अतिपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಪ್ಪಲ್ಪಟ್ಟ<br><br>अतिपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಲ್ಲಂಘಿಸಲ್ಪಟ್ಟ / ದಾಟಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अति+पद (गतौ) “क्तः” (३-२-१०२) ।<br><br>

अतिपरिचय
अतिपरिचय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಪರಿಚಯ / ಹೆಚ್ಚು ಸಲಿಗೆ<br><b>व्युत्पत्तिः - </b>अतिशयितः परिचयः ।<br><b>प्रयोगाः - </b>“अतिपरिचयादवज्ञा सन्ततगमनादनादरो भवति” ।<br><br>

अतिपर
अतिपर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲಿಷ್ಠನಾದ ಶತ್ರು<br><b>व्युत्पत्तिः - </b>अतिशयितः परः ।<br><br>अतिपर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶತ್ರುವನ್ನು ಜಯಿಸಿದ<br><b>व्युत्पत्तिः - </b>परमतिक्रान्तः ।<br><br>

अतिपरोक्ष
अतिपरोक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯಕ್ಷ<br><b>व्युत्पत्तिः - </b>अतिक्रान्तं परोक्षम् ।<br><br>अतिपरोक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ದೂರದ / ದೃಷ್ಟಿಗೆ ಗೋಚರವಾಗದ<br><b>व्युत्पत्तिः - </b>अत्यन्तं परोक्षम् ।<br><br>

अतिपात
अतिपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮ / ಮೀರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>अतिक्रम्य पातः ।<br><b>प्रयोगाः - </b>“अहो कालातिपातः” |<br><b>उल्लेखाः - </b>मालती० २ ।<br><br>अतिपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಪ್ಪುವಿಕೆ / ಕಳೆಯುವಿಕೆ<br><b>प्रयोगाः - </b>“न चेदन्यकार्यातिपातः तत्प्रविश्य प्रतिगृह्यतामातिथेयः सत्काअः” |<br><b>उल्लेखाः - </b>शाकु० १ ।<br><br>अतिपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಗುಹೋಗು / ಸಂಭವ / ಘಟನೆ<br><br>अतिपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿರೋಧ / ಪ್ರತಿಭಟನೆ<br><br>अतिपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಮಮೀರುವಿಕೆ<br><br>

अतिपातक
अतिपातक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾಪಾಪ / ಮಾತೃಗಮನಾದಿಗಳಿಂದುಂಟಾಗುವ ಮಹಾಪಾತಕ<br><br>

अतिपातित
अतिपातित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಳೆಯಲ್ಪಟ್ಟ / ಅತಿಕ್ರಮಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>“अतिपातितकालसाधना स्वशरीरेन्द्रियवर्गतापनी” |<br><b>उल्लेखाः - </b>किरा० २-४२ ।<br><br>

अतिपातिन्
अतिपातिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೀರತಕ್ಕ / ಅತಿಕ್ರಮಿಸುವ<br><b>निष्पत्तिः - </b>पत्लृ (गतौ) “णिनिः” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अतिक्रम्य पतति |<br><b>प्रयोगाः - </b>“ततार विद्याः पवनातिपतिभिर्दिशो हरिद्भिर्हरितामिवेश्वरः” |<br><b>उल्लेखाः - </b>रघु० ३-३० ।<br><br>

अतिप्रगे
अतिप्रगे<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಬಹಳ ಮುಂಜಾನೆ / ಬೆಳಿಗ್ಗೆ ಬಹಳ ಮುಂಚಿತವಾಗಿ<br><b>विस्तारः - </b>“प्रगे प्रातः प्रभाते” - अम० ।<br><br>

अतिप्रबन्ध
अतिप्रबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾತತ್ಯ / ಎಡಬಿಡದೆ ಮುಂದುವರಿಯುವಿಕೆ<br><b>प्रयोगाः - </b>“अतिप्रबन्धप्रहितास्त्रवुष्टिभिः” |<br><b>उल्लेखाः - </b>रघु० ३-५८ ।<br><br>

अतिप्रमाण
अतिप्रमाण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೊಡ್ಡ ಅಳತೆ / ದೊಡ್ಡ ಆಕಾರ<br><br>अतिप्रमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಳತೆಯನ್ನು ಮೀರಿದ / ದೊಡ್ಡ ಆಕಾರವುಳ್ಳ<br><b>प्रयोगाः - </b>“अतिप्रमाणा बलिनः दीर्घजिह्वानखास्तथा” |<br><b>उल्लेखाः - </b>रामा० ।<br><br>

अतिप्रवृद्ध
अतिप्रवृद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ದೊಡ್ಡದಾಗಿ ಬೆಳೆದಿರುವ<br><b>व्युत्पत्तिः - </b>अत्यन्तं प्रवृद्धः ।<br><br>

अतिप्रश्न
अतिप्रश्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹದ್ದುಮೀರಿದ ಪ್ರಶ್ನೆ / ಅನುಚಿತವಾದ ಪ್ರಶ್ನೆ<br><b>व्युत्पत्तिः - </b>अतिक्रम्य मर्यादां प्रश्नः ।<br><br>

अतिप्रसक्त
अतिप्रसक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಪ್ರೀತಿಸಲ್ಪಟ್ಟ<br><br>अतिप्रसक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಷಯಕ್ಕೆ ಸಂಬಂಧಪಡದ<br><br>

अतिप्रसक्ति
अतिप्रसक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಲ್ಲೆ ಮೀರಿದ ಅಕ್ಕರೆ / ಅತಿಶಯವಾದ ಪ್ರೇಮ (ಅನುರಾಗ)<br><br>अतिप्रसक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಯಕ್ಕೆ ಸಂಬಂಧಪಡದಿರುವಿಕೆ<br><br>अतिप्रसक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಮಾತು / ಅಧಿಕೋಕ್ತಿ<br><br>

अतिप्रसङ्ग
अतिप्रसङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>“अतिप्रसक्ति” ಪದದ ಅರ್ಥ<br><br>अतिप्रसङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ವಿಸ್ತಾರ<br><b>प्रयोगाः - </b>“अलमतिप्रसङ्गेन” |<br><b>उल्लेखाः - </b>मुद्रा० १ ।<br><br>अतिप्रसङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಸಂಬಂಧ<br><b>प्रयोगाः - </b>“अतिप्रसङ्गाद्विहितागसो मुहुः” |<br><b>उल्लेखाः - </b>किरा० ८-३३ ।<br><br>

अतिप्रौढ
अतिप्रौढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಬೆಳೆದಿರುವ<br><br>

अतिप्रौढा
अतिप्रौढा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹಕಾಲವನ್ನು ಹೊಂದಿದ ಕನ್ಯೆ/ ಹತ್ತು ವರ್ಷ ವಯಸ್ಸು ಮೀರಿದ ಕನ್ಯೆ<br><b>विस्तारः - </b>[ಹೆಂಗಸರಿಗೆ 10 ವರ್ಷ ವಯಸ್ಸಾದರೆ ಅತಿ ಪ್ರೌಢೆಯೆನಿಸುವರು.]<br><br>

अतिबल
अतिबल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಶಕ್ತಿ / ಉನ್ನತ ಪರಾಕ್ರಮ<br><br>अतिबल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೈನ್ಯ<br><br>अतिबल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಪರಾಕ್ರಮವುಳ್ಳ / ಅಧಿಕಶಕ್ತಿಯುಳ್ಳ<br><b>प्रयोगाः - </b>“जयत्यतिबलो रामो लक्ष्मणश्च महाबलः” |<br><b>उल्लेखाः - </b>रामा० ।<br><br>

अतिबला
अतिबला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶ್ವಾಮಿತ್ರಮಹರ್ಷಿಯು ಶ್ರೀರಾಮನಿಗೆ ಉಪದೇಶಿಸಿದ ವಿದ್ಯೆ<br><b>प्रयोगाः - </b>1. “बलेन तपसां लब्धे बलेत्यतिबलेति च” | 2. “क्षुत्पिपासे न ते राम भविष्येते नरोत्तम । बलामतिबलां चैव पठतः पथि राघव” |<br><b>उल्लेखाः - </b>1. चं० रा० १-७० । 2. रामा० ।<br><b>विस्तारः - </b>ಈ ವಿದ್ಯೆಯನ್ನು ಉಪದೇಶಿಸಿ, ಇದರ ಪಠನದಿಂದ ದಾರಿಯಲ್ಲಿ ಹಸಿವೂ ಬಾಯಾರಿಕೆಯೂ ಆಗುವುದಿಲ್ಲವೆಂದು ಹೇಳಿದರು.<br><br>

अतिब्रह्मचर्य
अतिब्रह्मचर्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಚರ್ಯವನ್ನು ಮೀರಿದವನು / ಶಾಸ್ತ್ರವಿರುದ್ಧವಾಗಿ ಹೆಂಗಸಿನೊಡನೆ ಸಂಬಂಧ ಬೆಳೆಸಿದವನು<br><b>व्युत्पत्तिः - </b>अतिक्रान्तो ब्रह्मचर्यम् ।<br><br>

अतिभार
अतिभार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಭಾರ (ಹೊರೆ)<br><b>व्युत्पत्तिः - </b>अतिशयितो भारः ।<br><b>प्रयोगाः - </b>“कोऽतिभारः समर्थानाम” |<br><b>उल्लेखाः - </b>पञ्चत० १-२२ ।<br><br>अतिभार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಶಯ / ಆಧಿಕ್ಯ<br><b>प्रयोगाः - </b>“प्रातः प्राप्तुं रथो मे पुनरिति मनसि न्यस्तचिन्तातिभारः” |<br><b>उल्लेखाः - </b>रत्ना० ३-५ ।<br><br>अतिभार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇಗ<br><br>

अतिभारग
अतिभारग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಸರಗತ್ತೆ / ಒಂದು ಮಿಶ್ರಜಾತಿಯ ಪ್ರಾಣಿ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) “डः” (वा० ३-२-४८) ।<br><b>व्युत्पत्तिः - </b>अतिभारेण गच्छति |<br><br>

अतिभी
अतिभी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿದ್ಯುತ್ತು / ಮಿಂಚು<br><b>निष्पत्तिः - </b>ञि भी (भये) “क्विप्” (३-२-६१) ।<br><b>व्युत्पत्तिः - </b>अतिबिभेत्यस्याः |<br><br>अतिभी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಭಯ<br><br>

अतिभूमि
अतिभूमि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಶಯ / ಆಧಿಕ್ಯ<br><b>प्रयोगाः - </b>“अद्य सविशेषदर्शनेनातिभूमिं खलु गमिष्यति तस्या अभिनिवेशः” |<br><b>उल्लेखाः - </b>मालती० २ ।<br><br>अतिभूमि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲೆಯನ್ನು ಮೀರಿದ<br><br>अतिभूमि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೂಮಿಯನ್ನು ದಾಟಿದ<br><br>अतिभूमि<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಎಲ್ಲೆ ಮೀರಿ<br><br>

अतिमङ्गल्य
अतिमङ्गल्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಲ್ವಮರ<br><br>अतिमङ्गल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಮಂಗಳವನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>अतिमङ्गले साधु “यत्” (४-४-९८) ।<br><br>

अतिमर्त्य
अतिमर्त्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನುಷ್ಯನನ್ನು ಮೀರಿದ<br><b>प्रयोगाः - </b>“अतिमर्त्यबला विराटशत्यद्रुपदाद्यः” |<br><b>उल्लेखाः - </b>याद० १५-५- ।<br><br>

अतिमर्याद
अतिमर्याद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹದ್ದುಮೀರಿದವನು / ಎಲ್ಲೆದಾಟಿದವನು<br><b>व्युत्पत्तिः - </b>अतिक्रान्तो मर्यादाम् ।<br><br>अतिमर्याद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಶಯವಾದ / ಹೆಚ್ಚಾದ<br><br>अतिमर्याद<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಎಲ್ಲೆ ಮೀರಿ<br><br>

अतिमात्र
अतिमात्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಶಯ / ಆಧಿಕ್ಯ<br><b>व्युत्पत्तिः - </b>मात्रामतिक्रान्तम् ।<br><br>अतिमात्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಶಯವಾದ / ಹೆಚ್ಚಾದ / ಅಧಿಕವಾದ<br><br>अतिमात्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಮಾಣವನ್ನು ಮೀರಿದ / ಅಳತೆ ಮೀರಿದ<br><b>प्रयोगाः - </b>“मुनिव्रतैस्तामतिमात्रकर्शिताम्” |<br><b>उल्लेखाः - </b>कुमा० ५-४८ ।<br><br>अतिमात्र<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಅಳತೆಮೀರಿ / ಹೆಚ್ಚಾಗಿ / ಅಧಿಕವಾಗಿ<br><br>

अतिमान
अतिमान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಅಭಿಮಾನ / ಅಹಂಕಾರ<br><b>व्युत्पत्तिः - </b>अत्यन्तो मानः अभिमानः ।<br><br>अतिमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಮಾಣವನ್ನು ಮೀರಿದ / ಬಹಳ ದೊಡ್ಡದಾದ<br><b>व्युत्पत्तिः - </b>मानं प्रमाणमतिक्रान्तः ।<br><br>

अतिमानुष
अतिमानुष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನುಷ್ಯನನ್ನು ಮೀರಿದ / ಮನುಷ್ಯನ ಶಕ್ತಿಯನ್ನು ಮೀರಿದ<br><b>व्युत्पत्तिः - </b>मानुषमतिक्रान्तः ।<br><br>अतिमानुष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನುಷ್ಯನ ಕಾರ್ಯವನ್ನು ಮೀರಿದ<br><br>अतिमानुष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನುಷ್ಯನ ಆಕಾರವನ್ನು ಮೀರಿದ<br><br>

अतिमारुत
अतिमारुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಂಟರಗಾಳಿ / ಬಿರುಗಾಳಿ<br><br>

अतिमित्र
अतिमित्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೊಡ್ಡ ಸ್ನೇಹಿತ<br><b>व्युत्पत्तिः - </b>अत्यन्तं मित्रम् ।<br><br>अतिमित्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಮೈತ್ರತಾರೆ / ಜನ್ಮತಾರೆ (ಜನ್ಮನಕ್ಷತ್ರ)ಯಿಂದ ಒಂಭತ್ತನೆಯ, ಹದಿನೆಂಟನೆಯ ಮತ್ತು ಇಪ್ಪತ್ತೇಳನೆಯ ನಕ್ಷತ್ರ<br><br>

अतिमुक्त
अतिमुक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಧವೀಲತೆ / ಕಾಡು ಇರುವಂತಿಗೆ<br><b>व्युत्पत्तिः - </b>अतिक्रान्तो मुक्ताम् ।<br><br>अतिमुक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಲಿಗೆಮರ<br><br>अतिमुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಕ್ತಿ ಹೊಂದಿದ / ಮೋಕ್ಷ ಪಡೆದ<br><b>व्युत्पत्तिः - </b>अतिशयेन मुक्तः ।<br><br>

अतिमुक्तक
अतिमुक्तक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾಳೆಗಿಡ<br><br>अतिमुक्तक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೂಬರೆಮರ / ಜಗಳದಮರ<br><br>अतिमुक्तक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೋಕ್ಷಹೊಂದಿದ<br><br>

अतिमुक्ति
अतिमुक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಧವಿಮೋಚನೆ / ಸಂಸಾರದಿಂದ ಬಿಡುಗಡೆ<br><br>

अतिमृत्यु
अतिमृत्यु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಕ್ತಿ / ಮೋಕ್ಷ<br><br>अतिमृत्यु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೃತ್ಯುವನ್ನು ಮೀರಿದ<br><br>

अतिमोदा
अतिमोदा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಜ್ಜಾಜಿ ಗಿಡ<br><b>व्युत्पत्तिः - </b>अतिशयितो मोदो गन्धो यस्याः।<br><br>अतिमोदा<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ವಾಸನೆಯುಳ್ಳ<br><br>

अतिरंहस्
अतिरंहस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳವೇಗ<br><br>अतिरंहस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ವೇಗವುಳ್ಳ<br><b>प्रयोगाः - </b>“एष राजेव दुष्यन्तः सारङ्गेणातिरंहसा” |<br><b>उल्लेखाः - </b>शाकु० १-५ ।<br><br>

अतिरक्त
अतिरक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಕೆಂಪುಬಣ್ಣ<br><br>अतिरक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕೆಂಪುಬಣ್ಣವುಳ್ಳ<br><br>अतिरक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಅನುರಾಗವುಳ್ಳ<br><b>प्रयोगाः - </b>“अतिरक्तभावमुपगम्य” |<br><b>उल्लेखाः - </b>माघ० १५-९ ।<br><br>

अतिरथ
अतिरथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ರತಿಮ ವೀರ / ರಣಧೀರ / ರಥಕ್ಕಿಂತಲೂ ಹೆಚ್ಚು ಪರಾಕ್ರಮವುಳ್ಳ ಯೋಧ<br><b>प्रयोगाः - </b>“अमितान् योधयेद्यस्तु सम्प्रोक्तोऽतिरथस्तु सः” ।<br><br>

अतिरभस
अतिरभस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ವೇಗ / ಮಿತಿಮೀರಿದ ವೇಗ<br><br>

अतिरसा
अतिरसा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣರಾಶ್ಮೆ<br><br>अतिरसा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಗ್ಗುರಟಿಕೆ ಮರ<br><br>

अतिराग
अतिराग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಪ್ರೀತಿ / ಉತ್ಸಾಹ<br><b>प्रयोगाः - </b>“प्रभुर्वुभूषुर्भुवनत्रयस्य गः शिरोऽतिरागाद्दशमं चिकर्तिषुः”|<br><b>उल्लेखाः - </b>माघ० १-४९ ।<br><br>

अतिराज
अतिराज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಾಜನನ್ನು ಮೀರಿರುವ<br><b>निष्पत्तिः - </b>“टच्” (५-४-९१) ।<br><b>व्युत्पत्तिः - </b>अतिक्रान्तो राजानम् |<br><br>

अतिराजन्
अतिराजन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠನಾದ ದೊರೆ / ಉತ್ತಮನಾದ ರಾಜ<br><b>निष्पत्तिः - </b>“न पूजनात्” (५-४-६९) “टच्” न भवति ।<br><b>व्युत्पत्तिः - </b>अतिशयितो राजा ।<br><br>

अतिरात्र
अतिरात्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ರಾತ್ರಿಯಲ್ಲಿ ನಡೆಸಬಹುದಾದ ಯಾಗ<br><br>

अतिरिक्त
अतिरिक्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಶಯ / ಆಧಿಕ್ಯ<br><b>निष्पत्तिः - </b>अति+रिचिर् (विरेचने) भावे “क्तः” (३-३-११४) ।<br><br>अतिरिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ<br><br>अतिरिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕ / ಹೆಚ್ಚಾದ<br><br>अतिरिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೀರಿದ / ಮಿಗಿಲಾದ<br><b>निष्पत्तिः - </b>अति+रिचिर् (विरेचने) “क्तः (३-२-१-२) ।<br><b>व्युत्पत्तिः - </b>अतिरिच्यते स्म ।<br><b>प्रयोगाः - </b>“सर्वाटिरिक्तसाएण सर्वतेजोऽभिभाविना” |<br><b>उल्लेखाः - </b>रघु० १-१४ ।<br><br>अतिरिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಿನ್ನವಾದ / ಬೇರೆಯಾದ<br><b>प्रयोगाः - </b>“न वृक्षव्यतिरिक्तसाधनः” |<br><b>उल्लेखाः - </b>कुमा० ५-२२ ।<br><br>अतिरिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶೂನ್ಯವಾದ<br><br>

अतिरुच्
अतिरुच्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಾನುಪ್ರದೇಶ / ಮಂಡಿ<br><br>अतिरुच्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಂದರಿಯಾದ ಹೆಂಗಸು<br><br>अतिरुच्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಕಾಂತಿಯುಳ್ಳ<br><br>अतिरुच्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಕಾಂತಿಯುಳ್ಳ<br><br>

अतिरूप
अतिरूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ<br><b>व्युत्पत्तिः - </b>अतिक्रान्तो रूपम् ।<br><br>अतिरूप<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಂದರವಾದ ರೂಪ<br><b>व्युत्पत्तिः - </b>अतिशयितं रूपम् ।<br><br>अतिरूप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೂಪವಿಲ್ಲದ (ವಾಯು)<br><b>व्युत्पत्तिः - </b>रूपमतिक्रान्तः ।<br><br>

अतिरेक
अतिरेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಶಯ / ಆಧಿಕ್ಯ<br><b>प्रयोगाः - </b>“तेजोभिः कनकनिकाषराजिगौरैरायामः क्रियत इव स्म सातिरेकः” |<br><b>उल्लेखाः - </b>किरा० ७-६ ।<br><br>अतिरेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೇದ / ವ್ಯತ್ಯಾಸ<br><br>अतिरेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಧಾನ್ಯ<br><b>निष्पत्तिः - </b>अति+रिचिर् (विरेचने) “घञ्” (३-३-१८)।<br><br>

अतिरोधान
अतिरोधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶ / ಮರೆಯಾಗದಿರುವಿಕೆ<br><br>

अतिरोमश
अतिरोमश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಮೇಕೆ<br><b>विस्तारः - </b>“इडिक्कस्तु बालवाह्यो वनच्छागोऽतिरोमशः” - हारा० ।<br><br>

अतिरोहित
अतिरोहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರೆಯಾಗದ / ಪ್ರಕಾಶವಾದ / ಸ್ಫುಟವಾದ<br><b>व्युत्पत्तिः - </b>न तिरोहितः ।<br><br>अतिरोहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕೆಂಪಾದ<br><b>व्युत्पत्तिः - </b>अत्यन्तं रोहितः ।<br><br>

अतिलङ्घन
अतिलङ्घन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಉಪವಾಸ<br><br>अतिलङ्घन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೀರುವಿಕೆ / ಉಲ್ಲಂಘನೆ / ಅಪರಾಧ / ಅತಿಕ್ರಮ<br><b>प्रयोगाः - </b>“अतिलङ्घनमभ्युपैतु को वा गुणकर्मश्रुतशालिनाममीषाम्”|<br><b>उल्लेखाः - </b>याद० १५-५० ।<br><br>

अतिलङ्घित
अतिलङ्घित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೀರಲ್ಪಟ್ಟ / ಅತಿಕ್ರಮಿಸಲ್ಪಟ್ಟ<br><br>

अतिलङ्घिन्
अतिलङ्घिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮಿಸುವ / ಮೀರುವ / ತಪ್ಪುಮಾಡುವ<br><b>प्रयोगाः - </b>“नर्तकीरभिनयातिलङ्घिनीः” |<br><b>उल्लेखाः - </b>रघु० १९-१४ ।<br><br>

अतिलङ्घिनी
अतिलङ्घिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮಿಸುವ / ಮೀರುವ / ತಪ್ಪುಮಾಡುವ<br><b>निष्पत्तिः - </b>स्त्रियाम् “डीप्” ।<br><br>

अतिवक्तृ
अतिवक्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾತಾಳಿ / ಮಾತುಗಾರ / ಹೆಚ್ಚು ಮಾತಾಡುವವನು<br><b>निष्पत्तिः - </b>अति+वच (परिभाषणे) “तृन्” (३-२-१३५) ।<br><b>व्युत्पत्तिः - </b>अतिवक्ति |<br><br>अतिवक्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾತಾಡಲು ಅರಿತವನು / ಭಾಷಣದಲ್ಲಿ ಸಮರ್ಥನು<br><br>

अतिवक्र
अतिवक्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>(ಸೂರ್ಯನು ಸಪ್ತಮ ಮತ್ತು ಅಷ್ಟಮ ಸ್ಥಾನಗಳಲ್ಲಿರುವಾಗ) ಋಜುಗತಿಯನ್ನು ಬಿಟ್ಟು ವಕ್ರಗತಿಯನ್ನು ಹೊಂದಿದ ಅಂಗಾರಕ ಮೊದಲಾದ ಐದು ಗ್ರಹಗಳು<br><br>अतिवक्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ವಕ್ರವಾದ / ಬಹಳ ಡೊಂಕಾಗಿರುವ<br><br>

अतिवयस्
अतिवयस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುದಿಯಾದ / ಬಹಳ ವಯಸ್ಸಾದ<br><b>व्युत्पत्तिः - </b>अतिक्रान्तो वयः ।<br><br>

अतिवर्णाश्रमिन्
अतिवर्णाश्रमिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣಾದಿ ವರ್ಣವನ್ನೂ ಬ್ರಹ್ಮಚರ್ಯಾದ್ಯಾಶ್ರಮವನ್ನೂ ಬಿಟ್ಟಿರುವವನು<br><br>

अतिवर्तन
अतिवर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಯಮಮೀರಿ ನಡೆಯುವಿಕೆ / ಹದ್ದುಮೀರುವಿಕೆ<br><br>अतिवर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ಷಮೆಗೆ ಯೋಗ್ಯವಾದ ಅಪರಾಧ<br><b>निष्पत्तिः - </b>वृतु (वर्तने) “ल्युः” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अतिक्रम्य दण्डं वर्तते |<br><b>प्रयोगाः - </b>“यानस्य चैव यातुश्च यानस्वामिन एव च । दशातिवर्तनान्याहुः शेषे दण्डो विधीयते” ॥ “छिन्ननस्य भग्नयुगे तिर्यक् प्रतिमुखागते । अक्षभङ्गे च यानस्य चक्रभङ्गे तथैवच् अ ॥ छेदने चैव यन्त्राणां योक्त्ररश्म्योस्तथैव च । आक्रोशे चाप्यपैहीति न दण्डं मनुरब्रवीत्” ||<br><b>उल्लेखाः - </b>मनु० ८-२९०-९२ ।<br><b>विस्तारः - </b>ಎಂದು ಮನುಸ್ಮೃತಿಯಲ್ಲಿ ಕ್ಷಮ್ಯವಾದ ಅಪರಾಧಗಳು ಹತ್ತು ಹೇಳಲ್ಪಟ್ಟಿವೆ.<br><br>अतिवर्तन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೀವನೋಪಾಯವನ್ನು ಕಳೆದುಕೊಂಡವನು<br><b>व्युत्पत्तिः - </b>वर्तनमतिक्रान्तः ।<br><br>

अतिवर्तिन्
अतिवर्तिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೀರಿರುವ<br><br>अतिवर्तिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದೆಸಾಗಿದ<br><b>निष्पत्तिः - </b>वृतु (वर्तने) “णिनिः” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अतीत्य वर्तते |<br><b>प्रयोगाः - </b>“स्थितमुन्नते तुहिनशैलशिरसि भुवनातिवर्तिना” |<br><b>उल्लेखाः - </b>किरा० १२-२१ ।<br><br>

अतिवाद
अतिवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತ್ಯುಕ್ತಿ / ಹೆಚ್ಚುಮಾತು<br><br>अतिवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ರಿಯವಾದ ಮಾತು / ನಿಂದೆ / ಬೈಗಳು<br><br>अतिवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಠಿನವಾದ ಮಾತು<br><b>निष्पत्तिः - </b>अति+वद (व्यक्तायां वाचि) “घञ्” (३-३-१८) ।<br><br>

अतिवादिन्
अतिवादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲೆಮೀರಿ ಮಾತಾಡುವವನು / ಹೆಚ್ಚು ಮಾತಾಡುವವನು<br><br>अतिवादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನ ಮತವನ್ನು ಸ್ಥಿರಪಡಿಸುವವನು<br><b>निष्पत्तिः - </b>वद (व्यक्तायां वाचि) “णिनिः” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>सर्वानतिक्रम्य वदति |<br><br>

अतिवाह
अतिवाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಕ್ಷ್ಮಶರೀರದಲ್ಲಿರುವ ಜೀವನು ಬೇರೆ ಶರೀರವನ್ನು ಸೇರುವುದು<br><b>व्युत्पत्तिः - </b>अतीत्य देहमन्यदेहे वाहः ।<br><br>अतिवाह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಹಿಸುವ / ಎತ್ತಿಕೊಳ್ಳುವ<br><br>

अतिवाहक
अतिवाहक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಕ್ಷ್ಮಶರೀರದಿಂದ ಜೀವನನ್ನು ಬೇರೆ ಶರೀರಕ್ಕೆ ಕರೆದೊಯ್ಯುವ ದೇವತೆ<br><b>निष्पत्तिः - </b>अति+वह (प्रापणे) “ण्वुल्” (३-१-१३३) ।<br><b>व्युत्पत्तिः - </b>अतिवाहयति |<br><br>

अतिवाहन
अतिवाहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಯ್ಯುವಿಕೆ<br><br>अतिवाहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಳುಹಿಸಿಕೊಡುವಿಕೆ<br><br>अतिवाहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಳೆಯುವಿಕೆ<br><br>

अतिवाहिक
अतिवाहिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಕ್ಷ್ಮಶರೀರ<br><b>निष्पत्तिः - </b>“ठन्” (५-२-११५) ।<br><b>व्युत्पत्तिः - </b>अतिवाहोऽस्यास्ति |<br><br>अतिवाहिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಯ್ಯಲು ಸಮರ್ಥ / ವಹಿಸಲು ಶಕ್ತ / ಒಪ್ಪಿಸಿಕೊಡಲು ಶಕ್ತ<br><br>

अतिवाहित
अतिवाहित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಕ್ಷ್ಮಶರೀರ<br><br>अतिवाहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಳುಹಿಸಲ್ಪಟ್ಟ / ವಹಿಸಿಕೊಡಲ್ಪಟ್ಟ / ಒಯ್ಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अति+वह (प्रापणे)+णिच् “क्तः” (३-२-१०२) ।<br><br>

अतिविकट
अतिविकट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಭಯಂಕರವಾದ<br><br>

अतिविषा
अतिविषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಬಜೆ<br><b>व्युत्पत्तिः - </b>विषमतिक्रान्ता |<br><br>

अतिवृत्त
अतिवृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೀರಿದ / ಮಿಗಿಲಾದ<br><b>प्रयोगाः - </b>“अत्रान्तरे किमपि वाग्विभवातिवृत्तमाचार्यकं विजयि मान्मथमाविरसीत्” |<br><b>उल्लेखाः - </b>मालती० १-२९ ।<br><br>अतिवृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಳೆದುಹೋದ<br><b>निष्पत्तिः - </b>अति+वृतु (वर्तने) “क्तः” (३-४-७२) |<br><b>व्युत्पत्तिः - </b>अतिक्रम्य वर्तते |<br><br>

अतिवृत्ति
अतिवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ವೃತ್ತತೆ / ಮೀರಿ ನಡೆಯುವಿಕೆ / ದುಷ್ಟತನ<br><b>निष्पत्तिः - </b>अति+वृतु(वर्तने) “क्तिन्” (३-३-९४) ।<br><b>प्रयोगाः - </b>“अतिवृत्तिमवेक्ष्य तस्य घोराम्” |<br><b>उल्लेखाः - </b>याद० १५-७५ ।<br><br>

अतिवृद्ध
अतिवृद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಮುದಿಯಾದ<br><br>अतिवृद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ವೃದ್ಧಿಹೊಂದಿದ<br><b>व्युत्पत्तिः - </b>अत्यन्तं वृद्धः ।<br><br>

अतिवृष्टि
अतिवृष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಮಳೆ / ಮಿತಿಮೀರಿದ ಮಳೆ / ಆರು ವಿಧ ಈತಿಬಾಧೆಗಳಲ್ಲೊಂದು<br><b>विस्तारः - </b>ಆರು ವಿಧ ಈತಿಬಾಧೆಗಳು: “अतिवृष्टिरनावृष्टिर्मूषकाः शलभाः खगाः । अत्यासन्नाश्च राजानः षडेता ईतयः स्मृताः” ।<br><br>

अतिवेध
अतिवेध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಏಕಾದಶಿ ತಿಥಿಗೆ ದಶಮೀ ತಿಥಿಯ ಸಂಬಂಧ<br><b>विस्तारः - </b>[ಈ ವೇಧೆಯು ಅರುಣೋದಯದಲ್ಲಿದ್ದರೆ ಒಂದೂವರೆ ಘಳಿಗೆಯೂ ಸೂರ್ಯೋದಯವಾದ ನಂತರವಾದರೆ ಎರಡು ಘಳಿಗೆಯೂ ಇರುವುದು.]<br><br>

अतिवेल
अतिवेल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾದ / ಎಲ್ಲೆ ಮೀರಿದ<br><br>अतिवेल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಡವನ್ನು ದಾಟಿದ<br><b>व्युत्पत्तिः - </b>अतिक्रान्तो वेलाम् ।<br><br>

अतिव्यथन
अतिव्यथन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ತೊಂದರೆಪಡಿಸುವಿಕೆ<br><br>

अतिव्यथा
अतिव्यथा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ತೊಂದರೆ<br><br>

अतिव्यय
अतिव्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಖರ್ಚು / ಮಿತಿ ಮೀರಿದ ವೆಚ್ಚ<br><b>व्युत्पत्तिः - </b>अतिशयितो व्ययः ।<br><b>प्रयोगाः - </b>“अतिव्ययात् स्वल्पकालत्क्लिश्येदर्थपरिक्षयात्” ।<br><br>

अतिव्याप्ति
अतिव्याप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾಗಿ ಹರಡುವಿಕೆ<br><br>अतिव्याप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತರ್ಕಶಾಸ್ತ್ರದಲ್ಲಿ ಲಕ್ಷಣದ ಒಂದು ದೋಷ<br><b>विस्तारः - </b>ಲಕ್ಷಣವು ತಾನಿರಬೇಕಾದ ಲಕ್ಷ್ಯವನ್ನು ಬಿಟ್ಟು ಬೇರೆ ಕಡೆ ಸಂಬಂಧಿಸುವುದು, ಲಕ್ಷಣವು ತನಗೆ ಸಂಬಂಧಿಸದ ಕಡೆಯೂ ಇರುವುದು. शृङ्गी गौः ಎಂಬ ಗೋವಿನ ಲಕ್ಷಣಕ್ಕೆ ಮಹಿಷದಲ್ಲಿಯೂ ಶೃಂಗಿತ್ವವಿರುವುದರಿಂದ ಅತಿವ್ಯಾಪ್ತಿ.<br><br>

अतिशक्वरी
अतिशक्वरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಶಕ್ವರೀ ಛಂದಸ್ಸು / ವೃತ್ತರತ್ನಾಕರದಲ್ಲಿ ಹದಿನೈದನೆಯ ಛಂದಸ್ಸು / ಹದಿನೈದು ಅಕ್ಷರಗಳ ಪಾದವುಳ್ಳ ಛಂದಸ್ಸು<br><br>

अतिशक्तिता
अतिशक्तिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಾಕ್ರಮ<br><br>

अतिशय
अतिशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಧಿಕ್ಯ / ಹೆಚ್ಚಿಗೆ<br><b>निष्पत्तिः - </b>अति+शीङ् (स्वप्ने) “अच्” (३-३-५६) ।<br><b>व्युत्पत्तिः - </b>अतिशेते |<br><br>अतिशय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕ / ಹೆಚ್ಚಾದ<br><b>प्रयोगाः - </b>“अतिशयपरिणाहवान् वितेने” |<br><b>उल्लेखाः - </b>माघ० ७-५ ।<br><br>अतिशय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ<br><b>निष्पत्तिः - </b>“अच्” (५-२-१२७) ।<br><b>व्युत्पत्तिः - </b>अतिशयोऽस्त्यस्य |<br><br>

अतिशयन
अतिशयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೀರುವಿಕೆ<br><br>अतिशयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚುವಿಕೆ<br><b>निष्पत्तिः - </b>अति+शीङ् (स्वप्ने) “ल्युट्” (३-३-११५) ।<br><br>

अतिशयान
अतिशयान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೀರುವ<br><br>अतिशयान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾಗುವ<br><b>निष्पत्तिः - </b>अति+शीङ् (स्वप्ने) “शानच्” (३-२-१२४) ।<br><br>

अतिशयित
अतिशयित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕವಾದ<br><br>अतिशयित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೀರಿದ<br><b>निष्पत्तिः - </b>अति+शीङ् (स्वप्ने) “क्तः” (३-२-१०२) ।<br><b>प्रयोगाः - </b>“अतिशयितवनान्तरद्युतीनाम्” |<br><b>उल्लेखाः - </b>किरा० १०-८ ।<br><br>

अतिशयिन्
अतिशयिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ<br><br>अतिशयिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕವಾದ<br><b>निष्पत्तिः - </b>अतिशय “इनिः” (५-२-११५) ।<br><b>व्युत्पत्तिः - </b>अतिशयोऽस्यास्ति |<br><b>प्रयोगाः - </b>“श्रियमतिशयिनीं समेत्य जग्मुः" |<br><b>उल्लेखाः - </b>किरा० १०-२५ ।<br><br>

अतिशायिनी
अतिशायिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अतिशयिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><br>

अतिशयोक्ति
अतिशयोक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥಾಲಂಕಾರದ ಒಂದು ಭೇದ<br><b>व्युत्पत्तिः - </b>अतिशयेन उक्तिर्यत्र ।<br><br>अतिशयोक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಿಕವಾದ ಮಾತು<br><b>व्युत्पत्तिः - </b>अतिशया उक्तिः ।<br><br>

अतिशस्त
अतिशस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಶ್ರೇಷ್ಠವಾದ<br><br>

अतिशायन
अतिशायन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಧಿಕ್ಯ / ಹೆಚ್ಚಿಗೆ<br><br>अतिशायन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠತೆ / ಮೇಲ್ಮೆ<br><br>

अतिशायिन्
अतिशायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೀರುವ<br><br>अतिशायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಿತಿಮೀರಿದ / ಹೆಚ್ಚಾದ<br><br>

अतिशोभन
अतिशोभन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ<br><br>अतिशोभन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕಾಂತಿಯಿಂದ ಕೂಡಿದ<br><br>

अतिश्व
अतिश्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಕ್ತಿಯಲ್ಲಿ ನಾಯಿಯನ್ನು ಮೀರಿದವನು<br><b>व्युत्पत्तिः - </b>अतिक्रान्तः श्वानम् ।<br><br>

अतिश्वन्
अतिश्वन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತಮಜಾತಿಯ ನಾಯಿ<br><br>

अतिसक्ति
अतिसक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಸಂಬಂಧ / ಸಮೀಪ ಸಂಬಂಧ<br><br>अतिसक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಶಯವಾದ ಪ್ರೀತಿ<br><b>प्रयोगाः - </b>“अतिसक्तिमेत्य वरुणस्य दिशा भृशमन्वरज्यदतुषारकरः”|<br><b>उल्लेखाः - </b>माघ० ९-७ ।<br><br>

अतिसन्ध
अतिसन्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರ್ಯಾದೆಯನ್ನು ಮೀರಿದ<br><br>अतिसन्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಜ್ಞೆಯನ್ನು ಮೀರಿದ / ಮಾತಿಗೆ ತಪ್ಪಿದ<br><b>व्युत्पत्तिः - </b>अतिक्रान्तः सन्धां मर्यादां प्रतिज्ञां वा ।<br><br>

अतिसन्धातृ
अतिसन्धातृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರ್ಯಾದೆಯನ್ನು ಮೀರಿದ<br><br>अतिसन्धातृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಜ್ಞೆಯನ್ನು ಮೀರಿದ / ಮಾತಿಗೆ ತಪ್ಪಿದ<br><b>निष्पत्तिः - </b>अति+सम्+डुधाञ् (धारणे) “तृन्” (३-२-१३५) ।<br><br>

अतिसन्धान
अतिसन्धान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಂಚನೆ / ಮೋಸ<br><b>निष्पत्तिः - </b>अति-सम्-डु घाञ् (धारणे) “ल्युट्” (३-३-११५) ।<br><b>व्युत्पत्तिः - </b>अतिसन्धीयते |<br><br>

अतिसन्ध्या
अतिसन्ध्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಧ್ಯಾಕಾಲಕ್ಕೆ ಸಮೀಪಕಾಲ<br><b>व्युत्पत्तिः - </b>अत्यासन्ना सन्ध्या यस्याः ।<br><br>

अतिसर
अतिसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಮುಂದೆ ನಡೆಯುವವನು / ಮುಂದಾಳು<br><b>निष्पत्तिः - </b>सृ (गतौ) “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अतिसरति |<br><br>

अतिसर्ग
अतिसर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಾನ / ಕೊಡುಗೆ<br><b>निष्पत्तिः - </b>अति+सृज (विसर्गे) “घञ्” (३-३-१८) ।<br><b>व्युत्पत्तिः - </b>अतिसृज्यते |<br><b>प्रयोगाः - </b>“स्रष्टुवंरातिसर्गात्तु मया तस्य दुरात्मनः” |<br><b>उल्लेखाः - </b>रघु० १०-४२ ।<br><br>अतिसर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮಚಾರಾನುಜ್ಞೆ / ಸ್ವೇಚ್ಛೆಯಿಂದಿರಲು ಅನುಮತಿ<br><b>विस्तारः - </b>“अतिसर्गः कामचारानुज्ञा” - सि० कौ० ।<br><br>अतिसर्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೃಷ್ಟಿಯನ್ನು ಮೀರಿದ / ಸೃಷ್ಟಿಗೆ ಒಳಪಡದ / ನಿತ್ಯವಾದ<br><br>अतिसर्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಕ್ತ / ಮೋಕ್ಷ ಹೊಂದಿದ<br><b>व्युत्पत्तिः - </b>सर्गं सृष्टिमतिक्रान्तः ।<br><br>

अतिसर्जन
अतिसर्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಾನ<br><b>निष्पत्तिः - </b>अति+सृज (विसर्गे) “ल्युट्” (३-३-११५) ।<br><b>प्रयोगाः - </b>“तत्तदीयविशिखातिसर्जनात्” |<br><b>उल्लेखाः - </b>किरा० १३-५७ ।<br><br>

अतिसर्पण
अतिसर्पण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಲವಂತದ ಚಲನೆ<br><br>

अतिसर्व
अतिसर्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>अतिक्रान्तः सर्वान् ।<br><br>अतिसर्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸರ್ವಾತೀತ / ಎಲ್ಲರನ್ನೂ ಮೀರಿಸಿದವನು<br><br>

अतिसान्तपन
अतिसान्तपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಉಗ್ರವಾದ ಒಂದು ವ್ರತ<br><b>व्युत्पत्तिः - </b>अतिक्रान्तं सान्तपनम् ।<br><br>

अतिसायम्
अतिसायम्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಸಾಯಂಕಾಲಕ್ಕೆ ಸನ್ನಿಹಿತಕಾಲ<br><br>

अतिसार
अतिसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ರೋಗ<br><b>व्युत्पत्तिः - </b>अतिसारयति मलम् ।<br><br>

अतिसारकिन्
अतिसारकिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಸಾರ ರೋಗವುಳ್ಳವನು<br><b>निष्पत्तिः - </b>“इनिः” (५-२-११५) ।<br><b>व्युत्पत्तिः - </b>अतिसारोऽस्यास्ति |<br><br>

अतिसृष्ट
अतिसृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಡಲ್ಪಟ್ಟ / ದಾನಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अति+सृज (विसर्गे) “क्तः” (३-२-१०२) ।<br><br>

अतिसौरभ
अतिसौरभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ವಾಸನೆಯುಳ್ಳ ಮಾವಿನಮರ<br><b>व्युत्पत्तिः - </b>अतिशयितं सौरभमस्य ।<br><br>अतिसौरभ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ವಾಸನೆ<br><br>अतिसौरभ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ವಾಸನೆಯುಳ್ಳ<br><br>

अतिसौहित्य
अतिसौहित्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ತೃಪ್ತಿ<br><br>

अतिस्तुति
अतिस्तुति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಿತಿಮೀರಿದ ಹೊಗಳಿಕೆ / ಇಲ್ಲದ ಮತ್ತು ಸಲ್ಲದ ಗುಣಗಳ ಪ್ರಶಂಸೆ<br><b>व्युत्पत्तिः - </b>अतिशयिता स्तुतिः ।<br><br>

अतिस्पर्श
अतिस्पर्श<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತಸ್ಥ ವರ್ಣಗಳು / ಹೆಚ್ಚು ಸ್ಪೃಷ್ಟಪ್ರಯತ್ನವಿಲ್ಲದೆ ಉಚ್ಚರಿಸಬಹುದಾದ ಯ, ವ, ರ, ಲ ವರ್ಣಗಳು<br><br>अतिस्पर्श<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಿಕಸ್ಪರ್ಶ<br><br>अतिस्पर्श<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಪಣ / ಜಿಪುಣ<br><br>

अतिस्नेह
अतिस्नेह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಸ್ನೇಹ / ಹೆಚ್ಚು ಪ್ರೇಮ<br><b>प्रयोगाः - </b>“अतिस्नेहः पापशङ्की” |<br><b>उल्लेखाः - </b>शाकु० ४ ।<br><br>

अतिहसित
अतिहसित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾದ ನಗು / ಹೆಚ್ಚು ಶಬ್ದವಾಗುವಂತೆ ನಗುವಿಕೆ<br><br>

अतीक्ष्ण
अतीक्ष्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಸಿಯಲ್ಲದ<br><br>अतीक्ष्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೂಪಲ್ಲದ / ಹರಿತವಲ್ಲದ<br><b>प्रयोगाः - </b>“अस्त्रैरतीक्ष्णकठिनैजैगज्ज्यति मन्मथः” |<br><b>उल्लेखाः - </b>चन्द्रा० ।<br><br>

अतीत
अतीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮಿಸಿ ಮುಂದೆ ಹೋದ<br><b>निष्पत्तिः - </b>अति + इण् (गतौ) “क्तः” (३-२-१०२) ।<br><b>प्रयोगाः - </b>“अतीतदर्शामिव चन्द्रलेखाम्” |<br><b>उल्लेखाः - </b>याद० १३-३३ ।<br><br>अतीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೀರಿದ / ಒಳಪಡದ<br><b>प्रयोगाः - </b>1. “परिच्छेदातीतः सकलवचनानामविषयः” | 2. “अतीतसङ्ख्या विहिता ममाग्निना” |<br><b>उल्लेखाः - </b>1. मालती० १-३३ । 2. किरा० १४-१० ।<br><br>

अतीतनौक
अतीतनौक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಡಗನ್ನು ದಾಟಿದ / ಹಡಗನ್ನು ಅತಿಕ್ರಮಿಸಿ ಬಂದ<br><b>निष्पत्तिः - </b>“कप्” (५-४-१५१) ।<br><b>व्युत्पत्तिः - </b>अतीता नौर्येन |<br><br>

अतीन्द्र
अतीन्द्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಂದ್ರನನ್ನು ಮೀರಿದ<br><b>व्युत्पत्तिः - </b>अतिक्रान्तः इन्द्रम् ।<br><br>

अतीन्द्रिय
अतीन्द्रिय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯಗಳಿಂದ ತಿಳಿಯಲಾಗದ / ಅಪ್ರತ್ಯಕ್ಷ / ಪರೋಕ್ಷ<br><b>व्युत्पत्तिः - </b>इन्द्रियमतिक्रान्तम् ।<br><b>प्रयोगाः - </b>“अतीन्द्रियज्ञाननिधिर्नभःसदः” |<br><b>उल्लेखाः - </b>माघ० १-११ ।<br><br>

अतीव
अतीव<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಬಹಳ ಹೆಚ್ಚಾಗಿ<br><b>व्युत्पत्तिः - </b>अति च इव च ।<br><b>प्रयोगाः - </b>“अंशुपाणिभिरतीव पिपासुः” |<br><b>उल्लेखाः - </b>किरा० ९-३ ।<br><br>

अतुल
अतुल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿಲಕವೃಕ್ಷ / ಕ್ಯಾಸರಿಕೆ ಗಿಡ<br><br>अतुल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮವಲ್ಲದ / ಅಸಮಾನ / ಅನುಪಮ<br><br>

अतुल्य
अतुल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಮಾನ / ಅಸದೃಶ / ಸಮವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न तुल्यः |<br><br>

अतुष
अतुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಟ್ಟಿಲ್ಲದ ಧಾನ್ಯ<br><b>व्युत्पत्तिः - </b>नास्ति तुषो यस्य ।<br><br>

अतुहिन
अतुहिन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಷ್ಣವಾದ / ಬಿಸಿಯಾದ<br><b>व्युत्पत्तिः - </b>न तुहिनः ।<br><br>

अतुहिनरश्मि
अतुहिनरश्मि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>न तुहिनः रश्मिः यस्य ।<br><br>अतुहिनरश्मि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಸಿಯಾದ ಕಿರಣ<br><b>व्युत्पत्तिः - </b>अतुहिनश्चासौ रश्मिश्च ।<br><br>

अतुहिनरुचि
अतुहिनरुचि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>न तुहिना रुचिः यस्य ।<br><b>प्रयोगाः - </b>“अतुहिनरुचिनासौ केवलं नोदयाद्रिः” |<br><b>उल्लेखाः - </b>माघ० ११-४६ ।<br><br>अतुहिनरुचि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಸಿಯಾದ ಕಿರಣ<br><b>व्युत्पत्तिः - </b>अतुहिना च सा रुचिश्च ।<br><br>

अतृणाद
अतृणाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಲ್ಲನ್ನು ತಿನ್ನದ ಮತ್ತು ಹಾಲನ್ನು ಕುಡಿಯುವ ಕರು<br><b>निष्पत्तिः - </b>अद (भक्षणे) “अण्” (३-२-१) ।<br><b>व्युत्पत्तिः - </b>न तृणमत्ति |<br><br>

अतृप्ति
अतृप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಂತೋಷ / ಸಂತೋಷವಿಲ್ಲದಿರುವಿಕೆ<br><br>अतृप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೃಪ್ತಿಯಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न तृप्तिः ।<br><br>अतृप्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೃಪ್ತಿಯಿಲ್ಲದ<br><br>अतृप्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न तृप्तिर्यस्य ।<br><br>

अतेजस्
अतेजस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಧಕಾರ / ಕತ್ತಲೆ<br><br>अतेजस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶವಿಲ್ಲದ<br><br>अतेजस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಲಹೀನ / ದುರ್ಬಲ<br><b>व्युत्पत्तिः - </b>नास्ति तेजो यस्य ।<br><br>

अत्क
अत्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯಾಣಿಕ<br><br>अत्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವಯವ<br><b>निष्पत्तिः - </b>अत (सातत्यगमने) “कन्” (उ० ३-४३) ।<br><b>विस्तारः - </b>अत्कः पथिकः शरीरावयवश्च - सि० कौ० ।<br><br>

अत्ता
अत्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಯಿ<br><b>व्युत्पत्तिः - </b>अतति सततं सम्बध्नाति ।<br><br>अत्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠ ಸಹೋದರಿ<br><br>

अत्ति
अत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಯಿ<br><b>निष्पत्तिः - </b>अत (सातत्यगमने) “क्तिच्” (३-३-१७४) ।<br><b>व्युत्पत्तिः - </b>अत्यते सदा सम्बध्यते |<br><br>अत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠ ಸಹೋದರಿ<br><br>

अत्तिका
अत्तिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಯಿ<br><br>अत्तिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠ ಸಹೋದರಿ<br><b>निष्पत्तिः - </b>अत्ता “कन्” (५-३-९७) ।<br><b>व्युत्पत्तिः - </b>अत्तैव |<br><br>

अतृ
अतृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><b>निष्पत्तिः - </b>अद (भक्षणे) “तृच्” (३-१-१३३) ।<br><br>अतृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಟಮಾಡುವ<br><b>प्रयोगाः - </b>“अरक्षितारमत्तारं नृपं विद्यादधोगतिम्” |<br><b>उल्लेखाः - </b>मनु० ८-३०९ ।<br><br>

अत्न
अत्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>अत (सातत्यगमने) “नः” (उ० ३-६) ।<br><br>अत्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ<br><br>

अत्यङ्गुल
अत्यङ्गुल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆರಳಿನ ಪ್ರಮಾಣಕ್ಕಿಂತಲೂ ಅಧಿಕವಾದ<br><b>निष्पत्तिः - </b>अति+अङ्गुलि “अच्” (५-४-८६) ।<br><b>व्युत्पत्तिः - </b>अतिक्रान्तोऽङ्गुलिम् तत्परिमाणम्|<br><br>

अत्यध्व
अत्यध्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾರಿಯನ್ನು ದಾಟದ / ಮುಂದೆ ಸಾಗಿದ<br><b>निष्पत्तिः - </b>“अच्” (५-४-८५) ।<br><b>व्युत्पत्तिः - </b>अतिक्रान्तोऽध्वानम् |<br><br>

अत्यध्वन्
अत्यध्वन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಪಥ / ಒಳ್ಳೆಯ ದಾರಿ<br><b>व्युत्पत्तिः - </b>अतिशयितोऽध्वा ।<br><b>विस्तारः - </b>“न पूजनात्” इति अच् न भवति ।<br><br>

अत्यन्त
अत्यन्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾದ / ಅಧಿಕವಾದ / ಅತಿಶಯವಾದ<br><b>व्युत्पत्तिः - </b>अतिक्रान्तोऽन्तम् ।<br><b>प्रयोगाः - </b>“निनाय सात्यन्तहिमोत्किरानिलाः” |<br><b>उल्लेखाः - </b>कुमा० ५-२६ ।<br><br>अत्यन्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶರಹಿತ<br><br>अत्यन्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂತ್ಯವಿಲ್ಲದ / ಕೊನೆಯಿಲ್ಲದ<br><br>अत्यन्त<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾಗಿ / ಅಧಿಕವಾಗಿ<br><br>अत्यन्त<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಯಾವಾಗಲೂ / ಎಂದೆಂದಿಗೂ<br><b>व्युत्पत्तिः - </b>अन्तस्यात्ययः ।<br><b>प्रयोगाः - </b>“अत्यन्तमेव मदिरेक्षणवल्लभाभिः” |<br><b>उल्लेखाः - </b>शाकु०१-२३ ।<br><br>

अत्यन्तकोपन
अत्यन्तकोपन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕೋಪಿಸಿಕೊಳ್ಳುವ<br><b>निष्पत्तिः - </b>“युच्” (३-२-१५१) ।<br><b>व्युत्पत्तिः - </b>अत्यन्तं कुप्यति |<br><b>विस्तारः - </b>“चण्डस्त्वत्यन्तकोपनः” - अम० ।<br><br>

अत्यन्तगामिन्
अत्यन्तगामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಸಂಚಾರ ಶೀಲ / ಹೆಚ್ಚಾಗಿ ನಡೆಯುವವನು<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) “णिनिः” (३-२-७८) ।<br><b>व्युत्पत्तिः - </b>अत्यन्तं गच्छति |<br><br>

अतिगामिनी
अतिगामिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಸಂಚಾರ ಶೀಲೆ / ಹೆಚ್ಚಾಗಿ ನಡೆಯುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां “डीप्” (४-१-५) ।<br><br>

अत्यन्तसंयोग
अत्यन्तसंयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಡಬಿಡದ ಸಂಬಂಧ<br><br>अत्यन्तसंयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಪ್ತಿ<br><b>व्युत्पत्तिः - </b>अन्तमवसानमतिक्रान्तः संयोगः ।<br><br>

अत्यन्ताभाव
अत्यन्ताभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣವಾಗಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>अत्यन्तः अन्तमतिक्रान्तः नित्यः अभावः ।<br><b>विस्तारः - </b>ಉದಾ: घटाभावः, पटाभावः ಇತ್ಯಾದಿ.<br><br>

अत्यन्तिक
अत्यन्तिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಸಮೀಪ<br><b>व्युत्पत्तिः - </b>अतिशयितमन्तिकम् ।<br><br>अत्यन्तिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ದೂರ<br><b>व्युत्पत्तिः - </b>अतिक्रान्तमन्तिकम् ।<br><br>अत्यन्तिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ವೇಗವಾಗಿ ಹೋಗುವ<br><b>निष्पत्तिः - </b>“ठक्” (४-४-८) ।<br><b>व्युत्पत्तिः - </b>अत्यन्तं गच्छाति |<br><br>अत्यन्तिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಸಮೀಪದಲ್ಲಿರುವ<br><br>अत्यन्तिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ದೂರದಲ್ಲಿರುವ<br><br>

अत्यन्तीन
अत्यन्तीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಸಂಚಾರದ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>“ख” ९५-२-११) ।<br><b>व्युत्पत्तिः - </b>अत्यन्तं गामी |<br><br>

अत्यम्ल
अत्यम्ल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಣಸೆ ಮರ<br><b>व्युत्पत्तिः - </b>अतिशयितोऽम्लो यस्य ।<br><br>अत्यम्ल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಹುಳಿಯಾದ<br><br>

अत्यम्ला
अत्यम्ला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೋಟಮಾದಳದ ಗಿಡ<br><br>

अत्यय
अत्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮ / ಮೀರುವಿಕೆ<br><br>अत्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿನಾಶ<br><b>निष्पत्तिः - </b>अति+इण् (गतौ) “अच्” (३-३-५६) ।<br><br>अत्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಷ್ಟ<br><br>अत्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೋಷ<br><br>अत्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಂಡನೆ / ಶಿಕ್ಷೆ<br><b>विस्तारः - </b>“अत्ययोऽतिक्रमे दोषे विनाशे दण्डकृच्छ्रयोः” -हेम० ।<br><br>

अत्यर्थ
अत्यर्थ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಿಗೆ / ಆಧಿಕ್ಯ<br><br>अत्यर्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾದ / ಅತಿಶಯವಾದ<br><b>व्युत्पत्तिः - </b>अर्थ विषयमतिक्रान्तः ।<br><br>अत्यर्थ<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾಗಿ / ಅತಿಶಯವಾಗಿ<br><b>प्रयोगाः - </b>“अत्यर्थं दुरुपसदादुपेत्य दूरम्” |<br><b>उल्लेखाः - </b>किरा ८-९ ।<br><br>

अत्यल्प
अत्यल्प<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕಡಿಮೆಯಾದ<br><br>अत्यल्प<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಸಣ್ಣದಾದ<br><br>

अत्यष्टि
अत्यष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹದಿನೇಳನೆಯ ಛಂದಸ್ಸು / ಹದಿನೇಳು ಅಕ್ಷರಗಳ ಪಾದವುಳ್ಳ ಛಂದಸ್ಸು<br><br>

अत्यह्न
अत्यह्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ದಿನ ಮೀರಿದ / ಒಂದು ದಿನದ ಕಾಲಕಳೆದ<br><b>निष्पत्तिः - </b>“टच्” (५-४-९१) । अह्नादेशः (५-४-८८)।<br><b>व्युत्पत्तिः - </b>अहरतिक्रान्तः |<br><br>

अत्याकार
अत्याकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೊಡ್ಡ ಆಕಾರ / ದೊಡ್ಡ ಶರೀರ<br><b>व्युत्पत्तिः - </b>अतिशयित आकारः । अतिशयेनाकारः ।<br><b>विस्तारः - </b>“अत्याकारः परिभवस्तिरस्कारोऽप्यनादरः” - वैज० ।<br><br>अत्याकार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೊಡ್ಡ ಶರೀರವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अतिशयित आकारो यस्य ।<br><br>

अत्याग
अत्याग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಾನವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न त्यागः |<br><br>अत्याग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾನವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न त्यागो यत्र ।<br><br>

अत्याचार
अत्याचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಕಾರ್ಯಾಚರಣೆ / ನಿಷಿದ್ಧವಾದ ಕೆಲಸಮಾಡುವುದು<br><br>अत्याचार<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಆಚಾರವನ್ನು ಮೀರಿ / ಸಂಪ್ರದಾಯವನ್ನು ಉಲ್ಲಂಘಿಸಿ<br><b>व्युत्पत्तिः - </b>आचारमतिक्रम्य ।<br><br>

अत्याज्य
अत्याज्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡಲು ಅಶಕ್ಯವಾದ<br><br>अत्याज्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡಲು ಅರ್ಹವಲ್ಲದ<br><b>निष्पत्तिः - </b>“ण्यत्” (३-१-१२४) ।<br><b>व्युत्पत्तिः - </b>न त्यक्तुं शक्यम् |<br><br>

अत्यादान
अत्यादान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾಗಿ ತೆಗೆದುಕೊಳ್ಳುವುದು<br><b>व्युत्पत्तिः - </b>अतिशयितमादानम् ।<br><br>अत्यादान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಳ್ಳದಿರುವ<br><b>व्युत्पत्तिः - </b>“आदानमतिक्रान्तः” ।<br><br>

अत्याधान
अत्याधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮಣ / ಉಲ್ಲಂಘನೆ<br><br>अत्याधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊರಿಸುವಿಕೆ / ಆರೋಪಣೆ<br><b>निष्पत्तिः - </b>अति+आ+डु घाञ् (धारणादौ) “ल्युट्” (३-३-११५) ।<br><br>अत्याधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠ ಸಹೋದರನಿಗೆ ಮುಂಚೆ (ಅವನನ್ನು ಮೀರಿ) ವಿವಾಹವಾಗಿ ಅಗ್ನಿಕಾರ್ಯಾದಿಗಳನ್ನು ಮಾಡುವುದು<br><b>व्युत्पत्तिः - </b>अतिक्रम्य ज्येष्ठमाधानम् ।<br><br>अत्याधान<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ನಾಶ / ಯಾಗಾಗ್ನಿಯನ್ನು ರಕ್ಷಿಸದಿರುವುದು<br><b>निष्पत्तिः - </b>अव्ययी० (२-१-६) ।<br><b>व्युत्पत्तिः - </b>आधानस्यात्ययः |<br><br>

अत्याय
अत्याय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಿಕಲಾಭ / ಹೆಚ್ಚು ವರಮಾನ<br><b>निष्पत्तिः - </b>अति +अय (गतौ) “घञ्” (३-३-१८) ।<br><br>अत्याय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮಣ / ಉಲ್ಲಂಘನೆ / ಮೀರುವಿಕೆ<br><br>

अत्यायु
अत्यायु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞಸಂಬಂಧವಾದ ಒಂದು ಪಾತ್ರೆ<br><br>

अत्यारूढ
अत्यारूढ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಪ್ರಸಿದ್ಧಿ<br><br>अत्यारूढ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಮೇಲಕ್ಕೇರುವಿಕೆ<br><br>अत्यारूढ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾಗಿ ಬೆಳೆಯುವಿಕೆ<br><br>अत्यारूढ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಕತ್ಷ / ಘನತೆ / ದೊಡ್ಡಸ್ತಿಕೆ<br><b>निष्पत्तिः - </b>अति+आ+रुह (बीजजन्मनि प्रादुर्भावे च) भावे “क्तः” (३-३-११४) ।<br><br>अत्यारूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಮೇಲಕ್ಕೇರಿದ<br><br>अत्यारूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಪ್ರಸಿದ್ಧವಾದ<br><b>निष्पत्तिः - </b>अति+आ_रुह कर्त० “क्तः” (३-४-७२) ।<br><br>अत्यारूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಹೆಚ್ಚಾಗಿ ಬೆಳೆದ<br><b>व्युत्पत्तिः - </b>अत्यन्तमारुढः ।<br><b>प्रयोगाः - </b>“अत्यारूढो हि नारीणामकालज्ञो मनोभवः” |<br><b>उल्लेखाः - </b>रघु० १२-३३ ।<br><br>

अत्यारूढि
अत्यारूढि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>“अत्यारूढ” ಪದದ (न०)ದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अति+आ+रुह भावे “क्तिन्” (३-३-९४) ।<br><br>

अत्याश
अत्याश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಆಸೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अतिशयिता आशा यस्य ।<br><br>

अत्याशा
अत्याशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಆಸೆ / ಮಿತಿಮೀರಿದ ಆಸೆ<br><b>व्युत्पत्तिः - </b>अतिशयिता आशा ।<br><br>

अत्याश्रम
अत्याश्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ ಆಶ್ರಮ / ಸಂನ್ಯಾಸಾಶ್ರಮ<br><b>व्युत्पत्तिः - </b>अतिशयितः आश्रमः ।<br><br>अत्याश्रम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಮವನ್ನು ಮೀರಿದ / ಆಶ್ರಮ ಧರ್ಮಗಳನ್ನು ತ್ಯಜಿಸಿದ<br><b>व्युत्पत्तिः - </b>अतिक्रान्तः आश्रमान् ।<br><br>

अत्याहित
अत्याहित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಭೀತಿ / ಮಹಾಭಯ<br><b>प्रयोगाः - </b>अतीवाधीयते स्म मनसि ।<br><br>अत्याहित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಾಯ<br><b>प्रयोगाः - </b>“अत्याहितम् अत्याहितम्” |<br><b>उल्लेखाः - </b>मालती० ३ ।<br><br>अत्याहित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆತುರದ ಕಾರ್ಯ / ಅವಿಚಾರಿತಕೃತ್ಯ<br><b>प्रयोगाः - </b>“पाण्डुपुत्रैर्न किमप्यत्याहितमाचरितं भवेत्” |<br><b>उल्लेखाः - </b>वेणी० २ ।<br><br>

अत्युक्त
अत्युक्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಿಕವಾದ ಮಾತು / ಹೆಚ್ಚು ಮಾತು<br><br>

अत्युक्ता
अत्युक्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎರಡನೆಯ ಛಂದಸ್ಸು<br><br>अत्युक्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎರಡು ಸಂಖ್ಯೆ<br><br>

अत्युक्ति
अत्युक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಿಕವಾದ ಮಾತು / ಹೆಚ್ಚಿನ ಮಾತು<br><br>अत्युक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ಯಾಯದ ಮಾತು<br><br>अत्युक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಲ್ಲದ ಸಲ್ಲದ ಗುಣಗಳ ವರ್ಣನೆ<br><b>व्युत्पत्तिः - </b>अतिशयेन उक्तिः ।<br><br>अत्युक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥಾಲಂಕಾರದ ಒಂದು ಭೇದ<br><b>प्रयोगाः - </b>“अत्युक्तिरद्भुतातथ्यशौर्यौन्दार्यादिवर्णनम्” |<br><b>उल्लेखाः - </b>चन्द्रा० ।<br><br>

अत्युग्र
अत्युग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕ್ರೂರವಾದ<br><br>

अत्युच्छ्रित
अत्युच्छ्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಎತ್ತರವಾದ<br><b>व्युत्पत्तिः - </b>अत्यन्तमुच्छ्रितः ।<br><br>

अत्युत्कट
अत्युत्कट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಹೆಚ್ಚಾದ / ಬಹಳ ಉಗ್ರವಾದ<br><b>प्रयोगाः - </b>“अत्युत्कटैः पुण्यपापैरिहैव फलमश्नुते” ।<br><br>

अत्युत्कृष्ट
अत्युत्कृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಶ್ರೇಷ್ಠವಾದ<br><b>व्युत्पत्तिः - </b>अत्यन्तमुत्कुष्टः ।<br><br>

अत्यूह
अत्यूह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರುಕಾಗೆ<br><b>निष्पत्तिः - </b>ऊह (वितर्के) “अच्” (३-१-१३४) |<br><b>व्युत्पत्तिः - </b>अतिशयेन ऊहते |<br><br>

अत्र
अत्र<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಇಲ್ಲಿ / ಈ ಪ್ರದೇಶದಲ್ಲಿ<br><b>निष्पत्तिः - </b>इदम् “त्रल्” (५-३-१०) ।<br><b>व्युत्पत्तिः - </b>अस्मिन् |<br><b>प्रयोगाः - </b>“एष चात्र समया सरोजिनीमेकतानयति चित्तचक्षुषी” |<br><b>उल्लेखाः - </b>याद० १७-३० ।<br><br>अत्र<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಈ ವಿಷಯದಲ್ಲಿ<br><b>प्रयोगाः - </b>“अतोऽत्र किञ्चिद्भवतीं बहुक्षमाम्” |<br><b>उल्लेखाः - </b>कुमा० ५-४० ।<br><br>अत्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇತರರಿಂದ ರಕ್ಷಿಸಲ್ಪಡದ (ಕ್ಷತ್ರಿಯ)<br><b>निष्पत्तिः - </b>त्रैङ् (पालने) “कः” (३-२-३) ।<br><b>व्युत्पत्तिः - </b>न त्रायते |<br><br>

अत्रत्य
अत्रत्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈ ಸ್ಥಳದಲ್ಲಿರುವ / ಈ ಸ್ಥಳಕ್ಕೆ ಸಂಬಂಧಿಸಿದ<br><b>निष्पत्तिः - </b>“त्यप्” (४-२-१०४) ।<br><b>व्युत्पत्तिः - </b>अत्र भवः |<br><b>प्रयोगाः - </b>“दौरात्म्याद्रक्षसस्तान्तु नात्रत्याः श्रद्दूधुः प्रजाः” |<br><b>उल्लेखाः - </b>रघु० १५-७२ ।<br><br>अत्रत्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈ ಸ್ಥಳದಲ್ಲಿ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>“ल्यप्” ।<br><b>व्युत्पत्तिः - </b>अत्र जातः |<br><br>

अत्रप
अत्रप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಚಿಕೆಯಿಲ್ಲದ / ಲಜ್ಜೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति त्रपा लज्जा यस्य ।<br><br>

अत्रभवत्
अत्रभवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜ್ಯ<br><b>निष्पत्तिः - </b>इदम् प्रथमार्थे “त्रल्” (५-३-१४) ।<br><b>व्युत्पत्तिः - </b>अत्रभवान् ।<br><b>प्रयोगाः - </b>1. “आसने तावदवभवतोः” । “सङ्गीतरचनां कृत्वा अत्रभवतो दूतं प्रेषयतम्” | 2. “यद्यत्रभवत्या शोभनं भणितं तत इदं पारितोषिकं प्रयच्छामि” |<br><b>उल्लेखाः - </b>1. माल० १ । 2. माल० २ ।<br><br>

अत्रभवती
अत्रभवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜ್ಯೆ<br><b>निष्पत्तिः - </b>स्त्रियाम् “डीप्” (४-१-६) ।<br><br>

अत्रस्त
अत्रस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯಪಡದಿರುವ / ಹೆದರದ<br><b>व्युत्पत्तिः - </b>न त्रस्तः ।<br><b>प्रयोगाः - </b>“जुगोपात्मानमत्रस्तो भेजे धर्ममनातुरः” |<br><b>उल्लेखाः - </b>रघु १-२१ ।<br><br>

अत्रान्तरे
अत्रान्तरे<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಏತನ್ಮಧ್ಯೆ / ಇಷ್ಟರಲ್ಲಿ<br><b>प्रयोगाः - </b>“अत्रान्तरे किमपि वाग्विभवातिवृत्तवैचित्र्यम्” |<br><b>उल्लेखाः - </b>मालती० १-२६ ।<br><br>

अत्रास
अत्रास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಯವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न त्रासः ।<br><br>अत्रास<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯವಿಲ್ಲದಿರುವ / ಹೆದರಿಕೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न त्रासो यस्य ।<br><br>

अत्रि
अत्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಪ್ತಋಷಿಗಳಲ್ಲೊಬ್ಬ ಋಷಿ<br><b>प्रयोगाः - </b>“अथ नयनसमुत्थं ज्योतिरत्रेरिव द्यौः” |<br><b>उल्लेखाः - </b>रघु० २-७५ ।<br><br>अत्रि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನುಂಗುವ / ನಾಶಪಡಿಸುವ<br><b>निष्पत्तिः - </b>अद (भक्षणे) “त्रिप्” (उ० ४-६८) ।<br><b>व्युत्पत्तिः - </b>अत्ति |<br><br>

अत्रिन्
अत्रिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>“अत्रि” ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अद (भक्षणे) “त्रिनिः” (उ० ४-६८) ।<br><br>

अत्रिजात
अत्रिजात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ / ಅತ್ರಿಮಹರ್ಷಿಯ ಪುತ್ರ<br><b>व्युत्पत्तिः - </b>अत्रेर्नेत्रात् जातः ।<br><br>

अत्रिनेत्रज
अत्रिनेत्रज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) “डः” (३-२-९८) ।<br><b>व्युत्पत्तिः - </b>अत्रेर्नेत्रात् जायते |<br><br>

अत्रिसंहिता
अत्रिसंहिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅತ್ರಿಮಹರ್ಷಿ ವಿರಚಿತವಾದ (ವರ್ಣಾಶ್ರಮಾಚಾರಾದಿಗಳನ್ನು ತಿಳಿಸತಕ್ಕ) ಧರ್ಮಶಾಸ್ತ್ರ ಗ್ರಂಥ<br><br>

अथ
अथ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>प्रयोगाः - </b>1. “अथ योगानुशासनम्” | 2. “अथातो ब्रह्मजिज्ञासा” |<br><b>उल्लेखाः - </b>1. पा० यो० सू० १-१ । 2. (ब्र० सू० १-१-१) ।<br><br>अथ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನಂತರ / ತರುವಾಯ / ಬಳಿಕ<br><b>प्रयोगाः - </b>“अथोप्सितं भर्तुरुपस्थितोदयम्” |<br><b>उल्लेखाः - </b>रघु० ३-१ ।<br><br>अथ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ<br><b>प्रयोगाः - </b>“अथ योगानुशासनम्” |<br><b>उल्लेखाः - </b>पा० यो० सू० १-१ ।<br><br>अथ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ<br><b>प्रयोगाः - </b>“अथैकधेनोरपारधचण्डाद्गुरोः कृशानुप्रतिमाद्विभेषि” |<br><b>उल्लेखाः - </b>रघु० २-४९ ।<br><br>अथ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲ / ಸಕಲ<br><b>प्रयोगाः - </b>“अथातो धर्मं व्याख्यास्यामः” ।<br><br>अथ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಶಯ / ವಿಕಲ್ಪ<br><b>प्रयोगाः - </b>“शब्दो नित्योऽथानित्यः” ।<br><br>अथ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಮುಚ್ಚಯ<br><b>प्रयोगाः - </b>“भीमोऽथार्जुनः” ।<br><br>अथ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪಕ್ಷಾಂತರ / ಮತಾಂತರ<br><b>निष्पत्तिः - </b>(अर्थ (याच्ञायाम्) “डह्’ (वा० ३-२-१०१) । पृषो० ।<br><b>प्रयोगाः - </b>1. “अथ क्षमामेव निरस्तविक्रमाश्चिराय पर्येषि सुखस्य साधनम्” | 2. “अथ चेदवधिः प्रतीक्ष्यते” |<br><b>उल्लेखाः - </b>1. किरा० १-४४ । 2. किरा० २-१६ ।<br><br>अथ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಧಿಕಾರ<br><b>विस्तारः - </b>“अथातो संशये स्यातामधिकारे च मङ्गले । विकल्पानन्तरप्रश्नकार्त्स्न्र्यारम्भसमुच्यये” - मेदि० ।<br><br>

अथकिम्
अथकिम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ / ಒಪ್ಪಿಗೆ<br><b>प्रयोगाः - </b>“अपि वृषलमनुरक्ताः प्रकृतयः? । अथकिम्” |<br><b>उल्लेखाः - </b>मुद्रा० १ ।<br><br>

अथर्वण
अथर्वण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಥರ್ವವೇದ / ನಾಲ್ಕನೆಯ ವೇದ<br><br>अथर्वण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ / ಈಶ್ವರ<br><b>विस्तारः - </b>“जटाचीरोऽथर्वण नन्दिवर्धनगुडाकेशोग्रकालञ्जराः” - त्रिकाण्ड० ।<br><br>

अथर्वन्
अथर्वन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮನ ಜ್ಯೇಷ್ಠ ಪುತ್ರ<br><b>उल्लेखाः - </b>मुण्डक० ।<br><b>विस्तारः - </b>[ಕಲ್ಪಾಂತರದಲ್ಲಿ ಬ್ರಹ್ಮನು ಈ ಋಷಿಯನ್ನು ಮೊದಲು ಸೃಷ್ಟಿಸಿ ವೇದೋಪದೇಶಮಾಡಿದನು.]<br><br>अथर्वन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸಿಷ್ಠಋಷಿ<br><b>प्रयोगाः - </b>“कृतपदपङ्क्तिरथर्वणेव वेदः” |<br><b>उल्लेखाः - </b>किरा० १०-१० ।<br><br>अथर्वन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ<br><br>अथर्वन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಥರ್ವಮಂತ್ರ<br><b>प्रयोगाः - </b>“जिष्णुं जैत्रैरथर्वभिः”<br><b>उल्लेखाः - </b>रघु० १७-१३ ।<br><br>अथर्वन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಥರ್ವಕುಲದಲ್ಲಿ ಜನಿಸಿದವರು<br><br>

अथर्वविद्
अथर्वविद्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸಿಷ್ಠಋಷಿ<br><br>अथर्वविद्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಥರ್ವವೇದೋಕ್ತಕರ್ಮಾಚರಣೆಯುಳ್ಳವನು / ಅಥರ್ವವೇದ ತಿಳಿದವನು<br><b>निष्पत्तिः - </b>विद (ज्ञाने) “क्विप्” (३-२-६१) ।<br><b>व्युत्पत्तिः - </b>अथर्ववेदं तदुक्तं कर्म वा वेत्ति |<br><b>प्रयोगाः - </b>“गुरुणाऽथर्वविदा कृतक्रियः” |<br><b>उल्लेखाः - </b>रघु० ७-८ ।<br><br>

अथर्वशिखा
अथर्वशिखा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಥರ್ವವೇದದ ಉಪನಿಷತ್ತು<br><br>

अथर्वशिरस्
अथर्वशिरस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಥರ್ವವೇದದ ಉಪನಿಷತ್ತು<br><b>व्युत्पत्तिः - </b>अथर्वणो वेदस्य शिखेव शिर इव वा ब्रह्मविद्याप्रतिपादकत्वात् ।<br><br>

अथर्वाङ्गिरस
अथर्वाङ्गिरस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಥರ್ವಮುನಿ ಮತ್ತು ಅಂಗಿರಸ್ಸು<br><b>व्युत्पत्तिः - </b>अथर्वा चाङ्गिराश्च ।<br><br>अथर्वाङ्गिरस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಥರ್ವ ಮತ್ತು ಅಂಗಿರಸ್ಸುಗಳ ವಂಶದಲ್ಲಿ ಜನಿಸಿದವರು<br><br>

अतर्वाधिप
अतर्वाधिप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಥರ್ವ ಶಾಖಾಧಿಪ / ಬುಧ<br><b>व्युत्पत्तिः - </b>अथर्वणोऽधिपः ।<br><b>प्रयोगाः - </b>“सामशाखाधिपो भौमः शशिजोऽथर्ववेदराट्” |<br><br>

अथवा
अथवा<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಮತಾಂತರ / ಪಕ್ಷಾಂತರ<br><b>प्रयोगाः - </b>“अथवाभिनिविष्टबुद्धिषु व्रजति व्यर्थकतां सुभाषितम्” |<br><b>उल्लेखाः - </b>माघ० १६-४३ ।<br><br>

अथो
अथो<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>“अथ” ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अर्थ (याच्ञायाम्) “डो” बाहु० रलोपः पृषो० ।<br><b>प्रयोगाः - </b>“अथो शरस्तेन मदर्थमुज्झितः” |<br><b>उल्लेखाः - </b>किरा० १४-१७ ।<br><br>

अदंष्ट्र
अदंष्ट्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ / ಹಾವು<br><br>अदंष्ट्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋರೆ ಹಲ್ಲುಗಳಿಲ್ಲದ<br><br>

अदक्ष
अदक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಮರ್ಥ/ ಜಡ / ಮಂದಸ್ವಭಾವದ<br><br>

अदक्षिण
अदक्षिण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣೆಯಿಲ್ಲದ (ಯಾಗ)<br><b>प्रयोगाः - </b>“मृतो यज्ञस्त्वदक्षिणः” |<br><b>उल्लेखाः - </b>पञ्चत० ।<br><br>अदक्षिण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಡಭಾಗ<br><br>अदक्षिण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕೂಲವಲ್ಲದ<br><br>अदक्षिण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಮರ್ಥ್ಯವಿಲ್ಲದ<br><br>

अदग्ध
अदग्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಡಲ್ಪಡದ<br><br>अदग्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರದಂತೆ ಅಗ್ನಿ ಸಂಸ್ಕಾರ ಮಾಡಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न दग्धः ।<br><br>

अदण्ड्य
अदण्ड्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಕ್ಷೆಗೆ ಅರ್ಹನಲ್ಲದ<br><b>निष्पत्तिः - </b>“यत्” (५-१-६६) ।<br><b>व्युत्पत्तिः - </b>दण्डमर्हति | न दण्ड्यः ।<br><b>प्रयोगाः - </b>अदण्ड्यान् दण्डयन् राजा दण्ड्यांश्चैवाप्यदण्डयन्” |<br><b>उल्लेखाः - </b>मनु० ८-१२८ ।<br><br>अदण्ड्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಕ್ಷೆಗೆ ಒಳಗಾಗದ<br><b>प्रयोगाः - </b>1. “प्ताचार्यः सुहृन्माता भार्या पुत्रः पुरोहितः । नादण्ड्यो नाम राज्ञोऽस्ति यः स्वधर्मे न तिष्ठति” | 2. “अदण्ड्या हस्तिनोऽश्वाश्च प्रजापाला हि ते स्मृताः । अदण्ड्याः काणकुण्ठाश्च वृषभः कृतलक्षणः” स्मृतिः ।<br><b>उल्लेखाः - </b>1. मनु० ८-३३५ ।<br><br>

अदत्त
अदत्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯರ್ಥವಾದ ದಾನ / ಕೆಲವು ಸಂದರ್ಭಗಳಲ್ಲಿ ಕೊಟ್ಟು ಪುನಃ ಹಿಂದಕ್ಕೆ ತೆಗೆದುಕೊಳ್ಲಬಹುದಾದ ದಾನ<br><br>अदत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾನಮಾಡಲ್ಪಡದ / ಕೊಡಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न दत्तः ।<br><br>

अदत्ता
अदत्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹವಾಗದ ಕನ್ಯೆ<br><br>

अदत्तपूर्वा
अदत्तपूर्वा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹವು ನಿಶ್ಚಯವಾಗದ ಕನ್ಯೆ / ವಿವಾಹಕ್ಕಾಗಿ ವಾಗ್ದಾನ ಮಾಡಲ್ಪಡದ ಕನ್ಯೆ<br><b>प्रयोगाः - </b>“अदत्तपूर्वोत्याशङ्क्यते” |<br><b>उल्लेखाः - </b>मालती० ४ ।<br><br>अदत्तपूर्वा<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂದೆಕೊಡಲ್ಪಡದ<br><br>

अदत्तादायिन्
अदत्तादायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಡದಿರುವುದನ್ನು ತೆಗೆದುಕೊಳ್ಳುವವನು<br><b>निष्पत्तिः - </b>आ+डु दाञ् (दाने) “णिनिः” (३-२-७८) ।<br><b>व्युत्पत्तिः - </b>अदत्तमादत्ते |<br><b>प्रयोगाः - </b>“अदत्तादायिनोहस्तात् लिप्सेत ब्राह्मणो धनम् । याजनाध्ययनेनापि यथा स्तेनस्तथैव सः ।<br><br>

अदद्र्यञ्च्
अदद्र्यञ्च्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇದನ್ನು ಹೊಂದುವ / ಇದರ ಕಡೆಗೆ ಹೋಗುವ<br><b>निष्पत्तिः - </b>अञ्चु (गतौ) “क्विप्” (३-२-६२) । “अद्रि” आदेशः (८-२-८०) ।<br><b>व्युत्पत्तिः - </b>अमुमञ्चति |<br><br>

अदन
अदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೋಜನ / ಊಟಮಾಡುವುದು<br><b>निष्पत्तिः - </b>अद (भक्षणे) “ल्युट्” (३-३-११५) ।<br><br>अदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಹಾರ / ಊಟದ ಪದಾರ್ಥ<br><b>निष्पत्तिः - </b>अद कर्म० “ल्युट्” (३-३-११३) ।<br><b>व्युत्पत्तिः - </b>अद्यते स्म |<br><b>प्रयोगाः - </b>“प्रत्यवसानमशनं भोजनं जेमनादने” |<br><b>उल्लेखाः - </b>वैज० ।<br><br>

अदन्त
अदन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಷನೆಂಬ ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>नास्ति दन्तोऽस्य ।<br><b>प्रयोगाः - </b>“पूष्णश्चापातयद्दन्तान् कालिङ्गस्य यथा बलः । शप्यमाने गरिमणि योऽहसद्दर्शयन् दतः” |<br><b>उल्लेखाः - </b>भाग० स्क० ४-५-२१ ।<br><b>विस्तारः - </b>[ದಕ್ಷಯಜ್ಞಸಮಯದಲ್ಲಿ ಸೂರ್ಯನ ದಂತ(ಹಲ್ಲು)ಗಳನ್ನು ಉದುರಿಸಿದನು.]<br><br>अदन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಗಣೆ<br><br>अदन्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೀರುವವನು<br><br>अदन्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಂತವಿಲ್ಲದ / ಹಲ್ಲುಗಳಿಲ್ಲದ<br><br>अदन्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಲ್ಲು ಹುಟ್ಟದಿರುವ<br><br>अदन्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕಾರಾಂತ (ಶಬ್ದ ಮುಂತಾದುದು)<br><b>व्युत्पत्तिः - </b>अत् अन्ते यस्य ।<br><br>

अदभ्र
अदभ्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾದ / ಬಹಳ<br><b>व्युत्पत्तिः - </b>न दभ्रः ।<br><b>प्रयोगाः - </b>1. “अदभ्रदर्भामधिशय्य स स्थलीम्” | 2. “अदभ्रसत्राजितभ्कतियन्त्रितः” |<br><b>उल्लेखाः - </b>1. किरा० १-३८ । 2. याद० १४-१ ।<br><br>

अदम्भ
अदम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಯಸಂಧತೆ / ಪ್ರಾಮಾಣಿಕತೆ / ಕಪಟವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न दम्भः ।<br><br>अदम्भ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಟವಿಲ್ಲದವನು / ಸತ್ಯಸಂಧ / ಪ್ರಾಮಾಣಿಕ<br><br>

अदम्य
अदम्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಡಗಿಸಲು ಶಕ್ಯವಲ್ಲದ<br><b>निष्पत्तिः - </b>दमु (उपशमे) “यत्” (३-१-९८) ।<br><b>व्युत्पत्तिः - </b>न दम्यते |<br><br>

अदय
अदय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯೆಯಿಲ್ಲದ / ಕರುಣೆಯಿಲ್ಲದ / ಕನಿಕರವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति दया यस्य ।<br><br>अदय<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ದಯೆಯಿಲ್ಲದೆ / ಕನಿಕರವಿಲ್ಲದೆ<br><b>प्रयोगाः - </b>“अदयमिव कराग्रैरेष निष्पीड्य सद्यः” |<br><b>उल्लेखाः - </b>माघ० ११-६२ ।<br><br>

अदर्शन
अदर्शन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದರ್ಶನಾಭಾವ / ನೋಡದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न दर्शनम् ।<br><b>प्रयोगाः - </b>“अदर्शनेच्छामितरेषु दत्ते” |<br><b>उल्लेखाः - </b>याद० १८-९३ ।<br><br>अदर्शन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೋಪ / ವಿನಾಶ<br><br>अदर्शन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತರ್ಧಾನ / ಮರೆಯಾಗುವಿಕೆ<br><br>अदर्शन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೃಷ್ಟಿಗೆ ಗೋಚರವಾಗದ / ಕಣ್ಣಿಗೆ ಕಾಣಿಸದ<br><br>अदर्शन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೇತ್ರವಿಲ್ಲದ / ಕಣ್ಣಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति दर्शनं यस्य ।<br><br>

अदस्
अदस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇವನು, ಇವಳು, ಇದು.<br><b>प्रयोगाः - </b>1. “असावहङ्कारपरैर्दुरात्मभिः” | 2. “असौ पुनः विषमरचितैकभागां तामेव बहुमन्यमाना प्रतिगृहीतवती” | 3. “अदस्त्वया नुत्तमनुत्तमं तमः” |<br><b>उल्लेखाः - </b>1. प्रबोध० १-२४ । 2. मालती० १ । 3. माघ० १-२७ ।<br><b>विस्तारः - </b>ಈ ಶಬ್ದವು ದೂರದಲ್ಲಿರುವ ಮನುಷ್ಯನಲ್ಲಿ ಅಥವಾ ವಸ್ತುವಿನಲ್ಲಿ ಪ್ರಯೋಗಿಸಲ್ಪಡುವುದು. (पु०) असौ (स्त्री०) असौ (न०) अदः । “इदमस्तु सन्निकृष्टं समीपतरवर्तिचैददो रूपम् । अदसस्तु विप्रकृष्टं तदिति परोक्षे विजानीयात्” । ಕ್ರಮವಾಗಿ… ಕೆಲವು ಕಡೆ ಈ ಶಬ್ದಕ್ಕೆ ಸನ್ನಿಕೃಷ್ಟಾರ್ಥದಲ್ಲಿಯೂ ಪ್ರಯೋಗವುಂಟು. “अमी पुरः पश्यसि देवदारुम्” रघु० २-३६ । “प्राप्ता शुकश्रेणिरसौ विभाति” याद० १८-७६ । “तद्” ಶಬ್ದದಂತೆ “अदस्” ಶಬ್ದವೂ “यद्” ಶಬ್ದದ ಅರ್ಥವನ್ನು ಪೂರ್ತಿಗೊಳಿಸುವುದು. “य एष लोकत्रयसूत्रधारः पर्यायपात्राणि चराचराणि । आनर्तयत्यद्भुतचेष्टितोऽसौ ननतं खेलं नवनीतकाङ्क्षी” याद० ४-२७ । “यस्य त्वं यश्च हृद्यस्ते यस्यासौ तस्य यस्तथा । नाथ त्वत्पदमारुह्य न पुनस्तैर्निवर्त्यते” याद० १६-११९ । “तद्” ಶಬ್ದದಂತೆ “अदस्” ಶಬ್ದಕ್ಕೂ ಪ್ರಸಿದ್ಧಾರ್ಥದಲ್ಲಿ ಪ್ರಯೋಗವುಂಟು. “योऽप्यसौ कुमारसेवको राजसेनः सोऽपि तव प्रसादात्” मुद्रा० ३ ।<br><br>

अदातृ
अदातृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾನಮಾಡದ<br><br>

अदात्री
अदात्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಾನಮಾಡದ<br><b>निष्पत्तिः - </b>स्त्रियाम् “डीप्” (४-१-६) ।<br><br>

अदान
अदान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದೋದಕವಿಲ್ಲದ ಆನೆ<br><b>व्युत्पत्तिः - </b>न दानं यस्य ।<br><br>अदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಾನದ ಅಭಾವ / ದಾನಮಾಡದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न दानम् ।<br><br>अदान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾನವಿಲ್ಲದ<br><br>

अदान्त
अदान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯನಿಗ್ರಹವಿಲ್ಲದ / ಇಂದ್ರಿಯಗಳನ್ನು ಜಯಿಸದ<br><b>व्युत्पत्तिः - </b>न दान्तः ।<br><br>

अदाय
अदाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಾಯಕ್ಕೆ ಯೋಗ್ಯನಲ್ಲದವನು / ಆಸ್ತಿಯ ಭಾಗಕ್ಕೆ ಅರ್ಹನಲ್ಲದವನು / ಪತಿತನಾದ ಜ್ಞಾತಿ<br><b>व्युत्पत्तिः - </b>नास्ति दायो यस्य ।<br><b>विस्तारः - </b>“अदायाद” ಪದದಲ್ಲಿ ನೋಡಿ.<br><br>

अदायाद
अदायाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಂದೆಯ ಆಸ್ತಿಯಲ್ಲಿ ಭಾಗಹೊಂದಲು ಅರ್ಹರಲ್ಲದವರು<br><b>प्रयोगाः - </b>“अनंशौ क्लीबपतितौ जात्यन्धबधिरौ तथा । उन्मत्तजडमूकाश्च ये च केचिन्निरिन्द्रियाः” |<br><b>उल्लेखाः - </b>मनु० ९-२०१ ।<br><b>विस्तारः - </b>(1) ಪತಿತಜ್ಞಾತಿ (2) ಕ್ಲೀಬ, ಷಂಡ, ನಪುಂಸಕ (3) ಜನ್ಮವ್ಯಾಧಿಯಿಂದ ಕೂಡಿದ ಮಕ್ಕಳು (4) ಉನ್ಮತ್ತ (ಹುಚ್ಚ) (5) ಜಡ (6) ಮೂಗ ಮತ್ತು (7) ಅಂಗಹೀನರು.<br><br>अदायाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹನ್ನೆರಡು ವಿಧ ಪುತ್ರರಲ್ಲಿ ಆರು ವಿಧ ಪುತ್ರರು<br><b>प्रयोगाः - </b>“कानीनश्च सहोढश्च क्रीतः पौनर्भवस्तथा । स्वयन्दत्तश्च शौद्रश्च षडदायादबान्धवाः” |<br><b>उल्लेखाः - </b>मनु० ९-१६० ।<br><br>

अदायिक
अदायिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾಯಾದರಿಲ್ಲದ / ಜ್ಞಾತಿಗಳಿಲ್ಲದ<br><b>निष्पत्तिः - </b>दाय “ठक्” (५-१-६३) ।<br><b>व्युत्पत्तिः - </b>दायमर्हति । नादायिको यस्य ।<br><br>

अदास
अदास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವತಂತ್ರ<br><br>

अदास्य
अदास्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಾತಂತ್ರ್ಯ<br><br>

अदाह्य
अदाह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಹಿಸಲು ಅಶಕ್ಯ (ಆತ್ಮ)<br><b>व्युत्पत्तिः - </b>न दग्धुं शक्यः ।<br><b>प्रयोगाः - </b>“अच्छेद्योऽयमदाह्योऽयमक्लेद्योऽशेष्य एव च” |<br><b>उल्लेखाः - </b>गीता २-२४ ।<br><br>अदाह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಹಿಸಲು ಅನರ್ಹ / ಪತಿತ<br><b>व्युत्पत्तिः - </b>न दग्धुमर्हः ।<br><br>

अदिति
अदिति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><br>अदिति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೃತ್ಯು<br><br>अदिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅದಿತಿದೇವಿ / ದೇವತೆಗಳ ತಾಯಿ / ದಕ್ಷಬ್ರಹ್ಮನ ಮಗಳು<br><br>अदिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೃಥ್ವಿ / ಭೂಮಿ<br><b>निष्पत्तिः - </b>दो (अवखण्डने) क्तिच्” (३-३-१७४) । इत्वम् (७-४-४०) ।<br><b>व्युत्पत्तिः - </b>न दीयते खण्ड्यते | दितिभिन्ना अदितिः ।<br><b>विस्तारः - </b>“अदितिः शैलकन्यायां पृथिव्यां देवमातरि” - वैज० ।<br><br>

अदितिज
अदितिज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) “डः” (३-२-९८) ।<br><b>व्युत्पत्तिः - </b>अदितेर्जायते |<br><br>

अदितिनन्दन
अदितिनन्दन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><br>

अदितिपुत्र
अदितिपुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><br>

अदीन
अदीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧೈರ್ಯಗೆಡದ / ಹೆದರದ<br><br>अदीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧನಿಕ / ಸಿರಿವಂತ<br><br>अदीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಲಶಾಲಿ / ಪರಾಕ್ರಮಿ<br><br>

अदीपित
अदीपित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಗೊಳಿಸಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न दीपितम् ।<br><b>प्रयोगाः - </b>“अदीपितं वैद्युतजातवेदसा” |<br><b>उल्लेखाः - </b>किरा० ४-२९ ।<br><br>

अदीयमान
अदीयमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಡಲ್ಪಡದ<br><b>निष्पत्तिः - </b>डु दाञ् (दाने) “शानच्” (३-२-१२४) ।<br><b>व्युत्पत्तिः - </b>न दीयते |<br><br>

अदूर
अदूर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪ<br><b>व्युत्पत्तिः - </b>न दूरम् |<br><b>प्रयोगाः - </b>“परस्पराक्षिसादृश्यमद्गरोज्झितवर्त्मसु” |<br><b>उल्लेखाः - </b>रघु १-४- ।<br><br>अदूर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದ<br><br>

अदृश्
अदृश्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುರುಡ / ಕಣ್ಣಿಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>नास्ति दृक् यस्य ।<br><br>अदृश्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡದಿರುವ<br><br>

अदृश्य
अदृश्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><b>प्रयोगाः - </b>“अदृश्योऽव्यक्तरूपश्च सहस्रजिदनन्तजित्” |<br><b>उल्लेखाः - </b>वि० स० ।<br><br>अदृश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗೋಚರ / ಕಣ್ಣಿಗೆ ಕಾಣಿಸದ<br><b>व्युत्पत्तिः - </b>न दृश्यम् ।<br><b>प्रयोगाः - </b>“अदृश्यं मन्दपुण्यानाममन्दप्रीतिदायिनाम्” |<br><b>उल्लेखाः - </b>याद० १६-३ ।<br><br>

अदृष्ट
अदृष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣಿಗೆ ಕಾಣಿಸದಿರುವುದು / ದೈವಕೃತವಾದದ್ದು / ಪುಣ್ಯಪಾಪಗಳು / ವಿಧಿ / ಹಣೆಬರಹ<br><br>अदृष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಕಿ, ನೀರು ಮೊದಲಾದುವುಗಳ ಭಯ<br><b>विस्तारः - </b>”अदृष्टं वह्नितोयादि (भयम्)” - अम० ।<br><br>अदृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಣಲ್ಪಡದ / ತಿಳಿಯಲ್ಪಡದ<br><br>

अदृष्टपूर्व
अदृष्टपूर्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂದೆ ನೋಡದಿರುವ<br><b>व्युत्पत्तिः - </b>न पूर्व दृष्टः ।<br><b>प्रयोगाः - </b>1. “अदृष्टपूर्व हृपितोऽस्मि दृष्ट्वा” | 2. “अदृष्टपूर्वं भुवि पूतनादे” |<br><b>उल्लेखाः - </b>1. गीता ११-४५ । 2. याद० ४-३९ ।<br><br>

अदृष्टान्त
अदृष्टान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊನೆ ಕಾಣಿಸದಿರುವ / ಬಹಳ ದೂರದ / ಬಹಳ ಕಾಲದ<br><b>व्युत्पत्तिः - </b>न दृष्टः अन्तः यस्य ।<br><b>प्रयोगाः - </b>“अदृष्टान्तमभूद्युद्धम्” |<br><b>उल्लेखाः - </b>याद० १६-१०१ ।<br><br>

अदृष्टि
अदृष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರೂರವಾದ ನೋಟ<br><br>अदृष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪದ ನೋಟ<br><br>अदृष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೋಡದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न दृष्टिः । विरोधे अभावे वा न० त० ।<br><br>अदृष्टि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಣ್ಣಿಲ್ಲದ / ಕುರುಡ<br><br>

अदेय
अदेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಡಲು ಯೋಗ್ಯವಲ್ಲದ / ಕೊಡತಕ್ಕುದಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न दातुं योग्यम् ।<br><b>प्रयोगाः - </b>“अदेयमासीत् त्रयमेव भूपतेः शशिप्रभं छत्रमुभे च चामरे” |<br><b>उल्लेखाः - </b>रघु० ३-२६ ।<br><b>विस्तारः - </b>ದಾನಮಾಡಲು ಯೋಗ್ಯವಲ್ಲದವು: ಪತ್ನಿ, ಪುತ್ರ, ನಿಕ್ಷೇಪ, ಹೋಮಾಗ್ನಿ ಮುಂತಾದುವು. ಇವನ್ನು ಎಂತಹ ಕಷ್ಟಕಾಲದಲ್ಲಿಯೂ ಇತರರಿಗೆ ದಾನಮಾಡಕೂಡದು.<br><br>

अदेव
अदेव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೇವತೆಗಳಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न० व० ।<br><br>अदेव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೇವತೆಗಳಂತಿರುವ<br><b>व्युत्पत्तिः - </b>न देवः । सादृश्ये न० त० ।<br><br>

अदेवमातृक
अदेवमातृक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಳೆಯ ನೀರೇ ಆಧಾರವಾಗಿಲ್ಲದ ಪ್ರದೇಶ / ನದಿಯ ನೀರಿನ ಆಸರೆಯಿಂದ ಬೆಳೆಯುವ ಪ್ರದೇಶ<br><b>व्युत्पत्तिः - </b>देव एव माता यस्य सः देवमातृकः, स न भवतीत्यदेवमातृकः ।<br><b>प्रयोगाः - </b>“वितन्वति क्षेममदेवमातृकाश्चिराय तस्मिन् कुरवश्चकासति” |<br><b>उल्लेखाः - </b>किरा० १-१७ ।<br><br>

अदेश
अदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟಜಾಗ<br><br>अदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶುದ್ಧ ಪ್ರದೇಶ<br><b>प्रयोगाः - </b>“नादेशे तर्पणं कुर्यात् न सन्ध्यां नापि पूजनम्” |<br><b>उल्लेखाः - </b>स्मृतिः ।<br><b>विस्तारः - </b>ಚಾತುರ್ವರ್ಣ್ಯವ್ಯವಸ್ಥೆಯಿಲ್ಲದ ದೇಶವು ವಾಸಕ್ಕೆ ಅಯೋಗ್ಯವು.<br><br>

अदैव
अदैव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆಯಿಲ್ಲದ ಶ್ರಾದ್ಧ / ನಿತ್ಯಶ್ರಾದ್ಧ<br><b>व्युत्पत्तिः - </b>दैवं वैश्वदैविकं श्राद्धम्; तन्नास्ति यत्र ।<br><br>अदैव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅದೃಷ್ಟಶೂನ್ಯ<br><br>

अदोष
अदोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೋಷಾಭಾವ / ದೋಷವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न दोषः ।<br><b>प्रयोगाः - </b>“किमित्यदोषेण तिरस्कृता वयम्” |<br><b>उल्लेखाः - </b>किरा० १४-११ ।<br><br>अदोष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೋಷವಿಲ್ಲದ<br><b>प्रयोगाः - </b>“तददोषौ शब्दार्थौ सगुणावनलङ्कृती पुनः क्वापि” |<br><b>उल्लेखाः - </b>काव्यप्र० १ ।<br><br>

अद्ग
अद्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುರೋಡಾಶ / ಹವಿಸ್ಸು<br><b>निष्पत्तिः - </b>अद (बक्षणे) “गन्” (उ० १-१२०) ।<br><b>व्युत्पत्तिः - </b>अद्यते देवैः |<br><br>

अद्धा
अद्धा<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಸತ್ಯ / ನಿಜ<br><b>निष्पत्तिः - </b>डु धाञ् (धारणपोषणयोः) “विच्” (३-२-१५) ।<br><b>व्युत्पत्तिः - </b>अतं सततगमनं दधाति |<br><b>प्रयोगाः - </b>“अद्धा श्रियं पालितसङ्गराय” |<br><b>उल्लेखाः - </b>रघु० १३-६५ ।<br><br>

अद्भुत
अद्भुत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ಚರ್ಯ / ವಿಸ್ಮಯ<br><b>निष्पत्तिः - </b>अद्+भू (सत्तायाम्) “डुतच्” (उ० ५-१) ।<br><b>व्युत्पत्तिः - </b>अद् (आश्चर्येऽव्ययम्) तस्य भवनम् ।<br><b>प्रयोगाः - </b>“तर्कातिगं तादृशमद्भुतं नः” |<br><b>उल्लेखाः - </b>याद० २-२२ ।<br><br>अद्भुत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅದ್ಭುತರಸ / ನವರಸಗಳಲ್ಲೊಂದು<br><b>विस्तारः - </b>ಅದ್ಭುತರಸಕ್ಕೆ ಸ್ಥಾಯಿಭಾವ ವಿಸ್ಮಯ. ಇದು ಗಂಧರ್ವ ದೇವತಾಕವಾದುದು. ಬಣ್ಣ ಹಳದಿ. ಆಶ್ಚರ್ಯಕರವಾದ ಕೆಲಸವು ಉದ್ದೀಪನ ವಿಭಾವ. ಚಕಿತ, ಸ್ವೇದ, ರೋಮಾಂಚ, ಗದ್ಗದಸ್ವರ, ನೇತ್ರವಿಕಾಸ ಮುಂತಾದುವು ವ್ಯಭಿಚಾರಿಭಾವ. ಈ ವಿಭಾವಾನುಭಾವ ವ್ಯಭಿಚಾರಿಭಾವಗಳಿಂದ ಕೂಡಿದ ಸ್ಥಾಯಿಭಾವ (ವಿಸ್ಮಯ)ವು ಅದ್ಭುತ ರಸತ್ವವನ್ನು ಹೊಂದುವುದು. सा० द० ३-२४२-४५ ।<br><br>अद्भुत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೈಶ್ವದೇವದ ಅಗ್ನಿ<br><b>विस्तारः - </b>“महिमांस्तु विवाहाग्निवैश्वदेवाग्निरद्भुतः” - वैज० ।<br><br>अद्भुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ಚರ್ಯಕರವಾದ<br><br>

अद्मनि
अद्मनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ / ಬೆಂಕಿ<br><b>निष्पत्तिः - </b>अद (भक्षणे) “अनिः” मुट् च (उ० २-१०४) ।<br><b>व्युत्पत्तिः - </b>अत्ति सर्वान् |<br><br>

अद्मर
अद्मर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಂಡಿಬಾಕ / ಯಾವಾಗಲೂ ತಿನ್ನುವ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>अद (भक्षणे) “क्मरच्” (३-२-१६०) ।<br><b>व्युत्पत्तिः - </b>अत्ति |<br><br>

अद्य
अद्य<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಈಗ / ಈ ದಿನ<br><b>निष्पत्तिः - </b>इदम् “द्यः” अश् च निपा० (५-३-२२)।<br><b>व्युत्पत्तिः - </b>इदम् |<br><b>प्रयोगाः - </b>1. “अद्य क्रियाः कामदुघाः अतूनाम्” | 2. “कृष्ण त्वदीयपदपङ्कजपञ्जरान्तमद्यैव मे विशतु” |<br><b>उल्लेखाः - </b>1. किरा० ३-६ । 2. मु० मा० ।<br><br>

अद्यतन
अद्यतन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈ ದಿನ / ಈಗಿನ ಕಾಲ<br><br>अद्यतन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈಗಿನಕಾಲದ / ಈಗ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>अद्य भवः “ट्युः” (४-३-२३) ।<br><b>व्युत्पत्तिः - </b>अद्य भवः |<br><br>

अद्यश्वीन
अद्यश्वीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈ ದಿನವೋ ಅಥವಾ ನಾಳೆಯೋ ಆಗಬಹುದಾದ<br><b>निष्पत्तिः - </b>अद्य-श्वस् “खः” (५-२-१३) ।<br><br>

अद्यश्वीना
अद्यश्वीना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಈ ದಿನವೋ ನಾಳೆಯೋ ಪ್ರಸವಿಸಬಹುದಾದ ಹೆಂಗಸು / ಪೂರ್ಣಗರ್ಭಿಣಿ<br><b>विस्तारः - </b>“अद्यश्वीना तु सा या स्यादद्यश्वः प्रसयोन्मुखी” - वैज० ।<br><br>

अद्यापि
अद्यापि<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಈಗಲೂ ಕೂಡ<br><b>प्रयोगाः - </b>“पसृप्य पुरोभागादद्यापि न निवर्तते” |<br><b>उल्लेखाः - </b>याद० १६-३६ ।<br><br>

अद्रव
अद्रव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದ್ರವವಲ್ಲದ / ಗಟ್ಟಿಯಾದ<br><b>व्युत्पत्तिः - </b>नास्ति द्रवो यस्मिन् ।<br><b>विस्तारः - </b>“अद्रवं मूर्तिमत्स्वाङ्गम्” - सि० कौ० ।<br><br>

अद्रव्य
अद्रव्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯವಸ್ತು / ಗುಣಹೀನ / ಕೆಲಸಕ್ಕೆ ಬಾರದ ಪದಾರ್ಥ<br><b>व्युत्पत्तिः - </b>न द्रव्यम् । अप्राशस्त्ये न० त० ।<br><b>प्रयोगाः - </b>“विनेतुरद्रव्यपरिग्रह एव बुद्धिलाघवं प्रकाशयति” |<br><b>उल्लेखाः - </b>माल० १ ।<br><br>अद्रव्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ತ್ವ ಮೊದಲಾದ ಹತ್ತು ಗುಣಗಳು<br><b>विस्तारः - </b>ಇವು ಸತ್ತ್ವ, ರಜಸ್ಸು, ತಮಸ್ಸು, ಶಬ್ದ, ಸ್ಪರ್ಶ, ರೂಪ, ರಸ, ಗಂಧ, ಸಂಯೋಗ ಮತ್ತು ಶಕ್ತಿಗಳೆಂದು ಹತ್ತು ಬಗೆ.<br><br>

अद्रि
अद्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತ / ಬೆಟ್ಟ<br><b>निष्पत्तिः - </b>अद (भक्षणे) “क्रिन्” (उ० ४-६५) ।<br><b>प्रयोगाः - </b>“तस्मिन्नद्रौ कतिचिदबलाविप्रयुक्तः स कामी” |<br><b>उल्लेखाः - </b>मेघ० १-२ ।<br><br>अद्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಡೆ / ದೊಡ್ಡ ಕಲ್ಲು<br><br>अद्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>अद्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಕ್ಷ / ಮರ<br><b>विस्तारः - </b>“अद्रिः शैलद्रुमार्के ना” - मेदि० ।<br><br>अद्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ / ಮೋಡ<br><br>अद्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಪ್ತಸಂಖ್ಯೆ / ಏಳು<br><br>अद्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೋಮಲತೆಯನ್ನು ಅರೆಯುವ ಕಲ್ಲು<br><br>

अद्रिकन्या
अद्रिकन्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತರಾಜನ ಮಗಳು / ಪಾರ್ವತಿ<br><br>

अद्रिसुता
अद्रिसुता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತರಾಜನ ಮಗಳು / ಪಾರ್ವತಿ<br><br>

अद्रितनया
अद्रितनया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತರಾಜನ ಮಗಳು / ಪಾರ್ವತಿ<br><br>

अद्रिकर्णी
अद्रिकर्णी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣುಕ್ರಾಂತಿಗಿಡ<br><br>

अद्रिकील
अद्रिकील<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಕಂಭಪರ್ವತ<br><br>अद्रिकील<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿ<br><b>व्युत्पत्तिः - </b>अद्रयः कुलपर्वताः कीला इव यस्याः ।<br><br>

अद्रिज
अद्रिज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಾವಾನಲ / ಕಾಳ್ಕಿಚ್ಚು<br><br>अद्रिज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><br>अद्रिज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಲಾಜತು<br><br>अद्रिज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆಟ್ಟದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) “डः” (३-२-९७) ।<br><b>व्युत्पत्तिः - </b>अद्रौ जायते |<br><br>अद्रिज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನಿಂದ ಹುಟ್ಟಿದ<br><br>

अद्रिजा
अद्रिजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರ್ವತಿ<br><b>व्युत्पत्तिः - </b>अद्रि जाता |<br><br>

अद्रिद्विष्
अद्रिद्विष्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><b>निष्पत्तिः - </b>द्विष (अप्रीतौ) “क्विप्” (३-२-६१) ।<br><b>व्युत्पत्तिः - </b>अद्रिं द्वेष्टि |<br><br>

अद्रिद्रोणि
अद्रिद्रोणि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಿರಿನದಿ / ಬೆಟ್ಟದಲ್ಲಿ ಹುಟ್ಟಿದ ನದಿ<br><b>व्युत्पत्तिः - </b>अद्रेः द्रोणिरिव ।<br><br>अद्रिद्रोणि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣಿವೆ<br><br>

अद्रिपति
अद्रिपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತರಾಜ / ಹಿಮಾಚಲ<br><b>निष्पत्तिः - </b>अद्रि+राजन् “टच्” (५-४-९१) ।<br><b>व्युत्पत्तिः - </b>अद्रीणां पतिः राजा वा । अद्रिराज|<br><b>प्रयोगाः - </b>“सनिर्झरोद्गार इवाद्रिराजः” |<br><b>उल्लेखाः - </b>रघु० ६-६० ।<br><br>

अद्रिभिद्
अद्रिभिद्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>(ಪರ್ವತಗಳ ರೆಕ್ಕೆಗಳನ್ನು ಕತ್ತರಿಸಿದ) ಇಂದ್ರ<br><b>निष्पत्तिः - </b>भिदिर् (विदारणे) “क्विप्” (३-२-६१) ।<br><b>व्युत्पत्तिः - </b>अर्द्रि भिनत्ति |<br><br>

अद्रिभू
अद्रिभू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರ್ವತಿ<br><b>निष्पत्तिः - </b>भू (सत्तायाम्) “क्विप्” (३-२-१७१) ।<br><b>व्युत्पत्तिः - </b>अद्रेर्भवति |<br><br>अद्रिभू<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರ್ವತದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>भू “क्विप्” ।<br><b>व्युत्पत्तिः - </b>अद्रौ भवति |<br><br>

अद्रिषुत
अद्रिषुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೋಮರಸ<br><b>व्युत्पत्तिः - </b>अद्रिभिः ग्रावभिः सुतः अभिषुतः ।<br><br>

अद्रिसार
अद्रिसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣ<br><br>अद्रिसार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆಟ್ಟದಂತೆ ಬಹಳ ಕಠಿನವಾದ<br><br>

अद्रिसारमय
अद्रिसारमय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣದಿಂದ ತಯಾರಾದ<br><br>अद्रिसारमय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಕಠಿನವಾದ<br><br>

अद्रीन्द्र
अद्रीन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತರಾಜ / ಹಿಮಾಚಲ<br><br>अद्रीन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಲಾಸಧಿಪತಿ / ಈಶ್ವರ<br><br>अद्रीन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತ ಶ್ರೇಷ್ಠ<br><br>

अद्रोह
अद्रोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ರೋಹಾಭಾವ / ವಂಚನೆಯಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न द्रोहः ।<br><br>

अद्वन्द्व
अद्वन्द्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದ್ವಂದ್ವಗಳಿಲ್ಲದ / ದ್ವಂದ್ವಗಳನ್ನು ಮೀರಿದ<br><b>विस्तारः - </b>[ಸುಖದುಃಖ, ರಾಗದ್ವೇಷ, ಶೀತ ಉಷ್ಣ ಮುಂತಾದುವು ದ್ವಂದ್ವಗಳು.]<br><br>

अद्वय
अद्वय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧದೇವ<br><br>अद्वय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೀವಾತ್ಮ ಮತ್ತು ಪರಮಾತ್ಮರ ಐಕ್ಯಜ್ಞಾನವುಳ್ಳವನು / ಅದ್ವೈತಿ<br><b>व्युत्पत्तिः - </b>नास्ति द्वयं यस्य ।<br><br>अद्वय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎರಡಿಲ್ಲದಿರುವಿಕೆ / ಅಭೇದ<br><br>अद्वय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಾತ್ಮೈಕ್ಯ ಜ್ಞಾನ / ಅದ್ವೈತ<br><br>

अद्वयवादिन्
अद्वयवादिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧದೇವ<br><b>निष्पत्तिः - </b>वद (व्याक्तायां वाचि) “णिनिः” (३-३-१७०) ।<br><b>व्युत्पत्तिः - </b>अद्वयं वदति |<br><br>अद्वयवादिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಾತ್ಮೈಕವಾದಿ / ಅದ್ವೈತಿ<br><br>

अद्वार
अद्वार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಪ್ತಮಾರ್ಗ / ರಹಸ್ಯದ ದಾರಿ / ಎಲ್ಲರ ಸಂಚಾರಕ್ಕೆ ಏರ್ಪಡದ ದಾರಿ<br><br>अद्वार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಚಾರಕ್ಕೆ ಅನರ್ಹವಾದ ದಾರಿ<br><b>प्रयोगाः - </b>“अद्वारेण महाबाहुः प्राकारमभिपुप्लुवे” |<br><b>उल्लेखाः - </b>रामा० ।<br><br>

अद्वितीय
अद्वितीय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪತ್ನಿಯಿಲ್ಲದವನು / ವಿಧುರ<br><b>व्युत्पत्तिः - </b>न द्वितीया यस्य ।<br><br>अद्वितीय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಬ್ರಹ್ಮ / ಪರಮಾತ್ಮ / ಸಜಾತೀಯ ವಿಜಾತೀಯ ಭೇದಶೂನ್ಯ<br><b>व्युत्पत्तिः - </b>न द्वितीयं यस्य ।<br><b>प्रयोगाः - </b>“एकमेवाद्वितीयं ब्रह्म” ।<br><br>अद्वितीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾನವಿಲ್ಲದ<br><br>अद्वितीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೊತೆಗಾರನಿಲ್ಲದ / ಅಸಹಾಯ<br><br>

अद्वेष
अद्वेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ವೇಷವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न द्वेषः ।<br><br>अद्वेष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದ್ವೇಷವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न द्वेषो यस्य ।<br><br>

अद्वैत
अद्वैत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭೇದ<br><b>व्युत्पत्तिः - </b>द्विधा इतम् द्वीतम् । द्वीतमेव द्वैतं भेदः । न० त० ।<br><b>प्रयोगाः - </b>“अद्वैतं सुखदुःखयोरनुगतं सर्वास्ववस्थासु यत्” |<br><b>उल्लेखाः - </b>उ० रा० १-३९ ।<br><br>अद्वैत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ / ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>नास्ति द्वैतं भेदो यत्र । द्वे इते गते यस्मात् तद्द्वीतम् । द्वीतमेव द्वैतम् । न द्वैतं यस्य वा । सुखदुःखादिवर्जितम् ।<br><br>अद्वैत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೇದವಿಲ್ಲದ<br><br>

अद्वैतदर्शन
अद्वैतदर्शन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಸ್ತಿಕ ದರ್ಶನಗಳಲ್ಲೊಂದಾದ ವೇದಾಂತ ದರ್ಶನದ ಒಂದು ಭೇದ / ಜೀವನಿಗೂ ಈಶ್ವರನಿಗೂ ಅಬೇದವನ್ನು ಹೇಳುವ ಶ್ರೀ ಶಂಕರಾಚಾರ್ಯರ ಸಿದ್ಧಾಂತ<br><b>व्युत्पत्तिः - </b>द्विधा इतं द्वीतम् । द्वीतमेव द्वैतं भेदः । न द्वैतम् अद्वैतम् । तत्प्रतिपादकं दर्शनम् ।<br><b>प्रयोगाः - </b>1. “मायामात्रमिदं द्वैतमद्वैतं परमार्थतः” | 2. “अहं ब्रह्मास्मि” । “अयमात्मा ब्रह्म” । “सर्वं खल्वितं ब्रह्म” । “नेह नानास्ति” । “नेति नेति” । 3. . “तमेतमविद्याख्यमात्मानात्मनोरितरेतराध्यासं पुरस्कृत्य सर्वे प्रमाणप्रमेयव्यवहाराः लौकिक् वैदिकाश्च प्रवृत्ताः, सर्वाणि च शास्त्राणि विधिप्रतिषेधमोक्षपर्णि” |<br><b>उल्लेखाः - </b>1. माण्डूक्य० । 3. अध्यासभाष्यम् ।<br><b>विस्तारः - </b>ಅದ್ವೈತದರ್ಶನದ ಸ್ವರೂಪ: ಜೀವ-ಈಶ್ವರ ಜಡ-ಈಶ್ವರ ಜೀವ-ಜಡವಸ್ತು ಈ ರೀತಿ ಪರಸ್ಪರ ಭೇದವನ್ನು ಹೇಳುವುದು ದ್ವೈತವು. ಇವುಗಳಿಗೆ ಪರಸ್ಪರ ಭೇದವಿಲ್ಲದಿರುವುದೇ ಅದ್ವೈತವು.<br><br>

अद्वैतवादिन्
अद्वैतवादिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಾತ್ಮೈಕ್ಯವಾದಿ<br><br>अद्वैतवादिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧದೇವ<br><br>

अधःकरण
अधःकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರ<br><br>अधःकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಡಿಮೆ ಮಾಡುವುದು<br><br>अधःकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಗೆ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) “ल्युट्” (३-३-११५) ।<br><b>व्युत्पत्तिः - </b>अधः करणम् |<br><br>

अधःकाय
अधःकाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶರೀರದ ಕೆಳಭಾಗ / ಹೊಕ್ಕಳಿನ ಕೆಳಪ್ರದೇಶ<br><b>व्युत्पत्तिः - </b>अधः अधरं कायस्य ।<br><br>

अधःकार
अधःकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಡಿಮೆ ಮಾಡುವುದು<br><br>अधःकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಗೆ ಮಾಡುವುದು<br><br>अधःकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರ<br><b>निष्पत्तिः - </b>डु कृञ् (करणे) “घञ्” (३-३-१८) ।<br><b>व्युत्पत्तिः - </b>अधः करणम् |<br><br>

अधःक्रिया
अधःक्रिया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಮಾನ / ತಿರಸ್ಕಾರ<br><b>प्रयोगाः - </b>“सहते न जनोऽप्यधःक्रियाम्” |<br><b>उल्लेखाः - </b>किरा० २-४७ ।<br><br>

अधःक्षिप्त
अधःक्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಗೆ ಇಡಲ್ಪಟ್ಟ<br><br>अधःक्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಮುಖವಾಗಿ ಇಡಲ್ಪಟ್ಟ / ಬಗ್ಗಿಸಿಡಲ್ಪಟ್ಟ<br><br>

अधःपुष्टी
अधःपुष्टी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಡೇಗಿಡ<br><br>अधःपुष्टी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡು ಸಬ್ಬಸಿಗೆಗಿಡ<br><br>

अधःशय्या
अधःशय्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಗೆ ಮಲಗುವುದು / ಹಾಸಿಗೆಯಿಲ್ಲದೆ ಭೂಮಿಯ ಮೇಲೆ ಮಲಗುವುದು<br><br>

अधन
अधन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧನವಿಲ್ಲದ / ದರಿದ್ರ / ಬಡವ<br><b>व्युत्पत्तिः - </b>नास्ति धनं यस्य ।<br><b>प्रयोगाः - </b>“अधनो हि धनं लब्ध्वा तृणवन्मन्यते जगत्” । “अधनोऽयं धनं लब्ध्वा माड्यन्नुच्चैनं मां स्मरेत् । इति काऋणिको नूनं धनं मे भूरि नाददात्” |<br><b>उल्लेखाः - </b>भाग० १०-८१-२० ।<br><br>

अधन्य
अधन्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೀನ / ನಿರ್ಗತಿಕ<br><br>अधन्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲ್ಮೆಪಡೆಯದ / ಪುಣ್ಯಮಾಡದ<br><b>प्रयोगाः - </b>“हन्त षिङ् मामधन्यम्” |<br><b>उल्लेखाः - </b>उ० रा० १-४२ ।<br><br>

अधम
अधम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದ್ಯ / ಬಹಳ ಕೆಳದರ್ಜೆಯ / ಕೆಟ್ಟ<br><b>निष्पत्तिः - </b>अव “अमः” (उ० ५-५४) ।<br><b>व्युत्पत्तिः - </b>अवत्यस्मादात्मानम् |<br><br>

अधमभृतक
अधमभृतक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಳು / ಚಾಕರ / ಹೊರೆಹೊರುವ ಕೂಲಿಯವನು<br><b>व्युत्पत्तिः - </b>अधमश्चासौ भ्रुतकश्च ।<br><b>विस्तारः - </b>“उत्तमस्त्वायुधोपेतः मध्यमस्तु कृषीवलः । अधमो भारवाही स्यादित्येवं त्रिविधो भृतः” ಎಂದು ಭೃತ್ಯನು ಮೂರು ಬಗೆ.<br><br>

अधमर्ण
अधमर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಲಗಾರ / ಸಾಲ ತೆಗೆದವನು<br><b>व्युत्पत्तिः - </b>अधम ऋणं यस्य ।<br><b>विस्तारः - </b>“उत्तमर्णाधमर्णौ द्वौ प्रयोक्तृग्राहकौ क्रमात्” - अम० ।<br><br>

अधमर्णिक
अधमर्णिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಲಗಾರ / ಸಾಲ ತೆಗೆದವನು<br><br>

अधमर्णिन्
अधमर्णिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಲಗಾರ / ಸಾಲ ತೆಗೆದವನು<br><br>

अधमाङ्ग
अधमाङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚರಣ / ಕಾಲು<br><b>व्युत्पत्तिः - </b>अधमं च तत् अङ्गं च ।<br><br>

अधमार्ध
अधमार्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಕ್ಕಳಿನ ಕೆಳಭಾಗ / ದೇಹದ ಕೆಳಗಿನ ಅರ್ಧಭಾಗ<br><b>व्युत्पत्तिः - </b>अधमं च तत् अर्धं च ।<br><br>

अधमार्ध्य
अधमार्ध्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೇಹದ ಕೆಳಭಾಗದಲ್ಲುಂಟಾದ / ದೇಹದ ಕೆಳಭಾಗಕ್ಕೆ ಸಂಬಂಧಿಸಿದ<br><b>निष्पत्तिः - </b>“यत्” (४-३-४) ।<br><b>व्युत्पत्तिः - </b>अधमार्षे भवम् |<br><br>

अधर
अधर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳತುಟಿ<br><b>निष्पत्तिः - </b>धृङ् (अवस्थाने) “घः” (३-३-११८) ।<br><b>व्युत्पत्तिः - </b>न घ्रियते |<br><b>प्रयोगाः - </b>“अधरोष्ठविभागरेखिका सुदृशोऽस्या वदनेऽस्ति वा न वा”|<br><b>उल्लेखाः - </b>चं० भा० २-३९ ।<br><br>अधर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೀನವಾದ / ನೀಚವಾದ<br><br>अधर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಭಾಗದ<br><b>प्रयोगाः - </b>1. “असितमधरवासो बिभ्रतः सीरपाणेः” |<br><b>उल्लेखाः - </b>1. किरा० ४-३८<br><b>विस्तारः - </b>“अधरोऽन्र्ध्वहीनोष्ठे” - हेम० ।<br><br>अधर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂದಿನ / ಮೊದಲಿನ<br><br>

अधरकाय
अधरकाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹದ ಕೆಳಭಾಗ / ಹೊಕ್ಕಳಿನ ಕೆಳಭಾಗ<br><b>व्युत्पत्तिः - </b>अधरं कायस्य ।<br><br>

अधरतस्
अधरतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೆಳಭಾಗ<br><br>अधरतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೆಳಭಾಗದಿಂದ<br><br>अधरतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೆಳಭಾಗದಲ್ಲಿ<br><b>निष्पत्तिः - </b>अधर “तसिः” (वा० ५-४-४४) ।<br><br>

अधरपान
अधरपान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚುಂಬನ / ಅಧರಾಮೃತವನ್ನು ಕುಡಿಯುವುದು<br><br>

अधरमधु
अधरमधु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಧರಾಮೃತ / ತುಟಿಯ ರಸ<br><br>

अधराच्
अधराच्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಗಡೆ ಹೋಗುವ<br><b>निष्पत्तिः - </b>अञ्चु (गतौ) “क्विन्” (३-२-५९) ।<br><b>व्युत्पत्तिः - </b>अधरां दक्षिणां दिशमञ्चति |<br><br>

अधराची
अधराची<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಗಡೆ ಹೋಗುವ<br><b>निष्पत्तिः - </b>स्त्रियाम् “डीप्” (४-१-६) ।<br><br>

अधराचीन
अधराचीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಗಡೆ ಇರುವ / ಕೆಳಭಾಗದಲ್ಲುಂಟಾದ<br><b>निष्पत्तिः - </b>“खः” (५-४-८) ।<br><b>व्युत्पत्तिः - </b>अधराची भवं |<br><br>

अधरात्
अधरात्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಕೆಳಭಾಗ<br><br>अधरात्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಹಿಂದಿನ ಕಾಲ<br><br>अधरात्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಕೆಳಭಾಗದಿಂದ<br><br>अधरात्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಹಿಂದಿನ ಕಾಲದಿಂದ<br><br>अधरात्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಕೆಳಭಾಗದಲ್ಲಿ<br><br>अधरात्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಹಿಂದಿನ ಕಾಲದಲ್ಲಿ<br><b>निष्पत्तिः - </b>अधर “आतिः” (५-५-३४) ।<br><br>

अधरीकृत
अधरीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೀರಿಸಲ್ಪಟ್ಟ / ಕೀಳುಮಾಡಲ್ಪಟ್ಟ<br><br>अधरीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ / ಅವಮಾನಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>

अधरेण
अधरेण<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಕೆಳಭಾಗ<br><br>अधरेण<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಕೆಳಭಾಗದಿಂದ<br><br>अधरेण<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಕೆಳಭಾಗದಲ್ಲಿ<br><b>निष्पत्तिः - </b>अधर “एनप्” (५-३-३५) ।<br><br>

अधरेद्युस्
अधरेद्युस्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಹಿಂದಿನ ದಿನದಲ್ಲಿ<br><b>निष्पत्तिः - </b>अधर “एद्युस्” (वा० ५-३-२२) ।<br><br>

अधरोत्तर
अधरोत्तर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೀಳುಮೇಲು<br><br>अधरोत्तर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಭಾಗ ಮತ್ತು ಮೇಲುಭಾಗ<br><br>अधरोत्तर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀಚವಾದ ಉತ್ತರ<br><b>निष्पत्तिः - </b>एकवद्भावः (२-४-१२) ।<br><b>व्युत्पत्तिः - </b>अधरं च उत्तरं च ।<br><b>प्रयोगाः - </b>“श्रुतं भवद्भिरधरोत्तरम्” |<br><b>उल्लेखाः - </b>शाकु० ५ ।<br><br>

अधर्म
अधर्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><br>अधर्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪಕ್ಕೆ ಕಾರಣವಾದ ಅಕಾರ್ಯ / ನಿಷಿದ್ಧ ಕಾರ್ಯಾಚರಣೆ<br><b>निष्पत्तिः - </b>धृ (धारणे) “मन्” (उ० १-१३७) ।<br><b>व्युत्पत्तिः - </b>ध्रियतेऽनेन | विरोधे न० त० ।<br><b>प्रयोगाः - </b>“अधर्मनिघ्नैरधुना धर्मसेतुविभेदकैः” |<br><b>उल्लेखाः - </b>याद० १-३९ ।<br><b>विस्तारः - </b>ಅಧರ್ಮಗಳು ಮತ್ತು ಅವುಗಳಿಂದ ಮನುಷ್ಯನಿಗೊದಗುವ ಶಿಕ್ಷೆ: ಪತಿತನಿಂದ ದಾನತೆಗೆದುಕೊಂಡರೆ “अधीत्य चतुरो वेदान् द्विजो मोहसमन्वितः । पतितात्प्रतिगृह्याथ खरयॊनौ प्रजायते । खरो जीवति वर्षाणि दश पञ्च च भारत । खरो मृतो बलीवर्दः सप्तवर्षाणि जीवति । बलीवर्दो मृतश्चापि जायेत ब्रह्मराक्षसः । ब्रह्मरक्षश्च मासांस्त्रीन् ततो जायेत ब्राह्मणः” ॥ ಗುರುಪತ್ನಿಯಲ್ಲಿ ಅಪರಾಧಮಾಡಿದ ಶಿಷ್ಯನಿಗೆ “मनसापि गुरोर्भार्यां यः शिष्यो याति पापकृत् । स उग्रान् प्रैति संसारानधर्मेणेह चेतसा । श्वयोनौ तु स सम्भूतस्त्रीणि वर्षाणि जीवति । तत्रापि निधनं प्राप्तः कृमियोनौ प्रजायते । कृमिभावमनुप्राप्तो वर्षमेकं तु जीवति । ततस्तु निधनं प्राप्तो ब्रह्मयोनौ प्रजायते” ॥ ವಿವಾಹ, ಯಜ್ಞ ಮತ್ತು ದಾನ ಇವುಗಳಿಗೆ ವಿಘ್ನವುಂಟಮಾಡುವವನಿಗೆ “उपास्थिते विवाहे तु यज्ञे दानेऽथवा विभो । मोहात्करोति यो विघ्नं स मृतो जायते कृमिः । कृमिर्जीवति वर्षाणि दश पञ्च च भारत । अधर्मस्य क्षयं कृत्वा ततो जायेत मानवः ॥“ ಇತ್ಯಾದಿ, ಇತ್ಯಾದಿ. हरिवं० ।<br><br>अधर्म<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಬ್ರಹ್ಮ / ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>धर्मो गुणः स नास्ति यस्य ।<br><b>विस्तारः - </b>(ನಿರ್ಗುಣ, ಗುಣರಹಿತ.)<br><br>

अधर्मचारिन्
अधर्मचारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧರ್ಮಕಾರ್ಯಗಳನ್ನು ಮಾಡದ / ಪಾಪಕೃತ್ಯಗಳನ್ನು ನಡೆಸುವ<br><b>निष्पत्तिः - </b>चर (गतौ) “णिनिः” (३-२-७८) ।<br><b>व्युत्पत्तिः - </b>न धर्म चरति |<br><br>

अधर्ममय
अधर्ममय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪಭೂಯಿಷ್ಠ / ಪಾಪಮಯವಾದ<br><b>निष्पत्तिः - </b>“मयट्” (४-३-१४३) ।<br><b>व्युत्पत्तिः - </b>अधर्मेण प्रचुरः |<br><br>

अधर्मात्मन्
अधर्मात्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪಭೂಯಿಷ್ಠ / ಪಾಪಮಯವಾದ<br><b>व्युत्पत्तिः - </b>अधर्मप्रधानः आत्मा यस्य ।<br><br>

अधर्मिन्
अधर्मिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪಾತ್ಮ / ಪಾಪಕಾರ್ಯಗಳನ್ನೆಸಗುವವನು<br><br>

अधर्मिणी
अधर्मिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪಕಾರ್ಯಗಳನ್ನೆಸಗುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियाम् “डीप्” (४-१-५) ।<br><br>

अधर्मिष्ठ
अधर्मिष्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಪಾಪದಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>“इष्ठन्” (५-३-५५) ।<br><b>व्युत्पत्तिः - </b>अतिशयेन अधर्मी |<br><br>

अधर्म्य
अधर्म्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧರ್ಮಕಾರ್ಯವಿಲ್ಲದ / ಪಾಪಕಾರ್ಯವುಳ್ಳ<br><b>निष्पत्तिः - </b>“यत्” (४-४-९२) ।<br><b>व्युत्पत्तिः - </b>धर्मादनपेतो धर्म्यः | स न भवति।<br><br>अधर्म्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನ್ಯಾಯವಲ್ಲದ / ಧರ್ಮಕ್ಕೆ ವಿರುದ್ಧವಾದ<br><br>

अधवा
अधवा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಧವೆ / ವಿತಂತು<br><b>व्युत्पत्तिः - </b>नास्ति धवः पतिर्यस्याः ।<br><br>

अधश्चर
अधश्चर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೋರ / ಕಳ್ಳ<br><b>निष्पत्तिः - </b>चर (गतौ) “टः” (३-२-१६) ।<br><b>व्युत्पत्तिः - </b>अधः खनित्वा चरति |<br><br>अधश्चर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಭಾಗದಲ್ಲಿ ಸಂಚರಿಸುವ<br><b>निष्पत्तिः - </b>चर (गतौ) “टः” (३-२-१६) ।<br><b>व्युत्पत्तिः - </b>अधः चरति |<br><br>

अधश्चोर
अधश्चोर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಳ್ಳ / ಕನ್ನವನ್ನು ಕೊರೆದು ಕಳುವವನು<br><b>निष्पत्तिः - </b>चुर (स्तेये)+णिच् “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अधः खनित्वा चोरयति |<br><br>

अधस्
अधस्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಕೆಳಗೆ / ಕೆಳಭಾಗದಲ್ಲಿ<br><br>अधस्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಪಾತಾಳಲೋಕ<br><b>निष्पत्तिः - </b>अधर “असिः” अध् आदेशश्च (५-३-३९)।<br><b>प्रयोगाः - </b>“अधस्तथोर्ध्व पुरतोऽथ पृष्ठतः” |<br><b>उल्लेखाः - </b>कुमा० १४-२१ ।<br><br>

अधस्तन
अधस्तन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಗಿರುವ / ಕೆಳಭಾಗದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>“ट्युः” (४-३-२३) ।<br><b>व्युत्पत्तिः - </b>अधो भवः |<br><br>

अधस्तराम्
अधस्तराम्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಬಹಳ ಕೆಳಗೆ<br><b>निष्पत्तिः - </b>“तरप्” (५-३-५७) । “आमुः” (५-४-११) ।<br><b>व्युत्पत्तिः - </b>अतिशयेन अधः |<br><br>

अधस्तात्
अधस्तात्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಕೆಳಭಾಗ<br><br>अधस्तात्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಕೆಳಭಾಗದಿಂದ<br><br>अधस्तात्<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಕೆಳಭಾಗದಲ್ಲಿ<br><b>निष्पत्तिः - </b>“अस्तातिः” (५-४-४०) । अध् आदेशः (५-३-३९) ।<br><br>

अधामार्गव
अधामार्गव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರಣೆಗಿಡ<br><br>

अधार्मिक
अधार्मिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪಾತ್ಮ / ಪಾಪಕಾರ್ಯವನ್ನು ಮಾಡುವ<br><b>निष्पत्तिः - </b>“ठक्” (४-४-८) ।<br><b>व्युत्पत्तिः - </b>धर्मेण चरति | न० त० ।<br><br>

अधि
अधि<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಮೇಲೆ<br><b>निष्पत्तिः - </b>अधि+कृञ्, अधि+ष्ठा |<br><b>व्युत्पत्तिः - </b>अधिकारः, अधिष्ठानम् |<br><br>अधि<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಮೇಲುಭಾಗ<br><b>प्रयोगाः - </b>1. “अधिविटपि सलीलमग्रपुष्पग्रहणपदेन चिरं विलम्ब्य काचित्” | 2. “अधिजानु बाहुमुपधाय” |<br><b>उल्लेखाः - </b>1. माघ० ७-३५ । 2. माघ० ९-५४ ।<br><br>अधि<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಅತಿಶಯವಾದ / ಹೆಚ್ಚಾದ<br><b>प्रयोगाः - </b>“एतस्मिन्नधिकपयःश्रियं बहन्त्यः सङ्क्षोभं पवनभुवा जवेन नीताः” |<br><b>उल्लेखाः - </b>माघ० ४-५९ ।<br><br>अधि<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಐಶ್ವರ್ಯ<br><b>व्युत्पत्तिः - </b>अधिपतिः ।<br><br>अधि<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಅಧಿಕಾರ<br><b>विस्तारः - </b>“अधि स्यादधिकारे चापीश्चरे च निगद्यते” - मेदि० ।<br><br>अधि<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಹೀನ / ನಿಕೃಷ್ಟ / ಕೀಳು<br><b>प्रयोगाः - </b>“अधि हरौ सुराः” ।<br><br>अधि<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಪ್ರಾಧಾನ್ಯ / ಶ್ರೇಷ್ಠತೆ<br><b>व्युत्पत्तिः - </b>अधिदेवता, अधिराजः |<br><br>अधि<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಅಂಕೆ / ಹತೋಟಿ<br><b>व्युत्पत्तिः - </b>अधीनः ।<br><br>अधि<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಸ್ಮರಣ / ನೆನಪು<br><b>व्युत्पत्तिः - </b>मातुरध्येति ।<br><br>अधि<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ವಿಷಯವಾಗಿ / ಸಂಬಂಧವಾಗಿ<br><b>व्युत्पत्तिः - </b>अधिकृष्णम्, अधिरामम् |<br><br>अधि<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಅಧ್ಯಯನ<br><b>व्युत्पत्तिः - </b>उपाध्यायादधीते ।<br><b>विस्तारः - </b>[ಈ ಮೇಲೆ ಹೇಳಿದ ಎಲ್ಲಾ ಅರ್ಥಗಳಿಗೂ ಈ “अधि” ಎಂಬುದು ದ್ಯೋತಕವಾಗಿರುವುದು.]<br><br>

अधिक
अधिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾದ<br><b>प्रयोगाः - </b>“इयमधिकमनोज्ञावल्कलेनापि” |<br><b>उल्लेखाः - </b>शाकु० १-१७ ।<br><br>अधिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೊಡ್ಡದಾದ / ಹಿರಿದಾದ<br><b>प्रयोगाः - </b>“धनबन्धुवयःक्रियादिमात्रैरधिकेष्वप्यचमत्क्रिया विहत्यै”|<br><b>उल्लेखाः - </b>याद० १५-६७ ।<br><br>अधिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇರಳವಾದ / ಧಾರಾಳವಾದ<br><b>प्रयोगाः - </b>“श्वासः प्रमाणाधिकः” |<br><b>उल्लेखाः - </b>शाकु० १-२६ ।<br><br>अधिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ / ಮಿಗಿಲಾದ / ಉನ್ನತವಾದ<br><b>प्रयोगाः - </b>“सेनाशतेभ्योऽधिका (बुद्धिः)" |<br><b>उल्लेखाः - </b>मुद्रा० १-२५ ।<br><br>अधिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಾಧಾರಣ / ವಿಶೇಷ<br><b>प्रयोगाः - </b>“इज्य्घ्ययनदानानि वैश्यस्य क्षत्रियस्य च । प्रतिग्रहोऽधिको विप्रे य्जनाव्यापने तथा” |<br><b>उल्लेखाः - </b>याज्ञ० ५-११८ ।<br><br>अधिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದಿನ / ಅನಂತರದ (ಕಾಲ)<br><br>अधिक<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾಗಿ / ಮಿಗಿಲಾಗಿ<br><b>प्रयोगाः - </b>“स राज्यं गुरुणा दत्तं प्रतिपद्याधिकं वभौ” |<br><b>उल्लेखाः - </b>रघु० ४-१- ।<br><br>

अधिकतर
अधिकतर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠ / ಬಹಳ ಉತ್ಕೃಷ್ಟ<br><br>अधिकतर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಬ್ಬರಲ್ಲಿ ಮಿಗಿಲಾದವನೊಬ್ಬನು / ಎರಡರಲ್ಲಿ ಹೆಚ್ಚಾದ ಒಂದು<br><b>निष्पत्तिः - </b>“तरप्” (५-३-५७) ।<br><b>व्युत्पत्तिः - </b>अनयोरयमतिशयेनाधिकः |<br><b>प्रयोगाः - </b>“क्लेशोऽधिकतरस्तेषाम्” |<br><b>उल्लेखाः - </b>गीता १२-५ ।<br><br>

अधिकतम
अधिकतम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠ / ಬಹಳ ಉತ್ಕೃಷ್ಟ<br><br>अधिकतम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಬ್ಬರಲ್ಲಿ ಮಿಗಿಲಾದವನೊಬ್ಬನು / ಎರಡರಲ್ಲಿ ಹೆಚ್ಚಾದ ಒಂದು<br><b>निष्पत्तिः - </b>“तमप्” (५-३-५५) ।<br><b>व्युत्पत्तिः - </b>अयमेषामतिशयेनाधिकः |<br><br>

अधिकमास
अधिकमास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಲಮಾಸ. (ಶೂನ್ಯಮಾಸ)<br><b>प्रयोगाः - </b>“पक्षद्वयेऽपि सङ्क्रान्तिर्यदि न स्यात् सितेऽसिते । तदा तन्मासि विहितमुत्तरे मासि कारयेत्” ।<br><b>विस्तारः - </b>[ಸಂಕ್ರಮಣವಿಲ್ಲದ ಮಾಸವು ಮಲಮಾಸ. ಚೈತ್ರಾದಿಮಾಸಗಳಲ್ಲಿ ಸೂರ್ಯನು ಯಾವ ಮುಂದಿನ ರಾಶಿಯನ್ನೂ ಪ್ರವೇಶಿಸದೆ ಇದ್ದಲ್ಲಿಯೇ ಇದ್ದರೆ ಅದು ಸಂಕ್ರಾಂತಿವರ್ಜಿತಮಾಸವು (ಮಲಮಾಸವು). ಈ ಮಲಮಾಸವು ಯಾವ ಕಾರ್ಯಕ್ಕೂ ಪ್ರಶಸ್ತವಲ್ಲ.]<br><br>

अधिकरण
अधिकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೇಮಕ<br><br>अधिकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ<br><b>निष्पत्तिः - </b>अधि+डु कृञ् (करणे) कर० “ल्युट्” (३-३-११७) ।<br><b>व्युत्पत्तिः - </b>अधिक्रियतेऽनेन ।<br><b>प्रयोगाः - </b>“रामाधिकरणाः कथाः” ।<br><b>उल्लेखाः - </b>रामा० ।<br><br>अधिकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಾನ / ಜಾಗ<br><br>अधिकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಧಾರ / ಆಶ್ರಯ<br><b>निष्पत्तिः - </b>“तत्पुरुषः समानाधिकरणः कर्मधारयः” पा० सू० (१-२-४२) ।<br><b>प्रयोगाः - </b>1. “घृताधिकरणं पात्रम्” । 2. “ज्ञानाधिकरणम् आत्मा” ।<br><br>अधिकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಂಥಭಾಗ / ಅಧ್ಯಾಯ<br><br>अधिकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನ್ಯಾಯಸ್ಥಾನ<br><br>अधिकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದ್ರವ್ಯ<br><b>निष्पत्तिः - </b>“विप्रतिषिद्धं चानधिकरणवाचि” पा० सू० (२-४-१३) ।<br><b>विस्तारः - </b>अद्रव्यवाचिनाम् - सि० कौ० ।<br><br>अधिकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>(ಮೀಮಾಂಸಾಶಾಸ್ತ್ರದಲ್ಲಿ) ಐದು ಅಂಗಗಳಿಂದ ಕೂಡಿದ ಒಂದು ವಾಕ್ಯ ಸಮುದಾಯ<br><b>विस्तारः - </b>ಅಧಿಕರಣಾಂಗಗಳು: ವಿಷಯ, ವಿಶಯ (ಸಂಶಯ), ಪೂರ್ವಪಕ್ಷ, ಉತ್ತರ ಮತ್ತು ನಿರ್ಣಯಗಳೆಂದು ಐದು.<br><br>अधिकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>(ವ್ಯಾಕರಣಶಾಸ್ತ್ರದಲ್ಲಿ) ಕರ್ತೃಕರ್ಮಗಳ ಮೂಲಕ ಕ್ರಿಯೆಗೆ ಇರುವ ಆಧಾರ<br><b>निष्पत्तिः - </b>“आधारोऽधिकरणम्” पा० स्० (१-४-४५) ।<br><br>

अधिकरणिक
अधिकरणिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನ್ಯಾಯಾಧಿಪತಿ<br><b>निष्पत्तिः - </b>“ठन्” (५-२-११५) ।<br><b>व्युत्पत्तिः - </b>अधिकरणमाश्रयतयस्त्यस्य |<br><br>

अधिकर्धि
अधिकर्धि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಸಂಪತ್ತುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>अधिका ऋद्धिरस्य ।<br><b>प्रयोगाः - </b>“ऋद्धिमन्तमधिकर्धिरुत्तरः” |<br><b>उल्लेखाः - </b>रघु० १९-५ ।<br><br>

अधिकर्मन्
अधिकर्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲ್ವಿಚಾರಕ / ಮೇಲ್ವಿಚಾರಣೆಯಲ್ಲಿ ನೇಮಕವಾದವನು<br><br>अधिकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಕೆಲಸ / ಅಧಿಕ ಕಾರ್ಯ<br><b>व्युत्पत्तिः - </b>अधिकं कर्म ।<br><br>अधिकर्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಕಾರ್ಯವುಳ್ಳವನು<br><br>

अधिकर्मकर
अधिकर्मकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಕೆಲಸ ಮಾಡುವ<br><br>अधिकर्मकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಸ್ತುವಾರಿ ನೋಡುವ<br><b>निष्पत्तिः - </b>डु कृञ् (करणे) “टः” (३-२-२०) ।<br><b>व्युत्पत्तिः - </b>अद्धं कर्म करोति |<br><br>

अधिकर्मकृत्
अधिकर्मकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಕೆಲಸ ಮಾಡುವ<br><br>अधिकर्मकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಸ್ತುವಾರಿ ನೋಡುವ<br><br>

अधिकाङ्ग
अधिकाङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಡುಕಟ್ಟು / ನಡುವಿನ ಪಟ್ಟಿ<br><b>निष्पत्तिः - </b>मयूर० ।<br><b>व्युत्पत्तिः - </b>अङ्गादधिकम् ।<br><br>अधिकाङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕವಾದ ಅಂಗವುಳ್ಳ / ಅಳತೆ ಮೀರಿದ ದೇಹವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अधिकमङ्गं यस्य ।<br><br>

अधिकाम
अधिकाम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲವಾದ ಆಸೆ / ಹೆಚ್ಚು ಆಸೆ<br><br>

अधिकार
अधिकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲ್ವಿಚಾರಣೆ / ಪಾರುಪತ್ಯ / ಯಜಮಾನ್ಯ<br><b>निष्पत्तिः - </b>अधि+डु कृञ् (करणे) “घञ्” (३-३-१८) ।<br><b>प्रयोगाः - </b>“अधिकाराविलम्बितापवर्तस्थिरसङ्गादपकौतुकस्त्रिवर्गे”|<br><b>उल्लेखाः - </b>याद० १५-७ ।<br><br>अधिकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸ / ಕಾರ್ಯ / ಅವಶ್ಯಕರ್ತವ್ಯ<br><b>प्रयोगाः - </b>1. “तेन शिल्पाधिकारे योग्येयं दारिकेति भगिन्या” देव्या उपायनं प्रेषित्” | 2. “स्याधिकारार्प्रमत्तः” |<br><b>उल्लेखाः - </b>1. माल० १ । 2. मेघ० १-१- ।<br><br>अधिकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಭುತ್ವ / ರಾಜತ್ವ / ಆಧಿಪತ್ಯ / ಆಡಳಿತ<br><b>प्रयोगाः - </b>“ख्षणादायुष्मान् स्वाधिकारभूमौ वर्तिष्यते” |<br><b>उल्लेखाः - </b>शाकु० ७ ।<br><br>अधिकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಾಮಿತ್ವ / ಒಡೆತನ<br><b>प्रयोगाः - </b>“अधिकारः फले स्वाम्यमधिकारी च तत्प्रभुः” |<br><b>उल्लेखाः - </b>सा० द० ६-४३ ।<br><br>अधिकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯೋಗ್ಯತೆ / ಅರ್ಹತೆ / ಕೆಲಸವನ್ನು ಮಾಡುವ ಮತ್ತು ಅದರ ಫಲವನ್ನು ಅನುಭವಿಸುವ ಅರ್ಹತೆ<br><b>विस्तारः - </b>[ಬ್ರಾಹ್ಮಣನಿಗೆ ಯಜನ, ಯಾಜನ; ಅಧ್ಯಯನ, ಅಧ್ಯಾಪನ; ದಾನ, ಪ್ರತಿಗ್ರಹ. ಇವುಗಳಲ್ಲಿ ಅಧಿಕಾರ (ಅರ್ಹತೆ)ವುಂಟು. ಕ್ಷತ್ರಿಯ ಮತ್ತು ವೈಶ್ಯನಿಗೆ ಯಜನ, ಅಧ್ಯಯನ ಮತ್ತು ದಾನ ಇವುಗಳಲ್ಲಿ ಮಾತ್ರ ಅಧಿಕಾರವುಂಟು.] ಇತ್ಯಾದಿ.<br><br>अधिकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾನ್ಯತೆ / ಹಿರಿಮೆ<br><b>प्रयोगाः - </b>“हृताधिकारां मलिनां पिण्डमात्रोपजीविनीम्” |<br><b>उल्लेखाः - </b>याज्ञ० १-७० ।<br><br>अधिकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶೇಷಾಧಿಕಾರ / ಸ್ವಾಮ್ಯ / ಹಕ್ಕು<br><br>अधिकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನ / ಪ್ರಯಾಸ<br><b>प्रयोगाः - </b>“कर्मण्येवाधिकारस्ते मा फलेषु कदाचन” |<br><b>उल्लेखाः - </b>गीता २-४७ ।<br><br>अधिकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಣನೆ / ಎಣಿಕೆ<br><b>प्रयोगाः - </b>“संसत्सु जाते पुरुषाधिकारे न पूरणी तं समुपैति सङ्ख्या” |<br><b>उल्लेखाः - </b>किरा० ३-५१ ।<br><br>अधिकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಾನ / ಪದವಿ<br><b>प्रयोगाः - </b>“निर्णयाधिकारे ब्रव्मि” |<br><b>उल्लेखाः - </b>माल० १ ।<br><b>विस्तारः - </b>(ಧರ್ಮನಿರ್ಣಯ ಮೊದಲಾದುವುಗಳ ತೀರ್ಮಾನ ಪೀಠ)<br><br>अधिकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕರಣ ಸಂದರ್ಭ<br><b>व्युत्पत्तिः - </b>प्रायश्चित्ताधिकारः ।<br><br>अधिकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣಶಾಸ್ತ್ರದಲ್ಲಿ ಹೇಳಿರುವ ಆರು ವಿಧ ಸೂತ್ರಗಳಲ್ಲಿ ಅನುವೃತ್ತವಾಗಿ ತನ್ನ ಅರ್ಥವನ್ನು ಕೊಡುವ ಸೂತ್ರ<br><b>विस्तारः - </b>ಉದಾ: “धातोः” (३-१-९१) । अतृतीयसमाप्तेरधिकारोऽयम् । “कृत्याः” (३-१-९५) । अधिकारोऽयम् ण्वुलः प्राक् सि० कौ० । ಇತ್ಯಾದಿ. ಆರುವಿಧ ಸೂತ್ರಗಳು: “सञ्ज्ञा च परिभाषा च विधिर्नियम एव च । अतिदेशोऽधिकारश्च षड्विधं सूत्रमीरितम्” ।<br><br>

अधिकारवत्
अधिकारवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉನ್ನತೋದ್ಯೋಗಿ / ಮೇಲ್ವಿಚಾರಕ<br><b>प्रयोगाः - </b>“न निष्प्रयोजनमधिकारवन्तः प्रभुभिराहूयन्ते” |<br><b>उल्लेखाः - </b>मुद्रा० ३ ।<br><br>

अधिकारविधि
अधिकारविधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಹಿತಕಾರ್ಯಗಳನ್ನು ಮಾಡಲು ಅರ್ಹತೆಯ ನಿರ್ಣಯ / ಯೋಗ್ಯತಾನುಸಾರ ಕಾರ್ಯವನ್ನು ನಿರ್ಣಯಿಸುವುದು<br><b>विस्तारः - </b>“ज्योतिष्टोमेन स्वर्गकामो यजेत” ಇಲ್ಲಿ ಜ್ಯೋತಿಷ್ಟ್ಮಯಾಗದ ಫಲವನ್ನು ಅನುಭವಿಸುವವನು ಸ್ವರ್ಗವನ್ನು ಅಪೇಕ್ಷಿಸುವವನಾದ್ದರಿಂದ ಅವನೇ ಈ ಯಾಗವನ್ನು ಮಾಡಬೇಕೆಂದು ವಿಧಿ. “राजा राजसूयेन यजेत” ಇಲ್ಲಿ ರಾಜಸೂಯಾಯಾಗದ ಫಲವನ್ನು ಅನುಭವಿಸುವವನು ರಾಜನಾದ್ದರಿಂದ ರಾಜಸೂಯವನ್ನು ರಾಜನೇ ಮಾಡಬೇಕೆಂದು ವಿಧಿ. ಇತ್ಯಾದಿ.<br><br>

अधिकारिन्
अधिकारिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ಯೋಗದಲ್ಲಿರುವವನು / ಉನ್ನತೋದ್ಯೋಗಿ<br><br>अधिकारिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜಮಾನ<br><b>निष्पत्तिः - </b>अधिकार “इनिः” (५-२-११५) ।<br><br>अधिकारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕಾರವುಳ್ಳ<br><b>प्रयोगाः - </b>“कृतात्र देवी वचनाढिकारिणी” |<br><b>उल्लेखाः - </b>नैष० ।<br><br>अधिकारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯೋಗ್ಯತೆಯುಳ್ಳ / ಅರ್ಹತೆಯುಳ್ಳ<br><b>प्रयोगाः - </b>“तपस्यनधिकारित्वात् प्रजानां तमधावहं” |<br><b>उल्लेखाः - </b>रघु० १५-५१ ।<br><br>अधिकारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಡೆಯ / ಸ್ವಂತಗ್ರ<br><br>अधिकारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಹ / ಶಕ್ತ<br><br>अधिकारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಕ್ಕುದಾರ / ವಾರಸುದಾರ<br><br>

अधिकारिणी
अधिकारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अधिकारिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><br>

अधिकारिता
अधिकारिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಿಕಾರ / ಪ್ರಭುತ್ವ<br><br>अधिकारिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಡೆತನ<br><br>अधिकारिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಕ್ಕು / ವಾರಸು<br><br>अधिकारिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಹತೆ / ಯೋಗ್ಯತೆ<br><br>

अधिकृच्छ्र
अधिकृच्छ्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ತಿಂಗಳು ಕಾಲ ಮಾಡಬೇಕಾದ ಬಹಳ ಕಷ್ಟವಾದ ವ್ರತ<br><br>अधिकृच्छ्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಕಷ್ಟ<br><br>अधिकृच्छ्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕಷ್ಟವಾದ<br><br>

अधिकृत
अधिकृत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆದಾಯ ಮತ್ತು ವೆಚ್ಚವನ್ನು ನೋಡಿಕೊಳ್ಳಲು ನೇಮಿಸಿರುವ ಅಧಿಕಾರಿ / ಅಧ್ಯಕ್ಷ / ಮೇಲ್ವಿಚಾರಕ<br><br>अधिकृत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಯಮಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अधि+डु कृञ् (करणे) “क्तः” (३-२-१०२) ।<br><b>प्रयोगाः - </b>“सम्भावना ह्याधिकृतस्य तनोति तेजः” |<br><b>उल्लेखाः - </b>किरा० ६-४६ ।<br><br>अधिकृत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಭುತ್ವವುಳ್ಳ / ಸ್ವಾಮಿತ್ವವುಳ್ಳ<br><br>अधिकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಹತೆಯುಳ್ಳ<br><br>

अधिकृति
अधिकृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಿಕಾರ / ಪ್ರಭುತ್ವ / ಒಡೆತನ<br><b>निष्पत्तिः - </b>अधि+डु कृञ् (करणे) “क्तिन्” (३-३-९४)।<br><br>

अधिकृत्य
अधिकृत्य<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಕುರಿತು / ಸಂಬಂಧಿಸಿ / ಉದ್ದೇಶಿಸಿ<br><b>निष्पत्तिः - </b>अधि+डु कृञ् (करणे) “ल्युप्” (७-१-३७) ।<br><b>प्रयोगाः - </b>“प्रेक्ष्य शान्तिमधिकृत्य कृत्यवित्” |<br><b>उल्लेखाः - </b>रघु० ११-६२ ।<br><br>

अधिक्रम
अधिक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮಿಸಿ ಬರುವುದು / ಮೇಲೆಬೀಳುವುದು / ಉಲ್ಲಂಘಿಸುವುದು / ಧಾಳಿಮಾಡುವುದು<br><b>निष्पत्तिः - </b>अधि+क्रमु (पादविक्षेपे) भावे “घञ्” (३-३-१८) ।<br><br>

अधिक्रमण
अधिक्रमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>अधिक्रम ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे “ल्युट्” (३-३-११५) ।<br><br>

अधिक्षिप्त
अधिक्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೇರಿಸಲ್ಪಟ್ಟ<br><br>अधिक्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿಸಲ್ಪಟ್ಟ<br><br>अधिक्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ<br><br>अधिक्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕ್ಷೇಪಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अधि+क्षिपु (निरसने) “क्तः” (३-२-१०२) |<br><b>प्रयोगाः - </b>“न मे प्राद्ररजसा तुल्य इत्यधिक्षिप्तः” |<br><b>उल्लेखाः - </b>म्ल० १ ।<br><br>अधिक्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲೆ ಇಡಲ್ಪಟ್ಟ<br><br>

अधिक्षेप
अधिक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೇರಣೆ<br><br>अधिक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ / ದೂಷಣೆ<br><br>अधिक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲೆ ಇಡುವುದು<br><br>अधिक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಸೆಯೋಣ<br><br>अधिक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರ<br><b>निष्पत्तिः - </b>अधि+क्षिपु (निरसने) भावे “घञ्” (३-३-१८) ।<br><b>प्रयोगाः - </b>“भवादृशेषु प्रमदाजनोदितं भवत्यधिक्षेप इवानुशासनम्” |<br><b>उल्लेखाः - </b>किरा० १-२८ ।<br><br>

अधिगत
अधिगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಟ್ಟ / ಸಂಪಾದಿಸಲ್ಪಟ್ಟ / ಗಳಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अधि+गम्लृ (गतौ) “क्तः” (३-२-१०२) ।<br><b>प्रयोगाः - </b>“अधिगतं विधिवद्यदपालयत्” |<br><b>उल्लेखाः - </b>रघु० ९-२ ।<br><br>अधिगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಪಟ್ಟ / ಕಲಿಯಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>“किमित्येवम्पृच्छस्यनधिगतरामायण इव” |<br><b>उल्लेखाः - </b>उ० रा० ६-३० ।<br><br>

अधिगम
अधिगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನ / ತಿಳಿವಳಿಕೆ<br><br>अधिगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಪ್ತಿ / ಹೊಂದುವಿಕೆ<br><b>प्रयोगाः - </b>“यदा च तस्याधिगमे जगत्पतेः” |<br><b>उल्लेखाः - </b>कुमा० ५-५९ ।<br><br>अधिगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಡೆಯುವಿಕೆ / ಸಂಪಾದನೆ<br><b>प्रयोगाः - </b>“स्थापयन्ति तु यां वृद्धिं सा तत्राधिगमं प्रति” |<br><b>उल्लेखाः - </b>मनु० ८-१५७ ।<br><br>अधिगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ / ಸ್ವೀಕಾರ<br><b>निष्पत्तिः - </b>अधि+गम्लृ (गतौ) “घञ्” (३-३-१८) ।<br><br>

अधिगन्तृ
अधिगन्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದತಕ್ಕ / ಪಡೆಯುವ<br><b>निष्पत्तिः - </b>अधि+गम्लृ (गतौ) “तृच्” (३-१-१३३) ।<br><br>

अधिगन्त्री
अधिगन्त्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಂದತಕ್ಕ / ಪಡೆಯುವ<br><b>निष्पत्तिः - </b>स्त्रियाम् “डीप्” (४-१-५) ।<br><br>

अधिगम्य
अधिगम्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲು ಶಕ್ಯವಾದ / ಪಡೆಯಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>अधि+गम्लृ (गतौ) “यत्” (३-१-९८) ।<br><br>अधिगम्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿ / ಪಡೆದು / ಸಂಪಾದಿಸಿ<br><br>अधिगम्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅರಿತು / ತಿಳಿದು<br><b>निष्पत्तिः - </b>अधि+गम्लृ (गतौ) “क्त्वा” ल्युप्” (७-१-३७) ।<br><b>प्रयोगाः - </b>“अधिगम्य गुह्यकगणादिति” |<br><b>उल्लेखाः - </b>किरा ६-३८ ।<br><br>

अधिगुण
अधिगुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಿಕಗುಣ / ಅತಿಶಯವಾದ ಗುಣ<br><b>व्युत्पत्तिः - </b>अधिको गुणः ।<br><br>अधिगुण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕಗುಣವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अधिको गुणो यस्य ।<br><b>प्रयोगाः - </b>“याच्च्रा मोघा वरमधिगुणे नाढमे लब्धकामा” |<br><b>उल्लेखाः - </b>मेघ० १-६ ।<br><br>अधिगुण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆದೆಯೇರಿಸಲ್ಪಟ್ಟ ಧನುಸ್ಸು<br><b>व्युत्पत्तिः - </b>अधिगतो गुणो येन ।<br><b>प्रयोगाः - </b>“अधिगुणशरासनं जनाः” |<br><b>उल्लेखाः - </b>किरा० १२-१४ ।<br><br>

अधिजिह्व
अधिजिह्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾವು / ಸರ್ಪ<br><b>निष्पत्तिः - </b>भा० आदि० ३६ ।<br><b>व्युत्पत्तिः - </b>अधिका जिह्वा यस्य ।<br><b>विस्तारः - </b>[ದರ್ಭೆಯ ಮೇಲಿಟ್ಟಿದ ಅಮೃತವನ್ನು ಪಾನಮಾಡಲು ಹೋದಾಗ ದರ್ಭೆಯ ಚೂಪಾದ ಅಗ್ರದಿಂದ ಸರ್ಪಗಳ ನಾಲಿಗೆಯ ಎರಡು ಭಾಗವಾಯಿತು.]<br><br>अधिजिह्व<br><br><b>पदविभागः - </b>अव्ययम्<br><b>व्युत्पत्तिः - </b>जिह्वायामधिजिह्वम् ।<br><br>

अधिजिह्विका
अधिजिह्विका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರುನಾಲಿಗೆ<br><b>निष्पत्तिः - </b>स्वार्थे “कन्” (५-४-२९) ।<br><b>व्युत्पत्तिः - </b>अधिरूढा जिह्वा |<br><br>

अधिज्य
अधिज्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆದೆಯೇರಿಸಲ್ಪಟ್ಟ ಧನುಸ್ಸು<br><b>व्युत्पत्तिः - </b>अधिरूढा ज्या यत्र ।<br><br>

अधिज्यकार्मुक
अधिज्यकार्मुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆದೆಯೇರಿಸಲ್ಪಟ್ಟ ಧನುಸ್ಸುಳ್ಳ<br><b>निष्पत्तिः - </b>“अनङ्” (५-४-१३२) ।<br><b>व्युत्पत्तिः - </b>अधिज्यं कार्मुकं यस्य । अधिज्यं धनुर्यस्य - अधिज्यधन्वन् |<br><b>प्रयोगाः - </b>1. “कृष्णसारे ददच्चक्षुस्त्वयि चाधिज्यकार्मुके” | 2. “अधिज्यधन्वा विचचार दावम्” |<br><b>उल्लेखाः - </b>1. शाकु० १-६ । 2. रघु० २-८ ।<br><br>

अधितिष्ठत्
अधितिष्ठत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೀರುವ / ಅತಿಕ್ರಮಿಸುವ<br><b>निष्पत्तिः - </b>अधि+ष्ठा (गतिनिवृत्तौ) “शतृ” (३-२-१२४) ।<br><b>प्रयोगाः - </b>“तन्त्रावापविदा योगैर्मण्डलान्यधितिष्ठता” |<br><b>उल्लेखाः - </b>माघ० २-८८ ।<br><br>अधितिष्ठत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇರುವ / ವಾಸಮಾಡುವ<br><br>

अधित्यका
अधित्यका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಟ್ಟದ ಮೇಲುಭಾಗದ ಭೂಮಿ<br><b>निष्पत्तिः - </b>अधि “त्यकन्” (५-२-३४) ।<br><b>प्रयोगाः - </b>“कमपि काञ्चनभ्भुदधित्यका” |<br><b>उल्लेखाः - </b>याद० ३-१२ ।<br><br>

अधिदन्त
अधिदन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಲ್ಲಿನ ಮೇಲೆ ಹುಟ್ಟಿರುವ ಹಲ್ಲು<br><br>अधिदन्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತಹ ಹಲ್ಲುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>अधिरूढो दन्तो यस्य ।<br><br>

अधिदीधिति
अधिदीधिति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕ ಕಾಂತಿಯುಳ್ಳ / ಹೆಚ್ಚು ತೇಜಸ್ಸುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अधिरूढो दन्तः ।<br><br>अधिदीधिति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>व्युत्पत्तिः - </b>अधिरूढो दन्तो यस्य ।<br><br>

अधिदेव
अधिदेव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವದೇವ / ಪರಮೇಶ್ವರ<br><b>व्युत्पत्तिः - </b>अधिकृतो देवः येन ।<br><br>अधिदेव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>व्युत्पत्तिः - </b>अधिष्ठाता देवः ।<br><b>प्रयोगाः - </b>“ययाचे पादुके पश्चात् कर्तुं राज्याधिदेवते” |<br><b>उल्लेखाः - </b>रघु० १२-१७ ।<br><br>अधिदेव<br><br><b>पदविभागः - </b>अव्ययम्<br><br>

अधिदेवता
अधिदेवता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>व्युत्पत्तिः - </b>अधिष्ठात्री देवता वा ।<br><br>

अधिदेवन
अधिदेवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಟದ ಹಲಗೆ / ಪಗಡೆಯ ಹಾಸು<br><b>निष्पत्तिः - </b>दिवु (क्रीडादौ) “ल्युट्” (३-३-११७) |<br><b>व्युत्पत्तिः - </b>अधि उपरि दीव्यते यत्र |<br><br>

अधिदैवत
अधिदैवत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಿದೇವತೆ / ರಕ್ಷಿಸುವ ದೇವತೆ / ಇಷ್ಟದೇವತೆ<br><b>व्युत्पत्तिः - </b>अधिष्ठातृ दैवतम् ।<br><br>

अधिनाथ
अधिनाथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಧೀಶ್ವರ / ಸಾಮಂತ ರಾಜರನ್ನು ಗೆದ್ದ ರಾಜ (ಚಕ್ರವರ್ತಿ)<br><b>व्युत्पत्तिः - </b>अधिको नाथः ।<br><br>

अधिप
अधिप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ / ದೊರೆ<br><b>निष्पत्तिः - </b>पा (रक्षणे) “कः” (३-१-१३६) ।<br><b>व्युत्पत्तिः - </b>अधि पाति |<br><b>प्रयोगाः - </b>1. “सा भूधराणामधिपेन तस्यां समाधिमत्यामुदपादि भव्या” | 2. “श्रियः कुरुणामधिपस्य पालनीम्” |<br><b>उल्लेखाः - </b>1. कुमा० १-२२ । 2. किरा० १-१-।<br><br>

अधिपति
अधिपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ / ದೊರೆ<br><b>व्युत्पत्तिः - </b>अधिकः पतिः ।<br><b>प्रयोगाः - </b>“ततो भुजङ्गाधिपतेः फणाग्रैः” |<br><b>उल्लेखाः - </b>कुमा० ३-५९ ।<br><br>

अधिपा
अधिपा<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ / ದೊರೆ<br><b>निष्पत्तिः - </b>पा (रक्षणे) “विच्” (३-२-७५) ।<br><b>व्युत्पत्तिः - </b>अधि पाति |<br><br>

अधिपुरुष
अधिपुरुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>अधिकः उत्तमः पुरुषः ।<br><br>

अधिपेषण
अधिपेषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರೆಯುವ ಕಲ್ಲು / ಪುಡಿ ಮಾಡುವ ಕಲ್ಲು<br><b>निष्पत्तिः - </b>अधि_पिष (सञ्चूर्णने) “ल्युट्” (३-३-११७)|<br><br>

अधिप्रज
अधिप्रज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>व्युत्पत्तिः - </b>अधिका प्रजा यस्य यस्या वा ।<br><br>अधिप्रज<br><br><b>पदविभागः - </b>अव्ययम्<br><b>व्युत्पत्तिः - </b>प्रजायामधिप्रजम् ।<br><br>

अधिप्रजा
अधिप्रजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><br>

अधिबल
अधिबल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಟಕೀಯ ಒಂದು ಅಂಗ<br><br>अधिबल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿರೋಧ ಸಮಯದಲ್ಲಿ ಆಡುವ ಪರಸ್ಪರ ಸಮಾಧಾನ ವಚನ / ಸಂಧಾನದ ಮಾತು<br><b>प्रयोगाः - </b>“अधिबलमभिसन्धिच्छलेन यः” |<br><b>उल्लेखाः - </b>सा० द० ६-९९ ।<br><br>

अधिभू
अधिभू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಭು / ನಾಯಕ / ಸ್ವಾಮಿ / ಯಜಮಾನ<br><b>निष्पत्तिः - </b>भू (सत्तायाम्) “क्विप्” (३-२-१७९) ।<br><b>व्युत्पत्तिः - </b>अधिभवति |<br><br>

अधिभूत
अधिभूत<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಾಣಿಗಳನ್ನು ಕುರಿತು / ಪ್ರಾಣಿಗಳ ವಿಷಯವಾಗಿ<br><b>निष्पत्तिः - </b>विभक्त्यर्थे अव्ययी० |<br><b>व्युत्पत्तिः - </b>भूतेषु-<br><b>प्रयोगाः - </b>“अधिभूतं किमुच्यते” |<br><b>उल्लेखाः - </b>गीता ८-१ ।<br><br>

अधिभोजन
अधिभोजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಿತಿಮೀರಿದ ಊಟ<br><b>व्युत्पत्तिः - </b>अधिकमत्यन्तं भोजनम् ।<br><br>अधिभोजन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಬೆಲೆಬಾಳುವ / ಅಧಿಕ ಬೆಲೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अधिकं भोजनं धनं यस्य । भोजनं धनमिति निरुक्तम् ।<br><br>

अधिमन्थ
अधिमन्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ನೇತ್ರರೋಗ<br><b>निष्पत्तिः - </b>मन्थ (विलोडने) कर० “घञ्” (३-३-१२१)।<br><b>व्युत्पत्तिः - </b>अधिकं मथ्यतेऽनेन |<br><br>अधिमन्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞದ ಅಗ್ನಿಗಾಗಿ ಅರಣಿಯನ್ನು ಕಡೆಯುವುದು<br><b>निष्पत्तिः - </b>मन्थ भावे “घञ्” (३-३-१८) ।<br><br>

अधिमन्थन
अधिमन्थन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯನ್ನು ಉಂಟು ಮಾಡಲು ಕಡೆಯುವ ಅರಣಿ<br><b>निष्पत्तिः - </b>मन्थ (विलोडने) कर० “ल्युट्” (३-३-११७)।<br><b>व्युत्पत्तिः - </b>अधिकं मथ्यतेऽनेन |<br><br>

अधिमांस
अधिमांस<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣಿನ ಬಿಳಿ ಗುಡ್ಡೆಯ ಮೇಲೆ ಹೆಚ್ಚು ಮಾಂಸವು ಬೆಳೆದುಂಟಾಗುವ ಒಂದು ರೋಗ<br><br>अधिमांस<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಟ್ಟೆಯಲ್ಲಿ ಮಾಂಸಗ್ರಂಥಿಯು ಬೆಳೆದುಂಟಾಗುವ ಒಂದು ರೋಗ<br><b>व्युत्पत्तिः - </b>अधिकं मांसं यत्र ।<br><br>

अधिमांसक
अधिमांसक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಂತಮೂಲದಲ್ಲಿ ಮಾಂಸವು ಹೆಚ್ಚಾಗಿ ಬೆಳೆದುಂಟಾಗುವ ವ್ರಣ / ವಸಡಿನ ಹುಣ್ಣು<br><br>

अधिमात्र
अधिमात्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಶಯವಾದ / ಮಿತಿಮೀರಿದ<br><b>व्युत्पत्तिः - </b>अधिकः अतिरिक्तः मासः ।<br><b>विस्तारः - </b>[ವಿವರಕ್ಕೆ “अधिकमास” ಪದದಲ್ಲಿ ನೋಡಿ.]<br><br>

अधिमास
अधिमास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಿಕಮಾಸ / ಮಲಮಾಸ<br><b>व्युत्पत्तिः - </b>अधिकः अतिरिक्तः मासः ।<br><b>विस्तारः - </b>[ವಿವರಕ್ಕೆ “अधिकमास” ಪದದಲ್ಲಿ ನೋಡಿ.]<br><br>

अधियज्ञ
अधियज्ञ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ / ಪರಬ್ರಹ್ಮ<br><b>व्युत्पत्तिः - </b>अधिकृतो यज्ञो यस्मात् ।<br><b>प्रयोगाः - </b>“अधियज्ञोऽहमेवात्र देहे देहभृतां वर” |<br><b>उल्लेखाः - </b>गीता ८-४ ।<br><br>अधियज्ञ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಜ್ಞವನ್ನು ಉದ್ದೇಶಿಸಿ / ಯಜ್ಞದ ವಿಷಯವಾಗಿ<br><br>

अधियोग
अधियोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯಾಣ ಸಂಬಂಧವಾದ ಶುಭಮೂಹೂರ್ತ<br><b>व्युत्पत्तिः - </b>अधिकः उत्तमः योगः ।<br><b>उल्लेखाः - </b>मु० चि० ।<br><b>विस्तारः - </b>[ಪ್ರಯಾಣ ಲಗ್ನದಿಂದ 4, 5, 7, 9 ಅಥವಾ 10 ನೇ ಸ್ಥಾನದಲ್ಲಿ ಬುಧ, ಗುರು ಮತ್ತು ಶುಕ್ರರಲ್ಲಿ ಯಾರಾದರು ಇಬ್ಬರಿದ್ದರೆ ಈ ಶುಭ ಯೋಗವೆಂದು ತಿಳಿಯಬೇಕು.]<br><br>

अधियोध
अधियोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾಗಿ ಹೋರಾಡುವವನು / ಮುಂದೆ ನಿಂತು ಯುದ್ಧಮಾಡುವವನು<br><b>निष्पत्तिः - </b>अधि+युध (सम्प्रहारे) “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>आधिक्येन युध्यते |<br><br>अधियोध<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಯೋಧನಲ್ಲಿ<br><b>निष्पत्तिः - </b>योधे-विभक्त्यर्थे अव्ययी० ।<br><br>

अधिरथ
अधिरथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾರಥಿ<br><b>व्युत्पत्तिः - </b>अध्यारूढः रथम् ।<br><br>

अधिराज्
अधिराज्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಕ್ರವರ್ತಿ / ಸಾಮ್ರಾಜ್ಯಾಧಿಪತಿ<br><b>निष्पत्तिः - </b>अधि+राजृ (दीप्तौ) “क्विप्” (३-२-६१) ।<br><b>व्युत्पत्तिः - </b>अधिराजते |<br><br>अधिराज्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕಕಾಂತಿಯುಳ್ಳ / ಹೆಚ್ಚು ಪ್ರಕಾಶಿಸುವ<br><b>निष्पत्तिः - </b>राजृ “क्विप्” (३-२-६१) |<br><b>व्युत्पत्तिः - </b>अधिकं राजते |<br><br>

अधिराज
अधिराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಕ್ರವರ್ತಿ / ಸಾಮ್ರಾಜ್ಯಾಧಿಪತಿ<br><b>व्युत्पत्तिः - </b>अधिको राजा ।<br><b>प्रयोगाः - </b>“शैल्धिराजतनया न ययौ न तस्थौ” |<br><b>उल्लेखाः - </b>कुमा० ५-८५ ।<br><br>

अधिराज्य
अधिराज्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಮ್ರಾಜ್ಯ / ಗಣರಾಜ್ಯ<br><b>व्युत्पत्तिः - </b>अधिकं राज्यम् ।<br><b>प्रयोगाः - </b>“भवानिव भूतले मलयकेतुः अधिराज्यमारोपितः” |<br><b>उल्लेखाः - </b>मुद्रा० ३ ।<br><br>

अधिराष्ट्र
अधिराष्ट्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ್ಯ / ಸಂಸ್ಥಾನ<br><b>व्युत्पत्तिः - </b>अधिकृतं राष्ट्रं यत्र ।<br><br>

अधिरूढ
अधिरूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹತ್ತಿರುವ<br><b>निष्पत्तिः - </b>अधि+रुह (बीजजन्मनि प्रादुर्भावे च) कर्त० “क्तः” (३-४-७२) ।<br><b>प्रयोगाः - </b>“पुराधिरूढः शयनं महाधनं विबोध्यसे यः स्तुतिगीतिमङ्गलैः” |<br><b>उल्लेखाः - </b>किरा० १-३८ ।<br><br>

अधिरोपण
अधिरोपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೇರಿಸುವುದು<br><br>अधिरोपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಿಸುವುದು<br><b>निष्पत्तिः - </b>अधि+रुह (बीजजन्मनि प्रादुर्भावे च) + णिच् “ल्युट्” (३-३-११५) ।<br><br>

अधिरोपित
अधिरोपित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೇರಿಸಲ್ಪಟ್ಟ<br><br>अधिरोपित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अधि+रुह (बीजजन्मनि प्रादुर्भावे च) + णिच् कर्म० “क्तः” (३-२-१०२) ।<br><br>

अधिरोहण
अधिरोहण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹತ್ತುವುದು<br><br>अधिरोहण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಿಸುವುದು<br><b>निष्पत्तिः - </b>अधि+रुह (बीजजन्मनि प्राद्रुभावे च) भावे “ल्युट्” (३-३-११५) |<br><br>

अधिरोहणी
अधिरोहणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಏಣಿ / ಸೋಪಾನ / ಮೆಟ್ಟಲು / ಹಂತ<br><br>

अधिलोक
अधिलोक<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಲೋಕದಲ್ಲಿ<br><b>निष्पत्तिः - </b>विभ० अव्ययी० ।<br><b>व्युत्पत्तिः - </b>लोके<br><br>

अधिवक्तृ
अधिवक्तृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಕೀಲ / ಒಂದು ಪಕ್ಷ ವಹಿಸಿ ಮಾತಾಡುವವನು<br><br>अधिवक्तृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಗ್ಮಿ / ಹೆಚ್ಚು ಮಾತಾಡುವವನು / ಚೆನ್ನಾಗಿ ಮಾತಾಡುವವನು<br><b>निष्पत्तिः - </b>अधि+वच (परिभाषणे) “तृन्” (३-२-१३५) ।<br><br>

अधिवचन
अधिवचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಕಾಲತ್ತು / ಏಕಪಕ್ಷದ ಮಾತು<br><br>अधिवचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಸರು / ಅಭಿಧಾನ<br><br>

अधिवाक
अधिवाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಕಾಲತ್ತು / ಏಕಪಕ್ಷದ ಮಾತು / ಒಂದೇ ಪಕ್ಷವನ್ನು ಹಿಡಿದು ಆಡುವ ಮಾತು<br><br>

अधिवास
अधिवास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಿತಿ / ವಾಸ / ಅವಿಚ್ಛಿನ್ನ ಸ್ಥಿತಿ<br><b>निष्पत्तिः - </b>अधि+वस (निवासे) “घञ्” (३-३-१८) ।<br><b>प्रयोगाः - </b>“सतताधिवाससुभग्र्पितस्तनम्” |<br><b>उल्लेखाः - </b>मालती० ५-८ ।<br><br>अधिवास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೌರಭ / ವಾಸನೆ / ಪರಿಮಳ<br><b>प्रयोगाः - </b>“ककुद्मिकन्यावक्त्रान्तर्वासलब्धाधिवासया” |<br><b>उल्लेखाः - </b>माघ० २-२० ।<br><br>अधिवास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗದ ಹಿಂದಿನ ದಿನದಲ್ಲಿ ಮಾಡುವ ದೇವತಾ ಸ್ಥಾಪನೆ<br><br>अधिवास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧೂಪದ ಹೊಗೆಯಿಂದ ವಾಸನೆ ಕಟ್ಟುವಿಕೆ<br><b>विस्तारः - </b>“अधिवासः स्यान्निवासे संस्कारे धूपनादिभिः” - हेम० ।<br><br>

अधिवासन
अधिवासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಧಮಾಲ್ಯಾದಿಗಳಿಂದ ವಾಸನೆಕಟ್ಟುವುದು<br><b>निष्पत्तिः - </b>अधि+वस (निवासे) +णिच् भावे “ल्युट्” (३-३-११५) ।<br><br>अधिवासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗದ ಹಿಂದಿನ ದಿನದಲ್ಲಿ ಮಾಡುವ ದೇವತಾ ಸ್ಥಾಪನೆ<br><br>

अधिवासित
अधिवासित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಸನೆ ಕಟ್ಟಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अधि+वस (निवासे)+णिच् कर्म० “क्तः” (३-२-१०२) ।<br><br>अधिवासित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಡಿಸಲ್ಪಟ್ಟ, ತೊಡಿಸಲ್ಪಟ್ಟ<br><br>अधिवासित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾಗದ ಹಿಂದಿನ ದಿನದಲ್ಲಿ ಸ್ಥಾಪಿಸಲ್ಪಟ್ಟ (ದೇವತೆ)<br><b>निष्पत्तिः - </b>अधि+वस (निवासे)+णिच् कर्म० “क्तः” (३-२-१०२) ।<br><br>

अधिवासिन्
अधिवासिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಸಮಾಡುವ<br><br>अधिवासिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಸನೆಕೊಡುವ<br><br>

अधिवाहन
अधिवाहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೇರಿಸುವುದು<br><br>अधिवाहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಒಯ್ಯುವುದು<br><br>अधिवाहन<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ವಾಹನವನ್ನು ಕುರಿತು<br><b>निष्पत्तिः - </b>विभ० अव्ययी० ।<br><br>

अधिविकर्तन
अधिविकर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವಿಕೆ<br><br>

अधिविद्य
अधिविद्य<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ವಿದ್ಯೆಯನ್ನು ಕುರಿತು / ವಿದ್ಯೆಯ ವಿಷಯವಾಗಿ<br><b>व्युत्पत्तिः - </b>विद्यामधिकृत्य ।<br><br>

अधिविन्ना
अधिविन्ना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠಪತ್ನಿ / ಹಿರಿಯ ಹೆಂಡತಿ / ಮೊದಲು ಮದುವೆಯಾದ ಹೆಂಡತಿ<br><b>व्युत्पत्तिः - </b>अधि उपरि विन्नं लाभोऽस्याः ।<br><br>अधिविन्ना<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊದಲು ಹೊಂದಿದ<br><b>प्रयोगाः - </b>“अवृणोदनधा कीर्तिरधिविन्नाप्सरोगणान्” |<br><b>उल्लेखाः - </b>याद० १६-९९ ।<br><br>

अधिवॆत्तव्या
अधिवॆत्तव्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನ ಪತ್ನಿಯು ಮತ್ತೊಂದು ಮದುವೆ ಮಾಡಿಕೊಳ್ಳಲು ಅರ್ಹತೆಯುಳ್ಳವಳು<br><b>निष्पत्तिः - </b>विद्लृ (लाभे) “तव्यः” (३-१-९६) ।<br><b>व्युत्पत्तिः - </b>अधिवेदयितुमर्हा |<br><br>

अधिवेत्तृ
अधिवेत्तृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿರಿಯಹೆಂಡತಿ ಇರುವಾಗ ಮತ್ತೊಂದು ಮದುವೆಯಾಗುವವನು<br><b>निष्पत्तिः - </b>अधि+विद्लृ (ल्भे) “तृच्” (३-१-१३३) ।<br><br>

अधिवेद
अधिवेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೊಂದು ಮದುವೆಯಾಗುವಿಕೆ<br><b>निष्पत्तिः - </b>अधि-विद्लृ (लाभे) भावे “घञ्” (३-३-१८) ।<br><br>अधिवेद<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ವೇದವನ್ನು ಕುರಿತು / ವೇದದ ವಿಷಯವಾಗಿ<br><b>व्युत्पत्तिः - </b>वेदमधिकृत्य ।<br><br>

अधिवेदन
अधिवेदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೊಂದು ಮದುವೆಯಾಗುವಿಕೆ<br><b>निष्पत्तिः - </b>अधि+विद्लृ (लाभे) भावे “ल्युट्” (३-३-११५) ।<br><br>

अधिवेदनीया
अधिवेदनीया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನ ಪತಿಯು ಮತ್ತೊಂದು ವಿವಾಹ ಮಾಡಿಕೊಳ್ಳಲು ಅರ್ಹಳಾದ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>अधि+विद्लृ (लाभे) “अनीयर्” (३-१-१६) ।<br><br>

अधिशयान
अधिशयान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಲಗಿರುವ<br><b>निष्पत्तिः - </b>अधि+शीङ् (स्वप्ने) “शानच्” (३-२-१२४) ।<br><br>

अधिश्रपण
अधिश्रपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಡಿಗೆ ಮಾಡಿಸುವುದು<br><b>निष्पत्तिः - </b>अधि+श्रा (पाके)+णिच् “ल्युट्” (३-३-११५)|<br><br>

अधिश्रय
अधिश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಲೆಯ ಮೇಲಿಟ್ಟು ಅಡಿಗೆ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>अधि+श्रीञ् (पाके) “अच्” (३-३-५६) ।<br><br>

अधिश्रयण
अधिश्रयण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಲೆಯ ಮೇಲೆ (ಅಡಿಗೆಮಾಡಲು) ಇಡುವುದು<br><b>निष्पत्तिः - </b>अधि+श्रीञ् (पाके) भावे “ल्युट्” (३-३-११५) |<br><b>व्युत्पत्तिः - </b>अधि उपरि श्रयणं (पाकार्थं) स्थापनम् |<br><br>अधिश्रयण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಡಿಗೆಯ ಮನೆ / ಮಹಾನಸ<br><b>निष्पत्तिः - </b>अधि+श्रीञ् अधि० “ल्युट्” (३-३-११७) ।<br><br>

अधिश्रयणी
अधिश्रयणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಲೆ<br><b>निष्पत्तिः - </b>अधि+श्रीञ् (पाके) अधि० “ल्युट्” (३-३-११७) । “डीप्” (४-१-१५) ।<br><br>

अधिश्रयणीय
अधिश्रयणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಡಿಗೆ ಮಾಡಲು ಅರ್ಹವಾದ / ಬೇಯಿಸಲು ಅರ್ಹವಾದ (ಪಾತ್ರೆ ಮೊದಲಾದುದು)<br><br>

अधिश्रित
अधिश्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯಿಸಲ್ಪಟ್ಟ / ಹೊಂದಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अधि+श्रिञ् (सेवायाम्) “क्तः” (३-२-१०२) ।<br><b>प्रयोगाः - </b>“विलोचने विभ्रदधिश्रितश्रिणी स पुण्डरीक्क्ष इति स्फुटोऽभवत्” |<br><b>उल्लेखाः - </b>माघ० १-२४ ।<br><br>

अधिश्री
अधिश्री<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕ ಕಾಂತಿಯುಳ್ಳ<br><br>अधिश्री<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕವಾದ ಐಶ್ವರ್ಯವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अधिका श्री यस्य ।<br><b>प्रयोगाः - </b>“समादिदेशाधिकृतानधिश्रीः” |<br><b>उल्लेखाः - </b>रघु० ७-२९ ।<br><br>

अधिष्ठातृ
अधिष्ठातृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಧಾನ / ನಾಯಕ / ಅಧ್ಯಕ್ಷ<br><br>अधिष्ठातृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯವಸ್ಥಾಪಕ<br><b>निष्पत्तिः - </b>अधि+ष्ठा (गतिनिवृत्तौ) “तृच्” (३-१-१३३) ।<br><br>

अधिष्ठात्री
अधिष्ठात्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯವಸ್ಥಾಪಕಿ<br><b>निष्पत्तिः - </b>स्त्रियाम् “डीप्” (४-१-५) ।<br><br>

अधिष्ठान
अधिष्ठान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>अधि+ष्ठा (गतिनिवृत्तौ) भावे “ल्युट्” (३-३-११५) ।<br><br>अधिष्ठान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ<br><br>अधिष्ठान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸಸ್ಥಾನ<br><b>निष्पत्तिः - </b>अधि+ष्ठा अधि० “ल्युट्” (३-३-११७) ।<br><br>अधिष्ठान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಕ್ರ / ಬಂಡಿಯ ಗಾಲಿ<br><b>निष्पत्तिः - </b>अधि+ष्ठा कर० “ल्युट्” (३-३-११७) ।<br><br>अधिष्ठान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಯಂತ್ರಣಶಕ್ತಿ<br><br>अधिष्ठान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾನ್ನಿಧ್ಯ / ಸಾಮೀಪ್ಯ<br><br>अधिष्ठान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ್ಯ ಆಧಿಪತ್ಯ<br><br>अधिष्ठान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಟ್ಟಣ<br><br>अधिष्ठान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಭಾವ<br><br>अधिष्ठान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಣ<br><b>विस्तारः - </b>“अधिष्ठानं पुरे चक्रे प्रभावेऽध्यासनेऽपि च” - मेदि० ।<br><br>अधिष्ठान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭ್ರಾಂತಿಗೆ ಕಾರಣಭೂತವಾದ ಅಜ್ಞಾನಕ್ಕೆ ವಿಷಯ / ಭ್ರಾಂತಿಯನ್ನು ಹೋಗಲಾಡಿಸುವ ಜ್ಞಾನಕ್ಕೆ ವಿಷಯ / ಆರೋಪದ ಅಧಿಕರಣ<br><b>विस्तारः - </b>(ವೇದಾಂತಿಗಳ ಮತದಲ್ಲಿ)<br><br>

अधिष्ठित
अधिष्ठित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯಿಸಲ್ಪಟ್ಟ / ಹತ್ತಲ್ಪಟ್ಟ / ಏರಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अधि+ष्ठा (गतिनिवृत्तौ) कर्म० “क्तः” (३-२-१०२) ।<br><b>प्रयोगाः - </b>“विलोक्य वृद्धोक्षमधिष्ठितं त्वया” |<br><b>उल्लेखाः - </b>कुमा० ५-७० ।<br><br>अधिष्ठित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>“ईश्वराधिष्ठिताः सर्वे स्वं स्वं कार्य हि कुर्वते” ।<br><br>अधिष्ठित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಸಮಾಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>“दनुकबन्धाधिष्ठितो दण्डकारण्यभागः” |<br><b>उल्लेखाः - </b>उ० रा० १ ।<br><br>अधिष्ठित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಟ್ಟ / ಸ್ವೀಕರಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>“अचिराधिष्ठितराज्यः शत्रुः प्रकृतिष्वरूढमूलत्वात्” |<br><b>उल्लेखाः - </b>माल० १-८ ।<br><br>अधिष्ठित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಿಸಲ್ಪಟ್ಟ / ಉಸ್ತುವಾರಿ ನೋಡಲ್ಪಟ್ಟ / ಮೇಲ್ವಿಚಾರಣೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>“आयरुन्धती वसिष्ठाधिष्ठितेषु रघुकुलकदम्बर्केषु” |<br><b>उल्लेखाः - </b>उ० रा० २ ।<br><br>अधिष्ठित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡೆಸಲ್ಪಟ್ಟ / ಮಾರ್ಗ ತೋರಿಸಲ್ಪಟ್ಟ / ಮುಂದೆ ಒಯ್ಯಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>“वसिष्ठाधिष्ठिता देव्यो गता राघवमातरः” |<br><b>उल्लेखाः - </b>उ० रा० १-३१ ।<br><br>

अधिहरि
अधिहरि<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಹರಿಯ ವಿಷಯವಾಗಿ / ಹರಿಯ ಸಂಬಂಧವಾಗಿ<br><b>व्युत्पत्तिः - </b>हरिमधिकृत्य ।<br><br>अधिहरि<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಹರಿಯಲ್ಲಿ<br><b>निष्पत्तिः - </b>विभ० अव्ययी० ।<br><b>व्युत्पत्तिः - </b>हरौ<br><br>

अधीकार
अधीकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>“अधिकार” ಪದದ ಅರ್ಥ<br><b>प्रयोगाः - </b>“स्वागतं स्वानधीकारान्” |<br><b>उल्लेखाः - </b>कुमा० २-१८ ।<br><br>

अधीत
अधीत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಧ್ಯಯನ / ವ್ಯಾಸ೦ಗ<br><b>निष्पत्तिः - </b>अधि+इङ् (अध्वयने) भावे “क्तः (३-३-११४) ।<br><br>अधीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಲಿಯಲ್ಪಟ್ಟ / ಅಧ್ಯಯನ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अधि+इङ् (अध्ययने) कर्म० “क्तः” (३-२-१०२) ।<br><b>प्रयोगाः - </b>“कदम्वमालाभिरधीतलास्यः” |<br><b>उल्लेखाः - </b>याद० २-७८ ।<br><br>

अधीति
अधीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಧ್ಯಯನ / ವ್ಯಾಸಂಗ / ವಿದ್ಯಾಭ್ಯಾಸ<br><b>निष्पत्तिः - </b>अधि+इङ् (अध्ययने) “क्तिन्” (३-३-९४) ।<br><b>प्रयोगाः - </b>“अधीतिबोबाचरणप्रचारणैः” |<br><b>उल्लेखाः - </b>नैष० १-४ ।<br><br>अधीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಮರಣೆ / ನೆನಪು<br><b>निष्पत्तिः - </b>अधि+इक् (स्मरणे) “क्तिन्” (३-३-९४) ।<br><br>

अधीतिन्
अधीतिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲಿತವನು / ಅಧ್ಯಯನ ಮಾಡಿದವನು<br><b>निष्पत्तिः - </b>“इनिः” (५-२-८८) ।<br><b>प्रयोगाः - </b>1. “अधीतिनो यत्र मम त्रिवेद्याम्” | 2. “कृताभिषेकां हुतजातवेदसं त्वगुत्तरासङ्गवतीमधीतिनीम्” |<br><b>उल्लेखाः - </b>1. याद० १८-६२ । 2. कुमा० ५-१६ ।<br><br>

अधीतिनी
अधीतिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲಿತವಳು / ಅಧ್ಯಯನ ಮಾಡಿದವಳು<br><br>

अधीन
अधीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸ್ವತಂತ್ರ / ಆಶ್ರಿತ / ಒಬ್ಬನ ವಶದಲ್ಲಿರುವ<br><b>व्युत्पत्तिः - </b>अधिगतः इनः स्वामी अनेन ।<br><b>प्रयोगाः - </b>1. “निरास्पदं प्रश्नकुतूहलित्वमस्मास्वधीनं किमु निःस्पृहाणाम्” | 2. “इक्श्वाकूणां दुरापेऽर्थे त्वदधीना हि सिद्धयः” |<br><b>उल्लेखाः - </b>1. किरा० ३-९ । 2. रघु० १-७२।<br><br>

अधीर
अधीर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯವುಳ್ಳ / ಧೈರ್ಯವಿಲ್ಲದ / ಅಂಜುಪುರಕ / ಹೇಡಿ<br><b>व्युत्पत्तिः - </b>धीरो न भवति ।<br><br>अधीर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಂಚಲ / ಚಪಲಚಿತ್ತವುಳ್ಳ<br><br>अधीर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸ್ಥಿರ / ಚಂಚಲ<br><b>प्रयोगाः - </b>“अशुक्नुवन् सोढुमधीरलोचनः” |<br><b>उल्लेखाः - </b>माघ० १-५३ ।<br><br>

अधीरा
अधीरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಿಂಚು<br><br>अधीरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಧೀರನಾಯಿಕೆ<br><b>प्रयोगाः - </b>“प्रियं मध्या दहेद्रोषादधीरा परुषोक्तिभिः” |<br><b>उल्लेखाः - </b>सा० द० ।<br><br>

अधीवास
अधीवास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೀರ್ಘಕವಚ / ದೇಹವನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ಮರೆಮಾಡುವ ಉದ್ದ ಕವಚ<br><br>

अधीश
अधीश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾರ್ವಭೌಮ / ಚಕ್ರವರ್ತಿ / ಅಧಿಪತಿ<br><b>व्युत्पत्तिः - </b>अधिकः ईशः ।<br><b>प्रयोगाः - </b>“दिशामधीशांश्चतुरो यतस्सुरानप्स्य तं रागहृताः सिषेविरे” |<br><b>उल्लेखाः - </b>माघ० १-४४ ।<br><br>

अधीश्वर
अधीश्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾರ್ವಭೌಮ / ಚಕ್ರವರ್ತಿ / ಅಧಿಪತಿ<br><b>व्युत्पत्तिः - </b>अधिकः ईश्वरः ।<br><br>

अधीष्ट
अधीष्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೌರವಪೂರ್ವಕವಾದ ಪ್ರಾರ್ಥನೆ<br><b>निष्पत्तिः - </b>अधि+इषु (इच्छायाम्) भावे “क्तः” (३-३-११४) ।<br><br>अधीष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೌರವಪೂರ್ವಕ ಪ್ರಾರ್ಥಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अधि+इषु कर्म० “क्तः” (३-२-१०२) ।<br><br>

अधुना
अधुना<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಈಗ / ಈ ಕಾಲದಲ್ಲಿ<br><b>निष्पत्तिः - </b>इदम् स्वार्थे “अधुना” (५-३-१७) ।<br><b>व्युत्पत्तिः - </b>अस्मिन् काले |<br><b>प्रयोगाः - </b>“प्रमदानामधुना विडम्बना” |<br><b>उल्लेखाः - </b>किरा० ४-१२ ।<br><br>

अधुनातन
अधुनातन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈಗಿನ ಕಾಲದ / ಈ ಕಾಲಕ್ಕೆ ಸಂಬಂಧಿಸಿದ<br><b>निष्पत्तिः - </b>“ट्युल्” तुट् च (४-३-२३) ।<br><br>

अधुनातनी
अधुनातनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಈಗಿನ ಕಾಲದ / ಈ ಕಾಲಕ್ಕೆ ಸಂಬಂಧಿಸಿದ<br><b>निष्पत्तिः - </b>स्त्रियां “डीप्” (४-१-१५) ।<br><br>

अधुर
अधुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಾರವಿಲ್ಲದ / ಹೊರೆಯಿಲ್ಲದ<br><br>अधुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧನವಿಲ್ಲದ / ಐಶ್ವರ್ಯವಿಲ್ಲದ<br><br>अधुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಕವಿಲ್ಲದ<br><br>अधुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧೂಪವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति धूर्भारः |<br><b>विस्तारः - </b>“वित्तं कम्पः धूपो वा भारे युगाग्रयोः” - नानार्थर० ।<br><br>

अधूमक
अधूमक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಗೆಯಿಲ್ಲದ ಬೆಂಕಿ / ಉರಿಯುತ್ತಿರುವ ಬೆಂಕಿ<br><b>निष्पत्तिः - </b>“कप्” (५-४-१५४) ।<br><b>व्युत्पत्तिः - </b>नास्ति धूमो यत्र |<br><br>

अधृत
अधृत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>न धृतः [सर्वेषां धारकत्वेन न केनापि धृतः] |<br><b>प्रयोगाः - </b>“अधृतः स्वधृतः स्वास्थ्यः” |<br><b>उल्लेखाः - </b>वि० स० ।<br><br>अधृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧರಿಸಲ್ಪಡದ<br><br>

अधृति
अधृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂತೋಷವಿಲ್ಲದಿರುವಿಕೆ<br><br>अधृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಗಿಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अधृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಧೈರ್ಯ<br><b>व्युत्पत्तिः - </b>न धृतिः ।<br><br>अधृति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧೈರ್ಯವಿಲ್ಲದ / ಹೇಡಿ<br><b>व्युत्पत्तिः - </b>न धृतिर्यस्य ।<br><br>

अधृष्ट
अधृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಕೋಚ ಸ್ವಭಾವದ / ಲಜ್ಜೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>न धृष्टः ।<br><br>अधृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧೈರ್ಯವಿಲ್ಲದ / ಭಯಸ್ವಭಾವದ<br><br>अधृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಯಿಸಲ್ಪಡದ / ಎದುರಿಸಲ್ಪಡದ<br><br>

अधृष्य
अधृष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಜೇಯ / ಜಯಿಸಲಾಗದ / ಎದುರಿಸಲಾಗದ<br><b>व्युत्पत्तिः - </b>न धृष्यः ।<br><b>प्रयोगाः - </b>“अध्ष्यश्चाभिगम्यश्च यादोरत्नैरिवार्णवः” |<br><b>उल्लेखाः - </b>रघु० १-१६ ।<br><br>अधृष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧೈರ್ಯವಿಲ್ಲದ / ಭಯಸ್ವಭಾವದ<br><br>अधृष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲಜ್ಜೆಯುಳ್ಳ / ನಾಚಿಕೆಯುಳ್ಳ<br><br>

अधेनु
अधेनु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಲು ಕರೆಯದ ಹಸು<br><b>निष्पत्तिः - </b>धीयते-धेट् (पाने) “नुः” (उ० ३-३४) ।<br><b>व्युत्पत्तिः - </b>न० त० ।<br><br>

अधैर्य
अधैर्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭಯ / ಹೆದರಿಕೆ<br><br>अधैर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧೈರ್ಯವಿಲ್ಲದ<br><br>

अधोऽक्ष
अधोऽक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಾಡಿಯ ಕೆಳಗಿರುವ<br><br>अधोऽक्ष<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಗಾಡಿಯ ಕೆಳಗೆ<br><br>

अधोऽक्षज
अधोऽक्षज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>“निशम्य ताः शेषगवीरभिधातुमधोक्षजः” |<br><b>उल्लेखाः - </b>माघ० २-६८ ।<br><b>विस्तारः - </b>अधः कृतम् अक्षजमैन्द्रयिकं ज्ञानं येन, अक्षात् इन्द्रियात् जायते अक्षजमिन्द्रियजन्यं ज्ञानं अधः अक्षजं येनेति वा ।<br><br>

अधोगति
अधोगति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಗೆ ಬೀಳುವುದು / ಇಳಿಕೆ / ಕ್ಷೀಣಗತಿ<br><br>अधोगति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಳಿಜಾರು / ಕೆಳಕ್ಕೆ ಇಳಿಯುವುದು<br><br>अधोगति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನರಕ ಪ್ರಾಪ್ತಿ<br><br>

अधोगामिन्
अधोगामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನರಕಕ್ಕೆ ಹೋಗುವ<br><br>अधोगामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಹೋಗುವ / ಕೆಳಕ್ಕೆ ಇಳಿಯುವ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) “णिनिः” (३-२-७८) ।<br><b>व्युत्पत्तिः - </b>अधः गच्छति |<br><br>

अधोगामिनी
अधोगामिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಹೋಗುವ / ಕೆಳಕ್ಕೆ ಇಳಿಯುವ<br><b>निष्पत्तिः - </b>स्त्रीयाम् “डीप्” (४-१-५) ।<br><br>

अधोजानु
अधोजानु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಡಿಯ ಕೆಳಭಾಗ<br><br>अधोजानु<br><br><b>पदविभागः - </b>अव्ययम्<br><br>

अधोजिह्विका
अधोजिह्विका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರುನಾಲಿಗೆ<br><b>निष्पत्तिः - </b>अल्पाजिह्वा “कन्” (५-३-८५) ।<br><b>व्युत्पत्तिः - </b>अधः जिह्विका ।<br><br>

अधोदारु
अधोदारु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಲುವಿನ ಕೆಳಭಾಗದ ಮರ<br><br>

अधोदृष्टि
अधोदृष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳನೋಟ<br><br>अधोदृष्टि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳನೋಟವುಳ್ಳ<br><br>अधोदृष्टि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯೋಗಾಭ್ಯಾಸದ ಸಮಯದಲ್ಲಿ ಮೂಗಿನ ತುದಿಯಲ್ಲಿ ಮಾತ್ರ ದೃಷ್ಟಿಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अधः दृष्टिर्यस्य ।<br><br>

अधॊभक्त
अधॊभक्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಊಟವಾದ ಮೇಲೆ ಕುಡಿಯುವ ನೀರು<br><b>व्युत्पत्तिः - </b>अधः भक्तं यस्मात् ।<br><br>

अधोभाग
अधोभाग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹದ ಕೆಳಭಾಗ<br><br>अधोभाग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಭಾಗ<br><br>

अधोभुवन
अधोभुवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾತಾಳಲೋಕ<br><b>व्युत्पत्तिः - </b>अधश्च तद्भुवनं च ।<br><br>

अधोमुख
अधोमुख<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>(ಜ್ಯೋತಿಶಾಸ್ತ್ರದಲ್ಲಿ) ಕೆಳಮುಖವಾಗಿ ಸಂಚರಿಸುವ ನಕ್ಷತ್ರ<br><b>विस्तारः - </b>(ಜ್ಯೋತಿಶಾಸ್ತ್ರದಲ್ಲಿ) ಕೆಳಮುಖವಾಗಿ ಸಂಚರಿಸುವ ನಕ್ಷತ್ರ: ಮೂಲ, ಆಶ್ಲೇಷ, ಕೃತ್ತಿಕೆ, ವಿಶಾಖೆ, ಭರಣಿ, ಮಖೆ, ಪೂರ್ವಫಲ್ಗುನಿ, ಪೂರ್ವಾಷಾಢ ಮತ್ತು ಪೂರ್ವಾಭಾದ್ರ ನಕ್ಷತ್ರಗಳು ಕೆಳಮುಖವುಳ್ಳವುಗಳು.<br><br>अधोमुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಮುಖವಾದ<br><br>अधोमुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿದ ಮುಖವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अधः मुखं यस्य ।<br><b>प्रयोगाः - </b>“अधोमुखैरूर्ध्वमुखैश्च पत्रिभिः” |<br><b>उल्लेखाः - </b>रघु० ३-५७ ।<br><br>

अधोमुखी
अधोमुखी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಡೆಗಿಡ<br><br>

अधोमुखा
अधोमुखा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಡೆಗಿಡ<br><br>

अधोलोक
अधोलोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾತಾಳಲೋಕ<br><br>

अधोवायु
अधोवायु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಪಾನವಾಯು / ಕೆಳಮುಖವಾಗಿ ಸಂಚರಿಸುವ ವಾಯು<br><br>

अध्यक्ष
अध्यक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಭಾನಾಯಕ / ಅಗ್ರಾಸನಾಢಿಪತಿ<br><br>अध्यक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಿಪತಿ / ಒಡೆಯ / ಪ್ರಭು<br><b>प्रयोगाः - </b>“यदध्यक्षेण जगतां वयमारोपितास्त्वया” |<br><b>उल्लेखाः - </b>कुमा० ६-१७ ।<br><br>अध्यक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಖ್ಯಾಧಿಕಾರಿ / ಇಲಾಖೆಯ ಮೊಕ್ತೇಸರ<br><b>व्युत्पत्तिः - </b>अधिगतोऽक्षं व्यवहारम् ।<br><br>अध्यक्ष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯಕ್ಷಜ್ಞಾನ<br><b>व्युत्पत्तिः - </b>अधिगतमक्षमिन्द्रियम् ।<br><br>अध्यक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯಕ್ಷಜ್ಞಾನ ಗೋಚರವಾದ<br><br>अध्यक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಪಕ / ಎಲ್ಲದರಲ್ಲಿಯೂ ಹರಡಿರುವ<br><b>निष्पत्तिः - </b>अक्षू (व्याप्तौ) । “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अधि उपरि अक्ष्णोति व्याप्नोति |<br><br>

अध्यक्षर
अध्यक्षर<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಅಕ್ಷರಗಳನ್ನು ಕುರಿತು / ಅಕ್ಷರಗಳ ವಿಷಯವಾಗಿ<br><b>निष्पत्तिः - </b>विभ० अव्ययी० (२-२-६) ।<br><b>व्युत्पत्तिः - </b>अक्षरेषु अध्यक्षरम् |<br><br>

अध्यग्नि
अध्यग्नि<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹಸಮಯದಲ್ಲಿ ಅಗ್ನಿಯ ಮುಂದೆ ಹೆಂಗಸರಿಗೆ ಕೊಡುವ ಧನ / ಸ್ತ್ರೀಧನ<br><b>प्रयोगाः - </b>“अध्यग्न्यध्यावाहनिकं दत्तं च प्रीतिकर्मणि । भ्रातृमातृपितृप्ताप्तं षड्व्धं स्त्रीधनं स्मृतम्” ||<br><b>उल्लेखाः - </b>मनु० ९-१९४ ।<br><b>विस्तारः - </b>ಆರು ವಿಧಸ್ತ್ರೀಧನಗಳಲ್ಲೊಂದು.<br><br>अध्यग्नि<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯಲ್ಲಿ<br><br>अध्यग्नि<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಸಮೀಪದಲ್ಲಿ<br><b>निष्पत्तिः - </b>विभ० सामीप्ये वा अव्ययी० ।<br><b>व्युत्पत्तिः - </b>अग्नौ अग्नेः समीपे वा ।<br><br>

अध्यधिक्षेप
अध्यधिक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಿಕವಾದ ಆಕ್ಷೇಪಣೆ / ಹೆಚ್ಚು ದೋಷಾರೋಪಣೆ<br><br>अध्यधिक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ತಿರಸ್ಕಾರ<br><br>

अध्यधीन
अध्यधीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣವಾಗಿ ಪರಾಧೀನನಾದ / ಚಾಕರ / ಗುಲಾಮ<br><br>

अध्यय
अध्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಧ್ಯಯನ / ವಿದ್ಯಾಭ್ಯಾಸ / ಶಿಕ್ಷಣ<br><br>अध्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಮರಣೆ / ನೆನಪು<br><b>निष्पत्तिः - </b>अधि+इङ् (अध्ययने) इक् (स्मरणे) वा भावे “अच्” (३-३-५६) ।<br><br>

अध्ययन
अध्ययन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿದ್ಯಾಭ್ಯಾಸ / ಕಲಿಯುವಿಕೆ / ಶಿಕ್ಷಣ / ವೇದಾಭ್ಯಾಸ<br><b>निष्पत्तिः - </b>अधि+इङ् (अध्ययने) “ल्युट्” (३-३-११५) ।<br><b>प्रयोगाः - </b>“यद्वेदाध्ययनं तथोपनिषदां साङ्ख्यस्य योगस्य च” |<br><b>उल्लेखाः - </b>मालती० १-१० ।<br><br>

अध्यर्ध
अध्यर्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಧದಿಂದ ಕೂಡಿದ / ಅರ್ಧಭಾಗದೊಡನೆ ಸೇರಿಕೊಂಡಿರುವ<br><b>व्युत्पत्तिः - </b>अधिकमर्घं यस्य ।<br><b>प्रयोगाः - </b>“एकाधिकं हरेज्ज्येष्टः पुत्रोऽध्यर्धं ततोऽनुजः” |<br><b>उल्लेखाः - </b>मनु० ९-११७ ।<br><br>

अध्यवसान
अध्यवसान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿರ್ಧಾರ / ಅವಧಾರಣ / ನಿಶ್ಚಯ<br><br>अध्यवसान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನ<br><b>निष्पत्तिः - </b>अधि+अव+षो (अन्तकर्मणि) “घञ्” (३-३-१८) ।<br><br>

अध्यवसाय
अध्यवसाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯ/ ಅವಧಾರಣ / ನಿರ್ಣಯ<br><br>अध्यवसाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನ<br><br>अध्यवसाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹ / ದೃಢಸಂಕಲ್ಪ<br><b>निष्पत्तिः - </b>अधि+अव+षो (अन्तकर्मणि) “घञ्” (३-३-१८) ।<br><br>

अध्यवसायिन्
अध्यवसायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೃಢಮನಸ್ಸುಳ್ಳ / ನಿಶ್ಚಯವುಳ್ಳ<br><br>अध्यवसायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹವುಳ್ಳ<br><br>अध्यवसायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನವುಳ್ಳ<br><b>निष्पत्तिः - </b>“इनिः” (५-२-११५) ।<br><b>व्युत्पत्तिः - </b>अध्यवसायोऽस्यास्ति |<br><br>

अध्यवसित
अध्यवसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನ ಮಾಡಲ್ಪಟ್ಟ<br><br>अध्यवसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अधि+अव+षो (अन्तकर्मणी) कर्म० “क्तः” (३-२-१०२) ।<br><br>

अध्यवहनन
अध्यवहनन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಟ್ಟಿದ ಧಾನ್ಯವನ್ನು ಮತ್ತೆ ಕುಟ್ಟುವುದು<br><b>व्युत्पत्तिः - </b>अधि उपरि अवहननम् ।<br><br>

अध्यशन
अध्यशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಿಕ ಭೋಜನ / ಮಿತಿ ಮೀರಿದ ಊಟ<br><b>व्युत्पत्तिः - </b>अधिकमशनम् ।<br><b>प्रयोगाः - </b>“साजीर्णे भुज्यते यत्तु तदध्यशनुमुच्यते” |<br><b>उल्लेखाः - </b>सुश्रु० ।<br><b>विस्तारः - </b>[ತಿಂದ ಆಹಾರವು ಜೀರ್ಣವಾಗುವುದಕ್ಕೆ ಮುಂಚೆ ಮತ್ತೆ ಊಟಮಾಡುವುದು.]<br><br>

अध्यस्त
अध्यस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನ್ಯಾಯವಾಗಿ ತಪ್ಪು ಹೊರಿಸಲ್ಪಟ್ಟ<br><br>अध्यस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಪ್ಪಾಗಿ ತಿಳಿಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अधि+असु (क्षेपणे) “क्तः” (३-२-१०२) ।<br><b>व्युत्पत्तिः - </b>शुक्तौ रजतमध्यस्तम् ।<br><br>

अध्यात्म
अध्यात्म<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆತ್ಮನನ್ನು ಕುರಿತು / ಆತ್ಮನ ಸಂಬಂಧವಾಗಿ<br><br>अध्यात्म<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ದೇಹವನ್ನು ಕುರಿತು / ದೇಹದ ಸಂಬಂಧವಾಗಿ<br><br>अध्यात्म<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪರಬ್ರಹ್ಮನನ್ನು ಕುರಿತು / ಪರಬ್ರಹ್ಮ ಸಂಬಂಧವಾದ<br><b>व्युत्पत्तिः - </b>आत्मानमधिकृत्य ।<br><br>

अध्यात्मज्ञान
अध्यात्मज्ञान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮಜ್ಞಾನ / ಬ್ರಹ್ಮಜ್ಞಾನ<br><br>

अध्यात्मविद्या
अध्यात्मविद्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮವಿದ್ಯೆ / ಬ್ರಹ್ಮಸ್ವರೂಪಪ್ರತಿಪಾದಕ ಉಪನಿಷತ್ತು<br><b>व्युत्पत्तिः - </b>आत्मानं ब्रह्म अधिकृत्य विद्या ।<br><b>प्रयोगाः - </b>“त्रयी विग्रहवत्येव सममध्यात्मविद्यय्” |<br><b>उल्लेखाः - </b>माल० १-१४ ।<br><br>

अध्यात्मदृश्
अध्यात्मदृश्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಜ್ಞಾನ<br><b>व्युत्पत्तिः - </b>अध्यात्मं दृक् ।<br><b>प्रयोगाः - </b>“गृहीतमध्यात्मदृशा कथञ्चन” |<br><b>उल्लेखाः - </b>माघ० १-३३ ।<br><br>अध्यात्मदृश्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆತ್ಮಸ್ವರೂಪವನ್ನು ತಿಳಿದವನು / ಬ್ರಹ್ಮಜ್ಞಾನವುಳ್ಳವನು<br><b>निष्पत्तिः - </b>दृशिर् (प्रेक्षणे) “क्विप्” (३-२-१७८) ।<br><b>व्युत्पत्तिः - </b>अध्यात्मं पश्यति |<br><br>

अध्यात्मयोग
अध्यात्मयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮನಲ್ಲಿ ಮನಸ್ಸನ್ನು ಇಡುವುದು / ಬಾಹ್ಯ ವಿಷಯಗಳಲ್ಲಿ ಮನಸ್ಸಿಡದೆ ಮಾಡುವ ಪರಮಾತ್ಮನ ಧ್ಯಾನ<br><b>व्युत्पत्तिः - </b>आत्मानमधिकृत्य योगः ।<br><b>प्रयोगाः - </b>“अध्यात्मयोगाधिगमेन देवं मत्वा धीरो हर्षशोकौ जहाति” ।<br><br>

अध्यात्मशास्त्र
अध्यात्मशास्त्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮಸ್ವರೂಪವನ್ನು ತಿಳಿಸುವ ಶಾಸ್ತ್ರ<br><b>व्युत्पत्तिः - </b>अध्यात्मप्रतिपादकं शास्त्रम् ।<br><br>

अध्यापक
अध्यापक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇದಾಧ್ಯಯನ ಮಾಡಿಸುವವನು / ಉಪಾಧ್ಯಾಯ<br><b>निष्पत्तिः - </b>अधि+इङ् (अध्ययने)+णिच् “ण्वुल्” (३-१-१३३) ।<br><b>व्युत्पत्तिः - </b>अध्यापयति |<br><br>

अध्यापन
अध्यापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಕ್ಷಣ / ಉಪದೇಶ<br><b>निष्पत्तिः - </b>अधि+इङ् (अध्ययने) +णिच् “ल्युट्” (३-३-११५) ।<br><b>प्रयोगाः - </b>1. “अध्यापनं च त्रिविधं धर्मार्थमृक्यकारणम् । शुश्रूषाकारणं चेति त्रिविधं परिकीर्तितम्” || 2. “योऽधर्मेणाह यश्चाधर्मेण पृच्छति । तयोरन्तरः प्रैति विद्वेषं वाधिगच्छति” ||<br><b>उल्लेखाः - </b>1. हारीत० । 2. हारीत० ।<br><b>विस्तारः - </b>ಉಪದೇಶವು ಧರ್ಮಕ್ಕಾಗಿಯೂ ಅರ್ಥಕ್ಕಾಗಿಯೂ ಶುಶ್ರೂಷೆಗಾಗಿಯೂ ಮೂರು ವಿಧವಾಗಿ ನಡೆಯತಕ್ಕದ್ದು. ಧರ್ಮಾರ್ಥಗಳಾಗಲೀ ಶುಶ್ರೂಷೆಯಾಗಲೀ ಇಲ್ಲದವನಿಗೆ ವಿದ್ಯಾದಾನ ಮಾಡಕೂಡದು. ಮತ್ತು ಅಧರ್ಮದಿಂದ ಉಪದೇಶ ಮಾಡುವುದೂ ಅಧರ್ಮದಿಂದ (ಮರ್ಯಾದೆ ಮೀರಿ) ಪ್ರಶ್ನೆಮಾಡುವುದೂ ಮನಃ ಕಾಲುಷ್ಯಕ್ಕೆ ಕಾರಣವಾದುದರಿಂದ ಅಂತಹ ಉಪದೇಶವು ಕೂಡದು.<br><br>

अध्यापित
अध्यापित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಲಿಸಲ್ಪಟ್ಟ / ಓದಿಸಲ್ಪಟ್ಟ / ಉಪದೇಶಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अधि+इङ् (अध्ययने)+णिच् “क्तः” (३-२-१०२) ।<br><b>प्रयोगाः - </b>“अध्यापितस्योशनसापि नीतिम्” |<br><b>उल्लेखाः - </b>कुमा० ३-६ ।<br><br>

अध्याप्य
अध्याप्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಲಿಸಲು ಅರ್ಹನಾದ / ಪಾಠಹೇಳಲು ಅರ್ಹನಾದ (ಶಿಷ್ಯ)<br><b>निष्पत्तिः - </b>अधि+इङ् (अध्ययने)+णिच् “यत्” (३-१-९७) ।<br><b>व्युत्पत्तिः - </b>अध्यापयितुमर्हः |<br><br>अध्याप्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉಪದೇಶಮಾಡಿ / ಕಲಿಸಿ<br><b>निष्पत्तिः - </b>अधि+इङ्+णिच् “ल्युप्” (७-१-३७) ।<br><br>अध्याप्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿ / ಪಡೆದು<br><b>निष्पत्तिः - </b>अधि+आप्लृ (व्याप्तौ) “ल्युप्” (७-१-३७) ।<br><br>

अध्याय
अध्याय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಧ್ಯಯನ / ವ್ಯಾಸಂಗ<br><b>निष्पत्तिः - </b>अधि+इङ् (अध्ययने) “घञ्” (३-३-२१) ।<br><br>अध्याय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಂಥಗಳಲ್ಲಿ ಆಯಾ ಪ್ರಕಾರಣಗಳನ್ನು ನಿಲ್ಲಿಸುವ ಭಾಗ<br><br>

अध्यारूढ
अध्यारूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏರಿದ / ಹತ್ತಿದ<br><br>अध्यारूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಿಸಿದ<br><br>अध्यारूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕವಾದ / ಹೆಚ್ಚಾದ / ಮೇಲಾದ<br><br>अध्यारूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧ್ಯಯನ / ವ್ಯಾಸಂಗ<br><b>निष्पत्तिः - </b>अधि+आ+रुह (बीजजन्मादौ) कर्त० “क्तः” (३-४-७२) ।<br><br>अध्यारूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಲ್ಪಟ್ಟ<br><br>अध्यारूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अधि+आ+रुह कर्म० “क्तः” (३-२-१०२) ।<br><b>प्रयोगाः - </b>“अतोऽध्यारूढानां पदमसुजनद्वेषजननम्” |<br><b>उल्लेखाः - </b>मुद्रा० ५-१२ ।<br><br>

अध्यारोप
अध्यारोप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಿಥ್ಯಜ್ಞಾನ / ತಪ್ಪು ತಿಳಿವಳಿಕೆ / ಭ್ರಾಂತಿ / ಒಂದು ವಸ್ತುವಿನಲ್ಲಿ ಮತ್ತೊಂದು ವಸ್ತುವಿನ ಜ್ಞಾನ<br><b>निष्पत्तिः - </b>अधि+आ+रुह (बीजजन्मादौ)+णिच् “घाञ्” (३-३-१९) ।<br><b>विस्तारः - </b>[ರಜ್ಜು (ಹಗ್ಗ)ವಿನಲ್ಲಿ ಸರ್ಪದ ಬುದ್ಧಿಯಂತೆ.]<br><br>

अध्यारोपण
अध्यारोपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಿಕಪಡಿಸುವುದು / ಹೆಚ್ಚಿಸುವುದು<br><br>अध्यारोपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏರಿಸುವುದು<br><br>अध्यारोपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯವನ್ನು ಬಿತ್ತುವುದು<br><b>निष्पत्तिः - </b>अधि+आ+रुह (बीजजन्मादौ)+णिच् “ल्युट्” (३-३-११७) । हस्य “पः” (७-३-४३) ।<br><br>

अध्यावाहनिक
अध्यावाहनिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತ್ರೀಧನ / ಪತಿಗೃಹಕ್ಕೆ ಹೊರಟುಬರುವಾಗ ತಂದೆಯ ಮನೆಯಲ್ಲಿ ಹೆಂಗಸಿಗೆ ಕೊಡುವ ಧನ<br><b>निष्पत्तिः - </b>अधि+आ+वह (प्रापणे) “ल्युट्” (३-३-११५) । “ठञ्” (४-३-११) ।<br><b>व्युत्पत्तिः - </b>अध्यावाहने पितृगृहात् भर्तृगृहागमनकाले लब्धं धनम् ।<br><b>प्रयोगाः - </b>“यत्पुनर्लभते नारी न्यमाना हि पैतृक्त् । अध्यावाहनिकं नाम स्त्रीधनं परिकीर्तितम्” ||<br><b>उल्लेखाः - </b>कात्या० ।<br><br>

अध्यास
अध्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಿಥ್ಯಾಜ್ಞಾನ / ಭ್ರಾಂತಿ / ತಪ್ಪು ತಿಳಿವಳಿಕೆ / ಇಲ್ಲದೇ ಇರತಕ್ಕ ಸ್ಥಳದಲ್ಲಿ ಇದ್ದಹಾಗೆ ತೋರುವುದು<br><b>निष्पत्तिः - </b>अधि+असु (क्षेपणे) “घञ्” (३-३-१८) ।<br><b>विस्तारः - </b>[ಸರ್ಪವಲ್ಲದ ರಜ್ಜುವಿನಲ್ಲಿ ಸರ್ಪದ ಭ್ರಾಂತಿಯಂತೆ ಜಗತ್ತಿನ ಸ್ವರೂಪವಲ್ಲದ ಬ್ರಹ್ಮನಲ್ಲಿ ಜಗತ್ತಿನ ಆರೋಪವು ಅಧ್ಯಾಸವೆನಿಸುವುದು.]<br><br>

अध्यासन
अध्यासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸಸ್ಥಾನ<br><b>निष्पत्तिः - </b>अधि+आस (उपवेशने) “ल्युट्” (३-३-११७) ।<br><br>अध्यासन<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಸನದಲ್ಲಿ / ಪೀಠದಲ್ಲಿ<br><b>निष्पत्तिः - </b>विभ० अव्ययी० (२-१-६) ।<br><b>व्युत्पत्तिः - </b>आसने<br><br>

अध्यासित
अध्यासित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಣ / ಹಿಡಿಯುವಿಕೆ<br><b>निष्पत्तिः - </b>अधि+आस (उपवेशने) भावे “क्तः” (३-३-११४) ।<br><b>प्रयोगाः - </b>“धेन्वा तदध्यासितकातराक्ष्या” |<br><b>उल्लेखाः - </b>रघु० २-५२ ।<br><br>अध्यासित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯಿಸಲ್ಪಟ್ಟ<br><br>अध्यासित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अधि+आस “क्तः” (३-२-१०२) ।<br><b>प्रयोगाः - </b>“अध्यासिता योगिभिरस्य नित्यम्” |<br><b>उल्लेखाः - </b>याद० १८-८ ।<br><br>

अध्याहार
अध्याहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಊಹೆ<br><br>अध्याहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥಪೂರ್ತಿಗಾಗಿ ಸಾಲದಿರುವ ಪದ ಅಥವಾ ಅರ್ಥಗಳನ್ನು ಸೇರಿಸಿಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>अधि+आ+हृञ् (हरणे) “घञ्” (३-३-१८) ।<br><b>व्युत्पत्तिः - </b>अध्याह्रियते |<br><br>

अध्यूढ
अध्यूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಿಸಲ್ಪಟ್ಟ<br><br>अध्यूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏರಿಸಲ್ಪಟ್ಟ<br><br>अध्यूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಐಶ್ವರ್ಯವುಳ್ಳ / ಸಮೃದ್ಧ / ಧನಾಢ್ಯನಾದ<br><b>व्युत्पत्तिः - </b>अधि उपरि ऊढः ।<br><br>

अध्यूढा
अध्यूढा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿರಿಯ ಹೆಂಡತಿ / ಅನೇಕ ಪತ್ನಿಯರುಳ್ಳವನ ದೊಡ್ಡ ಹೆಂಡತಿ<br><b>व्युत्पत्तिः - </b>अधि उपरि ऊढमुद्बहनमस्याः ।<br><br>

अध्यूध्नी
अध्यूध्नी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತುಂಬಿದ ಕೆಚ್ಚಲುಳ್ಳ ಹಸು<br><b>निष्पत्तिः - </b>ऊधस् “अनङ्” (५-४-१३) । “ङीष्” (४-१-२५) ।<br><b>व्युत्पत्तिः - </b>अधिकमूघो यस्याः |<br><br>

अध्यॆतव्य
अध्यॆतव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧ್ಯಯನ ಮಾಡಲು ಅರ್ಹವಾದ<br><br>अध्यॆतव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಶ್ಯವಾಗಿ ಓದಬೇಕಾದ<br><b>निष्पत्तिः - </b>अधि+इङ् (अध्ययने) “तव्यः” (३-१-९६) |<br><br>

अध्येषणा
अध्येषणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಜ್ಞಾಪನೆ / ಪ್ರಾರ್ಥನೆ / ಆಚಾರ್ಯರನ್ನು ಗೌರವದಿಂದ ಬೇಡುವುದು<br><b>निष्पत्तिः - </b>अधि+इष (आभीक्ष्ण्ये) “युच्” (वा० ३-३-१०७) ।<br><b>विस्तारः - </b>ಈ ಅರ್ಥದಲ್ಲಿ अध्येषणं ಎಂದು ನಪುಂಸಕಲಿಂಗದಲ್ಲಿಯೂ ಪ್ರಯೋಗವುಂಟು.<br><br>अध्येषणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಿಕವಾದ ಪ್ರಾರ್ಥನೆ / ಹೆಚ್ಚು ಬೇಡಿಕೆ<br><br>

अध्रि
अध्रि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಯಲಾಗದ / ಎದುರಿಸಲಾಗದ / ಅಜೇಯವಾದ<br><br>

अध्रिगू
अध्रिगू<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಿಸಲಾಗದ ಸಂಚಾರವುಳ್ಳ<br><br>

अध्रुव
अध्रुव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಂಚಲವಾದ / ಚಲಿಸುವ ಸ್ವಭಾವದ<br><br>अध्रुव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಥಿರವಾದ / ಶಾಶ್ವತವಲ್ಲದ<br><br>अध्रुव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯವಿಲ್ಲದ / ಸಂದೇಹಾಸ್ಪದವಾದ<br><b>व्युत्पत्तिः - </b>न ध्रुवम् ।<br><b>प्रयोगाः - </b>“यो ध्रुवाणि परित्यज्य अध्रुवाणि निषेवते । ध्रुवाणि तस्य नश्यन्ति अध्रुवं नष्टमेव हि” ||<br><b>उल्लेखाः - </b>हितो० ।<br><b>विस्तारः - </b>ನಿಶ್ಚಿತವಾದ (ಕರಗತವಾದ) ಸ್ವಲ್ಪ ಪ್ರಯೋಜನವನ್ನು ಬಿಟ್ಟು ಸಂದೇಹಾಸ್ಪದವಾದ ಹೆಚ್ಚು ಪ್ರಯೋಜನಕ್ಕಾಗಿ ನಿರೀಕ್ಷಿಸುವವನು (ಆಸೆಪಡುವವನು) ಕರಗತವಾದ ಪ್ರಯೋಜನವನ್ನೂ ಕಳೆದುಕೊಳ್ಳುವನು.<br><br>

अध्रुष
अध्रुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಗಂಟಲು ರೋಗ / ರಕ್ತವು ಕೆಡುವುದರಿಂದ ಬರುವ ಊದಲು<br><br>

अध्वग
अध्वग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಥಿಕ / ದಾರಿ ನಡೆಯುವವನು<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) “डः” (३-----) ।<br><b>व्युत्पत्तिः - </b>अध्वानं गच्छति |<br><b>प्रयोगाः - </b>“सन्तानकतरुच्छाय्सुप्तविद्याधराध्वगम्” |<br><b>उल्लेखाः - </b>कुमा० |<br><br>अध्वग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಷ್ಟ್ರ / ಒಂಟೆ<br><b>विस्तारः - </b>“लम्बौष्ठाध्वगदासन्तकुलनाशमधुद्विपाः” - त्रिकाण्ड० ।<br><br>अध्वग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>अध्वग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಸರಗತ್ತೆ<br><br>

अध्वगा
अध्वगा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಗಾನದಿ<br><b>व्युत्पत्तिः - </b>अध्वगा |<br><br>

अध्वगत्
अध्वगत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಾರಿ ನಡೆಯುವವನು / ಪಥಿಕ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) “क्विप्” (३-२-७६) ।<br><b>व्युत्पत्तिः - </b>अध्वानं गच्छति |<br><br>

अध्वन्
अध्वन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾರ್ಗ / ದಾರಿ<br><b>निष्पत्तिः - </b>अद (भक्षणे) “कनिप्” “घ” च (उ० ४-११५) ।<br><b>व्युत्पत्तिः - </b>अत्ति बलं (पथिकानाम्) |<br><b>प्रयोगाः - </b>“अपि लङ्घितमध्वानं वुबुधे न बुधोपमः” |<br><b>उल्लेखाः - </b>रघु० १-४७ ।<br><br>अध्वन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾಶ / ವಾಯುಮಂಡಲ<br><br>अध्वन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲ<br><b>विस्तारः - </b>[ಕಾಲವು ಎಲ್ಲವನ್ನೂ ನುಂಗುವುದರಿಂದ ಈ ಹೆಸರು.] “अध्वा कालवत्र्मनोः” - हेम० ।<br><br>अध्वन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯಾಣ<br><b>प्रयोगाः - </b>“अध्वसु त्रिषु विसृष्टमैथिलः” |<br><b>उल्लेखाः - </b>रघु० ११-५७ ।<br><br>

अध्वनीन
अध्वनीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಥಿಕ / ದಾರಿ ನಡೆಯುವವನು<br><b>निष्पत्तिः - </b>“खः” (५-२-१६) ।<br><b>व्युत्पत्तिः - </b>अध्वानमलं गच्छति |<br><br>अध्वनीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾರಿ ನಡೆಯಲು ಸಮರ್ಥ<br><br>

अध्वन्य
अध्वन्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಥಿಕ / ದಾರಿ ನಡೆಯುವವನು<br><br>अध्वन्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾರಿ ನಡೆಯಲು ಸಮರ್ಥ<br><b>निष्पत्तिः - </b>“यत्” (५-२-१६) ।<br><b>व्युत्पत्तिः - </b>अध्वानमलं गच्छति |<br><br>

अध्वपति
अध्वपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>अध्वनि पतिः ।<br><b>विस्तारः - </b>[ರಾತ್ರಿಯ ವೇಳೆಯಲ್ಲಿ ಪ್ರಯಾಣವು ನಿಷಿದ್ಧ. ಹಗಲು ಮಾತ್ರ ಜನರು ಪ್ರಯಾಣ ಮಾಡುವುದರಿಂದ ಸೂರ್ಯನು ಪಥಿಕರ ರಕ್ಷಕನಾಗಿರುವನು.]<br><br>अध्वपति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾರಿಯಲ್ಲಿ ಕಾಪಾಡುವ<br><br>

अध्वर
अध्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗ / ಯಜ್ಞ<br><b>निष्पत्तिः - </b>रा (आदाने) “कः” (३-२-३) ।<br><b>व्युत्पत्तिः - </b>अध्वानं राति |<br><b>प्रयोगाः - </b>“तमध्वरे विश्वजिति क्षितीशं निःशेषविश्राणितकोशजातम्” |<br><b>उल्लेखाः - </b>रघु० ५-१ ।<br><br>अध्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಷ್ಟವಸುಗಳ ಪೈಕಿ ಎರಡನೆಯ ವಸು<br><br>

अध्वरमीमांसा
अध्वरमीमांसा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗದ ವಿಧಾನವನ್ನು ತಿಳಿಸುವ ಶಾಸ್ತ್ರ / ಮೀಮಾಂಸಾಶಾಸ್ತ್ರ<br><br>

अध्वर्यु
अध्वर्यु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜುರ್ವೇದವನ್ನು ತಿಳಿದ ಋತ್ವಿಕ್ಕು / ಯಾಗದಲ್ಲಿ ಹೋಮವನ್ನು ಮಾಡುವ ಋತ್ವಿಕ್ಕು<br><b>निष्पत्तिः - </b>“क्यच्” (३-१-८) । “उः” ((३-२-१७०) ।<br><b>व्युत्पत्तिः - </b>अध्वरमिच्छाति |<br><br>

अध्वशल्य
अध्वशल्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರಣೆ ಗಿಡ / ಮುಳ್ಳುತ್ತರಣೆ<br><b>व्युत्पत्तिः - </b>अध्वनि शल्यमिव |<br><b>विस्तारः - </b>[ದಾರಿಯಲ್ಲಿ ಹೋಗುವಾಗ ಇದರ ಮುಳ್ಳು ಬಟ್ಟೆಗೆ ಅಂಟಿಕೊಳ್ಳುವುದರಿಂದ ಈ ಹೆಸರು.]<br><br>

अध्वाति
अध्वाति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಥಿಕ / ದಾರಿ ನಡೆಯುವವನು<br><b>निष्पत्तिः - </b>अत (सातत्यगमने) “इण्” (उ० ४-१७०) ।<br><b>व्युत्पत्तिः - </b>अध्वानमतति |<br><br>

अध्वायन
अध्वायन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾತ್ರೆ / ಪ್ರಯಾಣ<br><b>व्युत्पत्तिः - </b>अध्वनि अयनं गतिः ।<br><br>

अन
अन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಣವಾಯು / ಶ್ವಾಸ / ಉಸಿರು<br><b>निष्पत्तिः - </b>अन (प्राणने) “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अनिति |<br><br>

अनक
अनक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀಚ / ಅಧಮ / ಕೆಳದರ್ಜೆಯವನು<br><br>

अनक्ष
अनक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>(ಕಣ್ಣು ಮೊದಲಾದ) ಇಂದ್ರಿಯವಿಲ್ಲದವನು<br><br>अनक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಕ್ರವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति अक्षं नेत्रादिकमिन्द्रियं चक्रं वा यस्य ।<br><br>अनक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಣ್ಣಿಲ್ಲದವನು / ಕುರುಡ<br><b>निष्पत्तिः - </b>“षच्” (५-४-११३) ।<br><b>व्युत्पत्तिः - </b>नास्ति अक्षि यस्य |<br><br>

अनक्षर
अनक्षर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದಾವಚನ / ಆಕ್ಷೇಪಣೆ / ಬೈಗಳು<br><b>व्युत्पत्तिः - </b>अप्रशस्तान्यक्षर्णि यत्र ।<br><br>अनक्षर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಕ್ಷರವಿಲ್ಲದ / ವಿದ್ಯೆಯಿಲ್ಲದ / ಮೂರ್ಖ<br><br>अनक्षर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾತಾಡಲಾರದವನು / ಮೂಗ<br><b>व्युत्पत्तिः - </b>न सन्त्यक्षराणि यस्य ।<br><br>अनक्षर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೌನವಾಗಿ / ಮಾತಿಲ್ಲದೆ<br><b>प्रयोगाः - </b>“अनक्षरव्यञ्जितदौहृदेन” |<br><b>उल्लेखाः - </b>रघु० १४-२६ ।<br><br>

अनक्षि
अनक्षि<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ರಶಸ್ತವಾದ ಕಣ್ಣು / ನೋಟದ ಶಕ್ತಿಯಿಲ್ಲದ ಕಣ್ಣು<br><b>व्युत्पत्तिः - </b>अप्रशस्तमक्षि ।<br><br>

अनगार
अनगार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂನ್ಯಾಸಿ / ಯತಿ<br><br>अनगार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನೆಯಿಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>नास्त्यगारं यस्य ।<br><br>

अनग्नि
अनग्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂನ್ಯಾಸಿ / ಯತಿ<br><br>अनग्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಕಾರ್ಯ (ಔಪಾಸನಾದಿಗಳು)ವನ್ನಿಟ್ಟುಕೊಳ್ಳದ ಗೃಹಸ್ಥ<br><b>व्युत्पत्तिः - </b>नास्ति अग्निः श्रौतः स्मार्तो वा यस्य ।<br><b>प्रयोगाः - </b>“अनग्निरनिकेतः स्यान्मुनिर्मूलफलाशनः” |<br><b>उल्लेखाः - </b>मनु० ६-२५ ।<br><br>अनग्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಚಾರಿ<br><br>अनग्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಧುರ / ವೈದಿಕಾಗ್ನಿಯಿಲ್ಲದವನು<br><br>अनग्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಾರ್ಮಿಕ<br><br>अनग्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಸಂಸ್ಕಾರವಿಲ್ಲದ ಯಾಗ<br><br>अनग्नि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಠರಾಗ್ನಿಯಿಲ್ಲದ / ಅಜೀರ್ಣರೋಗವುಳ್ಳ<br><br>

अनग्निदग्ध
अनग्निदग्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಸಂಸ್ಕಾರವಿಲ್ಲದ / ಬೆಂಕಿಯಿಂದ ಸುಡಲ್ಪಡದ<br><br>

अनघ
अनघ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>“अनघो विजयो जेता” |<br><b>उल्लेखाः - </b>वि० स० ।<br><br>अनघ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ / ಈಶ್ವರ<br><br>अनघ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿ ಸಾಸುವೆ<br><br>अनघ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಮ್ಯವಾದ / ಸುಂದರವಾದ / ದೋಷವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति अघं यस्य ।<br><b>प्रयोगाः - </b>“अथागमानामनघेन भूम्ना” |<br><b>उल्लेखाः - </b>याद० २-१ ।<br><br>अनघ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುಃಖವಿಲ್ಲದ / ಸಂತೋಷವುಳ್ಳ<br><b>प्रयोगाः - </b>1. “अनघस्वाघतस्मितम्” | 2. “अनघस्थितिमन्तिमामवस्थाम्” |<br><b>उल्लेखाः - </b>1. याद० १-७५ । 2. याद० १५-१३१ ।<br><br>अनघ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪವಿಲ್ಲದ / ದೋಷವಿಲ್ಲದ<br><b>प्रयोगाः - </b>“अवैमि चैनामनघेति किन्तु” |<br><b>उल्लेखाः - </b>रघु० १४-४० ।<br><br>अनघ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುರಕ್ಷಿತವಾದ / ಯಾವ ತೊಂದರೆಯೂ ಇಲ್ಲದ<br><b>प्रयोगाः - </b>“कच्चिन्मृगीणामनघाः प्रसूतिः” |<br><b>उल्लेखाः - </b>रघु० ५-७ ।<br><br>अनघ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶುದ್ಧವಾದ / ಸ್ವಚ್ಛವಾದ / ಕಲ್ಮಷವಿಲ್ಲದ / ದೋಷವಿಲ್ಲದ<br><b>प्रयोगाः - </b>“धर्मस्य स्थितिमनघां विधातुकामः” |<br><b>उल्लेखाः - </b>याद० १-१०० ।<br><br>

अनङ्ग
अनङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥ<br><b>व्युत्पत्तिः - </b>नास्ति अङ्गमाकारो यस्य ।<br><b>प्रयोगाः - </b>“तां वीक्ष्य लीलाचतुरामनङ्गः” |<br><b>उल्लेखाः - </b>कुमा० १-४७ ।<br><br>अनङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾಶ / ಗಗನ<br><br>अनङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ತ / ಮನಸ್ಸು<br><b>विस्तारः - </b>“अनङ्गो मदनेऽनङ्गमाकाशमनसोरपि” - मेदि० ।<br><br>

अनङ्गक्रीडा
अनङ्गक्रीडा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸುರತ / ಕಾಮಲೀಲೆ<br><b>व्युत्पत्तिः - </b>अनङ्गेन क्रीडा ।<br><br>अनङ्गक्रीडा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವೃತ್ತ<br><br>

अनङ्गद
अनङ्गद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗದವಿಲ್ಲದ / ತೋಳಿನ ಆಭರಣವಿಲ್ಲದ<br><br>अनङ्गद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮವಿಕಾರವನ್ನುಂಟುಮಾಡುವ<br><b>प्रयोगाः - </b>“दर्शने दौहृदार्तौ च द्वयोरासीदनङ्गदा” |<br><b>उल्लेखाः - </b>चं० भा० ।<br><br>

अनङ्गलेख
अनङ्गलेख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೇಮಪತ್ರ / ಕಾಮವನ್ನು ಸೂಚಿಸುವ ಕಾಗದ<br><b>व्युत्पत्तिः - </b>अनङ्गव्यञ्जको लेखः ।<br><b>प्रयोगाः - </b>“अनङ्गलेखक्रिययोपयोगम्” |<br><b>उल्लेखाः - </b>कुमा० १-७ ।<br><br>

अनङ्गशत्रु
अनङ्गशत्रु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ / ಈಶ್ವರ<br><br>

अनच्छ
अनच्छ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಳೆಯಾದ<br><br>अनच्छ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಲದ / ನಿರ್ಮಲವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न अच्छः ।<br><br>

अनञ्जन
अनञ्जन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು / ನಾರಾಯಣ<br><b>व्युत्पत्तिः - </b>नास्ति अञ्जनं दोषो यस्य ।<br><br>अनञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಬ್ರಹ್ಮ<br><br>अनञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಗನ / ಆಕಾಶ / ವಾಯುಮಂಡಲ<br><br>अनञ्जन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧವಿಲ್ಲದ / ಸಂಪರ್ಕವಿಲ್ಲದ<br><br>अनञ्जन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೋಷವಿಲ್ಲದ / ಕಳಂಕವಿಲ್ಲದ<br><br>अनञ्जन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಜನವಿಲ್ಲದ / ಕಾಡಿಗೆ (ಕಣ್ಣುಕಪ್ಪು)ಯಿಲ್ಲದ<br><b>प्रयोगाः - </b>“नेत्रे द्रमनञ्जने पुलकिता तन्वीतवेयं तनुः” |<br><b>उल्लेखाः - </b>अमरु० ।<br><br>

अनडुज्जिह्वा
अनडुज्जिह्वा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಡೆಗಿಡ<br><b>व्युत्पत्तिः - </b>अनडुहो जिह्वेव ।<br><br>

अनडुह्
अनडुह्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಷಭ / ಎತ್ತು<br><br>अनडुह्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಷಭರಾಶಿ<br><b>निष्पत्तिः - </b>निपा० ।<br><b>व्युत्पत्तिः - </b>अनः शकटं वहति ।<br><br>

अनडुहा
अनडुहा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಳು / ಹಸು<br><b>निष्पत्तिः - </b>स्त्रियां “डीप्” (४-१-४१) ।<br><br>

अनड्वाही
अनड्वाही<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಳು / ಹಸು<br><br>

अनणु
अनणु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಪ್ಪಧಾನ್ಯ<br><b>विस्तारः - </b>(ಕಡಲೆ, ಬಟಾಣಿ ಮೊದಲಾದುವು)<br><br>अनणु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಥೂಲವಾದ / ದಪ್ಪವಾದ<br><br>

अनतिक्रमणीय
अनतिक्रमणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೀರಲಾಗದ / ಉಲ್ಲಂಘಿಸಲಾಗದ<br><b>प्रयोगाः - </b>“अनतिक्रमणीयात्ते शासनात्सुरनायक” |<br><b>उल्लेखाः - </b>कुमा० १०-६ ।<br><br>

अनतिचिर
अनतिचिर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕಾಲದ್ದಲ್ಲದ / ತತ್ಕಾಲದ<br><b>प्रयोगाः - </b>“अनतिचिरोज्झितस्य जलदेन” |<br><b>उल्लेखाः - </b>माघ० ४-४१ ।<br><br>

अनतिरिक्त
अनतिरिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕವಲ್ಲದ / ಬೇರೆಯಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न अतिरिक्तम् ।<br><br>

अनतिलङ्घन
अनतिलङ्घन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೀರದಿರುವುದು / ದಾಟದಿರುವುದು<br><br>

अनतिलङ्गनीय
अनतिलङ्गनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾಟಲರ್ಹವಲ್ಲದ / ಮೀರಲರ್ಹವಲ್ಲದ<br><b>निष्पत्तिः - </b>अति+लघ् (गतौ) “अनीयर्” (३-३-१६९) । लघि “अनीयर्” (३-१-१६) ।<br><b>व्युत्पत्तिः - </b>अतिलङ्घितुमहं न भवति | न अतिलङ्घ्यते |<br><br>

अनतिविलम्बिता
अनतिविलम्बिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾವಕಾಶವಾಗದಿರುವಿಕೆ<br><br>अनतिविलम्बिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂವತ್ತೈದು ವಾಗ್ಗುಣಗಳಲ್ಲಿ ಒಂದು ವಿಧ<br><br>

अनद्धा
अनद्धा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನಿಶ್ಚಯ<br><br>

अनद्धापुरुष
अनद्धापुरुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ರಾಮಾಣಿಕ / ನಂಬಿಕೆಯಿಲ್ಲದ ಪುರುಷ<br><br>

अनद्धापुरुष
अनद्धापुरुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವ ಮತ್ತು ಪಿತೃ ಕಾರ್ಯಗಳಲ್ಲಿ ವಿಶ್ವಾಸವಿಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>न अद्धा पुरुषः ।<br><br>

अनद्य
अनद्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿಸಾಸುವೆ<br><br>अनद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿನ್ನಲು ಯೋಗ್ಯವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न अद्यः ।<br><br>

अनद्यतन
अनद्यतन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂದಿನ ಮತ್ತು ಮುಂದಿನ ಕಾಲ / ಭೂತ ಮತ್ತು ಭವಿಷ್ಯತ್ಕಾಲ<br><b>व्युत्पत्तिः - </b>न अद्यतनः ।<br><b>विस्तारः - </b>[ಹಿಂದಿನ ರಾತ್ರಿಯ ಉತ್ತರಾರ್ಧ ಮತ್ತು ಮುಂದಿನ ರಾತ್ರಿಯ ಪೂರ್ವಾರ್ಧದಿಂದ ಕೂಡಿದ (ದಿವಸವು) ಮಧ್ಯಕಾಲವು ಅದ್ಯತನ]<br><br>अनद्यतन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈಗಿನದಲ್ಲದ / ಹಿಂದಿನ ಅಥವಾ ಮುಂದಿನ ಕಾಲದ<br><br>

अनधिकार
अनधिकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಕ್ಕಿಲ್ಲದಿರುವಿಕೆ / ಬಾಧ್ಯತೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>

अनधिकारचर्चा
अनधिकारचर्चा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಿಕಾರವಿಲ್ಲದ ವಿಷಯದಲ್ಲಿ ಮಾಡುವ ಚರ್ಚೆ / ತನಗೆ ಸಂಬಂಧ ಪಡೆದ (ಮತ್ತೊಬ್ಬರ) ವಿಷಯದಲ್ಲಿ ಚರ್ಚಿಸುವುದು<br><br>

अनधिकृत
अनधिकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕಾರ ಹೊಂದದ / ಹಕ್ಕುಪಡೆಯದ<br><b>व्युत्पत्तिः - </b>न अधिकृतः ।<br><br>

अनधिगत
अनधिगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಡದ<br><br>अनधिगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न अधिगतः ।<br><br>

अनधीन
अनधीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವತಂತ್ರ / ಇತರರಿಗೆ ಅಧೀನನಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>न अधीनः ।<br><br>

अनधीनक
अनधीनक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬರಿಗೂ ಅಧೀನನಲ್ಲದೆ ತನ್ನ ಮನೆಯಲ್ಲೇ ಸ್ವತಂತ್ರನಾಗಿ ಕೆಲಸಮಾಡುವ ಬಡಗಿ<br><b>निष्पत्तिः - </b>स्वार्थे “कन्” (५-४-५) ।<br><b>व्युत्पत्तिः - </b>न अधीनः |<br><b>विस्तारः - </b>“कौटतक्षोऽनधीनकः” - अम० ।<br><br>

अनध्यक्ष
अनध्यक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯಕ್ಷವಲ್ಲದ / ಅಗೋಚರವಾದ<br><br>अनध्यक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಜಮಾನನಿಲ್ಲದ / ಮೇಲ್ವಿಚಾರಕನಿಲ್ಲದ<br><br>

अनध्ययन
अनध्ययन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿದ್ಯಾಭ್ಯಾಸದ ವಿರಾಮ / ವ್ಯಾಸಂಗದ ವಿಶ್ರಾಂತಿ<br><br>

अनध्याय
अनध्याय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿದ್ಯಾಭ್ಯಾಸದ ವಿರಾಮ / ವ್ಯಾಸಂಗದ ವಿಶ್ರಾಂತಿ<br><b>व्युत्पत्तिः - </b>न अध्यायोऽध्ययनम् ।<br><br>अनध्याय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಧ್ಯಯನದ ವಿರಾಮಕಾಲ / ವ್ಯಾಸಂಗದ ಬಿಡುಗಾಲ<br><b>निष्पत्तिः - </b>अधि+इङ् (अध्ययने) अधि० “घञ्” (३-३-१२२) ।<br><b>व्युत्पत्तिः - </b>न अधीयते अस्मिन् काले |<br><br>

अनन
अनन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜೀವನ / ಉಸಿರಾಡುವಿಕೆ / ಜೀವಿಸಿರುವುದು<br><b>निष्पत्तिः - </b>अन (प्राणने) भावे “ल्युट्” (३-३-११५) ।<br><br>

अननुगत
अननुगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಾಧಾರಣ(ಧರ್ಮ) / ಸಮಾನತೆಯನ್ನು ಹೋಗಲಾಡಿಸುವ(ವಿಶೇಷಧರ್ಮ)<br><b>व्युत्पत्तिः - </b>न अनुगतः ।<br><br>अननुगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಿಸದ / ಅನುಸರಿಸಿ ಹೋಗದಿರುವ<br><br>अननुगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧೀನನಲ್ಲದ / ಸ್ವತಂತ್ರನಾದ<br><br>

अननुगम
अननुगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>(ಸಮಾನತೆಯನ್ನು ತೋರಿಸುವ) ಸಾಧಾರಣ ಧರ್ಮದ ಅಭಾವ<br><b>व्युत्पत्तिः - </b>न अनुगमः ।<br><br>

अननुभावुक
अननुभावुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗ್ರಹಿಸಲು ಅಸಮರ್ಥ / ತಿಳಿದುಕೊಳ್ಳಲು ಅಶಕ್ತ<br><b>निष्पत्तिः - </b>न +अनु+भू (सत्तायाम्) “उकञ्” (३-२-१५४) ।<br><br>

अननुभावुकता
अननुभावुकता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಹಣ ಸಾಮರ್ಥ್ಯವಿಲ್ಲದಿರುವಿಕೆ / ಧಾರಣಶಕ್ತಿಯಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>“तल्” (५-१-११९) ।<br><br>

अनन्त
अनन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>व्युत्पत्तिः - </b>नास्ति अन्तो गुणानां यस्य ।<br><b>प्रयोगाः - </b>“अनन्तगर्भामवलोक्य देवीम्” |<br><b>उल्लेखाः - </b>याद० २-३६ ।<br><b>विस्तारः - </b>[ಸಿದ್ಧರು, ಗಂಧರ್ವರು, ಅಪ್ಸರಸ್ಸು ಮೊದಲಾಗಿ ಯಾರೂ ಪರಮಾತ್ಮನ ಗುಣಗಳ ಎಲ್ಲೆಯನ್ನು ತಿಳಿಯಲ್ಗದಿರುವುದರಿಂದ ಈ ಹೆಸರು.]<br><br>अनन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆದಿಶೇಷ / ಸರ್ಪರಾಜ<br><br>अनन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲರಾಮ<br><b>विस्तारः - </b>[ಆಧಿಶೇಷನ ಅವತಾರ]<br><br>अनन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ / ಮೋಡ<br><br>अनन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಕೀಗಿಡ<br><br>अनन्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾಶ<br><br>अनन्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಬ್ರಹ್ಮ<br><b>प्रयोगाः - </b>“सत्यं ज्ञानमनन्तं ब्रह्म” |<br><b>उल्लेखाः - </b>तै० उ० २-१ ।<br><b>विस्तारः - </b>[ಕಾಲದೇಶವಸ್ತುಪರಿಚ್ಛೇದ ಶೂನ್ಯ]<br><br>अनन्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊನೆಯಿಲ್ಲದ / ಅವಧಿಯಿಲ್ಲದ<br><b>प्रयोगाः - </b>“अनन्तेन्य्यनेहसा” |<br><b>उल्लेखाः - </b>याद० १६-११४ ।<br><br>अनन्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಳತೆಯಿಲ್ಲದ / ಇಯತ್ತಾರಹಿತವಾದ<br><b>प्रयोगाः - </b>1. “अनन्ता वाङ्मयस्याहो गेयस्येव विचित्रता” | 2. “अनन्तरत्नप्रभवस्य यस्य हिमं न सौभाग्यविलोपि जातम्” |<br><b>उल्लेखाः - </b>1. माघ० २-७२ । 2. कुमा० १-३ ।<br><br>

अनन्तचतुर्दशी
अनन्तचतुर्दशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭಾದ್ರಪದ ಶುಕ್ಲ ಚತುರ್ದಶಿ<br><b>व्युत्पत्तिः - </b>अनन्तस्य चरुर्दशी ।<br><b>विस्तारः - </b>[ವಿಷ್ಣುವಿನ ವಿಶೇಷ ಪೂಜೆಯ ದಿವಸ.]<br><br>

अनन्तजित्
अनन्तजित्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>अनन्तानि भूतानि जितवान् ।<br><b>प्रयोगाः - </b>“सहस्रजिदनन्तजित्” |<br><b>उल्लेखाः - </b>वि० स० ।<br><br>

अनन्ततृतीया
अनन्ततृतीया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭಾದಪದ, ಮಾರ್ಗಶೀರ್ಷ ಮತ್ತು ವೈಶಾಖ ಮಾಸದ ಶುಕ್ಲ (ಪಕ್ಷದ) ತದಿಗೆ<br><b>प्रयोगाः - </b>“नभस्ये वाथ वैशाखे मागशीर्षेऽथवा पुनः । शुक्लपक्षतृतीयायां...... । उक्तानन्ततृतीयैषा सुतानन्दफलप्रदा”|<br><b>उल्लेखाः - </b>पद्मपु० ।<br><br>

अनन्तदृष्टि
अनन्तदृष्टि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><br>अनन्तदृष्टि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ / ಈಶ್ವರ<br><b>व्युत्पत्तिः - </b>अनन्ता दृष्टयो यस्य ।<br><br>

अनन्तदेव
अनन्तदेव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೇಷಶಾಯಿಯಾದ ವಿಷ್ಣು / ನಾರಾಯಣ<br><b>निष्पत्तिः - </b>दिवु (क्रीडादौ) “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अनन्ते दीव्यति |<br><br>

अनन्तमूल
अनन्तमूल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನಂತಗೊಂಡೆಗಿಡ<br><b>व्युत्पत्तिः - </b>अनन्तानि मूलानि यस्य ।<br><br>

अनन्तर
अनन्तर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂದಿನ ಮತ್ತು ಮುಂದಿನ ಕಾಲ ಅಥವಾ ದೇಶ<br><br>अनन्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯವಧಾನವಿಲ್ಲದ / ಬಿಡುವಿಲ್ಲದ / ಕಾಲದ ಅವಕಾಶವಿಲ್ಲದ / ಎಡೆಯಿಲ್ಲದ<br><br>अनन्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇರಿದಂತಿರುವ / ಸಮೀಪದಲ್ಲಿರುವ / ಸಮೀಪದಲ್ಲಿರುವ / ಸನ್ನಿಹಿತವಾದ<br><b>व्युत्पत्तिः - </b>नास्ति अन्तरं व्यवधानं यस्य ।<br><b>प्रयोगाः - </b>1. “वशमेको नृपतीननन्तरान्” | 2. “अभिभूय हरत्यनन्तरः शिथिलं कूलमिवापगारयः” | 3. “गर्जितानन्तरां वृष्टिं सौभाग्येन जिगाय सः” |<br><b>उल्लेखाः - </b>1. राघु० ८-१९ । 2. किरा० २-५३ । 3. कुमा० २-५३ ।<br><br>अनन्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರಕಾಲದ / (ಮುಂದಿನ) ಸಮೀಪ ಕಾಲದ<br><b>प्रयोगाः - </b>“गर्जितानन्तरां वृष्ट्ं सौभाग्येन जिगाय सः” |<br><b>उल्लेखाः - </b>कुमा० २-५३ ।<br><br>अनन्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಮೇಲೆ / ಉತ್ತರಕಾಲದಲ್ಲಿ<br><b>व्युत्पत्तिः - </b>नास्त्यन्तरं यथा स्यात्तथा ।<br><b>प्रयोगाः - </b>“पुराणपत्रापगमादनन्तरम्” |<br><b>उल्लेखाः - </b>रघु० ३-७ ।<br><br>

अनन्तरज
अनन्तरज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂದಿನ ವರ್ಣದ ಹೆಂಗಸಿನಲ್ಲಿ ಜನಿಸಿದ ಮಗ / ಬ್ರಾಹ್ಮಣನಿಗೆ ಕ್ಷತ್ರಿಯ ಅಥವಾ ವೈಶ್ಯ ಜಾತಿಯ ಹೆಂಗಸಿನಲ್ಲಿಯೂ ಕ್ಷತ್ರಿಯನಿಗೆ ವೈಶ್ಯ ಜಾತಿಯ ಹೆಂಗಸಿನಲ್ಲಿಯೂ ಜನಿಸಿದ ಮಗ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) “डः” (३-२-९७) ।<br><b>व्युत्पत्तिः - </b>अनन्तरस्यां अनन्तवर्णायां जायते|<br><br>अनन्तरज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠ ಮತ್ತು ಕನಿಷ್ಠ ಸಹೋದರ<br><b>निष्पत्तिः - </b>जनी “डः” (३-२-९७) ।<br><b>व्युत्पत्तिः - </b>अनन्तरे जातः |<br><br>

अनन्तरजा
अनन्तरजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠ ಮತ್ತು ಕನಿಷ್ಠ ಸಹೋದರಿ<br><br>

अनन्तरय
अनन्तरय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೂರಮಾಡದಿರುವಿಕೆ / ಬಿಟ್ಟುಕೊಡದಿರುವಿಕೆ<br><br>

अनन्तराय
अनन्तराय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಘ್ನವಿಲ್ಲದ / ಪ್ರತಿಬಂಧಕವಿಲ್ಲದ<br><br>

अनन्तरीय
अनन्तरीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಘ್ನವಿಲ್ಲದ / ಪ್ರತಿಬಂಧಕವಿಲ್ಲದ<br><br>

अनन्तरूप
अनन्तरूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ / ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>अनन्तानि रूपाणि यस्य |<br><b>प्रयोगाः - </b>“अनन्तरूपोऽनन्तश्रीर्जितमन्युर्भयापहः” |<br><b>उल्लेखाः - </b>वि० स० ।<br><br>

अनन्तविजय
अनन्तविजय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧರ್ಮರಾಜನ ಶಂಖ<br><b>व्युत्पत्तिः - </b>अनन्तान् विजयतेऽनेन ।<br><b>प्रयोगाः - </b>“अनन्तविजयं राजा कुन्तीपुत्रो युधिष्ठिरः” |<br><b>उल्लेखाः - </b>गीता १-९६ ।<br><br>

अनन्तवीर्य
अनन्तवीर्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಪ್ಪತ್ತಮೂರನೆಯ (ಜೈನ) ತೀರ್ಥಂಕರರ ಹೆಸರು<br><br>

अनन्तशयन
अनन्तशयन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು / ಶೇಷಶಾಯಿ<br><b>व्युत्पत्तिः - </b>अनन्तः शयनं यस्य ।<br><br>अनन्तशयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿರುವಾಂಕೂರು<br><br>अनन्तशयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀರಂಗ<br><br>अनन्तशयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀರಂಗಪಟ್ಟಣ<br><br>अनन्तशयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವನಸಮುದ್ರ<br><br>अनन्तशयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿರುಪತಿ / ಗೋವಿಂದರಾಜಪಟ್ಟಣ<br><b>निष्पत्तिः - </b>शीङ् (स्वन्पे) “ल्युट्” (३-३-११७) ।<br><b>व्युत्पत्तिः - </b>अनन्तः शेतेऽव |<br><br>

अनन्तशीर्ष
अनन्तशीर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>अनन्तशीर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸುಕಿ<br><br>

अनन्तशीर्षा
अनन्तशीर्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸುಕಿಯ ಪತ್ನಿ<br><br>

अनन्तश्री
अनन्तश्री<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>अनन्तश्री<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>अनन्ता अपरिमिता श्रीर्यस्य ।<br><b>प्रयोगाः - </b>“अनन्तरूपोऽनन्तश्रीः” |<br><b>उल्लेखाः - </b>वि० स० ।<br><br>

अनन्ता
अनन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಂತನ ಗೊಂಡೆ ಗಿಡ<br><br>अनन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೃಥ್ವಿ / ಭೂಮಿ<br><b>व्युत्पत्तिः - </b>नास्त्यन्तोऽस्याः ।<br><br>अनन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರ್ವತಿ<br><br>अनन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರಿಕೆಹುಲ್ಲು<br><br>अनन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಸುಗುನ್ನಿ ಗಿಡ<br><br>अनन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಣ್ಣೆ ಬಿದುರು ಸೊಪ್ಪು<br><br>अनन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮೃತಬಳ್ಳಿ<br><br>अनन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನರುವಲುಗಿಡ<br><br>अनन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೊಗದೆಬೇರು<br><br>अनन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಪ್ಪಲಿ<br><br>अनन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿಗರಿಕೆ<br><br>अनन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿ ಜೀರಿಗೆ<br><br>अनन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೀಟಕಸಂಧಿ<br><br>अनन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಳಲೆಗಿಡ<br><br>अनन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೆಲ್ಲಿಗಿಡ<br><br>अनन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂರ್ಣಿಮೆ / ಹುಣ್ಣಿಮೆ<br><b>विस्तारः - </b>1. “अनन्ता तु गुडूची भुर्दुरालभा विहशल्या लाङ्गली दूर्वा शारिवा हैमवत्यपि” - - हेम० । 2. “अनन्ता च विशत्यायां शारिवादूर्वयोरपि । कणादुरालभापथ्यापार्वत्यामलकीषु च । विश्वम्भरागुडूच्योः स्यात्” - मेदि० । 3. “अनन्ता पूर्णिमा दूर्वा यवाषः शारिवा मही”- वैज० ।<br><br>

अनन्त्य
अनन्त्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷಪಡಿಸದ<br><br>अनन्त्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುಃಖವುಂಟುಮಾಡುವ<br><br>

अनन्द
अनन्द<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷಪಡಿಸದ<br><br>अनन्द<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುಃಖವುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>टु नदि (समृद्धौ)+णिच् “अच्” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>न नन्दयति |<br><b>प्रयोगाः - </b>“अनन्दा नाम ते लोकाः” |<br><b>उल्लेखाः - </b>कठ० १-२ ।<br><br>

अनन्य
अनन्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು / ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>नास्त्यन्यद्यस्मात् ।<br><br>अनन्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆಯಲ್ಲದ / ಒಂದೇ ಆದ / ವ್ಯತ್ಯಾಸವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न अन्यः ।<br><br>अनन्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆಯಾಗಿಲ್ಲದ / ಒಂದಾಗಿರುವ / ಅವಿನಾಭೂತವಾದ / ಎಡಬಿಡದೆ ಸೇರಿಕೊಂಡಿರುವ<br><b>प्रयोगाः - </b>“अनन्या राधवेणाहं भास्करेण प्रभा यथा” । “सा हि सत्याभिसन्धाना तथानन्या च भार्तरि” |<br><b>उल्लेखाः - </b>रामा० ।<br><br>अनन्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅದ್ವಿತೀಯ / ಕೇವಲ / ಬೇರೊಬ್ಬನಿಲ್ಲದ / ಅಸಹಾಯ<br><b>व्युत्पत्तिः - </b>नास्ति अन्यो यस्य ।<br><br>अनन्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೊಬ್ಬರನ್ನೂ ಧ್ಯಾನಮಾಡದ<br><b>व्युत्पत्तिः - </b>नास्ति अन्यो ध्यानविषयो यस्य ।<br><br>अनन्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಯಾವ ಫಲಾಪೇಕ್ಷೆಯೂ ಇಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति अन्यो विषयो यस्य ।<br><b>प्रयोगाः - </b>“अनन्याश्चिन्तयन्तो मां ये जनाः पर्युपासते” |<br><b>उल्लेखाः - </b>गीता ९-२२ ।<br><br>

अनन्यगतिक
अनन्यगतिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಉಪಾಯವಿಲ್ಲದ<br><b>निष्पत्तिः - </b>समासान्तः “कप्” (५-४-१५४) ।<br><b>व्युत्पत्तिः - </b>नास्ति अन्यागतिर्यस्य ।<br><b>प्रयोगाः - </b>“अनन्यगतिके जने विगतपातके चातके” |<br><b>उल्लेखाः - </b>उद्भं ।<br><br>

अनन्यज
अनन्यज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ / ಮನ್ಮಥ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) “डः” (३-२-९८) ।<br><b>व्युत्पत्तिः - </b>अनन्यो विष्णुः ततो जातः |<br><br>

अनन्यदृष्टि
अनन्यदृष्टि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಕಡೆ ದೃಷ್ಟಿಯಿಲ್ಲದ / ಒಂದೇ ಕಡೆ ದೃಷ್ಟಿಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>नास्त्यन्यत्र दृष्टिर्यस्य ।<br><b>प्रयोगाः - </b>“अनन्यदृष्टिः सवितारमैक्षत” |<br><b>उल्लेखाः - </b>कुमा० ५-२० ।<br><br>

अनन्यपूर्वा
अनन्यपूर्वा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರೆ ಯಾರಿಂದಲೂ ಅನುಭವಿಸಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>अन्यः पूर्वॊ यस्याः सा अन्यपूर्वा । न अन्यपूर्वा ।<br><b>प्रयोगाः - </b>“तथाप्यनन्यपुर्वेव तस्मिन्नासीद्वसुन्धरा” |<br><b>उल्लेखाः - </b>रघु ४-७ ।<br><br>

अनन्यभाज्
अनन्यभाज्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಯಾರನ್ನೂ ಸೇರದಿರುವ / ಇತರರನ್ನು ಸೇವಿಸದಿರುವ<br><b>निष्पत्तिः - </b>भज (सेवायाम्) “ण्विः” (३-२-६२) ।<br><b>व्युत्पत्तिः - </b>न अन्यं भजते |<br><b>प्रयोगाः - </b>“अनन्यभाजं पतिमाप्नुहीति सा तथ्यमेवाभिहिता भवेन” |<br><b>उल्लेखाः - </b>कुमा० ३-६३ ।<br><br>

अनन्यमनस्
अनन्यमनस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಯಾವುದರಲ್ಲಿಯೂ ಮನಸ್ಸಿಲ್ಲದ / ಒಂದೇ ವಿಷಯದಲ್ಲಿ ಮನಸ್ಸುಳ್ಳ / ಚಿತ್ತೈಕಾಗ್ರ್ಯವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>नास्त्यन्यत्र मनः यस्य ।<br><br>

अनन्यलभ्य
अनन्यलभ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇತರ ವಿಷಯಗಳಲ್ಲಿ ಹೊಂದಲು ಅಶಕ್ಯವಾದ<br><b>व्युत्पत्तिः - </b>न अन्येषु लभ्यः ।<br><b>प्रयोगाः - </b>“अनन्यलभ्यां लभते स्म तृप्तिम्” |<br><b>उल्लेखाः - </b>याद० १३-४ ।<br><br>अनन्यलभ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಉಪಾಯದಿಂದ ಹೊಂದಲು ಅಶಕ್ಯವಾದ<br><b>व्युत्पत्तिः - </b>न अन्येन लभ्यः ।<br><b>प्रयोगाः - </b>“अनन्यलभ्यामलभन्त पौराः” |<br><b>उल्लेखाः - </b>याद० १३-१५ ।<br><br>अनन्यलभ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೊಬ್ಬರಿಂದ ಹೊಂದಲು ಅಶಕ್ಯವಾದ<br><br>

अनन्यविषय
अनन्यविषय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೊಬ್ಬರಿಗೂ ಸಂಬಂಧಪಡದ / ತನಗೇ ಸಂಬಂಧಿಸಿದ<br><br>अनन्यविषय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮತ್ತೊಂದು ವಿಷಯಕ್ಕೆ ಸಂಬಂಧಿಸಿದ<br><br>

अनन्यवृत्ति
अनन्यवृत्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏಕಾಗ್ರಚಿತ್ತವುಳ್ಳ / ಒಂದೇ ವಿಷಯದಲ್ಲಿ ಮನಸ್ಸುಳ್ಳ<br><b>व्युत्पत्तिः - </b>न अन्यस्मिन् वृत्तिर्यस्य ।<br><br>अनन्यवृत्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಜೀವನೋಪಾಯವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न अन्या वृत्तिर्यस्य ।<br><br>

अनन्यसाधारण
अनन्यसाधारण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇತರರಿಗೆ ಸಮಾನವಲ್ಲದ / ಇತರ ಗುಣಕ್ಕಿಂತಲೂ ಮಿಗಿಲಾದ ಗುಣವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>न अन्यस्य साधारणः अन्यधर्मस्य सदृशः ।<br><b>प्रयोगाः - </b>“पुंसामनन्यसाधाअणमेव कर्म” |<br><b>उल्लेखाः - </b>कुमा० ३-१९ ।<br><br>

अनन्वय
अनन्वय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನನ್ವಯಾಲಂಕಾರ / ಅರ್ಥಾಲಂಕಾರದ ಒಂದು ಭೇದ<br><b>प्रयोगाः - </b>“उपमानोपमेयत्वं यदेकस्यैव वस्तुनः । इन्दुरिन्दुरिव श्रीमानित्यादौ तदनन्वयः” |<br><b>उल्लेखाः - </b>चन्द्रा० ।<br><b>विस्तारः - </b>ಅತ್ಯುತ್ಕೃಷ್ಟಗುಣವುಳ್ಳೋಣದರಿಂದ ಬೇರೊಂದು ಉಪಮಾನವಸ್ತುವಿಲ್ಲದ ಒಂದೇ ವಸ್ತುವಿಗೆ ಉಪಮಾನತ್ವ ಮತ್ತು ಉಪಮೇಯತ್ವವರ್ಣನೆಯು ಅನನ್ವಯಾಲಂಕಾರ.<br><br>अनन्वय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧವಿಲ್ಲದಿರುವಿಕೆ / (ಪದಾರ್ಥಗಳಿಗೆ) ಪರಸ್ಪರ ಅನ್ವಯವಿಲ್ಲದಿರುವಿಕೆ<br><br>

अनन्वित
अनन्वित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧವಿಲ್ಲದ / ಒಂದು ವಿಷಯದಿಂದ (ಸಂಬಂಧಪಡದ) ಮತ್ತೊಂದು ವಿಷಯಕ್ಕೆ ಹಾರುವ<br><br>

अनपकर्मन्
अनपकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಾನ ಮಾಡಿದುದನ್ನು / ತೆಗೆದುಕೊಂಡವನು ಅನರ್ಹನೆಂದಾಗಲಿ ಕೋಪದಿಂದಾಗಲಿ ಹಿಂದಕ್ಕೆ ತೆಗೆದುಕೊಳ್ಳುವಿಕೆ<br><b>व्युत्पत्तिः - </b>अपकर्म अपाकरणम् । अभावे न० त० ।<br><b>प्रयोगाः - </b>1. “सम्भूय च समुत्थानं दत्तस्यानपकर्म च” | 2. दत्तस्य धनस्यापात्रबुद्ध्या क्रोधादिना वा ग्रहणम् इति कुल्लूकः ।<br><b>उल्लेखाः - </b>1. मनु० ८-४ ।<br><br>

अनपत्य
अनपत्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಕ್ಕಳಿಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>नास्ति अपत्यं यस्य ।<br><b>प्रयोगाः - </b>“अनपत्यश्च किल तपस्वी” |<br><b>उल्लेखाः - </b>शाकु० ६ ।<br><br>

अनपत्यता
अनपत्यता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಕ್ಕಳಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>अनपत्यस्य भावः ।<br><b>प्रयोगाः - </b>“नूनमनपत्यता मां वत्सलयति” |<br><b>उल्लेखाः - </b>शाकु० ७ ।<br><br>

अनपत्रप
अनपत्रप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲಜ್ಜೆಯಿಲ್ಲದ / ನಾಚಿಕೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति अपत्रपा यस्य ।<br><b>प्रयोगाः - </b>“अन्येपि कवयः कामं बभूवुरनपत्रप्ः” |<br><b>उल्लेखाः - </b>याद० १-४ ।<br><br>

अनपाय
अनपाय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಾಯರಹಿತ / ಹಾನಿಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति अपत्रपा यस्य ।<br><b>प्रयोगाः - </b>“अन्येपि कवयः कामं बभूवुरनपत्रप्ः” |<br><b>उल्लेखाः - </b>याद० १-४ ।<br><br>

अनपायिन्
अनपायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಾಯರಹಿತ / ನಾಶರಹಿತ<br><b>व्युत्पत्तिः - </b>अपायी न भवति ।<br><b>प्रयोगाः - </b>1. “अनपायि निर्बर्हणं द्विषां न तितिक्षासममस्ति साधनम्” | 2. “चलेष्वर्थेषु लुब्धेन न यशस्स्वनपायिषु” |<br><b>उल्लेखाः - </b>1. किरा० २-४३ । 2. मुद्रा० ५-१४ ।<br><br>अनपायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಥಿರವಾದ / ಅಚಲವಾದ<br><b>प्रयोगाः - </b>‘अनपायिनि संश्रयद्रुमे गजभग्ने” |<br><b>उल्लेखाः - </b>कुमा० ४-३१ ।<br><br>

अनपावृत्
अनपावृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂತಿರುಗದ / ಹಿಂದಕ್ಕೆ ಬರದಿರುವ<br><b>व्युत्पत्तिः - </b>न अपावृत् पुनरागमनं यस्य ।<br><br>

अनपेक्ष
अनपेक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆಯಿಲ್ಲದ / ಆಸೆಯಿಲ್ಲದಿರುವ / ನಿಃಸ್ಪೃಹ<br><br>अनपेक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದಾಸೀನ / ತಟಸ್ಥ<br><br>अनपेक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇತರರ ಸಹಾಯವನ್ನಪೇಕ್ಷಿಸದ<br><b>व्युत्पत्तिः - </b>न अपेक्षते ।<br><br>अनपेक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆಯಿಲ್ಲದೆ / ಆಸೆಯಿಲ್ಲದೆ<br><b>प्रयोगाः - </b>“लक्ष्मी तनोतु नितरामितरानपेक्षम्” |<br><b>उल्लेखाः - </b>चं० रा० १-१ ।<br><br>

अनपेक्षा
अनपेक्षा<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದಾಸೀನತೆ<br><br>अनपेक्षा<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಃಸ್ಪೃಹತೆ<br><br>अनपेक्षा<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪೇಕ್ಷೆ / ಅಲಕ್ಷ್ಯ / ಅನಾದರ<br><br>

अनपेत
अनपेत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡಲ್ಪಡದ / ಕೂಡಿಕೊಂಡಿರುವ<br><b>व्युत्पत्तिः - </b>न अपेतः ।<br><b>प्रयोगाः - </b>“एश्वर्यादनपेतमीदृशमय्ं लोकोऽर्थतः सेवते” |<br><b>उल्लेखाः - </b>मुद्रा० १-१४ ।<br><br>अनपेत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಗದಿರುವ<br><br>अनपेत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>(ಕಾಲ) ಕಳೆಯದಿರುವ / ಅತಿಕ್ರಮಿಸದಿರುವ / ಮೀರದಿರುವ<br><b>प्रयोगाः - </b>“अनपेतकालमभिरामकथाः कथयां बभूवुरिति गोत्रभिदे” |<br><b>उल्लेखाः - </b>किरा० ६-३० ।<br><br>

अनभिज्ञ
अनभिज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿವಳಿಕೆಯಿಲ್ಲದ / ಅರಿವಿಲ್ಲದ<br><b>निष्पत्तिः - </b>अभि+ज्ञा (अवबोधने) “कः” (३-१-१३५) ।<br><b>व्युत्पत्तिः - </b>अभिजानाति | न अभिज्ञः ।<br><b>प्रयोगाः - </b>“अनभिज्ञास्तमिस्राणां दुर्दिनेष्वभिसारिकाः” |<br><b>उल्लेखाः - </b>कुमा० ६-४३ |<br><br>

अनभिभव
अनभिभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರವಿಲ್ಲದಿರುವಿಕೆ<br><br>अनभिभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೋಲಿಲ್ಲದಿರುವಿಕೆ<br><br>

अनभिभूत
अनभिभूत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಡದ<br><br>अनभिभूत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೋಲಿಸಲ್ಪಡದ / ಜಯಿಸಲ್ಪಡದ<br><b>निष्पत्तिः - </b>न० त० ।<br><br>

अनभिमत
अनभिमत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರು / ವೈರಿ / ಹಗೆ<br><b>व्युत्पत्तिः - </b>न अभिमतः ।<br><br>अनभिमत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮ್ಮತವಿಲ್ಲದ / ಒಪ್ಪಿಗೆಯಿಲ್ಲದ<br><br>

अनभिलषित
अनभिलषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಡದ<br><br>

अनभिलाष
अनभिलाष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆಯಿಲ್ಲದಿರುವಿಕೆ / ಅರುಚಿ<br><b>व्युत्पत्तिः - </b>न अभिलाषः ।<br><br>अनभिलाष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆಯಿಲ್ಲದ / ಇಚ್ಛೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति अभिलाषो यस्य ।<br><br>

अनभिव्यक्त
अनभिव्यक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸ್ಪಷ್ಟ / ಅಸ್ಫುಟ<br><b>व्युत्पत्तिः - </b>न अभिव्यक्तः ।<br><b>प्रयोगाः - </b>“अर्थिप्रत्यर्थिनोरासीदनभिव्यक्तरूपता” |<br><b>उल्लेखाः - </b>याद० १६-८० ।<br><br>

अनभिशस्त
अनभिशस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದೆಗೆ ಸಿಲುಕದ / ಅಪವಾದಕ್ಕೆ ಒಳಗಾಗದ<br><b>व्युत्पत्तिः - </b>न अभिशस्तः ।<br><br>

अनभिशस्त्य
अनभिशस्त्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದೆಗೆ ಅರ್ಹನಲ್ಲದ / ಶ್ಲಾಘನೆಗೆ ಅರ್ಹನಾದ<br><b>व्युत्पत्तिः - </b>न अभिशस्तः ।<br><br>

अनभिसन्धान
अनभिसन्धान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ದೇಶವಿಲ್ಲದಿರುವಿಕೆ / ಫಲಾಪೇಕ್ಷೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>

अनभिसन्धि
अनभिसन्धि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಫಲೋದ್ದೇಶವಿಲ್ಲದಿರುವಿಕೆ / ತಾತ್ಪರ್ಯವಿಲ್ಲದಿರುವುದು<br><br>

अनभिसंहित
अनभिसंहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಫಲೋದ್ದೇಶದಿಂದ ಮಾಡಲ್ಪಡದ<br><br>

अनभिहित
अनभिहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲ್ಪಡದ / ಪ್ರತಿಪಾದಿಸಲ್ಪಡದ<br><br>

अनभ्यावृत्ति
अनभ्यावृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸಲ / ಪುನಃ ಪುನಃ ಮಾಡದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न अभ्यावृत्तिरभ्यासः ।<br><b>प्रयोगाः - </b>“मनागनभ्यावृत्त्या वा कामं क्षाम्यतु यः क्षमी” ।<br><b>उल्लेखाः - </b>माघ० २-४३ ।<br><br>

अनभ्याश
अनभ्याश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೂರ<br><br>अनभ्याश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೂರದಲ್ಲಿರುವ / ಹತ್ತಿರದಲ್ಲಿಲ್ಲದಿರುವ<br><br>

अनभ्याशमित्य
अनभ्याशमित्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೂರದಲ್ಲಿ ವರ್ಜಿಸಲು ಯೋಗ್ಯನಾದ<br><b>निष्पत्तिः - </b>“मुम्” (वा० ६-३-७०) ।<br><b>व्युत्पत्तिः - </b>अनभ्याशं इत्यः |<br><br>

अनम
अनम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣ / ಇತರರಿಗೆ ನಮಸ್ಕರಿಸದವನು<br><b>निष्पत्तिः - </b>णम (प्रह्वत्वे शब्दे च) “अच्” (३-१-१३४) । न० त० ।<br><b>व्युत्पत्तिः - </b>न नमत्यन्यान् |<br><b>विस्तारः - </b>“वक्त्रजस्त्वनमो विप्रो वर्णज्येष्ठः कठो द्विजः” - त्रिकाण्ड० ।<br><br>

अनम्र
अनम्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗರ್ವದಿಂದ ಕೂಡಿದ / ಅಹಂಕಾರವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>न नम्रः ।<br><b>प्रयोगाः - </b>“अनम्राणां समुद्धर्तुस्तस्मात्स्न्द्रयादिव” |<br><b>उल्लेखाः - </b>रघु० ४-३५ ।<br><br>

अनय
अनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುಷ್ಟತನ / ಕೇಡಿತನ<br><b>प्रयोगाः - </b>“अनयो नयसङ्काशो हृदयान्नापसर्पति” |<br><b>उल्लेखाः - </b>पञ्चत० ।<br><br>अनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ರಾಮಾಣಿಕತೆ<br><b>प्रयोगाः - </b>“समृद्धिरनयाद्विनश्यति” |<br><b>उल्लेखाः - </b>पञ्चत० १-१६९ ।<br><br>अनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಪತ್ತು / ತೊಂದರೆ<br><b>व्युत्पत्तिः - </b>न अयः ।<br><b>प्रयोगाः - </b>“सर्वतः प्रतिगृह्णीयाद्ब्राह्मणस्त्वनयं गतः” |<br><b>उल्लेखाः - </b>मनु० १०-१०२ ।<br><br>अनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ದೈವ / ದುರ್ದಶೆ<br><br>अनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಗಡೆಯಾಟದ ಒಂದು ಭೇದ<br><br>अनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಸನ<br><b>विस्तारः - </b>“अनयोऽशुभदैवे स्याद्विपद्व्यसनयोरपि” - हेम० ।<br><br>अनय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀತಿಯಿಲ್ಲದ<br><br>

अनरण्य
अनरण्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯವಂಶದ ಒಬ್ಬ ದೊರೆ<br><br>

अनर्गल
अनर्गल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಬಂಧಕವಿಲ್ಲದ / ಅಡಚಣೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति अर्गलं प्रतिबन्धकं यस्य ।<br><b>प्रयोगाः - </b>“तुरङ्गमुत्सृष्टमनर्गलं पुनः” |<br><b>उल्लेखाः - </b>रघु० ३-३९ ।<br><br>अनर्गल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗಳಿ ಮರವಿಲ್ಲದ<br><br>

अनर्घ
अनर्घ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಮೌಲ್ಯವಾದ / ಬಹಳ ಬೆಲೆಬಾಳುವ / ಬೆಲೆಕಟ್ಟಲಾಗದ<br><b>व्युत्पत्तिः - </b>न अर्घो मूल्यं यस्य ।<br><b>प्रयोगाः - </b>“अनर्थरत्नाभरणप्रधानाम्” |<br><b>उल्लेखाः - </b>याद० १३-४३ ।<br><br>

अनर्घराघव
अनर्घराघव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುರಾರಿಕವಿ ಪ್ರಣೀತವಾದ ಒಂದು ನಾಟಕ<br><br>

अनर्घ्य
अनर्घ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಮೂಲ್ಯವಾದ / ಬೆಲೆ ಕಟ್ಟಲಾಗದ / ಬಹಳ ಬೆಲೆಬಾಳುವ<br><b>निष्पत्तिः - </b>“यत्” (५-१-६६) । न० त० ।<br><b>व्युत्पत्तिः - </b>अर्घ मूल्यमर्हति |<br><br>अनर्घ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲರಿಗೂ ಪೂಜ್ಯನಾದ / ಪೂಜಿಸಲ್ಪಡುವವರಿಲ್ಲದ<br><br>

अनर्थ
अनर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನಿಷ್ಟ / ವಿಪತ್ತು / ತೊಂದರೆ / ಕೆಡುಕು<br><b>व्युत्पत्तिः - </b>न अर्थः प्रयोजनम् । विरोधे न० त० ।<br><b>प्रयोगाः - </b>“यौवनं धनसम्पत्तिः प्रभुत्वमविवेकिता । एकैकमप्यनर्थाय किमु यत्र चतुष्टयम्” |<br><b>उल्लेखाः - </b>हितो० ।<br><br>अनर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯೋಜನವಿಲ್ಲದ ವಿಷಯ<br><br>अनर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಂಬದ್ಧತೆ / ಮೂರ್ಖತನ<br><br>अनर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>न अर्थः अभीष्टं यस्य ।<br><b>प्रयोगाः - </b>“अर्थोऽनर्थो महाकोशः” |<br><b>उल्लेखाः - </b>वि० स० ।<br><br>अनर्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯೋಜನವಿಲ್ಲದ<br><b>प्रयोगाः - </b>“शुनः पुच्छमिवानर्थं पाण्डित्यं धर्मवर्जितम्” |<br><b>उल्लेखाः - </b>पञ्चत० ३-९७ ।<br><br>अनर्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರ್ಭಾಗ್ಯ / ದುರದೃಷ್ಟದ<br><br>अनर्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಾನಿಕರ / ಕೆಡಕಿನ<br><br>अनर्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಥವಿಲ್ಲದ / ವಿವಕ್ಷಿತಾರ್ಥರಹಿತವಾದ<br><br>अनर्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಥಹೀನ / ದರಿದ್ರ / ಬಡವ<br><br>

अनर्थक
अनर्थक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಂಬದ್ಧವಾದ ಮಾತು / ಹೊಂದಿಕೆಯಿಲ್ಲದ ಮಾತು<br><b>निष्पत्तिः - </b>“कप्” (५-४-१५१) ।<br><b>व्युत्पत्तिः - </b>न विद्यतेऽर्थोऽभिधेयो यत्र |<br><br>अनर्थक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>व्युत्पत्तिः - </b>न अर्थः प्रयोजनं यस्य ।<br><br>

अनर्थकर
अनर्थकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯೋಜನವಿಲ್ಲದ ಕೆಲಸಮಾಡುವ<br><br>अनर्थकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಡಕುಮಾಡುವ<br><b>व्युत्पत्तिः - </b>अनर्थस्य करः ।<br><br>

अनर्थान्तर
अनर्थान्तर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾನವಾದ ಅರ್ಥ / ಒಂದೇ ಅರ್ಥ<br><b>निष्पत्तिः - </b>न० त० ।<br><b>व्युत्पत्तिः - </b>अन्योऽर्थः अर्थान्तरम् । न अर्थान्तरम् ।<br><br>अनर्थान्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾನವಾದ ಅರ್ಥವುಳ್ಳ / ಬೇರೆ ಅರ್ಥವಿಲ್ಲದ<br><br>

अनर्विश्
अनर्विश्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಗಬೇಕಾದ ಸ್ಥಳಕ್ಕೆ ಹೋಗಲು ಅಶಕ್ತನಾದ<br><b>व्युत्पत्तिः - </b>अरं गन्तव्यप्रदेशं विशति अर्विश् । न० त० ।<br><br>अनर्विश्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಾಡಿಯನ್ನು ಹತ್ತಿಕೊಂಡು ಸೌದೆ ಮೊದಲಾದುದನ್ನು ತರಲು ಕಾಡಿಗೆ ಹೋಗುವವನು<br><b>व्युत्पत्तिः - </b>अनसा शकटेन विशति प्राप्नोति ।<br><br>

अनर्ह
अनर्ह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯ / ಅರ್ಹತೆಯಿಲ್ಲದ<br><br>अनर्ह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನನುರೂಪ / ಅಯುಕ್ತ / ತಕ್ಕುದಲ್ಲದ<br><br>

अनल
अनल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ / ಬೆಂಕಿ<br><b>निष्पत्तिः - </b>अनिति-अन (प्राणने) “कलः” वा (उ० १-१०६) ।<br><b>व्युत्पत्तिः - </b>न अलः पर्याप्तिर्यस्य ।<br><b>प्रयोगाः - </b>“नाग्निस्तृप्यति काष्ठानाम्” । “अनलस्कन्धविनिस्सृतं स्फुलिङ्गम्” |<br><b>उल्लेखाः - </b>याद० १५-१०९ ।<br><b>विस्तारः - </b>[ಬೆಂಕಿಗೆ ಎಷ್ಟು ಆಹಾರವನ್ನು ಕೊಟ್ಟರೂ ತೃಪ್ತಿಯಾಗುವುದಿಲ್ಲ]<br><br>अनल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಠರಾಗ್ನಿ / ಜೀರ್ಣಮಾಡುವ ಶಕ್ತಿ<br><br>अनल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹದೊಳಗಿರುವ ಪಿತ್ತರಸ<br><br>अनल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಷ್ಟವಸುಗಳಲ್ಲಿ ಐದನೆಯ ವಸು<br><br>अनल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರಕವೃಕ್ಷ / ಚಿತ್ರಮೂಲದ ಗಿಡ<br><br>अनल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೇರುಮರ<br><br>अनल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂರು ಸಂಖ್ಯೆ<br><br>अनल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತ್ತಿಕಾ ನಕ್ಷತ್ರ<br><br>अनल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೀವ<br><br>अनल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು / ವಾಸುದೇವ<br><br>अनल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯು / ಗಾಳಿ<br><b>विस्तारः - </b>“अनलो वासुदेवेऽग्नावनलो वसुवातयोः” - विश्व० ।<br><br>अनल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೃಪ್ತಿಯಿಲ್ಲದ<br><br>

अनलदीपन
अनलदीपन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಠರಾಗ್ನಿಯನ್ನು ಹೆಚ್ಚಿಸುವ / ಜೀರ್ಣಶಕ್ತಿಯನ್ನು ಅಧಿಕಪಡಿಸುವ<br><b>निष्पत्तिः - </b>दीपो (दीप्तौ)+णिच् “ल्युः” (३-१-१३४) ।<br><b>व्युत्पत्तिः - </b>अनलं दीपयति |<br><br>

अनलप्रभा
अनलप्रभा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಿಂಚುಬಳ್ಳಿ / ಜ್ಯೋತಿಷ್ಮತೀಲತೆ<br><b>व्युत्पत्तिः - </b>अनलस्य प्रभेव प्रभा यस्याः ।<br><br>अनलप्रभा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಕಿಯ ಪ್ರಕಾಶ<br><br>

अनलप्रिया
अनलप्रिया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಪತ್ನಿ / ಸ್ವಾಹಾದೇವಿ<br><br>

अनल्प
अनल्प<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾದ / ಬಹಳ / ಅನೇಕ<br><b>व्युत्पत्तिः - </b>न अल्पः ।<br><b>प्रयोगाः - </b>“म्रदीयसीमपि घनामनल्पगुणकल्पिताम्” |<br><b>उल्लेखाः - </b>माघ० २-७४ ।<br><br>

अनवगीत
अनवगीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಿಂದಿತವಾದ / ಶ್ರೇಷ್ಠವಾದ / ಶುದ್ಧವಾದ<br><br>

अनवग्रह
अनवग्रह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಬಂಧಕವಿಲ್ಲದ / ತಡೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति अवग्रहो यस्य ।<br><b>प्रयोगाः - </b>“सुकुमारकायमनवग्रहः स्मरः” |<br><b>उल्लेखाः - </b>मालती० १-४२ ।<br><br>

अनवच्छिन्न
अनवच्छिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಳತೆಯಿಲ್ಲದ / ಎಲ್ಲೆಯಿಲ್ಲದ<br><br>अनवच्छिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪರಿಮಿತ / ಅಪಾರವಾದ<br><br>अनवच्छिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂದಿಗ್ಧವಾದ / ಅಸ್ಪಷ್ಟವಾದ / ಅನಿಶ್ಚಿತವಾದ<br><br>अनवच्छिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವ್ಯಾಪಕ<br><br>

अनवद्य
अनवद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೋಷವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नोद्यते नोच्यते इत्यवद्यम् । न अवद्यम् ।<br><b>प्रयोगाः - </b>“मुदमवहदनवद्यां तामवद्यादपेतः” |<br><b>उल्लेखाः - </b>रघु० ७-७० ।<br><br>

अनवधान
अनवधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಜಾಗರೂಕತೆ / ಪ್ರಮಾದ / ಉದಾಸೀನತೆ<br><b>निष्पत्तिः - </b>न० त० ।<br><b>व्युत्पत्तिः - </b>न अवधीयते मनः कर्तव्यकर्मणि ।<br><br>अनवधान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಾಗರೂಕತೆಯಿಲ್ಲದ / ಉದಾಸೀನ / ಅಶ್ರದ್ಧೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>न अवधानं यस्य ।<br><br>

अनवधानता
अनवधानता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಮಾದ / ಅಶ್ರದ್ಧೆ / ಕರ್ತವ್ಯಕಾರ್ಯದಲ್ಲಿ ಅಲಕ್ಷ್ಯ ಮತ್ತು ಅಕರ್ತವ್ಯ (ಮಾಡಬಾರದ) ಕಾರ್ಯದಲ್ಲಿ ಪ್ರವೃತ್ತಿ<br><b>प्रयोगाः - </b>“कर्तव्याकरणं यत्राकर्तव्यस्याथवा क्रिया । उच्यते द्वितयं तत्र प्रमादोऽनवधानता” ।|<br><br>

अनवधारित
अनवधारित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न अवधारितम् ।<br><b>प्रयोगाः - </b>“अनवधाइतशौरिविहारया” |<br><b>उल्लेखाः - </b>याद० ३-४० ।<br><br>अनवधारित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯಿಸಲ್ಪಡದ / ನಿರ್ಧರಿಸಲ್ಪಡದ<br><br>

अनवबुद्ध
अनवबुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಿಯಲ್ಪಡದ / ತಿಳಿಯಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न अवबुद्धः ।<br><b>प्रयोगाः - </b>“अनवबुद्धजनार्दनकन्यका विनिमयः” |<br><b>उल्लेखाः - </b>याद० ३-४८ ।<br><br>

अनवबोध
अनवबोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಿವಿಲ್ಲದಿರುವಿಕೆ / ತಿಳಿವಳಿಕೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>

अनवम
अनवम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನ್ಯೂನಾತಿರೇಕವಿಲ್ಲದ / ಹೆಚ್ಚುಕಡಿಮೆಯಿಲ್ಲದ / ಸಮಾನವಾದ<br><b>व्युत्पत्तिः - </b>न अवमः ।<br><b>प्रयोगाः - </b>“सुधमनिवमां सुभाम्” |<br><b>उल्लेखाः - </b>रघु० १७-२७ ।<br><br>अनवम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂಭತ್ತನೆಯದಲ್ಲದ<br><br>

अनवरत
अनवरत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಶ್ರಾಂತಿಯಿಲ್ಲದ / ನಿರಂತರವಾದ<br><br>अनवरत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರಂತರವಾಗಿ / ವಿಶ್ರಾಂತಿಯಿಲ್ಲದೆ<br><br>

अनवरार्ध्य
अनवरार्ध्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಖ್ಯವಾದ / ಶ್ರೇಷ್ಠವಾದ<br><b>निष्पत्तिः - </b>“यत्” (४-३-४) । न० त० ।<br><b>व्युत्पत्तिः - </b>अवस्मिन् अर्धे भवः |<br><br>

अनवलम्ब
अनवलम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಹಾಯತೆ / ಆಶ್ರಯವಿಲ್ಲದಿರುವಿಕೆ / ನೆರವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न अवलम्बः ।<br><br>अनवलम्ब<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯವಿಲ್ಲದ / ಸಹಾಯವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति अवलम्बो यस्य ।<br><b>प्रयोगाः - </b>“न परं पथि पक्षपातिताऽनवलम्बे किमु मादृशेऽपि सा" |<br><b>उल्लेखाः - </b>नैष० २-५२ ।<br><br>

अनवलम्बन
अनवलम्बन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಾತಂತ್ರ್ಯ / ಆಶ್ರಯಿಸದಿರುವಿಕೆ<br><br>अनवलम्बन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯವಿಲ್ಲದ / ಸಹಾಯವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्त्यवलम्बनं यस्य ।<br><br>

अनवसर
अनवसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವಕಾಶವಿಲ್ಲದಿರುವಿಕೆ<br><br>अनवसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯವಾದ ಸಮಯ / ಅನುಚಿತಕಾಲ / ಅಕಾಲ<br><b>व्युत्पत्तिः - </b>न अवसरः उचितः कालः ।<br><b>प्रयोगाः - </b>“क्रं याचे यत्र तत्र ध्रुवमनवसरग्रस्त एवार्थिभावः” |<br><b>उल्लेखाः - </b>मालती० ९-३० ।<br><br>अनवसर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯಕಾಲದ / ಅನುಚಿತಕಾಲದ / ಅಕಾಲದ<br><b>व्युत्पत्तिः - </b>नास्ति अवसरः उचितः कालो यस्य ।<br><br>

अनवसान
अनवसान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂತ್ಯವಿಲ್ಲದ / ಕೊನೆಯಿಲ್ಲದ / ನಾಶವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति अवसानं यस्य ।<br><br>

अनवसित
अनवसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾಪ್ತಿಹೊಂದದ / ಕೊನೆಯನ್ನು ಮುಟ್ಟದಿರುವ<br><br>अनवसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಿಶ್ಚಿತವಾದ<br><br>

अनवस्कर
अनवस्कर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಳೆಯಿಲ್ಲದ / ಶುಚಿಯಾದ / ಕಶ್ಮಲವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति अवसानं यस्य ।<br><br>

अनवस्थ
अनवस्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಂಚಲವಾದ / ಅಸ್ಥಿರವಾದ<br><b>व्युत्पत्तिः - </b>नास्त्यवस्था स्थितिर्यस्य ।<br><b>प्रयोगाः - </b>“क्वचिदयमनवस्थः स्थास्नुत्मेति वायुः” |<br><b>उल्लेखाः - </b>माघ० ११-२८ ।<br><br>

अनवस्था
अनवस्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಂಚಲ್ಯ / ಅಸ್ಥಿರವಾದ<br><b>प्रयोगाः - </b>“एवमप्यनवस्था स्य्द्या मूलक्षतिकारिणी” |<br><b>उल्लेखाः - </b>काव्यप्र० ।<br><br>

अनवस्थान
अनवस्थान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯು / ಗಾಳಿ<br><br>अनवस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಂಚಲ್ಯ / ಅಸ್ಥಿರತೆ / ಅನಿಶ್ಚಯ<br><b>प्रयोगाः - </b>“जयपराजयानवस्थानात्” |<br><b>उल्लेखाः - </b>दशकु० ।<br><br>अनवस्थान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಂಚಲವಾದ / ಅಸ್ಥಿರವಾದ<br><br>

अनवस्थित
अनवस्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಂಚಲವಾದ / ಅಸ್ಥಿರವಾದ<br><b>व्युत्पत्तिः - </b>न अवस्थितः ।<br><br>अनवस्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮಾತುರವುಳ್ಳ / ವ್ಯಭಿಚಾರಿ<br><b>प्रयोगाः - </b>1. “चतुर्णामपि वर्णानां नारीर्हत्वानवस्थिताः” | 2. “मित्रक्र्यमपदिश्य पार्श्वतः प्रस्थितं तमनवस्थितं प्रियाः” |<br><b>उल्लेखाः - </b>1. मनु० १२-१३८ । 2. रघु० १९-३१ ।<br><br>

अनवस्थिति
अनवस्थिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಂಚಲ್ಯ / ಅಸ್ಥಿರತೆ<br><b>व्युत्पत्तिः - </b>न अवस्थितिः ।<br><br>

अनवह्वर
अनवह्वर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೌಟಿಲ್ಯವಿಲ್ಲದ / ಸರಳವಾದ / ಕಪಟವಿಲ್ಲದ / ಪ್ರಾಮಾಣಿಕ<br><br>

अनवाप्त
अनवाप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಡದ / ಸಂಪಾದಿಸಲ್ಪಡದ<br><b>प्रयोगाः - </b>“नानवाप्तमवाप्तव्यं वर्त एव च कर्मणि” |<br><b>उल्लेखाः - </b>गीता ३-२२ ।<br><br>

अनवेक्षक
अनवेक्षक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರ್ಯಾಲೋಚಿಸದ / ವಿವೇಚನೆಮಾಡದ / ವಿಮರ್ಶೆಮಾಡದ<br><b>व्युत्पत्तिः - </b>न अवेक्षकः ।<br><br>अनवेक्षक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲ್ವಿಚಾರಕನಿಲ್ಲದ / ಉಸ್ತುವಾರಿ ನೋಡುವವನಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न अवेक्षकः यस्मिन् ।<br><br>

अनवेक्षा
अनवेक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆಯಿಲ್ಲದಿರುವಿಕೆ / ಉದಾಸೀನತೆ<br><b>व्युत्पत्तिः - </b>न अवेक्षा । न० त० ।<br><br>

अनशन
अनशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪವಾಸ<br><b>निष्पत्तिः - </b>अश (भोजने) भावे “ल्युट्” (३-३-११५) ।<br><b>व्युत्पत्तिः - </b>अश्यते | न अशनम् ।<br><br>अनशन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೋಜನವಿಲ್ಲದ / ಊಟವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न अशनं यस्य ।<br><br>

अनश्वर
अनश्वर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಥಿರವಾದ / ಶಾಶ್ವತವಾದ / ನಿತ್ಯವಾದ<br><b>निष्पत्तिः - </b>णश(अदर्शने) “करप्” (३-२-१६३) । न० त० ।<br><br>

अनस्
अनस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಡಿ / ಬಂಡಿ<br><b>निष्पत्तिः - </b>अन (प्राणने) “असुन्” (उ० ४-१८८) ।<br><b>व्युत्पत्तिः - </b>अनिति चीत्करोति |<br><b>प्रयोगाः - </b>“मनसा बकं लिलेह रात्र्यामनसा धारितमन्नराशिमेव” |<br><b>उल्लेखाः - </b>चं० भा० ।<br><br>अनस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನ<br><b>व्युत्पत्तिः - </b>अनिति जीवत्यनेन ।<br><br>अनस्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಂದೆ ಅಥವಾ ತಾಯಿ<br><br>

अनसूय
अनसूय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸೂಯೆಯಿಲ್ಲದ / ಇತರರ ಗುಣದಲ್ಲಿ ದ್ವೇಷವಿಲ್ಲದ<br><b>निष्पत्तिः - </b>स्वार्थे “कन्” ।<br><b>व्युत्पत्तिः - </b>नास्ति असूया यस्य । अनसूयकः|<br><b>प्रयोगाः - </b>“श्रद्धावाननसूयश्च” |<br><b>उल्लेखाः - </b>गीता० १८-७१ ।<br><br>

अनसूया
अनसूया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸೂಯೆಯಿಲ್ಲದಿರುವಿಕೆ / ಇತರರ ಗುಣದಲ್ಲಿ ದ್ವೇಷವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न असूया ।<br><b>प्रयोगाः - </b>“न गुणान् गुणिनो हन्ति स्तौति चान्यगुणानपि । न हतेच्छान्यदोषांश्च सानसूया प्रकीर्तिता” ।<br><br>अनसूया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಕುಂತಲೆಯ ಸಖಿ<br><br>अनसूया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಸೂಯೆ / ಅತ್ರಿಮಹರ್ಷಿಯ ಪತ್ನಿ<br><b>विस्तारः - </b>[ಅನಸೂಯೆಯು ಮಹಾಪತಿವ್ರತೆ. ಒಂದು ಸಲ ಬ್ರಹ್ಮ ವಿಷ್ಣು ಮಹೇಶ್ವರರು ಅನಸೂಯೆಯ ಪ್ತಿವ್ರತ್ಯವನ್ನು ಪರೀಕ್ಷಿಸಲೋಸುಗ ತಮಗೆ ನಗ್ನಳಾಗಿ ಊಟಕ್ಕೆ ಬಡಿಸಬೇಕೆಂದು ಕೇಳುವರು. ಆಗ ಅನಸೂಯೆಯ್ ಕಮಂಡುಲುವಿನ ತೀರ್ಥದಿಂದ ಅವರನ್ನು ಪ್ರೋಕ್ಷಿಸಲು ಆ ತ್ರಿಮೂರ್ತಿಗಳೂ ಶಿಶುಗಳಾಗುವರು. ಮೂರು ಶಿಶುಗಳನ್ನೂ ತೊಟ್ಟಿಲಿನಲ್ಲಿ ಮಲಗಿಸಿ ನಗ್ನಳ್ಗಿಯೇ ಹಾಲು ಮೊದಲಾದುವನ್ನು ಕೊಡುತ್ತಿದ್ದಳು. ಹೀಗೆ ಅನೇಕ ದಿನಗಳು ಕಳೆದರೂ ತಮ್ಮ ಪತಿಗಳು ಬರದಿದ್ದುದರಿಂದ ಲಕ್ಷ್ಮಿ, ಸರಸ್ವತಿ ಮತ್ತು ಪಾರ್ವತಿ ಇವರು ಅನಸೂಯೆಯಲ್ಲಿಗೆ ಬಂದು ಪ್ರಾರ್ಥಿಸಿಕೊಳ್ಳಲು ನಿಮ್ಮ ನಿಮ್ಮ ಪತಿಗಳನ್ನು ನೀವೇ ಕರೆದುಕೊಳ್ಳಬಹುದೆಂದು ತೊಟ್ಟಿಲುಗಳಲ್ಲಿ ಶಿಶುಗಳನ್ನು ತೋರಿಸಿದಾಗ ಅವರು ತಮ್ಮ ಪತಿಗಳ ಗುರುತನ್ನು ಕಂಡುಹಿಡಿಯಲಾರದೆ ಹೋಗುವರು. ಆಗ ಪುನಃ ಕಮಂಡಲುವಿನ ತೀರ್ಥದಿಂದ ಪ್ರೋಕ್ಷಿಸಲು ತ್ರಿಮೂರ್ತಿಗಳಿಗೂ ನಿಜರೂಪವುಂಟಾಗಲು ಅವರು ತಮ್ಮತಮ್ಮ ಪತಿಗಳೊಡನೆ ನಿಜಲೋಕಗಳಿಗೆ ತೆರಳುವರೆಂದು ಅನಸೂಯೆಯ ಪಾತಿವ್ರತ್ಯದ ವಿಷಯವಾಗಿ ಕಥೆಯಿರುವುದು.]<br><br>

अनसूयु
अनसूयु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸೂಯೆಯಿಲ್ಲದ / ಇತರರ ಗುಣದಲ್ಲಿ ದ್ವೇಷವಿಲ್ಲದ<br><b>प्रयोगाः - </b>“इदं तु ते गुह्यतमं प्रवक्ष्याम्यनसूयवे” |<br><b>उल्लेखाः - </b>गीता ९-१ ।<br><br>

अनहङ्कारिन्
अनहङ्कारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಹಂಕಾರವಿಲ್ಲದ / ಗರ್ವವಿಲ್ಲದ<br><br>

अनहङ्कृत
अनहङ्कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಹಂಕಾರಪಡದ<br><br>

अनहङ्कृति
अनहङ्कृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಹಂಕಾರವಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>न० त० ।<br><br>अनहङ्कृति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಹಂಕಾರವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति अहङ्कृतिर्यस्य ।<br><br>

अनहन्
अनहन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ರಶಸ್ತದಿವಸ / ಕೆಟ್ಟದಿವಸ<br><b>निष्पत्तिः - </b>अप्राशस्त्ये न० त० ।<br><br>

अनाकार
अनाकार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕಾರವಿಲ್ಲದ / ರೂಪವಿಲ್ಲದ (ಆಕಾಶ ಮೊದಲಾದುದು)<br><b>व्युत्पत्तिः - </b>नास्ति आकारोऽस्य ।<br><br>

अनाकाल
अनाकाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಭಿಕ್ಷಕಾಲ<br><b>निष्पत्तिः - </b>न० त० ।<br><b>व्युत्पत्तिः - </b>आ सम्यक् अन्नादिसम्पन्नः कालः आकालः ।<br><br>

अनाकुल
अनाकुल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಥಿರಚಿತ್ತನಾದ / ಚಲಿಸದ ಮನಸ್ಸುಳ್ಳ<br><br>अनाकुल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕದಲದಿರುವ / ಸ್ಥಿರವಾದ<br><br>अनाकुल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇರಿಕೊಂಡಿರುವ / ಚದುರದಿರುವ / ಒಟ್ಟುಗೂಡಿದ<br><b>व्युत्पत्तिः - </b>न आकुलः ।<br><br>अनाकुल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಲ್ಲಾಪಿಲ್ಲಿಯಾಗದೆ / ಒಟ್ಟುಗೂಡಿ<br><br>

अनाकृत
अनाकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಡದ / ತಡೆಯಲ್ಪಡದ<br><br>

अनाक्रान्ता
अनाक्रान्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಿಸಲ್ಪಡದ / ಸ್ವಾಧೀನಪಡಿಸಿಕೊಳ್ಳಲ್ಪಡದ<br><br>

अनाग
अनाग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न आ सम्यक् गच्छति स्वर्गमनेन नागः अधर्मः । न नागः यस्य ।<br><br>

अनागत
अनागत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭವಿಷ್ಯತ್ ಕಾಲ<br><br>अनागत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಲುಪದಿರುವ / ಬರದಿರುವ / ಆಗಮಿಸದಿರುವ<br><b>प्रयोगाः - </b>“तावद्भयस्य भेतव्यं याअद्भूयमनागतम्” |<br><b>उल्लेखाः - </b>हितो० ।<br><br>अनागत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂದೆ ಹೊಂದಲ್ಪಡದ / ಮುಂದೆ ಉಂಟಾಗಬಹುದಾದ<br><b>प्रयोगाः - </b>“सर्वो हि नोपगतमप्यवचीयमानं वधिष्णुमाश्रयमनागतमभ्युपैति” |<br><b>उल्लेखाः - </b>माघ० ५-१४ ।<br><br>

अनागतविधातृ
अनागतविधातृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂದೆ ಒದಗಬಹುದಾದ ಕಷ್ಟಗಳಿಗೆ ಮೊದಲೇ ಪ್ರತಿಕ್ರಿಯೆಯನ್ನು ನಡೆಸುವವನು<br><b>व्युत्पत्तिः - </b>अनागतस्य भविष्यतः अनिष्टस्य विधाता प्रतिविधाता ।<br><b>प्रयोगाः - </b>“अनागतविधाता च प्रत्युत्पन्नमतिस्तथा । “अनागतविधाता च प्रत्युत्पन्नमतिस्तथा । द्वाविमौ सुखमेधेते यद्भविष्यो विनश्यति”|<br><b>उल्लेखाः - </b>हितो० ।<br><br>

अनागतविधान
अनागतविधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂದೆ ಒದಗಬಹುದಾದ ತೊಂದರೆಗೆ ಮಾಡುವ ಪ್ರತಿಕ್ರಿಯೆ / ತೊಂದರೆ ಬರುವ ಮುನ್ನವೇ ನಡೆಯಿಸುವ ಪರಿಹಾರಕ್ರಮ<br><b>व्युत्पत्तिः - </b>अनागतस्य भविष्यतोऽनिष्टस्य विधानं प्रतिक्रिया ।<br><br>

अनागतार्तवा
अनागतार्तवा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಋತುಮತಿಯಾಗದ ಕನ್ಯೆ<br><b>व्युत्पत्तिः - </b>अनागतमार्तवं यस्याः ।<br><br>

अनागति
अनागति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಾಗಮನ / ಬರದಿರುವಿಕೆ<br><br>

अनागम
अनागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಸ್ತಿಯನ್ನು ಸ್ವಾಧೀನಪಡಿಸಿಕೊಳ್ಳಲು ಆಗಬೇಕಾದ ಕ್ರಯಪತ್ರ ಮೊದಲಾದವುಗಳಿಲ್ಲದಿರುವಿಕೆ<br><br>अनागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬರದಿರುವಿಕೆ<br><br>अनागम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಗಮಿಸದಿರುವ / ಬರದಿರುವ<br><br>

अनागम्य
अनागम्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲು ಸಾಧ್ಯವಾಗದಿರುವ / ಸಮೀಪಿಸಲು ಸಾಧ್ಯವಲ್ಲದ / ದುರ್ಗಮವಾದ<br><br>

अनागस्
अनागस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪರಾಧವಿಲ್ಲದ<br><br>अनागस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति आगः यस्य ।<br><b>प्रयोगाः - </b>“आर्तत्राणाय वः शस्त्रं न प्रहर्तुमनागसि” |<br><b>उल्लेखाः - </b>शाकु० १-१० ।<br><br>

अनाचार
अनाचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟನಡತೆ / ಕೆಟ್ಟಸಂಪ್ರದಾಯ<br><b>व्युत्पत्तिः - </b>न प्रशस्तः आचारः ।<br><b>प्रयोगाः - </b>“सर्वदेशेष्वनाचारः पथि ताम्बूलचर्वणम्” |<br><b>उल्लेखाः - </b>स्मृतिः ।<br><br>अनाचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೂಢಿಯಿಲ್ಲದಿರುವಿಕೆ / ಸಂಪ್ರದಾಯಶೂನ್ಯತೆ<br><b>विस्तारः - </b>[ವಿಹಿತವಾದುದನ್ನು ಮಾಡದಿರುವುದೂ ನಿಷಿದ್ಧವಾದುದನ್ನು ಮಾಡುವುದೂ ಅನಾಚಾರವು.]<br><br>

अनाज्ञात
अनाज्ञात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ತಿಳಿಯಲ್ಪಡದ<br><br>

अनातप
अनातप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಛಾಯೆ / ನೆರಳು<br><br>अनातप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಸಿಲಿಲ್ಲದ<br><br>

अनातर
अनातर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆತುರವಿಲ್ಲದ / ತವಕವಿಲ್ಲದ<br><b>प्रयोगाः - </b>“अनातुरोत्कण्ठितयोः प्रसिध्यता” |<br><b>उल्लेखाः - </b>माल० ३-१५ ।<br><br>अनातर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೋಗವಿಲ್ಲದ / ಆರೋಗ್ಯವುಳ್ಳ<br><b>प्रयोगाः - </b>“जुगोपात्मानमत्रस्तो भेजे धर्ममनातुरः” |<br><b>उल्लेखाः - </b>रघु० १-२१ ।<br><br>

अनात्मज्ञ
अनात्मज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆತ್ಮಸ್ವರೂಪವನ್ನರಿಯದ / ಆತ್ಮಜ್ಞಾನವಿಲ್ಲದ<br><br>अनात्मज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನ ಸ್ವರೂಪವನ್ನರಿಯದ / ತನ್ನ ಯೋಗ್ಯತೆಯನ್ನು ತಿಳಿಯದ / ಮೂರ್ಖ<br><b>निष्पत्तिः - </b>ज्ञा (अवबोधने) “कः” (३-२-३) ।<br><b>व्युत्पत्तिः - </b>न आत्मानं जानाति |<br><b>प्रयोगाः - </b>“कथं कायविनिमयेन मयि व्यवहरत्यनात्मज्ञः” |<br><b>उल्लेखाः - </b>माल० १ ।<br><br>

अनात्मन्
अनात्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮಭಿನ್ನ / ತನಗಿಂತಲೂ ಬೇರೆಯವನು / ಇತರನು<br><br>अनात्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಕೃಷ್ಟವಾದ ಭೌತಿಕದೇಹ<br><b>व्युत्पत्तिः - </b>न अन्यः अप्रशस्तो वा आत्मा ।<br><b>प्रयोगाः - </b>“अप्राप्तः प्राप्यते योऽयमत्यन्तं त्यज्यतेऽथवा । जानीयात्तमनात्मानं बुद्ध्यन्तं वपुरादिकम्” ।<br><br>अनात्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>(ತನ್ನ) ಮನಸ್ಸನ್ನು ಅಂಕೆಯಲ್ಲಿಡದ / ಮನಸ್ಸನ್ನು ಬಿಗಿಹಿಡಿಯದ<br><b>प्रयोगाः - </b>“अनात्मनस्तु शत्रुत्वे वर्तेत्त्मैव शत्रुवत्” |<br><b>उल्लेखाः - </b>गीता ६-६-|<br><br>

अनात्मवत्
अनात्मवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯನಿಗ್ರಹವಿಲ್ಲದ / ಜಿತೇಂದ್ರಿಯನಲ್ಲದ<br><b>निष्पत्तिः - </b>“मतुप्” (५-२-९४) ।<br><b>व्युत्पत्तिः - </b>न आत्मा वश्यत्वेनास्त्यस्य |<br><br>

अनाथ
अनाथ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಡೆಯನಿಲ್ಲದ / ಯಜಮಾನನಿಲ್ಲದ<br><br>अनाथ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಹಾಯಕನಿಲ್ಲದ / ರಕ್ಷಕನಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति नाथः यस्य ।<br><b>प्रयोगाः - </b>“नाथवन्तस्त्वया लोकास्त्वमनाथा विपत्स्यसे” |<br><b>उल्लेखाः - </b>उ० रा० १-४३ ।<br><br>

अनादर
अनादर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಿಭವ / ತಿರಸ್ಕಾರ / ಅವಮಾನಪಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>विरोधे न० त० ।<br><b>व्युत्पत्तिः - </b>न आदरः ।<br><b>प्रयोगाः - </b>“अनादराकृष्टमुलूखलं तत्” |<br><b>उल्लेखाः - </b>याद० ४-३७ ।<br><br>अनादर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>न आदरो यस्य । अवाप्तसमस्तकामत्वेन आदर्तव्याभावात् ।<br><br>अनादर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆದರವಿಲ್ಲದ / ಗೌರವವಿಲ್ಲದ<br><br>

अनादि
अनादि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>न आदिर्यस्य ।<br><br>अनादि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿರಣ್ಯಗರ್ಭ / ಬ್ರಹ್ಮ<br><b>व्युत्पत्तिः - </b>न आदिर्यस्मात् ।<br><br>अनादि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>(ಅದ್ವೈತಿಗಳ ಮತದಲ್ಲಿ) ಅನಾದಿಷಟ್ಕ<br><b>विस्तारः - </b>[(1) ಜೀವ, (2) ಈಶ, (3) ಶುದ್ಧ ಚೈತನ್ಯ, (4) ಜೀವೇಶ್ವರಭೇದ, (5) ಮಾಯೆ ಮತ್ತು (6) ಮಾಯ್ಚೈತನ್ಯ ಸಂಬಂಧ ಇವು ಆರೂ ಅನಾದಿಗಳು.]<br><br>अनादि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆದಿಯಿಲ್ಲದ / ಉತ್ಪತ್ತಿಯಿಲ್ಲದ / ಶಾಶ್ವತವಾದ / ನಿತ್ಯವಾದ<br><b>प्रयोगाः - </b>“जगदादिरनादिस्त्वं जगदीशो निरीश्वरः” |<br><b>उल्लेखाः - </b>कुमा० २-९ ।<br><br>

अनादीनव
अनादीनव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರ್ದೋಷವಾದ<br><b>प्रयोगाः - </b>“यद्वसुदेवेनादीनमनादीनवमीरितम्” |<br><b>उल्लेखाः - </b>माघ २-२२ ।<br><br>अनादीनव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪವಿಲ್ಲದ<br><br>अनादीनव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ಲೇಶವಿಲ್ಲದ<br><br>अनादीनव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುಃಖದಲ್ಲಿ ಕೊನೆಗಾಣದ / ಸುಖಾಂತವಾದ<br><b>विस्तारः - </b>1. “आदीनवःपुनर्दोषे परिक्लिष्टदुरन्तयोः”- हेम० । 2. “रोषेत्वादीनवाश्रवौ”- वैज० ।<br><br>

अनादृत
अनादृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಮಾನ / ತಿರಸ್ಕಾರ<br><b>निष्पत्तिः - </b>आ+दृङ् (आदरे) भावे “क्तः” (३-३-११४) । न० त० ।<br><br>अनादृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿಸಲ್ಪಡದ / ಅಪೇಕ್ಷಿಸಲ್ಪಡದ<br><b>प्रयोगाः - </b>“अनादृतस्तन्यरसैर्मुकुन्दः” |<br><b>उल्लेखाः - </b>याद० ४-८५ ।<br><br>अनादृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ / ಅವಮಾನಗೊಳಿಸಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>न आदृतः ।<br><br>

अनादेय
अनादेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವೀಕರಿಸಲು ಯೋಗ್ಯವಲ್ಲದ<br><b>प्रयोगाः - </b>“अनादेयस्य चादानादादेयस्य च वर्जनात्” |<br><b>उल्लेखाः - </b>मनु० ८-१७१ ।<br><br>

अनादेश
अनादेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪದೇಶವಿಲ್ಲದಿರುವಿಕೆ<br><br>अनादेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆಯಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>अभावे न० त० ।<br><b>व्युत्पत्तिः - </b>न आदेशः ।<br><br>

अनादेशकर
अनादेशकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆಯಂತೆ ನಡೆಯದಿರುವ / ಅಪ್ಪಣೆಯನ್ನು ನೆರವೇರಿಸದಿರುವ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>कृञ् (करणे) “टः” (३-२-२०) ।<br><b>व्युत्पत्तिः - </b>न आदेशं करोति |<br><br>अनादेशकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪದೇಶಮಾಡದ / ಸಲಹೆಕೊಡದ<br><br>

अनाद्य
अनाद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭುಜಿಸಲು ಅನರ್ಹವಾದ / ತಿನ್ನಲು ಯೋಗ್ಯವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न आद्यम् ।<br><br>अनाद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊದಲನೆಯದಲ್ಲದ<br><br>

अनाधार
अनाधार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><b>प्रयोगाः - </b>“अशेषाधारमेकं त्व्मनाधारमधीयते” |<br><b>उल्लेखाः - </b>याद० १६-११२ ।<br><br>अनाधार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति आचारो यस्य ।<br><br>

अनाधि
अनाधि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನೋವ್ಯಥೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न आधिर्यस्य ।<br><b>प्रयोगाः - </b>“धनुरधिज्यमनाधिरूप्ददे” |<br><b>उल्लेखाः - </b>रघु० ९-५४ ।<br><br>

अनाधृष्ट
अनाधृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಡದ / ಎದುರಿಸಲ್ಪಡದ / ಜಯಿಸಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न आधृष्टः ।<br><br>

अनाधृष्य
अनाधृष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲಾಗದ / ಎದುರಿಸಲಾಗದ / ಜಯಿಸಲಾಗದ<br><br>

अनापि
अनापि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಂಧುಗಳಿಲ್ಲದ<br><br>अनापि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ನೇಹಿತರಿಲ್ಲದ<br><b>निष्पत्तिः - </b>आप्लृ (व्याप्तौ) कर्म० “इन्” (उ० ४-११७) ।<br><b>व्युत्पत्तिः - </b>आप्यते | आपिः आप्तः । न आपिर्यस्य ।<br><br>

अनाप्त
अनाप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಡದ<br><br>अनाप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಫಲವನ್ನು ಹೊಂದದ / ಕೊನೆಯನ್ನು ಮುಟ್ಟದ<br><br>अनाप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಪ್ತನಲ್ಲದ / ಸ್ನೇಹಿತನಲ್ಲದ<br><br>अनाप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಂಧುವಲ್ಲದ<br><br>अनाप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಾಣನಲ್ಲದ / ನಿಪುಣತೆಯಿಲ್ಲದ<br><b>प्रयोगाः - </b>“युग्यस्थाः प्राजकेऽनाप्ते सर्वे दण्ड्याः शतं शतम्” |<br><b>उल्लेखाः - </b>मनु० ८-२९४ ।<br><br>

अनामक
अनामक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಲಮಾಸ / ಅಧಿಕಮಾಸ<br><br>अनामक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನಾಮಿಕೆಯೆಂಬ ಬೆರಳು / ಉಂಗುರದ ಬೆರಳು<br><br>अनामक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಶೋರೋಗ / ಮೂಲವ್ಯಾಧಿ<br><br>अनामक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಸರಿಲ್ಲದವನು / ಹೆಸರು ಪಡೆಯದವನು / ಅಪ್ರಸಿದ್ಧ<br><br>

अनामन्
अनामन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಲಮಾಸ / ಅಧಿಕಮಾಸ<br><br>अनामन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನಾಮಿಕೆಯೆಂಬ ಬೆರಳು / ಉಂಗುರದ ಬೆರಳು<br><br>अनामन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಶೋರೋಗ / ಮೂಲವ್ಯಾಧಿ<br><br>अनामन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ರಸಿದ್ಧ / ಹೆಸರು ಪಡೆಯದವನು<br><br>

अनामय
अनामय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು / ಈಶ್ವರ<br><b>व्युत्पत्तिः - </b>न आमयः यस्मात् ।<br><b>विस्तारः - </b>[ಪರಮಾತ್ಮನು ಸಕಲವಿಧವಾದ ರೋಗಗಳನ್ನೂ ಪರಿಹರಿಸುವವನು.]<br><br>अनामय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆರೋಗ್ಯ<br><b>निष्पत्तिः - </b>अम (रोगे) भावे “घञ्” (३-३-१८) “डः” (वा० ३-२-१०१) ।<br><b>व्युत्पत्तिः - </b>आमयस्याभावः ।<br><b>प्रयोगाः - </b>1. “स भवन्तमनामयप्रश्नम्पूर्वकमाह” | 2. “ब्राह्मणं कुशलं पृच्छेत्क्षत्रबन्धुमनामयम्” |<br><b>उल्लेखाः - </b>1. शाकु० ५ । 2. मनु० २-१२७ ।<br><br>अनामय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೋಗವಿಲ್ಲದ / ಉಪದ್ರವವಿಲ್ಲದ / ಸೌಖ್ಯವುಳ್ಳ<br><b>प्रयोगाः - </b>“जन्मबन्धविनिर्मुक्ताः पदं गच्छत्यनामयम्” |<br><b>उल्लेखाः - </b>गीता २-५१ ।<br><br>

अनामा
अनामा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಾಮಿಕೆ / ಉಂಗುರದ ಬೆರಳು / ಹೆಸರನ್ನು ಹಿಡಿದು ಕರೆಯಲು ಅನರ್ಹವಾದ ಬೆರಳು<br><b>निष्पत्तिः - </b>“डाप्” (४-१-१३) ।<br><b>व्युत्पत्तिः - </b>न प्रशस्तं नाम यस्याः |<br><b>विस्तारः - </b>[ಈಶ್ವರನು ಈ ಬೆರಳಿನಿಂದ ಬ್ರಹ್ಮನ ಶಿರಸ್ಸನ್ನು ಕತ್ತರಿಸಿದ್ದರಿಂದ ಈ ಹೆಸರು.]<br><br>

अनामिका
अनामिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಂಗುರದ ಬೆರಳು / ಅನಾಮಿಕೆಯೆಂಬ ಬೆರಳು / ಹೆಸರನ್ನು ಹಿಡಿದು ಕರೆಯಲು ಅನರ್ಹವಾದ ಬೆರಳು<br><b>निष्पत्तिः - </b>स्वार्थे “कन्” ।<br><b>व्युत्पत्तिः - </b>न नाम ग्रहणयोग्यमस्याः ।<br><b>प्रयोगाः - </b>“पुरा कवीन्ं गणनाप्रसङ्गे कनिष्ठिक्धिष्ठितकालिदास् । अद्यापि तत्तुल्यकवेरभावादनामिका सार्थवती बभूव” ।|<br><br>

अनायक
अनायक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಜಮಾನನಿಲ್ಲದ / ಕ್ರಮಗೆಟ್ಟ / ಶಿಸ್ತು ಇಲ್ಲದ<br><br>

अनायत
अनायत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ದವಾಗಿಲ್ಲದ / ಹ್ರಸ್ವವಾಗಿರುವ / ತುಂಡಾಗಿರುವ<br><b>व्युत्पत्तिः - </b>न आयतः ।<br><br>

अनायत्त
अनायत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧೀನವಲ್ಲದ / ಸ್ವತಂತ್ರವಾದ<br><b>व्युत्पत्तिः - </b>न आयत्तः ।<br><b>प्रयोगाः - </b>“एतावज्जन्मसाफल्यं यदनायत्तवृत्तित्” |<br><b>उल्लेखाः - </b>हितो० २-२२ ।<br><br>

अनायन
अनायन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಏಕಾಂತ<br><br>अनायन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏಕಪ್ರಕಾರವಾದ / ವಿಕಾರವನ್ನು ಹೊಂದದ / ಬದಲಾವಣೆ ಹೊಂದದಿರುವ<br><b>व्युत्पत्तिः - </b>न आयनं चालनं यत्र ।<br><br>

अनायास
अनायास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನವಿಲ್ಲದಿರುವಿಕೆ<br><br>अनायास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಯಾಸವಿಲ್ಲದಿರುವಿಕೆ / ಸೌಲಭ್ಯ / ಸೌಕರ್ಯ<br><br>अनायास<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರಮವಿಲ್ಲದ / ಆಯಾಸವಿಲ್ಲದ<br><br>अनायास<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನವಿಲ್ಲದ<br><br>

अनायासकृत
अनायासकृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಯಾಸವಿಲ್ಲದೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>अनायासेन अल्पप्रयत्नेन कृतम् ।<br><br>अनायासकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಲಭವಾಗಿ ಮಾಡಲ್ಪಟ್ಟ<br><br>

अनायुष्य
अनायुष्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಯುಸ್ಸಿಗೆ ಹಿತವಲ್ಲದ ಭೋಜನ / ಅತಿಭೋಜನ<br><b>निष्पत्तिः - </b>आयुस् “यत्” (५-१-५) । न० त० ।<br><b>व्युत्पत्तिः - </b>न आयुषे हितम् |<br><br>अनायुष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೀರ್ಘಾಯುಸ್ಸಿಗೆ ತೊಂದರೆಯುಂಟುಮಾಡುವ / ದೀರ್ಘಾಯುಸ್ಸಿಗೆ ಅಹಿತವಾದ<br><br>

अनारत
अनारत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಡಬಿಡದ ಸಂಬಂಧ / ವಿರಾಮವಿಲ್ಲದಿರುವಿಕೆ / ವಿಚ್ಛೇದವಿಲ್ಲದಿರುವಿಕೆ<br><br>अनारत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿರಾಮವಿಲ್ಲದ / ಎಡಬಿಡದ<br><br>अनारत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿರಾಮವಿಲ್ಲದೆ / ಎಡಬಿಡದೆ<br><b>व्युत्पत्तिः - </b>अविद्यमानमारतं विरामः यस्मिन् ।<br><b>प्रयोगाः - </b>“अनारतं तेन पदेषु लम्भिताः” |<br><b>उल्लेखाः - </b>किरा० १-१५ ।<br><br>

अनारम्भ
अनारम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭಿಸದಿರುವಿಕೆ / ಪ್ರಯತ್ನಪಡದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>अभावे न० त० ।<br><b>व्युत्पत्तिः - </b>न आरम्भः ।<br><b>प्रयोगाः - </b>“विकारं खलु परमार्थतोऽज्ञात्व्ऽनारम्भः प्रतीकारस्य” |<br><b>उल्लेखाः - </b>शाकु० ३ ।<br><br>

अनारोग्य
अनारोग्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆರೋಗ್ಯವಿಲ್ಲದಿರುವಿಕೆ / ಬೇನೆ / ರೋಗ<br><b>व्युत्पत्तिः - </b>न आरोग्यम् ।<br><br>अनारोग्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೋಗಕ್ಕೆ ಕಾರಣವಾದ<br><b>व्युत्पत्तिः - </b>न आरोग्यं यस्मात् ।<br><br>

अनार्जव
अनार्जव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗ<br><b>व्युत्पत्तिः - </b>नास्ति आर्जवं यस्मिन् ।<br><br>अनार्जव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಕ್ರತೆ / ಕುಟಿಲತೆ<br><br>अनार्जव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಟ / ಮೋಸ<br><br>अनार्जव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಕ್ರವಾದ / ಕುಟಿಲವಾದ<br><b>व्युत्पत्तिः - </b>न आर्जवं यस्य ।<br><br>

अनार्तव
अनार्तव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಋತುವಿನಲ್ಲಿ ಹುಟ್ಟದಿರುವ / ಆಯಾ ಋತುವಿಗೆ ಸಂಬಂಧಪಡದ<br><br>

अनार्तवा
अनार्तवा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಋತುಮತಿಯಾಗದ ಕನ್ಯೆ<br><br>

अनार्य
अनार्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆರ್ಯನಲ್ಲದವನು / ಒಳ್ಳೆಯ ನಡತೆಯಿಲ್ಲದವನು<br><br>अनार्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆರ್ಯನಿಲ್ಲದ ದೇಶ<br><br>

अनार्यक
अनार्यक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗರುಮರ<br><br>

अनार्यकर्मन्
अनार्यकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀಚಕಾರ್ಯ / ಕೆಟ್ಟಕೆಲಸ<br><br>अनार्यकर्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಕೆಲಸ ಮಾಡುವ<br><b>व्युत्पत्तिः - </b>अनार्य कर्म यस्य ।<br><br>

अनार्यज
अनार्यज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮ್ಲೇಚ್ಛದೇಶದಲ್ಲಿ ಹುಟ್ಟಿದ ಅಗರುಮರ<br><b>व्युत्पत्तिः - </b>अनार्ये देशे भवम् ।<br><br>अनार्यज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀಚನಿಂದ ಹುಟ್ಟಿದ<br><br>

अनार्यतिक्त
अनार्यतिक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೆಲಬೇವಿನಮರ<br><b>व्युत्पत्तिः - </b>अनार्यप्रियः तिक्तः ।<br><br>

अनार्ष
अनार्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇದದಲ್ಲಿ ಪ್ರಯೋಗಿಸಲ್ಪಡದ / ಅವೈದಿಕ<br><b>निष्पत्तिः - </b>न० त० ।<br><b>व्युत्पत्तिः - </b>ऋषिर्वेदः तत्रोक्तः आर्षः । न आर्षः ।<br><br>अनार्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಋಷಿಗಳಿಗೆ ಸಂಬಂಧಪಡದ<br><br>अनार्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಋಷಿಗಳಿಂದ ಕಾಣಲ್ಪಡದ<br><b>निष्पत्तिः - </b>न० त० ।<br><b>व्युत्पत्तिः - </b>ऋषिणा दृष्टम् आर्षम् ।<br><br>

अनालम्ब
अनालम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न आलम्बः ।<br><br>अनालम्ब<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯವಿಲ್ಲದ / ಆಧಾರವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति आलम्बो यस्य ।<br><b>प्रयोगाः - </b>“कथङ्क्रमनालम्बा कीर्तिद्यमिधिरोहति” |<br><b>उल्लेखाः - </b>माघ० २-५२ ।<br><br>

अनालोचित
अनालोचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯೋಚಿಸಲ್ಪಡದ / ಆಲೋಚಿಸಲ್ಪಡದ / ಉಪೇಕ್ಷೆಮಾಡಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>न आलोचितम् ।<br><b>प्रयोगाः - </b>“अनालोचितक्र्यस्य वाग्जालं वाग्मिनो वृथा” |<br><b>उल्लेखाः - </b>माघ० २-२७ ।<br><br>अनालोचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಿರೀಕ್ಷಿತವಾದ<br><br>अनालोचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ವಿಮರ್ಶೆಮಾಡಲ್ಪಡದ<br><br>

अनाविद्ध
अनाविद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇರಿಯಲ್ಪಡದ / ವೆಜ್ಜಮಾಡಲ್ಪಡದ / ರಂಧ್ರಮಾಡಲ್ಪಡದ / ಗಾಯಮಾಡಲ್ಪಡದ<br><br>अनाविद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಕ್ರವಲ್ಲದ / ಬಗ್ಗಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न आविद्धः ।<br><b>प्रयोगाः - </b>“अनाविद्धं रत्नं मधु नवमनास्वादितरसम्” |<br><b>उल्लेखाः - </b>शाकु० २-१० ।<br><br>

अनाविल
अनाविल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಕಲುಷ / ಕಲಕದಿರುವ / ಪ್ರಸನ್ನವಾದ / ನಿರ್ಮಲವಾದ<br><b>निष्पत्तिः - </b>न० त० ।<br><b>प्रयोगाः - </b>“अनाविलधियामन्तश्चिन्तामणिरिव स्फुरन्” |<br><b>उल्लेखाः - </b>याद० १-५२ ।<br><br>

अनावृत
अनावृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆವರಿಸಲ್ಪಡದ / ಸುತ್ತುವರಿಯಲ್ಪಡದ<br><br>

अनावृत्त
अनावृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊದಲನೆಯ ಸಲ ಬಂದಿರುವ<br><br>अनावृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮತ್ತೆ ಬರದಿರುವ<br><b>निष्पत्तिः - </b>न० त० ।<br><br>

अनावृत्ति
अनावृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುನಃ ಆಗಮಿಸದಿರುವಿಕೆ / ಮತ್ತೆ ಬರದೆ ಇರುವಿಕೆ<br><br>अनावृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಧವಿಮೋಚನೆ / ಮೋಕ್ಷ / ಸಂಸ್ರದಿಂದ ಬಿಡುಗಡೆ<br><b>निष्पत्तिः - </b>न० त० ।<br><br>

अनावृष्टि
अनावृष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಳೆಯು ಬರದಿರುವಿಕೆ / ಆರು ವಿಧ ಈತಿಬಾಧೆಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>“अतिवृष्टिरनावृष्टिर्मूषकाः शलभाः शुकाः । अत्यासन्नाश्च राजानः षडेता ईतयः स्मृताः” ।<br><br>

अनाश
अनाश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>व्युत्पत्तिः - </b>नास्ति आशा यस्य । नास्ति नाशो यस्य |<br><br>

अनाशक
अनाशक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಬೋಜನವಿಲ್ಲದ<br><b>निष्पत्तिः - </b>आ+अश (भोजने) “घञ्” (३-३-१८) । तन्नास्ति यस्य “कप्” (५-४-१५४) ।<br><b>व्युत्पत्तिः - </b>आ सम्यक् आशः अशनम् |<br><br>अनाशक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಹೊಂದದ / ಶಾಶ್ವತವಾದ / ಅನಶ್ವರ<br><b>निष्पत्तिः - </b>“कप्” (५-४-१५४) ।<br><b>व्युत्पत्तिः - </b>न नाशो यस्य ।<br><br>अनाशक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸದ<br><br>

अनाशिन्
अनाशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>निष्पत्तिः - </b>णश (अदर्शने) “उण्” । न० त० । अशू (व्याप्तौ) “उण्” (उ० १-१) । न० त० ।<br><br>

अनाशु
अनाशु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶರಹಿತ / ಶಾಶ್ವತವಾದ<br><b>निष्पत्तिः - </b>णश (अदर्शने) “उण्” । न० त० ।<br><br>अनाशु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಪಿಸದಿರುವ / ಪಸರಿಸದಿರುವ / ಹಬ್ಬದಿರುವ<br><br>अनाशु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಧಾನವಾದ / ಸಾವಕಾಶವಾದ<br><b>निष्पत्तिः - </b>अशू (व्याप्तौ) “उण्” (उ० १-१) । न० त० ।<br><br>

अनाश्य
अनाश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸಲು ಅನರ್ಹವಾದ<br><br>अनाश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸಲು ಸಾಧ್ಯವಿಲ್ಲದ<br><br>

अनाश्रमिन्
अनाश्रमिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹಸ್ಥಾದ್ಯಾಶ್ರಮವನ್ನು ಸ್ವ್ಕರಿಸದವನು / ಯಾವ ಆಶ್ರಮದ ಧರ್ಮವನ್ನೂ ಆಚರಿಸದವನು.<br><b>निष्पत्तिः - </b>। न० त० ।<br><b>व्युत्पत्तिः - </b>न आश्रमी<br><b>प्रयोगाः - </b>“अनाश्रमी न तिष्ठेत्तु क्षणमेकमपि द्विजः” ।<br><b>उल्लेखाः - </b>स्मृतिः ।<br><br>अनाश्रमिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಧುರ / ಅಪತ್ನೀಕ<br><br>

अनाश्रय
अनाश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯವಿಲ್ಲದಿರುವಿಕೆ / ಬೇರೆಯಾಗಿರೋಣ<br><br>अनाश्रय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯವಿಲ್ಲದ<br><br>

अनाश्रव
अनाश्रव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಿಧೇಯ / ಮೊಂಡ / ಚಂಡಿಖೋರ<br><b>व्युत्पत्तिः - </b>न आश्रवः ।<br><b>प्रयोगाः - </b>“दुष्टदोषमपि तन्न सोऽत्यजत्सङ्गवस्तु भिषज्मन्श्रवः” ।<br><b>उल्लेखाः - </b>रघु० १९-४९ ।<br><br>

अनाश्रित
अनाश्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯಪಡೆಯದ / ಬೇರೆಯಾಗಿರುವ / ಅಧೀನನಲ್ಲದ / ಸ್ವತಂತ್ರ<br><b>व्युत्पत्तिः - </b>न आश्रितः ।<br><br>अनाश्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಲಂಬಿಸದ / ಇತರ ಅಪೇಕ್ಷೆಯಿಲ್ಲದ<br><b>प्रयोगाः - </b>“अनाश्रितः कर्मफलं कार्य कर्म करोति यः” ।<br><b>उल्लेखाः - </b>गीता ६-१ ।<br><br>

अनाश्वस्
अनाश्वस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಟಮಾಡದ / ಸುಖಪಡದ<br><b>निष्पत्तिः - </b>अश (भोजने) “कसुः” (३-२-१०९) । न० त० ।<br><b>प्रयोगाः - </b>“इच्छताशितुमनाशुषा न च” ।<br><b>उल्लेखाः - </b>माघ० १४-४९ ।<br><br>

अनाश्वास
अनाश्वास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶ್ವಾಸವಿಲ್ಲದಿರುವಿಕೆ / ಆದರವಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>न० त० ।<br><b>व्युत्पत्तिः - </b>न आश्वासः ।<br><br>

अनास्
अनास्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಖದ ವ್ಯಾಪಾರವಿಲ್ಲದ / ಬಾಯಿಯ ಕೆಲಸವಿಲ್ಲದ / ಮಾತಾಡುವ ಶಕ್ತಿಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>आस्यते निर्स्यतेऽनेन आः मुखम् । तन्नास्ति साधनत्वेनास्य ।<br><br>

अनासादित
अनासादित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಡದ / ಸಂಪಾದಿಸಲ್ಪಡದ<br><br>अनासादित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಿಸಲ್ಪಡದ / ಭೇಟಿಯಾಗದ<br><br>

अनासिक
अनासिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಕುಮೂಗುಳ್ಳ<br><br>अनासिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಕಾರವಾದ ಮೂಗುಳ್ಳ<br><b>व्युत्पत्तिः - </b>नास्ति नासिका यस्य ।<br><br>

अनास्था
अनास्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಾದರ / ಉಪೇಕ್ಷೆ / ಉದಾಸೀನತೆ<br><b>निष्पत्तिः - </b>न० त० ।<br><b>व्युत्पत्तिः - </b>न आस्था ।<br><b>प्रयोगाः - </b>“व्रूत येनात्र वः कार्यमनास्था बाह्यवस्तुषु” ।<br><b>उल्लेखाः - </b>कुमा० ६-६३ ।<br><br>अनास्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಮಾನ / ಅವಮರ್ಯಾದೆ<br><br>अनास्था<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದಾಸೀನನಾದ / ತಟಸ್ಥನಾದ<br><br>

अनास्वाद
अनास्वाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರುಚಿ / ಸಪ್ಪೆ<br><br>अनास्वाद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಪ್ಪೆಯಾದ / ರುಚಿಯಿಲ್ಲದ / ಸಾರವಿಲ್ಲದ<br><br>

अनास्वादित
अनास्वादित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರುಚಿನೋಡಲ್ಪಡದ / ಸವಿಯಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न आस्वादितम् ।<br><b>प्रयोगाः - </b>“मधु नवमनास्वादितरसम्” ।<br><b>उल्लेखाः - </b>शाकु० २-१० ।<br><br>

अनाहत
अनाहत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಡದ ಮತ್ತು ಕತ್ತರಿಸದ ಹೊಸ ಬಟ್ಟೆ / ನೂತನ ವಸ್ತ್ರ<br><b>व्युत्पत्तिः - </b>न आहतम् ।<br><br>अनाहत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಂತ್ರ ಶಾಸ್ತ್ರೋಕ್ತವಾದ ಹೃದಯದೊಳಗಿನ ಒಂದು ಪದ್ಮ<br><br>अनाहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಡೆಯಲ್ಪಡದ / ಗಟ್ಟಿಸಲ್ಪಡದ<br><br>

अनाहार
अनाहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪವಾಸ / ನಿರಶನ / ಲಂಘನ<br><b>व्युत्पत्तिः - </b>न आहारः ।<br><b>प्रयोगाः - </b>“अनाहरेणात्मानं व्यापादयिप्य्मि” ।<br><b>उल्लेखाः - </b>हितो० ।<br><br>अनाहार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಷಯೋಪಭೋಗರಹಿತನಾದ<br><br>

अनाहार्य
अनाहार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಕೃತ್ರಿಮ / ಸ್ವಭಾವಸಿದ್ಧವಾದ<br><br>अनाहार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತರಲು ಸಾಧ್ಯವಲ್ಲದ<br><br>अनाहार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿನ್ನಲು ಅರ್ಹವಲ್ಲದ<br><br>अनाहार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತರಲು ಅರ್ಹವಲ್ಲದ<br><br>

अनाहूत
अनाहूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಮಂತ್ರಣವಿಲ್ಲದ / ಆಹ್ವಾನವಿಲ್ಲದ / ಕರೆಯಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न आहूतः ।<br><b>प्रयोगाः - </b>“अनाहुतोऽध्वरं गच्छेत्” ।<br><br>

अनिकेत
अनिकेत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂನ್ಯಾಸಿ / ಯತಿ / ಸ್ಥಿರವಾದ ಮನೆಯಿಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>नास्ति निकेतो नियमेन निवासो यस्य ।<br><b>प्रयोगाः - </b>“अनग्निरनिकेतः स्याद्ग्राममन्नार्थमाश्रयेत्” ।<br><b>उल्लेखाः - </b>मनु० ६-४३ ।<br><br>अनिकेत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಸಗೃಹವಿಲ್ಲದ / ಮನೆಯಿಲ್ಲದ<br><b>प्रयोगाः - </b>“अनिकेतः स्थिरमतिः” ।<br><b>उल्लेखाः - </b>गीता १२-१९ ।<br><br>

अनिगीर्ण
अनिगीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿನ್ನಲ್ಪಡದ / ನುಂಗಲ್ಪಡದ<br><br>अनिगीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರೆಮಾಚಲ್ಪಡದ / ರಹಸ್ಯವಾಗಿಡಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न निगीर्णः ।<br><br>

अनिग्रह
अनिग्रह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರ್ಬಂಧವಿಲ್ಲದಿರುವಿಕೆ / ಹತೋಟಿಯಿಲ್ಲದಿರುವಿಕೆ / ಸ್ವೇಚ್ಛೆಯಿಂದಿರುವಿಕೆ<br><b>प्रयोगाः - </b>“अनिग्रहाच्चेन्द्रियाणां नरः पतनमृच्छति” ।<br><b>उल्लेखाः - </b>याज्ञ० ३-२१९ ।<br><br>अनिग्रह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರ್ಬಂಧವಿಲ್ಲದ / ಹತೋಟಿಯಿಲ್ಲದ / ಸ್ವತಂತ್ರವಾದ<br><br>

अनिच्छा
अनिच्छा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪೇಕ್ಷೆ / ಉದಾಸೀನತೆ<br><b>व्युत्पत्तिः - </b>न इच्छा ।<br><b>प्रयोगाः - </b>“स्फुटामनिच्छां विवरीतुमुत्सुकाम्” ।<br><b>उल्लेखाः - </b>नैष० ९-१ ।<br><br>अनिच्छा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆಯಿಲ್ಲದಿರುವಿಕೆ<br><b>प्रयोगाः - </b>“जातिभ्रंशकरं कर्म कृत्वान्यतममिच्छया । चरेत्सान्तपनं कृच्छ्रं प्राजापत्यमनिच्छया” ॥<br><b>उल्लेखाः - </b>मनु० ११-१२४ ।<br><br>

अनित
अनित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬದುಕಿರುವ / ಜೀವಿಸಿರುವ<br><b>निष्पत्तिः - </b>अन (प्राणने) “क्तः (३-४-७२) ।<br><br>अनित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದದಿರುವ / ತಲುಪದಿರುವ<br><b>व्युत्पत्तिः - </b>न इतः ।<br><br>अनित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಡದ / ಪಡೆಯಲ್ಪಡದ<br><br>

अनित्य
अनित्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಶ್ವರ / ನಾಶಸ್ವಭಾವದ<br><b>व्युत्पत्तिः - </b>न नित्यः ।<br><b>प्रयोगाः - </b>“तत्र गन्धवती पृथिवी । सा द्विविधा । नित्याऽनित्या च । नित्या परमाणुगुरूपा । अनित्या कार्यरूपा” ॥<br><b>उल्लेखाः - </b>त० सं० ।<br><br>अनित्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸ್ಥಿರ / ಸಂದಿಗ್ಧ / ಅನಿಶ್ಚಿತವಾದ<br><b>प्रयोगाः - </b>“अनित्यो विजयो यस्मात् दृश्यते युध्यमानयोः । पराजयश्च सङ्ग्रामे तस्माद्युद्धं विवर्जयेत्” ।<br><b>उल्लेखाः - </b>मनु० ७-१९९ ।<br><br>अनित्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕಸ್ಮಿಕ / ನೈಮಿತ್ತಿಕ / ಆಗಾಗ್ಗೆ ಸಂಭವಿಸುವ<br><br>अनित्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿತ್ಯವಲ್ಲದ / ವಿಶೇಷರೀತಿಯ<br><b>निष्पत्तिः - </b>“आनाय्योऽनित्ये” पा०सू० (३-१-१२७) ।<br><b>प्रयोगाः - </b>“स हि गार्हपत्यादानीयतेऽनित्यश्च सततमप्रज्वलन्त्” ।<br><b>उल्लेखाः - </b>सि० कौ० ।<br><br>अनित्य<br><br><b>पदविभागः - </b>अव्यय<br><b>कन्नडार्थः - </b>ಆಗಾಗ್ಗೆ / ನೈಮಿತ್ತಿಕವಾಗಿ / ಸಮಯ ಬಂದಾಗ<br><b>प्रयोगाः - </b>“अनित्यं हि स्थितो यस्मात् तस्मादतिथिरुच्यते” ।<br><b>उल्लेखाः - </b>मनु० ३-१०२ ।<br><br>

अनिद्र
अनिद्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿದ್ದೆಯಿಲ್ಲದ<br><br>अनिद्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಾಗರೂಕ / ಎಚ್ಚರಿಕೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>नास्ति निद्रा यस्य ।<br><br>

अनिद्रा
अनिद्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿದ್ದೆಯ ಅಭಾವ / ನಿದ್ದೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अनिद्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಚ್ಚರಿಕೆ / ಜಾಗರೂಕತೆ<br><br>

अनिन्दित
अनिन्दित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಶಸ್ತವಾದ / ನಿಂದಿಸಲ್ಪಡದ / ಸಾಧುವಾದ<br><b>व्युत्पत्तिः - </b>न निन्दितः ।<br><br>

अनिभृत
अनिभृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಂಚಲವಾದ<br><b>प्रयोगाः - </b>“भुवमनिभृतवेलावीचिबाहुः पयोधिः” ।<br><b>उल्लेखाः - </b>किरा० ३-६० ।<br><br>अनिभृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಹಸ್ಯವಲ್ಲದ / ಲೋಕಪ್ರಸಿದ್ಧವಾದ<br><b>व्युत्पत्तिः - </b>न निभृतः ।<br><br>

अनिमित्त
अनिमित्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರಣವಿಲ್ಲದಿರುವಿಕೆ<br><br>अनिमित्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಶಕುನ<br><br>अनिमित्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರಣವಲ್ಲದ / ಆಧಾರವಿಲ್ಲದ / ಆಕಸ್ಮಿಕ<br><br>अनिमित्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಮಿತ್ತವಿಲ್ಲದೆ / ಕಾರಣವಿಲ್ಲದೆ<br><b>प्रयोगाः - </b>“अनिमित्तमिन्दुवदने किमित्रभवतः पराङ्मुखी भवसि” ।<br><b>उल्लेखाः - </b>माल० १-१८ ।<br><br>

अनिमिष
अनिमिष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>“निमिषोऽनिमिषः स्रग्वी” ।<br><b>उल्लेखाः - </b>वि० स० ।<br><br>अनिमिष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><b>व्युत्पत्तिः - </b>नास्ति निमिषः चक्षुःस्पन्दनं यस्य ।<br><b>प्रयोगाः - </b>“गुणमनिमिषचापे कञ्चिदार्प्य सीतां कुशिकतनयवाक्यादग्रहीद्रामभद्रः” ।<br><b>उल्लेखाः - </b>च० रा० १-१८४ ।<br><br>अनिमिष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ಸ್ಯ / ಮೀನು<br><b>विस्तारः - </b>“अनिमिषः सुरमत्स्ययोः” - हेम० ।<br><br>अनिमिष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಣ್ಣಿನ ರೆಪ್ಪೆಯು ಚಲಿಸದಿರುವ / ನೇತ್ರಸ್ಪಂದನವಿಲ್ಲದ<br><br>

अनिमिषाचार्य
अनिमिषाचार्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವಗುರು / ಬೃಹಸ್ಪತಿ<br><b>व्युत्पत्तिः - </b>अनिमिषाणां देवानामाचार्यः ।<br><br>

अनिमेष
अनिमेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>अनिमेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><br>अनिमेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ಸ್ಯ / ಮೀನು<br><b>व्युत्पत्तिः - </b>नास्ति निमेषः चक्षुःस्पन्दनं यस्य ।<br><br>अनिमेष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಣ್ಣಿನ ರೆಪ್ಪೆಯು ಚಲಿಸದಿರುವ / ನೇತ್ರಸ್ಪಂದನವಿಲ್ಲದ<br><b>प्रयोगाः - </b>“शतैस्तमक्ष्णामनिमेषवृत्तिभिः” ।<br><b>उल्लेखाः - </b>रघु० ३-४३ ।<br><br>

अनियत
अनियत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಿತ್ಯ / ಅಸ್ಥಿರ<br><b>व्युत्पत्तिः - </b>न नियतः ।<br><b>प्रयोगाः - </b>“रत्यादयोऽप्यनियते रसे स्युर्व्यभिचारिणः” ।<br><b>उल्लेखाः - </b>सा० द० ।<br><br>अनियत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಯಂತ್ರಣವಿಲ್ಲದ / ನಿರ್ಬಂಧಕ್ಕೊಳಗಾಗದ<br><br>अनियत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಿಶ್ಚಿತ / ಕ್ಲೃಪ್ತವಲ್ಲದ<br><b>प्रयोगाः - </b>“अनियतवेलमाहारोऽश्यते” ।<br><b>उल्लेखाः - </b>शाकु० २ ।<br><br>

अनियतवृत्ति
अनियतवृत्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಥಿರವಾದ ಜೀವನವಿಲ್ಲದ<br><br>अनियतवृत्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಥಿರವಾದ ವರಮಾನವಿಲ್ಲದ<br><br>

अनियन्त्रण
अनियन्त्रण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿರ್ಬಂಧವಿಲ್ಲದಿರುವಿಕೆ / ಹತೋಟಿಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अनियन्त्रण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಯಮನವಿಲ್ಲದ / ಅಂಕೆಯಿಲ್ಲದ / ಸ್ವತಂತ್ರವಾದ<br><b>प्रयोगाः - </b>“अनियन्त्रणानुयोगो नाम तपस्विजनः” ।<br><b>उल्लेखाः - </b>शाकु० १ ।<br><br>

अनियम
अनियम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಕೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अनियम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಟ್ಟಳೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अनियम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯವಿಲ್ಲದಿರುವಿಕೆ<br><br>अनियम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಕೆ ಅಥವಾ ಕಟ್ಟಳೆಯಿಲ್ಲದ<br><br>

अनिराकृत
अनिराकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಯಲ್ಪಡದ / ಹೋಗಲಾಡಿಸಲ್ಪಡದ / ನಿವಾರಿಸಲ್ಪಡದ<br><b>निष्पत्तिः - </b>न० त० ।<br><b>प्रयोगाः - </b>“अनिराकृततापसम्पदम्” ।<br><b>उल्लेखाः - </b>माघ० १६-२४ ।<br><br>

अनिरुद्ध
अनिरुद्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರದ್ಯುಮ್ನನ ಮಗ<br><br>अनिरुद्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>“अनिरुद्धः सुरानन्दो गोविन्दो गोविदां पतिः” ।<br><b>उल्लेखाः - </b>वि० स० ।<br><b>विस्तारः - </b>ವಾಸುದೇವ, ಸಂಕರ್ಷಣ, ಪ್ರದ್ಯುಮ್ನ, ಅನಿರುದ್ಧರೆಂಬ ಪರಮಾತ್ಮನ ನಾಲ್ಕು ವ್ಯೂಹಗಳಲ್ಲಿ ಒಂದು ವ್ಯೂಹಭೇಧ.<br><br>अनिरुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಯಲ್ಪಡದ<br><br>

अनिर्दशाह
अनिर्दशाह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತು ದಿನಗಳು ಕಳೆಯದಿರುವ<br><b>व्युत्पत्तिः - </b>न निर्गतानि दशाहानि यस्य ।<br><b>प्रयोगाः - </b>“अनिर्दशाहां गां सूताम्” ।<br><b>उल्लेखाः - </b>मनु० ८-२४२ ।<br><br>

अनिर्दिष्ट
अनिर्दिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಿಶ್ಚಿತವಾದ / ವಿವರಿಸಲ್ಪಡದ / ವಿಸ್ತರಿಸಿ ಹೇಳಲು ಸಾಧ್ಯವಲ್ಲದ<br><br>

अनिर्देश्य
अनिर्देश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿವರಿಸಲು ಶಕ್ಯವಲ್ಲದ / ವಿಸ್ತರಿಸಿ ಹೇಳಲು ಸಾಧ್ಯವಲ್ಲದ<br><b>निष्पत्तिः - </b>निर्+दिश (अतिसर्जने) “ण्यत्” (३-१-१२४) ।<br><b>व्युत्पत्तिः - </b>न निर्देष्टुं शक्यम् ।<br><b>प्रयोगाः - </b>“अनिर्देश्यवपुर्विष्णुः” ।<br><b>उल्लेखाः - </b>वि० स० ।<br><br>

अनिर्धारित
अनिर्धारित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯಿಸಲ್ಪಡದ / ತೀರ್ಮಾನಿಸಲ್ಪಡದ<br><br>

अनिर्वचनीय
अनिर्वचनीय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><br>अनिर्वचनीय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಗತ್ತು / ಪ್ರಪಂಚ<br><br>अनिर्वचनीय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಜ್ಞಾನ<br><b>विस्तारः - </b>[ಅದ್ವೈತ ದರ್ಶನದಲ್ಲಿ ಜಗತ್ತು ಮತ್ತು ಅಜ್ಞಾನಗಳು ಕ್ರಮವಾಗಿ ಬಾಧ ಮತ್ತು ಪ್ರಕಾಶಗಳನ್ನು ಹೊಂದಿರುವುದರಿಂದ ಅನಿರ್ವಚನೀಯಗಳು.]<br><br>अनिर्वचनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಚ್ಚರಿಸಲಾಗದ / ಹೇಳಲಾಗದ<br><b>व्युत्पत्तिः - </b>न निर्वक्तुं शक्यः ।<br><br>

अनिर्वचनीख्याति
अनिर्वचनीख्याति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಳಲು ಅಶಕ್ಯವಾದ ವಸ್ತುಗಳ ತೋರಿಕೆ<br><b>विस्तारः - </b>[ಭ್ರಾಂತಿಯಿಂದ ತೋರಿ ಬರುವ ಜಗತ್ತು ಮತ್ತು ಅಜ್ಞಾನಗಳು ಸತ್ತು ಮತ್ತು ಅಸತ್ತುಗಳೆಂದು ಹೇಳಲು ಸಾಧ್ಯವಿಲ್ಲ. “ಸತ್” ಎಂದರೆ ಬ್ರಹ್ಮನಂತೆ ಕಾಲತ್ರಯದಲ್ಲಿಯ್ ಬಾಧೆಯಿಲ್ಲದಿರುವುದು. “ಅಸತ್” ಎಂದರೆ ಎಂದೆಂದಿಗ್ ತೋರದಿರುವುದು. ಪ್ರಪಂಚ ಮತ್ತು ಅಜ್ಞಾನಗಳು ಯಾವಾಗಲೂ ತೋರಿಬರುವುದರಿಂದ “ಅಸತ್” ಎಂದು ಹೇಳಲಾಗುವುದಿಲ್ಲ. ಬಾಧವಿರುವುದರಿಂದ “ಸತ್” ಎಂದೂ ಹೇಳಲಾಗುವುದಿಲ್ಲವಾದ ಕಾರಣ ಜಗತ್ತು ಮತ್ತು ಅಜ್ಞಾನಗಳು ಅನಿರ್ವಚನೀಯಗಳಾಗಿಯೇ ತೋರಿಬರುವುವು. ಇದಕ್ಕೆ ಅನಿರ್ವಚನೀಯ ಖ್ಯಾತಿಯೆಂದು ಹೆಸರು.]<br><br>

अनिर्वाण
अनिर्वाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ನಾನವಿಲ್ಲದ / ಮೈತೊಳೆಯದಿರುವ<br><b>व्युत्पत्तिः - </b>न निर्वाणं (गज) मज्जनं यस्य ।<br><b>प्रयोगाः - </b>“निर्वाणं निर्वृतौ मोक्षे विनाशे गजमज्जने” यादवः । “अरुन्तुदमिवालानमनिर्वाणस्य दन्तिनः” ||<br><b>उल्लेखाः - </b>रघु० १-७१ ।<br><br>

अनिर्वाह
अनिर्वाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೆರವೇರಿಸದಿರುವಿಕೆ / ಪೂರ್ತಿಮಾಡದಿರುವಿಕೆ<br><br>अनिर्वाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಂಗತಿ / ಹೊಂದಿಕೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अनिर्वाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಡತನ<br><br>

अनिर्विण्ण
अनिर्विण्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>“अनिर्विण्णः सदामर्षी” |<br><b>उल्लेखाः - </b>वि० स० ।<br><br>अनिर्विण्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಖೇದವಿಲ್ಲದ<br><br>अनिर्विण्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಣಿವಿಲ್ಲದ / ಆಯಾಸವಿಲ್ಲದ<br><br>अनिर्विण्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧೈರ್ಯಗೆಡದ<br><br>

अनिर्विद्
अनिर्विद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಯಾಸವಿಲ್ಲದ / ದಣಿವಿಲ್ಲದ<br><br>

अनिर्विद्
अनिर्विद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಖೇದವಿಲ್ಲದ<br><b>निष्पत्तिः - </b>निर्+विद (ज्ञाने) “क्विप्” (३-२-६१) ।<br><b>व्युत्पत्तिः - </b>न निर्विद्यते |<br><b>प्रयोगाः - </b>“अनिर्विदा य् विदधे विधात्रा” |<br><b>उल्लेखाः - </b>माघ० ३-३४ ।<br><br>

अनिर्वृति
अनिर्वृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸುಖ<br><br>अनिर्वृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಾರಿದ್ರ್ಯ / ಬಡತನ<br><b>निष्पत्तिः - </b>न० त० ।<br><br>अनिर्वृति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಖವಿಲ್ಲದ<br><br>अनिर्वृति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಡತನವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>न निर्वृतिः यस्य ।<br><br>

अनिर्वेद
अनिर्वेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಖೇದವಿಲ್ಲದಿರುವಿಕೆ / ಕುಗ್ಗದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न० त० ।<br><b>प्रयोगाः - </b>“अनिर्वेदः श्रियो मूलमनिर्वेदः परं सुखम्” |<br><b>उल्लेखाः - </b>रामा० ।<br><br>

अनिल
अनिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಳಿ / ವಾಯು<br><b>निष्पत्तिः - </b>अन (प्राणने) “इलच्” (उ० १-५४) |<br><b>व्युत्पत्तिः - </b>अनित्यनेन |<br><b>प्रयोगाः - </b>“प्राणानामनिलेन वृत्तिरुचिता सत्कल्पवृक्षे वने” |<br><b>उल्लेखाः - </b>शाकु० ७-१२ ।<br><br>अनिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯುದೇವತೆ<br><br>अनिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>“अहःसंवर्तको वह्निरनिलो धरणीधरः” |<br><b>उल्लेखाः - </b>वि० स० ।<br><br>

अनिलसख
अनिलसख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ / ಬೆಂಕಿ<br><b>निष्पत्तिः - </b>“टच्” (५-४-९१) ।<br><b>व्युत्पत्तिः - </b>अनिलस्य सखा |<br><br>

अनिलान्तक
अनिलान्तक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂಗುದೀವೃಕ್ಕ್ಷ / ಇಂಗಳದಗಿಡ<br><b>व्युत्पत्तिः - </b>अनिलस्य वातरोगस्य अन्तकः ।<br><br>

अनिलामय
अनिलामय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾತರೋಗ<br><b>व्युत्पत्तिः - </b>अनिलादामयः ।<br><br>

अनिवर्तिन्
अनिवर्तिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>नि+वृतु (वर्तने) “णिनिः” (३-२-७८) ।<br><b>व्युत्पत्तिः - </b>न निवर्तते |<br><b>प्रयोगाः - </b>“अनिवर्त्ती सङ्क्षेप्ता क्षेमकृच्छिवः” |<br><b>उल्लेखाः - </b>वि० स० ।<br><br>अनिवर्तिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂದಕ್ಕೆ ತಿರುಗದ / ಹಿಮ್ಮೆಟ್ಟದಿರುವ / ಸಾಹಸಿಕ<br><br>

अनिविशमान
अनिविशमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>(ಒಂದು ಜಾಗದಲ್ಲಿ ಕೂಡದೆ) ಯಾವಾಗಲೂ ತಿರುಗಾಡುತ್ತಿರುವ<br><br>

अनिश
अनिश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡುವಿಲ್ಲದ / ಎಡಬಿಡದ<br><br>अनिश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವಾಗಲೂ / ಬಿಡುವಿಲ್ಲದೆ<br><b>प्रयोगाः - </b>“शत्रूणामनिशं विन्शपिशुनः” |<br><b>उल्लेखाः - </b>माघ० १-७५ ।<br><br>

अनिष्ट
अनिष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶುಭ<br><br>अनिष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಪತ್ತು / ತೊಂದರೆ<br><br>अनिष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪರಾಧ / ತಪ್ಪು<br><b>निष्पत्तिः - </b>इषु (इच्छायाम्) “क्तः” (३-३-११४) ।<br><b>व्युत्पत्तिः - </b>न इष्टम् |<br><b>प्रयोगाः - </b>“भवत्यनिष्टादपिनाम दुःसहान्मनस्विनीनां प्रतिपत्तिरीदृशी” |<br><b>उल्लेखाः - </b>कुमा० ५-४२ ।<br><br>अनिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಡದ<br><br>अनिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ರಿಯವಾದ<br><br>अनिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟಸ್ವಭಾವದ / ದುಷ್ಟವಾದ<br><br>

अनिष्पत्ति
अनिष्पत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಮಾಪ್ತಿ / ಕೊನೆಗಾಣದಿರುವಿಕೆ / ಸಂಪೂರ್ಣವಾಗದಿರುವಿಕೆ<br><br>

अनिष्पन्न
अनिष्पन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಮಾಪ್ತ / ಕೊನೆಗಾಣದ / ಅಸಂಪೂರ್ಣ<br><br>

अनीक
अनीक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ<br><b>निष्पत्तिः - </b>णीञ् (प्रापणे) “क्विप्” कप् च ।<br><b>व्युत्पत्तिः - </b>न नीयतेऽपसार्यतेऽस्मात् |<br><br>अनीक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೈನ್ಯ / ಸೇನೆ<br><b>निष्पत्तिः - </b>अन (प्राणने) “ईकन्” (उ० ४-१७) ।<br><b>व्युत्पत्तिः - </b>अनित्यनेन |<br><b>विस्तारः - </b>“अनीकं रणसैन्ययोः” - हेम० ।<br><br>

अनीकनेतृ
अनीकनेतृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ವಕ್ಸೇನ<br><b>प्रयोगाः - </b>“अनीकनेतारमवैक्षतार्त्” |<br><b>उल्लेखाः - </b>याद० २-२३ ।<br><br>अनीकनेतृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಕಂದ / ಷಣ್ಮುಖ<br><br>

अनीकस्थ
अनीकस्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧದಲ್ಲಿ ನಿಂತಿರುವ ಸೇನೆ<br><br>अनीकस्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗರಕ್ಷಕ / ಮೈಗಾವಲಿನವನು<br><br>अनीकस्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾವಟಿಗ / ಆನೆಯ ಶಿಕ್ಷಕ<br><br>अनीकस्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಗಾರಿ / ರಣಭೇರಿ<br><b>निष्पत्तिः - </b>ष्ठा (गतिनिवृत्तौ) “कः” (३-२-४) ।<br><b>व्युत्पत्तिः - </b>अनीके तिष्ठति |<br><br>अनीकस्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಹ್ನೆ / ಗುರುತು<br><b>विस्तारः - </b>“अनीकस्थो रणगते हस्ति शिक्षाविचक्षणे । राजरक्षिण् चिह्ने च वीरमर्दलकेऽपि च” - मेदि० ।<br><br>

अनीकिनी
अनीकिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇನೆ / ದಂಡು / ಪಡೆ<br><b>निष्पत्तिः - </b>अनीक “इनिः” (५-२-११५) ।<br><b>व्युत्पत्तिः - </b>अनीकं रणौऽस्ति प्रयोजनत्वेनास्याः|<br><b>प्रयोगाः - </b>“समं समन्ततो राज्ञामापतन्तीरनीकिनौः” |<br><b>उल्लेखाः - </b>माघ० १९-१० ।<br><br>अनीकिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇನೆಗಳ ಗುಂಪು / ಆನೆ ರಥ ಕುದುರೆ ಮತ್ತು ಕಾಲಾಳುಗಳ ಒಂದು ಗುಂಪು / ಅಕ್ಷೌಹಿಣಿಯ ಹತ್ತನೆಯ ಒಂದು ಭಾಗದ ಸೈನ್ಯ<br><b>प्रयोगाः - </b>“एकैभेकरथत्र्यश्वा पत्तिः पञ्चपदातिका । पत्यङ्गैः त्रिगुणैः सर्वैः क्रमादाख्या यथोत्तरम् । सेनामुखं गुत्मगणौ वाहिनी पृतना चमूः । अनीकिनी दशानीकिन्यक्षौहिणी” |<br><b>उल्लेखाः - </b>अम० ।<br><b>विस्तारः - </b>ಸೇನೆಗಳ ಗುಂಪುಗಳಲ್ಲಿ ಆನೆ ರಥ ಕುದುರೆ ಮತ್ತು ಕಾಲಾಳುಗಲ ಸಂಖ್ಯಾವಿವರ-ಇವು ಕ್ರಮವಾಗಿ ಒಂದಕ್ಕಿಂತಲೂ ಒಂದು ಮೂರರಷ್ಟು ಅಧಿಕವಾಗಿರುವುವು.<br>ಸೇನೆಗಳ ಗುಂಪು ಆನೆಗಳು ರಥಗಳು ಕುದುರೆ ಕಾಲಾಳುಗಳು ಹೆಸರು<br>ಪತ್ತಿ 1 1 3 5<br>ಸೇನಾಮುಖ 3 3 9 15<br>ಗುಲ್ಮ 9 9 27 45<br>ಗಣ 27 27 81 135<br>ವಾಹಿನೀ 81 81 243 405<br>ಪೃತನಾ 243 243 729 1215 <br>ಚಮೂ 729 729 2187 3645<br>ಅನೀಕಿನೀ 2187 2187 6561 10935<br>ಅಕ್ಶೌಹಿಣೀ 21870 21870 65610 109350<br>(ಅಕ್ಶೌಹಿಣೀಯು ಅನೀಕಿನಿಯ ಹತ್ತರಷ್ಟು ಅಧಿಕವಾಗಿರುವುದು.)<br><br>

अनीति
अनीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರಾಚಾರ / ಅಧರ್ಮ / ಅನ್ಯಾಯ<br><br>अनीति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈತಿಬಾಧೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति ईतिर्यस्य ।<br><br>अनीति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುರಾಚಾರವುಳ್ಳ / ನ್ಯಾಯವಿಲ್ಲದ / ಧರ್ಮವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न नीतिर्यस्य ।<br><br>

अनीश
अनीश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು / ಸರ್ವೇಶ್ವರ<br><b>व्युत्पत्तिः - </b>नास्ति ईशः स्वामी यस्य ।<br><b>प्रयोगाः - </b>“अनीशः शाश्वतः स्थिरः” |<br><b>उल्लेखाः - </b>वि० स० ।<br><br>अनीश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜಮಾನನಲ್ಲದವನು / ಒಡೆಯನಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>न ईशः स्वामी ।<br><b>प्रयोगाः - </b>“मम गात्राणामनीशोऽस्मि संवृत्तः” |<br><b>उल्लेखाः - </b>शाकु० २ ।<br><br>अनीश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುರಾಚಾರವುಳ್ಳ / ನ್ಯಾಯವಿಲ್ಲದ / ಧರ್ಮವಿಲ್ಲದ<br><b>प्रयोगाः - </b>“सर्वप्रभुरनीशस्त्वमेकस्त्वं सर्वर्पभाक्” |<br><b>उल्लेखाः - </b>रघु० १०-२० ।<br><br>अनीश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸ್ವತಂತ್ರ / ಪರಾಧೀನ<br><br>अनीश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಮರ್ಥ / ಕೈಯಲ್ಲಾಗದ / ಅಶಕ್ತ<br><br>

अनीश्वर
अनीश्वर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರನಿಲ್ಲದ ಜಗತ್ತು / ಸಾಂಖ್ಯರು ಒಪ್ಪಿರುವ ನಿರೀಶ್ವರ ಜಗತ್ತು<br><b>व्युत्पत्तिः - </b>न ईश्वरः नियन्ता यस्य ।<br><br>अनीश्वर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈಶ್ವರನಿಗೆ ಸಂಬಂಧಪಡದ<br><b>प्रयोगाः - </b>“ध्यानेनानीश्वरान् गुणान्” |<br><b>उल्लेखाः - </b>मनु० ६-७२ ।<br><br>अनीश्वर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈಶ್ವರನಿಲ್ಲದ<br><br>अनीश्वर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಡೆಯನಿಲ್ಲದ / ಯಜಮಾನನಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति ईश्वरः यस्य ।<br><b>प्रयोगाः - </b>“शयिता सविधेऽप्यनीश्वर्”<br><b>उल्लेखाः - </b>भामि० वि० २-१८२ ।<br><br>

अनीश्वरवाद
अनीश्वरवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿರೀಶ್ವರವಾದ / ನಾಸ್ತಿಮಕತ / ದೇವರನ್ನು ಒಪ್ಪದಿರುವ ಮತ<br><br>

अनीश्वरवादिन्
अनीश्वरवादिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿರೀಶ್ವರವಾದ / ನಾಸ್ತಿಕಮತ / ದೇವರನ್ನು ಒಪ್ಪದಿರುವ ಮತ<br><br>

अनीह
अनीह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆಯಿಲ್ಲದ / ಆಸೆಯಿಲ್ಲದ<br><br>अनीह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದಾಸೀನ / ಅಸಡ್ಡೆಯ / ಯಾವ ಕಾರ್ಯವೂ ಇಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति ईहा यस्य ।<br><br>

अनीहा
अनीहा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಾದರ / ಉಪೇಕ್ಷೆ / ಉದಾಸೀನತೆ / ಅನುತ್ಸಾಹ<br><b>प्रयोगाः - </b>“प्रभुशक्ति द्विषतामनीहया” |<br><b>उल्लेखाः - </b>किरा० २-१० ।<br><br>अनीहा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಸೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>

अनु
अनु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ತರುವಾಯ /ಬಳಿಕ /ಆಮೇಲೆ<br><b>निष्पत्तिः - </b>अन (प्राणने) - "उः" बाहु० ।<br><b>व्युत्पत्तिः - </b>अनिति<br><b>प्रयोगाः - </b>"क्रमेण सुप्तामनु संविवेश" । "तं गच्छन्त्यनु ये विपत्तिषु सदा" ।<br><b>उल्लेखाः - </b>रघु० २-२४, मुद्रा० १-१४<br><br>अनु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉದ್ದಕ್ಕೂ /ದೀರ್ಘವಾಗಿ<br><b>प्रयोगाः - </b>"वहत्ययोध्यामनु राजधानीम्" । "गङ्गामनु चतुःशतान्" ।<br><b>उल्लेखाः - </b>रघु० १३-६१, भा०<br><br>अनु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಜೊತೆಯಲ್ಲಿ /ಸಂಗಡ /ಒಡನೆ<br><b>प्रयोगाः - </b>"उमास्तनोद्भेदमनु प्रवृद्धो मनोरथो यः प्रथमं बभूव"<br><b>उल्लेखाः - </b>कुमा० ७-२४<br><br>अनु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕಡಿಮೆಯಾದ /ಹೀನವಾದ<br><b>प्रयोगाः - </b>"मित्रलाभमनु लाभसम्पदः"<br><b>उल्लेखाः - </b>किरा० १२-५२<br><br>अनु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಕೃಷ್ಟ /ಅಧಮ /ನೀಚ<br><b>प्रयोगाः - </b>"अनु हरिं सुराः"<br><br>अनु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಭಾಗ /ಪಾಲು<br><b>प्रयोगाः - </b>"लक्ष्मीर्हरिमनु"<br><br>अनु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವೀಪ್ಸೆ /ವ್ಯಾಪ್ತಿ /ಎರಡು ವಸ್ತುಗಳು ಒಂದಿದ್ದ ಕಡೆ ಮತ್ತೊಂದಿರಬೇಕೆಂಬ ನಿಯಮ<br><b>प्रयोगाः - </b>"अनुदिवसम्, अनुवृक्षम्"<br><br>अनु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ /ಹತ್ತಿರದಲ್ಲಿ<br><b>प्रयोगाः - </b>"अनुनदि शुश्रविरे रुतानि ताभिः"<br><b>उल्लेखाः - </b>माघ० ७-२४<br><br>अनु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಾದೃಶ್ಯ /ಸಾಮ್ಯ<br><b>प्रयोगाः - </b>"सर्वं मामनु ते प्रियाविरहितां त्वं तु व्यथां मानुभूः"<br><b>उल्लेखाः - </b>विक्र० ४-२५<br><br>अनु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನುರೂಪವಾದ /ಹೊಂದುವ /ಯುಕ್ತವಾದ<br><b>प्रयोगाः - </b>"तथैव सोऽभूदन्वर्थो राजा प्रकृतिरञ्जनात्"<br><b>उल्लेखाः - </b>रघु० ४-१२<br><br>अनु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಭಿಮುಖ್ಯ /ಎದುರು<br><b>प्रयोगाः - </b>"मातरमनुधावति कृष्णः"<br><br>अनु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನುಷ್ಠಾನ /ಆಚರಣೆ<br><b>प्रयोगाः - </b>"प्रजापतिः कल्पितयज्ञभागं शैलाधिपत्यं स्वयमन्वतिष्ठत्"<br><b>उल्लेखाः - </b>कुमा० १-१७<br><br>अनु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಲಕ್ಷಣ /ಜ್ಞಾಪಕ<br><b>प्रयोगाः - </b>"वृक्षमनु विद्योतते विद्युत्"<br><br>अनु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉಪಾಸನೆ /ಸೇವೆ<br><b>प्रयोगाः - </b>"अन्वासितमरुधन्त्या स्वाहयेव हविर्भुजम्"<br><b>उल्लेखाः - </b>रघु० १-५६<br><br>अनु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನುಕ್ರಮ /ಒಂದಾದ ಮೇಲೊಂದು ಕ್ರಮವಾಗಿ ಬರುವಿಕೆ<br><br>अनु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಪ್ರಧಾನ /ಮುಖ್ಯವಲ್ಲದ<br><b>प्रयोगाः - </b>"अनुबन्धः"<br><br>

अनुक
अनुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮುಕ /ಸ್ತ್ರೀಲೋಲ<br><b>निष्पत्तिः - </b>अनु - "कन्" (५-२-७४)<br><b>व्युत्पत्तिः - </b>अनुकामयते<br><br>

अनुकथन
अनुकथन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಂತರ ಹೇಳುವುದು /ತರುವಾಯ ನಿರ್ದೇಶಿಸುವುದು<br><br>अनुकथन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಭಾಷಣೆ<br><br>

अनुकम्पक
अनुकम्पक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯೆ ತೋರಿಸುವವನು<br><b>निष्पत्तिः - </b>अनु + कपि (चलने) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>अनुकम्पते<br><br>

अनुकम्पन
अनुकम्पन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಯೆ /ಕರುಣೆ<br><b>निष्पत्तिः - </b>अनु + कपि (चलने) - भावे "ल्युट्" (३-३-११५)<br><b>व्युत्पत्तिः - </b>अनुकम्प्यते<br><br>अनुकम्पन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯಾಶೀಲ /ಕರುಣೆಯ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>अनु + कपि (चलने) - कर्त० "युच्" (३-२-१४८)<br><br>

अनुकम्पा
अनुकम्पा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಯೆ /ಕರುಣೆ<br><b>निष्पत्तिः - </b>अनु + कपि (चलने) - "अः" (३-३-१०३)<br><b>प्रयोगाः - </b>"भक्त्या गुरौ मय्यनुकम्पया च"<br><b>उल्लेखाः - </b>रघु० २-६३<br><br>

अनुकम्प्य
अनुकम्प्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇಗವುಳ್ಳ<br><br>अनुकम्प्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯೆ ತೋರಿಸಲು ಅರ್ಹನಾದ<br><b>व्युत्पत्तिः - </b>अनुकम्पितुमर्हः<br><b>प्रयोगाः - </b>"दुहितरमनुकम्प्यामद्रिरादाय दोर्भ्याम्"<br><b>उल्लेखाः - </b>कुमा० ३-७६<br><br>

अनुकम्प्र
अनुकम्प्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯೆ ತೋರಿಸುವ ಸ್ವಭಾವದ /ಕನಿಕರದ ಸ್ವಭಾವವುಳ್ಳ<br><b>निष्पत्तिः - </b>अनु + कपि (चलने) - "रः" (३-२-१६७)<br><br>

अनुकरण
अनुकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಕರಿಸುವುದು /ಅಣಕಿಸುವುದು<br><b>निष्पत्तिः - </b>अनु + डुकृञ् (करणे) - "ल्युट्" (३-३-११५)<br><b>व्युत्पत्तिः - </b>अनुक्रियते<br><b>प्रयोगाः - </b>"तव सुचरितैकदेशस्यानुकरणं किलैतत्"<br><b>उल्लेखाः - </b>मुद्रा० ७<br><br>अनुकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಕಲು /ಪ್ರತಿಕೃತಿ<br><b>निष्पत्तिः - </b>कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>अनुक्रियतेऽनेन<br><br>

अनुकर्तृ
अनुकर्तृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಟ<br><b>निष्पत्तिः - </b>अनु + डुकृञ् (करणे) - "तृन्" (३-२-१३५)<br><br>अनुकर्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕರಿಸುವವನು /ಒಬ್ಬನು ಮಾಡಿದಂತೆ ಮಾಡುವವನು<br><br>

अनुकर्ष
अनुकर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಡಿಯ ನೊಗದ ಕೆಳಗಿನ ತೋಳುಮರ<br><b>निष्पत्तिः - </b>कृष (विलेखने) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>अनुकृष्यते<br><br>अनुकर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಷಣೆ /ಎಳೆಯುವುದು<br><b>विस्तारः - </b>"अनुकर्षि रथस्याधःस्थिते दारुणि कर्षणे" - नानार्थर० ।<br><br>

अनुकर्षण
अनुकर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕರ್ಷಣ /ಎಳೆಯುವಿಕೆ<br><br>अनुकर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂದಿನ ವಾಕ್ಯದಿಂದ ಬೇಕಾದ ಪದಗಳನ್ನು ಮುಂದಿನ ವಾಕ್ಯದ ಅನ್ವಯಕ್ಕಾಗಿ ತೆಗೆದುಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>अनु + कृष (विलेखने) - "ल्युट्" (३-३-११५)<br><br>

अनुकल्प
अनुकल्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೌಣ /ಅಪ್ರಧಾನ<br><b>व्युत्पत्तिः - </b>अनु हीनः कल्पः<br><br>

अनुकल्पता
अनुकल्पता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ರಧಾನತೆ<br><b>व्युत्पत्तिः - </b>अनुकल्पस्य भावः<br><b>प्रयोगाः - </b>"व्यधित कल्पतरोरनुकल्पताम्"<br><b>उल्लेखाः - </b>याद० ३-६५<br><br>

अनुकाम
अनुकाम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುರೂಪವಾದ ಅಪೇಕ್ಷೆ /ಯುಕ್ತವಾದ ಆಸೆ<br><b>व्युत्पत्तिः - </b>अनुरूपः कामः<br><br>अनुकाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆಗೆ ಅನುರೂಪವಾದ /ಆಸೆಗೆ ತಕ್ಕಂತಿರುವ<br><br>अनुकाम<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆಗೆ ತಕ್ಕಂತೆ /ಆಸೆಗೆ ಅನುಗುಣವಾಗಿ<br><b>व्युत्पत्तिः - </b>कामस्य सदृशम्<br><br>

अनुकामीन
अनुकामीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟಬಂದಂತೆ ನಡೆಯುವ ಸ್ವಭಾವವುಳ್ಳ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "खः" (५-२-११)<br><b>व्युत्पत्तिः - </b>कामस्य सदृशम् , अनुकामं गच्छति<br><br>

अनुकार
अनुकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಣಕಿಸುವುದು /ಅನುಕರಿಸುವುದು /ಹೋಲುವಂತೆ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>अनु + डुकृञ् (करणे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"सुलभानुकारः खलु जगति वेधसो निर्माणसन्निवेशः"<br><b>उल्लेखाः - </b>मालती० ९<br><br>

अनुकारिन्
अनुकारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇತರರಿಗೆ ಸದೃಶವಾಗಿ ಮಾಡುವ /ಅನುಕರಿಸುವ /ಹೋಲುವ<br><b>निष्पत्तिः - </b>अनु + डुकृञ् (करणे) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अनुकरोति<br><b>प्रयोगाः - </b>"आमोदमुपजिघ्रन्तौ स्वनिःश्वासानुकारिणम्"<br><b>उल्लेखाः - </b>रघु० १-४३<br><br>

अनुकारिणी
अनुकारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇತರರಿಗೆ ಸದೃಶವಾಗಿ ಮಾಡುವ /ಅನುಕರಿಸುವ /ಹೋಲುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><b>प्रयोगाः - </b>"दधत्सन्ध्यारुणव्योमस्फुरत्तारानुकारिणीः"<br><b>उल्लेखाः - </b>माघ० २-१८<br><br>

अनुकार्य
अनुकार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಲಲು ಅರ್ಹವಾದ /ಅನುಕರಿಸಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>अनु + डुकृञ् (करणे) - "ण्यत्" (३-१-१२४)<br><br>

अनुकाल
अनुकाल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಲಕ್ಕೆ ತಕ್ಕಂತಹ /ಸಮಯೋಚಿತವಾದ<br><br>अनुकाल<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಸಮಯೋಚಿತವಾಗಿ /ಕಾಲಕ್ಕೆ ತಕ್ಕಂತೆ<br><br>

अनुकीर्तन
अनुकीर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತುತಿ /ಸ್ತೋತ್ರ<br><b>प्रयोगाः - </b>"साङ्गं भवति तत्सर्वं हरेर्नामानुकीर्तनम्"<br><br>

अनुकूल
अनुकूल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ಪರಮಾತ್ಮ<br><b>प्रयोगाः - </b>"अनुकूलः शतावर्तः"<br><b>उल्लेखाः - </b>वि० स०<br><br>अनुकूल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಯಕರಲ್ಲಿ ಒಂದು ಭೇದ /ಒಬ್ಬಳೇ ನಾಯಿಕೆಯಲ್ಲಿ ಅನುರಾಗವುಳ್ಳವನು<br><b>प्रयोगाः - </b>"अनुकूलस्त्वेकनिरतः"<br><b>उल्लेखाः - </b>सा० द० ३-३७<br><br>अनुकूल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಹಾಯ್ಯ /ಉಪಕಾರ<br><br>अनुकूल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಯೆ /ಪ್ರೀತಿ<br><br>अनुकूल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಹಾಯಕ /ಉಪಕಾರ ಮಾಡುವ<br><b>प्रयोगाः - </b>"मन्दं मन्दं नुदति पवनश्चानुकूलो यथा त्वाम्"<br><b>उल्लेखाः - </b>मेघ० १-९<br><br>अनुकूल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ನೇಹಸ್ವಭಾವವುಳ್ಳ /ಪ್ರೀತಿಯುಳ್ಳ<br><b>प्रयोगाः - </b>"सदानुकूलेषु हि कुर्वते रतिम्"<br><b>उल्लेखाः - </b>किरा० १-५<br><br>अनुकूल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯೆಯುಳ್ಳ<br><br>अनुकूल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಪ್ಪುವಂತಹ /ಅನುರೂಪವಾದ /ಯೋಗ್ಯವಾದ<br><b>प्रयोगाः - </b>"कुशलविरचितानुकूलवेषः"<br><b>उल्लेखाः - </b>रघु० ५-७६<br><br>अनुकूल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿತವಾದ /ಸುಖಕರವಾದ<br><br>

अनुकूलत्व
अनुकूलत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಗುಣ್ಯ /ಅನುಕೂಲತೆ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><b>व्युत्पत्तिः - </b>अनुकूलस्य भावः<br><b>प्रयोगाः - </b>"पवनस्यानुकूलत्वात् प्रथनासिद्धिशंसिनः"<br><b>उल्लेखाः - </b>रघु० १-४२<br><br>

अनुकृत
अनुकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕರಿಸಲ್ಪಟ್ಟ /ಹೋಲಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + डुकृञ् (करणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अनुकृतशिखरौघश्रीभिरभ्यागतेऽसौ"<br><b>उल्लेखाः - </b>माघ० ४-६८<br><br>

अनुकृति
अनुकृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೋಲಿಕೆ /ಅನುಕರಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अनु + डुकृञ् (करणे) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"धूमोद्गारानुकृतिनिपुणाः"<br><b>उल्लेखाः - </b>मेघ० २-६<br><br>

अनुक्त
अनुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲ್ಪಡದ /ಉಚರಿಸಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न उक्तः<br><b>प्रयोगाः - </b>"असावनुक्तोऽपि सहाय एव"<br><b>उल्लेखाः - </b>कुमा० ३-२१<br><br>अनुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಖ್ಯಾತಪ್ರತ್ಯಯಾದಿಗಳಿಂದ ಹೇಳಲ್ಪಡದ<br><br>

अनुक्रम
अनुक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಮ /ಪರಂಪರೆ<br><b>प्रयोगाः - </b>"प्रचक्रमे वक्तुमनुक्रमज्ञा"<br><b>उल्लेखाः - </b>रघु० ६-७०<br><br>अनुक्रम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ರಮವಾದ /ಪರಂಪರೆಯ<br><b>व्युत्पत्तिः - </b>अनुगतः क्रमम्<br><br>अनुक्रम<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕ್ರಮವಾಗಿ /ಪರಂಪರೆಯಾಗಿ<br><b>व्युत्पत्तिः - </b>क्रममनतिक्रम्य<br><br>

अनुक्रमणी
अनुक्रमणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಯಸೂಚಿ /ಗ್ರಂಥದ ಕ್ರಮವನ್ನು ಸೂಚಿಸುವ ಪಟ್ಟಿ<br><b>निष्पत्तिः - </b>अनु +क्रमु (पादविक्षेपे) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>अनुक्रम्यतेऽनया<br><br>

अनुक्रोश
अनुक्रोश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಯೆ /ಕನಿಕರ /ಇತರರ ಕಷ್ಟವನ್ನು ನೋಡಿ ಮರುಕಗೊಳ್ಳುವಿಕೆ<br><b>निष्पत्तिः - </b>अनु + क्रुश (आह्वाने रोदने च) - "घञ्"(३-३-१२१)<br><b>व्युत्पत्तिः - </b>अनुक्रोशयत्यनेन<br><b>प्रयोगाः - </b>"अपाङ्गाः परिपात्यन्तामनुक्रोशानुवर्तिनः"<br><b>उल्लेखाः - </b>याद० १६-२४<br><br>अनुक्रोश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕ್ರೋಶದಷ್ಟೇ ದೂರ ನಡೆದವನು<br><b>व्युत्पत्तिः - </b>अनुगतः क्रोशम्<br><br>

अनुक्षण
अनुक्षण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವಾಗಲೂ ಇರುವ /ಪ್ರತಿಕ್ಷಣದಲ್ಲೂ ಉಂಟಾಗುವ<br><b>व्युत्पत्तिः - </b>क्षणमनुगतः<br><br>अनुक्षण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವಾಗಲೂ /ಪ್ರತಿಕ್ಷಣದಲ್ಲೂ<br><b>व्युत्पत्तिः - </b>क्षणे क्षणे<br><br>

अनुख्याति
अनुख्याति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರೂಪಾವಿಷ್ಕರಣ /ಸಾಕ್ಷಾತ್ಕಾರದಿಂದ ಸ್ವರೂಪವನ್ನು ಪ್ರಕಾಶಪಡಿಸುವುದು<br><br>

अनुग
अनुग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಹಚರ /ಸಂಗಡಿಗ /ಒಡನಾಡಿ<br><br>अनुग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಕ /ಆಳು /ಅನುಚರ<br><b>प्रयोगाः - </b>"तद्भूतनाथानुग नार्हसि त्वम्"<br><b>उल्लेखाः - </b>रघु० २-५८<br><br>अनुग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಿಸುವ /ಹಿಂದೆ ನಡೆಯುವ<br><b>निष्पत्तिः - </b>अनु + गम्लृ (गतौ) -"डः" (वा० ३-२-४८)<br><b>व्युत्पत्तिः - </b>अनुगच्छति<br><b>प्रयोगाः - </b>"गीतानुगं वारिमृदङ्गवाद्यम्"<br><b>उल्लेखाः - </b>रघु० १६-६४<br><br>

अनुगङ्ग
अनुगङ्ग<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಗಂಗಾನದಿಯ ಸಮೀಪದಲ್ಲಿ<br><b>व्युत्पत्तिः - </b>गङ्गाया अनु<br><br>अनुगङ्ग<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಗಂಗಾನದಿಯಲ್ಲಿ<br><b>व्युत्पत्तिः - </b>गङ्गायाम्<br><br>अनुगङ्ग<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಗಂಗಾನದಿಯಷ್ಟು ಉದ್ದವಿರುವ<br><b>प्रयोगाः - </b>"अनुगङ्गं वाराणसी"<br><br>

अनुगत
अनुगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + गम्लृ (गतौ) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अनुगतमलिवृन्दैर्गण्डभित्तीर्विहाय "<br><b>उल्लेखाः - </b>रघु० १२-१०२<br><br>अनुगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಪ್ತವಾದ /ಕೂಡಿರುವ<br><b>प्रयोगाः - </b>"शिवमिवानुगतं गजचर्मणा"<br><b>उल्लेखाः - </b>किरा० ५-२<br><br>अनुगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಿಸುವ /ಅನುಸರಿಸುವ<br><b>निष्पत्तिः - </b>अनु + गम्लृ (गतौ) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"रामादेशादनुगता सेना तस्यार्थसिद्धये"<br><b>उल्लेखाः - </b>रघु० १५-९<br><br>अनुगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿಕೆಯಾಗುವ /ತಾಳೆಯಾಗುವ /ಸಮಕೂಡುವ /ಒಪ್ಪುವ<br><b>प्रयोगाः - </b>"मृदङ्गानुगतसङ्गीतमधुरः पौराणां समुच्चरति चर्चरीध्वनिः"<br><b>उल्लेखाः - </b>रत्ना० १<br><br>अनुगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸದೃಶವಾದ /ಸಮಾನವಾದ<br><br>अनुगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧೀನ /ವಿಧೇಯ<br><b>प्रयोगाः - </b>"स्वमतमनुगतस्त्वं तु मह्यं ददासि"<br><b>उल्लेखाः - </b>मुद्रा० ५-१९<br><br>

अनुगति
अनुगति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಿಸುವಿಕೆ<br><br>अनुगति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾದೃಶ್ಯ /ಹೋಲಿಕೆ<br><br>अनुगति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಪ್ಪಿಗೆ /ಸಮ್ಮತಿ<br><b>निष्पत्तिः - </b>अनु + गम्लृ (गतौ) - "क्तिन्" (३-३-९४)<br><br>

अनुगम
अनुगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अनु + गम्लृ (गतौ) - "अप्" (३-३-५८)<br><br>अनुगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಪ್ಪಿಗೆ /ಸಮ್ಮತಿ<br><br>अनुगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾದೃಶ್ಯ /ಹೋಲಿಕೆ<br><br>

अनुगमन
अनुगमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸಿ ನಡೆಯುವುದು /ಹಿಂಬಾಲಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अनु + गम्लृ (गतौ) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"वन्यवृत्तिरिमां शश्वदात्मानुगमनेन गाम्"<br><b>उल्लेखाः - </b>रघु० १-८८<br><br>अनुगमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಹಗಮನ /ಪತಿಯ ಜೊತೆಯಲ್ಲಿ ಮರಣ ಹೊಂದುವುದು<br><br>

अनुगव
अनुगव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತಿನ ಉದ್ದಕ್ಕೆ ಅನುಗುಣವಾದ ಗಾಡಿ /ಎತ್ತಿಗೆ ಅನುಗುಣವಾದ ಉದ್ದವುಳ್ಳ ಗಾಡಿ<br><b>निष्पत्तिः - </b>समासान्तः "अच्" (५-४-८३) निपा० ।<br><b>व्युत्पत्तिः - </b>गोः अनु गोः सदृश आयामो यस्य<br><br>

अनुगवीन
अनुगवीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೋಪಾಲಕ /ಗೋವುಗಳನ್ನು ಅನುಸರಿಸಿ ನಡೆಯುವವನು<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "खः" (५-२-१५)<br><b>व्युत्पत्तिः - </b>गोः पश्चात् । अनुगु अलं गच्छति ।<br><br>

अनुगामिन्
अनुगामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಕ /ಹಿಂದೆ ಹೋಗುವ /ಅನುಸರಿಸಿ ಹೋಗುವ<br><br>अनुगामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಗಡಿಗ /ಜೊತೆಗಾರ<br><b>निष्पत्तिः - </b>अनु + गम्लृ (गतौ) - "णिनिः" (३-२-७८)<br><br>

अनुगामिनी
अनुगामिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अनुगामिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अनुगुण
अनुगुण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕೂಲವಾದ<br><br>अनुगुण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುರೂಪವಾದ /ಯೊಗ್ಯವಾದ<br><br>अनुगुण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿಕೆಯಿರುವ /ಒಪ್ಪುವಂತಿರುವ /ಮೆಚ್ಚುವಂತಿರುವ<br><b>प्रयोगाः - </b>"अद्वैतं सुखदुःखयोरनुगुणं सर्वास्ववस्थासु यत्"<br><b>उल्लेखाः - </b>उ० रा० १-३९<br><br>अनुगुण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುಣದಲ್ಲಿ ಪ್ರೀತಿಯುಳ್ಳ /ಗುಣದಲ್ಲಿ ಅನುರಾಗವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अनुगतः गुणम्<br><br>अनुगुण<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಗುಣದಲ್ಲಿ<br><b>निष्पत्तिः - </b>विभ० अव्ययी० (२-२-६) ।<br><b>व्युत्पत्तिः - </b>गुणे<br><br>अनुगुण<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಗುಣವನ್ನು ಮೀರದೆ<br><b>व्युत्पत्तिः - </b>गुणमनतिक्रम्य<br><br>अनुगुण<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನುಸಾರವಾಗಿ /ಸರಿಯಾಗಿ ಒಪ್ಪುವಂತೆ<br><br>

अनुगुणा
अनुगुणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಂತಿಯಿಂದ ಕೂಡಿದ ವೀಣೆ<br><b>व्युत्पत्तिः - </b>अनुगता गुणं तन्त्रीसूत्रम्<br><br>अनुगुणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಣದಲ್ಲಿ ಅನುರಾಗವುಳ್ಳ ಹೆಂಗಸು<br><br>

अनुगुप्त
अनुगुप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಲ್ಪಟ್ಟ /ಹೊದ್ದಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + गुपू (रक्षणे) - "क्तः" (३-२-१०२)<br><br>अनुगुप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಿಸಲ್ಪಟ್ಟ / ಕಾಪಾಡಲ್ಪಟ್ಟ<br><br>

अनुगृहीत
अनुगृहीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಗ್ರಹ ಮಾಡಲ್ಪಟ್ಟ /ದಯೆ ತೋರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + ग्रह (उपादाने) - "क्तः"(३-२-१०२)<br><br>

अनुग्रह
अनुग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನುಕೂಲ್ಯ /ಹಿತವನ್ನುಂಟುಮಾಡುವ ಮತ್ತು ಅಹಿತವನ್ನು ನಿವಾರಿಸುವ ದಯೆ<br><b>निष्पत्तिः - </b>अनु + ग्रह (उपादाने) - "अप्" (३-३-५८)<br><b>प्रयोगाः - </b>"प्रलयेष्वपि दीर्घायुः प्रतिभूस्त्वदनुग्रहः"<br><b>उल्लेखाः - </b>याद० १-५७<br><br>अनुग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಹಾಯ್ಯ /ಉಪಕಾರ<br><br>अनुग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ /ಸ್ವೀಕಾರ<br><br>अनुग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೀನದಲಿತರ ಪೋಷಣೆ<br><br>अनुग्रह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೂರ್ಯಾದಿ ಗ್ರಹಗಳನ್ನು ಹಿಂಬಾಲಿಸುವ ಇತರ ಗ್ರಹಗಳು<br><br>

अनुग्रहण
अनुग्रहण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>अनुग्रह ಪದದ ೧-೪ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अनु + ग्रह (उपादाने) - "ल्युट्" (३-३-११५)<br><br>

अनुग्राहक
अनुग्राहक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿತವನ್ನುಂಟುಮಾಡುವ<br><br>अनुग्राहक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಕಾರ ಮಾಡುವ<br><b>निष्पत्तिः - </b>अनु + ग्रह (उपादाने) - "ण्वुल्" (३-१-१३३)<br><br>

अनुग्राह्य
अनुग्राह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯೆ ತೋರಿಸಲು ಅರ್ಹನಾದ<br><br>अनुग्राह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಹಾಯ್ಯ ಪಡೆಯಲು ಯೋಗ್ಯನಾದ<br><b>निष्पत्तिः - </b>अनु + ग्रह (उपादाने) - "ण्यत्" (३-१-१२४)<br><b>प्रयोगाः - </b>"यदि तेऽहनुग्राह्यो यदि स्मरसि मे गुणान्"<br><b>उल्लेखाः - </b>रामा०<br><br>

अनुचर
अनुचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಕ /ಆಳು /ಅನುಚರ<br><b>निष्पत्तिः - </b>अनु + चर (गतिभक्षणयोः) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अनुचरति<br><b>प्रयोगाः - </b>"अनुचरेण धनाधिपतेरथो"<br><b>उल्लेखाः - </b>किरा० ५-१६<br><br>अनुचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಗಡಿಗ /ಜೊತೆಗಾರ<br><br>अनुचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಕ /ಹಿಂದೆ ಹೋಗುವ /ಅನುಸರಿಸಿ ಹೋಗುವ<br><b>प्रयोगाः - </b>"व्रताय तेनानुचरेन धेनोः"<br><b>उल्लेखाः - </b>रघु० २-४<br><br>अनुचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೂತನನ್ನು ಅನುಸರಿಸಿ ಹೋಗುವ<br><b>व्युत्पत्तिः - </b>अनुगतः चरं दूतम्<br><br>

अनुचरी
अनुचरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अनुचर ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

अनुचित
अनुचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಯುಕ್ತವಾದ /ಅಸಮಂಜಸವಾದ /ಅಯೋಗ್ಯವಾದ<br><br>अनुचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪರಿಚಿತವಾದ /ಹೊಸದಾದ /ಮಾಮೂಲಲ್ಲದ<br><b>प्रयोगाः - </b>"अनुचितनूपुरविरहं नार्हसि तपनीयपीठिकालम्बि"<br><b>उल्लेखाः - </b>माल० ४-३<br><b>विस्तारः - </b>"अभ्यस्तेऽप्युचितं न्याय्येऽपि" - वैज० ।<br><br>

अनुचिन्तन
अनुचिन्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಮರಣೆ /ನೆನಪು<br><br>अनुचिन्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವಾಗಲೂ ಚಿಂತಿಸುವುದು /ವಿರಾಮವಿಲ್ಲದ ಚಿಂತೆ<br><b>निष्पत्तिः - </b>अनु + चिति (स्मृत्याम्) - "ल्युट्" (३-३-११५)<br><br>

अनुचिन्ता
अनुचिन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವಾಗಲೂ ಚಿಂತಿಸುತ್ತಿರುವುದು<br><b>निष्पत्तिः - </b>अनु + चिति (स्मृत्याम्) - "अङ्" (३-३-१०५)<br><br>

अनुचिन्तित
अनुचिन्तित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಂತಿಸಲ್ಪಟ್ಟ /ಸ್ಮರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + चिति (स्मृत्याम्) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अनुचिन्तितमात्रस्तमुपतस्थे खगेश्वरः"<br><b>उल्लेखाः - </b>याद० १६-५१<br><br>

अनुच्च
अनुच्च<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎತ್ತರವಲ್ಲದ /ಉನ್ನತವಲ್ಲದ /ಕುಳ್ಳಾಗಿರುವ<br><b>व्युत्पत्तिः - </b>न उच्चः<br><br>अनुच्च<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗ್ರಹಗಳ ನೀಚಸ್ಥಾನ<br><br>

अनुच्छित्ति
अनुच्छित्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶವಾಗದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>अनु + छिदिर् (द्वैधीकरणे) - "क्तिन्" (३-३-९४)<br><br>

अनुच्छिष्ट
अनुच्छिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶುದ್ಧವಾದ /ಎಂಜಲಲ್ಲದ /ಉಪಯೋಗಿಸಲ್ಪಡದ<br><b>निष्पत्तिः - </b>अनु + शिष (असर्वोपयेगे) - "क्तः" (३-२-१०२)<br><br>

अनुज
अनुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಿಯ ಸಹೋದರ /ತರುವಾಯ ಹುಟ್ಟಿದವನು /ತಮ್ಮ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९९)<br><b>व्युत्पत्तिः - </b>अनु पश्चात् जायते<br><b>प्रयोगाः - </b>"प्रविश्य कृष्णासदनं महीभुजा तदाऽचचक्षेऽनुजसन्निधौ वचः"<br><b>उल्लेखाः - </b>किरा० १-२६<br><br>

अनुजा
अनुजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಂಗಿ /ಸಹೋದರಿ<br><b>निष्पत्तिः - </b>स्त्रियाम् "टाप्"<br><br>

अनुजन्मन्
अनुजन्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಮ್ಮ /ಕಿರಿಯ ಸಹೋದರ<br><b>व्युत्पत्तिः - </b>अनु जन्म यस्य<br><b>प्रयोगाः - </b>"जननाथ तवानुजन्मनाम्"<br><b>उल्लेखाः - </b>किरा० २-१७<br><br>

अनुजात
अनुजात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಮ್ಮ /ಕಿರಿಯ ಸಹೋದರ<br><br>अनुजात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಂತರ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>अनु + जनी (प्रादुर्भावे) - "क्तः" (३-४-७२०<br><b>प्रयोगाः - </b>"असौ कुमारस्तमजोऽनुजातः"<br><b>उल्लेखाः - </b>रघु० ६-७८<br><br>

अनुजीविन्
अनुजीविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಕ /ಆಳು<br><b>निष्पत्तिः - </b>अनु + जीव (प्राणधारणे)- "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अनुजीवितुं शीलमस्य<br><b>प्रयोगाः - </b>"न वञ्चनीयाः प्रभवोऽनुजीविभिः"<br><b>उल्लेखाः - </b>किरा० १-४<br><br>अनुजीविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಿತ /ಇತರರ ಆಶ್ರಯದಿಂದ ಜೀವಿಸುವ /ಪರಾಧೀನ<br><br>

अनुजीव्य
अनुजीव्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜಮಾನ<br><br>अनुजीव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯವನ್ನು ನೀಡುವ /ಆಶ್ರಯಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अनु + जीव (प्राणधारणे)- "ण्यत्" (३-१-१२४)<br><b>व्युत्पत्तिः - </b>अनुजीव्यतेऽसौ<br><br>

अनुज्ञा
अनुज्ञा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಮತಿ /ಸಮ್ಮತಿ /ಒಪ್ಪಿಗೆ<br><b>निष्पत्तिः - </b>अनु + ज्ञा (नियोगे) - "अङ्" (३-३-१०६)<br><b>प्रयोगाः - </b>"ऋषेरनुज्ञामधिगम्य मातः"<br><b>उल्लेखाः - </b>रघु० २-६६<br><br>अनुज्ञा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಜ್ಞೆ /ಅಪ್ಪಣೆ<br><b>प्रयोगाः - </b>"रहस्यनुज्ञामधिगम्य भूभृतः"<br><b>उल्लेखाः - </b>किरा० १-३<br><br>

अनुज्ञात
अनुज्ञात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆ ಮಾಡಲ್ಪಟ್ಟ<br><br>अनुज्ञात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಮತಿಸಲ್ಪಟ್ಟ /ಸಮ್ಮತಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + ज्ञा (नियोगे) - "क्तः" (३-२-१०२)<br><br>

अनुज्ञापक
अनुज्ञापक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆ ಮಾಡುವವನು<br><br>अनुज्ञापक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಮತಿ ಕೊಡುವವನು<br><b>निष्पत्तिः - </b>अनु + ज्ञा (नियोगे) + णिच् - "ण्वुल्" (३-१-१३३)<br><br>

अनुज्ञापन
अनुज्ञापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆ ಮಾಡುವಿಕೆ<br><br>अनुज्ञापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಮತಿ ಕೊಡುವಿಕೆ<br><b>निष्पत्तिः - </b>अनु + ज्ञा (नियोगे) + णिच् - "ल्युट्" (३-३-११५)<br><br>

अनुज्येष्ठ
अनुज्येष्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠನ ತರುವಾಯ ಹುಟ್ಟಿದವನು<br><b>व्युत्पत्तिः - </b>अनुगतः ज्येष्ठम्<br><br>अनुज्येष्ठ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠನ ಕ್ರಮದಲ್ಲಿ<br><b>व्युत्पत्तिः - </b>ज्येष्ठस्यानुपूर्व्येण<br><br>अनुज्येष्ठ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹಿರಿಯದನ್ನು ಮೀರದೆ<br><b>व्युत्पत्तिः - </b>ज्येष्ठमनतिक्रम्य<br><br>

अनुतर
अनुतर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನದಿಯನ್ನು ದಾಟಲು ಕೊಡುವ ಶುಲ್ಕ /ದೋಣಿಯ ಬಾಡಿಗೆ /ನದಿಯನ್ನು ದಾಟಿಸಿದ ಕೂಲಿ<br><b>निष्पत्तिः - </b>अनु + तॄ (प्लवनतरणयोः) - कर० "अप्" (३-३-५७)<br><b>व्युत्पत्तिः - </b>अनुतीर्यतेऽनेन<br><br>

अनुतर्ष
अनुतर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯಪಾನ<br><br>अनुतर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಡಿಕೆ /ಬಾಯಾರಿಕೆ<br><br>अनुतर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆ /ಅಭಿಲಾಷೆ<br><b>निष्पत्तिः - </b>अनु + ञि तृषा (पिपासायाम्) - "घञ्" (३-३-१८)<br><b>व्युत्पत्तिः - </b>अनुतृष्यते<br><br>अनुतर्ष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ<br><b>निष्पत्तिः - </b>कर्म० "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>अनुतृष्यते इदम्<br><br>अनुतर्ष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯಪಾನದ ಪಾತ್ರೆ<br><b>निष्पत्तिः - </b>कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>अनुतृष्यतेऽनेन<br><b>प्रयोगाः - </b>"सानुतर्षमनुतर्षपदेन"<br><b>उल्लेखाः - </b>माघ० १०-२<br><b>विस्तारः - </b>"मद्येऽनुतर्षं तत्पाने पात्रे तृष्णाभिलाषयोः" - विश्व० । "अनुतर्षः सुरापानपात्रे तृष्णाभिलाषयोः" - नानार्थर० ।<br><br>

अनुतर्षण
अनुतर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ<br><b>निष्पत्तिः - </b>अनु + ञि तृषा (पिपासायाम्) - भावे "ल्युट्" (३-३-११५)<br><br>अनुतर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯಪಾನದ ಪಾತ್ರೆ<br><b>निष्पत्तिः - </b>अनु + ञि तृषा (पिपासायाम्) - कर० "ल्युट्" (३-३-११७)<br><br>

अनुतप्त
अनुतप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಯಿಸಲ್ಪಟ್ಟ /ಬಿಸಿ ಮಾಡಲ್ಪಟ್ಟ<br><br>अनुतप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಶ್ಚಾತ್ತಾಪ ಹೊಂದಿದ /ಮರುಗಿದ<br><br>

अनुताप
अनुताप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಶ್ಚಾತ್ತಾಪ /ಅನುಚಿತಕಾರ್ಯದಿಂದುಂಟಾದ ದುಃಖ<br><b>निष्पत्तिः - </b>अनु + तप (सन्तापे) - भावे "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"यस्याः करिष्यामि दृढानुतापं प्रवालशय्याशरणं शरीरम्"<br><b>उल्लेखाः - </b>कुमा० ३-८<br><br>अनुताप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಸಿ /ಕಾವು<br><br>

अनुतापन
अनुतापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಶ್ಚಾತ್ತಾಪವುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>अनु + तप (सन्तापे) + णिच् - "ल्युः" (३-१-१३४)<br><br>

अनुतापिन्
अनुतापिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಶ್ಚಾತ್ತಾಪವುಳ್ಳ /ಮರುಗುವ /ಅನುಚಿತ ಕಾರ್ಯದಿಂದ ದುಃಖಪಡುವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>अनुतापोऽस्यास्ति<br><br>

अनुत्क
अनुत्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹವಿಲ್ಲದ /ಇಷ್ಟವಾದುದನ್ನು ಹೊಂದಲು ತವಕಪಡದಿರುವ<br><b>व्युत्पत्तिः - </b>न उत्कः<br><br>

अनुत्तम
अनुत्तम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಶ್ರೇಷ್ಠವಾದ /ಎಲ್ಲಕ್ಕಿಂತಲೂ ಉನ್ನತವಾದ /ಸರ್ವೋತ್ತಮವಾದ<br><b>व्युत्पत्तिः - </b>नास्ति उत्तमो यस्मात्<br><b>प्रयोगाः - </b>"अनुत्तमादुत्तरमार्यधाम्नः"<br><b>उल्लेखाः - </b>याद० १८-१२४<br><br>

अनुत्तर
अनुत्तर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜವಾಬು ಕೊಡದಿರುವುದು /ಉತ್ತರ ಹೇಳದಿರುವುದು<br><b>प्रयोगाः - </b>"भवत्यवज्ञा च भवत्यनुत्तरात्"<br><b>उल्लेखाः - </b>नैष० ९-२५<br><br>अनुत्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತಮ /ಸರ್ವಶ್ರೇಷ್ಠ /ಅನುಪಮ<br><b>व्युत्पत्तिः - </b>न विद्यते उत्तरः यस्मात्<br><b>प्रयोगाः - </b>"अनुत्तराणि विलसितानि"<br><b>उल्लेखाः - </b>दशकु०<br><br>अनुत्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರವಿಲ್ಲದ /ಪ್ರತಿಯಿಲ್ಲದ /ಜವಾಬಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति उत्तरं यस्य<br><br>अनुत्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಕೃಷ್ಟವಾದ /ಉತ್ತಮವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न उत्तरः<br><br>

अनुत्तरङ्ग
अनुत्तरङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಚಂಚಲ /ಸ್ಥಿರವಾದ /ಅಲೆಗಳಿಂದ ಚಲಿಸದಿರುವ<br><b>व्युत्पत्तिः - </b>न उत्तरङ्गाः यस्मिन्<br><b>प्रयोगाः - </b>"अपामिवाधारमनुत्तरङ्गम्"<br><b>उल्लेखाः - </b>कुमा० ३-४८<br><br>

अनुत्पत्ति
अनुत्पत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿಯಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न उत्पत्तिः<br><br>अनुत्पत्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿಯಿಲ್ಲದ<br><br>

अनुत्पत्तिक
अनुत्पत्तिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न उत्पत्तिर्यस्य<br><br>

अनुत्पन्न
अनुत्पन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜನ್ಯವಲ್ಲದ /ಹುಟ್ಟಿಲ್ಲದ<br><br>अनुत्पन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇನ್ನೂ ಹುಟ್ಟದಿರುವ /ಇನ್ನೂ ಉಂಟಾಗದಿರುವ<br><br>

अनुत्पाद
अनुत्पाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿಯಿಲ್ಲದಿರುವಿಕೆ /ಹುಟ್ಟು ಇಲ್ಲದಿರುವಿಕೆ<br><br>अनुत्पाद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿಯಿಲ್ಲದ<br><br>

अनुत्साह
अनुत्साह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹವಿಲ್ಲದಿರುವಿಕೆ /ದೊಡ್ಡ ಕಾರ್ಯದಲ್ಲಿ ಪ್ರಯತ್ನವಿಲ್ಲದಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"ध्रुवमेतदवेहि विद्विषां त्वदनुत्साहहता विपत्तयः"<br><b>उल्लेखाः - </b>किरा० २-२२<br><br>अनुत्साह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹವಿಲ್ಲದ /ಪ್ರಯತ್ನವಿಲ್ಲದ<br><br>

अनुत्सिक्त
अनुत्सिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗರ್ವವಿಲ್ಲದ /ಕೊಬ್ಬಿಲ್ಲದ /ದರ್ಪವಿಲ್ಲದ<br><br>

अनुत्सुक
अनुत्सुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಾಂತವಾದ /ತವಕವಿಲ್ಲದ /ಇಷ್ಟವಾದುದನ್ನು ಪಡೆಯಲು ಹೆಚ್ಚು ಆತುರವಿಲ್ಲದ<br><br>

अनुत्सूत्र
अनुत्सूत्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೂತ್ರವನ್ನು ಮೀರದ /ಶಾಸ್ತ್ರವನ್ನು ಮೀರದಿರುವ<br><b>व्युत्पत्तिः - </b>उत्क्रान्तः सूत्रं व्याकरणसूत्रं नीतिशास्त्रं वा उत्सूत्रः । न उत्सूत्रः ।<br><b>प्रयोगाः - </b>"अनुत्सूत्रपदन्यासा सद्वृत्तिः सन्निबन्धना"<br><b>उल्लेखाः - </b>माघ० २-११२<br><br>

अनुत्सेक
अनुत्सेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ವವಿಲ್ಲದಿರುವಿಕೆ /ದರ್ಪವಿಲ್ಲದಿರುವಿಕೆ<br><br>अनुत्सेक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗರ್ವವಿಲ್ಲದ /ಅಹಂಕಾರವಿಲ್ಲದ<br><br>

अनुत्सेकिन्
अनुत्सेकिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗರ್ವವಿಲ್ಲದ /ಅಹಂಕಾರವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न उत्सेकी<br><br>

अनुत्सेकिनी
अनुत्सेकिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ವವಿಲ್ಲದ /ಅಹಂಕಾರವಿಲ್ಲದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><b>प्रयोगाः - </b>"भूयिष्ठं भव दक्षिणा परिजने भाग्येष्वनुत्सेकिनी"<br><b>उल्लेखाः - </b>शाकु० ४-१७<br><br>

अनुद
अनुद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೇರಕನಲ್ಲದ<br><b>निष्पत्तिः - </b>णुद (प्रेरणे) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>नुदति<br><br>अनुद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುರೂಪವಾದುದನ್ನು ಕೊಡುವ<br><b>निष्पत्तिः - </b>अनु + दाञ् (दाने) - "कः" (३-१-१३६)<br><b>व्युत्पत्तिः - </b>अनु ददाति<br><br>

अनुदक
अनुदक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರುಭೂಮಿ /ಊಷರ ಭೂಮಿ<br><b>व्युत्पत्तिः - </b>नास्ति उदकं यत्र<br><br>अनुदक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ನೀರುಳ್ಳ ಕೊಳ<br><b>व्युत्पत्तिः - </b>न अल्पं उदकं यत्र<br><br>अनुदक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಲತರ್ಪಣವಿಲ್ಲದ ಶ್ರಾದ್ಧ<br><br>

अनुदग्र
अनुदग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎತ್ತರವಲ್ಲದ /ಉನ್ನತವಲ್ಲದ<br><br>अनुदग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೃದುವಾದ /ಮೆದುವಾದ /ಮೆತ್ತಗಿರುವ<br><br>अनुदग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೀಕ್ಷ್ಣ್ಣವಲ್ಲದ /ಹರಿತವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न उदग्रमस्य<br><br>अनुदग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಉನ್ನತವಾದ /ಹೆಚ್ಚು ಎತ್ತರವಾದ<br><b>व्युत्पत्तिः - </b>नास्ति उदग्रो यस्मात्<br><br>

अनुदर
अनुदर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಶವಾದ ಉದರವುಳ್ಳ /ತೆಳುವಾದ ಹೊಟ್ಟೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>न अल्पं उदरं यस्य<br><br>

अनुदरा
अनुदरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಶವಾದ ಉದರವುಳ್ಳ /ತೆಳುವಾದ ಹೊಟ್ಟೆಯುಳ್ಳ<br><br>

अनुदात्त
अनुदात्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುದಾತ್ತ ಸ್ವರ /ತಗ್ಗಿದ ಸ್ವರ /ತಾಲ್ವಾದಿ ಸ್ಥಾನಗಳಲ್ಲಿ ಕೆಳಭಾಗದಲ್ಲಿ ಹುಟ್ಟುವ ಸ್ವರ<br><b>प्रयोगाः - </b>"नीचैरनुदात्तः"<br><b>उल्लेखाः - </b>पा० सू०<br><br>अनुदात्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಔದಾರ್ಯವಿಲ್ಲದವನು /ದೊಡ್ಡ ಮನಸ್ಸಿಲ್ಲದವನು<br><br>

अनुदार
अनुदार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲೋಭಿ /ಜಿಪುಣ<br><br>अनुदार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೊಡ್ಡದಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न उदारः<br><br>अनुदार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತ್ಯಾಗಶೀಲ /ದಾನಿ /ಹೆಚ್ಚು ದಾನದ ಬುದ್ಧಿಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>न उदारो यस्मात्<br><br>अनुदार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪತ್ನಿಯನ್ನು ಅನುಸರಿಸಿರುವ /ಪತ್ನಿಯನ್ನು ಅವಲಂಬಿಸಿರುವ<br><b>व्युत्पत्तिः - </b>अनुगतो दारान्<br><br>अनुदार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುರೂಪಳಾದ ಪತ್ನಿಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अनु दारा यस्य<br><br>

अनुदित
अनुदित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನು ಸ್ವಲ್ಪ ಮಾತ್ರ ಉದಯಿಸಿರುವ ಕಾಲ<br><b>व्युत्पत्तिः - </b>न अल्पं उदितः<br><b>प्रयोगाः - </b>"उदितेऽनुदिते चैव समयाध्युषिते तथा"<br><b>उल्लेखाः - </b>मनु० २-१५<br><br>अनुदित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದಯಿಸದಿರುವ /ಹುಟ್ಟದಿರುವ<br><b>व्युत्पत्तिः - </b>न उदितः<br><br>अनुदित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲ್ಪಡದ<br><b>निष्पत्तिः - </b>वद (व्यक्तायां वाचि) -"क्तः" (३-२-१०२)<br><br>

अनुदिन
अनुदिन<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿದಿನವೂ<br><b>निष्पत्तिः - </b>वीप्सायां अव्ययी०<br><b>व्युत्पत्तिः - </b>दिने दिने<br><br>

अनुदृष्टि
अनुदृष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಕೂಲವಾದ ದೃಷ್ಟಿ<br><b>व्युत्पत्तिः - </b>अनुकूला दृष्टिः<br><br>अनुदृष्टि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕೂಲದೃಷ್ಟಿಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अनुकूला दृष्टिर्यस्य<br><br>

अनुद्धत
अनुद्धत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಮ್ರ /ವಿನಯಶೀಲ /ಶಾಂತವಾದ<br><b>व्युत्पत्तिः - </b>न उद्धतः<br><b>प्रयोगाः - </b>"अनुद्धताकारतया विविक्ताम्"<br><b>उल्लेखाः - </b>किरा० ३-३<br><br>

अनुद्धरण
अनुद्धरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರೆ ಜಾಗಕ್ಕೆ ಬದಲಾಯಿಸದೆ ಇರುವಿಕೆ /ಮೇಲಕ್ಕೆ ತೆಗೆಯದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न उद्धरणम्<br><br>अनुद्धरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಾಪಿಸದಿರುವಿಕೆ /ಸ್ಥಿರಪಡಿಸದಿರುವಿಕೆ<br><br>

अनुद्धार
अनुद्धार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ತೆಗೆಯದಿರುವಿಕೆ<br><br>अनुद्धार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಲವಿಲ್ಲದಿರುವಿಕೆ<br><b>विस्तारः - </b>"स्यादृणं पर्युदञ्चनम् । तदवृद्धिकमुद्धारः" - वैज० ।<br><br>अनुद्धार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಭಾಗ ಮಾಡದಿರುವಿಕೆ /ಪಾಲು ಹಂಚದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न उद्धारः<br><br>

अनुद्धृत
अनुद्धृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲ್ಪಡದ<br><br>अनुद्धृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಭಾಗ ಮಾಡಲ್ಪಡದ<br><br>

अनुद्भट
अनुद्भट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧೈರ್ಯವಿಲ್ಲದ /ಮೃದು ಸ್ವಭಾವದ<br><br>अनुद्भट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗರ್ವವಿಲ್ಲದ<br><br>

अनुद्यत
अनुद्यत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ಯೋಗವಿಲ್ಲದ /ಸೋಮಾರಿ /ಕೆಲಸ ಮಾಡದ<br><br>अनुद्यत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲ್ಪಡದ<br><br>

अनुद्यम
अनुद्यम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न उद्यमः<br><br>अनुद्यम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೋಮಾರಿಯಾದ /ಜಡ /ಕೆಲಸವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न उद्यमो यस्य<br><br>

अनुद्यूत
अनुद्यूत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುನಃ ಆಟವಾಡುವುದು /ಎರಡನೇ ಸಲದ ಆಟ<br><b>निष्पत्तिः - </b>अनु + दिवु (क्रीडायाम्) - "क्तः" (३-३-११४)<br><br>अनुद्यूत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾಭಾರತದಲ್ಲಿ ಸಭಾಪರ್ವದ ಒಂದು ಭಾಗ /ಅನುದ್ಯೂತಪರ್ವ /ದ್ಯೂತವಿಷಯವನ್ನು ಕುರಿತು ರಚಿಸಿದ ಗ್ರಂಥ<br><br>

अनुद्योग
अनुद्योग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೋಮಾರಿತನ<br><b>व्युत्पत्तिः - </b>न उद्योगः<br><br>अनुद्योग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೋಮಾರಿತನವುಳ್ಳ /ಕೆಲಸವಿಲ್ಲದಿರುವ<br><b>व्युत्पत्तिः - </b>न उद्योगो यस्य<br><br>

अनुद्रुत
अनुद्रुत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧದ್ರುತತಾಳ<br><br>अनुद्रुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಿಸಲ್ಪಟ್ಟ /ಬೆನ್ನೆಟ್ಟಿ ಓಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + द्रु (गतौ) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अनुद्रुतः संयति येन केवलम्"<br><b>उल्लेखाः - </b>माघ० १-५२<br><br>

अनुद्वाह
अनुद्वाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದುವೆಯಾಗದಿರುವಿಕೆ /ಬ್ರಹ್ಮಚರ್ಯದಲ್ಲಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न उद्वाहः<br><br>अनुद्वाह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮದುವೆಯಾಗದಿರುವ<br><b>व्युत्पत्तिः - </b>नास्ति उद्वाहो यस्य<br><br>

अनुद्विग्न
अनुद्विग्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಶಂಕ /ಭಯವಿಲ್ಲದ<br><br>अनुद्विग्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಿಂತನಾದ<br><br>अनुद्विग्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುಃಖಗೊಳ್ಳದ<br><b>व्युत्पत्तिः - </b>न उद्विग्नः<br><br>

अनुद्वेग
अनुद्वेग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಯವಿಲ್ಲದಿರುವಿಕೆ<br><br>अनुद्वेग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಂತೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अनुद्वेग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುಃಖವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न उद्वेगः<br><b>प्रयोगाः - </b>"अनुद्वेगकरं वाक्यं सतां स्वाभाविकं मतम्"<br><br>अनुद्वेग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯವಿಲ್ಲದ<br><br>अनुद्वेग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಂತೆಯಿಲ್ಲದ<br><br>अनुद्वेग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋವಿಲ್ಲದ<br><br>

अनुधावन
अनुधावन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಿಸಿ ಹೋಗುವಿಕೆ /ಅನುಸರಿಸಿ ನಡೆಯುವಿಕೆ<br><br>अनुधावन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತತ್ತ್ವವನ್ನು ತಿಳಿಯುವುದಕ್ಕಾಗಿ ಅನುಸರಣ<br><br>अनुधावन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತತ್ತ್ವಾನ್ವೇಷಣ<br><br>अनुधावन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶುದ್ಧಿ ಮಾಡುವಿಕೆ /ತೊಳೆಯುವಿಕೆ<br><br>

अनुध्या
अनुध्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಳ್ಳೆಯದನ್ನು ಕುರಿತು ಚಿಂತನೆ /ಒಳ್ಳೆಯದನ್ನು ಕೋರುವಿಕೆ<br><br>अनुध्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಗ್ರಹ /ಹಿತದ ಬಯಕೆ<br><br>अनुध्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಸಕ್ತಿ<br><b>निष्पत्तिः - </b>अनु + ध्यै (चिन्तायाम्) - "अङ्" (३-३-१०६)<br><br>

अनुध्यात
अनुध्यात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧ್ಯಾನ ಮಾಡಲ್ಪಟ್ಟ /ಚಿಂತಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + ध्यै (चिन्तायाम्) - "क्तः"(३-२-१०२)<br><br>

अनुध्यान
अनुध्यान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಡೆಬಿಡದ ಚಿಂತೆ /ಯಾವಾಗಲೂ ಯೋಚಿಸುತ್ತಿರುವ /ಸತತ ಧ್ಯಾನ<br><b>निष्पत्तिः - </b>अनु + ध्यै (चिन्तायाम्) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"या नः प्रीतिर्विरूपाक्ष त्वदनुध्यानसम्भवा"<br><b>उल्लेखाः - </b>कुमा० ६-२१<br><br>

अनुध्येय
अनुध्येय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಗ್ರಹ ಮಾಡಲ್ು ಅರ್ಹನಾದ /ಶುಭವನ್ನು ಕೋರಲು ಯೋಗ್ಯನಾದ<br><b>निष्पत्तिः - </b>अनु + ध्यै (चिन्तायाम्) - "यत्" (३-१-९७)<br><b>प्रयोगाः - </b>"अनुदध्युरनुध्येयं सान्निध्यैः प्रतिमागतैः"<br><b>उल्लेखाः - </b>रघु० १७-३६<br><br>अनुध्येय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧ್ಯಾನ ಮಾಡಲ್ು ಯೋಗ್ಯವಾದ /ಧ್ಯಾನ ಮಾಡಲ್ಪಡುವ<br><br>

अनुनय
अनुनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿನಯ /ನಮ್ರತೆ<br><br>अनुनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಧಾನ /ಸಮಾಧಾನ /ವಿರೋಧಿಗಳ ಮನಸ್ಸನ್ನು ಒಲಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अनु +णीञ् (प्रापणे) - "अच्" (३-३-५६)<br><b>प्रयोगाः - </b>"कथं नु शक्योऽनुनयो महर्षेः"<br><b>उल्लेखाः - </b>रघु० २-५४<br><br>अनुनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರ್ಥನೆ /ಯಾಚನೆ<br><b>प्रयोगाः - </b>"अनुनयमगृहीत्वा व्याजसुप्ता पराची"<br><b>उल्लेखाः - </b>माघ० ११-९<br><br>अनुनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಮಸ್ಕಾರ<br><b>विस्तारः - </b>"प्रणिपातस्त्वनुनयः प्रणतिः" - कल्पद्रु० ।<br><br>

अनुनाद
अनुनाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಧ್ವನಿ /ಅನುಸರಿಸಿದ ಸದ್ದು<br><br>अनुनाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುರೂಪವಾದ ಧ್ವನಿ<br><b>व्युत्पत्तिः - </b>अनुरूपो नादः<br><b>प्रयोगाः - </b>"गुरुतरकलनूपुरानुनादम्"<br><b>उल्लेखाः - </b>माघ० ७-१८<br><br>

अनुनादिन्
अनुनादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಧ್ವನಿಯನ್ನು ಕೊಡುವ /ಅನುಸರಿಸಿ ಶಬ್ದವನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>अनु + णद (अव्यक्ते शब्दे) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अनुनदति<br><b>प्रयोगाः - </b>"गम्भीरेणानुनादिना"<br><b>उल्लेखाः - </b>रामा०<br><br>

अनुनायिका
अनुनायिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಯಿಕೆಯನ್ನು ಅನುಸರಿಸಿಕೊಂಡಿರುವ ಸಖಿ /ದಾಸಿ ಮೊದಲಾದ ಹೆಂಗಸು<br><b>प्रयोगाः - </b>"सखी प्रव्रजिता दासी प्रेष्या धात्रेयिका तथा । अन्याश्च शिल्पकारिण्यो विज्ञेयाह्यनुनायिकाः ॥"<br><br>

अनुनासिक
अनुनासिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂಗಿನ ಮೂಲಕ ಉಚ್ಚರಿಸಲ್ಪಡುವ /ಮೂಗನ್ನು ಅನುಸರಿಸಿ ಹೊರಡುವ ವರ್ಣ<br><b>व्युत्पत्तिः - </b>अनुगतो नासिकाम्<br><b>प्रयोगाः - </b>"मुखनासिकया उच्चार्यमाणो वर्णः अनुनासिकसञ्ज्ञः स्यात्"<br><b>उल्लेखाः - </b>सि० कौ०<br><br>

अनुनीति
अनुनीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾಧಾನಗೊಳಿಸುವಿಕೆ /ಕೋಪವು ಶಾಂತವಾಗುವ ರೀತಿಯನ್ನು ಅನುಸರಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अनु +णीञ् (प्रापणे) - "क्तिन्" (३-३-९४)<br><br>

अनुनेय
अनुनेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುನಯಕ್ಕೆ ಅರ್ಹನಾದ /ಸಮಾಧಾನಗೊಳಿಸಲು ಯೋಗ್ಯನಾದ<br><b>निष्पत्तिः - </b>अनु +णीञ् (प्रापणे) - "यत्" (३-१-९७)<br><br>अनुनेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇಡಲು ಅರ್ಹನಾದ<br><br>

अनुपठित
अनुपठित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸಿ ಪಠಿಸುವುದು /ಗುರುವು ಹೇಳಿಕೊಟ್ಟಂತೆ ಹೇಳುವುದು<br><b>निष्पत्तिः - </b>अनु +पठ (व्यक्तायां वाचि) - भावे "क्तः" (३-३-११४)<br><br>अनुपठित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸಿ ಹೇಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु +पठ (व्यक्तायां वाचि) - कर्म० "क्तः" (३-२-१०२)<br><br>

अनुपठितिन्
अनुपठितिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುರುವಿನ ಪಾಠವನ್ನು ಅನುಸರಿಸಿ ಅಧ್ಯಯನ ಮಾಡಿದವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-८८)<br><b>व्युत्पत्तिः - </b>अनुपठितमनेन<br><br>

अनुपठितिनी
अनुपठितिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗುರುವಿನ ಪಾಠವನ್ನು ಅನುಸರಿಸಿ ಅಧ್ಯಯನ ಮಾಡಿದವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्"(४-१-५)<br><br>

अनुपतन
अनुपतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸಿ ಹೋಗುವುದು /ಬಳಿಕ ಹೋಗುವುದು<br><b>निष्पत्तिः - </b>अनु + पत्लृ (गतौ) - भावे "ल्युट्" (३-३-११५)<br><br>

अनुपति
अनुपति<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪತಿಯ ಸಮೀಪದಲ್ಲಿ<br><b>निष्पत्तिः - </b>सामीप्ये अव्ययी०<br><b>व्युत्पत्तिः - </b>पत्युः समीपे<br><br>

अनुपथ
अनुपथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಕೂಲವಾದ ಮಾರ್ಗ<br><b>निष्पत्तिः - </b>"अः" (५-४-७४)<br><b>व्युत्पत्तिः - </b>अनुकूलः पन्थाः<br><br>अनुपथ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾರ್ಗವನ್ನು ಅನುಸರಿಸಿರುವ<br><b>व्युत्पत्तिः - </b>पन्थानमगुतः<br><br>अनुपथ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮಾರ್ಗದ ಸಮೀಪದಲ್ಲಿ<br><b>निष्पत्तिः - </b>सामीप्ये अव्ययी०<br><b>व्युत्पत्तिः - </b>पथः समीपे<br><br>अनुपथ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮಾರ್ಗದಲ್ಲಿ<br><b>निष्पत्तिः - </b>सप्तम्यर्थे अव्ययी०<br><b>व्युत्पत्तिः - </b>पथि<br><br>

अनुपद
अनुपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಕೂಲವಾದ ಸ್ಥಳ<br><b>व्युत्पत्तिः - </b>अनुरूपं पदम्<br><br>अनुपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಗೀತವಿಲ್ಲದ ಪಲ್ಲವಿ<br><br>अनुपद<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನಂತರ /ಬಳಿಕ /ತರುವಾಯ<br><b>निष्पत्तिः - </b>पश्चादर्थे अव्ययी०<br><b>व्युत्पत्तिः - </b>पदस्य पश्चात्<br><b>प्रयोगाः - </b>"अमोघाः प्रतिगृह्णन्तावर्ध्यानुपदमाशिषः"<br><b>उल्लेखाः - </b>रघु० १-४४<br><br>अनुपद<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕಾಲಿನ ಸಮೀಪದಲ್ಲಿ<br><b>व्युत्पत्तिः - </b>पादस्य समीपम्<br><br>

अनुपदवि
अनुपदवि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾರಿಯನ್ನು ಅನುಸರಿಸಿರುವ<br><b>व्युत्पत्तिः - </b>पदवीमनुगतः<br><br>अनुपदवि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾರಿಯ ಸಮೀಪದಲ್ಲಿ<br><b>व्युत्पत्तिः - </b>पदव्याः समीपे<br><br>अनुपदवि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾರಿಯಲ್ಲಿ<br><b>निष्पत्तिः - </b>सप्तम्यर्थे अव्ययी०<br><b>व्युत्पत्तिः - </b>पदव्याम्<br><br>

अनुपदवी
अनुपदवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಕೂಲವಾದ ಮಾರ್ಗ /ದಾರಿ /ರಸ್ತೆ<br><b>व्युत्पत्तिः - </b>अनुकूला पदवी<br><br>अनुपदवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲುದಾರಿ<br><b>व्युत्पत्तिः - </b>अनु अप्रधाना पदवी<br><br>

अनुपदिक
अनुपदिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸಿರುವ /ಹಿಂಬಾಲಿಸುವ<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५)<br><b>व्युत्पत्तिः - </b>अनुपदमस्त्यस्य गन्तृत्वेन<br><br>

अनुपदिन्
अनुपदिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸುವ /ಹಿಂಬಾಲಿಸುವ<br><br>अनुपदिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಡುಕುವ /ವಿಚಾರಿಸುವ<br><b>निष्पत्तिः - </b>अनुपद - "इनिः" (५-२-९०)<br><b>प्रयोगाः - </b>"उदिते ततः सपदि लब्धपदैः क्षणदाकरेऽनुपदिभिः प्रयये"<br><b>उल्लेखाः - </b>माघ० ९-७०<br><br>

अनुपदिष्ट
अनुपदिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪದೇಶ ಮಾಡಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न उपदिष्टः<br><br>

अनुपदीना
अनुपदीना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾದರಕ್ಷೆ /ಮೋಜಾ /ಜೋಡು<br><b>निष्पत्तिः - </b>अनुपद - "खः" (५-२-९)<br><b>व्युत्पत्तिः - </b>अनुपदं बद्धा<br><br>

अनुपधि
अनुपधि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಷ್ಕಪಟವಾದ /ವಂಚನೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति उपधिर्यत्र<br><b>प्रयोगाः - </b>"रहस्यं साधूनामनुपधि विशुद्धं विजयते"<br><b>उल्लेखाः - </b>उ० रा० २-२<br><br>

अनुपनीत
अनुपनीत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪನಯನ ಸಂಸ್ಕಾರವಿಲ್ಲದ ಬಾಲಕ<br><br>अनुपनीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರಕ್ಕೆ ತರಲ್ಪಡದ<br><br>

अनुपपत्ति
अनुपपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಂಗತಿ /ಹೊಂದಿಕೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अनुपपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯುಕ್ತಿಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अनुपपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಷ್ಟ /ತೊಂದರೆ /ದಾರಿದ್ರ್ಯ<br><br>

अनुपपन्न
अनुपपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಪತ್ತಿಯಿಲ್ಲದ<br><br>अनुपपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯುಕ್ತಿಯಿಲ್ಲದ /ಉಪಾಯವಿಲ್ಲದ<br><br>अनुपपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧವಿಲ್ಲದ<br><br>

अनुपप्लव
अनुपप्लव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಂದರೆಯಿಲ್ಲದ /ನಾಶವಿಲ್ಲದ<br><b>प्रयोगाः - </b>"श्रुतिभिरप्यनुपप्लवनीतिभिः"<br><b>उल्लेखाः - </b>याद० ३-८<br><br>

अनुपबाध
अनुपबाध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಂದರೆಯಿಲ್ಲದ /ಪ್ರತಿಬಂಧಕವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति उपबाधा यस्य<br><br>

अनुपम
अनुपम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಮಾನವಾದ /ಹೋಲಿಕೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति उपमा सादृश्यं यस्य<br><br>

अनुपमा
अनुपमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಮಾನವಾದ /ಹೋಲಿಕೆಯಿಲ್ಲದ<br><br>अनुपमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಹೆಣ್ಣಾನೆ /ಕುಮುದವೆಂಬ ದಿಗ್ಗಜನ ಪತ್ನಿ<br><br>

अनुपमेय
अनुपमेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಮಾನವಾದ /ಹೋಲಿಕೆಯಿಲ್ಲದ<br><b>निष्पत्तिः - </b>उप +माङ् (माने) - "यत्" (३-१-९७)<br><b>व्युत्पत्तिः - </b>न उपमीयतेऽसौ<br><br>

अनुपयुक्त
अनुपयुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಯೋಗಿಸಲ್ಪಡದ /ಅನುಭವಿಸಲ್ಪಡದ<br><br>अनुपयुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯೋಗ್ಯವಲ್ಲದ<br><br>अनुपयुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಯೋಗವಿಲ್ಲದ /ಪ್ರಯೋಜನವಿಲ್ಲದ<br><br>

अनुपयोग
अनुपयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯೋಜನವಿಲ್ಲದಿರುವಿಕೆ /ಅನುಕೂಲ್ಯವಿಲ್ಲದಿರುವಿಕೆ<br><br>अनुपयोग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕೂಲ್ಯವಿಲ್ಲದ /ಪ್ರಯೋಜನವಿಲ್ಲದ<br><br>

अनुपरत
अनुपरत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರಣ ಹೊಂದದ<br><br>अनुपरत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿರಾಮವಿಲ್ಲದ /ವಿಶ್ರಾಂತಿಯಿಲ್ಲದ<br><br>अनुपरत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿವೃತ್ತಿಯಿಲ್ಲದ /ವಿಷಯಾಭಿಲಾಷೆಯಿಂದ ಹಿಂತಿರುಗದ<br><br>अनुपरत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಗಿಯದ /ಸಮಾಪ್ತಿ ಹೊಂದಿದ<br><br>

अनुपलक्षित
अनुपलक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ತಿಳಿಯಲ್ಪಡದ<br><br>अनुपलक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಹಿಸಲ್ಪಡದ<br><br>अनुपलक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡಲ್ಪಡದ<br><br>

अनुपलब्ध
अनुपलब्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲಕ್ಷಿಸಲ್ಪಡದ /ಇಂದ್ರಿಯಗಳಿಂದ ತಿಳಿಯಲ್ಪಡದ<br><br>अनुपलब्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न उपलब्धः<br><br>

अनुपलब्धि
अनुपलब्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಡೆಯದಿರುವಿಕೆ /ಹೊಂದದಿರುವಿಕೆ<br><br>अनुपलब्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯಕ್ಷವಾಗಿ ಕಾಣದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न उपलब्धिः<br><br>अनुपलब्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಾವವನ್ನು ತಿಳಿಸುವ ಮೀಮಾಂಸಕರ ಒಂದು ಪ್ರಮಾಣ<br><br>

अनुपवीत
अनुपवीत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪನಯನ ಸಂಸ್ಕಾರವಿಲ್ಲದ ಬಾಲಕ<br><br>अनुपवीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಜ್ಞೋಪವೀತವಿಲ್ಲದ ಬಾಲಕ<br><b>व्युत्पत्तिः - </b>न उपवीतं यस्य<br><br>

अनुपशम
अनुपशम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಂತಿಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अनुपशम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಷಯಾಭಿಲಾಷೆಯಿಂದ ನಿವೃತ್ತಿಯಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न उपशमः शान्तिः निवृत्तिर्वा<br><br>

अनुपसेचन
अनुपसेचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಸರು ಸಂಬಾರ ಹುಳಿ ಮೊದಲಾದುವುಗಳೊಡನೆ ಬೆರಸದ ಅನ್ನ /ಯಾವ ವ್ಯಂಜನವೂ ಇಲ್ಲದ ಅನ್ನ<br><b>व्युत्पत्तिः - </b>नास्ति उपसेचनं व्यञ्जनं यस्य<br><br>

अनुपस्कार
अनुपस्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಧ್ಯಾಹಾರ ದೋಷವಿಲ್ಲದೆ ಇರುವಿಕೆ /ಪದಗಳ ಲೋಪವಿಲ್ಲದಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"साकाङ्क्षमनुपस्कारम्"<br><b>उल्लेखाः - </b>किरा० ११-३८<br><br>

अनुपस्कृत
अनुपस्कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇಯಿಸಲ್ಪಡದ<br><br>अनुपस्कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಗ್ಗರಿಸಲ್ಪಡದ<br><br>अनुपस्कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಕಾರ ಹೊಂದದ /ಚೊಕ್ಕ /ಶುದ್ಧವಾದ<br><b>निष्पत्तिः - </b>अनु + उप + डुकृञ् (करणे) - "क्तः" (३-२-१०२) । सुट् (६-१-१३९)<br><br>अनुपस्कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯಕ್ಷ ಪ್ರಯೋಜವನ್ನು ಅಪೇಕ್ಷಿಸದೆ<br><b>प्रयोगाः - </b>"ब्राह्मणार्थे गवार्थे वा देहत्यागेऽनुपस्कृतः"<br><b>उल्लेखाः - </b>मनु० १०-६२<br><br>

अनुपस्थान
अनुपस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಾವ /ಇಲ್ಲದಿರುವಿಕೆ<br><br>अनुपस्थान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಾಜರಾಗಿಲ್ಲದ<br><br>

अनुपस्थापन
अनुपस्थापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಜರು ಪಡಿಸದಿರುವಿಕೆ /ಸಮೀಪಕ್ಕೆ ತರದಿರುವಿಕೆ<br><br>अनुपस्थापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾಪಿಸದಿರುವಿಕೆ<br><br>

अनुपस्थापित
अनुपस्थापित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಾಜರು ಪಡಿಸಲ್ಪಡದ /ತರಲ್ಪಡದಿರುವ /ಎದುರಿಗೆ ತೋರಿಸಲ್ಪಡದ<br><br>अनुपस्थापित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜ್ಞಾಪಿಸಲ್ಪಡದ<br><br>

अनुपस्थित
अनुपस्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಾಜರಾಗದ /ಬರದಿರುವ /ಸಮೀಪದಲ್ಲಿಲ್ಲದ<br><br>अनुपस्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜ್ಞಾಪಕವಿಲ್ಲದ /ನೆನಪಿಲ್ಲದ<br><br>

अनुपस्थिति
अनुपस्थिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೈರುಹಾಜರಿ /ಬರದಿರುವಿಕೆ<br><br>अनुपस्थिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೆನಪಿಲ್ಲದಿರುವಿಕೆ /ಮರವು<br><b>व्युत्पत्तिः - </b>न उपस्थितिः<br><br>

अनुपहत
अनुपहत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಸದಾದ ಮತ್ತು ಉಪಯೋಗಿಸದ ಬಟ್ಟೆ<br><b>प्रयोगाः - </b>"अनुपहतमतिधवलं दुकूलयुगलम्"<br><b>उल्लेखाः - </b>कादं०<br><br>अनुपहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಡಿಸಲ್ಪಡದ<br><br>अनुपहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಾಯ ಮಾಡಲ್ಪಡದ<br><br>अनुपहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಯೋಗಿಸಲ್ಪಡದ<br><br>

अनुपात
अनुपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತ್ರೈರಾಶಿಕ ಗಣಿತ<br><b>व्युत्पत्तिः - </b>अनुरूपः त्रैराशिकेन पातः<br><br>अनुपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಿಸುವುದು<br><b>व्युत्पत्तिः - </b>अनु पश्चात् पातः<br><b>प्रयोगाः - </b>"उपवनपवनानुपातदक्षैः"<br><b>उल्लेखाः - </b>माघ० ७-२७<br><br>

अनुपातक
अनुपातक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಹತ್ಯೆ ಮೊದಲಾದ ಮಹಾಪಾತಕಕ್ಕೆ ಸಮವಾದ ಪಾಪ<br><b>निष्पत्तिः - </b>अनु + पत्लृ (गतौ) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>अनुपातयति नरकं गमयति<br><br>

अनुपातकिन्
अनुपातकिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಹಾಪಾತಕಕ್ಕೆ ಸಮವಾದ ಪಾಪವುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>अनुपातकमस्त्यस्य<br><br>

अनुपातिन्
अनुपातिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸಿ ಬರುವ /ಹಿಂಬಾಲಿಸುವ<br><b>निष्पत्तिः - </b>अनु +पत्लृ (गतौ) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अनुपतति<br><br>

अनुपान
अनुपान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಔಷಧದ ಜೊತೆಯಲ್ಲಿ ಅಥವಾ ಔಷಧ ಸೇವಿಸಿದ ಮೇಲೆ ಕುಡಿಯುವ ಪಾನೀಯ<br><b>निष्पत्तिः - </b>अनु +पा (पाने) - "ल्युट्" (३-३-११३)<br><b>व्युत्पत्तिः - </b>अनु सह पश्चाद्वा पीयते<br><br>अनुपान<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನೀರಿನ ಸಮೀಪದಲ್ಲಿ<br><b>निष्पत्तिः - </b>सामीप्ये अव्ययी०<br><b>व्युत्पत्तिः - </b>पानस्य जलस्य समीपे<br><br>

अनुपानीय
अनुपानीय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಔಷಧದ ಜೊತೆಯಲ್ಲಿ ಅಥವಾ ಸೇವಿಸಿದ ಮೇಲೆ ಕುಡಿಯುವ ನೀರು<br><br>

अनुपालयत्
अनुपालयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪೇಕ್ಷಿಸುವ /ಉದಸೀನತೆಯಿಂದ ಕಾಣುವ<br><b>प्रयोगाः - </b>"अनुपालयतामुदेष्यतीं प्रभुशक्तिन्द्विषतामनीहया"<br><b>उल्लेखाः - </b>किरा० २-१०<br><br>

अनुपूर्व
अनुपूर्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ರಮವಾಗಿ ಬಂದ<br><br>अनुपूर्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದೆ ಇರುವವನ್ನು ಅನುಸರಿಸಿ ಬಂದ<br><b>व्युत्पत्तिः - </b>अनुगतः क्रमं पूर्वं वा<br><b>प्रयोगाः - </b>"वृत्तानुपूर्वे च न चातिदीर्घे"<br><b>उल्लेखाः - </b>कुमा० १-३५<br><br>

अनुपूर्वशस्
अनुपूर्वशस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕ್ರಮವಾಗಿ /ಒಂದಾದ ಮೇಲೆ ಒಂದಾಗಿ<br><b>निष्पत्तिः - </b>अनुपूर्व - "शस्" (५-४-४३)<br><br>

अनुपेत
अनुपेत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಪನೀತ /ಉಪನಯನವಿಲ್ಲದವನು<br><br>अनुपेत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಹೋಗದಿರುವ<br><br>

अनुप्त
अनुप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿತ್ತಲ್ಪಡದ ಬೀಜ<br><br>अनुप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿತ್ತನೆಯಾಗದಿರುವ ನೆಲ<br><br>

अनुप्रदान
अनुप्रदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಾನ /ಕಾಣಿಕೆ<br><br>अनुप्रदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧ್ವನಿಗಳನ್ನು ಹೊರಡಿಸುವ ಬಾಹ್ಯಪ್ರಯತ್ನ<br><b>निष्पत्तिः - </b>अनु + प्र + दाञ् (दाने) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>अनुप्रदीयतेऽनेन<br><b>प्रयोगाः - </b>"एते श्वासानुप्रदाना अघोषाश्च विवृण्वते"<br><b>उल्लेखाः - </b>सि० कौ०<br><br>

अनुप्रवचन
अनुप्रवचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುರುವು ಹೇಳಿ ಕೊಟ್ಟಂತೆ ಹೇಳುವುದು /ಗುರುವಿನ ಉಚ್ಚಾರಣೆಯನ್ನು ಅನುಸರಿಸಿ ಹೇಳುವುದು<br><b>व्युत्पत्तिः - </b>अनुरूपं प्रवचनं अनु पश्चाद्वा प्रवचनम्<br><br>

अनुप्रवचनीय
अनुप्रवचनीय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪದೇಶಿಸಲ್ಪಡುವ ಮಂತ್ರದ ಸಿದ್ಧಿಗಾಗಿ ಅದರ ಅಂಗವಾಗಿ ಶಿಷ್ಯನಿಗೆ ಮಾಡುವ ಒಂದು ಸಂಸ್ಕಾರ<br><b>निष्पत्तिः - </b>"छः" (५-१-१११)<br><b>व्युत्पत्तिः - </b>अनुप्रवचनं प्रयोजनमस्य<br><br>

अनुप्रवेश
अनुप्रवेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಳಗೆ ಪ್ರವೇಶಿಸುವುದು<br><b>निष्पत्तिः - </b>अनु + प्र + विश (प्रवेशने) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"पुपोष वृद्धिं हरिदश्वदीधितेरनुप्रवेशादिव बालचन्द्रमाः"<br><b>उल्लेखाः - </b>रघु० ३-२२<br><br>अनुप्रवेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸುವುದು /ಹೊಂದಿಕೊಳ್ಳುವುದು<br><b>प्रयोगाः - </b>"भजते विदेशमधिकेन जितस्तदनुप्रवेशमथ वा कुशलः"<br><b>उल्लेखाः - </b>माघ० ९-४८<br><br>

अनुप्रश्न
अनुप्रश्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನಂತರದ ಪ್ರಶ್ನೆ /ಹಿಂದಿನ ವಿಷಯವನ್ನು ಅನುಸರಿಸಿದ ಪ್ರಶ್ನೆ<br><br>

अनुप्रसक्ति
अनुप्रसक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಸಮೀಪ ಸಂಬಂಧ /ವಿಷಯಕ್ಕೆ ಹೊಂದಿಕೆಯಾಗುವ ಯುಕ್ತಿಯುತವಾದ ಸಂಬಂಧ<br><br>

अनुप्रास
अनुप्रास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಶಬ್ದಾಲಂಕಾರ /ರಸಾದಿಗಳಿಗೆ ಅನುಕೂಲವಾದ ಸಜಾತೀಯ ವರ್ಣಗಳ ಆವೃತ್ತಿ /ಒಂದೇ ಜಾತಿಯ ಅಕ್ಷರಗಳನ್ನು ಮತ್ತೆ ಮತ್ತೆ ಉಪಯೋಗಿಸುವುದು<br><b>व्युत्पत्तिः - </b>अनुगतः रसाद्यनुगुणः प्रकृष्टः आसः समवर्णोच्चारणम्<br><b>प्रयोगाः - </b>"अनुप्रासः शब्दसाम्यं वैषम्येऽपि स्वरस्य यत्"<br><b>उल्लेखाः - </b>सा० द० १०-३<br><br>

अनुप्लव
अनुप्लव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಗಡಿಗ /ಜೊತೆಗಾರ<br><br>अनुप्लव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವಕ /ಆಳು<br><b>निष्पत्तिः - </b>ल्युङ् (गतौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अनु पश्चात् प्लवते<br><b>प्रयोगाः - </b>"सानुप्लवः प्रभुरपि क्षणदाचराणाम्"<br><b>उल्लेखाः - </b>रघु० १३-७५<br><br>

अनुबद्ध
अनुबद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧಿಸಿದ /ಸೇರಿರುವ<br><br>अनुबद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಿಚ್ಛಿನ್ನವಾಗಿ ಮುಂದುವರೆದ /ಅನುವರ್ತಿಸಿರುವ<br><b>प्रयोगाः - </b>"नित्यानुबद्धकुलवैरः"<br><b>उल्लेखाः - </b>वेणी० १<br><br>

अनुबदध्यमान
अनुबदध्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾರ್ಥಿಸಲ್ಪಡುವ /ಬೇಡಲ್ಪಡುವ /ಯಾಚಿಸಲ್ಪಡುವ<br><b>प्रयोगाः - </b>"तया चानुबध्यमानस्तां वकुलमालामात्मनः कण्ठादवतार्य दत्तवान्"<br><b>उल्लेखाः - </b>मालती० १<br><br>

अनुबन्ध
अनुबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ /ಹೊಂದಿಕೆ<br><b>निष्पत्तिः - </b>अनु + बन्ध (बन्धने) + यक् - "शानच्" (३-२-१२४)<br><br>अनुबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಡಬಿದದ ಸಂಬಂಧ<br><b>निष्पत्तिः - </b>अनु + बन्ध (बन्धने) - "घञ्" (३-३-१८)<br><b>व्युत्पत्तिः - </b>अनुबध्यते<br><b>प्रयोगाः - </b>"यस्यां मनश्चक्षुषोरनुबन्धस्तस्यामृद्धिः"<br><b>उल्लेखाः - </b>मालती० २<br><br>अनुबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಂಥದ ಆರಂಭದಲ್ಲಿ ಹೇಳುವ ಅಧಿಕಾರಿ ವಿಷಯ ಸಂಬಂಧ ಪ್ರಯೋಜನಗಳೆಂಬ ಅನುಬಂಧ ಚತುಷ್ಟಯಗಳು<br><b>प्रयोगाः - </b>"सानुबन्धाः कथं न स्युः सपदां मे निरापदः"<br><b>उल्लेखाः - </b>रघु० १-६४<br><br>अनुबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂದೆ ಉಂಟಾಗುವ ಶುಭ ಮತ್ತು ಅಶುಭ ಫಲಗಳು<br><b>निष्पत्तिः - </b>अनु + बन्ध (बन्धने) - कर्म० "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>अनुबध्यतेऽनेन<br><b>प्रयोगाः - </b>"अनुबन्धमजानन्तः कर्मणामविचालिताः"<br><b>उल्लेखाः - </b>रामा०<br><br>अनुबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇತ್ ಸಂಜ್ಞೆಯುಳ್ಳ ವರ್ಣ<br><b>प्रयोगाः - </b>"रिपुराप पराभवाय मध्यं प्रकृतिप्रत्ययोरिवानुबन्धः"<br><b>उल्लेखाः - </b>किरा० १३-१९<br><br>अनुबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೋಷೋತ್ಪಾದನ /ದೋಷವನ್ನುಂಟುಮಾಡುವುದು<br><br>अनुबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಖ್ಯವಾದ ವಿಷಯದೊಡನೆ ಹೊಂದಿಕೊಮ್ಡು ಬರುವ ಅಪ್ರಧಾನ ವಿಷಯ<br><br>अनुबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರಣ /ಉದ್ದೇಶ<br><b>प्रयोगाः - </b>"अनुबन्धं परिज्ञाय देशकालौ च तत्त्वतः । सत्त्वापराधौ चालोक्य दण्डं दण्ड्येषु पातयेत् ॥"<br><b>उल्लेखाः - </b>मनु० ८-१२६<br><br>अनुबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಸರಣ /ಅನುಸರಿಸಿ ಬರುವಿಕೆ<br><b>प्रयोगाः - </b>"शान्तज्वरोऽपि शोध्यः स्यादनुबन्धभयान्नरः"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>अनुबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾಯಿ ತಂದೆಗಳ ನಡತೆಯನ್ನು ಅನುಸರಿಸುವವನು<br><br>अनुबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆರಂಭ /ಉಪಕ್ರಮ<br><br>अनुबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾತಪಿತ್ತಾದಿ ದೋಷಗಳ ಅಪ್ರಾಧಾನ್ಯ<br><br>अनुबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಶು<br><br>अनुबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೇಶ /ಚೂರು<br><b>विस्तारः - </b>"अनुबन्धः शिशौ दोषोत्पादे मुख्यानुयायिनि । विनश्वरे प्रकृत्यादौ प्रवृत्तस्यानुवर्तने" - मेदि० ।<br><br>

अनुबन्धन
अनुबन्धन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ /ಪರಂಪರೆ<br><b>निष्पत्तिः - </b>अनु + बन्ध (बन्धने) - "ल्युट्" (३-३-११५)<br><br>

अनुबन्धिन्
अनुबन्धिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧವುಳ್ಳ<br><br>अनुबन्धिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಿಸುವ<br><br>अनुबन्धिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೊತೆಗಾರ<br><b>निष्पत्तिः - </b>अनु + बन्ध (बन्धने) - "णिनिः" (३-२-७८)<br><br>अनुबन्धिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಿಶ್ರವಾದ /ಬೆರೆತಿರುವ<br><b>प्रयोगाः - </b>"नीलकण्ठकलकेकानुबन्धिना मन्द्रहुङ्कृतेन मामनुमन्यते"<br><b>उल्लेखाः - </b>मालती० ९<br><br>अनुबन्धिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೃದ್ಧಿ ಹೊಂದುವ /ಏಳಿಗೆ ಹೊಂದುವ /ಎಡೆಬಿಡದೆ ಬೆಳೆಯುವ<br><b>प्रयोगाः - </b>"प्रवालमासामनुबन्धि वीरुधाम्"<br><b>उल्लेखाः - </b>कुमा० ५-३४<br><br>

अनुबन्धिनी
अनुबन्धिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अनुबन्धिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><b>प्रयोगाः - </b>"अनयोः सरसरमणीयानुबन्धिनी स्त्रीजनकथा"<br><b>उल्लेखाः - </b>मालती० १<br><br>

अनुबन्धी
अनुबन्धी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೃಷ್ಣೆ /ಆಸೆ<br><br>अनुबन्धी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಕ್ಕಳಿಕೆ<br><b>निष्पत्तिः - </b>अनु + बन्ध (बन्धने) - कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>अनुबध्यते अतिश्वासेन व्याप्रियतेऽनेन<br><b>विस्तारः - </b>"अनुबन्धी तृषा हिक्का" - हेम० ।<br><br>

अनुबन्ध्य
अनुबन्ध्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಲ್ಲಲು ಬಂಧಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + बन्ध (बन्धने) - "ण्यत्" (३-१-१२४)<br><b>प्रयोगाः - </b>"गौरनुबन्ध्यः"<br><b>उल्लेखाः - </b>काव्यप्र०<br><br>

अनुबल
अनुबल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಗಾವಲು ಸೈನ್ಯ /ಸಹಾಯಕ ಸೈನ್ಯ<br><b>व्युत्पत्तिः - </b>अनु पश्चात् स्थितं बलम्<br><br>

अनुबोध
अनुबोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುನರಾಲೋಚನೆ /ಕಾರ್ಯವಾದ ನಂತರ ಮತ್ತೆ ಯೋಚಿಸುವುದು /ಸ್ಮರಣೆ /ನೆನಪು<br><br>अनुबोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸನೆಯು ಕಡಮೆಯಾದ ಚಂದನ ಮೊದಲಾದುವಕ್ಕೆ ಪುನಃ ವಾಸನೆ ಕಟ್ಟುವುದು /ಸುಗಂಧ ದ್ಯವ್ಯಗಳಿಂದ ಮತ್ತೆ ವಾಸನೆಯನ್ನುಂಟುಮಾಡುವುದು<br><b>निष्पत्तिः - </b>अनु + बन्ध (अवगमने) - भावे "घञ्" (३-३-१८)<br><br>

अनुभव
अनुभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿ /ಜ್ಞಾನ /ತಿಳುವಳಿಕೆ<br><b>निष्पत्तिः - </b>अनु + भू (सत्तायाम्) - "अप्" (३-३-५७)<br><br>अनुभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನಗಂಡದ್ದು /ಮನವರಿಕೆಯಾದುದು /ಮನಸ್ಸಿಗೆ ಚೆನ್ನಾಗಿ ತಿಳಿದಿರುವುದು<br><b>प्रयोगाः - </b>"अनुभवं वचसा सखि लुम्पसि"<br><b>उल्लेखाः - </b>नैष० ४-१०५<br><br>अनुभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಪ್ರಾಯ /ತಿಳುವಳಿಕೆ<br><br>अनुभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನದ ಫಲ /ಪರಿಣಾಮ<br><br>

अनुभाव
अनुभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಭಾವ /ಮಹಿಮೆ<br><b>निष्पत्तिः - </b>अनु + भू (सत्तायाम्) + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अनुभावयति<br><b>प्रयोगाः - </b>"तवानुभावोऽयमवेदि यन्मया निगूढतत्त्वं नयवर्त्म विद्विषाम्"<br><b>उल्लेखाः - </b>किरा० १-६<br><br>अनुभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನ ತೇಜಸ್ಸು /ಬೊಕ್ಕಸ ಮತ್ತು ದಂಡಿಸುವ ಅಧಿಕಾರ ಪ್ರಯುಕ್ತವಾದ ತೇಜಸ್ಸು<br><b>प्रयोगाः - </b>"अनुभावविशेषत्तु सेनापरिवृताविव"<br><b>उल्लेखाः - </b>रघु० १-३७<br><br>अनुभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಲಂಕಾರ ಶಾಸ್ತ್ರದಲ್ಲಿ ಹೇಳಿರುವ ರಸಸೂಚಕವಾದ ಮತ್ತು ಮನಸ್ಸಿನ ಅಭಿಪ್ರಾಯವನ್ನು ತಿಳಿಯಪಡಿಸುವ ದೃಷ್ಟಿ /ಭ್ರೂಭಂಗ ಇತ್ಯಾದಿ ಚೇಷ್ಟೆ<br><b>प्रयोगाः - </b>"भावं मनोगतं साक्षात् स्वगतं व्यञ्जयन्ति ये । तेऽनुभावा इति ख्याताः"<br><br>अनुभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿರಿಯರ ಬುದ್ಧಿನಿಶ್ಚಯ /ವೃದ್ಧರ ದೃಢ ಸಂಕಲ್ಪ<br><b>प्रयोगाः - </b>"अनुभाववत गुरुस्थिरत्वात्"<br><b>उल्लेखाः - </b>किरा० १३-१५<br><b>विस्तारः - </b>"अनुभावः प्रभावे स्यान्निश्चये भावसूचने" - मेदि० ।<br><br>

अनुभावक
अनुभावक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಪಡಿಸುವ /ಬೋಧಿಸುವ<br><b>निष्पत्तिः - </b>अनु + भू (सत्तायाम्) + णिच् - "ण्वुल्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अनुभावयति बोधयति<br><br>

अनुभावन
अनुभावन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿನಯ /ಅನುಭವವನ್ನು ಹೊರಪಡಿಸುವಿಕೆ<br><br>

अनुभाविन्
अनुभाविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನೋಗತವನ್ನು ಚೇಷ್ಟೆಗಳಿಂದ ತಿಳಿಯಪಡಿಸುವ<br><br>अनुभाविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಕ್ಷಾತ್ಕಾರವನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>अनु + भू (सत्तायाम्) + णिच् - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अनुभावयति<br><br>अनुभाविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕನಿಷ್ಠ /ಕಿರಿಯವನು<br><b>व्युत्पत्तिः - </b>अनु पश्चात् भवति<br><br>अनुभाविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಭಾವಶಾಲಿ /ಮಹಿಮೆಯುಳ್ಳ<br><br>अनुभाविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೃಢಸಂಕಲ್ಪವುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>अनुभावोऽस्यास्ति<br><br>अनुभाविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಕ್ಷಿ /ಎದುರಿಗೆ ನೋಡಿದವನು<br><b>निष्पत्तिः - </b>अनु + भू (सत्तायाम्) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अनुभवति<br><b>प्रयोगाः - </b>"अनुभावी तु यः कश्चित् कुर्यात्साक्ष्यं विवादिनाम्"<br><b>उल्लेखाः - </b>मनु० ८-६९<br><br>

अनुभाषण
अनुभाषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಳಿಕ ಮಾತನಾಡುವುದು /ಒಬ್ಬರ ಭಾಷಣಾನಂತರ ಭಾಷಣ ಮಾಡುವುದು<br><b>व्युत्पत्तिः - </b>अनु पश्चात् भाषणम्<br><br>

अनुभू
अनुभू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಭವ /ಜ್ಞಾನ<br><b>निष्पत्तिः - </b>अनु + भू (सत्तायाम्) - "क्विप्" (वा० ३-३-९४)<br><br>अनुभू<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಭವವುಳ್ಳ /ತಿಳುವಳಿಕೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>अनु + भू (सत्तायाम्) - कर्त०"क्विप्" (वा० ३-३-९४)<br><br>

अनुभूत
अनुभूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಂತರ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>अनु + भू (सत्तायाम्) - "क्तः" (३-४-७२)<br><br>अनुभूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಭವಿಸಲ್ಪಟ್ಟ /ತಿಳಿಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + भू (सत्तायाम्) - कर्म० "क्तः" (३-२-१०२)<br><br>

अनुभूति
अनुभूति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಭವ /ಜ್ಞಾನ<br><b>निष्पत्तिः - </b>अनु + भू (सत्तायाम्) - "क्तिन्" (३-३-९४)<br><br>

अनुमत
अनुमत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಪ್ಪಲ್ಪಟ್ಟ /ಸಮ್ಮತಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + मन (ज्ञाने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"सम्यग्विनीयानुमतो गृहाय"<br><b>उल्लेखाः - </b>रघु० ५-१०<br><br>अनुमत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"मखेष्वखिन्नोऽनुमतः पुरोधसा"<br><b>उल्लेखाः - </b>किरा० १-२२<br><br>

अनुमति
अनुमति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಪ್ಪಿಗೆ /ಸಮ್ಮತಿ<br><br>अनुमति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆ /ಜ್ಞಾನೆ<br><b>निष्पत्तिः - </b>अनु + मन (ज्ञाने) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"अनुमत्या मुनिमुख्यसम्मते च"<br><b>उल्लेखाः - </b>याद० १५-९५<br><br>अनुमति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಕಲೆಯು ಕಡಮೆಯಾದ ಚಂದ್ರನುಳ್ಳ ಶುಕ್ಲ ಚತುರ್ದಶಿಯಿಂದ ಕೂಡಿದ ಪೂರ್ಣಿಮಾ ತಿಥಿ<br><b>निष्पत्तिः - </b>अनु + मन (ज्ञाने) - "क्तिच्" (३-३-१७४)<br><b>व्युत्पत्तिः - </b>अनुमन्यते कलाहीनत्वेऽपि पूर्णिमाविहितयागादिकरणाय अनुज्ञायतेऽस्याम्<br><br>

अनुमतिपत्र
अनुमतिपत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಮೋದನೆಯ ಕಾಗದ /ಒಪ್ಪಿತದ ಕಾಗದ /ಕರಾರು ಪತ್ರ<br><br>

अनुमनन
अनुमनन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಮೋದನೆ /ಸಮ್ಮತಿ /ಒಪ್ಪಿಗೆ<br><br>

अनुमन्तृ
अनुमन्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಮೋದಿಸುವ /ಸಮ್ಮತಿಸುವ<br><br>अनुमन्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆ ಮಾಡುವ<br><b>निष्पत्तिः - </b>अनु + मन (ज्ञाने) - "तृच्" (३-१-१३३)<br><br>

अनुमन्त्री
अनुमन्त्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अनुमन्तृ ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अनुमन्त्रण
अनुमन्त्रण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂತ್ರೋಚ್ಚಾರಣ ಪೂರ್ವಕವಾದ ಸಂಸ್ಕಾರ<br><br>

अनुमरण
अनुमरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪತಿಯು ದೇಶಾಂತರದಲ್ಲಿ ಮೃತಿ ಹೊಂದಿದ ವಾರ್ತೆಯನ್ನು ಕೇಳಿ ಪತ್ನಿಯು ಆತನ ಪಾದುಕೆಗಳೊಡನೆ ಸೇರಿ ಪ್ರಾಣತ್ಯಾಗ ಮಾಡುವುದು<br><br>अनुमरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಹಗಮನ /ಪತಿಯ ಜೊತೆಯಲ್ಲಿ ಮರಣ ಹೊಂದುವುದು<br><br>

अनुमा
अनुमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಮಾನ /ತರ್ಕ /ಪರಾಮರ್ಶದಿಂದ ಉಮ್ತಾಗುವ ಜ್ಞಾನ /ಊಹೆ<br><b>निष्पत्तिः - </b>अनु + माङ् (माने) - "अङ्" (३-३-१०६)<br><br>

अनुमातृ
अनुमातृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತರ್ಕಿಸುವ /ಊಹಿಸುವ<br><b>निष्पत्तिः - </b>अनु + माङ् (माने) - "तृच्" (३-१-१३३)<br><b>प्रयोगाः - </b>"न हि करिणि दृष्टे चीत्कारेण तमनुमिमतेऽनुमातारः"<br><br>

अनुमान
अनुमान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಮಿತಿಗೆ ಕಾರಣ /ಊಹೆಗೆ ಕಾರಣ<br><b>निष्पत्तिः - </b>अनु + माङ् (माने) - "ल्युट्" (३-३-११५)<br><br>अनुमान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತರ್ಕ /ಊಹೆ<br><b>निष्पत्तिः - </b>अनु + माङ् (माने) - भावे "ल्युट्" (३-३-११५)<br><br>अनुमान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಮಿತಿ ಜ್ಞಾನಕ್ಕೆ ಕಾರಣವಾದ ಧೂಮ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>अनु + माङ् (माने) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>अनुमीयतेऽनेन<br><br>अनुमान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯುಕ್ತಿ<br><b>प्रयोगाः - </b>"अनुमानेन च चागमः क्षतः"<br><b>उल्लेखाः - </b>किरा० २-२८<br><br>अनुमान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾದೃಶ್ಯ /ಸಾಮ್ಯ<br><b>प्रयोगाः - </b>"आत्मनो हृदयानुमानेन प्रेक्षसे"<br><b>उल्लेखाः - </b>शाकु० ५<br><br>

अनुमापक
अनुमापक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತರ್ಕಕ್ಕೆ ಕಾರಣವಾದ /ಅನುಮಿತಿ ಜ್ಞಾನವನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>अनु + माङ् (माने) + णिच् - "ण्वुल्"(३-१-१३३)<br><b>व्युत्पत्तिः - </b>अनुमापयति<br><br>

अनुमापिका
अनुमापिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತರ್ಕಕ್ಕೆ ಕಾರಣವಾದ /ಅನುಮಿತಿ ಜ್ಞಾನವನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्"<br><br>

अनुमास
अनुमास<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಮಾಸದಲ್ಲೂ<br><b>निष्पत्तिः - </b>वीप्सायां अव्ययी०<br><br>

अनुमित
अनुमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಮಾನ ಮಾಡಲ್ಪಟ್ಟ /ಊಹಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + माङ् (माने) - "क्तः" (३-२-१०२)<br><br>

अनुमिति
अनुमिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಾಮರ್ಶದಿಂದುಂಟಾಗುವ ಜ್ಞಾನ /ಅನುಭವದ ನಾಲ್ಕು ಭೇದಗಳಲ್ಲೊಂದು<br><b>निष्पत्तिः - </b>अनु + माङ् (माने) - "क्तिन्" (३-३-९४)<br><br>

अनुमित्सा
अनुमित्सा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಊಹಿಸಲು ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>अनु + माङ् (माने) + सन् - "अः" (३-३-१०२)<br><b>व्युत्पत्तिः - </b>अनुमातुमिच्छा<br><br>

अनुमृत
अनुमृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೃತಿ ಹೊಂದಿದ /ದುಃಖದಿಂದ ಮರಣ ಹೊಂದಿದ<br><br>

अनुमेय
अनुमेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಹಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + माङ् (माने) - कर्म० "यत्" (३-१-९७)<br><b>व्युत्पत्तिः - </b>अनुमीयतेऽसौ<br><br>अनुमेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಹಿಸಲು ಯೋಗ್ಯವಾದ<br><b>प्रयोगाः - </b>"एतावता नन्वनुनेयशोभि काञ्चीगुणस्थानमनिन्दितायाः"<br><b>उल्लेखाः - </b>कुमा० १-३७<br><br>अनुमेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಹಿಸಲು ಶಕ್ಯವಾದ<br><br>

अनुमोद
अनुमोद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಪ್ಪಿಗೆ /ಸಮ್ಮತಿ<br><b>निष्पत्तिः - </b>अनु +मुद (हर्षे) - "घञ्"(३-३-१८)<br><br>

अनुमोदन
अनुमोदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಪ್ಪಿಗೆ /ಸಮ್ಮತಿ<br><b>निष्पत्तिः - </b>अनु +मुद (हर्षे) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"अनुमोदनजातमौलिकम्पैः"<br><b>उल्लेखाः - </b>याद० १५-७७<br><br>अनुमोदन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಪ್ಪುವ /ಸಮ್ಮತಿಸುವ<br><b>निष्पत्तिः - </b>अनु +मुद (हर्षे) - "ल्युः" (३-१-१३४)<br><br>

अनुमोदित
अनुमोदित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಪ್ಪಲ್ಪಟ್ಟ /ಸಮ್ಮತಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु +मुद (हर्षे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"श्रूयन्ते परिणीतास्ताः पितृभिश्चानुमोदिताः"<br><b>उल्लेखाः - </b>शाकु० ३-२०<br><br>

अनुयात
अनुयात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಿಸಿ ಹೋಗಿರುವ /ಅನುಸರಿಸಿ ಹೋಗಿರುವ<br><b>निष्पत्तिः - </b>अनु +या (प्रापणे) - "क्तः" (३-४-७२)<br><br>अनुयात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಿಸಲ್ಪಟ್ಟ /ಅನುಸರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु +या (प्रापणे) - कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आकाशगङ्गारतिरप्सरोभिर्वृतो मरुत्वाननुयातलीलः"<br><b>उल्लेखाः - </b>रघु० १६-७१<br><br>

अनुयातृ
अनुयातृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಕ /ಹಿಂದೆ ನಡೆಯುವ /ಅನುಸರಿಸಿ ಹೋಗುವ<br><b>निष्पत्तिः - </b>अनु +या (प्रापणे) - "तृच्" (३-१-१३३)<br><br>

अनुयात्र
अनुयात्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೃತ್ಯವರ್ಗ /ಅನುಯಾಯಿ ವರ್ಗ /ಪರಿವಾರ<br><b>व्युत्पत्तिः - </b>अनुगता यात्रा येन<br><b>प्रयोगाः - </b>"त्यक्तभोगस्य मे राजन् वने वन्येन जीवतः । किं कार्यमनुयात्रेण"<br><b>उल्लेखाः - </b>रामा०<br><br>अनुयात्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಕ /ಅನುಸರಿಸಿ ನಡೆತುವ<br><br>अनुयात्र<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಾತ್ರೆಯಲ್ಲಿ<br><b>निष्पत्तिः - </b>विभक्त्यर्थे अव्ययी०<br><b>व्युत्पत्तिः - </b>यात्रायाम्<br><br>अनुयात्र<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಾತ್ರೆಯ ಅನಂತರದಲ್ಲಿ<br><b>निष्पत्तिः - </b>अव्ययी०<br><b>व्युत्पत्तिः - </b>यात्रायाः पश्चात्<br><br>

अनुयात्रा
अनुयात्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಂತರದ ಯಾತ್ರೆ<br><b>व्युत्पत्तिः - </b>अनुगता यात्रा<br><br>

अनुयायिन्
अनुयायिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವಕ /ಪರಿಜನ /ಹಿಂಬಾಲಕ<br><b>निष्पत्तिः - </b>अनु +या (प्रापणे) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अनु पश्चात् याति<br><b>प्रयोगाः - </b>"न्यषेधि शेषोऽप्यनुयायिवर्गः"<br><b>उल्लेखाः - </b>रघु० २-४<br><br>अनुयायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸದೃಶ /ಸಮಾನವಾದ<br><br>अनुयायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸಿ ನಡೆಯುವ<br><br>

अनुयायिनी
अनुयायिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವಕಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अनुयास्यत्
अनुयास्यत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸಿ ಹೋಗಲಿರುವ /ಹಿಂಬಾಲಿಸಲಿರುವ<br><b>निष्पत्तिः - </b>अनु +या (प्रापणे) - लृटः "शानच्" (३-३-१४)<br><b>प्रयोगाः - </b>"अनुयास्यन्मुनितनयां सहसा विनयेन वारितप्रसरः"<br><b>उल्लेखाः - </b>शाकु० १-२५<br><br>

अनुयुक्त
अनुयुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ ಮಾಡಲ್ಪಟ್ಟ /ಕೇಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + युजिर् (योगे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"वयस्ययाऽभावविदानुयुक्ता"<br><b>उल्लेखाः - </b>याद० २-१७<br><br>

अनुयोक्तृ
अनुयोक्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೇಳುವವನು /ಪ್ರಶ್ನೆ ಮಾಡುವವನು<br><br>अनुयोक्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಳ ತೆಗೆದುಕೊಂಡು ಪಾಠ ಹೇಳುವವನು<br><b>निष्पत्तिः - </b>अनु + युजिर् (योगे) - "तृच्" (३-१-१३३)<br><br>

अनुयोक्त्री
अनुयोक्त्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अनुयोक्तृ ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अनुयोग
अनुयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ /ಕೇಳಿಕೆ<br><b>निष्पत्तिः - </b>अनु + युजिर् (योगे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"वार्तानुयोगमधुराक्षरया च वाचा"<br><b>उल्लेखाः - </b>रघु० १३-७१<br><br>

अनुयोगकृत्
अनुयोगकृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಚಾರ್ಯ /ಉಪಾಧ್ಯಾಯ /ಪ್ರಶ್ನೆಯ ವಿಷಯದ ಸಂಶಯವನ್ನು ಹೋಗಲಾಡಿಸುವವನು<br><b>निष्पत्तिः - </b>कृती (छेदने) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>अनुयोगं प्रश्नविषयसंशयं कृन्तति<br><br>अनुयोगकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ ಮಾಡುವ /ಕೇಳುವ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>अनुयोगं करोति<br><br>

अनुयोगिन्
अनुयोगिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ ಮಾಡುವವನು<br><br>अनुयोगिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧವುಳ್ಳ<br><br>

अनुयोजन
अनुयोजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ /ಕೇಳಿಕೆ<br><b>निष्पत्तिः - </b>अनु + युजिर् (योगे) - "ल्युट्" (३-३-११५)<br><br>अनुयोजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಂತರ ಸೇರಿಸುವಿಕೆ<br><b>व्युत्पत्तिः - </b>अनु पश्चात् योजनम्<br><br>

अनुयोज्य
अनुयोज्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಕ /ವಿಧೇಯ<br><b>प्रयोगाः - </b>"वासवानुयोज्यो दुष्यन्तः प्रणमति"<br><b>उल्लेखाः - </b>शाकु० ७<br><br>अनुयोज्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನಿಸಲು ಯೋಗ್ಯವಾದ<br><br>

अनुरक्त
अनुरक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುರಾಗದಿಂದ ಕೂಡಿದ /ಪ್ರೀತಿಯಿಂದ ಕೂಡಿದ<br><b>प्रयोगाः - </b>"अपि वृषलमनुरक्ताः प्रकृतयः"<br><b>उल्लेखाः - </b>मुद्रा० १<br><br>अनुरक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕೂಲ್ವಾದ<br><b>प्रयोगाः - </b>"गुणानुरक्तामनुरक्तसाधनः"<br><b>उल्लेखाः - </b>किरा० १-३१<br><br>अनुरक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಂಪಾಗಿರುವ /ಕೆಂಪಾಗಿ ಮಾಡಲ್ಪಟ್ಟ<br><br>

अनुरक्ति
अनुरक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುರಾಗ /ಪ್ರೀತಿ<br><b>निष्पत्तिः - </b>अनु +रञ्ज (रागे) - "क्तिन्" (३-३-९४)<br><br>

अनुरञ्जन
अनुरञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂತೋಷಪಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अनु +रञ्ज (रागे) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"युक्तः प्रजानामनुरञ्जने स्याः"<br><b>उल्लेखाः - </b>उ० रा० १-११<br><br>अनुरञ्जन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷಪಡುವ<br><b>निष्पत्तिः - </b>अनु +रञ्ज (रागे) - कर्त० "ल्युः" (३-१-१३४)<br><br>

अनुरञ्जित
अनुरञ्जित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷಪಡಿಸಲ್ಪಟ್ಟ /ಪ್ರೀತಿ ತೋರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु +रञ्ज (रागे) +णिच् - "क्तः" (३-२-१०२)<br><br>अनुरञ्जित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುನಃ ಬಣ್ಣ ಹಾಕಿಸಲ್ಪಟ್ಟ<br><br>

अनुरणन
अनुरणन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧ್ವನಿ /ಅನುಸರಿಸಿದ ಶಬ್ದ /ಗಂಟೆಯ ಶಬ್ದದಿಂದುಂಟಾದ ನಾದ ಸಂತಾನ<br><br>अनुरणन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಂಜನಾ ರೂಪವಾದ ಶಬ್ದದ ಒಂದು ಶಕ್ತಿ<br><b>निष्पत्तिः - </b>अनु + रण (शब्दे) - भावे "ल्युट्" (३-३-११५)<br><br>अनुरणन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಧ್ವನಿ<br><br>

अनुरत
अनुरत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುರಾಗವುಳ್ಳ /ಪ್ರೀತಿಯುಳ್ಳ<br><b>निष्पत्तिः - </b>अनु + रमु (क्रीडायाम्) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"धर्मानुरतमत्यर्थं शान्तं सूनृतभाषिणम्"<br><b>उल्लेखाः - </b>भा०<br><br>

अनुरति
अनुरति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುರಾಗ /ಪ್ರೀತಿ<br><b>निष्पत्तिः - </b>अनु + रमु (क्रीडायाम्) - "क्तिन्" (३-३-९४)<br><br>

अनुरस
अनुरस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರು ಶಬ್ದ /ಪ್ರತಿಧ್ವನಿ<br><br>अनुरस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಸವನ್ನು ಅನುಸರಿಸಿದ<br><b>व्युत्पत्तिः - </b>रसमनुगतः<br><br>

अनुरसित
अनुरसित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರು ಶಬ್ದ /ಪ್ರತಿಧ್ವನಿ<br><br>अनुरसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸಿ ಶಬ್ದ ಮಾಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"उद्ग्रीवैरनुरसितस्य पुष्करस्य"<br><b>उल्लेखाः - </b>माल० १-२१<br><br>

अनुराग
अनुराग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿ /ಸ್ನೇಹ<br><b>निष्पत्तिः - </b>अनु + रञ्ज (रागे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"प्रियानुरागस्य मनःसमुन्नतेः"<br><b>उल्लेखाः - </b>रघु० ३-१०<br><br>अनुराग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆರುಣ್ಯ /ಕೆಂಪು<br><b>प्रयोगाः - </b>"अनुरागवन्तमपि लोचनयोः"<br><b>उल्लेखाः - </b>माघ० ९-१०<br><br>अनुराग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಸಕ್ತಿ /ಶ್ರದ್ಧೆ<br><br>

अनुरागिन्
अनुरागिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಶ್ವಾಸವುಳ್ಳ /ಸ್ನೇಹವುಳ್ಳ<br><br>अनुरागिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರದ್ಧೆಯುಳ್ಳ /ಆಸಕ್ತಿಯುಳ್ಳ<br><b>निष्पत्तिः - </b>अनुराग - "इनिः" (५-२-११५)<br><br>

अनुरागिणी
अनुरागिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अनुरागिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><b>प्रयोगाः - </b>"वश्याञ्चाननुरागिणीम्"<br><b>उल्लेखाः - </b>सा० द०<br><br>

अनुरात्र
अनुरात्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಾತ್ರಿಯನ್ನು ಅನುಸರಿಸುವ<br><b>निष्पत्तिः - </b>"अच्" (५-४-८७)<br><b>व्युत्पत्तिः - </b>अनुगतो रात्रिम्<br><br>अनुरात्र<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ರಾತ್ರಿಯಲ್ಲಿ<br><br>अनुरात्र<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿ ರಾತ್ರಿಯಲ್ಲಿಯೂ<br><b>निष्पत्तिः - </b>वीप्सायां अव्ययी०<br><br>

अनुराधा
अनुराधा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುರಾಧಾ ನಕ್ಷತ್ರ<br><b>व्युत्पत्तिः - </b>अनुगता राधां विशाखायाम्<br><b>प्रयोगाः - </b>"आढ्यो विदेशवासी क्षुधालुरटनोऽनुराधासु"<br><b>उल्लेखाः - </b>बृह०<br><br>

अनुरूप
अनुरूप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸದೃಶವಾದ /ಸಮಾನವಾದ<br><br>अनुरूप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯೋಗ್ಯವಾದ /ಒಪ್ಪುವ /ಸರಿಯಾದ<br><b>व्युत्पत्तिः - </b>अनुगतो रूपम्<br><b>प्रयोगाः - </b>"अथानुरूपाभिनिवेशतोषिणा"<br><b>उल्लेखाः - </b>कुमा० ५-७<br><br>

अनुरोध
अनुरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಸರಣ /ಅನುವರ್ತನ /ಹೊಂದಿಕೊಂಡು ನಡೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>अनु + रुधिर् (आवरणे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"इत्याधारानुरोधात् त्रिपुरविजयिनः पातु वो दुःखनृत्यम्"<br><b>उल्लेखाः - </b>मुद्रा० १-२<br><br>अनुरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂತೋಷಪಡಿಸುವಿಕೆ /ತೃಪ್ತಿ ಪಡಿಸುವಿಕೆ<br><br>अनुरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಷ್ಟವನ್ನು ಪಡೆಯುವ ಆಸೆ<br><br>

अनुरोधन
अनुरोधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>अनुरोध ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

अनुरोधिन्
अनुरोधिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುವರ್ತಿಯಾದ /ಅನುಸರಿಸುವ<br><br>अनुरोधिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷಪಡಿಸುವ<br><b>निष्पत्तिः - </b>अनु + रुधिर् (आवरणे) - "णिनिः" (३-१-१३४)<br><br>

अनुरोधिनी
अनुरोधिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अनुरोधिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अनुलाप
अनुलाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುನಃ ಮಾತನಾಡುವುದು /ಪುನರುಕ್ತಿ<br><b>निष्पत्तिः - </b>अनु + लप (व्यक्तायां वाचि) - "घञ्" (३-३-१८)<br><br>

अनुलिप्त
अनुलिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಂಧ ಮೊದಲಾದುವುಗಳಿಂದ ಪೂಜಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + लिप (उपदेहे) - "क्तः" (३-२-१०२)<br><br>

अनुलेप
अनुलेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೇಪನ ಮಾಡುವಿಕೆ /ಬಳಿಯುವಿಕೆ /ಪೂಸುವುದು /ಹಚ್ಚುವುದು<br><b>निष्पत्तिः - </b>अनु + लिप (उपदेहे) - "घञ्" (३-३-१८)<br><b>व्युत्पत्तिः - </b>अनुलिप्यते<br><br>अनुलेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಧ /ಚಂದನ<br><br>अनुलेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಲಾಮು<br><b>निष्पत्तिः - </b>अनु + लिप (उपदेहे) - कर० "घञ्" (३-३-१२१)<br><br>

अनुलेपक
अनुलेपक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಚ್ಚುವ /ಬಳಿಯುವ<br><b>निष्पत्तिः - </b>अनु + लिप (उपदेहे) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>अनुलिम्पति<br><br>

अनुलेपिका
अनुलेपिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಚ್ಚುವ /ಬಳಿಯುವ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्"<br><br>

अनुलेपन
अनुलेपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಚ್ಚುವುದು /ಬಳಿಯುವುದು /ಪೂಸುವುದು<br><b>निष्पत्तिः - </b>अनु + लिप (उपदेहे) - भावे "ल्युट्" (३-३-११५)<br><br>अनुलेपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಧ /ಚಂದನ<br><b>निष्पत्तिः - </b>अनु + लिप (उपदेहे) - कर० "ल्युट्" (३-३-११७)<br><b>प्रयोगाः - </b>"अनुलेपनानि कुसुमान्यबलाः"<br><b>उल्लेखाः - </b>माघ० ९-२४<br><br>

अनुलेपिन्
अनुलेपिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಚ್ಚುವ /ಬಳಿಯುವ<br><b>निष्पत्तिः - </b>अनु + लिप (उपदेहे) - "णिनिः" (३-१-१३४)<br><br>

अनुलेपिनी
अनुलेपिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಚ್ಚುವ /ಬಳಿಯುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्"(४-१-५)<br><br>

अनुलोम
अनुलोम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಥಾಕ್ರಮವಾದ /ಅನುಕೂಲವಾದ /ನಿಯಮಕ್ಕೆ ಅನುಸಾರವಾದ<br><b>निष्पत्तिः - </b>"अच्" (५-४-८७)<br><b>व्युत्पत्तिः - </b>अनुगतं लोम<br><br>अनुलोम<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನುಕೂಲವಾಗಿ /ನಿಯಮಕ್ಕೆ ಅನುಸಾರವಾಗಿ /ಕ್ರಮವಾಗಿ<br><b>व्युत्पत्तिः - </b>लोम अनतिक्रम्य<br><br>

अनुलोमज
अनुलोमज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣಜಾತಿಯ ಪುರುಷನಿಗೆ ಮುಂದಿನ ಜಾತಿಯ ಹೆಂಗಸಿನಲ್ಲಿ ಹುಟ್ಟಿದವನು /ಬ್ರಾಹ್ಮಣಾದಿ ಜಾತಿಯವನಿಗೆ ಕ್ಷತ್ರಿಯಾದಿ ಜಾತಿಯ ಹೆಂಗಸಿನಲ್ಲಿ ಹುಟ್ಟಿದ ಮಿಶ್ರ ಜಾತಿಯವನು<br><br>

अनुलोमा
अनुलोमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣಾದಿ ಜಾತಿಯವನನ್ನು ಮದುವೆಯಾದ ಕ್ಷತ್ರಿಯಾದಿ ಮುಂದಿನ ಜಾತಿಯ ಹೆಂಗಸು<br><b>प्रयोगाः - </b>"सकामास्वनुलोमासु न दोषस्त्वन्यथा दमः"<br><b>उल्लेखाः - </b>याज्ञ० २-२८८<br><br>

अनुलोमार्थ
अनुलोमार्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕೂಲವಾದ ಅರ್ಥವುಳ್ಳ /ಅನುಕೂಲವಾದ ಅಭಿಪ್ರಾಯವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अनुलोमः अनुकूलोऽर्थो यस्य<br><b>प्रयोगाः - </b>"जडानप्यनुलोमार्थान् प्रवाचः कृतिनां गिरः"<br><b>उल्लेखाः - </b>माघ० २-२५<br><br>

अनुवंश
अनुवंश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶಾವಳಿಯ ಪಟ್ಟಿ /ಪರಂಪರೆಯ ಸೂಚಿ<br><b>व्युत्पत्तिः - </b>अनुसृतो वंशम्<br><br>अनुवंश<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಂಶದಲ್ಲಿ<br><b>निष्पत्तिः - </b>विभक्त्यर्थे अव्ययी०<br><b>व्युत्पत्तिः - </b>वंशे<br><br>

अनुवक्तृ
अनुवक्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸಿ ಹೇಳುವ /ಗುರುವು ಹೇಳಿದಂತೆ ಹೇಳುವ<br><b>निष्पत्तिः - </b>अनु + वच (परिभाषणे) - "तृच्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>अनु अनुरूपं वक्ति वदति<br><br>

अनुवक्त्री
अनुवक्त्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸಿ ಹೇಳುವ /ಗುರುವು ಹೇಳಿದಂತೆ ಹೇಳುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अनुवक्र
अनुवक्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಡೊಂಕಾದ /ಹೆಚ್ಚು ಬಗ್ಗಿರುವ<br><br>अनुवक्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ವಕ್ರವಾದ /ಮುಂದಿನ ರಾಶಿಯಿಂದ ಹಿಂದಿನ ರಾಶಿಗೆ ಕ್ರಮತಪ್ಪಿ ಬರುವ ಗ್ರಹ<br><br>

अनुवचन
अनुवचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸಿ ಹೇಳುವುದು /ಗುರುವು ಹೇಳಿದಂತೆ ಹೇಳುವುದು<br><br>

अनुवर्तन
अनुवर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸುವಿಕೆ<br><br>अनुवर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಿಸುವಿಕೆ<br><br>अनुवर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣ ಶಾಸ್ತ್ರದಲ್ಲಿ ಹಿಂದಿನ ಸೂತ್ರಗಳಿಂದ ಬೇಕಾದ ಪದಗಳನ್ನು ಮುಂದಿನ ಸೂತ್ರಗಳಿಗೆ ತೆಗೆದುಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>अनु + वृतु (वर्तने) - "ल्युट्" (३-३-११५)<br><br>

अनुवर्तिन्
अनुवर्तिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂದೆ ನಡೆಯುವ<br><br>अनुवर्तिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಿಸುವ /ಅನುಸರಿಸುವ<br><br>

अनुवर्तिनी
अनुवर्तिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अनुवर्तिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><b>प्रयोगाः - </b>"सशरीरा गता स्वर्गं भर्तारमनुवर्तिनी"<br><b>उल्लेखाः - </b>रामा०<br><br>

अनुवाक
अनुवाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇದದ ಭಾಗ /ವೇದದ ಅಧ್ಯಾಯ<br><br>अनुवाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇದಪಠನ<br><br>अनुवाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಾನವಿಲ್ಲದ ಋಗ್ವೇದದ ಅಥವಾ ಯರ್ಜುರ್ವೇದದ ಸಮೂಹ<br><br>

अनुवाक्या
अनुवाक्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಋತ್ವಿಕ್ಕುಗಳು ದೇವತೆಗಳನ್ನು ಕರೆಯುವ ಮಂತ್ರ<br><b>निष्पत्तिः - </b>अनु + वच (परिभाषणे) - "ण्यत्" (३-१-१२४)<br><b>व्युत्पत्तिः - </b>अनूच्यते<br><b>प्रयोगाः - </b>"शब्दितामनपशब्दमुच्चकैर्वाक्यलक्षणविदोऽनुवाक्यया"<br><b>उल्लेखाः - </b>माघ० १४-२०<br><br>

अनुवाचन
अनुवाचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುರುವು ತಾನು ಹೇಳಿದಂತೆ ಶಿಷ್ಯನಿಂದ ಹೇಳಿಸುವುದು<br><br>अनुवाचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞದಲ್ಲಿ ಅಧ್ವರ್ಯುಗಳು ಹೋತೃಗಳಿಂದ ಮಂತ್ರಗಳನ್ನು ಹೇಳಿಸುವುದು<br><b>निष्पत्तिः - </b>अनु + वच (परिभाषणे) णिच् - "ल्युट्" (३-३-११५)<br><br>

अनुवात
अनुवात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಷ್ಯನ ಕಡೆಯಿಂದ ಗುರುವಿನ ಕಡೆಗೆ ಬೀಸುವ ಗಾಳಿ /ಎದುರಾಗಿ ಬೀಸುವ ಗಾಳಿ<br><b>व्युत्पत्तिः - </b>अनुगतो वातः<br><b>प्रयोगाः - </b>"प्रतिवातेऽनुवाते च नासीत गुरुणा सह"<br><b>उल्लेखाः - </b>मनु० २-२०३<br><br>

अनुवाद
अनुवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಳಿದ ವಿಷಯವನ್ನು ಮತ್ತೆ ಹೇಳುವುದು<br><b>निष्पत्तिः - </b>अनु + वच (परिभाषणे) - "घञ्" (३-३-१८)<br><br>अनुवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಂಥದ ಪರಿವರ್ತನೆ /ಭಾಷಾಂತರ<br><br>अनुवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥವಾದದ ಒಂದು ಭೇದ /ಪ್ರಮಾಣಾಂತರದಿಂದ ಸಿದ್ಧವಾದ ವಿಷಯವನ್ನು ಪುನಃ ಹೇಳುವುದು<br><br>

अनुवादक
अनुवादक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುವಾದ ಮಾಡುವ /ವಿವರಿಸುವ /ಭಾಷಾಂತರ ಮಾಡುವ<br><b>निष्पत्तिः - </b>अनु + वच (परिभाषणे) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>अनुवदति<br><br>

अनुवादिन्
अनुवादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುವಾದ ಮಾಡುವ /ವಿವರಿಸುವ /ಭಾಷಾಂತರ ಮಾಡುವ<br><b>निष्पत्तिः - </b>अनु + वच (परिभाषणे) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अनुवदति<br><br>

अनुवादिनी
अनुवादिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುವಾದ ಮಾಡುವ /ವಿವರಿಸುವ /ಭಾಷಾಂತರ ಮಾಡುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अनुवाद्य
अनुवाद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುವಾದ ಮಾಡಲು ಅರ್ಹವಾದ /ಭಾಷಾಂತರಿಸಲು ಯೋಗ್ಯವಾದ /ವಿವರಿಸಲ್ಪಡುವ<br><br>अनुवाद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ದೇಶ್ಯ<br><b>निष्पत्तिः - </b>अनु + वच (परिभाषणे) - "ण्यत्" (३-१-१२४)<br><b>प्रयोगाः - </b>"अनुवाद्यमनुक्त्वैव न विधेयमुदीरयेत्"<br><br>

अनुवासन
अनुवासन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಿಚಕಾರಿ /ಔಷಧ ಪ್ರಯೋಗ ಮಾಡುವ ಕೊಳವೆ<br><b>निष्पत्तिः - </b>अनु + वस (निवासे) + णिच् - "ल्युट्" (३-१-११५)<br><b>प्रयोगाः - </b>"द्विधा बस्तिः परिज्ञेयो निरूहश्चानुवासनम् । कषायाद्यैर्निरूहः स्यात् स्नेहाद्यैरनुवासनम् ॥"<br><br>अनुवासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧೂಪ ಮೊದಲಾದುವುಗಳಿಂದ ವಾಸನೆ ಕಟ್ಟುವುದು<br><br>अनुवासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಿಚಕಾರಿಯ ಕೆಲಸ /ಪಿಚಕಾರಿಯಿಂದ ಔಷಧ ಪ್ರಯೋಗ /ಬಸ್ತಿಕ್ರಿಯೆ<br><b>निष्पत्तिः - </b>अनु + वस (निवासे) + णिच् - "ल्युट्" (३-१-११५)<br><br>

अनुवासित
अनुवासित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಸನೆ ಕೊಡಲ್ಪಟ್ಟ<br><br>अनुवासित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಿಚಕಾರಿಯಿಂದ ಔಷಧಗಳ ಪ್ರಯೋಗ ನಡೆಸಲ್ಪಟ್ಟ /ಬಸ್ತಿ ಕ್ರಿಯೆಯಿಂದ ಚಿಕಿತ್ಸೆ ನಡೆಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + वस (निवासे) + णिच् - "क्तः" (३-२-१०२)<br><br>

अनुविधान
अनुविधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಧೀನತೆ /ವಿಧೇಯತೆ /ಆಜ್ಞಾಪಾಲನೆ<br><br>अनुविधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಂತರದ ಕೆಲಸ<br><br>

अनुविधायिन्
अनुविधायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಧೇಯ /ನಮ್ರ<br><br>अनुविधायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಂತರ ಕೆಲಸ ಮಾಡುವ<br><br>अनुविधायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸದೃಶವಾದ /ಹೋಲುವ<br><b>निष्पत्तिः - </b>अनु + वि + डुधाञ् (धारणपोषणयोः) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अनुविधत्ते<br><b>प्रयोगाः - </b>"निजवधूश्वसितानुविधायिनि"<br><b>उल्लेखाः - </b>माघ० ६-२३<br><br>

अनुविधायिनी
अनुविधायिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अनुविधायिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अनुविद्ध
अनुविद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇರಿಯಲ್ಪಟ್ಟ /ತಿವಿಯಲ್ಪಟ್ಟ<br><br>अनुविद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಸರಿಸಲ್ಪಟ್ಟ /ವ್ಯಾಪಿಸಲ್ಪಟ್ಟ /ಸಂಬಂಧಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + व्यध (ताडने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"सरसिजमनुविद्धं शैवलेनापि रम्यम्" । "संलक्ष्यते विविधरत्नकरानुविद्धम्" ।<br><b>उल्लेखाः - </b>शाकु० १-१७, माघ० ४-४९<br><br>

अनुवृत्त
अनुवृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದುವರೆದ /ಹಿಂದಿನ ವಿಷಯಕ್ಕೆ ಸಂಬಂಧಿಸಿದಂತೆ ಮುಂದೆ ಸಾಗಿದ<br><br>अनुवृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವರ್ತುಲಾಕಾರವಾದ /ಗುಂಡಾಗಿರುವ<br><br>अनुवृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚರಿತ್ರೆಯನ್ನು ಅನುಸರಿಸಿದ<br><br>अनुवृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶೀಲಕ್ಕೆ ಹೊಂದಿಕೊಂಡಿರುವ<br><br>अनुवृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣಶಾಸ್ತ್ರದಲ್ಲಿ ಹಿಂದಿನ ಸೂತ್ರಗಳಿಂದ ಮುಂದಿನ ಸೂತ್ರಗಳಿಗೆ ತೆಗೆದುಕೊಳ್ಳಲ್ಪಟ್ಟ ಪದ ಮುಂತಾದುದು<br><br>अनुवृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸಿ ನಡೆಯುವ /ಅಧೀನವಾದ<br><br>

अनुवृत्ति
अनुवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಸರಣೆ /ಸೇವೆ<br><b>निष्पत्तिः - </b>अनु + वृतु (वर्तने) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"तवानुवृत्तिं न च कर्तुमुत्सहे"<br><b>उल्लेखाः - </b>कुमा० ५-६५<br><br>अनुवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂದಿನ ಸೂತ್ರಗಳಿಂದ ಮುಂದಿನ ಸೂತ್ರಾರ್ಥಕ್ಕೆ ಬೇಕಾದ ಪದಗಳನ್ನು ತೆಗೆದುಕೊಳ್ಳುವುದು<br><br>अनुवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಧೇಯತೆ /ಅನುಸರಿಸಿ ನಡೆಯುವಿಕೆ<br><b>प्रयोगाः - </b>"छन्दानुवृत्तिदुःसाध्याः"<br><b>उल्लेखाः - </b>माघ० २-१०५<br><br>अनुवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾದೃಶ್ಯ /ಸಾಮ್ಯ<br><br>अनुवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೆನಪು /ಜ್ಞಾಪಕ<br><br>

अनुवेध
अनुवेध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಸರ್ಗ /ಸಂಬಂಧ<br><b>निष्पत्तिः - </b>अनु + विध (विधाने) - "घञ्" (३-३-१८०<br><br>

अनुवेल
अनुवेल<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಕ್ಷಣದಲ್ಲಿಯೂ<br><b>व्युत्पत्तिः - </b>वेलायाम् वेलायाम्<br><b>प्रयोगाः - </b>"तस्यानुवेलं व्रजतोऽधिवेलम्"<br><b>उल्लेखाः - </b>माघ० ३-७९<br><br>अनुवेल<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ದಡದಲ್ಲಿ /ತೀರದಲ್ಲಿ<br><b>निष्पत्तिः - </b>विभक्त्यर्थे अव्ययी०<br><b>व्युत्पत्तिः - </b>वेलायाम्<br><br>

अनुवेल्लित
अनुवेल्लित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಘಾಯಕ್ಕೆ ಕಟ್ಟುವ ಪಟ್ಟ /ಘಾಯದ ಕಟ್ಟು<br><br>अनुवेल्लित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಕ್ರವಾದ /ಕ್ರಮವಾಗಿ ಬಗ್ಗಿರುವ<br><br>

अनुवेश
अनुवेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಿಸುವಿಕೆ /ಅನಂತರ ಪ್ರವೇಶಿಸುವುಸು<br><br>अनुवेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿರಿಯನಿಗಿಂತ ಕಿರಿಯವನು ಮುಂಚೆ ಮದುವೆಯಾಗುವುದು<br><b>प्रयोगाः - </b>"यवीयसोऽनुवेशो हि ज्येष्ठस्य विधिलोपकः"<br><b>उल्लेखाः - </b>भा०<br><br>अनुवेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೆರೆಮನೆಯ ಪಕ್ಕದ ಮನೆ<br><br>

अनुवेश्य
अनुवेश्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೆರೆಮನೆಯ ಪಕ್ಕದ ಮನೆಯಲ್ಲಿ ವಾಸ ಮಾಡುವವನು /ತನ್ನ ಮನೆಯಿಂದ ಮೂರನೆಯ ಮನೆಯಲ್ಲಿ ವಾಸಿಸುವವನು<br><b>निष्पत्तिः - </b>वेश - "यत्" (४-३-५४)<br><b>व्युत्पत्तिः - </b>अनुक्रमेण वेशमर्हति<br><br>

अनुव्याध
अनुव्याध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಸರ್ಗ /ಸಂಬಂಧ<br><b>निष्पत्तिः - </b>अनु + व्यध (ताडने) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"मुखामोदं मदिरया कृतानुव्याधमुद्वमन्"<br><b>उल्लेखाः - </b>माघ० २-२०<br><br>

अनुव्रजत्
अनुव्रजत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸಿ ಬರುವ /ಹಿಂಬಾಲಿಸುವ<br><b>निष्पत्तिः - </b>अनु + व्रज (गतौ) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"निवर्त्य सोऽनुव्रजतः कृतानतीन्"<br><b>उल्लेखाः - </b>माघ० १-११<br><br>

अनुव्रजन
अनुव्रजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಿಸುವಿಕೆ /ಅನಂತರ ಪ್ರವೇಶಿಸುವುಸು<br><b>निष्पत्तिः - </b>अनु + व्रज (गतौ) - "ल्युट्" (३-३-११५)<br><br>

अनुव्रज्या
अनुव्रज्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸಿ ನಡೆಯುವುದು /ಹಿಂಬಾಲಿಸುವಿಕೆ<br><br>अनुव्रज्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವೆ<br><b>निष्पत्तिः - </b>अनु + व्रज (गतौ) - "क्यप्"(३-३-९८)<br><b>प्रयोगाः - </b>"अनुव्रज्या च शुश्रूषा यावदध्ययनं गुरोः"<br><b>उल्लेखाः - </b>मनु० २-२४१<br><br>

अनुव्रत
अनुव्रत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುರಕ್ತ /ಅನುರಾಗವುಳ್ಳ /ಅನುಕೂಲ ಧರ್ಮಾಚರಣೆಯುಳ್ಳ<br><br>

अनुव्रता
अनुव्रता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುರಕ್ತ /ಅನುರಾಗವುಳ್ಳ /ಅನುಕೂಲ ಧರ್ಮಾಚರಣೆಯುಳ್ಳ<br><b>प्रयोगाः - </b>"अनुव्रतां राममतीव मैथिलीम्" । "अनुव्रता कामकलास्वधीतिनी"।<br><b>उल्लेखाः - </b>रामा०, याद० १४-७२<br><br>

अनुशय
अनुशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಶ್ಚಾತ್ತಾಪ<br><b>निष्पत्तिः - </b>अनु + शीङ् (स्वप्ने)- "अच्" (३-३-५६)<br><b>प्रयोगाः - </b>"ततः सपत्नापनयस्मरणानुशयस्फुरा"<br><b>उल्लेखाः - </b>माघ० २-१४<br><br>अनुशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪ /ಕ್ರೋಧ<br><b>प्रयोगाः - </b>"यस्मिन्नमुक्तानुशया सदैव"<br><b>उल्लेखाः - </b>मालती० ६-१<br><br>अनुशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ವೇಷ /ವೈರ<br><br>अनुशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಯಕ್ಕೆ ಕೊಂಡ ವಸ್ತುವಿನ ವಿಷಯದಲ್ಲಿ ಅಸಮಾಧಾನ /ಕ್ರಯದಲ್ಲಿ ಮೋಸ ನಡೆದಿರುವುದೆಂದು ಪಶ್ಚಾತ್ತಾಪ<br><b>प्रयोगाः - </b>"क्रीत्वा मूल्येन यः पण्यं क्रेता न बहु मन्यते । क्रीतानुशय इत्येतद्विवादपदमुच्यते ॥"<br><br>अनुशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಗಪ್ರಾಪ್ತಿಗಾಗಿ ಮಾಡಿದ ಪುಣ್ಯಕರ್ಮದ ಶೇಷ /ಸ್ವರ್ಗಾನುಭವವಾದ ನಂತರ ಭೂಮಿಗೆ ಪತನವಾಗುವ ಸಮಯದಲ್ಲಿ ಪುಣ್ಯಫಲದ ಉಳಿಕೆ<br><b>प्रयोगाः - </b>"कृतात्ययेऽनुशयवान् दृष्टस्मृतिभ्यां यथेतमनेयं च"<br><b>उल्लेखाः - </b>ब्र० सू० ३-१<br><br>

अनुशयान
अनुशयान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಶ್ಚಾತ್ತಾಪ ಪಡುವ<br><br>अनुशयान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದ್ವೇಷಿಸುವ<br><b>निष्पत्तिः - </b>अनु + शीङ् (स्वप्ने)- "शानच्" (३-२-१२४)<br><br>

अनुशयाना
अनुशयाना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಕೀಯ ನಾಯಿಕೆಯ ಒಂದು ಭೇದ<br><br>

अनुशयिन्
अनुशयिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಶ್ಚಾತ್ತಾಪವುಳ್ಳ<br><br>अनुशयिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದ್ವೇಷವುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>अनुशयोऽस्यास्ति<br><br>

अनुशासक
अनुशासक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಕ್ಷಕ /ದಂಡವನ್ನು ವಿಧಿಸುವವನು<br><br>अनुशासक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಜ್ಞೆ ಮಾಡುವವನು<br><br>अनुशासक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಸುವವನು<br><br>अनुशासक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಳುವವನು<br><b>निष्पत्तिः - </b>अनु + शासु (अनुशिष्टौ) - "ण्वुल्" (३-१-१३३)<br><br>

अनुशासत्
अनुशासत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಳುವ /ದೊರೆತನ ಮಾಡುವ<br><b>निष्पत्तिः - </b>अनु + शासु (अनुशिष्टौ) - "शतृ" (३-२-१२४)<br><br>अनुशासत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಸುವ /ಉಪದೇಶ ಮಾಡುವ<br><b>प्रयोगाः - </b>"अनुशासतमित्यनाकुलं नयवर्त्माकुलमर्जुनाग्रजम्"<br><b>उल्लेखाः - </b>किरा० २-५४<br><br>अनुशासत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಕ್ಷಿಸುವ /ದಂಡಿಸುವ<br><br>अनुशासत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಜ್ಞೆ ಮಾಡುವ<br><br>

अनुशासन
अनुशासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪದೇಶ /ತಿಳುವಳಿಕೆ ಕೊಡುವುದು<br><br>अनुशासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಲಹೆ ಕೊಡುವುದು<br><b>निष्पत्तिः - </b>अनु + शासु (अनुशिष्टौ) - भावे "ल्युट्" (३-३-११५)<br><b>व्युत्पत्तिः - </b>अनुशिष्यते<br><b>प्रयोगाः - </b>"भवादृशेषु प्रमदाजनोदितं भवत्यधिक्षेप इवानुशासनम्"<br><b>उल्लेखाः - </b>किरा० १-२८<br><br>अनुशासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಜ್ಞೆ /ಅಪ್ಪಣೆ<br><br>अनुशासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಧಿ ಶಾಸ್ತ್ರ /ನಿಯಮಶಾಸ್ತ್ರ /ಅಸಾಧುವಿಷಯಗಳಿಂದ ಸಾಧುವಿಷಯಗಳನ್ನು ವಿಮರ್ಶಿಸಿ ಹೇಳುವುದು<br><b>निष्पत्तिः - </b>अनु + शासु (अनुशिष्टौ) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>अनुशिष्यतेऽनेन<br><b>प्रयोगाः - </b>"अथ शब्दानुशासनम्" । "नामलिङ्गानुशासनम्" ।<br><br>अनुशासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಕ್ಷೆ<br><br>

अनुशासितृ
अनुशासितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪದೇಶಕ /ತಿಳುವಳಿಕೆ ಕೊಡುವವನು<br><br>अनुशासितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಕ್ಷಕ /ದಂಡಿಸುವವನು<br><b>निष्पत्तिः - </b>अनु + शासु (अनुशिष्टौ) - "तृच्" (३-१-१३३)<br><br>

अनुशासित्री
अनुशासित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अनुशासितृ ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अनुशासिन्
अनुशासिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪದೇಶಕ /ತಿಳುವಳಿಕೆ ಕೊಡುವವನು<br><br>अनुशासिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಕ್ಷಕ /ದಂಡಿಸುವವನು<br><b>निष्पत्तिः - </b>अनु + शासु (अनुशिष्टौ) -"णिनिः" (३-२-७८)<br><br>

अनुशास्तृ
अनुशास्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪದೇಶಕ /ತಿಳುವಳಿಕೆ ಕೊಡುವವನು<br><br>अनुशास्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಕ್ಷಕ /ದಂಡಿಸುವವನು<br><br>

अनुशास्त्री
अनुशास्त्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अनुशास्तृ ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अनुशिष्ट
अनुशिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪದೇಶ ಮಾಡಲ್ಪಟ್ಟ /ತಿಳುವಳಿಕೆಯುಂಟುಮಾಡಲ್ಪಟ್ಟ<br><br>अनुशिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಂಡಿಸಲ್ಪಟ್ಟ /ಶಿಕ್ಷಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + शासु (अनुशिष्टौ) - "क्तः" (३-२-१०२)<br><br>

अनुशिष्टि
अनुशिष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಜ್ಞೆ /ಅಪ್ಪಣೆ<br><br>अनुशिष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪದೇಶ /ಶಿಕ್ಷಣ<br><b>निष्पत्तिः - </b>अनु + शासु (अनुशिष्टौ) - "क्तिन्" (३-३-९४)<br><br>

अनुशीलन
अनुशीलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಡೆಬಿಡದೆ ಅಭ್ಯಾಸ /ಸತತವಾದ ಕಾರ್ಯಾಚರಣೆ<br><b>व्युत्पत्तिः - </b>अनुक्षणं शीलनम्<br><b>प्रयोगाः - </b>"गुरुस्थिराण्युत्तमवंशजत्वात् विज्ञातसाराण्यनुशीलनेन"<br><b>उल्लेखाः - </b>किरा० १६-२८<br><br>अनुशीलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಚಾರಣೆ /ತನಿಖೆ<br><br>

अनुशोक
अनुशोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುಃಖ /ವ್ಯಸನ<br><br>अनुशोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸಿ ದುಃಖಿಸುವುದು /ಅನಂತರ ದುಃಖಿಸುವುದು<br><b>निष्पत्तिः - </b>अनु + शुच (शोके) - "घञ्" (३-३-१८)<br><br>

अनुशोचन
अनुशोचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದುಃಖ<br><br>अनुशोचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಶ್ಚಾತ್ತಾಪ<br><br>

अनुश्रव
अनुश्रव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇದ<br><b>निष्पत्तिः - </b>अनु + श्रु (श्रवणे) - "अप्"(३-३-५७)<br><b>प्रयोगाः - </b>"अनुश्रवणामवतंसभूतम्"<br><b>उल्लेखाः - </b>याद० ४-५४<br><br>

अनुषक्त
अनुषक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧಿಸಿದ /ಸೇರಿರುವ<br><b>निष्पत्तिः - </b>अनु + षञ्ज (सङ्गे) - "क्तः" (३-४-७२)<br><br>

अनुषङ्ग
अनुषङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ /ಹೊಂದಿಕೊಮ್ಡಿರುವಿಕೆ /ಸೇರಿರುವಿಕೆ /ಅಂಟಿಕೊಂಡಿರುವಿಕೆ<br><br>अनुषङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಟ್ಟುಗೂಡುವಿಕೆ /ಮಿಶ್ರಣ /ಬೆರಕೆ<br><br>अनुषङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಕ್ಯಾಂತರದಲ್ಲಿರುವ ಪದಗಳೊಡನೆ ಸಂಬಂಧ<br><br>अनुषङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಸಂಗ /ಪ್ರಸಕ್ತಿ /ಹಿಂದಿನ ವಿಷಯದೊಡನೆ ಸಂಬಂಧ<br><br>अनुषङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಕಾರ್ಯಕ್ಕೆ ಯತ್ನಿಸಿದಾಗ ಆಗುವ ಮತ್ತೊಂದು ಕಾರ್ಯಸಿದ್ಧಿ<br><b>प्रयोगाः - </b>"नित्यक्रियां तथा चान्ये ह्यनुषङ्गफलां श्रुतिम्"<br><br>

अनुषङ्गिन्
अनुषङ्गिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧವುಳ್ಳ /ಅಂಟಿಕೊಂಡಿರುವ /ಸೇರಿಕೊಂಡಿರುವ<br><b>निष्पत्तिः - </b>अनु + षञ्ज (सङ्गे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"महीयसां महति दिगन्तदन्तिनामनीकजे रजसि मुखानुषङ्गिनि"<br><b>उल्लेखाः - </b>माघ० १७-५७<br><br>अनुषङ्गिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಪಿಸುವ /ಹರಡುವ<br><b>निष्पत्तिः - </b>अनुषङ्ग - "इनिः" (५-२-११५)<br><b>प्रयोगाः - </b>"शमिनोऽपि तस्य नवसङ्गमने विभुतानुषङ्गि भयमेति जनः"<br><b>उल्लेखाः - </b>किरा० ६-३५<br><br>

अनुषिक्त
अनुषिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವಾಗಲೂ ಸಿಂಪಡಿಸಲ್ಪಟ್ಟ<br><br>अनुषिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಂತರ ಸೇಚನೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु +षिच (क्षरणे) - "क्तः" (३-२-१०२)<br><br>

अनुषेक
अनुषेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುನಃ ಚಿಮುಕಿಸುವುದು<br><br>

अनुष्टुभ्
अनुष्टुभ्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸರಸ್ವತಿ<br><br>अनुष्टुभ्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾತು<br><br>अनुष्टुभ्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಛಂದಸ್ಸು<br><b>निष्पत्तिः - </b>अनु + स्तुन्भु (निष्कोषणे) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>अनु निरन्तरं स्तुभ्नोति<br><br>

अनुष्ठ
अनुष्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ರಮವಾಗಿ ನಿಲ್ಲುವ<br><b>निष्पत्तिः - </b>अनु + ष्ठा (गतिनिवृत्तौ) - "कः" (३-१-१३६)<br><b>व्युत्पत्तिः - </b>अनुक्रमेण तिष्ठति<br><br>

अनुष्ठा
अनुष्ठा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಷ್ಠಾನ /ಆಚರಣೆ<br><b>निष्पत्तिः - </b>अनु + ष्ठा (गतिनिवृत्तौ) - "अङ्" (३-३-१०६)<br><br>

अनुष्ठातृ
अनुष्ठातृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಚರಿಸುವವನು<br><b>निष्पत्तिः - </b>अनु + ष्ठा (गतिनिवृत्तौ) - "तृच्" (३-१-१३३)<br><br>

अनुष्ठात्री
अनुष्ठात्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಚರಿಸುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अनुष्ठान
अनुष्ठान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಚರಣೆ /ಮಾಡುವುದು /ನೆರವೇರಿಸುವುದು /ಕಾರ್ಯನಿರ್ವಾಹ<br><b>निष्पत्तिः - </b>अनु + ष्ठा (गतिनिवृत्तौ) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"उपरुध्यते तपोऽनुष्ठान्म्"<br><b>उल्लेखाः - </b>शाकु० ४<br><br>

अनुष्ठित
अनुष्ठित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಚರಿಸಲ್ಪಟ್ಟ /ಶಾಸ್ತ್ರ ರೀತಿಯಿಂದ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + ष्ठा (गतिनिवृत्तौ) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"विक्रियायै न कल्पन्ते सम्बन्धाः सदनुष्ठिताः"<br><b>उल्लेखाः - </b>कुमा० ६-२९<br><br>

अनुष्ठेय
अनुष्ठेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಚರಿಸಲ್ಪಡಬೇಕಾದ /ನಿರ್ವಹಿಸಲ್ಪಡಬೇಕಾದ<br><b>निष्पत्तिः - </b>अनु + ष्ठा (गतिनिवृत्तौ) - कर्म० "यत्" (३-१-९७)<br><b>प्रयोगाः - </b>"अस्माभिर्यदनुष्ठेयं गन्धर्वैस्तदनुष्ठितम्"<br><b>उल्लेखाः - </b>भा० वन० २४३-१७<br><br>

अनुष्ण
अनुष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೀತಸ್ಪರ್ಶ<br><br>अनुष्ण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪಲ /ಕನ್ನೈದಿಲೆ /ನೀಲ ಕಮಲ<br><br>अनुष्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಸಿಯಲ್ಲದ /ಶೀತಲವಾದ<br><b>व्युत्पत्तिः - </b>न उष्णः<br><b>प्रयोगाः - </b>"अनुष्णबाष्पोदयमन्थराक्षीम्"<br><b>उल्लेखाः - </b>याद० १३-२४<br><br>अनुष्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಲಸ /ಸೋಮಾರಿ /ಕಾರ್ಯಾಸಮರ್ಥ<br><b>निष्पत्तिः - </b>अन्यार्थे न० त० ।<br><b>व्युत्पत्तिः - </b>उष्णो दक्षः । तदन्यः<br><b>विस्तारः - </b>"उष्णो ग्रीष्मे पुमान् दक्षाशीतयोरन्यलिङ्गकः" - मेदि० ।<br><br>

अनुष्णगु
अनुष्णगु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>व्युत्पत्तिः - </b>अनुष्णाः शीतलाः गावः किरणाः यस्य<br><br>

अनुसंवत्सर
अनुसंवत्सर<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವರ್ಷದಲ್ಲಿ /ಸಂವತ್ಸರದಲ್ಲಿ<br><b>निष्पत्तिः - </b>विभक्त्यर्थे अव्ययी०<br><br>अनुसंवत्सर<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಸಂವತ್ಸರದಲ್ಲಿಯೂ<br><b>निष्पत्तिः - </b>वीप्सायां अव्ययी०<br><br>

अनुसंवरण
अनुसंवरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಮವಾಗಿ ಮುಚ್ಚಿಡುವುದು /ಮರೆ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>अनु + सम् + वृञ् (वरणे) - "ल्युट्" (३-३-११५)<br><br>

अनुसंहित
अनुसंहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುನಃ ವಿಚಾರಣೆ ಮಾಡಲ್ಪಟ್ಟ /ಮೇಲ್ತನಿಖೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + सम् + डुधाञ् (धारणपोषणयोः) - "क्तः" (३-२-१०२)<br><br>

अनुसन्तति
अनुसन्तति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಡೆಬಿಡದೆ ಮುಂದುವರೆಯುವಿಕೆ /ಅನುಸ್ಯೂತವಾಗಿ ನಡೆದುಕೊಂಡು ಬರುವಿಕೆ /ವಿಚ್ಛೇದವಿಲ್ಲದಿರುವಿಕೆ<br><br>

अनुसन्धातृ
अनुसन्धातृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಚಾರಣೆ ನಡೆಸುವ /ತನಿಖೆ ಮಾಡುವ /ಶೋಧಿಸುವ<br><br>अनुसन्धातृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧ್ಯಾನಿಸುವ /ಚಿಂತಿಸುವ /ದೀರ್ಘಾಲೋಚನೆ ಮಾಡುವ<br><br>

अनुसन्धान
अनुसन्धान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತನಿಖೆ /ವಿಚಾರಣೆ /ಶೋಧನೆ<br><br>अनुसन्धान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಂತಿಸುವುದು /ಧ್ಯಾನ<br><b>निष्पत्तिः - </b>अनु + सम् + डुधाञ् (धारणपोषणयोः) - भावे "ल्युट्" (३-३-११५)<br><br>

अनुसन्धानिन्
अनुसन्धानिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಂತಿಸುವ<br><br>अनुसन्धानिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನಿಖೆ ನಡೆಸುವ<br><br>

अनुसन्धेय
अनुसन्धेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಸಂಧಾನ ಮಾಡಲು ಯೋಗ್ಯವಾದ<br><br>अनुसन्धेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಸಂಧಾನ ಮಾಡಲ್ಪಡಬೇಕಾದ<br><b>निष्पत्तिः - </b>अनु + सम् + डुधाञ् (धारणपोषणयोः) - "यत्" (३-१-९७)<br><b>व्युत्पत्तिः - </b>अनुसन्धातुमर्हं शक्यं वा<br><br>

अनुसर
अनुसर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಚರ /ಸೇವಕ<br><br>अनुसर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೊತೆಯಲ್ಲಿ ಸಂಚರಿಸುವ /ಸಂಗಡಿಗ<br><b>निष्पत्तिः - </b>अनु + सृ (गतौ) -"टः" बाहु० ।<br><br>अनुसर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಬಲಕ /ಅನುಸರಿಸಿ ನಡೆಯುವ<br><br>

अनुसरी
अनुसरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अनुसर ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अनुसरण
अनुसरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಿಸುವಿಕೆ /ಅನುಸರಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अनु + सृ (गतौ) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"इन्दोर्दैन्यं त्वदनुसरणक्लिष्टकान्तेर्बिभर्ति"<br><b>उल्लेखाः - </b>मेघ० २-२१<br><br>

अनुसार
अनुसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಸರಣ /ಅನುಸರಿಸಿ ನಡೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>अनु + सृ (गतौ) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"धर्मशास्त्रानुसारेण क्रोधलोभविवर्जितः"<br><b>उल्लेखाः - </b>याज्ञ० २-१<br><br>

अनुसारणा
अनुसारणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸಿ ಓಡುವುದು /ಬೆನ್ನಟುವುದು<br><br>अनुसारणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂದೆ ನಡೆಯುವುದು<br><b>निष्पत्तिः - </b>अनु + सृ (गतौ) + णिच् - "युच्" (३-३-१०७)<br><br>

अनुसारिन्
अनुसारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆನ್ನಟ್ಟುವ<br><b>निष्पत्तिः - </b>अनु + सृ (गतौ) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अनुसरति पश्चात् गच्छति<br><b>प्रयोगाः - </b>"मृगानुसारिणं साक्षात् पश्यामीव पिनाकिनम्"<br><b>उल्लेखाः - </b>शाकु० १-६<br><br>

अनुसृत
अनुसृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + सृ (गतौ) - "क्तः" (३-२-१०२)<br><br>

अनुसृति
अनुसृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಸರಣ /ಹಿಂಬಾಲಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अनु + सृ (गतौ) - "क्तिन्" (३-३-९४)<br><br>अनुसृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವೈರಿಣಿ /ವ್ಯಭಿಚಾರಿಣಿ<br><b>निष्पत्तिः - </b>अनु + सृ (गतौ) - "क्तिच्" (३-३-१७४)<br><b>व्युत्पत्तिः - </b>अनुसरति कुलान्तरम्<br><br>

अनुसृष्ट
अनुसृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + सृज (विसर्गे)- "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अनुसृष्टस्तदा काकः जगाम विविधां गतिम्"<br><b>उल्लेखाः - </b>रामा०<br><br>

अनुसृष्टि
अनुसृष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಮವಾದ ಸೃಷ್ಟಿ<br><b>निष्पत्तिः - </b>अनु + सृज (विसर्गे)- "क्तिन्" (३-३-९४)<br><br>अनुसृष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿವಂತೆಯಾದ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>अनु + सृज (विसर्गे)- "क्तिच्" (३-३-१७४)<br><br>

अनुसैन्य
अनुसैन्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಗಾವಲು ಸೈನ್ಯ<br><br>

अनुस्तरण
अनुस्तरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊದಿಸುವುದು<br><b>निष्पत्तिः - </b>अनु + स्तृञ् (आच्छादने) - भावे "ल्युट्" (३-३-११५)<br><br>अनुस्तरण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊದಿಸುವ<br><b>निष्पत्तिः - </b>अनु + स्तृञ् (आच्छादने) - कर० "ल्युट्" (३-३-११७)<br><br>

अनुस्तरणी
अनुस्तरणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೈತರಣೀ ನದಿಯನ್ನು ದಾಟಿಸುವ ಹಸು<br><br>

अनुस्मरण
अनुस्मरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಮೃತಿ ಯನೆನಪು<br><br>अनुस्मरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾಪಕ<br><br>अनुस्मरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೆ ಸ್ಮರಿಸುವುದು<br><b>निष्पत्तिः - </b>अनु + स्मृ (चिन्तायाम्) - "ल्युट्" (३-३-११५)<br><br>

अनुस्मृत
अनुस्मृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೆನೆಯಲ್ಪಟ್ಟ /ಜ್ಞಾಪಿಸಿ ಕೊಳ್ಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + स्मृ (चिन्तायाम्) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"कथाप्रसङ्गेन जनैरुदाहृतान् अनुस्मृताखण्डलसूनुविक्रमः"<br><b>उल्लेखाः - </b>किरा० १-२४<br><br>

अनुस्मृति
अनुस्मृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಮರಣೆ /ನೆನಪು<br><b>निष्पत्तिः - </b>अनु + स्मृ (चिन्तायाम्) - "क्तिन्" (३-३-९४)<br><br>

अनुस्यूत
अनुस्यूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಟ್ಟಿಗೆ ಸೇರಿಕೊಮ್ಡಿರುವ /ಎಡೆಬಿಡದ ಸಂಬಂಧವುಳ್ಳ<br><br>अनुस्यूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಟ್ಟಿಗೆ ನೇಯಲ್ಪಟ್ಟ /ಸೇರಿದಂತೆ ಹೊಲಿಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + षिवु (तन्तुसन्ताने) - "क्तः" (३-२-१०२)<br><br>

अनुस्रुत
अनुस्रुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುರಿಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + स्रु (गतौ) - कर्म० "क्तः" (३-२-१०२)<br><br>अनुस्रुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುರಿದು ಹೋದ /ಸ್ರವಿಸಿದ<br><b>निष्पत्तिः - </b>अनु + स्रु (गतौ) - कर्त० "क्तः" (३-४-७२)<br><br>

अनुस्वान
अनुस्वान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುರೂಪವಾದ ಶಬ್ದ /ಒಪ್ಪುವ ಧ್ವನಿ<br><br>अनुस्वान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಧ್ವನಿ /ಎದುರು ಶಬ್ದ<br><b>व्युत्पत्तिः - </b>अनुरूपः अनुसृतो वा स्वानः<br><br>

अनुस्वार
अनुस्वार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಗಿನ ಸಹಾಯದಿಂದ ಸ್ವರವರ್ನದ ನಂತರವೇ ಉಚ್ಚರಿಸಬಹುದಾದ ವರ್ಣ<br><br>

अनुहार
अनुहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಕರಣ<br><br>अनुहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೋಲಿಕೆ /ಸಾದೃಶ್ಯ<br><b>निष्पत्तिः - </b>अनु + हृञ् (हरणे) - "घञ्" (३-३-१८)<br><br>अनुहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನಂತರ ಒಯ್ಯುವುದು<br><br>

अनुहार्य
अनुहार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಲಿಸಲು ಯೋಗ್ಯವಾದ /ಹೋಲಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अनु + हृञ् (हरणे) - "ण्यत्" (३-१-१२४)<br><br>

अनूक
अनूक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂದಿನ ಜನ್ಮ<br><br>अनूक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆನ್ನು ಮೂಳೆ<br><br>अनूक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಲ /ವಂಶ<br><br>अनूक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶೀಲ /ಸ್ವಭಾವ<br><b>निष्पत्तिः - </b>अनु + कै (शब्दे) - "कः" (३-१-१३६)<br><b>व्युत्पत्तिः - </b>अनुकायति<br><b>विस्तारः - </b>"अनूकं तु कुले शीले पुंसि स्याद्गतजन्मनि" - मेदि० ।<br><br>अनूक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಯಜ್ಞದ ಪಾತ್ರೆ<br><br>

अनूचान
अनूचान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಂಗವೇದಾಧ್ಯಯನ ಮಾಡಿದವನು /ಗುರುವಿನಿಂದ ಷಡಂಗಸಹಿತ ವೇದವನ್ನು ಕಲಿತವನು<br><b>निष्पत्तिः - </b>अनु +वच (परिभाषणे) - "कानच्" (३-२-१०९) निपा० ।<br><b>व्युत्पत्तिः - </b>अन्ववोचत्<br><b>प्रयोगाः - </b>"इदमूचुरनूचानाः प्रीतिकण्टकितत्वचः"<br><b>उल्लेखाः - </b>कुमा० ६-१५<br><br>अनूचान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿನೀತ /ವಿಧೇಯ /ಸಭ್ಯತೆಯಿಂದ ಕೂಡಿದ<br><b>विस्तारः - </b>"अनूचानः साङ्गवेदकोविदे विनयान्विते" - हेम० ।<br><br>

अनूचीन
अनूचीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ರಮವಾದ /ಅನುಲೋಮವಾದ<br><b>विस्तारः - </b>"अनुलोममनूचीनम्" - वैज० ।<br><br>

अनूच्य
अनूच्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಚದ ಎರಡು ಪಾರ್ಶ್ವಗಳಲ್ಲಿಯೂ ಇರುವ ಹಲಗೆ<br><b>प्रयोगाः - </b>"दक्षिणोत्तरयोर्दीर्घे खट्वाङ्गे अनूच्यसञ्ज्ञे"<br><b>उल्लेखाः - </b>शङ्कराचार्याः<br><br>अनूच्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಚಾರ್ಯರ ಉಚ್ಚಾರಣೆಯನ್ನನುಸರಿಸಿ ಹೇಳುವ ಪಾಠ ಭಾಗ<br><br>

अनूढ
अनूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಿವಾಹಿತ /ಮದುವೆಯಾಗದ<br><br>अनूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಹಿಸಲ್ಪಡದ /ಎತ್ತಿಕೊಳ್ಳಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न ऊढः<br><br>

अनूढा
अनूढा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अनूढ ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><br>

अनूदित
अनूदित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಮಾತಿನಿಂದ ಹೇಳಲ್ಪಟ್ಟ /ಭಾಷಾಂತರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + वद (व्यक्तायां वाचि) - "ल्यप्"(७-१-३७)<br><br>अनूदित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುನಃ ಹೇಳಲ್ಪಟ್ಟ<br><br>

अनूद्य
अनूद्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನುವಾದ ಮಾಡಿ /ಭಾಷಾಂತರಿಸಿ<br><br>

अनून
अनून<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಿಪೂರ್ಣವಾದ /ತುಂಬಿರುವ<br><br>अनून<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಗ್ರವಾದ /ಸಂಪೂರ್ಣವಾದ<br><br>अनून<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತಮವಾದ /ಅಧಮನಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न ऊनः<br><b>प्रयोगाः - </b>"अनूपराजस्य गुणैरनूनाम्"<br><b>उल्लेखाः - </b>रघु० ६-३७<br><br>

अनूप
अनूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನಿಂದ ತುಂಬಿದ ಪ್ರದೇಶ /ಜವುಗು ಪ್ರದೇಶ<br><br>अनूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಿಷ /ಎಮ್ಮೆ<br><br>अनूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಡೂಕ /ಕಪ್ಪೆ<br><b>विस्तारः - </b>"अनुपो महिषे नाम्बुप्रायदेशे तु वाच्यवत्"- मेदि० ।<br><br>अनूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆ<br><br>अनूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೌಜಿಗ ಹಕ್ಕಿ<br><br>अनूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಯೂರ /ನವಿಲು<br><br>अनूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ<br><br>अनूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಲದ ಬಾಯಿ<br><br>अनूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನೂಪವೆಂಬ ಒಂದು ದೇಶ<br><b>व्युत्पत्तिः - </b>अनुगता आपो यत्र<br><b>प्रयोगाः - </b>"अनूपराजस्य गुणैरनूनाम्"<br><b>उल्लेखाः - </b>रघु० ६-३७<br><br>

अनूपज
अनूपज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸಿಶುಂಠಿ<br><br>अनूपज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜವುಗು ಪ್ರದೇಶದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९९)<br><b>व्युत्पत्तिः - </b>अनूपे जायते<br><br>

अनूराधा
अनूराधा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುರಾಧಾ ನಕ್ಷತ್ರ<br><br>

अनूरु
अनूरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರುಣ /ಸೂರ್ಯನ ಸಾರಥಿ<br><b>व्युत्पत्तिः - </b>अविद्यमानावूरू यस्य<br><br>अनूरु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಡೆಯಿಲ್ಲದ<br><br>

अनूरुसारथि
अनूरुसारथि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>अनूरुः सारथिर्यस्य<br><b>प्रयोगाः - </b>"गतं तिरश्चीनमनूरुसारथेः"<br><b>उल्लेखाः - </b>माघ० १-२<br><br>

अनृच
अनृच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪನಯನವಿಲ್ಲದ ಬಾಲಕ<br><b>निष्पत्तिः - </b>"अः"(५-४-७४)<br><b>व्युत्पत्तिः - </b>नास्ति ऋक् यस्य<br><br>अनृच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಋಗ್ವೇದವನ್ನು ಅಧ್ಯಯನ ಮಾಡಿದವನು<br><br>

अनृजु
अनृजु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಕ್ರವಾದ /ಕ್ರಮವಾಗಿ ಬಗ್ಗಿರುವ<br><br>अनृजु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಠ /ಮೂರ್ಖ /ಕುಟಿಲ ಹೃದಯವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>न ऋजुः<br><b>प्रयोगाः - </b>"न पाणिपादचपलो न नेत्रचपलोऽनृजुः"<br><b>उल्लेखाः - </b>मनु० ४-१७७<br><br>

अनृण
अनृण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಋಣವಿಲ್ಲದ /ಸಾಲವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न विद्यते ऋणं यस्य<br><b>प्रयोगाः - </b>"दशलक्षणकं धर्ममनुतिष्ठन् समाहितः । वेदान्तं विधिवत् श्रुत्वा सन्न्यसेदनृणो द्विजः ॥"<br><b>उल्लेखाः - </b>मनु० ६-९४<br><br>

अनृणिन्
अनृणिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಲವಿಲ್ಲದವನು /ಸಾಲಗಾರನಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>न ऋणी<br><b>प्रयोगाः - </b>"एकमप्यक्षरं यस्तु गुरुः शिष्यं प्रबोधयेत् । पृथिव्यां नास्ति तद्द्रव्यं यद्दत्वा ह्यनृणी भवेत् ॥" "पञ्चमेऽहनि षष्ठे वा शाकं पचति यो नरः । अनृणी चाप्रवासी च स वारिञ्चर मोदते ॥"<br><b>उल्लेखाः - </b>२)भा० वन० ३१४-११७<br><br>

अनृत
अनृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಟೆ /ಸುಳ್ಳು<br><br>अनृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷಿ /ವ್ಯವಸಾಯ<br><b>व्युत्पत्तिः - </b>न ऋतम्<br><b>प्रयोगाः - </b>"वर्णिनां हि वधो यत्र साक्ष्यनृतं वदेत्"<br><b>उल्लेखाः - </b>याज्ञ० २-८३<br><b>विस्तारः - </b>"अनृत वितथे कृषौ" - वैज० ।<br><br>

अनृतवादिन्
अनृतवादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಳ್ಳು ಹೇಳುವ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>अनृत + वद (व्यक्तायां वाचि) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अनृतं वदति<br><br>

अनेक
अनेक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ /ಅಸಂಖ್ಯಾತ<br><b>प्रयोगाः - </b>"अनेकराजन्यरथाश्वसङ्कुलम्"<br><b>उल्लेखाः - </b>किरा० १-१६<br><br>

अनेकधा
अनेकधा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನೇಕ ಪ್ರಕಾರವಾಗಿ<br><b>निष्पत्तिः - </b>अनेक - प्रकारे - "धा" (५-३-४२)<br><b>प्रयोगाः - </b>"तत्रैकस्थं जगत्कृत्स्नं प्रविभक्तमनेकधा"<br><b>उल्लेखाः - </b>गीता० ११-१३<br><br>

अनेकप
अनेकप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಜ /ಆನೆ<br><b>निष्पत्तिः - </b>पा (पाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>अनेकाभ्यां पिबति<br><b>प्रयोगाः - </b>"मालवनाथोऽप्यनेकानेकपयूथसनाथः"<br><b>उल्लेखाः - </b>दशकु०<br><br>

अनेकमूर्ति
अनेकमूर्ति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ /ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>अनेका नानाविधा मूर्तयो यस्य<br><b>प्रयोगाः - </b>"अनेकमूर्तिरव्यक्तः शतमूर्तिः शताननः"<br><b>उल्लेखाः - </b>वि० स०<br><br>

अनेकरूप
अनेकरूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ /ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>अनेकानि रूपाणि यस्य<br><br>

अनेकलोचन
अनेकलोचन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><br>अनेकलोचन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ<br><br>

अनेकविध
अनेकविध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾನಾವಿಧವಾದ /ಬಹು ಪ್ರಕಾರವಾದ<br><b>व्युत्पत्तिः - </b>अनेका विधा यस्य<br><br>

अनेकशस्
अनेकशस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನೇಕ ಸಲ<br><b>निष्पत्तिः - </b>अनेक - "शस्" (५-४-४३)<br><b>प्रयोगाः - </b>"अनेकशो निर्जितराजकस्त्वं पितॄनतार्प्सीर्नृपरक्ततोयैः"<br><b>उल्लेखाः - </b>भट्टि० २-५२<br><br>

अनेकान्त
अनेकान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುಷ್ಟವಾದ ಹೇತು<br><br>अनेकान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಿಶ್ಚಿತ /ಅಸ್ಥಿರ<br><br>अनेकान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಯಮವಿಲ್ಲದ<br><br>

अनेकार्थ
अनेकार्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದಕ್ಕಿಂತಲೂ ಹೆಚ್ಚು ಅರ್ಥವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अनेके अर्था यस्य<br><b>प्रयोगाः - </b>"अनेकार्थस्य शब्दस्य संयोगाद्यैः नियन्त्रिते । एकत्रार्थे अन्यधिहेतुः व्यञ्जना साभिधाश्रया ॥"<br><b>उल्लेखाः - </b>सा० द० २-१४<br><br>अनेकार्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಪ್ರಯೋಜನವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अनेके अर्था प्रयोजनानि यस्य<br><br>

अनेकमूक
अनेकमूक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಬ್ದವನ್ನು ಕೇಳುವ ಶಕ್ತಿಯೂ ಮಾತನಾಡುವ ಶಕ್ತಿಯೂ ಇಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति एडः मूकश्च यस्मात्<br><br>अनेकमूक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಠ /ಮೂರ್ಖ /ಕುಟಿಲ ಹೃದಯವುಳ್ಳ<br><b>विस्तारः - </b>"अनेकमूढ उद्दिष्टः शठे वाक्श्रुतिवर्जिते" - मेदि० ।<br><br>

अनेनस्
अनेनस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪವಿಲ್ಲದ<br><br>अनेनस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೋಷವಿಲ್ಲದ /ತಪ್ಪಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति एनः यस्य<br><b>विस्तारः - </b>"एनः पापापराधयोः" - मेदि० ।<br><br>

अनेहस्
अनेहस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲ /ಸಮಯ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) - "असिः" एहश्च (उ० ४-२२४)<br><b>व्युत्पत्तिः - </b>न हन्यते<br><br>अनेहस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸಲ್ಪಡದ<br><br>

अनैकाग्र्य
अनैकाग्र्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಏಕಾಗ್ರತೆಯಿಲ್ಲದಿರುವಿಕೆ /ಚಿತ್ತಸ್ಥೈರ್ಯವಿಲ್ಲದಿರುವಿಕೆ<br><br>अनैकाग्र्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏಕಾಗ್ರತೆಯಿಲ್ಲದ /ಒಂದೇ ವಿಷಯದಲ್ಲಿ ಮನಸ್ಸಿಲ್ಲದ<br><br>

अनैकान्त
अनैकान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುಷ್ಟಹೇತು /ಹೇತ್ವಾಭಾಸ<br><br>

अनैकान्तिक
अनैकान्तिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುಷ್ಟಹೇತು /ಹೇತ್ವಾಭಾಸ<br><b>प्रयोगाः - </b>"अनैकान्तो विरुद्धश्चाप्यसिद्धः प्रतिपक्षितः । कालात्ययापदिष्टश्च हेत्वाभासश्च पञ्चधा ॥"<br><br>अनैकान्तिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯವಿಲ್ಲದ /ಭರವಸೆಯಿಲ್ಲದ<br><br>

अनैक्य
अनैक्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನೇಕವಾಗಿರುವಿಕೆ /ಬಹುವಾಗಿರುವಿಕೆ<br><br>अनैक्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಗ್ಗಟ್ಟಿಲ್ಲದಿರುವಿಕೆ /ಐಕಮತ್ಯವಿಲ್ಲದಿರುವಿಕೆ<br><br>

अनैतिह्य
अनैतिह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಐತಿಹ್ಯರೂಪವಾದ ಪ್ರಮಾಣವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति ऐतिह्यं यत्र<br><b>प्रयोगाः - </b>"अनागतमनैतिह्यं कथं ब्रह्माधिगच्छति"<br><b>उल्लेखाः - </b>भा०<br><br>

अनोहक
अनोहक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಕ್ಷ /ಮರ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) - "डः" (३-२-१०१)<br><b>व्युत्पत्तिः - </b>अनसः अकं गतिं हन्ति<br><b>प्रयोगाः - </b>"अनेकहाकम्पितपुष्पगन्धी"<br><b>उल्लेखाः - </b>रघु० २-१३<br><br>

अन्त
अन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೀಮೆ /ಗಡಿ /ಎಲ್ಲೆ<br><b>निष्पत्तिः - </b>अति (बन्धने) - "अच्" (३-१-१३४)<br><b>प्रयोगाः - </b>"वनान्तपर्यन्तमुपेत्य सस्पृहम्"<br><b>उल्लेखाः - </b>नैष० १-७५<br><br>अन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶ<br><b>प्रयोगाः - </b>"वैरस्यान्तं करिष्यति"<br><b>उल्लेखाः - </b>रामा०<br><br>अन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯ<br><b>प्रयोगाः - </b>"उभयोरपि दृष्टोऽन्तस्त्वनयोस्तत्त्वदर्शिभिः"<br><b>उल्लेखाः - </b>गीता० २-१६<br><b>विस्तारः - </b>"निर्णयोऽन्तश्च निश्चयः" - वैज० ।<br><br>अन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೆರಗು /ಅಂಚು /ಬಟ್ಟೆಯ ತುದಿ<br><b>प्रयोगाः - </b>"पवनप्रणर्तितान्तदेशे दुकूले"<br><b>उल्लेखाः - </b>कादं०<br><br>अन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪ<br><b>प्रयोगाः - </b>"गङ्गाप्रपातान्तनिरूढघासम्"<br><b>उल्लेखाः - </b>रघु० २-२६<br><br>अन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನೆ /ಸಮಾಪ್ತಿ /ಮುಕ್ತಾಯ<br><b>प्रयोगाः - </b>"सेकान्ते मुनिकन्याभिः"<br><b>उल्लेखाः - </b>रघु० १-५१<br><br>अन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಂತ /ಪ್ರದೇಶ<br><b>प्रयोगाः - </b>"अमुं वनान्ताद्वनितापहारिणम्"<br><b>उल्लेखाः - </b>माघ० १-६८<br><br>अन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಧನ /ಮರಣ<br><b>प्रयोगाः - </b>"वार्धके मुनिवृत्तीनां योगेनान्ते तनुत्यजाम्"<br><b>उल्लेखाः - </b>रघु० १-८<br><br>अन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನೆಯ ಭಾಗ<br><b>प्रयोगाः - </b>"नेत्रे कर्णान्तविश्रान्ते कर्णौ दोःस्तम्भदोलिनौ"<br><b>उल्लेखाः - </b>चन्द्रा०<br><br>अन्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರೂಪ<br><b>विस्तारः - </b>"स्वरूपेऽन्तः विनाशे ना" - त्रिकाण्ड० ।<br><br>अन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನೆಯದು /ಉಳಿದಿರುವುದು<br><br>अन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಯವ<br><b>विस्तारः - </b>"अन्तः स्वरूपे निकटे प्रान्ते निश्चयनाशयोः । अवयवेऽपि" - हेम० । "अन्तं स्वरूपे नाशे ना नास्त्री शेषेऽन्तिके त्रिषु" - मेदि० ।<br><br>अन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸಂಖ್ಯೆ<br><br>अन्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನೋಹರ /ರಮ್ಯ<br><b>प्रयोगाः - </b>"दन्तिज्ज्वलासु विमलोपलमेखलान्ताः"<br><b>उल्लेखाः - </b>माघ० ४-४०<br><br>अन्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದ /ಹತ್ತಿರದ<br><br>

अन्तःकरण
अन्तःकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತರಿಂದ್ರಿಯ /ಬುದ್ಧಿ /ಚಿತ್ತ /ಮನಸ್ಸು<br><b>व्युत्पत्तिः - </b>अन्तरभ्यन्तरस्थं करणम्<br><b>प्रयोगाः - </b>"सतां हि सन्देहपदेषु वस्तुषु प्रमाणमन्तःकरणप्रवृत्तयः"<br><b>उल्लेखाः - </b>शाकु० १-१९<br><br>

अन्तःकलह
अन्तःकलह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಳಜಗಳ /ಆಂತರಿಕ ಅಸಮಾಧಾನ<br><br>

अन्तःकुटिल
अन्तःकुटिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಂಖ<br><br>अन्तःकुटिल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಟಿಲ ಮನಸ್ಸುಳ್ಳ /ವಕ್ರಬುದ್ಧಿಯುಳ್ಳ<br><br>

अन्तःपतित
अन्तःपतित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳಗೆ ಸೇರಿರುವ /ಒಳಹೊಕ್ಕಿರುವ<br><b>व्युत्पत्तिः - </b>अन्तरभ्यन्तरे पतितः<br><br>

अन्तःपदवी
अन्तःपदवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಷುಮ್ನಾ ನಾಡಿಯ ಮಧ್ಯಭಾಗದಲ್ಲಿರುವ ಮಾರ್ಗ<br><br>

अन्तःपशु
अन्तःपशु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಊರಿನೊಳಗೆ ಹಸುಗಳಿರುವ ಕಾಲ /ಪೂರ್ವಾಹ್ನ ಮತ್ತು ಸಾಯಂಕಾಲ<br><b>व्युत्पत्तिः - </b>अन्तः ग्राममध्ये पशुर्यत्र<br><br>

अन्तःपात
अन्तःपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಧ್ಯದಲ್ಲಿ ಸೇರುವುದು /ಮಧ್ಯದಲ್ಲಿ ಬೀಳುವುದು<br><br>

अन्तःपातिन्
अन्तःपातिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಧ್ಯದಲ್ಲಿ ಸೇರಿರುವ /ಮಧ್ಯದಲ್ಲಿ ಬಿದ್ದಿರುವ<br><b>निष्पत्तिः - </b>पत्लृ (गतौ) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अन्तः पतति<br><br>

अन्तःपातिनी
अन्तःपातिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಧ್ಯದಲ್ಲಿ ಸೇರಿರುವ /ಮಧ್ಯದಲ್ಲಿ ಬಿದ್ದಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अन्तःपुर
अन्तःपुर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜಸ್ತ್ರೀಯರು ವಾಸ ಮಾಡುವ ಮನೆ /ರಾಣಿವಾಸ /ಅರಮನೆಯ ಒಳಭಾಗ<br><br>अन्तःपुर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಣಿ /ಮಹಿಷಿ /ಅಂತಃಪುರದ ಸ್ತ್ರೀಯರು<br><b>प्रयोगाः - </b>"अन्तःपुरविरहपर्युत्सुकस्य राजर्षेः"<br><b>उल्लेखाः - </b>शाकु० ३<br><br>

अन्तःपुरचर
अन्तःपुरचर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಚುಕಿ /ಅಂತಃಪುರದಲ್ಲಿ ನೇಮಿಸಿರುವ ಕಾವಲುಗಾರ /ಅಂತಃಪುರದ ರಕ್ಷಕ<br><b>निष्पत्तिः - </b>चर (गतौ) - "टः" (३-२-१६)<br><b>व्युत्पत्तिः - </b>अन्तःपुरे चरति<br><br>

अन्तःपुरचरी
अन्तःपुरचरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಚುಕಿ /ಅಂತಃಪುರದಲ್ಲಿ ನೇಮಿಸಿರುವ ಕಾವಲುಗಾರ /ಅಂತಃಪುರದ ರಕ್ಷಕಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

अन्तःपुरसहाय
अन्तःपुरसहाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನ ಅಂತಃಪುರದ ಸಹಾಯಕ<br><b>व्युत्पत्तिः - </b>अन्तःपुरे सहायः<br><br>

अन्तःपुरिक
अन्तःपुरिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂತಃಪುರದಲ್ಲಿ ನಿಯುಕ್ತನಾದವನು<br><b>निष्पत्तिः - </b>"ठक्"(४-४-६९)<br><b>व्युत्पत्तिः - </b>अन्तःपुरे नियुक्तः<br><br>

अन्तःप्रकृति
अन्तःप्रकृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನ ಮಂತ್ರಿಮಂಡಲ<br><b>व्युत्पत्तिः - </b>अन्तर्वर्तिनी प्रकृतिः राज्याङ्गम्<br><b>प्रयोगाः - </b>"आणुरप्यपहन्ति विग्रहः प्रभुमन्तःप्रकृतिकोपजः"<br><b>उल्लेखाः - </b>किरा० २-५१<br><br>

अन्तःप्रकोप
अन्तःप्रकोप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಳಗಡೆಯ ಕೋಪ /ಆಂತರಿಕ ಅಸಮಾಧಾನ /ವೈಮನಸ್ಯ<br><br>

अन्तःप्रज्ञ
अन्तःप्रज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆತ್ಮಾನುಸಂಧಾನದಲ್ಲಿ ಆಸಕ್ತನಾದ /ಪರಮಾತ್ಮನ ಧ್ಯಾನದಲ್ಲಿ ತೊಡಗಿದ<br><b>व्युत्पत्तिः - </b>अन्तस्था प्रज्ञा यस्य<br><br>अन्तःप्रज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಪ್ನಾವಸ್ಥೆಯಲ್ಲಿರುವ<br><br>

अन्तःप्रविष्ट
अन्तःप्रविष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳಗೆ ಪ್ರವೇಶಿಸಿರುವ /ಒಳಹೊಕ್ಕಿರುವ<br><br>अन्तःप्रविष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೃದಯದಲ್ಲಿ ಅಡಗಿರುವ<br><br>

अन्तःशल्य
अन्तःशल्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮನಸ್ಸಿಗೆ ನೋವುಂಟು ಮಾಡುವ ವಿಷಯ /ಶಲ್ಯದಂತೆ ಮನಸ್ಸನ್ನು ನೋಯಿಸುವ ವಸ್ತು<br><br>

अन्तःसञ्ज्ञ
अन्तःसञ्ज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳಚೈತನ್ಯವುಳ್ಳ ಮರ /ಗಿಡ ಬಳ್ಳಿ ಮೊದಲಾದುದು /ಮಾತನಾಡಲು ಸಾಮರ್ಥ್ಯವಿಲ್ಲದ ಜೀವಿಗಳು<br><b>प्रयोगाः - </b>"तमसा बहुरूपेण वेष्टिताः कर्महेतुना । अन्तःसञ्ज्ञा भवन्त्येते सुखदुःखसमन्विताः ॥"<br><b>उल्लेखाः - </b>मनु० १-४९<br><br>

अन्तःसत्वा
अन्तःसत्वा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ಭಿಣಿ /ಗರ್ಭವತಿ<br><b>व्युत्पत्तिः - </b>गर्भे सत्त्वं प्राणी यस्याः<br><br>

अन्तःस्वेद
अन्तःस्वेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಜ /ಆನೆ<br><b>व्युत्पत्तिः - </b>अन्तः स्वेदो मदजलं यस्य<br><br>

अन्तक
अन्तक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೃತ್ಯು<br><b>निष्पत्तिः - </b>अन्त + णिच् - "ण्वुल्"(३-१-१३३)<br><b>व्युत्पत्तिः - </b>अन्तयति<br><br>अन्तक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಮ<br><b>प्रयोगाः - </b>"ऋषि प्रभावान्मयि नान्तकोऽपि प्रभुः प्रहर्तुं किमुतान्यहिंस्राः"<br><b>उल्लेखाः - </b>रघु० २-६२<br><br>अन्तक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ಪರಮಾತ್ಮ<br><b>प्रयोगाः - </b>"महोदधिशयोऽन्तकः"<br><b>उल्लेखाः - </b>वि० स०<br><br>अन्तक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿನಾಶ ಪಡಿಸುವ<br><b>प्रयोगाः - </b>"क्रोधान्धस्तस्य तस्य स्वयमिह जगतामन्तकस्यान्तकोऽहम्"<br><b>उल्लेखाः - </b>वेणी० ३-३०<br><br>

अन्तकर
अन्तकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸುವ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "टः" (३-२-२०)<br><b>व्युत्पत्तिः - </b>अन्तं करोति<br><br>

अन्तकरण
अन्तकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸುವಿಕೆ<br><br>अन्तकरण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶ ಪಡಿಸುವ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अन्तं करोति<br><b>प्रयोगाः - </b>"द्यूतं समाह्वयं चैव राजा राष्ट्रान्निवारयेत् । राजान्तकरणावेतौ द्वौ दोषौ पृथिवीक्षिताम् ॥"<br><b>उल्लेखाः - </b>मनु० ९-२२१<br><br>

अन्तकर्मन्
अन्तकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸುವ ಕಾರ್ಯ<br><br>

अन्तकारिन्
अन्तकारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸುವ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अन्तं करोति<br><br>

अन्तकारिणी
अन्तकारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अन्तकाल
अन्तकाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೃತ್ಯುಕಾಲ /ಕೊನೆಗಾಲ<br><b>प्रयोगाः - </b>"अन्तकाले च मामेव स्मरन् मुक्त्वा कलेवरम्"<br><b>उल्लेखाः - </b>गीता० ८-५<br><br>

अन्तकृत्
अन्तकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸುವ /ಕೊನೆಗಾಣಿಸುವ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>अन्तं करोति<br><br>

अन्तग
अन्तग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊನೆಗಾಣುವ /ಕಾರ್ಯದ ಕೊನೆಯನ್ನು ಮುಟ್ಟುವ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "डः" (३-२-४८)<br><b>व्युत्पत्तिः - </b>अन्तं गच्छति<br><br>

अन्तचर
अन्तचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊನೆಯಲ್ಲಿ ಸಂಚರಿಸುವ /ಗಡಿಯಲ್ಲಿ ಓಡಾಡುವ<br><br>अन्तचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣವಾಗಿ ಮಾಡುವ /ಕಾರ್ಯದ ಕೊನೆ ಮುಟ್ಟುವ<br><br>

अन्तशस्
अन्तशस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೊನೆಯಿಂದ<br><br>अन्तशस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೊನೆಯಲ್ಲಿ /ಸಮಾಪ್ತಿಯಲ್ಲಿ<br><b>निष्पत्तिः - </b>अन्त - "तसिः" (वा० ५-४-४४)<br><br>अन्तशस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಳಭಾಗದಲ್ಲಿ /ಮಧ್ಯದಲ್ಲಿ<br><br>अन्तशस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೊನೆಯ ಪಕ್ಷ<br><br>

अन्तपाल
अन्तपाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ವಾರಪಾಲಕ<br><b>प्रयोगाः - </b>"त्वदीयेनान्तपालेनावस्कन्ध गृहीतः"<br><b>उल्लेखाः - </b>माल० १<br><br>

अन्तर्
अन्तर्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮಧ್ಯಭಾಗ<br><b>निष्पत्तिः - </b>अम (गतौ) - "अरन्" तुट्" च (उ० ५-६०)<br><b>प्रयोगाः - </b>"अन्तर्जलौघमवगाढवतः कपोलौ"<br><b>उल्लेखाः - </b>माघ० ५-३८<br><br>अन्तर्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಳಭಾಗ<br><b>प्रयोगाः - </b>"अन्तः कञ्चुकिकञ्चुकस्य विशति त्रासादयं वामनः"<br><b>उल्लेखाः - </b>रत्ना० २-३<br><br>अन्तर्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸ್ವೀಕಾರ<br><br>अन्तर्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೃದಯ<br><b>प्रयोगाः - </b>"अनाविलधियामन्तश्चिन्ता मणिरिव स्फुरन्"<br><b>उल्लेखाः - </b>याद० १-५२<br><br>

अन्यर
अन्यर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಡುವ ವಸ್ತ್ರ<br><b>प्रयोगाः - </b>"अन्तरे शाटकाः"<br><br>अन्यर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><br>अन्यर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಕಾಶ /ಒಳಭಾಗ<br><b>निष्पत्तिः - </b>रा (दाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>अन्तं राति<br><b>प्रयोगाः - </b>"ज्वलितज्योतिरिवान्तरं दिवः"<br><b>उल्लेखाः - </b>किरा० ३-५८<br><br>अन्यर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಧಿ /ಗಡು /ವಾಯಿದೆ<br><b>प्रयोगाः - </b>"मासान्तरं देयम्"<br><br>अन्यर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶೇಷ /ಭೇದ /ವ್ಯತ್ಯಾಸ<br><b>प्रयोगाः - </b>"यदन्तरं वायसवैनतेययोः"<br><b>उल्लेखाः - </b>रामा०<br><br>अन्यर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲಾವಕಾಶ /ಮಧ್ಯಕಾಲ<br><b>प्रयोगाः - </b>"गीतान्तरेषु श्रमवारिलेशैः"<br><b>उल्लेखाः - </b>कुमा० ३-३८<br><br>अन्यर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಡುವಣ ಪ್ರದೇಶ /ವ್ಯವಧಾನ<br><b>प्रयोगाः - </b>"तदन्तरे सा विरराज धेनुः"<br><b>उल्लेखाः - </b>रघु० २-२०<br><br>अन्यर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಾಗ /ಸ್ಥಾನ /ಅವಕಾಶ<br><b>प्रयोगाः - </b>"लेभेऽन्तरे चेतसि नोपदेशः"<br><b>उल्लेखाः - </b>रघु० ६-६६<br><br>अन्यर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಾದರ್ಥ್ಯ /ಉದ್ದೇಶ<br><b>प्रयोगाः - </b>"अवैमि कार्यान्तरमानुषस्य"<br><b>उल्लेखाः - </b>रघु० १६-८२<br><br>अन्यर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶಕ್ತತೆ /ಬಲಹೀನತೆ /ದೌರ್ಬಲ್ಯ<br><b>प्रयोगाः - </b>"सुजयः खलु तादृगन्तरे"<br><b>उल्लेखाः - </b>किरा० २-५२<br><br>अन्यर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಸರ /ಸಮಯ<br><b>प्रयोगाः - </b>"अत्रान्तरे किमपि वाग्विभवतिवृत्तवैचित्र्यमुल्लसितविभ्रममायताक्ष्याः"<br><b>उल्लेखाः - </b>मालती० १-२९<br><br>अन्यर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿನಾ /ಅದನ್ನುಳಿದು<br><br>अन्यर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತರ್ಧಾನ /ಮರೆಯಾಗುವಿಕೆ<br><b>प्रयोगाः - </b>"पर्वतान्तरितो रविः"<br><br>अन्यर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರೊಂದು /ಮತ್ತೊಂದು<br><b>प्रयोगाः - </b>"पात्रविशेषे न्यस्तं गुणान्तरं व्रजति शिल्पमाधातुः"<br><b>उल्लेखाः - </b>माल० १-६<br><br>अन्यर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವರ /ರಂಧ್ರ /ತೂತು<br><br>अन्यर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಸಾನ /ಕೊನೆ<br><br>अन्यर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನದಾದ /ತನ್ನ ಸಂಬಂಧವಾದ<br><b>प्रयोगाः - </b>"न चैतदिष्टं माता मे यदवोचन्मदन्तरम्"<br><b>उल्लेखाः - </b>रामा०<br><br>अन्यर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳಗಿರುವ /ಮಧ್ಯದಲ್ಲಿರುವ<br><br>अन्यर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿರುವ /ಹತ್ತಿರದಲ್ಲಿರುವ<br><br>अन्यर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸದೃಶವಾದ /ಸಮಾನವಾದ<br><br>अन्यर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆಯಾದ<br><br>अन्यर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊರಗಡೆಯಿರುವ<br><b>विस्तारः - </b>"अन्तरमवकाशावधिपरिधानान्तर्धिभेदतादर्थ्ये । छिद्रात्मीयविनाबहिरवसरमध्यसदृशेषु" - मेदि० । "विशेषविवरान्तर्धिष्ववसानविनार्थयोः" - वैज० ।<br><br>

अन्तरग्नि
अन्तरग्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಠರಾಗ್ನಿ /ಆಹಾರವನ್ನು ಕರಗಿಸುವ ಶಕ್ತಿ<br><b>व्युत्पत्तिः - </b>अन्तर्वर्ती अग्निः<br><br>अन्तरग्नि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಮಧ್ಯದಲ್ಲಿ<br><b>प्रयोगाः - </b>"दीप्तान्तरग्निपरिशुद्धकोष्ठः"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

अन्तरङ्ग
अन्तरङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೃದಯ ಮನಸ್ಸು ಅಂತರಂಗ<br><br>अन्तरङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣದಲ್ಲಿ ಪರ ಮತ್ತು ನಿತ್ಯ ಶಾಸ್ತ್ರಗಳನ್ನು ಬಾಧಿಸಿ ಬರುವ ಒಂದು ಶಾಸ್ತ್ರ /ಅಂತರಂಗ ಶಾಸ್ತ್ರ<br><b>प्रयोगाः - </b>"परनित्यान्तरङ्गापवादानां उत्तरोत्तरं बलीयः"<br><b>उल्लेखाः - </b>परि० ३९<br><br>अन्तरङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಪ್ರಿಯವಾದ /ಬಹಳ ಪ್ರೇಮಪಾತ್ರವಾದ<br><b>प्रयोगाः - </b>"चरमगिरिकुरङ्गीशृङ्गकण्डूयनेन स्वपिति सुखमिदानीमन्तरङ्गः कुरङ्गः"<br><br>अन्तरङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಶ್ವಾಸಕ್ಕೆ ಪಾತ್ರನಾದ /ನಂಬಿಕೆಗೆ ಅರ್ಹನಾದ ಸ್ನೇಹಿತ<br><b>प्रयोगाः - </b>"अन्तरङ्गेषु राज्यभारं समर्प्य"<br><b>उल्लेखाः - </b>दशकु०<br><br>

अन्तरचक्र
अन्तरचक्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹದಲ್ಲಿ ಸುಷುಮ್ನಾ ನಾಡಿಯ ಮಧ್ಯದಲ್ಲಿರುವ ಪದ್ಮಾಕಾರದ ಆರು ಚಕ್ರಗಳು<br><br>अन्तरचक्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನವರಸಮೂಹ /ಆತ್ಮೀಯರ ಗುಂಪು<br><br>

अन्तरज्ञ
अन्तरज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಶೇಷ ವಿಷಯಗಳನ್ನು ತಿಳಿದಿರುವ /ವ್ಯತ್ಯಾಸವನ್ನು ಅರಿತಿರುವ<br><b>निष्पत्तिः - </b>ज्ञा (अवबोधने) “कः” (३-२-३) ।<br><b>व्युत्पत्तिः - </b>अन्तरं भेदं जानाति<br><b>प्रयोगाः - </b>"नान्तरङ्गाः श्रियो जातु प्रियैरासां न भूयते"<br><b>उल्लेखाः - </b>किरा० ११-२४<br><br>

अन्तरतम
अन्तरतम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಹೋಲುವ /ಬಹುಭಾಗ ಸಮಾನವಾಗಿರುವ<br><b>प्रयोगाः - </b>"स्थानेऽन्तरतमः"<br><b>उल्लेखाः - </b>पा० सू० १-१-५०<br><br>

अन्तरशस्
अन्तरशस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮಧ್ಯದಲ್ಲಿ /ನಡುವೆ<br><b>निष्पत्तिः - </b>अन्तर - "तसिः" (वा० ५-४-४४)<br><b>प्रयोगाः - </b>"तृणमन्तरतः कृत्वा रावणं वाक्यमब्रवीत्"<br><b>उल्लेखाः - </b>रामा०<br><br>

अन्तरदिश्
अन्तरदिश्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿದಿಕ್ಕು /ಮಧ್ಯದ ದಿಕ್ಕು /ಆಗ್ನೇಯ ನೈರೃತ್ಯ ವಾಯವ್ಯ ಮತ್ತು ಈಶಾನ್ಯ ದಿಕ್ಕುಗಳು<br><br>

अन्तरदृश्
अन्तरदृश्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ ಸ್ವರೂಪವನ್ನು ತಿಳಿದವನು /ಪರಮಾತ್ಮಧ್ಯಾನಾಸಕ್ತ<br><b>व्युत्पत्तिः - </b>अन्तरे परमात्मनि दृक् यस्य<br><br>अन्तरदृश्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಶೇಷ ವಿಷಯಗಳನ್ನು ತಿಳಿದಿರುವ /ವ್ಯತ್ಯಾಸವನ್ನು ಅರಿತಿರುವ<br><b>निष्पत्तिः - </b>दृशिर् (प्रेक्षणे) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>अन्तरं पश्यति<br><br>

अन्तरदेश
अन्तरदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಧ್ಯದೇಶ /ನಡುವಣ ಪ್ರದೇಶ<br><br>

अन्तरपट
अन्तरपट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಬ್ಬರ ಮಧ್ಯೆ ಹಿಡಿಯುವ ಬಟ್ಟೆಯ ಪರದೆ /ವಧೂವರರ ಅಥವಾ ಗುರುಶಿಷ್ಯರ ಸಮಾಗಮಕ್ಕೆ ಮುಂಚೆ ಅವರಿಬ್ಬರ ಮಧ್ಯದಲ್ಲಿ ಹಿಡಿಯುವ ತೆರೆ<br><br>

अन्तरपुरुष
अन्तरपुरुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತರ್ಯಾಮಿ /ಪರಮಾತ್ಮ<br><br>अन्तरपुरुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಧ್ಯಸ್ಥನಾದ ಮನುಷ್ಯ<br><br>

अन्तरपूजा
अन्तरपूजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾನಸಿಕ ಪೂಜೆ /ತಂತ್ರೋಕ್ತಕ್ರಮದಲ್ಲಿ ಮನಸ್ಸಿನಿಂದ ಕಲ್ಪಿತವಾದ ಉಪಚಾರಗಳಿಂದ ಮಾಡುವ ಪೂಜೆ<br><br>

अन्तरप्रभव
अन्तरप्रभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಿಶ್ರ ಜಾತಿಯವನು /ಬೆರಕೆ ಜಾತಿಯವನು<br><b>व्युत्पत्तिः - </b>अन्तराभ्यां भिन्नवर्णमातापितृभ्यां प्रभवति<br><b>प्रयोगाः - </b>"अन्तरप्रभवाणां च धर्मान्नो वक्तुमर्हसि"<br><b>उल्लेखाः - </b>मनु० १-२<br><br>

अन्तरय
अन्तरय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯವಧಾನ<br><br>अन्तरय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ತದಲ್ಲಿರುವ /ಮನಸ್ಸಿನಲ್ಲಿರುವ<br><br>

अन्तरशायिन्
अन्तरशायिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೃದಯದಲ್ಲಿ ನೆಲೆಸಿರುವ ಜೀವ<br><br>अन्तरशायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಧ್ಯದಲ್ಲಿರುವ<br><br>

अन्तरा
अन्तरा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮಧ್ಯದಲ್ಲಿ /ನಡುವೆ<br><br>अन्तरा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮಾರ್ಗದ ಮಧ್ಯದಲ್ಲಿ<br><b>प्रयोगाः - </b>"कुमार, ममान्तिकमुपगच्छन् अन्तरा त्वदीयेनान्तपालेनावस्कन्द्य गृहीतः"<br><b>उल्लेखाः - </b>माल० १<br><br>अन्तरा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮಧ್ಯಕಾಲದಲ್ಲಿ<br><b>प्रयोगाः - </b>"नाद्याच्चैवान्तरा तथा"<br><br>अन्तरा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮಧ್ಯೆ ಮಧ್ಯೆ /ಆಗಾಗ್ಗೆ<br><b>प्रयोगाः - </b>"अन्तरा पितृसक्तमन्तरा मातृसक्तमालापं कुर्वन्"<br><b>उल्लेखाः - </b>कादं०<br><br>अन्तरा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎರಡರ ನಡುವೆ /ಎರಡು ವಸ್ತುಗಳ ಮಧ್ಯದಲ್ಲಿ<br><b>प्रयोगाः - </b>"अन्तरा त्वां च मां च कमण्डलुः" । "अन्तरा त्वां मां हरिः" ।<br><br>अन्तरा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಇಲ್ಲದೆ /ವಿನಾ /ಹೊರತು<br><b>प्रयोगाः - </b>"न च प्रयोजनमन्तरा चाणक्यः स्वप्नेऽपि चेष्टते"<br><b>उल्लेखाः - </b>मुद्रा० ३<br><br>अन्तरा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸನ್ನಿಧಿ /ಸಾನ್ನಿಧ್ಯ /ಹತ್ತಿರ<br><br>अन्तरा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ<br><br>अन्तरा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎದುರು<br><br>अन्तरा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣ<br><br>अन्तरा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎರಡು ಕಡೆಯೂ<br><br>अन्तरा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಶೀಘ್ರ /ವೇಗ /ಜಾಗ್ರತೆ<br><b>विस्तारः - </b>"अन्तरा पुनः । विनार्थे सन्निधौ मध्येऽभितोऽभिमुखकार्त्स्न्ययोः । समीपोभयतःशीघ्रेषु" - हेम० ।<br><br>

अन्तरात्मन्
अन्तरात्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೀವಾತ್ಮ<br><b>प्रयोगाः - </b>"जातो ममायं विशदः प्रकामं प्रत्यर्पितन्यास इवान्तरात्मा"<br><b>उल्लेखाः - </b>शाकु० ४-२१<br><br>अन्तरात्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತರ್ಯಾಮಿ /ಪರಮಾತ್ಮ<br><b>प्रयोगाः - </b>"अन्तरात्मनि निविष्टमन्तरा"<br><b>उल्लेखाः - </b>याद० १७-१२६<br><br>

अन्तराय
अन्तराय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಘ್ನ /ಪ್ರತಿಬಂಧಕ<br><b>निष्पत्तिः - </b>अय (गतौ) - "घञ्" (३-३-१८)<br><b>व्युत्पत्तिः - </b>अन्तर्मध्ये अयनम्<br><b>प्रयोगाः - </b>"त्वमन्तरायो भवसि च्युतो विधिः"<br><b>उल्लेखाः - </b>रघु० ३-४५<br><br>अन्तराय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯವಧಾನ /ನಡುವೆ /ಬರೋಣ<br><br>अन्तराय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಘ್ನವನ್ನುಂಟುಮಾಡುವ<br><br>

अन्तराराम
अन्तराराम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಳಗೇ ಸಂತೋಷಪಡುವವನು /ಹೃದಯದಲ್ಲಿ ಆತ್ಮಾನಂದವನ್ನನುಭವಿಸುವವನು<br><b>व्युत्पत्तिः - </b>अन्तरे आत्मनि आरमते<br><b>प्रयोगाः - </b>"योऽन्तः सुखोऽन्तरारामः"<br><b>उल्लेखाः - </b>गीता० ५-२४<br><br>

अन्तराल
अन्तराल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಳಭಾಗ /ಮಧ್ಯಭಾಗ<br><b>निष्पत्तिः - </b>ला (आदाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>अन्तरमवकाशं लाति<br><b>प्रयोगाः - </b>"मुहुरन्तरालभुवमस्तगिरेः"<br><b>उल्लेखाः - </b>माघ० ९-२<br><br>अन्तराल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಿಶ್ರಜಾತಿ /ಬೆರಕೆ ಜಾತಿ<br><b>प्रयोगाः - </b>"वर्णानां सान्तरालानां ससदाचार उच्यते"<br><br>

अन्तरालदिश्
अन्तरालदिश्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿದಿಕ್ಕು /ಮಧ್ಯದ ದಿಕ್ಕು /ಆಗ್ನೇಯ ನೈರೃತ್ಯ ವಾಯವ್ಯ ಮತ್ತು ಈಶಾನ್ಯ ದಿಕ್ಕುಗಳು<br><br>

अन्तरिक्ष
अन्तरिक्ष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಗನ /ಆಕಾಶ<br><b>निष्पत्तिः - </b>पृषो०<br><b>व्युत्पत्तिः - </b>अन्तः ऋक्षाण्यस्य<br><b>प्रयोगाः - </b>"अन्तरिक्षमणिदर्पणान्तरे"<br><b>उल्लेखाः - </b>याद० १७-२५<br><br>

अन्तरित
अन्तरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳಗೆ ಸೇರಿರುವ<br><b>निष्पत्तिः - </b>अन्तर् + इण् (गतौ) - "क्तः" (३-४-७२)<br><br>अन्तरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಲ್ಪಟ್ಟ /ಮರೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अन्तर + णिच् - कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"श्रियः पद्मनिषण्णायाः क्षौमान्तरितमेखले"<br><b>उल्लेखाः - </b>रघु० १०-८<br><br>अन्तरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರೆಯಾದ /ಅದೃಶ್ಯವಾದ<br><b>प्रयोगाः - </b>"द्विषत्प्रतापान्तरितोरुतेजाः"<br><b>उल्लेखाः - </b>किरा० ३-४५<br><br>

अन्तरिन्द्रिय
अन्तरिन्द्रिय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತಃಕರಣ /ಚಿತ್ತ /ಮನಸ್ಸು<br><br>

अन्तरीक्ष
अन्तरीक्ष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಗನ /ಆಕಾಶ<br><b>निष्पत्तिः - </b>अन्तर् + ईष (दर्शने) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>द्यावापृथिव्योरन्तरीक्ष्यते<br><b>प्रयोगाः - </b>"अन्तर्जलौघमवगाढवतः कपोलौ हित्वा क्षणं विततपक्षतिरन्तरीक्षे"<br><b>उल्लेखाः - </b>माघ० ५-३८<br><br>

अन्तरीप
अन्तरीप<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದ್ವೀಪ /ನೀರಿನ ಮಧ್ಯಪ್ರದೇಶ /ನೀರಿನ ಮಧ್ಯದಲ್ಲಿರುವ ದಿಣ್ಣೆ<br><b>निष्पत्तिः - </b>"अः" (५-४-७४) । ईत् (६-३-९७)<br><b>व्युत्पत्तिः - </b>अन्तर्गता आपो यस्मिन्<br><br>

अन्तरीय
अन्तरीय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಗಿನ ಬಟ್ಟೆ /ಉಡುವ ಬಟ್ಟೆ<br><b>निष्पत्तिः - </b>"छः" (४-२-१३८)<br><b>व्युत्पत्तिः - </b>अन्तरे भवम्<br><br>

अन्तरे
अन्तरे<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮಧ್ಯದಲ್ಲಿ /ನಡುವೆ<br><b>निष्पत्तिः - </b>इण् (गतौ) - "विच्" (३-२-७५)<br><b>व्युत्पत्तिः - </b>अन्तरेति<br><b>प्रयोगाः - </b>"आवयोरन्तरे जाताः पर्वताः सरितो द्रुमाः"<br><b>विस्तारः - </b>"मध्ये स्यादन्तरेणान्तरेऽन्तरा" - वैज० ।<br><br>

अन्तरेण
अन्तरेण<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿನಾ /ಅದನ್ನುಳಿದು<br><b>निष्पत्तिः - </b>इण् (गतौ) - "णः᳚<br><b>व्युत्पत्तिः - </b>अन्तरेति<br><b>प्रयोगाः - </b>"क्रियान्तरान्तरायमन्तरेण"<br><b>उल्लेखाः - </b>मुद्रा० ३<br><br>अन्तरेण<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮಧ್ಯದಲ್ಲಿ /ನಡುವೆ<br><b>प्रयोगाः - </b>"मृणालसूत्रामलमन्तरेण"<br><b>उल्लेखाः - </b>माघ० ३-३<br><br>

अन्तर्गडु
अन्तर्गडु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರರ್ಥಕವಾದ /ಆಡಿನ ಕತ್ತಿನಲ್ಲಿರುವ ಮಾಂಸ ಪಿಂಡದಂತೆ ಪ್ರಯೋಜನವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>अन्तर्मध्ये गडुरिव<br><b>विस्तारः - </b>"अन्तर्गडु निरर्थकम्" - वैज० ।<br><br>

अन्तर्गत
अन्तर्गत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೃದಯದಲ್ಲಿರುವ /ಮನಸ್ಸಿನಲ್ಲಿರುವ<br><b>व्युत्पत्तिः - </b>अन्तः अन्तःकरणे गतः<br><b>प्रयोगाः - </b>"अन्तर्गतं प्राणभृता हि वेद"<br><b>उल्लेखाः - </b>रघु० २-४३<br><br>अन्तर्गत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೇಹದಲ್ಲಿರುವ /ಶರೀರದಲ್ಲಿರುವ<br><br>अन्तर्गत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಧ್ಯದಲ್ಲಿರುವ /ಒಳಗಡೆಯಿರುವ<br><b>प्रयोगाः - </b>"नभः प्रतिच्छन्दनिभेन नूनमन्तर्गतं व्यञ्जयति स्वधाम्ना"<br><b>उल्लेखाः - </b>याद० १८-१०६<br><br>

अन्तर्गृह
अन्तर्गृह<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಳಗಿನ ಮನೆ /ಮನೆಯೊಳಗಿನ ಕೊಠಡಿ /ಮಧ್ಯದ ಮನೆ<br><br>अन्तर्गृह<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶಿಯಲ್ಲಿ ಒಂದು ಯಾತ್ರಾಸ್ಥಳ<br><b>प्रयोगाः - </b>"पञ्चक्रोश्यां कृतं पापमन्तर्गृहे विनश्यति"<br><br>अन्तर्गृह<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮನೆಯ ಮಧ್ಯದಲ್ಲಿ<br><br>

अन्तर्जठर
अन्तर्जठर<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉದರದ ಮಧ್ಯದಲ್ಲಿ<br><b>व्युत्पत्तिः - </b>जठरस्यान्तः<br><br>

अन्तर्दशा
अन्तर्दशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಃಶಾಸ್ತ್ರದಲ್ಲಿ ಹೇಳಿರುವ ಒಂದು ಗ್ರಹದ ಮಹಾದಶೆಯಲ್ಲಿ ಇತರ ಗ್ರಹಗಳು ಅಧಿಕಾರ ನಡೆಯಿಸಿ ಫಕೊಡುವ ಕಾಲ /ಭುಕ್ತಿ<br><b>व्युत्पत्तिः - </b>अन्तर्गता दशा अधिपत्यकालः<br><br>

अन्तर्दाह
अन्तर्दाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹದೊಳಗಿನ ತಾಪ<br><b>व्युत्पत्तिः - </b>अन्तः शरीरमध्ये दाहः तापः<br><br>

अन्तर्दुष्ट
अन्तर्दुष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುಷ್ಟ ಹೃದಯವುಳ್ಳ /ಕೆಟ್ಟ ಮನಸ್ಸುಳ್ಳ /ಹೊರಗಡೆ ಸಾಧುವಾಗಿ ತೋರುವ<br><b>व्युत्पत्तिः - </b>अन्तः अन्तःकरणे दुष्टः<br><br>

अन्तर्द्वार
अन्तर्द्वार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಳಬಾಗಿಲು /ಮನೆಯೊಳಗಿನ ರಹಸ್ಯವಾದ ಬಾಗಿಲು<br><b>व्युत्पत्तिः - </b>अन्तर्गतं द्वारम्<br><br>

अन्तर्धा
अन्तर्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮರೆಯಾಗುವಿಕೆ<br><b>निष्पत्तिः - </b>अन्तर् + डुधाञ् (धारणपोषणयोः) - "अङ्" (३-३-१०६)<br><b>प्रयोगाः - </b>"अन्तर्धामुपययुरुत्पलावलीषु"<br><b>उल्लेखाः - </b>माघ० ८-१२<br><br>

अन्तर्धान
अन्तर्धान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರೆಯಾಗುವಿಕೆ<br><b>निष्पत्तिः - </b>अन्तर् + डुधाञ् (धारणपोषणयोः) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"अन्तर्धानव्यसनरसिका रात्रिकापालिकीयम्"<br><b>उल्लेखाः - </b>कुव० पु० ५९<br><br>

अन्तर्धि
अन्तर्धि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರೆಯಾಗುವಿಕೆ<br><b>निष्पत्तिः - </b>अन्तर् + डुधाञ् (धारणपोषणयोः) - "किः" (३-३-९२)<br><b>प्रयोगाः - </b>"अन्तर्धिं द्रुतमिव क्र्तुमश्रुवर्षैः"<br><b>उल्लेखाः - </b>माघ० ८-४२<br><br>

अन्तर्नगर
अन्तर्नगर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತಃಪುರ /ರಾಣಿ ವಾಸ<br><b>प्रयोगाः - </b>"दशाननान्तर्नगरं ददर्श"<br><b>उल्लेखाः - </b>रामा०<br><br>अन्तर्नगर<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಗರದ ಮಧ್ಯದಲ್ಲಿ /ನಗರದ ಒಳಭಾಗದಲ್ಲಿ<br><b>व्युत्पत्तिः - </b>नगरस्यान्तः<br><br>

अन्तर्निहित
अन्तर्निहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳಗೆ ಸೇರಿಸಲ್ಪಟ್ಟ /ಒಳಗೆ ಇಡಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>अन्तः निहितम्<br><b>प्रयोगाः - </b>"अङ्गैरन्तर्निहितवचनैः सूचितः सम्यगर्थः"<br><b>उल्लेखाः - </b>माल० २-९<br><br>

अन्तर्भाव
अन्तर्भाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಧ್ಯದಲ್ಲಿ ಸೇರುವಿಕೆ<br><br>अन्तर्भाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರೆಯಾಗುವಿಕೆ<br><br>अन्तर्भाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನೋಭಾವ /ಮನಸ್ಸಿನ ಗುಣ /ಚಿತ್ತವೃತ್ತಿ<br><b>निष्पत्तिः - </b>अन्तर् + भू (सत्तायाम्) - "घञ्" (३-३-१८)<br><br>

अन्तर्भावना
अन्तर्भावना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಧ್ಯದಲ್ಲಿ ಸೇರಿಸುವಿಕೆ<br><br>अन्तर्भावना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಂತೆ /ಹಂಬಲ<br><br>अन्तर्भावना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಧ್ಯಾನ<br><b>निष्पत्तिः - </b>अन्तर् + भू (सत्तायाम्) + णिच् - "युच्" (३-३-१०७)<br><br>

अन्तर्भावित
अन्तर्भावित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಧ್ಯೆ ಸೇರಿಸಲ್ಪಟ್ಟ /ಮಧ್ಯೆ ಪ್ರವೇಶಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अन्तर् + भू (सत्तायाम्) + णिच् - "क्तः" (३-२-१०२)<br><br>

अन्तर्भूत
अन्तर्भूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳಗೆ ಸೇರಿರುವ /ಒಳಹೊಕ್ಕಿರುವ<br><br>अन्तर्भूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಧ್ಯದಲ್ಲಿರುವ<br><br>अन्तर्भूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರೆಯಾದ<br><br>

अन्तर्मनस्
अन्तर्मनस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುಃಖಗೊಂಡ ಮನಸ್ಸುಳ್ಳ /ಚಿಂತೆಯಿಂದ ಕೊರಗುವ ಮನಸ್ಸುಳ್ಳ<br><br>अन्तर्मनस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾಧಾನಗೊಂಡ ಮನಸ್ಸುಳ್ಳ /ಯೋಚನೆಯಿಲ್ಲದೆ ಪರಮಾತ್ಮನ ಧ್ಯಾನದಲ್ಲಿ ಆಸಕ್ತನಾದ ಮನಸ್ಸುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अन्तः अन्तर्मुखं मनो यस्य<br><br>

अन्तर्मातृका
अन्तर्मातृका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಂತ್ರೋಕ್ತವಾದ ಷಟ್ಚಕ್ರದಲ್ಲಿರುವ ಮಾತೃಕೆಗಳು<br><br>

अन्तर्मातृकान्यास
अन्तर्मातृकान्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹದೊಳಗಿನ ಪದ್ಮಗಳಲ್ಲಿ ಅಕಾರಾದಿ ವರ್ಣಗಳ ಉಚ್ಚಾರಣ ಪೂರ್ವಕ ಆಯಾ ಸ್ಥಾನಗಳಲ್ಲಿ ಮಾಡುವ ನ್ಯಾಸ<br><b>विस्तारः - </b>"द्यष्टपत्राम्बुजे कण्ठे स्वरान् षोडश विन्यसेत् । द्वादशच्छदहृत्पद्मे कादीन् द्वादश विन्यसेत् । दशपत्राम्बुजे नाभौ डकारादीन्न्यसेद्दश । षट्पत्रमध्ये लिङ्गस्ते बकारादीन् न्यसेच्च षट् । आधारे चतुरो वर्णान् न्यसेद्वादीन् चतुर्दले । हस्तौ भ्रूमध्यगे पद्मे द्विदले विन्यसेत् प्रिये । तन्मध्ये परबिन्दुं च सृष्टिस्थितिलयात्मकम् । एवं समाहितमना ध्यानेन्न्यासोऽयमान्तरः ॥" - तन्त्रसा० ।<br><br>

अन्तर्मुख
अन्तर्मुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾಹ್ಯ ವ್ಯಾಪಾರವನ್ನು ಬಿಟ್ಟು ಪರಮಾತ್ಮನ ಧ್ಯಾನಾಸಕ್ತನಾದ<br><b>व्युत्पत्तिः - </b>अन्तरभ्यन्तरे मुखं यस्य<br><b>प्रयोगाः - </b>"अन्तर्मुखं चित्तमिवान्वविन्दत्"<br><b>उल्लेखाः - </b>याद० १-८७<br><br>

अन्तर्मृत
अन्तर्मृत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಟ್ಟೆಯೊಳಗೆ ಮೃತವಾದ ಶಿಶು<br><br>

अन्तर्य
अन्तर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಧ್ಯದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>अन्तर - "यत्" (४-३-५४)<br><b>व्युत्पत्तिः - </b>अन्तरे भवः<br><br>

अन्तर्याग
अन्तर्याग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಂತ್ರೋಕ್ತವಾದ ಮಾನಸ ಪೂಜೆ<br><b>व्युत्पत्तिः - </b>अन्तः मनसा कृतो यागः<br><br>

अन्तर्यामिन्
अन्तर्यामिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ /ಪರಮಾತ್ಮ<br><br>

अन्तर्वंशिक
अन्तर्वंशिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತಃಪುರದಲ್ಲಿ ನಿಯುಕ್ತನಾದ ಅಧಿಕಾರಿ /ಕುಬ್ಜ /ವಾಮನ /ಕಿರಾತ ಮೊದಲಾದವರು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-६९)<br><b>व्युत्पत्तिः - </b>अन्तर्वंशे अभ्यन्तरगृहे नियुक्तः<br><br>

अन्तर्वत्नी
अन्तर्वत्नी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ಭಿಣಿ /ಗರ್ಭವತಿ<br><b>निष्पत्तिः - </b>"नुक्" (४-१-३२) । "मतुप्" निपा० । "ङीप्" (४-१-५)<br><b>व्युत्पत्तिः - </b>अन्तरस्त्यस्यां गर्भः<br><b>प्रयोगाः - </b>"तस्यामेवास्य यामिन्यामन्तर्वत्नी प्रजावती । सुतावसूत सम्पन्नौ कौशदण्डाविव क्षितिः ॥"<br><b>उल्लेखाः - </b>रघु० १५-१३<br><br>

अन्तर्वर्तिन्
अन्तर्वर्तिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಧ್ಯದಲ್ಲಿರುವ /ಒಳಗಡೆಯಿರುವ<br><b>निष्पत्तिः - </b>वृतु (वर्तने) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अन्तः वर्तते<br><br>

अन्तर्वाणि
अन्तर्वाणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಂಡಿತ /ಶಾಸ್ತ್ರವನ್ನರಿತವನು<br><b>व्युत्पत्तिः - </b>अन्तः अन्तःकरणे वाणी शास्त्रात्मिका यस्य<br><br>

अन्तर्विगाह
अन्तर्विगाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಳಗಡೆ ಪ್ರವೇಶಿಸುವುದು /ಮಧ್ಯೆ ಪ್ರವೇಶಿಸುವುದು<br><br>

अन्तर्वेश
अन्तर्वेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತಃಪುರ /ರಾಣಿ ವಾಸ<br><br>

अन्तर्वेशिक
अन्तर्वेशिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತಃಪುರದಲ್ಲಿ ನಿಯುಕ್ತನಾದ ಅಧಿಕಾರಿ /ಕುಬ್ಜ /ವಾಮನ /ಕಿರಾತ ಮೊದಲಾದವರು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-६९)<br><b>व्युत्पत्तिः - </b>अन्तर्वेशे नियुक्तः<br><br>

अन्तर्वेश्मन्
अन्तर्वेश्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆಯ ಒಳಭಾಗ<br><br>अन्तर्वेश्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತಃಪುರ<br><br>

अन्तर्वेश्मिक
अन्तर्वेश्मिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತಃಪುರದ ಅಧಿಕಾರಿ<br><b>व्युत्पत्तिः - </b>अन्तर्वेश्मनि नियुक्तः<br><br>

अन्तर्हास
अन्तर्हास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಯಿ ಮುಚ್ಚಿಕೊಂಡು ನಗುವುದು /ಮುಗುಳುನಗೆ /ಹೊರಕ್ಕೆ ತಿಳಿಯದಂತೆ ಒಳಗೇ ನಗುವುದು<br><b>व्युत्पत्तिः - </b>अन्तः अप्रकाशो हासः<br><b>प्रयोगाः - </b>"अन्तर्हासलसत्कपोलफलकां धूर्तोऽपरां चुम्बति"<br><b>उल्लेखाः - </b>काव्यप्र०<br><br>अन्तर्हास<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೂಢವಾದ ನಗುವುಳ್ಳ /ಒಳಗೇ ಅಡಗಿಸಿಕೊಂಡು ನಗುವ<br><br>

अन्तर्हित
अन्तर्हित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರೆಯಾದ /ಅದೃಶ್ಯವಾದ<br><b>निष्पत्तिः - </b>अन्तर् +डुधाञ् (धारणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अन्तर्हिते शशिनि सैव कुमुद्वती मे"<br><b>उल्लेखाः - </b>शाकु० ४-२<br><br>अन्तर्हित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುಪ್ತವಾದ /ರಹಸ್ಯವಾದ<br><br>

अन्तवत्
अन्तवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಶ್ವರವಾದ /ನಾಶ ಸ್ವಭಾವದ /ಕೊನೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>अन्तो नाशोऽस्यास्ति<br><b>प्रयोगाः - </b>"अन्तवन्त इमे देहाः नित्यस्योक्ताः शरीरिणः"<br><b>उल्लेखाः - </b>गीता० २-१८<br><br>अन्तवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲೆಯುಳ್ಳ /ಅವಧಿಯುಳ್ಳ<br><br>

अन्तश्छिद्र
अन्तश्छिद्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳಗಡೆ ರಂಧ್ರವುಳ್ಳ /ಒಳಗಡೆ ಟೊಳ್ಳಾಗಿರುವ<br><b>प्रयोगाः - </b>"अन्तश्छिद्राणि भूयांसि कण्टका बहवो बहिः"<br><b>उल्लेखाः - </b>कुव० पु० ७९<br><br>अन्तश्छिद्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳಜಗಳವುಳ್ಳ /ಅಂತಃಕಲಹವುಳ್ಳ<br><br>

अन्तसद्
अन्तसद्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಷ್ಯ<br><b>निष्पत्तिः - </b>षद्लृ (विशरणादौ) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>अन्ते समीपे सीदति<br><b>प्रयोगाः - </b>"तमुपासते गुरुमिवान्तसदः"<br><b>उल्लेखाः - </b>किरा० ६-३४<br><br>

अन्तःस्लिल
अन्तःस्लिल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿಯೊಳಗಿನ ನೀರು<br><br>

अन्तःसलिल
अन्तःसलिल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳಗಡೆ ನೀರುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अन्तरप्रकाशं सलिलम्<br><br>अन्तःसलिल<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನೀರಿನೊಳಗೆ /ನೀರಿನ ಮಧ್ಯದಲ್ಲಿ<br><br>

अन्तःसलिला
अन्तःसलिला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಪ್ತಗಾಮಿನಿ /ಸರಸ್ವತಿ<br><b>व्युत्पत्तिः - </b>अन्तर्गतं सलिलमस्याः<br><br>

अन्तस्ताप
अन्तस्ताप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹದೊಳಗಿನ ಬೇನೆ /ಜ್ವರ<br><br>अन्तस्ताप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಂತೆ /ಯೋಚನೆ<br><br>

अन्तावसायिन्
अन्तावसायिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುನಿ /ತಪಸ್ವಿ<br><b>व्युत्पत्तिः - </b>अन्ते वयसि अवस्यति तत्वम्<br><br>अन्तावसायिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಪಿತ /ನಾಯಿಂದ /ಕ್ಷೌರಿಕ<br><b>निष्पत्तिः - </b>अन्त + अव + षो (अन्तकर्मणि) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>नखानामन्तमवसातुं शीलमस्य<br><br>अन्तावसायिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂಡಾಲ<br><b>व्युत्पत्तिः - </b>अन्ताय प्राणनाशाय अवस्यति<br><br>अन्तावसायिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂಡಾಲನಿಗೆ ನಿಷಾದಿಯಲ್ಲಿ ಹುಟ್ಟಿದ ಸಂಕರ ಜಾತಿಯವನು<br><b>विस्तारः - </b>"चण्डालात् पुल्कसी डोम्बं निषाद्यन्तावसायिनम्" - वैज० ।<br><br>

अन्ति
अन्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಟಕ ಸಂಕೇತದಲ್ಲಿ ಜ್ಯೇಷ್ಠ ಸಹೋದರಿ<br><br>

अन्तिक
अन्तिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪ /ಹತ್ತಿರ<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५)<br><b>व्युत्पत्तिः - </b>अन्तोऽस्यास्ति<br><b>प्रयोगाः - </b>"सिंहासनान्तिकचरेण सहोपसर्पन्"<br><b>उल्लेखाः - </b>माल० १-१२<br><br>अन्तिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದ /ಹತ್ತಿರದ<br><br>

अन्तिकतम
अन्तिकतम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಸಮೀಪದ<br><b>निष्पत्तिः - </b>"तमप्" (५-३-५५)<br><b>व्युत्पत्तिः - </b>अतिशयेनान्तिकम्<br><b>विस्तारः - </b>"नेदिष्ठमन्तिकतमम्" - अम० ।<br><br>

अन्तिका
अन्तिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಟಕದ ಸಂಕೇತದಲ್ಲಿ ಜ್ಯೇಷ್ಠ ಸಹೋದರಿ<br><b>विस्तारः - </b>"नाट्युक्तौ चाग्रजान्तिका" - त्रिकाण्ड० ।<br><br>अन्तिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಲೆ<br><b>विस्तारः - </b>"अधिश्रयणी चुल्लिरन्तिका" - वैज० ।<br><br>

अन्तिकान्तक
अन्तिकान्तक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಸಮೀಪ /ಬಹಳ ಹತ್ತಿರ<br><b>प्रयोगाः - </b>"अन्तिकान्तिकगतेन्दुविसृष्टे"<br><b>उल्लेखाः - </b>किरा० ९-२१<br><br>

अन्तिकाश्रय
अन्तिकाश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ ಸ್ಥಾನ /ಅವಲಂಬನ ಸ್ಥಾನ<br><b>विस्तारः - </b>"उपघ्नन्त्वन्तिकाश्रयः" - वैज० ।<br><br>

अन्तिम
अन्तिम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊನೆಯದಾದ<br><br>अन्तिम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊನೆಯಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"डिमच्" (वा० ४-३-२३)<br><b>व्युत्पत्तिः - </b>अन्ते भवः<br><b>प्रयोगाः - </b>"अजातमृतमूर्खाणां वरमाद्यौ न चान्तिमः"<br><b>उल्लेखाः - </b>हितो०<br><br>

अन्तेवसत्
अन्तेवसत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿದ್ಯಾರ್ಥಿ /ಶಿಷ್ಯ<br><b>निष्पत्तिः - </b>वस (निवासे) - "शतृ" (३-२-१२४)<br><b>व्युत्पत्तिः - </b>अन्ते समीपे वसति<br><b>प्रयोगाः - </b>"छन्दोमयीनां निलयस्य वाचामन्तेवसन्तौ मुनिपुङ्गवस्य"<br><b>उल्लेखाः - </b>चं० रा०<br><br>

अन्तेवासिन्
अन्तेवासिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿದ್ಯಾರ್ಥಿ /ಶಿಷ್ಯ<br><b>निष्पत्तिः - </b>वस (निवासे) - "णिनिः" (३-२-७८)<br><b>प्रयोगाः - </b>"वेदमनूच्याचार्योऽन्तेवासिनमनुशास्ति"<br><b>उल्लेखाः - </b>तै० उ०<br><br>अन्तेवासिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂಡಾಲ<br><b>व्युत्पत्तिः - </b>ग्रामादेरन्ते वसति<br><br>अन्तेवासिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊನೆಯಲ್ಲಿ ವಾಸ ಮಾಡುವ<br><b>विस्तारः - </b>"अन्तेवासी शिष्येऽपि स्यात् चण्डाले प्रान्तगेऽपि च" - मेदि० ।<br><br>

अन्त्य
अन्त्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂಡಾಲ<br><b>निष्पत्तिः - </b>"यत्" (४-३-५४)<br><b>व्युत्पत्तिः - </b>अन्ते भवः<br><br>अन्त्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊನೆಯದಾದ /ಕಡೆಯಲ್ಲಿರುವ /ಕೊನೆಯಲ್ಲುಂಟಾದ<br><b>व्युत्पत्तिः - </b>अन्ते भवम्<br><br>अन्त्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಮ /ನೀಚ ಗುಣವುಳ್ಳವನು<br><br>

अन्त्या
अन्त्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಸ್ತೆ /ಕೊನ್ನಾರಿ<br><br>

अन्त्यऋण
अन्त्यऋण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂರು ಋಣಗಳಲ್ಲಿ ಕೊನೆಯದು /ಪಿತೃ ಋಣ<br><br>

अन्त्यज
अन्त्यज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೂದ್ರ<br><br>अन्त्यज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸ /ಚಮ್ಮಾರ ಮೊದಲಾದ ೭ ಜಾತಿಯವರು<br><b>प्रयोगाः - </b>"रजकश्चर्मकारश्च नटो वरुड एव च । कैवर्तमेदभिल्लाश्च सप्तैते चान्त्यजाः स्मृतः ॥"<br><b>उल्लेखाः - </b>अत्रिसं०<br><br>अन्त्यज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊನೆಯಲ್ಲಿ ಹುಟ್ಟಿದ<br><br>

अन्त्यजा
अन्त्यजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अन्त्यज ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्"<br><br>

अन्त्यजन्मन्
अन्त्यजन्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೂದ್ರ<br><b>व्युत्पत्तिः - </b>अन्त्यं जन्मास्य<br><b>प्रयोगाः - </b>"प्रतिग्रहस्तु क्रियते शूद्रादप्यन्त्यजन्मनः"<br><b>उल्लेखाः - </b>मनु० १०-११<br><br>अन्त्यजन्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂಡಾಲ<br><br>

अन्त्यभ
अन्त्यभ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನೆಯ ನಕ್ಷತ್ರ /ರೇವತೀ ನಕ್ಷತ್ರ<br><br>

अन्त्यवर्ण
अन्त्यवर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪದದ ಕೊನೆಯ ಅಕ್ಷರ<br><br>अन्त्यवर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಣ,ಮಾಲೆಯಲ್ಲಿ ಕೊನೆಯ ಅಕ್ಷರ<br><br>अन्त्यवर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೂದ್ರ /ನಾಲ್ಕು ವರ್ಣಗಳಲ್ಲಿ ಕೊನೆಯ ವರ್ಣ<br><br>

अन्त्यवर्णा
अन्त्यवर्णा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अन्त्यवर्ण ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्"<br><br>

अन्त्यानुप्रास
अन्त्यानुप्रास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದಾಲಂಕಾರಗಳಲ್ಲಿ ಒಂದು ಭೇದ<br><b>प्रयोगाः - </b>"व्यञ्जनं चेद्यथावस्थं सहाद्येन स्वरेण तु । आवर्त्यतेऽन्त्ययोज्यत्वदन्त्यानुप्रास एव तत् ॥"<br><b>उल्लेखाः - </b>सा० द० १०-६<br><br>

अन्त्यावसायिन्
अन्त्यावसायिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂಡಾಲನಿಂದ ಬೇಡರ ಹೆಂಗಸಿನಲ್ಲಿ ಹುಟ್ಟಿದ ಬೆರಕೆ ಜಾತಿಯವನು<br><b>प्रयोगाः - </b>"निषादस्त्री तु चण्डालात् पुत्रमन्त्यावसायिनम्"<br><b>उल्लेखाः - </b>मनु० १०-३९<br><br>अन्त्यावसायिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸ /ಚಮ್ಮಾರ ಮೊದಲಾದ ಏಳು ಜಾತಿಗೆ ಸೇರಿದವನು<br><br>

अन्त्यावसायिनी
अन्त्यावसायिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अन्त्यावसायिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अन्त्याश्रम
अन्त्याश्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನೆಯ ಆಶ್ರಮ /ಸಂನ್ಯಾಸಾಶ್ರಮ<br><br>

अन्त्याश्रमिन्
अन्त्याश्रमिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಿಕ್ಷು /ಸಂನ್ಯಾಸಿ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>अन्त्याश्रमोऽस्यास्ति<br><br>

अन्त्र
अन्त्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರುಳು<br><b>निष्पत्तिः - </b>अति (बन्धने) - "ष्ट्रन्" (उ० ४-१५९)<br><b>व्युत्पत्तिः - </b>अन्त्यते बध्यते देहोऽनेन<br><br>

अन्त्रकूजित
अन्त्रकूजित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರುಳಿನ ಒಳಗೆ ಆಗುವ ಶಬ್ದ /ಹೊಟ್ಟೆಯೊಳಗಿನ ಗುಡುಗಾಟ<br><br>

अन्दुक
अन्दुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲು ಸರಪಣಿ /ಕಾಲಂದಿಗೆ ಗೊಲಸು<br><b>निष्पत्तिः - </b>अन्दू - स्वार्थे "कन्" (५-४-५)<br><br>अन्दुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯನ್ನು ಕಟ್ಟುವ ಸರಪಣಿ<br><br>

अन्दू
अन्दू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲು ಸರಪಣಿ /ಕಾಲಂದಿಗೆ ಗೊಲಸು<br><b>निष्पत्तिः - </b>अदि (बन्धने) - "कूः" (उ० १-९३)<br><b>व्युत्पत्तिः - </b>अन्द्यते बध्यतेऽनेन चरणम्<br><br>

अन्ध
अन्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಧಕಾರ /ಕತ್ತಲೆ<br><b>निष्पत्तिः - </b>अन्ध (दृष्ट्युपघाते) + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अन्दधयति<br><br>अन्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುರುಡ /ಕಣ್ಣಿಲ್ಲದವನು<br><b>प्रयोगाः - </b>"अन्धस्य दैवादिव दृष्टिलाभः"<br><b>उल्लेखाः - </b>याद० २-६९<br><br>अन्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಮಲು ಮತ್ತು ಆವೇಶಗಳಿಂದ ಮೈಮರೆತವನು<br><b>विस्तारः - </b>"अन्धं स्यात् तिमिरे क्लीबं चक्षुर्हीनेऽभिधेयवत्" - मेदि० ।<br><br>

अन्धक
अन्धक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಕ್ಷಸ /ಅಂಧಕಾಸುರ<br><br>अन्धक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೃಹಸ್ಪತಿಯ ಶಾಪದಿಂದ ಕುರುಡನಾದ ಉತಥ್ಯ ಋಷಿಯ ಮಗ<br><b>निष्पत्तिः - </b>अन्ध - स्वार्थे "कन्"<br><br>अन्धक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರಣ /ಸಾವು<br><b>विस्तारः - </b>"कालधर्मस्तु दिष्टान्तो निपातो गमिरन्धकः" - वैज० ।<br><br>अन्धक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಧಕವಂಶದ ಮೂಲಪುರುಷನಾದ ಒಬ್ಬ ರಾಜ<br><br>अन्धक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತಲೆ<br><br>अन्धक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುರುಡ /ಕಣ್ಣಿಲ್ಲದವನು<br><br>

अन्धकरिपु
अन्धकरिपु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ /ಶಿವ<br><b>व्युत्पत्तिः - </b>अन्धकस्य तन्नामकस्यासुरस्य रिपुः<br><br>अन्धकरिपु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>अन्धकरिपु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><br>अन्धकरिपु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>व्युत्पत्तिः - </b>अन्धकस्यान्धकारस्य रिपुः<br><br>

अन्धकार
अन्धकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತಲೆ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>अन्धं करोति<br><b>प्रयोगाः - </b>"अथान्धकारं गिरिगह्वराणाम्"<br><b>उल्लेखाः - </b>रघु० २-४६<br><br>

अन्धकूप
अन्धकूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತಲೆಯಾಗಿರುವ ಬಾವಿ /ಪಾಳು ಬಾವಿ<br><br>अन्धकूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನರಕ<br><br>अन्धकूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಜ್ಞಾನ /ಮೋಹ<br><br>

अन्धतमस
अन्धतमस<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಗ್ಗತ್ತಲೆ /ದಟ್ಟವಾದ ಕತ್ತಲೆ<br><b>निष्पत्तिः - </b>"अच्" (५-४-७९)<br><b>व्युत्पत्तिः - </b>अन्धं च तत्तमश्च<br><b>प्रयोगाः - </b>"प्रध्वंसितान्धतमससस्तत्रोदाहरणं रविः"<br><b>उल्लेखाः - </b>माघ० २-३३<br><br>अन्धतमस<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಗ್ಗತ್ತಲೆಯಿಂದ ಕೂಡಿದ ನರಕ<br><br>

अन्धतामस
अन्धतामस<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಗ್ಗತ್ತಲೆ /ದಟ್ಟವಾದ ಕತ್ತಲೆ<br><b>व्युत्पत्तिः - </b>अन्धं च तत्तामसं च<br><br>

अन्धतामिस्र
अन्धतामिस्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಗ್ಗತ್ತಲೆ /ದಟ್ಟವಾದ ಕತ್ತಲೆ<br><b>व्युत्पत्तिः - </b>अन्धं च तत्तामिस्रं च<br><br>अन्धतामिस्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>೨೧ ನರಕಗಳಲ್ಲಿ ಎರಡನೆಯದು /ಆತ್ಮಹತ್ಯೆ ಮಾಡಿಕೊಂಡವನಿಗೆ ಪ್ರಾಪ್ತವಾಗುವ ನರಕ<br><b>प्रयोगाः - </b>"अन्धतामिस्रा ह्यसूर्यास्ते लोकास्तेभ्यः प्रतिविधीयन्ते य आत्मघातिन इति ऋषयो मन्यन्ते"<br><b>उल्लेखाः - </b>उ० रा० ४<br><br>

अन्धत्व
अन्धत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುಡತನ /ವಸ್ತುಗಳನ್ನು ನೋಡುವ ಶಕ್ತಿಯಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><b>व्युत्पत्तिः - </b>अन्धस्य भावः<br><br>

अन्धपूतना
अन्धपूतना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಬಾಲಗ್ರಹ /ಸಣ್ಣ ಮಕ್ಕಳಿಗೆ ಹಿಡಿಯುವ ಒಂದು ಭೂತ<br><b>प्रयोगाः - </b>"यो द्वेष्टि स्तनमतिसारकासहिक्काछर्दिभिर्ज्वरसहिताभिरर्द्यमान । दुर्वर्णः सततमधःशयोऽम्लगन्धिस्तं ब्रूयुर्वरभिषजोऽन्धपूतनार्तम् ॥"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

अन्धमूषिका
अन्धमूषिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತಾಳೆ ಮರ<br><b>निष्पत्तिः - </b>मुष (स्तेये) - "किकन्" दीर्घश्च (उ० २-४२)<br><b>व्युत्पत्तिः - </b>अन्धं दृष्ट्यभावं मुष्णाति<br><br>

अन्धम्भविष्णु
अन्धम्भविष्णु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುರುಡನಾಗಿ ಆಗುವನು<br><b>निष्पत्तिः - </b>अन्ध (च्व्यर्थे) - भू (सत्तायाम्) - "खिष्णुच्" (३-२-५७) । मुम् (६-३-६७)<br><b>व्युत्पत्तिः - </b>अनन्धोऽन्धो भवति<br><br>

अन्धम्भावुक
अन्धम्भावुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುರುಡನಾಗಿ ಆಗುವನು<br><b>निष्पत्तिः - </b>अन्ध (च्व्यर्थे) - भू (सत्तायाम्) - "खमुञ्" (३-२-५७) । मुम् (६-३-६७)<br><b>व्युत्पत्तिः - </b>अनन्धोऽन्धो भवति<br><br>

अन्धस्
अन्धस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನ<br><b>निष्पत्तिः - </b>अद (भक्षणे) - "असुन्" नुम् धश्च (उ० ४-२०६)<br><b>व्युत्पत्तिः - </b>अद्यते<br><b>प्रयोगाः - </b>"द्विजातिशेषेण यदेतदन्धसा"<br><b>उल्लेखाः - </b>किरा० १-३९<br><br>

अन्धु
अन्धु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾವಿ<br><br>अन्धु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುರುಷನ ಲಿಂಗ /ಪುರುಷನ ಜನನೇಂದ್ರಿಯ<br><b>निष्पत्तिः - </b>अमि (गतौ) - "कुः" धुक् च (उ० १-२७)<br><b>प्रयोगाः - </b>"वाक्पाणिपादपाय्वन्धुसञ्ज्ञान्याहुर्मनीषिणः"<br><br>

अन्न
अन्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>प्रयोगाः - </b>"आदित्यात् जायते वृष्टिः वृष्टेरन्नं ततः प्रजाः"<br><b>उल्लेखाः - </b>मनु० ३-७६<br><br>अन्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನ /ಆಹಾರ<br><b>निष्पत्तिः - </b>अद (भक्षणे) - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>अद्यते स्म<br><b>प्रयोगाः - </b>"अद्यतेऽत्ति च भूतानि । तस्मादन्नं तदुच्यत इति"<br><b>उल्लेखाः - </b>तै० उ०<br><br>अन्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಯಿಸದ ಅನ್ನ<br><b>प्रयोगाः - </b>"चण्डालान्नं भुक्त्वा त्रिरात्रमुपवसेत्"<br><br>अन्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಹಾರ ಧಾನ್ಯ<br><br>अन्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿ<br><br>अन्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು<br><br>अन्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೋಗ್ಯವಸ್ತು /ಸುಖಸಾಧನ<br><b>प्रयोगाः - </b>"स्त्रियोऽन्नं पशवोऽन्नं च विशोऽन्नं च महीक्षिताम्"<br><br>अन्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>"यज्ञान्तकृद्यज्ञगुह्यमन्नमन्नाद एव च"<br><b>उल्लेखाः - </b>वि० स०<br><br>अन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿನ್ನಲ್ಪಟ್ಟ<br><br>

अन्नकोष्ठ
अन्नकोष्ठ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಗ್ರಾಣ /ಧಾನ್ಯಗಳನ್ನು ಶೇಖರಿಸಿಡುವ ಸ್ಥಾನ /ಕಣಜ<br><br>

अन्नद
अन्नद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನ್ನವನ್ನು ಕೊಡುವ /ಆಹಾರವನ್ನು ಕೊಡುವ<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>अन्नं ददाति<br><br>

अन्नदा
अन्नदा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನವನ್ನು ಕೊಡುವ /ಆಹಾರವನ್ನು ಕೊಡುವ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्"<br><br>अन्नदा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನಪೂರ್ಣಾದೇವಿ<br><br>

अन्नदास
अन्नदास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನದಿಂದ ರಕ್ಷಿಸಲ್ಪಟ್ಟ<br><br>

अन्नदोष
अन्नदोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಷಿದ್ಧವಾದ ಅನ್ನವನ್ನು ಊಟಮಾಡ್ದುದರಿಂದ ಉಂಟಾಗುವ ದೋಷ<br><br>अन्नदोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಥ್ಯಾಹಾರ ಸೇವನೆಯಿಂದ ಉಂಟಾಗುವ ರೋಗರುಜಿನಾದಿ ರೂಪವಾದ ದೋಷ<br><br>अन्नदोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೈಶ್ವದೇವದಿಂದ ಹೋಗಲಾಡಿಸಲ್ಪಡುವ ೫ ಅನ್ನ ದೋಷಗಳು<br><br>

अन्नपाक
अन्नपाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಡಿಗೆ ಮಾಡುವುದು<br><br>अन्नपाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಟ್ಟೆಯಲ್ಲಿ ತಿಂದ ಆಹಾರವು ಜೀರ್ಣವಾಗುವಿಕೆ<br><br>

अन्नपूर्णा
अन्नपूर्णा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನಪೂರ್ಣಾದೇವಿ<br><b>व्युत्पत्तिः - </b>अन्नं पूर्णं यया<br><br>

अन्नप्राशन
अन्नप्राशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಕ್ಕಳಿಗೆ ಮೊದಲು ಶಾಸ್ತ್ರೋಕ್ತರೀತಿಯಲ್ಲಿ ಅನ್ನವನ್ನು ಉಣಿಸುವುದು<br><b>व्युत्पत्तिः - </b>प्रकृष्टं शास्त्रक्रमेण प्रथममाशनं प्राशनम्<br><b>प्रयोगाः - </b>"षष्ठेऽन्नप्राशनं मासि यद्वेष्टं मङ्गलं कुले ।"<br><b>उल्लेखाः - </b>मनु० २-३४<br><br>

अन्नभक्त
अन्नभक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನದಿಂದ ಸೇವಕನಾದವನು /ಒಬ್ಬನ ಮನೆಯಲ್ಲಿ ಅನ್ನ ತಿಂದು ಅವರ ಚಾಕರಿ ಮಾಡುವವನು<br><br>

अन्नमल
अन्नमल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ /ಮಾರಕ ದ್ರಯ<br><br>अन्नमल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನದ ಮೇಲಿನ ಸಾರ<br><br>

अन्नरस
अन्नरस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನದ ಸಾರ /ಅನ್ನದಲ್ಲಿರುವ ಪುಷ್ಟಿಕರ ದ್ರವ್ಯ<br><br>अन्नरस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನದ ರುಚಿ<br><b>व्युत्पत्तिः - </b>अन्नस्य रसः सारांशः स्वादो वा<br><br>

अन्नविकार
अन्नविकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಪ್ತಧಾತುಗಳಲ್ಲಿ ಮುಖ್ಯವಾದ ಶುಕ್ರಧಾತು<br><br>

अन्नाद
अन्नाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>"यज्ञान्तकृद्यज्ञगुह्यमन्नमन्नाद एव च"<br><b>उल्लेखाः - </b>वि० स०<br><br>अन्नाद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನ್ನವನ್ನು ತಿನ್ನುವ<br><b>निष्पत्तिः - </b>अद (भक्षणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>अन्नमत्ति<br><br>अन्नाद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನ್ನವನ್ನು ಊಟಮಾಡಲು ಶಕ್ತಿಯುಳ್ಳ /ಜಠರಾಗ್ನಿಯ ಬಲವುಳ್ಳ<br><br>

अन्नादा
अन्नादा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अन्नाद ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्"<br><br>

अन्नादिन्
अन्नादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನ್ನವನ್ನು ತಿನ್ನುವ<br><b>निष्पत्तिः - </b>अद (भक्षणे) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अन्नमत्ति<br><b>प्रयोगाः - </b>"भैक्षेण वर्तयेन्नित्यं नैकान्नादी भवेद्वती"<br><b>उल्लेखाः - </b>मनु० २-१८८<br><br>

अन्नादिनी
अन्नादिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನವನ್ನು ತಿನ್ನುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अन्नाद्य
अन्नाद्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನರೂಪವಾದ ತಿಂಡಿ<br><br>अन्नाद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನ್ನ ಮೊದಲಾದ<br><br>

अन्नायुस्
अन्नायुस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನ್ನದಿಂದ ಜೀವಿಸುವ<br><b>व्युत्पत्तिः - </b>अन्नमायुर्जीवनसाधनं यस्य<br><br>

अन्नाशन
अन्नाशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನಪ್ರಾಶನ /ಮಕ್ಕಳಿಗೆ ಮೊದಲು ಶಾಸ್ತ್ರೋಕ್ತರೀತಿಯಲ್ಲಿ ಅನ್ನವನ್ನು ಉಣಿಸುವುದು<br><b>व्युत्पत्तिः - </b>अन्नस्य शास्त्रविधानेन अशनम्<br><br>

अन्य
अन्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇತರ /ಬೇರೆಯಾದ<br><b>निष्पत्तिः - </b>अन (प्राणने) - "यः" (उ० ४-१११)<br><b>प्रयोगाः - </b>"अदृष्टान्तमभूद्युद्धमन्येदृष्टान्तवर्जितम्"<br><b>उल्लेखाः - </b>याद० १६-१०१<br><br>अन्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮತ್ತೊಂದು /ಮತ್ತೊಬ್ಬ<br><b>प्रयोगाः - </b>"अन्येन विदधेऽरीणामतिमात्रा विलासिना"<br><b>उल्लेखाः - </b>माघ० १९-५०<br><br>अन्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕವಾದ /ಹೆಚ್ಚಾದ<br><b>प्रयोगाः - </b>"अन्यान् दश सुवर्णान् प्रयच्छ"<br><b>उल्लेखाः - </b>मृच्छ०<br><br>अन्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಮಾನ್ಯ /ಉದಾಸೀನ<br><b>प्रयोगाः - </b>"साहारण्यान्निरातङ्कः कन्यामन्योऽपि याचते"<br><b>उल्लेखाः - </b>म० वी० १-३१<br><br>अन्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ರೀತಿಯಾದ /ಇತರ ವಿಲಕ್ಷಣವಾದ<br><b>प्रयोगाः - </b>"अन्यदुच्छृङ्खलं सत्त्वमन्यच्छास्त्रनियन्त्रितम्"<br><b>उल्लेखाः - </b>माघ० २-६२<br><br>

अन्या
अन्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अन्य ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्"<br><br>

अन्यत्
अन्यत्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>अन्य ಪದದ ಅರ್ಥ<br><br>अन्यत्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಇದಲ್ಲದೆ /ಮತ್ತೆ<br><b>प्रयोगाः - </b>"अन्यच्च कृतककलहं कृत्वा स्वतन्त्रेण वर्तितव्यमित्यार्यादेशः"<br><b>उल्लेखाः - </b>मुद्रा० ३<br><br>

अन्यक्षेत्र
अन्यक्षेत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೊಬ್ಬನ ಪತ್ನಿ<br><br>अन्यक्षेत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇನ್ನೊಬ್ಬನ ಜಮೀನು<br><br>अन्यक्षेत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರದೇಶ /ಪರರಾಷ್ಟ್ರ<br><br>

अन्यचित्त
अन्यचित्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರೆ ವಿಷಯದಲ್ಲಿ ಆಸಕ್ತವಾದ ಮನಸ್ಸು<br><br>अन्यचित्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ವಿಷಯದಲ್ಲಿ ಆಸಕ್ತವದ ಮನಸ್ಸುಳ್ಳ<br><br>

अन्यतम
अन्यतम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹುಮಂದಿಗಳಲ್ಲೊಬ್ಬ<br><br>

अन्यतर
अन्यतर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಬ್ಬರಲ್ಲೊಬ್ಬ<br><br>

अन्यतरेद्युस्
अन्यतरेद्युस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮತ್ತೊಂದು ದಿವಸ /ಎರಡರಲ್ಲೊಂದು ದಿವಸ<br><b>निष्पत्तिः - </b>अन्यतर - "एद्युस्" (५-३-२२)<br><br>

अन्यतस्
अन्यतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮತ್ತೊಬ್ಬನಿಂದ /ಮತ್ತೊಂದರಿಂದ /ಮತ್ತೊಂದು ಕಡೆಯಿಂದ<br><b>निष्पत्तिः - </b>अन्य - "तसिल्" (५-३-७)<br><b>व्युत्पत्तिः - </b>अन्यस्मात्<br><b>प्रयोगाः - </b>"न चान्यतस्तस्य शरीररक्षा स्ववीर्यगुप्ता हि मनो प्रसूतिः"<br><b>उल्लेखाः - </b>रघु० २-४<br><br>अन्यतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಕಡೆಗೆ /ಮತ್ತೊಂದೆಡೆಗೆ<br><b>प्रयोगाः - </b>"गुरोर्यत्र परीवादो निन्दा वापि प्रवर्तते । कर्णौ तत्र पिधातव्यौ गन्तव्यं वा ततोऽन्यतः ॥" "आर्ये व्रजामोऽन्यत इत्यथैनाम्" ।<br><b>उल्लेखाः - </b>मनु० २-२००, रघु० ६-८२<br><br>अन्यतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಕಡೆಯಲ್ಲಿ /ಮತ್ತೊಂದೆಡೆಯಲ್ಲಿ<br><b>प्रयोगाः - </b>"तपनमण्डलदीपितमेकतः सततनैशतमोवृतमन्यतः"<br><b>उल्लेखाः - </b>किरा० ५-२<br><br>

अन्यतस्त्य
अन्यतस्त्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶತ್ರುಪಕ್ಷದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"त्यप्" (४-२-१०४)<br><b>व्युत्पत्तिः - </b>अन्यतो भावः<br><br>

अन्यत्र
अन्यत्र<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಕಡೆ /ಮತ್ತೊಂದೆಡೆಯಲ್ಲಿ<br><b>निष्पत्तिः - </b>अन्य - "त्रल्" (५-३-१०)<br><b>व्युत्पत्तिः - </b>अन्यस्मिन्<br><br>अन्यत्र<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅದಕ್ಕಿಂತಲೂ /ಬೇರೆ ಕಡೆಯಲ್ಲಿ<br><b>प्रयोगाः - </b>"अन्यत्र रक्षोभवनोषितायाः परिग्रहान्मानवदेव देव्याः"<br><b>उल्लेखाः - </b>रघु० १४-३२<br><br>अन्यत्र<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಪ್ರಸಂಗದಲ್ಲಿ /ಬೇರೆ ಸಂದರ್ಭದಲ್ಲಿ<br><b>प्रयोगाः - </b>"मधुपर्के च यज्ञे च पितुर्देवतकर्मणि । अन्यत्र पशवो हिंस्या नान्यत्रेत्यब्रवीन्मनुः ॥"<br><b>उल्लेखाः - </b>मनु० ५-४१<br><br>

अन्यथा
अन्यथा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ರೀತಿಯಾಗಿ /ಬೇರೆ ಪ್ರಕಾರವಾಗಿ<br><b>प्रयोगाः - </b>"मन्त्रभङ्गभयाद्राज्ञां कथयन्त्यन्यथा पुरः । अन्यथा विवृतार्थेषु स्वैरालापेषु मन्त्रिणः ॥"<br><b>उल्लेखाः - </b>मुद्रा० ४-८<br><br>अन्यथा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹಾಗಿಲ್ಲದಿದ್ದಲ್ಲಿ /ಬೇರೆ ರೀತಿಯಾಗಿದ್ದಲ್ಲಿ /ಇಲ್ಲದಿದ್ದರೆ<br><b>प्रयोगाः - </b>"श्रिरेषा पाणिरप्यस्याः पारिजातस्य पल्लवः । कुतोऽन्यथा स्रवत्येषः स्वेदच्छद्मामृतद्रवम् ॥"<br><b>उल्लेखाः - </b>रत्ना० २-१७<br><br>अन्यथा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿರುದ್ಧವಾಗಿ /ಪ್ರತಿಯಾಗಿ<br><b>प्रयोगाः - </b>"त्वया कदाचिदपि मम वचनं नान्यथा कृतम्"<br><br>अन्यथा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮಿಥ್ಯೆಅಗಿ /ಸುಳ್ಳಾಗಿ /ಅಸತ್ಯವಾಗಿ<br><b>प्रयोगाः - </b>"किमन्यथा भट्टिन्यै निवेदितम्"<br><b>उल्लेखाः - </b>माल० ४<br><br>अन्यथा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಷ್ಕಾರಣವಾಗಿ /ಕಾರಣವಿಲ್ಲದೆ<br><b>विस्तारः - </b>"निष्कारणेऽन्यथा पुनः । वितर्ये चापरार्थे च" - मेदि० ।<br><br>

अन्यथाकारम्
अन्यथाकारम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ರೀತಿಯಾಗಿ /ಯೋಗ್ಯವಾದ ಕ್ರಮವನ್ನು ಬಿಟ್ಟು ಬೇರೆ ಕ್ರಮದಲ್ಲಿ ಮಾಡಿ<br><b>निष्पत्तिः - </b>अन्यथा + डुकृञ् (करणे) - "णमुल्" (३-४-२७)<br><br>

अन्यथाख्याति
अन्यथाख्याति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಪ್ಪು ತಿಳುವಳಿಕೆ /ಒಂದು ವಸ್ತುವನ್ನು ಮತ್ತೊಂದು ವಸ್ತುವನ್ನಾಗಿ ತಿಳುವಳಿಕೆ /ಭ್ರಾಂತಿ<br><b>व्युत्पत्तिः - </b>अन्यथा अन्यरूपेण ख्यातिः ज्ञानम्<br><br>

अन्यथानुपपत्ति
अन्यथानुपपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಗಿರುವ ಕಾರ್ಯವು ಬೇರೆ ಕಾರಣದಿಂದ ಸಂಬವಿಸದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>अन्यथा अभावे अनुपपत्तिः कार्यासम्भवः<br><br>

अन्यथाभाव
अन्यथाभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬದಲಾವಣೆ /ವ್ಯತ್ಯಾಸ /ರೂಪಾಂತರ ಹೊಂದುವುದು<br><b>व्युत्पत्तिः - </b>अन्यथा अन्यरूपेण भावः<br><br>अन्यथाभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರೆ ವಿಧವಾದ ಅಭಿಪ್ರಾಯ<br><br>

अन्यथाभूत
अन्यथाभूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬದಲಾವಣೆ ಹೊಂದಿದ /ವ್ಯತ್ಯಾಸವಾದ<br><br>

अन्यथावृत्ति
अन्यथावृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರೆ ರೀತಿಯಲ್ಲಿರುವುದು<br><br>

अन्यथासिद्ध
अन्यथासिद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ರೀತಿಯಲ್ಲಿ ಸಿದ್ಧವಾದ /ಬೇರೆ ಕಾರಣದಿಂದ ಸಿದ್ಧವಾದ /ಬೇರೆ ಪ್ರಮಾಣದಿಂದ ಸಿದ್ಧವಾದ<br><b>व्युत्पत्तिः - </b>अन्यथा अन्यप्रकारेण सिद्धः<br><br>अन्यथासिद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನ್ಯಥಾ ಸಿದ್ಧಿಯುಳ್ಳದ್ದು<br><br>

अन्यथासिद्धि
अन्यथासिद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರೆ ರೀತಿಯಲ್ಲಿ ಸಿದ್ಧವಾಗುವಿಕೆ /ಬೇರೆ ಕಾರಣದಿಂದ ಸಿದ್ದಿಸುವುದು<br><br>अन्यथासिद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಜವಾದ ಕಾರಣವಲ್ಲದಿರುವುದು<br><br>

अन्यदा
अन्यदा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಕಾಲದಲ್ಲಿ /ಬೇರೆ ಸಂದರ್ಭದಲ್ಲಿ /ಮತ್ತೊಂದು ಸಮಯದಲ್ಲಿ<br><b>निष्पत्तिः - </b>अन्य - "दा" (५-३-१५)<br><b>प्रयोगाः - </b>"अन्यदा भूषण पुंसः क्षमा लज्जेव योषितः"<br><b>उल्लेखाः - </b>माघ० २-४४<br><br>अन्यदा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕಾಲದಲ್ಲಿ /ಒಂದು ಸಮಯದಲ್ಲಿ<br><br>

अन्यदाशा
अन्यदाशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರೆ ಅಪೇಕ್ಷೆ /ಮತ್ತೊಂದು ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>"दुक्" (६-३-९९)<br><b>व्युत्पत्तिः - </b>अन्या च सा आशा च ।<br><br>अन्यदाशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೊಬ್ಬನ ಆಸೆ /ಮತ್ತೊಂದು ವಸ್ತುವಿನ ಆಸೆ<br><br>

अन्याशा
अन्याशा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಅಪೇಕ್ಷೆ /ಮತ್ತೊಂದು ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>दुक् न<br><b>व्युत्पत्तिः - </b>अन्यस्याशा ।<br><br>

अन्यदाशिस्
अन्यदाशिस्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೊಂದು ಅಶೀರ್ವಾದ<br><b>निष्पत्तिः - </b>"दुक्" (६-३-९९)<br><b>व्युत्पत्तिः - </b>अन्या आशीः<br><br>अन्यदाशिस्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೊಬ್ಬನ ಆಶೀರ್ವಾದ<br><br>

अन्याशी
अन्याशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೊಂದು ಅಶೀರ್ವಾದ<br><b>निष्पत्तिः - </b>दुक् न<br><b>व्युत्पत्तिः - </b>अन्यस्याशीः<br><br>

अन्यदास्था
अन्यदास्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೊಂದು ಅನುರಾಗ /ಮತ್ತೊಂದು ಭಕ್ತಿ /ಶ್ರದ್ಧೆ<br><b>निष्पत्तिः - </b>"दुक्" (६-३-९९)<br><b>व्युत्पत्तिः - </b>अन्या आस्था<br><br>अन्यदास्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೊಬ್ಬನ ಶ್ರದ್ಧೆ /ಶ್ರದ್ಧೆ<br><br>

अन्यस्था
अन्यस्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೊಂದು ಅನುರಾಗ /ಮತ್ತೊಂದು ಭಕ್ತಿ /ಶ್ರದ್ಧೆ<br><b>निष्पत्तिः - </b>दुक् न<br><b>व्युत्पत्तिः - </b>अन्येनास्थितः<br><br>

अन्यदास्थित
अन्यदास्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮತ್ತೊಬ್ಬನನ್ನು ಆಶ್ರಯಿಸಿರುವ /ಮತ್ತೊಬ್ಬನನ್ನು ಸೇರಿರುವ<br><b>निष्पत्तिः - </b>"दुक्" (६-३-९९)<br><b>व्युत्पत्तिः - </b>अन्यमास्थितः<br><br>अन्यदास्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮತ್ತೊಬ್ಬನಿಂದ ಆಶ್ರಯಿಸಲ್ಪಟ್ಟ<br><br>

अन्यास्थित
अन्यास्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮತ್ತೊಬ್ಬನನ್ನು ಆಶ್ರಯಿಸಿರುವ /ಮತ್ತೊಬ್ಬನನ್ನು ಸೇರಿರುವ<br><b>निष्पत्तिः - </b>दुक् न<br><b>व्युत्पत्तिः - </b>अन्येनास्थितः<br><br>

अन्यदीय
अन्यदीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮತ್ತೊಬ್ಬನಿಗೆ ಸಂಬಂಧಿಸಿದ<br><b>निष्पत्तिः - </b>अन्य - "छः" (४-२-१३८)<br><b>प्रयोगाः - </b>"अन्यदीयविशिखे न केवलम्"<br><b>उल्लेखाः - </b>किरा० १३-४६<br><br>

अन्यदुत्सुक
अन्यदुत्सुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮತ್ತೊಂದು ವಿಷಯದಲ್ಲಿ ಆಸೆಯುಳ್ಳ /ಬೇರೆ ವಸ್ತುವಿನಲ್ಲಿ ಬಯಕೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"दुक्" (६-३-९९)<br><b>व्युत्पत्तिः - </b>अन्यस्मिन्नुत्सुकः<br><br>

अन्योत्सुक
अन्योत्सुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮತ್ತೊಂದು ವಿಷಯದಲ್ಲಿ ಆಸೆಯುಳ್ಳ /ಬೇರೆ ವಸ್ತುವಿನಲ್ಲಿ ಬಯಕೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>दुक् न<br><b>व्युत्पत्तिः - </b>अन्येनोत्सुकः<br><br>

अन्यदूति
अन्यदूति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೊಂದು ರಕ್ಷಣೆ<br><b>निष्पत्तिः - </b>"दुक्" (६-३-९९)<br><b>व्युत्पत्तिः - </b>अन्या ऊतिः<br><br>

अन्योति
अन्योति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೊಂದು ರಕ್ಷಣೆ<br><b>निष्पत्तिः - </b>दुक् न<br><b>व्युत्पत्तिः - </b>अन्यस्योतिः<br><br>

अन्यदाग्र
अन्यदाग्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೊಬ್ಬನ ರಕ್ಷಣೆ<br><b>निष्पत्तिः - </b>"दुक्" (६-३-९९)<br><b>व्युत्पत्तिः - </b>अन्यस्मिन् रागः<br><br>अन्यदाग्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೊಬ್ಬನ ಪ್ರೀತಿ<br><br>

अन्यराग
अन्यराग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೊಂದರಲ್ಲಿ ಪ್ರೀತಿ /ಮತ್ತೊಂದು ವಿಷಯದಲ್ಲಿ ಶ್ರದ್ಧೆ<br><b>निष्पत्तिः - </b>दुक् न<br><b>व्युत्पत्तिः - </b>अन्यरागः<br><br>

अन्यपुष्ट
अन्यपुष्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><b>निष्पत्तिः - </b>"दुक्" (६-३-९९)<br><b>व्युत्पत्तिः - </b>अन्येन काकेन पुष्टः<br><b>प्रयोगाः - </b>"बलिपुष्टकुलादिवान्यपुष्टैः"<br><b>उल्लेखाः - </b>माघ० २-११६<br><br>

अन्यपुष्टा
अन्यपुष्टा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><b>निष्पत्तिः - </b>स्त्रियाम् "टाप्"<br><b>प्रयोगाः - </b>"अप्यन्यपुष्टा प्रतिकूलशब्दा"<br><b>उल्लेखाः - </b>कुमा० १-४५<br><br>

अन्यपूर्वा
अन्यपूर्वा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೊಬ್ಬನನ್ನು ಮದುವೆಯಾದ ವಿತಂತು<br><b>व्युत्पत्तिः - </b>अन्यः पतिः पूर्वो यस्याः<br><br>अन्यपूर्वा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೊಬ್ಬನಿಗೆ ನಿಶ್ಚಿತವಾಗಿದ್ದ ಕನ್ಯೆ<br><br>

अन्यभृत्
अन्यभृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯಸ /ಕಾಗೆ<br><b>निष्पत्तिः - </b>डुभृञ् (धारणपोषणयोः) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>अन्यं बिभर्ति<br><br>

अन्यभृत
अन्यभृत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><b>व्युत्पत्तिः - </b>अन्येन भृतः<br><br>

अन्यभृता
अन्यभृता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><b>निष्पत्तिः - </b>स्त्रियाम् "टाप्"<br><b>प्रयोगाः - </b>"कलमन्यभृतासु भाषितम्"<br><b>उल्लेखाः - </b>रघु० ८-५९<br><br>

अन्यमनस्
अन्यमनस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಪಲಚಿತ್ತ /ಚಂಚಲವಾದ ಮನಸ್ಸುಳ್ಳ<br><br>अन्यमनस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಕಡೇ ಮನಸ್ಸುಳ್ಳ /ಬೇರೆ ವಿಷಯದಲ್ಲಿ ಆಸಕ್ತವಾದ ಮನಸ್ಸುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अन्यस्मिन् मनो यस्य<br><br>

अन्यमनस्क
अन्यमनस्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಕಡೇ ಮನಸ್ಸುಳ್ಳ /ಬೇರೆ ವಿಷಯದಲ್ಲಿ ಆಸಕ್ತವಾದ ಮನಸ್ಸುಳ್ಳ<br><b>निष्पत्तिः - </b>वा "कप्" (५-४-१५४)<br><br>

अन्यमातृक
अन्यमातृक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಲತಾಯಿಯ ಮಗ<br><b>व्युत्पत्तिः - </b>अन्या माता<br><br>

अन्यमातृका
अन्यमातृका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಲತಾಯಿಯ ಮಗ<br><b>निष्पत्तिः - </b>वा "कप्" (५-४-१५३)<br><br>

अन्यमातृज
अन्यमातृज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಲತಾಯಿಯ ಮಗ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>अन्यस्या मातुर्जायते<br><br>

अन्यमातृजा
अन्यमातृजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಲತಾಯಿಯ ಮಗ<br><b>निष्पत्तिः - </b>स्त्रियाम् "टाप्"<br><br>

अन्यलिङ्ग
अन्यलिङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶೇಷ್ಯಾಧೀನವಾದ ಶಬ್ದ /ವಿಶೇಷ್ಯ ಪದದ ಲಿಂಗವುಳ್ಳ ಶಬ್ದ<br><b>व्युत्पत्तिः - </b>अन्यस्य स्वविशेष्यस्य लिङ्गमिव लिङ्गमस्य<br><br>

अन्यलिङ्गक
अन्यलिङ्गक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶೇಷ್ಯಾಧೀನವಾದ ಶಬ್ದ /ವಿಶೇಷ್ಯ ಪದದ ಲಿಂಗವುಳ್ಳ ಶಬ್ದ<br><b>निष्पत्तिः - </b>वा "कप्" (५-४-१५४)<br><b>प्रयोगाः - </b>"ऊषवानूषरो द्वावप्यन्यलिङ्गौ ।"<br><b>विस्तारः - </b>"हिमः सप्तान्यलिङ्गकौ" - अम० ।<br><br>

अन्यवादिन्
अन्यवादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಳ್ಳು ಹೇಳುವವನು /ಅಸತ್ಯ ನುಡಿಯುವವನು<br><br>अन्यवादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿವಾದಿ /ಎದುರು ಪಕ್ಷದವನು<br><b>निष्पत्तिः - </b>वद (व्यक्तायां वाचि) - 'णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>प्रतिज्ञातार्थादन्यथा वदति<br><br>

अन्यवादिनी
अन्यवादिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರು ಪಕ್ಷದವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अन्यशाख
अन्यशाख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನ ಶಾಖೆಯನ್ನು ಬಿಟ್ಟು ಬೇರೆ ಶಾಖೆಯ ವೇದವನ್ನು ಅಧ್ಯಯನ ಮಾಡುವವನು<br><b>व्युत्पत्तिः - </b>अन्या शाखा वेदभागो यस्य<br><br>

अन्यसङ्गम
अन्यसङ्गम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಪುರುಷನೊಡನೆ ಅಥವಾ ಪರಸ್ತ್ರೀಯೊಡನೆ ಮಾಡುವ ಸಂಭೋಗ<br><b>व्युत्पत्तिः - </b>अन्यस्यान्यस्या वा सङ्गमः<br><br>

अन्यसाधारण
अन्यसाधारण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇತರರಿಗೆ ಸಮಾನವಾದ<br><b>व्युत्पत्तिः - </b>अन्यैः साधारणः<br><br>

अन्यादृक्ष
अन्यादृक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನ್ಯಾದೃಶವಾದ /ವಿಲಕ್ಷಣವಾದ<br><br>अन्यादृक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆಯವನಂತೆ ಕಾಣುವ<br><b>निष्पत्तिः - </b>अन्य + दृशिर् (प्रेक्षणे) - "क्सः" (वा० ३-२-५७) । आत्वम् (६-३-९१)<br><b>व्युत्पत्तिः - </b>अन्य इव पश्यति<br><br>

अन्यादृश्
अन्यादृश्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆಯವನಂತೆ ಕಾಣುವ<br><br>अन्यादृश्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಾಧಾರಣವಾದ /ವಿಲಕ್ಷಣವಾದ<br><b>निष्पत्तिः - </b>अन्य + दृशिर् (प्रेक्षणे) - "क्विन्" (वा० ३-२-५७) । आत्वम् (६-३-९१)<br><b>व्युत्पत्तिः - </b>अन्य इव पश्यति<br><br>

अन्यादृश
अन्यादृश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆಯವನಂತೆ ಕಾಣುವ<br><br>अन्यादृश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಾಧಾರಣವಾದ /ವಿಲಕ್ಷಣವಾದ<br><b>निष्पत्तिः - </b>अन्य + दृशिर् (प्रेक्षणे) - "कञ्" (वा० ३-२-५७) । आत्वम् (६-३-९१)<br><b>व्युत्पत्तिः - </b>अन्य इव पश्यति<br><b>प्रयोगाः - </b>"कामदेवोद्यानयात्राप्रतिनिवृत्तं भवन्तमन्यादृशमिवावधारयामि"<br><b>उल्लेखाः - </b>मालती० १<br><br>

अन्यादृशी
अन्यादृशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अन्यादृश ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अन्याय
अन्याय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನ್ಯಾಯದ ಅಭಾವ /ನ್ಯಾಯವಿಲ್ಲದಿರುವಿಕೆ<br><br>अन्याय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಔಚಿತ್ಯವಿಲ್ಲದಿರುವಿಕೆ /ಅಯೋಗ್ಯತೆ<br><br>अन्याय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನ್ಯಾಯವಲ್ಲದ /ಅಯುಕ್ತವಾದ /ವಿಮರ್ಶೆ ಮಾಡದ<br><br>

अन्याय्य
अन्याय्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಚಿತವಾದ /ಅಯೋಗ್ಯವಾದ<br><br>अन्याय्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನ್ಯಾಯವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न न्याय्यम्<br><br>

अन्यार्थ
अन्यार्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರೆ ಅರ್ಥ /ಮತ್ತೊಂದು ಅರ್ಥ<br><br>अन्यार्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರೆ ಪ್ರಯೋಜನ<br><b>व्युत्पत्तिः - </b>अन्योऽर्थः<br><br>अन्यार्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಅರ್ಥವುಳ್ಳ<br><br>अन्यार्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಪ್ರಯೋಜನವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अन्योऽर्थोऽभिधेयः प्रयोजनं वा यस्य<br><br>

अन्यून
अन्यून<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಡಮೆಯಾಗದ /ಕಡಮೆಯಿಲ್ಲದ /ಹೀನವಲ್ಲದ /ಸಂಪೂರ್ಣವಾದ<br><b>व्युत्पत्तिः - </b>न न्यूनः<br><br>

अन्यूनाधिक
अन्यूनाधिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಕಡಮೆಯಿಲ್ಲದ /ಸಮವಾದ<br><br>

अन्यूनातिरिक्त
अन्यूनातिरिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಕಡಮೆಯಿಲ್ಲದ /ಸಮವಾದ<br><br>

अन्यूनातिरेक
अन्यूनातिरेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಕಡಮೆಯಿಲ್ಲದಿರುವಿಕೆ /ಸಮವಾಗಿರುವಿಕೆ<br><br>

अन्येद्युस्
अन्येद्युस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮತ್ತೊಂದು ದಿವಸ /ಮರು ದಿವಸ<br><b>निष्पत्तिः - </b>अन्य - "एद्युस्" (५-३-२२)<br><b>प्रयोगाः - </b>"अन्येद्युरात्मानुचरस्य भावम्"<br><b>उल्लेखाः - </b>रघु० २-२६<br><br>

अन्योढा
अन्योढा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ಯನಾಯಿಕೆ /ಪರಕೀಯಳು<br><b>प्रयोगाः - </b>"यात्रादिनिरतान्योढा कुलटा गलितत्रपा"<br><b>उल्लेखाः - </b>सा० द० ३-६६<br><br>

अन्योदर्य
अन्योदर्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಲತಾಯಿಯ ಮಗ /ಭಿನ್ನೋದರ<br><b>निष्पत्तिः - </b>"यत्" (४-३-५४)<br><b>व्युत्पत्तिः - </b>अन्यस्मिन्नुदरे स्वमातृभिन्ने गर्भे भवः<br><b>प्रयोगाः - </b>"नयोदर्यस्तु संसृष्टी नान्योदर्यो धनं हरेत्"<br><b>उल्लेखाः - </b>याज्ञ० २-१३४<br><br>

अन्योन्य
अन्योन्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ಯೋನ್ಯಾಲಂಕಾರ /ಅರ್ಥಾಲಂಕಾರದ ಒಂದು ಭೇದ<br><b>प्रयोगाः - </b>"अन्योन्यं नाम यत्र स्यादुपकारः परस्परम् । त्रियामा शशिना भाति शश् भाति त्रियामया ॥"<br><b>उल्लेखाः - </b>चन्द्रा०<br><br>अन्योन्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಸ್ಪರವಾದ<br><b>निष्पत्तिः - </b>अन्य - कर्मव्य० द्वित्वम् "सुच्" च (वा० ८-१-१२)<br><b>प्रयोगाः - </b>"अन्योन्यव्यतिकरचारुभिर्विचित्रैः"<br><b>उल्लेखाः - </b>माघ० ४-५३<br><br>अन्योन्य<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಪರಸ್ಪರವಾಗಿ<br><b>प्रयोगाः - </b>"अन्योन्यरक्तमनसामथ बिभ्रतीनाम्"<br><b>उल्लेखाः - </b>किरा० ९-७४<br><br>

अन्योन्याध्यास
अन्योन्याध्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎರಡು ವಸ್ತುಗಳೊಡನೆ ಪರಸ್ಪರ ಒಂದರ ಧರ್ಮವನ್ನು ಮತ್ತೊಂದರಲ್ಲಿ ತಪ್ಪಾಗಿ ತಿಳಿಯುವುದು<br><b>व्युत्पत्तिः - </b>अन्योन्यस्मिन् अन्योन्यतादात्म्याध्यासः आरोपः<br><br>

अन्योन्याभाव
अन्योन्याभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಾವದ ಒಂದು ಭೇದ /ಒಂದು ಮತ್ತೊಂದಲ್ಲದಿರುವುದು<br><br>

अन्योन्याश्रय
अन्योन्याश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಮತ್ತೊಂದನ್ನು ಪರಸ್ಪರ ಆಶ್ರಯಿಸಿಕೊಂಡಿರುವಿಕೆ /ಒಂದರ ಅಧೀನದಲ್ಲಿ ಮತ್ತೊಂದಿರುವಿಕೆ /ಪರಸ್ಪರಾವಲಂಬನ<br><br>

अन्वक्ष
अन्वक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯಕ್ಷವಾದ /ಇಂದ್ರಿಯಗಳಿಗೆ ಗೋಚರವಾಗುವ<br><b>व्युत्पत्तिः - </b>अनुगतमक्षमिन्द्रियम्<br><br>अन्वक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸುವ /ಹಿಂಬಾಲಿಸುವ<br><br>अन्वक्ष<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನಂತರ /ತರುವಾಯ<br><br>अन्वक्ष<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೂಡಲೆ /ಒಡನೆ<br><br>अन्वक्ष<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯಕ್ಷವಾಗಿ /ಕಣ್ಣಿನೆದುರಿಗೆ<br><b>निष्पत्तिः - </b>अव्ययी०<br><b>व्युत्पत्तिः - </b>अक्ष्णः समीपम्<br><br>

अन्वच्
अन्वच्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸುವ /ಹಿಂಬಾಲಿಸುವ<br><br>अन्वच्<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಹಿಂಭಾಗದಲ್ಲಿ /ಹಿಂದುಗಡೆಯಿಂದ<br><b>निष्पत्तिः - </b>अञ्चु (गतौ) - "क्विन्" (३-२-५९)<br><b>व्युत्पत्तिः - </b>अनु अञ्चति<br><b>प्रयोगाः - </b>"पिदधानमन्वगुपगम्य दृशौ"<br><b>उल्लेखाः - </b>माघ० ९-७६<br><br>अन्वच्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ತರುವಾಯ /ಬಳಿಕ /ಅನಂತರ<br><br>

अन्वय
अन्वय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶ /ಕುಲ<br><b>निष्पत्तिः - </b>अनु + इण् (गतौ) - भावे "अच्" (३-३-५६)<br><b>व्युत्पत्तिः - </b>अन्वीयते<br><b>प्रयोगाः - </b>"तदन्वये शुद्धिमति प्रसूतः शुद्धिमत्तरः"<br><b>उल्लेखाः - </b>रघु० १-१२<br><br>अन्वय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಮವಾದ ಸಂಬಂಧ /ಒಂದು ವಾಕ್ಯದಲ್ಲಿ ಒಂದು ಪದಾರ್ಥಕ್ಕೆ ಮತ್ತೊಂದು ಪದಾರ್ಥದೊಡನೆ ಇರುವ ಸಂಬಂಧ<br><br>अन्वय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಿಸುವಿಕೆ /ಅನುಸರಿಸುವಿಕೆ<br><br>अन्वय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾತ್ಪರ್ಯ /ಅಭಿಪ್ರಾಯ<br><br>अन्वय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಲದಲ್ಲಿ ಜನಿಸಿದವರು<br><b>निष्पत्तिः - </b>अनु + इण् (गतौ) - कर्त० "अच्" (३-३-५६)<br><b>प्रयोगाः - </b>"न जीवन्नेव शूद्रत्वमाशु गच्छति सन्वयः"<br><b>उल्लेखाः - </b>मनु० २-१६८<br><br>अन्वय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ<br><b>प्रयोगाः - </b>"धर्मसूकररूपस्य तवासौ क्षमयान्वये"<br><b>उल्लेखाः - </b>याद० १६-२७<br><br>अन्वय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯಕ್ಷ<br><b>व्युत्पत्तिः - </b>अन्वेति इन्द्रियम्<br><br>अन्वय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾರ್ಕಿಕ ಮತದಲ್ಲಿ ಹೇತು ಸಾಧ್ಯಗಳ ವ್ಯಾಪ್ತಿ<br><br>

अन्वयज्ञ
अन्वयज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಂಶಾವಳಿಯನ್ನರಿತವನು /ವಂಶದ ಚರಿತ್ರೆಯನ್ನು ಬಲ್ಲವನು<br><b>निष्पत्तिः - </b>ज्ञा (अवबोधने) “कः” (३-२-३) ।<br><b>व्युत्पत्तिः - </b>अन्वयं जानाति<br><b>प्रयोगाः - </b>"अथ स्तुते वन्दिभिरवज्ञैः"<br><b>उल्लेखाः - </b>रघु० ६-८<br><br>

अन्वयबोध
अन्वयबोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಬ್ದಬೋಧ /ಪದಾರ್ಥಗಳಿಗೆ ಪರಸ್ಪರ ಇರುವ ಸಂಬಂಧದ ಜ್ಞಾನ<br><br>

अन्वयव्याप्ति
अन्वयव्याप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇತುಸಾಧ್ಯಗಳ ವ್ಯಾಪ್ತಿ<br><b>व्युत्पत्तिः - </b>अन्वयेन व्याप्तिः व्यापनं नियमेन स्थितिः<br><br>

अन्वयागत
अन्वयागत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಂಶಪರಂಪರೆಯಿಂದ ಬಂದ /ಕಾಲಕ್ರಮವಾಗಿ ಬಂದಿರುವ<br><b>व्युत्पत्तिः - </b>अन्वयादागतः<br><b>प्रयोगाः - </b>"श्रुतं शौर्यं तपः कन्या शिष्ययाज्यान्वयागतम् । धनं सप्तविधं शुद्धम्"<br><b>उल्लेखाः - </b>नारदसं०<br><br>

अन्वर्थ
अन्वर्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಥಕ್ಕೆ ಅನುಸಾರವಾದ /ಅರ್ಥವನ್ನು ಅನುಸರಿಸಿ ಬಂದಿರುವ<br><b>व्युत्पत्तिः - </b>अनुगतः अर्थम्<br><b>प्रयोगाः - </b>"तथैव सोभूदन्वर्थो राजा प्रकृतिरञ्जनात्"<br><b>उल्लेखाः - </b>रघु० ४-१२<br><br>

आन्ववसर्ग
आन्ववसर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮಚಾರಾನುಜ್ಞೆ /ಸ್ವೇಚ್ಛೆಯಿಂದ ನಡೆಯಲು ಅಪ್ಪಣೆ<br><b>विस्तारः - </b>"अपि स्तुहि अपि सिञ्च । अन्ववसर्गः कामचारानुज्ञा" - सि० कौ० ।<br><br>

अन्ववाय
अन्ववाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶ /ಸಂತತಿ /ಸಂತಾನ<br><b>निष्पत्तिः - </b>अनु + अव + अय (गतौ) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>अन्ववाय्यते अनुसम्बन्ध्यते<br><b>प्रयोगाः - </b>"प्राह ते नु सदृशि दिवौकसामन्ववायमवदातमाकृतिः"<br><b>उल्लेखाः - </b>किरा० १३-३७<br><br>

अन्वष्टका
अन्वष्टका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾರ್ಗಶೀರ್ಷ ಒದಲು ನಾಲ್ಕು ತಿಂಗಳ ಕೃಷ್ಣ ನವಮಿ<br><br>

अन्वहम्
अन्वहम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿದಿನವೂ /ಪ್ರತಿ ನಿತ್ಯವೂ<br><b>व्युत्पत्तिः - </b>अह्नि अह्नि<br><br>

अन्वाख्यान
अन्वाख्यान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂದೆ ಹೇಳಿದ ವಿಷಯದ ಅರ್ಥವಿವರಣೆ<br><b>निष्पत्तिः - </b>अनु + आ + ख्या (प्रकथने) - "ल्युट्" (३-३-११५)<br><br>

अन्वाचय
अन्वाचय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಖ್ಯವಾದ ಕೆಲಸದೊಡನೆ ಮತ್ತೊಂದು ಗೌಣ ಕೆಲಸವನ್ನೂ ಸಾಧಿಸಲು ಹೇಳುವುದು /ಪ್ರಧಾನಕಾರ್ಯದ ಜೊತೆಯಲ್ಲಿ ಅಪ್ರಧಾನ ಕಾರ್ಯವನ್ನೂ ಮಾಡಲು ಅಪ್ಪಣೆ<br><b>निष्पत्तिः - </b>अनु + आ+ चिञ् (चयने) - "अच्" (३-३-५६)<br><b>व्युत्पत्तिः - </b>प्रधानस्य पश्चात् अन्य आचीयते बोध्यते यत्र<br><br>

अन्वादेश
अन्वादेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಕಾರ್ಯವನ್ನು ಬೋಧಿಸಲು ಹೇಳಿರುವುದನ್ನು ಮತ್ತೊಂದು ಕಾರ್ಯವನ್ನು ಬೋಧಿಸಲು ಮತ್ತೆ ಹೇಳುವುದು<br><b>विस्तारः - </b>"किञ्चित् कार्यं विधातुमुपत्तस्य कार्यान्तरं विधातुं पुनरुपादानमन्वादेशः । अनेन व्याकरणमधीतं एनं छन्दोध्यापय" - सि० कौ० ।<br><br>

अन्वाधान
अन्वाधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞವೇದಿಕೆಯಲ್ಲಿ ಸ್ಥಂಡಿಲಕಲ್ಪಾನಂತರ ಅಗ್ನಿ ಪ್ರತಿಷ್ಠೆ ಮಾಡಿ ಅದರಲ್ಲಿ ಮಾಡುವ ಸಮಿತ್ತುಗಳ ಆಧಾನ<br><b>व्युत्पत्तिः - </b>अनु पश्चात् आधानम्<br><br>

अन्वाधि
अन्वाधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನಲ್ಲಿಟ್ಟಿದ್ದ ವಸ್ತು ಅಥವಾ ಧನವನ್ನು ಅದರ ಯಜಮಾನನಿಗೆ ಕೊಡಲು ಮತ್ತೊಬ್ಬನಲ್ಲಿಡುವುದು<br><b>निष्पत्तिः - </b>अनु + आ+ डुधाञ् (धारणपोषणयोः) - "किः" (३-३-९२)<br><b>व्युत्पत्तिः - </b>अनु पश्चात् आधीयते<br><b>प्रयोगाः - </b>"अर्थमार्गणकार्येषु अन्यस्मिन् वचनान्मम । दद्यास्त्वमिति यो दत्तः स इहानधिरुच्यते ॥"<br><b>उल्लेखाः - </b>कात्या०<br><br>अन्वाधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಶ್ಚಾತ್ತಾಪ<br><br>

अन्वाधेय
अन्वाधेय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹಾನಂತರ ವಧುವಿಗೆ ಪತಿಗೃಹದಲ್ಲಿಯೂ ಪಿತೃಗೃಹದಲ್ಲಿಯೂ ಕೊಡಲ್ಪಟ್ಟ ಹಣ /ಸ್ತ್ರೀಧನ<br><b>प्रयोगाः - </b>"विवाहात्परतो यत्तु लब्धं भर्तृकुले स्त्रिया । अन्वाधेयं तदुक्तं तु लब्धं बन्धुकुले तथा ॥"<br><b>उल्लेखाः - </b>कात्या०<br><br>

अन्वायतन
अन्वायतन<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮನೆಯಲ್ಲಿ /ಮನೆಯೊಳಗೆ /ಮನೆಯ ಮಧ್ಯದಲ್ಲಿ<br><br>

अन्वारब्ध
अन्वारब्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾಗಾದಿಗಳ ಫಲವು ತನಗೂ ಲಭಿಸಲು ಯಜಮಾನನ್ನು ಸ್ಪರ್ಶಮಾಡಿಕೊಂಡು ಕುಳಿತಿರುವ<br><br>अन्वारब्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೇಹದಲ್ಲಿ ಇಡಲ್ಪಟ್ಟ<br><br>अन्वारब्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸಲ್ಪಟ್ಟ<br><br>

अन्वारम्भ
अन्वारम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗಾದಿಗಳ ಫಲವು ತನಗೂ ಲಭಿಸಲು ಯಜಮಾನನ್ನು ಸ್ಪರ್ಶಮಾಡಿಕೊಂಡು ಕೂಡುವುದು<br><br>

अन्वारूढ
अन्वारूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಲ್ಪಟ್ಟ<br><br>अन्वारूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಂತರ ಹತ್ತಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + अआ + रुह (बीजजन्मनि प्रादुर्भावे च) - "क्तः" (३-२-१०२)<br><br>

अन्वारोह
अन्वारोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪತಿಯ ಮರಣಾನಂತರ ಪತ್ನಿಯ ಸಹಗಮನ<br><b>व्युत्पत्तिः - </b>अनु पश्चात् आरोहः<br><br>

अन्वासन
अन्वासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವೆ /ಶುಶ್ರೂಷೆ<br><br>अन्वासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಂತರ ಕುಳಿತುಕೊಳ್ಳುವುದು<br><br>अन्वासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದುಃಖ /ಶೋಕ<br><br>अन्वासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಗಾರಿಕೆಯ ಶಾಲೆ<br><br>अन्वासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಸ್ತಿಕ್ರಿಯೆ<br><b>विस्तारः - </b>"अन्वासनं स्नेहवस्तौ सेवायामनुशोचने" - हेम० ।<br><br>

अन्वासित
अन्वासित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಂತರ ಕುಳಿತು ಕೊಳ್ಳೋಣದರಿಂದ ಗೌರವಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + आस (उपवेशने) - कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अन्वासितमरुन्धत्या स्वाहयेव हविर्भुजम्"<br><b>उल्लेखाः - </b>रघु० १-५६<br><br>

अन्वासीन
अन्वासीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಂತರ ಕುಳಿತುಕೊಂಡ /ಗುರುಹಿರಿಯರು ಕುಳಿತ ಮೇಲೆ ಕುಳಿತುಕೊಂಡ<br><b>व्युत्पत्तिः - </b>अनु पश्चात् आसीनः<br><br>

अन्वाहार्य
अन्वाहार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗದಲ್ಲಿ ಪುರೋಹಿತನಿಗೆ ಕೊಡುವ ದಾನ /ಕಾಣಿಕೆ /ದಕ್ಷಿಣೆ<br><br>अन्वाहार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಸಿಕ ಶ್ರಾದ್ಧ /ಪ್ರತಿ ತಿಂಗಳಲ್ಲಿಯೂ ನಡೆಸುವ ಶ್ರಾದ್ಧ<br><b>निष्पत्तिः - </b>अनु + आ + हृञ् (हरणे) - "ण्यत्" (३-१-१२४)<br><b>विस्तारः - </b>"अन्वाहार्यममावास्याश्राद्धमिष्टेश्च दक्षिणा" - हेम० ।<br><br>

अन्वित
अन्वित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧಿಸಲ್ಪಟ್ಟ<br><br>अन्वित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇರಿಸಲ್ಪಟ್ಟ<br><br>अन्वित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + इण् (गतौ) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"स वृत्तचूलश्चलकाकपक्षकैरमात्यपुत्रैः सवयोभिरन्वितः"<br><b>उल्लेखाः - </b>रघु० ३-२६<br><br>

अन्विष्ट
अन्विष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಡುಕಲ್ಪಟ್ಟ /ಶೋಧಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + इषु (इच्छायाम्) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"यद्वायुरन्विष्टमृगैः किरातैः"<br><b>उल्लेखाः - </b>कुमा० १-१५<br><br>अन्विष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಟ್ಟ<br><br>

अन्वीक्षा
अन्वीक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ಯಾಲೋಚನೆ /ಚಿಂತನೆ<br><br>अन्वीक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಂತನೆ ಆಲೋಚನೆ<br><br>

अन्वेष
अन्वेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಡುಕುವುದು<br><br>अन्वेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧ್ಯಾನ /ಚಿಂತನೆ<br><b>निष्पत्तिः - </b>अनु + इषु (इच्छायाम्) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"वयं तत्त्वान्वेषान्मधुकर हतास्त्वं खलु कृती"<br><b>उल्लेखाः - </b>शाकु० १-२४<br><br>

अन्वेषण
अन्वेषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹುಡುಕುವುದು<br><b>प्रयोगाः - </b>"रन्ध्रान्वेषणदक्षाणां द्विषामामिषतां ययौ"<br><b>उल्लेखाः - </b>रघु० १२-११<br><br>अन्वेषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧ್ಯಾನ /ಚಿಂತನೆ<br><br>

अन्वेषणा
अन्वेषणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹುಡುಕುವುದು<br><b>निष्पत्तिः - </b>अनु + इष (गतौ) - "युच्" (३-३-१०७)<br><br>अन्वेषणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಧ್ಯಾನ /ಚಿಂತನೆ /ತತ್ತ್ವಾನುಸಂಧಾನ<br><br>

अन्वेषित
अन्वेषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಡುಕಲ್ಪಟ್ಟ<br><br>अन्वेषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಂತಿಸಲ್ಪಟ್ಟ /ಧ್ಯಾನಿಸಲ್ಪಟ್ಟ<br><br>अन्वेषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಮರ್ಶಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अनु + एषृ (गतौ) - "क्तः" (३-२-१०२)<br><br>

अन्वेषितृ
अन्वेषितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಡುಕುವ /ಶೋಧಿಸುವ<br><b>निष्पत्तिः - </b>अनु + एषृ (गतौ) - "तृन्" (३-२-१३५)<br><br>

अन्वेषिन्
अन्वेषिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಡುಕುವ<br><b>निष्पत्तिः - </b>अनु + इषु (इच्छायाम्) - "णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"तौ सीतान्वेषिणौ गृध्रं लूनपक्षमपश्यताम्"<br><b>उल्लेखाः - </b>रघु० १२-५४<br><br>

अन्वेषिणी
अन्वेषिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹುಡುಕುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अन्वेष्टृ
अन्वेष्टृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಡುಕುವವನು<br><b>निष्पत्तिः - </b>अनु + इषु (इच्छायाम्) - "तृच्" (३-१-१३३)<br><br>

अप्
अप्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು /ಜಲ<br><b>निष्पत्तिः - </b>आप्लृ (व्याप्तौ) - "क्विप्" ह्रस्वश्च (उ० २-५१)<br><b>प्रयोगाः - </b>"अप एव ससर्जादौ तासु वीर्यमवासृजत्"<br><b>उल्लेखाः - </b>मनु० १-८<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>

अप
अप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿಯೋಗ /ಅಗಲಿಕೆ<br><b>प्रयोगाः - </b>अपयाति । अपसरति ।<br><br>अप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಚೌರ್ಯ /ಕಳ್ಳತನ<br><b>प्रयोगाः - </b>अपहरति ।<br><br>अप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸತ್ಯವನ್ನಡಗಿಸುವುದು /ಮರೆ ಮಾಚುವುದು<br><b>प्रयोगाः - </b>अपलपति । अपवदति ।<br><br>अप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪರಿಹಾಸ್ಯ /ಕುಚೋದ್ಯ<br><b>प्रयोगाः - </b>अपहसति ।<br><br>अप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವರ್ಜಿಸುವುದು /ತಳ್ಳಿ ಹಾಕುವುದು<br><b>प्रयोगाः - </b>अपविष्णु संसारः ।<br><br>अप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೀನದೆಶೆ ಹೊಂದುವುದು /ಕ್ಷೀಣವಾಗುವುದು<br><b>प्रयोगाः - </b>अपचयः ।<br><br>अप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿಪರೀತ /ವಿರೋಧ<br><b>प्रयोगाः - </b>अपशब्दः ।<br><br>अप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿದರ್ಶನ /ನಿರ್ದೇಶ ಮಾಡುವುದು<br><b>प्रयोगाः - </b>अपदिशति ।<br><br>अप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಪಕರ್ಷ /ಕೀಳುತನ<br><b>प्रयोगाः - </b>अपकर्म ।<br><br>अप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೆಳಗಡೆ /ಕೆಳಮುಖ<br><b>प्रयोगाः - </b>अपानः ।<br><br>अप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷ /ಆನಂದ<br><b>विस्तारः - </b>वर्जने विकृतौ चौर्ये विपरीतवियोगयोः । अपकृष्टे च निर्देशे हर्षे चापः प्रयुज्यते" ।<br><br>

अपकर्तृ
अपकर्तृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರು /ಹಗೆ<br><b>निष्पत्तिः - </b>अप + डुकृञ् (करणे) - "तृच्" (३-१-१३३)<br><br>अपकर्तृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಕಾರ ಮಾಡುವ /ಹಾನಿಯುಂಟುಮಾಡುವ<br><br>

अपकर्त्री
अपकर्त्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अपकर्तृ ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अपकर्मन्
अपकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಕೆಲಸ<br><br>अपकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಾನ ಮಾಡಿದುದನ್ನು ಕೋಪದಿಂದಾಗಲಿ ದಾನ ತೆಗೆದುಕೊಂಡವನು ಅಯೋಗ್ಯನೆಂಬ ಕಾರಣದಿಂದಾಗಲೀ ಹಿಂದಕ್ಕೆ ತೆಗೆದುಕೊಳ್ಳೂದು<br><br>अपकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಂಡ ಹಣವನ್ನು ಹಿಂದಕ್ಕೆ ತಿರುಗಿಸುವುದು /ಸಾಲ ತೀರಿಸುವುದು<br><b>प्रयोगाः - </b>"तेषामाद्यमृणादानं निक्षेपोऽस्वामिविक्रयः । सम्भूय च समुत्थानं दत्तस्यानपकर्म च ॥"<br><b>उल्लेखाः - </b>मनु० ८-४<br><br>

अपकर्ष
अपकर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆದುಕೊಳ್ಳುವುದು /ಹಿಂದಕ್ಕೆ ತೆಗೆದುಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>अप + कृष (विलेखने) - "घञ्" (३-३-१८)<br><br>अपकर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಣದಲ್ಲಿ ಕಡಿಮೆಯಾಗುವುದು /ಹೀನವಾಗುವುದು /ಕೀಳುತನ<br><br>अपकर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂದೆ ಮಾಡಬೇಕಾದ ಶ್ರಾದ್ಧಾದಿ ಕಾರ್ಯವನ್ನು ಮುಂಚಿತವಾಗಿ ಮಾಡುವುದು<br><br>अपकर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣದಲ್ಲಿ ಮುಂದಿನ ಸೂತ್ರಗಳ ಪದಗಳನ್ನು ಹಿಂದಿನ ಸೂತ್ರಾರ್ಥಾನ್ವಯಕ್ಕಾಗಿ ಎಳೆದುಕೊಳ್ಳುವುದು<br><br>

अपकर्षक
अपकर्षक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯುವ /ಹಿಂದಕ್ಕೆ ತೆಗೆದುಕೊಳ್ಳುವ<br><br>अपकर्षक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುಣದಲ್ಲಿ ಕಡಮೆ ಮಾಡುವ /ಹೀನವಾಗಿ ಮಾಡುವ<br><b>निष्पत्तिः - </b>अप + कृष (विलेखने) - "ण्वुल्" (३-१-१३३)<br><b>प्रयोगाः - </b>"दोषास्तस्य काव्यस्य अपकर्षकाः"<br><b>उल्लेखाः - </b>सा० द० १-३<br><br>

अपकर्षण
अपकर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆದುಕೊಳ್ಳುವುದು /ಹಿಂದಕ್ಕೆ ತೆಗೆದುಕೊಳ್ಳುವುದು<br><br>अपकर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಣದಲ್ಲಿ ಕಡಮೆ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>अप + कृष (विलेखने) - "ल्युट्" (३-३-११५)<br><br>अपकर्षण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆದುಕೊಳ್ಳುವ /ಹಿಂದಕ್ಕೆ ತೆಗೆದುಕೊಳ್ಳುವ<br><br>अपकर्षण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುಣದಲ್ಲಿ ಕಡಮೆ ಮಾಡುವ /ಹೀನವಾಗಿ ಮಾಡುವ<br><b>निष्पत्तिः - </b>अप + कृष (विलेखने) - "ल्युः" (३-१-१३४)<br><br>

अपकार
अपकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಡುಕು /ಹಿಂಸೆ<br><b>निष्पत्तिः - </b>अप + डुकृञ् (करणे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"उपकारापकारौ हि लक्ष्यं लक्षणमेतयोः"<br><b>उल्लेखाः - </b>माघ० २-३७<br><br>अपकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಡುಕು ಮಾಡುವ ಅಪೇಕ್ಷೆ /ಕೇಡು ಬಯಸುವುದು<br><br>अपकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇತರರನ್ನು ಪೀಡಿಸುವುದು<br><b>विस्तारः - </b>"अपकारः परपीडनम्" - वैज० ।<br><br>

अपकारगिर्
अपकारगिर्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಡುಂಟುಮಾಡುವೆನೆಂಬ ಬೆದರಿಕೆಯ ಮಾತು /ಭಯೋತ್ಪಾದಕ ವಚನ<br><b>निष्पत्तिः - </b>गॄ (निगरणे) - "क्विप्"<br><b>व्युत्पत्तिः - </b>अपकारेण गीर्यते<br><br>

अपकारिन्
अपकारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಕಾರ ಮಾಡುವ<br><br>अपकारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಕಾರವನ್ನು ಬಯಸುವ /ಕೆಡುಕನ್ನು ಯೋಚಿಸುವ<br><b>निष्पत्तिः - </b>अप + डुकृञ् (करणे) - "णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"उपकर्त्रारिणा सन्धिर्न मित्रेणापकारिणा"<br><b>उल्लेखाः - </b>माघ० २-३७<br><br>

अपकृत
अपकृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಕಾರ /ಕೆಡುಕು<br><b>निष्पत्तिः - </b>अप + डुकृञ् (करणे) - भावे "क्तः" (३-३-११४)<br><br>अपकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಂದರೆ ಪಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अप + डुकृञ् (करणे) - कर्म० "क्तः" (३-२-१०२)<br><br>

अपकृति
अपकृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಕಾರ /ಕೆಡುಕು<br><br>अपकृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಡುಕನ್ನು ಮಾಡುವ ಯೋಚನೆ<br><b>निष्पत्तिः - </b>अप + डुकृञ् (करणे) - "क्तिन्" (३-३-९४)<br><br>

अपकृत्य
अपकृत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಕಾರ /ಕೆಡುಕು<br><b>निष्पत्तिः - </b>अप + डुकृञ् (करणे) - भावे "क्यप्" (३-१-१२०)<br><br>अपकृत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಕೃತ್ಯ /ನಿಂದ್ಯವಾದ ಕೆಲಸ<br><b>व्युत्पत्तिः - </b>अपकृष्टं कृत्यम्<br><br>

अपकृत्या
अपकृत्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಕಾರ /ಕೆಡುಕು<br><b>निष्पत्तिः - </b>अप + डुकृञ् (करणे) - भावे "क्यप्" (३३-१००)<br><br>

अपकृष्ट
अपकृष्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯಸ /ಕಾಗೆ<br><b>विस्तारः - </b>"शक्रजः सत्यवाक्काणोऽपक्र्ष्टो नगरीबकः" - त्रिकाण्ड० ।<br><br>अपकृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀಚವಾದ /ಹೀನವಾದ<br><br>अपकृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂಚಿತವಾಗಿ ಮಾಡಲ್ಪಟ್ಟ<br><br>अपकृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯಲ್ಪಟ್ಟ<br><br>अपकृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದಿನ ಸೂತ್ರದಿಂದ ಹಿಂದಿನ ಸೂತ್ರಾರ್ಥಾನ್ವಯಕ್ಕಾಗಿ ತೆಗೆದುಕೊಳ್ಳಲ್ಪಟ್ಟ ಪದ<br><br>

अपक्रम
अपक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಲಾಯನ /ಓಡಿ ಹೋಗುವುದು<br><b>निष्पत्तिः - </b>अप + क्रमु (पादविक्षेपे) - भावे "घञ्" (३-३-१८)<br><br>अपक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಓಡಿ ಹೋಗುವ ಸ್ಥಳದ ಎಲ್ಲೆ<br><b>निष्पत्तिः - </b>अप + क्रमु (पादविक्षेपे) - कर्म० "घञ्" (३-३-१९)<br><b>प्रयोगाः - </b>"विक्षिपत्येष विक्षेपं चन्द्रादीनामपक्रमात्"<br><b>उल्लेखाः - </b>सू० सि०<br><br>अपक्रम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಕ್ರಮವಾದ /ಕ್ರಮತಪ್ಪಿದ<br><b>व्युत्पत्तिः - </b>अपगतः क्रमो यस्मात्<br><br>

अपक्रमण
अपक्रमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಓಟ /ಪಲಾಯನ<br><b>निष्पत्तिः - </b>अप + क्रमु (पादविक्षेपे) - भावे "ल्युट्" (३-३-११५)<br><br>

अपक्रिया
अपक्रिया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಕಾರ /ಕೆಡುಕು<br><b>निष्पत्तिः - </b>अप + डुकृञ् (करणे) - "शः" (३-३-१००)<br><b>प्रयोगाः - </b>"चतुर्थोपायसाध्ये तु रिपौ सान्त्वमपक्रिया"<br><b>उल्लेखाः - </b>माघ० २-५४<br><br>

अपक्रोश
अपक्रोश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ<br><b>निष्पत्तिः - </b>अप + क्रुश (आह्वाने रोदने च) - "घञ्" (३-३-१८)<br><br>

अपक्रोशन
अपक्रोशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

अपक्व
अपक्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಲಿಯದ /ಮಾಗದಿರುವ<br><br>अपक्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇಯಿಸಲ್ಪಡದ /ಹಸಿಯಾದ<br><br>

अपक्ष
अपक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೆಕ್ಕೆಯಿಲ್ಲದ<br><br>अपक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಹಾಯವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति पक्षो गरुत् सहायो वा यस्य<br><br>

अपक्षपात
अपक्षपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಷ್ಪಕ್ಷಪಾತ /ನ್ಯಾಯ ಸಮದೃಷ್ಟಿ<br><br>

अपक्षपातिन्
अपक्षपातिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಕ್ಷಪಾತವಿಲ್ಲದ /ನಿಷ್ಪಕ್ಷಪಾತ /ನ್ಯಾಯ ಸಮದೃಷ್ಟಿ<br><br>

अपक्षय
अपक्षय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಡಮೆಯಾಗುವುದು /ಕ್ಷೀಣವಾಗುವುದು<br><br>

अपक्षेपण
अपक्षेपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಹಾಕುವುದು /ಕೆಳಕ್ಕೆ ಎಸೆಯುವುದು<br><br>अपक्षेपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಗೆ ಇಡುವುದು<br><br>

अपगण्ड
अपगण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಶು /ಬಾಲಕ<br><br>

अपगत
अपगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಲಾಯನ ಮಾಡಿದ /ಓಡಿ ಹೋದ<br><br>अपगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊರಟುಹೋದ /ಕಳೆದು ಹೋದ<br><b>निष्पत्तिः - </b>अप + गम्लृ (गतौ) - कर्त० "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"अपगतनवयावकैश्चिराय"<br><b>उल्लेखाः - </b>माघ० ७-६७<br><br>

अपगम
अपगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಲಾಯನ /ಓಡಿ ಹೋಗುವುದು<br><br>अपगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೋಗುವುದು /ಹೊರಡುವುದು<br><br>अपगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅದೃಶ್ಯವಾಗುವುದು /ಕಣ್ಣಿಗೆ ಕಾಣಿಸದಿರುವುದು<br><b>निष्पत्तिः - </b>अप + गम्लृ (गतौ) - भावे "अप्" (३-३-५८)<br><b>प्रयोगाः - </b>"पुराणपत्रापगमादनन्तरं लतेव सन्नद्धमनोज्ञपल्लवा"<br><b>उल्लेखाः - </b>रघु० ३-७<br><br>अपगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗತಿಸಿ ಹೋಗುವುದು /ತೀರಿ ಹೋಗುವುದು<br><br>

अपगति
अपगति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ದೈವ<br><br>

अपगर
अपगर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ<br><br>

अपगुण
अपगुण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರ್ಗುಣ /ಗುಣಶೂನ್ಯ<br><b>व्युत्पत्तिः - </b>अपगता गुणा यस्मात्<br><b>प्रयोगाः - </b>"व्यक्तमपगुण गुणत्रितयत्यजनप्रयासमुपयासि किं मुधा"<br><b>उल्लेखाः - </b>माघ० १५-३२<br><br>

अपगुरण
अपगुरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದ್ರೋಹ /ವಂಚನೆ<br><b>निष्पत्तिः - </b>अप + गुरी (उद्यमने) - "ल्युट्" (३-३-११५)<br><br>

अपघन
अपघन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗ /ಅವಯವ<br><b>निष्पत्तिः - </b>अप + हन (हिंसागत्योः) - "अप्" (३-३-८१)<br><b>व्युत्पत्तिः - </b>अपहन्यते<br><b>विस्तारः - </b>"अङ्गं प्रतीकोऽवयववोऽपघनः" - अम० ।<br><br>अपघन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೋಡವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>अपगतो घनो यस्मात्<br><br>

अपघात
अपघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾನಿ /ತೊಂದರೆ<br><br>अपघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುರಂತ /ಮರಣಕ್ಕೆ ಕಾರಣವಾದ<br><b>निष्पत्तिः - </b>अप + हन (हिंसागत्योः) - भावे "घञ्" (३-३-१८)<br><br>

अपच
अपच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಡಿಗೆ ಮಾಡಲು ಶಕ್ತಿಯಿಲ್ಲದವನು<br><b>निष्पत्तिः - </b>६-२-१५७<br><b>व्युत्पत्तिः - </b>पक्तुमशक्यः<br><br>अपच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯನಾದ ಅಡಿಗೆಯವನು<br><b>विस्तारः - </b>"अपचो जाल्मः" - सि० कौ० ।<br><br>

अपचय
अपचय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಡಮೆಯಾಗುವುದು /ಕ್ಷೀಣವಾಗುವುದು<br><b>निष्पत्तिः - </b>अप + चिञ् (चयने) - "अच्" (३-३-५६)<br><b>प्रयोगाः - </b>"तेनास्यापचयं यान्ति व्याधेर्मूलान्यशेषतः"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>अपचय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಷ್ಟ<br><br>अपचय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾನಿ /ತೊಂದರೆ<br><br>

अपचरित
अपचरित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಕಾರ್ಯ /ಕೆಟ್ಟ ಕೆಲಸ<br><b>व्युत्पत्तिः - </b>अपकृष्टं चरितम्<br><b>प्रयोगाः - </b>"आहोस्वित्प्रसवो ममापचरितैर्विष्टम्भितो वीरुधाम्"<br><b>उल्लेखाः - </b>शाकु० ५-९<br><br>

अपचायित
अपचायित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अप + चायृ (पूजानिशामनयोः) - "क्तः" (३-२-१०२)<br><br>

अपचार
अपचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪರಾಧ /ತಪ್ಪು<br><b>निष्पत्तिः - </b>अप + चर (गतौ) - भावे "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"राजन् प्रजासु ते कश्चिदपचारः प्रवर्तते"<br><b>उल्लेखाः - </b>रघु० १५-४७<br><br>अपचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶ<br><br>अपचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿರ್ಗಮನ /ಪ್ರಯಾಣ<br><br>अपचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೋಪ /ಕರ್ಮಾಚರಣೆಯಲ್ಲಿ ವಿಷಯ ವೈಪರೀತ್ಯದಿಂದುಂಟಾಗುವ ದೋಷ<br><br>अपचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಥ್ಯ /ಆಹಾರ ನಿಯಮದ ಉಲ್ಲಂಘನೆ<br><b>प्रयोगाः - </b>"कृतापचारोऽपि परैरनाविष्कृतविक्रियः"<br><b>उल्लेखाः - </b>माघ० २-८४<br><br>

अपचारिन्
अपचारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಪ್ಪು ಕೆಲಸ ಮಾಡುವ /ಅಪರಾಧ ಮಾಡುವ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>अप + चर (गतौ) - "घिनुण्" (३-२-१४२)<br><br>

अपचारिणी
अपचारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಪ್ಪು ಕೆಲಸ ಮಾಡುವ /ಅಪರಾಧ ಮಾಡುವ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अपचिकीर्षा
अपचिकीर्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಕಾರ ಮಾಡುವ ಅಪೇಕ್ಷೆ /ಕೆಡುಕನ್ನುಂಟುಮಾಡುವ ಅಭಿಲಾಷೆ<br><b>निष्पत्तिः - </b>अप + डुकृञ् (करणे) + सन् - "अः" (३-३-१-२)<br><b>व्युत्पत्तिः - </b>अपकर्तुमिच्छा<br><br>

अपचिकीर्षु
अपचिकीर्षु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಕಾರ ಮಾಡುವ ಅಪೇಕ್ಷೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>अप + डुकृञ् (करणे) + सन् - "उः" (३-२-१६८)<br><br>

अपचित
अपचित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೌರವ /ಮರ್ಯಾದೆ<br><b>निष्पत्तिः - </b>अप + चायृ (पूजानिशामनयोः) + णिच् - चिभावः + "क्तः" (३-३-११४)<br><br>अपचित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಟ್ಟ /ಗೌರವಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कर्म० "क्तः" (७-२-३०) निपा० ।<br><br>अपचित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಡಮೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कर्म० "क्तः" (३-२-१०२)<br><br>

अपचिति
अपचिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ /ಗೌರವ<br><b>निष्पत्तिः - </b>अप + चायृ (पूजानिशामनयोः) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"आशंसितापचितिचारु पुरः सुराणाम्"<br><b>उल्लेखाः - </b>किरा० ६-४६<br><br>अपचिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಯ /ಖರ್ಚು<br><br>अपचिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಡಮೆಯಾಗುವುದು /ಕ್ಷೀಣವಾಗುವುದು<br><br>अपचिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶ /ಹಾನಿ<br><br>अपचिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಯಶ್ಚಿತ್ತ<br><b>विस्तारः - </b>अपचितिर्व्यये हानौ पूजायां निष्कृतावपि" - हेम० ।<br><br>

अपचीयमान
अपचीयमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಡಮೆಯಗುತ್ತಿರುವ /ನಾಶ ಹೊಂದುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>अप + चिञ् (चयने) - "शानच्" (३-२-१२४)<br><br>

अपच्छाय
अपच्छाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><br>अपच्छाय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೆರಳಿಲ್ಲದ<br><br>अपच्छाय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಂತಿಯಿಲ್ಲದ<br><br>

अपजय
अपजय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಾಜಯ /ಸೋಲು<br><b>निष्पत्तिः - </b>अप + जि (जये० - "अच्" (३-३-५६)<br><br>

अपजर
अपजर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><b>व्युत्पत्तिः - </b>अपगता जरा यस्मात्<br><br>अपजर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಪ್ಪಿಲ್ಲದ<br><br>

अपजात
अपजात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಮಗ /ಅಯೋಗ್ಯನಾದ ಮಗ<br><b>प्रयोगाः - </b>"मातृतुल्यगुणो जातस्त्वनुजातः पितुः समः । अतिजातोऽधिकस्तस्मादपजातोऽधमाधमः ॥"<br><br>

अपञ्चीकृत
अपञ्चीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಂಚೀಕರಣ ಮಾಡಲ್ಪಡದ<br><br>

अपटान्तर
अपटान्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇರಿಕೊಂಡಿರುವ /ವ್ಯವಧಾನವಿಲ್ಲದ /ಮಧ್ಯೆ ತಡೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न पटेन अन्तरमत्र<br><br>

अपटमन्
अपटमन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಮರ್ಥತೆ /ಚಟುವಟ್ಕೆಯಿಲ್ಲದಿರುವಿಕೆ /ಮಂಕುತನ<br><b>निष्पत्तिः - </b>अपटु - "इमनिच्" (५-१-१२२)<br><br>

अपटी
अपटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೆರೆ /ಪರದೆ /ಜವನಿಕೆ<br><b>व्युत्पत्तिः - </b>अल्पः पटः अपटः । न पटी ।<br><br>

अपटीक्षेप
अपटीक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೆರೆಯನ್ನು ಪಕ್ಕಕ್ಕೆ ತಳ್ಳುವುದು<br><b>व्युत्पत्तिः - </b>अपट्याः काण्डपटस्य क्षेपः<br><br>

अपटु
अपटु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಮರ್ಥವಿಲ್ಲದ /ಶಕ್ತಿಯಿಲ್ಲದ<br><br>अपटु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಕ್ಷತೆಯಿಲ್ಲದ /ನೈಪುಣ್ಯವಿಲದ /ಜಾಣ್ಮೆಯಿಲ್ಲದ<br><b>प्रयोगाः - </b>"सा क्रान्ता जघनस्थलेन गुरुणा गन्तुं न शक्ता वयं दोषैरन्यजनाश्रयैरपटवो जाताः स्म इत्यद्भुतम्"<br><b>उल्लेखाः - </b>अमरु०<br><br>अपटु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೋಗಿ<br><b>व्युत्पत्तिः - </b>न पटुः<br><br>

अपण्डित
अपण्डित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂರ್ಖ /ಅಜ್ಞಾನಿ<br><b>प्रयोगाः - </b>"विभूषणं मौनमपण्डितानाम्"<br><b>उल्लेखाः - </b>भर्तृ० २-६<br><br>

अपण्य
अपण्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಕ್ರಯಿಸಲು ಅರ್ಹವಲ್ಲದ /ಮಾರಲು ಯೋಗ್ಯವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न पण्यः<br><br>

अपतन्त्रक
अपतन्त्रक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ವಾಯು ರೋಗ /ವೈದ್ಯನಿಗೆ ಸ್ವಾಧೀನವಾಗದ ರೋಗ<br><b>व्युत्पत्तिः - </b>अपगतं तन्त्रकं भिषजामधीनता यत्र<br><b>प्रयोगाः - </b>"अपतन्त्रकातुरं नापतर्पयेत्"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

अपतर्पण
अपतर्पण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪವಾಸ<br><br>अपतर्पण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೃಪ್ತಿಯಿಲ್ಲದಿರುವಿಕೆ<br><br>

अपतानक
अपतानक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ವಾಯುರೋಗ /ಬಿಟ್ಟು ಬಿಟ್ಟು ಬರುವ ವಾಯುರೋಗ /ಮೂರ್ಚ್ಛೆ ರೋಗ<br><b>निष्पत्तिः - </b>तनु (विस्तारे) - कर्त० "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>अपक्रम्य अन्तरान्तरा तनुते<br><br>

अपति
अपति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಡನಿಲ್ಲದ ಹೆಂಗಸು<br><br>

अपतिका
अपतिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಡನಿಲ್ಲದ ಹೆಂಗಸು<br><br>

अपत्नी
अपत्नी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮದುವೆ ಇಲ್ಲದ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>"नः" (४-१-३४) । "ङीप्" (४-१-५)<br><b>व्युत्पत्तिः - </b>नास्ति पतिः यस्याः<br><br>

अपत्नीक
अपत्नीक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರ್ಮಗಳಿಗೆ ಅನರ್ಹಳಾದ ಪತ್ನಿಯುಳ್ಳವನು<br><br>अपत्नीक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪತ್ನಿಯನ್ನು ಕಳೆದುಕೊಂಡವನು<br><br>अपत्नीक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪತ್ನಿಯು ಸಮೀಪದಲ್ಲಿಲ್ಲದೆ ಮಾಡುವ ಕಾರ್ಯ<br><br>

अपत्य
अपत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂತತಿ /ಸಂತಾನ<br><b>निष्पत्तिः - </b>पत्लृ (गतौ) कर० "यक्" (उ० ४-१११)<br><b>व्युत्पत्तिः - </b>न पतन्ति पितरो नरकेऽनेन<br><b>प्रयोगाः - </b>"अपत्यभावमापन्नमात्मानममृतोदधेः" । "अपत्यैरिव नीवारभागधेयोचितैर्मृगैः" ।<br><b>उल्लेखाः - </b>याद० १६-२, रघु० १-५०<br><br>अपत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಗೋತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದ ಮೊಮ್ಮಗ ಮತ್ತು ಮುಂದಿನ ಪ್ರಜೆ<br><br>

अपत्यद
अपत्यद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತಾನವನ್ನು ಕೊಡುವ /ಮಕ್ಕಳನ್ನು ಕೊಡುವ ಮಂತ್ರ ಮುಂತಾದುದು<br><b>व्युत्पत्तिः - </b>अपत्यं तद्धेतुं गर्भं ददाति<br><br>

अपत्यदा
अपत्यदा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ಭೋತ್ಪತ್ತಿ ಮಾಡುವ ಔಷಧ<br><br>अपत्यदा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ಭೋತ್ಪತ್ತಿ ಮಾಡುವ ವಿದ್ಯೆ /ಮಂತ್ರ<br><br>

अपत्यपथ
अपत्यपथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸರ ಗುಹ್ಯಸ್ಥಾನ<br><b>निष्पत्तिः - </b>"अः" (५-४-७४) ।<br><b>व्युत्पत्तिः - </b>अपत्यस्य पन्थाः<br><br>

अपत्यशत्रु
अपत्यशत्रु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ /ಹಾವು<br><b>व्युत्पत्तिः - </b>अपत्यस्य शत्रुः<br><br>अपत्यशत्रु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ನಳ್ಳಿ<br><br>अपत्यशत्रु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೇಳು<br><b>व्युत्पत्तिः - </b>अपत्यं शत्रुः यस्याः<br><br>

अपत्र
अपत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಕುರ /ಮೊಳಕೆ<br><br>अपत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿದಿರಿನ ಚಿಗುರು<br><br>अपत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಲೆಗಳಿಲ್ಲದ ಮರ<br><br>अपत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೆಕ್ಕೆಗಳಿಲ್ಲದ ಹಕ್ಕಿ<br><b>व्युत्पत्तिः - </b>नास्ति पत्रं दलं पक्षो वा यस्य<br><br>

अपत्रप
अपत्रप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲಜ್ಜೆಯಿಲ್ಲದ /ನಾಚಿಕೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>अपगता त्रपा यस्मात्<br><br>

अपत्रपा
अपत्रपा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಜ್ಜೆ /ನಾಚಿಕೆ<br><b>निष्पत्तिः - </b>अप + त्रपूष् (लज्जायाम्) - भावे "अङ्" (३-३-१०४)<br><b>प्रयोगाः - </b>"अपत्रपामप्सरसामकार्षीत्"<br><b>उल्लेखाः - </b>याद० १८-५५<br><br>अपत्रपा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೊಬ್ಬರ ದೆಸೆಯಿಂದ ಉಂಟಾಗುವ ಲಜ್ಜೆ<br><b>प्रयोगाः - </b>"पत्रपाविप्लुतचेतसो ये"<br><b>उल्लेखाः - </b>याद० १३-७६<br><br>

अपत्रपिष्णु
अपत्रपिष्णु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲಜ್ಜೆಯುಳ್ಳ /ನಾಚಿಕೆಯ ಸ್ವಭಾವದ /ಸಂಕೋಚ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>अप + त्रपूष् (लज्जायाम्) - "इष्णुच्" (३-२-१३६)<br><b>व्युत्पत्तिः - </b>अपत्रपते<br><b>प्रयोगाः - </b>"लोलाक्षे सुरतगुरावपत्रपिष्णोः"<br><b>उल्लेखाः - </b>माघ० ८-४६<br><br>

अपथ
अपथ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಮಾರ್ಗ /ಕೆಟ್ಟ ದಾರಿ<br><br>अपथ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಪ್ಪು ದಾರಿ /ದುರ್ನಡತೆ<br><br>अपथ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾರಿಯಿಲ್ಲದ ದೇಶ<br><b>निष्पत्तिः - </b>"अः" (५-४-७२) ।<br><b>व्युत्पत्तिः - </b>न पन्थाः<br><b>प्रयोगाः - </b>"अपथे पदमर्पयन्ति हि श्रुतवन्तोऽपि रजोनिमीलिताः"<br><b>उल्लेखाः - </b>रघु० ९-७४<br><br>अपथ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಪ್ಪು ದಾರಿಯಲ್ಲಿ<br><b>व्युत्पत्तिः - </b>नास्ति पन्थाः यस्य<br><br>

अपथिन्
अपथिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ದಾರಿ /ಕುಮಾರ್ಗ<br><b>व्युत्पत्तिः - </b>अपथे वर्तते<br><br>

अपथ्य
अपथ्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೈದ್ಯನು ಹೇಳಿದ ಆಹಾರ ನಿಯಮವನ್ನು ಮೀರಿ ನಡೆಯುವುದು /ಕೆಡುಕುಂಟುಮಾಡುವ ಊಟ<br><b>निष्पत्तिः - </b>"पथे विभाषा" (५-४-७२) । "अ" प्रत्ययाभावे रूपम् ।<br><b>व्युत्पत्तिः - </b>न पन्थाः<br><br>अपथ्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರೋಕ್ತವಾದ ಆಹಾರವನ್ನು ಮೀರಿ ನಡೆಯುವುದು /ಅಹಿತವಾದ ವರ್ತನೆ /ನಿಯಮೋಲ್ಲಂಘನ<br><br>

अपद
अपद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲಿಲ್ಲದ ಹುಳು /ಹರಿದಾಡುವ ಹುಳು<br><b>निष्पत्तिः - </b>"यत्" (४-४-९२)<br><b>व्युत्पत्तिः - </b>पथः अनपेतम्<br><b>प्रयोगाः - </b>"राजापथ्यकारी क्षपणको नगरान्निर्वास्यते"<br><b>उल्लेखाः - </b>मुद्रा० १<br><br>

अपद
अपद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ /ಹಾವು<br><br>अपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದ್ಯವಾದ ಜಾಗ /ಅಸ್ಥಾನ<br><br>अपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಹವಲ್ಲದ ಜಾಗ<br><br>अपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಬಂತ ಮತ್ತು ತಿಂಗಂತವಲ್ಲದ್ದು<br><b>प्रयोगाः - </b>"प्रेम पश्यति भयान्यपदेऽपि"<br><b>उल्लेखाः - </b>किरा० ९-६०<br><br>अपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾಶ<br><b>व्युत्पत्तिः - </b>नास्ति पदं पादः स्थानं सुप्तिङन्तात्मकं वा यस्य<br><br>अपद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಲಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>अस्य विष्णोः पदम्<br><br>

अपदान
अपदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶುದ್ಧವಾದ ನಡತೆ /ಪರಿಶುದ್ಧವಾದ ಆಚಾರ<br><b>निष्पत्तिः - </b>अप + दैप् (शोधने) -कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>अपदायति परिशुद्ध्यति अनेन<br><br>अपदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂದೆ ನಡೆದ ಸಂಗತಿ /ಹಿಂದೆ ನಡೆಯಿಸಿದ ಕಾರ್ಯ<br><b>विस्तारः - </b>"अपदानं कर्म वृत्तम्" - अम० ।<br><br>

अपदान्तर
अपदान्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವ್ಯವಹಿತವಾದ<br><br>अपदान्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇರಿಕೊಂಡಿರುವ<br><br>अपदान्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸನ್ನಿಹಿತವಾದ<br><b>व्युत्पत्तिः - </b>न पदान्तरं यत्र<br><br>

अपदिशम्
अपदिशम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎರಡು ದಿಕ್ಕುಗಳ ಮಧ್ಯಪ್ರದೇಶ /ಆಗ್ನೇಯ ಮೊದಲಾದ ವಿದಿಕ್ಕು<br><b>निष्पत्तिः - </b>दिशोर्मध्य इति विग्रहे "टच्" (५-४-१०७)<br><b>व्युत्पत्तिः - </b>दिशोर्मध्ये अपदिशम्<br><b>विस्तारः - </b>"क्लीबाव्ययं त्वपदिशं दिशोर्मध्ये विदिक् स्त्रियाम्" - अम० ।<br><br>

अपदिष्ट
अपदिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲ್ಪಟ್ಟ /ಉಪದೇಶಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अप + दिश (अतिसर्जने) - "क्तः" (३-२-१०२)<br><br>

अपदेश
अपदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಜ /ನೆಪ<br><b>निष्पत्तिः - </b>अप + दिश (अतिसर्जने) - "घञ्" (३-३-१८)<br><b>व्युत्पत्तिः - </b>अपदिश्यते<br><b>प्रयोगाः - </b>"रक्षापदेशान्मुनिहोमधेनोः वन्यान्विनेष्यन्निव दुष्टसत्त्वान्"<br><b>उल्लेखाः - </b>रघु० २-८<br><br>अपदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಛಲ /ಕಪಟ /ವಂಚನೆ<br><br>अपदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಯ /ಗುರಿ<br><br>अपदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾರ /ವೇಷ<br><b>प्रयोगाः - </b>"विकटदुष्टश्वापदापदेशकालगोचरं गता मदयन्तिका"<br><b>उल्लेखाः - </b>मालती० ८<br><br>अपदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೇತು /ಕಾರಣ<br><br>अपदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಾನ /ಜಾಗ<br><b>विस्तारः - </b>"अपदेशस्तु कारणे । व्याजे लक्ष्येऽपि" - हेम० । "अपदेशः पदे लक्ष्यनिमित्तव्याजयोरपि" - नानार्थर० ।<br><br>

अपदेश्य
अपदेश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಟದಿಂದ ಹೇಳಲ್ಪಡುವ /ಮೋಸದಿಂದ ಹೇಳಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अप + दिश (अतिसर्जने) -कर्म० "ण्यत्" (३-१-१२४)<br><br>अपदेश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯವಾದ ಪ್ರದೇಶದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"यत्" (४-३-५४)<br><b>व्युत्पत्तिः - </b>अपदेशे भवः<br><br>

अपद्वार
अपद्वार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಳ್ಳಬಾಗಿಲು /ಮುಖ್ಯವಾದ ಬಾಗಿಲುಗಳಿಗಿಂತಲೂ ಬೇರೆಯಾದ ಒಂದು ಪಕ್ಕದ ಬಾಗಿಲು<br><br>

अपध्यान
अपध्यान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಯೋಚನೆ /ಅರಿಷ್ಟದ ಚಿಂತನೆ<br><b>व्युत्पत्तिः - </b>अपकृष्टं ध्यानम्<br><br>

अपध्वंस
अपध्वंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವನತಿ /ಅಧಃಪತನ<br><br>अपध्वंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶ /ಹಾನಿ<br><br>अपध्वंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧಿಕ್ಕಾರ /ತಿರಸ್ಕಾರ /ಅಪಮಾನ<br><b>निष्पत्तिः - </b>अप + ध्वंसु (अवस्रंसने) - "घञ्" (३-३-१८)<br><br>

अपध्वंसिन्
अपध्वंसिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸುವ ಸ್ವಭಾವದ<br><br>अपध्वंसिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸುವ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>अप + ध्वंसु (अवस्रंसने) + णिच् - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अपध्वंसयितुं शीलमस्य<br><b>विस्तारः - </b>"सर्वैनसामपध्वंसि जप्यं त्रिष्वधमर्षणम्" - अम० ।<br><br>

अपध्वस्त
अपध्वस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧಿಕ್ಕರಿಸಲ್ಪಟ್ಟ /ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अप + ध्वंसु (अवस्रंसने) - "क्तः" (३-२-१०२)<br><br>अपध्वस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿಸಲ್ಪಟ್ಟ /ಹಳಿಯಲ್ಪಟ್ಟ<br><br>अपध्वस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡಲ್ಪಟ್ಟ /ತ್ಯಜಿಸಲ್ಪಟ್ಟ<br><br>अपध्वस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುಡಿ ಮಾಡಲ್ಪಟ್ಟ /ಧೂಳು ಮಾಡಲ್ಪಟ್ಟ<br><br>

अपध्वान्न्त
अपध्वान्न्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತಲೆಯಿಲ್ಲದ /ಅಂಧಕಾರವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>अपगतं ध्वान्तं यस्मात्<br><br>

अपनय
अपनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೂರಕ್ಕೆ ಒಯ್ಯುವುದು /ಬೇರೆ ಕಡೆಗೆ ಸಾಗಿಸುವುದು<br><br>अपनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ನೀತಿ /ಕೆಟ್ಟ ನಡತೆ<br><br>अपनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಕಾರ<br><b>निष्पत्तिः - </b>अप + णीञ् (प्रापणे) - "अच्" (३-३-५६)<br><b>प्रयोगाः - </b>"ततः सपत्नापनयस्मरणानुशयस्फुरा"<br><b>उल्लेखाः - </b>माघ० २-२४<br><br>

अपनयन
अपनयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರೆ ಕಡೆಗೆ ಒಯ್ಯುವುದು /ಬೇರೆ ಕಡೆಗೆ ಸಾಗಿಸುವುದು<br><br>अपनयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೋಗಲಾಡಿಸುವುದು /ಪರಿಹರಿಸುವುದು<br><b>निष्पत्तिः - </b>अप + णीञ् (प्रापणे) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"नातिश्रमापनयनाय न च श्रमाय"<br><b>उल्लेखाः - </b>शाकु० ५-६<br><br>अपनयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯವಕಲನ /ಕಳೆಯುವುದು<br><br>अपनयन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಣ್ಣಿಲ್ಲದ /ನೇತ್ರವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>अपगतं नयनं यस्य<br><br>

अपनस
अपनस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂಗಿಲ್ಲದ /ನಾಶವಾದ ಮೂಗುಳ್ಳ<br><b>निष्पत्तिः - </b>"अच्" (५-४-११९) । नस् आदेशश्च ।<br><b>व्युत्पत्तिः - </b>अपगता नासिका यस्य<br><b>प्रयोगाः - </b>"असिं कौक्षेयमुद्यम्य चकारापनसं मुखम्"<br><b>उल्लेखाः - </b>भट्टि० ४-३१<br><br>

अपनीत
अपनीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೂರಕ್ಕೆ ಒಯ್ಯಲ್ಪಟ್ಟ /ಬೇರೆ ಕಡೆಗೆ ಸಾಗಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अप + णीञ् (प्रापणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"गोचरं गतयोर्भ्रात्रोरपनीता त्वयाधम"<br><b>उल्लेखाः - </b>रामा०<br><br>अपनीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಳ್ಳಲ್ಪಟ್ಟ /ನೂಕಲ್ಪಟ್ಟ<br><br>अपनीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿರುದ್ಧವಾದ /ಅಸಗಂತವಾದ<br><b>प्रयोगाः - </b>"तत्त्वधर्मापनीतस्य दृश्यते कर्मणः फलम्"<br><b>उल्लेखाः - </b>रामा०<br><br>अपनीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿತ್ತುಕೊಳ್ಳಲ್ಪಟ್ಟ /ಕೊಳ್ಳೆ ಹೊಡೆಯಲ್ಪಟ್ಟ /ಸುಲಿಗೆ ಮಾಡಲ್ಪಟ್ಟ<br><br>

अपनुत्ति
अपनुत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಿಹಾರ /ನಿವಾರಣೆ<br><br>अपनुत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೂರಕ್ಕೆ ಒಯ್ಯುವುದು /ಬೇರೆ ಕಡೆಗೆ ಸಾಗಿಸುವುದು<br><b>निष्पत्तिः - </b>अप + णुद (प्रेरणे) - "क्तिन्" (३-३-९४)<br><br>

अपनोद
अपनोद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಿಹಾರ /ನಿವಾರಣೆ<br><b>निष्पत्तिः - </b>अप + णुद (प्रेरणे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"ब्रह्महत्यापनोदाय मितभुङ्नियतेन्द्रियः"<br><b>उल्लेखाः - </b>मनु० ११-७६<br><br>अपनोद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೂರಕ್ಕೆ ತಳ್ಳುವುದು /ದೂರಕ್ಕೆ ಸಾಗಿಸುವುದು<br><br>

अपनोदन
अपनोदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೋಗಲಾಡಿಸುವಿಕೆ /ನಿವಾರಣೆ /ಪರಿಹಾರ<br><b>निष्पत्तिः - </b>अप + णुद (प्रेरणे) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"एनसां स्थूलसूक्ष्माणां चिकीर्षन्नपनोदनम्"<br><b>उल्लेखाः - </b>मनु० ११-२५२<br><br>अपनोदन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಗಲಾಡಿಸುವ /ಪರಿಹರಿಸುವ<br><b>निष्पत्तिः - </b>अप + णुद (प्रेरणे) - कर्त० "ल्युः" (३-१-१३४)<br><b>प्रयोगाः - </b>"पराको नाम कृच्छ्रोऽयं सर्वपापापनोदनः"<br><b>उल्लेखाः - </b>मनु० ११-२१५<br><br>

अपप्रदान
अपप्रदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಂಚ /ಉತ್ಕೋಚ<br><b>व्युत्पत्तिः - </b>अपकॄष्टं प्रदानम्<br><br>

अपभय
अपभय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯವಿಲ್ಲದ /ಹೆದರಿಕೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>अपगतं भयं यस्मात्<br><b>प्रयोगाः - </b>"ततः पहस्यापभयः पुरन्दरं पुनर्बभाषे तुरगस्य रक्षिता"<br><b>उल्लेखाः - </b>रघु० ३-५१<br><br>

अपभाषण
अपभाषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ<br><br>अपभाषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾನ ಭಂಗಪಡಿಸುವುದು<br><br>

अपभी
अपभी<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯವಿಲ್ಲದ /ಹೆದರಿಕೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>अपगता भीर्यस्मात्<br><br>

अपभ्रंश
अपभ्रंश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಃಪತನ /ಕೆಳಗೆ ಬೀಳುವುದು<br><b>निष्पत्तिः - </b>अप + भ्रंशु (अधःपतने) - "घञ्" (३-३-१८)<br><br>अपभ्रंश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಶಬ್ದ /ವ್ಯಾಕರಣನಿಯಮಕ್ಕೆ ವಿರುದ್ದವಾದ ಶಬ್ದ<br><br>अपभ्रंश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶುದ್ಧವಾದ ಭಾಷೆ /ಸಂಸ್ಕೃತಕ್ಕಿಂತಲೂ ಬೇರೆಯಾದ ಭಾಷೆ<br><b>प्रयोगाः - </b>"शास्त्रेषु संस्कृतादन्यदपभ्रंशतयोदितम्"<br><b>उल्लेखाः - </b>काव्या० १-३६<br><br>

अपभ्रष्ट
अपभ्रष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಗೆ ಬಿದ್ದಿರುವ<br><br>अपभ्रष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಶುದ್ಧವಾದ ಪ್ರಾಂತ ಭಾಷೆ<br><br>

अपमर्द
अपमर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಸ /ಧೂಳು /ಹೊಲಸು<br><b>निष्पत्तिः - </b>अप + मृद (क्षोदे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"हयहस्तिकरीषाभ्यामपनर्दः कृतो महान्"<br><b>उल्लेखाः - </b>रामा०<br><br>

अपमान
अपमान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವಮಾನ /ಅಗೌರವ<br><b>निष्पत्तिः - </b>अप + मान (पूजायाम्) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"मानापमानयोस्तुल्यः तुल्यो मित्रारिपक्षयोः" । "अथनाशं मनस्तापं गृहे दुश्चरितानि च । वञ्चनञ्चापमानञ्च मतिमान्नप्रकाशयेत् ॥"<br><b>उल्लेखाः - </b>गीता० १४-२५<br><br>

अपमानित
अपमानित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಮಾನಗೊಳಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अप + मान (पूजायाम्) - "क्तः" (३-२-१०२)<br><br>

अपमार्ग
अपमार्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಮಾರ್ಗ /ಕೆಟ್ಟ ದಾರಿ<br><b>व्युत्पत्तिः - </b>अपकृष्टो मार्गः<br><br>

अपमार्जन
अपमार्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶೋಧನೆ /ಶುದ್ಧಿಗೊಳಿಸುವುದು<br><b>निष्पत्तिः - </b>अप + मृजूष् (शुद्धौ) + णिच् - "ल्युट्" (३-३-११५)<br><br>

अपमित
अपमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ /ಅವಮಾನಗೊಳಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अप + मेङ् (प्रणिदाने) - "क्तः" (३-२-१०२)<br><br>

अपमित्यक
अपमित्यक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಋಣ /ಸಾಲ<br><b>निष्पत्तिः - </b>अप + मेङ् (प्रणिदाने) - "ल्यप्" (७-१-३७) । "इत्" (६-४-७०) । कन् ।<br><b>व्युत्पत्तिः - </b>अपमित्य अपमानं स्वीकृत्य गृह्यते<br><br>

अपमुख
अपमुख<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂದಕ್ಕೆ ತಿರುಗಿಸಿದ ಮುಖ<br><br>अपमुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರುಗಿಸಿದ ಮುಖವುಳ್ಳ<br><br>

अपमूर्धन्
अपमूर्धन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಲೆಯಿಲ್ಲದ ಶರೀರ /ಮುಂಡ<br><b>व्युत्पत्तिः - </b>अपगतो मूर्धा यस्य<br><br>

अपमृषित
अपमृषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಹಿಸಲ್ಪಡದ /ಸಹಿಸಲಾಗದ /ತಾಳಲಾಗದ<br><b>निष्पत्तिः - </b>अप + मृष (तितिक्षायाम्) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"विहितं मयाद्य सदसीदमपमृषितमच्युतार्चनम्"<br><b>उल्लेखाः - </b>माघ० १५-४६<br><br>अपमृषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲಿಕ್ಕಾಗದ /ಅಸ್ಪಷ್ಟವಾದ /ಅರ್ಥವಾಗದ<br><b>विस्तारः - </b>"अपमृषितं वाक्यमविस्पष्टमित्यर्थः" - सि० कौ० ।<br><br>

अपयशस्
अपयशस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಕೀರ್ತಿ /ಅಪಖ್ಯಾತಿ<br><b>व्युत्पत्तिः - </b>अपकृष्टं यशः<br><b>प्रयोगाः - </b>"अपयशो यद्यस्ति किं मृत्युना"<br><b>उल्लेखाः - </b>भर्तृ० १-४४<br><br>

अपयशस्कर
अपयशस्कर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಕೀರ್ತಿಯನ್ನು ಉಂಟುಮಾಡುವ<br><br>

अपयान
अपयान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊರಕ್ಕೆ ಹೋಗುವುದು /ದೂರಕ್ಕೆ ಹೋಗುವುದು /ತಪ್ಪಿಸಿಕೊಂಡು ಹೋಗುವುದು<br><b>निष्पत्तिः - </b>अप + या (प्रापणे) - "ल्युट्" (३-३-११५)<br><br>

अपर
अपर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನೆಯ ಹಿಂದಿನ ಕಾಲು<br><b>निष्पत्तिः - </b>रा (दाने) - "कः" (३-१-१३६)<br><b>व्युत्पत्तिः - </b>अप राति<br><b>प्रयोगाः - </b>"बद्धापराणि परितो निगडान्यलावीत्"<br><b>उल्लेखाः - </b>माघ० ५-४८<br><br>अपर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂದಿನ ಕಾರ್ಯ /ಅಪರಕಾರ್ಯ<br><br>अपर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತಮವಾದ /ಅದಕ್ಕೆ ಸಮಾನವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति परो यस्मात्<br><b>प्रयोगाः - </b>"स्त्रीरत्नसृष्टिरपरा प्रतिभाति सा मे"<br><b>उल्लेखाः - </b>शाकु० ७-५<br><br>अपर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಕೃಷ್ಟವಾದ /ಉತ್ತಮವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न परः<br><b>प्रयोगाः - </b>"अपरेयमितस्त्वन्यां प्रकृतिं विद्धि मे पराम्"<br><b>उल्लेखाः - </b>गीता० ७-५<br><br>अपर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ವ್ಯಾಪ್ತಿಯಿಲ್ಲದ /ಕಡಿಮೆ ವ್ಯಾಪ್ತಿಯುಳ್ಳ<br><b>विस्तारः - </b>परमपरं चेति सामान्यं दिविधम् ।अधिकदेशवृत्ति परम् । अपरं ति अल्पदेशवृत्ति ।<br><br>अपर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಿನ್ನವಾದ /ಬೇರೆಯಾದ /ಇತರ<br><b>प्रयोगाः - </b>"अन्ये कृतयुगे धर्मास्त्रेतायां द्वापरेऽपरे"<br><b>उल्लेखाः - </b>मनु० १-८५<br><br>अपर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಭಾಗದ /ಪಶ್ಚಿಮ ಭಾಗದ<br><b>प्रयोगाः - </b>"पूर्वापरौ तोयनिधी वगाह्य स्थितः पृथिव्या इव मानदण्डः"<br><b>उल्लेखाः - </b>कुमा० १-१<br><br>अपर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದಿನ /ಅನಂತರದ<br><b>प्रयोगाः - </b>"अपरं भवतो जन्म परं जन्म विवस्वतः"<br><b>उल्लेखाः - </b>गीता० ४-४<br><br>अपर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇನ್ನೊಬ್ಬನು /ಮತ್ತೊಬ್ಬನು<br><b>प्रयोगाः - </b>"एके समूहुर्बलरेणुसंहतिं शिरोभिराज्ञामपरे महीभृतः"<br><b>उल्लेखाः - </b>माघ० १२-४५<br><br>

अपरा
अपरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಶ್ಚಿಮ ದಿಕ್ಕು<br><br>अपरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಶ್ಚಿಮ ಸಂಧ್ಯೆ<br><br>अपरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಲ್ಕು ವೇದಗಳು<br><br>अपरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆರು ವೇದಾಂಗಗಳು<br><b>प्रयोगाः - </b>"द्वे विद्ये वेदितव्ये इति हस्म ब्रह्मविदो वदन्ति पराचैवापरा च तत्रापरा ऋग्वेदो यजुर्वेदः सामवेदोऽथर्ववेदः शिक्षा कल्पो व्याकरणं निरुक्तं छन्दो ज्योतिषमिति"<br><b>उल्लेखाः - </b>श्रुतिः<br><br>अपरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ಭಾಶಯ<br><br>अपरा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮತ್ತೆ /ಇನ್ನೂ<br><br>

अपरक्त
अपरक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿಯಿಲ್ಲದ /ವಿಶ್ವಾಸವಿಲ್ಲದ /ಅನುರಾಗವಿಲ್ಲದ<br><b>निष्पत्तिः - </b>अप + रञ्ज (रागे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अपि चन्द्रगुप्तादपरक्ताः प्रकृतयः"<br><b>उल्लेखाः - </b>मुद्रा० १<br><br>अपरक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಂಪಾಗಿಲ್ಲದ /ಕೆಂಪು ಬಣ್ಣವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>अपगतो रक्तः रक्तवर्णः यस्मात्<br><br>

अपरति
अपरति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಲ್ಲುವಿಕೆ /ನಿಲುಗಡೆ<br><br>अपरति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಮಾಧಾನ /ಅಸಂತುಷ್ಟಿ /ಬೇಸರ<br><b>निष्पत्तिः - </b>अप + रमु (क्रीडायाम्) भावे "क्तिन्" (३-३-९४)<br><br>

अपरत्र
अपरत्र<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಕಡೆಯಲ್ಲಿ /ಮತ್ತೊಂದೆಡೆಯಲ್ಲಿ<br><br>अपरत्र<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಕಾಲದಲ್ಲಿ /ಬೇರೆ ಸಂದರ್ಭದಲ್ಲಿ /ಮತ್ತೊಂದು ಸಮಯದಲ್ಲಿ<br><b>निष्पत्तिः - </b>अपर - "त्रल्" (५-३-१०)<br><br>

अपरथा
अपरथा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ರೀತಿಯಾಗಿ<br><b>निष्पत्तिः - </b>अपर - "थाल्" (५-३-२३)<br><b>प्रयोगाः - </b>"अपरथापरथावयवायुधः"<br><b>उल्लेखाः - </b>माघ० ६-४१<br><br>

अपरदक्षिण
अपरदक्षिण<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣ ಮತ್ತು ಪಶ್ಚಿಮ ದಿಕ್ಕುಗಳ ಮಧ್ಯಭಾಗ /ನಿರೃತಿ ದಿಕ್ಕು<br><b>निष्पत्तिः - </b>निपा० (२-१-१७)<br><b>व्युत्पत्तिः - </b>अपरस्याः दक्षिणस्याश्च अन्तरालं दिक्<br><br>

अपरपक्ष
अपरपक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಪಕ್ಷ /ತಿಂಗಳಿನ ಎರಡನೆಯ ಅರ್ಧಭಾಗ<br><br>अपरपक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಾಧ್ರಪದ ಕೃಷ್ಟಪಕ್ಷ<br><br>अपरपक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರುಪಕ್ಷ /ಪ್ರತಿಪಕ್ಷ<br><br>

अपररात्र
अपररात्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾತ್ರಿಯ ಉತ್ತರಭಾಗ /ರಾತ್ರಿಯ ಎರಡನೆಯ ಅರ್ಧಭಾಗ<br><b>निष्पत्तिः - </b>"अच्" (५-४-८७)<br><b>व्युत्पत्तिः - </b>अपरं रात्रेः<br><br>

अपरव
अपरव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಯಶಸ್ಸು /ಅಪಕೀರ್ತಿ<br><b>व्युत्पत्तिः - </b>अपकृष्टो रवः<br><br>अपरव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಶಬ್ದ /ಅಶ್ಲೀಲವಾದ ಶಬ್ದ<br><br>

अपरस्पर
अपरस्पर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಸ್ಪರವಲ್ಲದ /ಅನ್ಯೋನ್ಯವಲ್ಲದ<br><br>अपरस्पर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ರಿಯಾಸಾತತ್ಯವುಳ್ಳ /ಎಡೆಬಿಡದ ಕೆಲಸವುಳ್ಳ<br><b>निष्पत्तिः - </b>"सुट्" (६-१-१४४)<br><b>व्युत्पत्तिः - </b>अपरे च परे च सातत्येन गच्छति<br><b>प्रयोगाः - </b>"अपरस्पराः सार्थाः गच्छन्ति"<br><b>उल्लेखाः - </b>सि० कौ०<br><br>अपरस्पर<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಸತತವಾಗಿ /ಎಡೆಬಿಡದೆ ಕೆಲಸ<br><b>व्युत्पत्तिः - </b>अपरस्परं गच्छन्ति<br><br>

अपराग
अपराग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ವೇಷ /ಪ್ರೀತಿಯಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>अप + रञ्ज (रागे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"आर्य, एतेषामपरागहेतून् श्रोतुमिच्छामि"<br><b>उल्लेखाः - </b>मुद्रा० ३<br><br>

अपराङ्ग
अपराङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಣೀಭೂತವ್ಯಂಗ್ಯಕಾವ್ಯ<br><b>व्युत्पत्तिः - </b>अपरस्य रसादेरङ्गम्<br><br>

अपराजित
अपराजित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>"अपराजितः सर्वसहो नियन्ता नियमो यमः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"हरीशावपराजितौ" - वैज० ।<br><br>अपराजित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ<br><br>अपराजित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಯಿಸಲ್ಪಡದ /ಸೋಲಿಸಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न पराजितः<br><br>

अपराजिता
अपराजिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ /ವಿಜಯದಶಮಿಯ ದಿನ ಜಯಗಳಿಸಲು ಪೂಜಿಸಲ್ಪಡುವ ದೇವತೆ<br><b>प्रयोगाः - </b>"दशम्यां च नरैः सम्यक् पूजनीयापराजिता । क्षेमार्थं विजयार्थं च पूर्वोक्तविधिना नरैः । नवमीशेषयुक्तायां दशम्यामपराजिता । ददाति विजयं देवी पूजिता जयवर्धिनी ॥"<br><b>उल्लेखाः - </b>स्कान्द०<br><br>अपराजिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರಿಕೆ ಹುಲ್ಲು<br><br>अपराजिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶೇಫಾಲಿಕಾ ವೃಕ್ಷ /ಕರಿಲಕ್ಕಿ ಗಿಡ<br><br>अपराजिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊನ್ನೇ ಮರ<br><br>अपराजिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಕ್ಕರಿಕೆ ಗಿಡ /ಕಡಿಯಾಲದ ಮರ<br><br>अपराजिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಕ್ಕಿಲೆ ಗಿಡ<br><br>अपराजिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣುಕ್ರಾಂತಿ ಗಿಡ<br><br>अपराजिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರಪೂರ್ವ ದಿಕ್ಕುಗಳ ಮಧ್ಯಭಾಗ /ಈಶಾನ್ಯ ದಿಕ್ಕು<br><b>प्रयोगाः - </b>"अपराजितां वास्थाय रजेद्दिशमजिह्मगः"<br><b>उल्लेखाः - </b>मनु० ६-३१<br><br>अपराजिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಯಲೋಕದ ಪ್ರಧಾನ ನಗರ<br><b>विस्तारः - </b>"ब्रह्मलोकस्सत्यलोकस्तत्र पर्युपराजिता" - वैज० ।<br><br>

अपराद्ध
अपराद्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪರಾಧ /ತಪ್ಪು<br><b>निष्पत्तिः - </b>अप + राध (संसिद्धौ) - भावे "क्तः" (३-३-११४)<br><b>प्रयोगाः - </b>"न तु ग्रीष्मस्यैवं सुभगमपराद्धं युवतिषु"<br><b>उल्लेखाः - </b>शाकु० ३-९<br><br>अपराद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪರಾಧ ಮಾಡಿದ /ತಪ್ಪು ಮಾಡಿದ<br><b>निष्पत्तिः - </b>अप + राध (संसिद्धौ) - कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"कृतवत्यसि नावधीरणामपराद्धेऽपि यदा चिरं मयि"<br><b>उल्लेखाः - </b>रघु० ८-४८<br><br>अपराद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಖಲಿತವಾದ /ತಪ್ಪಿದ /ಜಾರಿದ<br><b>प्रयोगाः - </b>"निमित्तादपराद्धेषोर्धानुष्कस्येव वल्गितम्"<br><b>उल्लेखाः - </b>माघ० २-२७<br><br>

अपराध
अपराध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಪ್ಪು /ಅಕೃತ್ಯ /ದೋಷ<br><b>निष्पत्तिः - </b>अप + राध (संसिद्धौ) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"पराधशरक्षमं नृपः क्षमयात्येति भवन्तमेकया"<br><b>उल्लेखाः - </b>माघ० १६-४८<br><br>

अपराधिन्
अपराधिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪರಾಧವುಳ್ಳ /ತಪ್ಪಿತವುಳ್ಳ /ತಪ್ಪು ಮಾಡಿದ<br><b>निष्पत्तिः - </b>अपराध - "इनिः" (५-२-११५)<br><br>

अपराधिनी
अपराधिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪರಾಧವುಳ್ಳ /ತಪ್ಪಿತವುಳ್ಳ /ತಪ್ಪು ಮಾಡಿದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अपरान्त
अपरान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದೇಶ /ಪಶ್ಚಿಮ ದಿಕ್ಕಿನ ಕೊನೆಯಲ್ಲಿರುವ ದೇಶ<br><b>व्युत्पत्तिः - </b>अपरस्याः पश्चिमायाः सीमाभूतो देशः<br><br>अपरान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಶ್ಚಾತ್ಯರು /ಪಶ್ಚಿಮ ದಿಕ್ಕಿನಲ್ಲಿ ವಾಸ ಮಾಡುವ ಜನರು<br><br>अपरान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಶ್ಚಿಮ ದೇಶದ ರಾಜರು<br><b>प्रयोगाः - </b>"तस्यानीकैर्विसर्पद्भिरपरान्तजयोद्यतैः" । "अपरान्तमहीपालव्याजेन रघवे करम्" ।<br><b>उल्लेखाः - </b>रघु० ४-५३, रघु० ४-५८<br><br>

अपराह्ण
अपराह्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಗಲಿನ ಎರಡನೆಯ ಅರ್ಧಭಾಗ<br><b>निष्पत्तिः - </b>एकदेशितत्पुरुषसमासः (२-२-१)<br><b>व्युत्पत्तिः - </b>अह्णः अपरम्<br><b>प्रयोगाः - </b>"अपराह्णशीतलतरेण शनैः"<br><b>उल्लेखाः - </b>माघ्ha0 ९-४<br><br>अपराह्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಗಲಿನ ೫ ಭಾಗಗಳಾದ ಪ್ರಾತಃ ಸಂಗವ ಮಧ್ಯಾಹ್ನ ಅಪರಾಹ್ಣ ಮತ್ತು ಸಾಯಾಹ್ನಗಳಲ್ಲಿ ನಾಲ್ಕನೆಯದು<br><br>

अपराह्णतन
अपराह्णतन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಪಾಹ್ಣವನ್ನು ಸಹಿಸುವ ಸ್ವಭಾವದ /ಅಪರಾಹ್ಣವನ್ನು ಸಹಿಸಲು ಶಕ್ತಿಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"ट्युः" (४-३-५२)<br><b>व्युत्पत्तिः - </b>अपराह्णः सोढोऽस्य<br><br>अपराह्णतन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪರಾಹ್ಣದಲ್ಲಿರುವ /ಅಪರಾಹ್ಣದಲ್ಲಿ ಉಂಟಾದ<br><br>

अपरिकलित
अपरिकलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಪಡದ<br><br>अपरिकलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡಲ್ಪಡದ<br><br>अपरिकलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೇಳಲ್ಪಡದ<br><br>अपरिकलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರ್ಯಾಲೋಚಿಸಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न परिकलितः<br><br>

अपरिक्रम
अपरिक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ಸಂಚರಿಸದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>परितः क्रमः क्रमणम्<br><br>अपरिक्रम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ಸಂಚರಿಸದ<br><br>अपरिक्रम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ಯೋಗಶೀಲನಲ್ಲದ /ಶ್ರಮಪಡುವ ಸ್ವಭಾವವಿಲ್ಲದ /ಆಸಕ್ತಿಯಿಲ್ಲದ<br><br>

अपरिगत
अपरिगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಪಡದ<br><br>अपरिगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಡದ<br><br>

अपरिग्रह
अपरिग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವೀಕರಿಸದಿರುವಿಕೆ /ಬೇಡವೆನ್ನುವುದು<br><br>अपरिग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾತಂಜಲ ಯೋಗದಲ್ಲಿ ಹೇಳಲ್ಪಟ್ಟ ಒಂದು ವಿಧ ಯಮ /ಅಷ್ಟಾಂಗಯೋಗಗಳಲ್ಲಿ ಒಂದಾದ ಯಮದ ಒಂದು ಬೇದ<br><b>व्युत्पत्तिः - </b>न परिग्रहः<br><b>प्रयोगाः - </b>"अहिंसासत्यास्तेयब्रह्मचर्यापरिग्रहाः"<br><b>उल्लेखाः - </b>पा० यो०<br><br>अपरिग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯತಿ /ಸಂನ್ಯಾಸಿ<br><b>व्युत्पत्तिः - </b>नास्ति परिग्रहो यस्य<br><b>प्रयोगाः - </b>"निराशीरपरिग्रहः"<br><b>उल्लेखाः - </b>गीता० ६-१०<br><br>अपरिग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪತ್ನಿಯಿಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>न परिचितः<br><br>

अपरिचित
अपरिचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಿಚಯವಿಲ್ಲದ /ತಿಳಿಯದಿರುವ /ಗುರುತಿಲ್ಲದ<br><b>निष्पत्तिः - </b>अप्राशस्त्ये न० ब०<br><b>व्युत्पत्तिः - </b>न परिच्छेदो यस्य<br><br>

अपरिच्छद
अपरिच्छद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದರಿದ್ರ /ನಿರ್ಗತಿಕ<br><br>

अपरिच्छिन्न
अपरिच्छिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಪಷ್ಟವಾಗಿ ತಿಳಿಯಲ್ಪಡದ /ಭೇದವರಿಯಲ್ಪಡದ<br><br>अपरिच्छिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟೆಂದು ತಿಳಿಯಲಾಗದ /ಅಳತೆ ಮಾಡಲಾಗದ<br><br>अपरिच्छिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಡೆಬಿಡದೆ ಮುಂದುವರೆದ /ಅವಿಚ್ಛಿನ್ನವಾದ<br><br>

अपरिच्छेद
अपरिच्छेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಪಷ್ಟವಾಗಿ ತಿಳಿಯದಿರುವಿಕೆ /ತಾರತಮ್ಯವನ್ನು ಅರಿಯದಿರುವಿಕೆ<br><br>अपरिच्छेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂದುವರಿಯುವಿಕೆ /ಮುಂದೆ ಸಾಗುವಿಕೆ<br><br>अपरिच्छेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೀರ್ಮಾನವಾಗದಿರುವಿಕೆ /ಸಂಶಯ ಪರಿಹಾರವಾಗದಿರುವಿಕೆ<br><br>अपरिच्छेद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಯತ್ತಾ ಶೂನ್ಯನಾದ /ಇಷ್ಟೆಂದು ಅಳತೆಯಿಲ್ಲದ<br><br>

अपरिणत
अपरिणत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಗದಿರುವ /ಬಲಿಯದಿರುವ<br><br>अपरिणत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಷ್ಣಾತನಲ್ಲದ /ಪರಿಶ್ರಮವಿಲ್ಲದ<br><br>अपरिणत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೂಪಾಂತರವನ್ನು ಹೊಂದದ /ಉಚಿತ ಪರಿಣಾಮವನ್ನು ಹೊಂದದ<br><b>व्युत्पत्तिः - </b>न परिणतः<br><br>

अपरिणय
अपरिणय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹವಾಗದಿರುವಿಕೆ /ಮದುವೆಯಾಗದಿರುವಿಕೆ<br><br>

अपरितोष
अपरितोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂತೋಷವಿಲ್ಲದಿರುವಿಕೆ<br><br>अपरितोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೃಪ್ತಿಯಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न परितोषः<br><br>

अपरिपक्व
अपरिपक्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಕ್ವಾಅಗದ /ಬೇಯಿಸಲ್ಪಡದ<br><br>अपरिपक्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೂಪಾಂತರವನ್ನು ಹೊಂದದ /ಉಚಿತ ಪರಿಣಾಮವನ್ನು ಹೊಂದದ<br><br>अपरिपक्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಗದ<br><br>अपरिपक्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ವಿಮರ್ಶಿಸುವ ಸಾಮರ್ಥ್ಯವಿಲ್ಲದ ಬುದ್ಧಿ<br><br>

अपरिमाण
अपरिमाण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಳತೆಯಿಅದಿರುವಿಕೆ /ಪರಿಮಾಣವಿಲ್ಲದಿರುವಿಕೆ<br><br>अपरिमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಿಮಾಣವಿಲ್ಲದ /ಅಳತೆಯಿಲ್ಲದ /ಅಪಾರವಾದ<br><b>व्युत्पत्तिः - </b>नास्ति परिमाणं यस्य<br><br>

अपरिमित
अपरिमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಳತೆಯಿಲ್ಲದ /ಅಪಾರವಾದ /ಹೆಚ್ಚಾದ<br><br>

अपरिमेय
अपरिमेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಳೆಯಲಾಗದ /ಇಯತ್ತಾಶೂನ್ಯವಾದ /ಅಳತೆಯಿಲ್ಲದ<br><b>प्रयोगाः - </b>"अथ कदाचिदपरिमेयमायाभयानकयुद्धसमुद्धतदैत्यबलावस्कन्दकान्दिशीकबृन्दारकानीकपरिवार्यमाणरथः पङ्क्तिरथः"<br><b>उल्लेखाः - </b>चं० रा०<br><br>अपरिमेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಳೆಯಲು ಯೋಗ್ಯವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न परिमातुं शक्यमर्हं वा<br><br>

अपरिविष्ट
अपरिविष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಡಿಸಲ್ಪಡದ<br><br>

अपरिवृत
अपरिवृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುತ್ತುವರಿಯಲ್ಪಡದ /ಬೇಲಿ ಹಾಕದಿರುವ ಜಮೀನು<br><br>अपरिवृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿಸಲ್ಪಡದ /ಮುಚ್ಚಲ್ಪಡದ<br><br>

अपरिष्कार
अपरिष्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶುದ್ಧಿ ಮಾಡದಿರುವಿಕೆ /ತೊಳೆಯದಿರುವಿಕೆ<br><br>अपरिष्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಲಂಕರಿಸದಿರುವಿಕೆ<br><br>

अपरिष्कृत
अपरिष्कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶುದ್ಧಿ ಮಾಡಲ್ಪಡದ /ತೊಳೆಯಲ್ಪಡದ<br><br>अपरिष्कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲಂಕರಿಸಲ್ಪಡದ /ಶೃಂಗರಿಸಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न परिष्कृतः<br><br>

अपरिहरणीय
अपरिहरणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡಲು ಅಶಕ್ಯವಾದ<br><br>अपरिहरणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡಲು ಅಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>परि + हृञ् (हरणे) - "अनीयर्" (३-१-९६)<br><b>व्युत्पत्तिः - </b>न परिहर्तुं शक्यमर्हं वा<br><br>अपरिहरणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಗಲಾಡಿಸಲು ಆಗದ<br><br>अपरिहरणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿವಾರಿಸಲು ಅರ್ಹವಲ್ಲದ<br><br>

अपरिहार्य
अपरिहार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಿಹರಿಸಲಾಗದ<br><br>अपरिहार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡಲು ಅಶಕ್ಯವಾದ<br><br>अपरिहार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಿಹರಿಸಲು ಅರ್ಹವಲ್ಲದ<br><br>अपरिहार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡಲು ಯೋಗ್ಯವಲ್ಲದ<br><b>निष्पत्तिः - </b>परि + हृञ् (हरणे) - "ण्यत्" (३-१-१२४)<br><b>व्युत्पत्तिः - </b>न परिहर्तुं शक्यमर्हं वा<br><b>प्रयोगाः - </b>"तस्मादपरिहार्येर्थे न त्वं शोचितुमर्हसि"<br><b>उल्लेखाः - </b>गीता० २-२७<br><br>

अपरीक्षित
अपरीक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರೀಕ್ಷಿಸಲ್ಪಡದ /ವಿಮರ್ಶಿಸಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न परीक्षितः<br><br>

अपरुष्
अपरुष्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>अपगता रुट् यस्य<br><b>प्रयोगाः - </b>"आपरुषा परुषाक्षरमीरिता"<br><b>उल्लेखाः - </b>रघु० ९-८<br><br>

अपरुष
अपरुष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಠಿನವಲ್ಲದ /ಕ್ರೂರವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न परुषः<br><br>अपरुष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪವಿಲ್ಲದ /ಶಾಂತವಾದ<br><b>व्युत्पत्तिः - </b>अपगता रुषा यस्य<br><br>

अपरुषा
अपरुषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अपरुष ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><br>

अपरूप
अपरूप<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಕಾರವಾದ ರೂಪ /ಕುರೂಪ<br><br>अपरूप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಕಾರವಾದ ರೂಪವುಳ್ಳ /ಕುರೂಪವುಳ್ಳ<br><br>

अपरेद्युस्
अपरेद्युस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮಾರನೆಯ ದಿನ /ಮರುದಿವಸ<br><b>निष्पत्तिः - </b>अपर - "एद्युस्" (५-३-२२)<br><br>

अपरोक्ष
अपरोक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯಕ್ಷವಾದ /ದೃಶ್ಯವಾದ /ಕಣ್ಣಿಗೆ ಕಾಣುವ<br><br>अपरोक्ष<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯಕ್ಷವಾಗಿ /ಎದುರಿಗೆ<br><br>

अपरोक्षानुभूति
अपरोक्षानुभूति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯಕ್ಷ ಜ್ಞಾನ<br><br>अपरोक्षानुभूति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಶಂಕರಾಚಾರ್ಯರು ರಚಿಸಿದ ಒಂದು ಗ್ರಂಥ<br><br>

अपरोध
अपरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಡೆ /ನಿರೋಧ<br><b>निष्पत्तिः - </b>अप + रुधिर् (आवरणे) - "घञ्" (३-३-१८)<br><br>

अपरोप
अपरोप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೂಲ ನಾಶ /ಬುಡಸಹಿತ ಕಿತ್ತು ಹಾಕುವುದು<br><b>प्रयोगाः - </b>"श्रुत्वा स्वाम्यपरोपरौद्रविषमान्"<br><b>उल्लेखाः - </b>मुद्रा० २-२१<br><br>

अपर्ण
अपर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರ್ಣವಿಲ್ಲದ /ಎಲೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न पर्णानि यस्य<br><br>

अपर्णा
अपर्णा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರ್ವತಿ<br><b>व्युत्पत्तिः - </b>नासि पर्णं वृत्तिसाधनं यस्याः<br><b>प्रयोगाः - </b>"स्वयं विशीर्णद्रुमपर्णवृत्तिता परा हि काष्ठा तपसस्तया पुनः । तदप्यपाकीर्णमतः प्रियंवदां वदन्त्यपर्णेति च तां पुराविदः ॥"<br><b>उल्लेखाः - </b>कुमा० ५-२८<br><br>

अपर्तु
अपर्तु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಟ್ಟು ನಿಂತಿರುವ ಹೆಂಗಸು<br><b>व्युत्पत्तिः - </b>अपगतः ऋतुः स्त्रीपुष्पं यस्याः<br><br>अपर्तु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಕಾಲದ /ಋತುನಿಯಮವನ್ನು ಮೀರಿದ<br><br>

अपर्यन्त
अपर्यन्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲೆಯಿಲ್ಲದ /ಅವಧಿಯಿಲ್ಲದ /ಕೊನೆಯಿಲ್ಲದ /ಅಪಾರವಾದ<br><b>व्युत्पत्तिः - </b>नास्ति पर्यन्तो यस्य<br><b>प्रयोगाः - </b>"तदक्षयमपर्यन्तं दुर्जयं वानरं बलम्"<br><b>उल्लेखाः - </b>रामा०<br><br>

अपर्याप्त
अपर्याप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಾರವಾದ /ಅಪರಿಮಿತವಾದ /ಅಳತೆಯನ್ನು ಮೀರಿದ<br><b>प्रयोगाः - </b>"जगत्यपर्याप्तसहस्रभानुना न यन्नियन्तुं समभावि भानुना"<br><b>उल्लेखाः - </b>माघ० १-२७<br><br>अपर्याप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಕಾಗದ /ಕಡಮೆಯಾದ /ಅಸಂಪೂರ್ಣವಾದ<br><br>अपर्याप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಮರ್ಥವಾದ /ಶಕ್ತಿಯಿಲ್ಲದ<br><b>प्रयोगाः - </b>"अपर्याप्तं तदस्माकं बलं भीष्माभिरक्शितम्"<br><b>उल्लेखाः - </b>गीता० १-१०<br><br>

अपर्याप्ति
अपर्याप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಕಾಗದಿರುವಿಕೆ /ಕಡಿಮೆಯಾಗದಿರುವಿಕೆ<br><br>अपर्याप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶಕ್ತತೆ /ಅಸಾಮರ್ಥ್ಯ<br><br>अपर्याप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಳತೆಯನ್ನು ಮೀರಿರುವಿಕೆ<br><br>

अपर्याय
अपर्याय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಮವಿಲ್ಲದಿರುವಿಕೆ<br><br>अपर्याय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ರಮವಿಲ್ಲದ<br><br>अपर्याय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರ್ಯಾಯವಿಲದ /ಸಮನವಾದ ಅರ್ಥವಿಲ್ಲದ ಶಬ್ದ<br><br>

अपर्युषित
अपर्युषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಸದಾದ /ಹಿಂದಿನಲ್ಲದ /ಹಳಸದ<br><br>

अपर्वन्
अपर्वन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗ್ರಂಥಿಗಳಿಲ್ಲದ /ಗೆಣ್ಣುಗಳಿಲ್ಲದ ಕೋಲು<br><br>अपर्वन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರ್ವಗಳಿಲ್ಲದ ಗ್ರಂಥ<br><br>

अपल
अपल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗುಳಿ /ಚಿಲಕ<br><b>निष्पत्तिः - </b>अप + ला (आदाने) - "कः" (३-१-१३६)<br><b>व्युत्पत्तिः - </b>अपलाति गृह्णात्यत्र<br><br>अपल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಂಸವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति पलं मांसं यस्य<br><br>

अपलपन
अपलपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಚ್ಚುಮರೆ /ಸತ್ಯವನ್ನಡಗಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अप + लप (व्यक्तायां वाचि) - "ल्युट्" (३-३-११५)<br><b>व्युत्पत्तिः - </b>अपलप्यते<br><b>प्रयोगाः - </b>"दैन्यादुन्मुखदर्शनापलपनैः पिण्डार्थमायस्यतः"<br><b>उल्लेखाः - </b>मुद्रा० ३-१४<br><br>

अपलपित
अपलपित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಚ್ಚುಮರೆ /ಸತ್ಯವನ್ನಡಗಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अप + लप (व्यक्तायां वाचि) - भावे "क्तः" (३-३-११४)<br><b>व्युत्पत्तिः - </b>अपलपनम्<br><br>अपलपित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರೆಮಾಚಲ್ಪಟ್ಟ<br><br>

अपलापिन्
अपलापिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸತ್ಯವನ್ನಡಗಿಸುವ /ನಿಜವನ್ನು ಮರೆ ಮಾಚುವ<br><b>निष्पत्तिः - </b>अप + लप (व्यक्तायां वाचि) - "णिनिः" (३-२-७८)<br><br>

अपलाषिका
अपलाषिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅತ್ಯಾಸೆ /ಕ್ರಮ ಮೀರಿದ ಆಸೆ<br><b>निष्पत्तिः - </b>अप + लष (कान्तौ) - "ण्वुच्" (३-३-१११)<br><br>

अपलाषिन्
अपलाषिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತ್ಯಾಸೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>अप + लष (कान्तौ) - "घिनुण्" (३-२-१४४)<br><br>

अपलाषुक
अपलाषुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತ್ಯಾಸೆ ಪಡುವ<br><b>निष्पत्तिः - </b>अप + लष (कान्तौ) - "उकञ्" (३-२-१५४)<br><br>

अपवरक
अपवरक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಠಡಿ /ಕೋಣೆ /ಕಿರುಮನೆ<br><b>निष्पत्तिः - </b>अप + वृञ् (वरणे) - "वुन्" (उ० ५-३५)<br><b>व्युत्पत्तिः - </b>अपव्रियते<br><br>

अपवर्ग
अपवर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಕ್ಷ /ಮುಕ್ತಿ<br><b>निष्पत्तिः - </b>अप + वृजी (वर्जने) - "घञ्" (३-३-१२१)<br><b>प्रयोगाः - </b>"स्तुतिभिः कतिचित्त्रिवर्गमृच्छन्त्यपवर्गं च यमेकमाश्रिताभिः"<br><b>उल्लेखाः - </b>याद० १५-५८<br><br>अपवर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತ್ಯಾಗ /ದಾನ<br><br>अपवर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾಪ್ತಿ /ಕೊನೆ<br><b>प्रयोगाः - </b>"साफल्यमस्त्रे रिपुपौरुषस्य कृत्वा गते भाग्य इवापवर्गम्"<br><b>उल्लेखाः - </b>किरा० १६-४९<br><br>अपवर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಸರ್ಜಿಸುವುದು /ಬಿಡುವುದು /ತೊರೆಯುವುದು<br><b>प्रयोगाः - </b>"मृष्टेरसम्भेद इवापवर्गे"<br><b>उल्लेखाः - </b>किरा० १६-२०<br><br>अपवर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಿಯೆ /ಕೆಲಸ<br><br>अपवर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸದಿಂದಾಗುವ ಪ್ರಯೋಜನ /ಫಲಪ್ರಾಪ್ತಿ<br><br>अपवर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಿಯಾಸಾಫಲ್ಯ<br><b>विस्तारः - </b>"स्यादपवर्गस्त्यागे मोक्षे कार्यावसाने साफल्ये" - मेदि० । "अपवर्गः क्रियामुक्त्योः क्रियासाध्यफलागमे" - नानार्थर० ।<br><br>

अपवर्जन
अपवर्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಸರ್ಜಿಸುವುದು /ಬಿಡುವುದು /ತೊರೆಯುವುದು<br><b>निष्पत्तिः - </b>अप + वृजी (वर्जने) - "ल्युट्" (३-३-११५)<br><br>अपवर्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತ್ಯಾಗ /ದಾನ<br><b>विस्तारः - </b>"अपवर्जनन्तु दाने निर्वाणत्यागयोरपि" - मेदि० ।<br><br>अपवर्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಕ್ಷ /ಮುಕ್ತಿ<br><br>

अपवर्जित
अपवर्जित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡಲ್ಪಟ್ಟ /ತ್ಯಜಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अप + वृजी (वर्जने) - "क्तः" (३-२-१०२)<br><br>अपवर्जित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಿಹರಿಸಲ್ಪಟ್ಟ /ಹೋಗಲಾಡಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अपवर्जितविप्लवे शुचौ हृदयग्राहिणि मङ्गलास्पदे"<br><b>उल्लेखाः - </b>किरा० २-२६<br><br>अपवर्जित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾನ ಮಾಡಲ್ಪಟ್ಟ /ಕೊಡಲ್ಪಟ್ಟ<br><br>

अपवर्तन
अपवर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಗಾಯಿಸುವಿಕೆ /ಬದಲಾವಣೆ<br><br>अपवर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಹರಣ /ಕಸಿದುಕೊಳ್ಳುವಿಕೆ<br><b>निष्पत्तिः - </b>अप + वृजी (वर्जने) - "ल्युट्" (३-३-११५)<br><br>अपवर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಣಿತ ಶಾಸ್ತ್ರದಲ್ಲಿ ಯಾವುದಾದರೂ ಒಂದು ಪೂರ್ಣಾಂಕವನ್ನು ನಿಃಶೇಷವಾಗಿ ಭಾಗಿಸುವ ಇತರ ಸಣ್ಣ ಸಂಖ್ಯೆಗಳು<br><br>

अपवाद
अपवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ<br><b>निष्पत्तिः - </b>अप + वद (व्यक्तायां वाचि) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"कोऽपवादः स्तुतिपदे यदशीलेषु चञ्चलाः"<br><b>उल्लेखाः - </b>किरा० ११-२५<br><br>अपवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಿಥ್ಯಾವಾದ /ನಿಜವನ್ನು ಮರೆಸೆ ಸುಳ್ಳು ಹೇಳುವುದು<br><b>प्रयोगाः - </b>"गुणापवादेन तदन्यरोपणात्"<br><b>उल्लेखाः - </b>किरा० १४-१२<br><br>अपवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಜ್ಞೆ /ಅಪ್ಪಣೆ<br><b>प्रयोगाः - </b>"ततोऽपवादेन पताकिनीपतेश्चचाल निर्ह्रादवती महाचमूः"<br><b>उल्लेखाः - </b>किरा० १४-२७<br><br>अपवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶೇಷಶಾಸ್ತ್ರ /ಭಾಧಕಶಾಸ್ತ್ರ<br><b>निष्पत्तिः - </b>अप + वद (व्यक्तायां वाचि) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>अपोद्यते सामान्यशास्त्रमनेन<br><b>प्रयोगाः - </b>"अपवाद इवोत्सर्गं व्यावर्तयितुमीश्वरः"<br><b>उल्लेखाः - </b>रघु० १५-७<br><br>अपवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶ್ವಾಸ /ಪ್ರೀತಿ<br><br>अपवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ವಾದ್ಯ /ಕಿರುಗಂಟೆ ಮೊದಲಾದುದು<br><b>प्रयोगाः - </b>"मधुकरैरपवादकरैरिव"<br><b>उल्लेखाः - </b>माघ० ६-९<br><br>अपवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಂಬಿಕೆ<br><b>विस्तारः - </b>"अपवादस्तु निर्देशे निन्दाविस्रम्भयोरपि" - हेम० ।<br><br>अपवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಕೀರ್ತಿ<br><br>

अपवादक
अपवादक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿಸುವವನು /ದೂಷಿಸುವವನು<br><b>निष्पत्तिः - </b>अप + वद (व्यक्तायां वाचि) - "ण्वुल्" (३-१-१३३)<br><br>अपवादक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಶೇಷಶಾಸ್ತ್ರ<br><br>

अपवादिन्
अपवादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಕ /ದೂಷಿಸುವವನು<br><b>निष्पत्तिः - </b>अप + वद (व्यक्तायां वाचि) - "णिनिः" (३-२-७८)<br><b>प्रयोगाः - </b>"मन्दोत्साहः कृतोऽस्मि मृगयापवादिना माढव्येन"<br><b>उल्लेखाः - </b>शाकु० २<br><br>

अपवारण
अपवारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತರ್ಧಾನ /ಮರೆಯಾಗುವಿಕೆ<br><b>निष्पत्तिः - </b>अप + वृञ् (आवरणे) - भावे "ल्युट्" (३-३-११५०<br><br>अपवारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರೆಮಾಡುವುದು /ಆಚ್ಛಾದನ /ಮುಚ್ಚುವುದು<br><br>अपवारण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರೆ ಮಾಡುವ /ಮುಚ್ಚುವ<br><b>निष्पत्तिः - </b>अप + वृञ् (आवरणे) + णिच् - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अपवारयति<br><br>

अपवारित
अपवारित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ರಕಾಶ /ರಹಸ್ಯ<br><br>अपवारित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಟಕದಲ್ಲಿ ಒಂದು ಕಡೆ ತಿರುಗಿಕೊಂಡು ಮತ್ತೊಬ್ಬನಿಗೆ ಹೇಳುವುದು<br><b>प्रयोगाः - </b>"तद्भवेदपवारितम् । रहस्यन्तु यदन्यस्य परावृत्य प्रकाश्यते"<br><b>उल्लेखाः - </b>सा० द० ६-१३८<br><br>अपवारित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಲ್ಪಟ್ಟ /ಮರೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अप + वृञ् (आवरणे) + णिच् - "क्तः" (३-२-१०२)<br><br>

अपवार्य
अपवार्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮರೆ ಮಾಡಿ<br><b>निष्पत्तिः - </b>अप + वृञ् (आवरणे) + णिच् - "ल्यप्" (७-१-३७)<br><b>प्रयोगाः - </b>"त्रिपताकाकरेणान्यानपवार्यान्तरा कथाम्"<br><b>उल्लेखाः - </b>सा० द० ६-१३९<br><br>

अपवाह
अपवाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾಗದಿಂದ ಮತ್ತೊಂದು ಜಾಗಕ್ಕೆ ಒಯ್ಯುವುದು /ಸ್ಥಳಾಂತರಕ್ಕೆ ತೆಗೆದುಕೊಂಡು ಹೋಗುವುದು<br><b>व्युत्पत्तिः - </b>अपसार्य वाहः स्थानान्तरनयनम्<br><br>

अपवाहन
अपवाहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರದೇಶದಿಂದ ಜನರನ್ನು ತನ್ನ ದೇಶಕ್ಕೆ ಕರೆತರುವುದು<br><b>निष्पत्तिः - </b>अप + वह (प्रापणे) + णिच् - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"स्वदेशं वर्धयेत् राजा परदेस्गापवाहनात्"<br><b>उल्लेखाः - </b>हितो०<br><br>

अपवाह्य
अपवाह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೂರಕ್ಕೆ ಒಯ್ಯಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अप + वह (प्रापणे) - "ण्यत्" (३-१-१३४)<br><br>अपवाह्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ದೂರಕ್ಕೆ ತಳ್ಳಿ<br><b>निष्पत्तिः - </b>अप + वह (प्रापणे) + णिच् - "ल्यप्" (७-१-३७)<br><br>

अपविघ्न
अपविघ्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಘ್ನರಹಿತವಾದ /ಅಡ್ಡಿಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>अपगतो विघ्नो यस्मात्<br><b>प्रयोगाः - </b>"शतं क्रतूनामपविघ्नमाप"<br><b>उल्लेखाः - </b>रघु० ३-३८<br><br>

अपविद्ध
अपविद्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೧೨ ವಿಧ ಪುತ್ರರಲ್ಲೊಬ್ಬ /ತಾಯಿ ತಂದೆಯರಿಂದ ತ್ಯಜಿಸಲ್ಪಟ್ಟು ತಂದು ಸಾಕಲ್ಪಟ್ಟ ಮಗ<br><br>अपविद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ<br><br>अपविद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಗಲಾಡಿಸಲ್ಪಟ್ಟ /ಪರಿಹರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अप + व्यघ (ताडने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"रक्षोविप्रकृतावास्तामपविद्धशुचाविव"<br><b>उल्लेखाः - </b>रघु० १०-७४<br><br>अपविद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡಲ್ಪಟ್ಟ /ತ್ಯಜಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अपविद्धगदो बाहुर्भग्नशाख इव द्रुमः"<br><b>उल्लेखाः - </b>कुमा० २-२२<br><br>

अपविद्या
अपविद्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಿದ್ಯೆ /ಅಜ್ಞಾನ<br><b>प्रयोगाः - </b>"तत्त्वस्य संवित्तिरिवापविद्याम्"<br><b>उल्लेखाः - </b>किरा० १६-३२<br><br>अपविद्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೀಚ ವಿದ್ಯೆ<br><b>व्युत्पत्तिः - </b>अपकृष्टा विद्या<br><br>

अपव्यय
अपव्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯರ್ಥವಾದ ಖರ್ಚು /ದುಬಾರಿ ಖರ್ಚು<br><b>व्युत्पत्तिः - </b>अपकृष्टो व्ययः<br><br>अपव्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಜವನ್ನು ಮರೆ ಮಾಡುವುದು /ಸತ್ಯವನ್ನಡಗಿಸುವುದು<br><br>

अपशङ्क
अपशङ्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂದೇಹವಿಲ್ಲದ /ಸಂಶಯರಹಿತವಾದ<br><b>व्युत्पत्तिः - </b>अपगता शङ्का यस्य<br><br>अपशङ्क<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಸಂದೇಹವಿಲ್ಲದೆ /ಸಂಶಯರಹಿತವಾಗಿ<br><b>प्रयोगाः - </b>"अपशङ्कमङ्कपरिवर्तनोचिताः"<br><b>उल्लेखाः - </b>माघ० ४-४७<br><br>

अपशद
अपशद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಲೋಮಜಾತಿಯವನು<br><b>विस्तारः - </b>"वर्णमात्रानुलोमा ये षट्तेऽपशदसञ्ज्ञिताः" - वैज० ।<br><br>अपशद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀಚ /ಅಧಮ<br><b>निष्पत्तिः - </b>अप + शद्लृ (शातने) - "अच्" (३-१-१३४)<br><b>विस्तारः - </b>"निहीनोऽपशदो जाल्मः" - वैज० ।<br><br>

अपशब्द
अपशब्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಭ್ರಂಶ ಶಬ್ದ /ತಪ್ಪಾಗಿ ಉಚ್ಚರಿಸಲ್ಪಡುವ ಶಬ್ದ /ವ್ಯಾಕರಣನಿಯಮಕ್ಕೆ ವಿರುದ್ಧವಾದ ಶಬ್ದ<br><br>अपशब्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದಾವಚನ /ಬೈಗಳು<br><b>प्रयोगाः - </b>"प्रापाक्ष्णोर्गलदपशब्दमञ्जनाम्भः"<br><b>उल्लेखाः - </b>माघ० ८-४३<br><br>

अपशु
अपशु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಸು ಮತ್ತು ಕುದುರೆಗಳಿಗಿಂತ ಬೇರೆಯಾದ ತಿರ್ಯಗ್ಜಂತು<br><br>अपशु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಲ್ಲದ ಪಶು<br><br>अपशु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಶುಗಳಿಲ್ಲದ /ಗೋವುಗಳಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति पशुर्यत्र<br><br>

अपशुच्
अपशुच्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶೋಕರಹಿತವಾದ /ದುಃಖವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>अपगता शुक् यस्य<br><br>

अपशोक
अपशोक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶೋಕರಹಿತವಾದ /ದುಃಖವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>अपगतः शोको यस्मात्<br><br>

अपश्चिम
अपश्चिम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊದಲನೆಯ /ಮೊದಲಿಗ /ಅಗ್ರೇಸರ<br><b>व्युत्पत्तिः - </b>न पश्चिमः<br><b>प्रयोगाः - </b>"शिश्रिये सुमनसामपश्चिमः पश्चिमे वयसि नैमिशं वशी"<br><b>उल्लेखाः - </b>रघु० १९-१<br><br>अपश्चिम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊನೆಯದಲ್ಲದ<br><b>प्रयोगाः - </b>"प्रसीदतु महाराजो ममानेनापश्चिमेन प्रणयेन"<br><b>उल्लेखाः - </b>वेणी० ६<br><br>अपश्चिम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕವಾದ /ಮಿತಿಮೀರಿದ<br><b>प्रयोगाः - </b>"अपश्चिमामिमां कष्टमापदं प्राप्तवत्यहम्"<br><b>उल्लेखाः - </b>रामा०<br><br>

अपश्यत्
अपश्यत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡದಿರುವ /ಕಾಣದಿರುವ<br><b>निष्पत्तिः - </b>दृशिर् (प्रेक्षणे) - "शतृ" (३-२-१२४)<br><b>व्युत्पत्तिः - </b>न पश्यति<br><b>प्रयोगाः - </b>"अपश्यद्भिरिवेशानम्" । "अपश्यतोऽभवदतिदुःखितं मनः सुचक्षुषः प्रविचरतो महात्मनः" ।<br><b>उल्लेखाः - </b>किरा० १५-२, रामा०<br><br>

अपश्री
अपश्री<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದರಿದ್ರ /ಬಡವ<br><b>व्युत्पत्तिः - </b>अपगता श्रीः सम्पद्यस्य<br><br>अपश्री<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಂತಿಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>अपगता श्रीः शोभा यस्मात्<br><b>प्रयोगाः - </b>"कुमुदवनमपश्रि श्रीमदम्भोजषण्डम्"<br><b>उल्लेखाः - </b>माघ० ११-६४<br><br>

अपष्ठ
अपष्ठ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಕುಶದ ತುದಿ<br><b>निष्पत्तिः - </b>अप + ष्ठा (गतिनिवृत्तौ) - "कः" (३-१-१३६)<br><b>विस्तारः - </b>"अपष्ठन्त्वङ्कुशस्याग्रम्" - वैज० ।<br><br>

अपष्ठु
अपष्ठु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲ /ಸಮಯ<br><br>अपष्ठु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಕೂಲವಾದ /ವಿರುದ್ಧವಾದ<br><br>अपष्ठु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕೂಲವಾದ<br><br>अपष्ठु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಡಭಾಗದ<br><b>निष्पत्तिः - </b>अप + ष्ठा (गतिनिवृत्तौ) - "कुः" (उ० १-२५)<br><b>विस्तारः - </b>"अपष्ठुः पुंसि काले च वामे स्यादन्यलिङ्गकः" - मेदि० ।<br><br>अपष्ठु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ತಪ್ಪಾಗಿ /ವಿರುದ್ಧವಾಗಿ /ಸುಳ್ಳಾಗಿ<br><b>प्रयोगाः - </b>"तव धर्मराज इति नाम कथमिदमपष्ठु पठ्यते"<br><b>उल्लेखाः - </b>माघ० १५-१७<br><br>अपष्ठु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ತಪ್ಪಿಲ್ಲದೆ /ನಿರ್ದೋಷವಾಗಿ<br><br>अपष्ठु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸುಂದರವಾಗಿ /ಅಂದವಾಗಿ<br><b>विस्तारः - </b>"प्रतिकूलानुकूलार्थे अपष्ठुरमपष्ठु च" - वैज० । "अपष्ठु चारौ निर्दोषे" - हेम० ।<br><br>

अपस्
अपस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸ /ಕಾರ್ಯ<br><b>निष्पत्तिः - </b>आप्लृ (व्याप्तौ) - "असुन्" ह्रस्वश्च (उ० ४-२०७)<br><br>अपस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪವಿತ್ರ ಕಾರ್ಯ /ಧರ್ಮಕಾರ್ಯ<br><br>अपस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು<br><br>अपस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯನಿರತನಾದ /ಪ್ರಯತ್ನಶೀಲ<br><br>

अपसद्
अपसद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಮ /ನೀಚ /ಪಾಪಿ<br><b>विस्तारः - </b>"पापे त्वधमापसदध्रुवाः" - त्रिकाण्ड० ।<br><br>

अपसर
अपसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿರ್ಗಮನ /ಹೊರಡುವಿಕೆ<br><b>निष्पत्तिः - </b>अप + सृ (गतौ) - "अच्" (३-३-११८)<br><br>अपसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಗ್ರಹ /ಸ್ವೀಕಾರ /ತೆಗೆದುಕೊಳ್ಳುವಿಕೆ<br><b>प्रयोगाः - </b>"निरन्वयोऽनपसरः प्राप्तः स्यात्"<br><b>उल्लेखाः - </b>मनु० ८-१९८<br><br>

अपसरण
अपसरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿರ್ಗಮನ /ಹೊರಡುವಿಕೆ<br><b>निष्पत्तिः - </b>अप + सृ (गतौ) - भावे "ल्युट्" (३-३-११५)<br><br>

अपसर्ग
अपसर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತ್ಯಾಗ /ದಾನ<br><br>अपसर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಸರ್ಜನ /ತ್ಯಜಿಸುವುದು<br><b>निष्पत्तिः - </b>अप + सृज (विसर्गे) - भावे "घञ्" (३-३-१८)<br><br>

अपसर्प
अपसर्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೂಢಾಚಾರ<br><b>निष्पत्तिः - </b>अप + सृप्लृ (गतौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अपसर्पति<br><b>प्रयोगाः - </b>"सर्पाधिराजोरुभुजोऽपसर्गं पप्रच्छ भद्रं विजिरातिभद्रः"<br><b>उल्लेखाः - </b>रघु० १४-३१<br><br>अपसर्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಸರಣ /ನಿರ್ಗಮನ<br><b>निष्पत्तिः - </b>अप + सृप्लृ (गतौ) - भावे "घञ्" (३-३-१८)<br><br>

अपसर्पण
अपसर्पण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಸರಣ /ನಿರ್ಗಮನ<br><b>निष्पत्तिः - </b>अप + सृप्लृ (गतौ) - भावे "ल्युट्" (३-३-११५)<br><br>

अपसव्य
अपसव्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶರೀರದ ಬಲಭಾಗ<br><b>व्युत्पत्तिः - </b>अपक्रान्तं सव्यात्<br><br>अपसव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿರುದ್ಧವಾದ /ಪ್ರತಿಕೂಲವಾದ<br><br>अपसव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಲಭಾಗದ<br><br>

अपसार
अपसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೂರಕ್ಕೆ ತಳ್ಳುವುದು<br><br>अपसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಿಷ್ಕಾರ /ಹೊರದೂಡುವುದು<br><b>निष्पत्तिः - </b>अप + सृ (गतौ) - "घञ्" (३-३-१८)<br><br>अपसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಓಡಿ ಹೋಗುವುದು<br><b>प्रयोगाः - </b>"व्याप्तं लोकैर्दुःखलभ्यापसारम्"<br><b>उल्लेखाः - </b>माघ० १८-४०<br><br>

अपसारण
अपसारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>अपसार ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अप + सृ (गतौ) + णिच् - भावे "ल्युट्" (३-३-११५)<br><br>

अपसारणा
अपसारणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अपसार ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अप + सृ (गतौ) + णिच् - "युच्" (३-३-१०७)<br><br>

अपसारित
अपसारित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೂರ ಮಾಡಲ್ಪಟ್ಟ<br><br>अपसारित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಿಷ್ಕರಿಸಲ್ಪಟ್ಟ /ಹೊರದೂಡಲ್ಪಟ್ಟ<br><br>अपसारित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಓಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अप + सृ (गतौ) + णिच् - "क्तः" (३-२-१०२)<br><br>

अपस्कर
अपस्कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಥದ ಅವಯವ /ರಥದ ಭಾಗ<br><b>प्रयोगाः - </b>"अपस्करो रथाङ्गम्"<br><b>उल्लेखाः - </b>पा० सू० ६-१-१४९<br><br>

अपस्नात
अपस्नात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೃತನಿಗಾಗಿ ಸ್ನಾನ ಮಾಡಿದ /ಮರಣಕ್ಕಾಗಿ ಸ್ನಾನ ಮಾಡಿದ<br><b>व्युत्पत्तिः - </b>अपकृष्टं स्नातः<br><br>

अपस्नान
अपस्नान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರಣವಾರ್ತೆಯನ್ನು ಕೇಳಿ ಮಾಡುವ ಸ್ನಾನ<br><b>व्युत्पत्तिः - </b>अपकृष्टं स्नानम्<br><br>अपस्नान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ನಾನ ಮಾಡಿದ ನಿಂತ ನೀರು /ಮೈ ತೊಳೆದ ನೀರು<br><b>व्युत्पत्तिः - </b>अपक्रान्तः स्नानात्<br><b>प्रयोगाः - </b>"उद्वर्तनमपस्नानं विण्मूत्रे रक्तमेव च । श्लेष्मानिष्ठ्यूतवान्तानि नाधितिष्ठेत्तु कामतः ॥"<br><b>उल्लेखाः - </b>मनु० ४-१३२<br><br>

अपस्पश
अपस्पश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೂಢಾಚಾರನಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>अपगतः स्पशः यस्मात्<br><b>प्रयोगाः - </b>"शब्दविद्येव नोभाति राजनीतिमपस्मशा"<br><b>उल्लेखाः - </b>माघ० २-११२<br><br>अपस्पश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಸ್ಪಶ ಗ್ರಂಥವಿಲ್ಲದ<br><br>

अपस्मार
अपस्मार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂರ್ಚ್ಛೆ ರೋಗ<br><b>निष्पत्तिः - </b>अप + स्मृ (चिन्तायाम्) + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अपस्मारयति<br><br>

अपस्मारिन्
अपस्मारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂರ್ಚ್ಛೆ ರೋಗ<br><br>

अपहत
अपहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अप + हन (हिंसागत्योः) - "क्तः" (३-२-१०२)<br><br>

अपहति
अपहति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸುವುದು<br><b>निष्पत्तिः - </b>अप + हन (हिंसागत्योः) - "क्तिन्" (३-३-९४)<br><br>

अपहर
अपहर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಹರಿಸುವ /ಕದಿಯುವ<br><b>निष्पत्तिः - </b>अप + हृञ् (हरणे) - "अच्" (३-१-१३४)<br><br>

अपहरण
अपहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕದಿಯುವುದು /ಕಳ್ಳತನ<br><br>अपहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಯ್ಯುವುದು /ಸ್ಥಳಾಂತಕ್ಕೆ ಬದಲಾಯಿಸುವುದು<br><b>निष्पत्तिः - </b>अप + हृञ् (हरणे) - "ल्युट्" (३-३-११५)<br><br>

अपहरणीय
अपहरणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಹರಿಸಲು ಯೋಗ್ಯವಾದ<br><br>अपहरणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಹರಿಸಲು ಶಕ್ಯವಾದ<br><br>अपहरणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಹರಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अप + हृञ् (हरणे) - "अनीयर्" (३-१-९६)<br><b>व्युत्पत्तिः - </b>अपहर्तुमर्हं शक्यम् अपह्रियते वा<br><br>अपहरणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಯ್ಯಲು ಅರ್ಹವಾದ<br><br>अपहरणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಯ್ಯಲು ಶಕ್ಯವಾದ<br><br>अपहरणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಯ್ಯಲ್ಪಡುವ<br><br>

अपहर्तृ
अपहर्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಹಾರ ಮಾಡುವ /ಕದಿಯುವ<br><b>निष्पत्तिः - </b>अप + हृञ् (हरणे) - "तृच्" (३-१-१३३)<br><br>

अपहर्त्री
अपहर्त्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಹಾರ ಮಾಡುವ /ಕದಿಯುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अपहसन
अपहसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಹಾಸ್ಯ /ಕುಚೋದ್ಯ<br><b>निष्पत्तिः - </b>अप + हसे (हसने) - "ल्युट्" (३-३-११५)<br><br>

अपहसित
अपहसित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಹಾಸ್ಯ /ಕುಚೋದ್ಯ<br><b>निष्पत्तिः - </b>अप + हसे (हसने) - भावे "क्तः" (३-२-१०२)<br><br>अपहसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಹಾಸ್ಯ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अप + हसे (हसने) - कर्म० "क्तः" (३-२-२१०२)<br><br>

अपहस्त
अपहस्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊರದೂಡಲು ಕುತ್ತಿಗೆಯ ಮೇಲೆ ಇಡುವ ಹಸ್ತ /ತಳ್ಳಲು ಕತ್ತಿನ ಮೇಲೆ ಇಟ್ಟಿರುವ ಕೈ<br><b>व्युत्पत्तिः - </b>अपसारणाय उद्यतो हस्तः<br><br>

अपहस्तित
अपहस्तित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುತ್ತಿಗೆಯ ಮೇಲೆ ಕೈಯಿಟ್ಟು ನೂಕಲ್ಪಟ್ಟ /ಕತ್ತು ಹಿಡಿದು ತಳ್ಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>अपहस्तोऽस्य सञ्जातः<br><br>अपहस्तित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ /ಅಪಮಾನಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>

अपहार
अपहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾನಿ /ನಾಶ<br><b>निष्पत्तिः - </b>अप + हृञ् (हरणे) - "घञ्" (३-३-१८)<br><b>विस्तारः - </b>"अपहारस्त्वपचयः" - अम० ।<br><br>अपहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೋರ /ಕಳ್ಳ<br><br>अपहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೂಜು ಮತ್ತು ಯುದ್ಧಗಳ ಮಧ್ಯೆ ಕೊಡುವ ವಿರಾಮ<br><br>अपहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಹ್ವಾನದ ಮೇಲೆ ಹೋದಕಡೆ ಅವಶ್ಯ ಕೊಡಬೇಕಾದ ವಸ್ತು<br><br>अपहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಸಳೆ<br><b>विस्तारः - </b>"अपहारः पुनश्चोरे द्यूतयुद्धादिविश्रमे । निमन्त्रणोपनेतव्यद्रव्ये ग्राहाख्ययादसि" - वैज० ।<br><br>अपहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೆಗೆದು ಹಾಕುವುದು /ಕಿತ್ತೊಗೆಯುವುದು<br><b>प्रयोगाः - </b>"कर्णनासापहारेण भगिनी मे विरूपिता"<br><b>उल्लेखाः - </b>रामा०<br><br>अपहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರೆ ಮಾಚುವುದು /ನಿಜವನ್ನು ಮುಚ್ಚುವುದು<br><b>प्रयोगाः - </b>"कथमात्मानं निवेदयामि । कथं वात्मापहारं करोमि"<br><b>उल्लेखाः - </b>शाकु०<br><br>अपहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಯ್ಯುವುದು /ಬೇರೆ ಕಡೆಗೆ ಸಾಗಿಸುವುದು<br><br>

अपहारक
अपहारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪರಿಸುವ /ಕದಿಯುವ<br><b>निष्पत्तिः - </b>अप + हृञ् (हरणे) - "ण्वुल्" (३-१-१३३)<br><br>अपहारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಕಡೆಗೆ ಒಯ್ಯುವ /ಸ್ಥಳಾಂತರಕ್ಕೆ ಬದಲಾಯಿಸುವ<br><br>अपहारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರೆ ಮಾಚುವ /ವಂಚಿಸುವ<br><br>अपहारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶ ಪಡಿಸುವ<br><br>

अपहारिन्
अपहारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>अपहारक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अप + हृञ् (हरणे) - "णीनिः" (३-२-७८)<br><br>

अपहारिणी
अपहारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अपहारक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अपहास
अपहास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರಣವಿಲ್ಲದೆ ನಗುವುದು<br><b>निष्पत्तिः - </b>अप + हसे (हसने) - भावे "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"अपहासः परमाददे महद्भिः"<br><b>उल्लेखाः - </b>याद० १५-१०८<br><br>

अपहृत
अपहृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕದಿಯಲ್ಪಟ್ಟ<br><br>अपहृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಯ್ಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अप + हृञ् (हरणे) - "क्तः" (३-२-१०२)<br><br>

अपह्नव
अपह्नव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಯವನ್ನಡಗಿಸುವಿಕೆ /ಇರುವುದನ್ನು ಅದಲ್ಲವೆಂದು ಹೇಳುವುದು<br><b>निष्पत्तिः - </b>अप + ह्नुङ् (अपनयने) - "अप्" (३-३-५७)<br><br>अपह्नव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೇಮ /ಪ್ರೀತಿ /ಸ್ನೇಹ<br><br>अपह्नव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತುತಿ /ಸ್ತೋತ್ರ<br><b>विस्तारः - </b>"स्तुतिस्नेहावपह्नवौ" - वैज० ।<br><br>अपह्नव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥಾಲಂಕಾರದ ಒಂದು ಭೇದ<br><b>प्रयोगाः - </b>"प्रकृतं यन्निपिध्यान्यत्साध्यते सात्वहह्नुतिः"<br><b>उल्लेखाः - </b>काव्यप्र<br><br>

अपह्नुति
अपह्नुति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಯವನನ್ಡಗಿಸುವಿಕೆ /ಇರುವುದನ್ನು ಇಲ್ಲವೆಂದು ಹೇಳುವಿಕೆ<br><br>अपह्नुति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥಾಲಂಕಾರದ ಒಂದು ಭೇದ<br><b>विस्तारः - </b>"वह्निवातावपाङ्गर्भौ" - वैज० ।<br><br>

अपाङ्गर्भ
अपाङ्गर्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><br>अपाङ्गर्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯು /ಗಾಳಿ<br><br>

अपान्नपात्
अपान्नपात्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞದೆವತೆ<br><b>निष्पत्तिः - </b>षष्ठ्या अलुक् (६-३-१४)<br><b>व्युत्पत्तिः - </b>अपो न पातयति<br><br>

अपान्निधि
अपान्निधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ<br><b>निष्पत्तिः - </b>षष्ठ्या अलुक् (६-३-१४)<br><br>अपान्निधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>"अपां निधिरधिष्ठानमप्रमत्तः प्रतिष्ठितः"<br><b>उल्लेखाः - </b>वि० स०<br><br>

अपाम्पति
अपाम्पति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ<br><br>अपाम्पति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರುಣ<br><b>निष्पत्तिः - </b>षष्ठ्या अलुक् (६-३-१४)<br><b>प्रयोगाः - </b>"अपाम्पतिर्नित्यमबिन्धनेन"<br><b>उल्लेखाः - </b>याद० १८-४५<br><br>

अपांयोनि
अपांयोनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ<br><b>निष्पत्तिः - </b>षष्ठ्या अलुक् (६-३-१४)<br><br>

अपाक
अपाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಚನವಾಗದಿರುವಿಕೆ<br><br>अपाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಜೀರ್ಣ /ಅಗ್ನಿಯ ಮಾಂದ್ಯದಿಂದ ಆಹಾರವು ಜೀರ್ಣವಾಗದಿರುವಿಕೆ<br><br>अपाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಜೀರ್ಣರೋಗ<br><br>अपाक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇಯಿಸಲ್ಪಡದ /ಪಕ್ವವಾಗದ<br><br>

अपाकज
अपाकज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಕದಿಂದುಂಟಾದ<br><br>अपाकज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಭಾವ ಸಿದ್ಧವಾದ /ಪ್ರಕೃತಿ ಸಿದ್ಧವಾದ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>पाकाज्जायते<br><br>

अपाकरण
अपाकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರ /ನಿರಾಕರಣೆ<br><br>अपाकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೂರಕ್ಕೆ ತಳ್ಳುವುದು<br><br>अपाकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಿಷ್ಕರಿಸುವುದು<br><b>निष्पत्तिः - </b>अप + आ + डुकृञ् (करणे) - "ल्युट्" (३-३-११५)<br><br>

अपाकरिष्णु
अपाकरिष्णु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೂರಕ್ಕೆ ತಳ್ಳುವ ಸ್ವಭಾವದ<br><br>अपाकरिष्णु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸುವ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>अप + आ + डुकृञ् (करणे) - "इष्णुच्" बाहु० ।<br><br>

अपाकर्मन्
अपाकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಲದ ಸಂದಾಯ /ಸಾಲವನ್ನು ತೀರಿಸುವಿಕೆ<br><br>

अपाकृत
अपाकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಓಡಿಸಲ್ಪಟ್ಟ /ಚೆದುರಿಸಲ್ಪಟ್ಟ<br><br>अपाकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೂರ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अप + आ + डुकृञ् (करणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"त्वयि पूजनं जगति जाल्म कृतमिदमपाकृतेः गुणैः"<br><b>उल्लेखाः - </b>माघ० १५-३३<br><br>अपाकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ<br><br>

अपाकृति
अपाकृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರ<br><br>अपाकृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿವಾರಣೆ /ಪರಿಹಾರ<br><b>निष्पत्तिः - </b>अप + आ + डुकृञ् (करणे) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"निशम्य सिद्धिं द्विषतामपाकृतीः"<br><b>उल्लेखाः - </b>किरा० १-२७<br><br>अपाकृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಕಾರದಿಂದುಂಟಾಗುವ ಚಿತ್ತವಿಕಾರ /ಕಳವಳ<br><b>प्रयोगाः - </b>"अपाङ्क्तदाने यो दातुर्भवत्यूर्ध्वं फलोदयः"<br><b>उल्लेखाः - </b>मनु० ३-१६९<br><br>

अपाङ्क्त
अपाङ्क्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಪಂಕ್ತಿಯಲ್ಲಿ ಕುಳಿತು ಭೋಜನಾದಿಗಳನ್ನು ಮಾಡಲು ಯೋಗ್ಯನಲ್ಲದವನು<br><b>निष्पत्तिः - </b>"ढक्"<br><b>व्युत्पत्तिः - </b>न पङ्क्तिमर्हति<br><b>प्रयोगाः - </b>"एतान्विगर्हिताचारानपाङ्क्तेयान् द्विजाधमान्"<br><b>उल्लेखाः - </b>मनु० ३-१६७<br><br>

अपाङ्क्तेय
अपाङ्क्तेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಂಕ್ತಿಗೆ ಯೋಗ್ಯನಲ್ಲದ /ಪಂಕ್ತಿಯಲ್ಲಿ ಕುಳಿತು ಭೋಜನಾದಿಗಳನ್ನು ಮಾಡಲು ಯೋಗ್ಯನಲ್ಲದ<br><b>निष्पत्तिः - </b>पङ्क्ति - "अञ्" (४-१-८६) । "ष्यञ्" (वा० ७-३-३१)<br><b>प्रयोगाः - </b>"अपाङ्क्त्यो यावतः पाङ्क्त्यान्भुञ्जानाननुपश्यति"<br><b>उल्लेखाः - </b>मनु० ३-१७६<br><br>

अपाङ्क्त्य
अपाङ्क्त्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಪಂಕ್ತಿಯಲ್ಲಿ ಕುಳಿತು ಭೋಜನಾದಿಗಳನ್ನು ಮಾಡಲು ಯೋಗ್ಯನಲ್ಲದವನು<br><b>प्रयोगाः - </b>"अपाङ्गाः परिपात्यन्ताम्"<br><b>उल्लेखाः - </b>याद० १६-२४<br><br>

अपाङ्ग
अपाङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಡೆಗಣ್ಣು /ಕಣ್ಣಿನ ಕೊನೆಯಭಾಗ<br><b>निष्पत्तिः - </b>अगि (गतौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अप अङ्गति<br><b>विस्तारः - </b>"अपाङ्गो नेत्रान्तपुण्ड्रयोः" - हेम० ।<br><br>अपाङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿಲಕ /ಪುಂಡ್ರ<br><br>अपाङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗವಿಹೀನ /ಊನವಾದ ಅವಯವಗಳುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अपगतान्यङ्गान्यस्य<br><br>

अपाङ्गदर्शन
अपाङ्गदर्शन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಡೆಗಣ್ಣಿನ ನೋಟ<br><b>व्युत्पत्तिः - </b>अपाङ्गेन दर्शनम्<br><br>

अपाच्
अपाच्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂದಕ್ಕೆ ಹೋಗುವ /ಹಿಮ್ಮೆಟ್ಟುವ<br><br>अपाच्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ರಕಾಶವಾದ /ಅಸ್ಪಷ್ಟವಾದ<br><b>निष्पत्तिः - </b>अञ्चु (गतौ) - "क्विन्" (३-२-५९)<br><b>व्युत्पत्तिः - </b>अपाञ्चति<br><br>अपाच्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹಿಂಭಾಗಕ್ಕೆ<br><br>अपाच्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣ ದಿಕ್ಕಿಗೆ<br><br>अपाच्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪಶ್ಚಿಮ ದಿಕ್ಕಿಗೆ<br><br>

अपाची
अपाची<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣ ದಿಕ್ಕು<br><b>निष्पत्तिः - </b>अप + अञ्चु (गतौ) - "क्विन्" (३-२-५९) । "ङीप्" (४-१-६)<br><b>व्युत्पत्तिः - </b>अपाञ्चति सूर्यम्<br><br>अपाची<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಶ್ಚಿಮ ದಿಕ್ಕು<br><br>

अपाचीन
अपाचीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣ ದಿಕ್ಕಿನ<br><b>निष्पत्तिः - </b>"खः" (५-४-८)<br><br>अपाचीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಶ್ಚಿಮ ದಿಕ್ಕಿನ<br><b>व्युत्पत्तिः - </b>अपाच्यां भवः<br><br>अपाचीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಭಾಗದಲ್ಲಿರುವ<br><br>अपाचीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ರಕಾಶವಾದ /ಕಣ್ಣಿಗೆ ಕಾಣದ<br><br>

अपाच्य
अपाच्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣ ದಿಕ್ಕಿನಲ್ಲಿರುವ /ದಕ್ಷಿಣ ದಿಕ್ಕಿನಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>"यत्" (४-२-१०१)<br><b>व्युत्पत्तिः - </b>अपाच्यां भवः<br><br>

अपाटव
अपाटव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಕುಶಲತೆ /ಚುರುಕಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न पाटवम्<br><br>अपाटव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಾಮರ್ಥ್ಯ /ಅಶಕ್ತತೆ<br><br>अपाटव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗ /ಬೇನೆ<br><b>व्युत्पत्तिः - </b>नास्ति पाटवं यत्र<br><br>अपाटव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಕುಶಲ /ಚತುರನಲ್ಲದ<br><br>

अपाणिनीय
अपाणिनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಣಿನಿ ಮಹರ್ಷಿಯಿಂದ ಹೇಳಲ್ಪಡದ /ಪಾಣಿನಿ ಸೂತ್ರಗಳಿಗೆ ಅನುಗುಣವಲ್ಲದ<br><br>अपाणिनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಣಿನಿಯ ಗ್ರಂಥವನ್ನು ಅಧ್ಯಯನ ಮಾಡದವನು<br><br>

अपात्र
अपात्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸಕ್ಕೆ ಬಾರದ ಪಾತ್ರೆ<br><br>अपात्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಾನಕ್ಕೆ ಯೋಗ್ಯನಲ್ಲದ ಪುರುಷ<br><b>प्रयोगाः - </b>"अदेशकाले यद्दानं अपात्रेभ्यश्च दीयते । असत्कृतमवज्ञातं तत्तामसमुदाहृतम् ॥"<br><b>उल्लेखाः - </b>गीता० १७-२२<br><br>

अपात्रीकरण
अपात्रीकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯನನ್ನಾಗಿ ಮಾಡುವುದು<br><br>अपात्रीकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನರ್ಹನನ್ನಾಗಿ ಮಾಡುವ ಪಾಪಕೃತ್ಯ<br><b>प्रयोगाः - </b>"निन्दितेभ्यो धनादानं वाणिज्यं शूद्रसेवनम् । अपात्रीकरणं ज्ञेयमसत्यस्य च भाषणम् ॥"<br><b>उल्लेखाः - </b>मनु० ११-६९<br><br>

अपादान
अपादान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಹಾರ /ಕಸಿದುಕೊಳ್ಳುವುದು<br><br>अपादान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣ ಶಾಸ್ತ್ರದಲ್ಲಿ ಹೇಳಿರುವ ಅಪಾದಾನ ಸಂಜ್ಞೆಯುಳ್ಳದ್ದ್ಯು<br><b>प्रयोगाः - </b>"ध्रुवमपायेऽपादनम्"<br><b>उल्लेखाः - </b>पा० सू०<br><br>

अपान
अपान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹದಲ್ಲಿರುವ ಪಂಚಪ್ರಾಣವಾಯುಗಳಲ್ಲೊಂದು<br><b>निष्पत्तिः - </b>अप + अन (प्रानने) - "घञ्" (३-३-३२१)<br><b>व्युत्पत्तिः - </b>अपसारणेन अनित्यनेन<br><br>अपान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುದ /ಮಲದ್ವಾರ<br><br>अपान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೃಷಣ /ಅಂಡಕೋಶ<br><b>विस्तारः - </b>"अपानो देहजो वायुरपानं वृषणे गुदे" - वैज० ।<br><br>

अपानन
अपानन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ವಾಸೋಚ್ಛ್ವಾಸ<br><br>अपानन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಲಮೂತ್ರಾದಿಗಳ ವಿಸರ್ಜನೆ<br><b>निष्पत्तिः - </b>अप + अन (प्रानने) - भावे "ल्युट्" (३-३-११५)<br><br>

अपामार्ग
अपामार्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರೆಣಿ ಗಿಡ<br><b>व्युत्पत्तिः - </b>अपकृष्टः आ समन्तात् मार्गोऽस्य<br><br>

अपाय
अपाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶ್ಲೇಷ /ಅಗಲಿಕೆ<br><b>निष्पत्तिः - </b>अप + इण् (गतौ) - "अच्" (३-३-५६)<br><br>अपाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಲಾಯನ /ಓಟ<br><br>अपाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶ<br><b>प्रयोगाः - </b>"मालत्यपायमधिगम्य विरक्तचेताः"<br><b>उल्लेखाः - </b>मालती० १०-९<br><b>विस्तारः - </b>"नाशस्त्वपक्रमोऽपायः" - वैज० ।<br><br>अपाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾನಿ /ಕೇಡು<br><b>प्रयोगाः - </b>"उपायं चिन्तयेत् प्राज्ञस्तथापायं च चिन्तयेत्"<br><b>उल्लेखाः - </b>पञ्चतं०<br><br>

अपायिन्
अपायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಾಯವುಳ್ಳ<br><br>अपायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗಲಿಕೆಯುಳ್ಳ<br><br>अपायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶವುಳ್ಳ /ನಶ್ವರವಾದ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>अपायोऽस्यास्ति<br><b>प्रयोगाः - </b>"आगमापायिनोऽनित्याः"<br><b>उल्लेखाः - </b>गीता० २-१४<br><br>

अपार
अपार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ<br><br>अपार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನದಿಯ ಎದುರು ದಡ<br><br>अपार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾದ /ಅಧಿಕವಾದ<br><b>व्युत्पत्तिः - </b>नास्ति पारं यस्य<br><b>प्रयोगाः - </b>"अपारहर्षादनधामवस्थाम्"<br><b>उल्लेखाः - </b>याद० १३-६१<br><br>अपार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಧಿಯಿಲ್ಲದ<br><br>अपार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೀರವಿಲ್ಲದ /ದಡವಿಲ್ಲದ<br><br>अपार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕಷ್ಟವಾದ<br><br>अपार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗಾಧವಾದ /ಆಳವಾದ<br><br>

अपारा
अपारा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೃಥ್ವಿ /ಭೂಮಿ<br><br>

अपार्थ
अपार्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಂಬದ್ಧವಾದ ಅರ್ಥ<br><br>अपार्थ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥವಲ್ಲದ ಮಾತು /ಅಸಂಬದ್ಧ ವಾಕ್ಯ<br><b>प्रयोगाः - </b>"समुदायार्थशून्यं यत्तदपार्थमितीष्यते"<br><b>उल्लेखाः - </b>काव्यप्र०<br><br>अपार्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯರ್ಥವಾದ /ಪ್ರಯೋಜನವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>अपगतोऽर्थः प्रयोजनं यस्मात्<br><br>

अपावर्तन
अपावर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುತ್ತುವುದು /ತಿರುಗುವಿಕೆ /ಪ್ರದಕ್ಷಿಣೆ<br><br>अपावर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರ<br><br>अपावर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂದಕ್ಕೆ ಓಡುವುದು<br><b>निष्पत्तिः - </b>अप + आ + वृतु (वर्तने) - "ल्युट्" (३-३-११५)<br><br>अपावर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿಯ ಮೆಲೆ ಹೊರಳಾಡುವುದು<br><br>

अपावृत
अपावृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆವರಣ ತೆಗೆಯಲ್ಪಟ್ಟ<br><br>अपावृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆರೆಯಲ್ಪಟ್ಟ /ಬಿಚ್ಚಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"यदृच्छयाचोपपन्नं स्वर्गद्वारमपावृतम्"<br><b>उल्लेखाः - </b>गीता० २-३२<br><br>अपावृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಲ್ಪಟ್ಟ<br><br>अपावृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವತಂತ್ರ /ನಿರ್ಬಂಧವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>अपगतमावृतमावरणं यस्य<br><b>प्रयोगाः - </b>"त्वं ब्रह्म परमं साक्षादनाद्यन्तमपावृतम्"<br><b>उल्लेखाः - </b>भाग० ११-१६-१<br><br>

अपावृति
अपावृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆವರಣ ತೆಗೆಯುವುದು /ನೋಟದ ವಿಘ್ನವನ್ನು ಹೋಗಲಾಡಿಸುವುದು<br><br>अपावृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೆರೆಯುವುದು /ಬಿಚ್ಚುವುದು<br><br>अपावृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಚ್ಚುವುದು /ಮರೆ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>अप + आ+ वृञ् (वरणे) - "क्तिन्" (३-३-९४)<br><br>

अपावृत्त
अपावृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರುಗಿದ /ಸುತ್ತಿದ<br><br>अपावृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಮ್ಮೆಟ್ಟಿದ /ಓಡಿ ಹೋದ<br><b>निष्पत्तिः - </b>अप + आ + वृतु (वर्तने) - "क्तः" (३-२-१०२)<br><br>अपावृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಾಙ್ಮುಖನಾದ /ಹಿಂದಕ್ಕೆ ತಿರುಗಿದ<br><b>प्रयोगाः - </b>"पुरः सूर्यादपावृत्तां छायामिव महातरुः"<br><b>उल्लेखाः - </b>किरा० १५-३३<br><br>

अपावृत्ति
अपावृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಿರುಗುವಿಕೆ /ಸುತ್ತುವಿಕೆ<br><br>अपावृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಮ್ಮೆಟ್ಟುವುದು /ಹಿಂದಕ್ಕೆ ಓಡುವುದು<br><b>निष्पत्तिः - </b>अप + आ + वृतु (वर्तने) - "क्तिन्" (३-३-९४)<br><br>

अपाश्रय
अपाश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ /ಅಭಯ ಸ್ಥಾನ<br><br>अपाश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಚ /ಪರ್ಯಂಕ<br><br>अपाश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಪ್ಪರ /ಅಂಗಳದ ಮೇಲ್ಛಾವಣಿ<br><br>अपाश्रय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯವಿಲ್ಲದ /ಸಹಾಯವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>अपगत आश्रयो यस्य<br><br>

अपासङ्ग
अपासङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬತ್ತಳಿಕೆ<br><b>निष्पत्तिः - </b>अप + आ+ षञ्ज (सङ्गे) - "घञ्" (३-३-१२१)<br><br>

अपासन
अपासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಸೆಯುವುದು<br><br>अपासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಳ್ಳುವುದು /ನೂಕುವುದು<br><br>अपासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಧೆ /ಕೊಲ್ಲುವುದು<br><b>निष्पत्तिः - </b>अप + असु (क्षेपणे) - "ल्युट्" (३-३-११५)<br><br>

अपासित
अपासित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಸೆಯಲ್ಪಟ್ಟ<br><br>अपासित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊರಡಿಸಲ್ಪಟ್ಟ<br><br>अपासित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಲಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अप + असु (क्षेपणे) + णिच् - "क्तः" (३-२-१०२)<br><br>

अपासृत
अपासृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೂರವಾದ /ಬಿಟ್ಟು ಹೊರಟಿರುವ<br><br>अपासृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಓಡಿ ಹೋದ<br><b>निष्पत्तिः - </b>अप + आ+ सृ (गतौ) - "क्तः" (३-४-७२<br><br>

अपास्त
अपास्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಸೆಯಲ್ಪಟ್ಟ<br><br>अपास्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಗಲಾಡಿಸಲ್ಪಟ್ಟ<br><br>अपास्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಓಡಿಸಲ್ಪಟ್ಟ /ಹೊರಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अप + असु (क्षेपणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"निरस्तगाम्भीर्यमपास्तपुष्पक्म्"<br><b>उल्लेखाः - </b>माघ० १-५५<br><br>अपास्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अस्तापास्तसमस्तभासि नभसः पारं प्रयात्ए रवौ"<br><b>उल्लेखाः - </b>रत्ना० १-२३<br><br>अपास्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತ್ಯಜಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अपास्तसमस्ताशमपि उपगतदक्षिणाशम्"<br><b>उल्लेखाः - </b>चं रा० ३<br><br>

अपास्य
अपास्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎಸೆದು<br><br>अपास्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೋಗಲಾಡಿಸಿ<br><br>अपास्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ತ್ಯಜಿಸಿ /ಬಿಟ್ಟು<br><b>निष्पत्तिः - </b>अप + असु (क्षेपणे) - "ल्पप्" (७-१-३७)<br><b>प्रयोगाः - </b>"किमित्यपास्याभरणानि यौवने"<br><b>उल्लेखाः - </b>कुमा० ५-४४<br><br>

अपि
अपि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ಬೈಗಳು<br><b>प्रयोगाः - </b>"धिग्देवदत्तम्, अपि स्यात् वृषलम्"<br><br>अपि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪದಾರ್ಥ<br><b>प्रयोगाः - </b>"सर्पिषोऽपि स्यात्"<br><br>अपि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಭಾವನೆ /ಹೆಚ್ಚು ಶಕ್ತಿಯನ್ನು ತೋರಿಸಿ ಕೊಡುವ ಅತಿಶಯೋಕ್ತಿ<br><b>प्रयोगाः - </b>"अपि स्याद्विष्णुम्"<br><b>विस्तारः - </b>"सम्भावनं शक्त्युत्कर्षमाविष्कर्तुमत्युक्तिः" - सि० कौ० ।<br><br>अपि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕಾಮಚಾರಾನುಜ್ಞೆ<br><b>प्रयोगाः - </b>"अपि स्तुहि"<br><br>अपि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಮುಚ್ಚಯ<br><b>प्रयोगाः - </b>"अपि स्तुहि, अपि सिञ्च" । "अस्ति मे सोदरस्नेहोप्येतेषु" ।<br><b>उल्लेखाः - </b>शाकु० १<br><br>अपि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ<br><b>प्रयोगाः - </b>"अपि क्रियार्थं सुलभं समित्कुशम्"<br><b>उल्लेखाः - </b>कुमा० ५-३३<br><br>अपि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯಾಶೆ /ನಿರೀಕ್ಷಣೆ<br><b>प्रयोगाः - </b>"अपि नाम दुरात्मा राक्षसो गृह्येत"<br><b>उल्लेखाः - </b>मुद्रा० १<br><br>अपि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂದೇಹ /ಶಂಕೆ<br><b>प्रयोगाः - </b>"अपि चोरो भवेत्? अपि देवदतो गच्छेत्"<br><br>

अपि
अपि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆದರೂ /ಆದಾಗ್ಯು<br><b>प्रयोगाः - </b>"अपि दृश्तमपि श्रुतं प्रभावं भवदियं भविनस्तमोऽभिभुताः"<br><b>उल्लेखाः - </b>याद० १५-२५<br><br>अपि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನಿರ್ದಿಷ್ಟ /ಅನಿರ್ವಾಚ್ಯ<br><b>प्रयोगाः - </b>"स्वस्ति यथास्थाने कुतोऽपि कोऽपि कमपि पुरुषविशेषमवगमयति" । "व्यतिषजति पदार्थानान्तरः कोऽपि हेतुः"<br><b>उल्लेखाः - </b>मुद्रा० ५, म् उ० रा० ६-१२<br><br>

अपिगीर्ण
अपिगीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲ್ಪಟ್ಟ<br><br>अपिगीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವರ್ಣಿಸಲ್ಪಟ್ಟ<br><br>अपिगीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಗಳಲ್ಪಟ್ಟ<br><br>

अपिच
अपिच<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮತ್ತೆ /ಇದಲ್ಲದೆ<br><b>प्रयोगाः - </b>"अपिच, दुराराध्या हि राजलक्ष्मीः आत्मवद्भिरपि"<br><b>उल्लेखाः - </b>मुद्रा० ३<br><br>

अपित्
अपित्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇತ್ ಸಂಜ್ಞೆಯುಳ್ಳ ಪಕಾರವಿಲ್ಲದ<br><b>प्रयोगाः - </b>"सार्वधातुकमपित्"<br><b>उल्लेखाः - </b>पा० सू०<br><br>

अपितु
अपितु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆದರೆ<br><b>प्रयोगाः - </b>"अपितु त्रपया न तास्तदुक्तीस्य इमे नन्विह चेतसा नमन्ति"<br><b>उल्लेखाः - </b>याद० १५-६०<br><br>अपितु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹಾಗಾದರೆ<br><br>

अपिधान
अपिधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಚ್ಚುವುದು /ಮರೆ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>अपि + डुधाञ् (धारणे - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"नैकजलदच्छत्रापिधानं जगत्"<br><b>उल्लेखाः - </b>मृच्छ० ५-२४<br><br>अपिधान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚುವ /ಮರೆ ಮಾಡುವ ಸಾಧನ<br><b>निष्पत्तिः - </b>अपि + डुधाञ् (धारणे - कर० "ल्यूट्" (३-३-११७)<br><b>प्रयोगाः - </b>"अमृतापिधानमसि"<br><br>

अपिहित
अपिहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚಲ್ಪಟ್ಟ /ಮರೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अपि + डुधाञ् (धारणे - "क्तः" (३-२-१०२)<br><br>अपिहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न पिहितम्<br><br>

अपीति
अपीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಳಯ /ವಿನಾಶ<br><b>प्रयोगाः - </b>"अपीतौ तद्वत् प्रसङ्गादसमञ्जसम्"<br><b>उल्लेखाः - </b>ब्र० सू० २-१-८<br><br>अपीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಯ /ಕರಗುವಿಕೆ<br><br>अपीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಗ್ರಾಮ /ಯುದ್ಧ<br><br>

अपीव्य
अपीव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಸುಂದರವಾದ /ಅತಿ ಸೊಗಸಾದ<br><b>प्रयोगाः - </b>"अपीव्यदर्शनं शश्वत्सर्वलोकनमस्कृतम् । सन्तं वयसि कैशोरे भृत्यानुग्रहकातरम्"<br><b>उल्लेखाः - </b>भाग०<br><br>

अपुंस्
अपुंस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ಲೀಬ /ಷಂಡ<br><b>प्रयोगाः - </b>"पुमान् पुंसोऽधिकेशुक्रे स्त्री भवत्यधिके स्त्रियाः । समेऽपुमान् पुंस्त्रियौ वा क्षीणेऽल्पे च विपर्ययः ॥"<br><b>उल्लेखाः - </b>मनु० ३-४९<br><br>

अपुंस्का
अपुंस्का<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುರುಷನಿಲ್ಲದ ಹೆಂಗಸು<br><b>व्युत्पत्तिः - </b>न पुमान् यस्याः<br><br>

अपुण्य
अपुण्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><br>अपुण्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುಣ್ಯವಿಲ್ಲದ<br><br>

अपुण्यकृत्
अपुण्यकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪಕೃತ್ಯಗಳನು ಮಾಡುವ<br><b>व्युत्पत्तिः - </b>अपुण्यं करोति<br><br>अपुण्यकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುಣ್ಯಕಾರ್ಯವನ್ನು ಮಾಡದ<br><b>व्युत्पत्तिः - </b>न पुण्यं करोति<br><b>प्रयोगाः - </b>"गृहानुपेतं प्रणयादभीप्सवो भवन्ति नापुण्यकृतां मनीषिणः"<br><b>उल्लेखाः - </b>माघ० १-१४<br><br>

अपुत्र
अपुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರನಿಲದ /ಮಗನಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति पुत्रो यस्य यस्या वा<br><b>प्रयोगाः - </b>"अपुत्रोऽनेन विधिना सुतां कुर्वीत पुत्रिकाम् । यदपत्यं भवेदस्यां तन्मम स्यात्स्वधारकम् ॥"<br><b>उल्लेखाः - </b>मनु० ९-१२७<br><br>अपुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯನಾದ ಮಗ<br><br>

अपुत्रा
अपुत्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯನಾದ ಮಗಳು<br><br>

अपुत्रक
अपुत्रक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರನಿಲದ /ಮಗನಿಲ್ಲದ<br><b>निष्पत्तिः - </b>"कप्" (५-४-१५४)<br><br>

अपुत्रिका
अपुत्रिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಗಳಿಲ್ಲದ<br><br>

अपुनर्
अपुनर्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಂದು ಸಲ<br><b>व्युत्पत्तिः - </b>न पुनः<br><br>

अपुनरावृत्ति
अपुनरावृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂದಿರುಗುವಿಕೆ<br><br>अपुनरावृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಕ್ಷ /ಮುಕ್ತಿ<br><br>अपुनरावृत्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುನಃ ಬರದಿರುವ<br><b>व्युत्पत्तिः - </b>न पुनरावृत्तिर्यस्य<br><br>

अपुनर्भव
अपुनर्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಕ್ಷ /ಮುಕ್ತಿ<br><br>अपुनर्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೆ ಹುಟ್ಟದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न पुनर्भवः<br><b>प्रयोगाः - </b>"हेतौ लिङ्गे प्रशमने रोगाणामपुनर्भवे । ज्ञानं चतुर्विधं यस्य स राजार्हो भिषक्तमः ॥"<br><b>उल्लेखाः - </b>चरक०<br><br>अपुनर्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತತ್ತ್ವಜ್ಞಾನ<br><br>अपुनर्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಿಹಾರ /ನಿವಾರಣೆ<br><br>अपुनर्भव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುನರ್ಜನ್ಮವಿಲ್ಲದ<br><br>

अपुष्ट
अपुष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಅರ್ಥದೋಷದಿಂದ ಕೂಡಿದ ಪದ<br><br>अपुष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೋಷಣೆ ಮಾಡಲ್ಪಡದ<br><br>अपुष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೃದುವಾದ /ಗಟ್ಟಿಯಲ್ಲದ ಧ್ವನಿ<br><br>

अपुष्टता
अपुष्टता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಅರ್ಥದೋಷ /ವಿವಕ್ಷಿತಾರ್ಥಕ್ಕೆ ಉಪಕಾರಕವಲ್ಲದ ದೋಷ<br><b>व्युत्पत्तिः - </b>अपुष्टस्य भावः<br><br>

अपुष्पफलद
अपुष्पफलद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪನಸ /ಹಲಸಿನ ಮರ<br><br>अपुष्पफलद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದುಂಬರ /ಅತ್ತಿ ಮರ<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>अपुष्पः सन् फलं ददाति<br><br>

अपूजा
अपूजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರಮರ್ಯಾದೆಯನ್ನು ಇಟ್ಟು ಮಾಡುವ ಪೂಜೆ<br><br>अपूजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗೌರವ<br><br>अपूजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಿಶ್ವಾಸ<br><br>अपूजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>

अपूजित
अपूजित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ<br><br>अपूजित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೌರವಿಸಲ್ಪಡದ<br><br>अपूजित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न पूजितः<br><br>

अपूत
अपूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪವಿತ್ರವಲ್ಲದ /ಪರಿಶುದ್ಧವಿಲ್ಲದ<br><br>अपूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾತ್ಯ /ಸಂಸ್ಕಾರವಿಲ್ಲದವನು<br><br>

अपूप
अपूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಟ್ಟಿನಿಂದ ಮಾಡುವ ರೊಟ್ಟಿ /ದೋಸೆ /ಹೋಳಿಗೆ<br><b>निष्पत्तिः - </b>पूयी (विशरणे) - "पः' बाहु० (३-३-१)<br><b>व्युत्पत्तिः - </b>न पूय्यते<br><br>अपूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುರೋಡಾಶ<br><b>प्रयोगाः - </b>"वृथाकृशरसंयावं पायसापूपमेव च"<br><b>उल्लेखाः - </b>मनु० ५-७<br><br>

अपूर्ण
अपूर्ण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂರ್ಣವಾಗದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>पॄ (पालनपूरणयोः) - भावे "क्तः" (३-३-११४)<br><br>अपूर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂರ್ಣವಲ್ಲದ /ತುಂಬಿಲ್ಲದ<br><b>प्रयोगाः - </b>"अपूर्ण एव पञ्चरात्रे दोहदस्य"<br><b>उल्लेखाः - </b>माल० ३<br><br>

अपूर्णकाल
अपूर्णकाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೂರ್ತಿಯಾಗದ ಕಾಲ /ಸಾಕಾಗದಷ್ಟು ಕಾಲ<br><br>अपूर्णकाल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಕಾಲದ /ಅನಿಯತ ಕಾಲದ<br><br>

अपूर्व
अपूर्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜನ್ಮಾಂತರದಲ್ಲಿ ಅನುಭವಿಸಲ್ಪಡುವ ಸುಖ ದುಃಖಾದಿಗಳಿಗೆ ಕಾರಣವಾದ ಪುಣ್ಯಪಾಪಗಳು<br><br>अपूर्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಸದಾದ /ಹಿಂದಿನದಲ್ಲದ<br><b>प्रयोगाः - </b>"अपूर्वयेव तत्कालसमागमसकामया"<br><b>उल्लेखाः - </b>माघ० १९-८५<br><br>अपूर्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ಚರ್ಯಕರವಾದ<br><b>प्रयोगाः - </b>"अपूर्वेयं हरेर्माया त्रिगुणा रज्जुरूपिणी । यया मुक्तो न चलति बद्धो धावति धावति ॥"<br><b>उल्लेखाः - </b>उद्भ०<br><br>अपूर्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊದಲನೆಯದಲ್ಲದ<br><br>अपूर्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಪಡದ<br><b>प्रयोगाः - </b>"विदितेऽप्यपूर्व इव तत्र हरिः"<br><b>उल्लेखाः - </b>किरा० ६-३९<br><br>अपूर्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅ ವರ್ಣವೇ ಪೂರ್ವವಾಗಿರುವ<br><br>अपूर्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂರ್ವದಿಕ್ಕು ದೇಶ ಕಾಲಗಳಿಗಿಂತಲೂ ಭಿನ್ನವಾದ<br><br>

अपूर्वपति
अपूर्वपति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊದಲು ಗಂಡನಿಲ್ಲದವಳು /ಹಿಂದೆ ಮದುವೆಯಾಗದವಳು<br><b>व्युत्पत्तिः - </b>न पूर्वः पतिर्यस्याः<br><br>

अपूर्वविधि
अपूर्वविधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಸ ಕಟ್ಟಳೆ /ಹೊಸ ಆಜ್ಞೆ /ಬೇರೆ ಪ್ರಮಾಣದಿಂದ ಹೇಳಲ್ಪಡದ ವಿಧಿ<br><br>

अपृक्त
अपृक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರೆ ಅಕ್ಷರದಿಂದ ಕೂಡದೇ ಇರುವ ಒಂದೇ ವರ್ಣದ ಪ್ರತ್ಯಯ<br><b>प्रयोगाः - </b>"अपृक्त एकाल् प्रत्ययः"<br><b>उल्लेखाः - </b>पा० सू०<br><br>अपृक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೂಡಿಕೊಂಡಿರದ /ಮತ್ತೊಂದರೊಡನೆ ಸೇರಿಕೊಂಡಿರದ<br><b>निष्पत्तिः - </b>पृची (सम्पर्के) - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>पृक्तः । न पृक्तः ।<br><br>

अपेक्षणीय
अपेक्षणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಡುವ /ಇಚ್ಛಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अप + ईक्ष (दर्शने) - "अनीयर्" (३-१-९६)<br><br>अपेक्षणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರೀಕ್ಷಿಸಲ್ಪಡುವ /ನಿರೀಕ್ಷಿಸಲ್ಪಡಬೇಕಾದ<br><br>

अपेक्षमाण
अपेक्षमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸುವ /ಇಚ್ಛಿಸುವ<br><b>निष्पत्तिः - </b>अप + ईक्ष (दर्शने) - "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"भवत्कृतां भूतिमपेक्षमाणः"<br><b>उल्लेखाः - </b>किरा० ३-४९<br><br>

अपेक्षा
अपेक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಚ್ಛೆ /ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>अप + ईक्ष (दर्शने) - "अः" (३-३-१०३)<br><b>प्रयोगाः - </b>"अध्यात्मरतिरासीनो निरपेक्षो निरामिषः"<br><b>उल्लेखाः - </b>मनु० ६-४९<br><br>अपेक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆವಶ್ಯಕತೆ /ಅವಶ್ಯವಾಗಿ ಬೇಕಾಗಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"स्फुलिङ्गावस्थया वह्निरेधापेक्ष इव स्थितः" । "सोऽहमवसितप्रतिज्ञाभरोऽपि वृषलापेक्षया शास्त्रं धारयामि" ।<br><b>उल्लेखाः - </b>शाकु० ७-१५, मुद्रा० १<br><br>अपेक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ವಯ /ತಮ್ಮ ತಮ್ಮ ಅರ್ಥಗಳನ್ನು ಕೊಡತಕ್ಕ ಪದಗಳಿಗೆ ಇರುವ ಪರಸ್ಪರ ಸಂಬಂಧ<br><br>अपेक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಮನ /ಲಕ್ಷ್ಯ /ಎಚ್ಚರಿಕೆ<br><b>प्रयोगाः - </b>"देशापेक्षास्तथा यूयं याताऽदायाऽङ्गुलीयकम्"<br><b>उल्लेखाः - </b>भट्टि० ७-४९<br><br>अपेक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿರೀಕ್ಷಣೆ /ಕಾಯುವಿಕೆ<br><br>अपेक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಲಂಬನ /ಆಶ್ರಯ<br><br>

अपेक्षण
अपेक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>अपेक्षा ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

अपेक्षित
अपेक्षित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಚ್ಛೆ /ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>अप + ईक्ष (दर्शने) - भावे "क्तः" (३-३-११४)<br><br>अपेक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಟ್ಟ /ಇಚ್ಛಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अप + ईक्ष (दर्शने) - "क्तः" (३-२-१०२)<br><br>अपेक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರೀಕ್ಷಿಸಲ್ಪಟ್ಟ /ಎದುರು ನೋಡಲ್ಪಟ್ಟ<br><br>अपेक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಮನಿಸಲ್ಪಟ್ಟ /ಎಚ್ಚರಿಕೆಯಿಂದ ನೋಡಲ್ಪಟ್ಟ<br><br>

अपेक्षिन्
अपेक्षिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಸೆಯುಳ್ಳ /ಆಸೆ ಪಡುವ<br><b>निष्पत्तिः - </b>अप + ईक्ष (दर्शने) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अपेक्षते<br><b>प्रयोगाः - </b>"प्रयोजनापेक्षितया प्रभूणां प्रायश्चलं गौरवमाश्रितेषु"<br><b>उल्लेखाः - </b>कुमा० ३-१<br><br>

अपेक्ष्य
अपेक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಡುವ /ಇಚಛಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अप + ईक्ष (दर्शने) - "ण्यत्" (३-१-१२४)<br><br>अपेक्ष्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಿ /ಆಸೆ ಪಟ್ಟು<br><b>निष्पत्तिः - </b>अप + ईक्ष (दर्शने) - "ल्यप्" (७-१-३७)<br><b>प्रयोगाः - </b>"किमपेक्ष्य फलं पयोधरान् ध्वनतः प्रार्थयते मृगाधिपः"<br><b>उल्लेखाः - </b>किरा० २-२१<br><br>

अपेत
अपेत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಓಡಿ ಹೋದ /ಹೊರಟು ಹೋದ<br><b>निष्पत्तिः - </b>अप + इण् (गतौ) - "क्तः" (३-४-७२)<br><br>अपेत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಗಲಾಡಿಸಲ್ಪಟ್ಟ /ನಿವಾರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अप + इण् (गतौ) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अपेतयुद्धाभिनिवेशसौम्यौ हरिर्हरिप्रस्थमथ प्रतस्थे"<br><b>उल्लेखाः - </b>माघ० ३-१<br><br>

अपेय
अपेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾನಕ್ಕೆ ಅರ್ಹವಲ್ಲದ ಮದ್ಯ<br><b>निष्पत्तिः - </b>पा (पाने) - "यत्" (३-१-९७)<br><b>व्युत्पत्तिः - </b>न पातुं योग्यम्<br><br>

अपोगण्ड
अपोगण्ड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗಹೀನ<br><b>व्युत्पत्तिः - </b>अपसि कर्मणि गण्डः त्याज्यः<br><b>विस्तारः - </b>"विकलाङ्गस्त्वपोगण्डः" - अम० ।<br><br>अपोगण्ड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಜುಬುರುಕ /ಹೇಡಿ<br><br>अपोगण्ड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಶು /ಮಗು<br><b>विस्तारः - </b>"अपोगण्डोऽतिभीरौ स्याच्छिशुके विकलाङ्गके" - हेम० ।<br><br>अपोगण्ड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತ್ರಿವಳಿಗಳಿಂದ ಕೂಡಿದ<br><b>विस्तारः - </b>"अपोगण्डस्तु वलिभे विकलाङ्गे शिशावपि" - मेदि० ।<br><br>अपोगण्ड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹದಿನಾರು ವರ್ಷ ವಯಸ್ಸು ಕಳೆದವನು<br><b>व्युत्पत्तिः - </b>"बाल आषोडशाद्वर्षात्पोगण्ड इति कथ्यते" - नारदः । तद्भिन्नोऽपोगण्डः ।<br><br>

अपोढ
अपोढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತ್ಯಜಿಸಲ್ಪಟ್ಟ /ಬಿಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अप + वह (प्रापणे) - "क्तः" (३-२-१०२)<br><br>

अपोह
अपोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಿತ್ಯಾಗ /ವರ್ಜಿಸುವುದು<br><br>अपोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಶಯ ಪರಿಚ್ಛೇದ /ಸಂದೇಹವನ್ನು ಪರಿಹರಿಸುವುದು<br><br>

अपोहनीय
अपोहनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಶಯವನ್ನು ತಕ್ಕ ಕಾರಣಗಳಿಂದ ಪರಿಹರಿಸಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>अप + ऊह (वितर्के) - "अनीयर्" (३-१-९६)<br><br>

अपोह्य
अपोह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವರ್ಜಿಸಲ್ಪಡುವ /ತ್ಯಜಿಸಲ್ಪಡುವ<br><br>अपोह्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿವಾರಿಸಿ /ಹೋಗಲಾಡಿಸಿ<br><br>

अपौरुष
अपौरुष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಾಕ್ರಮವಿಲ್ಲದಿರುವಿಕೆ /ಹೇಡಿತನ<br><br>अपौरुष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಾಕ್ರಮವಿಲ್ಲದ /ಹೇಡಿ /ಅಧೀರ<br><b>व्युत्पत्तिः - </b>नास्ति पौरुषमस्य<br><br>

अपुरुषेय
अपुरुषेय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಿವ್ಯಶಕ್ತಿ /ಅಮಾನುಷ ಸಾಮಾರ್ಥ್ಯ<br><br>अपुरुषेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಮಾನುಷವಾದ /ಮನುಷ್ಯಕಲ್ಪಿತವಲ್ಲದ<br><b>निष्पत्तिः - </b>"ढञ्" (वा० ५-१-१०) । न० त० ।<br><b>व्युत्पत्तिः - </b>पुरुषेण कृतं पौरुषेयम् । न पौरुषेयम् ।<br><br>

अप्चर
अप्चर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಲಚರ ಪ್ರಾಣಿ<br><b>निष्पत्तिः - </b>चर (गतौ) - "टः" (३-२-१६)<br><b>व्युत्पत्तिः - </b>अप्सु चरति<br><br>

अप्चरी
अप्चरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲಚರ ಪ್ರಾಣಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

अप्पति
अप्पति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರುಣ<br><br>अप्पति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ<br><b>व्युत्पत्तिः - </b>अपां पतिः<br><br>

अप्पित्त
अप्पित्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>व्युत्पत्तिः - </b>अपां पित्तमिव<br><br>अप्पित्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರಮೂಲದ ಗಿಡ<br><br>

अप्रकम्प
अप्रकम्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಲನೆಯಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न प्रकम्पः<br><br>अप्रकम्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಲನೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न प्रकम्पो यस्य<br><br>

अप्रकर्ष
अप्रकर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೀನವಾಗಿರುವುದು<br><br>अप्रकर्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೀನವಾದ /ಕಡಮೆಯಾದ<br><br>

अप्रकाण्ड
अप्रकाण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಂಟಿಲ್ಲದ ಗಿಡ<br><b>व्युत्पत्तिः - </b>न प्रकाण्डोऽस्य<br><br>

अप्रकाश
अप्रकाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಹಸ್ಯ /ಗುಟ್ಟು<br><br>अप्रकाश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶವಲ್ಲದ<br><b>प्रयोगाः - </b>"प्रकाशश्चाप्रकाशश्च लोकालोक इवाचलः"<br><b>उल्लेखाः - </b>रघु० १-६८<br><br>अप्रकाश<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ರಹಸ್ಯವಾಗಿ /ಗುಟ್ಟಾಗಿ<br><br>

अप्रकाश्य
अप्रकाश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸಲು ಅರ್ಹವಲ್ಲದ<br><b>प्रयोगाः - </b>"जन्मर्क्षं मैथुनं मन्त्रो गृहच्छिद्रं च वञ्चनम् । आयुर्धनापमानं स्त्री न प्रकाश्यानि सर्वथा ॥"<br><br>

अप्रकृत
अप्रकृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಮಾನ<br><br>अप्रकृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಖ್ಯವಲ್ಲದ /ಅಪ್ರಧಾನವಾದ<br><br>अप्रकृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಯಕ್ಕೆ ಸಂಬಂಧಿಸದ /ಅಸಮಂಜಸವಾದ<br><br>

अप्रकृति
अप्रकृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಂಖ್ಯಮತಸಿದ್ಧವಾದ ಪ್ರಕೃತಿಭಿನ್ನ ಪುರುಷ<br><br>अप्रकृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಕೃತಿ /ಪ್ರಕೃತಿಯ ಕಾರ್ಯ<br><br>अप्रकृति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಭಾವಶೂನ್ಯ /ನಿಸರ್ಗವಲ್ಲದ<br><br>

अप्रकृष्ट
अप्रकृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಶಸ್ತವಲ್ಲದ /ನೀಚವಾದ<br><br>

अप्रगल्भ
अप्रगल्भ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧೀರ /ಸಂಕೋಚದ ಸ್ವಭಾವದವನು<br><b>प्रयोगाः - </b>"धृष्टं पार्श्वे वसति नियतं दूरतश्चाप्रगल्भः"<br><b>उल्लेखाः - </b>हितो०<br><br>

अप्रगुण
अप्रगुण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆದರಿದ /ಬೇರೆ ಬೇರೆಯಾದ<br><br>अप्रगुण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಶಸ್ತಗುಣವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न विद्यते प्रकृष्टो गुणो यस्य<br><br>

अप्रज
अप्रज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಜೆಯಿಲ್ಲದವನು /ಸಂತಾನವಿಲ್ಲದವನು<br><br>

अप्रजा
अप्रजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಕ್ಕಳಿಲ್ಲದವಳು /ಬಂಜೆ<br><br>

अप्रजस्
अप्रजस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಜೆಯಿಲ್ಲದ /ಮಕ್ಕಳಿಲ್ಲದ<br><b>निष्पत्तिः - </b>"असिच्" (५-४-१२२)<br><b>व्युत्पत्तिः - </b>न प्रजा सन्ततिर्यस्य<br><b>प्रयोगाः - </b>"अतीतायमप्रजसि बान्धवास्तदवाप्नुयुः"<br><b>उल्लेखाः - </b>याज्ञ० २-१४४<br><br>

अप्रजाता
अप्रजाता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಜೆ /ಮಕ್ಕಳಿಲ್ಲದವಳು<br><b>व्युत्पत्तिः - </b>न प्रजाता<br><br>

अप्रणीत
अप्रणीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪವಿತ್ರಗೊಳಿಸಲ್ಪಡದ /ಶಾಸ್ತ್ರ ವಿಧಾನದಿಂದ ಸಂಸ್ಕಾರ ಹೊಂದದ<br><br>

अप्रतर्क्य
अप्रतर्क्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಹಿಸಲು ಶಕ್ಯವಲ್ಲದ /ಅನುಮಾನದಿಂದ ತಿಳಿಯಲಾಗದ<br><b>प्रयोगाः - </b>"अप्रतर्क्यतरसो गरुत्मतः"<br><b>उल्लेखाः - </b>याद० १७-६१<br><br>

अप्रतिकर
अप्रतिकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಂಬಿಕೆಯವನು /ವಿಶ್ವಾಸಪಾತ್ರ /ಅನುಕೂಲವಾಗಿರುವ<br><br>

अप्रतिकर्मन्
अप्रतिकर्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತೀಕಾರ ಮಾಡಲು ಶಕ್ಯವಲ್ಲದ<br><br>अप्रतिकर्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತೀಕಾರವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति प्रतिकर्म प्रतीकारो यस्य<br><br>अप्रतिकर्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾನವಾದ ಕೆಲಸವಿಲ್ಲದ<br><br>

अप्रतिकर्मा
अप्रतिकर्मा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अप्रतिकर्मन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "डाप्" (४-१-१३)<br><br>

अप्रतिक्रिय
अप्रतिक्रिय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಕ್ರಿಯೆಯಿಲ್ಲದ<br><br>अप्रतिक्रिय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಕ್ರಿಯೆ ಮಾಡಲು ಶಕ್ಯವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति प्रतिक्रिया यस्य<br><br>

अप्रतिक्रिया
अप्रतिक्रिया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತೀಕಾರವಿಲ್ಲದಿರುವಿಕೆ<br><br>

अप्रतिग्राह्य
अप्रतिग्राह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಳ್ಳಲು ಯೋಗ್ಯವಲ್ಲದ /ಸ್ವೀಕರಿಸಲು ಅರ್ಹವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न प्रतिग्रहीतुं योग्यम्<br><br>

अप्रतिगघ
अप्रतिगघ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಯಿಸಲಾಗದ /ಪ್ರತಿಹತಿಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति प्रतिघा यस्य<br><br>

अप्रतिद्वन्द्व
अप्रतिद्वन्द्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಾಳಿಯಿಲ್ಲದ /ಎದುರಿಸುವವನಿಲ್ಲದ<br><br>अप्रतिद्वन्द्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾನವಿಲ್ಲದ /ಈಡಿಲ್ಲದ<br><b>प्रयोगाः - </b>"पौरुषे चाप्रतिद्वन्द्वः शरैनं जहि रावणिम्"<br><b>उल्लेखाः - </b>रामा०<br><br>

अप्रतिपक्ष
अप्रतिपक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿರೋಧಿಯಿಲ್ಲದ /ಶತ್ರುಗಳಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति प्रतिपक्षः शत्रुर्यस्य<br><br>अप्रतिपक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸದೃಶ /ಅಸಮಾನ<br><b>व्युत्पत्तिः - </b>नास्ति प्रतिपक्षः सदृशो यस्य<br><br>

अप्रतिपत्ति
अप्रतिपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಂಗೀಕಾರ /ಅಸಮ್ಮತಿ<br><br>अप्रतिपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಿಶ್ಚಯ /ಏನು ಮಾಡಬೇಕೆಂಬ ನಿರ್ಧಾರವಿಲ್ಲದಿರುವುದು<br><b>प्रयोगाः - </b>"ययुः क्षणादप्रतिपत्तिमूढतां महानुभावः प्रतिहन्ति पौरुषम्"<br><b>उल्लेखाः - </b>किरा० १४-४३<br><br>अप्रतिपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ರತಿಭೆ /ಸ್ಫೂರ್ತಿಯಿಲ್ಲದಿರುವುದು<br><br>अप्रतिपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಾತ್ಸಾರ /ಅನಾದರ<br><br>

अप्रतिपन्न
अप्रतिपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಪಡದ<br><br>अप्रतिपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವೀಕರಿಸಲ್ಪಡದ /ಅಂಗೀಕರಿಸಲ್ಪಡದ<br><br>

अप्रतिबद्ध
अप्रतिबद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಯಲ್ಪಡದ /ಎದುರಿಸಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न प्रतिबद्धः<br><br>

अप्रतिबन्ध
अप्रतिबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಡೆಯಿಲ್ಲದಿರುವಿಕೆ /ವಿರೋಧವಿಲ್ಲದಿರುವಿಕೆ<br><br>अप्रतिबन्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಯಿಲ್ಲದ /ವಿರೋಧವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न प्रतिबन्धो यस्य<br><br>

अप्रतिबल
अप्रतिबल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಪಕ್ಷವಿಲ್ಲದ /ಶತ್ರುಗಳಿಲ್ಲದ<br><br>अप्रतिबल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಬಲನಾದ /ಹೆಚ್ಚು ಬಲಶಾಲಿಯಾದ<br><b>व्युत्पत्तिः - </b>नास्ति प्रतिबलो यस्य यस्माद्वा<br><br>

अप्रतिभ
अप्रतिभ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಭೆಯಿಲ್ಲದವನು<br><br>अप्रतिभ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಕೋಚ ಸ್ವಭಾವದ<br><br>अप्रतिभ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ರಗಲ್ಭ /ಧೈರ್ಯವಿಲ್ಲದ<br><br>

अप्रतिभा
अप्रतिभा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿಯು ಹೊಳೆಯದಿರುವುದು /ಸಮಯದಲ್ಲಿ ಹೊಸ ಹೊಸದಾಗಿ ಉತ್ತರಕೊಡಲು ಸ್ಫೂರ್ತಿಯುಂಟಾಗದಿರುವುದು<br><br>अप्रतिभा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಕೋಚ<br><br>

अप्रतिम
अप्रतिम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾನವಿಲ್ಲದ /ಅಸದೃಶ<br><b>व्युत्पत्तिः - </b>नास्ति प्रतिमा उपमा यस्य<br><b>प्रयोगाः - </b>"त्वामप्रतिमकर्माणमप्रतिद्वन्द्वमाहवे"<br><b>उल्लेखाः - </b>रामा०<br><br>

अप्रतियोगिन्
अप्रतियोगिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾನವಿಲ್ಲದ /ಅಸದೃಶ<br><br>अप्रतियोगिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಾಳಿಯಿಲ್ಲದ /ಎದುರಿಸುವವನಿಲ್ಲದ<br><br>

अप्रतिरथ
अप्रतिरथ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶತ್ರುಗಳಿಲ್ಲದ /ಎದುರಾಳಿಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न विद्यते प्रतिरथो यस्य<br><b>प्रयोगाः - </b>"दौष्यन्तिमप्रतिरथं तनयं निवेश्य"<br><b>उल्लेखाः - </b>शाकु० ४-१९<br><br>अप्रतिरथ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ರತಿಮ /ಸಮಾನವಿಲ್ಲದ<br><br>

अप्रतिरूप
अप्रतिरूप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ರತಿಮ /ಸಮಾನವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति प्रतिरूपः तुल्यरूपो यस्य<br><br>

अप्रतिष्ठ
अप्रतिष्ठ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಸ್ಥಾನದಲ್ಲಿರುವ ಪರಬ್ರಹ್ಮ<br><br>अप्रतिष्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯವಿಲ್ಲದ<br><br>अप्रतिष्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಶಸ್ತವಲ್ಲದ<br><br>अप्रतिष्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯೋಜನವಿಲ್ಲದ<br><b>प्रयोगाः - </b>"सोमविक्रयिणे विष्ठा भिषजे पूयशोणितम् । नष्टं देवलके दत्तमप्रतिष्ठं तु वार्द्धुषौ ॥"<br><b>उल्लेखाः - </b>मनु० ३-१८०<br><br>अप्रतिष्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸ್ಥಿರವಾದ<br><br>अप्रतिष्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರಣವಿಲ್ಲದ<br><br>

अप्रतिष्ठा
अप्रतिष्ठा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸ್ಥಿರತೆ /ಚಾಂಚಲ್ಯ<br><br>

अप्रतिष्ठित
अप्रतिष्ठित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸ್ಥಿರವಾದ /ಚಂಚಲವಾದ<br><br>

अप्रतिश्रुत
अप्रतिश्रुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಪ್ಪಲ್ಪಡದ /ಅಂಗೀಕರಿಸಲ್ಪಡದ<br><br>

अप्रतिहत
अप्रतिहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇತರರಿಂದ ಎದುರಿಸಲ್ಪಡದ<br><br>अप्रतिहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಡಿಸಲ್ಪಡದ /ಭಂಗಪಡಿಸಲ್ಪಡದ<br><br>

अप्रतीक
अप्रतीक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಬ್ರಹ್ಮ ನಿರಾಕಾರ<br><br>अप्रतीक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಯವವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति प्रतीकोऽवयवो यस्य<br><br>

अप्रतीक्ष
अप्रतीक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರೀಕ್ಷಿಸದಿರುವ /ಎದುರು ನೋಡದಿರುವ<br><b>निष्पत्तिः - </b>प्रति + ईक्ष (दर्शने) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>न प्रतीक्षते<br><br>

अप्रतीक्षमाण
अप्रतीक्षमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರೀಕ್ಷಿಸದಿರುವ /ಎದುರು ನೋಡದಿರುವ<br><b>निष्पत्तिः - </b>"शानच्" (३-२-१२४)<br><br>

अप्रतीक्षा
अप्रतीक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿರೀಕ್ಷಣೆಯಿಲ್ಲದಿರುವುದು /ಪ್ರತ್ಯಾಶೆಯಿಂದ ಎದುರುನೋಡದಿರುವುದು<br><b>प्रयोगाः - </b>"अप्रतीतत्वमेकदेशमात्रप्रसिद्धत्वम्"<br><b>उल्लेखाः - </b>सा० द०<br><br>

अप्रतीत
अप्रतीत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಶಬ್ದದೋಷದಿಂದ ಕೂಡಿದ ಪದ<br><br>अप्रतीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಮ್ಮೆಟ್ಟದಿರುವ /ಓಡಿ ಹೋಗದಿರುವ<br><br>अप्रतीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲಾಗದ /ಅರ್ಥವಾಗದ<br><br>अप्रतीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಸಿದ್ಧವಲ್ಲದ<br><br>

अप्रतीतत्व
अप्रतीतत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಸಿದ್ಧವಲ್ಲದಿರುವಿಕೆ<br><br>

अप्रतीति
अप्रतीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ರಸಿದ್ಧಿ<br><br>अप्रतीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ತಿಳಿಯದಿರುವಿಕೆ /ಅಸ್ಪಷ್ಟತ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿರುದ್ಧವಲ್ಲದ /ಅನುಕೂಲವಾದ<br><br>

अप्रत्यक्ष
अप्रत्यक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯಗಳಿಂದ ತಿಳಿಯಲಾಗದ /ಇಂದ್ರಿಯಗಳಿಗೆ ಗೋಚರವಾಗದ<br><br>

अप्रत्यय
अप्रत्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವಿಶ್ವಾಸ /ಅಪನಂಬಿಕೆ<br><br>अप्रत्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಜ್ಞಾನ /ತಿಳುವಳಿಕೆಯಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न प्रत्ययो विश्वासो ज्ञानं वा<br><br>अप्रत्यय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಂಬಿಕೆಯಿಲ್ಲದ /ವಿಶ್ವಾಸವಿಲ್ಲದ<br><b>प्रयोगाः - </b>"बलवदपि शिक्षितानामात्मन्यप्रत्ययं चेतः"<br><b>उल्लेखाः - </b>शाकु० १-२<br><br>अप्रत्यय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳುವಳಿಕೆಯಿಲ್ಲದ<br><br>अप्रत्यय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕೃತಿ /ಸುಬಾದಿಪ್ರತ್ಯಯವಿಲ್ಲದ ಶಬ್ದಸ್ವರೂಪ<br><br>अप्रत्यय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಳಿದಿರುವ ಪ್ರತ್ಯಯಗಳು<br><b>प्रयोगाः - </b>"विश्वग्देवयोश्च टेरद्र्यञ्चतावप्रत्यये"<br><b>उल्लेखाः - </b>पा० सू० ६-३-९२<br><br>

अप्रधान
अप्रधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಧಾನಕರ್ಮದ ಅಂಗ<br><br>अप्रधान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಖ್ಯವಲ್ಲದ /ಗೌಣ<br><br>अप्रधान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಮಟ್ಟದ /ಕೆಳದರ್ಜೆಯ<br><br>

अप्रधृष्य
अप्रधृष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೀರಲು ಶಕ್ಯವಲ್ಲದ<br><br>अप्रधृष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಯಿಸಲಾಗದ /ಪ್ರತಿಹತಿಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न प्रधर्षितुं शक्यः<br><b>प्रयोगाः - </b>"यस्याप्रधृष्यः प्रभवस्त्वमुच्चैः"<br><b>उल्लेखाः - </b>माल० ५-१७<br><br>

अप्रभु
अप्रभु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಮರ್ಥ /ಅಶಕ್ತ /ಯೋಗ್ಯತೆಯಿಲ್ಲದವನು<br><b>निष्पत्तिः - </b>प्र + भू (सत्तायाम्) - "डुः" (३-२-१८०)<br><b>व्युत्पत्तिः - </b>न प्रभवति<br><br>अप्रभु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಾಜನಿಲ್ಲದ ದೇಶ<br><br>

अप्रमत्त
अप्रमत्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>"अपान्निधिरधिष्ठानमप्रमत्तः प्रतिष्ठितः"<br><b>उल्लेखाः - </b>वि० स०<br><br>अप्रमत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಾಗರೂಕ /ಎಚ್ಚರಿಕೆಯುಳ್ಳ<br><br>अप्रमत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮದಿಸಿದವನಲ್ಲದ<br><br>

अप्रमाद
अप्रमाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಚ್ಚರಿಕೆ /ಜಾಗರೂಕತೆ<br><br>अप्रमाद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಚ್ಚರಿಕೆಯುಳ್ಳ /ಜಾಗರೂಕತೆಯುಳ್ಳ<br><br>अप्रमाद<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಎಚ್ಚರಿಕೆಯಿಂದ /ಜಾಗರೂಕತೆಯಿಂದ<br><b>व्युत्पत्तिः - </b>न विद्यते प्रमादः यस्मिन् कर्मणि<br><br>

अप्रमादिन्
अप्रमादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಚ್ಚರಿಕೆಯುಳ್ಳ /ಜಾಗರೂಕತೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>न प्रमादोऽस्यास्ति<br><br>

अप्रमित
अप्रमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಸಿದ್ಧನಲ್ಲದವನು<br><br>अप्रमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾದ /ಅಪರಿಮಿತವಾದ<br><br>अप्रमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಮಾಣಗಳಿಂದ ತಿಳಿಯಲ್ಪಡದ<br><br>

अप्रमृष्ट
अप्रमृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಹಿಸಲ್ಪಡದ<br><b>निष्पत्तिः - </b>न + प्र + मृषु (सहने) - "क्तः" (३-२-१०२)<br><br>अप्रमृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಜ್ಜಲ್ಪಡದ /ಶುದ್ಧಿ ಮಾಡಲ್ಪಡದ<br><b>निष्पत्तिः - </b>मृजू (शुद्धौ) - "क्तः" (३-२-१०२)<br><br>अप्रमृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಳಿಸಲ್ಪಡದ /ತೊಳೆಯಲ್ಪಡದ<br><br>अप्रमृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಪಡದ<br><b>निष्पत्तिः - </b>मृश (आमर्शे) - "क्तः" (३-२-१०२)<br><br>

अप्रमृष्य
अप्रमृष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಂದರೆಪಡಿಸಲಾಗದ /ಬಾಧಿಸಲು ಅಶಕ್ಯವಾದ<br><b>निष्पत्तिः - </b>प्र + मृष - "ण्यत्" (३-१-१२४)<br><br>

अप्रमेय
अप्रमेय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ /ಪರಮಾತ್ಮ<br><br>अप्रमेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಳೆಯಲಾಗದ<br><b>व्युत्पत्तिः - </b>न प्रमातुं योग्यम्<br><br>अप्रमेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲಾಗದ /ತಿಳಿಯಲು ಅಶಕ್ಯವಾದ<br><br>अप्रमेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರ್ಣಯಿಸಲಾಗದ /ಹೀಗೆಂದು ಹೇಳಲಾಗದ<br><br>

अप्रयत्न
अप्रयत्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನವಿಲ್ಲದಿರುವಿಕೆ /ಉದಾಸೀನತೆ<br><br>अप्रयत्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನವಿಲ್ಲದ /ಉದಾಸೀನವಾದ<br><b>प्रयोगाः - </b>"अप्रयत्नः सुखार्थेषु ब्रह्मचारी धराशयः"<br><b>उल्लेखाः - </b>मनु० ६-२६<br><br>

अप्रयुक्त
अप्रयुक्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರಕಾರರಿಂದ ಅಂಗೀಕರಿಸಲ್ಪಟ್ಟಿದ್ದರೂ ಕವಿಗಳಿಂದ ಪ್ರಯೋಗಿಸಲ್ಪಡದ ಪದ<br><br>अप्रयुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಯೋಗಿಸಲ್ಪಡದ<br><br>अप्रयुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಕ್ರಮವಾಗಿ ಉಪಯೋಗಿಸಲ್ಪಟ್ಟ<br><br>

अप्रलम्ब
अप्रलम्ब<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೇಗ /ಶೀಘ್ರತೆ<br><br>अप्रलम्ब<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇಗವಾದ /ಚುರುಕಾದ<br><br>

अप्रवर्तक
अप्रवर्तक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಡ /ಮಂದ<br><br>अप्रवर्तक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯಕ್ಕೆ ಪ್ರೇರಕನಲ್ಲದ /ಕೆಲಸವನ್ನು ಮಾಡಿಸದ<br><br>

अप्रवर्तन
अप्रवर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡದಿರುವಿಕೆ /ಕೆಲಸಕ್ಕೆ ತೊಡಗದಿರುವಿಕೆ<br><br>

अप्रवर्तिन्
अप्रवर्तिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡದಿರುವ /ಕೆಲಸಕ್ಕೆ ತೊಡಗದಿರುವ<br><b>निष्पत्तिः - </b>प्र + वृतु (वर्तने) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>न प्रवर्तते<br><br>

अप्रवृत्ति
अप्रवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಡತೆ /ನಿಶ್ಚಲತೆ<br><br>

अप्रशस्त
अप्रशस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ಲಾಘ್ಯವಲ್ಲದ /ಗುಣಹೀನ /ನಿಷ್ಪಯೋಜಕ<br><br>अप्रशस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿತವಾದ /ತುಚ್ಛವಾದ<br><b>व्युत्पत्तिः - </b>न प्रशस्तः<br><br>

अप्रसक्त
अप्रसक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧಪಡದ /ಅಪ್ರಕೃತವಾದ<br><br>अप्रसक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಗ್ರಹವಲ್ಲದ /ಸೌಮ್ಯವಾದ<br><br>अप्रसक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇರಿಕೊಂಡಿಲ್ಲದ<br><br>अप्रसक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜ್ಞಾನಕ್ಕೆ ವಿಷಯವಾಗದ<br><br>

अप्रसक्ति
अप्रसक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಂದಿಕೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अप्रसक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧವಿಲ್ಲದಿರುವಿಕೆ<br><br>अप्रसक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌಮ್ಯತೆ /ಶಾಂತತೆ<br><br>अप्रसक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನಕ್ಕೆ ವಿಷಯವಾಗದಿರುವಿಕೆ<br><br>

अप्रसङ्ग
अप्रसङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧವಿಲ್ಲದಿರುವಿಕೆ<br><br>अप्रसङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಯಕ್ಕೆ ಹೊಂದಿಕೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अप्रसङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಂಗತವಾದ /ಹೊಂದಿಕೆಯಿಲ್ಲದ<br><br>

अप्रसन्न
अप्रसन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಚ್ಛವಲ್ಲದ /ತಿಳಿಯಲ್ಲದ<br><br>अप्रसन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಂತುಷ್ಟ /ಸಂತೋಷಪಡದ<br><br>अप्रसन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನಃಕಾಲುಷ್ಯವುಳ್ಳ<br><b>प्रयोगाः - </b>"अप्रसन्नमपराद्धरि पत्यौ"<br><b>उल्लेखाः - </b>माघ० १०-१४<br><br>अप्रसन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೃಪ್ತಿಯಿಲ್ಲದ /ಮನಸ್ಸಿಗೆ ಸಮಾಧಾನವಿಲ್ಲದ<br><br>

अप्रसाद
अप्रसाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಮಾಧಾನ<br><br>अप्रसाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अप्रसाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪ<br><br>

अप्रसाद्य
अप्रसाद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾಧಾನಪಡಿಸಲು ಅಶಕ್ಯವಾದ /ಬಹಳ ಕೋಪದಿಂದ ಕೂಡಿದ<br><br>अप्रसाद्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಮಾಧಾನಪಡಿಸದ<br><br>

अप्रसिद्ध
अप्रसिद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಸಿದ್ಧಿಪಡೆಯದ<br><b>व्युत्पत्तिः - </b>न प्रसिद्धः<br><b>प्रयोगाः - </b>"अप्यप्रसिद्धं यशसे हि पुंसामनन्यसाधारणमेव कर्म"<br><b>उल्लेखाः - </b>कुमा० ३-१९<br><br>अप्रसिद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೂಢವಲ್ಲದ /ಬಳಕೆಯಲ್ಲಿಲ್ಲದ ಪದ<br><br>

अप्रास्ताविक
अप्रास्ताविक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಲೃತವಿಷಯಕ್ಕೆ ಸಂಬಂಧಪಡದ /ಅಸಂಗತವದ /ಬೇರೆ ವಿಷಯಕ್ಕೆ ಸಂಬಂಧಿಸಿದ<br><br>

अप्रस्तुत
अप्रस्तुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಲೃತವಿಷಯಕ್ಕೆ ಸಂಬಂಧಪಡದ /ಅಸಂಗತವದ /ಬೇರೆ ವಿಷಯಕ್ಕೆ ಸಂಬಂಧಿಸಿದ<br><br>अप्रस्तुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಬದ್ಧಕಂತೆ /ಅರ್ಥವಿಲ್ಲದ ಮಾತು<br><b>प्रयोगाः - </b>"रे गोरम्भ किमप्रस्तुतं लपसि"<br><b>उल्लेखाः - </b>पञ्चतं०<br><br>

अप्रस्तुतप्रशंसा
अप्रस्तुतप्रशंसा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥಾಲಂಕಾರದ ಒಂದು ಭೇದ<br><br>

अप्रहत
अप्रहत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಲುವೆ ಮಾಡಲ್ಪಡದ ಬಟ್ಟೆ<br><b>प्रयोगाः - </b>"ईषद्धौतं नवं श्वेतं सदशं यन्न धारितम् । निर्णेजकाक्षालितं चाप्रहतं वास उच्यते ॥"<br><br>अप्रहत<br><br><b>पदविभागः - </b>त्रिलिङ्गः<br><b>कन्नडार्थः - </b>ನೇಗಿಲಿನಿಂದ ಉಳಲ್ಪಡದ ಭೂಮಿ /ಬಂಜರು ಭೂಮಿ<br><br>अप्रहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಖಿಲವಾಗದ /ನಾಶವಾಗದ /ಸವೆಯದ<br><br>

अप्रहता
अप्रहता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अप्रहत ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><br>

अप्रहित
अप्रहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಳುಹಿಸಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न प्रहितः<br><br>

अप्राकरणिक
अप्राकरणिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ರಸ್ತುತವಾದ /ಪ್ರಕೃತವಿಷಯಕ್ಕೆ ಸಂಬಂಧಪಡದ<br><br>

अप्राकृत
अप्राकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕೃತಿಗೆ ಸಂಬಂಧಪಡದ /ಪ್ರಕೃತಿಯ ಕಾರ್ಯವಲ್ಲದ<br><br>अप्राकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಾಧಾರಣವಾದ /ಲೋಕೋತ್ತರವಾದ<br><br>अप्राकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಾಭಾವಿಕವಲ್ಲದ /ಅನೈಸರ್ಗಿಕವಾದ<br><br>

अप्राग्र्य
अप्राग्र्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಧಾನವಲ್ಲದ /ಮುಖ್ಯವಲ್ಲದ<br><br>

अप्राण
अप्राण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ /ಪರಮಾತ್ಮ<br><b>प्रयोगाः - </b>"अप्राणोह्यमनाः शुभ्रो ह्यक्षरात्परतः परः"<br><b>उल्लेखाः - </b>श्रुतिः<br><br>अप्राण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾಣವಿಲ್ಲದ<br><br>

अप्राप्त
अप्राप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಡದ /ಪಡೆಯದಿರುವ<br><br>अप्राप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇರದಿರುವ /ತಲುಪದಿರುವ<br><br>अप्राप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಮಾಣಾಂತರಗಳಿಂದ ತಿಳಿಯಲ್ಪಡದ<br><br>अप्राप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿವಾಹಕ್ಕೆ ಯೋಗ್ಯವಾದ ವಯಸ್ಸನ್ನು ಹೊಂದಿರುವ<br><br>

अप्राप्तकाल
अप्राप्तकाल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ರಮವಾದ ವಾದ /ಕ್ರಮತಪ್ಪಿ ಮಾಡುವ ಚರ್ಚೆ<br><br>अप्राप्तकाल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಮಯದ /ಕಾಲೋಚಿತವಲ್ಲದ<br><b>प्रयोगाः - </b>"अप्राप्तकालं वचनं बृहस्पतिरपि ब्रुवन् । लभते बुद्ध्ववज्ञानमपमानं च पुष्कलम् ॥"<br><b>उल्लेखाः - </b>पञ्चतं०<br><br>

अप्राप्ति
अप्राप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಡೆಯದಿರುವಿಕೆ<br><br>अप्राप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇರದಿರುವಿಕೆ /ತಲುಪದಿರುವಿಕೆ<br><br>

अप्रामाणिक
अप्रामाणिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಮಾಣದಿಂದ ಸಿದ್ಧವಲ್ಲದ<br><br>अप्रामाणिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಮಾಣವನ್ನರಿಯದ<br><br>अप्रामाणिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಂಬಿಕೆಯಿಲ್ಲದ /ವಿಶ್ವಾಸವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न प्रामाणिकः<br><br>

अप्रिय
अप्रिय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದುಃಖ<br><b>प्रयोगाः - </b>"न प्रहृष्येत्प्रियं प्राप्य नोद्विजेत्प्राप्य चाप्रियम्"<br><b>उल्लेखाः - </b>गीता० ५-२०<br><br>अप्रिय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟವಲ್ಲದ /ಪ್ರೀತಿಯಿಲ್ಲದ<br><br>

अप्रियंवद
अप्रियंवद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಠಿನವಾಗಿ ಮಾತನಾಡುವ /ಬಿರುಸಾಗಿ ಮಾತನಾಡುವ /ಮನನೋಯಿಸುವಂತೆ ಮಾತನಾಡುವ<br><b>निष्पत्तिः - </b>वद (व्यक्तायां वाचि) - "खच्" (३-२-३८)<br><b>व्युत्पत्तिः - </b>अप्रियं वदति<br><br>

अप्रियवादिन्
अप्रियवादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಠಿನವಾಗಿ ಮಾತನಾಡುವ /ಬಿರುಸಾಗಿ ಮಾತನಾಡುವ /ಮನನೋಯಿಸುವಂತೆ ಮಾತನಾಡುವ<br><b>निष्पत्तिः - </b>वद (व्यक्तायां वाचि) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अप्रियं वदति<br><br>

अप्रीति
अप्रीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಗೆತನ /ದ್ವೇಷ<br><br>अप्रीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಸನ /ದುಃಖ<br><br>

अप्रेमन्
अप्रेमन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ವೇಷ /ಶತ್ರುತ್ವ<br><br>अप्रेमन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿಯಿಲ್ಲದ /ವಿಶ್ವಾಸವಿಲ್ಲದ /ಅನುರಾಗವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न प्रेम यस्य<br><br>

अप्रौढ
अप्रौढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗರ್ವವಿಲ್ಲದ<br><br>अप्रौढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಮ್ರ /ಸಾಧು /ಸೌಮ್ಯ /ವಿನೀತ<br><br>अप्रौढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆಳೆಯದ /ಅಭಿವೃದ್ಧಿ ಹೊಂದದ<br><br>

अप्रौढा
अप्रौढा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮದುವೆಯಾಗದ ಕನ್ಯೆ<br><br>अप्रौढा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸದ್ಯಃ ಮದುವೆಯಾದ ಕನ್ಯೆ /ಸಂಪೂರ್ಣ ತಾರುಣ್ಯ ಹೊಂದದ ಕನ್ಯೆ<br><br>अप्रौढा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಗ್ಧ ನಾಯಿಕೆ /ಹೊಸ ತಾರುಣ್ಯ ಮತ್ತು ಕಾಮವಿಕಾರ ಹೊಂದಿರುವ ನಾಯಿಕೆ<br><br>

अप्सरस्
अप्सरस्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವಲೋಕದ ವೇಶ್ಯೆಯರು<br><b>निष्पत्तिः - </b>सृ (गतौ) - "असुन्" (उ० ४-१३७)<br><b>व्युत्पत्तिः - </b>अद्भ्यः सरन्ति<br><b>प्रयोगाः - </b>"अप्सु निर्मथनादेव रसात्तस्माद्वरस्त्रियः । उत्पेतुर्मनुजश्रेष्ठ तस्मादप्सरसोऽभवन् ॥" "अप्सरस्सु निखिलास्वलक्षितां रूपसम्पदमसौ तवाद्भुताम्"<br><b>उल्लेखाः - </b>याद० १७-२६<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>

अफल
अफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><br>अफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೋತ /ಆಡು<br><br>अफल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೊಡ್ಡು /ಬಂಜೆ /ಫಲಿಸದ<br><br>अफल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಷ್ಫಲವಾದ /ಪ್ರಯೋಜನವಿಲ್ಲದ<br><b>प्रयोगाः - </b>"यथा षण्डोऽफलः स्त्रीषु यथा गौर्गवि चाफला । यथा चाज्ञेऽफलं दानं तथा मर्त्योऽनृचोऽफलः ॥"<br><b>उल्लेखाः - </b>मनु० २-१५८<br><br>

अफला
अफला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿಗಿಡ<br><b>विस्तारः - </b>"केसरबदराऽफला कार्पासी" - वैज० ।<br><br>अफला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲೋಳೆಸರ /ಕತ್ತಾಳೆ ಗಿಡ<br><br>

अबद्ध
अबद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಂಬದ್ಧವಾದ /ಅರ್ಥವಿಲ್ಲದ<br><br>अबद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಟ್ಟಲ್ಪಡದ<br><br>अबद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರ್ಬಂಧವಿಲ್ಲದ<br><br>

अबद्धमुख
अबद्धमुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ರಿಯವನ್ನು ಹೇಳುವವನು /ದುರ್ಮುಖ /ದುರ್ಭಾಷೆಯಾಡುವ<br><b>व्युत्पत्तिः - </b>न बद्धं नियमितं मुखमस्य<br><br>

अबद्धमुखा
अबद्धमुखा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ರಿಯವನ್ನು ಹೇಳುವವಳು /ದುರ್ಮುಖಿ /ದುರ್ಭಾಷೆಯಾಡುವ<br><br>

अबद्धमुखी
अबद्धमुखी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ರಿಯವನ್ನು ಹೇಳುವವಳು /ದುರ್ಮುಖಿ /ದುರ್ಭಾಷೆಯಾಡುವ<br><b>निष्पत्तिः - </b>स्त्रियां वा "ङीष्" (४-१-५४)<br><br>

अबन्धक
अबन्धक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವ ಆಧಾರವೂ ಇಲ್ಲದೆ ತೆಗೆದುಕೊಳ್ಳುವ ಸಾಲ<br><br>अबन्धक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಕೆಯಲ್ಲಿಡದ /ನಿರ್ಬಂಧದಲ್ಲಿಡದ<br><br>

अबन्धन
अबन्धन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಾತಂತ್ರ್ಯ /ನಿರ್ಬಂಧವಿಲ್ಲದಿರುವಿಕೆ<br><br>अबन्धन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಂಧನವಿಲ್ಲದ /ಸಂಕೋಲೆಯಿಲ್ಲದ<br><br>

अबन्धुर
अबन्धुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೀನವಾದ<br><br>अबन्धुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎತ್ತರವಾಗಿಯೂ ಬಗ್ಗಿಯೂ ಇಲ್ಲದ /ಹಳ್ಳತಿಟ್ಟಿಲ್ಲದ<br><br>अबन्धुर<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ದೀನವಾಗಿ /ಕೋಪ ಮತ್ತು ದುಃಖದಿಂದ<br><b>प्रयोगाः - </b>"सनयनाम्बुसखीजनसम्भ्रमाद्विधुरबन्धुरबन्धुरमैक्षत"<br><b>उल्लेखाः - </b>माघ० ६-२९<br><br>

अबल
अबल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಲಸೆ ಗಿಡ<br><br>अबल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೌರ್ಬಲ್ಯ<br><br>अबल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುರ್ಬಲ /ಬಲಹೀನವಾದ<br><b>व्युत्पत्तिः - </b>नास्ति बलं यस्य<br><br>

अबला
अबला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>अल्पार्थे नञ्<br><b>व्युत्पत्तिः - </b>अल्पं बलं यस्याः<br><b>प्रयोगाः - </b>"सकठिनकुचचूचुकप्रणोदं प्रियमबला सविलाससमन्वियाय"<br><b>उल्लेखाः - </b>माघ० ७-१९<br><br>

अबाध
अबाध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಘ್ನವಿಲ್ಲದಿರುವಿಕೆ /ತಡೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अबाध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೊಂದರೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अबाध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಯಿಲ್ಲದ /ಆತಂಕವಿಲ್ಲದ<br><br>अबाध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾಧೆಯಿಲ್ಲದ /ತೊಂದರೆಯಿಲ್ಲದ<br><br>

अबाधक
अबाधक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಘ್ನವನ್ನುಂಟುಮಾಡದ /ಅನುಕೂಲವಾದ<br><br>अबाधक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಂದರೆಯಿಲ್ಲದ /ಪೀಡೆಯಿಲ್ಲದ<br><br>

अबाधित
अबाधित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಂದರೆ ಪಡಿಸಲ್ಪಡದ /ಪೀಡಿಸಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न बाधितः<br><br>

अबालिश
अबालिश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾಲಕನಲ್ಲದ /ಹುಡುಗನಲ್ಲದ<br><b>प्रयोगाः - </b>"अबालिशो बालिशवत्प्रजानाम्"<br><b>उल्लेखाः - </b>याद० ४-७१<br><br>

अबिन्धन
अबिन्धन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಡಬಾಗ್ನಿ<br><b>व्युत्पत्तिः - </b>आपः इन्धनमस्य<br><b>प्रयोगाः - </b>"अबिन्धनं वह्निमसौ बिभर्ति"<br><b>उल्लेखाः - </b>रघु० १३-४<br><br>

अबुद्ध
अबुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಂಕ /ದಡ್ಡ /ಹೆಡ್ಡ<br><br>अबुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂರ್ಖ /ತಿಳಿಗೇಡಿ<br><br>

अबुद्धि
अबुद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಿವೇಕ /ತಿಳಿಗೇಡಿತನ<br><br>अबुद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಡ್ಡತನ /ಮಂಕು<br><br>

अबुध
अबुध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂರ್ಖ /ತಿಳಿಗೇಡಿ<br><b>प्रयोगाः - </b>"धृतोऽन्धमुखदर्पणो यदबुधो जनः सेवितः"<br><b>उल्लेखाः - </b>कुव० पु० ५६<br><br>अबुध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಕ /ದಡ್ಡ /ಹೆಡ್ಡ<br><b>प्रयोगाः - </b>"अबुधैः कृतमानसंविदः"<br><b>उल्लेखाः - </b>माघ० १६-४७<br><br>

अबोध
अबोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಜ್ಞಾನ /ತಿಳುವಳಿಕೆಯಿಲ್ಲದಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"निसर्गदुर्बोधमबोधविक्लवाः क्व भूपतीनां चरितं क्व जन्तवः"<br><b>उल्लेखाः - </b>किरा० १-६<br><br>अबोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೋಚರವಾಗದಿರುವಿಕೆ /ಕಣ್ಣಿಗೆ ಕಾಣಿಸದಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"जलदकालमबोधकृतं दिशाम्"<br><b>उल्लेखाः - </b>माघ० ६-४१<br><br>अबोध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಜ್ಞಾನಿ /ತಿಳುವಳಿಕೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न बोधो यस्य<br><br>

अबोधगम्य
अबोधगम्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿಗೆ ಮೀರಿದ /ಊಹಾತೀತ<br><br>

अब्ज
अब्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><br>अब्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧನ್ವಂತರಿ<br><br>अब्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿಹಲಸಿನ ಗಿಡ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९७)<br><b>व्युत्पत्तिः - </b>अप्सु जायते<br><br>अब्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಬು /ಶಂಖ<br><br>अब्ज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲವಣ /ಉಪ್ಪು<br><br>अब्ज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲ /ತಾವರೆ<br><b>विस्तारः - </b>"लवणाम्बुजयोरब्जं क्लीबे शङ्खे तु पुंसि वा । पुंस्येव निचुले शीतरश्मौ धन्वन्तरावपि ॥" - नानार्थर०<br><br>अब्ज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೂರು ಕೋಟಿ /ಹತ್ತು ಸಾವಿರ ಲಕ್ಷ<br><br>अब्ज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣಗಿಲೆ ಗಿಡ<br><br>अब्ज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರಿನಲ್ಲಿ ಹುಟ್ಟಿದ<br><br>अब्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>अपः ददाति<br><br>अब्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಸ್ತೆ /ಕೊನ್ನಾರಿಗೆಡ್ಡೆ<br><br>अब्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಷ /ಸಂವತ್ಸರ<br><b>निष्पत्तिः - </b>आप्लृ (व्याप्तौ) - "दन्" ह्रस्वश्च निपा० (उ० ४-९८)<br><b>व्युत्पत्तिः - </b>आप्यन्ते ऋतुमासादयो येन<br><br>

अब्जा
अब्जा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಮಿ<br><br>

अब्जज
अब्जज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ /ಚತುರ್ಮುಖ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>अब्जात् विष्णोर्नाभिकमलात् जातः<br><br>

अब्जबन्धु
अब्जबन्धु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>

अब्जबान्धव
अब्जबान्धव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>

अब्जनयन
अब्जनयन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಮಲದಂತೆ ಕಣ್ಣುಗಳುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अब्जे इव नयने यस्य<br><br>

अब्जलोचन
अब्जलोचन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲದಂತೆ ಕಣ್ಣುಗಳುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अब्जे इव लोचने यस्य<br><br>

अब्जभव
अब्जभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ /ಚತುರ್ಮುಖ<br><b>व्युत्पत्तिः - </b>अब्जे भवः<br><br>

अब्जभू
अब्जभू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ /ಚತುರ್ಮುಖ<br><b>निष्पत्तिः - </b>भू (सत्तायाम्) - "क्विप्"<br><b>व्युत्पत्तिः - </b>अब्जात् भवति<br><br>

अब्जभोग
अब्जभोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾವರೆಯ ದಂಟು<br><br>अब्जभोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾವರೆಯ ಬೀಜಕೋಶ<br><br>अब्जभोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕವಡೆ<br><b>व्युत्पत्तिः - </b>अब्जस्य शङ्खस्य भोगः अवयव इव भोगो यस्य<br><br>

अब्जयोनि
अब्जयोनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ /ಚತುರ್ಮುಖ<br><b>व्युत्पत्तिः - </b>अब्जं विष्णुनाभिकमलं योनिरुत्पत्तिस्थानं यस्य<br><br>

अब्जवाहन
अब्जवाहन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರಮೌಳಿ /ಈಶ್ವರ /ವೃಷಭವಾಹನ<br><b>व्युत्पत्तिः - </b>अब्ज इव शङ्ख इव शुभ्रो वृषभो वाहनमस्य<br><b>विस्तारः - </b>"मिहिराणो जगद्योनिष्टङ्कटीकोऽब्जवाहनः" - त्रिकाण्ड० ।<br><br>

अब्जवाहना
अब्जवाहना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಮಿ<br><b>व्युत्पत्तिः - </b>अब्जं कमलं वाहनमिव यस्याः<br><br>

अब्जिनी
अब्जिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲಲತೆ<br><br>अब्जिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲಗಳ ಸಮೂಹ<br><b>निष्पत्तिः - </b>अब्ज - "इनिः" (४-२-५१)<br><br>अब्जिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಷ್ಕರಿಣಿ<br><b>निष्पत्तिः - </b>अब्ज - "इनिः" (५-१-१३१)<br><br>

अब्दप
अब्दप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಷಾಧಿಪತಿ<br><b>निष्पत्तिः - </b>पा (रक्षणे) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>अब्दं पाति<br><br>

अब्दसार
अब्दसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಪೂರ<br><b>व्युत्पत्तिः - </b>अब्दस्य मुस्तायाः सारः<br><br>

अब्दवाहन
अब्दवाहन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><b>व्युत्पत्तिः - </b>अब्दो मेघो वाहनमस्य<br><br>

अब्धि
अब्धि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಗರ /ಸಮುದ್ರ /ಕಡಲು<br><b>निष्पत्तिः - </b>डुधाञ् (धारणे) - "किः" (३-३-९३)<br><b>व्युत्पत्तिः - </b>आपः धीयन्तेऽस्मिन्<br><b>प्रयोगाः - </b>"विधाय तार्क्ष्यं गगनाब्धिपोतं सार्धं मया देवि समाव्रजन्तीम्"<br><b>उल्लेखाः - </b>याद० १८-११६<br><br>अब्धि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರಸ್ಸು /ಕೊಳ<br><br>अब्धि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆರೆ<br><br>अब्धि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಲ್ಕು ಮತ್ತು ಏಳು ಸಂಖ್ಯೆ<br><br>

अब्धिकन्या
अब्धिकन्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಮಿ<br><b>प्रयोगाः - </b>"विशुद्धदेहद्युतिरब्धिकन्या"<br><b>उल्लेखाः - </b>य्आद० ४-५८<br><br>

अब्धितनय
अब्धितनय<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಮಿ<br><br>

अब्धिसुता
अब्धिसुता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಮಿ<br><br>

अब्धिकफ
अब्धिकफ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರದ ನೊರೆ<br><br>

अब्धिज
अब्धिज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><br>अब्धिज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಂಖ<br><br>अब्धिज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಿನೀ ದೇವತೆಗಳು<br><br>अब्धिज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರದಲ್ಲಿ ಹುಟ್ಟಿದ<br><br>

अब्धिजा
अब्धिजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಮಿ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९७)<br><b>व्युत्पत्तिः - </b>अब्धौ जायते<br><br>

अब्धिनगरी
अब्धिनगरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದ್ವಾರಕಾಪಟ್ಟಣ<br><b>व्युत्पत्तिः - </b>अब्धौ तत्तीरे नगरी<br><br>

अब्धिमण्डूकी
अब्धिमण्डूकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುತ್ತಿನ ಚಿಪ್ಪು<br><b>निष्पत्तिः - </b>मडि (भूषायाम्) - "ऊकन्" (उ० ४-४२) । "ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>अब्धि मण्डयति<br><br>

अब्धिशय
अब्धिशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>शीङ् (स्वप्ने) - "अच्" (३-३-५६)<br><b>व्युत्पत्तिः - </b>अब्धौ शेते<br><br>

अब्ध्यग्नि
अब्ध्यग्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಡಬಾಗ್ನಿ<br><br>

अब्भक्ष
अब्भक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ /ಹಾವು<br><br>अब्भक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರು ಕುಡಿದು ಜೀವಿಸುವ<br><b>निष्पत्तिः - </b>भक्ष (अदने) "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>अपो भक्षयति<br><br>

अब्रह्मण्य
अब्रह्मण्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಹಾರ ಮಾಡಕೂಡದೆಂಬ ಮಾತು<br><b>निष्पत्तिः - </b>"यत्"(४-४-९८)<br><b>व्युत्पत्तिः - </b>ब्रह्मणि साधु ब्रह्मण्यं शान्तता । तन्नभवति ।<br><b>विस्तारः - </b>"अब्रह्मण्यमवध्योक्तौ" - अम० ।<br><br>अब्रह्मण्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆಗಾಗಿ ಭಯಂಕರವಾಗಿ ಕೂಗಿಕೊಳ್ಳುವಿಕೆ<br><b>प्रयोगाः - </b>"अब्रह्मण्यमब्रह्मण्यम्"<br><b>उल्लेखाः - </b>शाकु० ६<br><br>अब्रह्मण्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣನು ಮಾಡಬಾರದ ಕಾರ್ಯ /ಹಿಂಸೆ<br><br>अब्रह्मण्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣನಿಗೆ ಹಿತವಾಗಿಲ್ಲದ /ಬ್ರಾಹ್ಮಣನಿಗೆ ಅಪಾಯಕರವಾದ<br><br>

अब्रह्मन्
अब्रह्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣನಿಲ್ಲದ /ಬ್ರಾಹ್ಮಣರಹಿತವಾದ<br><b>व्युत्पत्तिः - </b>न ब्रह्मा ब्राह्मणो यत्र<br><b>प्रयोगाः - </b>"नाब्रह्म क्षत्रमृध्नोति नाक्षत्रम्ब्रह्म वर्धते"<br><b>उल्लेखाः - </b>मनु० ९-३२२<br><br>

अब्राह्मण
अब्राह्मण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀಚ ಬ್ರಾಹ್ಮಣ /ಪತಿತನಾದ ಬ್ರಾಹ್ಮಣ<br><b>निष्पत्तिः - </b>अप्राशस्त्ये न० ब०<br><b>व्युत्पत्तिः - </b>न ब्राह्मणः<br><b>प्रयोगाः - </b>"अब्राह्मणास्तु षट् प्रोक्ता ऋषिणा तत्त्ववादिना । आद्यो राजभृतस्तेषां द्वितीयः क्रयविक्रयी । तृतीयो बहुयाज्यः स्यात् चतुर्थो ग्रामयाजकः । पञ्चमस्तु वृतस्तेषां ग्रामस्य नगरस्य च । अनागतां तु यः पूर्वं सादित्यां चैव पश्चिमाम् । नोपासीत द्विजः सन्ध्यां स षष्ठोऽब्राह्मणः स्मृतः ॥"<br><br>अब्राह्मण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣನಿಲ್ಲದ /ಬ್ರಾಹ್ಮಣರಹಿತವಾದ<br><br>अब्राह्मण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣನಲ್ಲದವನು<br><br>

अब्लिङ्ग
अब्लिङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲವೇ ದೇವತೆಯಾಗುಳ್ಳ ಮಂತ್ರ<br><b>व्युत्पत्तिः - </b>अपां लिङ्गं बोधनसामर्थ्यं यत्र<br><br>

अभक्त
अभक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಕ್ತನಲದ /ಸೇವಕನಲ್ಲದವನು<br><br>अभक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಮಾಡಲ್ಪಡದ /ಪ್ರತ್ಯೇಕಿಸಲ್ಪಡದ<br><br>

अभक्षण
अभक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿನ್ನದಿರುವುದು /ಊಟ ಮಾಡದಿರುವುದು<br><br>

अभक्ष्य
अभक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಷಿದ್ಧವಾದ ಆಹಾರ /ಊಟ ಮಾಡಲು ಯೋಗ್ಯವಲ್ಲದ ಆಹಾರ<br><br>अभक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿನ್ನಲು ಯೋಗ್ಯವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न भक्षयितुं योग्यम्<br><br>अभक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಟಮಾಡಲು ನಿಷಿದ್ಧವಾದ<br><br>

अभङ्ग
अभङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಡೆಯದಿರುವುದು /ಮುರಿಯದಿರುವುದು<br><br>अभङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಂಗ ಶ್ಲೇಷ /ಶಬ್ದಾಲಂಕಾರವಾದ ಶ್ಲೇಷದ ಒಂದು ಬೇಧ<br><b>प्रयोगाः - </b>"पुनस्त्रिधा सभङ्गोऽथाभङ्गस्तदुभयात्मकः"<br><b>उल्लेखाः - </b>सा० द०<br><br>

अभङ्गुर
अभङ्गुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶವಾಗದ /ಸ್ಥಿರವಾದ<br><b>निष्पत्तिः - </b>भञ्जो (आमर्दने) - "घुरच्" (३-२-१६१)<br><b>व्युत्पत्तिः - </b>न भङ्गुरः<br><b>प्रयोगाः - </b>"अभङ्गुरविभूतिर्नस्तरङ्गयतु मङ्गलम्"<br><br>

अभद्र
अभद्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದುಃಖ<br><br>अभद्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮಂಗಳ<br><br>अभद्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಶುಭದ /ಮಂಗಳವಲ್ಲದ<br><br>

अभय
अभय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ /ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>न भयमस्मात्<br><br>अभय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಜ್ಞಾನ<br><br>अभय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಯವೆಂಬ ಪ್ರಯಾಣದ ಒಂದು ಶುಭಯೋಗ<br><b>प्रयोगाः - </b>"यत्रैकादशगश्चन्द्रो भानुर्वा प्रबलः शुभः । अभयो नाम योगोऽयमरिभूतविनाशकृत् ॥"<br><br>अभय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮನಿಷ್ಠ /ತಪಸ್ವಿ<br><br>अभय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಯವನ್ನು ಹೋಗಲಾಡಿಸುವ ಅಭಯಹಸ್ತ /ಅಭಯವಚನ<br><br>अभय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭಯವಿಲ್ಲದಿರುವಿಕೆ /ಧೈರ್ಯ<br><b>प्रयोगाः - </b>"यो दत्वा सर्वभूतेभ्यः प्रव्यजत्यभयं गृहात् । तस्य तेजोमया लोका भवन्ति ब्रह्मवादिनः ॥"<br><b>उल्लेखाः - </b>मनु० ६-३९<br><br>अभय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆ /ಕಾಪಾಡುವಿಕೆ<br><br>अभय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಮಂಚದ ಬೇರು<br><b>विस्तारः - </b>"अभयं नलदं सेव्यममृणालं जलाशयम्" - अम० ।<br><br>अभय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯವಿಲ್ಲದ /ಹೆದರಿಕೆಯಿಲ್ಲದ<br><b>विस्तारः - </b>"अभयं नलदे स्त्री तु पथ्यायां निर्भये त्रिषु" - नानार्थर० ।<br><br>

अभया
अभया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಳಲೆ ಗಿಡ<br><b>विस्तारः - </b>"अभयमुशीराभीत्योरभया तु हरीतकी" - हेम० ।<br><br>

अभयकृत्
अभयकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಿಸುವ /ಕಾಪಾಡುವ<br><b>व्युत्पत्तिः - </b>अभयं त्राणं करोति<br><br>अभयकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯಂಕರವಲ್ಲದ /ಶಾಂತವಾದ /ಸೌಮ್ಯವಾದ<br><br>

अभयङ्कर
अभयङ्कर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯವನ್ನುಂಟುಮಾಡದ /ಶಾಂತವಾದ /ಸೌಮ್ಯವಾದ<br><br>

अभयद
अभयद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಿಸುವವನು /ಧೈರ್ಯವನ್ನುಂಟುಮಾಡುವವನು<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>अभयं ददाति अभयवचनं दत्वा रक्षति<br><br>

अभयदक्षिणा
अभयदक्षिणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಯರೂಪವಾದ ರಕ್ಷಣೆ /ರಕ್ಷಣೆಯ ಭರವಸೆಯ ಮಾತು<br><br>अभयदक्षिणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭಯದಿಂದ ಕಾಪಾಡಿದವನಿಗೆ ಕೊಡುವ ದಕ್ಷಿಣೆ<br><br>

अभयमुद्रा
अभयमुद्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಂತ್ರೋಕ್ತವಾದ ಒಂದು ವಿಧ ಮುದ್ರೆ /ಅಭಯವನ್ನು ಸೂಚಿಸುವ ಮುದ್ರೆ<br><b>व्युत्पत्तिः - </b>अभयार्था मुद्रा<br><br>

अभययाचना
अभययाचना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಯದ ಬೇಡಿಕೆ /ರಕ್ಷಣೆಗಾಗಿ ಪ್ರಾರ್ಥನೆ<br><b>व्युत्पत्तिः - </b>अभयार्थं याचना<br><b>प्रयोगाः - </b>"बध्यतामभययाचनाञ्जलिः"<br><b>उल्लेखाः - </b>रघु० ११-७८<br><br>

अभयवचन
अभयवचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆಯ ಭರವಸೆಯ ಮಾತು /ಕಾಪಾಡುವುದಾಗಿ ನೀಡಿದ ಅಭಯಹಸ್ತ<br><br>

अभव
अभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಟ್ಟದಿರುವಿಕೆ /ಜನ್ಮಪಡೆಯದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न भवः उत्पत्तिः<br><br>अभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಕ್ಷ /ಮುಕ್ತಿ<br><b>व्युत्पत्तिः - </b>न विद्यते भवः उत्पत्तिर्यस्य<br><b>प्रयोगाः - </b>"प्राप्तुमभवमभिवाञ्च्छति वा वयमस्य नो विषहितुं क्षमा रुचः"<br><b>उल्लेखाः - </b>किरा० १२-३०<br><br>अभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿನಾಶ<br><b>प्रयोगाः - </b>"भवाय सर्वभूतानामभवाय च रक्षताम्"<br><b>उल्लेखाः - </b>रामा०<br><br>

अभव्य
अभव्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದುರದೃಷ್ಟ /ಕೆಟ್ಟ ಅದೃಷ್ಟ<br><br>अभव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅದೃಷ್ಟ ಹೀನ /ಭಾಗ್ಯಹೀನ<br><b>प्रयोगाः - </b>"उपनतमवधीरयन्त्यभव्याः"<br><b>उल्लेखाः - </b>किरा० १०-५१<br><br>अभव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಂಗಳವಲ್ಲದ<br><br>

अभाव
अभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಸತ್ತೆ /ಇಲ್ಲದಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"अस्ति पुत्रो वशे यस्य भृत्यो भार्या तथैव च । अभावे सति सन्तोषः स्वर्गस्थोऽसौ महीयते ॥"<br><br>अभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾರ್ಕಿಕಮತದಲ್ಲಿ ದ್ರವ್ಯಾದಿ ಸಪ್ತ ಪದಾರ್ಥಗಳಲ್ಲಿ ಒಂದು<br><b>प्रयोगाः - </b>"द्रव्यगुणकर्मसामान्यविशेषसमवायाभावाः सप्त पदार्थाः"<br><b>उल्लेखाः - </b>त० सं०<br><br>अभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊರತೆ /ಬಡತನ<br><br>अभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶ<br><br>अभाव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಥಾಯಿಭಾವವಿಲ್ಲದ<br><br>अभाव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುರಾಗವಿಲ್ಲದ /ಪ್ರೀತಿಯಿಲ್ಲದ<br><br>

अभावनीय
अभावनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಂತಿಸುವುದಕ್ಕೂ ಶಕ್ಯವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न भावयितुं शक्यम्<br><br>

अभाषण
अभाषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೌನ /ಮಾತನಾಡದಿರುವಿಕೆ<br><br>

अभि
अभि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಣಣ /ಚಿಹ್ನೆ /ಗುರುತು<br><b>प्रयोगाः - </b>"हरिमभि वर्तते"<br><br>अभि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾರಾಂತರವನ್ನು ಹೊಂದುವುದು<br><b>प्रयोगाः - </b>"भक्तो हरिमभि"<br><br>अभि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವೀಪ್ಸೆ /ವ್ಯಾಪ್ತಿ<br><b>प्रयोगाः - </b>"देवदेवमभिसिञ्चति"<br><br>अभि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಭಿಮುಖ್ಯ /ಎದುರು<br><b>प्रयोगाः - </b>अबिचैद्य्ं प्रतिष्ठासुरासीत्कार्यद्वयाकुलः"<br><b>उल्लेखाः - </b>माघ० २-१<br><br>अभि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಇಚ್ಛೆ /ಅಪೇಕ್ಷೆ<br><b>प्रयोगाः - </b>"अभिलाषमुदीरितेन्द्रियः स्वसुतायामकरोत्प्रजापतिः"<br><b>उल्लेखाः - </b>कुमा० ४-४१<br><br>अभि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ<br><b>प्रयोगाः - </b>"अभ्युन्नताङ्गुष्ठनखप्रभाभिः"<br><b>उल्लेखाः - </b>कुमा० १-३३<br><br>अभि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸೌಮ್ಯತೆ /ಶಾಂತತೆ<br><b>प्रयोगाः - </b>"जात्यस्तेनाभिजातेन शूरः शौर्यवता कुशः"<br><b>उल्लेखाः - </b>रघु० १७-४<br><br>अभि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಳಕ್ಕೆ /ಒಳಗಡೆಗೆ<br><b>प्रयोगाः - </b>"भ्रश्यद्भिर्जलमभि भूषणैर्वधूनामङ्गेभ्यो गुरुभिरमज्जि लज्जयेव"<br><b>उल्लेखाः - </b>माघ० ८-६०<br><br>अभि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಶಿಕ್ಷಣ /ಕಲಿಯುವುದು<br><b>प्रयोगाः - </b>"अभ्यस्यन्ति तटाघातं निर्जितैरावता गजाः"<br><b>उल्लेखाः - </b>कुमा० २-५०<br><br>अभि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮುಂಭಾಗ /ಸಮೀಪ<br><b>प्रयोगाः - </b>"प्रियमभि कुसुमोद्यतस्य बाहोः"<br><b>उल्लेखाः - </b>माघ० ७-४०<br><br>अभि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಚನ /ಮಾತು<br><b>प्रयोगाः - </b>"अभिधाय रूक्षमिति मा स्म गम इति पृथासुतेरिताम्"<br><b>उल्लेखाः - </b>माघ० १५-६७<br><br>अभि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಪ್ತಮ್ಯರ್ಥ<br><b>प्रयोगाः - </b>"अभिगौरि रथासक्तम्"<br><b>उल्लेखाः - </b>कुमा० १०-७<br><br>अभि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಭಾಗ /ಪಾಲು<br><b>प्रयोगाः - </b>"यदत्र ममाभिष्यात् तद्दीयताम्"<br><b>उल्लेखाः - </b>सि० कौ०<br><br>अभि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪೂಜೆ<br><b>प्रयोगाः - </b>"अभिवादयते"<br><br>अभि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಊಟ /ಭೋಜನ<br><b>प्रयोगाः - </b>"अभ्यवहरति"<br><b>विस्तारः - </b>"अभीत्थम्भूतकथनेऽप्यभि वीप्साभिमुख्ययोः" - विश्व० । "अभीत्थम्भूतकथने चाभिमुख्याभिलाषयोः" - मेदि० ।<br><br>

अभिक
अभिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮುಕ /ಸ್ತ್ರೀಲೋಲ<br><b>निष्पत्तिः - </b>"कन्" (५-२-७४)<br><b>व्युत्पत्तिः - </b>अभि कामयते<br><b>प्रयोगाः - </b>"सोऽधिकारमभिकः कुलोचितं काश्चन स्वयमवर्तयत्समाः"<br><b>उल्लेखाः - </b>रघु० १९-४<br><br>

अभिकाङ्क्षा
अभिकाङ्क्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಚ್ಛೆ /ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>अभि + काक्षि (काङ्क्षायाम्) - "अः" (३-३-१०३)<br><br>

अभिकाङ्क्षित
अभिकाङ्क्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + काक्षि (काङ्क्षायाम्) - "क्तः" (३-२-१०२)<br><br>

अभिकाङ्क्षिन्
अभिकाङ्क्षिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸುವ<br><b>निष्पत्तिः - </b>अभि + काक्षि (काङ्क्षायाम्) - "णिनिः" (३-२-७८)<br><br>

अभिकाङ्क्षिणी
अभिकाङ्क्षिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अभिकाम
अभिकाम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಲಾಷೆ /ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>अभि + कमु (कान्तौ) - "घञ्" (३-३-१८)<br><br>अभिकाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮಿಸುವ /ಪ್ರೀತಿಸುವ<br><b>निष्पत्तिः - </b>अभि + कमु (कान्तौ) + णिङ् - "अच्" (३-१-१३४)<br><b>प्रयोगाः - </b>"याचे त्वामभिकामाहं तस्मात्कुरु मम प्रियम्"<br><b>उल्लेखाः - </b>भा०<br><br>

अभिक्रम
अभिक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ /ಉಪಕ್ರಮ<br><br>अभिक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧಾಳಿ /ಮೇಲೆ ಬೀಳುವುದು<br><br>अभिक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧೈರ್ಯದಿಂದ ಶತ್ರುಗಳ ಮೇಲೆ ಯುದ್ಧಕ್ಕೆ ಹೊರಡುವುದು<br><br>अभिक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಏರುವುದು /ಹತ್ತುವುದು<br><b>निष्पत्तिः - </b>अभि + क्रमु (पादविक्षेपे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"अभिक्रमो रणे यानमभीतस्य रिपून् प्रति"<br><b>विस्तारः - </b>"आरोहणं त्वभिक्रमः" - अभि० चि०<br><br>अभिक्रम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ<br><b>निष्पत्तिः - </b>अभि + क्रमु (पादविक्षेपे) - अधि० "घञ्" (३-३-१२१)<br><br>अभिक्रम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + क्रमु (पादविक्षेपे) - कर्म० "घञ्" (३-३-१९)<br><b>प्रयोगाः - </b>"नेहाभिक्रमनाशोऽस्ति प्रत्यवायो न विद्यते"<br><b>उल्लेखाः - </b>गीता० २-४<br><br>

अभिक्रमण
अभिक्रमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧಾಳಿ /ಮೇಲೆ ಬೀಳುವುದು<br><b>निष्पत्तिः - </b>अभि + क्रमु (पादविक्षेपे) - "ल्युट्" (३-३-११५)<br><br>अभिक्रमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ /ಉಪಕ್ರಮ<br><br>

अभिक्रान्त
अभिक्रान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + क्रमु (पादविक्षेपे) - "क्तः" (३-२-१०२)<br><br>अभिक्रान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧಾಳಿ ಮಾಡಲ್ಪಟ್ಟ<br><br>

अभिक्रान्ति
अभिक्रान्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ /ಉಪಕ್ರಮ<br><br>अभिक्रान्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಧಾಳಿ /ಮೇಲೆ ಬೀಳುವುದು<br><b>निष्पत्तिः - </b>अभि + क्रमु (पादविक्षेपे) - "क्तिन्" (३-३-९४) । दीर्घः (६-४-१५)<br><br>

अभिक्रन्तिन्
अभिक्रन्तिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭಿಸುವ /ಉಪಕ್ರಮಿಸುವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-८८)<br><b>व्युत्पत्तिः - </b>अभिक्रान्तमनेन<br><br>अभिक्रन्तिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧಾಳಿ ಮಾಡುವ /ಮೇಲೆ ಬೀಳುವ<br><br>

अभिक्रोश
अभिक्रोश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ<br><br>अभिक्रोश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ ಕೂಗಿಕೊಳ್ಳುವುದು /ಕಿರುಚುವುದು<br><b>निष्पत्तिः - </b>अभि + क्रुश (आह्वाने रोदने च) - "घञ्" (३-३-१८)<br><br>

अभिक्रोशक
अभिक्रोशक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿಸುವ /ದೂಷಿಸುವ<br><br>अभिक्रोशक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ ಕೂಗಿಕೊಳ್ಳುವ /ಕಿರುಚುವ<br><b>निष्पत्तिः - </b>अभि + क्रुश (आह्वाने रोदने च) - "ण्वुल्" (३-१-१३३)<br><br>

अभिख्या
अभिख्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂತಿ /ಪ್ರಕಾಶ<br><b>निष्पत्तिः - </b>अभि + ख्या (प्रकथने) - "अङ्" (३-३-१०६)<br><b>प्रयोगाः - </b>"काप्यभिख्या तयोरासीत् व्रजतोः शुद्धवेषयोः"<br><b>उल्लेखाः - </b>रघु० १-४६<br><br>अभिख्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೀರ್ತಿ /ಯಶಸ್ಸು<br><br>अभिख्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಸರು<br><br>अभिख्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಹಾತ್ಮ್ಯ /ಮಹಿಮೆ<br><br>अभिख्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿ<br><b>विस्तारः - </b>"अभिख्या तु शोभायां कीर्तिसञ्ज्ञयोः" - हेम० ।<br><br>

अभिख्यात
अभिख्यात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಸಿದ್ಧನಾದ /ಹೆಸರು ಪಡೆದ /ಕೀರ್ತಿಶಾಲಿಯಾದ<br><br>

अभिख्यान
अभिख्यान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೀರ್ತಿ /ಯಶಸ್ಸು<br><br>

अभिगच्छत्
अभिगच्छत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊರಡುವ /ಎದುರಾಗಿ ಹೋಗುವ<br><b>निष्पत्तिः - </b>अभि + गम्लृ (गतौ) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"अभिगच्छन् यदुपुङ्गवं दिदृक्षुः"<br><b>उल्लेखाः - </b>याद० १५-१<br><br>

अभिगत
अभिगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಹೋದ<br><br>अभिगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕೂಲವಾಗಿ ಒದಗಿದ<br><b>निष्पत्तिः - </b>अभि + गम्लृ (गतौ) - "क्तः" (३-४-७२)<br><br>अभिगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಿಸಲ್ಪಟ್ಟ<br><br>अभिगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೂಡಿರುವ /ಸಹಿತವಾದ<br><b>प्रयोगाः - </b>"अभिगतमुषया तदानिरुद्धम्"<br><b>उल्लेखाः - </b>याद० १८-१३५<br><br>

अभिगन्तव्य
अभिगन्तव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲು ಯೋಗ್ಯನಾದ /ಸಮೀಪಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अभि + गम्लृ (गतौ) - "तव्यः" (३-१-९६)<br><br>

अभिगन्तृ
अभिगन्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಹೋಗುವ<br><br>अभिगन्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕೂಲವಾಗಿ ಹೋಗುವ<br><br>अभिगन्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯುದ್ಧಕಾಗಿ ಎದುರುಗೊಂಡು ಹೋಗುವ<br><b>निष्पत्तिः - </b>अभि + गम्लृ (गतौ) - "तृच्" (३-१-१३३)<br><br>

अभिगम
अभिगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಹೋಗುವುದು /ಆಗಮನ /ಬರುವುದು<br><b>प्रयोगाः - </b>"तवार्हतो नाभिगमेन तृप्तं मनो नियोगक्रिययोत्सुकं मे"<br><b>उल्लेखाः - </b>रघु० ५-११<br><br>अभिगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಕೂಲವಾಗಿ ಹೋಗುವುದು /ಅನುಕೂಲ ಪ್ರವೇಶ /ಅನುಕೂಲ ಸಮಾಗಮ<br><b>निष्पत्तिः - </b>अभि + गम्लृ (गतौ) - "अप्" (३-३-५८)<br><br>

अभिगम्य
अभिगम्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಖವಾಗಿ ಹೊಂದಲು ಶಕ್ಯನಾದ /ಸುಲಭವಾಗಿ ಸಮೀಪಿಸಬಹುದಾದ<br><b>निष्पत्तिः - </b>अभि + गम्लृ (गतौ) - "यत्" (३-१-९८)<br><b>व्युत्पत्तिः - </b>अभिगन्तुं शक्यः<br><b>प्रयोगाः - </b>"अधृष्यश्चाभिगम्यश्च यादोरत्नैरिवार्णवः"<br><b>उल्लेखाः - </b>रघु० १-१६<br><br>अभिगम्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿ /ಎದುರಾಗಿ ಹೋಗಿ<br><b>प्रयोगाः - </b>"मनुमेकाग्रमासीनमभिगम्य महर्षयः"<br><b>उल्लेखाः - </b>मनु० १-१<br><br>

अभिगामिन्
अभिगामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿಮುಖವಾಗಿ ಹೋಗುವ /ಸುಲಭವಾಗಿ ಸಮೀಪಿಸುವ<br><b>निष्पत्तिः - </b>अभि + गम्लृ (गतौ) - "णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"ऋतुकालाभिगामी स्यात् सदारनिरतः सदा"<br><b>उल्लेखाः - </b>मनु० ३-४५<br><br>

अभिगुप्ति
अभिगुप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆ /ಕಾಪಾಡುವುದು<br><b>निष्पत्तिः - </b>अभि + गुपू (रक्षणे) - "क्तिन्" (३-३-९४)<br><br>

अभिगोप्तृ
अभिगोप्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಿಸುವ /ಕಾಪಾಡುವ<br><b>निष्पत्तिः - </b>अभि + गुपू (रक्षणे) - "तृच्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>अभितो गोपयति<br><br>

अभिग्रस्त
अभिग्रस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಿಸಲ್ಪಟ್ಟ /ಹಿಡಿಯಲ್ಪಟ್ಟ<br><br>अभिग्रस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿನ್ನಲ್ಪಟ್ಟ /ನುಂಗಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + ग्रसु (अदने) - "क्तः" (३-२-१०२)<br><br>

अभिग्रह
अभिग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೂಟಿ ಮಾಡುವುದು<br><br>अभिग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧಾಳಿ /ಮೇಲೆ ಬೀಳುವುದು<br><br>अभिग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೌರವ /ಮರ್ಯಾದೆ<br><br>अभिग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ<br><br>अभिग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೂರು /ಫಿರ್ಯಾದು<br><b>निष्पत्तिः - </b>अभि + ग्रह (उपादाने) - "अप्" (३-३-५८)<br><b>विस्तारः - </b>"अभिग्रहस्तु गौरवे । अभियोगे अभिग्रहणे" - हेम० । "अभिहारस्त्वभिग्रहः" - वैज० ।<br><br>

अभिग्रहण
अभिग्रहण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>अभिग्रह ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अभि + ग्रह (उपादाने) - "ल्युट्" (३-३-११५)<br><br>

अभिघर्षण
अभिघर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಸ್ಪರ ಹೊಡೆದಾಟ /ತಿಕ್ಕಾಟ /ದುರಾಗ್ರಹದಿಂದ ಹೋರಾಟ<br><b>निष्पत्तिः - </b>अभि + घृषु (सङ्घर्षे) - "ल्युट्" (३-३-११५)<br><br>

अभिघात
अभिघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣವಾಗಿ ನಿರ್ಮೂಲ ಮಾಡುವುದು /ಬುಡಸಹಿತ ನಾಶಪಡಿಸುವುದು<br><b>निष्पत्तिः - </b>अभि + हन (हिंसागत्योः) - "घञ्" (३-३-१८)<br><br>अभिघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಏಟು /ಹೊಡೆತ /ಪೆಟ್ಟು<br><b>प्रयोगाः - </b>"तटाभिघातादिव लग्नपङ्के"<br><b>उल्लेखाः - </b>कुमा० ७-४९<br><br>अभिघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದವನ್ನುಂಟುಮಾಡುವ ಎರಡು ವಸ್ತುಗಳ ಸಂಯೋಗ<br><br>

अभिघातक
अभिघातक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರು /ಹಗೆ /ವೈರಿ<br><br>अभिघातक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿಘಾತವನ್ನುಂಟುಮಾಡುವ<br><br>अभिघातक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬುಡಸಹಿತ ನಾಶಮಾಡುವ<br><b>निष्पत्तिः - </b>अभि + हन (हिंसागत्योः) - "ण्वुल्" (३-१-१३३)<br><br>

अभिघातिन्
अभिघातिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರು /ಹಗೆ /ವೈರಿ<br><br>अभिघातिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿಘಾತವನ್ನುಂಟುಮಾಡುವ<br><br>अभिघातिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬುಡಸಹಿತ ನಾಶಮಾಡುವ<br><b>निष्पत्तिः - </b>अभि + हन (हिंसागत्योः) - "णिनिः" (३-२-७८)<br><br>

अभिघातिनी
अभिघातिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अभिघातिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अभिघार
अभिघार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಘೃತಸೇಚನೆ /ಹವಿಸೀಗೆ ತುಪ್ಪ ಹಾಕುವುದು<br><br>अभिघार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಘೃತಸೇಚನೆಯಿಂದಾಗುವ ಒಂದು ಸಂಸ್ಕಾರ ಶುದ್ಧಿ<br><b>निष्पत्तिः - </b>अभि + घृ (सेचने) + णिच् - भावे "घञ्" (३-३-१८)<br><br>अभिघार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಘೃತ /ತುಪ್ಪ<br><b>निष्पत्तिः - </b>कर्म० "घञ्" (३-३-१९)<br><br>

अभिचर
अभिचर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೃತ್ಯ /ಸೇವಕ /ಆಳು<br><b>निष्पत्तिः - </b>अभि + चर (गतौ) - "अच्" (३-१-१३४)<br><br>अभिचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ಸಂಚರಿಸುವ<br><br>

अभिचरा
अभिचरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अभिचर ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्" (४-१-४)<br><br>

अभिचरण
अभिचरण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರುಗಳ ನಾಶಕ್ಕಾಗಿ ಮಾಡುವ ಅಭಿಚಾರಕೃತ್ಯ /ಮಾಟ /ಶ್ಯೇನ ಯಾಗ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>अभि + चर (गतौ) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"कौटिल्यः कोपनोऽपि स्वयमभिचरणे ज्ञातदुःखः प्रतिज्ञाम्"<br><b>उल्लेखाः - </b>मुद्रा० ४-१२<br><br>

अभिचरणीय
अभिचरणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಟ ಮೊದಲಾದ ಮಾಂತ್ರಿಕನ ಕಾರ್ಯಕ್ಕೆ ಗುರಿಯಾಗುವ /ಅಭಿಚಾರಕೃತ್ಯಕ್ಕೆ ಯೋಗ್ಯನಾದ ಶತ್ರು<br><b>निष्पत्तिः - </b>अभि + चर (गतौ) - "अनीयर्" (३-१-९६)<br><br>

अभिचार
अभिचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರುಸಂಹಾರಕ್ಕಾಗಿ ಮಾಡುವ ಹೋಮ /ಹಿಂಸೆಯನ್ನುಂಟುಮಾಡುವ ಕಾರ್ಯ /ಮಾಟ<br><b>निष्पत्तिः - </b>अभि + चर (गतौ) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"स्फुटमिदमभिचारमन्त्र एव प्रतियुवतेरभिधानमङ्गनानाम्"<br><b>उल्लेखाः - </b>माघ० ७-५८<br><br>

अभिचारिन्
अभिचारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಟವನ್ನು ಮಾಡುವ /ಶತ್ರುವಿಗೆ ಹಿಂಸೆಯನ್ನುಂಟುಮಾಡುವ ಹೋಮಾದಿಗಳನ್ನು ನಡೆಸುವ<br><b>निष्पत्तिः - </b>अभि + चर (गतौ) - "णिनिः" (३-२-७८)<br><br>

अभिचारिणी
अभिचारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अभिचारिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अभिच्छाय
अभिच्छाय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೆರಳಿಗೆ ಎದುರಾಗಿರುವ<br><br>अभिच्छाय<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನೆರಳಿಗೆ ಎದುರಾಗಿ<br><br>

अभुजन
अभुजन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶ /ಕುಲ<br><b>निष्पत्तिः - </b>अभि + जनी (प्रादुर्भावे) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>अभिजायतेऽस्मिन्<br><b>प्रयोगाः - </b>"पतिं त्यक्त्वा देवं भुवनपतिमुच्चैरभिजनम्"<br><b>उल्लेखाः - </b>मुद्रा० ६-६<br><br>अभुजन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜನ್ಮಭೂಮಿ /ಹುಟ್ಟಿದ ಊರು<br><br>अभुजन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೂರ್ವಿಕರು<br><b>विस्तारः - </b>"यत्र पूर्वैरुषितं सोऽभिजनः" - सि० कौ० ।<br><br>अभुजन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೀರ್ತಿ /ಯಶಸ್ಸು<br><b>निष्पत्तिः - </b>अभि + जनी (प्रादुर्भावे) -कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>अभिजायते सत्पुरुषो भवति येन<br><br>अभुजन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸದ್ವಂಶ /ಒಳ್ಳೆಯ ಕಾಲ<br><b>प्रयोगाः - </b>"स्तुतं तन्माहात्म्यं यदभिजनतो यच्च गुणतः"<br><b>उल्लेखाः - </b>मालती० २-१३<br><br>अभुजन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಲದ ಯಜಮಾನ /ವಂಶದಲ್ಲಿ ಶ್ರೇಷ್ಠನಾದವನು<br><b>विस्तारः - </b>"भवेदभिजनः ख्यातौ जन्मभूम्यां कुलध्वजे । कुलेऽपि च" - मेदि० ।<br><br>

अभिजनन
अभिजनन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಕುಲದಲಿ ಹುಟ್ಟುವಿಕೆ<br><br>

अभिजय
अभिजय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಜಯ /ಜಯಿಸುವುದು<br><b>निष्पत्तिः - </b>अभि + जि (जये) - "अच्" (३-३-५६)<br><br>

अभिजात
अभिजात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸತ್ಕುಲದಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><b>व्युत्पत्तिः - </b>अभिमतं जातं यस्य<br><b>प्रयोगाः - </b>"जात्यस्तेनाभिजातेन शूरः शौर्यवता कुशः"<br><b>उल्लेखाः - </b>रघु० १७-४<br><br>अभिजात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಂಡಿತ /ಜ್ಞಾನಿ<br><b>प्रयोगाः - </b>"सङ्कीर्णं नाभिजातेषु नाप्रबुद्धेषु संस्कृतम्"<br><br>अभिजात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನೋಹರವಾದ /ಮಧುರವಾದ /ಇಂಪಾದ<br><b>प्रयोगाः - </b>"प्रजल्पितायामभिजातवाचि"<br><b>उल्लेखाः - </b>कुमा० १-४५<br><br>

अभिजाति
अभिजाति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ ಜನ್ಮ /ಸತ್ಕುಲದಲ್ಲಿ ಹುಟ್ಟುವುದು<br><br>

अभिजित्
अभिजित्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>अभिजित्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಯಾಗ<br><br>अभिजित्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನಕ್ಷತ್ರ<br><br>अभिजित्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯಾಣಕ್ಕೆ ಪ್ರಶಸ್ತವಾದ ಒಂದು ಲಗ್ನ<br><br>अभिजित्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಜಿನ್ಮುಹೂರ್ತ<br><b>प्रयोगाः - </b>"अपराह्णे तु सम्प्राप्ते अभिजिद्रिहिणोदये । यदत्र दीयते जन्तोः तदक्षयमुदाहृतम् ॥"<br><b>उल्लेखाः - </b>मत्स्यपु०<br><br>अभिजित्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ನಿಂತು ಹೋರಾಡಿ ಶತ್ರುವನ್ನು ಜಯಿಸುವ<br><b>निष्पत्तिः - </b>अभि + जि (जये) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>अभि जयति शत्रून्<br><br>अभिजित्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣವಾಗಿ ಜಯಗಳಿಸುವ<br><b>निष्पत्तिः - </b>कर० "क्विप्"<br><b>व्युत्पत्तिः - </b>अभिजयत्यनेन<br><br>अभिजित्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿಜಿತ್ ನಕ್ಷತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>अणो लुक् (४-३-३८)<br><b>व्युत्पत्तिः - </b>अभिजिति जातः<br><br>

अभिजित
अभिजित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧರಾತ್ರಿಯಲ್ಲಿ ಬರುವ ಅಭಿಜಿತ್ ಎಂಬ ಮುಹೂರ್ತ<br><b>प्रयोगाः - </b>"मुहूर्तेऽभिजिति प्राप्ते सार्धरात्रे विभूषिते । देवक्यजनयद्विष्णुं यशोदा तां तु कन्यकाम्"<br><b>उल्लेखाः - </b>विष्णुपु०<br><br>

अभिज्ञ
अभिज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿದವನು /ಬಲ್ಲವನು<br><b>निष्पत्तिः - </b>अभि + ज्ञा (अवबोधने) - "कः" (३-१-१३६)<br><b>व्युत्पत्तिः - </b>अभिजानाति<br><b>प्रयोगाः - </b>"यद्वा कौशलमिन्द्रसूनुदमने तत्राप्यभिज्ञो जनः"<br><b>उल्लेखाः - </b>उ० रा० ५-३५<br><br>अभिज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಪುಣ /ಜಾಣ /ಚತುರ<br><br>

अभिज्ञा
अभिज्ञा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊದಲು ಉಂಟಾದ ತಿಳುವಳಿಕೆ<br><br>अभिज्ञा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಮರಣೆ /ನೆನಪು<br><b>निष्पत्तिः - </b>अभि + ज्ञा (अवबोधने) - "अङ्" (३-३-१०६)<br><br>

अभिज्ञात
अभिज्ञात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂದಿನ ಗುರುತಿನಿಂದ ತಿಳಿಯಲ್ಪಟ್ಟ<br><br>

अभिज्ञान
अभिज्ञान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷಣ /ಹಿಂದಿನ ನೆನಪನ್ನುಂಟುಮಾಡುವ ಗುರುತು<br><b>निष्पत्तिः - </b>अभि + ज्ञा (अवबोधने) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>अभिज्ञायतेऽनेन<br><b>प्रयोगाः - </b>"उपपन्नैरभिज्ञानैर्दूतं तमवगच्छत"<br><b>उल्लेखाः - </b>रामा०<br><br>अभिज्ञान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಮರಣೆ /ನೆನಪು<br><b>निष्पत्तिः - </b>अभि + ज्ञा (अवबोधने) - भावे "ल्युट्" (३-३-११५)<br><br>अभिज्ञान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೆನಪನ್ನುಂಟುಮಾಡುವ ವಸ್ತು<br><b>प्रयोगाः - </b>"तस्त भर्तुरभिज्ञानमङ्गुलीयं ददौ कपिः"<br><b>उल्लेखाः - </b>रघु० १२-६२<br><br>

अभिज्ञानपत्र
अभिज्ञानपत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಿಚಯ ಪತ್ರ /ಯೋಗ್ಯತೆಯನ್ನು ತಿಳಿಸುವ ಕಾಗದ<br><br>

अभिज्ञानशाकुन्तल
अभिज्ञानशाकुन्तल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಳಿದಾಸನ ಪ್ರಸಿದ್ಧವಾದ ಶಾಕುಂತಲ ನಾಟಕ<br><b>व्युत्पत्तिः - </b>अभिज्ञानेन गृहीता शकुन्तला । तमधिकृत्य कृतं काव्यम् ।<br><br>

अभिज्ञापक
अभिज्ञापक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೆನಪಿಗೆ ತರುವ /ನೆನಪನ್ನುಂಟುಮಾಡುವ<br><br>

अभितप्त
अभितप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಕಾಯಿಸಲ್ಪಟ್ಟ /ಸುತ್ತಲೂ ಬಿಸಿ ಮಾಡಲ್ಪಟ್ಟ<br><br>

अभितस्
अभितस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ /ಹತ್ತಿರದಲ್ಲಿ<br><b>निष्पत्तिः - </b>अभि - "तसिल्" (५-३-९)<br><b>प्रयोगाः - </b>"ततो राजाब्रवीद्वाक्यं सुमन्त्रमभितः स्थितम्"<br><b>उल्लेखाः - </b>रामा०<br><br>अभितस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎದುರಿನಲ್ಲಿ<br><b>प्रयोगाः - </b>"अभितः सदोऽथ हरिपाण्डवौ रथात्"<br><b>उल्लेखाः - </b>माघ० १३-६१<br><br>अभितस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಶೀಘ್ರವಾಗಿ /ಜಾಗ್ರತೆಯಾಗಿ<br><br>अभितस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎರಡು ಕಡೆಗಳಲ್ಲಿಯೂ<br><b>प्रयोगाः - </b>"अभितः क्षुभिताम्बुराशिधीरध्वनिराकृष्टसमूलपादपौघः"<br><b>उल्लेखाः - </b>माघ० २०-५७<br><br>अभितस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ /ಎಲ್ಲಾ ಕಡೆಗಳಲ್ಲಿಯೂ<br><b>प्रयोगाः - </b>"अभितोऽभ्यागतान् योद्धुं वीरान् रणविशारदान्"<br><b>उल्लेखाः - </b>कुमा० १६-२१<br><br>अभितस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣವಾಗಿ /ಸಮಗ್ರವಾಗಿ<br><b>विस्तारः - </b>"अभितः शीघ्रसाकल्यसम्मुखोभयतोऽन्तिके" - विश्व० ।<br><br>

अभिताप
अभिताप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಸೆಕೆ /ಅಧಿಕ ಸಂತಾಪ<br><b>प्रयोगाः - </b>"अभितापसम्पदमथोष्णरुचिर्निजतेजसामसहमान इव"<br><b>उल्लेखाः - </b>माघ० ९-१<br><br>

अभिताम्र
अभिताम्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕೆಂಪಾದ /ಅಚ್ಛಗೆಂಪಾದ<br><b>व्युत्पत्तिः - </b>अभितः ताम्रम्<br><b>प्रयोगाः - </b>"अथ धूमाभिताम्रः वृक्षशाखावलम्बिनम्"<br><b>उल्लेखाः - </b>रघु० १५-४९<br><br>

अभितोमुख
अभितोमुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲಾ ಕಡೆಗೂ ವ್ಯಾಪಿಸುವ<br><br>

अभिदर्शन
अभिदर्शन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರು ನೋಟ<br><br>अभिदर्शन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯಕ್ಷವಾಗಿ ನೋಡುವುದು<br><b>प्रयोगाः - </b>"ग्रामाघाते हिताभङ्गे पथि मेषाभिदर्शने"<br><b>उल्लेखाः - </b>मनु० ९-२७४<br><br>

अभिद्रव
अभिद्रव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇಗವಾಗಿ ಓಡುವುದು<br><b>निष्पत्तिः - </b>अभि + द्रु (गतौ) - "अप्" (३-३-५७)<br><br>

अभिद्रवण
अभिद्रवण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೇಗವಾಗಿ ಓಡುವುದು<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

अभिद्रुह्
अभिद्रुह्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದ್ರೋಹ ಮಾಡುವ /ಅಪಕಾರ ಮಾಡುವ<br><b>निष्पत्तिः - </b>अभि + द्रुह (जिघांसायाम्) "क्विप्" (३-२-६१)<br><br>

अभिद्रोह
अभिद्रोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಕಾರ /ತೊಂದರೆ<br><b>निष्पत्तिः - </b>अभि + द्रुह (जिघांसायाम्)- "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"अभिद्रोहेण भूतानामर्जयन् गत्वरीः श्रियः"<br><b>उल्लेखाः - </b>किरा० ११-२१<br><br>अभिद्रोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೂಷಣೆ /ನಿಂದೆ /ಬೈಗಳು<br><b>प्रयोगाः - </b>"नामजातिग्रहं तेषामभिद्रोहेण कुर्वतः"<br><b>उल्लेखाः - </b>मनु० ८-२७१<br><br>अभिद्रोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಸ<br><br>

अभिधर्षण
अभिधर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸುವುದು<br><br>अभिधर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅದುಮುವುದು /ಅಡಗಿಸುವುದು<br><br>अभिधर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂತದ ಆವೇಶ<br><br>

अभिधा
अभिधा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದದಲ್ಲಿರುವ ಸಂಕೇತ ಅರ್ಥವನ್ನು ಕೊಡುವ ಒಂದು ಶಕ್ತಿ /ಶಬ್ದಕ್ಕಿರುವ ಅರ್ಥವನ್ನು ತಿಳಿಸುವ ಮೂರು ವಿಧ ಶಕ್ತಿಗಳಲ್ಲೊಂದು<br><b>निष्पत्तिः - </b>अभि + डुधाञ् (धारणे) - कर० "अङ्" (३-३-१०६)<br><b>प्रयोगाः - </b>"वाच्योऽर्थोऽभिधया बोध्यो लक्ष्यो लक्षणया मतः । व्यङ्ग्यो व्यञ्जनया ताः स्युः तिस्रः शब्दस्य शक्तयः ॥"<br><b>उल्लेखाः - </b>सा० द०<br><br>अभिधा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪದ /ಅರ್ಥವನ್ನು ಕೊಡುವ ಶಬ್ದ<br><br>अभिधा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಮಧೇಯ /ಹೆಸರು<br><b>प्रयोगाः - </b>"कुसुमवसन्ताद्यभिधः"<br><b>उल्लेखाः - </b>सा० द० ३-४२<br><br>

अभिधान
अभिधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಮಧೇಯ /ಹೆಸರು<br><b>निष्पत्तिः - </b>अभि + डुधाञ् (धारणे) - "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>अभिधीयतेऽनेन<br><b>प्रयोगाः - </b>"तवाभिधानात् व्यथते नताननः सुदुःसहान्मन्त्रपदादिवोरगः"<br><b>उल्लेखाः - </b>किरा० १-२४<br><br>अभिधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಥನ /ಹೇಳುವುದು<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>अभिधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಘಂಟು /ಶಬ್ದಕೋಶ<br><br>

अभिधानी
अभिधानी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಜ್ಜು /ಹಗ್ಗ<br><b>निष्पत्तिः - </b>अभि + डुधाञ् (धारणे) - "ल्युट्" (३-३-११७) । "ङीप्" (४-१-५)<br><b>व्युत्पत्तिः - </b>अभिधीयते आभिमुख्येन धीयन्तेऽनेन बन्धेनाऽनया<br><br>

अभिधामूला
अभिधामूला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಧಾಮೂಲವಾದ ವ್ಯಂಜನಾವೃತ್ತಿ<br><b>प्रयोगाः - </b>"अनेकार्थस्य शब्दस्य संयोगाद्यैर्नियन्त्रिते । एकत्रार्थेऽन्यधीहेतुर्व्यञ्जना साऽभिधाश्रया ॥"<br><b>उल्लेखाः - </b>सा० द० २-१४<br><br>

अभिधायक
अभिधायक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಚಕ ಶಬ್ದ /ಅಭಿಧಾವೃತ್ತಿಯಿಂದ ಅರ್ಥವನ್ನು ಕೊಡುವ ಶಬ್ದ<br><b>निष्पत्तिः - </b>अभि + डुधाञ् (धारणे) - "ण्वुल्" (३-१-१३३)<br><br>

अभिधायिन्
अभिधायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳುವ /ಮಾತನಾಡುವ<br><b>निष्पत्तिः - </b>अभि + डुधाञ् (धारणे) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अभिधत्ते<br><br>अभिधायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಬ್ದವನ್ನು ಪ್ರಯೋಗಿಸುವ<br><br>

अभिधायिनी
अभिधायिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अभिधायिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अभिधावक
अभिधावक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಓಡಿ ಹೋಗುವ<br><b>निष्पत्तिः - </b>अभि + धावु (गतुशुद्ध्योः) - "ण्वुल्" (३-१-१३३)<br><br>

अभिधित्सत्
अभिधित्सत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾತನಾಡಲು ಅಪೇಕ್ಷೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>अभि + डुधाञ् (धारणे) + सन् - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"अभिधित्सतः किमपि राहुवदनविकृतं व्यभाव्यत"<br><b>उल्लेखाः - </b>माघ० १५-५१<br><br>

अभिधित्सा
अभिधित्सा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಳಲು ಅಪೇಕ್ಷೆ /ಮಾತನಾಡಲು ಇಚ್ಛೆ<br><b>निष्पत्तिः - </b>अभि + डुधाञ् (धारणे) + सन् - "अः" (३-३-१०२)<br><br>

अभिधेय
अभिधेय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥ /ಅಭಿಧಾವೃತ್ತಿಯಿಂದ ಹೇಳುವ ಶಬ್ದಾರ್ಥ<br><b>निष्पत्तिः - </b>अभि + डुधाञ् (धारणे) - "यत्" (३-१-९७)<br><b>प्रयोगाः - </b>"अभिधेयाविनाभूतप्रतीतिर्लक्षणोच्यते"<br><b>उल्लेखाः - </b>काव्यप्र०<br><br>अभिधेय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಂಥದಲ್ಲಿ ಪ್ರತಿಪಾದಿಸಲ್ಪಡುವ ವಿಷಯ<br><br>

अभिध्या
अभिध्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಂತನೆ /ಆಲೋಚನೆ<br><b>निष्पत्तिः - </b>अभि + ध्यै (चिन्तायाम्) - "अङ्" (३-३-१०६)<br><br>अभिध्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಳ್ಳುವ ಆಸೆ<br><br>अभिध्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇತರರ ಸತ್ತನ್ನು ಅಪಹರಿಸುವ ಆಸೆ<br><b>विस्तारः - </b>"अभिध्या तु परस्वेहा" - अभि० चि० ।<br><br>

अभिध्यान
अभिध्यान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>अभिध्या ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अभि + ध्यै (चिन्तायाम्) - "ल्युट्" (३-३-११५)<br><br>

अभिनद्ध
अभिनद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ಕಟ್ಟಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + णह (बन्धने) - "क्तः" (३-१-१०२)<br><b>व्युत्पत्तिः - </b>अभितो नद्धः<br><b>प्रयोगाः - </b>"परिरम्भरुचिं ततिर्जलानामभिनद्धा रसमानसारसेन"<br><b>उल्लेखाः - </b>माघ० ६-७५<br><br>

अभिनन्द
अभिनन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನಂದ /ಸಂತೋಷ<br><b>निष्पत्तिः - </b>अभि + टुनदि (समृद्धौ) - "घञ्" (३-३-१८)<br><br>अभिनन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಗಳಿಕೆ /ಪ್ರಶಂಸೆ<br><br>अभिनन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಲ್ಪಸುಖ /ಸುಖಲೇಶ<br><br>अभिनन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೋತ್ಸಾಹ<br><b>व्युत्पत्तिः - </b>अभितो नन्दः सुखं यस्मिन्<br><br>अभिनन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವ್ರರ /ಪರಮಾತ್ಮ<br><br>अभिनन्द<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೋತ್ಸಾಹಕ /ಪ್ರೇರಕ<br><br>अभिनन्द<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷವುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>अभि + नदि + णिच् - "अच्" (३-१-१३४)<br><br>

अभिनन्दन
अभिनन्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಶಂಸೆ /ಹೊಗಳಿಕೆ<br><b>निष्पत्तिः - </b>अभि + टुनदि (समृद्धौ) - भावे "ल्युट्" (३-३-११५)<br><br>अभिनन्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆನಂದ /ಸಂತೋಷ<br><br>अभिनन्दन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷಪಡಿಸುವ /ಆನಂದವುಂಟುಮಾಡುವ<br><br>अभिनन्दन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಶಂಸಿಸುವ /ಹೊಗಳುವ<br><br>अभिनन्दन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೋತ್ಸಾಹಿಸುವ /ಪ್ರೇರಿಸುವ<br><b>निष्पत्तिः - </b>अभि + टुनदि (समृद्धौ) - "ल्युः" (३-१-१३४)<br><br>

अभिनन्दनीय
अभिनन्दनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಗಳಿಕೆಗೆ ಅರ್ಹನಾದ<br><br>अभिनन्दनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಗಳಲ್ಪಡುವ<br><br>अभिनन्दनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೋತ್ಸಾಹಿಸಲ್ಪಡುವ<br><br>अभिनन्दनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೋತ್ಸಾಹಕ್ಕೆ ಅರ್ಹನಾದ<br><b>निष्पत्तिः - </b>अभि + टुनदि (समृद्धौ) - "अनीयर्" (३-१-९६)<br><br>

अभिनन्दित
अभिनन्दित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಗಳಲ್ಪಟ್ಟ<br><br>अभिनन्दित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೋತ್ಸಾಹಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + टुनदि (समृद्धौ) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अभिनन्दितवृत्तिरार्यमिश्रैः"<br><b>उल्लेखाः - </b>याद० १५-९४<br><br>

अभिनन्दिन्
अभिनन्दिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷಪಡುವ<br><b>निष्पत्तिः - </b>अभि + टुनदि (समृद्धौ) - "णिनिः" (३-२-७८)<br><br>अभिनन्दिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಗಳುವ /ಪ್ರಶಂಸಿಸುವ<br><br>अभिनन्दिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೋತ್ಸಾಹಿಸುವ<br><b>निष्पत्तिः - </b>अभि + टुनदि (समृद्धौ) - "णिनिः" (३-१-१३४)<br><br>

अभिनन्दिनी
अभिनन्दिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अभिनन्दिन् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अभिनन्द्य
अभिनन्द्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಗಳಿಕೆಗೆ ಅರ್ಹನಾದ /ಪ್ರಶಂಸೆಗೆ ಯೋಗ್ಯನಾದ<br><b>निष्पत्तिः - </b>अभि + टुनदि (समृद्धौ) - "यत्" (३-१-९७)<br><b>प्रयोगाः - </b>"जनस्य साकेतनिवासिनस्तौ द्वावप्यभूतामभिनन्द्यसत्त्वौ"<br><b>उल्लेखाः - </b>रघु० ५-३१<br><br>अभिनन्द्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೊಗಳಿ /ಪ್ರಶಂಸೆ ಮಾಡಿ<br><b>निष्पत्तिः - </b>अभि + टुनदि (समृद्धौ) - "ल्यप्" (७-१-३७)<br><br>

अभिनभ
अभिनभ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಂತರಿಕ್ಷಕ್ಕೆ ಅಭಿಮುಖವಾಗಿ /ಆಕಾಶಕ್ಕೆ ಎದುರಾಗಿ<br><b>निष्पत्तिः - </b>अव्ययी०<br><b>प्रयोगाः - </b>"गुरुकाव्यानुगां बिभ्रच्छान्द्रीमभिनभः श्रियम्"<br><b>उल्लेखाः - </b>माघ० २-२<br><br>

अभिनम्र
अभिनम्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿರುವ /ಎದುರಾಗಿ ಬಗ್ಗಿದ<br><b>प्रयोगाः - </b>"इमां तटाशोकलतां च तन्वीं स्तनाभिरामस्तबकाभिनम्राम्"<br><b>उल्लेखाः - </b>रघु० १३-३२<br><br>

अभिनय
अभिनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನಸ್ಸಿನ ಅಭಿಪ್ರಾಯವನ್ನು ತಿಳಿಸುವ ಅಂಗಚೇಷ್ಟೆ /ಶರೀರವ್ಯಾಪಾರ<br><b>निष्पत्तिः - </b>अभि + णीञ् (प्रापणे) - "अच्" (३-३-५६)<br><b>व्युत्पत्तिः - </b>अभिनयत्यर्थान्<br><b>प्रयोगाः - </b>"अभिनयान् परिचेतुमबोद्यता मलयमारुतकम्पितपल्लवा"<br><b>उल्लेखाः - </b>रघु० ९-३३<br><br>अभिनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇತರರ ಅವಸ್ಥೆಯನ್ನು ಅನುಕರಿಸುವುದು /ರಂಗಸ್ಥಳದಲ್ಲಿ ತನ್ನ ಶರೀರವ್ಯಾಪಾರ ಭಾಷಣ ಮೊದಲಾದುವುಗಳಿಂದ ಮತ್ತೊಬ್ಬನು ಮಾಡಿದಂತೆ ಮಾಡುವುದು<br><b>प्रयोगाः - </b>"नर्तकीरभिनयातिलङ्गिनीः"<br><b>उल्लेखाः - </b>रघु० १९-१४<br><br>

अभिनव
अभिनव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಖಸ್ತುತಿ /ಎದುರಿಗೆ ಹೊಗಳುವುದು<br><br>अभिनव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಸದಾದ /ನವೀನವಾದ<br><b>निष्पत्तिः - </b>अभि + णु (स्तुतौ) - "अप्" (३-३-५७)<br><b>व्युत्पत्तिः - </b>अभिनूयते<br><b>प्रयोगाः - </b>"विरचिता मधुनोपवनश्रियामभिनवा इव पत्रविशेषकाः"<br><b>उल्लेखाः - </b>रघु० ९-२९<br><br>

अभिनवतामरस
अभिनवतामरस<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಸದಾದ ತಾವರೆ ಹೂವು<br><br>अभिनवतामरस<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹನ್ನೆರಡನೆಯ ಛಂದಸ್ಸಿನ ಒಂದು ವೃತ್ತ<br><b>प्रयोगाः - </b>"अभिनवतामरसं नजजाद्यः"<br><b>उल्लेखाः - </b>वृ० र०<br><br>

अभिनवोद्भिद्
अभिनवोद्भिद्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಕುರ /ಮೊಳಕೆ<br><b>निष्पत्तिः - </b>उद् + भिदिर् (विदारणे) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>उद्भिनत्ति भुवम् । अभिनवश्चासौ उद्भिश्च<br><br>

अभिनहन
अभिनहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ಕಟ್ಟುವುದು<br><br>अभिनहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಯಕ್ಕೆ ಕಟ್ಟುವ ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + णह (बन्धने) - भावे कर० वा "ल्युट्" (३-३-११५,११७)<br><br>

अभिनिधन
अभिनिधन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶೋನ್ಮುಖವಾದ /ಅವಸಾನವನ್ನು ಎದುರು ನೋಡುವ<br><b>व्युत्पत्तिः - </b>अभिगतो निधनम्<br><br>अभिनिधन<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಾಶಕ್ಕೆ ಎದುರಾಗಿ<br><br>

अभिनिधान
अभिनिधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಮುಖವಾಗಿ ಇಡುವುದು<br><b>निष्पत्तिः - </b>अभि + नि + डुधाञ् (धारणे) - "ल्युट्" (३-३-११५)<br><br>

अभिनिर्मुक्त
अभिनिर्मुक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯಾಸ್ತಮಯ ಕಾಲದಲ್ಲಿ ಮಾದಬೇಕಾದ ಸಂಧ್ಯಾವಂದನಾದಿ ಕಾರ್ಯವನ್ನು ಬಿಟ್ಟು ನಿದ್ರಿಸುವವನು<br><b>व्युत्पत्तिः - </b>अभिभूय निर्मुक्तोऽस्तमितोऽर्कोऽस्य, अभि सर्वं सायन्तनं कर्म निह्चयेन मुक्तं येन वा<br><b>विस्तारः - </b>"सुप्ते यस्मिन्नस्तमेति सुप्ते यस्मिन्नुदेति च । अंशुमानभिनिर्मुक्ताभ्युदितौ तौ यथाक्रमम् ॥" - अम० ।<br><br>

अभिनिर्याण
अभिनिर्याण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರುವನ್ನು ಜಯಿಸಲು ಯುದ್ಧಕ್ಕಾಗಿ ಹೊರಡುವುದು<br><b>निष्पत्तिः - </b>अभि + निर् + या (प्रापणे) - "ल्युट्" (३-३-११५)<br><br>

अभिनिर्वृत्त
अभिनिर्वृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಂಟಾದ /ತಯಾರಾದ /ಸಿದ್ಧವಾದ /ಪೂರ್ಣವಾದ<br><br>

अभिनिर्वृत्ति
अभिनिर्वृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಷ್ಪತ್ತಿ /ತಯಾರಿಕೆ<br><b>निष्पत्तिः - </b>अभि + निर् + वृतु (वर्तने) - "क्तिन्" (३-३-९४)<br><br>

अभिनिविष्ट
अभिनिविष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತತ್ಪರನಾದ /ಆಸಕ್ತನಾದ<br><br>अभिनिविष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಂತೆಯಿಂದ ಕೂಡಿದ /ಯೋಚನೆಯಲ್ಲಿ ಮಗ್ನನಾದ<br><br>अभिनिविष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಗ್ರಹದಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>अभि + नि + विश (प्रवेशने) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"अथावाभिनिविष्टबुद्धिषु"<br><b>उल्लेखाः - </b>माघ० १६-४३<br><br>

अभिनिवेश
अभिनिवेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಗ್ರಹ /ಹಠ<br><b>निष्पत्तिः - </b>अभि + नि + विश (प्रवेशने) - "घञ्" (३-३-१२१)<br><b>प्रयोगाः - </b>"अपेतयुद्धाभिनिवेशसौम्यो हरिर्हरिप्रस्थमथ प्रतस्थे"<br><b>उल्लेखाः - </b>माघ० ३-१<br><br>अभिनिवेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತತ್ಪರತೆ /ಆಸಕ್ತಿ /ಉತ್ಸಾಹದಿಂದ ಕೂಡಿದ ಪ್ರಯತ್ನ<br><b>प्रयोगाः - </b>"अहो निरर्थकव्यापारेष्वभिनिवेशः"<br><b>उल्लेखाः - </b>कादं०<br><br>

अभिनिवेशिन्
अभिनिवेशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಗ್ರಹವುಳ್ಳ /ಹಠವುಳ್ಳ<br><br>अभिनिवेशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಸಕ್ತಿಯುಳ್ಳ /ಉತ್ಸಾಹದಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>अभि + नि + विश (प्रवेशने) - "णिनिः" (३-२-७८)<br><br>

अभिनिष्क्रम
अभिनिष्क्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಹೊರಡುವುದು<br><b>निष्पत्तिः - </b>अभि + निस् + क्रमु (पादविक्षेपे) - "घञ्" (३-३-१८)<br><br>

अभिनिष्क्रमण
अभिनिष्क्रमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಹೊರಡುವುದು<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

अभिनिष्क्रान्त
अभिनिष्क्रान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಹೊರಟ<br><b>निष्पत्तिः - </b>अभि + निस् + क्रमु (पादविक्षेपे) - "क्तः" (३-४-७२)<br><br>

अभिनिष्टान
अभिनिष्टान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ಷರ<br><br>अभिनिष्टान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಸರ್ಗ /ವರ್ಣಗಳ ಮುಂದೆ ಬರುವ ಎರಡು ಸೊನ್ನೆ<br><b>निष्पत्तिः - </b>अभि + निस् + स्तुन (देवशब्दे) - "घञ्" (३-३-१२१)<br><b>विस्तारः - </b>"वर्णमात्रे विसर्गे चाभिनिष्टानः" - त्रिकाण्ड० ।<br><br>

अभिनिष्पतन
अभिनिष्पतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಹೊರಡುವುದು<br><b>निष्पत्तिः - </b>अभि + निस् + पद (गतौ) - "क्तिन्" (३-३-९४)<br><br>

अभिनिष्पत्ति
अभिनिष्पत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯಸಿದ್ಧಿ /ನೆರಏರುವಿಕೆ /ಈಡೇರುವಿಕೆ<br><b>निष्पत्तिः - </b>अभि + निस् + पद (गतौ) - "क्तः" (३-४-७२)<br><br>

अभिनिष्पन्न
अभिनिष्पन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಿದ್ಧವಾದ /ನೆರವೇರಿದ<br><b>निष्पत्तिः - </b>अभि + नि + ह्नुङ् (अपनयने) - "अप्" (३-३-५७)<br><br>

अभिनिह्नव
अभिनिह्नव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಷೇಧ /ಸತ್ಯವನ್ನಡಗಿಸುವಿಕೆ /ಮರೆ ಮಾಚುವುದು<br><br>

अभिनीत
अभिनीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯೋಗ್ಯವಾದ /ಯುಕ್ತವಾದ<br><br>अभिनीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪವುಳ್ಳ /ಕುಪಿತನಾದ<br><br>अभिनीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಮಾಡಲ್ಪಟ್ಟ<br><br>अभिनीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಟ್ಟ<br><br>अभिनीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲಂಕರಿಸಲ್ಪಟ್ಟ<br><br>अभिनीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕರಿಸಲ್ಪಟ್ಟ /ಅಭಿನಯಿಸಲ್ಪಟ್ಟ<br><br>अभिनीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ತರಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + णीञ् (प्रापणे) - "क्तः" (३-२-१०२) , (३-४-७२)<br><b>विस्तारः - </b>"अभिनीतस्तु न्याय्येऽमर्षिणि संस्कृते" - हेम० ।<br><br>

अभिनीति
अभिनीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿನಯ /ಇತರರ ಅವಸ್ಥೆಯ ಅನುಕರಣ<br><br>अभिनीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯುಕ್ತಿ<br><b>निष्पत्तिः - </b>अभि + णीञ् (प्रापणे) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"सान्त्वपूर्वमभिनीतिहेतुकम्"<br><b>उल्लेखाः - </b>किरा० १३-३६<br><br>

अभिनेतव्य
अभिनेतव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶರೀರಾದಿ ವ್ಯಾಪಾರಗಳಿಂದ ಅನುಕರಿಸಲ್ಪಡಲು ಯೋಗ್ಯವಾದ<br><br>अभिनेतव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕರಿಸಲ್ಪಡುವ<br><br>अभिनेतव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಕರೆತರಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अभि + णीञ् (प्रापणे) - "तव्यः" (३-१-९६)<br><br>

अभिनेतृ
अभिनेतृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಟ /ಅಭಿನಯ ಮಾಡುವವನು /ಇತರರ ಅವಸ್ಥೆಯನ್ನು ಅನುಕರಿಸುವವನು<br><b>निष्पत्तिः - </b>अभि + णीञ् (प्रापणे) - "तृच्" (३-१-१३३)<br><br>

अभिनेत्री
अभिनेत्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಟಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अभिनेय
अभिनेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶರೀರಾದಿ ವ್ಯಾಪಾರಗಳಿಂದ ಅನುಕರಿಸಲ್ಪಡುವ<br><br>अभिनेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಕರೆತರಲು ಯೋಗ್ಯನಾದ<br><b>निष्पत्तिः - </b>अभि + णीञ् (प्रापणे) - "यत्" (३-१-९७)<br><b>प्रयोगाः - </b>"दृश्यं तत्राभिनेयम्"<br><b>उल्लेखाः - </b>सा० द० ६-१<br><br>

अभिन्न
अभिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಡೆಯಲ್ಪಡದ<br><br>अभिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೀಳಲ್ಪಡದ<br><br>अभिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯತ್ಯಾಸ ಹೊಂದದ /ಏಕರೀತಿಯಾದ<br><b>प्रयोगाः - </b>"अभिन्नवर्णा गृहिणीव भव्या"<br><b>उल्लेखाः - </b>याद० १८-८०<br><br>अभिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಡೆಯದಿರುವ /ಅಖಂಡವಾದ /ಪೂರ್ಣವಾದ<br><b>प्रयोगाः - </b>"अभिन्नमन्योन्यलयादकार्षीत्"<br><b>उल्लेखाः - </b>याद० १८-३५<br><br>

अभिन्नपुट
अभिन्नपुट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಸ ಚಿಗುರು<br><b>व्युत्पत्तिः - </b>अभिन्नं पुटं यस्य<br><b>प्रयोगाः - </b>"दूर्वायवाङ्कुरल्पक्षत्वगभिन्नपुटोत्तरान्"<br><b>उल्लेखाः - </b>रघु० १७-१२<br><br>

अभिपत्ति
अभिपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಿದ್ಧಿ /ನಿಷ್ಪತ್ತಿ<br><b>निष्पत्तिः - </b>अभि + पद (गतौ) - "क्तिन्" (३-३-९४)<br><br>

अभिपन्न
अभिपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಬಂದಿರುವ<br><b>निष्पत्तिः - </b>अभि + पद (गतौ) - "क्तः" (३-४-७२)<br><br>अभिपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆಯನ್ನು ಅಪೇಕ್ಷಿಸಿ ಬಂದಿರುವ /ಮರೆ ಹೊಕ್ಕಿರುವ<br><b>विस्तारः - </b>"अभिपन्नं शरणार्थी" - अभि० चि० ।<br><br>अभिपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಪತ್ತಿಗೆ ಸಿಲುಕಿದ /ತೊಂದರೆಗೆ ಒಳಗಾದ<br><br>अभिपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪರಾಧ ಮಾಡಿದ<br><br>अभिपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಡಿಯಲ್ಪಟ್ಟ /ನುಂಗಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"कालाभिपन्नाः सीदन्ति सिकतासेतवो यथा" ।<br><b>उल्लेखाः - </b>रामा०<br><b>विस्तारः - </b>अभिपन्नोऽपराध्येभिद्रुते ग्रस्ते विपद्गते । - विश्व० ।<br><br>अभिपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿರುವ /ಪಡೆದಿರುವ<br><b>प्रयोगाः - </b>"त्वमन्यमाकारमिवाभिपन्नः"<br><b>उल्लेखाः - </b>किरा० ३-४५<br><br>

अभिप्रणयन
अभिप्रणयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೇದೋಕ್ತರೀತಿಯಲ್ಲಿ ಅಗ್ನಿ ಮೊದಲಾದುವುಗಳ ಸಂಸ್ಕಾರ<br><b>निष्पत्तिः - </b>अभि + प्र + णीञ् (प्रापणे) - "ल्युट्" (३-३-११५)<br><b>व्युत्पत्तिः - </b>अभिप्रणीयतेऽनेन<br><br>

अभिप्रणीत
अभिप्रणीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇದೋಕ್ತರೀತಿಯಲ್ಲಿ ಅಗ್ನಿ ಮೊದಲಾದುವುದು<br><b>व्युत्पत्तिः - </b>अभितः प्रणीतः<br><b>प्रयोगाः - </b>"जज्ज्वाल लोकस्थितये स राजा यथाध्वरे वह्निरिव प्रणीतः"<br><b>उल्लेखाः - </b>भट्टि० १-४<br><br>

अभिप्राय
अभिप्राय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>अभिमुखं प्रलये प्रैति जगदस्मिन्<br><b>प्रयोगाः - </b>"अभिप्रायः प्रियार्होऽर्हः प्रियकृत प्रीतिवर्धनः"<br><b>उल्लेखाः - </b>वि० स०<br><br>अभिप्राय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನೋಭಾವ /ಉದ್ದೇಶ /ಇಂಗಿತ<br><b>निष्पत्तिः - </b>अभि + प्रीञ् (तर्पणे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"तेषां स्वं स्वमभिप्रायमुपलभ्य पृथक् पृथक्"<br><b>उल्लेखाः - </b>मनु० ७-५७<br><br>अभिप्राय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ /ಸಲಹೆ<br><br>अभिप्राय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಬರುವ /ಸಮೀಪಕ್ಕೆ ಬರುವ<br><b>निष्पत्तिः - </b>अभि + प्र + इण् (गतौ) - "अच्" (३-१-१३४)<br><br>

अभिप्रेत
अभिप्रेत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಟ್ಟ<br><br>अभिप्रेत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ದೇಶಿಸಲ್ಪಟ್ಟ<br><br>अभिप्रेत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + प्र + इण् (गतौ) - "क्तः" (३-२-१०२)<br><br>

अभिप्रेप्सु
अभिप्रेप्सु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲು ಅಪೇಕ್ಷಿಸುವ /ಪಡೆಯುವ ಆಸೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>अभि + प्र + आप्लृ (व्याप्तौ) + सन् - "उः" (३-२--१६८)<br><b>प्रयोगाः - </b>"सहासनमभिप्रेप्सुरुत्कृष्टस्यापकृष्टजः"<br><b>उल्लेखाः - </b>मनु० ८-२८१<br><br>

अभिप्रोक्षण
अभिप्रोक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ಮೊದಲಾದುವುಗಳಿಂದ ಪ್ರೋಕ್ಷಿಸುವುದು /ಶಾಸ್ತ್ರೋಕ್ತವಾಗಿ ಮಂತ್ರಿಸಿದ ನೀರನ್ನು ಶುದ್ಧಿಗಾಗಿ ಚಿಮುಕಿಸುವುದು<br><b>निष्पत्तिः - </b>अभि + प्र + उक्ष (सेचने) - "ल्युट्" (३-३-११५)<br><br>

अभिप्लव
अभिप्लव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪದ್ರವ /ತೊಂದರೆ<br><br>अभिप्लव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಲಪ್ರಳಯ /ನೀರಿನಲ್ಲಿ ತೇಲುವುದು<br><b>निष्पत्तिः - </b>अभि + प्लुङ् (गतौ) - "क्तः" (३-२-१०२)<br><br>

अभिप्लुत
अभिप्लुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ನೆನೆಸಲ್ಪಟ್ಟ<br><br>अभिप्लुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲಾ ಕಡೆಯಲ್ಲೂ ವ್ಯಾಪಿಸಿರುವ<br><br>

अभिभव
अभिभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರ<br><br>अभिभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಮಾನ<br><b>निष्पत्तिः - </b>अभि + भू (सत्तायाम्) - "अप्" (३-३-५७)<br><b>प्रयोगाः - </b>"अभिभवोदितमन्युविदीपितः समभिसृत्य भृशं जवमोजसा" । "अलम्यशोकाभिभवेयमाकृतिः" ।<br><b>उल्लेखाः - </b>किरा० १८-७, कुमा० ५-४३<br><br>अभिभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಾಜಯ /ಸೋಲು<br><b>प्रयोगाः - </b>"रघोरभिभवाशङ्कि चुक्षुभे द्विषतां मनः"<br><b>उल्लेखाः - </b>रघु० ४-२१<br><br>अभिभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಗ್ಗುವುದು /ರೋಗಾದಿಗಳಿಂದ ಜ್ಞಾನ ತಪ್ಪುವುದು<br><br>

अभिभवन
अभिभवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>अभिभव ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

अभिभावन
अभिभावन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೋಲಿಸುವಿಕೆ<br><br>अभिभावन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸುವುದು<br><br>अभिभावन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಮಾನಗೊಳಿಸುವುದು<br><b>निष्पत्तिः - </b>अभि + भू (सत्तायाम्) + णिच् - "ल्युट्" (३-३-११५)<br><br>

अभिभावक
अभिभावक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸುವ<br><br>अभिभावक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಮಾನಗೊಳಿಸುವ<br><br>अभिभावक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಯಿಸುವ /ಸೋಲಿಸುವ<br><br>अभिभावक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜ್ಞಾನತಪ್ಪಿಸುವ<br><b>निष्पत्तिः - </b>अभि + भू (सत्तायाम्) - "ण्वुल्" (३-१-१३३)<br><br>

अभिभाविन्
अभिभाविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>अभिभावक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अभि + भू (सत्तायाम्) - "णिनिः" (३-२-७८)<br><b>प्रयोगाः - </b>"सर्वातिरिक्तसारेण सर्वतेजोऽभिभाविना"<br><b>उल्लेखाः - </b>रघु० १-१३<br><br>

अभिभावुक
अभिभावुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>अभिभावक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अभि + भू (सत्तायाम्) - "उकञ्" (३-२-१५४)<br><br>

अभिभाषण
अभिभाषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಭಾಷಣೆ /ಎದುರಿಗೆ ಮಾತನಾಡುವುದು<br><b>व्युत्पत्तिः - </b>आभिमुख्येन भाषणम्<br><br>

अभिभाषिन्
अभिभाषिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಭಾಷಣೆ ಮಾಡುವ<br><b>निष्पत्तिः - </b>अभि + भाष (व्यक्तायां वाचि) - "णिनिः" (३-२-७८)<br><b>प्रयोगाः - </b>"प्रसन्नमुखरागं तं स्मितपूर्वाभिभाषिणम्"<br><b>उल्लेखाः - </b>रघु० १७-३१<br><br>

अभिभू
अभिभू<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>अभिभावक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अभि + भू (सत्तायाम्) - "क्विप्" (३-२-७६)<br><br>

अभिभूत
अभिभूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ<br><br>अभिभूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೋಲಿಸಲ್ಪಟ್ಟ<br><br>अभिभूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಮಾನಗೊಳಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + भू (सत्तायाम्) - "क्तः" (३-२-१०२)<br><br>

अभिभूति
अभिभूति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರ /ಧಿಕ್ಕಾರ<br><br>अभिभूति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಮಾನ /ಪರಾಭವ<br><br>अभिभूति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಾಜಯ /ಸೋಲು<br><b>निष्पत्तिः - </b>अभि + भू (सत्तायाम्) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"अभिभूतिभयादसूनतः सुखमुज्झन्ति न धाम मानिनः"<br><b>उल्लेखाः - </b>किरा० २-२०<br><br>

अभिभूय
अभिभूय<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಿ /ಧಿಕ್ಕರಿಸಿ<br><br>अभिभूय<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸೋಲಿಸಿ<br><br>अभिभूय<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅವಮಾನಗೊಳಿಸಿ<br><br>

अभिमत
अभिमत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಚ್ಛೆ /ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>अभि + मन (ज्ञाने) - भावे "क्तः" (३-३-११४)<br><b>प्रयोगाः - </b>"द्वीपादन्यस्मादपि मध्यादपि जलनिधेर्दिशोऽप्यन्तात् । आनीय झडिति घटयति विधिरभिमतमभिमुखीभूतः ॥"<br><b>उल्लेखाः - </b>रत्ना० १-६<br><br>अभिमत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಮಾನ<br><br>अभिमत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಪ್ರಾಯ /ಆಶಯ<br><br>अभिमत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮ್ಮತವಾದ /ಪ್ರಿಯವಾದ /ಇಷ್ಟವಾದ<br><b>निष्पत्तिः - </b>अभि + मन (ज्ञाने) - कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"स माधवेनाभिमतेन सख्या"<br><b>उल्लेखाः - </b>कुमा० ३-२३<br><br>अभिमत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अभिमतफलशंसी चारु पुस्फोर बाहुः"<br><b>उल्लेखाः - </b>भट्टि० १-१७<br><br>अभिमत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆದರಿಸಲ್ಪಟ್ಟ<br><br>

अभिमति
अभिमति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆದರ /ಪ್ರೀತಿ<br><br>अभिमति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಮಾನ /ಅಹಂಕಾರ<br><br>अभिमति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೌರವ /ಮರ್ಯಾದೆ<br><br>अभिमति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಲಾಷೆ /ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>अभि + मन (ज्ञाने) - "क्तिन्" (३-३-९४)<br><br>

अभिमनस्
अभिमनस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಗ್ರ /ಆಸಕ್ತ /ತತ್ಪರ<br><b>व्युत्पत्तिः - </b>अभिमुखं मनो यस्य<br><b>प्रयोगाः - </b>"भवतोऽभिमनाः समीहिते सरुषः कर्तुमुपेत्य माननाम्"<br><b>उल्लेखाः - </b>माघ० १६-२<br><br>

अभिमन्तव्य
अभिमन्तव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲು ಯೋಗ್ಯವಾದ<br><br>अभिमन्तव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अभि + मन (ज्ञाने) - "तव्यः" (३-१-९६)<br><br>

अभिमन्तृ
अभिमन्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಹಂಕಾರಪಡುವ /ಹೆಮ್ಮೆ ಪಡುವ /ಸ್ವಾಭಿಮಾನದಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>अभि + मन (ज्ञाने) - "तृच्" (३-१-१३३)<br><br>अभिमन्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿಸುವ<br><br>अभिमन्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೌರವಿಸುವ<br><br>

अभिमन्त्रण
अभिमन्त्रण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂತ್ರವನ್ನು ಉಚ್ಚರಿಸಿ ಪವಿತ್ರಗೊಳಿಸುವುದು<br><br>अभिमन्त्रण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂತ್ರಿಸುವುದು /ಮೋಹಗೊಳಿಸುವುದು<br><b>निष्पत्तिः - </b>अभि + मत्रि (गुप्तपरिभाषणे) - भावे "ल्युट्" (३-३-११५)<br><br>

अभिमन्त्र्य
अभिमन्त्र्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮಂತ್ರವನ್ನು ಉಚ್ಚರಿಸಿ ಪವಿತ್ರಗೊಳಿಸುವುದು<br><br>अभिमन्त्र्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಭಿಮಂತ್ರಣ ಮಾಡಿ /ಪವಿತ್ರಗೊಳಿಸಿ<br><b>निष्पत्तिः - </b>अभि + मत्रि (गुप्तपरिभाषणे) - "ल्यप्" (७-१-३७)<br><br>

अभिमन्यु
अभिमन्यु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಜುನನ ಮಗನಾದ ಅಭಿಮನ್ಯು /ಶ್ರೀಕೃಷ್ಣನ ಸಹೋದರಿಯಾದ ಸುಭದ್ರೆಯ ಮಗ<br><br>

अभिमर
अभिमर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ<br><b>निष्पत्तिः - </b>अभि + मृङ् (प्राणत्यागे) - "घः" (३-३-११८)<br><b>व्युत्पत्तिः - </b>अभिम्रियतेऽत्र<br><br>अभिमर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನ ಸೈನ್ಯದಿಂದ ಉಂಟಾಗುವ ಭಯ<br><br>अभिमर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಧೆ /ಕೊಲ್ಲುವುದು<br><b>विस्तारः - </b>"भवेदभिमरो युद्धे वधे स्वबलसाध्वसे" - मेदि० ।<br><br>

अभिमर्द
अभिमर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುಡಿ ಮಾಡುವುದು<br><br>अभिमर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಡೂದು /ಹಿಸುಕುವುದು<br><br>अभिमर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸುವುದು /ಧ್ವಂಸ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>अभि + मृद (क्षोदे) - भावे "घञ्" (३-३-१८)<br><br>अभिमर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ<br><b>निष्पत्तिः - </b>अभि + मृद - अधि० "घञ्" (३-३-१२१)<br><br>अभिमर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ<br><br>अभिमर्द<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುಡಿಮಾಡುವ<br><br>अभिमर्द<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸುವ<br><br>अभिमर्द<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂದುವ /ಹಿಸುಕುವ<br><br>

अभिमर्दन
अभिमर्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>अभिमर्द ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अभि + मृद (क्षोदे) - "ल्युट्" (३-३-११५)<br><br>

अभिमर्श
अभिमर्श<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಪರ್ಶ /ಸಂಪರ್ಕ<br><b>निष्पत्तिः - </b>अभि + मृश (आमर्शने) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"फलद्भिरुष्णांशुकराभिमर्शात्कार्शानवं धाम पतङ्गकान्तैः"<br><b>उल्लेखाः - </b>माघ० ४-१६<br><br>अभिमर्श<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧಾಳಿ ಮಾಡುವುದು /ಮೇಲೆ ಬೀಳುವುದು<br><b>प्रयोगाः - </b>"पराभिमर्शो न तवास्ति कः करं प्रसारयेत्पन्नगरत्नसूचये"<br><b>उल्लेखाः - </b>कुमा० ५-४३<br><br>

अभिमर्शक
अभिमर्शक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಪರ್ಶ ಮಾಡುವ<br><br>अभिमर्शक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧಾಳಿ ಮಾಡುವ<br><b>निष्पत्तिः - </b>अभि + मृश (आमर्शने) - "ण्वुल्" (३-१-१३३)<br><b>प्रयोगाः - </b>"न दुष्टः कश्चिदप्यासीत्परदाराभिमर्शकः"<br><b>उल्लेखाः - </b>रामा०<br><br>

अभिमर्शन
अभिमर्शन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>अभिमर्श ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अभि + मृश (आमर्शने) - "ल्युट्" (३-३-११५)<br><br>

अभिमर्शिन्
अभिमर्शिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>अभिमर्शक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अभि + मृश (आमर्शने) - "णिनिः" (३-२-७८)<br><b>प्रयोगाः - </b>"त्वत्कलत्राभिमर्शी वैरास्पदं धनमित्रः"<br><b>उल्लेखाः - </b>दशकु०<br><br>

अभिमान
अभिमान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ವ /ಅಹಂಕಾರ<br><b>निष्पत्तिः - </b>अभि + मन (ज्ञाने) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"मुनिरस्मि निरागमः कुतो मे भयमित्येष न भूतयेऽभिमानः"<br><b>उल्लेखाः - </b>किरा० १३-७<br><br>अभिमान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದರ್ಪ /ಆತ್ಮಗೌರವ<br><b>प्रयोगाः - </b>"सदाभिमानैकधना हि मानिनः" । "निघ्नम् प्रियं प्राणमिवाभिमानम्" ।<br><b>उल्लेखाः - </b>माघ० १-६७, किरा० ३-४१<br><br>अभिमान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಣಯ /ಪ್ರೀತಿ<br><br>अभिमान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನ /ತಿಳುವಳಿಕೆ<br><b>प्रयोगाः - </b>"उत्साहादिसमुद्बोधः साधारण्याभिमानतः"<br><b>उल्लेखाः - </b>सा० द० ३-११<br><br>अभिमान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಪ್ಪು ತಿಳುವಳಿಕೆ /ಮಿಥ್ಯಾಜ್ಞಾನ /ತಪ್ಪು ಭಾವನೆ<br><br>अभिमान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಮ್ಮೆ /ಸೊಕ್ಕು<br><b>प्रयोगाः - </b>"वयं स्वपक्षशिथिलाभिमानाः संवृत्ताः"<br><b>उल्लेखाः - </b>माल० २<br><br>अभिमान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸೆ /ತೊಂದರೆ<br><b>विस्तारः - </b>"अभिमानस्त्वहङ्कृतौ । हिंसायां प्रणये ज्ञाने" - हेम० ।<br><br>

अभिमानशालिन्
अभिमानशालिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗರ್ವವುಳ್ಳ /ಅಹಂಕಾರವುಳ್ಳ<br><b>निष्पत्तिः - </b>अभि + शाडृ (श्लाघायाम्) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अभिमानेन शालते<br><b>प्रयोगाः - </b>""प्रभवन्त्यभिमानशालिनां मदमुत्तम्भयितुं विभूतयः"<br><b>उल्लेखाः - </b>किरा० २-४८<br><br>

अभिमानित
अभिमानित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತ್ರೀಪುರುಷರ ಕೂಡಿಕೆ /ಸಂಭೋಗ /ರತಿ<br><b>विस्तारः - </b>"सुरतं त्वभिमानितम्" - त्रिकाण्ड० ।<br><br>अभिमानित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆತ್ಮಗೌರವವುಳ್ಳ<br><br>अभिमानित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಹಂಕಾರವುಳ್ಳ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>अभिमानोऽस्य सञ्जातः<br><br>

अभिमानिन्
अभिमानिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಹಂಕಾರವುಳ್ಳ /ಗರ್ವವುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>अभिम्नोऽस्यास्ति<br><br>अभिमानिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆತ್ಮಗೌರವವುಳ್ಳ<br><b>प्रयोगाः - </b>"गुणानुरक्तामनुरक्तसाधनः कुलाभिमानी कुलजां नराधिपः"<br><b>उल्लेखाः - </b>किरा० १-३१<br><br>

अभिमाय
अभिमाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಜ್ಞಾನಿ /ತಿಳಿಗೇಡಿ<br><b>व्युत्पत्तिः - </b>मायामभिगतः<br><br>

अभिमुख
अभिमुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿರುವ<br><b>व्युत्पत्तिः - </b>अभिगतोमुखम्<br><b>प्रयोगाः - </b>"अभिमुखे मयि संहृतमीक्षणम्"<br><b>उल्लेखाः - </b>शाकु० २-११<br><br>अभिमुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಿಸಿರುವ<br><br>अभिमुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರುಗೊಳ್ಳುವ<br><b>प्रयोगाः - </b>"प्रसादाभिमुखो वेधाः प्रत्युवाच दिवओकसः"<br><b>उल्लेखाः - </b>कुमा० २-१६<br><br>अभिमुख<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಎದುರಿನಲ್ಲಿ /ಮುಂಭಾಗದಲ್ಲಿ<br><b>व्युत्पत्तिः - </b>अभिगतो मुखम्<br><b>प्रयोगाः - </b>"कर्णं ददात्यभिमुखं मयि भाषमाणे" । "तिष्ठन्मुनेरभिमुखं स विकीर्णधाम्नः" ।<br><b>उल्लेखाः - </b>शाकु० १-२७, किरा० २-५९<br><br>

अभिमुखीकरण
अभिमुखीकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಮಾಡಿಕೊಳ್ಳುವುದು<br><br>अभिमुखीकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬೋಧನೆ<br><br>

अभिमृष्ट
अभिमृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಪರ್ಶ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + मृश (आमर्शने) - "क्तः" (३-२-१०२)<br><br>अभिमृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧಾಳಿ ಮಾಡಲ್ಪಟ್ಟ<br><br>अभिमृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆರೆಸಲ್ಪಟ್ಟ<br><br>अभिमृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇರಿಸಲ್ಪಟ್ಟ /ಒಟ್ಟುಗೂಡಿಸಲ್ಪಟ್ಟ<br><br>अभिमृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಳಿಸಲ್ಪಟ್ಟ /ತೊಳೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + मृजूष् (शुद्धौ) - "क्तः" (३-२-१०२)<br><br>

अभियाति
अभियाति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರು /ಹಗೆ /ವೈರಿ<br><b>निष्पत्तिः - </b>अभि + या (प्रापणे) - "क्तिच्" (३-३-१७४)<br><b>व्युत्पत्तिः - </b>आभिमुख्यं युद्धार्थं याति<br><b>विस्तारः - </b>"अभियातिपरारातिप्रत्यर्थिपरिपन्थिनः" - अम० ।<br><br>

अभियातृ
अभियातृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರು /ಹಗೆ /ವೈರಿ<br><br>अभियातृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಹೋಗುವ<br><b>निष्पत्तिः - </b>अभि + या (प्रापणे) - "तृच्" (३-१-१३३)<br><br>

अभियान
अभियान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧಕಾಗಿ ಶತ್ರುವನ್ನು ಕುರಿತು ಮಾಡುವ ಪ್ರಯಾಣ<br><b>निष्पत्तिः - </b>अभि + या (प्रापणे) - "ल्युट्" (३-३-११५)<br><br>

अभियायिन्
अभियायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಹೋಗುವ<br><b>निष्पत्तिः - </b>अभि + या (प्रापणे) - "णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"रामाभियायिनां तेषां तदेवासीदमङ्गलम्"<br><b>उल्लेखाः - </b>रघु० १२-४३<br><br>

अभियुक्त
अभियुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿಜ್ಞ /ಪ್ರವೀಣ<br><b>निष्पत्तिः - </b>अभि + युजिर् (योगे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"न हि शक्यते दैवमन्यथाकर्तुमभियुक्तेनापि"<br><b>उल्लेखाः - </b>कादं०<br><br>अभियुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತತ್ಪರ /ಆಸಕ್ತ<br><b>प्रयोगाः - </b>"स्वस्वकर्मण्यधिकतरमभियुक्तः परिजनः"<br><b>उल्लेखाः - </b>मुद्रा० १<br><br>अभियुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಧಾನವುಳ್ಳ /ನೆಟ್ಟ ಮನಸ್ಸುಳ್ಳ<br><b>प्रयोगाः - </b>"भवतु भूयोभूयोऽभियुक्तः स्वरव्यक्तिमुपलप्स्ये"<br><b>उल्लेखाः - </b>मुद्रा० १<br><br>अभियुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶತ್ರುವಿನಿಂದ ಧಾಳಿ ಮಾಡಲ್ಪಟ್ಟ /ತಡೆದು ನಿಲ್ಲಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"स हि भृशमभियुक्तो यद्युपेयाद्विनाशम्"<br><b>उल्लेखाः - </b>मुद्रा० ३-२५<br><br>अभियुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪರಾಧಿ /ಪ್ರತಿವಾದಿ /ಆಪಾದಿಸಲ್ಪಟ್ಟವನು<br><br>अभियुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೃದ್ಧ /ಹಿರುಯನು<br><br>

अभियु्ज्
अभियु्ज्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧಾಳಿ ಮಾಡುವ<br><b>निष्पत्तिः - </b>अभि + युजिर् (योगे) - "क्विप्" (३-२-६१)<br><br>अभियु्ज्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶತ್ರು<br><br>

अभियोक्तव्य
अभियोक्तव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಸೇರಿಸಲ್ಪಡುವ<br><br>अभियोक्तव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಪಾದಿಸಲು ಯೋಗ್ಯನಾದ<br><b>निष्पत्तिः - </b>अभि + युजिर् (योगे) - "तव्यः" (३-१-९६)<br><br>अभियोक्तव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧಾಳಿ ಮಾಡಲ್ಪಡುವ<br><br>

अभियोक्तृ
अभियोक्तृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರು /ಹಗೆ /ವೈರಿ<br><b>निष्पत्तिः - </b>अभि + युजिर् (योगे) - "तृच्" (३-१-१३३)<br><b>प्रयोगाः - </b>"त्वय्युत्कृष्टवलेऽभियोक्तरि नृपे नन्दानुरक्ते पुरे"<br><b>उल्लेखाः - </b>मुद्रा० ४-१५<br><br>अभियोक्तृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾದಿ /ಅಪರಾಧ ಹೊರಿಸುವವನು<br><b>प्रयोगाः - </b>"अभियोक्ता न चेत् ब्रूयात् वध्यो दण्ड्यश्च धर्मतः"<br><b>उल्लेखाः - </b>मनु० ८-१२<br><br>

अभियोग
अभियोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿನಿವೇಶ /ಆಸಕ್ತಿ<br><b>निष्पत्तिः - </b>अभि + युजिर् (योगे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"अथ कस्यां कलायामभियोगो भवतः"<br><br>अभियोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಸದಾದ ಅವಮಾನ /ಸದ್ಯಃ ಒದಗಿದ ಪರಿಭವ<br><b>प्रयोगाः - </b>"अभियोग इमान् महीभुजो भवता तस्य कृतः कृतावधेः"<br><b>उल्लेखाः - </b>किरा० २-४६<br><b>विस्तारः - </b>"अभियोगस्तु शपथे स्यादार्द्रे च पराभवे" - विश्व० ।<br><br>अभियोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧಾಳಿ /ಮೇಲೆ ಬೀಳುವುದು<br><b>प्रयोगाः - </b>"स प्रापदप्राप्तपराभियोगम्"<br><b>उल्लेखाः - </b>कुमा० ७-५०<br><br>अभियोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಪಾದನೆ /ತಪ್ಪು ಹೊರಿಸುವುದು<br><b>प्रयोगाः - </b>"अभियोगमनिस्तीर्य नैनं प्रत्यभियोजयेत्"<br><b>उल्लेखाः - </b>याज्ञ० २-९<br><br>अभियोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧಕ್ಕಾಗಿ ಕರೆಯುವುದು<br><br>अभियोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ಯೋಗ /ಪ್ರಯತ್ನ<br><b>प्रयोगाः - </b>"निरुत्सुकानामभियोगभाजां समुत्सुकेवाङ्कमुपैति सिद्धिः"<br><b>उल्लेखाः - </b>किरा० ३-४०<br><br>अभियोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಪಥ /ಪ್ರತಿಜ್ಞೆ<br><br>अभियोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಡೆಗಟ್ಟುವುದು<br><b>प्रयोगाः - </b>"क्षुभितं वनगोचराभियोगात्"<br><b>उल्लेखाः - </b>किरा० १३-१०<br><br>अभियोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭ್ಯಾಸ<br><b>प्रयोगाः - </b>"गुरुचर्यातपस्तन्त्रमन्त्रयोगाभियोगजाम्"<br><b>उल्लेखाः - </b>मालती० ९-५३<br><br>

अभियोगिन्
अभियोगिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾದಿ /ಅಪರಾಧ ಹೊರಿಸುವವನು<br><b>निष्पत्तिः - </b>अभि + युजिर् (योगे) - "घिनुण्" (३-२-१४२)<br><b>प्रयोगाः - </b>"मिथ्याभियोगी द्विगुणमभियोगाद्धनं वहेत्"<br><b>उल्लेखाः - </b>याज्ञ० २-११<br><br>अभियोगिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧಾಳಿಕಾರ /ಮುತ್ತಿಗೆ ಹಾಕುವವನು<br><br>अभियोगिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಸಕ್ತಿಯುಳ್ಳವನು /ಉತ್ಕಟೇಚ್ಛೆಯುಳ್ಳವನು<br><br>

अभिरक्षण
अभिरक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣರಕ್ಷಣೆ /ಸುತ್ತಲೂ ಕಾಪಾಡುವುದು<br><b>व्युत्पत्तिः - </b>अभितो रक्षणम्<br><br>

अभिरक्षा
अभिरक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अभिरक्षण ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अभि + रक्ष (पालने) - "अः" (३-३-१-३)<br><b>प्रयोगाः - </b>"प्रशान्तबाधं दिशतोऽभिरक्षया"<br><b>उल्लेखाः - </b>किरा० १-१८<br><br>

अभिरक्षित
अभिरक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣವಾಗಿ ರಕ್ಷಿಸಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>अभितो रक्षितः<br><br>

अभिरक्षितृ
अभिरक्षितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣವಾಗಿ ಕಾಪಾಡುವ /ಎಲ್ಲಾ ಕಡೆಗಳಲ್ಲಿಯೂ ರಕ್ಷಣೆಯನ್ನು ಕೊಡುವ<br><b>व्युत्पत्तिः - </b>अभितो रक्षिता<br><b>प्रयोगाः - </b>"वर्णानामाश्रमाणां च राजा सृष्टोऽभिरक्षिता"<br><b>उल्लेखाः - </b>मनु० ७-३५<br><br>

अभिरत
अभिरत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಆಸಕ್ತಿಯುಳ್ಳ /ಬಹಳ ಶ್ರದ್ಧೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>अभि + रमु (क्रीडायाम्) - "क्तः" (३-४-७२)<br><br>अभिरत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷಗೊಂಡ /ಆನಂದ ಹೊಂದಿದ<br><b>प्रयोगाः - </b>"रेचितं परिजनेन महीयः केवलाभिरतदम्पति धाम"<br><b>उल्लेखाः - </b>माघ० १०-५५<br><br>अभिरत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಗ್ರ /ಕಾರ್ಯತತ್ಪರ<br><b>प्रयोगाः - </b>"आस्त्ट्तेऽभिनवपल्लवपुष्पैरप्यनारतरताभिरताभ्यः"<br><b>उल्लेखाः - </b>माघ० १०-८९<br><br>

अभिरति
अभिरति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರದ್ಧೆ /ಆಸಕ್ತಿ<br><br>अभिरति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಪ್ರಕಾಶವುಳ್ಳ /ಬಹಳ ಪ್ರಕಾಶಮಾನವಾದ<br><b>व्युत्पत्तिः - </b>अभितो रतिः<br><b>प्रयोगाः - </b>"अविमृष्यमेतदभिलक्ष्य स द्विषतां वधेन विषयाभीरतिम्"<br><b>उल्लेखाः - </b>किरा० ६-४४<br><br>

अभिराज्
अभिराज्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಕ್ರವರ್ತಿ /ಸಾರ್ವಭೌಮ<br><br>अभिराज्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಪ್ರಕಾಶವುಳ್ಳ<br><b>निष्पत्तिः - </b>अभि + राजृ (दीप्तौ) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>अभितो राजते<br><br>

अभिराद्ध
अभिराद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + राध (संसिद्धौ) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"दशाननादीनभिराद्धदेवतावितीर्णवीर्यातिशयान् हसत्यसौ"<br><b>उल्लेखाः - </b>माघ० १-७१<br><br>

अभिराद्धृ
अभिराद्धृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಿಸುವ /ಆರಾಧಿಸುವ<br><b>निष्पत्तिः - </b>अभि + राध (संसिद्धौ) - "तृच्" (३-१-१३३)<br><br>

अभिराम
अभिराम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಂದರವಾದ /ಮನೋಹರವಾದ<br><b>निष्पत्तिः - </b>अभि + रमु (क्रीडायाम्) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>अभिरमतेऽस्मिन्<br><b>प्रयोगाः - </b>"राम इत्यभिरामेण वपुषा तस्य चोदितः"<br><b>उल्लेखाः - </b>रघु० १०-६७<br><br>अभिराम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಧುರವಾದ /ಇಂಪಾದ<br><b>प्रयोगाः - </b>"मनोऽभिरामाः शृण्वन्तौ रथनेमिस्वनोन्मुखैः"<br><b>उल्लेखाः - </b>रघु० १-३९<br><br>अभिराम<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಸುಂದರವಾಗಿ /ಮನೋಹರವಾಗಿ<br><b>प्रयोगाः - </b>"ग्रीवाभङ्गाभिरामं मुहुरनुपतति स्यन्दने दत्तदृष्टिः पश्चार्धेन प्रविष्टः शरपतनभयात् भूयसा पूर्वकायम्"<br><b>उल्लेखाः - </b>शाकु० १-७<br><br>

अभिरुचि
अभिरुचि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಚ್ಛೆ /ಅಪೇಕ್ಷೆ<br><b>व्युत्पत्तिः - </b>अभि अत्यन्ता रुचिः<br><b>प्रयोगाः - </b>"यशसि चाभिरुचिर्व्यसनं श्रुतौ"<br><b>उल्लेखाः - </b>भर्तृ० २-६३<br><br>

अभिरूप
अभिरूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>अभि + रूप (रूपक्रियायाम्) + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अभिरूपयति सर्वम्<br><br>अभिरूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><br>अभिरूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><br>अभिरूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ /ಮನ್ಮಥ<br><b>व्युत्पत्तिः - </b>अभिरूपमस्य<br><br>अभिरूप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನೋಹರವಾದ /ಸುಂದರವಾದ<br><b>प्रयोगाः - </b>"उत्कृष्टायामभिरूपाय वराय सदृशाय च"<br><b>उल्लेखाः - </b>मनु० ९-८८<br><br>अभिरूप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಂಡಿತ /ಜ್ಞಾನಿ<br><b>व्युत्पत्तिः - </b>अभिगतं रूपं येन<br><b>प्रयोगाः - </b>"अभिरूपभूयिष्ठा परिषदियम्"<br><b>उल्लेखाः - </b>शाकु० १<br><br>अभिरूप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಿಯವಾದ /ಅಚ್ಚುಮೆಚ್ಚಾದ<br><b>प्रयोगाः - </b>"यो यः प्रदेशः सख्या मेऽभिरूपस्तं तमालिखितुकामो भवेत्"<br><b>उल्लेखाः - </b>शाकु० ६<br><br>अभिरूप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯುಕ್ತವಾದ /ಯೋಗ್ಯವಾದ<br><br>

अभिलक्ष्य
अभिलक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುರಿಯಿಡಲ್ಪಡುವ /ಉದ್ದೇಶಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अभि + लक्ष (दर्शनाकाङ्क्षयोः) + णिच् - "यत्" (३-१-९७)<br><br>अभिलक्ष्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಯಕ್ಕೆ ಎದುರಾಗಿ ನೋಡಿ /ಗುರಿಯಿಟ್ಟು ನೋಡಿ<br><b>निष्पत्तिः - </b>अभि + लक्ष (दर्शनाकाङ्क्षयोः) "ल्यप्" (७-१-३७)<br><br>अभिलक्ष्य<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಯಕ್ಕೆ ಎದುರಾಗಿ<br><br>

अभिलङ्घन
अभिलङ्घन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾರುವುದು /ದಾಟುವುದು<br><b>निष्पत्तिः - </b>अभि + लघि (गतौ) - "ल्युट्" (३-३-११५)<br><br>

अभिलषणीय
अभिलषणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲು ಯೋಗ್ಯವಾದ<br><br>अभिलषणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अभि + लष (कान्तौ) - "अनीयर्" (३-१-९६)<br><br>

अभिलषित
अभिलषित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆ /ಇಚ್ಛೆ<br><b>निष्पत्तिः - </b>अभि + लष (कान्तौ) - भावे "क्तः" (३-३-११४)<br><b>प्रयोगाः - </b>"यथाभिलषितमनुष्ठीयताम्"<br><b>उल्लेखाः - </b>पञ्चतं०<br><br>अभिलषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಟ್ಟ /ಇಷ್ಟವಾದ<br><b>निष्पत्तिः - </b>अभि + लष (कान्तौ) - "क्तः" (३-२-१०२)<br><br>

अभिलाप
अभिलाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದಪ್ರಯೋಗ /ವಾಕ್ಯಪ್ರಯೋಗ<br><b>निष्पत्तिः - </b>अभि + लप (व्यक्तायां वाचि) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>अभिलप्यतेऽनेन<br><b>प्रयोगाः - </b>"भृशकुसुमशरेषुपातमोहादनवसितार्थपदाकुलोऽभिलापः"<br><b>उल्लेखाः - </b>किरा० १०-६१<br><br>अभिलाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿವರಣೆ /ವಿಶೇಷ ನಿರ್ದೇಶ<br><br>अभिलाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಟನೆ /ಘೋಷಣೆ<br><br>

अभिलाष
अभिलाष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಚ್ಛೆ /ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>अभि + लष (कान्तौ) - "घञ्" (३-३-१९)<br><b>प्रयोगाः - </b>"अतोऽभिलाषे प्रथमं तथाविधे मनो बबन्धान्यरसान् विलङ्घ्य सा"<br><b>उल्लेखाः - </b>रघु० ३-४<br><br>अभिलाष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿ /ಅನುರಾಗ<br><b>प्रयोगाः - </b>"अभिलाषमुदीरितेन्द्रियः"<br><b>उल्लेखाः - </b>कुमा० ४-४१<br><br>

अभिलाषिन्
अभिलाषिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಚ್ಛಿಸುವ /ಅಪೇಕ್ಷಿಸುವ<br><b>निष्पत्तिः - </b>अभि + लष (कान्तौ) - "णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"जलाभिलाषी जलमाददानां छायेव तां भूपतिरन्वगच्छत्"<br><b>उल्लेखाः - </b>रघु० २-६<br><br>

अभिलाषुक
अभिलाषुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಆಸೆ ಪಡುವ /ಅಧಿಕವಾಗಿ ಆಸೆಪಡುವ<br><b>निष्पत्तिः - </b>अभि + लष (कान्तौ) - "उकञ्" (३-२-१५४)<br><b>प्रयोगाः - </b>"रभसादुदस्थुरथ युद्धमनुचितभियोऽभिलाषुकाः"<br><b>उल्लेखाः - </b>माघ० १५-५९<br><br>

अभिलिखित
अभिलिखित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲೇಖನ /ಬರವಣಿಗೆ<br><b>निष्पत्तिः - </b>अभि + लिख (अक्षरविन्यासे) - भावे "क्तः" (३-३-११४)<br><br>अभिलिखित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬರೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कर्म० "क्तः" (३-२-१०२)<br><br>

अभिवन्दन
अभिवन्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿನಯಪೂರ್ವಕನಮಸ್ಕಾರ /ಗೌರವದಿಂದ ಮಾಡುವ ನಮಸ್ಕಾರ<br><b>व्युत्पत्तिः - </b>अभिमुखं वन्दनम्<br><br>

अभिवर्तन
अभिवर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಿಸುವುದು /ಹತಿರಕ್ಕೆ ಹೋಗುವುದು<br><b>निष्पत्तिः - </b>अभि + वृतु (वर्तने) - "ल्युट्" (३-३-११५)<br><br>

अभिवर्तिन्
अभिवर्तिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿರುವ /ಅಭಿಮುಖವಾಗಿರುವ<br><b>निष्पत्तिः - </b>अभि + वृतु (वर्तने) - "णिनिः" (३-१-१३४)<br><br>

अभिवर्तिनी
अभिवर्तिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿರುವ /ಅಭಿಮುಖವಾಗಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अभिवर्धन
अभिवर्धन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಳೆಸುವುದು /ಹೆಚ್ಚಿಸುವುದು<br><b>निष्पत्तिः - </b>अभि + वृधु (वृद्धौ) - "ल्युट्" (३-३-११५)<br><br>अभिवर्धन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆಳೆಸುವ /ಹೆಚ್ಚಿಸುವ<br><b>निष्पत्तिः - </b>अभि + वृधु (वृद्धौ) - "ल्युः" (३-१-१३४)<br><br>

अभिवर्धना
अभिवर्धना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಳೆಸುವ /ಹೆಚ್ಚಿಸುವ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्" (४-१-४)<br><br>

अभिवर्धिन्
अभिवर्धिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆಳೆಸುವ /ಹೆಚ್ಚಿಸುವ<br><b>निष्पत्तिः - </b>अभि + वृधु (वृद्धौ) - "णिनिः" (३-३-१७०)<br><br>

अभिवर्धिनी
अभिवर्धिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಳೆಸುವ /ಹೆಚ್ಚಿಸುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अभिवर्षण
अभिवर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಲ್ಲಾ ಕಡೆಯಲ್ಲಿಯೂ ಮಳೆಯಾಗುವುದು<br><br>अभिवर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ಚಿಮುಕಿಸುವುದು<br><b>व्युत्पत्तिः - </b>अभितो वर्षणम्<br><br>

अभिवर्षिन्
अभिवर्षिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲಾ ಕಡೆಯಲ್ಲಿಯೂ ಮಳೆಸುರಿಸುವ ಮೋಡ<br><br>अभिवर्षिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ಚಿಮುಕಿಸುವ<br><b>निष्पत्तिः - </b>वृषु (सेचने) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अभितो वर्षति<br><br>

अभिवाद
अभिवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಮಸ್ಕಾರ /ಪ್ರಣಾಮ<br><b>निष्पत्तिः - </b>अभि + वद (व्यक्तायां वाचि) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"प्रत्युत्थानाभिवादाभ्यां पुनस्तान् प्रतिपद्यते"<br><b>उल्लेखाः - </b>मनु० २-१२०<br><br>

अभिवादक
अभिवादक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಮಸ್ಕರಿಸುವವನು<br><b>निष्पत्तिः - </b>अभि + वद (व्यक्तायां वाचि) - "ण्वुल्" (३-१-१३३)<br><b>प्रयोगाः - </b>"आयुष्मान् भव सौम्येति वाच्यो विप्रोऽभिवादकः"<br><b>उल्लेखाः - </b>मनु० २-१२५<br><br>

अभिवादन
अभिवादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೌರವದಿಂದ ಮಾಡುವ ನಮಸ್ಕಾರ /ವಿನಯಪೂರ್ವಕವಾದ ನಮಸ್ಕಾರ<br><b>निष्पत्तिः - </b>अभि + वद (व्यक्तायां वाचि) + णिच् - "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>अभिमुखं वाद्यते आशीरनेन<br><b>प्रयोगाः - </b>"अभिवादनशीलस्य नित्यं वृद्धोपसेविनः । चत्वारि तस्य वर्धन्ते आयुर्विद्या यशो बलम् ॥"<br><br>

अभिवाद्य
अभिवाद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಮಸ್ಕರಿಸಲು ಯೋಗ್ಯನಾದ<br><b>निष्पत्तिः - </b>अभि + वद (व्यक्तायां वाचि) + णिच् - "ण्यत्" (३-१-९७)<br><b>व्युत्पत्तिः - </b>अभिवादयितुमर्हः<br><br>अभिवाद्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಣಾಮ ಮಾಡಿ<br><b>निष्पत्तिः - </b>अभि + वह (प्रापणे) - भावे "ण्यत्" (३-१-१२४)<br><b>प्रयोगाः - </b>"हव्यकव्याभिवाह्याय सर्वस्याय च गुप्तये"<br><b>उल्लेखाः - </b>मनु० १-९४<br><br>

अभिवाह्य
अभिवाह्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಯ್ಯುವುದು<br><br>अभिवाह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಒಯ್ಯಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>अभि + वह (प्रापणे) + णिच् - "ण्यत्" (३-१-१२४)<br><br>अभिवाह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಒಯ್ಯಲ್ಪಡುವ<br><b>व्युत्पत्तिः - </b>अभितो विधिः व्याप्तिः<br><b>प्रयोगाः - </b>"आङ्मर्यादाभिविध्योः"<br><b>उल्लेखाः - </b>पा० सू०<br><br>

अभिविधि
अभिविधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಪ್ತಿ /ಸೇರಿಸಿಕೊಳ್ಳುವಿಕೆ<br><br>

अभिविनीत
अभिविनीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಚ ವಿನಯವುಳ್ಳವನು /ಒಳ್ಳೆಯ ನಡತೆಯುಳ್ಳವನು<br><br>अभिविनीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಶಿಕ್ಷಿತ /ಚೆನ್ನಾಗು ಪಳಗಿಸಲ್ಪಟ್ಟ<br><br>

अभिविश्रुत
अभिविश्रुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಸಿದ್ಧನಾದ /ಪ್ರಖ್ಯಾತಿ ಪಡೆದ<br><br>

अभिवीक्षण
अभिवीक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ನೋಡುವುದು /ಸುತ್ತಲೂ ನೋಡುವುದು<br><b>व्युत्पत्तिः - </b>अभितो वीक्षणम्<br><br>

अभिवृत्ति
अभिवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿರುವುದು /ಅಭಿಮುಖವಾಗಿರುವುದು<br><b>निष्पत्तिः - </b>अभि + वृतु (वर्तने) - "क्तिन्" (३-३-९४)<br><br>

अभिवृद्धि
अभिवृद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚುವುದು /ಅಧಿಕವಾಗುವುದು<br><b>निष्पत्तिः - </b>अभि + वृधु (वृद्धौ) - "क्तिन्" (३-३-९४)<br><br>

अभिव्यक्त
अभिव्यक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಪಷ್ಟವಾದ /ಪ್ರಕಾಶವಾದ /ಚೆನ್ನಾಗಿ ಕಾಣಿಸಿಕೊಂಡ<br><b>निष्पत्तिः - </b>अभि + वि + अञ्चू (व्यक्त्यादौ) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"पूरप्यभिव्यक्तमुखप्रसादा शरीरबन्धेन तिरोबभूव"<br><b>उल्लेखाः - </b>रघु० १६-२३<br><br>

अभिव्यक्ति
अभिव्यक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಪಷ್ಟವಾಗಿ ಕಾಣುವಿಕೆ /ಪ್ರಕಟವಾಗುವಿಕೆ<br><b>निष्पत्तिः - </b>अभि + वि + अञ्चू (व्यक्त्यादौ) - "क्तिन्" (३-३-९४)<br><br>

अभिव्यञ्जक
अभिव्यञ्जक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸುವ /ಸ್ಪಷ್ಟಪಡಿಸುವ /ಚೆನ್ನಾಗಿ ತಿಳಿಯಪಡಿಸುವ<br><b>निष्पत्तिः - </b>अभि + वि + अञ्चू (व्यक्त्यादौ) - "ण्वुल्" (३-१-१३३)<br><br>अभिव्यञ्जक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಂಜನಾವೃತ್ತಿಯಿಂದ ತಿಳಿಯಪಡಿಸುವ<br><br>

अभिव्यापक
अभिव्यापक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲಾ ಕಡೆಗೂ ವ್ಯಾಪಿಸುವ /ಎಲ್ಲಾ ಕಡೆಗೂ ಸಂಬಂಧಿಸಿದ<br><b>निष्पत्तिः - </b>अभि + वि + आप्लृ (व्याप्तौ) - "ण्वुल्" (३-१-१३३)<br><br>

अभिव्यापिन्
अभिव्यापिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>अभिव्यापक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अभि + वि + आप्लृ (व्याप्तौ) - "णिनिः" (३-२-७८)<br><br>

अभिव्याप्ति
अभिव्याप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ಹರಡುವಿಕೆ /ಎಲ್ಲಾ ಕಡೆಗೂ ಸಂಬಂಧಪಡುವಿಕೆ<br><b>निष्पत्तिः - </b>अभि + वि + आप्लृ (व्याप्तौ) - "क्तिन्" (३-३-९४)<br><br>

अभिव्याप्य
अभिव्याप्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ಹರಡಲ್ಪಡುವ /ಎಲ್ಲಾ ಕಡೆಯಲ್ಲಿಯೂ ಸೇರಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अभि + वि + आप्लृ (व्याप्तौ) - कर्म० "ण्यत्" (३-१-१२४)<br><br>अभिव्याप्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲಾ ಕಡೆಗೂ ಹರಡಿ /ಸುತ್ತಲೂ ಸೇರಿಕೊಂಡು<br><b>निष्पत्तिः - </b>अभि + वि + आप्लृ (व्याप्तौ) - "ल्यप्" (७-१-३७)<br><br>

अभिव्याहार
अभिव्याहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಪಷ್ಟವಾದ ಉಚ್ಚಾರಣೆ /ಸ್ಫುಟವಾಗಿ ಮಾತಾಡುವುದು<br><b>निष्पत्तिः - </b>अभि + वि + आ+ हृञ् (हरणे) - "घञ्" (३-३-१८)<br><br>

अभिशंसन
अभिशंसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪವಾದ /ತಪ್ಪು ಹೊರಿಸುವುದು<br><b>निष्पत्तिः - </b>अभि + शंसु (स्तुतौ) - "ल्युट्" (३-३-११५)<br><br>अभिशंसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಮಾತಾಡುವುದು<br><br>अभिशंसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯಕ್ಷವಾಗಿ ಕಠಿನವಾಗಿ ಮಾತಾಡುವುದು<br><b>विस्तारः - </b>"अभिशापोऽभिशंसनम्" - वैज० ।<br><br>

अभिशंसिन्
अभिशंसिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಕಠಿನವಾಗಿ ಮಾತಾಡುವ<br><br>अभिशंसिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪವಾದವನ್ನು ಹೊರಿಸುವ<br><b>निष्पत्तिः - </b>अभि + शंसु (स्तुतौ) - "णिनिः" (३-२-७८)<br><b>प्रयोगाः - </b>"मिथाभिशंसिनो दोषो द्विः समो भूतवादिनः"<br><b>उल्लेखाः - </b>याज्ञ० ३-२८४<br><br>

अभिशङ्का
अभिशङ्का<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಶಯ /ಸಂದೇಹ<br><br>अभिशङ्का<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭ್ರಾಂತಿ<br><b>निष्पत्तिः - </b>अभि + शकि (शङ्कायाम्) - "अः" (३-३-१०३)<br><b>प्रयोगाः - </b>"उपेयुषी कल्पलताभिशङ्कया कथं वितस्त्रस्यति षट्पदावलिः"<br><b>उल्लेखाः - </b>किरा० ८-७<br><br>

अभिशङ्कित
अभिशङ्कित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭ್ರಾಂತಿಗೆ ವಿಷಯವಾದ<br><br>अभिशङ्कित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಶಯಕ್ಕೆ ಒಳಗಾದ<br><b>निष्पत्तिः - </b>अभि + शकि (शङ्कायाम्) "क्तः" (३-२-१०२)<br><br>

अभिशप्त
अभिशप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಪಿಸಲ್ಪಟ್ಟ /ಕೆಡುಕುಂಟಾಗಲೆಂದು ಹಿರಿಯರ ಶಾಪ ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>अभि + शप (आक्रोशे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"न नामग्रहणं कुर्यात् जनकय गुरोस्तथा । भार्याया अभिशप्तस्य कृपणस्य विशेषतः ॥"<br><br>

अभिशब्दित
अभिशब्दित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಕರೆಯಲ್ಪಟ್ಟ<br><br>अभिशब्दित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಹೇಳಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>अभि आभिमुख्येन शब्दितः<br><br>

अभिशस्त
अभिशस्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಪ /ಬೈಗಳು<br><br>अभिशस्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸೆ /ತೊಂದರೆಪಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अभि + शसु (हिंसायाम्) - भावे "क्तः" (३-३-११४)<br><br>अभिशस्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾಪಾತಕಿಯೆಂದು ಮಿಥ್ಯಾಪವಾದಕ್ಕೆ ಗುರಿಯಾದ /ಜನರಿಂದ ದೂಷಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + शंसु (स्तुतौ) - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>अभिशस्यते स्म<br><b>प्रयोगाः - </b>"अभिशस्तस्य षण्डस्य पुंश्चल्या दाम्भिकस्य च । शुक्तं पर्युषितं चैव शूद्रस्योच्छिष्टमेव च ॥"<br><b>उल्लेखाः - </b>मनु० ४-२११<br><br>अभिशस्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸಲ್ಪಟ್ಟ<br><br>अभिशस्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಪಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + शसु - कर्म० "क्तः" (३-२-१०२)<br><br>

अभिशस्ति
अभिशस्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲೋಕಾಪವಾದ<br><br>अभिशस्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಸ್ತ್ರೀ ಸಂಗಮವಿಷಯದಲ್ಲಿ ಮಿಥ್ಯಾಪವಾದ<br><br>अभिशस्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಚನೆ /ಬೇಡಿಕೆ<br><b>निष्पत्तिः - </b>अभि + शंसु (स्तुतौ) - "क्तिन्" (३-३-९४)<br><b>विस्तारः - </b>"अभिशस्तिः पुनर्लोकापवादे प्रार्थनेऽपि च" - हेम० ।<br><br>अभिशस्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸೆ /ತೊಂದರೆ<br><b>निष्पत्तिः - </b>अभि + शसु (हिंसायाम्) - "क्तिन्" (३-३-९४)<br><br>

अभिशाप
अभिशाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಿಥ್ಯಾಪವಾದ /ಚಾಡಿ ಹೇಳುವುದು<br><br>अभिशाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಪ /ಬೈಗಳು<br><b>निष्पत्तिः - </b>अभि + शप (आक्रोशे) - "घञ्" (३-३-१८)<br><br>

अभिश्रवण
अभिश्रवण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರಾದ್ಧಭೋಜನ ಮಾಡುತ್ತಿರುವಾಗ ಶ್ರವಣಮಾಡಿಸುವ ಮಂತ್ರ<br><br>

अभिषङ्ग
अभिषङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಿಭವ /ಅಪಮಾನ<br><b>निष्पत्तिः - </b>अभि + षञ्ज (सङ्गे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"जाताभिषङ्गो नृपतिर्निषङ्गादुद्धर्तुमैच्छत्प्रसभोद्धृतारिः"<br><b>उल्लेखाः - </b>रघु० २-३०<br><br>अभिषङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಪ /ಬೈಗಳು<br><br>अभिषङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ /ಸಂಪರ್ಕ<br><b>प्रयोगाः - </b>"मुहुरिति वरिविभ्रमाभिषङ्गात्"<br><b>उल्लेखाः - </b>माघ० ७-६८<br><br>अभिषङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಪಥ /ಪ್ರತಿಜ್ಞೆ<br><b>विस्तारः - </b>"अभिषङ्गस्त्वभिषवे सङ्ग आक्रोशनेऽपि च" - वैज० । "अभिषङ्गः पुंल्लिङ्गः पराभवाक्रोशशपथेषु" - मेदि० ।<br><br>

अभिषव
अभिषव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೋಮಲತೆಯನ್ನು ಕುಟ್ಟಿ ರಸವನ್ನು ಹಿಂಡುವುದು<br><br>अभिषव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗದ ಸಲುವಾಗಿ ಮಾಡುವ ಸ್ನಾನ<br><br>अभिषव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಟ್ಟಿ ಇಳಿಸುವುದು /ಸಾರಾಯಿ ತೆಗೆಯುವುದು<br><br>अभिषव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ನಾನ<br><br>अभिषव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೋಮರಸದ ಪಾನ<br><br>अभिषव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೋಮರಸವನ್ನು ಹಿಂಡುವ ಬೆರಳು<br><br>अभिषव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞ<br><b>निष्पत्तिः - </b>अभि + षुञ् (अभिषवे) - "अप्" (३-३-५७)<br><b>प्रयोगाः - </b>"जपोपवासाभिषवैर्मुनीनाम्"<br><b>उल्लेखाः - </b>किरा० ३-२८<br><b>विस्तारः - </b>"अभिषवः क्रतौ मद्यसन्धानस्नानयोरपि" - हेम० ।<br><br>

अभिषवण
अभिषवण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ನಾನ<br><b>प्रयोगाः - </b>"शिरसा हरिन्मणिनिभः स वहन् कृतजन्मनोऽभिषवणेन जटाः"<br><b>उल्लेखाः - </b>किरा० ६-२३<br><br>अभिषवण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೋಮರಸವನ್ನು ಹಿಂಡುವುದು<br><br>

अभिषवणी
अभिषवणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೋಮಲತೆಯಿಂದ ರಸವನ್ನು ತೆಗೆಯುವ ಸಾಧನ<br><b>निष्पत्तिः - </b>अभि + षुञ् (अभिषवे) - "ल्युट्" (३-३-११५) । "ङीप्" (४-१-५)<br><br>

अभिषिक्त
अभिषिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಟ್ಟಾಭಿಷೇಕ ಮಾಡಲ್ಪಟ್ಟ ದೊರೆ<br><br>अभिषिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ನಾನ ಮಾಡಿದ<br><b>निष्पत्तिः - </b>अभि + षिव (क्षरणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"सुधारसैरुवाम्भोभिरभिषिक्तो हुताशनः"<br><b>उल्लेखाः - </b>कुमा० १०-३९<br><br>

अभिषिषेणयिषा
अभिषिषेणयिषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇನೆಯೊಡನೆ ಶತ್ರುವಿನ ಮೇಲೆ ಯುದ್ಧಕ್ಕೆ ಹೊರಡುವ ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>अभि + सेना + णिच् + सन् - "अः" (३-३-१०२)<br><b>व्युत्पत्तिः - </b>अभिषेणयितुमिच्छा<br><br>

अभिषिषेणयिषु
अभिषिषेणयिषु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇನೆಯೊಡನೆ ಶತ್ರುವಿನ ಮೇಲೆ ಯುದ್ಧಕ್ಕೆ ಹೊರಡುವ ಅಪೇಕ್ಷೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>अभि + सेना + णिच् + सन् - "उः" (३-२-१६८)<br><b>व्युत्पत्तिः - </b>अभिषेणयितुमिच्छुः<br><b>प्रयोगाः - </b>"अभिषिषेणयिषुं भुवनानि यः"<br><b>उल्लेखाः - </b>माघ० ६-६४<br><br>

अभिषुत
अभिषुत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಜಿ /ಅಂಬಲಿ<br><b>विस्तारः - </b>"अवन्तिसोमं रक्षोघ्नं शुक्ताभिषुतकुञ्जलम्" - वैज० ।<br><br>

अभिषेक
अभिषेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಟ್ಟಾಭಿಷೇಕ /ಮುಕುಟಾಭಿಷೇಕ<br><b>निष्पत्तिः - </b>अभि + षिच (क्षरणे) - भावे "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"अथाभिषेकं रघुवंशकेतोः प्रारब्धमानन्दजलैर्जनन्योः"<br><b>उल्लेखाः - </b>रघु० १४-७<br><br>अभिषेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ನಾನ<br><b>प्रयोगाः - </b>"कृताभिषेकैर्दिव्यानां त्रिसोतसि च सप्तभिः"<br><b>उल्लेखाः - </b>रघु० १०-६३<br><br>अभिषेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಂತಿಗಾಗಿ ಮಾಡುವ ಪ್ರೋಕ್ಷಣೆ<br><br>अभिषेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತಾಪ್ರತಿಷ್ಠೆಗಾಗಿ ಮಾಡುವ ವಿಗ್ರಹದ ಅಭಿಷೇಕ<br><br>अभिषेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೋಕ್ಷಣೆ /ನೀರು ಚಿಮುಕಿಸುವುದು<br><br>अभिषेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><b>निष्पत्तिः - </b>अभि + षिच (क्षरणे) - कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>अभिषिच्यतेऽनेन<br><br>

अभिषेक्तृ
अभिषेक्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಟ್ಟಾಭಿಷೇಕ ಮಾಡುವವನು<br><br>अभिषेक्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರನ್ನು ಪ್ರೋಕ್ಷಿಸುವವನು<br><b>निष्पत्तिः - </b>अभि + षिच (क्षरणे) - "तृच्" (३-१-१३३)<br><br>

अभिषेक्त्री
अभिषेक्त्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अभिषेक्तृ ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अभिषेचन
अभिषेचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>अभिषेक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अभि + षिच (क्षरणे) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"अनुभूय वसिष्ठसम्भृतैः सलिलैस्तेन सहाभिषेचनम्"<br><b>उल्लेखाः - </b>रघु० ८-३<br><br>

अभिषेचनीय
अभिषेचनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿಷೇಕಕ್ಕೆ ಯೋಗ್ಯನಾದ<br><b>निष्पत्तिः - </b>अभि + षिच (क्षरणे) -"अनीयर्" (३-१-९६)<br><br>

अभिषेणन
अभिषेणन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರುವಿಗೆ ಅಭಿಮುಖವಾಗಿ ಯುದ್ಧಕ್ಕಾಗಿ ದಂಡೆತ್ತಿ ಹೋಗುವುದು<br><b>निष्पत्तिः - </b>अभि + सेना + णिच् - "ल्युट्" (३-३-११५)<br><br>

अभिष्टव
अभिष्टव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತುತಿ /ಸ್ತೋತ್ರ<br><br>अभिष्टव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಣನೆ<br><b>निष्पत्तिः - </b>अभि + ष्टुञ् (स्तुतौ) - "अप्" (३-३-५७)<br><br>

अभिष्टुत
अभिष्टुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಗಳಲ್ಪಟ್ಟ /ಸ್ತುತಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + ष्टुञ् (स्तुतौ) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"स दैत्यहत्यामिच्छद्भिः सुरैरेवमभिष्टुतः"<br><b>उल्लेखाः - </b>याद० १-६५<br><br>अभिष्टुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವರ್ಣಿಸಲ್ಪಟ್ಟ<br><br>

अभिष्यन्द
अभिष्यन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಬಹಿಸುವುದು /ಹರಿಯುವುದು<br><b>निष्पत्तिः - </b>अभि + स्यन्दू (प्रस्रवणे) - भावे "घञ्" (३-३-१८)<br><br>अभिष्यन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೋರುವುದು /ತೊಟ್ಟಿಕ್ಕಿವುದು<br><br>अभिष्यन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಿಕವಾಗುವುದು /ದೊಡ್ಡದಾಗುವಿಕೆ<br><b>प्रयोगाः - </b>"स्वर्गाभिष्यन्दवमनं कृत्वेवोपनिवेशितम्"<br><b>उल्लेखाः - </b>कुमा० ६-३७<br><br>

अभिष्यन्दनगर
अभिष्यन्दनगर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಖಾನಗರ /ಬಡಾವಣೆ<br><b>व्युत्पत्तिः - </b>अभिष्यन्देन निर्मितं नगरम्<br><br>

अभिष्यन्दिन्
अभिष्यन्दिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರವಹಿಸುವ /ಹರಿಯುವ<br><b>निष्पत्तिः - </b>अभि + स्यन्दू (प्रस्रवणे) - णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अभिष्यन्दते<br><br>अभिष्यन्दिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೋರುವ /ಜಿನುಗುವ<br><br>

अभिष्वङ्ग
अभिष्वङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ /ಸಂಪರ್ಕ<br><br>अभिष्वङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿ /ಅನುರಾಗ<br><b>निष्पत्तिः - </b>अभि + षञ्ज (परिष्वङ्गे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"असक्तिरनभिष्वङ्गः पुत्रदारागृहादिषु"<br><b>उल्लेखाः - </b>गीता० १३-९<br><br>

अभिसंरब्ध
अभिसंरब्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪಗೊಂಡ /ಕುಪಿತನಾದ<br><b>निष्पत्तिः - </b>अभि + सम् + रभ (राभत्स्ये) - "क्तः" (३-४-७२)<br><br>

अभिसंरम्भ
अभिसंरम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪ /ರೋಷ<br><b>निष्पत्तिः - </b>अभि + सम् + रभ (राभत्स्ये) - "घञ्" (३-३-१८)<br><br>

अभिसंवृत
अभिसंवृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ಮುಚ್ಚಲ್ಪಟ್ಟ /ಚೆನ್ನಾಗಿ ಹೊದಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + सम् + वृञ् (वरणे) - "क्तः" (३-२-१०२)<br><br>

अभिसंश्रय
अभिसंश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ /ಆಸರೆ<br><b>व्युत्पत्तिः - </b>अभितः संश्रयः<br><br>

अभिसंसारम्
अभिसंसारम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒತ್ಟಿಗೆ ಕಲೆತು ಎದುರಿಗೆ ಬಂದು /ಗುಂಪು ಗುಂಪಾಗಿ ಎದುರಿಗೆ ಬಂದು<br><b>निष्पत्तिः - </b>अभि + सम् + सृ (गतौ) - "णमुल्" (३-४-२२)<br><br>

अभिसन्ताप
अभिसन्ताप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ<br><b>निष्पत्तिः - </b>अभि + सम् + तप (सन्तापे) - अधि० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>अभिसन्तप्यतेऽत्र<br><br>अभिसन्ताप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕ್ಷೇಪಣೆ /ಬೈಗಳು<br><b>निष्पत्तिः - </b>अभि + सम् + तप (सन्तापे) - कर० "घञ्" (३-३-१२१)<br><br>अभिसन्ताप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಗಳ /ಹೋರಾಟ<br><br>अभिसन्ताप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಲ್ಲಾ ಕಡೆಯಿಂದಲೂ ಉಂಟಾಗುವ ದುಃಖ<br><b>निष्पत्तिः - </b>भावे "घञ्" (३-३-१८)<br><br>

अभिसन्धा
अभिसन्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಸಂಧಿ /ಪ್ರತಿಜ್ಞೆ /ದೃಢವಾಗಿ ಹೇಳುವುದು<br><br>अभिसन्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಟ /ಮೋಸ<br><b>निष्पत्तिः - </b>अभि + सम् + डुधाञ् (धारणे) - "अङ्" (३-३-१०६)<br><br>अभिसन्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ದೇಶ /ಗುರಿ<br><br>

अभिसन्धान
अभिसन्धान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಂಚನೆ /ಮೋಸಪಡಿಸುವುದು<br><b>निष्पत्तिः - </b>अभि + सम् + डुधाञ् (धारणे) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"पराभिसन्धानपरं यद्यप्यस्य विचेष्टितम्"<br><b>उल्लेखाः - </b>रघु० १७-७६<br><br>अभिसन्धान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ದೇಶ /ಗುರಿ<br><br>अभिसन्धान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೃಢವಚನ /ಪ್ರತಿಜ್ಞೆ<br><br>अभिसन्धान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಧಿ ಮಾಡಿಸುವುದು /ಶಾಂತಪಡಿಸುವುದು<br><br>

अभिसन्धाय
अभिसन्धाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ದೇಶ /ಗುರಿ<br><b>निष्पत्तिः - </b>अभि + सम् + डुधाञ् (धारणे) - "घञ्" (३-३-१८)<br><br>अभिसन्धाय<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಧ್ಯೇಯವಿಟ್ಟು /ಉದ್ದೇಶಿಸಿ<br><br>अभिसन्धाय<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಂಚಿಸಿ /ಮೋಸಪಡಿಸಿ<br><b>निष्पत्तिः - </b>अभि + सम् + डुधाञ् (धारणे) - "ल्यप्" (७-१-३७)<br><br>

अभिसन्धि
अभिसन्धि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಜ್ಞೆ /ದೃಢವಚನ<br><br>अभिसन्धि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ದೇಶ /ಗುರಿ<br><b>निष्पत्तिः - </b>अभि + सम् + डुधाञ् (धारणे) - "किः" (३-३-९२)<br><b>प्रयोगाः - </b>"स्वर्गाभिसन्धिसुकृतं वञ्चनामिव मेनिरे"<br><b>उल्लेखाः - </b>कुमा० ६-४७<br><br>अभिसन्धि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಂಬಿಕೆ /ವಿಶ್ವಾಸ<br><br>अभिसन्धि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಬಂಧನೆ /ವಿಶೇಷವಾದ ಒಪ್ಪಂದ<br><b>प्रयोगाः - </b>"अथावश्यमेव माधवसेनो मोचयितव्यः श्रूयतामयमभिसन्धिः"<br><b>उल्लेखाः - </b>माल० १<br><br>अभिसन्धि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಪ್ರಾಯ<br><br>

अभिसम्पात
अभिसम्पात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ<br><b>निष्पत्तिः - </b>अभि + सम् + पत्लृ (गतौ) - "घञ्" (३-३-१२१)<br><b>प्रयोगाः - </b>"जन्यं स्यादभिसम्पातः सम्मर्दो विग्रहस्तथा"<br><b>उल्लेखाः - </b>हला०<br><br>अभिसम्पात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪತನ /ಬೀಳುವುದು<br><br>अभिसम्पात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಪ /ಬೈಗಳು<br><b>निष्पत्तिः - </b>भावे "घञ्" (३-३-१८)<br><br>

अभिसम्बन्ध
अभिसम्बन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣ<br><b>निष्पत्तिः - </b>अभि + सम् + बन्ध (बन्धने) - "घञ्" (३-३-१८)<br><br>

अभिसर
अभिसर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಚರ /ಸೇವಕ<br><b>निष्पत्तिः - </b>अभि + सृ (गतौ) - "अच्" (३-१-१३४)<br><b>प्रयोगाः - </b>"अथ साभिसरं शरैस्तपस्वी स तिरस्कर्तुमुपेन्द्रमभ्यवर्षत्"<br><b>उल्लेखाः - </b>माघ० २०-८<br><br>अभिसर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಹಾಯಕ /ನೆರವಾಗುವವನು<br><b>प्रयोगाः - </b>"मन्मथाभिसरा तदागारमभिसरामि"<br><b>उल्लेखाः - </b>दशकु०<br><br>

अभिसरण
अभिसरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಹೋಗುವುದು /ಆಗಮನ /ಬರುವುದು<br><br>अभिसरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಣಯಿಯು ಸಂಭೋಗಕ್ಕಾಗಿ ಸಂಕೇತ ಸ್ಥಾನಕ್ಕೆ ಹೋಗುವುದು<br><b>निष्पत्तिः - </b>अभि + सृ (गतौ) - "ल्युट्" (३-३-११५)<br><br>

अभिसर्जन
अभिसर्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಾನ /ಧರ್ಮ<br><br>अभिसर्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಧೆ /ಕೊಲ್ಲುವುದು<br><b>निष्पत्तिः - </b>अभि + सृज (विसर्गे) - "ल्युट्" (३-३-११५)<br><br>

अभिसाय
अभिसाय<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಾಯಂಕಾಲಕ್ಕೆ ಅಭಿಮುಖವಾಗಿ<br><b>निष्पत्तिः - </b>अव्ययी० (२-१-१४)<br><b>व्युत्पत्तिः - </b>सायमभि<br><b>प्रयोगाः - </b>"श्रितोदयाद्रेरभिसायमुच्चकैरचूचुरच्चन्द्रमसोऽभिरामताम्"<br><b>उल्लेखाः - </b>माघ० १-१६<br><br>

अभिसार
अभिसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಣಯಿಯು ಸಂಭೋಗಕ್ಕಾಗಿ ಸಂಕೇತ ಸ್ಥಾನಕ್ಕೆ ಹೋಗುವುದು<br><b>निष्पत्तिः - </b>अभि + सृ (गतौ) - भावे "घञ्" (३-३-१८)<br><br>अभिसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಣ /ಮುತ್ತಿಗೆ'<br><b>प्रयोगाः - </b>"श्वोऽभिसारः पुरस्य नः"<br><b>उल्लेखाः - </b>रामा०<br><br>अभिसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲ /ಶಕ್ತಿ<br><br>अभिसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ<br><br>अभिसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಕೇತಸ್ಥಾನ<br><b>निष्पत्तिः - </b>अधि० "घञ्" (३-३-१२१)<br><br>अभिसार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಗಡಿಗ /ಒಡನಾಡಿ<br><b>निष्पत्तिः - </b>अभि + सृ (गतौ) + णिच् - "अच्" (३-१-१३४)<br><br>

अभिसारण
अभिसारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಭೋಗಕ್ಕಾಗಿ ನಾಯಿಕೆಯು ನಾಯಕನನ್ನಾಗಲೀ ನಾಯಕನು ನಾಯಿಕೆಯನ್ನಾಗಲೀ ಸಂಕೇತಸ್ಥಾನಕ್ಕೆ ಬರಮಾಡಿಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>अभि + सृ (गतौ) + णिच् - "ल्युट्" (३-३-११५)<br><br>

अभिसारिका
अभिसारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಭೋಗಕ್ಕಾಗ್ ಸಂಕೇತ ಸ್ಥಾನಕ್ಕೆ ಹೋಗುವ ಅಥವಾ ನಾಯಕನನ್ನು ಬರಮಾಡಿಕೊಳ್ಳುವ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>अभि + सृ (गतौ) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>अभिसरति अभिसारयते वा कान्तं सङ्केतस्थानम्<br><b>प्रयोगाः - </b>"निशासु भास्वत्कलनूपुराणां यः सञ्चरोऽभूदभिसारिकाणाम्"<br><b>उल्लेखाः - </b>रघु० १६-१२<br><br>

अभिसारिन्
अभिसारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಚರ /ಸೇವಕ<br><b>निष्पत्तिः - </b>अभि + सृ (गतौ) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अभिसरति<br><br>अभिसारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಹೋಗುವ /ಅಭಿಮುಖವಾಗಿ ನಡೆಯುವ<br><br>

अभिसारिणी
अभिसारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अभिसारिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अभिसृष्ट
अभिसृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡಲ್ಪಟ್ಟ<br><br>अभिसृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಡಲ್ಪಟ್ಟ /ದಾನ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + सृज (विसर्गे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अभिसृष्टस्तदा काकः प्रतिपेदे स्वमालयम्"<br><b>उल्लेखाः - </b>रामा०<br><br>

अभिहत
अभिहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಡೆಯಲ್ಪಟ್ಟ /ಬಡಿಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + हन (हिंसागत्योः) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"धाराभिरातप इवाभिहतं सरोजम्"<br><b>उल्लेखाः - </b>माल० ५-३<br><br>अभिहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಟಲ್ಪಟ್ಟ /ತಗುಲಿಸಲ್ಪಟ್ಟ<br><br>अभिहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುಣಿಸಲ್ಪಟ್ಟ /ಹೆಚ್ಚಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अन्योन्यहाराभिहतौ हरांशौ"<br><b>उल्लेखाः - </b>लीला०<br><br>

अभिहति
अभिहति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಡೆಯುವುದು /ಬಡಿಯುವುದು<br><br>अभिहति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಣಾಕಾರ /ಹೆಚ್ಚಿಸುವುದು<br><b>निष्पत्तिः - </b>अभि + हन (हिंसागत्योः) - "क्तिन्" (३-३-९४)<br><br>

अभिहरण
अभिहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹ ಮೊದಲಾದುವುಗಳಲ್ಲಿ ಕೊಡುವ ಬಳುವಳಿ /ಬಹುಮಾನ /ಉಡುಗೊರೆ<br><br>अभिहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ತರುವುದು<br><b>निष्पत्तिः - </b>अभि + हृञ् (हरणे) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"व्यादिदेश गणशोऽथ पार्श्वगान् कार्मुकाभिहरणाय मैथिलः"<br><b>उल्लेखाः - </b>रघु० ११-४३<br><br>

अभिहार
अभिहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಣ /ಮುತ್ತಿಗೆ<br><br>अभिहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೌರ್ಯ /ಎದುರಿಗೆ ಕದಿಯುವುದು<br><br>अभिहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಟ್ಟುಗೂಡಿಸುವುದು /ಬೆರಸುವುದು<br><b>निष्पत्तिः - </b>अभि + हृञ् (हरणे) - "घञ्" (३-३-१८)<br><b>विस्तारः - </b>"अभिहारोऽभियोगे च चीर्ये सन्नहनेऽपि च" - अम० ।<br><br>अभिहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ಯಮ /ಪ್ರಯತ್ನ<br><b>विस्तारः - </b>"अभिहारः सन्नहने चौरिकोद्यमयोरपि" - हेम० ।<br><br>

अभिहित
अभिहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + डुधाञ् (धारणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"एषा तेऽभिहिता साङ्ख्ये बुद्धिर्योगेत्विमां शृणु"<br><b>उल्लेखाः - </b>गीता० २-३९<br><br>अभिहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿಧಾವೃತ್ತಿಯಿಂದ ಬೋಧಿಸಲ್ಪಟ್ಟ<br><br>

अभिहितान्वय
अभिहितान्वय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಧಾವೃತ್ತಿಯಿಂದ ತಿಳಿಸಲ್ಪಟ್ಟ ಪದಾರ್ಥಗಳ ಸಂಬಂಧ /ಪದಗಳಿಗೆ ಆಯಾ ಪದಾರ್ಥಗಳಲ್ಲಿ ಮಾತ್ರ ಶಕ್ತಿಯಿರುವುದರಿಂದ ಪ್ರತ್ಯೇಕ ಪದಗಳಿಂದ ಬೋಧಿತವಾದ ಅರ್ಥಗಳನ್ನು ತಾತ್ಪರ್ಯವೆಂಬ ವೃತ್ತಿಯಿಂದ ಸಂಬಂಧಪಡಿಸಿ ಹೇಳುವುದು<br><b>व्युत्पत्तिः - </b>अभिहितानां अभिधावृत्त्या बोधितानां पदार्थानां परस्परमन्वयः<br><br>

अभिहूति
अभिहूति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ನಿಂತು ಕೂಗುವುದು /ಅಭಿಮುಖವಾಗಿ ಕರೆಯುವುದು<br><b>निष्पत्तिः - </b>अभि + ह्वेञ् (स्पर्धायां शब्दे च) - "क्तिन्" (३-३-९४)<br><br>

अभी
अभी<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯವಿಲದ /ಹೆದರಿಕೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति भीर्यस्य<br><b>प्रयोगाः - </b>"व्याघ्रानभीरभिमुखोत्पतितान् गुहाभ्यः"<br><b>उल्लेखाः - </b>रघु० ९-६३<br><br>

अभीक
अभीक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕವಿ<br><br>अभीक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜಮಾನ<br><br>अभीक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ರೂರ<br><br>अभीक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯವಿಲ್ಲದವನು /ಹೆದರದವನು<br><b>व्युत्पत्तिः - </b>नास्ति भीर्यस्य<br><b>प्रयोगाः - </b>"अभीकमतिकेनेद्धे भीता नन्दस्य नाशने । कनत्सकामसेनाके मन्दकामकमस्यति ॥"<br><b>उल्लेखाः - </b>माघ० १९-७२<br><br>अभीक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮುಕ /ಕಾಮಾತುರವುಳ್ಳವನು<br><b>निष्पत्तिः - </b>अभि - "कन्" (५-२-७४)<br><b>व्युत्पत्तिः - </b>अभिकामयते<br><b>प्रयोगाः - </b>"मेदस्विनः सरभसोपगतानभीकान्"<br><b>उल्लेखाः - </b>माघ० ५-६४<br><br>अभीक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಸುಕ /ಉತ್ಸಾಹವುಳ್ಳವನು<br><b>विस्तारः - </b>"अभीकः कामुके क्रूरे निर्भये त्रिषु ना कवौ" - मेदि० ।<br><br>

अभीक्ष्ण्य
अभीक्ष्ण्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರಂತರವಾದ /ಎಡೆಬಿಡದ<br><br>अभीक्ष्ण्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಶಯವಾದ /ಹೆಚ್ಚಾದ<br><br>अभीक्ष्ण्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುನಃ ಪುನಃ ಸಂಭವಿಸುವ /ಬಾರಿ ಬಾರಿಗೂ ಉಂಟಾಗುವ<br><b>निष्पत्तिः - </b>पृषो० ।<br><b>व्युत्पत्तिः - </b>अभिगतः क्षणम्<br><b>प्रयोगाः - </b>"क्षते प्रहारा निपतन्त्यभीक्ष्णम्"<br><b>उल्लेखाः - </b>पञ्चतं० २-१७८<br><br>

अभीक्ष्ण्यम्
अभीक्ष्ण्यम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅತಿಶಯವಾಗಿ /ಹೆಚ್ಚಾಗಿ<br><b>निष्पत्तिः - </b>अभि + क्ष्णु (तेजने) - "डमुः" बाहु० ।<br><b>व्युत्पत्तिः - </b>अभिक्ष्णैति<br><b>प्रयोगाः - </b>"अभीक्ष्णमुष्णैरपि तस्य सोष्मणः"<br><b>उल्लेखाः - </b>माघ० १-६५<br><br>अभीक्ष्ण्यम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿರಂತರವಾಗಿ /ಎಡೆಬಿಡದೆ<br><b>प्रयोगाः - </b>"उदीर्णरागप्रतिरोधकं जनैरभीक्ष्णमक्षुण्णतयातिदुर्गमम्"<br><b>उल्लेखाः - </b>माघ० १-३२<br><br>अभीक्ष्ण्यम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪುನಃ ಪುನಃ /ಮತ್ತೆ ಮತ್ತೆ<br><br>अभीक्ष्ण्यम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಶೀಘ್ರವಾಗಿ /ಜಾಗ್ರತೆಯಾಗಿ<br><b>विस्तारः - </b>"अभीक्ष्णं शीघ्रप्रकर्षयोः" - हेम० ।<br><br>

अभीत
अभीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಬಂದ /ಅಭಿಮುಖವಾಗಿ ಬಂದ<br><b>निष्पत्तिः - </b>अभि + इण् (गतौ) - "क्तः" (३-४-७२)<br><br>अभीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆದರದ /ಭಯಪಡದ<br><b>व्युत्पत्तिः - </b>न भीतः<br><br>

अभीति
अभीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭಯವಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>न० त०<br><br>अभीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಯಮುದ್ರೆ<br><br>अभीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಹೋಗುವುದು<br><br>अभीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪ /ಹತ್ತಿರ<br><b>निष्पत्तिः - </b>अभि + इण् (गतौ) - "क्तिन्" (३-३-९४)<br><br>अभीति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯವಿಲ್ಲದ /ಹೆದರಿಕೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न भीतिर्यस्य<br><br>

अभीप्सित
अभीप्सित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆ /ಆಸೆ<br><b>निष्पत्तिः - </b>अभि + आप्लृ (व्याप्तौ) + सन् - "क्तः" (३-३-११४)<br><br>अभीप्सित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಟ್ಟ /ಇಷ್ಟವಾದ<br><b>निष्पत्तिः - </b>अभि + आप्लृ (व्याप्तौ) + सन् - "क्तः" (३-२-१०२)<br><br>

अभीप्सु
अभीप्सु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಸೆಪಡುವ /ಪಡೆಯಲು ಅಪೇಕ್ಷೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>अभि + आप्लृ (व्याप्तौ) + सन् - "उः" (३-२-१६८)<br><b>प्रयोगाः - </b>"गृहानुपैतुं प्रणयादभीप्सवो भवन्ति नापुण्यकृतां मनीषिणः"<br><b>उल्लेखाः - </b>माघ० १-१४<br><br>

अभीर
अभीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೋಪಾಲಕ /ಗೊಲ್ಲ<br><b>निष्पत्तिः - </b>अभि + ईर (गतौ कम्पने च) + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अभि ईरयति<br><br>

अभीरी
अभीरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೋಪಾಲಕಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६३)<br><br>

अभीरु
अभीरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೈರವ<br><br>अभीरु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶತಾವರಿ ಗಿಡ<br><br>अभीरु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧಭೂಮಿ<br><b>व्युत्पत्तिः - </b>न भीरुः<br><br>अभीरु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯವಿಲ್ಲದ /ಹೆದರಿಕೆಯಿಲ್ಲದ<br><br>

अभीरुपत्री
अभीरुपत्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶತಾವರಿ ಗಿಡ<br><br>

अभीलाप
अभीलाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>अभिलाप ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अभि + लप (व्यक्तायां वाचि) - "घञ्" (३-३-१८) । दीर्घः (६-३-१२२)<br><br>

अभीषङ्ग
अभीषङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>अभिषङ्ग ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अभि + षङ्ग (सङ्गे) - "घञ्" (३-३-१८) । दीर्घः (६-३-१२२)<br><br>

अभीषु
अभीषु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಣ /ರಶ್ಮಿ<br><b>निष्पत्तिः - </b>अभि + इष (गतौ) - "उः" (उ० १-१३)<br><b>प्रयोगाः - </b>"प्रफुल्लतापिच्छनिभैरभीषुभिः"<br><b>उल्लेखाः - </b>माघ० १-२२<br><br>अभीषु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಹಗ್ಗ /ಲಗಾಮು<br><b>विस्तारः - </b>"अभीषुः प्रग्रहरोचिषोः" - हेम० ।<br><br>अभीषु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುರಾಗ /ಪ್ರೀತಿ<br><br>

अभीष्ट
अभीष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟವಾದ /ಅಪೇಕ್ಷಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + इषु (इच्छायाम्) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अभीष्टसिद्धेरधिदेवतेयं यद्वा सवित्रीति यथार्थमूचे"<br><b>उल्लेखाः - </b>याद० १३-९७<br><br>अभीष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಿಯವಾದ /ಪ್ರೀತಿಪಾತ್ರವಾದ<br><b>प्रयोगाः - </b>"अभीष्टमासाद्य चिराय काले समुद्धृताशं कमनी चकाशे"<br><b>उल्लेखाः - </b>माघ० ६-७४<br><br>अभीष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಂದರವಾದ /ಮನೋಹರವಾದ<br><br>

अभुक्त
अभुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿನ್ನಲ್ಪಡದ<br><br>अभुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಭವಿಸಲ್ಪಡದ<br><b>निष्पत्तिः - </b>भुज (पालनाभ्यवहरायोः) - कर्म० "क्तः" (३-२-१०२) । न० त० ।<br><b>प्रयोगाः - </b>"नाभुक्तं क्षीयते कर्म कल्पकोटिशतैरपि"<br><br>अभुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿನ್ನದಿರುವ /ಊಟ ಮಾಡದಿರುವ<br><b>निष्पत्तिः - </b>भुज - भावे "क्तः" (३-३-११४) । "अच्" (५-२-१२७) । न० त० ।<br><b>व्युत्पत्तिः - </b>भुक्तं भोजनमस्यास्ति<br><b>प्रयोगाः - </b>"अभुक्तस्य दिवा निद्रा पाषाणमपि जीर्यति"<br><br>अभुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಭವಿಸದಿರುವ<br><br>

अभुक्तमूल
अभुक्तमूल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠಾನಕ್ಷತ್ರದ ಕೊನೆಯ ಎರಡು ಘಳಿಗೆ ಮತ್ತು ಮೂಲದ ಮೊದಲನೆಯ ಎರಡು ಘಳಿಗೆ ಈ ಕಾಲ<br><b>प्रयोगाः - </b>"ज्येष्ठान्ते घटिके द्वे च मूलाद्यघटिकाद्वयम् । अभुक्तमूलमित्याहुः जातं तत्र विवर्जयेत् ॥"<br><br>

अभूत
अभूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಿದ್ಯಮಾನ /ಇಲ್ಲದಿರುವ<br><b>व्युत्पत्तिः - </b>न भूतः<br><b>प्रयोगाः - </b>"स्तुवन्त्यश्रान्तास्याः क्षितिपतिमभूतैरपि गुणैः"<br><b>उल्लेखाः - </b>मुद्रा० ३-१६<br><br>अभूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಿಥ್ಯೆಯಾದ /ನಿಜವಲ್ಲದ<br><b>प्रयोगाः - </b>"अभूतमासज्य विरुद्धमीहितम्"<br><b>उल्लेखाः - </b>किरा० १४-१९<br><br>अभूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂದಿನಲ್ಲದ<br><br>

अभूततद्भाव
अभूततद्भाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪದಾರ್ಥವು ಹಿಂದಿನ ರೂಪವನ್ನು ಬಿಟ್ಟು ಹೊಸ ರೂಪವನ್ನು ತಾಳುವುದು<br><b>व्युत्पत्तिः - </b>अभूतस्य प्रकृतिरूपेण आविर्भूतस्य तेन रूपेण भावः तद्रूपप्राप्तिः<br><br>

अभूतपूर्व
अभूतपूर्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂದೆ ಇಲ್ಲದಿದ್ದ /ಅಪೂರ್ವವಾದ /ಹೊಸದಾದ /ನವೀನವಾದ<br><b>व्युत्पत्तिः - </b>न भूतपूर्वः<br><b>प्रयोगाः - </b>"भेजेऽभितः पातुकसिद्धसिन्धोरभूतपूर्वां श्रियमम्बुराशेः"<br><b>उल्लेखाः - </b>माघ० ३-३<br><br>

अभूताभिनिवेश
अभूताभिनिवेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಸತ್ಯವಾದುದರಲ್ಲಿ ಸತ್ಯವೆಂಬ ಅಭಿಮಾನ /ನಿಜವಲ್ಲದುದರಲ್ಲಿ ನಿಜವೆಂಬ ಭಾವನೆ<br><b>व्युत्पत्तिः - </b>अभूते अभिनिवेशः<br><br>

अभूताहरण
अभूताहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಟದಿಂದ ಕೂಡಿದ ಮಾತು /ಅಸತ್ಯದ ಮಾತು /ಮೋಸದ ಮಾತು<br><b>प्रयोगाः - </b>"अभूताहरणं मार्गो रूपोदाहरणक्रमाः" । "तत्र व्याजाश्रयं वाक्यमभूताहरणं मतम्" ।<br><b>उल्लेखाः - </b>सा० द० ६-९४, सा० द० ६-९५<br><br>

अभूति
अभूति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಾವ /ಇಲ್ಲದಿರುವಿಕೆ<br><br>अभूति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಾರಿದ್ರ್ಯ /ಬಡತನ<br><br>अभूति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಐಶ್ವರ್ಯವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न भूतिर्यस्य<br><br>

अभूमि
अभूमि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯವಿಲ್ಲದಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"अभूदभूमिः प्रतिपक्षजन्मनां भियां तनूजस्तपनद्युतिर्दितेः"<br><b>उल्लेखाः - </b>माघ० १-४२<br><br>अभूमि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಶಸ್ತವಲ್ಲದ ಭೂಮಿ<br><br>अभूमि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೂಮಿಯಿಲ್ಲದ<br><br>अभूमि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಷಯವಿಲ್ಲದ<br><br>

अभूमिज
अभूमिज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೂಮಿಯಲ್ಲಿ ಹುಟ್ಟದಿರುವ /ಆಕಾಶದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>व्युत्पत्तिः - </b>न भूमौ जायते<br><br>अभूमिज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ರಶಸ್ತವಾದ ಭೂಮಿಯಲ್ಲಿ ಬೆಳೆದ /ಕೆಟ್ಟ ಭೂಮಿಯಲ್ಲಿ ಬೆಳೆದ ಧಾನ್ಯ<br><b>प्रयोगाः - </b>"अभूमिजं नवञ्चापि न धान्यं गुणवत् स्मृतम्"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

अभेद
अभेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಐಕ್ಯ /ಭೇದವಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>अभावे न० त० ।<br><b>व्युत्पत्तिः - </b>न भेदः<br><br>अभेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪ ಸಂಬಂಧ /ಬಿಟ್ಟಿಲ್ಲದಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"इच्छतां सह वधूभिरभेदं यामिनीविरहिणां विहगानाम्"<br><b>उल्लेखाः - </b>किरा० ९-१३<br><br>अभेद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ /ಏಕರೂಪವಾದ<br><br>

अभेद्य
अभेद्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಜ್ರ<br><br>अभेद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೇದಿಸಲು ಅಶಕ್ಯವಾದ /ಒಡೆಯಲು ಸಾಧ್ಯವಿಲ್ಲದ<br><b>निष्पत्तिः - </b>भिदिर् (विदारणे) - "ण्यत्" (३-१-१२४)<br><b>व्युत्पत्तिः - </b>न भेत्तुं शक्यम्<br><b>प्रयोगाः - </b>"तारास्मि वज्रहृदया विशिखैरभेद्या धन्वी कथं भवसि राघव मामविद्ध्वा"<br><b>उल्लेखाः - </b>चं० रा०<br><br>

अभोजन
अभोजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಊಟ ಮಾಡದಿರುವಿಕೆ /ಉಪವಾಸ<br><b>प्रयोगाः - </b>"तृणकाष्ठद्रुमाणां च शुष्कान्नस्य गुडस्य च । चेलचर्मामिषाणां च त्रिरात्रं स्यादभोजनम् ॥"<br><b>उल्लेखाः - </b>मनु० ११-१६६<br><br>अभोजन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಟವಿಲ್ಲದ /ಭೋಜನವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न भोजनं यस्य<br><br>

अभोज्य
अभोज्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಟಮಾಡಲು ಅರ್ಹವಲ್ಲದ /ಭುಜಿಸಲು ನಿಷಿದ್ಧವಾದ /ಅಶುದ್ಧವಾದ ಆಹಾರ<br><b>व्युत्पत्तिः - </b>न भोक्तुमर्हम्<br><b>प्रयोगाः - </b>"अभोज्यमन्नं नात्तव्यमात्मनः शुद्धिमिच्छता"<br><b>उल्लेखाः - </b>मनु० ११-१६०<br><br>

अभौतिक
अभौतिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಂಚಮಹಾಭೂತಗಳಿಂದ ಹುಟ್ಟದಿರುವ<br><br>

अभौम
अभौम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೂಮಿಯಲ್ಲಿ ಹುಟ್ಟದಿರುವ /ಆಕಾಶದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>न० त० ।<br><b>व्युत्पत्तिः - </b>भूमौ भवम्<br><b>प्रयोगाः - </b>"अभौमसम्भाव्यविभूतियोग्यम्"<br><b>उल्लेखाः - </b>याद० १८-१२४<br><br>

अभ्यक्त
अभ्यक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೈಲಾಭ್ಯಂಗವನ್ನು ಮಾಡಿದ /ಎಣ್ಣೆ ಬಳಿದುಕೊಂಡ<br><b>निष्पत्तिः - </b>अभि + अञ्चू (व्यक्त्यादौ) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अभ्यक्तमिव स्नातः शुचिरशुचमिव प्रबुद्ध इव सुप्तम्"<br><b>उल्लेखाः - </b>शाकु० ५-११<br><br>अभ्यक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಬಳಿಯಲ್ಪಟ್ಟ /ಸುತ್ತಲೂ ಲೇಪನ ಮಾಡಲ್ಪಟ್ಟ<br><br>

अभ्यग्र
अभ्यग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನವೀನವಾದ /ಹೊಸದಾದ<br><br>अभ्यग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದ /ಹತ್ತಿರದ<br><b>व्युत्पत्तिः - </b>अभिमुखमग्रमस्य<br><b>विस्तारः - </b>"उपकण्ठान्तिकाभ्यर्णाभ्यग्राः" - अम० ।<br><br>

अभ्यङ्ग
अभ्यङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೈಲಾಭ್ಯಂಗ /ಮೈಗೆ ಎಣ್ಣೆ ಹಚ್ಚುವುದು<br><b>निष्पत्तिः - </b>अभि + अञ्चू (व्यक्त्यादौ) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"निर्नाभि कौशेयमुपात्तबाणमभ्यङ्गनेपथ्यमलञ्चकार"<br><b>उल्लेखाः - </b>कुमा० ७-७<br><br>अभ्यङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಳಿಯುವುದು /ಲೇಪನೆ ಮಾಡುವುದು<br><br>अभ्यङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಲಾಮು /ಲೇಪನೆ ಮಾಡುವ ತೈಲ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>कर० "घञ्" (३-३-१२१)<br><br>

अभ्यञ्जन
अभ्यञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೈಲ ಮೊದಲಾದುವನ್ನು ಐಗೆ ಲೇಪನ ಮಾಡುವುದು<br><br>अभ्यञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣಿಗೆ ಅಂಜನ ಹಾಕುವುದು<br><br>अभ्यञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣಿಗೆ ಕಾಡಿಗೆ ಹಚ್ಚುವುದು<br><br>अभ्यञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಳಿಯುವುದು /ಲೇಪನೆ ಮಾಡುವುದು<br><br>अभ्यञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲೇಪನ ಮಾಡುವ ತೈಲ<br><br>अभ्यञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಲಾಮು /ಲೇಪನೆ ಮಾಡುವ ತೈಲ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>अभि + अञ्चू (व्यक्त्यादौ) - भावे कर० वा "ल्युट्" (३-३-११५,११७)<br><b>प्रयोगाः - </b>"अभ्यञ्जनं स्नापनं च गात्रोत्सादनमेव च । गुरुपत्न्या च कार्याणि केशानां च प्रसाधनम् ॥"<br><b>उल्लेखाः - </b>मनु० २-२११<br><br>

अभ्यतीत
अभ्यतीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೃತನಾದ /ಮರಣ ಹೊಂದಿದ<br><b>प्रयोगाः - </b>"गुरुषु त्वभ्यतीतेषु विना वा तैर्गृहे वसन्"<br><b>उल्लेखाः - </b>मनु० ४-२५२<br><br>

अभ्यधिक
अभ्यधिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಹೆಚ್ಚಾದ /ಅಚಶ್ಯಕತೆಗಿಂತಲೂ ಅಧಿಕವಾದ<br><b>व्युत्पत्तिः - </b>अभितोऽधिकः<br><b>प्रयोगाः - </b>"सद्यः प्रसूतप्रियापीतादभ्यधिकम्"<br><b>उल्लेखाः - </b>उ० रा० ४-१<br><br>अभ्यधिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸರ್ವಶ್ರೇಷ್ಠವಾದ /ಬಹಳ ಉತ್ಕೃಷ್ಟವಾದ<br><b>प्रयोगाः - </b>"न त्वत्समोऽस्त्यभ्यधिकः कुतोऽन्यः"<br><b>उल्लेखाः - </b>गीता० ११-४३<br><br>अभ्यधिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಾಧಾರಣವಾದ /ಲೋಕೋತ್ತರವಾದ<br><br>अभ्यधिक<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಅಧಿಕವಾಗಿ /ಹೆಚ್ಚಾಗಿ<br><br>

अभ्यध्व
अभ्यध्व<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ದಾರಿಯ ಎದುರಿಗೆ /ದಾರಿಯ ಕಡೆಗೆ<br><b>निष्पत्तिः - </b>अभि + अध्वन् - "टच्" (५-४-२०८) । नलोपः (६-४-१४४)<br><b>व्युत्पत्तिः - </b>अध्वनोऽभिमुख्यम्<br><br>

अभ्यनुज्ञा
अभ्यनुज्ञा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಮತಿ /ಅಪ್ಪಣೆ<br><b>निष्पत्तिः - </b>अभि + अनु + ज्ञा (अवबोधने) - "अङ्" (३-३-१०६)<br><b>प्रयोगाः - </b>"अथानुरूपाभिनिवेशतोषिणा कृताभ्यनुज्ञा गुरुणा गरीयसा"<br><b>उल्लेखाः - </b>कुमा० ५-७<br><br>अभ्यनुज्ञा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಜ್ಞೆ /ಅಪ್ಪಣೆ<br><br>

अभ्यनुज्ञात
अभ्यनुज्ञात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಮತಿಸಲ್ಪಟ್ಟ /ಒಪ್ಪಿಗೆ ಕೊಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + अनु + ज्ञा (अवबोधने) - "क्तः" (३-२-१०२)<br><br>अभ्यनुज्ञात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆ ಮಾಡಲ್ಪಟ್ಟ<br><br>

अभ्यनुज्ञान
अभ्यनुज्ञान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಮತಿ /ಅಪ್ಪಣೆ<br><br>अभ्यनुज्ञान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಜ್ಞೆ /ಅಪ್ಪಣೆ<br><b>निष्पत्तिः - </b>अभि + अनु + ज्ञा (अवबोधने) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"भरद्वाजाभ्यनुज्ञानात् चित्रकूटस्य दर्शनम्"<br><b>उल्लेखाः - </b>रामा०<br><br>

अभ्यन्तर
अभ्यन्तर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಧ್ಯಭಾಗ /ಅಂತರಾಳ<br><b>व्युत्पत्तिः - </b>अभिगतमन्तरम्<br><b>प्रयोगाः - </b>"निधानगर्भामिव सागराम्बरां शमीमिवाभ्यन्तरलीनपावकाम्"<br><b>उल्लेखाः - </b>रघु० ३-९<br><br>अभ्यन्तर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಕಾಶ /ಮಧ್ಯಕಾಲ<br><br>अभ्यन्तर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ತ /ಮನಸ್ಸು<br><br>अभ्यन्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಧ್ಯದಲ್ಲಿರುವ /ಒಳಭಾಗದಲ್ಲಿರುವ<br><b>प्रयोगाः - </b>"अतः सोऽभ्यन्तरान्नित्यान् षट्पूर्वमजयद्रिपून्"<br><b>उल्लेखाः - </b>रघु० १७-४५<br><br>अभ्यन्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಿಚಯ ಹೊಂದಿದ /ಪ್ರಾವೀಣ್ಯ ಪಡೆದ /ನೈಪುಣ್ಯ ಹೊಂದಿದ<br><b>प्रयोगाः - </b>"सङ्गीतकेऽब्यन्तरे स्वः"<br><b>उल्लेखाः - </b>माल० ५<br><br>अभ्यन्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿರುವ /ಹತ್ತಿರದಲ್ಲಿರುವ<br><b>प्रयोगाः - </b>"त्यक्ताश्चाभ्यन्तरा येन"<br><b>उल्लेखाः - </b>पञ्चतं० १-२५९<br><br>अभ्यन्तर<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಳಭಾಗದಲ್ಲಿ /ಮಧ್ಯಭಾಗದಲ್ಲಿ<br><br>अभ्यन्तर<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮಧ್ಯಕಾಲದಲ್ಲಿ<br><br>

अभ्यन्तराराम
अभ्यन्तराराम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯೋಗಿ /ಆತ್ಮರಾಮ /ಪರಮಾತ್ಮ ಧ್ಯಾನಾಸಕ್ತ<br><b>व्युत्पत्तिः - </b>अभ्यन्तरे आरामः आरमणं यस्य<br><br>

अभ्यमन
अभ्यमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ನುಗ್ಗುವುದು /ಮುತ್ತಿಗೆ /ಮೇಲೆ ಬೀಳುವುದು<br><b>निष्पत्तिः - </b>अभि + अम (गत्यादिषु) - "ल्युट्" (३-३-११५)<br><br>अभ्यमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಮುಖವಾಗಿ ಹೋಗುವುದು<br><br>अभ्यमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗ /ವ್ಯಾಧಿ<br><br>

अभ्यमित
अभ्यमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಧಿಗ್ರಸ್ತ /ರೋಗಿ<br><b>निष्पत्तिः - </b>अभि + अम (रोगे) - "क्तः" (३-२-१०२)<br><b>विस्तारः - </b>"आतुरोऽभ्यमितोऽभ्यन्तः" - अम० ।<br><br>अभ्यमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಾಯಗೊಂಡವನು /ನೋಯಾಳಿ<br><br>

अभ्यमित्र
अभ्यमित्र<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಶತ್ರುವಿಗೆ ಎದುರಾಗಿ<br><b>निष्पत्तिः - </b>अव्ययी० (२-१-१४)<br><b>व्युत्पत्तिः - </b>अमित्रानभि<br><b>प्रयोगाः - </b>"हताहतेत्युद्धतभीमघोषैः समुज्झिता योद्धृभिरभ्यमित्रम्"<br><b>उल्लेखाः - </b>किरा० १६-५<br><br>

अभ्यमित्रीण
अभ्यमित्रीण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರುವಿನ ಕಡೆಗೆ ಧೈರ್ಯದಿಂದ ದಂಡೆತ್ತಿ ನುಗ್ಗುವವನು /ವೀರನಾದ ಯೋಧ<br><b>निष्पत्तिः - </b>अभ्यमित्र - "खः" (५-२-१७)<br><b>व्युत्पत्तिः - </b>अभ्यमित्रमलं गामी<br><b>प्रयोगाः - </b>"उद्योगमभ्यमित्रीणो यथेष्टं त्वं च सन्तनु"<br><b>उल्लेखाः - </b>भट्टि० ५-४७<br><br>

अभ्यमित्रीय
अभ्यमित्रीय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರುವಿನ ಕಡೆಗೆ ಧೈರ್ಯದಿಂದ ದಂಡೆತ್ತಿ ನುಗ್ಗುವವನು /ವೀರನಾದ ಯೋಧ<br><b>निष्पत्तिः - </b>अभ्यमित्र - "छः" (५-२-१७)<br><br>

अभ्यमित्र्य
अभ्यमित्र्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರುವಿನ ಕಡೆಗೆ ಧೈರ್ಯದಿಂದ ದಂಡೆತ್ತಿ ನುಗ್ಗುವವನು /ವೀರನಾದ ಯೋಧ<br><b>निष्पत्तिः - </b>"यत्" (५-२-१७)<br><b>प्रयोगाः - </b>"मारीचोऽनुनयंस्त्रासादभ्यमित्र्यो भवामि ते"<br><b>उल्लेखाः - </b>भट्टि० ५-४६<br><br>

अभ्यर्चन
अभ्यर्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಗ್ರಹ ಸಂಪಾದನೆಗಾಗಿ ಮಾಡುವ ಪೂಜೆ /ಉಪಾಸನೆ<br><b>निष्पत्तिः - </b>अभि + अर्च (पूजायाम्) - "ल्युट्" (३-३-११५)<br><br>

अभ्यर्चना
अभ्यर्चना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಗ್ರಹ ಸಂಪಾದನೆಗಾಗಿ ಮಾಡುವ ಪೂಜೆ /ಉಪಾಸನೆ<br><b>निष्पत्तिः - </b>अभि + अर्च (पूजायाम्) + णिच् - "युच्" (३-३-१०७)<br><b>प्रयोगाः - </b>"गलद्भिरन्या वलयप्रसूनैरभ्यर्चनामातनुतेव शौरेः"<br><b>उल्लेखाः - </b>याद० १३-५९<br><br>

अभ्यर्चा
अभ्यर्चा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ<br><b>निष्पत्तिः - </b>अभि + अर्च (पूजायाम्) - भावे "अः" (३-३-१-३)<br><br>

अभ्यर्चित
अभ्यर्चित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + अर्च (पूजायाम्) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अभ्यर्चितानां त्रिदशातिथीनाम्"<br><b>उल्लेखाः - </b>याद० १८-८२<br><br>

अभ्यर्च्य
अभ्यर्च्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜೆಗೆ ಯೋಗ್ಯನಾದ /ಪೂಜಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अभि + अर्च (पूजायाम्) - "ण्यत्" (३-१-१२४)<br><br>अभ्यर्च्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಿ /ಆರಾಧಿಸಿ<br><b>प्रयोगाः - </b>"अभ्यर्च्य कस्मैचिदुपाश्रिताय वितीर्य विप्राय विलोचने स्वे"<br><b>उल्लेखाः - </b>चं० रा०<br><br>

अभ्यर्ण
अभ्यर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪ /ಹತ್ತಿರ<br><b>प्रयोगाः - </b>"अभ्यर्णेऽम्भः पतनसमये पर्णलीभूतसानुम्"<br><b>उल्लेखाः - </b>भट्टि० ६-१४३<br><br>अभ्यर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿರುವ /ಹತ್ತಿರದಲ್ಲಿರುವ<br><b>प्रयोगाः - </b>"तपति प्रावृषि नितरामभ्यर्णजलागमो दिवसः"<br><b>उल्लेखाः - </b>रत्ना० ३-१०<br><br>

अभ्यर्थन
अभ्यर्थन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಡಿಕೆ /ಪ್ರಾರ್ಥನೆ /ಕೋರಿಕೆ<br><b>निष्पत्तिः - </b>अभि + अर्थ (याचने) + णिच् - "ल्युट्" (३-३-११५)<br><br>

अभ्यर्थना
अभ्यर्थना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಡಿಕೆ /ಪ್ರಾರ್ಥನೆ /ಕೋರಿಕೆ<br><b>निष्पत्तिः - </b>अभि + अर्थ (याचने) + णिच् - "युच्" (३-३-१०७)<br><b>प्रयोगाः - </b>"अभ्यर्थनाभङ्गभयेन साधुर्माव्यस्थ्यमिष्टेऽप्यवलम्बतेऽर्थे"<br><b>उल्लेखाः - </b>कुमा० १-५२<br><br>

अभ्यर्थनीय
अभ्यर्थनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಪ್ರಾರ್ಥಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अभि + अर्थ (याचने) - कर्म० "अनीयर्" (३-१-९६)<br><br>

अभ्यर्थिन्
अभ्यर्थिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾಚಿಸುವ /ಬೇಡುವ<br><b>निष्पत्तिः - </b>अभि + अर्थ (याचने) - "णिनिः" (३-२-७८)<br><br>

अभ्यर्थिनी
अभ्यर्थिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಚಿಸುವ /ಬೇಡುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अभ्यर्थ्य
अभ्यर्थ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾಚಿಸಲ್ಪಡುವ /ಪ್ರಾರ್ಥಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अभि + अर्थ (याचने) + णिच् - "यत्" (३-१-९७)<br><b>प्रयोगाः - </b>"कार्येषु चैककार्यत्वादभ्यर्थ्योऽस्मि न वज्रिणा"<br><b>उल्लेखाः - </b>रघु० १०-४०<br><br>अभ्यर्थ्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಾರ್ಥಿಸಿ /ಯಾಚನೆ ಮಾಡಿ<br><b>निष्पत्तिः - </b>अभि + अर्थ (याचने) - "ल्यप्" (७-१-३७)<br><br>

अभ्यर्थ्यमान
अभ्यर्थ्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾಚಿಸಲ್ಪಡುವ /ಪ್ರಾರ್ಥಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अभि + अर्थ (याचने) + णिच् - "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"अभ्यर्थ्यमाना विबुधैः समग्रैः प्रह्वैः सुरेन्द्रप्रमुखैरुपेत्य"<br><b>उल्लेखाः - </b>कुमा० ११-१<br><br>

अभ्यर्दन
अभ्यर्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳವಾಗಿ ಪೀಡಿಸುವುದು<br><b>निष्पत्तिः - </b>अभि + अर्द (हिंसायाम्) + णिच् - "ल्युट्" (३-३-११५)<br><br>अभ्यर्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಯಾಚಿಸುವುದು<br><b>निष्पत्तिः - </b>अभि + अर्द (गतौ याचने च) - "ल्युट्" (३-३-११५)<br><br>

अभ्यर्दित
अभ्यर्दित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಬೇಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + अर्द (याचने) - "क्तः" (३-२-१०२)<br><br>अभ्यर्दित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಬಹಳವಾಗಿ ಪೀಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + अर्ह (हिंसायाम्) - "क्तः" (३-२-१०२)<br><br>

अभ्यर्हण
अभ्यर्हण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ /ಸತ್ಕಾರ<br><b>निष्पत्तिः - </b>अभि + अर्ह (पूजायाम्) - "ल्युट्" (३-३-११५)<br><br>अभ्यर्हण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೌರವ /ಮರ್ಯಾದೆ<br><br>

अभ्यर्हणा
अभ्यर्हणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ /ಸತ್ಕಾರ<br><br>अभ्यर्हणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೌರವ /ಮರ್ಯಾದೆ<br><b>निष्पत्तिः - </b>अभि + अर्ह (पूजायाम्) + णिच् - "युच्" (३-३-१०७)<br><br>

अभ्यर्हणीय
अभ्यर्हणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಡುವ /ಪೂಜೆಗೆ ಅರ್ಹನಾದ<br><br>अभ्यर्हणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೌರವಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अभि + अर्ह (पूजायाम्) - "अनीयर्" (३-१-९६)<br><br>

अभ्यर्हित
अभ्यर्हित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಟ್ಟ /ಸತ್ಕರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + अर्ह (पूजायाम्) - "क्तः" (३-२-१०२)<br><br>अभ्यर्हित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ /ಉಚಿತವಾದ<br><b>प्रयोगाः - </b>"अभ्यर्हिता बन्धुषु तुल्यरूपा वृत्तुर्विशेषेण तपोधनानाम्"<br><b>उल्लेखाः - </b>किरा० ३-११<br><br>

अभ्यवकर्षण
अभ्यवकर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊರಕ್ಕೆ ಎಳೆಯುವುದು<br><b>निष्पत्तिः - </b>अभि + अव + कृष (विलेखने) - "ल्युट्" (३-३-११५)<br><br>

अभ्यवस्कन्द
अभ्यवस्कन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರುವಿನ ಆಕ್ರಮಣ /ಮುತ್ತಿಗೆ<br><b>विस्तारः - </b>"प्रपातस्त्वभ्यवस्कन्दो घाट्याभ्यासादनं च सः" - अभि० चि० ।<br><br>अभ्यवस्कन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರುವನ್ನು ಶಕ್ತಿಗುಂದಿದವನನ್ನಾಗಿ ಮಾಡಲು ಹೊಡೆಯುವುದು<br><br>अभ्यवस्कन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಹಾರ /ಏಟು /ಪೆಟ್ಟು<br><br>अभ्यवस्कन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಂದುವುದು /ತಲುಪುವುದು<br><br>अभ्यवस्कन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಪಾತ /ಪತನ<br><b>निष्पत्तिः - </b>अभि + अव + अकन्दिर् (गतिशोषणयोः) - "घञ्" (३-३-१८)<br><br>

अभ्यवस्कन्दन
अभ्यवस्कन्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>अभ्यवस्कन्द ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><b>विस्तारः - </b>"अभ्यवस्कन्दनं त्वभ्यासादनम्" - वैज० ।<br><br>

अभ्यवहरण
अभ्यवहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೋಜನ /ಊಟ<br><b>निष्पत्तिः - </b>अभि + अव + हृञ् (हरणे) - "ल्युट्" (३-३-११५)<br><br>

अभ्यवहार
अभ्यवहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೋಜನ /ಊಟ<br><b>निष्पत्तिः - </b>भावे "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"सर्वमप्यौदरिकस्याभ्यवहार एव पर्यवस्यति"<br><b>उल्लेखाः - </b>रत्ना० २<br><br>

अभ्यवहार्य
अभ्यवहार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಹಾರ /ಊಟದ ವಸ್ತು<br><br>अभ्यवहार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿನ್ನಲು ಯೋಗ್ಯವಾದ /ಭುಜಿಸಲು ಅರ್ಹವಾದ<br><b>निष्पत्तिः - </b>अभि + अव + हृञ् (हरणे) - कर्म० "ण्यत्" (३-१-१२४)<br><b>प्रयोगाः - </b>"सर्वत्रौदरिकस्याभ्यवहार्यमेव विषयः"<br><b>उल्लेखाः - </b>विक्र० ३<br><br>

अभ्यवहृत
अभ्यवहृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭುಜಿಸಲ್ಪಟ್ಟ /ತಿನ್ನಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + अव + हृञ् (हरणे) - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>अभ्यवह्रियते<br><br>

अभ्यवसन
अभ्यवसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭ್ಯಾಸ /ಪುನರಾವೃತ್ತಿ<br><br>अभ्यवसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಕ್ಷಣ /ಕಲಿಯುವುದು<br><br>अभ्यवसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುನರಾಚರಣೆ /ಮತ್ತೆ ಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>अभि + असु (क्षेपणे) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"विद्यामभ्यसनेनैव प्रसादयितुमर्हसि"<br><b>उल्लेखाः - </b>रघु० १-८८<br><br>

अभ्यवसनीय
अभ्यवसनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭ್ಯಾಸಮಾಡಲು ಯೋಗ್ಯವಾದ /ಕಲಿಯಲು ಅರ್ಹವಾದ<br><b>निष्पत्तिः - </b>अभि + असु (क्षेपणे) -"अनीयर्" (३-१-९६)<br><br>

अभ्यसूयक
अभ्यसूयक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಅಸೂಯೆ ಪಡುವವನು /ಗುಣದಲ್ಲಿ ದೋಷವನ್ನು ತೋರಿಸುವವನು<br><b>निष्पत्तिः - </b>अभि + असूञ् (उपतापे) - "यक्" (३-१-२७) । "ण्वुल्" (३-१-१३३)<br><b>प्रयोगाः - </b>"मामात्मपरदेहेषु प्रद्विषन्तोऽभ्यसूयकाः"<br><b>उल्लेखाः - </b>गीता० १६-१८<br><br>

अभ्यसूया
अभ्यसूया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸೂಯೆ /ಇತರರ ಗುಣ ಮತ್ತು ವೃದ್ಧಿಯಲ್ಲಿ ದೋಷವನ್ನು ಎಣಿಸುವ ಬುದ್ಧಿ<br><b>निष्पत्तिः - </b>अभि + असूञ् (उपतापे) - "यक्" (३-१-२७) । "अः" (३--३-१०२)<br><b>प्रयोगाः - </b>"केनाभ्यसूया पदकाङ्क्षिणा ते नितान्तदीर्घैर्जनिता तपोभिः"<br><b>उल्लेखाः - </b>कुमा० ३-४<br><br>

अभ्यस्त
अभ्यस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭ್ಯಾಸ ಮಾಡಲ್ಪಟ್ಟ<br><br>अभ्यस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುನರಾವೃತ್ತಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + असु (क्षेपणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"शैशवेऽभ्यस्तविद्यानां यौवने विषयैषिणाम्"<br><b>उल्लेखाः - </b>रघु० १-८<br><br>अभ्यस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದ್ವಿತ್ವ ಹೇಳಲ್ಪಟ್ಟ ಧಾತುವಿನ ಭಾಗಗಳು /ಅಭ್ಯಾಸ ಸಂಜ್ಞೆ ಹೊಂದಿರುವ ಧಾತು<br><b>प्रयोगाः - </b>"उभे अभ्यासस्य"<br><b>उल्लेखाः - </b>पा० सू०<br><br>

अभ्यस्य
अभ्यस्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಭ್ಯಾಸ ಮಾಡಿ /ಕಲಿತು<br><br>अभ्यस्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪುನಃ ಆವೃತ್ತಿ ಮಾಡಿ<br><b>निष्पत्तिः - </b>अभि + असु (क्षेपणे) - "ल्यप्" (७-१-३७)<br><br>

अभ्याख्यात
अभ्याख्यात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪವಾದ ಹೊರಿಸಲ್ಪಟ್ಟ /ಚಾಡಿ ಹೇಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + आ + ख्या (प्रकथने) - "ल्युट्" (३-३-११५)<br><br>

अभ्यागत
अभ्यागत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಔತಣಿಗ /ಊಟಕ್ಕೆ ಕರೆದು ಬಂದವನು<br><b>निष्पत्तिः - </b>अभि + आ + गम्लृ (गतौ) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"आस्वादितार्द्रक्रमुकाः समुद्रादभ्यागतस्य प्रतिपत्तिमीयुः"<br><b>उल्लेखाः - </b>माघ० ३-८१<br><br>अभ्यागत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿಮುಖವಾಗಿ ಬಂದ<br><b>प्रयोगाः - </b>"अभ्याजतोऽभ्यागततूर्णतर्णकाम्"<br><b>उल्लेखाः - </b>माघ० १२-४१<br><br>अभ्यागत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಬಂದ<br><br>

अभ्यागम
अभ्यागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಗಮನ /ಬರುವಿಕೆ<br><b>निष्पत्तिः - </b>अभि + आ + गम्लृ (गतौ) - "अप्" (३-३-५८)<br><b>प्रयोगाः - </b>"का त्वं शुभे कस्य परिग्रहो वा किं वा मदभ्यागमकारणं ते"<br><b>उल्लेखाः - </b>रघु० १६-८<br><br>अभ्यागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ<br><b>निष्पत्तिः - </b>अधि० "अप्" (३-३-५८)<br><b>व्युत्पत्तिः - </b>अभ्यागम्यतेऽत्र<br><br>अभ्यागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪ /ಹತ್ತಿರ<br><br>अभ्यागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿರೋಧ /ವೈರ<br><b>निष्पत्तिः - </b>कर० "अप्"<br><b>व्युत्पत्तिः - </b>अभ्यागम्यतेऽनेन<br><br>अभ्यागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಏಟು /ಪೆಟ್ಟು /ಹೊಡೆತ<br><br>अभ्यागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರುಗೊಳ್ಳುವುದು<br><br>अभ्यागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಲುಪುವುದು /ಸೇರುವುದು<br><br>अभ्यागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಣ /ಮುತ್ತಿಗೆ<br><b>विस्तारः - </b>"अभ्यागमो विरोधाजिघाताभ्युद्रमनान्तिके" - मेदि० । "अभ्यागमः समरेऽन्तिके । घाते रोधेऽभ्युद्गमे" - हेम० ।<br><br>

अभ्यागमन
अभ्यागमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರುಗೊಳ್ಳುವುದು<br><br>अभ्यागमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಮುಖವಾಗಿ ಬರುವುದು<br><b>निष्पत्तिः - </b>अभि + आ + गम्लृ (गतौ) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"हेतुं तदभ्यागमने परीप्सुः मुखोपविष्टं मुनिमाबभाषे"<br><b>उल्लेखाः - </b>किरा० ३-४<br><br>

अभ्यागारिक
अभ्यागारिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೃಹಕೃತ್ಯದಲ್ಲಿ ನಿರತನಾದವನು /ಕುಟುಂಬ ಪೋಷಣೆಯಲ್ಲಿ ಆಸಕ್ತನಾದವನು<br><b>निष्पत्तिः - </b>"ठन्" (४-४-७०)<br><b>व्युत्पत्तिः - </b>अभ्यागारे नियुक्तः<br><br>

अभ्याघात
अभ्याघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧಾಳಿ /ಮೇಲೆ ಬೀಳುವುದು<br><br>अभ्याघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಏಟು /ಪೆಟ್ಟು /ಹೊಡೆತ<br><b>निष्पत्तिः - </b>अभि + आ + हन (हिंसागत्योः) - "घञ्" (३-३-१८)<br><br>अभ्याघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಳ್ಳತನದ ಉಪದೇಶ /ಕಳ್ಳತನ ಮಾಡಲು ಒಡಂಬಡಿಸುವುದು<br><b>प्रयोगाः - </b>"अभ्याघातेषु मध्यस्थान् शिष्याच्चौरानिव द्रुतम्"<br><b>उल्लेखाः - </b>मनु० ९-२७२<br><br>

अभ्याघातिन्
अभ्याघातिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಡೆಯುವ ಸ್ವಭಾವದ /ಹಿಂಸಿಸುವ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>अभि + आ + हन (हिंसागत्योः) - "घिनुण्" (३-२-१४२)<br><br>

अभ्याजत्
अभ्याजत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಬರುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>अभि + आ + अज (गतौ) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"अभ्याजतोऽभ्यागततूर्णतर्णकाम्"<br><b>उल्लेखाः - </b>माघ० १२-४१<br><br>

अभ्यादान
अभ्यादान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ /ಉಪಕ್ರಮ<br><br>अभ्यादान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ತೆಗೆದುಕೊಳ್ಳುವುದು<br><b>व्युत्पत्तिः - </b>अभि आभिमुख्येनादानम्<br><b>विस्तारः - </b>"अथाभ्यादानमारम्भः" - वैज० ।<br><br>

अभ्याधान
अभ्याधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂತ್ರಪೂರ್ವಕ ಸಮಿತ್ತುಗಳನ್ನು ಅಗ್ನಿಯಲ್ಲಿ ಸಮರ್ಪಿಸುವುದು<br><br>

अभ्यान्त
अभ्यान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೋಗಪೀಡಿತನಾದವನು /ವ್ಯಾಧಿಗ್ರಸ್ತ<br><b>निष्पत्तिः - </b>अभि + अम (रोगे) - "क्तः" (३-२-१०२) । दीर्घः (६-४-१५)<br><b>व्युत्पत्तिः - </b>अभ्यम्यते स्म<br><b>विस्तारः - </b>"आतुरोऽभ्यमितोऽभ्यान्तः" - अम० ।<br><br>

अभ्यापतत्
अभ्यापतत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿಮುಖವಾಗಿ ಬರುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>अभि + आ + पत्लृ (गतौ) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"अभ्यापतन्तमसुराधिपमीशपुत्रः"<br><b>उल्लेखाः - </b>कुमा० १७-४९<br><br>

अभ्यापत्ति
अभ्यापत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಮುಖವಾಗಿ ಬರುವುದು /ಎದುರಾಗಿ ಬರುವುದು<br><b>निष्पत्तिः - </b>अभि + आ + पद (गतौ) - "क्तिन्" (३-३-९४)<br><br>

अभ्यापन्न
अभ्यापन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಬಂದಿರುವ /ಅಭಿಮುಖವಾಗಿ ಬಂದಿರುವ<br><b>निष्पत्तिः - </b>अभि + आ + पद (गतौ) -"क्तः" (३-४-७२)<br><br>

अभ्यापात
अभ्यापात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಪತ್ತು /ಆಕಸ್ಮಿಕ<br><br>

अभ्यामर्द
अभ्यामर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ /ಸಮರ<br><b>निष्पत्तिः - </b>अभि + आ + मृद (क्षोदे) - अधि० "घञ्" (३-३-१२१)<br><br>अभ्यामर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಡೆದಾಟ /ಘರ್ಷಣೆ<br><b>निष्पत्तिः - </b>भावे "घञ्" (३-३-१८)<br><br>

अभ्यायत्
अभ्यायत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿಮುಖವಾಗಿ ಬರುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>अभि + आ+ इण् (गतौ) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"अभ्यायतः सम्प्रति धूमधूस्रम्"<br><b>उल्लेखाः - </b>किरा० १६-६<br><br>

अभ्यारूढ
अभ्यारूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಿಗಿಲಾದ /ಮೀರಿದ<br><br>अभ्यारूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏರಿದ /ಮೇಲಕ್ಕೆ ಹತ್ತಿದ<br><b>निष्पत्तिः - </b>अभि + आ + रुह (बीजजन्मनि प्रादुर्भावे च) - "क्तः" (३-४-७२)<br><br>

अभ्यारोह
अभ्यारोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಮೇಲಕ್ಕೆ ಹತ್ತುವುದು<br><b>निष्पत्तिः - </b>अभि + आ + रुह (बीजजन्मनि प्रादुर्भावे च) - "घञ्" (३-३-१८)<br><br>अभ्यारोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ /ಏಳಿಗೆ<br><br>अभ्यारोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂತ್ರವನ್ನು ಜಪಿಸುವುದು<br><br>अभ्यारोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಳಾಂತರಕ್ಕೆ ಬದಲಾವಣೆ<br><br>

अभ्यावर्त
अभ्यावर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುನರಾವೃತ್ತಿ /ಮತ್ತೆ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>अभि + आ + वृतु (वर्तने) भावे "घञ्" (३-३-१८)<br><br>अभ्यावर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುನಃ ಪುನಃ ಜಪಿಸಲ್ಪಡುವ ಮಂತ್ರ<br><b>निष्पत्तिः - </b>कर्म० "घञ्" (३-३-१९)<br><br>

अभ्यावृत्त
अभ्यावृत्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ತರಲ್ಪಟ್ಟ ಶೇಷದ ವಸ್ತು<br><b>निष्पत्तिः - </b>अभि + वृतु (वर्तने) - "क्तः" (३-२-१०२)<br><br>अभ्यावृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುನರಾವೃತ್ತಿ ಮಾಡಲ್ಪಟ್ಟ<br><br>अभ्यावृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಬಂದಿರುವ<br><br>

अभ्यावृत्ति
अभ्यावृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುನರಾವೃತ್ತಿ /ಮಾಡಿದ ಕೆಲಸವನ್ನೇ ಮತ್ತೆ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>अभि + आ + वृतु (वर्तने) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"मनागनभ्यावृत्त्या वा कामं क्षाम्यतु यः क्षमी"<br><b>उल्लेखाः - </b>माघ० २-४३<br><br>

अभ्याश
अभ्याश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪ /ಹತ್ತಿರ<br><b>निष्पत्तिः - </b>अभि + अशू (व्याप्तौ) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>अभ्यश्यते<br><b>प्रयोगाः - </b>"चूतयष्टिरिवाभ्याशे मधौ परभृतोन्मुखी"<br><b>उल्लेखाः - </b>कुमा० ६-२<br><br>अभ्याश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಸರಿಸುವುದು /ಹರಡುವುದು /ವ್ಯಾಪಿಸುವುದು<br><b>निष्पत्तिः - </b>भावे "घञ्" (३-३-१८)<br><br>

अभ्यास
अभ्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪ /ಹತ್ತಿರ<br><b>निष्पत्तिः - </b>अभि + असु (क्षेपणे) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>अभ्यस्यते<br><b>प्रयोगाः - </b>"महोर्मिभिर्व्याहृतवाञ्छितार्थैर्वीडादिवाभ्यासगतैर्विलिल्ये"<br><b>उल्लेखाः - </b>माघ० ३-४०<br><br>अभ्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುನರಾವೃತ್ತಿ /ಮಾಡಿದ ಕೆಲಸವನ್ನೇ ಮತ್ತೆ ಮಾಡುವುದು<br><b>प्रयोगाः - </b>"अभ्यासेन च कौन्तेय वैराग्येण च गृह्यते"<br><b>उल्लेखाः - </b>गीता० ६-३५<br><br>अभ्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇದ ಮೊದಲಾದುವನ್ನು ಆವೃತ್ತಿ ಮಾಡುವುದು /ಗಟ್ಟಿಯಾಗಿ ಪಠಿಸುವುದು /ಮನಸ್ಸಿಗೆ ಹಿಡಿಯುವಂತೆ ವ್ಯಾಸಂಗ ಮಾಡುವುದು<br><b>प्रयोगाः - </b>"वेदाभ्यासजडः कथं नु विषयव्यावृत्तकौतूहलः"<br><b>उल्लेखाः - </b>विक्र० १-१०<br><br>अभ्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ವಿತ್ವ ಹೊಂದಿದ ಧಾತುವಿನ ಪೂರ್ವಭಾಗ<br><b>प्रयोगाः - </b>"पूर्वोऽभ्यासः"<br><b>उल्लेखाः - </b>पा० सू०<br><br>अभ्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಣಾಕಾರ<br><br>अभ्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಗೀತದಲ್ಲಿ ಹೇಳುವ ಪಲ್ಲವಿ<br><br>अभ्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೂಢಿ /ಛಾಳಿ<br><b>प्रयोगाः - </b>"अमङ्गलाभ्यासरतिं विचिन्त्य"<br><b>उल्लेखाः - </b>कुमा० ५-६५<br><br>अभ्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಯಾಮ ಕಲಿಯುವುದು /ಅಂಗಸಾಧನೆ ಮಾಡುವುದು<br><br>

अभ्यासयोग
अभ्यासयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಕಾಲದ ಧ್ಯಾನದಿಂದುಂಟಾದ ಚಿತ್ತೈಕಾಗ್ರತೆ /ಸಮಾಧಿ<br><b>व्युत्पत्तिः - </b>अभ्यासेन योगः<br><b>प्रयोगाः - </b>"अभ्यासयोगेन ततो मामिच्छाप्तुं धनञ्जय"<br><b>उल्लेखाः - </b>गीता० १२-९<br><br>

अभ्यासादन
अभ्यासादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರುವನ್ನು ದುರ್ಬಲನನ್ನಾಗಿ ಮಾಡುಲು ಹೊಡೆಯುವುದು<br><br>अभ्यासादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿಡುವುದು<br><br>अभ्यासादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರುವಿಗೆ ಎದುರಾಗಿ ಹೋಗುವುದು<br><b>निष्पत्तिः - </b>अभि + आ + षद्लृ (विशरणादौ) - "ल्युट्" (३-३-११५)<br><br>

अभ्याहार
अभ्याहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಮುಖವಾಗಿ ತರುವುದು<br><br>अभ्याहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದರೋಡೆ /ಕಳ್ಳತನ<br><b>निष्पत्तिः - </b>अभि + आ+ हृञ् (हरणे) - "घञ्" (३-३-१८)<br><br>

अभ्याहित
अभ्याहित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂತ್ರಪೂರ್ವಕ ಸಮಿತ್ತುಗಳಿಂದ ಹೋಮ ಮಾಡಲ್ಪಟ್ಟ ಅಗ್ನಿ<br><br>अभ्याहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಇಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + आ + डुधाञ् (धारणपोषणयोः) - "क्तः" (३-२-१०२)<br><br>

अभ्युक्त
अभ्युक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಹೇಳಲ್ಪಟ್ಟ /ಎದುರಿಗೆ ಸೂಚಿಸಲ್ಪಟ್ಟ<br><br>

अभ्युक्षण
अभ्युक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂತ್ರಪೂರ್ವಕ ಬೋರಲು ಕೈಯಿಂದ ನೀರನ್ನು ಚಿಮುಕಿಸುವುದು<br><b>निष्पत्तिः - </b>अभि + उक्ष (सेचने) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"उत्तानेनैव हस्तेन प्रोक्षणं परिकीर्तितम् । न्यञ्चताभ्युक्षणं प्रोक्तं तिरश्चावोक्षणं स्मृतम् ॥"<br><br>अभ्युक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರನ್ನು ಚಿಮುಕಿಸುವುದು /ನೀರನ್ನು ಎರಚುವುದು<br><b>प्रयोगाः - </b>"परस्पराभ्युक्षणतत्पराणां तासां नृपो मज्जनरागदर्शी"<br><b>उल्लेखाः - </b>रघु० १६-५७<br><br>

अभ्युच्चय
अभ्युच्चय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ /ಬೆಳವಣಿಗೆ<br><br>अभ्युच्चय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಐಶ್ಚರ್ಯ /ಸಂಪತ್ತು<br><b>निष्पत्तिः - </b>अभि + उत् + चिञ् (चयने) - "अच्" (३-३-५६)<br><br>

अभ्युत्थान
अभ्युत्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೌರವದಿಂದ ಎದ್ದು ನಿಂತುಕೊಳ್ಳುವುದು<br><br>अभ्युत्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೌರವದಿಂದ ಎದುರುಗೊಳ್ಳುವುದು<br><br>अभ्युत्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏಳುವುದು<br><br>अभ्युत्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿ /ಉದ್ಭವಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अभि + उद् + ष्ठा (गतिनिवृत्तौ) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"यदा यदा हि धर्मस्य ग्लानिर्भवति भारत । अभ्युत्थानमधर्मस्य तदात्मानं सृजाम्यहम् ॥"<br><b>उल्लेखाः - </b>गीता० ४-७<br><br>अभ्युत्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ /ಬೆಳವಣಿಗೆ<br><b>प्रयोगाः - </b>"नवाभ्युत्थानदर्शिन्यो ननन्दुः सप्रजाः प्रजाः"<br><b>उल्लेखाः - </b>रघु० ४-३<br><br>

अभ्युत्थायिन्
अभ्युत्थायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೌರವದಿಂದ ಮೇಲಕ್ಕೆ ಏಳುವ<br><br>अभ्युत्थायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೌರವದಿಂದ ಎದುರುಗೊಳ್ಳುವ<br><br>अभ्युत्थायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದುವ<br><b>निष्पत्तिः - </b>अभि + उद् + ष्ठा (गतिनिवृत्तौ) - "णिनिः" (३-१-१३४)<br><br>

अभ्युत्थित
अभ्युत्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೌರವದಿಂದ ಎದುರುಗೊಳ್ಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + उद् + ष्ठा (गतिनिवृत्तौ) - "क्तः" (३-२-१०२)<br><br>अभ्युत्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎದ್ದಿರುವ<br><b>निष्पत्तिः - </b>अभि + उद् + ष्ठा (गतिनिवृत्तौ) - कर्त० "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"अभ्युत्थिताग्निपिशुनैरतिथीनाश्रमोन्मुखम्"<br><b>उल्लेखाः - </b>रघु० १-५३<br><br>

अभ्युत्थेय
अभ्युत्थेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜ್ಯ /ಗೌರವಾರ್ಹ /ನಮಸ್ಕಾರಕ್ಕೆ ಅರ್ಹನಾದ<br><b>निष्पत्तिः - </b>अभि + उद् + ष्ठा (गतिनिवृत्तौ) - "यत्" (३-१-९७)<br><br>

अभ्युत्पतन
अभ्युत्पतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲೆ ಹಾರುವುದು /ಅಭಿಮುಖವಾಗಿ ಮೇಲೆ ಬೀಳುವುದು<br><b>निष्पत्तिः - </b>अभि + उद् + पत्लृ (गतौ) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"अलक्षिताभ्युत्पतनो नृपेण प्रसह्य किल तां चकर्ष"<br><b>उल्लेखाः - </b>रघु० २-२७<br><br>

अभ्युदय
अभ्युदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ /ಏಳಿಗೆ<br><b>निष्पत्तिः - </b>अभि + उद् + इण् (गतौ) - "अच्" (३-३-५६)<br><b>प्रयोगाः - </b>"बभूव सर्वं शुभशंसि तत्क्षणं भवो हि लोकाभ्युदयाय तादृशाम्"<br><b>उल्लेखाः - </b>रघु० ३-१४<br><br>अभ्युदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಯಾಣ /ಮಂಗಳ<br><b>प्रयोगाः - </b>"सर्वथा स्पृशन्ति नः स्वामिनमभ्युदयाः"<br><b>उल्लेखाः - </b>रत्ना० १<br><br>अभ्युदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಷ್ಟಕಾರ್ಯಸಿದ್ಧಿ<br><br>अभ्युदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿಗೆ ಕಾರಣವಾದ ಒಂದು ಶ್ರಾದ್ಧ /ನಾಂದೀ ಶ್ರಾದ್ಧ<br><br>अभ्युदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂದಿನ ಅಭಿವೃದ್ಧಿ<br><br>अभ्युदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಸವ /ಸಂತೋಷ /ಸಮಾರಂಭ<br><b>प्रयोगाः - </b>"प्रतिषिद्धापि चेद्या तु मद्यमभ्युदयेष्वपि"<br><b>उल्लेखाः - </b>मनु० ९-८४<br><br>

अभ्युदित
अभ्युदित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೂರ್ಯೋದಯಕಾಲದಲ್ಲಿ ಮಲಗಿ ನಿದ್ರಿಸುವವನು /ಸೂರ್ಯೋದಯಕಾಲದಲ್ಲಿ ಮಾಡಬೇಕಾದ ಸಂಧ್ಯಾವಂದನಾದಿ ಕಾರ್ಯಗಳನ್ನು ಬಿಟ್ಟು ನಿದ್ರಿಸುವವನು<br><b>व्युत्पत्तिः - </b>अभि सर्वतः उद् अतिशयेन इतं गतं प्रातस्तनं कर्म यस्मात्<br><b>विस्तारः - </b>"सुप्ते यस्मिन्नस्तमेति सुप्ते यस्मिन्नुदेति च । अंशुमानभिनिर्मुक्ताभ्युदितौ तौ यथाक्रमम् ॥" - अम० ।<br><br>अभ्युदित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ಉಂಟಾದ<br><br>

अभ्युदीरित
अभ्युदीरित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಳುವುದು /ಮಾತಾಡುವುದು<br><b>निष्पत्तिः - </b>अभि + उद् + ईर (गतौ कम्पने च) - "क्तः" (३-३-११४)<br><br>अभ्युदीरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + उद् + ईर (गतौ कम्पने च) - कर्म० "क्तः" (३-२-१०२)<br><br>अभ्युदीरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಸೆಯಲ್ಪಟ್ಟ /ಎರಚಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अशेषतीर्थोपहृताः कमण्डलोर्निधाय पाणावृषिणाभ्युदीरिताः"<br><b>उल्लेखाः - </b>माघ० १-१८<br><br>

अभ्युद्गत
अभ्युद्गत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರುಗೊಳ್ಳಲು ಮುಂದೆ ಬಂದಿರುವ /ಸಂಧಿಸಲು ಎದುರಿಗೆ ಬಂದಿರುವ<br><br>अभ्युद्गत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ಭವಿಸಿದ /ಉತ್ಪನ್ನವಾದ<br><b>निष्पत्तिः - </b>अभि + उद् + गम्लृ (गतौ)- "क्तः" (३-४-७२)<br><br>अभ्युद्गत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರುಗೊಳ್ಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कर्म० "क्तः" (३-२-१०२)<br><br>

अभ्युद्गम
अभ्युद्गम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯುತ್ಥಾನ /ಎದುರುಗೊಳ್ಳುವುದು<br><br>अभ्युद्गम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಭವಿಸುವುದು /ಉಂಟಾಗುವುದು<br><b>निष्पत्तिः - </b>अभि + उद् + गम्लृ (गतौ)- "अप्" (३-३-५८)<br><br>

अभ्युद्गमन
अभ्युद्गमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>अभ्युद्गम ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

अभ्युद्यत
अभ्युद्यत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲ್ಪಟ್ಟ /ಮೇಲಕ್ಕೆ ಏರಿಸಲ್ಪಟ್ಟ<br><br>अभ्युद्यत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾಚಿಸದೆ ಹೊಂದಲ್ಪಟ್ಟ /ಅಯಾಚಿತವಾಗಿ ಒದಗಿದ<br><b>निष्पत्तिः - </b>अभि + उद् + यम (उपरमे) - "क्तः" (३-२-१०२)<br><br>अभ्युद्यत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯಾಸಕ್ತನಾದ /ಉತ್ಸಾಹದಿಂದ ಕಾರ್ಯದಲ್ಲಿ ತೊಡಗಿರುವ<br><b>प्रयोगाः - </b>"अभ्युद्यतस्य क्रमितुं जव्र्न गां तमालनीला नितरां धृतायतिः"<br><b>उल्लेखाः - </b>माघ० १२-७०<br><br>अभ्युद्यत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದಿದ /ಏಳಿಗೆ ಪಡೆದ<br><b>निष्पत्तिः - </b>कर्त० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"कुलमभ्युद्यतनूतनेश्वरम्"<br><b>उल्लेखाः - </b>रघु० ८-१५<br><br>अभ्युद्यत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರವೃತ್ತನಾದ /ಯತ್ನಿಸಿದ<br><b>प्रयोगाः - </b>"चण्डी चण्डं हन्तुमभ्युद्यता माम्"<br><b>उल्लेखाः - </b>माल० ३-२१<br><br>

अभ्युद्धृत
अभ्युद्धृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲ್ಪಟ್ಟ /ಮೇಲಕ್ಕೆ ಏರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + उद् + हृञ् (हरणे) - "क्तः" (३-२-१०२)<br><br>अभ्युद्धृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಯಾಚಿತವಾಗಿ ಹೊಂದಲ್ಪಟ್ಟ /ಬೇಡದೆ ಒದಗಿದ<br><br>अभ्युद्धृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾಚಿಸಿದ ನಂತರ ಕೊಡಲ್ಪಟ್ಟ<br><br>

अभ्युन्नत
अभ्युन्नत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎತ್ತರಾಅದ /ಉನ್ನತವಾದ<br><b>व्युत्पत्तिः - </b>आभिमुख्येन उन्नतः<br><b>प्रयोगाः - </b>"अभ्युन्नताङ्गुष्ठनखप्रभाभिर्निक्षेपणाद्रागमिवोद्गिरन्तौ"<br><b>उल्लेखाः - </b>कुमा० १-३३<br><br>

अभ्युन्नति
अभ्युन्नति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ /ಏಳಿಗೆ<br><br>

अभ्युपगत
अभ्युपगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕರಿಸಲ್ಪಟ್ಟ /ಸಮ್ಮತಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + उप + गम्लृ (गतौ) - "क्तः" (३-२-१०२)<br><br>अभ्युपगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಟ್ಟ<br><br>अभ्युपगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪವನ್ನು ಹೊಂದಿದ /ಹತ್ತಿರಕ್ಕೆ ಹೋಗಿರುವ<br><br>अभ्युपगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಹೋಗಿರುವ /ಅಭಿಮುಖವಾಗಿ ಬಂದಿರುವ<br><br>

अभ्युपगम
अभ्युपगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಪ್ಪಿಗೆ /ಅಂಗೀಕಾರ<br><b>निष्पत्तिः - </b>अभि + उप + गम्लृ (गतौ) - "अप्" (३-३-५६)<br><b>प्रयोगाः - </b>"करिष्याम्येवं नो पुनरिति भवेदभ्युपगमः"<br><b>उल्लेखाः - </b>रत्ना० २-१९<br><br>अभ्युपगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪವನ್ನು ಹೊಂದುವುದು /ಹತ್ತಿರಕ್ಕೆ ಹೋಗುವುದು<br><br>अभ्युपगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭರವಸೆಯ ಮಾತು ಕೊಡುವುದು /ವಾಗ್ದಾನ ಮಾಡುವುದು<br><br>

अभ्युपपत्ति
अभ्युपपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಗ್ರಹ /ಹಿತಾಚರಣೆ /ಅನಿಷ್ಟವನ್ನು ತೊಲಗಿಸಿ ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>अभि + उप + पद (गतौ) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"अनयाभ्युपपत्त्या सूचिता ते भर्तृगृहेऽनुभवितव्या राजलक्ष्मीरिति"<br><b>उल्लेखाः - </b>शाकु० ४<br><br>अभ्युपपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆ /ಮರೆಹೊಕ್ಕಿದವನನ್ನು ಕಾಪಾಡುವುದು<br><b>प्रयोगाः - </b>"ब्राह्मणाभ्युपपत्तौ च शपथे नास्ति पातकम्"<br><b>उल्लेखाः - </b>मनु० ८-११२<br><br>अभ्युपपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ವಾಸನ /ಸಮಾಧಾನ<br><br>अभ्युपपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭರವಸೆಯ ಮಾತು ಕೊಡುವುದು /ವಾಗ್ದಾನ ಮಾಡುವುದು<br><br>

अभ्युपपन्न
अभ्युपपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಗ್ರಹಿಸಲ್ಪಟ್ಟ /ಒಳ್ಳೆಯದುಂಟುಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अभि + उप + पद (गतौ) - "क्तः" (३-२-१०२)<br><br>

अभ्युपाय
अभ्युपाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಾಯ /ಯುಕ್ತಿ<br><b>निष्पत्तिः - </b>उप + अय (गतौ) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>उपायतेऽनेन<br><b>प्रयोगाः - </b>"तस्मिन् सुराणां विजयाभ्युपाये तवैव नामास्त्रगतिः कृती त्वम्"<br><b>उल्लेखाः - </b>कुमा० ३-१९<br><br>अभ्युपाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ /ಒಪ್ಪಿಗೆ<br><b>निष्पत्तिः - </b>भावे "घञ्" (३-३-१८)<br><b>विस्तारः - </b>"संविदागूः प्रतिज्ञास्थाप्यभ्युपायः प्रतिश्रवः" - वैज० ।<br><br>

अभ्युपेत
अभ्युपेत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಸಮೀಪವನ್ನು ಹೊಂದಿದ /ಅಭಿಮುಖವಾಗಿ ಹತ್ತಿರಕ್ಕೆ ಬಂದ<br><b>निष्पत्तिः - </b>अभि + उप + इण् (गतौ) - "क्तः" (३-४-७२)<br><br>अभ्युपेत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕರಿಸಲ್ಪಟ್ಟ /ಸಮ್ಮತಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कर्म० "क्तः" (३-२-१०२)<br><br>

अभ्युपेत्य
अभ्युपेत्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಸಮೀಪವನ್ನು ಹೊಂದಿ /ಅಭಿಮುಖವಾಗಿ ಹತ್ತಿರಕ್ಕೆ ಬಂದು<br><br>अभ्युपेत्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕರಿಸಿ /ಸಮ್ಮತಿಸಿ<br><br>

अभ्युपेय
अभ्युपेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯಿಸಲು ಯೋಗ್ಯನಾದ /ಸಮೀಪಕ್ಕೆ ಹೋಗಲು ಅರ್ಹನಾದ<br><b>निष्पत्तिः - </b>अभि + उप + इण् (गतौ) -"यत्" (३-१-९७)<br><br>

अभ्युषित
अभ्युषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಕ /ಆಳು<br><br>अभ्युषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ ವಾಸ ಮಾಡುವ<br><b>निष्पत्तिः - </b>अभि + वस (निवासे) - "क्तः" (३-४-७२)<br><br>

अभ्यूष
अभ्यूष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಸಲಿ /ಗುಗ್ಗರಿ<br><b>निष्पत्तिः - </b>अभि + ऊष (रुजायाम्) - "कः" (३-१-१३५)<br><br>अभ्यूष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೊಟ್ಟಿ<br><br>अभ्यूष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುರಿಗಾಳು<br><br>

अभ्यूह
अभ्यूह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತರ್ಕ /ಊಹೆ /ಕಲ್ಪನೆ<br><b>निष्पत्तिः - </b>अभि + ऊह (वितर्के) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"बहिः सर्वाकारप्रवणरमणीयं व्यवहरन् पराभ्यूहस्थानान्यपि तनुतराणि स्थगयति"<br><b>उल्लेखाः - </b>मालती० १-१७<br><br>अभ्यूह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಧ್ಯಾಹಾರ /ಪದಲೋಪವಿದ್ದಲ್ಲಿ ಬೇಕಾದ ಪದಗಳನು ಸೇರಿಸಿಕೊಳ್ಳುವುದು<br><br>

अभ्यूह्य
अभ्यूह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಹಿಸಲು ಶಕ್ಯವಾದ<br><br>अभ्यूह्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಊಹಿಸಿ /ತರ್ಕಿಸಿ<br><br>

अभ्र
अभ्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><b>निष्पत्तिः - </b>भ्रंशु (अधःपतने) - "डः" (वा० ३-२-१०१)<br><b>व्युत्पत्तिः - </b>न भ्रश्यन्त्यापोऽस्मात्<br><b>प्रयोगाः - </b>"विच्छिन्नाभ्रविलायं वा विलीये नगमूर्धनि"<br><b>उल्लेखाः - </b>किरा० ११-७९<br><br>अभ्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಗನ /ಆಕಾಶ /ಅಂತರಿಕ್ಷ<br><b>प्रयोगाः - </b>"अलोकयिष्यन्मुदितामयोध्यां प्रासादमभ्रंलिहमारुरोह"<br><b>उल्लेखाः - </b>रघु० १४-२९<br><br>अभ्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಸ್ತಕ /ಕೊನ್ನಾರಿ ಗೆಡ್ಡೆ<br><br>अभ्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುವರ್ಣ /ಚಿನ್ನ<br><br>अभ्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಪೂರ<br><br>अभ्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ ಬಂಗಾರ<br><br>अभ्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜ್ಯ /ಸೊನ್ನೆ<br><b>विस्तारः - </b>"अभ्रं मेघे च गगने धातुभेदे च काञ्चने" - मेदि० ।<br><br>अभ्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವಲೋಕ /ಸ್ವರ್ಗ<br><b>विस्तारः - </b>"अभ्रं तु त्रिदिवे गगनेऽम्बुदे" - हेम० ।<br><br>

अभ्रक
अभ्रक<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ ಬಂಗಾರ<br><b>निष्पत्तिः - </b>"कन्" (५-३-९६)<br><b>व्युत्पत्तिः - </b>अभ्रस्य प्रतिकृतिः<br><b>प्रयोगाः - </b>"अभ्रकस्तव बीजन्तु मम बीजन्तु पारदः । उभयोर्मेलनं देवि, मृत्य्दारिद्र्यनाशनम् ॥"<br><br>

अभ्रंलिह
अभ्रंलिह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯು /ಗಾಳಿ<br><br>अभ्रंलिह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಗನವನ್ನು ಚುಂಬಿಸುವ /ಆಕಾಶವನ್ನು ಮುಟ್ಟುವ /ಬಹಳ ಎತ್ತರವಾದ<br><b>निष्पत्तिः - </b>अभ्र + लिह (आस्वादने) - "खश्" (३-२-३२) । मुम् (६-३-६७)<br><b>व्युत्पत्तिः - </b>अभ्रं लेढि स्पृशति<br><b>प्रयोगाः - </b>"प्रासादमभ्रंलिहमारुरोह" । "अभ्रंलिहात् फलवतस्तटनारिकेलात् सह्यात्मजासलिलवैवधिकानमंस्त" ।<br><b>उल्लेखाः - </b>रघु० १४-२९, चं० भा०<br><br>

अभ्रघन
अभ्रघन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘದ ಸಮೂಹ<br><b>प्रयोगाः - </b>"वर्षात्ययेन रुचमभ्रघनादिवेन्दोः"<br><b>उल्लेखाः - </b>रघु० १३-७७<br><br>

अभ्रङ्कष
अभ्रङ्कष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯು /ಗಾಳಿ<br><br>अभ्रङ्कष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಗನವನ್ನು ಚುಂಬಿಸುವ /ಆಕಾಶವನ್ನು ಮುಟ್ಟುವ /ಬಹಳ ಎತ್ತರವಾದ<br><b>निष्पत्तिः - </b>कष (हिंसायाम्) - "खच्" (३-२-४२) । "मुम् (६-३-६७)<br><b>व्युत्पत्तिः - </b>अभ्रं कषति<br><b>प्रयोगाः - </b>"आदायाभ्रङ्कषं प्रायान्मलयं फलशालिनम्"<br><b>उल्लेखाः - </b>भट्टि० ६-१०३<br><br>

अभ्रनाग
अभ्रनाग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಆನೆ /ಐರಾವತ<br><br>

अभ्रपथ
अभ्रपथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾಶಮಾರ್ಗ<br><br>अभ्रपथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಮಾನ<br><br>अभ्रपथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾಶಬುಟ್ಟಿ<br><br>

अभ्रपिशाच
अभ्रपिशाच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾಶದ ಭೂತ /ರಾಹುಗ್ರಹ<br><br>

अभ्रपुष्प
अभ्रपुष्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಬ್ಬೆಗಿಡ<br><br>अभ्रपुष्प<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು<br><br>अभ्रपुष्प<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಗನಕುಸುಮ<br><br>

अभ्रम
अभ्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭ್ರಾಂತಿಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अभ्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭ್ರಮಣವಿಲ್ಲದಿರುವಿಕೆ<br><br>अभ्रम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭ್ರಾಂತಿಯಿಲ್ಲದ<br><br>अभ्रम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭ್ರಮಣವಿಲ್ಲದ<br><br>

अभ्रमांसी
अभ्रमांसी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಟಾಮಾಂಸಿ<br><br>

अभ्रमातङ्ग
अभ्रमातङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಆನೆ /ಐರಾವತ<br><b>व्युत्पत्तिः - </b>अभ्रात्मको मातङ्गः अभ्रे मातङ्गो वा<br><br>

अभ्रमाला
अभ्रमाला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ ಪಂಕ್ತಿ /ಮೋಡಗಳಸಾಲು<br><b>व्युत्पत्तिः - </b>अभ्राणां माला<br><br>

अभ्रमु
अभ्रमु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಐರಾವತನ ಪತ್ನಿ<br><br>

अभ्रमुवल्लभ
अभ्रमुवल्लभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಆನೆ /ಐರಾವತ<br><br>

अभ्रवर्ष
अभ्रवर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಳೆ ಸುರಿಯುವುದು<br><br>

अभ्रातृक
अभ्रातृक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಹೋದರನಿಲ್ಲದವನು<br><b>निष्पत्तिः - </b>"कप्" (५-४-१५३)<br><b>व्युत्पत्तिः - </b>न भ्राता यस्य<br><br>

अभ्रातृका
अभ्रातृका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಹೋದರನಿಲ್ಲದವನು<br><br>

अभ्रातृव्य
अभ्रातृव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶತ್ರುಗಳಿಲ್ಲದವನು /ಹಗೆಯಿಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>नास्ति भ्रातृव्यः शत्रुर्यस्य<br><br>

अभ्रावकाश
अभ्रावकाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾಶದ ಆವರಣ /ಮೇಲಿನ ಛಾವಣಿಯಿಲ್ಲದಿರುವಿಕೆ<br><br>

अभ्रि
अभ्रि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಡಗಿನಲ್ಲಿ ಕಸವನ್ನು ಬಗೆಯುವ ಮರದ ಗುದ್ದಲಿ<br><br>अभ्रि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗುದ್ದಲಿ /ಸಲಿಕೆ /ಪಿಕಾಸಿ<br><b>निष्पत्तिः - </b>अभ्र (गतौ) - "इन्" (उ० ४-११८०<br><b>व्युत्पत्तिः - </b>अभ्रति मलमस्यात्<br><b>प्रयोगाः - </b>"अभ्रिं कार्ष्यायसीं दद्यात्सर्पं हत्वा द्विजोत्तमः"<br><b>उल्लेखाः - </b>मनु० ११-१३३<br><br>

अभ्रित
अभ्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೋಡದಿಂದ ಕವಿಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>अभ्रमस्य सञ्जातम्<br><b>प्रयोगाः - </b>"पतिः प्रतीतः प्रसवोन्मुखीं प्रियां ददर्श काले दिवमभ्रितामिव"<br><b>उल्लेखाः - </b>रघु० ३-१२<br><br>

अभ्रिय
अभ्रिय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಘದಲ್ಲಿ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>"घः" (४-४-११८)<br><b>व्युत्पत्तिः - </b>अभ्रे भवम्<br><br>

अभ्रेष
अभ्रेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚ್ಯುತಿಯಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>न० त०<br><b>व्युत्पत्तिः - </b>भ्रेषादन्यः<br><br>अभ्रेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುಕ್ತತೆ /ಔಚಿತ್ಯ<br><br>अभ्रेष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚ್ಯುತಿಯಿಲ್ಲದ /ತಪ್ಪದಿರುವ<br><br>

अम्
अम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಜಾಗ್ರತೆ<br><br>अम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ<br><b>निष्पत्तिः - </b>अम (गत्यादौ) - "क्विप्"<br><br>

अम
अम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಣ<br><b>निष्पत्तिः - </b>अम (गत्यादौ) - "अच्" (३-१-१३४)<br><br>अम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗ /ವ್ಯಾಧಿ<br><b>निष्पत्तिः - </b>अम (रोगे) - "घञ्" (३-३-१८)<br><br>अम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವಕ /ಆಳು<br><br>अम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲ /ಶಕ್ತಿ<br><br>अम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಕ್ವವಾದ /ಬಲಿತಿಲ್ಲದ<br><br>

अमङ्गल
अमङ्गल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹರಳುಗಿಡ<br><br>अमङ्गल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶುಭ /ಅರಿಷ್ಟ<br><b>प्रयोगाः - </b>"रामाभियायिनां तेषां तदेवाभूदमङ्गलम्"<br><b>उल्लेखाः - </b>रामा०<br><br>अमङ्गल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಶುಭವಾದ /ಕೆಟ್ಟದಾದ<br><b>प्रयोगाः - </b>"अमङ्गलाभ्यासरतिं विचिन्त्य तम्"<br><b>उल्लेखाः - </b>कुमा० ५-६५<br><br>

अमङ्गल्य
अमङ्गल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಶುಭಕ್ಕೆ ಕಾರಣವಾದ<br><b>व्युत्पत्तिः - </b>न मङ्गलाय हितम्<br><br>

अमण्ड
अमण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹರಳುಗಿಡ<br><b>विस्तारः - </b>"चञ्चुः पञ्चाङ्गुलामण्डवर्धमानव्यडम्बकाः" - अम० ।<br><br>अमण्ड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆನೆಯಿಲ್ಲದ ಅನ್ನ ಮುಂತಾದುದು<br><br>अमण्ड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲಂಕಾರವಿಲ್ಲದ /ಶೃಂಗಾರವಿಲ್ಲದ<br><br>

अमत
अमत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗ /ವ್ಯಾಧಿ<br><br>अमत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೃತ್ಯು /ಮರಣ<br><br>अमत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲ /ಸಮಯ<br><br>अमत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧೂಳು /ಕಸ<br><b>निष्पत्तिः - </b>अम (गत्यादौ) - "अतच्" (उ० ३-११०)<br><br>अमत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮ್ಮತವಲ್ಲದ /ಇಷ್ಟವಲ್ಲದ<br><br>अमत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न मतः<br><br>

अमति
अमति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><br>अमति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲ /ಸಮಯ<br><br>अमति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿಯಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>अभावे न० त० ।<br><br>अमति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಬುದ್ಧಿ<br><br>अमति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿಯಿಲ್ಲದ<br><br>अमति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುರ್ಜನ /ದುಷ್ಟ<br><b>विस्तारः - </b>"अमतिः पुंसि कालेऽपि दुष्टे हिमकरेऽपि च" - शब्दर० ।<br><br>

अमत्र
अमत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾತ್ರೆ<br><br>अमत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಊಟದ ಪಾತ್ರೆ<br><b>निष्पत्तिः - </b>अम (गत्यादौ) - "अत्रन्" (उ० ३-१०५०<br><br>अमत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಲ /ಶಕ್ತಿ<br><br>

अमनस्
अमनस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><b>प्रयोगाः - </b>"अप्राणोह्यमनाः शुभ्रः"<br><b>उल्लेखाः - </b>मुण्डक०<br><br>अमनस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸರಿಯಾದ ಮನಸ್ಸಿಲ್ಲದ<br><br>अमनस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ವಿಷಯದಲ್ಲಿ ಮನಸ್ಸುಳ್ಳ<br><br>अमनस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನೋನಿಗ್ರಹವಿಲ್ಲದ /ಮನಸ್ಸಿನ ಹತೋಟಿಯಿಲ್ಲದ<br><br>

अमनि
अमनि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾರ್ಗ /ದಾರಿ<br><b>निष्पत्तिः - </b>अम (गत्यादौ) - अधि० "अनिः" (उ० २-१०२)<br><b>व्युत्पत्तिः - </b>अमति गच्छत्यत्र<br><br>अमनि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗತಿ /ಚಲನೆ /ಸಂಚಾರ<br><br>

अमनुष्य
अमनुष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನುಷ್ಯಕೃತ್ಯವಿಲ್ಲದವನು /ಹೆಸರಿಗೆ ಮಾತ್ರ ಮನುಷ್ಯನಾದವನು<br><br>अमनुष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನುಷ್ಯನಿಲ್ಲದ<br><br>

अमनोगत
अमनोगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನಸ್ಸಿನಿಂದ ಯೋಚಿಸಲ್ಪಡದ /ಅಚಿಂತಿತವಾದ /ಮನಸ್ಸಿನಲ್ಲಿಲ್ಲದ<br><br>

अमन्त्रक
अमन्त्रक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇದೋಕ್ತ ಮಂತ್ರವಿಲ್ಲದ ಕರ್ಮ<br><br>अमन्त्रक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇದ ಮಂತ್ರಾಧಿಕಾರವಿಲ್ಲದವನು<br><br>

अमम
अमम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನನ್ನದು ನನಗೆ ಎಂಬ ಅಭಿಮಾನವನ್ನು ತೊರೆದಿರುವ /ಪ್ರಾಪಂಚಿಕ ಸಂಬಂಧವನ್ನು ಬಿಟ್ಟಿರುವ /ಪತ್ನಿ ಪುತ್ರ ಮನೆ ಮಠ ಮೊದಲಾದುವುಗಳಲ್ಲಿ ಅಭಿಮಾನ್ಯ ಶೂನ್ಯನಾದ<br><b>व्युत्पत्तिः - </b>नास्ति ममेत्यभिमानो यस्य<br><br>

अममकार
अममकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಾರ್ಥತೆಯಿಲ್ಲದಿರುವಿಕೆ /ತನ್ನದೆಂಬ ಅಭಿಮಾನಶೂನ್ಯತೆ<br><br>अममकार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿಮಾನವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति ममकारो यस्य<br><br>

अमर
अमर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><b>निष्पत्तिः - </b>मृङ् (प्राणत्यागे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>न म्रियते<br><b>प्रयोगाः - </b>"अमरस्त्रीकटाक्षणामप्यभङ्गुरधन्वनः"<br><b>उल्लेखाः - </b>याद० १६-९२<br><br>अमर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಮರಸಿಂಹ<br><br>अमर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಳ್ಳಿಗಿಡ<br><br>अमर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾದರಸ<br><br>अमर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಳೆಗಳ ರಾಶಿ<br><br>अमर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರಣವಿಲ್ಲದ<br><b>प्रयोगाः - </b>"अजरामरवत्प्राज्ञो विद्यामर्थं च साधयेत्"<br><b>उल्लेखाः - </b>हितो०<br><b>विस्तारः - </b>"अमरः सुरे । स्नुहीवृक्षेऽस्थिसंहारेऽपि च" - हेम० ।<br><br>

अमरा
अमरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮರಾವತೀ ಪಟ್ಟಣ<br><br>अमरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮೃತಬಳ್ಳಿ<br><br>अमरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರಿಕೆ ಹುಲ್ಲು<br><br>अमरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆಯ ಕಂಬ<br><br>अमरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ಭಾಶಯ /ಬಸುರು ಉಂಟಾಗುವ ಭಾಗ<br><br>अमरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ಭನಾಳ /ಹೊಕ್ಕಳ ಕುಡಿ<br><br>अमरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾವುಮೆಕ್ಕೆ ಗಿಡ<br><b>विस्तारः - </b>"अमरस्त्रिदशोऽप्यस्थिसंहारे कुलिशद्रुमे । स्त्री गुडूच्यमरावत्योः स्थूणादूर्वाजरायुषु" - मेदि० । "अमरा नाभिनालायां गुडूच्यामपि" - त्रिकाण्ड० ।<br><br>

अमरकोश
अमरकोश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಮರಸಿಂಹನಿಂದ ರಚಿತವಾದ ನಾಮಲಿಂಗಾನುಶಾಸನವೆಂಬ ನಿಘಂಟು<br><br>

अमरण
अमरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮರತ್ವ /ಸಾಯದಿರುವಿಕೆ<br><br>

अमरतरु
अमरतरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ನಂದನವನದ ವೃಕ್ಷ<br><br>अमरतरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವದಾರು ಮರ<br><br>अमरतरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಪವೃಕ್ಷ<br><br>

अमरता
अमरता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತ್ವ /ಅಮರತ್ವ<br><br>

अमरद्विज
अमरद्विज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವಲಕ /ದೇವರಪೂಜೆಯಿಂದ ಜೀವಿಸುವ ಬ್ರಾಹ್ಮಣ /ಜೀವನಕ್ಕಾಗಿ ದೇವಪೂಜಾಕಾರ್ಯವನ್ನಿಟ್ಟುಕೊಂಡಿರುವವನು<br><br>

अमरपुर
अमरपुर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ನಗರ /ಅಮರಾವತೀ ಪಟ್ಟಣ<br><br>

अमरपुष्प
अमरपुष्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಪವೃಕ್ಷ<br><br>अमरपुष्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೊಂಡುಹುಲ್ಲು<br><br>

अमरपुष्पिका
अमरपुष्पिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೆಗ್ಗಿಲುಗಿಡ<br><br>अमरपुष्पिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಳವಳಿಕೆ ಗಿಡ<br><br>अमरपुष्पिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಸಬ್ಬಸಿಗೆ ಗಿಡ<br><br>

अमरपुष्पी
अमरपुष्पी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೆಗ್ಗಿಲುಗಿಡ<br><br>अमरपुष्पी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಳವಳಿಕೆ ಗಿಡ<br><br>अमरपुष्पी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಸಬ್ಬಸಿಗೆ ಗಿಡ<br><br>

अमरप्रभु
अमरप्रभु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>अमरप्रभु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><b>व्युत्पत्तिः - </b>अमराणां प्रभुः<br><b>प्रयोगाः - </b>"अप्रमेयो हृषीकेशः पद्मनाभोऽमरप्रभुः"<br><b>उल्लेखाः - </b>वि० स०<br><br>

अमररत्न
अमररत्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಫಟಿಕಮಣಿ<br><br>

अमरराज
अमरराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><b>निष्पत्तिः - </b>"टच्" (५-४-९१)<br><b>व्युत्पत्तिः - </b>अमराणां राजा<br><br>

अमरलोक
अमरलोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವಲೋಕ /ಸ್ವರ್ಗ<br><br>

अमरसरित्
अमरसरित्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವನದಿ /ಗಂಗಾನದಿ<br><br>

अमराङ्गना
अमराङ्गना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತಾಸ್ತ್ರೀಯರು /ಅಪ್ಸರಸ್ಸುಗಳು<br><b>व्युत्पत्तिः - </b>अमराणामङ्गनाः<br><b>प्रयोगाः - </b>"पुरीमवस्कन्द लुनीहि नन्दनं मुषाण रत्नानि हरामराङ्गनाः"<br><b>उल्लेखाः - </b>माघ० १-५१<br><br>

अमराद्रि
अमराद्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇರುಪರ್ವತ<br><b>व्युत्पत्तिः - </b>अमराणामद्रिः<br><br>

अमरदधिप
अमरदधिप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ /ದೇವತೆಗಳ ಒಡೆಯ<br><b>व्युत्पत्तिः - </b>अमराणामदधिपः<br><br>

अमरापगा
अमरापगा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವನದಿ /ಗಂಗಾನದಿ<br><b>व्युत्पत्तिः - </b>अमराणामापगा<br><br>

अमरालय
अमरालय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಗ<br><br>अमरालय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇರುಪರ್ವತ<br><br>

अमरावती
अमरावती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಪಟ್ಟಣ /ಇಂದ್ರನ ರಾಜಧಾನಿ<br><br>

अमरु
अमरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಮರು ಶತಕವನ್ನು ಬರೆದ ಕವಿ<br><br>

अमर्त्य
अमर्त्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><b>निष्पत्तिः - </b>मृङ् (प्राणत्यागे) - "तन्" (उ० ३-८६) । तत्र भवा अपि मर्ता जनाः । स्वार्थे "यत्" (वा० ५-४-३६) मर्त्याः । तद्भिन्ना अमर्त्याः ।<br><b>व्युत्पत्तिः - </b>म्रियन्तेऽस्मिन्निति मर्तो भूलोकः<br><b>प्रयोगाः - </b>"विधत्स्व विपदुत्तीर्णानमर्त्याननुकम्पया"<br><b>उल्लेखाः - </b>याद० १६-४९<br><br>

अमर्त्यभुवन
अमर्त्यभुवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಗ /ದೇವಲೋಕ<br><b>व्युत्पत्तिः - </b>अमर्त्यानां भुवनम्<br><br>

अमर्याद
अमर्याद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರಮರ್ಯಾದೆಯನ್ನು ಮೀರಿದ /ನಿಯಮವನ್ನು ಉಲ್ಲಂಘಿಸಿದ<br><b>प्रयोगाः - </b>"अमर्यादः क्षुद्रश्चलमतिरसूयाप्रसवभूः कृतघ्नो दुर्मानी स्मरपरवशो वञ्चनपरः"<br><b>उल्लेखाः - </b>स्तो० र०<br><br>अमर्याद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲೆಯಿಲ್ಲದ /ಮೇರೆಯಿಲ್ಲದ<br><br>अमर्याद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೌರವವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति मर्यादा यस्य<br><br>

अमर्यादा
अमर्यादा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಲ್ಲೆ ಮೀರುವುದು /ಉಲ್ಲಂಘಿಸುವುದು /ಅತಿಕ್ರಮಿಸುವುದು<br><br>

अमर्ष
अमर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪ<br><br>अमर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಹನೆಯಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>मृष (तितिक्षायाम्) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"अमर्षशून्येन जनस्य जन्तुना न जातहार्देन च विद्विषादरः"<br><b>उल्लेखाः - </b>किरा० १-३३<br><br>

अमर्षण
अमर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಹನೆಯಿಲ್ಲದ /ಅಸಹಿಷ್ಣು<br><b>प्रयोगाः - </b>"विशेषात्परिपूर्णस्य याति शत्रोरमर्षणः । आभिमुख्यम्"<br><b>उल्लेखाः - </b>पञ्चतं० १-३५५<br><br>अमर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಪಿತನಾದ /ಕೋಪಗೊಂಡ<br><b>निष्पत्तिः - </b>मृष (तितिक्षायाम्) - ताच्छील्ये "युच्" (३-२-१५१)<br><b>व्युत्पत्तिः - </b>न मर्षशीलः<br><b>प्रयोगाः - </b>"रघोरवष्टम्भभयेन पत्रिणा हृदि क्षतो गोत्रभिदप्यमर्षणः"<br><b>उल्लेखाः - </b>रघु० ३-५३<br><br>

अमर्षित
अमर्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಪಿತನಾದ /ಕೋಪಗೊಂಡ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>अमर्षोऽस्य सञ्जातः<br><b>प्रयोगाः - </b>"अभिमन्युवधामर्षितैः पाण्डुपुत्रैः"<br><b>उल्लेखाः - </b>वेणी० ४<br><br>

अमर्षिन्
अमर्षिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪವುಳ್ಳ /ಕುಪಿತನಾಗಿರುವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>अमर्षोऽस्यास्ति<br><b>प्रयोगाः - </b>"अमर्षिणा कृत्यमिव क्षमाश्रयं मदोद्धतेनेव हितं प्रियं वचः"<br><b>उल्लेखाः - </b>किरा० १४-६३<br><br>

अमर्षिणी
अमर्षिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಪಿತಳಾಗಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अमल
अमल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ ಬಂಗಾರ<br><br>अमल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಚ್ಛವಾದ /ಕೊಳೆಯಿಲ್ಲದ<br><br>अमल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೋಷವಿಲ್ಲದ /ಕಳಂಕವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति मलं यस्य<br><b>प्रयोगाः - </b>"मम तु दयितः श्लाघ्यस्तातो जनन्यमलान्वया"<br><b>उल्लेखाः - </b>मालती० २-२<br><br>

अमला
अमला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಮಿ<br><b>विस्तारः - </b>"अमला कमलायां स्यात् अमलं विशदेऽभ्रके" - हेम० ।<br><br>

अमलात्मन्
अमलात्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿರ್ಮಲಚಿತ್ತನಾದ ಯೋಗಿ /ವಿಷಯಾಭಿಲಾಷೆಯನ್ನು ತ್ಯಜಿಸಿದ ಯೋಗಿ<br><br>अमलात्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರ್ಮಲವಾದ ದೇಹವುಳ್ಳ<br><b>प्रयोगाः - </b>"अमलात्मसु प्रतिफलन्नभितस्तरुणीकपोलफलकेषु मुहुः"<br><b>उल्लेखाः - </b>माघ० ९-३७<br><br>

अमा
अमा<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮ<br><br>

अमा
अमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರನ ಹದಿನಾರನೆಯ ಕಲೆ<br><br>अमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮಾವಾಸ್ಯೆ ತಿಥಿ<br><b>विस्तारः - </b>"दर्शोऽमामावसी च सा" - त्रिकाण्ड० ।<br><br>अमा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಗಡ /ಜೊತೆಯಲ್ಲಿ /ಕೂಡ<br><br>अमा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರ /ಸಮೀಪ<br><b>निष्पत्तिः - </b>मा (माने) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>न माति<br><b>विस्तारः - </b>"स्यादमा सन्निधानार्थे सहार्थे" - हेम० ।<br><br>

अमांस
अमांस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಕ್ತಿಯಿಲ್ಲದವನು /ದುರ್ಬಲ<br><b>व्युत्पत्तिः - </b>नास्ति मांसं यस्य<br><br>

अमात्य
अमात्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಚಿವ /ಮಂತ್ರಿ<br><b>निष्पत्तिः - </b>"त्यप्" (४-२-१०४)<br><b>व्युत्पत्तिः - </b>अमा सह वसति<br><b>प्रयोगाः - </b>"नृपेष्वमात्येषु च सर्वसम्पदः" । "अमात्यव्यञ्जना राज्ञां दूष्यास्ते शत्रुसञ्ज्ञिताः" ।<br><b>उल्लेखाः - </b>किरा० १-५, माघ० २-५६<br><br>अमात्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನೆಯ ಒದನಾಡಿ /ಕುಟುಂಬಕ್ಕೆ ಸೇರಿದವನು<br><br>

अमात्र
अमात्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>नास्ति मात्रा परिच्छेदो यस्य<br><br>अमात्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಳತೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अमात्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಿಮಾಣಶೂನ್ಯವಾದ /ಅಳತೆಯಿಲ್ಲದ<br><br>

अमानन
अमानन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗೌರವ /ಅವಮರ್ಯಾದೆ<br><br>अमानन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆದರವಿಲ್ಲದ /ಗೌರವಿಲ್ಲದ<br><br>

अमानव
अमानव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಮಾನುಷ /ಮನುಷ್ಯನಲ್ಲದ /ಮನುಷ್ಯನ ಸಂಬಂಧವಿಲ್ಲದ<br><b>निष्पत्तिः - </b>न० त०<br><b>व्युत्पत्तिः - </b>मनोरयं मानवः<br><b>प्रयोगाः - </b>"अमनावं जातमजं मनोः कुले प्रभाविनं भाविनमन्तमात्मनः"<br><b>उल्लेखाः - </b>माघ० १-६७<br><br>

अमानस्य
अमानस्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮನಸ್ಸನ್ನು ನೋಯಿಸುವ ದುಃಖ<br><b>निष्पत्तिः - </b>मानस - "यत्" (४-४-९८) । मानस्यम् । न० त० ।<br><b>व्युत्पत्तिः - </b>मानसे साधु<br><br>

अमाय
अमाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><br>अमाय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಟವಿಲ್ಲದ /ಋಜುವಾದ /ಪ್ರಾಮಾಣಿಕನಾದ<br><b>व्युत्पत्तिः - </b>नास्ति माया यस्य<br><br>

अमाया
अमाया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಮಾಣಿಕತೆ /ಕಪಟವಿಲ್ಲದಿರುವಿಕೆ<br><br>अमाया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಿದ್ಯಾಶೂನ್ಯತೆ<br><br>

अमायिन्
अमायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಟವಿಲ್ಲದ /ಪ್ರಾಮಾಣಿಕನಾದ<br><br>

अमावास्या
अमावास्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮಾವಾಸ್ಯೆ /ಕೃಷ್ಣಪಕ್ಷದ ಹದಿನೈದನೆಯ ತಿಥಿ<br><b>निष्पत्तिः - </b>अमा + वस (निवासे) - "ण्यत्" (३-१-१२२) । वा ह्रस्वः । निपा० ।<br><b>व्युत्पत्तिः - </b>अमा सह असतश्चन्द्रार्कौ यस्याम्<br><br>

अमित
अमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಿತವಲ್ಲದ /ಹೆಚ್ಚಾದ /ಅಳತೆಯಿಲ್ಲದ<br><b>निष्पत्तिः - </b>मा (माने) - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>न मितः<br><br>अमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಪಡದ<br><b>प्रयोगाः - </b>"अमितस्य महिम्नस्ते प्रयातुं पारमिच्छताम्"<br><b>उल्लेखाः - </b>याद० १-४७<br><br>

अमितशासन
अमितशासन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ /ಪರಮಾತ್ಮ<br><b>निष्पत्तिः - </b>अश (भोजने) - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अमितमश्नाति<br><b>प्रयोगाः - </b>"महीधरो महाभागो वेगवानमिताशनः"<br><b>उल्लेखाः - </b>वि० स०<br><br>

अमितौजस्
अमितौजस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಬಲಶಾಲಿ<br><b>व्युत्पत्तिः - </b>अमितमोजो यस्य<br><br>

अमित्र
अमित्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರು /ಹಗೆ /ವೈರಿ<br><b>निष्पत्तिः - </b>अम (गत्यादौ) - "इत्रः" (उ० ४-१७४)<br><b>प्रयोगाः - </b>"गुणार्जनोपायविरुद्धबुद्धयः प्रकृतमित्रा हि सतामसाधवः"<br><b>उल्लेखाः - </b>किरा० १४-२१<br><br>

अमिथ्या
अमिथ्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಯವಾಗಿ /ನಿಜವಾಗಿ<br><b>व्युत्पत्तिः - </b>न मिथ्या<br><b>प्रयोगाः - </b>"कृच्छ्रं महत्तीर्ण इति प्रियार्हां तामूचतुस्ते प्रियमप्यमिथ्या"<br><b>उल्लेखाः - </b>रघु० १४-६<br><br>

अमिन्
अमिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸ್ವಸ್ಥ /ರೋಗಿ<br><b>निष्पत्तिः - </b>अम - "इनिः" (५-२-११५)<br><br>

अमिष
अमिष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲೌಕಿಕಸುಖ<br><br>अमिष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೋಗ್ಯವಸ್ತು /ಸುಖದ ಪದಾರ್ಥ<br><br>अमिष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಸವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न मिषः<br><br>अमिष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಟವಿಲ್ಲದ /ಮೋಸವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति मिषश्छलं यस्य<br><br>

अमुक्त
अमुक्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಖಡ್ಗ /ಕತ್ತಿ<br><br>अमुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಕ್ತಿ ಹೊಂದದ /ಸಂಸಾರದಿಂದ ಬಿಡುಗಡೆ ಹೊಂದಿದ<br><br>अमुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न मुक्तः<br><b>प्रयोगाः - </b>"अमुक्ता भवता नाथ मुहूर्तमपि सा पुरा"<br><b>उल्लेखाः - </b>सा० द०<br><br>

अमुक्तहस्त
अमुक्तहस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಿಪುಣ /ಜೀನ /ಕೃಪಣ /ಲೋಭಿ<br><b>व्युत्पत्तिः - </b>न मुक्तहस्तो यस्य<br><br>

अमुक्तहस्ता
अमुक्तहस्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಪುಣೆ<br><b>प्रयोगाः - </b>"सुसंस्कृतोपस्करया व्यये चामुक्तहस्तया"<br><b>उल्लेखाः - </b>मनु० ५-१५०<br><br>

अमुक्ति
अमुक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಕ್ಷವಿಲ್ಲದಿರುವಿಕೆ /ಸಂಸಾರದಿಂದ ಬಿಡುಗಡೆ ಹೊಂದದಿರುವಿಕೆ<br><br>अमुक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಧನದಿಂದ ಬಿಡುಗಡೆಯಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न मुक्तिः<br><br>

अमुतस्
अमुतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಲ್ಲಿಂದ /ಆ ಪ್ರದೇಶದಿಂದ /ಅವಳಿಂದ /ಅದರಿಂದ<br><b>निष्पत्तिः - </b>अदस् - "तसिल्" (वा० ५-४-४४)<br><br>अमुतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪರಲೋಕದಿಂದ<br><br>

अमुत्र
अमुत्र<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಲ್ಲಿ /ಅವನಲ್ಲಿ /ಅದರಲ್ಲಿ<br><br>अमुत्र<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪರಲೋಕದಲ್ಲಿ<br><b>निष्पत्तिः - </b>अदस् - "त्रल्" (५-३-१०)<br><br>अमुत्र<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಜನ್ಮಾಂತರದಲ್ಲಿ /ಬೇರೆ ಜನ್ಮದಲ್ಲೀ<br><b>प्रयोगाः - </b>"तथैव यः क्षमाकाले क्षत्रियो नोपशाम्यति । अप्रियः सर्वभूतानां सोऽमुत्रेह च नश्यति ॥"<br><br>

अमूदृश्
अमूदृश्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅದರಂತಿರುವ /ಅವನಂತಿರುವ<br><b>निष्पत्तिः - </b>अदस् + दृशिर् (प्रेक्षणे) - "क्विन्" (३-२-६०)<br><br>

अमूदृक्ष
अमूदृक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅದರಂತಿರುವ /ಅವನಂತಿರುವ<br><b>निष्पत्तिः - </b>"क्सः" (६-३-८९)<br><br>

अमूर्त
अमूर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><br>अमूर्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಯವರಹಿತ /ಆಕಾರಶೂನ್ಯ<br><b>व्युत्पत्तिः - </b>न मूर्तः<br><b>प्रयोगाः - </b>"क्षितिर्जलं तथा तेजः पवनो मन एव च । परापरत्वमूर्तत्वक्रियायोगाश्रया अमी ।"<br><b>उल्लेखाः - </b>भाषापा०<br><b>विस्तारः - </b>अविच्छिन्नपरिमाणवत्वं मूर्तत्वम् - मुक्ता० ।<br><br>

अमूर्तगुण
अमूर्तगुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಮೂರ್ತವಾದ ಆಕಾಶ ಮೊದಲಾದುವುಗಳ ಗುಣ<br><b>प्रयोगाः - </b>"धर्माधर्मौ भावना च शब्दो बुद्ध्यादयोऽपि च । एतेऽमूर्तगुणाः सर्वे"<br><b>उल्लेखाः - </b>भाषाप०<br><br>

अमूर्ति
अमूर्ति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>नास्ति मूर्तिः<br><b>प्रयोगाः - </b>"अमूर्तिरनघोऽचिन्त्यो भयकृद्भयनाशनः"<br><b>उल्लेखाः - </b>वि० स०<br><br>अमूर्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕಾಶರಹಿತವಾದ /ಅವಯವವಿಲ್ಲದ<br><br>

अमूर्तिमत्
अमूर्तिमत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>"विश्वमूर्तिः महामूर्तिः दीप्तमूर्तिरमूर्तिमान्"<br><b>उल्लेखाः - </b>वि० स०<br><br>अमूर्तिमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕಾಶರಹಿತವಾದ /ಅವಯವವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न मूर्तिमान्<br><br>

अमूल्य
अमूल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆಲೆಯಿಲ್ಲದ /ಬಹಳ ಬೆಲೆ ಬಾಳುವ<br><br>

अमृणाल
अमृणाल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಮಂಚದ ಬೇರು<br><b>निष्पत्तिः - </b>सादृश्ये न० त०<br><b>व्युत्पत्तिः - </b>मृणालमिव<br><br>

अमृत
अमृत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>न मृतं मरणं यस्य<br><b>प्रयोगाः - </b>"अमृतः शाश्वतस्थाणुः वरारोहो महातपाः"<br><b>उल्लेखाः - </b>वि० स०<br><br>अमृत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧನಂತರಿ<br><br>अमृत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><br>अमृत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><br>अमृत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಕ್ಷತ್ರ ಮತ್ತು ವಾರಗಳ ಯೋಗದಿಂದ ಉಂಟಾಗುವ ಒಂದು ಯೋಗ<br><br>अमृत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><br>अमृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮೃತ /ಸುಧೆ<br><b>निष्पत्तिः - </b>मृङ् (प्राणत्यागे) - "तन्" (उ० ३-८८) ।<br><b>व्युत्पत्तिः - </b>न म्रियन्तेऽनेन<br><b>प्रयोगाः - </b>"देवासुरैरमृतमम्बुनिधिर्ममन्थे"<br><b>उल्लेखाः - </b>किरा० ५-३०<br><br>अमृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಕ್ಷ /ಮುಕ್ತಿ<br><b>व्युत्पत्तिः - </b>न मृतं मरणं यत्र<br><b>विस्तारः - </b>"स श्रियैचामृताय च" - अम० ।<br><br>अमृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಗ<br><br>अमृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><br>अमृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಲು /ಕ್ಷೀರ<br><br>अमृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞಶೇಷ<br><b>प्रयोगाः - </b>"विघसो भुक्तशेषं तु यज्ञशेषं तथामृतम्"<br><b>उल्लेखाः - </b>मनु० ३-२८५<br><br>अमृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಚಿಸದೆ ದೊರೆತ ಭಿಕ್ಷೆ<br><b>प्रयोगाः - </b>"मृतं स्याद्याचितं भैक्ष्यममृतं स्यादयाचितम्"<br><b>उल्लेखाः - </b>मनु० ४-५<br><br>अमृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಘೃತ /ತುಪ್ಪ<br><b>प्रयोगाः - </b>"अमृतं नाम यत्सन्तो मन्त्रजिह्वेषु जुह्वति । शोभैव मन्दरक्षुब्धक्षुभिताम्भोधिवर्णना"<br><b>उल्लेखाः - </b>माघ० २-१०७<br><br>अमृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನ /ಆಹಾರ<br><br>अमृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿನ್ನ /ಸುವರ್ಣ<br><br>अमृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾದರಸ<br><br>अमृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ<br><br>अमृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೋಜನ /ಊಟ<br><br>अमृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾಶ /ಗಗನ<br><br>अमृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಸಾಯನ<br><br>अमृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಿಹಿಯಾದ<br><br>अमृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರಣಹೊಂದದ /ಬದುಕಿರುವ<br><br>अमृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಮರತ್ವಕ್ಕೆ ಕಾರಣವಾದ<br><br>अमृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೋಕ್ಷ ಹೊಂದದ /ಮುಕ್ತನಾದ<br><br>अमृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಮ್ಯವಾದ /ಸುಂದರವಾದ<br><b>विस्तारः - </b>"अमृतं यज्ञशेषाम्बुसुधामोक्षेष्वयाचिते । अन्नकाञ्चनयोर्जग्धौ खे स्वादुनि रसायने । घृते हृद्ये गोरसे चामृतो धन्वन्तरौ सुरे" - हेम० ।<br><br>अमृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶವಿಲ್ಲದ /ಶಾಶ್ವತವಾದ<br><b>प्रयोगाः - </b>"ब्रह्मणो हि प्रतिष्ठाहं अमृततस्याव्यवयस्य च । शाश्वतस्य च धर्मस्य सुखस्तैकान्तिकस्य च ॥"<br><b>उल्लेखाः - </b>गीता० १४-२७<br><br>

अमृता
अमृता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಾರಾಹಿ ಗೆಡ್ಡೆ<br><br>अमृता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮೃತಬಳ್ಳಿ<br><br>अमृता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಹೆಸರು<br><br>अमृता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರಿಕೆ<br><br>अमृता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ /ಹೆಂಡ<br><br>अमृता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತುಲಸಿ<br><br>अमृता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾವುಮೆಕ್ಕೆ ಗಿಡ<br><br>अमृता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಪ್ಪಲಿ<br><br>अमृता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಳಲೆ ಗಿಡ<br><br>अमृता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಷ್ಮತೀಲತೆ<br><br>अमृता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೆಲ್ಲಿ ಮರ<br><b>विस्तारः - </b>"अमृता मागधीपथ्यागुडूच्यामलकीषु च ।" - मेदि० । "स्यात् यज्ञशेषाम्बुनभोरसायनक्षीराज्यसोमान्नसुधासु चामृतम् । पथ्यागुडूच्यामलकीष्वयं स्त्रियां देवेषु ना स्वाद्वविनाशिनोस्त्रिषु" - नानार्थर० ।<br><br>अमृता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಕಿರಣಗಳಲ್ಲೊಂದು<br><br>अमृता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶರೀರದೊಳಗಿನ ಒಂದು ನಾಡಿ<br><b>प्रयोगाः - </b>"नाडीनामुदयक्रमेण जगतः पञ्चामृताकर्षणात्"<br><b>उल्लेखाः - </b>मालती० ५-२<br><br>

अमृतत्व
अमृतत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಕ್ಷ /ಮುಕ್ತಿ<br><b>प्रयोगाः - </b>"अहिंसया च भूतानाममृतत्वाय कल्पते"<br><b>उल्लेखाः - </b>मनु० ६-६०<br><br>

अमृतकिरण
अमृतकिरण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>प्रयोगाः - </b>"अमृतदीधितिरेष विदर्भजे भजसि तापममुष्य किमंशुभिः"<br><b>उल्लेखाः - </b>नैष० ४-१०४<br><br>

अमृतदीधिति
अमृतदीधिति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><br>

अमृतद्युति
अमृतद्युति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><br>

अमृतप
अमृतप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>पा (रक्षणे) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>अमृतं पाति असुरेभ्यः<br><b>प्रयोगाः - </b>"सोमपोऽमृतपः सोमः"<br><b>उल्लेखाः - </b>वि० स०<br><br>अमृतप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><b>निष्पत्तिः - </b>पा (पाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>अमृतं पिबति<br><br>

अमृतयोग
अमृतयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾರ ಮತ್ತು ನಕ್ಷತ್ರಗಳ ಯೋಗದಿಂದ ಉಂಟಾಗುವ ಒಂದು ಶುಭಯೋಗ<br><br>

अमृतरस
अमृतरस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ಪರಮಾತ್ಮ<br><br>अमृतरस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಧಾರಸ<br><br>

अमृतरसा
अमृतरसा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿದ್ರಾಕ್ಷಿ<br><br>अमृतरसा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಸಿಹಿರೊಟ್ಟಿ<br><br>

अमृतलता
अमृतलता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮೃತಬಳ್ಳಿ ಗಿಡ<br><br>

अमृतवल्ली
अमृतवल्ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮೃತಬಳ್ಳಿ ಗಿಡ<br><br>

अमृतसम्भवा
अमृतसम्भवा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮೃತಬಳ್ಳಿ ಗಿಡ<br><br>

अमृतसार
अमृतसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಘೃತ /ತುಪ್ಪ<br><b>व्युत्पत्तिः - </b>अमृतस्य क्षीरस्य सारः<br><br>

अमृतसू
अमृतसू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>निष्पत्तिः - </b>षूङ् (प्राणिगर्भविमोचने) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>अमृतं सूते<br><br>अमृतसू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅದಿತಿದೇವಿ<br><b>व्युत्पत्तिः - </b>अमृतान् सूते<br><br>

अमृतांशु
अमृतांशु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>व्युत्पत्तिः - </b>अमृतमिवांशवोऽस्य<br><br>

अमृतांशूद्भव
अमृतांशूद्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>अमृतांशोश्चन्द्रस्य उद्भवो यस्मात्<br><b>प्रयोगाः - </b>"अमृतांशूद्भवो भानुः शशबिन्दुः सुरेश्वरः"<br><b>उल्लेखाः - </b>वि० स०<br><br>अमृतांशूद्भव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಂದ್ರನಿಂದ ಹುಟ್ಟಿದ<br><b>व्युत्पत्तिः - </b>अमृतांशोरुद्भवति<br><br>

अमृतान्धस्
अमृतान्धस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><b>व्युत्पत्तिः - </b>अमृतमन्धोऽन्नं दर्शनात् तृप्तिकारकं यस्य<br><b>प्रयोगाः - </b>"न वै देवा अश्नन्ति पिबन्ति एतदेवामृतं दृष्ट्वा तृप्यन्ति"<br><b>उल्लेखाः - </b>श्रुतिः<br><br>

अमृताश
अमृताश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>अशू (व्याप्तौ) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>अमृतं क्षयाभावमश्नुते<br><b>प्रयोगाः - </b>"अमृतांशोऽमृतवपुः"<br><b>उल्लेखाः - </b>वि० स०<br><br>अमृताश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><b>निष्पत्तिः - </b>अश (भोजने) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>अमृत सुधामश्नाति<br><br>

अमृताशन
अमृताशन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><b>निष्पत्तिः - </b>अश (भोजने) - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अमृतमश्नाति<br><br>

अमृत्यु
अमृत्यु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>नास्ति मृत्युर्यस्य<br><b>प्रयोगाः - </b>"अमृत्युः सर्वदृक् सिंहः सन्धाता सन्धिमान् स्थिरः"<br><b>उल्लेखाः - </b>वि० स०<br><br>अमृत्यु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರಣವಿಲ್ಲದಿರುವಿಕೆ<br><br>अमृत्यु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರಣವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति मृत्युर्यस्य<br><br>अमृत्यु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರಣಕ್ಕೆ ಕಾರಣವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति मृत्युर्यस्मात्<br><br>

अमृषा
अमृषा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸತ್ಯವಾಗಿ /ನಿಜವಾಗಿ<br><br>

अमेधस्
अमेधस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂರ್ಖ /ಮೂಢ /ತಿಳುವಳಿಕೆಯಿಲ್ಲದವನು<br><b>निष्पत्तिः - </b>"असिच्" (५-४-१२२)<br><b>व्युत्पत्तिः - </b>नास्ति मेधा यस्य<br><br>

अमेध्य
अमेध्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುರೀಷ /ಮಲ<br><b>प्रयोगाः - </b>"समुत्सृजेद्राजमार्गे यस्त्वमेध्यमनापदि"<br><b>उल्लेखाः - </b>मनु० ९-२८२<br><br>अमेध्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಶುದ್ಧವಾದ /ಪವಿತ್ರವಲ್ಲದ<br><b>प्रयोगाः - </b>"उच्छिष्टमपि चामेध्यं भोजनं तामसप्रियम्"<br><b>उल्लेखाः - </b>गीता० १७-१०<br><br>अमेध्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾಗಕ್ಕೆ ಅರ್ಹವಲ್ಲದ<br><b>प्रयोगाः - </b>"नामेध्यं प्रक्षिपेदग्नौ न च पादौ प्रतापयेत्"<br><b>उल्लेखाः - </b>मनु० ४-५३<br><br>

अमेय
अमेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಳೆಯಲಾಗದ<br><b>व्युत्पत्तिः - </b>न मातुं शक्यः<br><br>अमेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲಾಗದ<br><b>प्रयोगाः - </b>"अमेयो मितलोक्स्त्वम्"<br><b>उल्लेखाः - </b>रघु० १०-१८<br><br>

अमेयात्मन्
अमेयात्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>अमेय आत्मा यस्य<br><b>प्रयोगाः - </b>"वृषाकपिरमेयात्मा"<br><b>उल्लेखाः - </b>वि० स०<br><br>अमेयात्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿರಿದಾದ ಮನಸ್ಸುಳ್ಳ /ಉದಾರವಾದ ಹೃದಯವುಳ್ಳ<br><br>

अमोघ
अमोघ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>"अमोघः पुण्डरीकाक्षो वृषकर्मा वृषाकृतिः"<br><b>उल्लेखाः - </b>वि० स०<br><br>अमोघ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಫಲವಾದ /ವ್ಯರ್ಥವಲ್ಲದ<br><b>प्रयोगाः - </b>"अमोघाः प्रतिगृह्णन्तावर्ध्यानुपदमाशिषः"<br><b>उल्लेखाः - </b>रघु० १-४४<br><br>अमोघ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುರಿ ಮುಟ್ಟುವ /ಗುರಿ ತಪ್ಪದಿರುವ<br><b>प्रयोगाः - </b>"धनुष्यमोघं समधत्त बाणम्"<br><b>उल्लेखाः - </b>कुमा० ३-६६<br><br>

अमोघा
अमोघा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯುವಿಳಂಗ<br><br>अमोघा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸರು ಪಾದರಿ ಗಿಡ<br><br>अमोघा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಳಲೆ ಗಿಡ<br><b>विस्तारः - </b>"अमोघः सफले वाच्यवत् स्त्री पथ्याविडङ्गयोः" - मेदि० ।<br><br>

अम्ब
अम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದ /ಧ್ವನಿ /ಸದ್ದು<br><b>निष्पत्तिः - </b>अबि (शब्दे) - "घञ्" (३-३-१८)<br><br>अम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಂದೆ<br><br>

अम्बक
अम्बक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಂದೆ<br><b>निष्पत्तिः - </b>अबि (शब्दे) - "घञ्" (३-३-१९) । स्वार्थे "कः"<br><b>व्युत्पत्तिः - </b>अम्ब्यते स्नेहेन शब्द्यते<br><br>अम्बक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೇತ್ರ /ಕಣ್ಣು<br><b>निष्पत्तिः - </b>अत्रि- "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>अम्बति शीघ्रं नक्षत्रस्थानपर्यन्तं गच्छति<br><b>विस्तारः - </b>"ईक्षणं नयनं चक्षुरक्षि लोचनमम्बकम्" - वैज० ।<br><br>

अम्बर
अम्बर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಸ್ತ್ರ /ಬಟ್ಟೆ<br><b>निष्पत्तिः - </b>रा (दाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>अम्बं (मर्मर)शब्दं राति<br><b>प्रयोगाः - </b>"स तप्तकार्तस्वरभास्वराम्बरः कठोरताराधिपलाञ्छनच्छविः"<br><b>उल्लेखाः - </b>माघ० १-२०<br><br>अम्बर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಗನ /ಆಕಾಶ<br><b>प्रयोगाः - </b>"वसन् ददर्शावतरन्तमम्बराद्धिरण्यगर्भाङ्गभुवं मुनिं हरिः"<br><b>उल्लेखाः - </b>माघ० १-१<br><br>अम्बर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ ಬಂಗಾರ<br><br>अम्बर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಕುಮ ಕೇಸರಿ<br><br>अम्बर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿರ /ಸಮೀಪ<br><br>अम्बर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸುಗಂಧ ದ್ರವ್ಯ<br><b>विस्तारः - </b>"अम्बरं वाससि व्योम्नि कार्पासे च सुगन्धके" - विश्व० ।<br><br>

अम्बरीष
अम्बरीष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>अम्बरीष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><br>अम्बरीष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>अम्बरीष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯವಂಶದ ಒಬ್ಬ ದೊರೆ /ವಿಷ್ಣುಭಕ್ತನಾದ ಅಂಬರೀಷ ಮಹಾರಾಜ<br><br>अम्बरीष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಲಕ<br><br>अम्बरीष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಮಟೆ ಮರ<br><br>अम्बरीष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಬರೀಷವೆಂಬ ಒಂದು ನಗರ<br><br>अम्बरीष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುತಾಪ<br><br>अम्बरीष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹುರಿಯುವ ಓಡು /ಬಾಣಲಿ<br><br>अम्बरीष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಣ /ಯುದ್ಧ<br><b>निष्पत्तिः - </b>अबि (शब्दे) - "ईषन्" अरुडागमश्च (उ० ४-२९) । निपा० ।<br><b>व्युत्पत्तिः - </b>अम्ब्यतेऽत्र<br><b>विस्तारः - </b>"अम्बरीषं रणे भ्राष्ट्रेअप्यम्बरीषो नृपान्तरे । मार्तण्डे खण्डपरशावाम्रातककिशोरयोः" - विश्व० । "अम्बरीषं रणे भ्राष्ट्रे क्लीबं पुंसि नृपान्तरे । नरकस्य प्रभेदे च किशोरे भास्करेऽपि च । आम्रातकेऽनुतापे च" - मेदि० ।<br><br>

अम्बष्ठ
अम्बष्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣನಿಗೆ ವೈಶ್ಯ ಹೆಂಗಸಿನಲ್ಲಿ ಜನಿಸಿದ ಬೆರಕೆ ಜಾತಿಯವನು<br><br>अम्बष्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಕಿತ್ಸಕ /ವೈದ್ಯ<br><br>अम्बष्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾವಟಿಗ /ಮಾವುತ<br><br>अम्बष्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಬಷ್ಠದೇಶ<br><br>

अम्बष्ठा
अम्बष्ठा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಮಲ್ಲಿಗೆ<br><br>अम्बष्ठा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಪ್ಪಲಿ<br><br>अम्बष्ठा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಲ್ಲಂಪುರಿಚಿ<br><br>

अम्बष्ठिका
अम्बष्ठिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊನಗೊನ್ನೆ ಸೊಪ್ಪು<br><br>

अम्बा
अम्बा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಯಿ<br><b>निष्पत्तिः - </b>अबि (शब्दे) - "अः" (३-३-१०३)<br><b>व्युत्पत्तिः - </b>अम्ब्यते शब्द्यते<br><b>प्रयोगाः - </b>"कृताञ्जलिस्तत्र यदम्ब सत्यात्"<br><b>उल्लेखाः - </b>रघु० १४-१६<br><br>अम्बा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶೀರಾಜನ ಮಗಳು /ಅಂಬಿಕೆಯ ಸಹೋದರಿ<br><br>अम्बा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ<br><br>अम्बा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗುರುಶುಂಠಿ<br><br>अम्बा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠ ಸಹೋದರಿ<br><b>विस्तारः - </b>"अथ भगिनी स्वसा । सा ज्येष्ठाम्बाप्यवन्ती च" - वैज० ।<br><br>अम्बा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಯಿ<br><b>विस्तारः - </b>"आर्यो मारिषमार्षकौ । आबुकस्तु पिताम्बा तु माता" - वैज० ।<br><br>

अम्बालिका
अम्बालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶೀರಾಜನ ಮೂರನೆಯ ಮಗಳು<br><br>

अम्बिका
अम्बिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಯಿ<br><br>अम्बिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ<br><br>अम्बिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೋದರಮಾವನ ಹೆಂಡತಿ<br><b>विस्तारः - </b>"अम्बिका पार्वतीमात्रोर्धृतराष्ट्रस्य मातरि" - मेदि० । "अम्बिका मातुलीगौर्योः" - नानार्थर० ।<br><br>अम्बिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶೀರಾಜನ ಎರಡನೆಯ ಮಗಳು /ಧೃತರಾಷ್ಟ್ರನ ತಾಯಿ<br><br>अम्बिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಿಯ ಸಹೋದರಿ /ಕಿರಿಯ ತಂಗಿ<br><b>विस्तारः - </b>"अथ भगिनी स्वसा । सा ज्येष्ठाम्बाप्यवन्ती च कनिष्ठा कन्यसाम्बिका" - वैज० ।<br><br>

अम्बु
अम्बु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><b>निष्पत्तिः - </b>अबि (शब्दे) - "उण्" बाहु० ।<br><b>प्रयोगाः - </b>"स्वेदाम्बुस्नपितमजायतेतरस्याः" । "विततशीकरराशिभिरुच्छ्रितैरुपलरोधविवर्तिभिरम्बुभिः" ।<br><b>उल्लेखाः - </b>माघ० ८-३६, किरा० ५-१५<br><br>अम्बु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಗ್ನದಿಂದ ನಾಲ್ಕನೆಯ ಸ್ಥಾನ<br><br>

अम्बुकण
अम्बुकण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನ ಹನಿ /ಜಲಬಿಂದು<br><br>

अम्बुकण्टक
अम्बुकण्टक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಸಳೆ<br><b>व्युत्पत्तिः - </b>अम्बुनि कण्टकमिव<br><br>

अम्बुकिरात
अम्बुकिरात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಸಳೆ<br><b>व्युत्पत्तिः - </b>अम्बुनि किरात इव हिंस्रः<br><b>विस्तारः - </b>"नक्रस्तु वार्भटः स्यादम्बुकिरातोऽम्बुकण्टकः" - त्रिकाण्ड० ।<br><br>

अम्बुकीश
अम्बुकीश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೂರ್ಮ /ಆಮೆ<br><b>विस्तारः - </b>"जलकूर्मस्त्वम्बुकीशो वसाढ्यः शिशुकश्च सः" - त्रिकाण्ड० ।<br><br>

अम्बुकूर्म
अम्बुकूर्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೂರ್ಮ /ಆಮೆ<br><b>व्युत्पत्तिः - </b>अम्बुनः कूर्मः<br><b>विस्तारः - </b>"शिशुमारस्त्वम्बुकूर्म उष्णवीर्यो महावसः" - अभि० चि० ।<br><br>

अम्बुकेसर
अम्बुकेसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂಬೆ ಗಿಡ<br><br>

अम्बुज
अम्बुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಂಖ<br><br>अम्बुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><br>अम्बुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಕ್ಕರೆ<br><br>अम्बुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಪೂರ<br><br>अम्बुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ಹಲಸಿನ ಗಿಡ<br><br>अम्बुज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९७)<br><b>व्युत्पत्तिः - </b>अम्बुनि जायते । अम्बुनो जन्म यस्य वा ।<br><br>अम्बुज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ವಜ್ರಾಯುಧ<br><b>विस्तारः - </b>"शतधारं शतारं चाभ्रोत्थं भिदिरम्बुजम्" - त्रिकाण्ड० ।<br><br>अम्बुज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರಿನಲ್ಲಿ ಹುಟ್ಟಿದ<br><br>

अम्बुजन्मन्
अम्बुजन्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಂಖ'<br><br>अम्बुजन्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><br>अम्बुजन्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಕ್ಕರೆ<br><br>अम्बुजन्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಪೂರ<br><br>अम्बुजन्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ಹಲಸಿನ ಗಿಡ<br><br>अम्बुजन्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲ<br><br>अम्बुजन्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ವಜ್ರಾಯುಧ<br><br>अम्बुजन्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರಿನಲ್ಲಿ ಹುಟ್ಟಿದ<br><br>

अम्बुजासन
अम्बुजासन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ /ಚತುರ್ಮುಖ<br><br>

अम्बुजासना
अम्बुजासना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಮಿ<br><br>

अम्बुद
अम्बुद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>अम्बु ददाति<br><b>प्रयोगाः - </b>"प्रबुद्धमन्द्राम्बुदधीरनादः कृष्णार्णवाभ्यर्णचरैकहंसः"<br><b>उल्लेखाः - </b>माघ० ३-२१<br><br>अम्बुद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನ್ನಾರಿ ಗೆಡ್ಡೆ<br><br>अम्बुद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರನ್ನು ಕೊಡುವ<br><br>

अम्बुधर
अम्बुधर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><b>निष्पत्तिः - </b>धृञ् (धारणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अम्बुनो धरः<br><b>प्रयोगाः - </b>"शरदम्बुधरच्छायागत्वर्यो यौवनश्रियः" । "शरत्प्रमृष्टाम्बुधरोपरोधः" ।<br><b>उल्लेखाः - </b>किरा० ११-१२, रघु० ६-४४<br><br>अम्बुधर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನ್ನಾರಿ ಗೆಡ್ಡೆ<br><br>

अम्बुधि
अम्बुधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ /ಕಡಲು<br><b>निष्पत्तिः - </b>डुधाञ् (धारणे) - "किः" (३-३-९३)<br><b>व्युत्पत्तिः - </b>अम्बूनि धीयन्तेऽत्र<br><b>प्रयोगाः - </b>"बभूव नहुषस्तस्मिन् ऐरावत इवाम्बुधौ" । "रत्नावलीरम्बुधिराबबन्ध" ।<br><b>उल्लेखाः - </b>याद० १-१३, माघ० ३-३६<br><br>अम्बुधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ತುಂಬಿಡುವ ಪಾತ್ರೆ<br><br>अम्बुधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಲ್ಕು ಸಂಖ್ಯೆ<br><br>

अम्बुनिधि
अम्बुनिधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ /ಕಡಲು<br><b>निष्पत्तिः - </b>अम्बु + नि + डुधाञ् (धारणे) - "किः" (३-३-९३)<br><b>व्युत्पत्तिः - </b>अम्बूनि निधीयन्तेऽत्र<br><b>प्रयोगाः - </b>"त्वरितमम्बुनिधेरभिसारिकाम्" । "ये पक्षिणः प्रथमम्बुनिधिं गतास्ते" ।<br><b>उल्लेखाः - </b>याद० ३-३९, माघ० ५-३१<br><br>

अम्बुप
अम्बुप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರುಣ<br><b>निष्पत्तिः - </b>पा (रक्षणे) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>अम्बूनि पाति<br><br>अम्बुप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ /ಕಡಲು<br><br>अम्बुप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರನ್ನು ಕುಡಿಯುವ<br><b>निष्पत्तिः - </b>पा (पाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>अम्बूनि पिबति<br><br>

अम्बुप्रसाद
अम्बुप्रसाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಲ್ಲದ ಬೀಜ<br><b>निष्पत्तिः - </b>अम्बु + प्र + षद्लृ (विशरणादौ) + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अम्बूनि प्रसादयति<br><br>

अम्बुप्रसादन
अम्बुप्रसादन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಲ್ಲದ ಬೀಜ<br><b>निष्पत्तिः - </b>"ल्युः" (३-१-१३४)<br><br>

अम्बुकृत्
अम्बुकृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><b>निष्पत्तिः - </b>डुभृञ् (धारणपोषणयोः) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>अम्बु बिभर्ति<br><br>अम्बुकृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ /ಕಡಲು<br><br>अम्बुकृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನ್ನಾರಿ ಗೆಡ್ಡೆ<br><br>अम्बुकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರನ್ನು ಹೊರುವವನು<br><br>

अम्बुमुच्
अम्बुमुच्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><b>निष्पत्तिः - </b>मुच्लृ (मोक्षणे) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>अम्बूनि मुञ्चति<br><b>प्रयोगाः - </b>"विगलितजलभारशुक्लभासां निचय इवाम्बुमुचां नगाधिराजः"<br><b>उल्लेखाः - </b>किरा० ४-३७<br><br>

अम्बुराज
अम्बुराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರುಣ<br><br>अम्बुराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ /ಕಡಲು<br><b>निष्पत्तिः - </b>"टच्" (५-४-९१)<br><b>व्युत्पत्तिः - </b>अम्बूनां राजा<br><br>

अम्बुराशि
अम्बुराशि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ /ಕಡಲು<br><b>व्युत्पत्तिः - </b>अम्बूनां राशिर्यत्र<br><b>प्रयोगाः - </b>"प्रसक्तपातश्चरमाम्बुराशौ" । "भ्रमागतैरम्बुभिरम्बुराशिः" ।<br><b>उल्लेखाः - </b>याद० २-३९, माघ० ३-३८<br><br>

अम्बुरुह्
अम्बुरुह्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲ<br><b>निष्पत्तिः - </b>रुह (बीजजन्मनि प्रादुर्भावे च) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>अम्बुनि रोहति<br><b>प्रयोगाः - </b>"विसृत्वरैरम्बुरुहां रजोभिर्यमस्वसुश्चित्र इवोदभारः"<br><b>उल्लेखाः - </b>माघ० ३-११<br><br>

अम्बुरुह
अम्बुरुह<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲ<br><b>निष्पत्तिः - </b>रुह (बीजजन्मनि प्रादुर्भावे च) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>अम्बुनि रोहति<br><b>प्रयोगाः - </b>"श्रवणनियमितेन कान्तमन्या सममसिताम्बुरुहेण चक्षुषा च"<br><b>उल्लेखाः - </b>माघ० ७-५६<br><br>

अम्बुरुहा
अम्बुरुहा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಲಕಮಲ<br><br>

अम्बुरोहिणी
अम्बुरोहिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲಲತೆ<br><br>अम्बुरोहिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲಗಳಿಂದ ಕೂಡಿದ ದೇಶ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-१३५)<br><b>व्युत्पत्तिः - </b>अम्बुरुहाण्यत्र सन्ति<br><b>प्रयोगाः - </b>"नीयते स्म नतिमुज्झितहर्षं पङ्कजं मुखमिवाम्बुरुहिण्या"<br><b>उल्लेखाः - </b>किरा० ९-१४<br><br>

अम्बुवाह
अम्बुवाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><b>निष्पत्तिः - </b>वह (प्रापणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>अम्बूनि वहति<br><b>प्रयोगाः - </b>"रसन्नरोदीद्भृशमम्बुवर्षव्याजेन यस्या बहिरम्बुवाहः" ।<br><b>उल्लेखाः - </b>माघ० ३-४१<br><br>अम्बुवाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನ್ನಾರಿ ಗೆಡ್ಡೆ<br><br>अम्बुवाह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರನ್ನು ಹೊರುವವನು<br><br>

अम्बुवाहिन्
अम्बुवाहिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><b>निष्पत्तिः - </b>वह (प्रापणे) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अम्बूनि वहति<br><br>अम्बुवाहिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನ್ನಾರಿ ಗೆಡ್ಡೆ<br><br>अम्बुवाहिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರನ್ನು ಹೊರುವವನು<br><br>

अम्बुवाहिनी
अम्बुवाहिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಡಗಿನಿಂದ ನೀರನ್ನು ಹೊರಕ್ಕೆ ಚೆಲ್ಲಲು ಮಾಡಿರುವ ಮರದ ಪೀಪಾಯಿ<br><br>

अम्बुविहार
अम्बुविहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಲಕ್ರೀಡೆ /ನೀರಿನಲ್ಲಿ ಆಟವಾಡುವುದು<br><br>

अम्बुवेतस
अम्बुवेतस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ಹಬ್ಬೆಗಿಡ<br><br>

अम्बुसरण
अम्बुसरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲಪ್ರವಾಹ /ನೀರು ಹರಿಯುವುದು<br><br>

अम्बुसर्पिणी
अम्बुसर्पिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಗಣೆ /ಜಲೌಕೆ<br><b>निष्पत्तिः - </b>सृप्लृ (गतौ) -- "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अम्बुनि सर्पति<br><b>विस्तारः - </b>"पटालुका जलौकाम्बुसर्पिणी वेणिवेधिनी" - त्रिकाण्ड० ।<br><br>

अम्बूकृत
अम्बूकृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಫವು ಹೊರಡುವ ಸಮಯದಲ್ಲಿ ಆಡುವ ಮಾತು /ಬಾಯಲ್ಲಿ ಉಗುಳು ತುಂಬಿರುವಾಗ ಆಡುವ ಮಾತು<br><b>व्युत्पत्तिः - </b>अनम्बु अम्बु कृतम्<br><b>प्रयोगाः - </b>"अनुरसितगुरूणि स्त्यानमम्बूकृतानि"<br><b>उल्लेखाः - </b>मालती० ९-६<br><br>

अम्भस्
अम्भस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><b>निष्पत्तिः - </b>अभि (शब्दे) - "असुन्" (उ० ४-१८८)<br><b>व्युत्पत्तिः - </b>अम्बते<br><b>प्रयोगाः - </b>"अम्भोभिरुल्लङ्घिततुङ्गरोधसः प्रतीपनाम्नीः कुरुते स्म निम्नगाः" । "भयादिवाश्लिष्य झषायतेऽम्भसि" ।<br><b>उल्लेखाः - </b>माघ० १२-५७, किरा० ८-४६<br><br>अम्भस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><br>अम्भस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸುರ<br><br>अम्भस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮನುಷ್ಯ<br><br>अम्भस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಗ್ನದಿಂದ ನಾಲ್ಕನೆಯ ಸ್ಥಾನ<br><br>अम्भस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಿತೃಲೋಕ<br><br>अम्भस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾಶ ಮತ್ತು ಭೂಮಿ<br><br>

अम्भसान्निधि
अम्भसान्निधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ /ಕಡಲು<br><b>निष्पत्तिः - </b>षष्ठ्या अलुक् बाहु० ।<br><b>प्रयोगाः - </b>"शिखाभिराश्लिष्ट इवाम्भसान्निधिः"<br><b>उल्लेखाः - </b>माघ० १-२०<br><br>

अम्भोज
अम्भोज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><br>अम्भोज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಂಖ<br><br>अम्भोज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಕ್ಕರೆ<br><br>अम्भोज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಪೂರ<br><br>अम्भोज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲ<br><b>निष्पत्तिः - </b>जनि (प्रादुर्भावे) - "डः" (३-२-९७)<br><b>व्युत्पत्तिः - </b>अम्भसि जायते<br><b>प्रयोगाः - </b>"संसर्पिभिः पयसि गैरिकरेणुरागैरम्भोजगर्भरजसाङ्गनिषङ्गिणा च"<br><b>उल्लेखाः - </b>माघ० ५-३९<br><br>अम्भोज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರಿನಲ್ಲಿ ಹುಟ್ಟಿದ<br><br>

अम्भोजजन्मन्
अम्भोजजन्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ /ಚತುರ್ಮುಖ<br><b>व्युत्पत्तिः - </b>अम्भोजे जन्मास्य<br><br>

अम्भोजजात
अम्भोजजात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ /ಚತುರ್ಮುಖ<br><b>व्युत्पत्तिः - </b>अम्भोजे जातः<br><br>

अम्भोजयोनि
अम्भोजयोनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ /ಚತುರ್ಮುಖ<br><b>व्युत्पत्तिः - </b>अम्भोजं योनिरुत्पत्तिस्थानं यस्य<br><br>

अम्भोजिनी
अम्भोजिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲಗಳಿಂದ ಕೂಡಿದ ದೇಶ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-१३५)<br><b>व्युत्पत्तिः - </b>अम्भोजान्यत्र सन्ति<br><br>अम्भोजिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲಗಳ ಸಮೂಹ<br><br>अम्भोजिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲ ಲತೆ<br><br>

अम्भोद
अम्भोद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>अम्भो ददाति<br><b>प्रयोगाः - </b>"दृप्तारिसन्त्रासखिलीकृतात्स कथञ्चिदम्भोदविहारमार्गात्"<br><b>उल्लेखाः - </b>कुमा० १२-२<br><br>अम्भोद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನ್ನಾರಿ ಗೆಡ್ಡೆ<br><br>अम्भोद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರನ್ನು ಕೊಡುವ<br><br>

अम्भोधर
अम्भोधर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><br>अम्भोधर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನ್ನಾರಿ ಗೆಡ್ಡೆ<br><b>व्युत्पत्तिः - </b>अम्भसां धरः<br><b>प्रयोगाः - </b>"नवोद्यदम्भोधरघोरदर्शने युद्धाय रूढो मकरे महत्तरे"<br><b>उल्लेखाः - </b>कुमा० १४-९<br><br>

अम्भोधि
अम्भोधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ /ಕಡಲು<br><b>निष्पत्तिः - </b>डुधाञ् (धारणपोषणयोः) - "किः" (३-३-९३)<br><b>व्युत्पत्तिः - </b>अम्भांसि धीयन्तेऽत्र<br><b>प्रयोगाः - </b>"अपारममृताम्भोधिममन्यन्त दिवौकसः"<br><b>उल्लेखाः - </b>याद० १-७४<br><br>

अम्भोनिधि
अम्भोनिधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ /ಕಡಲು<br><b>निष्पत्तिः - </b>अम्भस् + नि + डुधाञ् (धारणपोषणयोः) - "किः" (३-३-९३)<br><b>व्युत्पत्तिः - </b>अम्भांसि निधीयन्तेऽत्र<br><b>प्रयोगाः - </b>"अम्भोनिधेरन्तरयन्ति घोषान्"<br><b>उल्लेखाः - </b>याद० १८-११५<br><br>

अम्भोमुच्
अम्भोमुच्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><b>निष्पत्तिः - </b>मुच्लृ (मोक्षणे) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>अम्भांसि मुचन्ति<br><b>प्रयोगाः - </b>"काले कालियकायकालवपुषः पांसून् गजाम्भोमुचः"<br><b>उल्लेखाः - </b>माघ० १७-६९<br><br>

अम्भोराशि
अम्भोराशि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ /ಕಡಲು<br><b>व्युत्पत्तिः - </b>अम्भसां राशिर्यत्र<br><br>

अम्भोरुह्
अम्भोरुह्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲ /ತಾವರೆ ಹೂವು<br><b>निष्पत्तिः - </b>रुह (बीजजन्मनि प्रादुर्भावे च) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>अम्भसि रोहति<br><br>अम्भोरुह्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಕ್ಕರೆ /ನೀರುಹಕ್ಕಿ<br><br>

अम्भोरुह
अम्भोरुह<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲ /ತಾವರೆ ಹೂವು<br><b>निष्पत्तिः - </b>रुह (बीजजन्मनि प्रादुर्भावे च) - "कः" (३-१-१३५)<br><b>प्रयोगाः - </b>"दधानम्भोरुहकेसरद्युतीर्जटाः शरच्चन्द्रमरीचिरोचिषम्" । "अम्भोरुहाणामवलेपसीमाम्" ।<br><b>उल्लेखाः - </b>माघ० १-५, याद० १३-७०<br><br>अम्भोरुह<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಕ್ಕರೆ /ನೀರುಹಕ್ಕಿ<br><br>

अम्मय
अम्मय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಲವಿಕಾರ<br><br>अम्मय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರಿನಿಂದ ತುಂಬಿದ<br><b>निष्पत्तिः - </b>"मयट्" (वा० ४-३-१४४)<br><b>व्युत्पत्तिः - </b>अपां विकारः<br><br>

अम्मयी
अम्मयी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अम्मय ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

अम्ब्ल
अम्ब्ल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಳಿ /ಆಮ್ಲರಸ /ಆರು ಭೋಜ್ಯರಸಗಳಲ್ಲೊಂದು<br><b>निष्पत्तिः - </b>अबि (शब्दे) - "क्लः" (उ० ४-१०८)<br><br>अम्ब्ल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಳಿಹಬ್ಬೆ ಗಿಡ<br><br>अम्ब्ल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂಬೆ ಗಿಡ<br><br>अम्ब्ल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಜ್ಜಿಗೆ<br><br>अम्ब्ल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂಬೆ ಹಣ್ಣು<br><br>अम्ब्ल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಳಿಯಾಗಿರುವ /ಆಮ್ಲರಸದಿಂದ ಕೂಡಿದ<br><br>

अम्ल
अम्ल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>अम्ब्ल ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अम (गत्यादौ) - "क्लः" बाहु० ।<br><b>प्रयोगाः - </b>"कट्वम्ललवणात्युष्णतीक्ष्णरूक्षविदाहिनः । आहार राजसस्येष्टाः"<br><b>उल्लेखाः - </b>गीता० १७-९<br><br>

अम्लक
अम्लक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಜನಿಂಬೆ ಗಿಡ<br><br>अम्लक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಜನಿಂಬೆ ಹಣ್ಣು<br><br>

अम्लकेसर
अम्लकेसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾದಳದ ಗಿಡ<br><br>अम्लकेसर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾದಳದ ಹಣ್ಣು<br><br>

अम्लजम्बीर
अम्लजम्बीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂಬೆ ಗಿಡ<br><br>अम्लजम्बीर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂಬೆ ಹಣ್ಣು<br><br>

अम्लनिशा
अम्लनिशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಚೋರದ ಗಿಡ<br><br>

अम्लपञ्चक
अम्लपञ्चक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>೫ ಹುಳಿಯ ಹಣ್ಣುಗಳು<br><b>व्युत्पत्तिः - </b>अम्लानां पञ्चकम्<br><b>प्रयोगाः - </b>"जम्बीरं नागरङ्गं च तथाम्लं वेतसं पुनः । तिन्तिडीकं बीजपूरमम्लपञ्चफलं स्मृतम् ॥"<br><br>

अम्लपम्नस
अम्लपम्नस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಜನಿಂಬೆ ಗಿಡ<br><br>अम्लपम्नस<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಜನಿಂಬೆ ಹಣ್ಣು<br><br>

अम्लपित्त
अम्लपित्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ರೋಗ /ತಿಂದ ಆಹಾರವನ್ನು ಹುಳಿಯನ್ನಾಗಿ ಮಾಡುವ ಒಂದು ರೋಗ<br><br>

अम्लपूर
अम्लपूर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹುಣಸೆ ಹಣ್ಣು<br><b>निष्पत्तिः - </b>पूर (पूरणे) + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अम्लं पूरयति<br><br>

अम्लफल
अम्लफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಣಸೆ ಮರ<br><br>अम्लफल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹುಣಸೆ ಹಣ್ಣು<br><br>

अम्लरस
अम्लरस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಳಿ<br><br>अम्लरस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಳಿಯಾಗಿರುವ /ಆಮ್ಲರಸದಿಂದ ಕೂಡಿದ<br><br>

अम्ललोणिका
अम्ललोणिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಲ್ಲಂಪುರಿಚಿ ಗಿಡ<br><br>

अम्लवर्ग
अम्लवर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಳಿಯಿಂದ ಕೂಡಿದ ಅಸ್ತುಗಳ ಗುಂಪು<br><br>

अम्लवास्तूक
अम्लवास्तूक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಳಿಹಬ್ಬೆ ಗಿಡ<br><br>

अम्लवृक्ष
अम्लवृक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಣಸೆ ಮರ<br><br>

अम्लवेतस
अम्लवेतस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಳಿಹಬ್ಬೆ ಗಿಡ<br><br>

अम्लसार
अम्लसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂಬೆ ಗಿಡ<br><br>अम्लसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಳಿಹಬ್ಬೆ ಗಿಡ<br><br>अम्लसार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಬಲಿ /ಗಂಜಿ<br><br>

अम्लान
अम्लान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೊಡ್ಡಗೋರಂಟಿ<br><br>अम्लान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾಡದಿರುವ<br><br>

अम्लिका
अम्लिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹುಣಸೆ ಮರ<br><br>अम्लिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಲ್ಲಂಪುರಿಚಿ ಗಿಡ<br><br>अम्लिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹುಳಿತೇಗು<br><br>

अम्लिी
अम्लिी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಲ್ಲಂಪುರಿಚಿ<br><br>

अम्लोद्गार
अम्लोद्गार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಳಿತೇಗು<br><br>

अय
अय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೂರ್ವಜನ್ಮದ ಪುಣ್ಯಕಾರ್ಯ<br><br>अय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಳ್ಳೆಯ ಅದೃಷ್ಟ /ಒಳ್ಳೆಯದನ್ನಂಟುಮಾಡುವ ಭಾಗ್ಯ<br><b>निष्पत्तिः - </b>इण् (गतौ) - "घः" (३-३-११८)<br><b>व्युत्पत्तिः - </b>एति सुखमनेन<br><b>प्रयोगाः - </b>"स गुप्तमूलप्रत्यन्तः शुद्धपार्ष्णिरयान्वितः"<br><b>उल्लेखाः - </b>रघु० ४-२६<br><br>अय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಗಡೆಯ ದಾಳ<br><b>व्युत्पत्तिः - </b>अयते जयमनेन<br><br>

अयःपान
अयःपान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪಮಾಡಿದವರಿಗೆ ಕರಗಿಸಿದ ಕಬ್ಬಿಣವನ್ನು ಕುಡಿಯಿಸುವ ಒಂದು ನರಕ<br><br>

अयःशूल
अयःशूल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಈಟಿ /ಭರ್ಜಿ /ಕುಂತ<br><br>अयःशूल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ತೀಕ್ಷ್ಣವಾದ ಉಪಾಯ<br><br>

अयज्ञिय
अयज्ञिय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಜ್ಞಕ್ಕೆ ಯೋಗ್ಯವಲ್ಲದ /ಯಜ್ಞಕರ್ಮಕ್ಕೆ ಅರ್ಹವಲ್ಲದ<br><b>निष्पत्तिः - </b>यज्ञ - "घः" (५-१-७१) । न० त० ।<br><b>व्युत्पत्तिः - </b>न यज्ञमर्हति<br><br>अयज्ञिय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಜ್ಞವನ್ನು ಮಾಡಲು ಅರ್ಹನಲ್ಲದ<br><br>अयज्ञिय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಜ್ಞಕಾಲದಲ್ಲಿ ಆಡಬಾರದ ಅಸಭ್ಯ ಮಾತು<br><br>

अयत
अयत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯ ನಿಗ್ರಹವಿಲ್ಲದ<br><b>निष्पत्तिः - </b>यम (उपरमे) - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>यम्यते<br><br>अयत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನವಿಲ್ಲದ<br><b>निष्पत्तिः - </b>यती (प्रयत्ने) - "क्तः" (३-४-७२)<br><b>व्युत्पत्तिः - </b>यतते<br><br>

अयति
अयति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನವಿಲ್ಲದ<br><b>प्रयोगाः - </b>"अयतिः श्रद्धयोपेतः योगाच्चलितमानसः"<br><b>उल्लेखाः - </b>गीता० ६-३७<br><br>

अयत्न
अयत्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯತ್ನವಿಲ್ಲದಿರುವಿಕೆ /ಆಯಾಸವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न यत्नः<br><b>प्रयोगाः - </b>"तदावाप्नोत्ययत्नेन यो हिनस्ति न किञ्चन"<br><b>उल्लेखाः - </b>मनु० ५-४७<br><br>अयत्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನವಿಲ್ಲದ<br><br>

अयथा
अयथा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯವಾಗಿ<br><br>अयथा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಇರಬೇಕಾದುದಕ್ಕಿಂತಲೂ ಬೇರೆ ರೀತಿಯಾಗಿ /ಅಕ್ರಮವಾಗಿ /ಸುಳ್ಳಾಗಿ<br><br>

अयथातथ
अयथातथ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಜವಲ್ಲದ /ಸುಳ್ಳಾದ<br><b>निष्पत्तिः - </b>न ० त०<br><b>व्युत्पत्तिः - </b>तथात्वमनतिक्रम्य यथातथम् ।<br><br>

अयथार्थ
अयथार्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಥಕ್ಕೆ ಅನುಸಾರವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न यथार्थः<br><b>प्रयोगाः - </b>"परित्यक्तान्यार्थो नियतमयथार्थः"<br><b>उल्लेखाः - </b>मुद्रा० ३-४<br><br>अयथार्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಜವಲ್ಲದ /ಯೋಗ್ಯವಲ್ಲದ<br><b>प्रयोगाः - </b>"अयथार्थक्रियारम्भैः पतिभिः किं तवेक्षितैः"<br><b>उल्लेखाः - </b>किरा० ११-५२<br><br>

अयथार्थानुभव
अयथार्थानुभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅದಲ್ಲದ ಬೇರೊಂದು ವಸ್ತುವಿನಲ್ಲಿ ಅದು ಎಂಬ ತಪ್ಪು ತಿಳುವಳಿಕೆ ಜ್ಞಾನ<br><b>निष्पत्तिः - </b>न० त० ।<br><b>व्युत्पत्तिः - </b>अयथार्थश्च असावनुभवश्च<br><b>प्रयोगाः - </b>"तदभाववति तत्प्रकारकानुभवोऽयथार्थानुभवः ।"<br><br>

अयथावत्
अयथावत्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನುರೂಪವಲ್ಲದೆ /ಅಯೋಗ್ಯವಾಗಿ /ಅಕ್ರಮವಾಗಿ<br><br>

अयन
अयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಮನ /ಸಂಚಾರ<br><b>निष्पत्तिः - </b>अय (गतौ) - "ल्युट्" (३-३-११५)<br><br>अयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಷಾದಿ ೧೨ ರಾಶಿಗಳಲ್ಲಿ ಸೂರ್ಯನ ಗತಿ<br><br>अयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯಸ್ಥಾನ /ಪ್ರಾಪ್ಯಸ್ಥಾನ<br><b>प्रयोगाः - </b>"आपो नारा इति प्रोक्ता आपो वै नरसूनवः । ता यदस्यायनं पूर्वं तेन नारायणः स्मृतः ॥"<br><b>उल्लेखाः - </b>मनु० १-१०<br><br>अयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೈನ್ಯವ್ಯೂಹದ ಪ್ರವೇಶ ಮಾರ್ಗ<br><b>प्रयोगाः - </b>"अयनेषु च सर्वेषु यथाभागमवस्थिताः । भीष्ममेवाभिरक्षन्तु भवन्तः सर एव हि ।"<br><b>उल्लेखाः - </b>गीता० १-११<br><br>अयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾರ್ಗ /ದಾರಿ<br><b>प्रयोगाः - </b>"अगस्त्यचिह्नादयनात्"<br><b>उल्लेखाः - </b>रघु० १६-४४<br><br>अयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಯಾಗ<br><br>अयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಯನಾಭಿಮಾನಿ ದೇವತೆ<br><br>अयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಕ್ರಾಂತಿಯ ಸಮಯ<br><br>अयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಕ್ಷ /ಮುಕ್ತಿ<br><b>प्रयोगाः - </b>"तमेव विदित्वाऽतिमृत्युमेति नान्यः पन्था अयनाय विद्यते"<br><b>उल्लेखाः - </b>श्रुतिः<br><br>अयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹ /ಮನೆ<br><br>अयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಾನ /ಜಾಗ<br><br>अयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಯನದ ವಿಷಯವನ್ನು ತಿಳಿಸುವ ಶಾಸ್ತ್ರ<br><br>

अयनकाल
अयनकाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಕರಸಂಕ್ರಾಂತಿಯಿಂದ ಕರ್ಕಾಟಕ ಸಂಕ್ರಾಂತಿ ಮತ್ತು ಕರ್ಕಾಟಕ ಸಂಕ್ರಾಂತಿಯಿಂದ ಮಕರ ಸಂಕ್ರಾಂತಿ ಇವುಗಳ ಮಧ್ಯ ಕಾಲ<br><br>

अयन्त्रित
अयन्त्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಡ್ಡಿಯಿಲ್ಲದ /ನಿರ್ಬಂಧವಿಲ್ಲದ<br><br>

अयव
अयव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಲದಲ್ಲಿ ಹುಟ್ಟಿದ ಕ್ರಿಮಿ<br><br>अयव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರು<br><b>निष्पत्तिः - </b>यु (मिश्रणाऽमिश्रणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>न यौति सम्बध्नाति<br><br>अयव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಪಕ್ಷ<br><br>अयव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯವ ಸಂಬಂಧವಿಲ್ಲದ /ತಿಲದಿಂದ ಮಾಡುವ ಪಿತೃಕರ್ಮ<br><b>व्युत्पत्तिः - </b>न विद्यते यवो यत्र<br><br>

अयशस्
अयशस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪವಾದ /ಅಪಕೀರ್ತಿ<br><b>प्रयोगाः - </b>"अयशोभिदुरालोके कोपधा मरणादृते"<br><b>उल्लेखाः - </b>माघ० १९-५८<br><br>अयशस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೀರ್ತಿ ಪಡೆಯದ /ಹೆಸರು ಪಡೆಯದ<br><br>

अयशस्कर
अयशस्कर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಕೀರ್ತಿಯನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "टः" (३-२-२०)<br><b>व्युत्पत्तिः - </b>अयशः करोति<br><br>

अयशस्करी
अयशस्करी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಕೀರ್ತಿಯನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

अयशस्य
अयशस्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಕೀರ್ತಿಯನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>"यत्" (५-१-५) । न० त० ।<br><b>व्युत्पत्तिः - </b>यशसे हितम् । न यशस्यम् ।<br><br>

अयश्चूर्ण
अयश्चूर्ण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣದ ಪಡಿ /ಕಬ್ಬಿಣದ ಪುಡಿಯಿಂದ ತಯಾರಿಸಿದ ಔಷಧ /ಅಯೋಭಸ್ಮ<br><br>

अयस्
अयस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣ<br><b>निष्पत्तिः - </b>अय (गतौ) - "असुन्" (उ० ४-१८८)<br><br>अयस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಕ್ಕು<br><br>

अयस्कंस
अयस्कंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಕ್ಕಿನಿಂದ ತಯಾರಾದ ಕುಡಿಯುವ ಬಟ್ಟಲು<br><br>

अयस्कान्त
अयस्कान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಜಿಗಲ್ಲು /ಲೋಹಚುಂಬಕ /ಲೋಹಗಳನು ಆಕರ್ಷಿಸುವ ಕಬ್ಬಿಣದ ಅದುರು<br><b>व्युत्पत्तिः - </b>अयस्सु कान्तः<br><b>प्रयोगाः - </b>"शम्भोर्यतध्वमाक्रष्टुमयस्कान्तेन लोहवत्"<br><b>उल्लेखाः - </b>कुमा० २-५९<br><br>

अयस्कार
अयस्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮ್ಮಾರ /ಕಬ್ಬಿಣದ ಕೆಲಸ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "अण्" (३-२-१) । सुट् (८-३-४६)<br><b>व्युत्पत्तिः - </b>अयः अयोविकारं करोति<br><br>

अयस्कुम्भ
अयस्कुम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣದ ಬಿಂದಿಗೆ<br><br>

अयस्कुशा
अयस्कुशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣದ ಸರಪಣಿಯಿಂದ ಕೂಡಿದ ಹಗ್ಗ<br><b>व्युत्पत्तिः - </b>अयःसहिता कुशा<br><br>

अयस्कृति
अयस्कृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಷ್ಠರೋಗದ ಚಿಕಿತ್ಸೆ<br><br>

अयाचित
अयाचित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಚಿಸದೆ ದೊರೆತ ಭಿಕ್ಷೆ<br><br>अयाचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾಚಿಸಲ್ಪಡದ /ಬೇಡಲ್ಪಡದ<br><br>

अयाज्य
अयाज्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾಗಕ್ಕೆ ಅರ್ಹನಲ್ಲದ /ಯಾಗ ಮಾಡಿಸಲು ಯೋಗ್ಯನಲ್ಲದ /ಪತಿತ<br><b>निष्पत्तिः - </b>यज (देवपूजायाम्) - "ण्यत्" (३-१-१२४)<br><b>व्युत्पत्तिः - </b>न याजयितुमर्हः<br><br>

अयाज्ययाजन
अयाज्ययाजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗಕ್ಕೆ ಅನರ್ಹನಾದವನಿಂದ ಯಾಗವನ್ನು ಮಾಡಿಸುವುದು /ಪತಿತನಿಂದ ಯಾಗ ಮಾಡಿಸುವುದು<br><br>

अयातयाम
अयातयाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಳೆಯದಲ್ಲದ /ಹೊಸದಾದ /ಉಪಯೋಗಿಸಲ್ಪಡದ<br><br>अयातयाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೋಷವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न यातो यामो यस्य<br><br>

अयान
अयान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಭಾವ<br><b>व्युत्पत्तिः - </b>न यानं चलनं यस्य<br><br>अयान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಚಾರವಿಲ್ಲದಿರುವಿಕೆ<br><br>अयान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಚಾರವಿಲ್ಲದ<br><br>

अयि
अयि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿಯಿಂದ ಮಾಡುವ ಸಂಬೋಧನೆ<br><b>प्रयोगाः - </b>"अयि, विवेकविश्रान्तमभिहितम्"<br><b>उल्लेखाः - </b>माल० १<br><br>अयि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ದೈನ್ಯದಿಂದ ಮಾಡುವ ಸಂಬೋಧನೆ<br><b>प्रयोगाः - </b>"अयि कवलय माममू विमुञ्चेत्यतिकरुणं रुदतीमवेक्ष्य सीताम्"<br><b>उल्लेखाः - </b>चं० रा०<br><br>अयि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನುನಯ /ಪ್ರಾರ್ಥನೆ<br><b>प्रयोगाः - </b>"अयि सम्प्रति देहि दर्शनम्"<br><b>उल्लेखाः - </b>कुमा० ४-२८<br><br>अयि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ /ಕೇಳಿಕೆ<br><b>प्रयोगाः - </b>"अयि जीवितनाथ जीवसि"<br><b>उल्लेखाः - </b>कुमा० ४-३<br><b>विस्तारः - </b>"अयि प्रश्नानुननययोस्तथा सम्बोधनेऽपि च" - मेदि० ।<br><br>

अयुक्छद
अयुक्छद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಏಳೆಲೆ ಬಾಳೆಯ ಗಿಡ<br><br>

अयुक्त
अयुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯವಾದ /ಅನುಚಿತವಾದ<br><b>प्रयोगाः - </b>"अयुक्तरूपं कुमतःपरं वद"<br><b>उल्लेखाः - </b>कुमा० ५-६९<br><br>अयुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇರಿಕೊಂಡಿಲ್ಲದ /ಬೇರೆಯಾಗಿರುವ<br><br>अयुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದಾಸೀನ /ಕರ್ತವ್ಯಪರಾಙ್ಮುಖ<br><br>अयुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಥಿರಚಿತ್ತವಿಲ್ಲದವನು /ಚಿತ್ತವೃತ್ತಿನಿರೋಧವಿಲ್ಲದವನು<br><br>अयुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರೀಯಕರ್ಮಕ್ಕೆ ಯೋಗ್ಯನಲ್ಲದವನು<br><b>प्रयोगाः - </b>"अयुक्तः प्राकृतः स्तब्धः शठो नैकृतिकोऽलसः"<br><b>उल्लेखाः - </b>गीता० १८-२८<br><br>अयुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಷ್ಟಕ್ಕೊಳಗಾದ /ಪೇಚಾಟಕ್ಕೆ ಸಿಲುಕಿದ<br><br>अयुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಿವಾಹಿತ /ಮದೆವೆಯಿಲ್ಲದವನು<br><br>

अयुक्ति
अयुक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯುಕ್ತಿಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अयुक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಲಿಕೆ /ವಿರಹ<br><br>अयुक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನರ್ಹತೆ /ಅಯೋಗ್ಯತೆ<br><br>

अयुग
अयुग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಮ /ಬೆಸ<br><br>अयुग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೊಗವಿಲ್ಲದ ರಥ<br><br>अयुग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆಸಸಂಖ್ಯೆಯುಳ್ಳ /ಸಮ ಸಂಖ್ಯೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न युगमत्र<br><b>प्रयोगाः - </b>"युगपदयुगसप्तिस्तुल्यसङ्ख्यैर्मयूखैः"<br><b>उल्लेखाः - </b>माघ० ११-६१<br><br>

अयुग्म
अयुग्म<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಮ /ಬೆಸ<br><br>अयुग्म<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆಸಸಂಖ್ಯೆಯುಳ್ಳ /ಸಮ ಸಂಖ್ಯೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न युग्ममत्र<br><b>प्रयोगाः - </b>"अथेन्द्रियक्षोभमयुग्मनेत्रः"<br><b>उल्लेखाः - </b>कुमा० ३-६९<br><br>

अयुग्मच्छद
अयुग्मच्छद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಏಳೆಲೆ ಬಾಳೆಯ ಗಿಡ<br><b>व्युत्पत्तिः - </b>अयुग्माः छदाः पत्राणि यस्य<br><b>प्रयोगाः - </b>"नयत्ययुग्मच्छदगन्धिरार्द्रताम्"<br><b>उल्लेखाः - </b>किरा० १-१६<br><br>

अयुग्मनेत्र
अयुग्मनेत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ /ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>अयुग्मानि नेत्राणि यस्य<br><b>प्रयोगाः - </b>"अथेन्द्रियक्षोभमयुग्मनेत्रः"<br><b>उल्लेखाः - </b>कुमा० ३-६९<br><br>अयुग्मनेत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಮೀನರಸಿಂಹ<br><br>अयुग्मनेत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುದರ್ಶನ /ವಿಷ್ಣುಚಕ್ರ<br><br>

अयुग्मनयन
अयुग्मनयन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ /ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>अयुग्मानि नयनानि यस्य<br><br>अयुग्मनयन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಮೀನರಸಿಂಹ<br><br>अयुग्मनयन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುದರ್ಶನ /ವಿಷ್ಣುಚಕ್ರ<br><br>

अयुग्मलोचन
अयुग्मलोचन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ /ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>अयुग्मानि लोचनानि यस्य<br><br>अयुग्मलोचन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಮೀನರಸಿಂಹ<br><br>अयुग्मलोचन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುದರ್ಶನ /ವಿಷ್ಣುಚಕ್ರ<br><br>

अयुग्मबाण
अयुग्मबाण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥ /ಕಾಮ<br><b>व्युत्पत्तिः - </b>अयुग्माः पञ्च बाणाः यस्य<br><br>

अयुग्मशर
अयुग्मशर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥ /ಕಾಮ<br><b>व्युत्पत्तिः - </b>अयुग्माः पञ्च शराः यस्य<br><br>

अयुज्
अयुज्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಷಮ ಸಂಖ್ಯೆಯ /ವಿಷಮ ಸ್ಥಾನದ<br><b>प्रयोगाः - </b>"अयुग्भवा चारुहासिनी" । "चपलावक्त्रमयुजोर्नकारश्चेत्पयोराशेः"<br><b>उल्लेखाः - </b>वृ० र०<br><br>

अयुत
अयुत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಶಸಹಸ್ರ /ಹತ್ತುಸಾವಿರ<br><br>अयुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತು ಸಾವಿರವುಳ್ಳ<br><b>विस्तारः - </b>"अयुतं दशसाहस्रम्" - अम० ।<br><br>अयुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇರಿಕೊಂಡಿಲ್ಲದ /ಬೆರೆಯದಿರುವ<br><br>

अयुतसिद्ध
अयुतसिद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯ ಮತ್ತು ಕಾರಣಗಳು ಬೇರೆ ಬೇರೆಯಿರದೆ ಒಟ್ಟಿಗೆ ಸೇರಿ ಸಿದ್ಧವಾದ<br><b>व्युत्पत्तिः - </b>युतः पृथग्भूतःसन् सिद्धः<br><br>

अयुतसिद्धि
अयुतसिद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯಕಾರಣಗಳು ಬೇರೆ ಬೇರೆಯಿರದೆ ಒಟ್ಟಿಗೆ ಕಲೆತು ಸಿದ್ಧಿಸುವುದು<br><br>

अयुताजित्
अयुताजित्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯದುವಂಶದ ಒಬ್ಬ ದೊರೆ<br><b>प्रयोगाः - </b>"अयुताजित् सहस्राजित् शताजिदथ दासकः"<br><b>उल्लेखाः - </b>हरिवं०<br><br>

अयुतायु
अयुतायु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯವಂಶದ ಒಬ್ಬ ದೊರೆ<br><br>

अये
अये<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಭ್ರಮ<br><br>अये<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಶ್ಚರ್ಯ<br><b>प्रयोगाः - </b>"अये, कथमार्यः पाञ्चाल्याः चतुःशालकं प्रति प्रस्थितः"<br><b>उल्लेखाः - </b>वेणी०<br><br>अये<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೋಪ<br><b>प्रयोगाः - </b>"अये, अश्वमेध इति विश्वजयिनां क्षत्रियाणां माहनुत्कर्षनिकर्षः"<br><b>उल्लेखाः - </b>उ० रा० ४<br><br>अये<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸ್ಮರಣೆ /ನೆನಪು<br><b>प्रयोगाः - </b>"अये, कुसुमपुरवृत्तान्तज्ञः अहं भवत्प्रणिधिश्चेति गतार्थः"<br><b>उल्लेखाः - </b>मुद्रा० २<br><br>अये<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಭಯ<br><b>प्रयोगाः - </b>"अये, तत्कथं सत्यमेव कुपित आर्यः"<br><b>उल्लेखाः - </b>मुद्रा० ३<br><br>अये<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಬೋಧನೆ<br><b>प्रयोगाः - </b>"अये, कले, भद्रमव्याहतम्"<br><b>उल्लेखाः - </b>प्रबोध० २<br><br>अये<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ದುಃಖ<br><b>प्रयोगाः - </b>"अये, देवपादपद्मोपजीविनोऽवस्थेयम्"<br><b>उल्लेखाः - </b>मुद्रा० २<br><b>विस्तारः - </b>"अये क्रोधविषादयोः । सम्भ्रमे स्मरणे च" - हेम० ।<br><br>

अयोग
अयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧವಿಲ್ಲದಿರುವಿಕೆ<br><br>अयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿಥಿವಾರಾದಿಗಳ ಕೆಟ್ಟಯೋಗ<br><b>निष्पत्तिः - </b>अप्राशस्त्ये न० त० ।<br><br>अयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಧುರ<br><b>विस्तारः - </b>"अयोगो विधुरोऽपि च" - त्रिकाण्ड० ।<br><br>अयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರುಚಿ /ಅಪ್ರೀತಿ<br><br>अयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುತ್ತಿಗೆ<br><br>अयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಯೋಗ<br><br>अयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಷ್ಟವಾದ ಪ್ರಯತ್ನ<br><br>अयोग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧವಿಲ್ಲದ<br><b>विस्तारः - </b>"अयोगः कठोनोद्यमे । विश्लेषे विधुरे कूटे" - हेम० ।<br><br>

अयोगव
अयोगव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೂದ್ರನಿಗೆ ವೈಶ್ಯ ಹೆಂಗಸಿನಲ್ಲಿ ಹುಟ್ಟಿದ ಬೆರಕೆ ಜಾತಿಯವನು<br><b>प्रयोगाः - </b>"शूद्रादयोगवः क्षत्ता चण्डालश्चाधमो नृणाम् । वैश्यराजन्यविप्रासु जायन्ते वर्णसङ्कराः ॥"<br><b>उल्लेखाः - </b>मनु० १०-१२<br><br>

अयोगवाह
अयोगवाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಸ್ವಾರ, ವಿಸರ್ಗ, ಜಿಹ್ವಾಮೂಲೀಯ, ಮತ್ತು ಉಪಧ್ಮಾನೀಯಗಳು<br><b>व्युत्पत्तिः - </b>नास्ति योगः वर्णसमाम्नायसूत्रेषु सम्बन्धो येषां ते । न विद्यते योगः संयोगः वर्णान्तरेण येषां ते इति वा । तथाभूताः सन्तः वाहयन्ति प्रयोगं निष्पादयन्ति ।<br><b>विस्तारः - </b>"अनुस्वारो विसर्गश्च क पौ चैव पराश्रितौ । अयोगवाहा विज्ञेया आश्रयस्थानभागिनः ॥"<br><br>

अयोग्य
अयोग्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನರ್ಹವಾದ<br><br>अयोग्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಚಿತವಾದ<br><br>

अयोग्र
अयोग्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಸಲ /ಒನಕೆ<br><b>व्युत्पत्तिः - </b>अयः अग्रे यस्य<br><br>

अयोघन
अयोघन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುತ್ತಿಗೆ /ಚಮ್ಮಟಿಗೆ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) - "अप्" घनादेशश्च (३-३-८२)<br><b>व्युत्पत्तिः - </b>अयांसि हन्यतेऽनेन<br><br>

अयोजाल
अयोजाल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣದ ಒಲೆ<br><b>व्युत्पत्तिः - </b>अयोमयं जालम्<br><br>अयोजाल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಾಕ್ಷಸಸ್ವಭಾವದ<br><b>व्युत्पत्तिः - </b>अय इव जालमस्य<br><br>

अयोध्य
अयोध्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯುದ್ಧಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲದ<br><b>निष्पत्तिः - </b>युध (सम्प्रहारे) - "ण्यत्" (३-१-१२४)<br><b>व्युत्पत्तिः - </b>योद्धुं शक्यः । न योध्यः ।<br><br>

अयोध्या
अयोध्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಯೋಧ್ಯಾನಗರ /ಇಕ್ಷ್ವಾಕುವಂಶದ ದೊರೆಗಳ ರಾಜಧಾನಿ<br><b>प्रयोगाः - </b>"अयोध्या मधुरा माया काशी काञ्ची अवन्तिका । पुरी द्वारावती चैव सप्तैता मोक्षदायिकाः ॥"<br><br>

अयोध्याकाण्ड
अयोध्याकाण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಯೋಧ್ಯಾನಗರದಲ್ಲಿ ನಡೆದ ವೃತ್ತಾಂತವನ್ನು ವರ್ಣಿಸುವ ಗ್ರಂಥಭಾಗ<br><br>

अयोनि
अयोनि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿಯಿಲ್ಲದ /ನಿತ್ಯವಾದ<br><b>व्युत्पत्तिः - </b>नास्ति योनिरुत्पत्तिस्थानं यस्य<br><b>प्रयोगाः - </b>"जगद्योनिरयोनिस्त्वं जगदन्तो निरन्तकः"<br><b>उल्लेखाः - </b>कुमा० २-९<br><br>

अयोनिज
अयोनिज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ನಾರಾಯಣ<br><b>प्रयोगाः - </b>"दिवस्पृक् सर्वदृग्व्यासो वाचस्पतिरयोनिजः"<br><b>उल्लेखाः - </b>वि० स०<br><br>अयोनिज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನುಷ್ಯಾದಿ ದೇಹದಲ್ಲಿ ಉತ್ಪತ್ತಿ ಹೊಂದದ /ಹೆಂಗಸರ ಗರ್ಭದಲ್ಲಿ ಹುಟ್ಟದ ಅಗಸ್ತ್ಯ ಮಹರ್ಷಿ, ದ್ರೋಣಾಚಾರ್ಯರು, ದ್ರೌಪದಿ ಸೀತೆ ಮುಂತಾದವರು<br><br>अयोनिज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಾಖದಿಂದ ಹುಟ್ಟುವ ಹುಳು /ನೊಣ<br><br>

अयोमल
अयोमल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣದ ಕಿಲುಬು /ಕಬ್ಬಿಣದ ಮೇಲೆ ಹಿಡಿಯುವ ತುಕ್ಕು<br><br>

अयोमुख
अयोमुख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣ<br><br>अयोमुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತುದಿಯಲ್ಲಿ ಕಬ್ಬಿಣವುಳ್ಳ /ಕಬ್ಬಿಣದ ಮೂತಿಯುಳ್ಳ<br><br>

अयोमुखी
अयोमुखी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣದಂತೆ ಕಠಿನವಾದ ಮೂತಿಯುಳ್ಳ<br><b>निष्पत्तिः - </b>स्त्रियां वा "ङीष्" (४-१-५४)<br><br>

अयोमुखा
अयोमुखा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣದಂತೆ ಕಠಿನವಾದ ಮೂತಿಯುಳ್ಳ<br><br>

अयोहृदय
अयोहृदय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣದಂತೆ ಕಠಿನವಾದ ಮನಸ್ಸುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अय इव हृदयं यस्य<br><br>

अयौगिक
अयौगिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯುತ್ಪತ್ತಿಯಿಂದ ಸಿದ್ಧವಾಗದ ಶಬ್ದ /ಅವಯವಾರ್ಥವಿಲ್ಲದ ಶಬ್ದ<br><br>

अर
अर<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಕ್ರದ ಅರೆಕಾಲು /ಚಕ್ರದ ಅಂಚಿಗೂ ಗುಂಬಕ್ಕೂ ಮಧ್ಯೆ ಇರುವ ಮರದ ಪಟ್ಟಿ ಅಥವಾ ಕಬ್ಬಿಣದ ಸಲಾಕೆ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>इयर्ति गच्छत्यनेन<br><b>प्रयोगाः - </b>"गण्डोज्ज्वलामुज्ज्वलनाभिचक्र्या विराजमानां नवयोदरश्रिया"<br><b>उल्लेखाः - </b>माघ० १२-८<br><br>अर<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶೈವಾಲ /ಪಾಚಿ<br><br>अर<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಮೂಲೆ<br><br>अर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶೀಘ್ರತೆಯಿಂದ ಕೂಡಿದ /ಶೀಘ್ರವಾಗಿ ನಡೆಯುವ<br><br>अर<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಶೀಘ್ರವಾಗಿ /ಜಾಗ್ರತೆಯಾಗಿ<br><b>प्रयोगाः - </b>"अरमयचयतामुभावसिभ्यां पिशितभुजं भुजभारहीनमेनम्"<br><b>उल्लेखाः - </b>चं० रा०<br><b>विस्तारः - </b>"अरमङ्गे रथाङ्गस्य शीघ्रशीघ्रगयोरपि" - शाश्व० ।<br><br>

अरघट्ट
अरघट्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಟೆ /ಬಾವಿಯಿಂದ ನೀರು ಸೇದಲು ಹಾಕಿರುವ ಚಕ್ರ<br><br>अरघट्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೊಡ್ಡ ಬಾವಿ /ಆಳವಾದ ಬಾವಿ<br><b>व्युत्पत्तिः - </b>अरं शीघ्रं घट्यते चाल्यतेऽसौ<br><b>प्रयोगाः - </b>"तदाकर्ण्य तु अरघट्टमार्गमहमाश्रित्य"<br><b>उल्लेखाः - </b>पञ्चतं०<br><b>विस्तारः - </b>"कोट्टारघट्टहट्टाश्च" - अम० ।<br><br>

अरजस्
अरजस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪುಷ್ಪವತಿಯಾಗಾದ ಹೆಂಗಸು /ಕನ್ಯೆ<br><br>अरजस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧೂಳಿಲ್ಲದ /ಕೊಳೆಯಿಲ್ಲದ<br><br>अरजस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮಕ್ರೋಧಾದಿಗಳಿಲ್ಲದ /ರಜೋಗುಣವಿಲ್ಲದ<br><br>

अरज्जु
अरज्जु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರಾಗೃಹ /ಸೆರೆಮನೆ<br><b>व्युत्पत्तिः - </b>नास्ति रज्जुर्बन्धनसाधनं यत्र<br><br>

अरणि
अरणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "अनिः" (उ० २-१०२)<br><b>व्युत्पत्तिः - </b>ऋच्छति<br><br>अरणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಮಂಥ ವೃಕ್ಷ /ಬೆಂಕಿಯನ್ನುಂಟುಮಾಡುವ ಒಂದು ಮರ<br><br>अरणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಕಿ /ಅಗ್ನಿ<br><br>अरणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಕಮಕಿ ಕಲ್ಲು /ಅಗ್ನಿಶಿಲೆ<br><br>अरणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗದ ಅಗ್ನಿಯನ್ನು ಉತ್ಪತ್ತಿ ಮಾಡಲು ಉಪಯೋಗಿಸುವ ಮರದ ತುಂಡು<br><b>विस्तारः - </b>"निर्मन्थ्यदारुणित्वरणिर्द्वयोः" - अम० ।<br><br>

अरणी
अरणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अरणि ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां वा "ङीष्" (४-१-५४)<br><b>प्रयोगाः - </b>"अरणिसम्भवपावकसङ्गमादभजताध्वरवेदिरुव श्रियम्"<br><b>उल्लेखाः - </b>याद० ३-४६<br><br>

अरणीकेतु
अरणीकेतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಮಂಥ ವೃಕ್ಷ<br><br>

अरणीसुत
अरणीसुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶುಕಮಹರ್ಷಿ<br><br>

अरण्य
अरण्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವನ /ಕಾಡು<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "अन्यः" (उ० ३-१०२)<br><b>व्युत्पत्तिः - </b>अर्यते<br><b>प्रयोगाः - </b>"आरण्यकानां प्रभवः फलानामरण्यजातानि फलान्यभीप्सन्"<br><b>उल्लेखाः - </b>याद० ४-३०<br><br>अरण्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೇಗದ ಮರ<br><br>

अरण्यकन्दली
अरण्यकन्दली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಬಾಳೆ ಗಿಡ<br><br>

अरण्यकाण्ड
अरण्यकाण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀರಾಮನ ಅರಣ್ಯಸಂಚಾರದ ವಿಷಯವನ್ನು ವರ್ಣಿಸುವ ರಾಮಾಯಣದ ಗ್ರಂಥಭಾಗ<br><br>

अरण्यकार्पासी
अरण्यकार्पासी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಹತ್ತಿ ಗಿಡ<br><br>

अरण्यचटक
अरण्यचटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಗುಬ್ಬಚ್ಚಿ<br><br>

अरण्यचन्द्रिका
अरण्यचन्द्रिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡಿನಲ್ಲಿ ಬೀಳುವ ಬೆಳದಿಂಗಳು /ಉಪಯೋಗವಿಲ್ಲದ ಸಂಪತ್ತು<br><br>

अरण्यचर
अरण्यचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಡಿನಲ್ಲಿ ಸಂಚರಿಸುವ<br><b>निष्पत्तिः - </b>चर (गतौ) - "टः" (३-२-१६)<br><b>व्युत्पत्तिः - </b>अरण्ये चरति<br><br>

अरण्यचरी
अरण्यचरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡಿನಲ್ಲಿ ಸಂಚರಿಸುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

अरण्यधर्म
अरण्यधर्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡಿನಲ್ಲಿ ಆಚರಿಸಲ್ಪಡುವ ಧರ್ಮ<br><br>

अरण्यमक्षिका
अरण्यमक्षिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುನೊಣ<br><br>

अरण्यमार्जार
अरण्यमार्जार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಬೆಕ್ಕು<br><br>

अरण्यमुद्ग
अरण्यमुद्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಹೆಸರು<br><br>

अरण्यरुदित
अरण्यरुदित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಣ್ಯದಲ್ಲಿ ಮಾಡುವ ರೋದನ /ಕಾಡಿನಲ್ಲಿ ಅಳುವುದು<br><br>

अरण्यवास
अरण्यवास<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಡಿನ ವಾಸ<br><br>

अरण्यवासिन्
अरण्यवासिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಡಿನಲ್ಲಿ ವಾಸ ಮಾಡುವ ಋಷಿ ಮೊದಲಾದವರು<br><b>निष्पत्तिः - </b>वस (निवासे) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अरण्ये वसति<br><br>

अरण्यसूकर
अरण्यसूकर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಹಂದಿ<br><br>

अरण्यश्वन्
अरण्यश्वन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುನಾಯಿ /ವೃಕ /ತೋಳ<br><br>

अरण्यषष्ठी
अरण्यषष्ठी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠ ಶುದ್ಧ ಷಷ್ಠಿ<br><b>प्रयोगाः - </b>"ज्येष्ठे मासे सिते पक्षे षष्ठी याऽरण्यसञ्ज्ञिता । व्यजनैककरास्तस्यामटन्ति विपिने स्त्रियः ॥"<br><br>

अरण्याध्यक्ष
अरण्याध्यक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಣ್ಯವನ್ನು ರಕ್ಷಿಸಲು ರಾಜನಿಂದ ನಿಯುಕ್ತನಾದ ಅಧಿಕಾರಿ<br><br>

अरण्यानी
अरण्यानी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೊಡ್ಡ ಕಾಡು /ವಿಸ್ತಾರವಾದ ಅಡವಿ<br><b>निष्पत्तिः - </b>"आनुक्" "ङीष्" (४-१-४९)<br><b>व्युत्पत्तिः - </b>महदरण्यम्<br><br>

अरण्यौकस्
अरण्यौकस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುನಿ /ಋಷಿ<br><b>निष्पत्तिः - </b>अरण्यमोको यस्य<br><b>प्रयोगाः - </b>"वैक्लव्यं मम तावदीदृशमिदं स्नेहादरण्यौकसः"<br><b>उल्लेखाः - </b>शाकु० ४-५<br><br>अरण्यौकस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾನಪ್ರಸ್ಥ /ಸಂಸಾರವನ್ನು ತ್ಯಜಿಸಿ ಅರಣ್ಯದಲ್ಲಿ ವಾಸ ಮಾಡುವವನು<br><br>

अरत
अरत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿರಕ್ತ /ವೈರಾಗ್ಯವುಳ್ಳವನು<br><br>अरत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುರಾಗವಿಲ್ಲದ /ಪ್ರೀತಿಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न रतः<br><br>

अरति
अरति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪ /ಕ್ರೋಧ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "अतिः" (उ० ४-६०)<br><br>

अरति
अरति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂತೋಷವಿಲ್ಲದಿರುವಿಕೆ /ನೆಮ್ಮದಿಯಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>रमु (क्रीडायाम्) - "क्तिन्" (३-३-९४)<br><br>अरति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿಯಿಲ್ಲದಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"विविक्तदेशसेवित्वमरतिर्जनसंसदि"<br><b>उल्लेखाः - </b>गीता० १३-१०<br><br>अरति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೋವು /ದುಃಖ<br><br>अरति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವುದರಲ್ಲಿಯೂ ಇಚ್ಛೆಯಿಲ್ಲದಿರುವಿಕೆ /ಬೇಸರ / ಹತ್ತು ಮನ್ಮಥಾವಸ್ಥೆಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"दृङ्मनःसङ्गसङ्कल्पा जागरः कृशताऽरतिः । ह्रीत्यागोन्मादमूर्च्छ्यान्ता इत्यनङ्गदशा दश ॥"<br><br>अरति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುರಾಗವಿಲ್ಲದ /ಪ್ರೀತಿಯಿಲ್ಲದ<br><br>

अरत्नि
अरत्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರುಬೆರಳು ನೀಡಿದ ಒಂದು ಗುದ್ದುಮೊಳ /ಮೊಳಕೈಯಿಂದ ಹಿಡಿದು ಕಿರುಬೆರಳಿನ ತುದಿಯವರೆಗಿನ ಅಳತೆ<br><br>अरत्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಳಕೈ<br><br>अरत्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಹು /ತೋಳು<br><b>विस्तारः - </b>"अरत्निर्ना सप्रकोष्ठतताङ्गुलिकरेऽपि च । कफोणावपि" - मेदि० ।<br><br>

अरर
अरर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><br>अरर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣ<br><br>अरर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕವಾಟ /ಬಾಗಿಲು<br><br>अरर<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿದಿರಿನ ಒರೆ /ಗವಸಣಿಗೆ<br><br>अरर<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಳ /ಒರೆ /ಕೋಶ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "अरन्" (उ० ३-१३२)<br><b>विस्तारः - </b>"न ना कवाटे क्ली लोहे सोमे स्यादररः पुमान्" - वैज० । "अररं छदकपाटयोः" - मेदि० ।<br><br>

अररि
अररि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕವಾಟ /ಬಾಗಿಲು<br><b>विस्तारः - </b>"कपाटोऽररिः कुवाटः" - अभि० चि० ।<br><br>

अररु
अररु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರು<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "अरुः" (उ० ४-७९)<br><br>अररु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಯುಧ<br><br>

अरविन्द
अरविन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾಮ್ರಲೋಹ<br><br>अरविन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಕ್ಕರೆ /ನೀರುಹಕ್ಕಿ<br><br>अरविन्द<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪದ್ಮ /ಕಮಲ<br><b>निष्पत्तिः - </b>अर + विद्लृ (लाभे) - "शः" (३-१-१३८)<br><b>व्युत्पत्तिः - </b>अराणि अरसदृशानि दलानि विदन्ति<br><b>प्रयोगाः - </b>"सरसीष्वरविन्दानां वीचिविक्षोभशीतलम्" । "क्रीडाहृतं क्षिप्रमिवारविन्दम्" ।<br><b>उल्लेखाः - </b>रघु० १-४३, याद० २-४१<br><br>अरविन्द<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂದಾವರೆ<br><br>अरविन्द<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ನೈದಿಲೆ /ನೀಲಕಮಲ<br><br>

अरविन्दनाभ
अरविन्दनाभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>"अच्" (५-४-७५)<br><b>व्युत्पत्तिः - </b>अरविन्दं नाभौ यस्य<br><br>

अरविन्दाक्ष
अरविन्दाक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>अरविन्दाक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಮಲದಂತೆ ಕಣ್ಣುಳ್ಳ<br><b>निष्पत्तिः - </b>"षच्" (५-४-११३)<br><b>व्युत्पत्तिः - </b>अरविन्दे इव अक्षिणी यस्य<br><br>

अरविन्दाक्षी
अरविन्दाक्षी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲದಂತೆ ಕಣ್ಣುಳ್ಳ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीष्" (४-१-४१)<br><br>

अरविन्दिनी
अरविन्दिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲ ಲತೆ<br><br>अरविन्दिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲಗಳಿಂದ ಕೂಡಿದ ದೇಶ<br><br>अरविन्दिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲಗಳ ಸಮೂಹ<br><b>निष्पत्तिः - </b>अरविन्द - "इनिः" (५-२-१३५) । "ङीप्" (४-१-५)<br><br>

अरस
अरस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಸವಿಲ್ಲದ<br><br>अरस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಕ್ತಿಯಿಲ್ಲದ<br><br>अरस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಪ್ಪೆಯಾದ<br><b>निष्पत्तिः - </b>रस (आस्वादनस्नेहनयोः) + णिच् - कर्म० "अच्" (३-३-५६) । न० ब० ।<br><b>व्युत्पत्तिः - </b>रस्यते<br><br>

अरसिक
अरसिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಸವನ್ನರಿಯದ /ರಸಸ್ವರೂಪವನ್ನು ತಿಳಿಯದ<br><b>निष्पत्तिः - </b>"ठन्" ५-२-११५)<br><b>व्युत्पत्तिः - </b>रसोऽस्त्यस्य<br><b>प्रयोगाः - </b>"अरसिकेषु रसस्य निवेदनं शिरसि मा लिख मा लिख मा लिख"<br><br>

अराजक
अराजक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನಿಲ್ಲದ ದೇಶ<br><b>निष्पत्तिः - </b>"कप्" (५-४-१५४)<br><b>व्युत्पत्तिः - </b>नास्ति राजा यत्र<br><br>

अराति
अराति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರು /ಹಗೆ /ವೈರಿ<br><b>निष्पत्तिः - </b>रा (दाने) - "क्तिच्" (३-३-१७४)<br><b>व्युत्पत्तिः - </b>न राति सुखम्<br><b>प्रयोगाः - </b>"अरातिपक्षार्णवमन्दराभे" । "अरातिभिर्युधि सहयुध्वानो हतान्"<br><b>उल्लेखाः - </b>याद० १३-८४, माघ० १७-३४<br><br>अराति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಾತಕದ ಕುಂಡಲಿಯಲ್ಲಿ ತನ್ವಾದಿ ಭಾವಗಳ ಪೈಕಿ ಆರನೆಯದು<br><br>अराति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆರು ಸಂಖ್ಯೆ<br><br>

अराल
अराल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದಿಸಿದ ಆನೆ<br><br>अराल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಜ ರಸ /ಮತ್ತಿಮರದ ಹಾಲು<br><br>अराल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಕ್ರವಾದ /ಕುಟಿಲವಾದ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "विच्" (३-२-७५) । आ + ला (आदाने) - "कः" (वा० ३-२-५)<br><b>व्युत्पत्तिः - </b>अरमालाति<br><b>प्रयोगाः - </b>"करोति लक्ष्यं चिरमस्य चक्षुषो न वक्त्रमात्मीयमरालपक्ष्मणः"<br><b>उल्लेखाः - </b>कुमा० ५-४९<br><b>विस्तारः - </b>"अरालः कुटिले सर्जरसे समददन्तिनि" - मेदि० ।<br><br>

अराला
अराला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇಶ್ಯೆ /ಸೂಳೆ /ಸ್ವೈರಿಣಿ<br><br>

अरि
अरि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರು /ಹಗೆ /ವೈರಿ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "इः" (उ० ४-१३८)<br><b>व्युत्पत्तिः - </b>इयर्ति विरोधम्<br><b>प्रयोगाः - </b>"अरिषु हि विजयार्थिनः क्षितीशाः विदधति सोपधि सन्धिदूषणानि"<br><b>उल्लेखाः - </b>किरा० १-४५<br><br>अरि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ ಕ್ರೋಧ ಲೋಭ ಮೋಹ ಮದ ಮಾತ್ಸರ್ಯಗಳೆಂಬ ಮನುಷ್ಯನ ಶತ್ರುವರ್ಗ<br><br>अरि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಗ್ನದಿಂದ ಆರನೆಯ ಸ್ಥಾನ /ಶತ್ರು ಸ್ಥಾನ<br><br>अरि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆರು ಸಂಖ್ಯೆ<br><br>

अरिचिन्तन
अरिचिन्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರುರಾಷ್ಟ್ರದ ವಿಷಯವಾಗಿ ಮಾಡುವ ಯೋಚನೆ<br><b>विस्तारः - </b>"तन्त्रं स्वराष्ट्रचिन्ता स्यादावापस्त्वरिचिन्तनम्" - वैज० ।<br><br>

अरित्र
अरित्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಡಗುಗಳನ್ನು ನಡೆಸುವ ಜಲ್ಲೆ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "इत्रः" (३-२-१८४)<br><b>व्युत्पत्तिः - </b>ऋच्छत्यनेन<br><b>प्रयोगाः - </b>"लोलैररित्रैश्चरणैरिवाभितः"<br><b>उल्लेखाः - </b>माघ० १२-७१<br><br>अरित्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಡಗಿನ ಚುಕ್ಕಾಣಿ /ಲಂಗರು<br><br>अरित्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶತ್ರುಗಳಿಂದ ಕಾಪಾಡುವ<br><b>निष्पत्तिः - </b>त्रैङ् (पालने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>अरिभ्यः त्रायते<br><br>

अरिन्दम
अरिन्दम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶತ್ರುಗಳನ್ನು ಅಡಗಿಸುವ /ಶತ್ರುಗಳನ್ನು ಕುಗ್ಗಿಸುವ<br><b>निष्पत्तिः - </b>अरि + स्दमु (उपशमे) - "खच्" (३-२-४६) । मुम् ।<br><b>व्युत्पत्तिः - </b>अरीन् दाम्यति<br><br>

अरिभद्र
अरिभद्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಿಶ್ರೇಷ್ಠ /ಬಹಳ ಬಲಶಾಲಿಯಾದ ಶತ್ರು<br><b>प्रयोगाः - </b>"सर्पाधिराजोरुभुजोऽपसर्पं पप्रच्छ भद्रं विजितारिभद्रः"<br><b>उल्लेखाः - </b>रघु० १४-३१<br><br>

अरिमेद
अरिमेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ವಾಸನೆಯುಳ್ಳ ಕಗ್ಗಲಿ ಮರ<br><br>

अरिषड्वर्ग
अरिषड्वर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ ಕ್ರೋಧ ಲೋಭ ಮೋಹ ಮದ ಮಾತ್ಸರ್ಯಗಳೆಂಬ ಮನುಷ್ಯನ ಶತ್ರುವರ್ಗ<br><br>

अरिष्ट
अरिष्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇವಿನ ಮರ<br><br>अरिष्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಳ್ಳುಳ್ಳಿ<br><br>अरिष्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹದ್ದು<br><br>अरिष्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ /ವಾಯಸ<br><br>अरिष्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣನಿಂದ ಹತನಾದ ಒಬ್ಬ ರಾಕ್ಷಸ<br><b>प्रयोगाः - </b>"अरिष्टचाणूरमुखेष्वलक्षितम्"<br><b>उल्लेखाः - </b>याद० १४-११<br><br>अरिष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶುಭ<br><br>अरिष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಜ್ಜಿಗೆ /ಕಡೆದು ನೀರು ಬೆರೆಸಿದ ಮೊಸರು<br><br>अरिष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶುಭ ಸೂಚನೆ<br><b>प्रयोगाः - </b>"अरिष्टमाशङ्क्य विपाकदारुणम्"<br><b>उल्लेखाः - </b>कुमा० १५-२६<br><br>अरिष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾವಿನಲಕ್ಷಣ /ಮರಣದ ಕುರುಹು<br><br>अरिष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ಷೇಮ /ಶುಭ<br><br>अरिष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ<br><br>अरिष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂತಿಕಾ ಗೃಹ /ಪ್ರಸವಗೃಹ<br><b>प्रयोगाः - </b>"अरिष्टशय्यां परितो विसारिणा"<br><b>उल्लेखाः - </b>रघु० ३-१५<br><br>अरिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಖವಾದ /ಕ್ಷೇಮವಾದ /ತೊಂದರೆಯಿಲ್ಲದ<br><b>प्रयोगाः - </b>"अरिष्टं गच्छ पन्थानम्"<br><b>उल्लेखाः - </b>रामा०<br><b>विस्तारः - </b>"अरिष्टो लशुने निम्बे फेनिले काककङ्कयोः । अरिष्टमशुभे तक्रे सूतिकागार आसवे । शुभे मरणचिह्ने च" - मेदि० ।<br><br>

अरिष्टा
अरिष्टा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಟುಕರೋಹಿಣಿ<br><br>

अरिष्टाति
अरिष्टाति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶುಭವನ್ನುಂಟುಮಾಡುವವನು<br><b>निष्पत्तिः - </b>अरिष्ट - "तातिल्" (४-४-१४३)<br><b>व्युत्पत्तिः - </b>अरिष्टं करोति<br><br>

अरिष्टदुष्टधी
अरिष्टदुष्टधी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶುಭ ಚಿಹ್ನೆಯಿಂದ ಕಳವಳಗೊಂಡ ಮನಸ್ಸುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अरिष्टेन दुष्टा धीः यस्य<br><b>विस्तारः - </b>"विवशोऽरिष्टदुष्टधीः" - अम० ।<br><br>

अरिष्टनेमि
अरिष्टनेमि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿನತಾದೇವಿಯ ಮಗ<br><b>प्रयोगाः - </b>"तार्क्ष्यश्चारिष्टनेमिश्च गरुदश्च महाबलः । अरुणश्चारुणिश्चैव विनतायाः सुताः स्मृताः ॥"<br><b>उल्लेखाः - </b>हरिवं०<br><br>अरिष्टनेमि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಜೈನತೀರ್ಥಂಕರರ ಹೆಸರು<br><br>

अरिष्टि
अरिष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ಷೇಮ /ಶುಭ<br><b>निष्पत्तिः - </b>न० त० ।<br><b>व्युत्पत्तिः - </b>न रिष्टिः<br><br>

अरुचि
अरुचि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अरुचि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂತೋಷವಿಲ್ಲದಿರುವಿಕೆ<br><br>

अरुण
अरुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "उनन्" (उ० ३-६०)<br><b>व्युत्पत्तिः - </b>ऋच्छति<br><b>प्रयोगाः - </b>"रागेण बालारुणकोमलेन"<br><b>उल्लेखाः - </b>कुमा० ३-३०<br><br>अरुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಸಾರಥಿ<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>अरुणो वर्णोऽस्यास्ति<br><b>प्रयोगाः - </b>"आविष्कृतारुणपुरःसर एकतोऽर्कः"<br><b>उल्लेखाः - </b>शाकु० ४-१<br><br>अरुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಪು ಬಣ್ಣ /ಕೆಂದಾವರೆ<br><br>अरुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆಗೆಂಪು<br><br>अरुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಣ್ಣೆ ಗೆಂಪು /ಕಪ್ಪು ಬೆರೆತ ಕೆಂಪು ಬಣ್ಣ<br><br>अरुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಕುಷ್ಠರೋಗ<br><br>अरुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಕಂಬಿ /ಬೆಲ್ಲದ ಪಾಕ<br><br>अरुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಕ್ಷಸ<br><br>अरुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ವಾದಶಾದಿತ್ಯರಲ್ಲೊಬ್ಬ<br><b>प्रयोगाः - </b>"अरुणो माघमासे वै"<br><b>उल्लेखाः - </b>आदित्यहृ०<br><br>अरुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುರಗಿ ಮರ /ಸುರಹೊನ್ನೆ ಮರ<br><br>अरुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬುಧಗ್ರಹ<br><br>अरुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಧ್ಯಾಕಾಲದ ಮೇಘ<br><br>अरुण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಕುಮ ಕೇಸರಿ<br><br>अरुण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿನ್ನ /ಸುವರ್ಣ<br><br>अरुण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಮ್ರಲೋಹ<br><b>विस्तारः - </b>"विषारुणारुणं ताम्रमरुणः सूर्यसारथौ । अव्यक्तरागे शशिजे सन्ध्याभ्रे लोहिते रवौ" - वैज० ।<br><br>अरुण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಂಪು ಬಣ್ಣದ /ಎಳೆಗೆಂಪಿನಿಂದ ಕೂಡಿದ<br><b>प्रयोगाः - </b>"अरुणजलजराजीमुग्धहस्ताग्रपादा" । "अरुणाधरसाभिलाषवंशां करुणां कारुणमानुषीं भजामि" ।<br><b>उल्लेखाः - </b>माघ० ११-४०, याद० १५-८९<br><br>अरुण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಣ್ಣೆಗೆಂಪಾದ<br><br>अरुण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂಕ /ಮಾತಾಡಲಾಗದವನು<br><br>अरुण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಂತಾಕ್ರಾಂತನಾದ<br><b>विस्तारः - </b>"अरुणो अव्यक्तरागे अर्के सन्ध्यारागे अर्कसारथौ । निःशब्दे कपिले कुष्ठभेदे ना गुणिनि त्रिषु । अरुणातिविषा श्यामा मञ्जिष्ठा त्रिवृतासु च" - मेदि० । "मञ्जिष्ठातिविषारुणा । त्रिष्वारक्ते व्याकुले" - त्रिकाण्ड० ।<br><br>

अरुणा
अरुणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಜಿಷ್ಠೆ<br><br>अरुणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಬಜೆ<br><br>अरुणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾವೆ<br><br>अरुणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಪು ತಿಗಡೆ ಮರ<br><br>अरुणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಲಗಂಜಿ ಬಳ್ಳಿ<br><br>अरुणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನದಿ<br><br>अरुणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾವು ಮೆಕ್ಕೆ ಗಿಡ<br><br>

अरुणप्रिया
अरुणप्रिया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಪತ್ನಿ ಸಂಜ್ಞಾದೇವಿ, ಛಾಯಾದೇವಿ<br><br>

अरुणनयन
अरुणनयन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರಾವತ /ಪಾರಿವಾಳದ ಹಕ್ಕಿ<br><b>व्युत्पत्तिः - </b>अरुणे नयने यस्य<br><br>अरुणनयन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಂಪಾದ ಕಣ್ಣುಳ್ಳ<br><br>

अरुणनेत्र
अरुणनेत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರಾವತ /ಪಾರಿವಾಳದ ಹಕ್ಕಿ<br><b>व्युत्पत्तिः - </b>अरुणे नेत्रे यस्य<br><br>अरुणनेत्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಂಪಾದ ಕಣ್ಣುಳ್ಳ<br><br>

अरुणलोचन
अरुणलोचन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರಾವತ /ಪಾರಿವಾಳದ ಹಕ್ಕಿ<br><b>व्युत्पत्तिः - </b>अरुणे लोचने यस्य<br><br>अरुणलोचन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಂಪಾದ ಕಣ್ಣುಳ್ಳ<br><br>

अरुणसारथि
अरुणसारथि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>अरुणः सारथिर्यस्य<br><br>

अरुणात्मज
अरुणात्मज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಮಗ ಯಮ, ಕರ್ಣ, ಸಾವರ್ಣಿಮನು, ಅಶ್ವಿನೀ ಕುಮಾರರು<br><br>अरुणात्मज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಸಾರಥಿಯಾದ ಅರುಣನ ಮಗ ಜಟಾಯು, ಸಂಪಾತಿ<br><br>

अरुणात्मजा
अरुणात्मजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಮಗಳು ಯಮುನಾ ನದಿ<br><br>अरुणात्मजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಮಗಳು ತಪತೀ ನದಿ<br><br>

अरुणानुज
अरुणानुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರುಣನ ತಮ್ಮ /ಗರುಡ<br><b>व्युत्पत्तिः - </b>अरुणस्यानुजः<br><br>

अरुणावरज
अरुणावरज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರುಣನ ತಮ್ಮ /ಗರುಡ<br><b>व्युत्पत्तिः - </b>अरुणस्यावरजः<br><br>

अरुणित
अरुणित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಂಪಾಗಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अरुण - "इतच्" (५-२-३६)<br><b>प्रयोगाः - </b>"स्तनाङ्गरागारुणिताच्च कन्दुकात्" । "अरुणिताखिलशैलवना मुहुः" ।<br><b>उल्लेखाः - </b>कुमा० ५-११, माघ० ६-२१<br><br>

अरुणोदय
अरुणोदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯೋದಯಕ್ಕೆ ಪೂರ್ವದಲ್ಲಿ ನಾಲ್ಕು ಘಳಿಗೆಯ ಕಾಲ<br><b>प्रयोगाः - </b>"चतस्रो घटिकाः प्रातररुणोदय उच्यते"<br><br>अरुणोदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರುಣನ ಆವಿರ್ಭಾವ /ಅರುಣನು ಕಾಣಿಸಿಕೊಳ್ಳುವಿಕೆ<br><br>

अरुणोदयविद्धा
अरुणोदयविद्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರುಣೋದಯ ಕಾಲದಲ್ಲಿ ದಶಮೀ ತಿಥಿಯ ಸಂಬಂಧವುಳ್ಳ ಏಕಾದಶಿ ತಿಥಿ<br><b>व्युत्पत्तिः - </b>अरुणोदये विद्धा<br><b>प्रयोगाः - </b>"दशमी शेषसंयुक्ता यदि स्यादरुणोदये । वैष्णवेन न कर्तव्यं तद्दिनैकादशीव्रतम् ॥"<br><b>उल्लेखाः - </b>भविष्यपु०<br><br>

अरुणोदयसप्तमी
अरुणोदयसप्तमी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಘ ಶುಕ್ಲ ಸಪ್ತಮಿ /ರಥಸಪ್ತಮಿ<br><b>प्रयोगाः - </b>"माघे मासे सिते पक्षे सप्तमी कोटिभास्करा । दद्यात् स्नानार्घदानाभ्यामायुरारोग्यसम्पदः ॥"<br><b>उल्लेखाः - </b>भविष्यपु०<br><br>

अरुणोपल
अरुणोपल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪದ್ಮರಾಗ /ಮಾಣಿಕ್ಯ<br><br>

अरुन्तुद
अरुन्तुद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನಸ್ಸನ್ನು ನೋಯಿಸುವ /ಮರ್ಮಭೇದಕವಾದ<br><b>निष्पत्तिः - </b>अरुस् + तुद (व्यथने) - "खश्" (३-२-३५)<br><b>व्युत्पत्तिः - </b>अरूंषि तुदति<br><b>प्रयोगाः - </b>"अरुन्तुदमिवालनमनिर्वाणस्य दन्तिनः"<br><b>उल्लेखाः - </b>रघु० १-७१<br><br>

अरुन्धती
अरुन्धती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಸಿಷ್ಠಮಹರ್ಷಿಯ ಪತ್ನಿ<br><b>प्रयोगाः - </b>"अन्वासितमरुन्धत्या स्वाहयेव हविर्भुजम्" । "आर्याप्यरुन्धती तत्र व्यापारं कर्तुमर्हति"<br><b>उल्लेखाः - </b>रघु० १-५६, कुमा० ६-३२<br><br>अरुन्धती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಹ್ವಾ ಯನಾಲಗೆ<br><b>प्रयोगाः - </b>"अरुन्धती भवेज्जिह्वा ध्रुवो नासाग्रमुच्यते"<br><b>उल्लेखाः - </b>काशीखं०<br><br>

अरुन्धतीजानि
अरुन्धतीजानि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸಿಷ್ಠ ಮಹರ್ಷಿ<br><b>निष्पत्तिः - </b>"निङ्" (५-४-१३४)<br><b>व्युत्पत्तिः - </b>अरुन्धती जाया यस्य<br><br>

अरुन्धतीदर्शनन्याय
अरुन्धतीदर्शनन्याय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊದಲು ಸ್ಥೂಲವಾಗಿ ಸುಲಭವಾದ ವಿಷಯವನ್ನು ತಿಳಿಸ್ ಅನಂತರ ವಿಮರ್ಶೆಯಿಂದ ಸೂಕ್ಷ್ಮವಾದ ವಿಷಯವನ್ನು ತಿಳಿಸುವುದು<br><br>

अरुल
अरुल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><br>अरुल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೋಣಿ<br><b>विस्तारः - </b>"अरुलं सलिले पोतेऽपि" - वैज० ।<br><br>

अरुष्कर
अरुष्कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೇರುಮರ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "टः" (३-२-२१)<br><b>व्युत्पत्तिः - </b>अरुः व्रणं करोति<br><br>अरुष्कर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಾಯವನ್ನುಂಟುಮಾಡುವ<br><br>

अरुस्
अरुस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಕ್ಕದ ಗಿಡ<br><br>अरुस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಪು ಕಗ್ಗಲಿ ಮರ<br><br>अरुस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ರಣ /ಹುಣ್ಣು<br><br>अरुस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಯ<br><br>अरुस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರ್ಮಸ್ಥಾನ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "उसिः" (उ० २-११७)<br><br>

अरूप
अरूप<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ<br><br>अरूप<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುರೂಪ<br><br>अरूप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೂಪವಿಲ್ಲದ<br><br>अरूप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೌಂದರ್ಯವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति रूपं यस्य<br><br>

अरूपहार्य
अरूपहार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೌಂದರ್ಯದಿಂದ ವಶಪಡಿಸಿಕೊಳ್ಳಲಾಗದ<br><b>व्युत्पत्तिः - </b>रूपेण सौन्दर्येण हार्यो न भवति<br><b>प्रयोगाः - </b>"अरूपहार्यं मदनस्य निग्रहात् पिनाकपाणिं पतिमाप्तुमिच्छति"<br><b>उल्लेखाः - </b>कुमा० ५-५३<br><br>

अरूष
अरूष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>अरूष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಹಾವು<br><br>

अरे
अरे<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನೀಚ ಸಂಬೋಧನ<br><b>प्रयोगाः - </b>"अरे, कुम्भीरक कथय कुत्र त्वयैतद्राजकीयमङ्गुलीयकं समासादितम्"<br><b>उल्लेखाः - </b>शाकु० ६<br><br>अरे<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೋಪದ ಸಂಬೋಧನೆ<br><b>प्रयोगाः - </b>"अरे, मूढ जात्या काममवध्योऽहम् । इयं सा जातिः परित्यक्ता"<br><b>उल्लेखाः - </b>वेणी० ३<br><br>अरे<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಸೂಯೆ /ಹೊಟ್ಟೆಕಿಚ್ಚು<br><b>विस्तारः - </b>"अरेऽपाकृत्यसूययोः" - मेदि० ।<br><br>

अरोक
अरोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂತಿಯಿಲ್ಲದ /ಪ್ರಕಾಶಶೂನ್ಯವಾದ /ಕಳೆಗುಂದಿದ<br><b>निष्पत्तिः - </b>रुच (दीप्तौ) - "घञ्" (३-३-१८)<br><b>व्युत्पत्तिः - </b>रोको दीप्तिः । न रोको यस्य<br><br>अरोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಂಧ್ರವಿಲ್ಲದ /ತೂತವಿಲ್ಲದ<br><br>

अरोग
अरोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆರೋಗ್ಯ /ರೋಗವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न रोगः<br><b>प्रयोगाः - </b>"न नाममात्रेण करोत्यरोगम्"<br><b>उल्लेखाः - </b>हितो० १-१६७<br><br>अरोग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೋಗವಿಲ್ಲದ /ಆರೋಗ್ಯದಿಂದ ಕೂಡಿದ<br><b>व्युत्पत्तिः - </b>न रोगो यस्य<br><br>

अरोगिन्
अरोगिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೋಗವಿಲ್ಲದ /ಆರೋಗ್ಯದಿಂದ ಕೂಡಿದ<br><b>व्युत्पत्तिः - </b>न रोगी<br><br>

अरोगिणी
अरोगिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗವಿಲ್ಲದ /ಆರೋಗ್ಯದಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अरोचक
अरोचक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಜೀರ್ಣ ರೋಗವುಳ್ಳ<br><br>

अरोचकिन्
अरोचकिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>अर्च (पूजायाम्) - "कः" (उ० ३-४०)<br><b>व्युत्पत्तिः - </b>अर्च्यते<br><b>प्रयोगाः - </b>"जगत्पवित्रैरपि तं न पादैः स्प्रष्टुं जगत्पूज्यमयुज्यतार्कः"<br><b>उल्लेखाः - </b>माघ० ३-२<br><br>

अर्क
अर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>"अर्को वाजसनिः शृङ्गी"<br><b>उल्लेखाः - </b>वि० स०<br><br>अर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><br>अर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಫಟಿಕ<br><br>अर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾಮ್ರಲೋಹ<br><br>अर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಾನುವಾರ<br><br>अर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಕ್ಕದ ಗಿಡ<br><br>अर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶುಕ್ಲ ಸಪ್ತಮಿ<br><br>अर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಂಡಿತ<br><br>अर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠ ಸಹೋದರ<br><br>अर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹರಳು ಗಿಡ<br><br>अर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರ ಫಲ್ಗುನೀ ನಕ್ಷತ್ರ<br><br>अर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೧೨ ಸಂಖ್ಯೆ<br><br>अर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಷಾಯ<br><b>विस्तारः - </b>"अर्को अर्कपर्णे स्फटिके रवौ ताम्रे दिवस्पतौ" । मेदि० । "अर्को मघोनि स्फटिके ज्येष्ठभ्रातरि भास्करे । शुभ्रे अर्कपादपे" - नानार्थर० ।<br><br>अर्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಡುವ /ಪೂಜಿಸಲು ಯೋಗ್ಯವಾದ<br><br>

अर्कक्षेत्र
अर्कक्षेत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಿಂಹರಾಶಿ<br><b>व्युत्पत्तिः - </b>अर्कस्य क्षेत्रम्<br><br>

अर्कज
अर्कज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಮಗ ಶನಿದೇವ, ಯಮ, ಸುಗ್ರೀವ, ಕರ್ಣ, ಮನು, ಅಶ್ವಿನೀ ಕುಮಾರರು<br><br>

अर्कजा
अर्कजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಮಗಳು ಯಮುನಾ ಮತ್ತು ತಪತೀ ನದಿ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>अर्काज्जायते<br><br>

अर्कतनय
अर्कतनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಮಗ ಶನಿದೇವ, ಯಮ, ಸುಗ್ರೀವ, ಕರ್ಣ, ಮನು, ಅಶ್ವಿನೀ ಕುಮಾರರು<br><br>

अर्कपुत्र
अर्कपुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಮಗ ಶನಿದೇವ, ಯಮ, ಸುಗ್ರೀವ, ಕರ್ಣ, ಮನು, ಅಶ್ವಿನೀ ಕುಮಾರರು<br><br>

अर्कसुत
अर्कसुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಮಗ ಶನಿದೇವ, ಯಮ, ಸುಗ್ರೀವ, ಕರ್ಣ, ಮನು, ಅಶ್ವಿನೀ ಕುಮಾರರು<br><br>

अर्कसूनु
अर्कसूनु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಮಗ ಶನಿದೇವ, ಯಮ, ಸುಗ್ರೀವ, ಕರ್ಣ, ಮನು, ಅಶ್ವಿನೀ ಕುಮಾರರು<br><br>

अर्कनेत्र
अर्कनेत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿರಾಟ ಪುರುಷ<br><br>अर्कनेत्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನಂತೆ ತೀಕ್ಷ್ಣವಾದ ಕಣ್ಣುಗಳುಳ್ಳ<br><br>

अर्कनयन
अर्कनयन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿರಾಟ ಪುರುಷ<br><br>अर्कनयन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನಂತೆ ತೀಕ್ಷ್ಣವಾದ ಕಣ್ಣುಗಳುಳ್ಳ<br><br>

अर्कपत्र
अर्कपत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಕ್ಕದ ಗಿಡ<br><b>व्युत्पत्तिः - </b>अर्क इव तीक्ष्णं‍पत्रं यस्य<br><br>अर्कपत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಕ್ಕದ ಎಲೆ<br><br>

अर्कपर्ण
अर्कपर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्ङः<br><b>कन्नडार्थः - </b>ಎಕ್ಕದ ಗಿಡ<br><b>व्युत्पत्तिः - </b>अर्क इव तीक्ष्णं पर्णं यस्य<br><br>अर्कपर्ण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಕ್ಕದ ಎಲೆ<br><br>

अर्कपादप
अर्कपादप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಕ್ಕದ ಮರ<br><br>

अर्कप्रिया
अर्कप्रिया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಪತ್ನಿ ಸಂಜ್ಞಾದೇವಿ ಛಾಯಾದೇವಿ<br><br>अर्कप्रिया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಪತ್ನಿ ಛಾಯಾದೇವಿ<br><br>

अर्कबन्धु
अर्कबन्धु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧದೇವ<br><br>अर्कबन्धु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲ<br><b>व्युत्पत्तिः - </b>अर्को बन्धुः यस्य<br><br>

अर्कभ
अर्कभ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರಫಲ್ಗುನೀನಕ್ಷತ್ರ<br><br>अर्कभ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನೇ ಅಧಿಪತಿಯಾದ ಸಿಂಹರಾಶಿ<br><br>

अर्कविवाह
अर्कविवाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂರನೆಯ ವಿವಾಹವನ್ನು ಮಾಡಿಕೊಳ್ಳುವ ಮೊದಲು ಎಕ್ಕದ ಗಿಡವನ್ನು ಕನ್ಯೆಯನ್ನಾಗಿ ಮಾಡಿ ಅದರೊಡನೆ ಮಾಡಿಕೊಳ್ಳುವ ಮದುವೆ<br><br>

अर्कवेध
अर्कवेध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾಳೀಶಪತ್ರೆ ಗಿಡ<br><br>

अर्कव्रत
अर्कव्रत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಘಶುಕ್ಲ ಸಪ್ತಮಿಯ ದಿನ ಮಾಡುವ ಸೂರ್ಯನ ಪೂಜೆ<br><b>प्रयोगाः - </b>"अष्टौ मासान् यथादित्यः तोयं गृह्णाति रश्मिभिः । तथा हरेत्करं राष्ट्रान्नित्यमर्कव्रतं हितम् ॥" "सहस्रगुणमुत्स्रष्टुमादत्ते हि रसं रविः" ।<br><b>उल्लेखाः - </b>मनु० ९-३०५, रघु० १-१८<br><br>अर्कव्रत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನು ಪ್ರಜೆಗಳಿಂದ ಕಂದಾಯ ತೆಗೆದುಕೊಳ್ಳುವುದು<br><br>

अर्काश्मन्
अर्काश्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯಕಾಂತ ಶಿಲೆ<br><br>अर्काश्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪದ್ಮರಾಗ /ಮಾಣಿಕ್ಯ<br><br>

अर्केन्दुसङ्गम
अर्केन्दुसङ्गम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಮಾವಾಸ್ಯೆ /ಸೂರ್ಯಚಂದ್ರರು ಒಂದೇ ರಾಶಿಯಲ್ಲಿ ಸೇರುವ ದಿನ<br><b>निष्पत्तिः - </b>सम् + गम्लृ (गतौ) - "घः" (३-३-११८)<br><b>व्युत्पत्तिः - </b>अर्केन्दू सङ्गच्छतोऽत्र<br><br>

अर्कोपल
अर्कोपल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯಕಾಂತ ಶಿಲೆ<br><br>अर्कोपल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪದ್ಮರಾಗ /ಮಾಣಿಕ್ಯ<br><br>

अर्क्य
अर्क्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अर्क (स्तवने) - "ण्यत्" (३-१-१२४)<br><br>

अर्गल
अर्गल<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಳಿ /ಚಿಲಕ<br><br>अर्गल<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಗಿಲು<br><b>निष्पत्तिः - </b>अर्ज (अर्जने) - "कलच्" (उ० १-१०६) । कुत्वम् (७-३-५३)<br><b>व्युत्पत्तिः - </b>अर्ज्यते<br><b>प्रयोगाः - </b>"पुरार्गलादीर्घभुजो बुभोज"<br><b>उल्लेखाः - </b>रघु० १८-४<br><br>अर्गल<br><br><b>पदविभागः - </b>त्रिलिङ्गः<br><b>कन्नडार्थः - </b>ತರಂಗ /ಅಲೆ<br><b>विस्तारः - </b>"अर्गस्त्रिषु कल्लोलेऽन्तर्दण्डावारयोर्नना" - मेदि० ।<br><br>

अर्गलिका
अर्गलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಳಿ /ಚಿಲಕ<br><br>

अर्घ
अर्घ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಲೆ /ಕ್ರಯ<br><b>निष्पत्तिः - </b>अर्ह (पूजायाम्) - "घञ्" (३-३-१२१) । कुत्वम् (७-३-५३)<br><b>प्रयोगाः - </b>"मणिमुक्ताप्रवालानां लोहानां तान्तवस्य च । गन्धानां च रसानां च विद्यादर्घबलाबलम् ॥"<br><b>उल्लेखाः - </b>मनु० ९-३२९<br><br>अर्घ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ /ಪೂಜಾಕಾರ್ಯ<br><b>प्रयोगाः - </b>"स प्रत्यग्रैः कुटजकुसुमैः कल्पितार्घाय तस्मै"<br><b>उल्लेखाः - </b>मेघ० १-४<br><br>

अर्घ्य
अर्घ्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜಾದ್ರವ್ಯ /ಪೂಜೆಗೆ ಬೇಕಾದ ಪತ್ರ ಪುಷ್ಪ ಮೊದಲಾದುದು<br><br>अर्घ्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜಾಸಂಬಂಧವಾದ ಉಪಚಾರಗಳಲ್ಲೊಂದು<br><b>निष्पत्तिः - </b>"यत्" (५-४-२५)<br><b>व्युत्पत्तिः - </b>अर्घाय इदम्<br><br>अर्घ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अर्ह (पूजायाम्) - "ण्यत्" (३-१-१२४) । कुत्वम्<br><b>व्युत्पत्तिः - </b>अर्ह्यते<br><b>प्रयोगाः - </b>"तानर्घ्यानर्घ्यमादाय दूरात् प्रत्य्द्ययौ गिरिः" । "तमर्घ्यमर्घ्यादिकयादिपूरुषः" ।<br><b>उल्लेखाः - </b>कुमा० ६-५०, माघ० १-१४<br><br>

अर्चक
अर्चक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜಿಸುವವನು /ಆರಾಧಿಸುವವನು<br><b>निष्पत्तिः - </b>अर्च (पूजायाम्) - "ण्वुल्" (३-१-१३३)<br><b>प्रयोगाः - </b>"ब्रह्मचारी व्रती च स्यात् गुरुदेवद्विजार्चकः"<br><b>उल्लेखाः - </b>मनु० ११-२२४<br><br>

अर्चिका
अर्चिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜಿಸುವವಳು<br><br>अर्चिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಕಿಯ ಉರಿ /ಜ್ವಾಲೆ<br><b>निष्पत्तिः - </b>अर्च (पूजायाम्) - "इन्" (उ० ४-११८)<br><b>प्रयोगाः - </b>"आसीदासन्ननिर्वाणः प्रदीपार्चिरिवोषसि"<br><b>उल्लेखाः - </b>रघु० १२-१<br><br>

अर्चन
अर्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ /ಆರಾಧನೆ<br><b>निष्पत्तिः - </b>अर्च (पूजायाम्) - "ल्युट्" (३-३-११५)<br><br>

अर्चना
अर्चना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ /ಆರಾಧನೆ<br><b>निष्पत्तिः - </b>अर्च (पूजायाम्) + णिच् - "युच्" (३-३-१०७)<br><br>

अर्चनीय
अर्चनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಾರ್ಹನಾದ /ಪೂಜೆಗೆ ಯೋಗ್ಯನಾದ<br><b>निष्पत्तिः - </b>अर्च (पूजायाम्) - "अनीयर्" (३-१-९६)<br><b>प्रयोगाः - </b>"अचनीयचरणाम्बुजे भवत्याततायिपदवीमुपेयुषाम्"<br><b>उल्लेखाः - </b>याद० १७-११५<br><br>

अर्चा
अर्चा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ /ಆರಾಧನೆ<br><b>निष्पत्तिः - </b>अर्च (पूजायाम्) - "अः" (३-३-१०३)<br><br>अर्चा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಮೆ /ವಿಗ್ರಹ /ಪೂಜಿಸಲ್ಪಡುವ ಮೂರ್ತಿ<br><b>विस्तारः - </b>"अर्चा पूजाप्रतिमयोः" - वैज० ।<br><br>

अर्चिचयिषा
अर्चिचयिषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲು ಅಪೇಕ್ಷೆ /ಆರಾಧಿಸಲು ಇಚ್ಛೆ<br><b>निष्पत्तिः - </b>अर्च (पूजायाम्) + णिच् + सन् - "अः" (३-३-१०२)<br><br>

अर्चिचयिषु
अर्चिचयिषु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲು ಅಪೇಕ್ಷೆಯುಳ್ಳ /ಆರಾಧಿಸಲು ಇಷ್ಟವುಳ್ಳ<br><b>निष्पत्तिः - </b>अर्च (पूजायाम्) + णिच् + सन् - "उः" (३-२-१६८)<br><b>व्युत्पत्तिः - </b>अर्च्यितुमिच्छुः<br><b>प्रयोगाः - </b>"यष्टुमिच्छसि पितॄन्न साम्प्रतं संवृतोऽर्चिचयिषुर्दिवौकसः"<br><b>उल्लेखाः - </b>किरा० १३-६५<br><br>

अर्चित
अर्चित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>"अर्चिष्मानर्चितः कुम्भो विशुद्धात्मा विशोधनः"<br><b>उल्लेखाः - </b>वि० स०<br><br>अर्चित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಡುವ /ಆರಾಧಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अर्च (पूजायाम्) - "क्तः" (३-२-१८८)<br><b>प्रयोगाः - </b>"अनर्घ्यमर्घ्येण तमद्रिनाथः स्वर्गौकसामर्चितमर्चयित्वा"<br><b>उल्लेखाः - </b>कुमा० १-५८<br><br>अर्चित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अर्च (पूजायाम्) - कर्म० "क्तः" (३-२-१०२)<br><br>

अर्चिष्मत्
अर्चिष्मत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>"अर्चिष्मानर्चितः कुम्भो विशुद्धात्मा विशोधनः"<br><b>उल्लेखाः - </b>वि० स०<br><br>अर्चिष्मत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>अर्चिष्मत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>अर्चिरस्यास्ति<br><br>अर्चिष्मत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉರಿಯುತ್ತಿರುವ /ಪ್ರಕಾಶಮಾನವಾದ<br><br>

अर्चिस्
अर्चिस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಣ /ರಶ್ಮಿ<br><br>अर्चिस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><br>अर्चिस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಕಿಯ ಉರಿ /ಜ್ವಾಲೆ<br><b>निष्पत्तिः - </b>अर्च (पूजायाम्) - "इसिः" (उ० २-१०८)<br><br>अर्चिस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂತಿ /ಪ್ರಕಾಶ<br><b>प्रयोगाः - </b>"प्रशमादर्चिषामेतदनुद्गीर्णसुरायुधम्"<br><b>उल्लेखाः - </b>कुमा० २-२०<br><br>

अर्च्य
अर्च्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಾರ್ಹ /ಪೂಜಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अर्च (पूजायाम्) - "ण्यत्" (३-१-१२४)<br><b>प्रयोगाः - </b>"मरुत्प्रयुक्ताश्च मरुत्सखाभं तमर्च्यमारादभिवर्तमानम्"<br><b>उल्लेखाः - </b>रघु० २-१०<br><br>

अर्जक
अर्जक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿಗಗ್ಗರೆ ಗಿಡ<br><b>निष्पत्तिः - </b>अर्ज (अर्जने) - "ण्वुल्" (३-१-१३३)<br><br>अर्जक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಪಾದಿಸುವವನು<br><br>

अर्जन
अर्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪಾದನೆ<br><b>निष्पत्तिः - </b>अर्ज (प्रतियत्ने) - "ल्युट्" (३-३-११५)<br><br>

अर्जुन
अर्जुन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಂಡುವಿನ ಮಗನಾದ ಅರ್ಜುನ /ಕುಂತಿಯ ಪುತ್ರ<br><br>अर्जुन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ತವೀರ್ಯಾರ್ಜುನ<br><br>अर्जुन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಪು ಮತ್ತಿಮರ<br><b>निष्पत्तिः - </b>अर्ज (अर्जने) - "उनन्" (उ० २-५८)<br><b>प्रयोगाः - </b>"अनादराकृष्टमुलूखलं तद्यावर्जुनौ शैलनिभौ बभञ्ज"<br><b>उल्लेखाः - </b>याद० ४-३७<br><br>अर्जुन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾಯಿಯ ಏಕಮಾತ್ರ ಮಗ<br><br>अर्जुन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನವಿಲು<br><b>विस्तारः - </b>"अर्जुनः ककुभे पार्थे कार्तवीर्यमयूरयोः । मातुरेकसुतेऽपि स्यात् पुंल्लिङ्गो धवलेऽन्यवत्" - मेदि० ।<br><br>अर्जुन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೃಣ /ಹುಲ್ಲು<br><br>अर्जुन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನೇತ್ರ ರೋಗ<br><br>अर्जुन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಳುಪಾದ /ಶುಭ್ರವಾದ<br><br>

अर्जुना
अर्जुना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸು /ಆಕಳು<br><br>अर्जुना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಿರುದ್ಧನ ಪತ್ನಿ /ಉಷಾದೇವಿ<br><br>अर्जुना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಹುದಾ ನದಿ<br><br>अर्जुना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆ ಹಿಡಕಿ<br><b>विस्तारः - </b>"नपुसकं तृणे नेत्रगदे चाप्यर्जुनी गवि । उषायां बहुदानद्यां कुट्टिन्यामपि च क्वचित्" - मेदि० ।<br><br>

अर्ण
अर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಣ /ಅಕ್ಷರ<br><b>विस्तारः - </b>"अस्त्रियौ वर्णमर्णं च" - वैज० ।<br><br>

अर्णव
अर्णव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ /ಕಡಲು<br><b>निष्पत्तिः - </b>अर्णस् - "वः" सलोपश्च (उ० वा० ५-२-१०९)<br><b>व्युत्पत्तिः - </b>अर्णांस्यत्र सन्ति<br><b>प्रयोगाः - </b>"प्रवृद्धमन्द्राम्बुदधीरनादः कृष्णार्णवाभ्यर्णचरैकहंसः"<br><b>उल्लेखाः - </b>माघ० ३-२१<br><br>

अर्णस्
अर्णस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "असुन्" नुट् च (उ० ४-१९६)<br><b>प्रयोगाः - </b>"गाङ्गौघनिर्भस्मितशम्भुकन्धरासवर्णमर्णः कथमन्यथास्य तत्"<br><b>उल्लेखाः - </b>माघ० १२-६९<br><br>

अर्णस्वत्
अर्णस्वत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ /ಕಡಲು<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>अर्णांसि सन्त्यत्र<br><br>अर्णस्वत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಲಸಹಿತವಾದ /ನೀರಿನಿಂದ ಕೂಡಿದ<br><br>

अर्णोद
अर्णोद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><br>अर्णोद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನ್ನಾರಿ ಗೆಡ್ಡೆ<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>अर्णांसि ददाति<br><br>अर्णोद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರನ್ನು ಕೊಡುವ<br><br>

अर्णोभव
अर्णोभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಂಖ<br><br>अर्णोभव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರಿನಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>व्युत्पत्तिः - </b>अर्णसि भवः<br><br>

अर्तन
अर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜುಗುಪ್ಸೆ<br><br>अर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ಬೈಗಳು<br><b>निष्पत्तिः - </b>ऋति (सौत्रधातुः) - "ल्युट्" (३-३-११५)<br><br>

अर्ति
अर्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೀಡೆ /ಬಾಧೆ<br><br>अर्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಧನಸ್ಸಿನ ಅಗ್ರಭಾಗ /ಬಿಲ್ಲಿನ ತುದಿ<br><b>निष्पत्तिः - </b>अर्द (हिंसायाम्) - "क्तिन्" (वा० ३-३-९४)<br><b>प्रयोगाः - </b>"नान्नं वाञ्छति नो निद्रामुपैत्यर्तिनिपीडितः"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

अर्तिका
अर्तिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠ ಸಹೋದರಿ /ಅಕ್ಕ<br><br>

अर्थ
अर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ರವ್ಯ /ಹಣ /ಧನ<br><b>निष्पत्तिः - </b>अर्थ (उपयाञ्चायाम्) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>अर्थ्यते<br><b>प्रयोगाः - </b>"त्यागाय सम्भृतार्थानां सत्याय मितभाषिणाम्"<br><b>उल्लेखाः - </b>रघु० १-७<br><br>अर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಯ /ಉದ್ದೇಶ /ಗುರಿ<br><b>प्रयोगाः - </b>"न हि बुद्धिगुणेनैव सुहृदामर्थदर्शनम्"<br><b>उल्लेखाः - </b>माल० ४-६<br><br>अर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದಶಕ್ತಿಯಿಂದ ತಿಳಿಯಿಸಲ್ಪಡುವ ಅರ್ಥ<br><b>प्रयोगाः - </b>"अर्थो वाच्यश्च लक्ष्यश्च व्यङ्ग्यश्चेति त्रिधा मतः । वाच्योऽर्थोऽभिधया बोध्यो लक्ष्यो लक्ष्यो लक्षणया मतः ।" "वागर्थाविव सम्पृक्तौ वागर्थः प्रतिपत्तये" ।<br><b>उल्लेखाः - </b>सा० द०, रघु० १-१<br><br>अर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸ್ತು /ಪದಾರ್ಥ<br><b>प्रयोगाः - </b>"अर्थो हि कन्या परकीय एव"<br><b>उल्लेखाः - </b>शाकु० ४-२१<br><br>अर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರಣ /ನಿಮಿತ್ತ<br><b>प्रयोगाः - </b>"त्द्गच्छ सिद्ध्यै कुरु देवकार्यमर्थोऽयमर्थान्तरलभ्य एव"<br><b>उल्लेखाः - </b>कुमा० ३-१८<br><br>अर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿವೃತ್ತಿ /ತಡೆ<br><b>प्रयोगाः - </b>"मशकार्थो धूमः"<br><br>अर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಚನೆ /ಬೇಡಿಕೆ<br><b>प्रयोगाः - </b>"अर्थोऽनर्थो महाकोशः"<br><b>उल्लेखाः - </b>वि० स०<br><br>अर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>अर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಗ್ನದಿಂದ ಎರಡನೆಯ ಸ್ಥಾನ<br><br>अर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಫಲ /ಪರಿಣಾಮ<br><br>अर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆ /ಅಭಿಲಾಷೆ<br><br>अर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಜಸ್ಥಿತಿ /ವಸ್ತುಸ್ವಭಾವ<br><br>अर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾರ /ವಿಧಿ /ಬಗೆ<br><br>अर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಯ /ಪ್ರತಿಪಾದನೆಯ ವಸ್ತು<br><b>प्रयोगाः - </b>"तया भवतोऽविनयमन्तरेण परिगृहीतार्था कृता देवी"<br><b>उल्लेखाः - </b>माल० ४<br><br>अर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯೋಜನ /ಕಾರ್ಯ<br><b>प्रयोगाः - </b>"सेना परिच्छदस्तस्य द्वयमेवार्थसाधनम्"<br><b>उल्लेखाः - </b>रघु० १-१९<br><br>अर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನ ತಂತ್ರಾವಾಪಗಳು<br><br>अर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯವಹಾರ<br><br>अर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರ<br><b>विस्तारः - </b>"अर्थः प्रकारे विषये व्यवहारे प्रयोजने । अभिधेये धने शास्त्रे वस्तुहेतुनिवृत्तिषु" - नानार्थर० ।<br><br>

अर्थगत
अर्थगत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥದೋಷ /ಅರ್ಥದಲ್ಲಿರುವ ದೋಷ<br><br>अर्थगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಥದಲ್ಲಿರುವ<br><br>

अर्थगौरव
अर्थगौरव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥಗಾಂಭೀರ್ಯ /ಗಂಭೀರವಾದ ಬಹಳ ಅರ್ಥಗಳಿಂದ ಕೂಡಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>अर्थस्य गौरवम्<br><b>प्रयोगाः - </b>"स्फुटता न पदैरपाकृता न च न स्वीकृतमर्थगौरवम्"<br><b>उल्लेखाः - </b>किरा० २-२७<br><br>

अर्थघ्न
अर्थघ्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯವನ್ನು ನಾಶಪಡಿಸುವ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) - "कः" (वा० ३-२-५)<br><b>व्युत्पत्तिः - </b>अर्थं हन्ति<br><br>

अर्थघ्नी
अर्थघ्नी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯವನ್ನು ನಾಶಪಡಿಸುವ<br><b>प्रयोगाः - </b>"व्याधिता वाधिवेत्तव्या हिंस्रार्थघ्नी च सर्वदा"<br><b>उल्लेखाः - </b>मनु० ९-८०<br><br>

अर्थचिन्ता
अर्थचिन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನ ತಂತ್ರಾವಾಪ ರೂಪವಾದ ಚಿಂತೆ<br><br>अर्थचिन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದ್ರವ್ಯಚಿಂತೆ<br><br>अर्थचिन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯಚಿಂತೆ<br><br>

अर्थज्ञ
अर्थज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯೋಜನವನ್ನು ಅರಿತಿರುವ<br><b>निष्पत्तिः - </b>ज्ञा (अवबोधने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>अर्थं जानाति<br><br>

अर्थतस्
अर्थतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅರ್ಥಾನುಸಾರವಾಗಿ<br><br>अर्थतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅರ್ಥದಿಂದ<br><b>निष्पत्तिः - </b>अर्थ - "तसिः" (वा० ५-४-४४)<br><b>प्रयोगाः - </b>"यत्प्रौढित्वमुदारता च वचसां यच्चार्थतो गौरवम्"<br><b>उल्लेखाः - </b>मालती० १-१०<br><br>अर्थतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಜವಾಗಿ /ವಸ್ತುಸ್ವಭಾವದಿಂದ<br><b>प्रयोगाः - </b>"आकाशसाम्यं दधुरम्बराणि न नामतः क्र्वलमर्थतोऽपि"<br><b>उल्लेखाः - </b>माघ० ३-५६<br><br>अर्थतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಮಿತ್ತದಿಂದ /ಕಾರಣದಿಂದ<br><br>अर्थतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಧನಕ್ಕಾಗಿ /ಹಣಕ್ಕೋಸ್ಕರ<br><b>प्रयोगाः - </b>"ऐश्वर्यादनपेतमीश्वरमयं लोकोऽर्थतः सेवते"<br><b>उल्लेखाः - </b>मुद्रा० १-१४<br><br>

अर्थद
अर्थद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರ<br><br>अर्थद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಷ್ಯ /ಗುರುವನ್ನು ಗುರುದಕ್ಷಿಣೆಯಿಂದ ಸಂತೋಷಪಡಿಸುವ ವಿದ್ಯಾರ್ಥಿ<br><br>अर्थद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಥವನ್ನು ಅರ್ಪಿಸುವ /ಹಣವನ್ನು ಕೊಡುವ<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>अर्थं ददाति<br><b>प्रयोगाः - </b>"आप्तः शक्तोऽर्थदः साधुः स्वोऽध्याप्या दश धर्मतः"<br><b>उल्लेखाः - </b>मनु० २-१०९<br><br>

अर्थदर्शन
अर्थदर्शन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯಜ್ಞಾನ /ಕಾರ್ಯಸ್ವರೂಪದ ತಿಳುವಳಿಕೆ<br><br>अर्थदर्शन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಸ್ತುವಿನ ತೋರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>अर्थस्य दर्शनम्<br><b>प्रयोगाः - </b>"सुकृतः परिशुद्ध आगमः कुरुते दीप इवार्थदर्शनम्"<br><b>उल्लेखाः - </b>किरा० २-३३<br><br>

अर्थदोष
अर्थदोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>अर्थगत ಪದದ ೧ನೆಯ ಅರ್ಥ<br><br>

अर्थना
अर्थना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಚನೆ /ಬೇಡಿಕೆ<br><b>निष्पत्तिः - </b>अर्थ (याञ्चायाम्) + णिच् - "युच्" (३-३-१०७)<br><b>प्रयोगाः - </b>"अर्थना मयि भवद्भिरिवास्यै कर्तुमर्हति मयापि भवत्सु"<br><b>उल्लेखाः - </b>नैष० ५-११२<br><br>

अर्थपति
अर्थपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ /ದೊರೆ<br><b>व्युत्पत्तिः - </b>अर्थानां पतिः<br><b>प्रयोगाः - </b>"अर्थ्यामर्थपतिर्वाचमाददे वदतां वरः" । "किञ्चिद्विहस्यार्थपतिं बभाषे" ।<br><b>उल्लेखाः - </b>रघु० १-५९, रघु० २-४६<br><br>अर्थपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರ /ಧನದ ಅಧಿಪತಿ<br><br>

अर्थप्रकृति
अर्थप्रकृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಧಾನಕಾರ್ಯದ ಕಾರಣ /ಮುಖ್ಯಪ್ರಯೋಜನದ ಹೇತು<br><b>प्रयोगाः - </b>"बीजबिन्दुपताकाख्यप्रकरिकार्यलक्षणाः । आरम्भयत्नप्राप्त्याशानियताप्तिफलागमाः । अर्थप्रकृतयः पञ्च पञ्चावस्थासमन्विताः । यथासङ्ख्येन जायन्ते मुखाद्याः पञ्च सन्धयः ॥"<br><b>उल्लेखाः - </b>दशरू०<br><br>

अर्थप्रयोग
अर्थप्रयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ್ಯಾಡಳಿತ /ಸರ್ಕಾರವನ್ನು ನಡೆಸುವುದು<br><br>

अर्थप्राप्त
अर्थप्राप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಥಲಬ್ಧವಾದ /ಉಪಾತ್ತ ಶಬ್ದದಿಂದ ತಿಳಿಯದೆ ಅದರ ಅರ್ಥದಿಂದ ತಿಳಿಯಲ್ಪಟ್ಟ<br><br>अर्थप्राप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯಾಂತರದಿಂದ ಲಬ್ಧವಾದ /ಬೇರೆ ಕಾರ್ಯದ ಸಂದರ್ಭದಿಂದ ಒದಗಿದ<br><br>

अर्थवत्
अर्थवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಥದಿಂದ ಕೂಡಿದ /ಅರ್ಥಗರ್ಭಿತವಾದ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>अर्थोऽस्यास्ति<br><br>अर्थवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧನಿಕ /ಹಣವಂತ<br><b>प्रयोगाः - </b>"तेनार्थवान् लोभपराङ्मुखेन तेन घ्नता विघ्नभयं क्रियावान्"<br><b>उल्लेखाः - </b>रघु० १४-२३<br><br>अर्थवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯೋಜನ ಸಹಿತವಾದ /ಸಫಲವಾದ<br><br>अर्थवत्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅರ್ಥದಂತೆ /ಅರ್ಥಕ್ಕೆ ಸರಿಯಾಗಿ<br><br>अर्थवत्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯಕ್ಕೆ ಅನುಸಾರವಾಗಿ<br><b>निष्पत्तिः - </b>अर्थ - "वतिः" (५-१-११५)<br><br>

अर्थवती
अर्थवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अर्थवत् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><b>प्रयोगाः - </b>"करोति योऽशेषजनातिरिक्तां सम्भावनामर्थवतीं क्रियाभिः"<br><b>उल्लेखाः - </b>किरा० ३-५१<br><br>

अर्थवाद
अर्थवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತುತಿವಾಕ್ಯ /ಹೊಗಳಿಕೆಯ ಮಾತು<br><br>अर्थवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದಾವಚನ<br><b>व्युत्पत्तिः - </b>अर्थस्य प्रयोजनस्य वादः<br><br>अर्थवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಂಥದ ತಾತ್ಪರ್ಯವನ್ನು ನಿರ್ಣಯಿಸುವ ೬ ಉಪಕರಣಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"उपक्रमोपसंहारावभ्यासोऽपूर्वताफलम् । अर्थवादोपपत्ती च हेतुस्तात्पर्यनिर्णये ॥"<br><br>

अर्थविद्
अर्थविद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯಜ್ಞ /ಕಾರ್ಯದ ಸ್ವರೂಪವನ್ನು ಬಲ್ಲವನು /ಚತುರ /ಬುದ್ಧಿವಂತ<br><b>निष्पत्तिः - </b>विद (ज्ञाने) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>अर्थं वेत्ति<br><br>अर्थविद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಥವನ್ನು ಬಲ್ಲವನು /ಶಬ್ದಾರ್ಥವನ್ನು ತಿಳಿದವನು<br><b>प्रयोगाः - </b>"अवेक्ष्य धातोर्गमनार्थमर्थविच्चकार नाम्ना रघुमात्मसम्भवम्"<br><b>उल्लेखाः - </b>रघु० ३-२१<br><br>

अर्थवृद्धि
अर्थवृद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಧನವೃದ್ಧಿ /ಐಶ್ವರ್ಯವು ಅಧಿಕವಾಗುವಿಕೆ<br><br>

अर्थव्यय
अर्थव्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಣದ ಖರ್ಚು /ಹಣದ ವೆಚ್ಚ<br><br>

अर्थव्ययज्ञ
अर्थव्ययज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಲ ದೇಶ ಮತ್ತು ಪಾತ್ರಾಪಾತ್ರಗಳನ್ನು ವಿಮರ್ಶಿಸಿ ಖರ್ಚು ಮಾಡುವವನು /ಹಣದ ಖರ್ಚಿನ ಕ್ರಮವನ್ನರಿತವನು<br><br>

अर्थशास्त्र
अर्थशास्त्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀತಿ ಶಾಸ್ತ್ರ /ರಾಜನೀತಿ /ದಂಡನೀತಿ<br><b>व्युत्पत्तिः - </b>अर्थस्य धनादेः प्रापकं शास्त्रम्<br><b>प्रयोगाः - </b>"इह खलु अर्थशास्त्रकाराः त्रिविधां सिद्धिमुपार्णयन्ति"<br><b>उल्लेखाः - </b>मुद्रा० ३<br><br>अर्थशास्त्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂತ್ರ ತಂತ್ರಗಳ ಪ್ರಯೋಗದಿಂದ ಮಾಡುವ ಹಿಂಸಾಕೃತ್ಯಗಳನ್ನು ನಿರೂಪಿಸುವ ಶಾಸ್ತ್ರ<br><br>

अर्थशौच
अर्थशौच<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದ್ರವ್ಯಶುದ್ಧಿ /ನ್ಯಾಯ ಮಾರ್ಗದಿಂದ ಸಂಪಾದಿಸಿದ ಧನದ ಪರಿಶುದ್ಧತೆ<br><b>प्रयोगाः - </b>"सर्वेषामेव शौचानामर्थशौचं परं स्मृतम्"<br><b>उल्लेखाः - </b>मनु० ५-१०६<br><br>

अर्थसङ्ग्रह
अर्थसङ्ग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಣದ ಸಂಪಾದನೆ /ಹಣದ ಕೂಡಿಕೆ<br><br>

अर्थसमाज
अर्थसमाज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಣದ ರಾಶಿ<br><br>अर्थसमाज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನೇಕಾರ್ಥಗಳ ಗುಂಪು<br><br>अर्थसमाज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರಣಗಳ ಸಮೂಹ<br><br>

अर्थसमाहार
अर्थसमाहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಣದಸಂಪಾದನೆ<br><br>अर्थसमाहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಧಿ /ನಿಕ್ಷೇಪ<br><br>

अर्थसिद्ध
अर्थसिद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಾತ್ತವಾದ ಶಬ್ದಗಳ ಶಕ್ತಿಯಿಂದ ಉಂಟಾಗದೆ ಪೂರ್ವೋತ್ತರ ಸಂಬಂಧದಿಂದ ಸಿದ್ಧವಾದ /ಅನ್ವಯ ಲಬ್ಧವಾದ<br><br>अर्थसिद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯೋಜನವನ್ನು ಪಡೆದ<br><br>अर्थसिद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧನವನ್ನು ಪಡೆದ<br><br>

अर्थसिद्धि
अर्थसिद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯಸಿದ್ಧಿ /ಕಾರ್ಯವು ಕೈಗೂಡುವಿಕೆ<br><b>व्युत्पत्तिः - </b>अर्थस्य कार्यस्य सिद्धिः<br><b>प्रयोगाः - </b>"अर्थसिद्ध्यै हरिश्रेष्ठ गच्छ सौम्य यथासुखम्"<br><b>उल्लेखाः - </b>रामा०<br><br>

अर्थहर
अर्थहर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಣವನ್ನು ಪಡೆಯುವವನು /ಹಿರಿಯರಿಂದ ಆಸ್ತಿಯನ್ನು ತೆಗೆದುಕೊಳ್ಳುವವನು<br><b>निष्पत्तिः - </b>हृञ् (हरणे) - "अच्" (३-२-९)<br><b>व्युत्पत्तिः - </b>अर्थं हरति<br><br>

अर्थहीन
अर्थहीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದರಿದ್ರ /ಧನಹೀನ<br><b>व्युत्पत्तिः - </b>अर्थेन हीनः<br><br>अर्थहीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಥವಿಲ್ಲದ ಶಬ್ದ<br><br>

अर्थागम
अर्थागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥಲಾಭ /ಧನಲಾಭ<br><b>व्युत्पत्तिः - </b>अर्थस्यागमः<br><b>प्रयोगाः - </b>"अर्थागमो नित्यमरोगिता च"<br><b>उल्लेखाः - </b>हितो०<br><br>अर्थागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂದರ್ಭವಿಶೇಷದಿಂದ ಮತ್ತೊಂದು ಅರ್ಥವುಂಟಾಗುವಿಕೆ<br><br>अर्थागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ರವ್ಯಸಂಪಾದನೆಗೆ ಕಾರಣವಾದ ವ್ಯಾಪಾರ<br><b>व्युत्पत्तिः - </b>अर्थ आगम्यते अनेन<br><br>

अर्थान्तर
अर्थान्तर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರೆ ಅರ್ಥ<br><br>अर्थान्तर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರೊಂದು ಕಾರಣ<br><b>व्युत्पत्तिः - </b>अन्योऽर्थः<br><b>प्रयोगाः - </b>"तद्गच्छ सिद्ध्यै कुरु देवकार्यमर्थोऽयमर्थान्तरलभ्य एव"<br><b>उल्लेखाः - </b>कुमा० ३-१८<br><br>अर्थान्तर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತರ್ಕಶಾಸ್ತ್ರದಲ್ಲಿ ಉಕ್ತವಾದ ಒಂದು ದೋಷ /ನಡೆಸಿದ ಪ್ರಯತ್ನದಿಂದ ಪ್ರಕೃತ ಕಾರ್ಯ ಸಿದ್ಧಿಸದೆ ಬೇರೊಂದು ಕಾರ್ಯವು ಸಿದ್ಧಿಸುವಿಕೆ<br><br>

अर्थान्तरन्यास
अर्थान्तरन्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥಾಲಂಕಾರದ ಒಂದು ಭೇದ /ಒಂದು ಅರ್ಥವು ಸಿದ್ಧಿಸುವುದಕ್ಕಾಗಿ ಅದರ ಸಮರ್ಥನರೂಪವಾದ ಮತ್ತೊಂದು ಅರ್ಥವನ್ನು ಹೇಳುವುದು<br><b>प्रयोगाः - </b>"उक्तिरर्थान्तरन्यासः स्यात् सामन्यविशेषयोः"<br><b>उल्लेखाः - </b>चन्द्रा०<br><br>

अर्थापत्ति
अर्थापत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಅಂಶದಿಂದ ಮತ್ತೊಂದು ಅಂಶವನ್ನು ಕಲ್ಪಿಸುವುದು /ಉಪಪಾದ್ಯವಾದ ಅರ್ಥದಿಂದ ಅದರ ಉಪಪಾದಕ ಜ್ಞಾನವುಂಟಾಗುವಿಕೆ<br><br>अर्थापत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಅರ್ಥಾಲಂಕಾರ<br><b>प्रयोगाः - </b>"कौमुत्येनार्थसंसिद्धिः काव्यार्थापत्तिरिष्यते । स जितस्त्वन्मुखेनेन्दुः का वार्ता सरसीरुहाम्"<br><br>

अर्थिक
अर्थिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತುತಿಪಾಠಕ /ಹೊಗಳುಭಟ<br><b>व्युत्पत्तिः - </b>अर्थिन एव<br><b>विस्तारः - </b>"वैतालिका बोधकरा अर्थिकाः सौखसुप्तिकाः"- अभि० चि० ।<br><br>

अर्थित
अर्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾರ್ಥಿಸಲ್ಪಟ್ಟ /ಯಾಚಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अर्थ (उपयाञ्चायाम्) - "क्तः" (३-२-१०२)<br><br>

अर्थिता
अर्थिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರ್ಥನೆ /ಯಾಚನೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>अर्थिनो भावः<br><b>प्रयोगाः - </b>"अप्यसुप्रणयिनां रघोः कुले न व्यहन्यत कदाचिदर्थिता"<br><b>उल्लेखाः - </b>रघु० ११-२<br><br>अर्थिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಚ್ಛೆ /ಅಪೇಕ್ಷೆ<br><b>प्रयोगाः - </b>"यद्यर्थिता निर्हृतवाच्यशल्यान् प्राणान् मया धारयितुं चिरं वः"<br><b>उल्लेखाः - </b>रघु० १४-४२<br><br>

अर्थित्व
अर्थित्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>अर्थिता ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><b>प्रयोगाः - </b>"अर्थित्वे प्रकटीकृतेऽपि न फलप्राप्तिः प्रभोः"<br><b>उल्लेखाः - </b>म० वी० २-९<br><br>

अर्थिन्
अर्थिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾಚಕ /ಭಿಕ್ಷುಕ /ಬೇಡುವವನು<br><b>निष्पत्तिः - </b>अर्थ (उपयाञ्चायाम्) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अर्थयते<br><b>प्रयोगाः - </b>"यथाविधि हुताग्नीनां यथाकामार्चितार्थिनाम्"<br><b>उल्लेखाः - </b>रघु० १-६<br><br>अर्थिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದರಿದ್ರ /ಧನಹೀನ<br><b>निष्पत्तिः - </b>"इनिः" (वा० ५-२-१३५)<br><b>व्युत्पत्तिः - </b>असन्निहितोऽर्थोऽस्यास्ति<br><br>अर्थिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಕ /ಆಳು<br><br>अर्थिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾದಿ /ವ್ಯಾಜ್ಯ ಹೂಡುವವನು<br><b>प्रयोगाः - </b>"स धर्मस्थसखः शश्वदर्थिप्रत्यर्थिनां स्वयम् । ददर्श संशयच्छेद्यान् व्यवहारानतन्द्रितः ॥"<br><b>उल्लेखाः - </b>रघु० १७-३९<br><br>अर्थिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆಯುಳ್ಳ /ಆಸೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>अर्थोऽपेक्षाऽस्यास्ति<br><br>

अर्थिनी
अर्थिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अर्थिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अर्थिभाव
अर्थिभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಚನೆ /ಬೇಡಿಕೆ<br><b>व्युत्पत्तिः - </b>अर्थिनो भावः<br><b>प्रयोगाः - </b>"कं याचे यत्र तत्र ध्रुवमनवसरग्रस्त एवार्थिभावः"<br><b>उल्लेखाः - </b>मालती० ९-३०<br><br>

अर्थिसात्
अर्थिसात्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಾಚಕನಿಗೆ ಸಂಪೂರ್ಣ ಅಧೀನವಾಗಿ<br><b>निष्पत्तिः - </b>अर्थिन् - "सातिः" (५-४-५२)<br><b>प्रयोगाः - </b>"विभज्य मेरुर्न यदर्थिसात्कृतो सिन्धुरुत्सर्गजलव्ययैर्मरुः"<br><b>उल्लेखाः - </b>नैष० १-१६<br><br>

अर्थोपक्षेपक
अर्थोपक्षेपक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಟಕದ ಒಂದು ಅಂಗ<br><b>निष्पत्तिः - </b>उप + क्षिपु (निरसने) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>अर्थान् उपक्षिपति<br><br>

अर्थोपपत्ति
अर्थोपपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯಸಿದ್ಧಿ /ಕಾರ್ಯವು ಕೈಗೂಡುವಿಕೆ<br><b>व्युत्पत्तिः - </b>अर्थस्य उपपत्तिः<br><b>प्रयोगाः - </b>"स्वार्थोपपत्तिं प्रति दुर्बलाशस्तमित्यवोचद्वरतन्तुशिष्यः"<br><b>उल्लेखाः - </b>रघु० ५-१२<br><br>

अर्थ्य
अर्थ्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಲಾಜತು<br><br>अर्थ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಂಡಿತ /ತಿಳುವಳಿಕೆಯುಳ್ಳವನು<br><br>अर्थ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಥಸಹಿತವಾದ /ಅರ್ಥಗರ್ಭಿತವಾದ<br><b>निष्पत्तिः - </b>"यत्" (४-४-९२)<br><b>व्युत्पत्तिः - </b>अर्थादनपेतः<br><b>प्रयोगाः - </b>"वागीशं वाग्भिरर्थ्याभिः प्रणिपत्योपतस्थिरे"<br><b>उल्लेखाः - </b>कुमा० २-३<br><br>अर्थ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನ್ಯಾಯವಾದ /ಯೋಗ್ಯವಾದ<br><br>अर्थ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾಚಿಸಲು ಯೋಗ್ಯವಾದ<br><br>अर्थ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲು ಅರ್ಹವಾದ<br><b>विस्तारः - </b>"अर्थ्यं शिलाजतुन्यर्थ्यो बुधे न्याय्ये च वाच्यवत्" - मेदि० ।<br><br>

अर्द|गतौ|याचने
अर्द - गतौ याचने च (भ्वा० प० से)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ನಡೆ /ಚಲಿಸು<br><br>अर्द - गतौ याचने च (भ्वा० प० से)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಯಾಚಿಸು /ಬೇಡು<br><b>प्रयोगाः - </b>"स्वस्त्यस्तु ते निर्गलिताम्बुगर्भं शरद्घनं नार्दति चातकोऽपि"<br><b>उल्लेखाः - </b>रघु० ५-१७<br><br>

अर्द|हिंसायाम्
अर्द - हिंसायाम् (चु० उभ० से०)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸು /ಪೀಡಿಸು<br><b>प्रयोगाः - </b>"अव्यर्णो गिरिकूटाभानभ्यर्णानार्दिदद्द्रुतम्"<br><b>उल्लेखाः - </b>भट्टि० ९-१९<br><br>

अर्दन
अर्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸುವುದು /ಪೀಡಿಸುವುದು<br><br>अर्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಚಿಸುವುದು /ಬೇಡುವುದು<br><br>अर्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಮನ /ಚಲನೆ<br><br>अर्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಲ್ಲುವುದು<br><b>निष्पत्तिः - </b>अर्द (गतौ याचने हिंसायां च) - "ल्युट्" (३-३-११५)<br><br>अर्दन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸುವ /ಬೇಡುವ<br><b>निष्पत्तिः - </b>अर्द - "ल्युः" (३-१-१३४)<br><b>प्रयोगाः - </b>"सृजस्वेति तदोवाच बलं परबलार्दनम्"<br><b>उल्लेखाः - </b>रामा०<br><br>

अर्दना
अर्दना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರ್ಥನೆ /ಬೇಡುವುದು<br><br>अर्दना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಮನ /ನಡಿಗೆ<br><b>निष्पत्तिः - </b>अर्द (गतौ याचने हिंसायां च) + णिच् - "युच्" (३-३-१०७)<br><br>अर्दना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸೆ /ಪೀಡೆ<br><br>

अर्दित
अर्दित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧವಾದ ವಾತರೋಗ<br><br>अर्दित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸಲ್ಪಟ್ಟ /ಪೀಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अर्द (हिंसायाम्) + णिच् - "क्तः" (३-२-१०२)<br><br>अर्दित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಚಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अर्द (याचने) - "क्तः" (३-२-१०२)<br><b>विस्तारः - </b>"अर्दितं याचितेऽपि स्यात् वातव्याधौ च हिंसिते" - मेदि० ।<br><br>

अर्ध
अर्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಕಲ /ಚೂರು /ಮುರುಕು<br><b>प्रयोगाः - </b>"पश्चार्धेन प्रविष्टः शरपतनभयात् भूयसा पूर्वकायम्"<br><b>उल्लेखाः - </b>शाकु० १-४<br><br>अर्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾರ್ಧ /ಸರಿಯಾಗಿ /ಅರ್ಧಭಾಗ<br><b>निष्पत्तिः - </b>ऋधु (वृद्धौ) - कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>ऋध्नोत्यनेन<br><b>विस्तारः - </b>"अर्धः खण्डे समांशेऽर्धम्" - हेम० ।<br><br>अर्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹ /ಮನೆ<br><b>निष्पत्तिः - </b>ऋधु - अधि० "घञ्" (३-३-१२१)<br><br>अर्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ /ಏಳಿಗೆ<br><b>निष्पत्तिः - </b>ऋधु - भावे "घञ्" (३-३-१८)<br><br>

अर्धगङ्गा
अर्धगङ्गा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾವೇರೀ ನದಿ<br><b>व्युत्पत्तिः - </b>अर्धं गङ्गायाः<br><br>

अर्धगुच्छ
अर्धगुच्छ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೨೪ ಎಳೆಗಳುಳ್ಳ ಹಾರ<br><br>

अर्धगर्भ
अर्धगर्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಕಿರಣ<br><b>व्युत्पत्तिः - </b>अर्धे वत्सरस्यार्धे गर्भं गर्भस्थानीयमुदकं यस्य<br><br>

अर्धचन्द्र
अर्धचन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರನ ಅರ್ಧಭಾಗ<br><b>व्युत्पत्तिः - </b>अर्धं चन्द्रस्य<br><b>प्रयोगाः - </b>"शब्दमीश्वर इत्युच्चैः सार्धचन्द्रं बिभर्ति यः"<br><b>उल्लेखाः - </b>कुमा० ६-७५<br><br>अर्धचन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧಚಂದ್ರಾಕಾರದ ಉಗುರಿನ ಗಾಯ /ನಖಕ್ಷತ<br><br>अर्धचन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನವಿಲುಗರಿಯಲ್ಲಿರುವ ಅರ್ಧಚಂದ್ರಾಕಾರದ ಗುರುತು<br><br>अर्धचन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧಚಂದ್ರನಂತೆ ಮುಖವುಳ್ಳ ಬಾಣ<br><br>अर्धचन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತು ಹಿಡಿದು ನೂಕಲು ಅರ್ಧಚಂದ್ರಾಕಾರವಾಗಿ ಮಾಡುವ ಹಸ್ತ<br><br>

अर्धचन्द्रा
अर्धचन्द्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಿಗಡೆ ಮರ<br><b>विस्तारः - </b>"अर्धचन्द्रस्तु गलहस्तेन्दुखण्डयोः । चन्द्रके बाणभेदे चाऽर्धचन्द्रा त्रिवृताभिदि" - हेम० ।<br><br>

अर्धचन्द्रक
अर्धचन्द्रक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನವಿಲು ಗರಿಯಲ್ಲಿರುವ ಅರ್ಧಚಂದ್ರಾಕಾರದ ಗುರುತು<br><br>

अर्धचोलक
अर्धचोलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಪ್ಪಸ /ಕಂಚುಕ /ರವಿಕೆ<br><br>

अर्धजरतीय
अर्धजरतीय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧಮುದುಕಿಯಂತಿರುವ ಒಂದು ನ್ಯಾಯ<br><b>प्रयोगाः - </b>"अर्धं मुखमात्रं जरत्याः कामयते नाङ्गानीति सोऽयमर्धजरतीयन्यायः स चात्र न युक्तः" ।<br><br>

अर्धजाह्नवी
अर्धजाह्नवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾವೇರೀ ನದಿ<br><b>व्युत्पत्तिः - </b>अर्धं जाह्नव्याः<br><br>

अर्धनारीश
अर्धनारीश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧಪಾರ್ವತಿಯ ಮತ್ತು ಅರ್ಧ ಈಶ್ವರನ ದೇಹಗಳಿಂದ ಕೂಡಿದ ಪರಮೇಶ್ವರನ ಒಂದು ರೂಪ<br><b>व्युत्पत्तिः - </b>अर्धं नार्याः । अर्धनारीयुक्तः ईशः<br><br>

अर्धनारीश्वर
अर्धनारीश्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧಪಾರ್ವತಿಯ ಮತ್ತು ಅರ್ಧ ಈಶ್ವರನ ದೇಹಗಳಿಂದ ಕೂಡಿದ ಪರಮೇಶ್ವರನ ಒಂದು ರೂಪ<br><b>व्युत्पत्तिः - </b>अर्धनारीयुक्तः ईश्वरः<br><br>

अर्धनाव
अर्धनाव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧಹಡಗು<br><b>निष्पत्तिः - </b>नौ - "टच्" (५-४-१००)<br><b>व्युत्पत्तिः - </b>अर्धं नावः<br><br>

अर्धनिशा
अर्धनिशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧರಾತ್ರಿ<br><b>व्युत्पत्तिः - </b>अर्धं निशायाः<br><br>

अर्धपण
अर्धपण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೪೦ ಕವಡೆಗಳ ಬೆಲೆಯುಳ್ಳ ಒಂದು ನಾಣ್ಯ<br><b>विस्तारः - </b>"अशीतिभिर्वराटकैः पण इत्यभिधीयते" ।<br><br>

अर्धपादिक
अर्धपादिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಧಕಾಲವನ್ನು ಕತ್ತರಿಸಲು ಅರ್ಹ /ಅರ್ಧಕಾಲವನ್ನು ಕತ್ತರಿಸುವ ಶಿಕ್ಷೆಗೆ ಅರ್ಹನಾದವನು<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-६३)<br><b>व्युत्पत्तिः - </b>अर्धपादमर्हति<br><b>प्रयोगाः - </b>"गोषु ब्राह्मणसंस्थासु छुरिकायाश्च भेदने । पशूनां हरणे चैव सद्यः कार्योऽर्धपादिकः ॥"<br><b>उल्लेखाः - </b>मनु० ८-३२५<br><br>

अर्धपुलायित
अर्धपुलायित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ನಾಗಾಲೋಟ /ಅಶ್ವಗತಿಯ ಒಂದು ಭೇದ<br><b>निष्पत्तिः - </b>अय (गतौ) - भावे "क्तः" (३-३-११४)<br><b>व्युत्पत्तिः - </b>पुलाख्यया अयितं गतिः पुलायितम् ।<br><b>प्रयोगाः - </b>"शतार्धार्धक्रमादूनैर्मण्डलायितवल्गितैः । उन्मुखस्याश्वमुख्यस्य गतिरर्धपुलायितम् ॥"<br><br>

अर्धभाग
अर्धभाग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಸ್ತುವಿನ ಅರ್ಧ /ಏಕದೇಶ<br><b>प्रयोगाः - </b>"तदर्धभागेन लभस्व काङ्क्षितं वरं तमिच्छामि च साधु वेदितुम्"<br><b>उल्लेखाः - </b>कुमा० ५-५०<br><br>

अर्धभाज्
अर्धभाज्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಧಭಾಗವನ್ನು ಹೊಂದುವ /ಅರ್ಧಭಾಗವನ್ನು ಹೊಂದಲು ಹಕ್ಕುದಾರನಾದ<br><b>निष्पत्तिः - </b>भज (सेवायाम्) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>अर्धं भजति<br><b>प्रयोगाः - </b>"निधीनां तु पुराणानां धातूनामेव च क्षितौ‍। अर्धभाग्रक्षणाद्राजा भूमेरधिपतिर्हि सः ॥"<br><b>उल्लेखाः - </b>मनु० ८-३९<br><br>

अर्धभ्रमक
अर्धभ्रमक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದಾಲಂಕಾರದ ಒಂದು ಭೇದ<br><b>प्रयोगाः - </b>"आहुरर्धभ्रमं नाम श्लोकार्धभ्रमणं यदि"<br><br>

अर्धमाणवक
अर्धमाणवक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೧೨ ಎಳೆಗಳ ದಾರ<br><b>व्युत्पत्तिः - </b>अर्धं माणवकस्य<br><b>विस्तारः - </b>"द्वादशस्त्वर्धमाणवः" - वैज० ।<br><br>

अर्धमात्रक
अर्धमात्रक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಲ್ ವರ್ಣ /ವ್ಯಂಜನಾಕ್ಷರ<br><b>प्रयोगाः - </b>"एकमात्रो भवेत् ह्रस्वः द्विमात्रो दीर्घ उच्यते । त्रिमात्रस्तु प्लुतो ज्ञेयः व्यञ्जनं त्वर्धमात्रकम् ॥"<br><br>

अर्धमात्रा
अर्धमात्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವ್ಯಂಜನಾಕ್ಷರವನ್ನು ಉಚ್ಚರಿಸುವ ಕಾಲ<br><br>

अर्धमास
अर्धमास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ತೊಂಗಳಿನ ಅರ್ಧಭಾಗ /ಒಂದು ಪಕ್ಷ<br><b>व्युत्पत्तिः - </b>अर्धं मासस्य<br><br>

अर्धयाम
अर्धयाम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಗಲಿನ ಅಥವಾ ರಾತ್ರಿಯ ಎಂಟನೆಯ ಒಂದು ಭಾಗ /ಮೂರು ಮುಕ್ಕಾಲು ಘಳಿಗೆ<br><b>व्युत्पत्तिः - </b>अर्धं यामस्य<br><br>

अर्धरथ
अर्धरथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ನುರಿಯದ ಯೋಧ /ಒಳ್ಳೆಯ ಅನುಭವ ಪಡೆಯದ ರಥಿಕ<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>रथोऽस्यास्ति । अर्धं असम्पूर्णः रथी ।<br><b>प्रयोगाः - </b>"रणे रणेऽभिमानी च विमुखश्चापि दृश्यते । घृणी कर्णः प्रमादी च तेन सोऽर्धरथो मतः ॥"<br><b>उल्लेखाः - </b>भा० उद्योग० १६८-९<br><br>

अर्धरात्र
अर्धरात्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಡುರಾತ್ರಿ /ಮಧ್ಯರಾತ್ರಿ<br><b>निष्पत्तिः - </b>"अच्" (५-४-८७)<br><b>व्युत्पत्तिः - </b>अर्धं रात्रेः<br><b>प्रयोगाः - </b>"अथार्धरात्रे स्तिमितप्रदीपे शय्यागृहे सुप्तजने प्रबुद्धः"<br><b>उल्लेखाः - </b>रघु० १६-४<br><br>

अर्धविसर्ग
अर्धविसर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಹ್ವಾಮೂಲೀಯ ಮತ್ತು ಉಪಧ್ಮಾನೀಯ<br><br>

अर्धवीक्षण
अर्धवीक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರೆನೋಟ /ವಾರೆನೋಟ /ಕಟಾಕ್ಷ<br><br>

अर्धशत
अर्धशत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>೫೦<br><b>व्युत्पत्तिः - </b>अर्धं शतस्य<br><br>

अर्धसम
अर्धसम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಣವೃತ್ತದ ಒಂದು ಭೇದ<br><b>प्रयोगाः - </b>"सममर्धसमं वृत्तं विषमं च त्रिधा मतम् । प्रथमाङ्घ्रिसमो यस्य तृतीयश्चरणो भवेत् । द्वितीयस्तुर्यवद्वृत्तं तदर्धसममुच्यते ॥"<br><b>उल्लेखाः - </b>वृ० र०<br><br>

अर्धसीरिन्
अर्धसीरिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೈತ /ಬೇಸಾಯಗಾರ /ತಾನು ಮಾಡಿದ ವ್ಯವಸಾಯಕ್ಕಾಗಿ ಅರ್ಧಫಲವನ್ನು ಪಡೆಯುವವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>अर्धं सीरस्य । सोऽस्यास्ति<br><b>प्रयोगाः - </b>"शूद्रेषु दासगोपालकुलमित्रार्धसीरिणः"<br><b>उल्लेखाः - </b>याज्ञ० १-१६६<br><br>

अर्धहर
अर्धहर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಧಭಾಗವನ್ನು ಆಕ್ರಮಿಸುವ /ಅರ್ಧಭಾಗವನ್ನು ತೆಗೆದುಕೊಳ್ಳುವ<br><b>निष्पत्तिः - </b>हृञ् (हरणे) - "अच्" (३-२-९)<br><b>व्युत्पत्तिः - </b>अर्धं हरति<br><br>

अर्धहरा
अर्धहरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧಭಾಗವನ್ನು ಆಕ್ರಮಿಸುವ /ಅರ್ಧಭಾಗವನ್ನು ತೆಗೆದುಕೊಳ್ಳುವ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्"<br><b>प्रयोगाः - </b>"समादिदेशैकवधूं भवित्रीं प्रेम्णा शरीरार्धहरां हरस्य"<br><b>उल्लेखाः - </b>कुमा० १-५०<br><br>

अर्धहार
अर्धहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೬೪ ಎಳೆಗಳ ಹಾರ<br><b>विस्तारः - </b>"अर्धहारश्चतुःषष्टिः" - वैज० ।<br><br>

अर्धांश
अर्धांश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಅರ್ಧ /ಅರ್ಧಭಾಗ<br><br>

अर्धार्ध
अर्धार्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧದಲ್ಲಿ ಅರ್ಧಭಾಗ /ನಾಲ್ಕನೆಯ ಒಂದುಭಾಗ<br><b>व्युत्पत्तिः - </b>अर्धमर्धस्य<br><b>प्रयोगाः - </b>"चरोरर्धार्धभागाभ्यां तामयोजयतावुभे"<br><b>उल्लेखाः - </b>रघु० १०-५६<br><br>

अर्धासन
अर्धासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೀಠದ ಅರ್ಧಭಾಗ<br><b>व्युत्पत्तिः - </b>अर्धमासनमस्य<br><b>प्रयोगाः - </b>"उपेयुषः स्वामपि मूर्तिमग्र्यामर्धासनं गोत्रभिदोऽधितष्ठौ"<br><b>उल्लेखाः - </b>रघु० ६-७३<br><br>अर्धासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿಯಿಂದ ಮಾಡುವ ದಾನ<br><br>

अर्धेन्दु
अर्धेन्दु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧಚಂದ್ರ /ಚಂದ್ರನ ಅರ್ಧಭಾಗ<br><br>अर्धेन्दु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧಚಂದ್ರಾಕಾರದ ಮುಖವುಳ್ಳ ಒಂದು ಬಾಣ<br><br>अर्धेन्दु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧಚಂದ್ರಾಕಾರದ ಉಗುರಿನ ಗಾಯ /ನಖಕ್ಷತ<br><br>अर्धेन्दु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನವಿಲಿನ ಗರಿಯಲ್ಲಿರುವ ಅರ್ಧಚಂದ್ರಾಕಾರದ ಗುರುತು<br><br>अर्धेन्दु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತು ಹಿಡಿದು ನೂಕಲು ಅರ್ಧಚಂದ್ರಾಕಾರವಾಗಿ ಮಾಡುವ ಹಸ್ತ<br><br>अर्धेन्दु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೌಢಸ್ತ್ರೀಯ ಯೋನಿಯಲ್ಲಿ ಬೆರಳನ್ನಿಡುವುದು<br><b>विस्तारः - </b>"अर्धेन्दुरर्धचन्द्रे स्यात् गलहस्तनखाङ्कयोः । अर्धेन्दुः स्यात् अतिप्रौढस्त्रीयोन्यङ्गुलियोजने" - मेदि० ।<br><br>

अर्धोदक
अर्धोदक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧ ಮೈ ಮುಳುಗುವಷ್ಟು ನೀರು /ನೀರಿನಲ್ಲಿ ನಿಂತುಕೊಂಡಾಗ ನಾಭಿಯವರೆಗೆ ಬರುವ ನೀರು<br><br>

अर्धोदय
अर्धोदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಪುಣ್ಯಕಾಲ /ತಿಥಿ ವಾರಾದಿಗಳ ಯೋಗದಿಂದುಂಟಾಗುವ ಒಂದು ಪರ್ವಕಾಲ<br><b>व्युत्पत्तिः - </b>अर्धस्य समृद्धस्य पुण्यस्य उदयो यत्र<br><b>प्रयोगाः - </b>"अमार्कपातश्रवणैर्युक्ता चेत्पौषमाघयोः । अर्धोदयः स विज्ञेयः कोटिसूर्यग्रहैः समः ॥"<br><b>उल्लेखाः - </b>निर्णया०<br><br>

अर्धोदयासन
अर्धोदयासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯೋಗಾಸನದ ಒಂದು ಭೇದ /ಭೂಮಿಯ ಮೇಲೆ ಎರಡು ಹಸ್ತಗಳನ್ನು ಮಾತ್ರ ಊರಿ ದೇಹವೆಲ್ಲವನ್ನೂ ಮೇಲೆ ಆಕಾಶದಲ್ಲಿ ನಿಲ್ಲಿಸುವ ಒಂದು ಆಸನ<br><b>प्रयोगाः - </b>"अर्धोदयासनं नाथ सर्वाङ्गं खे नियोजयेत् । केवलं हस्तयुगलं भुव्यवष्टभ्य तिष्ठति ॥"<br><br>

अर्धोरुक
अर्धोरुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸರ ಒಳಲಂಗ /ಪಾವಡೆ /ಮಂಡಿಯವರೆಗೂ ಇರುವ ಒಳಲಂಗ<br><b>निष्पत्तिः - </b>काशृ (दीप्तौ) - "डः" (वा० ३-२-१०१)<br><b>व्युत्पत्तिः - </b>अर्धोरौ काशते<br><b>विस्तारः - </b>"अर्धोरुकं वरस्त्रीणां स्यात् चण्डातकमस्त्रियाम्" - अम० ।<br><br>

अर्ध्य
अर्ध्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೃದ್ಧಿ ಹೊಂದಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>ऋधु (वृद्धौ) + णिच् - "यत्" (३-१-९७)<br><br>अर्ध्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಧದ ಸಂಬಂಧವಾದ<br><b>व्युत्पत्तिः - </b>अर्धस्येदम्<br><br>अर्ध्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಧದಲ್ಲಿರುವ<br><b>व्युत्पत्तिः - </b>अर्धे भवः<br><br>

अर्पण
अर्पण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಡುವುದು /ಇರಿಸುವುದು<br><b>निष्पत्तिः - </b>ऋ (गतौ) + णिच् - "ल्युट्" (३-३-११५) । पुगागमः ।<br><br>अर्पण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲೆ ಇಡುವುದು<br><b>प्रयोगाः - </b>"कैलासगौरं वृषमारुरुक्षोः पादार्पणानुग्रहपूतपृष्ठम्"<br><b>उल्लेखाः - </b>रघु० २-३५<br><br>अर्पण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಡುವುದು /ಅರ್ಪಿಸುವುದು /ದಾನ ಮಾಡುವುದು<br><b>प्रयोगाः - </b>"सेयं स्वदेहार्पणनिष्क्रियेण न्याय्या मया मोचयितुं भवत्तः"<br><b>उल्लेखाः - </b>रघु० २-५५<br><br>अर्पण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂದಕ್ಕೆ ಕೊಡುವುದು /ಹಿಂತಿರುಗಿಸಿ ಕೊಡುವುದು<br><br>अर्पण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇರಿಯುವುದು /ಕೊರೆಯುವುದು<br><b>प्रयोगाः - </b>"तीक्ष्णतुण्डार्पणैर्ग्रीवां नखैः सर्वां व्यदारयत्"<br><b>उल्लेखाः - </b>रामा०<br><br>अर्पण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>निष्पत्तिः - </b>अधि० - "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>अर्प्यतेऽत्र<br><br>अर्पण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂತ್ರ<br><b>निष्पत्तिः - </b>कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>अर्प्यतेऽनेन<br><br>अर्पण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹವಿಸ್ಸು<br><b>निष्पत्तिः - </b>कर्म० "ल्युट्" (३-३-११३)<br><br>

अर्पित
अर्पित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಡಲ್ಪಟ್ಟ /ದಾನ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>ऋ (गतौ) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अर्पितं रसितवत्यापि नामग्राहमन्ययुवतेर्दयितेन"<br><b>उल्लेखाः - </b>माघ० १०-२७<br><br>अर्पित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇರಿಸಲ್ಪಟ್ಟ<br><br>अर्पित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲೆ ಇಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"हरिचक्रेण तेनास्य कण्ठे निष्कमिवार्पितम्"<br><b>उल्लेखाः - </b>कुमा० २-४९<br><br>

अर्बुद
अर्बुद<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಶಕೋಟಿ /ಹತ್ತು ಕೋಟಿ<br><br>अर्बुद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಂಸಪಿಂಡ /ಎರಡು ತಿಂಗಳಿನ ಗರ್ಭಪಿಂಡ<br><b>प्रयोगाः - </b>"प्रथमे मासि सङ्क्लेदभूतो धातुर्विमीर्च्छितः । मास्यर्बुदं द्वितीये तु तृतीयेऽङ्गेन्द्रियैर्युतः ॥"<br><b>उल्लेखाः - </b>याज्ञ० ३-७५<br><br>अर्बुद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಶ್ಚಿಮಭಾರತದ ಒಂದು ಪರ್ವತ<br><b>विस्तारः - </b>"अर्बुदो मांसपुरुषे दशकोटिषु न स्त्रियाम् । महीधरविशेषे ना" - मेदि० ।<br><br>अर्बुद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಂಸಗ್ರಂಥಿ ಬೆಳೆದುಂಟಾಗುವ ಒಂದು ರೋಗ<br><b>विस्तारः - </b>"अर्बुदः पर्वते मांसकीलके दशकोटिषु" - हेम० ।<br><br>अर्बुद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><br>

अर्भ
अर्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಲಕ /ಶಿಶು<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "भन्" (उ० ३-१५२)<br><br>अर्भ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕದಾದ /ಸಣ್ಣದಾದ<br><br>

अर्भक
अर्भक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಲಕ /ಶಿಶು<br><b>निष्पत्तिः - </b>ऋधु (वृद्धौ) - "वुन्" भकारादेशश्च (उ० ५-५३)<br><b>व्युत्पत्तिः - </b>ऋध्नोति वृद्धिं प्राप्नोति<br><b>प्रयोगाः - </b>"अनघवैभवमर्भकमुद्वहन्"<br><b>उल्लेखाः - </b>याद० ३-२९<br><br>अर्भक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸರ ಗರ್ಭ<br><br>अर्भक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಶವಾದ /ತೆಳ್ಳಗಿರುವ /ಬಡವಾದ /ಬಾಡಿರುವ<br><br>अर्भक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂರ್ಖನಾದ /ವಿವೇಕವಿಲ್ಲದ<br><br>अर्भक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕದಾದ /ಸಣ್ಣದಾದ<br><br>अर्भक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದರಿದ್ರ /ಧನಹೀನ<br><b>विस्तारः - </b>"अथार्भकस्त्रिषु । दरिद्रे बालके मूर्खे जडे भ्रूणे तु पुंस्ययम् । - नानार्थर० । "अर्भकः कथितो बाले मूर्खेऽपि च कृशेऽपि च" - मेदि० ।<br><br>

अर्मन्
अर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ನೇತ್ರರೋಗ<br><br>

अर्य
अर्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೈಶ್ಯ /ಮೂರನೆಯ ವರ್ಣದವನು<br><br>अर्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜಮಾನ /ಸ್ವಾಮಿ<br><b>निष्पत्तिः - </b>ऋ (गतु) - "यत्" (३-१-१०३)<br><b>विस्तारः - </b>"स्यादर्यः स्वामिवैश्ययोः" - हेम० ।<br><br>अर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ<br><br>

अर्या
अर्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೈಶ್ಯ ಜಾತಿಯ ಹೆಂಗಸು ಅಥವಾ ಯಜಮಾನಿ<br><br>

अर्याणी
अर्याणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೈಶ್ಯ ಜಾತಿಯ ಹೆಂಗಸು ಅಥವಾ ಯಜಮಾನಿ<br><b>निष्पत्तिः - </b>स्त्रियां विकल्पेन "आनुक्" ङीप्" च (वा० ४-१-४९)<br><br>

अर्यी
अर्यी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೈಶ್ಯನ ಪತ್ನಿ<br><b>निष्पत्तिः - </b>अर्य - "ङीप्" (४-१-४८)<br><br>

अर्यमन्
अर्यमन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>अर्य + माङ् (माने) - "कनिः" (उ० १-१५७)<br><b>प्रयोगाः - </b>"अर्यमप्रभृतिभिश्च संहतैः"<br><b>उल्लेखाः - </b>याद० १७-६९<br><br>अर्यमन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ವಾದಶಾದಿತ್ಯರಲ್ಲೊಬ್ಬ<br><br>अर्यमन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಿತೃದೇವತೆ<br><b>विस्तारः - </b>"सूरसूर्यार्यमादित्यद्वादशात्मदिवाकराः" - अम० । "अर्यमा तु पुमान् सूर्ये पितृदेवान्तरेऽपि च" - मेदि० ।<br><br>अर्यमन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಕವೃಕ್ಷ /ಎಕ್ಕದ ಗಿಡ<br><br>अर्यमन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯದೇವತಾಕವಾದ ಉತ್ತರ ಫಲ್ಗುನೀ ನಕ್ಷತ್ರ<br><br>

अर्वत्
अर्वत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸುವ /ಪೀಡಿಸುವ<br><b>निष्पत्तिः - </b>अर्व (हिंसायाम्) - "शतृ" (३-२-१२४)<br><br>

अर्वन्ती
अर्वन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸುವ /ಪೀಡಿಸುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>अर्वन्ती<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವ /ಕುದುರೆ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "वनिप्" (३-२-७५)<br><b>प्रयोगाः - </b>"उत्तेरुरुत्तालखुरारवं द्रुताः श्लथीकृतप्रग्रहमर्वतां व्रजाः"<br><b>उल्लेखाः - </b>माघ० १२-३१<br><br>अर्वन्ती<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><br>अर्वन्ती<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಸುವಿನ ಕಿವಿಯ ಅಳತೆ<br><br>अर्वन्ती<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಮವಾದ /ನೀಚವಾದ /ತುಚ್ಛವಾದ<br><b>विस्तारः - </b>"अर्वोऽश्वेऽधमे" - हेम० । "अर्वा तुरङ्गमे पुंसि कुत्सिते वाच्यलिङ्गकः" - मेदि० ।<br><br>अर्वन्ती<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಚಾರ ಸ್ವಭಾವದ<br><br>

अर्वती
अर्वती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಕುದುರೆ<br><br>अर्वती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಟ್ಟಿನಿ /ತಲೆಹಿಡಕಿ<br><b>विस्तारः - </b>"अर्वती कुम्भदास्यां च" - त्रिकाण्ड० ।<br><br>

अर्वरी
अर्वरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಕುದುರೆ<br><br>अर्वरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಟ್ಟಿನಿ /ತಲೆಹಿಡಕಿ<br><br>

अर्वाच्
अर्वाच्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮುಂಚಿನ ಕಾಲ /ಮುಂಚಿನ ಕಾಲದಿಂದ /ಮುಂಚಿನ ಕಾಲದಲ್ಲಿ<br><br>अर्वाच्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಈಚಿನ ದೇಶ /ದೇಶದಿಂದ /ದೇಶದಲ್ಲಿ<br><b>निष्पत्तिः - </b>अञ्चु (गतौ) - "क्विन्" (३-२-५९) । "अस्तातिः" (५-३-२७) । तस्य लुक् (५-३-३०)<br><b>व्युत्पत्तिः - </b>अर्वन्तमञ्चति<br><br>

अर्वाचीन
अर्वाचीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈಚಿನ ಕಾಲದ<br><b>निष्पत्तिः - </b>वा "खः" (५-४-८)<br><b>व्युत्पत्तिः - </b>अर्वाक् भवः<br><br>अर्वाचीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಂತರ ಹುಟ್ಟಿದ<br><br>

अर्वाचीना
अर्वाचीना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अर्वाचीन ಪದದ ಅರ್ಥ<br><br>

अर्श
अर्श<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಲವ್ಯಾಧಿ<br><br>अर्श<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪಾತ್ಮ /ಪಾಪಿ<br><b>निष्पत्तिः - </b>अर्शस् - पृषो० सलोपः ।<br><br>

अर्शस्
अर्शस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಲವ್ಯಾಧಿ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "असुन्" (उ० ४-१९५)<br><br>

अर्शस
अर्शस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂಲವ್ಯಾಧಿಯುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>अर्शांसि सन्त्यस्य<br><b>विस्तारः - </b>"अर्शोरोगयुतोऽर्शसः" - अम० ।<br><br>

अर्शिन्
अर्शिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂಲವ್ಯಾಧಿಯುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"इनिः"(५-२-११५)<br><b>व्युत्पत्तिः - </b>अर्शमस्यास्ति<br><br>

अर्शोघ्न
अर्शोघ्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರಣದ ಗೆಡ್ಡೆ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) - "टक्" (३-२-५३)<br><b>व्युत्पत्तिः - </b>अर्शो हन्ति<br><br>अर्शोघ्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಲ್ಕನೆಯ ಒಂದು ಭಾಗ ನೀರು ಬೆರೆಸಿದ ಮೊಸರು<br><b>विस्तारः - </b>"अथ घोलः पादाम्बुसंयुते । तक्रं कट्वरमर्स्शोघ्नम्" - वैज० ।<br><br>अर्शोघ्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಲವ್ಯಾಧಿಯನ್ನು ಗುಣಪಡಿಸುವ ಮನುಷ್ಯೇತರ ವಸ್ತು<br><br>

अर्शोहित
अर्शोहित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೇರು ಮರ<br><b>व्युत्पत्तिः - </b>अर्शसे हितः<br><br>अर्शोहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂಲವ್ಯಾಧಿಗೆ ಹಿತಕರವಾದ<br><br>

अर्षण
अर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಮನ /ಚಲನ<br><b>निष्पत्तिः - </b>ऋषी (गतौ) - भावे "ल्युट्" (३-३-११५)<br><br>

अर्षणी
अर्षणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಮನೋಪಾಯ /ಗಾಡಿ /ಗಮನ ಸಾಧನ<br><br>

अर्षणी
अर्षणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುಡಿತದಿಂದ ಕೂಡಿದ ನೋವು<br><br>

अर्ह|पूजायाम्|अर्हति
अर्ह - पूजायाम् (भ्वा० पर० सक० से०) अर्हति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೊಂದಲು ಅರ್ಹನಾಗು /ಪಡೆಯಲು ಯೋಗ್ಯನಾಗು<br><b>प्रयोगाः - </b>"गुरोर्गुरौ सन्निहिते गुरुवन्मानमर्हति"<br><b>उल्लेखाः - </b>मनु० २-२०५<br><br>अर्ह - पूजायाम् (भ्वा० पर० सक० से०) अर्हति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಶಕ್ತನಾಗು /ಸಮರ್ಥನಾಗು<br><b>प्रयोगाः - </b>"विनाशमव्ययस्यास्य न कश्चित् कर्तुमर्हति"<br><b>उल्लेखाः - </b>गीता० २-१७<br><br>अर्ह - पूजायाम् (भ्वा० पर० सक० से०) अर्हति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕೃಪೆ ಮಾಡು /ದಯೆತೋರು<br><b>प्रयोगाः - </b>"आर्याप्यरुन्धती तत्र व्यापारं कर्तुमर्हति"<br><b>उल्लेखाः - </b>कुमा० ६-३२<br><br>अर्ह - पूजायाम् (भ्वा० पर० सक० से०) अर्हति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಬಾಧ್ಯನಾಗು /ಹಕ್ಕುದಾರನಾಗು<br><b>प्रयोगाः - </b>"ननु गर्भः पित्र्यं रिक्थमर्हति"<br><b>उल्लेखाः - </b>शाकु० ६<br><br>अर्ह - पूजायाम् (भ्वा० पर० सक० से०) अर्हति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಮಾಡಲು ಯೋಗ್ಯನಾಗು /ತಕ್ಕವನಾಗು<br><b>प्रयोगाः - </b>"अर्थना मयि भवद्भिरिवास्यै कर्तुमर्हति मयापि भवत्सु"<br><b>उल्लेखाः - </b>नैष० ५-११२<br><br>अर्ह - पूजायाम् (भ्वा० पर० सक० से०) अर्हति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಮಾನವಾಗು<br><b>प्रयोगाः - </b>"सर्वे तं जपयज्ञस्य कलां नार्हन्ति षोडशीम्"<br><b>उल्लेखाः - </b>मनु० २-८६<br><br>

अर्ह
अर्ह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><b>निष्पत्तिः - </b>अर्ह (पूजायाम्) - "घञ्" (३-३-१९)<br><br>अर्ह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>"अभिप्रायः प्रियार्होऽर्हः"<br><b>उल्लेखाः - </b>वि० स०<br><br>अर्ह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಯ /ಬೆಲೆ /ಮೂಲ್ಯ<br><b>प्रयोगाः - </b>"महार्हशय्यापरिवर्तनच्युतैः स्वकेशपुष्पैरपि या स्म दूयते"<br><b>उल्लेखाः - </b>कुमा० ५-१२<br><br>अर्ह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ /ಗೌರವ<br><b>निष्पत्तिः - </b>भावे "घञ्" (३-३-१८)<br><br>अर्ह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗತಿ /ಗಮನ /ಚಲನ<br><br>अर्ह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೌರವಿಸಲು ಯೋಗ್ಯವಾದ /ಪೂಜೆಗೆ ಅರ್ಹವಾದ<br><b>प्रयोगाः - </b>"प्रातिवेश्यानुवेश्यौ च कल्याणे विंशतिद्विजे । अर्हावभोजयन्विप्रो दण्डमर्हति माषकम् ॥"<br><b>उल्लेखाः - </b>मनु० ८-३९२<br><br>अर्ह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಕ್ಕುದಾರ<br><b>प्रयोगाः - </b>"नियुक्तायामपि पुमान्नार्यां जातोऽविधानतः । नैवार्हः पैतृकं रिक्थं पतितोत्पादितो हि सः ॥"<br><b>उल्लेखाः - </b>मनु० ९-१४४<br><br>अर्ह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆಲೆಬಾಳುವ<br><br>अर्ह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯೋಗ್ಯವಾದ /ತಕ್ಕುದಾದ<br><b>प्रयोगाः - </b>"स भृत्योऽर्हो महीभुजाम्"<br><b>उल्लेखाः - </b>पञ्चतं० १-८७<br><br>

अर्हा
अर्हा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ /ಗೌರವ<br><b>निष्पत्तिः - </b>अर्ह - भावे "अः" (३-३-१०३)<br><b>प्रयोगाः - </b>"अवहितहृदयो विधाय सोऽर्हामृषिवदृषिप्रवरे गुरूपदिष्टाम्"<br><b>उल्लेखाः - </b>किरा० २-५८<br><br>अर्हा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ /ಗೌರವ /ಸತ್ಕಾರ<br><br>

अर्हण
अर्हण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ /ಸತ್ಕಾರ /ಗೌರವ<br><b>निष्पत्तिः - </b>अर्ह (पूजायाम्) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"प्रतिपत्तुमङ्ग घटते च न तव नृपयोग्यमर्हणम्"<br><b>उल्लेखाः - </b>माघ० १५-२२<br><br>

अर्हणा
अर्हणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ /ಸತ್ಕಾರ /ಗೌರವ<br><b>निष्पत्तिः - </b>अर्ह + णिच् - "युच्" (३-३-१०७)<br><b>प्रयोगाः - </b>"अर्हणामर्हते चक्रुर्मुनयो नयचक्षुषे"<br><b>उल्लेखाः - </b>रघु० १-५५<br><br>

अर्हणीय
अर्हणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲು ಅರ್ಹನಾದ /ಪೂಜಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अर्ह (पूजायाम्) - कर्म० "अनीयर्" (३-१-९६)<br><br>अर्हणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಾದ್ರವ್ಯ<br><br>

अर्हत्
अर्हत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧದೇವ<br><br>अर्हत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಜೈನಾಚಾರ್ಯರು<br><b>प्रयोगाः - </b>"सर्वज्ञो जितरागादिदोषस्त्रैलोक्यपूजितः । यथास्थितार्थवादी च देवोऽर्हन् परमेश्वरः ॥"<br><br>अर्हत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯೋಗ್ಯನಾದ /ಗೌರವಾರ್ಹನಾದ /ಪೂಜೆಗೆ ಯೋಗ್ಯನಾದ<br><b>निष्पत्तिः - </b>अर्ह (पूजायाम्) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"अर्हणामर्हते चक्रुर्मुनयो नयचक्षुषे"<br><b>उल्लेखाः - </b>रघु० १-५५<br><br>

अर्हन्त
अर्हन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><br>अर्हन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೌದ್ಧಸಂನ್ಯಾಸಿ<br><br>अर्हन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧದೇವ<br><b>निष्पत्तिः - </b>अर्ह (पूजायाम्) - "झच्" बाहु० ।<br><br>

अर्हित
अर्हित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ /ಗೌರವ /ಸತ್ಕಾರ<br><b>निष्पत्तिः - </b>अर्ह (पूजायाम्) - भावे "क्तः" (३-३-११४)<br><br>अर्हित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಟ್ಟ /ಗೌರವಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अर्ह (पूजायाम्) - कर्म० "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>अर्ह्यते<br><br>

अल|भूषणपर्याप्तिवारणेषु|अलति
अल - भूषणपर्याप्तिवारणेषु (भ्वा० पर० सक० से०) अलति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಲಂಕರಿಸು /ಶೃಂಗರಿಸು<br><br>अल - भूषणपर्याप्तिवारणेषु (भ्वा० पर० सक० से०) अलति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಮರ್ಥನಾಗು<br><br>अल - भूषणपर्याप्तिवारणेषु (भ्वा० पर० सक० से०) अलति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ತಡೆಗಟ್ಟು /ನಿವಾರಿಸು<br><br>

अल
अल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚೇಳಿನ ಕೊಮ್ಡಿಯ ಮುಳ್ಳು<br><br>अल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹರಿತಾಳ /ಅರಿದಳ<br><b>विस्तारः - </b>"वृश्चिको द्रुण आल्यालिः अलं तत्पुच्छकण्टकः" - अभि० चि० ।<br><br>

अलक
अलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಂಗುರಗೂದಲು /ಗುಂಗುರು ಗೂದಲು<br><b>निष्पत्तिः - </b>अल (भूषणादौ) - "वुन्" (उ० ५-३५)<br><b>व्युत्पत्तिः - </b>अलति<br><br>अलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂಗುರುಳು<br><b>प्रयोगाः - </b>"तदाप्रभृत्युन्मदना पितुर्गृहे ललाटिकाचन्दनधूसरालका"<br><b>उल्लेखाः - </b>कुमा० ५-५५<br><br>अलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸನೆಯ ಪುಡಿ /ಮೈಗೆ ಪೂಸಿಕೊಳ್ಳುವ ಸುಗಂಧ ಚೂರ್ಣ<br><br>अलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಚ್ಚು ನಾಯಿ<br><br>

अलकनन्दा
अलकनन्दा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಗಾನದಿ<br><br>

अलकप्रभा
अलकप्रभा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರನ ಪಟ್ಟಣ<br><br>

अलका
अलका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರನ ಪಟ್ಟಣ<br><b>प्रयोगाः - </b>"अलकामतिवाह्यैव वसतिं वसुसम्पदाम्"<br><b>उल्लेखाः - </b>कुमा० ६-३७<br><br>अलका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಂಟರಿಂದ ಹತ್ತು ವಯಸ್ಸಿನೊಳಗಿನ ಕನ್ಯೆ<br><br>

अलकाधिप
अलकाधिप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರ<br><b>व्युत्पत्तिः - </b>अलकायाः अधिपः<br><b>प्रयोगाः - </b>"अलकाधिपभृत्यदर्शितं शिवमुर्वीधरवर्त्म सम्प्रयान्"<br><b>उल्लेखाः - </b>किरा० ३-५९<br><br>

अलकाधिपति
अलकाधिपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರ<br><b>व्युत्पत्तिः - </b>अलकायाः अधिपतिः<br><br>

अलक्त
अलक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಗು /ಒಂದು ಮರದ ರಸ<br><b>निष्पत्तिः - </b>रस्य लः (वा० ८-२-१०)<br><b>व्युत्पत्तिः - </b>न रक्तोऽस्मात्<br><br>

अलक्तक
अलक्तक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಗು /ಒಂದು ಮರದ ರಸ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्" वा ।<br><b>प्रयोगाः - </b>"न्यस्तालक्तक रक्तमाल्यवसना"<br><b>उल्लेखाः - </b>मालती० ५-२४<br><br>

अलक्षण
अलक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಲಕ್ಷಣ<br><br>अलक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರಣವಲ್ಲದ ಹೇತು<br><br>अलक्षण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಂದರವಲ್ಲದ<br><br>अलक्षण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುರಿತಿಲ್ಲದ<br><br>अलक्षण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಲಕ್ಷಣವುಳ್ಳ<br><br>

अलक्षित
अलक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡಲ್ಪಡದ /ಕಾಣಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न लक्षितः<br><b>प्रयोगाः - </b>"अलक्षिताभ्युत्पतनो नृपेण"<br><b>उल्लेखाः - </b>रघु० २-२७<br><br>

अलक्ष्मन्
अलक्ष्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುರುತಿಲ್ಲದ /ಚಿಹ್ನೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न लक्ष्म यस्य<br><br>

अलक्ष्मी
अलक्ष्मी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಪತ್ತು /ತೊಂದರೆ<br><br>अलक्ष्मी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಾರಿದ್ರ್ಯ /ದುರ್ಗತಿ /ಬಡತನ<br><b>प्रयोगाः - </b>"कामान् दुग्धे विप्रकर्षत्यलक्ष्मीम्"<br><b>उल्लेखाः - </b>उ० रा० ५-३१<br><br>

अलक्ष्मीक
अलक्ष्मीक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದರಿದ್ರ /ಬಡವ<br><b>निष्पत्तिः - </b>"कप्"<br><b>व्युत्पत्तिः - </b>न विद्यते लक्ष्मीर्यस्य<br><br>अलक्ष्मीक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಂದರೆಗೊಳಗಾದವನು<br><br>अलक्ष्मीक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಂತಿಹೀನವಾದ<br><br>

अलक्ष्य
अलक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅದೃಶ್ಯವಾದ /ನೋಡಲಾಗದ<br><br>अलक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುರುತಿಸಲಾಗದ<br><br>अलक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಯವಲ್ಲದ /ಕ್ಷುಲ್ಲಕ<br><br>अलक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಟವಿಲ್ಲದ /ವಂಚನೆಯಿಲ್ಲದ<br><br>अलक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿವಕ್ಷಿತವಲ್ಲದ /ಉದಾಸೀನವಾದ<br><br>अलक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾಣಕ್ಕೆ ಗುರಿಯಿಲ್ಲದ<br><br>अलक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಣಾವೃತ್ತಿಯಿಂದ ತೋರದ ಅರ್ಥ<br><br>अलक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲಕ್ಷಣಸಮನ್ವಯವಾಗಬಾರದ ಜಾಗ<br><br>

अलक्ष्यगति
अलक्ष्यगति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಣ್ಣಿಗೆ ಕಾಣದ ಗಮನೌಳ್ಳ /ನೋಡಲು ಅಶಕ್ಯವಾದ ಚಲನೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अलक्ष्या गतिर्यस्य<br><br>

अलक्ष्यजन्मता
अलक्ष्यजन्मता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲಾಗದ ಜನ್ಮ /ಅವ್ಯಕ್ತವಾದ ಉತ್ಪತ್ತಿ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>अलक्ष्यजन्मनो भावः<br><b>प्रयोगाः - </b>"वपुर्विरूपाक्षमलक्ष्यजन्मता दिगम्बरत्वेन निवेदितं वसु"<br><b>उल्लेखाः - </b>कुमा० ५-७२<br><br>

अलक्ष्यजन्मन्
अलक्ष्यजन्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲಾಗದ ಹುಟ್ಟು /ಅವ್ಯಕ್ತವಾದ ಉತ್ಪತ್ತಿ<br><br>अलक्ष्यजन्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲಾಗದ ಉತ್ಪತ್ತಿಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अलक्ष्यं जन्म यस्य<br><br>

अलक्ष्यवाच्
अलक्ष्यवाच्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸ್ಪಷ್ಟವಾದ ಮಾತು<br><br>अलक्ष्यवाच्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸ್ಪಷ್ಟವಾದ ಮಾತುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अलक्ष्या वाक् यस्य<br><br>

अलगर्द
अलगर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ಹಾವು<br><b>निष्पत्तिः - </b>लगे (सङ्गे) - "क्विप्" (३-२-१७८) । अर्द (हिंसायाम्) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>लगति । अर्दयति । लक् चासावर्दश्च । लग्नः सन् पीडक इत्यर्थः । निर्विषत्वात् तद्भिन्नो अलगर्दः ।<br><br>

अलगर्दा
अलगर्दा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲೂಕೆ /ಜಿಗಣೆ<br><br>

अलघु
अलघु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುರುವರ್ಣ /ಗುರುಸಂಜ್ಞೆಯುಳ್ಳ ಅಕ್ಷರ<br><br>अलघु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಗುರವಲ್ಲದ /ಭಾರವಾದ<br><b>व्युत्पत्तिः - </b>न लघुः<br><b>प्रयोगाः - </b>"जघनमलघुपीवरोरु कृच्छ्रादुरुनिविरीस नितम्बभारखेदि"<br><b>उल्लेखाः - </b>माघ० ७-२०<br><br>अलघु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ದವಾದ /ದೊಡ್ಡದಾದ<br><b>प्रयोगाः - </b>"अलघुचरणाकृष्टग्राहां विषाणिभिरुन्मदैः"<br><b>उल्लेखाः - </b>माघ० १२-७७<br><br>अलघु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಣ್ಣದಲ್ಲದ<br><br>अलघु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇಗವಾದ<br><br>अलघु<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ವೇಗವಾಗಿ<br><b>प्रयोगाः - </b>"अलघुचलितजञ्झावातनिष्पेषदोषात्"<br><b>उल्लेखाः - </b>चं० रा०<br><br>अलघु<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಉದ್ದವಾಗಿ<br><br>अलघु<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ದೊಡ್ಡದಾಗಿ<br><br>अलघु<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಭಾರವಾಗಿ<br><br>

अलङ्करण
अलङ्करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲಂಕಾರ /ಶೃಂಗಾರ<br><b>निष्पत्तिः - </b>अलम् + डुकृञ् (करणे) - भावे "ल्युट्" (३-३-११५)<br><br>अलङ्करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಷಣ /ಒಡವೆ<br><b>निष्पत्तिः - </b>कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>अलङ्क्रियतेऽनेन<br><b>प्रयोगाः - </b>"सृजति तावदशेषगुणाकारं पुरुषरत्नमलङ्करणं भुवः"<br><b>उल्लेखाः - </b>भर्तृ० १-८६<br><br>

अलङ्करिष्णु
अलङ्करिष्णु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲಂಕಾರ ಮಾಡುವವನು /ಶೃಂಗರಿಸುವವನು<br><b>निष्पत्तिः - </b>अलम् + डुकृञ् (करणे) - "इष्णुच्" (३-२-१३६)<br><br>अलङ्करिष्णु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲಂಕಾರ ಮಾಡುವ ಸ್ವಭಾವದವನು<br><br>

अलङ्कर्तृ
अलङ्कर्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲಂಕಾರ ಮಾಡುವವನು /ಶೃಂಗರಿಸುವವನು<br><b>निष्पत्तिः - </b>अलम् + डुकृञ् (करणे) - "तृन्" (३-२-१३५)<br><br>

अलङ्कर्त्री
अलङ्कर्त्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲಂಕಾರ ಮಾಡುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अलङ्कर्मीण
अलङ्कर्मीण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದಲ್ಲಿ ದಕ್ಷನಾದ /ಕೆಲಸ ಮಾಡುವುದರಲ್ಲಿ ಸಮರ್ಥನಾದ<br><b>निष्पत्तिः - </b>अलङ्कर्मन् - "खः" (५-४-७)<br><b>व्युत्पत्तिः - </b>कर्मणे क्रियायै अलम्<br><b>विस्तारः - </b>"कर्मक्षमोऽलङ्कर्मीणः क्रियावान् कर्मसूद्यतः" - अम० ।<br><br>

अलङ्कार
अलङ्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಷಣ /ಒಡವೆ<br><b>निष्पत्तिः - </b>अलम् + डुकृञ् (करणे) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>अलङ्क्रियतेऽनेन<br><br>अलङ्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಲಂಕಾರ /ಶೃಂಗಾರ<br><br>अलङ्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಲಂಕಾರಶಾಸ್ತ್ರ<br><br>अलङ्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದ ಮತ್ತು ಅರ್ಥಾಲಂಕಾರ /ಶಬ್ದಾರ್ಥಗಳಿಗೆ ಹೆಚ್ಚು ಕಾಂತಿಯನ್ನು ಕೊಡುವ ಧರ್ಮ<br><b>प्रयोगाः - </b>"काव्यशोभाकरान् धर्मान् अलङ्कारान् प्रचक्षते"<br><b>उल्लेखाः - </b>काव्या० २-१<br><br>

अलङ्कृत
अलङ्कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲಂಕರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अलम् + डुकृञ् (करणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अलङ्कृतानां ऋजुतागुणेन गुरूपदिष्टां गतिमास्थितानाम्"<br><b>उल्लेखाः - </b>किरा० १७-२९<br><br>

अलङ्कृति
अलङ्कृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲಂಕಾರ /ಶೃಂಗಾರ<br><b>निष्पत्तिः - </b>अलम् + डुकृञ् (करणे) - "क्तिन्" (३-३-९४)<br><br>अलङ्कृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದ ಮತ್ತು ಅರ್ಥಾಲಂಕಾರ /ಶಬ್ದಾರ್ಥಗಳಿಗೆ ಹೆಚ್ಚು ಕಾಂತಿಯನ್ನು ಕೊಡುವ ಧರ್ಮ<br><b>प्रयोगाः - </b>"तददोषौ शब्दार्थौ सगुणावनलङ्कृती पुनः क्वापि"<br><b>उल्लेखाः - </b>काव्यप्र०<br><br>

अलङ्क्रिया
अलङ्क्रिया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲಂಕಾರ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>अलम् + डुकृञ् (करणे) - भावे "शः" (३-३-१००)<br><br>

अलङ्घन
अलङ्घन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೀರದಿರುವಿಕೆ /ಅತಿಕ್ರಮಿಸದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न लङ्घनम्<br><br>

अलङ्घनीय
अलङ्घनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮಿಸಲು ಯೋಗ್ಯವಲ್ಲದ /ಮೀರಲಾಗದ<br><b>व्युत्पत्तिः - </b>न लङ्घयितुं योग्यम्<br><b>प्रयोगाः - </b>"अलङ्घनीयं प्रकृतावपि स्थितं निवातनिष्कम्पमिवापगापतिम्"<br><b>उल्लेखाः - </b>किरा० १४-३७<br><br>

अलङ्घनीयता
अलङ्घनीयता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮಿಸಲು ಆಗದಿರುವಿಕೆ /ಮೀರಲು ಶಕ್ಯವಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>अलङ्घनीय - "तल्" (५-१-११९)<br><b>प्रयोगाः - </b>"अलङ्घनीयताहेतुरुभयं तन्मनस्विनि"<br><b>उल्लेखाः - </b>माघ० २-४८<br><br>अलङ्घनीयता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜ್ಯತೆ /ಗೌರವಾರ್ಹತೆ<br><br>

अलङ्घ्य
अलङ्घ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾಟಲಾಗದ<br><br>अलङ्घ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮಿಸಲು ಅಶಕ್ಯವಾದ /ಮೀರಲಾಗದ<br><b>व्युत्पत्तिः - </b>न लङ्घयितुं शक्यम्<br><b>प्रयोगाः - </b>"अलङ्घ्यं तत्तदुद्वीक्ष्य यद्यदुच्चैर्महीभृताम्"<br><b>उल्लेखाः - </b>किरा० ११-६०<br><br>अलङ्घ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಾಧ್ಯವಾದ /ಪಡೆಯಲಾಗದ<br><b>प्रयोगाः - </b>"उपहितपरमप्रभावधाम्नां न हि जयिनां तपसामलङ्घ्यमस्ति"<br><b>उल्लेखाः - </b>किरा० १०-६<br><br>

अलञ्जर|अलञ्जुर
अलञ्ज(ञ्जु)र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಣ್ಣಿನ ಹೂಜಿ<br><b>निष्पत्तिः - </b>जॄ (वयोहानौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अलं सामर्थ्यं जृणाति<br><br>

अलभ्य
अलभ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲು ಅನರ್ಹವಾದ /ಪಡೆಯಲು ಅಯೋಗ್ಯವಾದ<br><b>व्युत्पत्तिः - </b>न लब्धुमर्हः<br><b>प्रयोगाः - </b>"अलभ्यशोकाभिभवेयमाकृतिर्विमानना सुभ्रु कुतः पितुर्गृहे"<br><b>उल्लेखाः - </b>कुमा० ५-४३<br><br>

अलभ्ययोग
अलभ्ययोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವಕಾಲ /ಪುಣ್ಯಕಾಲ /ಅಪೂರ್ವವಾಗಿ ಒದಗುವ ತಿಥಿ ವಾರ ನಕ್ಷತ್ರಾದಿಗಳು ಸೇರುವ ಕಾಲ /ಅರ್ಧೋದಯ<br><br>

अलम्
अलम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಭೂಷಣ /ಒಡವೆ<br><br>अलम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಾಮರ್ಥ್ಯ /ಶಕ್ತಿ<br><br>अलम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪರ್ಯಾಪ್ತಿ /ಸಾಕಾಗುವಿಕೆ<br><br>अलम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ತಡೆ /ನಿಷೇಧ<br><b>निष्पत्तिः - </b>अल (भूषणादौ० - "अम्" बाहु० ।<br><b>प्रयोगाः - </b>"अलं विवादेन यथाश्रुतं त्वया तथाविधस्तावदशेषमस्तु सः"<br><b>उल्लेखाः - </b>कुमा० ५-८२<br><br>अलम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅತಿಶಯವಾಗಿ /ಹೆಚ್ಚಾಗಿ<br><b>प्रयोगाः - </b>"कुरु तात तपांस्यमार्गदायी विजयायेत्यलमन्वशान्मुनिर्माम्"<br><b>उल्लेखाः - </b>किरा० १३-१३<br><br>

अलम्पुरुषीण
अलम्पुरुषीण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧದಲ್ಲಿ ಶತ್ರುಪಕ್ಷದ ಸೈನ್ಯದ ಯಜಮಾನ<br><b>निष्पत्तिः - </b>"खः" (५-४-७)<br><b>व्युत्पत्तिः - </b>अलं पुरुषाय<br><br>

अलम्बुद्धि
अलम्बुद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಕು ಎಂಬ ಬುದ್ಧಿ /ತೃಪ್ತಿ<br><br>अलम्बुद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಕಾದಷ್ಟು ಬುದ್ಧಿ /ತಕ್ಕಷ್ಟು ಬುದ್ಧಿ<br><br>अलम्बुद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಿಥ್ಯಾಜ್ಞಾನ /ತಪ್ಪು ತಿಳುಅಳಿಕೆ<br><br>

अलम्बुष
अलम्बुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಮನ /ವಾಂತಿ<br><br>अलम्बुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಕ್ಷಸ<br><br>अलम्बुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾವಣನ ಮಂತ್ರಿ ಪ್ರಹಸ್ತ<br><b>प्रयोगाः - </b>"अलम्बुषं तथा युद्धे विचरन्तमभीतवत्"<br><b>उल्लेखाः - </b>भा० द्रोण०<br><br>

अलम्बुषा
अलम्बुषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಅಪ್ಸರಸ್ಸು<br><b>प्रयोगाः - </b>"अलम्बुषायामिक्ष्वाकोर्जातः कश्चिन्महीपतिः"<br><b>उल्लेखाः - </b>चं० रा०<br><br>अलम्बुषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತ್ಅಡೆಯ ಗೆರೆ /ಇತರರ ಪ್ರವೇಶವನ್ನು ತಡೆಗಟ್ಟುವ ನೀರಿನ ಗೆರೆ<br><br>अलम्बुषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಗರವಳ್ಳಿ<br><b>विस्तारः - </b>"अलम्बुषः प्रहस्ते च छर्दने राक्षसान्तरे । अलम्बुषा तु मुण्डीर्यां स्वर्गवाराङ्गनान्तरे" - मेदि० ।<br><br>

अलम्भूष्णु
अलम्भूष्णु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮರ್ಥ /ಶಕ್ತ<br><b>निष्पत्तिः - </b>अलम् + भू (सत्तायाम्) - "ग्स्नुः" (३-२-१३९)<br><b>व्युत्पत्तिः - </b>अलम्भवनशीलः<br><b>प्रयोगाः - </b>"विनाप्यस्मदलम्भूष्णुरिज्यायै तपसः सुतः"<br><b>उल्लेखाः - </b>माघ० २-९<br><br>

अलर्क
अलर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಚ್ಚುನಾಯಿ<br><b>निष्पत्तिः - </b>अर्क (स्तवने) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>अलम् अर्क्यते<br><br>अलर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿ ಎಳ್ಳಿನ ಗಿಡ<br><br>अलर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಂದಿಯ ಆಕಾರದ ಎಂಟು ಕಾಲುಗಳುಳ್ಳ ಒಂದು ಮೃಗ<br><br>अलर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರ /ಮಗ<br><br>अलर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಜ<br><b>प्रयोगाः - </b>"अभ्यर्च्य कस्मैचिदुपाश्रिताय वितीर्य विप्राय विलोचने स्वे । अपूरयत्कश्चिदलर्कसञ्ज्ञः प्राज्ञः प्रतिज्ञां प्रथितप्रभावः"<br><b>उल्लेखाः - </b>चं० रा०<br><br>अलर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಂಗೆ ಹುಳು /ಕರ್ಣನು ಪರಶುರಾಮನನ್ನು ತೊಡೆಯ ಮೇಲೆ ಮಲಗಿಸಿಕೊಂಡಿದ್ದಾಗ ಅವನ ತೊಡೆಯನ್ನು ಕೊರೆದ ಹುಳು<br><b>प्रयोगाः - </b>"रोमभिः सन्निरुद्धाङ्गमलर्क नाम नामतः"<br><b>उल्लेखाः - </b>भा० शान्ति० ३-१३<br><br>

अलर्का
अलर्का<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮದಾಲಸೆಯೆಂಬ ಒಬ್ಬ ಅಪ್ಸರಸ್ಸು<br><b>विस्तारः - </b>"अथात्मजे । मदालसायां श्वेतार्केऽप्यलर्को भ्रान्तशुन्यपि" - नानार्थर० ।<br><br>

अलस
अलस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲಿನ ಬೆರಳು ಸಂದಿಯ ಹುಣ್ಣು /ಕೆಸರಿನ ಹುಣ್ಣು<br><br>अलस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೋಮಾರಿ /ಮೈಗಳ್ಳ /ಕೆಲಸ ಮಾಡದವನು<br><b>निष्पत्तिः - </b>लस (श्लेषणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>न लसति<br><b>प्रयोगाः - </b>"अव्यवसायिनमलसं दैवपरं साहसाच्च परिहीनम् । प्रमदेव वृद्धिपतिं नेच्छत्युपगृहीतुं लक्ष्मीः ॥"<br><b>उल्लेखाः - </b>हितो०<br><br>अलस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಳಲಿದ /ಆಯಾಸಗೊಂಡ<br><b>प्रयोगाः - </b>"अलसपदमनोरमं प्रकृत्या जितकलहंसवधूगति प्रयातम्"<br><b>उल्लेखाः - </b>किरा० १०-६०<br><br>अलस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇಸರವುಳ್ಳ /ಕೆಲಸದಲ್ಲಿ ದ್ವೇಷವುಳ್ಳ<br><b>प्रयोगाः - </b>"गमनमलसं शून्या दृष्टिः शरीरमसौष्ठवम्"<br><b>उल्लेखाः - </b>मालती० १-२०<br><br>अलस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಂದಸ್ವಭಾವದವನು /ಜಡ ಪ್ರಕೃತಿಯವನು<br><br>

अलसा
अलसा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಂಸಪದೀಲತೆ<br><b>विस्तारः - </b>"अलसा हंसपद्यां ना पादरोग द्रुभेदयोः" - मेदि० ।<br><br>

अलसक
अलसक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಟ್ಟೆಯ ರೋಗ /ಉದರ ವ್ಯಾಧಿ /ಒಂದು ವಿಧ ಅಜೀರ್ಣ ರೋಗ<br><b>प्रयोगाः - </b>"प्रयाति नोर्ध्वं नाधस्तात् आहारो न च पच्यते । आमाशयोऽलसीभूतस्तेन सोऽलसकः स्मृतः ॥"<br><b>उल्लेखाः - </b>भावप्र०<br><br>

अलात
अलात<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧಬೆಂದ ಮರ /ಕೊಳ್ಳಿ<br><b>व्युत्पत्तिः - </b>न लातमस्य<br><b>प्रयोगाः - </b>"कुरुतेऽस्मिन्नमोघेऽपि निर्वाणालातलाघवम्"<br><b>उल्लेखाः - </b>कुमा० २-२३<br><br>

अलाबू
अलाबू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೋರೆ ಗಿಡ<br><b>निष्पत्तिः - </b>लबि (अवस्रंसने) - "ऊः" (उ० १-८७)<br><b>व्युत्पत्तिः - </b>न लम्बते<br><br>

अलाबु
अलाबु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೋರೆಕಾಯಿ<br><br>अलाबु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೋರೆ ಬುರುಡೆ<br><br>

अलार
अलार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಗಿಲು<br><br>

अलि
अलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭ್ರಮರ /ದುಂಬಿ<br><b>निष्पत्तिः - </b>अल (भूषणादौ) - "इन्" (उ० ४-११८)<br><b>व्युत्पत्तिः - </b>अलति दंशने समर्थो भवति<br><b>प्रयोगाः - </b>"गण्डोड्डीनालिमालामुखरितककुभस्ताण्डवे शूलपाणेः"<br><b>उल्लेखाः - </b>मालती० १-२<br><br>अलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಶ್ಚಿಕ /ಚೇಳು<br><br>अलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯಸ /ಕಾಗೆ<br><br>अलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><br>अलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ<br><br>अलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಶ್ಚಿಕರಾಶಿ<br><b>विस्तारः - </b>"अलिः सुराअपुष्पलिहोः" - मेदि० ।<br><br>

अलिक
अलिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಣೆ /ಲಲಾಟ<br><b>निष्पत्तिः - </b>अल (भूषणादौ) -"इकन्" (उ० ४-२७०<br><b>व्युत्पत्तिः - </b>अलति<br><b>विस्तारः - </b>"ललाटमलिकं गोधिः" - अम० ।<br><br>

अलिगर्द्ध
अलिगर्द्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ಹಾವು<br><b>निष्पत्तिः - </b>गृधु (अभिकाङ्क्षायाम्) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अलिरुव गृध्नोति<br><br>

अलिजिह्वा
अलिजिह्वा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರುನಾಲಿಗೆ /ಅಣ್ಣಾಲಿಗೆ<br><b>व्युत्पत्तिः - </b>अलिरिव क्षुद्रा जिह्वा<br><br>

अलिञ्जर
अलिञ्जर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಣ್ಣಿನ ಹೂಜಿ<br><b>निष्पत्तिः - </b>जॄष् (वयोहानौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अलिं जरयति<br><b>विस्तारः - </b>"अलिञ्ञरः स्यात् मणिकः" - अम० ।<br><br>

अलिदूर्वा
अलिदूर्वा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ದವಾಗಿ ಬಳ್ಳಿಯಂತೆ ಬೆಳೆಯುವ ಗರುಕೆ<br><br>

अलिन्
अलिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭ್ರಮರ /ದುಂಬಿ<br><b>निष्पत्तिः - </b>"इनिः"(५-२-११५)<br><b>व्युत्पत्तिः - </b>अलं वृश्चिकलाङ्गूलं तदिवास्यास्ति<br><b>प्रयोगाः - </b>"मलिनिमाऽलिनि माधवयोषिताम्"<br><b>उल्लेखाः - </b>माघ० ६-४<br><br>अलिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಶ್ಚಿಕ /ಚೇಳು<br><b>निष्पत्तिः - </b>"इनिः"(५-२-११५)<br><b>व्युत्पत्तिः - </b>अलमस्यास्ति<br><br>

अलिन्द
अलिन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆಯ ಬಾಗಿಲಿನ ಮುಂದಿನ ಜಗುಲಿ<br><br>अलिन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆಯ ಮುಂಭಾಗದಲ್ಲಿ ಚತುರಶ್ರವಾದ ಒಂದು ಪ್ರದೇಶ<br><b>निष्पत्तिः - </b>अल (भूषणादौ) - "किन्दच्" बाहु ।<br><b>प्रयोगाः - </b>"यस्यामलिन्देषु न चक्रुरेव मुग्धाङ्गनागोमयगोमुखानि"<br><b>उल्लेखाः - </b>माघ० ३-४८<br><br>

अलिपक
अलिपक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭ್ರಮರ /ದುಂಬಿ<br><br>अलिपक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><br>अलिपक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಯಿ<br><b>विस्तारः - </b>"अलिपको भृङ्गकोकिलकुक्कुरे" - मेदि० ।<br><br>

अलिप्रिय
अलिप्रिय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ತಕಮಲ /ಕೆಂದಾವರೆ<br><b>व्युत्पत्तिः - </b>अलीनां प्रियः<br><br>अलिप्रिय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುಂಬಿಗಳಿಗೆ ಪ್ರಿಯವಾದ /ಭ್ರಮರಗಳಿಗೆ ಸಂತೋಷವುಂಟುಮಾಡುವ<br><br>

अलिप्रिया
अलिप्रिया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತುತ್ತೂರಿ ಹೂವು<br><br>

अलिमक
अलिमक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲದ ಕುಸುರು<br><br>अलिमक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಪ್ಪೆ ಮರ<br><br>अलिमक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><br>अलिमक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಡೂಕ /ಕಪ್ಪೆ<br><br>अलिमक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭ್ರಮರ /ದುಂಬಿ<br><b>विस्तारः - </b>"भवेदलिमको भेके पिकेऽलौ पद्मकेसरे । मधूकेऽपि" - मेदि० ।<br><br>

अलीक
अलीक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಣೆ /ಲಲಾಟ<br><b>निष्पत्तिः - </b>अल (भूषणादौ) -"कीकन्" (उ० ४-२५)<br><b>प्रयोगाः - </b>"दिशालमीकालकभङ्गतां गतस्त्रयीवधूकर्णतमालपल्लवः"<br><b>उल्लेखाः - </b>कादं०<br><br>अलीक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಿಥ್ಯೆ /ಸುಳ್ಳು<br><b>प्रयोगाः - </b>"तद्यथा स महाराजो नालीकमधिगच्छति"<br><b>उल्लेखाः - </b>रामा०<br><br>अलीक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಗ<br><br>अलीक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ರಿಯವಾದ<br><br>अलीक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸತ್ಯವಾದ /ಸುಳ್ಳಾದ<br><br>

अलु
अलु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನ ಸಣ್ಣ ಪಾತ್ರೆ<br><br>

अलोक
अलोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಳಯ /ಜಗತ್ತಿನ ನಾಶ<br><b>प्रयोगाः - </b>"रक्ष सर्वानिमाल्लोकान्नालोकं कर्तुमर्हसि"<br><b>उल्लेखाः - </b>रामा०<br><br>अलोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾತಾಳ ಲೋಕ<br><br>अलोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಧ್ಯಾತ್ಮಿಕ ಜಗತ್ತು<br><br>अलोक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಣ್ಣಿಗೆ ಕಾಣದಿರುವ<br><b>प्रयोगाः - </b>"प्रकाशस्ज्चाप्रकाशश्च लोकालोक इवाचलः"<br><b>उल्लेखाः - </b>रघु० १-६८<br><br>

अलौकिक
अलौकिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲೋಕದಲ್ಲಿಲ್ಲದ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-४४)<br><b>व्युत्पत्तिः - </b>लोके विदितः<br><br>अलौकिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಾಧಾರಣವಾದ<br><br>

अल्प
अल्प<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಂಚ /ಸ್ವಲ್ಪ<br><b>निष्पत्तिः - </b>अल (भूषणादौ) - "पः" बाहु० ।<br><b>प्रयोगाः - </b>"क्व सूर्यप्रभवो वंशः क्व चाल्पविषया मतिः"<br><b>उल्लेखाः - </b>रघु० १-२<br><br>अल्प<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕದಾದ /ಸಣ್ಣದಾದ<br><br>अल्प<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಕೊಂಚವಾಗಿ /ಸ್ವಲ್ಪವಾಗಿ<br><br>अल्प<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕದಾಗಿ /ಸಣ್ಣದಾಗಿ<br><br>

अल्पक
अल्पक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೀಟಕಸಂಧಿಮರ<br><br>अल्पक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಂಚ /ಸ್ವಲ್ಪ<br><br>अल्पक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕದಾದ /ಸಣ್ಣದಾದ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><b>व्युत्पत्तिः - </b>अल्प एव<br><br>

अल्पिका
अल्पिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತುಚ್ಛವಾದ /ನೀಚವಾದ<br><b>प्रयोगाः - </b>"परदोषकथाभिरल्पकः स्वजनं तोषयितुं किलेच्छति"<br><b>उल्लेखाः - </b>माघ० १६-२८<br><br>

अल्पक्रीत
अल्पक्रीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಂಚ ಬೆಲೆಗೆ ಕೊಂಡುಕೊಂಡ /ಅಗ್ಗದ ಬೆಲೆಗೆ ತೆಗೆದುಕೊಂಡ<br><b>व्युत्पत्तिः - </b>अल्पेन क्रीतम्<br><br>

अल्पक्रीती
अल्पक्रीती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಂಚ ಬೆಲೆಗೆ ಕೊಂಡುಕೊಂಡ /ಅಗ್ಗದ ಬೆಲೆಗೆ ತೆಗೆದುಕೊಂಡ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीष्" (४-१-५०)<br><br>

अल्पगन्ध
अल्पगन्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ತೋತ್ಪಲ /ಕೆಂದಾವರೆ<br><br>अल्पगन्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಂಚ ವಾಸನೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अल्पो गन्धो यस्य<br><br>

अल्पज्ञ
अल्पज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಂಚ ಮಾತ್ರ ತಿಳಿದಿರುವ /ಅಲ್ಪಜ್ಞಾನವುಳ್ಳ<br><b>निष्पत्तिः - </b>ज्ञा (अवबोधने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>अल्पं जानाति<br><br>

अल्पतनु
अल्पतनु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಳುವಾದ ಮೈಯುಳ್ಳ<br><br>अल्पतनु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಡವಾದ /ದುರ್ಬಲ<br><br>अल्पतनु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಳ್ಳ /ವಾಮನ<br><b>व्युत्पत्तिः - </b>अल्पा तनुर्यस्य<br><b>विस्तारः - </b>"पृश्निः किरातोऽल्पतनुर्दुर्बलस्तु कृशस्तनुः" - वैज० ।<br><br>

अल्पद
अल्पद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಂಚ ಕೊದತಕ್ಕ /ಔದಾರ್ಯವಿಲ್ಲದ /ಕೊಡುಗೈಯಿಲ್ಲದ<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>अल्पं ददाति<br><br>

अल्पदृष्टि
अल्पदृष्टि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಕುಚಿತವಾದ ಮನಸ್ಸುಳ್ಳ /ಕ್ಷುದ್ರವಾದ ಹೃದಯವುಳ್ಳ<br><br>अल्पदृष्टि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಂದ ದೃಷ್ಟಿಯುಳ್ಳ /ದೂರದ ನೋಟವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>अल्पा दृष्टिर्यस्य<br><br>

अल्पधी
अल्पधी<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲ್ಪವಾದ ಬುದ್ಧಿಯುಳ್ಳ /ಕೊಂಚ ತಿಳುವಳಿಕೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अल्पा धीः यस्य<br><br>

अल्पबुद्धि
अल्पबुद्धि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲ್ಪವಾದ ಬುದ್ಧಿಯುಳ್ಳ /ಕೊಂಚ ತಿಳುವಳಿಕೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अल्पा बुद्धिः यस्य<br><br>

अल्पमति
अल्पमति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲ್ಪವಾದ ಬುದ್ಧಿಯುಳ್ಳ /ಕೊಂಚ ತಿಳುವಳಿಕೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अल्पा मतिर्यस्य<br><br>

अल्पप्राण
अल्पप्राण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಲ್ಪಪ್ರಾಣ ವಾಯುವಿನ ವ್ಯಾಪಾರವುಳ್ಳ ವರ್ಣ /ಅಲ್ಪಪ್ರಯತ್ನದಿಂದ ಉಚ್ಚರಿಸಲ್ಪಡುವ ಅಕ್ಷರ<br><b>विस्तारः - </b>"अयुग्मा वर्णयमगा यणश्चाल्पासवः स्मृताः" - सि० कौ० ।<br><br>अल्पप्राण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ಷರಗಳನು ಉಚ್ಚರಿಸುವ ಬಾಹ್ಯಪ್ರಯತ್ನಗಳಲ್ಲೊಂದು<br><br>अल्पप्राण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಲ್ಪಬಲವುಳ್ಳ /ಅಲ್ಪಪ್ರಾಣವಾಯುವುಳ್ಳ /ಬಹಳ ಕಷ್ಟದಿಂದ ಉಸಿರಾಡುವ<br><b>व्युत्पत्तिः - </b>अल्पः ह्रस्वः प्राणः प्राणवायुर्यस्य<br><br>

अल्पमारिष
अल्पमारिष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಲುಕೀರೆ ಸೊಪ್ಪು<br><b>विस्तारः - </b>"तण्डुलीयोऽल्पमारिषः" - अम० ।<br><br>

अल्पमूल्य
अल्पमूल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಂಚ ಬೆಲೆಯುಳ್ಳ /ಅಗ್ಗದ ಬೆಲೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अल्पं मूल्यं यस्य<br><br>

अल्पवयस्
अल्पवयस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕ ವಯಸ್ಸಿನ<br><b>व्युत्पत्तिः - </b>अल्पं वयो यस्य<br><br>

अल्पवादिन्
अल्पवादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಂಚ ಮಾತನಾಡುವ ಸ್ವಭಾವದ /ಮಿತಭಾಷಿ<br><b>निष्पत्तिः - </b>वद (व्यक्तायां वाचि) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अल्पं वदति<br><br>

अल्पवादिनी
अल्पवादिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಿತಭಾಷಿಣಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अल्पविद्य
अल्पविद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲ್ಪವಿದ್ಯೆಯುಳ್ಳ /ಕೊಂಚ ತಿಳುವಳಿಕೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अल्पा विद्या यस्य<br><b>प्रयोगाः - </b>"अल्पविद्यो महागर्वी"<br><br>

अल्पशस्
अल्पशस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೊಂಚವಾಗಿ /ಸ್ವಲ್ಪವಾಗಿ<br><b>निष्पत्तिः - </b>अल्प - "शस्" (५-४-४२)<br><br>

अल्पायुस्
अल्पायुस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಡು /ಮೇಕೆ<br><br>अल्पायुस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಡಿಮೆ ಆಯಸ್ಸುಳ್ಳ /ಕೊಂಚ ಕಾಲ ಬದುಕುವ<br><b>व्युत्पत्तिः - </b>अल्पमायुर्यस्य<br><b>प्रयोगाः - </b>"दुराचारो हि पुरुषो लोके भवति निन्दितः । दुःखभागी च सततं व्याधितोऽल्पायुरेव च ॥"<br><b>उल्लेखाः - </b>मनु० ४-१५७<br><br>

अल्पारम्भ
अल्पारम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪವಾಗಿ ಆರಂಭಿಸುವಿಕೆ /ಕ್ರಮವಾಗಿ ದೊಡ್ಡದಾಗುವಂತೆ ಕಾರ್ಯವನ್ನು ಚಿಕ್ಕ ಪ್ರಮಾಣದಲ್ಲಿ ಆರಂಭಿಸುವುದು<br><b>व्युत्पत्तिः - </b>अल्पश्चासावारम्भश्च<br><b>प्रयोगाः - </b>"अल्पारम्भः क्षेमकरः"<br><br>

अल्पाहारिन्
अल्पाहारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಿತವಾಗಿ ಊಟ ಮಾಡುವ /ಕೊಂಚ ಆಹಾರ ತೆಗೆದುಕೊಳ್ಳುವ<br><b>निष्पत्तिः - </b>"इनिः"(५-२-११५)<br><b>व्युत्पत्तिः - </b>अल्पाहारोऽस्यास्ति<br><br>

अल्पिष्ठ
अल्पिष्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಅಲ್ಪವಾದ /ಬಹಳ ಕೊಂಚವಾದ<br><b>निष्पत्तिः - </b>"इष्ठन्" (५-३-५८)<br><b>व्युत्पत्तिः - </b>अतिशयेन अल्पः<br><br>

अल्पीयस्
अल्पीयस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕೊಂಚವಾದ /ಬಹಳ ಚಿಕ್ಕದಾದ /ಅತಿಸಣ್ಣದಾದ<br><b>निष्पत्तिः - </b>"ईयसुन्" (५-३-५८)<br><b>व्युत्पत्तिः - </b>अतिशयेन अल्पः<br><br>

अल्पीयसी
अल्पीयसी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಕೊಂಚವಾದ /ಬಹಳ ಚಿಕ್ಕದಾದ /ಅತಿಸಣ್ಣದಾದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अव|रक्षणगतिकान्तिप्रीतितृप्त्यवगमप्रवेशश्रवणसामर्थ्ययाचनक्रियेच्छादीप्त्यवाप्त्यालिङ्गनहिंसादानभागवृद्धिषु|अवति
अव - रक्षणगतिकान्तिप्रीतितृप्त्यवगमप्रवेशश्रवणसामर्थ्ययाचनक्रियेच्छादीप्त्यवाप्त्यालिङ्गनहिंसादानभागवृद्धिषु (भ्वा० पर० सक० से०) अवति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ರಕ್ಷಿಸು /ಕಾಪಾಡು<br><b>प्रयोगाः - </b>"प्रत्यक्षाभिः प्रपन्नस्तनुभिरवतु वस्ताभिरष्टाभिरीशः"<br><b>उल्लेखाः - </b>शाकु० १-१<br><br>अव - रक्षणगतिकान्तिप्रीतितृप्त्यवगमप्रवेशश्रवणसामर्थ्ययाचनक्रियेच्छादीप्त्यवाप्त्यालिङ्गनहिंसादानभागवृद्धिषु (भ्वा० पर० सक० से०) अवति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚಲಿಸು /ಹೂಗು /ನಡೆ<br><br>अव - रक्षणगतिकान्तिप्रीतितृप्त्यवगमप्रवेशश्रवणसामर्थ्ययाचनक्रियेच्छादीप्त्यवाप्त्यालिङ्गनहिंसादानभागवृद्धिषु (भ्वा० पर० सक० से०) अवति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಇಚ್ಛಿಸು /ಅಪೇಕ್ಷಿಸು<br><br>अव - रक्षणगतिकान्तिप्रीतितृप्त्यवगमप्रवेशश्रवणसामर्थ्ययाचनक्रियेच्छादीप्त्यवाप्त्यालिङ्गनहिंसादानभागवृद्धिषु (भ्वा० पर० सक० से०) अवति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿಸು<br><b>प्रयोगाः - </b>"क्षत्रियान्तकरणोऽपि विक्रमस्तेन मामवति नाजिते त्वयि"<br><b>उल्लेखाः - </b>रघु० ११-७५<br><br>अव - रक्षणगतिकान्तिप्रीतितृप्त्यवगमप्रवेशश्रवणसामर्थ्ययाचनक्रियेच्छादीप्त्यवाप्त्यालिङ्गनहिंसादानभागवृद्धिषु (भ्वा० पर० सक० से०) अवति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ತೃಪ್ತಿ ಪಡು<br><br>अव - रक्षणगतिकान्तिप्रीतितृप्त्यवगमप्रवेशश्रवणसामर्थ्ययाचनक्रियेच्छादीप्त्यवाप्त्यालिङ्गनहिंसादानभागवृद्धिषु (भ्वा० पर० सक० से०) अवति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕೇಳು /ಶ್ರವಣ ಮಾಡು<br><br>अव - रक्षणगतिकान्तिप्रीतितृप्त्यवगमप्रवेशश्रवणसामर्थ्ययाचनक्रियेच्छादीप्त्यवाप्त्यालिङ्गनहिंसादानभागवृद्धिषु (भ्वा० पर० सक० से०) अवति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಗ್ರಹಣ ಮಾಡು<br><br>अव - रक्षणगतिकान्तिप्रीतितृप्त्यवगमप्रवेशश्रवणसामर्थ्ययाचनक्रियेच्छादीप्त्यवाप्त्यालिङ्गनहिंसादानभागवृद्धिषु (भ्वा० पर० सक० से०) अवति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪ್ರವೇಶಿಸು<br><br>अव - रक्षणगतिकान्तिप्रीतितृप्त्यवगमप्रवेशश्रवणसामर्थ्ययाचनक्रियेच्छादीप्त्यवाप्त्यालिङ्गनहिंसादानभागवृद्धिषु (भ्वा० पर० सक० से०) अवति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಯಾಚಿಸು /ಬೇಡು<br><br>अव - रक्षणगतिकान्तिप्रीतितृप्त्यवगमप्रवेशश्रवणसामर्थ्ययाचनक्रियेच्छादीप्त्यवाप्त्यालिङ्गनहिंसादानभागवृद्धिषु (भ्वा० पर० सक० से०) अवति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ತಿಳಿ /ಅರಿ<br><br>अव - रक्षणगतिकान्तिप्रीतितृप्त्यवगमप्रवेशश्रवणसामर्थ्ययाचनक्रियेच्छादीप्त्यवाप्त्यालिङ्गनहिंसादानभागवृद्धिषु (भ्वा० पर० सक० से०) अवति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಮಾಡು<br><br>अव - रक्षणगतिकान्तिप्रीतितृप्त्यवगमप्रवेशश्रवणसामर्थ्ययाचनक्रियेच्छादीप्त्यवाप्त्यालिङ्गनहिंसादानभागवृद्धिषु (भ्वा० पर० सक० से०) अवति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆ ಹುಟ್ಟಿಸು<br><br>अव - रक्षणगतिकान्तिप्रीतितृप्त्यवगमप्रवेशश्रवणसामर्थ्ययाचनक्रियेच्छादीप्त्यवाप्त्यालिङ्गनहिंसादानभागवृद्धिषु (भ्वा० पर० सक० से०) अवति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೊಂದು /ಪಡೆ<br><br>अव - रक्षणगतिकान्तिप्रीतितृप्त्यवगमप्रवेशश्रवणसामर्थ्ययाचनक्रियेच्छादीप्त्यवाप्त्यालिङ्गनहिंसादानभागवृद्धिषु (भ्वा० पर० सक० से०) अवति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಆಲಿಂಗಿಸು /ಅಪ್ಪಿಕೊಳ್ಳು<br><br>अव - रक्षणगतिकान्तिप्रीतितृप्त्यवगमप्रवेशश्रवणसामर्थ्ययाचनक्रियेच्छादीप्त्यवाप्त्यालिङ्गनहिंसादानभागवृद्धिषु (भ्वा० पर० सक० से०) अवति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಮರ್ಥನಾಗು /ಶಕ್ತಿಹೊಂದು<br><br>अव - रक्षणगतिकान्तिप्रीतितृप्त्यवगमप्रवेशश्रवणसामर्थ्ययाचनक्रियेच्छादीप्त्यवाप्त्यालिङ्गनहिंसादानभागवृद्धिषु (भ्वा० पर० सक० से०) अवति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸು /ಪೀಡಿಸು<br><br>अव - रक्षणगतिकान्तिप्रीतितृप्त्यवगमप्रवेशश्रवणसामर्थ्ययाचनक्रियेच्छादीप्त्यवाप्त्यालिङ्गनहिंसादानभागवृद्धिषु (भ्वा० पर० सक० से०) अवति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಭಾಗ ಹೊಂದು<br><br>अव - रक्षणगतिकान्तिप्रीतितृप्त्यवगमप्रवेशश्रवणसामर्थ्ययाचनक्रियेच्छादीप्त्यवाप्त्यालिङ्गनहिंसादानभागवृद्धिषु (भ्वा० पर० सक० से०) अवति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ವೃದ್ಧಿ ಹೊಂದು<br><br>

अव
अव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಲಂಬನ /ಆಶ್ರಯ<br><b>प्रयोगाः - </b>"प्रारम्भेऽस्मिन् स्वामिनो वृद्धिहेतौ दैवेनेत्थं दत्तहस्तावलम्बे"<br><b>उल्लेखाः - </b>रत्ना० १-८<br><br>अव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಪ್ತಿ /ಹರಡುವಿಕೆ<br><b>प्रयोगाः - </b>"हंसीव कृष्ण ते कीर्तिः स्वर्गङ्गामवगाहते"<br><b>उल्लेखाः - </b>चन्द्रा०<br><br>अव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರ /ಅನಾದರ<br><b>प्रयोगाः - </b>"अवजानासि मां यस्मादतस्ते न भविष्यति । मत्प्रसूतिमनाराध्य प्रजेति त्वां शशाप सा ॥"<br><b>उल्लेखाः - </b>रघु० १-७७<br><br>अव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಜ್ಞಾನ /ತಿಳುವಳಿಕೆ<br><b>प्रयोगाः - </b>"कृतापराधमिवावगच्छति आत्मानम्"<br><b>उल्लेखाः - </b>कादं०<br><br>अव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯ<br><b>प्रयोगाः - </b>अवधारणम्<br><br>अव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೆಳಮುಖ /ಕೆಳಕ್ಕೆ ಇಳಿಯುವುದು<br><b>प्रयोगाः - </b>"यानाज्जनं परिजनैरवतार्यमाणा राज्ञीर्नरापनयनाकुलसौविदल्लाः"<br><b>उल्लेखाः - </b>माघ० ५-१७<br><br>अव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಯೋಗ<br><br>अव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೀನ /ನಿಕೃಷ್ಟ<br><b>प्रयोगाः - </b>"प्रतिकर्तुं प्रकृष्टस्य नावकृष्टेन युज्यते"<br><b>उल्लेखाः - </b>रामा०<br><br>अव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಶುದ್ಧಿ<br><b>प्रयोगाः - </b>"अवदातः"<br><br>अव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪರಾಭವ /ಅವಮಾನಗೊಳಿಸುವಿಕೆ<br><b>प्रयोगाः - </b>शत्रूनवहन्ति<br><br>अव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆ /ಕಾಪಾಡುವುದು<br><br>अव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿರೋಧ<br><b>प्रयोगाः - </b>"पूर्वापरौ तोयनिधी वगाह्य स्थितः पृथिव्याः इव मानदण्डः"<br><b>उल्लेखाः - </b>कुमा० १-१<br><br>

अवकट
अवकट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೈರೂಪ್ಯ /ವಿರೋಧ<br><b>निष्पत्तिः - </b>अव - "कटच्" (५-२-३०)<br><br>अवकट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿರುದ್ಧವಾದ /ಪ್ರತಿಕೂಲವಾದ<br><br>

अवकटा
अवकटा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾರಗೋಪನ /ಮರೆ ಮಾಚುವುದು /ಠಕ್ಕು /ಮೋಸ<br><b>विस्तारः - </b>"आकारगोपनायामपटीकाप्यवकटापि स्त्री" - वैज० ।<br><br>

अवकर
अवकर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಸ /ಧೂಳು<br><b>निष्पत्तिः - </b>अव + कॄ (विक्षेपे) - "अप्" (३-३-५७)<br><b>व्युत्पत्तिः - </b>अवकीर्यते<br><b>प्रयोगाः - </b>"अवकरनिकरं विकिरति" । "अवकरशोधनेन गृहं शुध्यति ।"<br><br>

अवकर्णन
अवकर्णन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಾದರದಿಂದ ಕೇಳುವುದು /ತಿರಸ್ಕಾರ ಬುದ್ಧಿಯಿಂದ ಕೇಳುವುದು<br><b>निष्पत्तिः - </b>अव + कर्ण (भेदने) + णिच् - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"वाचमनुनयपरां स ततः सहसावकर्ण्यनिरियाय संसदः"<br><b>उल्लेखाः - </b>माघ० १५-६७<br><br>

अवकाश
अवकाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಸಮಯ /ಸುಸಂಧಿ<br><b>प्रयोगाः - </b>"तत्र मे साहाय्यदानावकाशः"<br><b>उल्लेखाः - </b>दशकु०<br><br>अवकाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಳ /ಜಾಗ<br><b>प्रयोगाः - </b>"अवकाशं किलोदन्वान् रामायाभ्यर्थितो ददौ"<br><b>उल्लेखाः - </b>रघु० ४-५८<br><br>अवकाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೆಲೆ /ಆಶ್ರಯ<br><b>प्रयोगाः - </b>"स सूक्ष्मतन्तोरपि तावकस्य तत्रावकाशो भवतः किमु स्यात्"<br><b>उल्लेखाः - </b>रत्ना० २-१४<br><br>अवकाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲದ ಅಂತರ /ಕಾಲದ ಮಧ್ಯಭಾಗ<br><br>अवकाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಛಿದ್ರ /ರಂಧ್ರ /ತೂತು<br><br>

अवकीर्ण
अवकीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಲ್ಪಟ್ಟ /ಮರೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + कॄ (विक्षेपे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"किमपैति रजोभिरौर्वरैरवकीर्णस्य मणेर्महार्घता"<br><b>उल्लेखाः - </b>माघ० १६-२७<br><br>अवकीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎರಚಲ್ಪಟ್ಟ<br><br>अवकीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸಲ್ಪಟ್ಟ /ಹಾಳು ಮಾಡಲ್ಪಟ್ಟ<br><br>अवकीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಂಗಪಡಿಸಲ್ಪಟ್ಟ /ಕೆಳದರ್ಜೆಗೆ ಇಳಿಸಲ್ಪಟ್ಟ<br><br>

अवकीर्णिन्
अवकीर्णिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ರತಭಂಗಪಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"इनिः"(५-२-११५)<br><b>व्युत्पत्तिः - </b>अवकीर्णं विक्षिप्तमनेब<br><b>प्रयोगाः - </b>"मारुतं पुरुहूतं च गुरुं पावकमेव च । चतुरो व्रतिनोऽभ्येति ब्राह्मं तेजोऽवकीर्णनः ॥"<br><b>उल्लेखाः - </b>मनु० ११-१२१<br><br>

अवकृष्ट
अवकृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಕೃಷ್ಟವಾದ /ಹೀನವಾನ /ಕೆಳದರ್ಜೆಯ<br><b>निष्पत्तिः - </b>अव + कृष (विलेखने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"प्रतिकर्तुं प्रकृष्टस्य नावकृष्टेन युज्यते"<br><b>उल्लेखाः - </b>रामा०<br><br>अवकृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯಲ್ಪಟ್ಟ /ಹೊರಕ್ಕೆ ತರಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"एकाकिनापि हि मया रसभावकृष्टनिस्त्रिंशदीधितिसटाभरभासुरेण"<br><b>उल्लेखाः - </b>नागा०<br><br>अवकृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊರಡಿಸಲ್ಪಟ್ಟ /ಓಡಿಸಲ್ಪಟ್ಟ /ಅಟ್ಟಲ್ಪಟ್ಟ<br><br>अवकृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಯ್ಯಲ್ಪಟ್ಟ /ಸ್ಥಳಾಂತರ ಮಾಡಲ್ಪಟ್ಟ<br><br>अवकृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೂಲಿಗಾರ /ಜೀತಗಾರ /ಗುಡಿಸುವುದು ಮುಂತಾದ ಕೆಲಸ ಮಾಡುವವನು<br><b>प्रयोगाः - </b>"पणौ देयोऽवक्र्ष्टस्य षडुत्कृष्टस्य वेतनम् । षाण्मासिकस्तथाच्छादो धान्यद्रोणस्तु मासिकः ॥"<br><b>उल्लेखाः - </b>मनु० ७-१२६<br><br>

अवक्लृप्त
अवक्लृप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಿತವಾದ /ವ್ಯವಸ್ಥಿತವಾದ<br><b>निष्पत्तिः - </b>अव + कृपू (सामर्थ्ये) - "क्तः" (३-२-१०२)<br><br>अवक्लृप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕಾರಿ /ಅರ್ಹ<br><br>

अवक्लृप्ति
अवक्लृप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಭವ /ಆಗು ಹೋಗು<br><br>अवक्लृप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯ /ತೀರ್ಮಾನ<br><b>निष्पत्तिः - </b>अव + कृपू (सामर्थ्ये) - "क्तिन्" (३-३-९४)<br><br>अवक्लृप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಿಕಾರ /ಅರ್ಹತೆ<br><b>विस्तारः - </b>"अनवक्लृप्तिरसम्भावना" - सि० कौ० ।<br><br>

अवकेशिन्
अवकेशिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಫಲಿಸದ ಗೊಡ್ಡುಮರ /ಆಯಾ ಋತುಗಳಲ್ಲೂ ಫಲಬಿಡದ ಮರ<br><b>निष्पत्तिः - </b>अचक + ईष (ऐश्वर्ये) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अव निर्गतं कं सुखं यस्मात् अवकं फलशून्यतामीष्टे<br><b>प्रयोगाः - </b>"निन्द्यते पितृभिस्तप्तैर्निरपत्यधनः पुमान् । अध्वनीनैरतिश्रान्तैरवकेशीव पादपः ॥"<br><b>उल्लेखाः - </b>चं० भा०<br><b>विस्तारः - </b>"वन्ध्योऽफलोऽवकेशी च" - अम० ।<br><br>

अवकोकिल
अवकोकिल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆಯಿಂದ ಕರೆಯಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>अवकृष्टः कोकिलया<br><br>

अवक्तव्य
अवक्तव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲು ಯೋಗ್ಯವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>वक्तुं योग्यम् । न वक्तव्यम्<br><br>अवक्तव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಿಥ್ಯೆಯಾದ<br><br>अवक्तव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವರ್ಣಿಸಲಾಗದ /ಹೇಳಲಾಗದ<br><br>

अवक्रन्द
अवक्रन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೋದನ /ಅಳುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + क्रदि (रोदने) - "घञ्" (३-३-१८०<br><br>अवक्रन्द<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೆಲ್ಲಗೆ ಅಳುವ<br><b>निष्पत्तिः - </b>अव + क्रदि - "अच्" (३-१-१३४)<br><br>

अवक्रन्दन
अवक्रन्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>अवक्रन्द ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

अवक्रम
अवक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಳಿಕೆ /ಅವರೋಹಣ<br><br>अवक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಳಿಕೆ /ಕ್ಷೀಣವಾಗುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + क्रमु (पादविक्षेपे) - "घञ्" (३-३-१८)<br><br>

अवक्रय
अवक्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಲ್ಯ /ಬೆಲೆ<br><b>निष्पत्तिः - </b>अव + डुक्रीञ् (द्रव्यविनिमये) - "अच्" (३-३-५६)<br><b>व्युत्पत्तिः - </b>अवक्रीयतेऽनेन<br><b>विस्तारः - </b>"मूल्यं वस्नोऽप्यवक्रमः" - अम० ।<br><br>अवक्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಡಿಗೆ /ಕೂಲಿ<br><br>अवक्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಡಿಗೆಗೆ ಕೊಡುವುದು<br><b>प्रयोगाः - </b>"विक्रयावक्रयाधानयाचितेषु पणान् दश"<br><b>उल्लेखाः - </b>याज्ञ० २-२३८<br><br>अवक्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ತಕರು ಸರ್ಕಾರಕ್ಕೆ ಕೊಡುವ ವ್ಯಾಪಾರ ತೆರಿಗೆ<br><br>

अवक्षय
अवक्षय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿನಾಶ /ಪ್ರಳಯ<br><b>निष्पत्तिः - </b>अव + क्षि (क्षये) - भावे "अच्" (३-३-५६)<br><b>प्रयोगाः - </b>"लब्धं रक्षेदवक्षयात्"<br><b>उल्लेखाः - </b>हितो० २-८<br><br>

अवक्षिप्त
अवक्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಸೆಯಲ್ಪಟ್ಟ /ಬಿಸಾಡಲ್ಪಟ್ಟ<br><br>अवक्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೂಷಿಸಲ್ಪಟ್ಟ /ನಿಂದಿಸಲ್ಪಟ್ಟ<br><br>अवक्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕ್ಷೇಪಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + क्षिपु (निरसने) - "क्तः" (३-२-१०२)<br><br>

अवक्षीण
अवक्षीण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಶವಾದ /ಬತ್ತಿ ಹೋದ<br><b>निष्पत्तिः - </b>अव + क्षि (क्षये) - "क्तः" (३-४-७२)<br><br>

अवक्षुत
अवक्षुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲೆ ಸೀನಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + टुक्षु (शब्दे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अनर्चितं वृथामांसमवीरायाश्च योषितः । द्विषदन्नं नगर्यन्नं पतितान्नमवक्षुतम् ॥"<br><b>उल्लेखाः - </b>मनु० ४-२१३<br><br>

अवक्षेप
अवक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೂಷಣೆ /ನಿಂದೆ<br><br>अवक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕ್ಷೇಪಣೆ<br><br>अवक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೈಗಳು<br><br>अवक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಸೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + क्षिपु (निरसने० - "घञ्" (३-३-१८)<br><br>

अवक्षेपण
अवक्षेपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಎಸೆಯುವುದು<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"उत्क्षेपणं ततोऽवक्षेपणमाकुञ्चनं तथा । प्रसारणं च गमनं कर्माण्येतानि पञ्च च ॥"<br><b>उल्लेखाः - </b>भाषापा०<br><br>अवक्षेपण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಸೆಯುವ ಸಾಧನ /ಕವಣೆ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>कर० "ल्युट्" (३-३-११७)<br><br>

अवक्षेपणी
अवक्षेपणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಳ್ಳಂಗಡಲೆ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>अवक्षेपणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಗಾಮು /ಕಡಿವಾಣ<br><br>

अवखण्डन
अवखण्डन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭಾಗ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>अव + खडि (भेदने) + णिच् - "ल्युट्" (३-३-११५)<br><br>

अवखात
अवखात<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಟೆಯ ಸುತ್ತಲೂ ಮಾಡುವ ಆಳವಾದ ಕಂದಕ<br><br>

अवखाद
अवखाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದ್ಯವಾದ ಊಟ /ಕೆಟ್ಟ ಆಹಾರ<br><b>व्युत्पत्तिः - </b>अवकृष्टः खादः<br><br>

अवगणन
अवगणन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗೌರವ /ಅನಾದರ<br><b>निष्पत्तिः - </b>अव + गण (सङ्ख्याने) - "ल्युट्" (३-३-११५)<br><br>अवगणन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ<br><br>

अवगणित
अवगणित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಮಾನಗೊಳಿಸಲ್ಪಟ್ಟ /ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + गण (सङ्ख्याने) - "क्त्ः" (३-२-१०२)<br><b>विस्तारः - </b>"अवगणितमवमताऽवज्ञाते अवमानितं च परिभूते" - अम० ।<br><br>

अवगण्ड
अवगण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಖದ ಮೇಲೆ ಏಳುವ ಬಕ್ಕೆ /ಗಲ್ಲದ ಮೇಲಿನ ಚರ್ಮದ ಒಂದು ಗಂಟು<br><br>

अवगत
अवगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + गम्लृ (गतौ) - "क्तः" (३-२-१०२)<br><br>अवगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿದಿರುವ<br><b>प्रयोगाः - </b>"तदेव ध्यानादवगतोऽस्मि"<br><b>उल्लेखाः - </b>शाकु० ७<br><br>अवगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಇಳಿದಿರುವ /ಕೆಳಕ್ಕೆ ಬಂದಿರುವ<br><b>निष्पत्तिः - </b>कर्त० "क्तः" (३-४-७२)<br><br>

अवगति
अवगति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಿಳುವಳಿಕೆ /ಜ್ಞಾನ<br><b>निष्पत्तिः - </b>अव + गम्लृ (गतौ) - "क्तिन्" (३-३-९४)<br><br>अवगति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯ ಜ್ಞಾನ<br><b>प्रयोगाः - </b>"ब्रह्मावगतिर्हि पुरुषार्थः ब्रह्मावगतिस्त्वप्रतिज्ञाता"<br><b>उल्लेखाः - </b>भा० शान्ति०<br><br>

अवगम
अवगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿಳುವಳಿಕೆ /ಜ್ಞಾನ<br><br>अवगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯ ಜ್ಞಾನ<br><b>निष्पत्तिः - </b>अव + गम्लृ (गतौ) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"प्रत्यक्षावगमं धर्म्यं सुसुखं कर्तुमव्ययम्"<br><b>उल्लेखाः - </b>गीता० ९-२<br><br>

अवगमन
अवगमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>अवगम ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

अवगाढ
अवगाढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳಕ್ಕೆ ಪ್ರವೇಶಿಸಿರುವ<br><b>निष्पत्तिः - </b>अव + गाहू (विलोडने) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"अभ्युन्नता पुरस्तादवगाढा जघनगौरवात्पश्चात्"<br><b>उल्लेखाः - </b>शाकु० ३-७<br><br>अवगाढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಳುಗಿರುವ /ನಾಟಿರುವ<br><br>अवगाढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಳುಗಲ್ಪಟ್ಟ /ಸ್ನಾನ ಮಾಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अवगाढा च पीता च पुनात्यासप्तमं कुलम्"<br><b>उल्लेखाः - </b>भा०<br><br>

अवगाद
अवगाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರದ ಪೀಪಾಯಿ /ದೋಣಿಯಿಂದ ನೀರನ್ನು ಹೊರಕ್ಕೆ ಚೆಲ್ಲುವ ಒಂದು ಮರದ ತೊಟ್ಟಿ<br><br>

अवगाह
अवगाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ನಾನ<br><b>निष्पत्तिः - </b>अव + गाहू (विलोडने) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"सुभगसलिलावगाहाः पाटलिसंसर्गसुरभिवनवाताः"<br><b>उल्लेखाः - </b>शाकु० १-३<br><br>अवगाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನ ಒಳಕ್ಕೆ ಪ್ರವೇಶ /ನೀರಿನಲ್ಲಿ ಇಳಿಯುವುದು<br><b>प्रयोगाः - </b>"जलावगाहक्षणमात्रशान्ता"<br><b>उल्लेखाः - </b>रघु० ५-४७<br><br>अवगाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ನಾನ ಮಾಡುವ ಸ್ಥಳ<br><b>निष्पत्तिः - </b>अधि० "घञ्" (३-३-१२१)<br><br>

अवगाहन
अवगाहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>अवगाह ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"सम्भिन्नैरिभतुरगावगाहनेन प्राप्योर्वीरनु पदवीं विमानपङ्क्तीः"<br><b>उल्लेखाः - </b>किरा० ७-११<br><br>

अवगाह्य
अवगाह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳಕ್ಕೆ ಪ್ರವೇಶಿಸಲು ಯೋಗ್ಯವಾದ<br><br>अवगाह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ನಾನ ಮಾಡಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>अव + गाहू (विलोडने) - "ण्यत्" (३-१-१२४)<br><br>अवगाह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳಕ್ಕೆ ಪ್ರವೇಶಿಸಿ /ಒಳಕ್ಕೆ ಇಳಿದು<br><br>अवगाह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ನಾನ ಮಾಡಿ<br><b>निष्पत्तिः - </b>अव + गाहू (विलोडने) - "ल्यप्" (७-१-३७)<br><br>

अवगीत
अवगीत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲೋಕಾಪವಾದ<br><br>अवगीत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದಾಪರವಾದ ಗದ್ಯ /ದೂಷಣಕಾವ್ಯ<br><br>अवगीत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಸ್ಯ /ಲೇವಡಿ<br><b>निष्पत्तिः - </b>अव + गै (शब्दे) - "क्तः" (३-३-११४)<br><br>अवगीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿಸಲ್ಪಟ್ಟ /ದೂಷಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + गै (शब्दे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"विधुरं किमतः परं परैरवगीतां गमिते दशामिमाम्"<br><b>उल्लेखाः - </b>किरा० २-७<br><br>अवगीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀಚ /ದುಷ್ಟ<br><b>विस्तारः - </b>"अवगीनन्तु निर्वादे दुष्टगर्हितयोरपि" - मेदि० ।<br><br>अवगीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಸ್ವರದಲ್ಲಿ ಹಾಡಲ್ಪಟ್ಟ<br><br>अवगीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾರಿ ಬಾರಿಗೆ ನೋಡಲ್ಪಟ್ಟ<br><b>विस्तारः - </b>"अवगीतन्तु निर्वादे मुहुर्दुष्टे विगर्हिते" - विश्व० ।<br><br>

अवगुण
अवगुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಗುಣ /ದೋಷ<br><b>व्युत्पत्तिः - </b>अवकृष्टो गुणः<br><br>

अवगुण्ठन
अवगुण्ठन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಖಪರದೆ /ಮುಸುಕು<br><b>निष्पत्तिः - </b>अव + गुठि (वेष्टने) - कर० "ल्युट्" (३-३-११७)<br><b>प्रयोगाः - </b>"अपनेष्यामि तावत्तेऽवगुण्ठन्म्"<br><b>उल्लेखाः - </b>शाकु० ५<br><br>अवगुण्ठन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೆರೆ /ಪರದೆ /ಅಂತರಪಟ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>अवगुण्ठन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸರು ಮುಖಪರದೆ ಹಾಕಿಕೊಳ್ಳುವುದು<br><br>अवगुण्ठन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧೂಳು ಹೊಡೆಯುವ ಪೊರಕೆ /ಕಸಬರಿಕೆ<br><br>

अवगुण्ठिका
अवगुण्ठिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಖಪರದೆ /ಮುಸುಕು<br><b>निष्पत्तिः - </b>अव + गुठि (वेष्टने) - "ण्वुल्" (३-१-१३३) । "टाप्" (४-१-४)<br><br>अवगुण्ठिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೆರೆ /ಪರದೆ /ಅಂತರಪಟ<br><b>विस्तारः - </b>"विरङ्गिण्यवगुण्ठिका" - त्रिकाण्ड० ।<br><br>

अवगुण्ठित
अवगुण्ठित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಸುಕು ಹಾಕಲ್ಪಟ್ಟ /ಮುಖಪರದೆ ಹಾಕಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + गुठि (वेष्टने) - "क्तः" (३-२-१०२)<br><br>अवगुण्ठित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುಡಿ ಮಾಡಲ್ಪಟ್ಟ /ಚೂರ್ಣ ಮಾಡಲ್ಪಟ್ಟ<br><br>

अवग्रह
अवग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನವೃಷ್ಟಿ /ಮಳೆಯಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + ग्रह (उपादाने) - "अप्" (३-३-५८)<br><b>प्रयोगाः - </b>"तपःकृशामभ्युपपत्स्यसे सखीं वृषेव सीतां तदवग्रहक्षताम्"<br><b>उल्लेखाः - </b>कुमा० ५-६१<br><br>अवग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪದಗಳಿಗೆ ಸಂಧಿಯಿಲ್ಲದೆ ಬಿಡಿಸಿ ಹೇಳುವುದು<br><br>अवग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಕೆ /ಆತಂಕ /ನಿರ್ಬಂಧ<br><br>अवग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಗ್ರಹ /ಶಿಕ್ಷೆ<br><b>प्रयोगाः - </b>"स्वयं विधाता सुरदैत्यरक्षसामनुग्रहावग्रहयोर्यदृच्छया"<br><b>उल्लेखाः - </b>माघ० १-७१<br><br>अवग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಧಿಕಾರ್ಯದಿಂದ ವರ್ಣಲೋಪವುಂಟಾದಾಗ ಎ ಮತ್ತು ಓಕಾರಗಳ ಮುಂದೆ ಅಕಾರಕ್ಕೆ ಬದಲಾಗಿ ಉಪಯೋಗಿಸುವ ऽ ಚಿಹ್ನೆ<br><br>अवग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಹಣೆ<br><b>विस्तारः - </b>"अवग्रहो वृष्टोरोधे प्रतिबन्धे गजालिके" - मेदि० ।<br><br>अवग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕೃತಿ /ಸ್ವಭಾವದಿಂದಿರುವಿಕೆ /ಬದಲಾವಣೆ ಹೊಂದದಿರುವಿಕೆ<br><b>विस्तारः - </b>"अवग्रहः स्यात् प्रकृतिभाववृष्टिविबन्धयोः" - त्रिकाण्ड० ।<br><br>अवग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಗಳ ಗುಂಪು<br><b>विस्तारः - </b>"अवग्रहो ज्ञानभेदे ह्यस्वातन्त्र्ये गजालिके" - हेम० ।<br><br>अवग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧವಾದ ತಪ್ಪು ತಿಳುವಳಿಕೆ<br><br>अवग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯನ್ನು ಅಂಕೆಯಲ್ಲಿಡುವ ಅಂಕುಶ<br><b>निष्पत्तिः - </b>अव + ग्रह (उपादाने) - कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>अवगृह्यतेऽनेन<br><br>

अवग्रहण
अवग्रहण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಬಂಧಕ /ತಡೆ /ಅಡ್ಡಿ<br><br>अवग्रहण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಾದರ /ತಿರಸ್ಕಾರ<br><b>निष्पत्तिः - </b>अव + ग्रह (उपादाने) - भावे "ल्युट्" (३-३-११५)<br><b>विस्तारः - </b>"अवग्रहणमित्येतत् प्रतिरोधेऽप्यनादरे" - मेदि० ।<br><br>

अवग्राह
अवग्राह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನಾವೃಷ್ಟಿ /ಮಳೆಯಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + ग्रह (उपादाने) - वा "घञ्" (३-३-५१) ।<br><b>विस्तारः - </b>देवस्य अवग्रहः अवग्राहः । देवकर्तुकमवर्षणमित्यर्थः - सि० कौ० ।<br><br>

अवघट्ट
अवघट्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಂಧ್ರ /ಬಿಲ<br><b>निष्पत्तिः - </b>अव + घट्ट (चलने) - कर० अधि० वा "घञ्" (३-३-१२१)<br><b>विस्तारः - </b>"अवगघट्टावटौ तुल्यौ" - त्रिकाण्ड० ।<br><br>अवघट्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೀಸುವ ಕಲ್ಲು /ಅಕ್ಕಿ ರಾಗಿ ಮೊದಲಾದುವನ್ನು ಬೀಸಿ ಹಿಟ್ಟು ಮಾಡುವ ಕಲ್ಲು<br><br>

अवघट्टन
अवघट्टन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೀಸುವಿಕೆ /ಅಕ್ಕಿ ರಾಗಿ ಮೊದಲಾದುವನ್ನು ಬೀಸಿ ಹಿಟ್ಟು ಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + घट्ट (चलने) - "ल्युट्" (३-३-११५)<br><br>अवघट्टन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯವನ್ನು ಕುಟ್ಟುವುದು<br><br>

अवघट्टित
अवघट्टित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೀಸಲ್ಪಟ್ಟ /ಹಿಟ್ಟು ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + घट्ट (चलने) - "क्तः" (३-२-१०२)<br><br>अवघट्टित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಟ್ಟಣೆ ಮಾಡಲ್ಪಟ್ಟ<br><br>अवघट्टित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನ್ನದ ಗಂಜಿಯಿಂದ ಬಳಿಯಲ್ಪಟ್ಟ ಬಟ್ಟೆ<br><b>प्रयोगाः - </b>"स्वतः शुद्धः पटो धौतोऽन्नलिप्तोऽवघट्टितः"<br><b>उल्लेखाः - </b>पञ्चदशी<br><br>

अवघात
अवघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯವನ್ನು ಕುಟ್ಟುವುದು<br><br>अवघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಡೆಯುವಿಕೆ<br><br>अवघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನಾಹುತ<br><b>निष्पत्तिः - </b>अव + हन (हिंसागत्योः) - "घञ्" (३-३-१८)<br><br>

अवघुषित
अवघुषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾರಲ್ಪಟ್ಟ /ಡಂಗೂರ ಹೊಡೆದು ಪ್ರಸಿದ್ಧಪಡಿಸಲ್ಪಟ್ಟ<br><br>अवघुषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಜ್ಞೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + घुषिर् (विशब्दने) - "क्तः" (३-२-१०२)<br><br>

अवघुष्ट
अवघुष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಸೆದು ತಯಾರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + घुषिर् (विशब्दने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अवघुष्टा रज्जुः"<br><br>

अवघूर्णन
अवघूर्णन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ತಿರುಗುವುದು<br><b>निष्पत्तिः - </b>अव + घूर्ण (भ्रमणे) - "ल्युट्" (३-३-११५)<br><br>

अवघूर्णयत्
अवघूर्णयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ತಿರುಗಿಸುವ<br><b>निष्पत्तिः - </b>अव + घूर्ण (भ्रमणे) - "शतृ" (३-२-१२४)<br><br>

अतघोषण
अतघोषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಡಂಗೂರ ಹೊಡೆಯುವುದು /ಗಟ್ಟಿಯಾಗಿ ಸಾರಿ ಪ್ರಸಿದ್ಧಪಡಿಸುವುದು<br><b>निष्पत्तिः - </b>अव + घुषिर् (विशब्दने) - "ल्युट्" (३-३-११५)<br><br>

अवघोषणा
अवघोषणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಡಂಗೂರ ಹೊಡೆಯುವುದು /ಗಟ್ಟಿಯಾಗಿ ಸಾರಿ ಪ್ರಸಿದ್ಧಪಡಿಸುವುದು<br><b>निष्पत्तिः - </b>अव + घुषिर् (विशब्दने) + णिच् - "युच्" (३-३-१०७)<br><br>

अवचन
अवचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ<br><br>अवचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೌನ /ಮಾತಾಡದಿರುವಿಕೆ<br><br>अवचन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾತಾಡದಿರುವ<br><b>निष्पत्तिः - </b>वच (परिभाषणे) - कर्त० "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>न वाचयति<br><br>

अवचना
अवचना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अवचन ಪದದ ಅರ್ಥ<br><b>प्रयोगाः - </b>"पार्वतीमवचनामसूयया प्रत्य्पेत्य पुनराह सस्मितम्"<br><b>उल्लेखाः - </b>कुमा० ८-५०<br><br>

अवचनीय
अवचनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಾಚ್ಯವಾದ /ಹೇಳಲು ಯೋಗ್ಯವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न वचनीयम्<br><b>प्रयोगाः - </b>"समवर्णे द्विजातीनां द्वादशैव व्यतिक्रमे । वादेष्ववचनीयेषु तदेव द्विगुणं भवेत् ॥"<br><b>उल्लेखाः - </b>मनु० ८-२६९<br><br>

अवचय
अवचय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಳ್ಳತನದಿಂದ ಹಣ್ಣು ಹೂವು ಮೊದಲಾದುವನ್ನು ಕೀಳುವುದು /ಬಿಡಿಸುವುದು /ಕೊಯ್ಯುವುದು<br><b>निष्पत्तिः - </b>अव + चिञ् (चयने) - "अच्" (३-३-५६)<br><b>प्रयोगाः - </b>"अवचयपरिभोगवन्ति हिंस्रैः सहचरितान्यमृगाणि काननानि"<br><b>उल्लेखाः - </b>किरा० १०-५<br><br>

अवचाय
अवचाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಯಿಂದ ಹೂವು ಹಣ್ಣು ಮುಂತಾದುವನ್ನು ಕೀಳುವುದು<br><b>निष्पत्तिः - </b>अव + चिञ् (चयने) - "घञ्" (३-३-४०)<br><b>प्रयोगाः - </b>"अविरतकुसुमावचायखेदान्निहितभुजालतयैकयोपकण्ठम्"<br><b>उल्लेखाः - </b>माघ० ७-७१<br><br>

अवचार
अवचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವರೋಹಣ ಸ್ಥಳ /ಇಳಿಯುವ ಜಾಗ<br><br>अवचार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಇಳಿಯುವ /ಕೆಳಮುಖವಾಗಿ ಹೋಗುವ<br><b>निष्पत्तिः - </b>अव + चर (गतौ) - "घञ्" (३-३-१८)<br><br>

अवचारण
अवचारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಲಿಸುವಿಕೆ /ನಡೆಯುವಂತೆ ಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + चर (गतौ) + णिच् - "ल्युट्" (३-३-११५)<br><br>अवचारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪ್ಪನ್ನು ತಯಾರಿಸುವ ಒಂದು ವಿಧಾನ<br><br>

अवचिकीषा|अवचिचीषा  
अवचिकी (ची) षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಯಿಂದ ಬಿಡಿಸುವ ಇಚ್ಛೆ<br><b>निष्पत्तिः - </b>अव + चिञ् (चयने)+ सन् - "अः" (३-३-१०२)<br><b>व्युत्पत्तिः - </b>अवचेतुमिच्छा<br><br>

अवचिकीषु|अवचिचीषु
अवचिकी(ची)षु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೈಯಿಂದ ಬಿಡಿಸಲು ಇಚ್ಛೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>अव + चिञ् (चयने) + सन् - "उः" (३-२-१६८)<br><b>व्युत्पत्तिः - </b>अवचेतुमिच्छुः<br><br>

अवचित
अवचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೈಯಿಂದ ಬಿಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + चिञ् (चयने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अवचितबलिपुष्पा वेदिसम्मार्गदक्षा नियमविधिजलानां बर्हिषां चोपनेत्री"<br><b>उल्लेखाः - </b>कुमा० १-६०<br><br>

अवचूड|अवचूल 
अवचूड(ल)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧ್ವಜದ ವಸ್ತ್ರ /ರಥದ ಮೇಲೆ ತೂಗಾಡುವ ಬಟ್ಟೆ<br><b>निष्पत्तिः - </b>डस्य वा लः<br><b>व्युत्पत्तिः - </b>अवनता चूडा अग्रं यस्य<br><b>प्रयोगाः - </b>"बिभ्राणया बहलयावकपङ्कपिङ्गपिच्छावचूडमनुमाधवधाम जग्मुः"<br><b>उल्लेखाः - </b>माघ० ५-१३<br><br>अवचूड(ल)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧ್ವಜದ ಕೆಳಗೆ ಜೋಲಾಡುತ್ತಿರುವ ಚಾಮರ ಮುಂತಾದುದು<br><b>प्रयोगाः - </b>"अवाप बाल्योचितनीलकण्ठपिच्छावचूडाकलनामिवोरः"<br><b>उल्लेखाः - </b>माघ० ३-५<br><br>

अवचूर्णन
अवचूर्णन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಡಿ ಮಾಡುವಿಕೆ /ಅರೆಯುವುದು<br><br>अवचूर्णन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಯದ ಮೇಲೆ ಔಷಧ ದ ಪುಡಿಯನ್ನು ತೂರಿ ಗಾಯವನ್ನು ಒಣಗಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + चूर्ण (सङ्कोचे) + णिच् - "ल्युट्" (३-३-११५)<br><br>

अवचूर्णित
अवचूर्णित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರೆಯಲ್ಪಟ್ಟ /ಪುಡಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + चूर्ण (सङ्कोचे) + णिच् - "क्तः" (३-२-१०२)<br><br>

अवचूलक
अवचूलक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಮರ<br><b>विस्तारः - </b>"चामरं रोमगुत्सं च केशरं चावचूलकम्" - त्रिकाण्ड० ।<br><br>अवचूलक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನವಿಲು ಗರಿಯಿಂದ ತಯಾರಿಸಿದ ಬೀಸಣಿಗೆ<br><br>

आच्छिन्न
आच्छिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರ್ಪಡಿಸಲ್ಪಟ್ಟ /ವಿಂಗಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + छिदिर् (द्वैधीकरणे) - "क्तः" (३-२-१०२)<br><br>आच्छिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಾಧಿಗಳಿಂದ ಭೇದ ತೋರ್ಪಡಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अवच्छिन्नस्य भिन्नस्य जरामरणधर्मिणः । मम ब्रवीति देवीयं सत्यानन्दचिदात्मताम् ॥"<br><b>उल्लेखाः - </b>प्रबोध० ६-२६<br><br>आच्छिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರ್ಣಯಿಸಲ್ಪಟ್ಟ /ಇಷ್ಟೆಂದು ತೀರ್ಮಾನಿಸಲ್ಪಟ್ಟ<br><br>

अवच्छुरित
अवच्छुरित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಟ್ಟಹಾಸ<br><b>निष्पत्तिः - </b>अव + छुर (छेदने) - "क्तः" (३-३-११४)<br><br>अवच्छुरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆರೆಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कर्म० "क्तः" (३-२-१०२)<br><br>

अवच्छेद
अवच्छेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿರ್ಣಯ /ನಿಶ್ಚಯ<br><br>अवच्छेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಲ್ಲೆ /ಗಡಿ<br><br>अवच्छेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಪ್ತಿ<br><br>अवच्छेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಷ್ಟೆಂದು ಮಿತಿಗೊಳಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + छिदिर् (द्वैधीकरणे) - भावे "घञ्" (३-३-१८)<br><br>अवच्छेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವಯವ /ಏಕದೇಶ<br><b>निष्पत्तिः - </b>अव + छिदिर् (द्वैधीकरणे) - कर० "घञ्" (३-३-१२१)<br><br>

अवच्छेदक
अवच्छेदक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವ್ಯಾಪ್ಯವೃತ್ತಿತ್ವ ನಿಯಾಮಕ<br><br>

अवच्छेद्य
अवच्छेद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸಲು ಯೋಗ್ಯವಾದ<br><br>अवच्छेद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯಿಸಲು ಅರ್ಹವಾದ /ಗೊತ್ತು ಮಾಡಲು ಶಕ್ಯವಾದ<br><b>निष्पत्तिः - </b>अव + छिदिर् (द्वैधीकरणे) - "ण्यत्" (३-१-१२४)<br><br>अवच्छेद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>अवच्छिन्न ಪದದ ಅರ್ಥ<br><br>

अवजय
अवजय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಾಜಯ /ಸೋಲು<br><b>निष्पत्तिः - </b>अव + जि (जये० - "अच्" (३-३-५६)<br><b>प्रयोगाः - </b>"अस्त्रं हरादाप्तवता दुरापं येनेन्द्रलोकावजयाय दृप्तः"<br><b>उल्लेखाः - </b>रघु० ६-६२<br><br>

अवजिति
अवजिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಜಯ /ಸೋಲಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + ज्ञा (अवबोधने) - "अङ्" (३-३-१०६)<br><b>प्रयोगाः - </b>"हृतवीतरागमनसां ननु वः सुखसङ्गिनं प्रति सुखावजितिः"<br><b>उल्लेखाः - </b>माघ० १७-४<br><br>

अवज्ञा
अवज्ञा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಾದರ /ತಿರಸ್ಕಾರ<br><br>

अवज्ञात
अवज्ञात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದಾಸೀನತೆಯಿಂದ ನೋಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + ज्ञा (अवबोधने) - "क्तः" (३-२-१०२)<br><br>अवज्ञात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಮಾನಗೊಳಿಸಲ್ಪಟ್ಟ /ಅಗೌರವ ಪಡಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"आससाद हरेः स्थानमवज्ञातत्रिविष्टपम्"<br><b>उल्लेखाः - </b>याद० १६-२१<br><br>

अवज्ञान
अवज्ञान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಾದರ /ತಿರಸ್ಕಾರ<br><b>निष्पत्तिः - </b>अव + ज्ञा (अवबोधने) - "ल्युट्" (३-३-११५)<br><br>अवज्ञान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಮಾನ /ಅಗೌರವ<br><b>प्रयोगाः - </b>"ईप्सितं तदवज्ञाद्विद्धि सार्गलमात्मनः"<br><b>उल्लेखाः - </b>रघु० १-७१<br><br>

अवट
अवट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ತ /ಹಳ್ಳ /ಗುಂಡಿ<br><b>निष्पत्तिः - </b>अव (रक्षणादौ) - "अटन्" (उ० ४-८१)<br><b>प्रयोगाः - </b>"रक्षसां गत्वसत्वानामेष धर्मः सनातनः । अवटे ये निधीयन्ते तेषां लोकाः सनातनाः ॥"<br><b>उल्लेखाः - </b>रामा०<br><br>अवट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಲ /ಗುಹೆ<br><br>अवट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೂಪ /ಬಾವಿ<br><br>अवट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶರೀರದ ತಗ್ಗಾದ ಜಾಗ /ಕಕ್ಷ /ಕಂಠಮೂಲ ಮುಂತಾದುದು<br><b>प्रयोगाः - </b>"अवटश्चैवमेतानि स्थानान्यत्र शरीरके"<br><b>उल्लेखाः - </b>याज्ञ० ३-९८<br><br>अवट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಐಂದ್ರಜಾಲಿಕ /ಗಾರುಡಿಗಾರ<br><b>विस्तारः - </b>"अवटः कूपखिलयोर्गर्ते कुहकजीविनि" - हेम० ।<br><br>अवट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಕ್ಕಿಯ ಮರಿ<br><b>विस्तारः - </b>"पक्षिपोतस्तु चिल्लाकश्चम्पुकः पीलुकावटौ" - वैज० ।<br><br>अवट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೨೪ ಅಂಗುಲಗಳು<br><b>विस्तारः - </b>"किष्कुः स्यादवटो हस्तः चतुर्विंशतिरङ्गुलाः" - वैज० ।<br><br>अवट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯಸ /ಕಾಗೆ<br><br>अवट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಳ್ಳುಳ್ಳಿ<br><br>अवट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇವಿನ ಮರ<br><br>अवट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುರ್ಜನ<br><b>विस्तारः - </b>"काके निम्बे च लशुने गर्ते कूपे खलेऽवटः" - त्रिकाण्ड० ।<br><br>अवट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ಷೀಣವಾದ /ದುರ್ಬಲವಾದ<br><b>विस्तारः - </b>"अवटः स्यात्खिले गर्ते कूपे कुहकजीविनि" - मेदि० ।<br><br>

अवटि
अवटि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ತ /ಹಳ್ಳ /ಗುಂಡಿ<br><br>अवटि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೂಪ /ಬಾವಿ<br><br>अवटि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಂಧ್ರ /ಸಂದು /ಬಿರುಕು<br><br>

अवटीट
अवटीट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿದ ಮೂಗುಳ್ಳ<br><b>निष्पत्तिः - </b>"टीटच्" (५-२-३१) । "अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>अवनतं नासिकायाः अवटीटम् । तद्युक्ताप्वटीटा नासिका । साऽस्यास्ति<br><b>विस्तारः - </b>"अवटौटोऽवनाटश्चावर्भटो नतनासिके" - अम० ।<br><br>

अवटु
अवटु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಳ್ಳ /ಗುಳಿ<br><br>अवटु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾವಿ<br><b>निष्पत्तिः - </b>अव + टीकृ (गतौ) - "डुः" (वा० ३-२-१८०)<br><b>व्युत्पत्तिः - </b>अवटीकते<br><br>अवटु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುತ್ತಿಗೆಯ ಹಿಂಭಾಗ<br><b>विस्तारः - </b>"अवटुः कथितो घाटाकूपगर्तेषु सूरिभिः" - विश्व० ।<br><br>अवटु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಟುವಲ್ಲದ /ಬ್ರಹ್ಮಚಾರಿಯಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न वटुः<br><br>

अवतंस
अवतंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣಾಭರಣ /ಕಿವಿಯಲ್ಲಿ ಧರಿಸುವ ಒಡವೆ<br><b>निष्पत्तिः - </b>अव + तसि (अलङ्कारे) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>अवतंस्यतेऽनेन<br><b>प्रयोगाः - </b>"यवाङ्कुरापाण्डुकपोलशोभी मायावतंसः परिकल्पितस्ते"<br><b>उल्लेखाः - </b>रघु० १३-४९<br><br>अवतंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿರೋಭೂಷಣ /ತಲೆಯಲ್ಲಿ ಧರಿಸುವ ಆಭರಣ<br><b>प्रयोगाः - </b>"गणा नमेरुप्रसवावतंसा भूर्जत्वचः स्पर्शवतीर्दधानाः"<br><b>उल्लेखाः - </b>कुमा० १-५५<br><br>अवतंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಭರಣ /ಒಡವೆ<br><b>प्रयोगाः - </b>"लवङ्गमालाकलितावतंसास्ते नालिकेलान्तरपः पिबन्तः"<br><b>उल्लेखाः - </b>माघ० ३-८१<br><br>

अवतंसक
अवतंसक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>अवतंस ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अव + तसि (अलङ्कारे) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>प्रयोगाः - </b>"कपोलसंश्लेषि विलोचनत्विषा विभूषयन्तीमवतंसकोत्पलम्"<br><b>उल्लेखाः - </b>किरा० ४-९<br><br>

अवतंसित
अवतंसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೂಷಿಸಲ್ಪಟ್ಟ /ಅಲಂಕರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + तसि (अलङ्कारे) - "क्तः" (३-२-१०२)<br><br>

अवतत
अवतत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಡಲ್ಪಟ್ಟ /ಹಬ್ಬಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + तनु (विस्तारे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"लताशतैरवतताम्"<br><b>उल्लेखाः - </b>रामा०<br><br>

अवतति
अवतति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಬುವಿಕೆ /ಹರಡುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + तनु (विस्तारे) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"प्रालेयावततिम्लानपलाशाब्ज इव ह्रदः"<br><b>उल्लेखाः - </b>किरा० ११-४<br><br>

अवतमस
अवतमस<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರುಗತ್ತಲೆ<br><b>निष्पत्तिः - </b>"अच्" (५-४-७९)<br><b>व्युत्पत्तिः - </b>अवक्षीणं तमः<br><br>अवतमस<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತಲೆ /ಅಂಧಕಾರ<br><b>प्रयोगाः - </b>"अवतमसभिदायै भास्वताभ्युद्गतेन प्रसभमुडुगणोऽसौ दर्शनीयोऽप्यपास्तः"<br><b>उल्लेखाः - </b>माघ० ११-५७<br><br>अवतमस<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಬ್ಬು /ಅಸ್ಪಷ್ಟವಾಗಿರುವಿಕೆ<br><br>

अवतर
अवतर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಳಿಯುವಿಕೆ /ಕೆಳಕ್ಕೆ ಬರುವಿಕೆ<br><br>अवतर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರವೇಶ<br><b>निष्पत्तिः - </b>अव + तॄ (प्लवनतरणयोः) - "अप्" (३-३-५७)<br><b>प्रयोगाः - </b>"भयस्य पूर्वावतरस्तरस्विना मनस्सु येन द्युसदां न्यधीयत"<br><b>उल्लेखाः - </b>माघ० १-४३<br><br>

अवतरण
अवतरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಳಿಯುವಿಕೆ /ಕೆಳಕ್ಕೆ ಬರುವಿಕೆ<br><br>अवतरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರೆ ರೂಪವನ್ನು ಹೊಂದಿ ಬರುವಿಕೆ<br><br>अवतरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೀರಪ್ರದೇಶದಿಂದ ನೀರಿನೊಳಕ್ಕೆ ಇಳಿದು ಬರುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + तॄ (प्लवनतरणयोः) - "ल्युट्" (३-३-११५)<br><br>अवतरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಳಿಯುವ ಸೋಪಾನ<br><b>निष्पत्तिः - </b>अव + तॄ (प्लवनतरणयोः) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>अवतीर्यतेऽनेन<br><br>अवतरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲೊಕರಕ್ಷಣೆಗಾಗಿ ದೇವತೆಗಳು ತಮ್ಮ ಅಂಶದಿಂದ ಭೂಮಿಯಲ್ಲಿ ಹುಟ್ಟುವುದು<br><br>अवतरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವತರಣಿಕೆ /ಪೀಠಿಕೆ /ಉಪೋದ್ಘಾತ<br><br>

अवतरणी
अवतरणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಸ್ತಾವನೆ /ಉಪೋದ್ಘಾತ<br><b>निष्पत्तिः - </b>अव + तॄ (प्लवनतरणयोः) - कर० "ल्युट्" (३-३-११७) । "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>अवतोर्यते ग्रन्थोऽनया<br><br>

अवतरणिका
अवतरणिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಿವಿಡಿ /ರೀತಿ /ಅನುಕ್ರಮ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><br>

अवतान
अवतान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲತೆಗಳ ಹಂಬು<br><br>अवतान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಮುಖ<br><br>अवतान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂತಾನ /ಪರಂಪರೆ<br><b>निष्पत्तिः - </b>अव + तनु (विस्तारे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"लताशतैरवततामवतानशतैस्तथा"<br><b>उल्लेखाः - </b>रामा०<br><br>

अवतार
अवतार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಳಿಯುವಿಕೆ /ಕೆಳಕ್ಕೆ ಬರುವಿಕೆ<br><br>अवतार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೂಪಾಂತರ ಹೊಂದಿ ಬರುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + तॄ (प्लवनतरणयोः) -"घञ्" (३-३-१२०)<br><b>प्रयोगाः - </b>"धर्मार्थकाममोक्षाणां अवतार इवाङ्गवान्"<br><b>उल्लेखाः - </b>रघु० १०-८४<br><br>अवतार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆಗಳು ಲೋಕರಕ್ಷಣೆಗಾಗಿತಮ್ಮ ಅಂಶದಿಂದ ಭೂಮಿಯಲ್ಲಿ ಹುಟ್ಟುವುದು /ವಿಷ್ಣುವಿನ ಮತ್ಸ್ಯಾವತಾರ<br><b>प्रयोगाः - </b>"मत्स्यः कूर्मो वराहश्च नारसिंहोऽथ वामनः । रामो रामश्च कृष्णश्च बुद्धः कल्की च ते दश ॥"<br><br>अवतार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಳಿಯುವ ಸ್ಥಳ /ನದಿಗೆ ಇಳಿಯುವ ಮಾರ್ಗ<br><b>प्रयोगाः - </b>"रुद्धे गजेन सरितः सरुषावतारे रिक्तोदपात्रकरमास्त चिरं जनौघः"<br><b>उल्लेखाः - </b>माघ० ५-३३<br><br>अवतार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಾಷಾಂತರ ಪರಿವರ್ತನೆ<br><br>अवतार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಸ್ತಾವನೆ /ಪೀಠಿಕೆ<br><br>अवतार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುಣ್ಯತೀರ್ಥ /ಪವಿತ್ರವಾದ ನದಿ<br><b>विस्तारः - </b>"अवतारोऽवतरणे पुष्करिण्यादितीर्थयोः" - मेदि० ।<br><br>

अवतारक
अवतारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಳಿಸುವ /ಕೆಳಕ್ಕೆ ಕರೆತರುವ<br><b>निष्पत्तिः - </b>अव + तॄ (प्लवनतरणयोः) - "ण्वुल्" (३-१-१३३)<br><br>

अवतारिका
अवतारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಳಿಸುವ /ಕೆಳಕ್ಕೆ ಕರೆತರುವ<br><br>अवतारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಂಥದ ಪೀಠಿಕೆ /ಪ್ರಸ್ತಾವನೆ<br><br>

अवतारण
अवतारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಿನಿಂದ ಕೆಳಕ್ಕೆ ಇಳಿಸುವಿಕೆ /ಗಾಡಿ ಮೊದಲಾದುವುಗಳಿಂದ ಇಳಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + तॄ (प्लवनतरणयोः) + णिच् - "ल्युट्" (३-३-११७)<br><b>प्रयोगाः - </b>"क्रियतां यदि शक्नोषि गङ्गाया अवतारणम्"<br><b>उल्लेखाः - </b>रामा०<br><br>अवतारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂತಗಳು ಕಾಣಿಸುವಂತೆ ಮಾಡುವುದು /ಭೂತಗಳನ್ನು ಹಿಡಿಯುವಿಕೆ<br><br>अवतारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಂಥದ ಪೀಠಿಕೆ /ಪ್ರಸ್ತಾವನೆ<br><br>अवतारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ /ಅರ್ಚನೆ<br><br>अवतारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಟ್ಟೆಯ ಸೆರಗು<br><b>विस्तारः - </b>"अथावतारणे । वस्त्राञ्चलार्चने भूतावेशे" - हेम० ।<br><br>

अवतार्यमाण
अवतार्यमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಿನಿಂದ ಕೆಳಕ್ಕೆ ಇಳಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अव + तॄ (प्लवनतरणयोः) + णिच् - कर्म० "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"यानाज्जनः परिजनैरवतार्यमाणा राज्ञीर्नरापनयनाकुलसौविदल्लाः "<br><b>उल्लेखाः - </b>माघ० ५-१७<br><br>

अवतीर्ण
अवतीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಳಿದಿರುವ /ಮೇಲಿನಿಂದ ಕೆಳಕ್ಕೆ ಬಂದಿರುವ<br><b>निष्पत्तिः - </b>अव + तॄ (प्लवनतरणयोः) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"कौबेरदिग्भागमपास्य मार्गमागस्त्यमुष्णांशुरिवावतीर्णः"<br><b>उल्लेखाः - </b>माघ० ३-१<br><br>अवतीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರಿನೊಳಕ್ಕೆ ಇಳಿದಿರುವ<br><br>अवतीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ರೂಪದಿದ ಹುಟ್ಟಿರುವ<br><br>अवतीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಾಷಾಂತರಿಸಲ್ಪಟ್ಟ<br><br>

अवतोका
अवतोका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ಭಸ್ರಾವವಾದ ಹೆಂಗಸು ಅಥವಾ ಹಸು<br><b>व्युत्पत्तिः - </b>अवगलितं तोकं यस्याः<br><br>

अवत्त
अवत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸಲ್ಪಟ್ಟ ಹವಿಸ್ಸು<br><b>निष्पत्तिः - </b>अव + दो (अवखण्डने) - "क्तः" (३-२-१०२)<br><br>अवत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + डुदाञ् (दाने) - "क्तः" (३-२-१०२)<br><br>

अवदंश
अवदंश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಯಾರಿಕೆಯುಂಟುಮಾಡುವ ಆಹಾರ /ಹುರಿಗಾಳು ಮುಂತಾದ ಕಾರದ ತಿಂಡಿ<br><b>निष्पत्तिः - </b>अव + दंश (दशने) - कर्म० "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>अवदश्यते<br><br>

अवदाघ
अवदाघ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಸಿಗೆ ಕಾಲ /ಗ್ರೀಷ್ಮ ಋತು<br><b>निष्पत्तिः - </b>अव + दह (भस्मीकरणे) - "घञ्" (३-३-१८)<br><br>

अवदात
अवदात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳುಪು<br><br>अवदात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಳದಿ ಬಣ್ಣ<br><b>निष्पत्तिः - </b>अव + दैप् (शोधने) - "क्तः" (३-४-७२)<br><br>अवदात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಳುಪಾದ<br><br>अवदात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಳದಿ ಬಣ್ಣದ<br><br>अवदात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶುದ್ಧವಾದ<br><br>अवदात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಷ್ಕಳಂಕವಾದ /ದೋಷವಿಲ್ಲದ<br><b>प्रयोगाः - </b>"स वंशस्यावदातस्य शशाङ्कस्येव लाञ्छनम्"<br><b>उल्लेखाः - </b>किरा० ११-७५<br><br>अवदात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನೋಹರವಾದ /ಸುಂದರವಾದ<br><b>विस्तारः - </b>"अवदातं तु विमले मनोज्ञे सितपीतयोः" - हेम० ।<br><br>

अवदान
अवदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವಿಕೆ /ತುಂಡು ಮಾಡುವಿಕೆ<br><br>अवदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಾಕ್ರಮ /ಶಕ್ತಿ<br><b>निष्पत्तिः - </b>अव + दो (अवखण्डने) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"नैरृतघ्नमथ मन्त्रवन्मुनेः प्रापदस्त्रमवदानतोषितात्"<br><b>उल्लेखाः - </b>रघु० ११-२१<br><br>अवदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂರ್ವದಲ್ಲಿ ನಡೆಸಿದ ಕೆಲಸ /ಕೀರ್ತಿಯನ್ನು ತರುವ ಶ್ಲಾಘ್ಯವಾದ ಕೆಲಸ<br><b>निष्पत्तिः - </b>अव + दैप् (शोधने) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"विश्वावसुप्राग्रहरैः प्रवीणैः सङ्गीयमानत्रिपुरावदानः"<br><b>उल्लेखाः - </b>कुमा० ७-४८<br><br>अवदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಮಂಚದ ಬೇರು<br><b>विस्तारः - </b>"अवदानं खण्डने स्यादितिवृत्ते च कर्मणि" - मेदि० ।<br><br>

अवदारक
अवदारक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುದ್ದಲಿ /ಸಲಿಕೆ<br><br>अवदारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೀಳುವ /ಬಿರಿಯುವಂತೆ ಮಾಡುವ<br><b>निष्पत्तिः - </b>अव + दॄ (विदारणे) + णिच् - "ण्वुल्" (३-१-१३३)<br><br>

अवदारण
अवदारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೀಳುವುದು /ಹೋಳು ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>अव + दॄ (विदारणे) + णिच् - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"अवदारणकाले तु पृथिवी नावदीर्यते"<br><b>उल्लेखाः - </b>रामा०<br><br>अवदारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುದ್ದಲಿ /ಸಲಿಕೆ<br><b>निष्पत्तिः - </b>अव + दॄ (विदारणे) + णिच् - "ल्युट्" (३-३-११७)<br><br>

अवदाह
अवदाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಮಂಚದ ಬೇರು<br><b>व्युत्पत्तिः - </b>अवसादितो दाहो येन<br><br>अवदाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂತಾಪ /ಜ್ವರದ ತಾಪ<br><br>

अवदीर्ण
अवदीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಡೆದಿರುವ /ಸೀಳಾಗಿರುವ<br><b>निष्पत्तिः - </b>अव + दॄ (विदारणे) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"अवदीर्णशुक्तिपुटमुक्तमौक्तिकप्रकरैरिव प्रियरथाङ्गमङ्गनाः"<br><b>उल्लेखाः - </b>माघ० १३-३७<br><br>अवदीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರಗಿಸಲ್ಪಟ್ಟ /ದ್ರವವಾಗಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + दॄ (विदारणे) - "क्तः" (३-२-१०२)<br><br>

अवदोह
अवदोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಲು /ಕ್ಷೀರ<br><b>निष्पत्तिः - </b>अव + दुह (प्रपूरणे) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>अवदुह्यते<br><b>विस्तारः - </b>"अवदोहः पयः क्षीरम्" - त्रिकाण्ड० ।<br><br>अवदोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಲು ಕರೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>भावे "घञ्" (३-३-१८)<br><br>

अवद्य
अवद्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೋಷ<br><b>निष्पत्तिः - </b>वद (व्यक्तायां वाचि) - "यत्" (३-१-१०१)<br><b>व्युत्पत्तिः - </b>नोद्यते नोच्यते<br><b>प्रयोगाः - </b>"इति शिरसि स वामं पादमाधाय राज्ञामुदवहदनवद्यां तामवद्यादपेतः"<br><b>उल्लेखाः - </b>रघु० ७-७०<br><br>अवद्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ<br><br>अवद्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><br>अवद्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಜ್ಜೆ /ನಾಚಿಕೆ<br><br>अवद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದ್ಯವಾದ /ದೂಷಣೆಗೆ ಯೋಗ್ಯವಾದ<br><br>अवद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತುಚ್ಛವಾದ /ನೀಚವಾದ<br><b>प्रयोगाः - </b>"पुराणमित्येव न साधु सर्वं न चापि काव्यं नवमित्यवद्यम्"<br><b>उल्लेखाः - </b>माल० १-२<br><br>

अवद्यत्
अवद्यत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಖಂಡಿಸುವ /ಕತ್ತರಿಸುವ<br><b>निष्पत्तिः - </b>अव + दो (अवखण्डने) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"अवद्यन् पत्रिणः शम्भोः सायकैरवसायकैः"<br><b>उल्लेखाः - </b>किरा० १५-३७<br><br>

अवद्योतन
अवद्योतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + द्युत (दीप्तौ) + णिच् - "ल्युट्" (३-३-११५)<br><br>

अवधान
अवधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಯ /ಗಮನ<br><b>निष्पत्तिः - </b>अव + डुधाञ् (धारणपोषणयोः) - "ल्युट्" (३-३-११७)<br><b>प्रयोगाः - </b>"अवधानेन परस्परं जिगीषा"<br><b>उल्लेखाः - </b>याद० १५-१२२<br><br>अवधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಏಕಾಗ್ರತೆ /ನೆಟ್ಟ ಮನಸ್ಸಿನಿಂದ ಕೂಡಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"श्रृणुत जना अवधानात् क्रियामिमां कालिदासस्य"<br><b>उल्लेखाः - </b>विक्र० १-२<br><br>

अवधारण
अवधारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯ /ಅವಧಾರಣ<br><b>निष्पत्तिः - </b>अव + धृञ् (धारणे) + णिच् - "ल्युट्" (३-३-११५)<br><br>अवधारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಗ್ಬಲ /ದೃಢವಚನ<br><br>अवधारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಿತಗೊಳಿಸುವಿಕೆ<br><br>अवधारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶೇಷ ಗುಣಗಳ ಕಾರಣ ಇತರ ವಸ್ತುಗಳಿಂದ ಬೇರ್ಪಡಿಸುವಿಕೆ<br><br>

अवधारणा
अवधारणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अवधारण ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अव + धृञ् (धारणे) + णिच् - "युच्" (३-३-१०७)<br><br>

अवधारणीय
अवधारणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯಿಸಲು ಅರ್ಹವಾದ /ನಿರ್ಣಯಿಸಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>अव + धृञ् (धारणे) + णिच् - "अनीयर्" (३-१-९६)<br><br>अवधारणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರ್ಣಯಿಸಲ್ಪಡಬೇಕಾದ<br><b>निष्पत्तिः - </b>अव + धृञ् (धारणे) + णिच् - कर्म० "अनीयर्" (३-१-९६)<br><b>प्रयोगाः - </b>"विष्णोरिवास्यानवधारणीयमीदृक्तया रुपमियत्तया वा"<br><b>उल्लेखाः - </b>रघु० १३-५<br><br>

अवधारित
अवधारित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + धृञ् (धारणे) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"चयस्त्विषामित्यवधारितं पुरा ततः शरीरीति विभाविताकृतिम्"<br><b>उल्लेखाः - </b>माघ० १-३<br><br>अवधारित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಶೇಷ ಗುಣ ಪ್ರಯುಕ್ತ ಇತರ ವಸ್ತುಗಳಿಂದ ಬೇರ್ಪಡಿಸಲ್ಪಟ್ಟ<br><br>

अवधार्य
अवधार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯಿಸಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>अव + धृञ् (धारणे) + णिच् - "यत्" (३-१-९७)<br><b>प्रयोगाः - </b>"परिणतिरवधार्या यत्नतः पण्डितेन"<br><b>उल्लेखाः - </b>भर्तृ० २-९९<br><br>अवधार्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿರ್ಣಯಿಸಿ /ನಿಶ್ಚಯಿಸಿ<br><b>निष्पत्तिः - </b>अव + धृञ् (धारणे) + णिच् - "ल्यप्" (३-१-९७)<br><br>

अवधि
अवधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಲ್ಲೆ /ಗಡಿ /ಸರಹದ್ದು<br><b>निष्पत्तिः - </b>अव + डुधाञ् (धारणे) - "किः" (३-३-९२)<br><b>प्रयोगाः - </b>"अवधिं दर्शनीयानामाकल्पमनघं दिवः"<br><b>उल्लेखाः - </b>याद० १६-१८<br><br>अवधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲ /ಸಮಯ<br><b>प्रयोगाः - </b>"अथ चेदवधिः प्रतीक्ष्यते कथमाविष्कृतजिह्मवृत्तिना"<br><b>उल्लेखाः - </b>किरा० २-१६<br><br>अवधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ತೈಕಾಗ್ರತೆ /ಅವಧಾನ /ಗಮನ<br><br>अवधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಲ /ಗುಳಿ<br><br>अवधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರಾವಧಿ /ಮುಂದಿನ ಕಾಲದ ಗಡು<br><b>विस्तारः - </b>"अवधिस्त्ववधाने स्यात् सीम्नि काले बिले पुमान्" - मेदि० ।<br><br>

अवधिमत्
अवधिमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲೆಯಿಂದ ಕೂಡಿದ<br><br>अवधिमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಯಿದೆಯುಳ್ಳ /ಕಾಲದ ಗಡುವುಳ್ಳ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>अवधिरस्यास्ति<br><br>

अवधीयमान
अवधीयमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಮನಿಸಲ್ಪಡುವ /ಆಸಕ್ತಿಯಿಡಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अव + डुधाञ् (धारणपोषणयोः) - कर्म० "शानच्" (३-२-१२४)<br><br>

अवधीरणा
अवधीरणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಮಾನ<br><br>अवधीरणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರ<br><b>निष्पत्तिः - </b>अवधीर (अवज्ञायाम्) + णिच् - "युच्" (३-३-१०७)<br><b>प्रयोगाः - </b>"अयं स ते तिष्ठति सङ्गमोत्सुको विशङ्कसे भीरु यतोऽवधीरणाम्"<br><b>उल्लेखाः - </b>शाकु० ३-११<br><br>

अवधीरित
अवधीरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಮಾನಗೊಳಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अवधीर (अवज्ञायाम्) + णिच् - "क्तः" (३-२-१०२)<br><br>अवधीरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"कप्"<br><b>व्युत्पत्तिः - </b>नास्ति वधूर्यस्य<br><b>प्रयोगाः - </b>"अवधीरितदुग्धाब्धिर्मधुरायां मनो दधे"<br><b>उल्लेखाः - </b>याद० १-९८<br><br>

अवधूक
अवधूक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪತ್ನಿಯಿಲ್ಲದವನು<br><br>

अवधूत
अवधूत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂನ್ಯಾಸಿ /ಬೈರಾಗಿ /ಜಗತ್ತಿನ ಸಂಬಂಧವನ್ನು ತ್ಯಜಿಸಿದ ವಿರಕ್ತ<br><b>प्रयोगाः - </b>"यो विलङ्घ्याश्रमान् वर्णान् आत्मन्येव स्थितः पुमान् । अतिवर्णाश्रमी योगी अवधूतः स उच्यते ॥"<br><br>अवधूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡಿಸಲ್ಪಟ್ಟ /ಕದಲಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + धूञ् (कम्पने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अवधूतपङ्कजपरागकणास्तनुजाह्नवीसलिलवीचिभिदः"<br><b>उल्लेखाः - </b>किरा० ६-३<br><br>अवधूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ /ನಿರಾಕರಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अन्वनैषुरवधूतविग्रहस्तं दुरुत्सहवियोगमङ्गनाः"<br><b>उल्लेखाः - </b>रघु० १९-४३<br><br>अवधूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಮಾನಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>अवधूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಡವಲ್ಪಟ್ಟ<br><br>

अवधूनन
अवधूनन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡಿಸುವಿಕೆ /ಅಲ್ಲಾಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + धूञ् (कम्पने) - "ल्युट्" (३-३-११५) । नुमागमः (वा० ७-४-२)<br><b>प्रयोगाः - </b>"विडम्बयन्ती ददृशे वधूजनैरमन्ददष्ठौष्ठकरावधूननम्"<br><b>उल्लेखाः - </b>किरा० ८-६<br><br>अवधूनन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಡುಕ /ತತ್ತರ /ಕಂಪನ<br><br>अवधूनन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಡವುವಿಕೆ<br><br>अवधूनन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಮಾನಗೊಳಿಸುವಿಕೆ<br><br>अवधूनन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸುವಿಕೆ<br><br>

अवधृत
अवधृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + धृञ् (धारणे) - "क्तः" (३-२-१०२)<br><br>

अवधेय
अवधेय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಯ /ಗಮನ<br><b>निष्पत्तिः - </b>अव + डुधाञ् (धारणपोषणयोः) - "यत्" (३-१-९७)<br><br>अवधेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಡಲು ಯೋಗ್ಯವಾದ<br><br>अवधेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲು ಯೋಗ್ಯವಾದ<br><br>अवधेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಂಬಲು ಅರ್ಹವಾದ<br><br>

अवध्य
अवध्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಲ್ಲಲಾಗದ /ಕೊಲ್ಲಲು ಅರ್ಹನಲ್ಲದ /ವಧೆಗೆ ಅನರ್ಹನಾದ<br><b>निष्पत्तिः - </b>वध - "यः" (५-१-६६)<br><b>व्युत्पत्तिः - </b>वधमर्हति<br><b>प्रयोगाः - </b>"देही नित्यमवध्योऽयं देहे सर्वस्य भारत"<br><b>उल्लेखाः - </b>गीता० २-३०<br><br>

अवध्वंस
अवध्वंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಡುವುದು /ಪರಿತ್ಯಾಗ<br><br>अवध्वंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ /ಬೈಗಳು<br><br>अवध्वंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುಡಿ ಮಾಡುವುದು /ಧುಳು ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>अव + ध्वंसु (अवस्रंसने) - "घञ्" (३-३-१८)<br><b>विस्तारः - </b>"अवध्वंसस्तु निन्दायां परित्यागेऽवचूर्णने" - हेम० ।<br><br>अवध्वंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶ<br><br>

अवध्वस्त
अवध्वस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತ್ಯಜಿಸಲ್ಪಟ್ಟ /ಬಿಡಲ್ಪಟ್ಟ<br><br>अवध्वस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುಡಿ ಮಾಡಲ್ಪಟ್ಟ /ಚೂರ್ಣ ಮಾಡಲ್ಪಟ್ಟ<br><br>अवध्वस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿಸಲ್ಪಟ್ಟ /ದೂಷಿಸಲ್ಪಟ್ಟ<br><br>अवध्वस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶ ಪಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + ध्वंसु (अवस्रंसने) - "क्तः" (३-२-१०२)<br><br>

अवन
अवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ಷಿಸುವುದು /ಕಾಪಾಡುವುದು<br><b>निष्पत्तिः - </b>अव (रक्षणादौ० - "ल्युट्" (३-३-११५)<br><br>अवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂತೋಷಪಡಿಸುವಿಕೆ /ತೃಪ್ತಿ ಪಡಿಸುವಿಕೆ<br><br>अवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೃಪ್ತಿ<br><br>अवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿ<br><br>अवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಮರ್ಥ್ಯ<br><br>अवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರವೇಶ<br><br>अवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಚನೆ<br><br>अवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಲಿಂಗನ<br><br>अवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ /ಏಳಿಗೆ<br><br>अवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸುವಿಕೆ<br><br>अवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸೆ /ತೊಂದರೆ<br><br>अवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಂದುವಿಕೆ /ಪಡೆಯುವಿಕೆ<br><br>

अवनत
अवनत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿರುವ /ಕೆಳಮುಖವಾಗಿರುವ<br><b>निष्पत्तिः - </b>अव + णम (प्रह्वत्वे) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"अवनतवदनेन्दुरिच्छतीव व्यवधिमधीरतया यदास्थितास्मै"<br><b>उल्लेखाः - </b>माघ० ७-३८<br><br>अवनत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸ್ತಹೊಂದಿದ /ಮುಳುಗಿದ<br><b>प्रयोगाः - </b>"रजनिरवनतेन्दुर्लज्जयाधोमुखीव"<br><b>उल्लेखाः - </b>माघ० १०-९१<br><br>अवनत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಮಸ್ಕರಿಸಲ್ಪಟ್ಟ<br><br>अवनत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿನಯವುಳ್ಳ /ವಿಧೇಯತೆಯುಳ್ಳ<br><br>

अवनति
अवनति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"दधत्या शालीनामवनतिमुदारे सति फले"<br><b>उल्लेखाः - </b>मुद्रा० ३-८<br><br>अवनति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಧೇಯತೆ /ನಮ್ರತೆ /ವಿನಯ<br><b>निष्पत्तिः - </b>अव + णम (प्रह्वत्वे) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"गतवत्यवराजत जपाकुसुमस्तबकद्युतौ दिनकरेऽवनतिम्"<br><b>उल्लेखाः - </b>माघ० ९-८<br><br>अवनति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸ್ತಮಯ<br><br>अवनति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಮಸ್ಕಾರ /ಪ್ರಣಾಮ<br><br>अवनति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ಷೀಣಗತಿ ಹೊಂದುವಿಕೆ /ಇಳಿಮುಖವಾಗುವಿಕೆ<br><br>

अवनद्ध
अवनद्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೃದಂಗ<br><br>अवनद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಟ್ಟಲ್ಪಟ್ಟ /ಗಂಟು ಹಾಕಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + णह (बन्धने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"चर्मावनद्धं दुर्गन्धि पूर्णं मूत्रपुरीषयोः"<br><b>उल्लेखाः - </b>मनु० ६-७६<br><br>अवनद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಪ್ತವಾದ /ಸುತ್ತಲೂ ಆವರಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"ताम्बूलीलतावनद्धपूगखण्डमण्डितैः"<br><b>उल्लेखाः - </b>कादं०<br><br>अवनद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಟ್ಟಿಗೆ ಸೇರಿಸಲ್ಪಟ್ಟ /ಪೋಣಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"हरितपत्रमयीव मरुद्गणैः स्रगवनद्धमनोरमपल्लवा"<br><b>उल्लेखाः - </b>माघ० ६-५३<br><br>अवनद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಡಲ್ಪಟ್ಟ /ನೆಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"निसर्गरक्तैर्वलयावनद्धताम्राश्मरश्मिच्छुरितैर्नखाग्रैः"<br><b>उल्लेखाः - </b>माघ० ३-७<br><br>अवनद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲೇಪನ ಮಾಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"स्त्यानावनद्धघनशोणितशोणपाणिः"<br><b>उल्लेखाः - </b>वेणी० १-२१<br><br>

अवनम्र
अवनम्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಬಗ್ಗಿರುವ<br><b>निष्पत्तिः - </b>अव + णम (प्रह्वत्वे) - "रः" (३-२-१६७)<br><b>प्रयोगाः - </b>"पर्याप्तपुष्पस्तबकावनम्रा सञ्चारिणी पल्लविनी लतेव"<br><b>उल्लेखाः - </b>कुमा० ३-५४<br><br>

अवनय
अवनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ತಳ್ಳುವುದು<br><br>अवनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಗೆ ಹಾಕುವುದು<br><b>निष्पत्तिः - </b>अव + णीञ् (प्रापणे) - "अच्" (३-३-५६)<br><br>

अवनाट
अवनाट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿದ ಮೂಗುಳ್ಳ<br><b>निष्पत्तिः - </b>"नाटच्" (५-२-३१) । "अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>अवनतं नासिकायाः अवनाटम् । तद्योगान्नासिकाप्यवनाटा । साऽस्यास्ति<br><br>

अवनाम
अवनाम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿ ನಮಸ್ಕರಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + णम (प्रह्वत्वे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"इति कृतवचनायाः कश्चिदभ्येत्य बिभ्यद्गलितनयनवारेर्याति पादावनामम्"<br><b>उल्लेखाः - </b>माघ० ११-३५<br><br>

अवनाय
अवनाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ತರುವುದು /ತಳ್ಳುವುದು /ನೂಕುವುದು<br><b>निष्पत्तिः - </b>अव + णीञ् (प्रापणे) - "घञ्" (३-३-१८)<br><br>

अवनि
अवनि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿ<br><b>निष्पत्तिः - </b>अव (रक्षणे) - "अनिः" (उ० २-१०२)<br><b>प्रयोगाः - </b>"अवनितनयभीतान् प्रीणयन्नादितेयान्"<br><b>उल्लेखाः - </b>याद० १६-१४४<br><br>अवनि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆರಳು<br><br>

अवनी
अवनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अवनि ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (ग० सू० ५०)<br><b>प्रयोगाः - </b>"निवत्स्यतो विश्वपतेरवन्पाम्"<br><b>उल्लेखाः - </b>याद० २-४६<br><br>

अवनीतनय
अवनीतनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿಯ ಮಗ ಕುಜ, ಅಂಗಾರಕ, ನರಕಾಸುರ<br><br>

अवनीसुत
अवनीसुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿಯ ಮಗ ಕುಜ, ಅಂಗಾರಕ, ನರಕಾಸುರ<br><br>

अवनीतनया
अवनीतनया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿಯ ಮಗಳು ಸೀತಾದೇವಿ<br><br>

अवनीसुता
अवनीसुता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿಯ ಮಗಳು ಸೀತಾದೇವಿ<br><br>

अवनीध्र
अवनीध्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತ /ಬೆಟ್ಟ<br><b>निष्पत्तिः - </b>धृञ् (धारणे० - "कः" (वा० ३-२-५)<br><b>व्युत्पत्तिः - </b>अवनीं धरति<br><b>प्रयोगाः - </b>"स्फुटमेव समस्तमापदा तदिदानीमवनीध्रमूर्धसु"<br><b>उल्लेखाः - </b>माघ० १६-७८<br><br>

अवनीपति
अवनीपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ /ದೊರೆ /ಭೂಮಿಯನ್ನು ಪಾಲಿಸುವವನು<br><b>व्युत्पत्तिः - </b>अवन्याः पतिः<br><b>प्रयोगाः - </b>"हरिरिव युगदीर्घैर्दोर्भिरंशैस्तदीयैः पतिरवनिपतीनां तैश्चकाशे चतुर्भिः"<br><b>उल्लेखाः - </b>रघु० १०-८६<br><br>

अवनीपाल
अवनीपाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ /ದೊರೆ /ಭೂಮಿಯನ್ನು ಪಾಲಿಸುವವನು<br><b>व्युत्पत्तिः - </b>अवन्याः पालः<br><br>

अवनीपालक
अवनीपालक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ /ದೊರೆ /ಭೂಮಿಯನ್ನು ಪಾಲಿಸುವವನು<br><b>व्युत्पत्तिः - </b>अवन्याः पालकः<br><br>

अवनीभृत्
अवनीभृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ /ದೊರೆ /ಭೂಮಿಯನ್ನು ಪಾಲಿಸುವವನು<br><b>निष्पत्तिः - </b>अवनी + डुभृञ् (धारणपोषणयोः) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>अवनीं बिभर्ति<br><br>

अवनीश
अवनीश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ /ದೊರೆ /ಭೂಮಿಯನ್ನು ಪಾಲಿಸುವವನು<br><b>व्युत्पत्तिः - </b>अवन्याः ईशः<br><br>

अवनीश्वर
अवनीश्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ /ದೊರೆ /ಭೂಮಿಯನ್ನು ಪಾಲಿಸುವವನು<br><b>व्युत्पत्तिः - </b>अवन्याः ईश्वरः<br><br>

अवनेजन
अवनेजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಳೆಯುವುದು /ಶುದ್ಧಿ ಮಾಡುವುದು<br><br>अवनेजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರಾದ್ಧದಲ್ಲಿ ದರ್ಭೆಯ ಮೇಲೆ ನೀರನ್ನು ಪ್ರೋಕ್ಷಿಸುವುದು<br><b>निष्पत्तिः - </b>अव + णिजिर् (शौचे) - "ल्युट्" (३-३-११५)<br><br>

अवन्ति
अवन्ति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಳವದೇಶ<br><b>प्रयोगाः - </b>"अयोध्या मथुरा माया काशी काञ्चिरवन्तिका । पुरी द्वारावती चैव सप्तैता मोक्षदायिकाः ॥"<br><br>अवन्ति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಳವದೇಶದ ದೊರೆಗಳು<br><br>अवन्ति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಳವ ದೇಶಸ ಜನರು<br><br>

अवन्ती
अवन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಳವದೇಶದ ರಾಜಧಾನಿಯಾದ ಉಜ್ಜಯಿನಿ ನಗರ<br><b>प्रयोगाः - </b>"विन्दानुविन्दावावन्त्यौ सैन्येन महतावृतौ । जिगाय समरे वीरावाश्विनेयः प्रतापवान् ॥"<br><b>उल्लेखाः - </b>भा० सभा० ३२-११<br><br>

अवन्तिसोम
अवन्तिसोम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಜಿ /ಅಂಬಲಿ<br><b>व्युत्पत्तिः - </b>अवन्तिषु सोम इव । अवन्तिषु सूयते वा ।<br><br>

अवन्ध्य
अवन्ध्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಫಲಸಹಿತವಾದ /ಫಲದಿಂದ ತುಂಬಿದ /ಫಲಿಸಿದ ಮರ<br><b>व्युत्पत्तिः - </b>बध्नाति फलानि इति बन्ध्यः । न बन्ध्यः ।<br><br>अवन्ध्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯರ್ಥವಲ್ಲದ /ಸಫಲವಾದ<br><b>प्रयोगाः - </b>"अवन्ध्यकोपस्य निहन्तुरापदां भवन्ति वश्याः स्वयमेव देहिनः"<br><b>उल्लेखाः - </b>किरा० १-३३<br><br>

अवन्ध्या
अवन्ध्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರವತಿಯಾದ ಹೆಂಗಸು<br><br>

अवपक्व
अवपक्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಡಿಮೆ ಬೇಯಿಸಲ್ಪಟ್ಟ<br><br>

अवपतन
अवपतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಇಳಿಯುವಿಕೆ<br><br>

अवपन्न
अवपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆರೆಸಲ್ಪಟ್ಟ /ಮಿಶ್ರ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + पद (गतौ) - "क्तः" (३-२-१०२)<br><br>अवपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧದಿಂದ ಕೆಟ್ಟಿರುವ /ಸಂಸರ್ಗದಿಂದ ದೂಷಿತವಾದ<br><b>प्रयोगाः - </b>"केशकीटावन्नं च पदा स्पृष्टं च कामतः"<br><b>उल्लेखाः - </b>मनु० ४-२०७<br><br>

अवपाक
अवपाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೂರ್ಣವಾದ ಪಾಕ /ಅಡ್ಡಾದಿಡ್ಡಿಯಾಗಿ ಬೇಯಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + डुपचष् (पाके) - भावे "घञ्" (३-३-१८)<br><br>अवपाक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೂರ್ಣವಾಗಿ ಬೇಯಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कर्म० "घञ्" (३-३-१९)<br><br>

अवपात
अवपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಬೀಳುವುದು<br><b>निष्पत्तिः - </b>अव + पत्लृ (गतौ) - "घञ्" (३-३-१८)<br><br>अवपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಹಾಕುವಿಕೆ /ಬೀಳಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + पत्लृ (गतौ) + णिच् - "अच्" (३-३-५६)<br><b>प्रयोगाः - </b>"शस्त्रावपाते गर्भस्य पातने चोत्तमो दमः"<br><b>उल्लेखाः - </b>याज्ञ० २-१७७<br><br>अवपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಳ್ಳ /ಗುಳಿ<br><b>निष्पत्तिः - </b>अधि० "घञ्" (३-३-१२१)<br><b>विस्तारः - </b>"श्वभ्रोऽवपातः" - कल्पद्रु०<br><br>अवपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯನ್ನು ಹಿಡಿಯಲು ಸೊಪ್ಪುಗಳಿಂದ ಮುಚ್ಚಲ್ಪಟ್ಟ ಹಳ್ಳ<br><b>प्रयोगाः - </b>"रोधांसि निघ्नन्नवपातमग्नः करीव वन्यः परुषं ररास"<br><b>उल्लेखाः - </b>रघु० १६-७८<br><b>विस्तारः - </b>"अवपातस्तु हस्त्यर्थे गर्ते छन्ने तृणादिना" - वैज० ।<br><br>

अवपातन
अवपातन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೂಕುವುದು /ಕೆಳಕ್ಕೆ ತಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>अव + पत्लृ (गतौ) + णिच् - "ल्युट्" (३-३-११५)<br><br>

अवपात्र
अवपात्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇತರರ ಊಟಕ್ಕೆ ಅನರ್ಹವಾದ ಊಟದ ಪಾತ್ರೆಯುಳ್ಳ ಮ್ಲೇಚ್ಛ /ಚಂಡಾಲ ಮೊದಲಾದವರು<br><br>

अवपात्रित
अवपात्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಾತಿ ಭ್ರಷ್ಟನಾದ /ಪಾಪಕಾರ್ಯಾಚರಣೆಯಿಂದ ಬಂಧುಗಳಿಂದ ಒಂದೇ ಪಾತ್ರೆಯಲ್ಲಿ ಪಾನ ಭೋಜನಾದಿಗಳಿಗೆ ನಿಷೇಧಿಸಲ್ಪಟ್ಟಿರುವ<br><b>निष्पत्तिः - </b>अवपात्र (कृत्यर्थे) + णिच् - "क्तः" (३-२-१०२)<br><br>

अवपाशित
अवपाशित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ಕಟ್ಟಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>अव समन्तात् पाशोऽस्य सञ्जातः<br><br>

अवपीड
अवपीड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒತ್ತುವಿಕೆ<br><br>अवपीड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಮೂಗಿನ ಚಿಕಿತ್ಸೆ<br><b>प्रयोगाः - </b>"प्रतिवर्षोऽवपीडश्च नस्यं प्रशमनं तथा । शिरोविरेचनं चेति नस्तः कर्म च पञ्चधा ॥"<br><br>अवपीड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒತ್ತುವ /ಕೆಳಕ್ಕೆ ಅದುಮುವ<br><b>निष्पत्तिः - </b>अव + पीड (अवगाहने) - "अच्" (३-१-१३४)<br><br>

अवपीडन
अवपीडन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒತ್ತುವಿಕೆ /ಅದುಮುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + पीड (अवगाहने) + णिच् - "ल्युट्" (३-३-११५)<br><br>अवपीडन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೀನು ಬರಿಸುವ ವಸ್ತು<br><br>

अवपीडना
अवपीडना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಡುವಿಕೆ /ಹಿಸುಕುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + पीड (अवगाहने) + णिच् - "युच्" (३-३-१०७)<br><b>प्रयोगाः - </b>"अङ्गावपीडनायां च व्रणशोणितयोस्तथा । समुत्थानव्ययं दाप्यः सर्वदण्डमथापि वा ॥"<br><b>उल्लेखाः - </b>मनु० ८-२८७<br><br>

अवप्लुत
अवप्लुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒದ್ದೆಯಾದ /ಸುತ್ತಲೂ ತೋಯಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + प्लुङ् (गतौ) - "क्तः" (३-२-१०२)<br><br>अवप्लुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಹಾರಿದ /ಕೆಳಕ್ಕೆ ಇಳಿದಿರುವ<br><b>प्रयोगाः - </b>"अवप्लुतो महातेजाः प्राकारं तस्य वेश्मनः"<br><b>उल्लेखाः - </b>रामा०<br><br>

अवबद्ध
अवबद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ಕಟ್ಟಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + बन्ध (बन्धने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"सद्वंशत्वादङ्गसंसङ्गिनीत्वं नीत्वा कामं गौरवेणावबद्धा"<br><b>उल्लेखाः - </b>माघ० १८-१९<br><br>

अवबन्ध
अवबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ಕಟ್ಟುವಿಕೆ /ಎಲ್ಲಾ ಕಡೆಯಲ್ಲಿಯೂ ಬಂಧಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + बन्ध (बन्धने) - भावे "घञ्" (३-३-१८)<br><br>अवबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ನೇತ್ರರೋಗ /ನೋಟದ ಶಕ್ತಿಯನ್ನು ತಡೆಯತಕ್ಕ ಕಣ್ಣಿನ ರೋಗ<br><br>

अवबाहुक
अवबाहुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೋಳುಗಳಲ್ಲಿ ಬರುವ ಸೆಳೆತ /ತೋಳುಗಳಿಗೆ ಬರುವ ಒಂದು ವಿಧ ವಾತರೋಗ<br><b>व्युत्पत्तिः - </b>अवबद्धो बाहुर्येन<br><b>प्रयोगाः - </b>"अंसदेशस्थितो वायुः शोषयित्वांसबन्धनम् । शिरास्वाकुञ्च्य तत्रस्थो जनयत्यवबाहुकम् ॥"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

अवबुद्ध
अवबुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳುವಳಿಕೆಯುಳ್ಳವನು<br><b>निष्पत्तिः - </b>अव + बुध (अवगमने) - "क्तः" (३-२-१८८)<br><br>अवबुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಪಟ್ಟ /ಅರಿಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कर्म० "क्तः" (३-२-१०२)<br><br>

अवबोध
अवबोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನ /ತಿಳುವಳಿಕೆ<br><b>निष्पत्तिः - </b>अव + बुध (अवगमने) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"औत्सुक्यहेतुं विवृणोषि न त्वं तत्त्वावबोधैकफलो न तर्कः"<br><b>उल्लेखाः - </b>माल० ३-१०<br><br>अवबोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಚ್ಚರಿಕೆ /ಜಾಗರಾವಸ್ಥೆ<br><b>प्रयोगाः - </b>"यौ तु स्वप्नावबोधौ तौ भूतानां प्रलयोदयौ"<br><b>उल्लेखाः - </b>कुमा० २-८<br><br>अवबोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತತ್ತ್ವದ ಉಪದೇಶ /ತಿಳುವಳಿಕೆ ಕೊಡುವುದು<br><b>प्रयोगाः - </b>"अवबोधवारि रजसः शमनम्"<br><b>उल्लेखाः - </b>किरा० ६-४१<br><br>

अवबोधक
अवबोधक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>अव + बुध (अवगमने) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>अवबोधयति<br><br>अवबोधक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತುತಿಪಾಠಕ<br><br>अवबोधक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪದೇಶ ಕೊಡುವ ಗುರು /ಉಪಾಧ್ಯಾಯ<br><br>अवबोधक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಸುವ /ಸೂಚಿಸುವ<br><b>प्रयोगाः - </b>"निजपराक्रमावबोधकानि चरितानि"<br><b>उल्लेखाः - </b>दशकु०<br><br>अवबोधक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಚ್ಚರಗೊಳಿಸುವ /ನಿದ್ದೆಯಿಂದೆಬ್ಬಿಸುವ<br><br>अवबोधक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪದೇಶಕ /ತಿಳುವಳಿಕೆ ಕೊಡುವ<br><br>

अवबोधन
अवबोधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿಳಿಸುವಿಕೆ /ಜ್ಞಾಪಕ ಕೊಡುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + बुध (अवगमने) + णिच् - भावे "ल्युट्" (३-३-११५)<br><br>

अवभर्जित
अवभर्जित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುರಿಯಲ್ಪಟ್ಟ<br><br>अवभर्जित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + भ्रस्ज (पाके) - "क्तः" (३-२-१०२)<br><br>

अवभाषण
अवभाषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾತಾಡುವುದು /ಹೇಳುವುದು<br><b>निष्पत्तिः - </b>अव +भाष (व्यक्तायां वाचि) - "ल्युट्" (३-३-११५०<br><br>

अवभास
अवभास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನ /ತಿಳುವಳಿಕೆ<br><b>निष्पत्तिः - </b>अव + भासृ (दीप्तौ) - भावे "घञ्" (३-३-१८)<br><br>अवभास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶ /ಬೆಳಕು<br><br>अवभास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಕ್ಷಾತ್ಕಾರ<br><b>प्रयोगाः - </b>"येनास्य तत्त्वेषु कृतावभासे समुन्मिमीलेव चिराय चक्षुः"<br><b>उल्लेखाः - </b>किरा० ३-२६<br><br>अवभास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಿಥ್ಯಾಜ್ಞಾನ /ತಪ್ಪು ತಿಳುವಳಿಕೆ<br><b>प्रयोगाः - </b>"शुक्तिकाया रजतवदवभासः"<br><br>

अवभासक
अवभासक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಗತ್ತೆಲ್ಲವನ್ನೂ ಪ್ರಕಾಶಗೊಳಿಸುವ ಬ್ರಹ್ಮಜ್ಞಾನ /ಪರಮಾತ್ಮ<br><b>निष्पत्तिः - </b>अव + भासृ (दीप्तौ) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>अवभासयति<br><b>प्रयोगाः - </b>"यदादित्यगतं तेजो जगद्भासयतेऽखिलम् । यच्चन्द्रमसि यच्चाग्नौ तत्तेजो विद्धि मामकम् ॥"<br><b>उल्लेखाः - </b>गीता० १५-१२<br><br>अवभासक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸುವ<br><br>

अवभासित
अवभासित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + भासृ (दीप्तौ) - "क्तः" (३-२-१०२)<br><br>

अवभासिन्
अवभासिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಿಸುವ /ಹೊಳೆಯುವ<br><b>निष्पत्तिः - </b>अव + भासृ (दीप्तौ) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अवभासते<br><br>

अवभुग्न
अवभुग्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿರುವ /ಕುಗ್ಗಿರುವ<br><b>निष्पत्तिः - </b>अव + भुजो (कौटिल्ये) - "क्तः" (३-४-७२) । तस्य नत्वम् (८-२-४५)<br><b>प्रयोगाः - </b>"तीरतरलजलराशिजलामवभुग्नभोगिफणमण्दलां भुवम्"<br><b>उल्लेखाः - </b>माघ० १५-५४<br><br>

अवभृथ
अवभृथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಖ್ಯಯಾಗದ ಕೊನೆಯಲ್ಲಿ ಮಾಡುವ ಇಷ್ಟಿ<br><b>निष्पत्तिः - </b>अव +भृञ् (भरणे) - "क्थन्" (उ० २-३)<br><b>व्युत्पत्तिः - </b>अवभ्रियतेऽनेन<br><br>अवभृथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವಭೃಥ ಸ್ನಾನ /ಯಾಗದ ಕೊನೆಯಲ್ಲಿ ಮಾಡುವ ಸ್ನಾನ<br><b>प्रयोगाः - </b>"भुवं कोष्णेन कुण्डोध्नी मेध्येनावभृथादपि"<br><b>उल्लेखाः - </b>रघु० १-८४<br><br>

अवभ्रट
अवभ्रट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿದ ಮೂಗುಳ್ಳ<br><b>निष्पत्तिः - </b>"भ्रटच्" (५-२-३१) । "अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>अवनतं नासिकायाः अवभ्रटम् । तद्योगन्नासिकाप्यवभ्रटा । सास्यास्ति ।<br><b>विस्तारः - </b>"अवटीटोऽवनाटश्चावभ्रटो नतनासिके" - अम० ।<br><br>

अवम
अवम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಿತೃಗಳ ಒಂದು ಗುಂಪು<br><b>निष्पत्तिः - </b>अव (रक्षणादौ) - "अमः" (उ० ५-५४)<br><br>अवम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><br>अवम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಮ ದಿನ /ಕ್ಷಯ ಹೊಂದಿದ ತಿಥಿ /ಮೂರು ತಿಥಿಗಳು ಸೇರುವ ಒಂದು ದಿನ<br><br>अवम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀಚ /ಅಧಮ<br><br>अवम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳದರ್ಜೆಯವನು<br><br>अवम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪಾತ್ಮ<br><br>

अवमत
अवमत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ<br><br>अवमत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಮಾನಗೊಳಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + मन (ज्ञाने) - "क्तः" (३-२-१०२)<br><br>

अवमतान्तर
अवमतान्तर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದಿಸಿದ ಆನೆ /ಅಡಗಿಸಲು ಸಾಧ್ಯವಿಲ್ಲದ ಆನೆ<br><b>व्युत्पत्तिः - </b>अवमतोऽङ्कुशो येन<br><br>अवमतान्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವೇಚ್ಛಾಪ್ರವೃತ್ತಿಯುಳ್ಳವನು<br><br>

अवमति
अवमति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಮಾನ<br><b>निष्पत्तिः - </b>अव + मन (ज्ञाने) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"अवमतिमनुकम्पे मन्दचित्तेषु विन्दन्"<br><b>उल्लेखाः - </b>दयाश०<br><br>अवमति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಾದರ /ತಿರಸ್ಕಾರ<br><br>

अवमतिथि
अवमतिथि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ತಿಥಿಯು ಲುಪ್ತವಾಗುವಂತೆ ಮೂರು ತಿಥಿಗಳ ಸಂಬಂಧವಿರುವ ಒಂದು ದಿನ<br><b>प्रयोगाः - </b>"स्युः तिस्रस्तिथयो वारे एकस्मिन्नवमा तिथिः"<br><br>

अवमदिन
अवमदिन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂರು ತಿಥಿಗಳ ಸಂಬಂಧವಿರುವ ಒಂದು ದಿನ /ಎರಡು ತಿಥಿಗಳ ಕೊನೆಯ ಭಾಗದ ಸಂಬಂಧವುಳ್ಳ ದಿನ<br><b>प्रयोगाः - </b>"तिथ्यन्तद्वयमेको दिनवारो यत्र तद्भवत्यवमदिनम्"<br><br>

अवमन्तव्य
अवमन्तव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರಕ್ಕೆ ಅರ್ಹನಾದ<br><br>अवमन्तव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಮಾನಗೊಳಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अव + मन (ज्ञाने) - "तव्यः" (३-१-९६)<br><b>प्रयोगाः - </b>"बालोऽपि नावमन्तव्यो मनुष्य इति भूमिपः"<br><b>उल्लेखाः - </b>मनु० ७-८<br><br>

अवमन्तृ
अवमन्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಮಾನಗೊಳಿಸುವವನು<br><br>अवमन्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸುವವನು /ಅನಾದರದಿಂದ ಕಾಣುವವನು<br><b>निष्पत्तिः - </b>अव + मन (ज्ञाने) - "तृच्" (३-१-१३३)<br><br>

अवमन्त्री
अवमन्त्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अवमन्तृ ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अवमर्द
अवमर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೀಡೆ /ಬಾಧೆ /ನೋವು<br><br>अवमर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ್ಯಾಂಗದಲ್ಲಿ ನಡೆಸಬೇಕಾದ ಉಪಾಯ /ಧಾಳಿಯಿಂದ ಶತ್ರುವನ್ನು ನಾಶಪಡಿಸುವುದು<br><b>निष्पत्तिः - </b>अव + मृद (क्षोदे) - "घञ्" (३-३-१८०<br><br>

अवमर्दन
अवमर्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒತ್ತುವುದು /ಹಿಸುಕುವುದು<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>अवमर्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸುವುದು<br><br>अवमर्दन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರ್ದಿಸುವ /ಹಿಸುಕುವ<br><b>निष्पत्तिः - </b>अव + मृद (क्षोदे) - "ल्युः" (३-१-१३४)<br><br>

अवमर्श
अवमर्श<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಟಕದ ಪಂಚ ಸಂಧಿಗಳಲ್ಲೊಂದು<br><br>अवमर्श<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಪರ್ಶ /ಸಂಬಂಧ /ಸಂಪರ್ಕ<br><br>अवमर्श<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಲೋಚನೆ<br><b>निष्पत्तिः - </b>अव + मृश (आमर्शने) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"मुखं प्रतिमुखं गर्भः सावमर्शोपसंहृतिः"<br><br>

अवमान
अवमान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಮಾನ /ಅಗೌರವ<br><br>अवमान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರ<br><b>निष्पत्तिः - </b>अव + मन (ज्ञाने) - "घञ्"(३-३-१८)<br><b>प्रयोगाः - </b>"अथावमानेन पितुः प्रयुक्ता दक्षस्य कन्या भवपूर्वपत्नी"<br><b>उल्लेखाः - </b>कुमा० १-२१<br><br>

अवमानन
अवमानन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಮಾನಗೊಳಿಸುವುದು /ಅಗೌರವಿಸುವುದು<br><b>निष्पत्तिः - </b>अव + मन (ज्ञाने) + णिच् - भावे "ल्युट्" (३-३-११५)<br><br>अवमानन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸುವುದು /ಅನಾದರದಿಂದ ಕಾಣುವುದು<br><b>प्रयोगाः - </b>"शौरिरवनिपतिभिर्निखिलैरवमाननार्थमिह किं निमन्त्रितैः"<br><b>उल्लेखाः - </b>माघ० १५-१८<br><br>

अवमानना
अवमानना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अवमानन ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अव + मन (ज्ञाने) + णिच् - "युच्" (३-३-१०७)<br><br>

अवमाननीय
अवमाननीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಡುವ<br><br>अवमाननीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಮಾನಗೊಳಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अव + मन (ज्ञाने) + णिच् - "अनीयर्" (३-१-९६)<br><br>

अवमानित
अवमानित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಮಾನಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>अवमानित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + मन (ज्ञाने) + णिच् - "क्तः" (३-२-१०२)<br><br>

अवमान्य
अवमान्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಡುವ<br><br>अवमान्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಮಾನಗೊಳಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अव + मन (ज्ञाने) - "ण्यत्" (३-१-१२४)<br><b>प्रयोगाः - </b>"नावमान्यो भवद्भिश्च हरिर्धीरपराक्रमः"<br><b>उल्लेखाः - </b>रामा०<br><br>

अवमार्जन
अवमार्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಳೆಯುವುದು /ಶುದ್ಧಿ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>अव + मृजूष् (शुद्धौ) + णिच् - "ल्युट्" (३-३-११५)<br><br>अवमार्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಳೆಯುವ /ನೀರು ಗುಡಿಸುವ ಪೊರಕೆ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>अव + मृजूष् (शुद्धौ) + णिच् - कर० "ल्युट्" (३-३-११७)<br><br>

अवमार्जना
अवमार्जना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अव + मृजूष् (शुद्धौ) + णिच् -भावे "युच्" (३-३-१०७)<br><br>

अवमूर्धन्
अवमूर्धन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿದ ತಲೆಯುಳ್ಳ /ತಲೆಯನ್ನು ತಗ್ಗಿಸಿಕೊಂಡಿರುವ<br><b>व्युत्पत्तिः - </b>अवनतो मूर्धा यस्य<br><br>

अवमूर्धनीय
अवमूर्धनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಗುಚಿಕೊಂಡು ಮಲಗುವವನು /ಕೆಳಮುಖವಾಗಿ ಮಲಗುವವನು<br><b>निष्पत्तिः - </b>शीङ् (स्वप्ने) - "अच्" (वा० ३-२-१५)<br><b>व्युत्पत्तिः - </b>अवमूर्धा सन् शेते<br><br>अवमूर्धनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಮುಖವಾಗಿ ಮಲಗುವ ಸ್ವಭಾವದ ಮನುಷ್ಯ<br><b>प्रयोगाः - </b>"उत्तानशया देवा अवमूर्धशया मनुष्याः"<br><br>

अवमोचन
अवमोचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಧನದಿಂದ ಬಿಡಿಸುವುದು<br><b>निष्पत्तिः - </b>अव + मुच्लृ (मोक्षणे) + णिच् - "ल्युट्" (३-३-११५)<br><br>

अवमोटन
अवमोटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರೆಯುವುದು /ಬೀಸುವುದು<br><br>अवमोटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರ್ದಿಸುವುದು /ಜಜ್ಜುವುದು<br><b>निष्पत्तिः - </b>अव + मुट (सञ्चूर्णने) - भावे "ल्युट्" (३-३-११५)<br><br>

अवयव
अवयव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶರೀರದ ಒಂದುಅಂಗ /ಕೈ ಕಾಲು ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>अव + यु (मिश्रणेऽमिश्रणे) - "अच्" (३-१-१३४) । "अप्" (३-३-५७) वा ।<br><b>व्युत्पत्तिः - </b>अव यौति<br><b>प्रयोगाः - </b>"मुखावयवलूनां तां नैरृता यत्पुरो दधुः"<br><b>उल्लेखाः - </b>रघु० १२-४३<br><br>अवयव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಭಾಗ /ವಸ್ತುವಿನ ಒಂದು ಭಾಗ<br><br>अवयव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾರ್ಕಿಕರ ನ್ಯಾಯಾಂಗ<br><br>अवयव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಾಯ /ಸಾಧನ /ಉಪಕರಣ<br><br>अवयव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಜ್ಞಾದಿ ೫ ಅವಯವಗಳ ಸ್ವರೂಪವನ್ನು ಪ್ರತಿಪಾದಿಸುವ ಒಂದು ಗ್ರಂಥ<br><br>

अवयविन्
अवयविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಜ್ಞಾದಿ ಪಂಚಾವಯವಗಳನ್ನೊಳಗೊಂಡ ತಾರ್ಕಿಕರ ವಾದ<br><br>अवयविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಸಂಪೂರ್ಣ ವಸ್ತು /ನಾನಾಭಾಗಗಳನ್ನೊಳಗೊಂಡ ಒಂದು ಪೂರ್ಣವಸ್ತು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>अवयवाः सन्त्यस्य<br><br>

अवर
अवर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನಂತರದ ಕಾಲ /ಮುಂದಿನ ಕಾಲ<br><br>अवर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಭಾಗದ ದೇಶ<br><b>निष्पत्तिः - </b>रा (दाने) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>अवराति<br><br>अवर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ತೊಡೆಯ ಹಿಂಭಾಗ<br><br>अवर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊನೆಯದಾದ /ಕಡೆಯದಾದ<br><br>अवर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಮವಾದ /ನಿಕೃಷ್ಟವಾದ<br><b>व्युत्पत्तिः - </b>न वरः<br><b>प्रयोगाः - </b>"दूरेण ह्यवरं कर्म बुद्धियोगात् धनञ्जय"<br><b>उल्लेखाः - </b>गीता० २-४९<br><br>अवर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಭಾಗದಲ್ಲಿರುವ<br><br>अवर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿರಿದಾದ /ಚಿಕ್ಕದಾದ<br><br>अवर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಶ್ರೇಷ್ಠವಾದ /ಉತ್ತಮವಾದ<br><br>

अवरज
अवरज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಿಯ ಸಹೋದರ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९७)<br><b>व्युत्पत्तिः - </b>अवरस्मिन् काले जायते<br><b>प्रयोगाः - </b>"सौमित्रिणा सावरजेन मन्दमाधूतबालव्यजनो रथस्थः"<br><b>उल्लेखाः - </b>रघु० १४-११<br><br>अवरज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣಾದಿ ನಾಲ್ಕು ವರ್ಣಗಳಲ್ಲಿ ಕೊನೆಯ ವರ್ಣದವನು<br><br>अवरज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಂತರದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>प्रयोगाः - </b>"आत्मभूरवरजाखिलप्रजः स्वर्पतेरवरजत्वमाययौ"<br><b>उल्लेखाः - </b>माघ० १४-७४<br><br>

अवरजा
अवरजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಿಯ ಸಹೋದರಿ<br><b>प्रयोगाः - </b>"रावणावरजा तत्र राघवं मदनातुरा"<br><b>उल्लेखाः - </b>रघु० १२-३२<br><br>अवरजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶೂದ್ರ ಹೆಂಗಸು<br><br>

अवरत
अवरत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಶ್ರಾಂತಿ ಪಡೆದ /ವಿರಾಮ ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>अव + रमु (क्रीडायाम्) - "क्तः" (३-४-७२)<br><br>

अवरतस्
अवरतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹಿಂಭಾಗದಲ್ಲಿ<br><br>अवरतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನಂತರದಲ್ಲಿ<br><br>अवरतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೆಳಗೆ<br><b>निष्पत्तिः - </b>अवर - "अतसुच्" (५-३-२९)<br><br>

अवरति
अवरति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶ್ರಾಂತಿ /ವಿರಾಮ<br><br>अवरति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿವೃತ್ತಿ /ನಿಲ್ಲಿಸುವಿಕೆ<br><br>अवरति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಜಾರು<br><b>निष्पत्तिः - </b>अव + रमु (क्रीडायाम्) - "क्तिन्" (३-३-९४)<br><br>

अवरचूर्ण
अवरचूर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನೆಯ ವರ್ಣದವನು /ಶೂದ್ರ<br><br>अवरचूर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನೆಯ ವರ್ಣ<br><br>

अवरवर्णज
अवरवर्णज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನೆಯ ವರ್ಣದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९७)<br><b>व्युत्पत्तिः - </b>अवरवर्णे जायते<br><br>

अवरव्रत
अवरव्रत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>अवरव्रत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಕವೃಕ್ಷ /ಎಕ್ಕದ ಗಿಡ<br><br>अवरव्रत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಮ /ನೀಚ<br><b>व्युत्पत्तिः - </b>अवरं अधमं व्रतमस्य<br><br>

अवरशैल
अवरशैल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಶ್ಚಿಮ ದಿಕ್ಕಿನಲ್ಲಿರುವ ಪರ್ವತ<br><br>

अवरतस्तात्
अवरतस्तात्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹಿಂಭಾಗದಲ್ಲಿ<br><br>अवरतस्तात्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೆಳಭಾಗದಲ್ಲಿ<br><br>अवरतस्तात्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನಂತರದಲ್ಲಿ<br><br>अवरतस्तात्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮುಂದಿನ ಕಾಲದಲ್ಲಿ<br><br>अवरतस्तात्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹಿಂದಿನ ದೇಶದಲ್ಲಿ<br><br>अवरतस्तात्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹಿಂದಿನ ದಿಕ್ಕಿನಲ್ಲಿ<br><br>

अवरार्ध
अवरार्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನೆಯ ಅರ್ಧಭಾಗ<br><br>अवरार्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಕಡಿಮೆ ಭಾಗ<br><br>अवरार्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶರೀರದ ಹಿಂಭಾಗ<br><br>

अवरार्ध्य
अवरार्ध्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳ ಭಾಗದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"यत्" (४-३-५५)<br><b>व्युत्पत्तिः - </b>अवरार्धे भवः<br><br>अवरार्ध्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊನೆಯ ಅರ್ಧಭಾಗದಲ್ಲಿ ಉಂಟಾದ<br><br>

अवरीण
अवरीण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ /ಧಿಕ್ಕರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + रीङ् (स्रवणे) - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>अवरीयते स्म<br><b>विस्तारः - </b>"अवरीणो धिक्कृतश्च" - अम० ।<br><br>

अवरीयस्
अवरीयस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ನಿಕೃಷ್ಟವಾದ<br><b>निष्पत्तिः - </b>अव + रुज (हिंसायाम्) - "क्तः" (३-२-१०२)<br><br>

अवरीयसी
अवरीयसी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ನಿಕೃಷ್ಟವಾದ<br><b>निष्पत्तिः - </b>अव + रुजो (भङ्गे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अवरुग्णतुङ्गसुरदारुतरौ"<br><b>उल्लेखाः - </b>किरा० ६-५<br><br>

अवरुग्ण
अवरुग्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೋಗದಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>अव + रुधिर् (आवरणे) - "क्तः" (३-२-१०२)<br><br>अवरुग्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುರಿದಿರುವ /ಒಡೆದು ಹೋಗಿರುವ<br><b>प्रयोगाः - </b>"अस्ति कश्चिद्राजसूनुरवरुद्धश्चरन्"<br><b>उल्लेखाः - </b>दशकु०<br><br>

अवरुद्ध
अवरुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಯಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"तासां चेदवरुद्धानां चरन्तीनां मिथो वने । यामुत्ल्पुत्य वृको हन्यान्न पालस्तत्र किल्बिषी ॥"<br><b>उल्लेखाः - </b>मनु० ८-२३६<br><br>अवरुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಹಸ್ಯವಾದ /ಇತರರಿಗೆ ತಿಳಿಯದಂತಿರುವ<br><br>अवरुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಹಸ್ಯವಾಗಿ ರಕ್ಷಿಸಲ್ಪಟ್ಟ /ಯಾರಿಗೂ ತಿಳಿಯದಂತೆ ಗೋಪ್ಯವಾಗಿಡಲ್ಪಟ್ಟ<br><br>अवरुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಂಧಿಸಲ್ಪಟ್ಟ /ತಡೆದಿಡಲ್ಪಟ್ಟ<br><br>अवरुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಿಸಲ್ಪಟ್ಟ<br><br>

अवरुद्धि
अवरुद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಡೆ /ಅಡ್ಡಿ<br><br>अवरुद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುತ್ತಿಗೆ /ಆಕ್ರಮಣ<br><b>निष्पत्तिः - </b>अव + रुधिर् (आवरणे) -"क्तिन्" (३-३-९४)<br><br>

अवरूढ
अवरूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಇಳಿಸಲ್ಪಟ್ಟ<br><br>अवरूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಇಳಿದಿರುವ<br><b>निष्पत्तिः - </b>अव + रुह - कर्त० "क्तः" (३-४-७२)<br><br>अवरूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೀಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + रुह (बीजजन्मादौ० - "क्तः" (३-२-१०२)<br><br>

अवरोध
अवरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತಃಪುರ /ರಾಣಿವಾಸ<br><b>निष्पत्तिः - </b>अव + रुधिर् (आवरणे) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>अवरुध्यतेऽत्र<br><b>प्रयोगाः - </b>"तेनावरोधप्रमदासखेन विगाहमानेन सरिद्वरां ताम्"<br><br>अवरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತಃಪುರದ ಹೆಂಗಸು /ಮಹಿಷಿ /ರಾಜನ ಪತ್ನಿ<br><b>निष्पत्तिः - </b>अव + रुधिर् (आवरणे) - कर्म० "घञ्" (३-३-१९)<br><b>प्रयोगाः - </b>"काकुत्स्थश्चिरविरहोत्सुकावरोधान् राजन्यान् स्वपुरनिवृत्तयेऽनुमेने"<br><b>उल्लेखाः - </b>रघु० ४-८७<br><br>अवरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಡೆ /ಅಡ್ಡಿ /ಪ್ರತಿಬಂಧಕ<br><b>निष्पत्तिः - </b>अव + रुधिर् (आवरणे) - भावे "घञ्" (३-३-१८)<br><br>अवरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುತ್ತಿಗೆ /ಆಕ್ರಮಣ<br><br>अवरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರೆಯಾಗುವಿಕೆ<br><b>विस्तारः - </b>"अवरोधस्तिरोधने राजदारेषु तद्गृहे" - मेदि० ।<br><br>अवरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜದ ಅರಮನೆ<br><br>अवरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಳ್ಳ /ತಗ್ಗು ಪ್ರದೇಶ<br><b>विस्तारः - </b>"अवरोधस्तु नृपौकसि । शुद्धान्ते च तिरोधाने गर्तादौ रोधनेऽपि च" - हेम० । "अवरोधो राजगृहे शुद्धान्तेऽपुअवरोधने" - नानार्थर० ।<br><br>अवरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಸೆರೆ /ಖೈದು<br><br>अवरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾವಲುಗಾರ<br><br>अवरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಚ್ಛಾದನ /ಹೊದಿಕೆ<br><br>अवरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಲಿ /ಮುಳ್ಳಿನ ಆವರಣ<br><b>प्रयोगाः - </b>"कण्ठावसक्तमृदुबाहुलतास्तुरङ्गाद्राजावरोधनवधूरवतारयन्तः"<br><b>उल्लेखाः - </b>माघ० ५-१८<br><br>

अवरोधन
अवरोधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>अवरोध ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अव + रुधिर् (आवरणे) - भावे "ल्युट्" (३-३-११५)<br><br>

अवरोधक
अवरोधक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾವಲುಗಾರ<br><br>अवरोधक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಲಿ /ಮುಳ್ಳಿನ ಆವರಣ<br><b>निष्पत्तिः - </b>अव + रुधिर् (आवरणे) - "ण्वुल्" (३-१-१३३)<br><br>अवरोधक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಗಟ್ಟುವ /ಅಡ್ಡಿ ಮಾಡುವ<br><br>अवरोधक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುತ್ತಿಗೆ ಹಾಕುವ<br><b>प्रयोगाः - </b>"सुधन्वा वीर्यवान् राजा मिथिलामवरोधकः"<br><b>उल्लेखाः - </b>रामा०<br><br>

अवरोधिक
अवरोधिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಚುಕಿ /ಅಂತಃಪುರದ ರಕ್ಷಕ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-६९)<br><b>व्युत्पत्तिः - </b>अवरोधे नियुक्तः<br><br>

अवरोधिका
अवरोधिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತಃಪುರದ ರಾಜಪತ್ನಿ<br><b>व्युत्पत्तिः - </b>अवरोधो वासत्वेनास्त्यस्याः<br><b>प्रयोगाः - </b>"वल्गद्गरीयःस्तनकम्प्रकञ्चुकं ययुस्तुरङ्गाधिरुहोऽवरोधिकाः"<br><b>उल्लेखाः - </b>माघ० १२-२०<br><br>

अवरोधिन्
अवरोधिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಯುವ /ಅಡ್ಡಿಪಡಿಸುವ<br><br>अवरोधिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುತ್ತಿಗೆ ಹಾಕುವ /ಆಕ್ರಮಿಸುವ<br><b>निष्पत्तिः - </b>अव + रुधिर् (आवरणे) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अवरुणद्धि<br><br>

अवरोधिनी
अवरोधिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುತ್ತಿಗೆ ಹಾಕುವ /ಆಕ್ರಮಿಸುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अवरोपण
अवरोपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೀಳುವುದು /ಕಿತ್ತು ಹಾಕುವುದು<br><br>अवरोपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಇಳಿಸುವುದು<br><b>निष्पत्तिः - </b>अव + रुह (बीजजन्मादौ) + णिच् + पुक् - "ल्युट्" (३-३-११५)<br><br>

अवरोपित
अवरोपित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಇಳಿಸಲ್ಪಟ್ಟ<br><br>अवरोपित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿತ್ತು ಹಾಕಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + रुह (बीजजन्मादौ) + णिच् + पुक् - "क्तः" (३-२-१०२)<br><br>

अवरोह
अवरोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಳಿಕೆ /ಇಳಿಯುವುದು<br><b>निष्पत्तिः - </b>अव + रुह (बीजजन्मादौ) - "घञ्" (३-३-१८)<br><br>अवरोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆರೋಹಣ /ಮೇಲಕ್ಕೇರುವಿಕೆ<br><br>अवरोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಗ<br><b>व्युत्पत्तिः - </b>अवरोहत्यस्मात्<br><b>विस्तारः - </b>"स्वर्लोको देवलोकः स्यादवरोहः फलोदयः" - त्रिकाण्ड० ।<br><br>अवरोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲತೆ /ಬುಡದಿಂದ ಮರದ ಮೇಲಿನವರೆಗೂ ಹಬ್ಬಿದ ಬಳ್ಳಿ<br><b>विस्तारः - </b>"अवरोहोऽवतरणेऽप्यारोहे च लतोद्गमे" - मेदि० ।<br><br>अवरोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರ್ದ ರೆಂಬೆಗಳಿಂದ ಭೂಮಿಯವರೆಗೂ ಇಳಿಯುವ ಬಿಳಲು<br><b>प्रयोगाः - </b>"अवरोहशताकीर्णं वटमासाद्य तस्थतुः"<br><b>उल्लेखाः - </b>रामा०<br><br>अवरोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಗೀತದ ಅವರೋಹಣ<br><b>निष्पत्तिः - </b>अव + रुह (बीजजन्मादौ) - "घः" (३-३-११८)<br><br>

अवरोहण
अवरोहण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಳಿಯುವಿಕೆ /ಮೇಲಿನಿಂದ ಕೆಳಕ್ಕೆ ಬರುವಿಕೆ<br><br>

अवरुहशाख
अवरुहशाख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಟವೃಕ್ಷ /ಆಲದ ಮರ<br><br>

अवरोहशाखिन्
अवरोहशाखिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಟವೃಕ್ಷ /ಆಲದ ಮರ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>अवरोहाः अधोगच्छन्त्यः शाखाः सन्त्यस्य<br><br>

अवरोहिका
अवरोहिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಗಂಧಾಲತೆ<br><b>निष्पत्तिः - </b>अव + रुह (बीजजन्मादौ) - "ण्वुल्" (३-१-१३३) । "टाप्" (४-१-४) । अत इत्वम् (७-३-४४)<br><b>व्युत्पत्तिः - </b>अवरोहति अधोगच्छति<br><br>

अवरोहिन्
अवरोहिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಟವೃಕ್ಷ /ಆಲದ ಮರ<br><b>निष्पत्तिः - </b>अव + रुह (बीजजन्मादौ) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अवरोहति<br><br>अवरोहिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಇಳಿಯುವ<br><br>

अवरोहिणी
अवरोहिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अवरोहिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अवर्ग
अवर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಕಾರಕ್ಕೆ ಸಮನಾದ ಸ್ವರವರ್ಣಗಳ ಗುಂಪು<br><br>अवर्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೂಹವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति वर्गः समूहो यत्र<br><br>

अवर्गीय
अवर्गीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವರ್ಗೀಯ ವ್ಯಂಜನ<br><br>

अवर्ण
अवर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹ್ರಸ್ವ ದೀರ್ಘ ಪ್ಲುತಮೊದಲಾದ ೧೮ ಭೇದಗಳುಳ್ಳ ಅವರ್ಣ<br><b>विस्तारः - </b>"अ इत्यष्टादशानां सञ्ज्ञा" - सि० कौ० ।<br><br>अवर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪವಾದ /ಅಪಕೀರ್ತಿ<br><b>निष्पत्तिः - </b>वर्ण (वर्णने) - "घञ्" (३-३-१८) । विरोधे न० त० ।<br><b>व्युत्पत्तिः - </b>वर्ण्यते इति वर्णः स्तुतिः । न वर्णः ।<br><b>प्रयोगाः - </b>"सोढुं न तत्पूर्णमवर्णमीशे आलानिकं स्थाणुमिव द्विपेन्द्रः"<br><b>उल्लेखाः - </b>रघु० १४-३८<br><br>अवर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ಬೈಗಳು<br><b>प्रयोगाः - </b>"न चावदद्भर्तुरवर्णमार्या निराकरिष्णोर्वृजिनादृतेऽपि"<br><b>उल्लेखाः - </b>रघु० १४-५७<br><br>

अवर्तन
अवर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸತ್ತೆ /ಅಭಾವ /ಇಲ್ಲದಿರುವಿಕೆ<br><br>अवर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜೀವನೋಪಾಯವಿಲ್ಲದಿರುವಿಕೆ<br><br>अवर्तन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೀವನೋಪಾಯವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न वर्तनं यस्य<br><br>

अवर्तमान
अवर्तमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಲ್ಲದಿರುವ<br><br>अवर्तमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂದಿನ ಕಾಲದ<br><br>अवर्तमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದಿನ ಕಾಲದ<br><br>

अवलक्ष
अवलक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳುಪು<br><b>निष्पत्तिः - </b>अव + लक्ष (दर्शनाकाङ्क्षयोः) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>अवलक्ष्यते<br><br>अवलक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಳುಪಾದ /ಬಿಳಿ ಬಣ್ಣದ<br><br>

अवलक्षण
अवलक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಲಕ್ಷಣ /ಕೆಟ್ಟ ಚಿಹ್ನೆ<br><br>अवलक्षण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಲಕ್ಷಣವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अव निकृष्टं लक्षणं यस्य<br><br>

अवलग्न
अवलग्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹದ ಮಧ್ಯಭಾಗ /ನಡುವು /ಸೊಂಟ<br><b>निष्पत्तिः - </b>लगे (सङ्गे) - "क्तः" (७-२-१८)<br><b>व्युत्पत्तिः - </b>अवकृष्टं लग्नम्<br><br>अवलग्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧಿಸಿರುವ /ಸೇರಿಕೊಮ್ಡಿರುವ<br><b>प्रयोगाः - </b>"विपुलतरनिरन्तरावलग्नस्तनपिहितप्रियवक्षसा ललम्बे"<br><b>उल्लेखाः - </b>माघ० ७-७१<br><br>

अवलम्ब
अवलम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ /ಸಹಾಯ<br><b>निष्पत्तिः - </b>अव + लबि (अवस्रंसने) - "घञ्" (३-३-१८)<br><br>अवलम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಹಾಯಪಡೆಯುವಿಕೆ /ಆಶ್ರಯ ಹೊಂದುವಿಕೆ<br><b>प्रयोगाः - </b>"तस्य पाण्डुवदनाल्पभूषणा सावलम्बगमना मृदुस्वना"<br><b>उल्लेखाः - </b>रघु० १९-५०<br><br>अवलम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಊರುಗೋಲು /ಒತ್ತುಗಂಬ<br><b>निष्पत्तिः - </b>कर० "घञ्" (३-३-१२१)<br><br>अवलम्ब<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೋಲಾಡುವ /ತೂಗಾಡುವ<br><br>

अवलम्बन
अवलम्बन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ /ಒತ್ತಾಸೆ<br><b>निष्पत्तिः - </b>अव + लबि (अवस्रंसने) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"अवलम्बनाय दिनभर्तुरभून्न पतिष्यतः करसहस्रमपि"<br><b>उल्लेखाः - </b>माघ० ९-६<br><br>अवलम्बन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಊರುಗೋಲು /ಒತ್ತುಗಂಬ<br><b>निष्पत्तिः - </b>कर० "ल्युट्" (३-३-११७)<br><br>अवलम्बन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬರನ್ನು ಸೇರುವಿಕೆ /ಆಶ್ರಯಪಡೆಯುವಿಕೆ<br><b>प्रयोगाः - </b>"इतरपक्षावलम्बनद्वारेण"<br><b>उल्लेखाः - </b>कादं०<br><br>

अवलम्बित
अवलम्बित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अवलम्बितैलविलपाणिपल्लवः श्रयति स्म मेघमिव मेघवाहनः"<br><b>उल्लेखाः - </b>माघ० १३-१८<br><br>अवलम्बित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೂಗಾಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + लबि (अवस्रंसने) - "क्तः" (३-२-१०२)<br><br>अवलम्बित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಇಳಿದಿರುವ /ಕೆಳಕ್ಕೆ ಬಂದಿರುವ<br><b>निष्पत्तिः - </b>अव + लबि (अवस्रंसने) - कर्त० "क्तः" (३-४-७२)<br><br>अवलम्बित<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಶೀಘ್ರವಾಗಿ /ಜಾಗ್ರತೆಯಾಗಿ<br><br>

अवलम्बिन्
अवलम्बिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ ಹೊಂದಿದ /ಸಹಾಯ ಪಡೆದಿರುವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>अवलम्बोस्यास्ति<br><br>अवलम्बिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ ಕೊಟ್ಟಿರುವ /ಆಸರೆಯನ್ನಿತ್ತಿರುವ<br><b>निष्पत्तिः - </b>अव + लबि (अवस्रंसने) - "णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"तामेकतस्तव बिभर्ति गुरुर्विनिद्रस्तस्या भवानपरधुर्यपदावलम्बी"<br><b>उल्लेखाः - </b>रघु० ५-६६<br><br>अवलम्बिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೂಗಾಡುವ /ಜೋಲಾಡುವ<br><b>प्रयोगाः - </b>"अथ धूमाभिताम्राक्षं वृक्षशाखावलम्बिनम्"<br><b>उल्लेखाः - </b>रघु० १५-४९<br><br>

अवलिप्त
अवलिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗರ್ವವುಳ್ಳ /ಅಹಂಕಾರವುಳ್ಳ<br><b>निष्पत्तिः - </b>अव + लिप (उपदेहे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"केनान्येनावलिप्ता नव नवतिशतद्रव्यकोटीश्वरास्ते"<br><b>उल्लेखाः - </b>मुद्रा० ३-२७<br><br>अवलिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲೇಪನ ಮಾಡಲ್ಪಟ್ಟ /ಬಳಿಯಲ್ಪಟ್ಟ<br><br>अवलिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ಬಳಿಯಲ್ಪಟ್ಟ<br><br>

अवलीढ
अवलीढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿನ್ನಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + लिह (आस्वादने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"दर्भैरर्धावलीढैः श्रमविवृतमुखभ्रंशिभिः कीर्णवर्त्मा पश्योदग्रप्लुतत्वाद्वियति बहुतरं स्तोकमुर्व्यां प्रयाति"<br><b>उल्लेखाः - </b>शाकु० १-७<br><br>अवलीढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರುಚಿ ನೋಡಲ್ಪಟ್ಟ<br><br>अवलीढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೆಕ್ಕಲ್ಪಟ್ಟ<br><br>अवलीढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ವ್ಯಾಪಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अवलीढसनाभिरश्वसेनः प्रसभं खाण्डवजातवेदसा वा"<br><b>उल्लेखाः - </b>किरा० १३-११<br><br>

अवलुञ्चन
अवलुञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಛೇದನ /ಕತ್ತರಿಸುವಿಕೆ<br><br>अवलुञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪಾಟನ /ಕಿತ್ತು ಹಾಕುವಿಕೆ<br><br>अवलुञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆದರಿರುವಿಕೆ /ಬಿಚ್ಚಿರುವಿಕೆ<br><br>अवलुञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಯ್ಯುವಿಕೆ /ತೆಗೆದುಕೊಂಡು ಹೋಗುವುದು<br><b>निष्पत्तिः - </b>अव + लुञ्च (अपनयने) - "ल्युट्" (३-३-११५)<br><br>

अवलुण्ठन
अवलुण्ठन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೆಲದ ಮೇಲೆ ಬಿದ್ದು ಹೊರಳಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + लुठि (स्तेये) - "ल्युट्" (३-३-११५)<br><br>अवलुण्ठन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಳ್ಳತನ<br><br>

अवलुप्त
अवलुप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲೋಪ ಹೊಂದಿದ /ನಾಶವಾದ<br><b>निष्पत्तिः - </b>अव + लप्लृ (छेदने) - "क्तः" (३-४-७२)<br><br>

अवलेप
अवलेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ವ /ಕೊಬ್ಬು /ಅಹಂಕಾರ<br><b>निष्पत्तिः - </b>अव + लिप (उपदेहे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"अवलेपभराक्रान्ता सुरलोकतरङ्गिणी"<br><b>उल्लेखाः - </b>चं० रा०<br><br>अवलेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಷಣ /ಒಡವೆ<br><br>अवलेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೇಪನ /ಬಳಿಯುವಿಕೆ<br><b>विस्तारः - </b>"अवलेपस्तु गर्वे स्यात् लेपने भूषणेऽपि च" - मेदि० ।<br><br>अवलेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುತ್ತಿಗೆ /ಧಾಳಿ<br><b>प्रयोगाः - </b>"किं भवतीनामसुरावलेपेनापराद्धम्"<br><b>उल्लेखाः - </b>विक्र० १<br><br>अवलेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಗ /ಸಂಬಂಧ<br><b>विस्तारः - </b>"अवलेपः सङ्गगर्वयोः" - त्रिकाण्ड० ।<br><br>

अवलेपन
अवलेपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲೇಪನ /ಬಳಿಯುವಿಕೆ<br><br>अवलेपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ವ /ಕೊಬ್ಬು /ಅಹಂಕಾರ<br><b>निष्पत्तिः - </b>अव + लिप (उपदेहे) - "ल्युट्" (३-३-११७)<br><br>अवलेपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಧ /ಚಂದನ<br><br>अवलेपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಣ್ಣೆ /ತೈಲ<br><b>निष्पत्तिः - </b>कर० "ल्युट्" (३-३-११७)<br><br>

अवलेह
अवलेह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೆಕ್ಕುವುದು /ಲೊಚ ಲೊಚ ಎಂದು ಕುಡಿಯುವುದು<br><b>निष्पत्तिः - </b>अव + लिह (आस्वादने) - "घञ्" (३-३-१८)<br><br>अवलेह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೇಹ /ಲೇಹ್ಯ<br><b>निष्पत्तिः - </b>कर्म० "घञ्" (३-३-१९)<br><br>

अवलेहन
अवलेहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಲಗೆಯಿಂದ ನೆಕ್ಕುವಿಕೆ<br><br>

अवलेह्य
अवलेह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೆಕ್ಕಲು ಯೋಗ್ಯವಾದ /ನಾಲಗೆಯಿಂದ ಕುಡಿಯಲು ಅರ್ಹವಾದ<br><br>

अवलोक
अवलोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೋಟ /ದೃಷ್ಟಿ<br><br>अवलोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೋಡುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + लोकृ (दर्शने) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"अवलोक एव नृपतेः स्म दूरतो रभसाद्रथादवतरीतुमिच्छतः"<br><b>उल्लेखाः - </b>माघ० १३-७<br><br>

अवलोकन
अवलोकन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೋಟ /ದೃಷ್ಟಿ<br><br>अवलोकन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೋಡುವುದು /ದೃಷ್ಟಿಯಿಡುವುದು<br><b>निष्पत्तिः - </b>अव + लोकृ (दर्शने) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"अवलोकनाथ सुरविद्विषां द्विषः पटहप्रणादविहितोपहूतयः"<br><b>उल्लेखाः - </b>माघ० १३-३०<br><br>अवलोकन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೇತ್ರ /ಕಣ್ಣು<br><b>निष्पत्तिः - </b>कर० "ल्युट्" (३-३-११७)<br><b>प्रयोगाः - </b>"योगनिन्द्रान्तविशदैः पावनैरवलोकनैः"<br><b>उल्लेखाः - </b>रघु० १०-१४<br><br>

अवलोकमान
अवलोकमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>अव + लोकृ (दर्शने) - "शानच्" (३-२-१२४)<br><br>

अवलोकित
अवलोकित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೋಟ /ದೃಷ್ಟಿ<br><b>निष्पत्तिः - </b>अव + लोकृ (दर्शने) - भावे "क्तः" (३-३-११४)<br><br>अवलोकित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + लोकृ (दर्शने) - कर्म० "क्तः" (३-२-१०२)<br><br>

अवलोकिन्
अवलोकिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡುವ /ವೀಕ್ಷಿಸುವ<br><b>निष्पत्तिः - </b>अव + लोकृ (दर्शने) - "णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"अवैमि सौभाग्यमदेन वञ्चितं तव प्रियं यश्चतुरावलोकिनः"<br><b>उल्लेखाः - </b>कुमा० ५-४९<br><br>

अवलोप
अवलोप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶ<br><br>अवलोप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವಿಕೆ /ತುಂಡು ಮಾಡುವಿಕೆ<br><br>अवलोप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಧರಖಂಡನ /ಚುಂಬನ<br><b>निष्पत्तिः - </b>अव + लुप्लृ (छेदने) - भावे "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"यदधयदधरावलोपनृत्यत्करवलयस्वनितेन तद्विवव्रे"<br><b>उल्लेखाः - </b>माघ० ७-४५<br><br>

अवलोम
अवलोम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕೂಲವಾದ<br><b>निष्पत्तिः - </b>"अच्" (५-४-७५)<br><b>व्युत्पत्तिः - </b>अवगतं लोम<br><br>

अवल्गुज
अवल्गुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಮರಾಜೀಲತೆ /ಬಾಹುಜಿಗೆ ಗಿಡ<br><br>अवल्गुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಸದ್ವಂಶದಲ್ಲಿ ಜನಿಸಿದ /ನೀಚ ಕುಲದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९७)<br><b>व्युत्पत्तिः - </b>अवल्गोरशिभनाज्जातः<br><br>

अववर्षण
अववर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣವಾಗಿ ಮಳೆಯಾಗುವುದು<br><b>निष्पत्तिः - </b>अव + वृषु (सेचने) - भावे "ल्युट्" (३-३-११५)<br><br>

अववाद
अववाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ<br><br>अववाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರ /ಅವಮಾನ<br><br>अववाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಕೀರ್ತಿ /ಅಪವಾದ<br><b>निष्पत्तिः - </b>अव + वद (व्यक्तायां वाचि) - "घञ्" (३-३-१८)<br><br>

अवश
अवश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರತಂತ್ರ /ಇತರರಿಗೆ ಅಧೀನನಾದ<br><b>प्रयोगाः - </b>"भूतग्राममिमं कृत्स्नं अवशं प्रकृतेर्वशात्"<br><b>उल्लेखाः - </b>गीता० ९-८<br><br>अवश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಾಧೀನನಲ್ಲದ /ಸ್ವತಂತ್ರನಾದ<br><br>अवश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಕೂಲವಾದ<br><b>व्युत्पत्तिः - </b>नास्ति वश स्वस्य परस्य वा आयतत्वं यस्य<br><b>प्रयोगाः - </b>"मधुरैरवशानि लम्भयन्नपि तिर्यञ्चि शमं निरीक्षितैः"<br><b>उल्लेखाः - </b>किरा० २-५५<br><br>अवश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಮರ್ಥ /ಪ್ರತೀಕಾರಾಶಕ್ತ<br><b>प्रयोगाः - </b>"मामग्रासनतोऽवकृष्टमवशं ये दृष्टवन्तः पुरा"<br><b>उल्लेखाः - </b>मुद्रा० १-१२<br><br>

अवशिरस्
अवशिरस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿದ ತಲೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अवनतं शिरो यस्य<br><br>

अवशिष्ट
अवशिष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಳಿಕೆ /ಶೇಷ<br><b>निष्पत्तिः - </b>अव + शिष (असर्वोपयोगे० - "क्तः" (३-३-११४)<br><br>अवशिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಳಿದಿರುವ /ಅಧಿಕವಾದ<br><b>निष्पत्तिः - </b>कर्त० "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"आरण्यकोपात्तफलप्रसूतिः स्तम्बेन नीवार इवावशिष्टः"<br><b>उल्लेखाः - </b>रघु० ५-१५<br><br>

अवशीर्ष
अवशीर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಮತಪ್ಪಿ ಮಲಗುವಿಕೆ /ಮೊಗಚಿಕೊಂಡು ಮಲಗುವಿಕೆ<br><b>प्रयोगाः - </b>"अवाक्शीर्षे दीर्घन्युब्जोत्तानसङ्कुचितदेहस्थितया दक्षिणपार्श्वस्थायिनः प्रदानमिति सप्त शय्यादोषाः"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>अवशीर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ನೇತ್ರ ರೋಗ<br><br>अवशीर्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿದ ತಲೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>वा "कप्" (५-४-१५४)<br><b>व्युत्पत्तिः - </b>अवनतं शीर्षं यस्य<br><br>

अवशीर्षक
अवशीर्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿದ ತಲೆಯುಳ್ಳ<br><b>प्रयोगाः - </b>"अतिपीडितवद्दोषान् विधिं चाप्यवशीर्षके"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

अवशेष
अवशेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೇಷ /ಉಳಿಕೆ<br><b>निष्पत्तिः - </b>अव + शिष (असर्वोपयोगे) - "क्तः" (३-२-१०२)<br><br>अवशेष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಶಿಷ್ಟವಾದ /ಉಳಿದಿರುವ<br><b>प्रयोगाः - </b>"स नन्दिनीस्तन्यमनिन्दितात्मा सद्वत्सलो वत्सहुतावशेषम्"<br><b>उल्लेखाः - </b>रघु० २-६९<br><br>

अवशोष
अवशोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಒಣಗುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + शुष (शोषणे) - भावे "घञ्" (३-३-१८)<br><br>

अवश्य
अवश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧೀನನಲ್ಲದ /ಸ್ವತಂತ್ರನಾದ<br><br>अवश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಡಗಿಸಲು ಶಕ್ಯವಲ್ಲದ /ವಶಪಡಿಸಿಕೊಳ್ಳಲಾಗದ<br><br>अवश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಿವಾರ್ಯ /ಅಪರಿಹಾರ್ಯ<br><b>व्युत्पत्तिः - </b>न वश्यः<br><br>

अवश्यम्
अवश्यम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಗತ್ಯವಾಗಿ /ಅವಶ್ಯವಾಗಿ /ಅನಿವಾರ್ಯವಾಗಿ<br><br>अवश्यम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಜವಾಗಿ /ನಿಃಸಂದೇಹವಾಗಿ<br><b>निष्पत्तिः - </b>अव + श्यैङ् (गतौ) - "डम्"<br><b>व्युत्पत्तिः - </b>अवश्यायते<br><b>प्रयोगाः - </b>"तां चावश्यं दिवसगणनातत्परामेकपत्नीम्"<br><b>उल्लेखाः - </b>मेघ० १-१०<br><br>

अवश्यपुत्र
अवश्यपुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಕ್ಷಿಸಲು ಸಾಧ್ಯವಿಲ್ಲದ ಮಗ /ಅಧೀನನಲ್ಲದ ಮಗ<br><br>

अवश्या
अवश्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವತಂತ್ರಳಾದ ಹೆಂಗಸು<br><br>

अवश्याय
अवश्याय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಮ /ಹೆಪ್ಪುಗಟ್ಟಿದ ಮಂಜು<br><b>निष्पत्तिः - </b>अव + श्यैङ् (गतौ) - "णः" (३-१-१४१)<br><b>प्रयोगाः - </b>"अवश्यायकणास्रावाश्चारुमुक्ताफलत्विषः"<br><b>उल्लेखाः - </b>भट्टि० ६-८०<br><br>अवश्याय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ವ /ಕೊಬ್ಬು /ಅಹಂಕಾರ<br><b>विस्तारः - </b>"अवश्यायस्तु नीहारेऽप्यभिमानेऽपि पुंस्ययम्" - मेदि० ।<br><br>

अवश्रयण
अवश्रयण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಡಿಗೆಯಾದ ನಂತರ ಒಲೆಯ ಮೇಲಿನಿಂದ ಕೆಳಕ್ಕೆ ಇಳಿಸುವುದು<br><b>निष्पत्तिः - </b>अव + श्रीञ् (सेवायाम्) - "ल्युट्" (३-३-११५)<br><br>

अवष्टब्ध
अवष्टब्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯಿಸಲ್ಪಟ್ಟ<br><br>अवष्टब्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಿಸಲ್ಪಟ್ಟ<br><br>अवष्टब्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದ<br><br>अवष्टब्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಯಲ್ಪಟ್ಟ /ನಿಲ್ಲಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + स्तम्भु (रोधने) - "क्तः" (३-२-१०२) । षत्वम् (८-३-६८)<br><b>विस्तारः - </b>"अवष्टब्धोऽविदूरे स्यादाक्रान्ते चावलम्बिते" - मेदि० ।<br><br>

अवष्टबभ्य
अवष्टबभ्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯಿಸಿ<br><br>अवष्टबभ्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ತಡೆದು<br><b>निष्पत्तिः - </b>अव + स्तम्भु (रोधने) - "ल्यप्" (७-१-३७) । षत्वम् (८-३-६८)<br><br>

अवष्टम्भ
अवष्टम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ /ಆಸರೆ<br><b>प्रयोगाः - </b>"खड्गलतावष्टम्भनिश्चलः"<br><b>उल्लेखाः - </b>मालती० ३<br><br>अवष्टम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ /ಉಪಕ್ರಮ<br><br>अवष्टम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ವ /ಕೊಬ್ಬು /ಅಹಂಕಾರ<br><br>अवष्टम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಬ<br><br>अवष्टम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಡೆ /ವಿಘ್ನ<br><br>अवष्टम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುವರ್ಣ<br><br>अवष्टम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಭ್ರಮ<br><b>निष्पत्तिः - </b>अव + स्तम्भु (रोधने) - "घञ्" (३-३-१८)<br><b>विस्तारः - </b>"अवष्टम्भः सुवर्णे च स्तम्भप्रारम्भयोरपि" - मेदि० ।<br><br>

अवष्टम्भन
अवष्टम्भन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ /ಆಸರೆ<br><br>अवष्टम्भन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ /ಉಪಕ್ರಮ<br><b>निष्पत्तिः - </b>अव + स्तम्भु (रोधने) - भावे "ल्युट्" (३-३-११५)<br><br>

अवस
अवस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ /ದೊರೆ<br><b>निष्पत्तिः - </b>अव (रक्षणे) - "असच्" (उ० ३-११७)<br><b>व्युत्पत्तिः - </b>अवति<br><br>अवस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>अवस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಕ್ಕದ ವೃಕ್ಷ<br><br>अवस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಫಲಾಹಾರದ ವಸ್ತು /ಪ್ರಯಾಣಕಾಲದಲ್ಲಿ ದಾರಿಯ ಆಹಾರಕ್ಕಾಗಿ ತೆಗೆದುಕೊಳ್ಳುವ ವಸ್ತು<br><br>

अवसक्त
अवसक्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಸರ್ಗ /ಸಂಬಂಧ<br><b>निष्पत्तिः - </b>अव + षञ्ज (सङ्गे) - भावे "क्तः" (३-३-११४)<br><br>अवसक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಟಿಕೊಂಡಿರುವ /ಸೇರಿಕೊಂಡಿರುವ<br><b>निष्पत्तिः - </b>कर्त० "क्तः" (३-४-७२)<br><br>अवसक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"कर्णावसक्तामलदन्तपत्रं माता तदीयं मुखमुन्नमय्य"<br><b>उल्लेखाः - </b>कुमा० ७-२३<br><br>

अवसक्थिका
अवसक्थिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ಯಂಕ /ಮಂಚ<br><b>विस्तारः - </b>"पर्यङ्कस्त्ववसक्थिका" - त्रिकाण्ड० ।<br><br>अवसक्थिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಳಿತುಕೊಳ್ಳುವಾಗ ತೊಡೆಗಳನ್ನು ಮಡಿಸಿಕೊಂಡು ಬೆನ್ನಿಗೆ ಸೇರಿಸಿ ಸುತ್ತಲೂ ಹಾಕುವ ಬಟ್ಟೆಯ ಕಟ್ಟು<br><b>व्युत्पत्तिः - </b>अवबन्धे सक्थिनी यस्य<br><b>विस्तारः - </b>"योगपट्टस्तु चीना स्यात् पर्यस्तिरवसक्थिका" - वैज० ।<br><br>

अचसण्डीन
अचसण्डीन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಿನಿಂದ ಕೆಳಕ್ಕೆ ಹಕ್ಕಿಗಳ ಇಳಿಯುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + सम् + डीङ् (विहायसा गतौ) - भावे "क्तः" (३-३-११४)<br><br>

अवसन्न
अवसन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧೈರ್ಯಗುಂದಿದ /ಕುಗ್ಗಿದ ಮನಸ್ಸುಳ್ಳ<br><b>प्रयोगाः - </b>"यातमवनिमवसन्नभुजात्"<br><b>उल्लेखाः - </b>माघ० १५-८५<br><br>अवसन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನ ಕರ್ತವ್ಯನಿರ್ವಾಹದಲ್ಲಿ ಅಸಮರ್ಥನಾದ<br><br>अवसन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾಪ್ತಿ ಹೊಂದಿದ /ಕೊನೆಗೊಂಡ<br><b>प्रयोगाः - </b>"अवसन्नतापमतमिस्रमभात्"<br><b>उल्लेखाः - </b>माघ० ९-१२<br><br>अवसन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಳುಗಿ ಹೋದ<br><br>अवसन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಳೆದು ಹೋದ<br><b>निष्पत्तिः - </b>अव + षद्लृ (विशरणादौ) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"पित्रोः सकाशमवसन्नदृशोर्निनाय"<br><b>उल्लेखाः - </b>रघु० ९-७७<br><br>

अवसर
अवसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವಕಾಶ /ಸಮಯ<br><b>निष्पत्तिः - </b>अव + सृ (गतौ) - "अप्" बाहु० ।<br><b>प्रयोगाः - </b>"भवद्भिरामवसरप्रदानाय वचांसि नः"<br><b>उल्लेखाः - </b>माघ० २-८<br><br>अवसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರಿಯಾದ ಕಾಲ /ಸಕಾಲ /ಸದವಕಾಶ<br><b>प्रयोगाः - </b>"विमानशृङ्गाण्यवगाहमानः शशंस सेवावसरं सुरेभ्यः"<br><b>उल्लेखाः - </b>कुमा० ७-४०<br><br>अवसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಸಂಗ /ಪ್ರಸ್ತಾವನೆ<br><br>अवसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂವತ್ಸರ<br><br>अवसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಳೆ<br><br>अवसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಳ /ಜಾಗ<br><b>प्रयोगाः - </b>"धृतमेत्य पुष्पधनुषो धनुषः कुमुदेऽङ्गनामनसि चावसरम्"<br><b>उल्लेखाः - </b>माघ० ९-४१<br><br>अवसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂತ್ರಾಲೋಚನೆ<br><br>अवसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿರಾಮ /ಪುರುಸೊತ್ತು<br><b>विस्तारः - </b>"अवसरो वत्सरे क्षणे" - हेम० । "अथावसरः पुमान् । प्रस्तावे मन्त्रभेदे च वर्षणे चापि कीर्तितः" - मेदि० ।<br><br>

अवसर्प
अवसर्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೂಢಾಚಾರ /ಗುಪ್ತ ಬಾತ್ಮೀದಾರ<br><b>निष्पत्तिः - </b>अव + सृल्पृ (गतौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अवसर्पति<br><br>

अचसर्पण
अचसर्पण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಇಳಿಯುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + सृल्पृ (गतौ) - भावे "ल्युट्" (३-३-११५)<br><br>

अवसर्पिन्
अवसर्पिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಹೋಗುವ<br><b>निष्पत्तिः - </b>अव + सृल्पृ (गतौ) - "णिनिः" (३-१-१३४)<br><br>

अवसर्पिणी
अवसर्पिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಹೋಗುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>अवसर्पिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜೈನರ ಕಲ್ಪಕಾಲದ ಒಂದು ಭಾಗ<br><br>

अवसाद
अवसाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶ /ಧ್ವಂಸ<br><b>निष्पत्तिः - </b>अव + षद्लृ (विशरणादौ) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"धैर्यावसादेन हृतप्रसादा वन्यद्विपेन निदाघसिन्धुः"<br><b>उल्लेखाः - </b>किरा० ३-३८<br><br>अवसाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶಕ್ತತೆ /ಅಸಾಮರ್ಥ್ಯ<br><br>अवसाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಣಿವು /ಆಯಾಸ<br><b>प्रयोगाः - </b>"किमिवावसादकरमात्मवताम्"<br><b>उल्लेखाः - </b>किरा० ६-१९<br><br>अवसाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಳಿವು /ಮುಳುಗಿ ಹೋಗುವುದು<br><b>प्रयोगाः - </b>"धुरं गुर्वी वोढुं स्थितमनवसादाय जगतः"<br><b>उल्लेखाः - </b>किरा० १८-४७<br><br>अवसाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೋಲು /ಪರಾಜಯ<br><b>प्रयोगाः - </b>"अलं स्वपक्षावसादशङ्कया"<br><b>उल्लेखाः - </b>माल० १<br><br>अवसाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವಸಾನ /ಕೊನೆ /ಸಮಾಪ್ತಿ<br><br>

अवसादक
अवसादक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಾಮರ್ಥ್ಯವನ್ನು ಉಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>अव + षद्लृ (विशरणादौ) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>प्रयोगाः - </b>"एष शोकः परित्यक्तः सर्वकार्यावसादकः"<br><b>उल्लेखाः - </b>रामा०<br><br>अवसादक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾಪ್ತಿಯನ್ನುಂಟುಮಾಡುವ /ಕೊನೆಗಾಣಿಸುವ<br><br>अवसादक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೋಲಿಸುವ<br><br>अवसादक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಗೊಳಿಸುವ<br><br>अवसादक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುಃಖವುಂಟುಮಾಡುವ<br><br>अवसादक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಣಿವುಂಟುಮಾಡುವ<br><br>

अवसादन
अवसादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸುವಿಕೆ<br><br>अवसादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದಲ್ಲಿ ಅಸಾಮರ್ಥ್ಯವನ್ನುಂಟುಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + षद्लृ (विशरणादौ) + णिच् - "ल्युट्" (३-३-११५)<br><br>अवसादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಬಲನನ್ನಾಗಿ ಮಾಡುವಿಕೆ<br><br>अवसादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಾಜಯಗೊಳಿಸುವಿಕೆ<br><br>अवसादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾಪ್ತಿಗೊಳಿಸುವಿಕೆ<br><br>अवसादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದುಃಖವುಂಟುಮಾಡುವಿಕೆ<br><br>अवसादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಯಲ್ಲಿ ದಪ್ಪನಾಗಿ ಎದ್ದಿರುವ ಕುರು ಮೊದಲಾದ ವ್ರಣವು ಸಣ್ಣದಾಗಲು ಮಾಡುವ ಚಿಕಿತ್ಸೆ /ಮಾಂಸಗ್ರಂಥಿಯನ್ನು ಹೊರತೆಗೆಯಲು ಮಾಡುವ ಚಿಕಿತ್ಸೆ<br><b>प्रयोगाः - </b>"उत्सन्नमृदुमांसानं व्रणानामवसादनम्"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

अवसान
अवसान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿರಾಮ /ನಿಲ್ಲಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + षो (अन्तकर्मणि) - "ल्युट्" (३-३-११५)<br><br>अवसान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನೆ /ಸಮಾಪ್ತಿ<br><b>प्रयोगाः - </b>"दोहावसाने पुनरेव दोग्ध्रीं भेजे भुजोच्छिन्नरिपुर्निषण्णाम्"<br><b>उल्लेखाः - </b>रघु० २-२३<br><br>अवसान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಗಿಸುವಿಕೆ<br><br>अवसान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೃತ್ಯು /ಮರಣ<br><b>विस्तारः - </b>"दिष्टान्तोऽस्तं कालधर्मोऽवसानम्" - अभि० चि० ।<br><br>अवसान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೀಮೆ /ಎಲ್ಲೆ /ಗಡಿ<br><b>विस्तारः - </b>"अन्तोऽवसानं सीमा च मर्यादाऽपि च सीमनि" - अभि० चि० ।<br><br>

अवसाय
अवसाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾಪ್ತಿ /ಕೊನೆ<br><b>निष्पत्तिः - </b>अव + षो (अन्तकर्मणि) - "णः" (३-१-१४१)<br><b>प्रयोगाः - </b>"परितः प्रसभेन नीयमानः शरवर्षेरवसायमाश्रयाशः"<br><b>उल्लेखाः - </b>माघ० २०-७२<br><br>अवसाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೇಷ /ಉಳಿಕೆ<br><br>अवसाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಗಿಸುವಿಕೆ /ಕೊನೆಗಾಣಿಸುವಿಕೆ<br><br>अवसाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯ /ನಿರ್ಧಾರ<br><b>विस्तारः - </b>"अथावसायः शेषे स्यात् समाप्तौ निश्चयेऽपि च" - मेदि० ।<br><br>अवसाय<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಮಾಪ್ತಿಗೊಳಿಸಿ /ಕೊನೆಗಾಣಿಸಿ<br><br>अवसाय<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯಿಸಿ /ನಿರ್ಣಯಿಸಿ<br><b>निष्पत्तिः - </b>अव + षो (अन्तकर्मणि) - "ल्यप्" (७-१-३७)<br><br>

अवसायक
अवसायक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯಿಸುವ /ನಿರ್ಣಯ ಮಾಡುವ<br><br>अवसायक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಗಿಸುವ /ಸಮಾಪ್ತಿಗೊಳಿಸುವ<br><b>निष्पत्तिः - </b>अव + षो (अन्तकर्मणि) - "ण्वुल्" (३-१-१३३)<br><br>

अवसायित
अवसायित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಗಿಸಲ್ಪಟ್ಟ /ಸಮಾಪ್ತಿಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>अवसायित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರ್ಣಯಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + षो (अन्तकर्मणि) + णिच् - "क्तः" (३-२-१०२)<br><br>

अवसिक्त
अवसिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೋಕ್ಷಿಸಲ್ಪಟ್ಟ /ಚಿಮುಕಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + षिच (क्षरणे) - "क्तः" (३-२-१०२)<br><br>अवसिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೆನೆಸಲ್ಪಟ್ಟ /ತೋಯಿಸಲ್ಪಟ್ಟ<br><br>

अवसित
अवसित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಮನ /ಗತಿ<br><br>अवसित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಸಾನ /ಕೊನೆ /ಸಮಾಪ್ತಿ<br><br>अवसित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಕ್ಕಿದ ಧಾನ್ಯ<br><br>अवसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಗಿಸಲ್ಪಟ್ಟ /ಸಮಾಪ್ತಿಗೊಳಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + षो (अन्तकर्मणि) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"वचस्यवसिते तस्मिन् ससर्ज गिरमात्मभूः"<br><b>उल्लेखाः - </b>कुमा० २-५३<br><br>अवसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಗಿಸಲ್ಪಟ್ಟ /ನಿರ್ವಹಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"सोऽहमिदानीमवसितप्रतिज्ञाभरोऽपि वृषलापेक्षया शस्त्रं धारयामि"<br><b>उल्लेखाः - </b>मुद्रा० १<br><br>अवसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಪಟ್ಟ<br><br>अवसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯಿಸ್ಲ್ಪಟ್ಟ<br><br>अवसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಪಕ್ವವಾಗಿರುವ<br><b>विस्तारः - </b>"अवसितं समाप्ते निश्चितेऽपि च" - नानार्थर० । "अवसितं गतौ । ऋद्धे ज्ञातेऽवसाने च" - हेम० ।<br><br>अवसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಯಲ್ಪಟ್ಟ<br><br>अवसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧಿಸಿದ<br><b>प्रयोगाः - </b>"नदीमन्ववसिता सेना"<br><b>विस्तारः - </b>"भवेदसितं ज्ञाते गतौ रुद्धावसानयोः" - विश्व० ।<br><br>

अवसृष्ट
अवसृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಡಲ್ಪಟ್ಟ /ದಾನ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + सृज (विसर्गे) - "क्तः" (३-२-१०२)<br><br>अवसृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡಲ್ಪಟ್ಟ /ತ್ಯಜಿಸಲ್ಪಟ್ಟ<br><br>अवसृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊರಟಿರುವ<br><br>

अवसेक
अवसेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ನಾನ<br><br>अवसेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಮುಕಿಸುವುದು /ಸಿಂಪಡಿಸುವುದು<br><b>निष्पत्तिः - </b>अव + षिच (क्षरणे) - "घञ्" (३-३-१८)<br><br>अवसेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಬಗೆ ನೇತ್ರರೋಗ<br><br>

अवसेचन
अवसेचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ಚಿಮುಕಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + षिच (क्षरणे) - "ल्युट्" (३-३-११५)<br><br>अवसेचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ತವನ್ನು ಸುರಿಸುವಿಕೆ<br><br>

अवसेय
अवसेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರ್ಣಯಿಸಲ್ಪಡುವ<br><br>अवसेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾಪ್ತಿಗೊಳಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अव + षो (अन्तकर्मणि) - "यत्" (३-१-९७)<br><br>

अवस्कन्द
अवस्कन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಣ /ಮುತ್ತಿಗೆ<br><br>अवस्कन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಳಿಕೆ /ಇಳಿಯುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + स्कन्दिर् (गतिशोषणयोः) - भावे "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"लतानुपातं कुसुमान्यगृह्णात् स नद्यवस्कन्दमुपास्पृशच्च"<br><b>उल्लेखाः - </b>भट्टि० २-११<br><br>अवस्कन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೇನಾನಿವೇಶಸ್ಥಾನ /ಸೇನೆಗಳ ಶಿಬಿರ<br><b>निष्पत्तिः - </b>अधि० "घञ्" (३-३-१२१)<br><br>

अवस्कन्दन
अवस्कन्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುತ್ತಿಗೆ /ಆಕ್ರಮಣ<br><b>निष्पत्तिः - </b>अव + स्कन्दिर् (गतिशोषणयोः) - भावे "ल्युट्" (३-३-११५)<br><br>अवस्कन्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಳಿಯುವಿಕೆ /ಮೇಲಿನಿಂದ ಕೆಳಕ್ಕೆ ಬರುವಿಕೆ<br><br>

अवस्कन्दित
अवस्कन्दित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುತ್ತಿಗೆ ಹಾಕಲ್ಪಟ್ಟ /ಆಕ್ರಮಿಸಲ್ಪಟ್ಟ<br><br>अवस्कन्दित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಖಂಡಿಸಲ್ಪಟ್ಟ /ನಿರಾಕರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + स्कन्दिर् (गतिशोषणयोः) - "क्तः" (३-२-१०२)<br><br>अवस्कन्दित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಇಳಿದಿರುವ<br><b>निष्पत्तिः - </b>कर्त० "क्तः" (३-४-७२)<br><br>

अवस्कर
अवस्कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಗಣಿ /ಲದ್ಧಿ<br><br>अवस्कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಹ್ಯಪ್ರದೇಶ<br><br>अवस्कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಸ<br><b>निष्पत्तिः - </b>अव + कॄ (विक्षेपे) - "अप्" (३-३-५७)<br><b>विस्तारः - </b>"अवस्करोऽपि वर्चस्के गुह्ये" - मेदि० ।<br><br>अवस्कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಸದರಾಶಿ /ಗುಪ್ಪೆ /ತಿಪ್ಪೆ<br><br>

अवस्करक
अवस्करक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಿಮಿ /ಹುಳ<br><br>अवस्करक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಸದರಾಶಿಯಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>"वुन्" (४-३-२८)<br><b>व्युत्पत्तिः - </b>अवस्करे जातः<br><br>

अवस्तरण
अवस्तरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊರಭಾಗದಲ್ಲಿ ಹರಡುವುದು<br><b>निष्पत्तिः - </b>अव + स्तृञ् (आच्छादने) - "ल्युट्" (३-३-११५)<br><br>

अवस्तात्
अवस्तात्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೆಳಗಡೆ /ಕೆಳಗಡೆಯಿಂದ /ಕೆಳಗಡೆಯಲ್ಲಿ<br><br>अवस्तात्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹಿಂದಿನ ಕಾಲ /ಹಿಂದಿನ ಕಾಲದಿಂದ /ಹಿಂದಿನ ಕಾಲದಲ್ಲಿ<br><br>अवस्तात्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹಿಂಭಾಗ /ಹಿಂಭಾಗದಿಂದ<br><b>निष्पत्तिः - </b>अवर - "अस्तातिः" "अव्" आदेशश्च (५-३-४१)<br><br>

अवस्तार
अवस्तार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜವನಿಕೆ /ತೆರೆ<br><br>अवस्तार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಪೆ<br><br>अवस्तार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊದಿಕೆ<br><b>निष्पत्तिः - </b>अव + स्तृञ् (आच्छादने) - "घञ्" (३-३-१८)<br><br>

अवस्तु
अवस्तु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯವಾದ ವಸ್ತು /ಅನರ್ಹವಾದ ಪದಾರ್ಥ<br><b>निष्पत्तिः - </b>कुत्सितार्थे न० त० ।<br><b>व्युत्पत्तिः - </b>न वस्तु<br><b>प्रयोगाः - </b>"अवस्तुनिर्बन्धपरे कथं नु ते"<br><b>उल्लेखाः - </b>कुमा० ५-६६<br><br>

अवस्था
अवस्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲದಿಂದ ಉಂಟಾದ ಶರೀರದ ವಿಶೇಷ ಧರ್ಮ<br><b>निष्पत्तिः - </b>अव + ष्ठा (गतिनिवृत्तौ) - "अङ्" (३-३-१०६)<br><b>प्रयोगाः - </b>"वयोऽवस्थां तस्याः शृण्वत सुहृदो यत्र मदनः प्रगल्भव्यापारश्चरति हृदि मुग्धश्च वपुषि"<br><b>उल्लेखाः - </b>मालती० ९-२९<br><br>अवस्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಿತಿ /ಇರುವಿಕೆ<br><br>अवस्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲಕೃತವಾದ ಪರಿಣಾಮ<br><br>

अवस्थान
अवस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಿತಿ /ಇರುವಿಕೆ<br><br>अवस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸ ಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + ष्ठा (गतिनिवृत्तौ) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"वटतले चतुर्मण्डलावस्थेन अवस्थितः"<br><b>उल्लेखाः - </b>पञ्चतं० १<br><br>अवस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸಸ್ಥಳ /ಮನೆ<br><b>निष्पत्तिः - </b>अधि० "ल्युट्" (३-३-११५)<br><br>

अवस्थापन
अवस्थापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇರಿಸುವಿಕೆ /ಇರುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + ष्ठा (गतिनिवृत्तौ) + णिच् + पुक् - "ल्युट्" (३-३-११५)<br><br>

अवस्थापित
अवस्थापित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + ष्ठा (गतिनिवृत्तौ) + णिच् + पुक् - "क्तः" (३-२-१०२)<br><br>

अवस्थायिन्
अवस्थायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇರುವ /ವಾಸ ಮಾಡುವ<br><b>निष्पत्तिः - </b>अव + ष्ठा (गतिनिवृत्तौ) - "णिनिः" (३-१-१३४)<br><br>

अवस्थायिनी
अवस्थायिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇರುವ /ವಾಸ ಮಾಡುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अवस्थित
अवस्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇರುವ /ನಿಂತಿರುವ<br><b>निष्पत्तिः - </b>अव + ष्ठा (गतिनिवृत्तौ) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"यानेव हत्वा जिजिविषामस्तेऽवस्थिताः प्रमुखे धार्तराष्ट्राः" । "तत्कथय कथमियन्तं कालमवस्थिता मया विना भवती" ।<br><b>उल्लेखाः - </b>गीता० २-६, विक्र० ४<br><br>अवस्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಸವಾಗಿರುವ<br><br>अवस्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರತನಾದ /ಉದ್ಯುಕ್ತನಾದ<br><b>प्रयोगाः - </b>"प्रिया भवन्ति लोकस्य स्वे स्वे कर्मण्यवस्थिताः"<br><b>उल्लेखाः - </b>मनु० ८-४२<br><br>अवस्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಥಿರವಾಗಿರುವ /ದೃಢವಾಗಿರುವ<br><br>अवस्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಲಂಬಿಸಿರುವ /ಆಶ್ರಯಿಸಿರುವ<br><b>प्रयोगाः - </b>"मयि सृष्टिर्हि लोकानां रक्षा युष्माववस्थिता"<br><b>उल्लेखाः - </b>कुमा० २-२८<br><br>अवस्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೀರ್ಮಾನವಾದ /ನಿಶ್ಚಿತವಾದ<br><b>प्रयोगाः - </b>"विपर्यये तु पितुरस्याः समीपनयनमवस्थितमेव"<br><b>उल्लेखाः - </b>शाकु० ५<br><br>

अवस्थिति
अवस्थिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಿತಿ /ಇರುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + ष्ठा (गतिनिवृत्तौ) - "क्तिन्" (३-३-९४)<br><br>अवस्थिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸಸ್ಥಾನ /ಮನೆ<br><b>प्रयोगाः - </b>"नियतमिह सर्वात्मना कृतावस्थितिना भगवता धर्मेण न स्मर्यते कृतयुगस्य"<br><b>उल्लेखाः - </b>कादं० ८८<br><br>

अवस्यन्दन
अवस्यन्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ರವಿಸುವಿಕೆ /ಸೋರುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + स्यन्दू (प्रस्रवणे) - "ल्युट्" (३-३-११५)<br><br>

अवस्रंसन
अवस्रंसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಬೀಳುವುದು<br><b>निष्पत्तिः - </b>अव + स्रंसु (अवस्रंसने) - भावे "ल्युट्" (३-३-११५)<br><br>

अवस्रंसित
अवस्रंसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಬೀಳಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + स्रंसु (अवस्रंसने) + णिच् - "क्तः" (३-२-१०२)<br><br>

अवस्रस्त
अवस्रस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಗೆ ಬಿದ್ದ<br><b>निष्पत्तिः - </b>अव + स्रंसु (अवस्रंसने) - "क्तः" (३-२-१०२)<br><br>

अवह
अवह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರವಾಹವಿಲ್ಲದ /ನದಿಯು ಹರಿಯದಿರುವ ದೇಶ<br><b>निष्पत्तिः - </b>वह (प्रापणे) - "अच्" (३-१-१३४)<br><br>अवह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಹಿಸದಿರುವ /ಹೊರದಿರುವ<br><br>

अवहत
अवहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಡಿಯಲ್ಪಟ್ಟ /ಒಕ್ಕಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + हन (हिंसागत्योः) - "क्तः" (३-२-१०२)<br><br>अवहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಟ್ಟಲ್ಪಟ್ಟ ಬತ್ತ<br><br>

अवहति
अवहति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೆನೆ ಬಡಿಯುವುದು<br><br>अवहति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಟ್ಟುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + हन (हिंसागत्योः) - "क्तिन्" (३-३-९४)<br><br>

अवहनन
अवहनन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೆನೆ ಬಡಿಯುವಿಕೆ<br><br>अवहनन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯವನ್ನು ಕುಟ್ಟುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + हन (हिंसागत्योः) - "ल्युट्" (३-३-११५)<br><br>अवहनन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ವಾಸಕೋಶ<br><b>निष्पत्तिः - </b>कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>अवहन्यते शोणितमनेन<br><br>

अवहरण
अवहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರೆ ಕಡೆಗೆ ಒಯ್ಯುವುದು<br><br>अवहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇನೆಗಳನ್ನು ರಣಕ್ಷೇತ್ರದಿಂದ ಶಿಬಿರಕ್ಕೆ ಒಯ್ಯುವುದು<br><br>अवहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತತ್ಕಾಲದಲ್ಲಿ ಹಂಗಾಮಿಯಾಗಿ ಯುದ್ಧವನ್ನು ನಿಲ್ಲಿಸುವುದು<br><br>अवहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಲಿಗೆ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>अव + हृञ् (हरणे) - "ल्युट्" (३-३-११५)<br><br>

अवहस्त
अवहस्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಯ ಹಿಂಭಾಗ<br><b>व्युत्पत्तिः - </b>अवरं हस्तस्य<br><b>विस्तारः - </b>"अवहस्तो हस्तपृष्ठतः" - अभि० चि० ।<br><br>

अवहार
अवहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೋರ /ಕಳ್ಳ<br><b>निष्पत्तिः - </b>अव + हृञ् (हरणे) - "णः" (३-१-१४१)<br><br>अवहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಲಚರ ಪ್ರಾಣಿ<br><b>विस्तारः - </b>"नक्रे चौरेऽवहारः स्यात्" - त्रिकाण्ड० ।<br><br>अवहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾವುಮೀನು<br><br>अवहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತತ್ಕಾಲದಲ್ಲಿ ಹಂಗಾಮಿಯಾಗಿ ಯುದ್ಧವನ್ನು ನಿಲ್ಲಿಸುವುದು<br><br>अवहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೇನೆಗಳನ್ನು ರಣಕ್ಷೇತ್ರದಿಂದ ಶಿಬಿರಕ್ಕೆ ಒಯ್ಯುವುದು<br><b>प्रयोगाः - </b>"ततोऽवहारः सैन्यानां तव तेषां च भारत"<br><b>उल्लेखाः - </b>भा० भीष्म० ४८-१२०<br><br>अवहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ಯೂತ /ಜೂಜು<br><b>विस्तारः - </b>"अवहारे भवेच्चौरे द्यूते ग्राहाख्ययादसि । निमन्त्रणोपनेतव्यद्रव्ये युद्धादिविश्रमे" - नानर्थर० ।<br><br>अवहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿರಾಮ /ವಿಶ್ರಾಂತಿ<br><br>अवहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ತರಲ್ಪಡುವ ವಸ್ತು<br><br>अवहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೂಜು ಯುದ್ಧ ಮುಂತಾದುವುಗಳ ವಿರಾಮ<br><br>अवहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಮಂತ್ರಣ ಕಾಲದಲ್ಲಿ ಬ್ರಾಹ್ಮಣನಿಗೆ ಕೊಡುವ ದ್ರವ್ಯ<br><b>विस्तारः - </b>"अवहारः पुमान् चौरे द्यूतयुद्धादिविश्रमे । निमन्त्रणोपनेतव्यद्रव्ये ग्राहाख्ययादसि" - मेदि० ।<br><br>

अवहारक
अवहारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊಸಳೆ<br><br>अवहारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಕಡೆಗೆ ಒಯ್ಯುವ /ಇನ್ನೊಂದು ಕಡೆಗೆ ಸಾಗಿಸುವ<br><b>निष्पत्तिः - </b>अव + हृञ् (हरणे) - "ण्वुल्" (३-१-१३३)<br><br>अवहारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯುದ್ಧದಿಂದ ಸೈನ್ಯವನ್ನು ತಡೆಯುವ<br><br>अवहारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಲ್ಲಿಸುವ /ತಡೆಯುವ<br><br>

अवहार्य
अवहार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಕಡೆಗೆ ಸಾಗಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अव + हृञ् (हरणे) - "ण्यत्" (३-१-१२४)<br><br>अवहार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಶ್ಯವಾಗಿ ಕೊಡಲ್ಪಡುವ<br><b>प्रयोगाः - </b>"अधिश्चोपनिधिश्चोभौ न कालात्ययमर्हतः । अवहार्यौ भवेतां तौ दीर्घकालमवस्थितौ ॥"<br><b>उल्लेखाः - </b>मनु० ८-१४५<br><br>अवहार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಕ್ಷಿಸಲ್ಪಡುವ /ದಂಡ ವಿಧಿಸಲ್ಪಡುವ<br><b>प्रयोगाः - </b>"अवहार्यो भवेच्चैव सान्वयः षट्शतं दमम्"<br><b>उल्लेखाः - </b>मनु० ८-१९८<br><br>अवहार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂತಿರುಗಲು ಯೋಗ್ಯವಾದ<br><br>

अवहास
अवहास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಸ್ಯ /ವಿನೋದ<br><b>निष्पत्तिः - </b>अव + हसे (हसने) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"यच्चावहासार्थमसत्कृतोऽसि विहारशय्यासनभोजनेषु"<br><b>उल्लेखाः - </b>गीता० ११-४२<br><br>अवहास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಗುಳು ನಗೆ /ಮಂದಹಾಸ<br><br>

अवहास्य
अवहास्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಗಲ್ಪಡುವ /ಗೇಲಿ ಮಾಡಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अव + हसे (हसने) - कर्म० "ण्यत्" (३-१-१२४)<br><br>

अवहित
अवहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಧಾನವಿಡಲ್ಪಟ್ಟ /ಜಾಗರೂಕವಾದ<br><b>निष्पत्तिः - </b>अव + डुधाञ् (धारणपोषणयोः) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अवहितहृदयो विधाय सोऽर्हामृषिवदृषिप्रवरे गुरूपदिष्टाम्"<br><b>उल्लेखाः - </b>किरा० २-५८<br><br>

अवहित्था
अवहित्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭಯ /ಲಜ್ಜೆ ಮುಂತಾದುವುಗಳಿಂದ ಹರ್ಷ ಮೊದಲಾದ ಅನುಭವಗಳನ್ನು ಅಡಗಿಸಿಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>अव + ष्ठा (गतिनिवृत्तौ) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>न बहिः तिष्ठति<br><b>प्रयोगाः - </b>"एवं वादिनि देवर्षौ पार्श्वे पितुरधोमुखी । लीलाकमलपत्राणि गणयामास पार्वती ॥"<br><b>उल्लेखाः - </b>कुमा० ६-८४<br><br>

अवहेल|अवहेला
अवहे(ल)ला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಾದರ /ತಿರಸ್ಕಾರ<br><b>निष्पत्तिः - </b>अव + हेडृ (अनादरे) - "कः" (वा० ३-३-५८) । "अङ्" (३-३-१०३) वा ।<br><br>

अवहेलन
अवहेलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಾದರ /ತಿರಸ್ಕಾರ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

अवहेलित
अवहेलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ /ಅನಾದರದಿಂದ ಕಾಣಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + हेडृ (अनादरे) - "क्तः" (३-२-१०२)<br><br>

अवह्वर
अवह्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಟಿಲ ಮಾರ್ಗ /ಠಕ್ಕು /ಮೋಸ<br><br>अवह्वर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಟಿಲವಾದ<br><b>निष्पत्तिः - </b>ह्वृ (कौटिल्ये संवरणे च० - "घः" (३-३-११८)<br><br>

अवाक्|अवाच् 
अवाक्(च्)<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂಗ /ಮಾತನಾಡದವನು<br><b>व्युत्पत्तिः - </b>नास्ति वाक् यस्य<br><br>अवाक्(च्)<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣದಿಕ್ಕು /ದಕ್ಷಿಣ ದಿಕ್ಕಿನಿಂದ /ದಕ್ಷಿಣ ದಿಕ್ಕಿನಲ್ಲಿ<br><br>अवाक्(च्)<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣ ದೇಶ /ದಕ್ಷಿಣ ದೇಶದಿಂದ /ದಕ್ಷಿಣ ದೇಶದಲ್ಲಿ<br><b>निष्पत्तिः - </b>अव + अञ्चु (गतौ) - "क्विन्" (३-२-५९) । "अस्तातिः" (५-३-२७)<br><br>

अवाक्पुष्पी
अवाक्पुष्पी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡು ಸಬ್ಬಸಿಗೆ<br><b>निष्पत्तिः - </b>"ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>अवाञ्चि अधोमुखानि पुष्पाण्यस्याः<br><br>

अवाक्शाख
अवाक्शाख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಮದ್ಭಗವದ್ಗೀತೆಯಲ್ಲಿ ಉಕ್ತವಾದ ಸಂಸಾರ /ಕೆಳಮುಖವಾದ ರೆಂಬೆಗಳುಳ್ಳ ಅಶ್ವತ್ಥ ವೃಕ್ಷ್ಗ<br><b>व्युत्पत्तिः - </b>अवाच्यः शाखा यस्य<br><b>प्रयोगाः - </b>"ऊर्ध्वमूलमधःशाखं अश्वत्थं प्राहुरव्ययम् । छन्दांसि यस्य पर्णानि यस्तं वेद स वेदवित् ॥"<br><b>उल्लेखाः - </b>गीता० १५-१<br><br>

अवाक्शिरस्
अवाक्शिरस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿದ ತಲೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अवाक् शिरो यस्य<br><b>प्रयोगाः - </b>"श्राद्धं भुक्त्वा य उच्छिष्टं वृषलाय प्रयच्छति । स मूढो नरकं याति कालसूत्रमवाक्शिराः ॥"<br><b>उल्लेखाः - </b>मनु० ३-२४९<br><br>

अवाग्र
अवाग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣ ದೇಶ<br><b>व्युत्पत्तिः - </b>अवनतमग्रं यस्य<br><br>

अवाच्
अवाच्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣ ದೇಶ<br><br>अवाच्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧೋಮುಖವಾದ /ಕೆಳಮುಖವಾದ<br><b>निष्पत्तिः - </b>अव + अञ्चु (गतौ) - "क्विन्" (३-२-५९) ।<br><b>व्युत्पत्तिः - </b>अवाञ्चति<br><br>

अवाची
अवाची<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣ ದಿಕ್ಕು<br><br>अवाची<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣ ದಿಕ್ಕು<br><b>निष्पत्तिः - </b>अव + अञ्चु (गतौ) - "क्विन्" (३-२-५७) । "ङीप्" (४-१-६)<br><b>व्युत्पत्तिः - </b>अवाञ्चसि<br><br>

अवाङ्मनसगोचर
अवाङ्मनसगोचर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ /ಹೇಳಲೂ ತಿಳಿದುಕೊಳ್ಳಲೂ ಅಶಕ್ಯನಾದ ಈಶ್ವರ<br><b>व्युत्पत्तिः - </b>व्आक् च मनश्च वाङ्मनसे । तयोर्गोचरो न भवति<br><br>

अवाङ्मुख
अवाङ्मुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿದ ತಲೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>अवाक् मुखं यस्य<br><b>प्रयोगाः - </b>"तस्थुस्तेऽवाङ्मुखाः सर्वे फलिता इव शालयः"<br><b>उल्लेखाः - </b>रघु० १५-८७<br><br>

अवाचीन
अवाचीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣ ದೇಶದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>अवाक् - "खः" (५-४-८)<br><b>व्युत्पत्तिः - </b>अवाच्याम् भवः<br><b>विस्तारः - </b>ಅಮರಕಾರನು ದಕ್ಷಿಣ ಮೊದಲಾದ ದಿಕ್ಕಿನಲ್ಲಿರುವ ಎಂಬ ಅರ್ಥದಲ್ಲಿ "अवाग्भवमवाचीनमुदीचीनमुदग्भवम् । प्रत्यग्भवं प्रतीचीनं प्राचीनं प्राग्भवं त्रिषु ॥" ಹೇಳಿರುತ್ತಾನೆ ."विभाषाञ्चेरदिक् स्त्रियाम्" (पा० सू० ५-४-८) ಎಂಬ ಸೂತ್ರದಿಂದ ಈ ಅರ್ಥದಲ್ಲಿ ಖ ಪ್ರತ್ಯಯವನ್ನು ವಿಧಿಸಿರುವುದಿಲ್ಲ.<br><br>

अवाच्य
अवाच्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಮಾತು<br><b>निष्पत्तिः - </b>वच (परिभाषणे० - "ण्यत्" (३-१-१२४)<br><b>व्युत्पत्तिः - </b>न वक्तुं योग्यम्<br><b>प्रयोगाः - </b>"अवाच्यं वदतो जिह्वां कथं न पतिता तव"<br><b>उल्लेखाः - </b>रामा०<br><br>अवाच्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲು ಅನರ್ಹವಾದ<br><br>अवाच्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲು ಅಶಕ್ಯವಾದ<br><br>अवाच्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿಧಾವೃತ್ತಿಯಿಂದ ತಿಳಿಸಲು ಆಗದ<br><br>

अवाञ्चित
अवाञ्चित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + अञ्चु (गतौ) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"तृणवाञ्छया मुहुरवाञ्चिताननान्निचयेषु यत्र हरिताश्मवेश्मनाम्"<br><b>उल्लेखाः - </b>माघ० १३-५६<br><br>

अवान्तर
अवान्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಧಾನಕಾರ್ಯದ ಮಧ್ಯೆ ಬರುವ ಕಾರ್ಯ<br><b>व्युत्पत्तिः - </b>अवगतमन्तरं मध्यम्<br><br>

अवान्तरदिश्
अवान्तरदिश्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿದಿಕ್ಕು /ಈಶಾನ್ಯ ಮೊದಲಾದ ಮೂಲೆ ದಿಕ್ಕುಗಳು<br><b>व्युत्पत्तिः - </b>अवान्तरा द्वयोर्दिशयोर्मध्ये दिक्<br><br>

अवान्तरदेश
अवान्तरदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಡುಭಾಗ /ಮಧ್ಯಪ್ರದೇಶ<br><br>

अवापित
अवापित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿತ್ತಲ್ಪಡುವ /ಬೀಜವನ್ನು ಬಿತ್ತದೆ ನೆಟ್ಟು ಬೆಳೆಸಲ್ಪಟ್ಟ ಗಿಡ<br><br>अवापित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸಲ್ಪಡದ ಕೂದಲು<br><b>निष्पत्तिः - </b>डुवप् (बीजसन्ताने) + णिच् - "क्तः" (३-२-१०२)<br><br>अवापित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + आप्लृ (व्याप्तौ) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"फणिभाषितभाष्यफक्किका विषमा कुण्डलनामवापिता"<br><b>उल्लेखाः - </b>नैष० २-९५<br><br>

अवाप्त
अवाप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಟ್ಟ /ಪಡೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + आप्लृ (व्याप्तौ) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"नानावाप्तमवाप्तव्यं वर्त एव च कर्मणि"<br><b>उल्लेखाः - </b>गीता० ३-२२<br><br>

अवाप्तव्य
अवाप्तव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಡುವ /ಅವಶ್ಯವಾಗಿ ಪಡೆಯಬೇಕಾದ<br><b>निष्पत्तिः - </b>अव + आप्लृ (व्याप्तौ) - "तव्यः" (३-१-९६)<br><b>प्रयोगाः - </b>"अनवाप्तमवाप्तव्यं न ते किञ्चन विद्यते"<br><b>उल्लेखाः - </b>रघु० १०-३१<br><br>

अवाप्ति
अवाप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಂದುವಿಕೆ /ಪಡೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + आप्लृ (व्याप्तौ) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"तपः किलेदं तदवाप्तिसाधनं मनोरथानामगतिर्न विद्यते"<br><b>उल्लेखाः - </b>कुमा० ५-६४<br><br>

अवाप्य
अवाप्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಡುವ /ಹೊಂದಬೇಕಾದ<br><b>निष्पत्तिः - </b>अव + आप्लृ (व्याप्तौ) - "ण्यत्" (३-१-१२४)<br><b>प्रयोगाः - </b>"ज्येष्ठता च निवर्तेत ज्येष्ठावाप्यं च यद्धनम्"<br><b>उल्लेखाः - </b>मनु० ११-१८५<br><br>अवाप्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿ /ಪಡೆದು<br><b>निष्पत्तिः - </b>अव + आप्लृ (व्याप्तौ) - "ल्यप्" (७-१-३७)<br><br>

अवाम
अवाम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಲಭಾಗ<br><b>व्युत्पत्तिः - </b>न वामम्<br><br>अवाम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಕೂಲವಾದ /ಪ್ರತಿಕೂಲವಲದ<br><br>अवाम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಂದರವಲ್ಲದ<br><br>

अवाय
अवाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗ /ಅವಯವ<br><b>निष्पत्तिः - </b>अव + इण् (गतौ) - "घञ्"<br><br>

अवार
अवार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನದಿಯ ಸಮೀಪದ ದಡ /ಹೊಳೆಯ ಈಚೆ ದಡ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - कर्म० "घञ्" (३-३-१९) । वा "अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>अवाक्तीरम् अव अर्यते । न वार् अस्त्यत्र ।<br><br>

अवारण
अवारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಡೆಯಿಲ್ಲದಿರುವಿಕೆ /ಅಡ್ಡಿಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अवारण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न वारणं यस्य<br><br>

अवारणीय
अवारणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಯಲಾಗದ /ಅಡ್ಡಿಪಡಿಸಲಾಗದ<br><b>व्युत्पत्तिः - </b>न वारयितुं शक्यः<br><br>अवारणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಗಲಾಡಿಸಲು ಶಕ್ಯವಿಲ್ಲದ<br><br>

अवारपार
अवारपार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ /ಕಡಲು<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>अवारं पारं च अर्वाक्तीरम् उत्तरतीरं च स्तः अस्य<br><br>

अवारपारीण
अवारपारीण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೀರವನ್ನು ಮುಟ್ಟುವ /ದಡವನ್ನು ತಲುಪುವ<br><b>निष्पत्तिः - </b>"खः" (४-२-९३)<br><b>व्युत्पत्तिः - </b>अवारपारे गच्छति<br><br>

अवारित
अवारित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಯಲ್ಪಡದ /ಅಡ್ಡಿಪಡಿಸಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न वारितः<br><b>प्रयोगाः - </b>"ग्रामेषु सैन्यैरकरोदवारितैः किमव्यवस्थां चलितोऽपि केशवः"<br><b>उल्लेखाः - </b>माघ० १२-३६<br><br>

अवारीण
अवारीण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನದಿಯ ಈಚೆ ದಡವನ್ನು ಮುಟ್ಟುವ<br><b>निष्पत्तिः - </b>"खः" (वा० ४-२-९३)<br><b>व्युत्पत्तिः - </b>अवारमर्वाक्तीरं गच्छति<br><br>

अवार्य
अवार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಯಲಾಗದ /ಅಡ್ಡಿಪಡುಸಲಾಗದ<br><br>अवार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿವಾರಿಸಲಾಗದ /ಗುಣಪಡಿಸಲಾಗದ<br><b>प्रयोगाः - </b>"उपद्रवैस्तु ये जुष्टा व्याधयो यान्त्यवार्यताम्"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

अवावट
अवावट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಜಾತೀಯ ಹೆಂಗಸಿನಲ್ಲಿ ಉಪಪತಿಯಿಂದ ಹುಟ್ಟಿದ ಮಗ<br><b>प्रयोगाः - </b>"द्वितीयेन तु यः पित्रा सवर्णायां प्रजायते । अवावट इति ख्यातो शूद्रधर्मा स जातितः ॥"<br><b>उल्लेखाः - </b>स्मृतिः<br><br>

अवासस्
अवासस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಗ್ನ /ದಿಗಂಬರ<br><b>व्युत्पत्तिः - </b>नास्ति वासो वस्त्रं यस्य<br><br>

अवास्तव
अवास्तव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಜವಲ್ಲದ /ಸುಳ್ಳಾದ<br><br>अवास्तव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯವಾದ /ಯುಕ್ತಿಗೆ ವಿರುದ್ಧವಾದ<br><b>व्युत्पत्तिः - </b>न वास्तवम्<br><br>

अवि
अवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>अव (रक्षणादौ) - "इन्" (उ० ४-११७)<br><b>व्युत्पत्तिः - </b>अवति<br><br>अवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಕವೃಕ್ಷ /ಎಕ್ಕದ ಗಿಡ<br><br>अवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರಿ /ಟಗರು<br><b>प्रयोगाः - </b>"महान्त्यपि समृद्धानि गोऽजाविधनधान्यतः । स्त्रीसम्बन्धे दशैतानि कुलानि परिवर्जयेत् ॥"<br><b>उल्लेखाः - </b>मनु० ३-६<br><br>अवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತ /ಬೆಟ್ಟ<br><br>अवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜಮಾನ<br><br>अवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಲಿಯ ಚರ್ಮದ ಕಂಬಳಿ<br><b>विस्तारः - </b>"अविर्नाथे रवौ मेषे शैलमूषिककम्बले" - मेदि० ।<br><br>अवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಕಾರ /ಮನೆಯ ಸುತ್ತುಗೋಡೆ<br><br>अवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆ<br><br>अवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂತಿ /ಪ್ರಕಾಶ<br><br>अवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯು /ಗಾಳಿ<br><br>अवि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿ<br><br>अवि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಋತುಮಯಾದ ಹೆಂಗಸು /ರಜಸ್ವಲೆ<br><br>अवि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುರಿ /ಟಗರು<br><b>विस्तारः - </b>"अविर्ना पर्वते सूर्ये मेषे मूषिककम्बले । प्राकारे भवने भासि स्त्री तु पुण्यवतीभुवोः" - नानार्थर० । "अविर्भूपुण्यवत्योः स्त्री वायुप्राकारभाःसु ना" - वैज० । "मेषी स्यात् जालकिन्यविः" - त्रिकाण्ड० ।<br><br>

अविक
अविक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अवि - स्वार्थे "कः" (५-४-२८)<br><br>

अविकट
अविकट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರಿಗಳ ಮಂದೆ /ಟಗರುಗಳ ಗುಂಪು<br><b>निष्पत्तिः - </b>"कटच्" (वा० ५-२-२९)<br><b>व्युत्पत्तिः - </b>अवीनां सङ्घातः<br><br>अविकट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಗ್ರವಲ್ಲದ /ಸೌಮ್ಯನಾದ<br><b>व्युत्पत्तिः - </b>न विकटः<br><br>

अविकटोरण
अविकटोरण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಟಗರುಗಳ ಗುಂಪಿನಿಂದ ರಾಜನಿಗೆ ಕೊಡಬೇಕಾದ ಟಗರು ರೂಪವಾದ ಕಪ್ಪ /ಕಾಣಿಕೆ<br><b>व्युत्पत्तिः - </b>अविकटे मेषसङ्घाते देयः उरणः<br><br>

अविकत्थन
अविकत्थन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆತ್ಮಶ್ಲಾಘನೆ ಮಾಡಿಕೊಳ್ಳುವವನು<br><b>व्युत्पत्तिः - </b>न विकत्थनः<br><b>प्रयोगाः - </b>"विद्वांसोऽप्यविकत्थना भवन्ति"<br><b>उल्लेखाः - </b>मुद्रा० ३<br><br>

अविकल
अविकल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣವಾದ /ಊನವಲ್ಲದ /ಕೆಡದಿರುವ<br><b>व्युत्पत्तिः - </b>न विकलः<br><b>प्रयोगाः - </b>"इहायातः सम्प्रत्यविकलशरच्चन्द्रवदनः"<br><b>उल्लेखाः - </b>मालती० २-११<br><br>अविकल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ರಮಬದ್ಧವಾದ /ನಿಯಮಾನುಸಾರವಾದ /ಅಸಂಗತವಲ್ಲದ<br><b>प्रयोगाः - </b>"गतमनुगतवीणैरेकतां वेणुनादैः कमलविकलतालं गायकैर्बोधहेतोः"<br><b>उल्लेखाः - </b>माघ० ११-१०<br><br>अविकल<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣವಾಗಿ<br><b>प्रयोगाः - </b>"रक्षोभिः सुरमनुजैर्दितैः सुतैर्वा यल्लोकेष्वविकलमाप्तमाधिपत्यम्"<br><b>उल्लेखाः - </b>किरा० १८-३६<br><br>

अविकल्प
अविकल्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಕಲ್ಪವಿಲದಿರುವಿಕೆ /ಇದು ಅಥವಾ ಅದು ಎಂಬ ಬದಲಾವಣೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अविकल्प<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಕಲ್ಪವಿಲ್ಲದ<br><br>अविकल्प<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ವಿಕಲ್ಪವಿಲ್ಲದಂತೆ /ಅನುಮಾನಕ್ಕೆ ಎಡೆಯಿಲ್ಲದಂತೆ<br><br>

अविकार
अविकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಕಾರವಿಲ್ಲದಿರುವಿಕೆ /ಬದಲಾವಣೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अविकार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಕಾರವಿಲ್ಲದ /ಬದಲಾವಣೆಯಿಲ್ಲದ<br><br>

अविकार्य
अविकार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಕಾರ ಹೊಂದದ /ಬದಲಾವಣೆ ಹೊಂದಲು ಯೋಗ್ಯವಲ್ಲದ /ಸ್ವಸ್ವರೂಪದ ವಿಕಾರವನ್ನು ಹೊಂದುವ ಸುವರ್ಣಾದಿಗಳಂತೆ ಯಾವ ವಿಕಾರವನ್ನೂ ಹೊಂದದ<br><b>व्युत्पत्तिः - </b>न विकार्यः<br><b>प्रयोगाः - </b>"अव्यक्तोऽयमचिन्त्योऽयमविकार्योऽयमुच्यते"<br><b>उल्लेखाः - </b>गीता० २-२५<br><br>

अविकृत
अविकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಕಾರ ಹೊಂದದ<br><b>व्युत्पत्तिः - </b>न विकृतः<br><br>

अविकृति
अविकृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಂಖ್ಯರು ಹೇಳುವ ಮೂಲಪ್ರಕೃತಿ<br><b>प्रयोगाः - </b>"मूलप्रकृतिरविकृतिः"<br><b>उल्लेखाः - </b>सां० का० ३<br><br>अविकृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಕಾರವಿಲ್ಲದಿರುವಿಕೆ /ಬದಲಾವಣೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अविकृति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಕಾರವಿಲ್ಲದ /ವಿಕಾರ ಹೊಂದದ<br><br>

अविक्रिय
अविक्रिय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಕಾರವಿಲ್ಲದ /ವಿಕಾರ ಹೊಂದದ<br><b>व्युत्पत्तिः - </b>नास्ति विक्रिया विकारो यस्य<br><b>प्रयोगाः - </b>"देशे देशे गुणेष्ववमस्थात्वमविक्रियः"<br><b>उल्लेखाः - </b>रघु० १०-१७<br><br>

अविक्रीत
अविक्रीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ರಯಕ್ಕೆ ತೆಗೆದುಕೊಂಡರೂ ನಿರ್ದಿಷ್ಟಕಾಲದಲ್ಲಿ ಹಿಂತಿರುಗಿಸಲು ಯೋಗ್ಯವಾದ ವಸ್ತು<br><b>प्रयोगाः - </b>"क्रीत्वा विक्रीय वा किञ्चित् यस्येहानुशयो भवेत् । सोऽन्तर्दशाहात्तद्द्रव्यं दद्यात् चैवाददीत वा ॥"<br><b>उल्लेखाः - </b>मनु० ८-२२२<br><br>

अविक्रेय
अविक्रेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಕ್ರಯಿಸಲು ಅನರ್ಹವಾದ /ಮಾರಲು ಯೋಗ್ಯವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न विक्रेतुं योग्यम्<br><br>

अविक्षत
अविक्षत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶ ಹೊಂದದ<br><br>अविक्षत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಡಿಸಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न विक्षतः<br><b>प्रयोगाः - </b>"विक्रेतुः प्रतिदेयं तत् तस्मिन्नेवाह्न्यविक्षतम्"<br><br>

अविगर्हित
अविगर्हित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿಸಲ್ಪಡದ /ದೂಷಿಸಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न विगर्हितः<br><br>

अविगीत
अविगीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿಸಲ್ಪಡದ /ದೂಷಿಸಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न विगीतः<br><br>

अविग्न
अविग्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮರಿಕೆ ಗಿಡ<br><br>अविग्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯಪಡದ /ಹೆದರದ<br><b>निष्पत्तिः - </b>ओ विजी (भयचलनयोः) - "क्तः" (३-४-७२)<br><br>

अविग्रह
अविग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿತ್ಯಸಮಾಸ<br><b>व्युत्पत्तिः - </b>नास्ति विग्रहो वृत्त्यर्थावबोधकं वाक्यं यस्य<br><br>अविग्रह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೇಹವಿಲ್ಲದ /ಶರೀರವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति विग्रहो देहो यस्य<br><b>प्रयोगाः - </b>"अविग्रहस्याप्यतुलेन हेतुना समेतभिन्नद्वमूर्ति तिष्ठतः"<br><b>उल्लेखाः - </b>किरा० १८-३३<br><br>अविग्रह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳುವಳಿಕೆಯಿಲ್ಲದ /ಅರಿವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति विशेषेण ग्रहो यस्य<br><br>

अविघ्न
अविघ्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಘ್ನವಿಲ್ಲದಿರುವಿಕೆ /ಅಡ್ಡಿಯಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>अव्ययी०<br><b>व्युत्पत्तिः - </b>विघ्नस्याभावः<br><b>प्रयोगाः - </b>"अविघ्नमस्तु ते स्थेयाः पितेव धुरि पुत्रिणाम्"<br><b>उल्लेखाः - </b>रघु० १-९१<br><br>अविघ्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಘ್ನವಿಲ್ಲದ /ತಡೆಯಿಲ್ಲದ /ಪ್ರತಿಬಂಧಕವಿಲದ<br><b>प्रयोगाः - </b>"सोऽहमविघ्नक्रियोपलभ्याय धर्मारण्यमिदमायातः"<br><b>उल्लेखाः - </b>शाकु० १<br><br>

अविचलित
अविचलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಲಿಸದಿರುವ /ಸ್ಥಿರವಾದ<br><b>व्युत्पत्तिः - </b>न विचलितः<br><b>प्रयोगाः - </b>"अविचलितमनोभिः साधकैर्मृग्यमाणः स जयति परिणद्धः शक्तिभिः शक्तिनाथः"<br><b>उल्लेखाः - </b>मालती० ५-१<br><br>

अविचार
अविचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಚಾರವಿಲ್ಲದಿರುವಿಕೆ /ಅವಿವೇಕ<br><b>व्युत्पत्तिः - </b>न विचारः<br><br>अविचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರಿಗಳು ಸಂಚರಿಸಲು ಯೋಗ್ಯವಾದ ದೇಶ<br><b>व्युत्पत्तिः - </b>अवीनां चारो यत्र<br><br>अविचार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಚಾರವಿಲ್ಲದ /ವಿಮರ್ಶೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न विचारो यत्र<br><br>

अविचारणीय
अविचारणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಮರ್ಶಿಸಲು ಯೋಗ್ಯವಲ್ಲದ /ವಿಚಾರ ಮಾಡಲು ಅರ್ಹವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न विचारयितुमर्हः<br><b>प्रयोगाः - </b>"प्रत्यग्रहीदग्रजशासनं तदाज्ञा गुरूणामविचारणीया"<br><b>उल्लेखाः - </b>रघु० १४-४६<br><br>

अविचारित
अविचारित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಮರ್ಶೆ ಮಾಡಲ್ಪಡದ /ಚೆನ್ನಾಗಿ ವಿಚಾರ ಮಾಡಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न विचारितः<br><br>अविचारित<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ವಿಚಾರ ಮಾಡದೆ<br><b>प्रयोगाः - </b>"स किं भृत्यः स किं मन्त्री य आदावेव भूपतिम् । युद्धोद्योगं स्वभूत्यागं निर्दिशत्यविचारितम् ॥"<br><b>उल्लेखाः - </b>हितो०<br><br>

अविचारिन्
अविचारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಚಾರ ಮಾಡದ /ಹಿಂದು ಮುಂದೆ ನೋಡದೆ ಕೆಲಸ ಮಾಡುವ<br><b>निष्पत्तिः - </b>"णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>न विचारयितुं शीलमस्य<br><br>

अविचारिणी
अविचारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಚಾರ ಮಾಡದ /ಹಿಂದು ಮುಂದೆ ನೋಡದೆ ಕೆಲಸ ಮಾಡುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अविचालित
अविचालित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಲಿಸಲ್ಪಡದ /ಕದಲಿಸಲ್ಪಡದ<br><br>अविचालित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೋಲಿಸಲ್ಪಡದ /ಜಯಶಾಲಿಯಾದ<br><b>व्युत्पत्तिः - </b>न विचालितः<br><b>प्रयोगाः - </b>"अविचालितचारुचक्रयोरनुरागादुपगूढयोः"<br><b>उल्लेखाः - </b>माघ० १६-७०<br><br>

अविचाल्य
अविचाल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಥಿರವಾದ /ಬದಲಾವಣೆ ಹೊಂದದ<br><b>व्युत्पत्तिः - </b>न विचाल्यः<br><b>प्रयोगाः - </b>"अविचाल्यमेतद्युक्तं तथ्यं च भवता वचः"<br><b>उल्लेखाः - </b>भा० वन०<br><br>

अविच्छिन्न
अविच्छिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆಯಾಗಿ ಮಾಡಲ್ಪಡದ /ಬೇರ್ಪಡಿಸಲ್ಪಡದ<br><br>अविच्छिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಖಂಡವಾದ /ನಿರಂತರವಾದ /ಎಡೆಬಿಡದ<br><b>व्युत्पत्तिः - </b>न विच्छिन्नः<br><b>प्रयोगाः - </b>"अन्वमीयत कल्याणं तस्याविच्छिन्नसन्तति"<br><b>उल्लेखाः - </b>रघु० १७-११<br><br>

अविच्छेद
अविच्छेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಚ್ಛೇದವಿಲ್ಲದಿರುವಿಕೆ /ನಿರಂತರವಾಗಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"गणैरविच्छेदनिरुद्धमाबभौ वनं निरुच्छ्वासमिवाकुलाकुलम्"<br><b>उल्लेखाः - </b>किरा० १४-३२<br><br>अविच्छेद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಡೆಬಿಡದ /ನಿರಂತರವಾದ<br><b>व्युत्पत्तिः - </b>न विच्छेदो यस्य<br><br>

अविज्ञात
अविज्ञात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ತಿಳಿಯಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न विज्ञातः<br><b>प्रयोगाः - </b>"अविज्ञातप्रबन्धस्य वचो वाचस्पतेरपि"<br><b>उल्लेखाः - </b>किरा० ११-४३<br><br>

अविज्ञातृ
अविज्ञातृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>"अविज्ञाता सहस्रांशुः"<br><b>उल्लेखाः - </b>वि० स०<br><br>अविज्ञातृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಿವಿಲ್ಲದವನು /ತಿಳುವಳಿಕೆಯಿಲ್ಲದವನು<br><br>

अविज्ञात्री
अविज्ञात्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಿಳುವಳಿಕೆಯಿಲ್ಲದವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अविज्ञेय
अविज्ञेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>न विज्ञातुं शक्यः<br><br>अविज्ञेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲು ಅಶಕ್ಯವಾದ<br><b>निष्पत्तिः - </b>अव (रक्षणादौ) - "क्तः" (३-१-१०२)<br><b>विस्तारः - </b>"त्राणं त्रातं रक्शितमवितं गोपायितं च गुप्तं च" - अम० ।<br><br>

अवित
अवित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಿಸಲ್ಪಟ್ಟ /ಕಾಪಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>विरोधे न त० ।<br><b>व्युत्पत्तिः - </b>न वितथम्<br><b>प्रयोगाः - </b>"तदवितथमवादीर्यन्मम त्वं प्रियेति प्रियजनपरिभुक्तं प्रतीतः यद्दुकूलं दधानः"<br><b>उल्लेखाः - </b>माघ० ११-३३<br><br>

अवितथ
अवितथ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಯ /ನಿಜ<br><b>प्रयोगाः - </b>"तथेति तस्यावितथं प्रतीतः प्रत्यग्रहीत् सङ्गरमग्रजन्मा"<br><b>उल्लेखाः - </b>रघु० ५-२६<br><br>अवितथ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಫಲವಾದ /ವ್ಯರ್ಥವಲ್ಲದ<br><b>प्रयोगाः - </b>"अवितथा वितथाः सखि मा गिरः"<br><b>उल्लेखाः - </b>माघ० ६-१८<br><br>अवितथ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸತ್ಯವಾದ /ನಿಜವಾದ<br><br>अवितथ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸತ್ಯವಾಗಿ /ನಿಜವಾಗಿ<br><br>

अवितृ
अवितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಕ /ಕಾಪಾಡುವವನು<br><b>निष्पत्तिः - </b>अव (रक्षणादौ) - "तृच्" (३-१-१३३)<br><br>

अवित्री
अवित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ಷಕಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अवित्त
अवित्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಸಿದ್ಧನಲ್ಲದವನು /ಹೆಸರು ಪಡೆಯದವನು<br><b>व्युत्पत्तिः - </b>न वित्तः प्रसिद्धः<br><br>अवित्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದರಿದ್ರ /ಬಡವ<br><b>व्युत्पत्तिः - </b>न वित्तं यस्य<br><br>

अवित्ति
अवित्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನಶೂನ್ಯತೆ /ಅರಿವಿಲ್ಲದಿರುವಿಕೆ<br><br>अवित्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಾರಿದ್ರ್ಯ /ಬಡತನ<br><br>अवित्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಂದದಿರುವಿಕೆ /ಪಡೆಯದಿರುವಿಕೆ<br><br>अवित्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜ್ಞಾನವಿಲ್ಲದ /ತಿಳುವಳಿಕೆಯಿಲ್ಲದ<br><br>अवित्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂರ್ಖ<br><br>अवित्ति<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಜ್ಞಾನವಿಲ್ಲದೆ<br><b>व्युत्पत्तिः - </b>नास्ति वित्तिः ज्ञानं यस्य<br><br>अवित्ति<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಪಾದನೆಯಿಲ್ಲದೆ<br><b>व्युत्पत्तिः - </b>नास्ति वित्तिर्लाभो यस्य<br><br>

अविथ्या
अविथ्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಾಜಿ ಗಿಡ<br><b>निष्पत्तिः - </b>"थ्यन्" (५-१-८)<br><b>व्युत्पत्तिः - </b>अविभ्यो हिता<br><br>

अविदग्ध
अविदग्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಂಕ /ದಡ್ಡ<br><b>व्युत्पत्तिः - </b>न विदग्धः<br><br>अविदग्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಸುಡಲ್ಪಡದ<br><br>

अविदित
अविदित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न विदितः<br><b>प्रयोगाः - </b>"अविदितगतयामा रात्रिरेव व्यरंसीत्"<br><b>उल्लेखाः - </b>उ० रा० १-२७<br><br>

अविदुग्ध
अविदुग्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುರಿಯ ಹಾಲು<br><b>व्युत्पत्तिः - </b>अवेः दुग्धम्<br><br>

अविदूर
अविदूर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಮೀಪ್ಯ /ಹತ್ತಿರ<br><br>अविदूर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದ /ಹತ್ತಿರದ<br><br>अविदूर<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಿಂದ /ಸಮೀಪದಲ್ಲಿ<br><br>

अविदूरेण
अविदूरेण<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಿಂದ /ಸಮೀಪದಲ್ಲಿ<br><br>

अविदूरतः
अविदूरतः<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಿಂದ /ಸಮೀಪದಲ್ಲಿ<br><br>

अविदूरे
अविदूरे<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪದಿಂದ /ಸಮೀಪದಲ್ಲಿ<br><br>

अविद्ध
अविद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೂತು ಕೊರೆಯಲ್ಪಡದ /ರಂಧ್ರ ಮಾಡಲ್ಪಡದ<br><b>निष्पत्तिः - </b>व्यध (ताडने) - "क्तः" (३-२-१०२)<br><br>

अविद्धकर्ण
अविद्धकर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯವನ /ಮ್ಲೇಚ್ಛ<br><br>

अविद्धकर्णी
अविद्धकर्णी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗುರುಶುಂಠಿ<br><br>

अविद्य
अविद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿದ್ಯೆಯಿಲ್ಲದ /ವಿದ್ಯಾಭ್ಯಾಸ ಮಾಡದ<br><b>व्युत्पत्तिः - </b>नास्ति विद्या ज्ञानं यस्य<br><b>प्रयोगाः - </b>"अविद्यानां तु सर्वेषामीहातश्चेद्धनं भवेत् । समस्तत्र विभागः स्यादपित्र्य इति धारणा ॥"<br><b>उल्लेखाः - </b>मनु० ९-२०५<br><br>

अविद्यमान
अविद्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಲ್ಲದಿರುವ<br><b>व्युत्पत्तिः - </b>न विद्यमानः<br><b>प्रयोगाः - </b>"अविद्यमाने पित्रंशे स्वांशादुद्धृत्य वा पुनः । अवश्यकार्याः संस्काराः भ्रातृभिः पूर्वसंस्कृतैः ॥"<br><br>

अविद्या
अविद्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಜ್ಞಾನ /ತಿಳಿಗೇಡಿತನ /ತಿಳುವಳಿಕೆಯಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>विरोधे न त० ।<br><b>व्युत्पत्तिः - </b>न विद्या<br><br>अविद्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶಿಷ್ಟಾದ್ವೈತಿಗಳ ಮತದಲ್ಲಿ ವಿದ್ಯೆಗಿಂತಲೂ ಬೇರೆಯಾದ ಕರ್ಮ<br><b>प्रयोगाः - </b>"तर्तुं मृत्युमविद्यया"<br><b>उल्लेखाः - </b>बृहदा०<br><br>अविद्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅದ್ವೈತಿಗಳ ಮತದಲ್ಲಿ ಜ್ಞಾನಕ್ಕೆ ವಿರೋಧಿಯಾದ ಅಜ್ಞಾನ /ಮಾಯೆ /ಭ್ರಾಂತಿ<br><br>अविद्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯೋಗಶಾಸ್ತ್ರದಲ್ಲಿ ೫ ವಿಧವಾದ ಕ್ಲೇಶಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"अनित्याशुचिदुःखानात्मसु नितुअशुचिसुखात्मख्यातिरविद्या"<br><b>उल्लेखाः - </b>पा० यो० सू० २-५<br><br>

अविधा
अविधा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಾಯ ಸಮಯದಲ್ಲಿ ಸಹಾಯಕ್ಕಾಗಿ ಕರೆಯಲು ಉಪಯೋಗಿಸುವ ಒಂದು ವಿಕಾರಸ್ವರದ ಶಬ್ದ<br><br>

अविधान
अविधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಯಮವಿಲ್ಲದಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"अविधानेन यत् कुर्यात् तत्सर्वं विफलं भवेत्"<br><br>अविधान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಯಮರಹಿತವಾದ /ಅಕ್ರಮವಾದ<br><br>

अविधि
अविधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ರಮ /ನಿಯಮವಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>अभावे न० त० ।<br><b>व्युत्पत्तिः - </b>न विधिः<br><b>प्रयोगाः - </b>"यजन्ते नाम यज्ञैस्ते दम्भेनाविधिपूर्वकम्"<br><b>उल्लेखाः - </b>गीता० १६-१७<br><br>अविधि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಯಮರಹಿತವಾದ /ಕ್ರಮಬದ್ಧವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न विधिर्यस्य<br><br>

अविधेय
अविधेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತೋಟಿಯಲ್ಲಿಡಲು ಸಾಧ್ಯವಿಲ್ಲದ /ಹೇಳಿದ ಮಾತಿನಂತೆ ನಡೆಯದ<br><b>निष्पत्तिः - </b>वि + डुधाञ् (धारणपोषणयोः) - "यत्" (३-१-९७)<br><b>व्युत्पत्तिः - </b>न विधातुं शक्यः<br><br>अविधेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಲು ಯೋಗ್ಯವಲ್ಲದ /ಮಾಡಲು ಸಾಧ್ಯವಲ್ಲದ<br><br>

अविधेयता
अविधेयता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಿಧೇಯತೆ /ಹೇಳಿದಂತೆ ನಡೆಯದಿರುವಿಕೆ /ಪ್ರತಿಕೂಲವಾಗಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>विधेयस्य भावः<br><b>प्रयोगाः - </b>"मम विमृशतः कार्यारम्भे विधेरविधेयतां सहजकुटिलां कौटिल्यस्य प्रचिन्तयतो मतिम्"<br><b>उल्लेखाः - </b>मुद्रा० ४-२<br><br>

अविन
अविन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅದಧ್ವರ್ಯು /ಯಾಗದಲ್ಲಿ ಯಜುರ್ವೇದವನ್ನು ಬಲ್ಲ ಋತ್ವಿಕ್ಕು<br><b>निष्पत्तिः - </b>अव (रक्षणे) - "इनच्" (उ० २-४७)<br><b>व्युत्पत्तिः - </b>अवति यज्ञम्<br><b>विस्तारः - </b>"अविनोऽध्वर्युः" - सि० कौ० ।<br><br>

अविनय
अविनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿನಯವಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>अभावे न० त० ।<br><b>व्युत्पत्तिः - </b>न विनयः<br><b>प्रयोगाः - </b>"अयमाचरत्यविनयं मुग्धासु तपस्विकन्यासु"<br><b>उल्लेखाः - </b>शाकु० १-२१<br><br>अविनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ವರ್ತನೆ /ಅಸಭ್ಯತೆ /ಅಪರಾಧ<br><b>प्रयोगाः - </b>"बहवोऽविनयान्नष्टा राजानः सपरिच्छदाः"<br><b>उल्लेखाः - </b>मनु० ७-४०<br><br>अविनय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿನಯವಿಲ್ಲದ /ಮರ್ಯಾದೆಯಿಲ್ಲದ /ಅಸಭ್ಯ<br><b>व्युत्पत्तिः - </b>न विनयो यस्य<br><br>

अविनश्वर
अविनश्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><b>निष्पत्तिः - </b>विरोधे न त० ।<br><b>व्युत्पत्तिः - </b>न विनश्चरः<br><br>अविनश्वर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶದ ಸ್ವಭಾವದ್ದಲ್ಲದ /ಸ್ಥಿರವಾದ /ನಿತ್ಯವಾದ<br><b>व्युत्पत्तिः - </b>विना ऋते न भावः स्थितिः<br><br>

अविनाभाव
अविनाभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದನ್ನು ಬಿಟ್ಟು ಇನ್ನೊಂದು ಇಲ್ಲದಿರುವಿಕೆ<br><br>अविनाभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ<br><br>

अविनाभूत
अविनाभूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಇನ್ನೊಂದನ್ನು ಬಿಡದೆ ಯಾವಾಗಲೂ ಸೇರಿಕೊಮ್ಡಿರುವ<br><b>व्युत्पत्तिः - </b>न विना व्यापकं विना भूतः स्थितः<br><br>

अविनाशिन्
अविनाशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಬ್ರಹ್ಮ /ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>न विनाशी<br><b>प्रयोगाः - </b>"अविनाशि तु तद्विद्धि येन सर्वमिदं ततम् । विनाशमव्ययस्यास्य न कश्चित् कर्तुमर्हति ॥"<br><b>उल्लेखाः - </b>गीता० २-१७<br><br>अविनाशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಶ್ವರವಲ್ಲದ /ಸ್ಥಿರವಲ್ಲದ<br><br>

अविनाशिनी
अविनाशिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अविनाशिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अविनीत
अविनीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಿಧೇಯ /ಅಂಕೆಯಲ್ಲಿಲ್ಲದ /ಹತೋಟಿಯಲ್ಲಿಲ್ಲದ<br><br>अविनीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ಧಟ /ದುಡುಕು ಸ್ವಭಾವದ<br><br>अविनीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಭ್ಯ /ಮರ್ಯಾದೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न विनीतः<br><b>प्रयोगाः - </b>"ववृते विनीतमविनीतशासिभिः"<br><b>उल्लेखाः - </b>माघ० १३-२४<br><br>अविनीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಶಿಕ್ಷಿತನಾದ /ಪಳಗಿಸಲ್ಪಡದ<br><b>प्रयोगाः - </b>"नाविनीतैः व्रजेत् धुर्यैः न च क्षुद्व्याधिपीडितैः । न भिन्नशृङ्गाक्षिखुरैर्न वालधिविरूपितैः ॥"<br><b>उल्लेखाः - </b>मनु० ४-६७<br><br>

अविनीता
अविनीता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವೈರಿಣಿ /ವ್ಯಭಿಚಾರಿಣಿ<br><br>

अविनीय
अविनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಟವಿಲ್ಲದ /ಹೃತ್ಪೂರ್ವಕವಾದ<br><b>व्युत्पत्तिः - </b>न विनीयः कल्कः यस्य<br><b>प्रयोगाः - </b>"अविनीयसम्भ्रमविकासिभक्तिभिः"<br><b>उल्लेखाः - </b>माघ० १३-२४<br><br>

अविनेय
अविनेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಕ್ಷಿಸಲು ಅಶಕ್ಯವಾದ /ಅಡಗಿಸಲು ಸಾಧ್ಯವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न विनेतुं शक्यः<br><br>

अविपाक
अविपाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಫಲರೂಪವಾಗಿ ಪರಿಣಮಿಸದ ಪಾಪ ಪುಣ್ಯಗಳು /ಫಲೋನ್ಮುಖವಾಗದ ಧರ್ಮಾಧರ್ಮಗಳು<br><b>निष्पत्तिः - </b>वि + डुपचष् (पाके) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>विशेषेण पच्यन्ते फलरूपेण<br><br>अविपाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಕವಾಗದಿರುವಿಕೆ /ತಿಂದ ಆಹಾರವು ಜೀರ್ಣವಾಗದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>नास्ति विपाको यत्र<br><br>अविपाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಬೇಯದಿರುವಿಕೆ /ಅನ್ನವು ಸರಿಯಾಗಿ ಪಕ್ವವಾಗದಿರುವಿಕೆ<br><br>

अविपाल
अविपाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುಬ /ಕುರಿಯನ್ನು ಕಾಪಾಡುವವನು<br><b>निष्पत्तिः - </b>पाल (रक्षणे) + णिच् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>अवीन् पालयति<br><br>

अविपुल
अविपुल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೊಡ್ಡದಲ್ಲದ /ಸಣ್ಣದಾದ /ಚಿಕ್ಕದಾದ<br><br>

अविप्लुत
अविप्लुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಷ್ಟವಾಗದ /ನಾಶ ಹೊಂದದ<br><b>व्युत्पत्तिः - </b>न विप्लुतः नष्टः<br><b>प्रयोगाः - </b>"अविप्लुतब्रह्मचर्यः सवर्णां स्त्रियमुद्वहेत्"<br><br>

अविभक्त
अविभक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಮಾದಲ್ಪಡದ /ಒಟ್ಟಿಗೆ ಸೇರಿರುವ<br><b>प्रयोगाः - </b>"अविभक्तं स्थावरं यत् सर्वेषामेव तद्भवेत्"<br><br>अविभक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಾಗ ಹೊಂದದ /ಆಸ್ತಿಯನ್ನು ಪಾಲುಮಾಡಿಕೊಳ್ಳದೆ ಒಂದೇ ಕುಟುಂಬದಲ್ಲಿರುವ ಸೋದರರು<br><b>प्रयोगाः - </b>"अविभक्ता विभक्ता वा सपिण्डाः स्थावरे समाः"<br><br>अविभक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಡೆಯಲ್ಪಡದ<br><br>अविभक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಟ್ಟಿಗೆ ಸೇರಿಕೊಂಡಿರುವ<br><br>अविभक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿವೇಕಶೂನ್ಯನಾದ /ವಿವೇಚನೆಯಿಲ್ಲದ<br><br>अविभक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಹಸ್ಯವಾಗಿಲ್ಲದ /ಜನನಿಬಿಡವಾದ<br><b>व्युत्पत्तिः - </b>न विविक्तम्<br><br>अविभक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಿಶುದ್ಧವಲ್ಲದ<br><b>विस्तारः - </b>"विविक्तं त्रिष्वसम्पृक्ते रहःपूतविवेकिषु" - मेदि०<br><br>अविभक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿವೇಚನೆಯಿಂದ ಬೇರೆ ಬೇರೆಯಾಗಿ ತಿಳಿಯಲ್ಪಡದ<br><br>

अविभावित
अविभावित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಪಡದ<br><br>अविभावित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯೋಚಿಸಲ್ಪಡದ<br><br>अविभावित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न विभावितः<br><b>प्रयोगाः - </b>"अविभावितेषु विषयः प्रथमं मदनोऽपि नूनमभवत्तमसा"<br><b>उल्लेखाः - </b>माघ० ९-४०<br><br>

अविमुक्त
अविमुक्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶೀಕ್ಷೇತ್ರ<br><b>व्युत्पत्तिः - </b>न विमुक्तम्<br><b>प्रयोगाः - </b>"मुने प्रलयकालेऽपि न तत्क्षेत्रं कदाचन । विमुक्तं न शिवाभ्यां यदविमुक्तं ततो विदुः ॥"<br><b>उल्लेखाः - </b>काशीखं<br><br>अविमुक्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಗೂ ಗಲ್ಲಕ್ಕೂ ನಡುವಣ ಭಾಗ<br><b>प्रयोगाः - </b>"य एषोऽनन्तोऽव्यक्त आत्मा सोऽविमुक्ते प्रतिष्ठितः"<br><b>उल्लेखाः - </b>जा० उ०<br><br>अविमुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿದಲ್ಪಡದ /ತ್ಯಜಿಸಲ್ಪಡದ<br><br>

अविमृष्य
अविमृष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಚಾರ ಮಾಡಲು ಯೋಗ್ಯವಲ್ಲದ /ಸಂದೇಹಪಡಲು ಅವಕಾಶವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न विमृष्यम्<br><b>प्रयोगाः - </b>"अविमृष्यमेतदभिलष्यति स द्विषतां वधेन विषयाभिरतिम्"<br><b>उल्लेखाः - </b>किरा० ६-४४<br><br>

अवियुक्त
अवियुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆಯಾಗಿಲ್ಲದ /ಅಗಲದಿರುವ /ಯಾವಾಗಲೂ ಸೇರಿಕೊಂಡಿರುವ<br><b>व्युत्पत्तिः - </b>न वियुक्तः<br><br>

अवियोग
अवियोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಯೋಗವಿಲ್ಲದಿರುವಿಕೆ /ಅಗಲದಿರುವಿಕೆ<br><br>अवियोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ /ಸೇರಿಕೊಂಡಿರುವಿಕೆ<br><br>अवियोग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಯೋಗವಿಲ್ಲದ<br><br>अवियोग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ ಹೊಂದಿರುವ /ಸೇರಿಕೊಂಡಿರುವ<br><b>व्युत्पत्तिः - </b>न वियोगो यस्य<br><br>

अवियुयोव्रत
अवियुयोव्रत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪತಿ ಪತ್ನಿಯರು ಅಗಲದಿರಲು ಮಾರ್ಗಶೀರ್ಷ ಶುಕ್ಲ ತೃತೀಯಾ ದಿವಸ ಮಾಡುವ ಒಂದು ವ್ರತ<br><br>

अविरत
अविरत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿರಾಮವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>विरतं विरामः । न विरामः ।<br><br>अविरत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿರಾಮವಿಲ್ದ /ನಿಲುಗಡೆಯಿಲ್ಲದ<br><br>अविरत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಸ್ಯೂತವಾದ /ಎಡೆಬಿಡದೆ ನಡೆಯುವ<br><b>प्रयोगाः - </b>"अविरतरतलीलायासजातश्रमाणामुपशममुपयान्तं निःसहेऽङ्गेऽङ्गनानाम्"<br><b>उल्लेखाः - </b>माघ० ११-१७<br><br>अविरत<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಎಡೆಬಿಡದೆ /ನಿರಂತರವಾಗಿ<br><b>प्रयोगाः - </b>"अविरतोज्झितवारिविपाण्डुभिर्विरहितैरचिरद्युतितेजसा"<br><b>उल्लेखाः - </b>किरा० ५-६<br><br>

अविरति
अविरति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿರಾಮವಿಲ್ಲದಿರುವಿಕೆ<br><br>अविरति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಡೆಬಿಡದ ಸಂಬಂಧ /ನಿರಂತರತೆ<br><br>अविरति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಯಾಭಿಲಾಷೆ /ಅತಿಕಾಮುಕತೆ<br><b>निष्पत्तिः - </b>वि + रमु (क्रीडायाम्) - भावे "क्तिन्" (३-३-९४)<br><b>व्युत्पत्तिः - </b>विरामो विरतिः<br><br>अविरति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿರಾಮವಿಲ್ಲದ /ಎಡೆಬಿಡದ<br><b>व्युत्पत्तिः - </b>नास्ति विरतिर्यस्य<br><br>

अविरल
अविरल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಬಿಡವಾದ /ಸಾಂದ್ರವಾದ<br><b>व्युत्पत्तिः - </b>न विरलः<br><b>प्रयोगाः - </b>"अध्यूषुश्च्युतकुसुमाचितां सहाया वृत्रारेरविरलशाद्वलां धरित्रीम्"<br><b>उल्लेखाः - </b>किरा० ७-२६<br><br>अविरल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇರಿಕೊಂಡಿರುವ /ಹೊಂದಿಕೊಂಡಿರುವ<br><br>अविरल<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ನಿಬಿಡವಾಗಿ /ಸಾಂದ್ರವಾಗಿ<br><b>प्रयोगाः - </b>"सम्भिन्नामविरलपातिभिर्मयूखैर्नीलानां भृशमुपमेखलं मणीनाम्"<br><b>उल्लेखाः - </b>किरा० ७-२३<br><br>

अविराम
अविराम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿರಾಮವಿಲ್ಲದಿರುವಿಕೆ<br><br>अविराम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿರಾಮವಿಲ್ಲದ /ತಡೆಯಿಲ್ಲದ<br><b>प्रयोगाः - </b>"अनिमिषमविरामा रागिणां सर्वरात्रं नवनिधुवनलीलाः कौतुकेनातिवीक्ष्य"<br><b>उल्लेखाः - </b>माघ० ११-१८<br><br>अविराम<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಎಡೆಬಿಡದೆ /ನಿರಂತರವಾಗಿ<br><br>

अविरुद्ध
अविरुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿರೋಧವಿಲ್ಲದ<br><br>अविरुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಯಲ್ಪಡದ<br><br>अविरुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಗುಣವಾದ /ಅನುರೂಪವಾದ<br><b>व्युत्पत्तिः - </b>न विरुद्धः<br><br>

अविरोध
अविरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮ್ಮತಿ /ಒಪ್ಪಿಗೆ<br><br>अविरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಡ್ಡಿಯಿಲ್ಲದಿರುವಿಕೆ /ತಡೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अविरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಗುಣ್ಯ /ಸಾಮಂಜಸ್ಯ<br><b>व्युत्पत्तिः - </b>न विरोधः<br><b>प्रयोगाः - </b>"श्रुतिस्मृतिविरोधे तु श्रुतिरेव गरीयसी । अविरोधे तयोः कार्यं स्मार्तं वैदिकवत् सदा ॥"<br><b>उल्लेखाः - </b>स्मृतिः<br><br>

अविलक्षण
अविलक्षण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೇದವಿಲ್ಲದ /ವ್ಯತ್ಯಾಸವಿಲ್ಲದ<br><b>निष्पत्तिः - </b>विरोधे न० त० ।<br><b>व्युत्पत्तिः - </b>न विलक्षणः<br><br>

अविलक्ष्य
अविलक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಯವಿಲ್ಲದ /ಗುರಿಯಿಲ್ಲದ<br><br>अविलक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ದೇಶವಿಲ್ಲದ<br><br>अविलक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪತವಿಲ್ಲದ<br><br>अविलक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತೀಕಾರವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति विशेषेण लक्ष्यं व्याजः उद्देश्यं शरव्यं वा यस्य<br><br>

अविलम्ब
अविलम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೀಘ್ರತೆ<br><b>व्युत्पत्तिः - </b>न विलम्बः<br><br>अविलम्ब<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಲಂಬವಿಲ್ಲದ /ಸಾವಕಾಶವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति विलम्बो यस्य<br><br>अविलम्ब<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ತಡೆಯಿಲ್ಲದೆ /ಜಾಗ್ರತೆಯಾಗಿ<br><br>

अच्विलम्बित
अच्विलम्बित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡವಿಲ್ಲದ /ಸಾವಕಾಶವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न विलम्बितम्<br><br>अच्विलम्बित<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಜಾಗ್ರತೆಯಾಗಿ /ಶೀಘ್ರವಾಗಿ<br><br>

अविला
अविला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುರಿ<br><b>निष्पत्तिः - </b>अव (रक्षणे) - "इलच्" बाहु० ।<br><b>विस्तारः - </b>"मेषी तु कुररी रुजा । जालिकिन्यविला वेणी" - अभि० चि० ।<br><br>

अविवक्षित
अविवक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲು ಅಷ್ಟವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>वक्तुमिष्टम्<br><br>अविवक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ದೇಶವಿಲ್ಲದ<br><br>

अविवाद
अविवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿರುದ್ಧವಾದ ಮಾತಿಲ್ಲದಿರುವಿಕೆ /ಐಕಮತ್ಯ<br><b>व्युत्पत्तिः - </b>विरुद्धो वादः कथनं विवादः<br><br>अविवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯವಹಾರವಿಲ್ಲದಿರುವಿಕೆ /ಚರ್ಚೆಯಿಂದ ಜಗಳವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>विरुद्धो वादः व्यवहारः विवादः<br><br>अविवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿರೋಧವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>विरुद्धो वादः विवादः विरोधः<br><br>अविवाद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂದೇಹಕ್ಕೆ ಅವಕಾಶವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति विरुद्धो वादो यत्र<br><br>

अविवाहित
अविवाहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮದುವೆಯಾಗದ<br><b>व्युत्पत्तिः - </b>न विवाहितः<br><br>

अविवेक
अविवेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿವೇಕವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>विवेकः भेदकधर्मेण ज्ञानम्<br><b>प्रयोगाः - </b>"सहसा विवधीत न क्रियामविवेकः परमापदां पदम्"<br><b>उल्लेखाः - </b>किरा० २-३०<br><br>अविवेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುಡುಕು /ಆತುರಪಡುವಿಕೆ<br><br>अविवेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಜ್ಞಾನ /ತಿಳಿಗೇಡಿತನ<br><br>

अविवेकिन्
अविवेकिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಮರ್ಶೆ ಮಾದದ /ವಿವೇಕವಿಲ್ಲದ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>विवेकोऽस्यास्ति<br><br>अविवेकिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಿಥ್ಯಾಜ್ಞಾನವುಳ್ಳ /ಅಜ್ಞಾನಿ<br><br>अविवेकिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುಡುಕುವ /ಆತುರದ ಸ್ವಭಾವದ<br><br>

अविशेष
अविशेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯತ್ಯಾಸವಿಲ್ಲದಿರುವಿಕೆ /ಸಮಾನವಾಗಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न विशेषः भेदकधर्मः<br><br>अविशेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭೇದ /ಐಕ್ಯ /ತಾದಾತ್ಮ್ಯ<br><b>व्युत्पत्तिः - </b>नास्ति विशेषो यस्य<br><br>अविशेष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೇದವಿಲ್ಲದ /ವ್ಯತ್ಯಾಸವಿಲ್ಲದ<br><br>

अविशेषित
अविशेषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೇದವಿಲ್ಲದ /ವ್ಯಾವರ್ತಕಧರ್ಮದಿಂದ ಭೇದ ತೋರಿಸಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न विशेषितः<br><br>

अविश्रान्त
अविश्रान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿರಾಮವಿಲ್ಲದ<br><br>अविश्रान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸತತವಾದ /ಎಡೆಬಿಡದ<br><b>निष्पत्तिः - </b>वि + श्रमु (तपसि खेदे च) - "क्तः" (३-४-७२)<br><br>अविश्रान्त<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ವಿರಾಮವಿಲ್ಲದೆ<br><br>अविश्रान्त<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಸತತವಾಗಿ /ಅವಿಚ್ಛಿನ್ನವಾಗಿ /ಎಡೆಬಿಡದೆ<br><br>

अविश्वसनीय
अविश्वसनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಂಬಿಕೆಗೆ ಅರ್ಹನಲ್ಲದ /ನಂಬಿಕೆಯಿಡಲು ಯೋಗ್ಯನಲ್ಲದ<br><b>निष्पत्तिः - </b>वि + श्वस (प्राणने) - "अनीयर्" (३-१-९६)<br><b>व्युत्पत्तिः - </b>विश्वसितुं योग्यः<br><br>

अविश्वस्त
अविश्वस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಂಬದಿರುವ<br><b>व्युत्पत्तिः - </b>न विश्वस्तः<br><b>प्रयोगाः - </b>"न विश्वसेत् अविश्वस्ते विश्वस्ते नातिविश्वसेत्"<br><b>उल्लेखाः - </b>हितो०<br><br>

अविश्वास
अविश्वास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪನಂಬಿಕೆ /ನಂಬಿಕೆಯಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न विश्वासः<br><br>अविश्वास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶ್ವಾಸವಿಲ್ಲದ<br><br>अविश्वास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಂಬಲಾಗದ<br><b>व्युत्पत्तिः - </b>न विश्वासो यस्मिन्<br><br>

अविश्वासिन्
अविश्वासिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಂಬಿಕೆಯಿಡದಿರುವ /ನಂಬದಿರುವ<br><b>निष्पत्तिः - </b>वि + श्वस (प्राणने) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>न विश्वसिति<br><br>

अविष
अविष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ /ಕಡಲು<br><b>निष्पत्तिः - </b>अव (रक्षणे) "टिषच्" (उ० १-४५)<br><br>अविष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ /ದೊರೆ<br><br>अविष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಗನ /ಆಕಾಶ<br><br>अविष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಶಷರಹಿತವಾದ<br><br>अविष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಪಾಡುವ /ರಕ್ಷಕ<br><br>

अविषी
अविषी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನದಿ /ಹೊಳೆ<br><br>अविषी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಗ<br><br>अविषी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿ<br><br>

अविषय
अविषय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೋಚರವಾಗದಿರುವಿಕೆ<br><br>अविषय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಯವಾಗದಿರುವಿಕೆ /ಉದ್ದೇಶವಾಗದಿರುವಿಕೆ<br><br>अविषय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಣಿಸಿಕೊಳ್ಳದ /ಇಂದ್ರಿಯಕ್ಕೆ ಗೋಚರವಾಗದ<br><br>अविषय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ದೇಶವಲ್ಲದ /ಗುರಿಯಲ್ಲದ<br><b>प्रयोगाः - </b>"परिच्छेदातीतः सकलवचनानामविषयः पुनर्जन्मन्यस्मिन्ननुभवपथं यो न गतवान्"<br><b>उल्लेखाः - </b>मालती० १-३३<br><br>

अविषह्य
अविषह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಹಿಸಲು ಅಶಕ್ಯವಾದ /ಸಹಿಸಲಾಗದ<br><br>अविषह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಿಸಲಾಗದ<br><b>व्युत्पत्तिः - </b>न विशेषेण सह्यः<br><br>

अविष्टम्भ
अविष्टम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರವಿಲ್ಲದಿರುವಿಕೆ<br><br>अविष्टम्भ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति विष्टम्भो यस्य<br><br>

अविसंवाद
अविसंवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಗುಣವಾಗಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न विसंवादः प्रमाणाननुगुणः<br><br>

अविसंवादिन्
अविसंवादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಗುಣವಾಗಿರುವ /ಪ್ರಮಾಣಕ್ಕೆ ಸರಿಯಾಗಿರುವ<br><b>निष्पत्तिः - </b>विरोधे न० त० ।<br><b>व्युत्पत्तिः - </b>न विसंवादी<br><b>प्रयोगाः - </b>"अभिनन्दितवृत्तिरार्यमिश्रैरविसंवादिभिरागमोदितेषु"<br><b>उल्लेखाः - </b>याद० १५-९४<br><br>अविसंवादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಂಗುರವಾದ /ಭಂಗ ಹೊಂದದ /ನಾಶ ಹೊಂದದ<br><b>प्रयोगाः - </b>"अनुभाववता गुरुः स्थिरत्वादविसंवादि धनुर्धनञ्जयेन"<br><b>उल्लेखाः - </b>किरा० १३-१५<br><br>

अविसर्गिन्
अविसर्गिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿರಂತರವಾಗಿ ಕಾಯುವ ಜ್ವರ /ನಿಲ್ಲದೆ ಬರುತ್ತಿರುವ ಜ್ವರ<br><b>प्रयोगाः - </b>"सप्ताहं व दशाहं वा द्वादशाहमथापि वा । सन्तत्या योऽविसर्गी स्यात् सन्ततः स निगद्यते ॥"<br><b>उल्लेखाः - </b>सुश्रुत०<br><b>विस्तारः - </b>"अविसर्गी अविसर्जनशीलः"<br><br>अविसर्गिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡದಿರುವ /ಬಿಟ್ಟು ಹೋಗದಿರುವ<br><br>

अविस्पष्ट
अविस्पष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸ್ಪಷ್ಟವಾದ ಮಾತು /ಸ್ಫುಟವಲ್ಲದ ಮಾತು<br><b>व्युत्पत्तिः - </b>न विस्पष्टम्<br><br>

अविस्मरण
अविस्मरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರೆಯದಿರುವಿಕೆ /ನೆನಪು /ಸ್ಮರಣೆ<br><b>निष्पत्तिः - </b>अभावे न० त० ।<br><b>व्युत्पत्तिः - </b>न विस्मरणम्<br><br>

अविस्मृत
अविस्मृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರೆಯದಿರುವ /ಸ್ಮರಿಸಲ್ಪಟ್ಟ<br><br>

अविस्मृति
अविस्मृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಮರಣೆ /ಮರೆಯದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न विस्मृतिः<br><b>प्रयोगाः - </b>"अविस्मृतिस्त्वच्चरणारविन्दे भवे भवे मेऽस्तु भवत्प्रसादात्"<br><b>उल्लेखाः - </b>मु० मा०<br><br>

अविहित
अविहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಲ್ಪಡದ<br><br>अविहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರದಲ್ಲಿ ಹೇಳಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न विहितम्<br><br>

अवी
अवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಋತುಮತಿ /ರಜಸ್ವಲೆ<br><b>निष्पत्तिः - </b>अव (रक्षणे) - "ईः" (उ० ३-१५८)<br><b>व्युत्पत्तिः - </b>अवत्यात्मानं लज्जया<br><br>

अवीचि
अवीचि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನರಕ<br><b>प्रयोगाः - </b>"यस्त्विहानृतं वदति साक्ष्ये द्रव्यविनिमये दाने वा स वै प्रेत्य नरके अवीचिमत्यधःशिरा निरवकाशे स्थलमश्मपृष्ठमवभासते तदवीचिमतिलशो विशीर्यमाणशरीरो न म्रियमाणः पुनरारोपितो निपतति"<br><b>उल्लेखाः - </b>भाग० ५-२६<br><br>अवीचि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲೆಗಳಿಲ್ಲದ /ತರಂಗಗಳಿಲ್ಲದ<br><br>

अवीर
अवीर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಕ್ಕಳಿಲ್ಲದ<br><br>अवीर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣಿಗ /ಹೆಂಗಸಿನ ಸ್ವಭಾವದ<br><br>

अवीरा
अवीरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪತಿ ಮತ್ತು ಪುತ್ರರಿಲ್ಲದ ಹೆಂಗಸು<br><b>व्युत्पत्तिः - </b>न वीरा<br><b>प्रयोगाः - </b>"पतिपुत्रवती नारी वीरा प्रोक्ता मनीषिभिः"<br><br>

अवेक्षक
अवेक्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲ್ವಿಚಾರಣೆ ನಡೆಸುವವನು<br><br>अवेक्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೋಡುವವನು<br><br>अवेक्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರೀಕ್ಷಿಸುವವನು<br><br>अवेक्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯೋಚಿಸುವವನು<br><b>निष्पत्तिः - </b>अव + ईक्ष (दर्शने) - "ण्वुल्" (३-१-१३३)<br><br>

अवेक्षण
अवेक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದರ್ಶನ /ಅವಲೋಕನ<br><b>प्रयोगाः - </b>"दूरादवेक्षणं हासः सम्प्रश्ने सादरो भृशम् । परोक्षेऽपि गुणश्लाघा स्मरणं प्रियवस्तुषु ॥"<br><b>उल्लेखाः - </b>हितो०<br><br>अवेक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಚ್ಚರದಿಂದ ನೋಡುವುದು<br><br>अवेक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲ್ವಿಚಾರಣೆ ನಡೆಸುವುದು<br><br>अवेक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಮನಿಸುವುದು /ಆಸಕ್ತಿಯಿಂದ ನೋಡುವುದು<br><b>निष्पत्तिः - </b>अव + ईक्ष (दर्शने) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"निगृह्य शोकं स्वयमेव धीमान् वर्णाश्रमावेक्षणजागरूकः"<br><b>उल्लेखाः - </b>रघु० १४-८५<br><br>

अवेक्षणीय
अवेक्षणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡಲ್ಪಡುವ /ನೋಡಲು ಅರ್ಹವಾದ<br><b>निष्पत्तिः - </b>अव + ईक्ष (दर्शने) - "अनीयर्" (३-१-९६)<br><b>प्रयोगाः - </b>"निर्वासिताप्येवमतस्त्वयाहं तपस्विसामान्यमवेक्षणीया"<br><b>उल्लेखाः - </b>रघु० १४-६७<br><br>अवेक्षणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಲೋಚಿಸಲ್ಪಡುವ<br><br>

अवेक्षमाण
अवेक्षमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಲೋಕಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>अव + ईक्ष (दर्शने) - "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"स्फुटीभवद्ग्रामविशेषमूर्च्छनामवेक्षमाणं महतीं मुहुर्मुहुः"<br><b>उल्लेखाः - </b>माघ० १-१०<br><br>

अवेक्षा
अवेक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೋಡುವುದು<br><br>अवेक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಮನಿಸುವುದು /ಆಸಕ್ತಿಯಿಂದ ನೋಡುವುದು<br><br>अवेक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲ್ವಿಚಾರಣೆ ನಡೆಸುವುದು<br><br>अवेक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಚ್ಚರದಿಂದ ಕಾಯುವುದು<br><b>निष्पत्तिः - </b>अव + ईक्ष (दर्शने) - "अः" (३-३-१०२)<br><b>प्रयोगाः - </b>"अलब्धमिच्छेत् दण्डेन लब्धं रक्षेदवेक्षया । रक्षितं वर्धयेत् वृद्ध्या वृद्धं पात्रेषु निक्षिपेत् ॥"<br><b>उल्लेखाः - </b>मनु० ७-१०१<br><br>

अवेक्षित
अवेक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव + ईक्ष (दर्शने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अवेक्षितानायतवल्गमग्रे तुरङ्गिभिर्यत्ननिरुद्धवाहैः"<br><b>उल्लेखाः - </b>माघ० ३-३०<br><br>अवेक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಲೋಚಿಸಲ್ಪಟ್ಟ<br><br>

अवेक्षितृ
अवेक्षितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲ್ವಿಚಾರಣೆ ನಡೆಸುವ<br><br>अवेक्षितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡುವ<br><br>अवेक्षितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರೀಕ್ಷಿಸುವ<br><br>अवेक्षितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯೋಚಿಸುವ<br><b>निष्पत्तिः - </b>अव + ईक्ष (दर्शने) - "तृच्" (३-१-१३३)<br><br>

अवेक्षित्री
अवेक्षित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अवेक्षितृ ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अवेक्ष्य
अवेक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡಲು ಅರ್ಹವಾದ<br><br>अवेक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಲೋಚಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>अव + ईक्ष (दर्शने) - "ण्यत्" (३-१-१२४)<br><br>अवेक्ष्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನೋಡಿ<br><br>अवेक्ष्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಲೋಚಿಸಿ<br><b>निष्पत्तिः - </b>अव + ईक्ष (दर्शने) - "ल्यप्" (७-१-३७)<br><b>प्रयोगाः - </b>"अवेक्ष्य नूनं चतुरः पुमर्थाननन्यलभ्यानलभन्त पौराः"<br><b>उल्लेखाः - </b>याद० १३-६५<br><br>

अवेद्य
अवेद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲಾಗದ /ತಿಳಿಯಲು ಅಶಕ್ಯವಾದ<br><b>व्युत्पत्तिः - </b>न वेद्यः<br><br>अवेद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲು ಅಶಕ್ಯಬಾದ<br><br>

अवेद्या
अवेद्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮದುವೆಯಾಗಲು ಅರ್ಹಳಲ್ಲದ ಹೆಂಗಸು<br><b>प्रयोगाः - </b>"व्यभिचारेण वर्णानामवेद्यावेदनेन च । स्वकर्मणां च त्यागेन जायन्ते वर्णसङ्कराः ॥"<br><b>उल्लेखाः - </b>मनु० १०-२४<br><br>

अवेल
अवेल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಲಾಪ /ಸತ್ಯವನ್ನು ಅಡಗಿಸುವಿಕೆ<br><br>अवेल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇಳೆಯಿಲ್ಲದ /ಸಮಯವಿಲ್ಲದ<br><br>अवेल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲೆಯಿಲ್ಲದ /ಮೇರೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति वेला यत्र<br><br>

अवेला
अवेला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಕಾಲ /ಅಸಮಯ<br><br>अवेला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಡಿಕೆ ಪುಡಿ<br><b>विस्तारः - </b>"अवेलस्त्वालापे स्यादवेला पूर्णचूर्णके" - विश्व० ।<br><br>

अवैध
अवैध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಧಿಯಿಂದ ಪ್ರಾಪ್ತವಲ್ಲದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-७४)<br><b>व्युत्पत्तिः - </b>विधेरागतः<br><b>प्रयोगाः - </b>"अवैधं पञ्चमं कुर्वन् राज्ञो दण्डेन शुद्ध्यति"<br><br>

अवैधव्य
अवैधव्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌಮಂಗಲ್ಯ /ಪತಿಯೊಡನೆ ಕೂಡುವಿಕೆ<br><b>निष्पत्तिः - </b>अभावे न० त० ।<br><br>

अवैमत्य
अवैमत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಗ್ಗಟ್ಟು /ಐಕಮತ್ಯ<br><b>निष्पत्तिः - </b>अभावे न० त० ।<br><br>अवैमत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭಿನ್ನಾಭಿಪ್ರಾಯವಿಲ್ಲದಿರುವಿಕೆ<br><br>अवैमत्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಿನ್ನಾಭಿಪ್ರಾಯವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न वैमत्यं यत्र<br><br>

अवैयात्य
अवैयात्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧೈರ್ಯವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>वियातस्य भावः वैयात्यम् । न वैयात्यम्<br><br>अवैयात्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧೈರ್ಯವಿಲ್ಲದ<br><br>

अवैराग्य
अवैराग्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಯಾಭಿಲಾಷೆ /ವೈರಾಗ್ಯವಿಲ್ಲದಿರುವಿಕೆ<br><br>अवैराग्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಂಖ್ಯರು ಹೇಳುವ ಧರ್ಮಾಧರ್ಮಾದಿ ೮ ಪ್ರಕೃತಿಧರ್ಮಗಳಲ್ಲೊಂದು<br><b>व्युत्पत्तिः - </b>वैराग्यं विषयवितृष्णा । न वैराग्यम् ।<br><br>

अवोक्षण
अवोक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧ ಬಗ್ಗಿಸಿದ ಕೈಯಿಂದ ನೀರನ್ನು ಪ್ರೋಕ್ಷಿಸುವುದು<br><b>निष्पत्तिः - </b>अव + उक्ष (सेचने) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"उत्तानेनैव हस्तेन प्रोक्षणं परिकीर्तितम् । न्यञ्चताभ्युक्षणं प्रोक्तं तिरश्चावोक्षणं स्मृतम् ॥"<br><br>

अवोद
अवोद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ಚಿಮುಕಿಸುವುದು<br><b>निष्पत्तिः - </b>अव + उन्दी (क्लेदने) - भावे "घञ्" (३-३-१८)<br><br>अवोद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೇವವಾದ /ಒದ್ದೆಯಾದ<br><br>

अवोष
अवोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಸಿಯಾದ ಅನ್ನ<br><b>निष्पत्तिः - </b>अव + उष (दाहे) - कर्म० "कः" (३-१-१३५)<br><br>

अव्यक्त
अव्यक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>अव्यक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಮಹೇಶ್ವರ<br><br>अव्यक्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಂಖ್ಯರು ಹೇಳುವ ಪ್ರಧಾನ /ಮೂಲಪ್ರಕೃತಿ<br><br>अव्यक्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಜ್ಞಾನ<br><br>अव्यक्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ<br><br>अव्यक्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಷುಪ್ತ್ಯವಸ್ಥಾ<br><br>अव्यक्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜೀವ /ಆತ್ಮ<br><b>प्रयोगाः - </b>"अव्यक्तोऽयमचिन्न्त्योयमविकार्योऽयमुच्यते । तस्मादेवं विदित्वैनं नानुशोचितुमर्हति ॥"<br><b>उल्लेखाः - </b>गीता० २-२५<br><br>अव्यक्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಭಾವ<br><br>अव्यक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಪಷ್ಟವಲ್ಲದ /ಅಸ್ಫುಟವಾದ<br><b>प्रयोगाः - </b>"अव्यक्तवर्णरमणीयवचःप्रवृत्तिम्"<br><b>उल्लेखाः - </b>शाकु० ७-१७<br><br>अव्यक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗೋಚರವಾದ /ಕಣ್ಣಿಗೆ ಕಾಣಿಸದ<br><b>विस्तारः - </b>"अव्यक्तः शङ्करे विष्णावव्यक्तं महदादिके । आत्मन्यपि स्यात् अव्यक्तमस्फुटे त्वभिधेयवत्" - विश्व० ।<br><br>अव्यक्त<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಸ್ಫುಟವಾಗಿ<br><br>अव्यक्त<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಗೋಚರವಾಗಿ<br><br>

अव्यक्तराग
अव्यक्तराग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆಗೆಂಪು /ಉದಯ ಕಾಲದ ಕೆಂಪು<br><br>

अव्यक्तलिङ्ग
अव्यक्तलिङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂನ್ಯಾಸಿ<br><br>अव्यक्तलिङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಂಖ್ಯೋಕ್ತವಾದ ಮಹತ್ ತತ್ತ್ವ<br><b>व्युत्पत्तिः - </b>अयक्तस्य लिङ्गमनुमापकम्<br><br>अव्यक्तलिङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಲಕ್ಷಣಗಳು ತಿಳಿಯದ ರೋಗ<br><b>व्युत्पत्तिः - </b>अव्यक्तं लिङ्गमस्य<br><br>

अव्यग्र
अव्यग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಾಂತ /ಸ್ಥಿರಚಿತ್ತ<br><br>अव्यग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತತ್ಪರನಲ್ಲದ /ನಿರತನಲ್ಲದ<br><br>अव्यग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದಾಸೀನ /ತಟಸ್ಥ<br><br>

अव्यङ्ग
अव्यङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗಹೀನವಲ್ಲದ /ಸಂಪೂರ್ಣವಾದ<br><br>

अव्यङ्गा
अव्यङ्गा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಸುಗುನ್ನಿ ಗಿಡ<br><br>

अव्यञ्जन
अव्यञ्जन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಂಬಿಲ್ಲದ ಪಶು /ಕೊಂಬು ಹುಟ್ಟದಿರುವ ಹಸು ಮೊದಲಾದ ಪ್ರಾಣಿ<br><br>अव्यञ्जन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲಕ್ಷಣವಿಲ್ಲದ /ಗುರುತಿಲ್ಲದ<br><br>अव्यञ्जन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳ್ಳೆಯ ಲಕ್ಷವಿಲ್ಲದ<br><br>अव्यञ्जन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಂಜನಾವೃತ್ತಿಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति व्यञ्जना वृत्तिर्यत्र<br><br>

अव्यण्डा
अव्यण्डा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಸುಗುನ್ನಿ ಗಿಡ<br><b>निष्पत्तिः - </b>व्यथ (भयसञ्चलनयोः) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>नास्ति विगतमण्डं बीजमस्याः<br><br>

अव्यथ
अव्यथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ /ಹಾವು<br><b>प्रयोगाः - </b>"लब्धस्पर्शं भूव्यधादव्यथेन स्थित्वा किञ्चिद्दन्तयोरन्तराले"<br><b>उल्लेखाः - </b>माघ० १४-४७<br><br>अव्यथ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಥೆಯಿಲ್ಲದ /ದುಃಖವಿಲ್ಲದ<br><br>

अव्यथा
अव्यथा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶುಂಠಿ<br><br>अव्यथा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಳಲೆ ಕಾಯಿ<br><b>विस्तारः - </b>"अव्यथो निर्व्यथे सर्पे चारटीपथ्ययोः स्त्रियाम्" - मेदि० ।<br><br>अव्यथा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಟ್ಟದಾವರೆ<br><br>अव्यथा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುಃಖವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न व्यथा<br><br>

अव्यथिन्
अव्यथिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಥೆಯಿಲ್ಲದ /ದುಃಖವಿಲ್ಲದ<br><br>अव्यथिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯವಿಲ್ಲದ /ಹೆದರಿಕೆಯಿಲ್ಲದ<br><br>

अव्यथिष
अव्यथिष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>अव्यथिष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ<br><b>निष्पत्तिः - </b>व्यथ (भयसञ्चलनयोः) - "टिषच्" (उ० १-४९)<br><br>

अव्यथिषी
अव्यथिषी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾತ್ರಿ<br><br>अव्यथिषी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿ<br><b>विस्तारः - </b>"अव्यथिषोऽब्धिसूर्ययोः । अव्यथिषी धरारात्र्योः" - सि० कौ० ।<br><br>

अव्यपेक्षा
अव्यपेक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಜಾಗರೂಕತೆ<br><b>प्रयोगाः - </b>"बाष्पावसरा हेमकाज्चीगुणेन श्रोणीबिम्बादव्यपेक्षाच्युतेन"<br><b>उल्लेखाः - </b>माल० ३-२१<br><br>अव्यपेक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಏಕಾರ್ಥಿಭಾವರೂಪವಾದ ಸಾಮರ್ಥ್ಯ<br><br>

अव्यपेक्ष
अव्यपेक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕ ಅಪೇಕ್ಷೆಯಿಲ್ಲದ<br><br>

अव्यभिचरित
अव्यभिचरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಭಿಚಾರ ರೂಪವಾದ ದೋಷವಿಲ್ಲದ ಹೇತು<br><br>अव्यभिचरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕೂಲವಾದ /ವಿರೋಧವಿಲ್ಲದ<br><br>

अव्यभिचार
अव्यभिचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಲದಿರುವಿಕೆ /ಬೇರೆಯಾಗದಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"अन्योन्यस्याव्यभीचारो भवेदामरणान्तिकः"<br><b>उल्लेखाः - </b>मनु० ९-१०१<br><br>अव्यभिचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಧೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अव्यभिचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಲವಾಗಿರುವಿಕೆ<br><br>

अव्यभिचारिन्
अव्यभिचारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕೂಲವಾದ /ವಿರುದ್ಧವಲ್ಲದ<br><b>निष्पत्तिः - </b>वि + अभि + चर (गतिभक्षणयोः) - "णिनिः" (३-२-७८)<br><br>अव्यभिचारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸತ್ಯವಾದ /ನಿಜವಾದ<br><b>प्रयोगाः - </b>"यदुच्यते पार्वति पापवृत्तये न रूपमित्यव्यभिचारि तद्वचः"<br><b>उल्लेखाः - </b>कुमा० ५-३६<br><br>

अव्यभिचारिन्
अव्यभिचारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ವಲವಾದ /ಸ್ಥಿರವಾದ<br><br>

अव्यभिचारिणी
अव्यभिचारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अव्यभिचारिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><b>प्रयोगाः - </b>"भवेदभिचारिण्यो भर्तुरिष्टे पतिव्रताः"<br><b>उल्लेखाः - </b>कुमा० ६-८६<br><br>

अव्यय
अव्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>वि + इण् (गतौ) - "अच्" (३-३-५६)<br><b>व्युत्पत्तिः - </b>न वीयते न व्यपगम्यते चेतनोऽस्मात्<br><b>प्रयोगाः - </b>"अव्ययः पुरुषः साक्षी क्षेत्रज्ञोऽक्षर एव च"<br><b>उल्लेखाः - </b>वि० स०<br><br>अव्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಪರಮೇಶ್ವರ<br><br>अव्यय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಬ್ರಹ್ಮ<br><br>अव्यय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವ್ಯಯ /ಎಲ್ಲಾ ಲಿಂಗ ವಿಭಕ್ತಿ ಮತ್ತು ವಚನಗಳಲ್ಲಿಯೂ ಒಂದೇ ರೂಪವುಳ್ಳ ಶಬ್ದ<br><b>प्रयोगाः - </b>"सदृशं त्रिषु लिङ्गेषु सर्वासु च विभक्तिषु । वचनेषु च सर्वेषु यन्नव्येति तदव्ययम् ॥"<br><br>अव्यय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶ ಹೊಂದದ /ಶಾಶ್ವತವಾದ<br><br>अव्यय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯತ್ಯಾಸ ಹೊಂದದ<br><b>प्रयोगाः - </b>"वेदाविनाशिनं नित्यं य एनमजमव्ययम्"<br><b>उल्लेखाः - </b>गीता० २-२१<br><br>अव्यय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಾಶ್ವತ ಫಲವನ್ನು ಕೊಡುವ<br><br>अव्यय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಖರ್ಚಿಲ್ಲದ /ವ್ಯಯವಿಲ್ಲದ<br><br>

अव्ययात्मन्
अव्ययात्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶದ ಸ್ವಭಾವವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>अव्यय आत्मा स्वभावो यस्य<br><br>

अव्ययीभाव
अव्ययीभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವ್ಯಯವಲ್ಲದ ಶಬ್ದವನ್ನು ಅವ್ಯಯವನ್ನಾಗಿ ಮಾಡುವ ಒಂದು ಸಮಾಸ<br><b>निष्पत्तिः - </b>अव्यय + च्वि + भू (सत्तायाम्) - "घञ्" (३-३-२४)<br><b>व्युत्पत्तिः - </b>अनव्ययमव्ययं भवत्यनेन<br><b>प्रयोगाः - </b>"द्वन्द्वो द्विगुरपिचाहं मद्गेहे नित्यमव्ययीभावः । तत्पुरुष कर्मधारय येनाहं स्यां बहुव्रीहिः ॥"<br><br>

अव्यर्थ
अव्यर्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯರ್ಥವಲ್ಲದ /ಸಾರ್ಥಕವಲ್ಲದ<br><br>अव्यर्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಫಲವಾದ /ಕೈಗೂಡಿದ<br><b>व्युत्पत्तिः - </b>न व्यर्थः<br><br>

अव्यलीक
अव्यलीक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸತ್ಯವಾದ /ನಿಜವಾದ<br><br>अव्यलीक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿತವಾದ /ಪ್ರಿಯವಾದ<br><b>निष्पत्तिः - </b>विरोधे न० त० ।<br><b>व्युत्पत्तिः - </b>न व्यलीकः<br><b>प्रयोगाः - </b>"इत्थं गिरः प्रियतमा इव सोऽव्यलीकाः शुश्राव सूततनयस्य तदा व्यलीकाः ॥"<br><b>उल्लेखाः - </b>माघ० ५-१<br><br>

अव्यवधान
अव्यवधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಮೀಪ್ಯ /ಮಧ್ಯೆ ಯಾವುದೂ ಇಲ್ಲದಿರುವಿಕೆ<br><br>अव्यवधान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದ /ಹತ್ತಿರದ<br><br>

अव्यवसाय
अव्यवसाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ಯೋಗವಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न व्यवसायो यस्य<br><br>अव्यवसाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಶ್ವಯವಿಲ್ಲದಿರುವಿಕೆ<br><br>अव्यवसाय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯವಿಲ್ಲದ /ನಿರ್ಧಾರವಲ್ಲದ<br><b>प्रयोगाः - </b>"बहुशाखा ह्यनन्ताश्च बुद्धयोऽव्यवसायिनाम्"<br><b>उल्लेखाः - </b>गीता० २-४१<br><br>अव्यवसाय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ಯೋಗವಿಲ್ಲದ<br><b>प्रयोगाः - </b>"स्थलारविन्दश्रियमव्यवस्थाम्"<br><b>उल्लेखाः - </b>कुमा० १-३३<br><br>

अव्यवसायिन्
अव्यवसायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ಯೋಗವಿಲ್ಲದ<br><b>प्रयोगाः - </b>"व्यूहावुभौ तावितरेतरस्मात् भङ्गं जयं चापतुरव्यवस्थम्"<br><b>उल्लेखाः - </b>रघु० ७-५४<br><br>अव्यवसायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯವಿಲ್ಲದ /ನಿರ್ಧಾರವಲ್ಲದ<br><br>

अव्यवस्थ
अव्यवस्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಂಚಲವಾದ /ಸ್ಥಿರವಲ್ಲದ<br><br>अव्यवस्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭರವಸೆಯಿಲ್ಲದ<br><br>अव्यवस्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲೆಯಿಲ್ಲದ /ಮಿತಿಮೀರಿದ<br><br>अव्यवस्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಟ್ಟಳೆಯಿಲ್ಲದ /ನಿಯಮರಹಿತವಾದ<br><br>

अव्यवस्था
अव्यवस्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಶ್ವಯವಿಲ್ಲದಿರುವಿಕೆ<br><br>अव्यवस्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ರಮ /ನಿಯಮಕ್ಕೆ ವಿರುದ್ಧವಾಗಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"ग्रामेषु सैन्यैरकरोदवारितैः किमव्यवस्थां चलितोऽपि केशवः"<br><b>उल्लेखाः - </b>माघ० १२-३६<br><br>

अव्यवस्थित
अव्यवस्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರಮರ್ಯಾದೆಯಿಲ್ಲದ /ನಿಯಮರಹಿತವಾದ<br><br>अव्यवस्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸ್ಥಿರವಾದ<br><b>निष्पत्तिः - </b>वि + अव + ष्ठा (गतिनिवृत्तौ) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"अव्यवस्थितचित्तस्य प्रसादोऽपि भयङ्करः"<br><br>अव्यवस्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಿತ್ಯವಾದ /ಶಾಶ್ವತವಾದ<br><br>

अव्यवहार्य
अव्यवहार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯವಹರಿಸಲು ಅನರ್ಹನಾದ /ಅಪಾಂಕ್ತೇಯ<br><b>निष्पत्तिः - </b>वि + अव + हृञ् (हरणे) - "ण्यत्" (३-१-१२४)<br><br>

अव्यवहित
अव्यवहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದ /ಹತ್ತಿರದ<br><br>

अव्यवहृत
अव्यवहृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯವಹರಿಸಲ್ಪಡದ<br><br>

अव्यसन
अव्यसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸನ್ಮಾರ್ಗ /ಸದಾಚಾರ<br><br>अव्यसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪವಿಲ್ಲದಿರುವಿಕೆ<br><br>अव्यसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶುಭ /ಕ್ಷೇಮ<br><br>अव्यसन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೋಷವಿಲ್ಲದ /ಪಾಪವಿಲ್ಲದ<br><br>अव्यसन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸದಾಚಾರವುಳ್ಳ<br><br>अव्यसन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುಃಖವಿಲ್ಲದ<br><br>अव्यसन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಸಕ್ತಿಯಿಲ್ಲದ<br><br>अव्यसन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏಳು ವಿಧ ವ್ಯಸನವಿಲ್ಲದ<br><br>

अव्यस्त
अव्यस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರ್ಪಡಿಸಲ್ಪಡದ /ಸೇರಿಕೊಂಡಿರುವ<br><br>अव्यस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯತ್ಯಾಸ ಹೊಂದದ<br><br>अव्यस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಸೆಯಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न व्यस्तः<br><br>

अव्याकुल
अव्याकुल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಳವಳವಿಲ್ಲದ /ಚಿತ್ತ ಸ್ವಾಸ್ಥ್ಯವುಳ್ಳ<br><br>

अव्याकृत
अव्याकृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಂಖ್ಯಮತದಲ್ಲಿ ಪ್ರಧಾನ /ಮೂಲಪ್ರಕೃತಿ<br><br>अव्याकृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅದ್ವೈತಿಗಳ ಮತದಲ್ಲಿ ಜಗತ್ಕಾರಣವಾದ ಬೀಜಭೂತವಾದ ಮಾಯೆ<br><br>अव्याकृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶಿಷ್ಟಾದ್ವೈತಿಗಳ ಮತದಲ್ಲಿ ನಾಮರೂಪಗಳಿಂದ ಅಭಿವ್ಯಕ್ತವಲ್ಲದ ಪ್ರಕೃತಿ<br><b>प्रयोगाः - </b>"अव्याकृताद्व्याकृतवानसि त्वं नामानि रूपाणी च यानि पूर्वम्"<br><b>उल्लेखाः - </b>हय०<br><br>

अव्याज
अव्याज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಟವಿಲ್ಲದಿರುವಿಕೆ<br><br>अव्याज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಭಾವದಿಂದಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"इदं किलाव्याजमनोहरं वपुः"<br><b>उल्लेखाः - </b>शाकु० १-१६<br><br>अव्याज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಟವಿಲ್ಲದ /ಸರಳವಾದ<br><br>अव्याज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಸರ್ಗವಾದ /ಕೃತಕವಲ್ಲದ<br><br>

अव्यापक
अव्यापक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಸ್ತಾರವಲ್ಲದ /ಹರಡದಿರುವ<br><br>अव्यापक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲಾ ಕಡೆಯಲ್ಲೂ ಸಂಬಂಧವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न व्यापकः<br><br>

अव्यापकत्व
अव्यापकत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯೇಕತೆ /ಬೇರೆಯಾಗಿರುವಿಕೆ<br><br>

अव्यापिन्
अव्यापिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಡದಿರುವ<br><br>अव्यापिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಿಮಿತಿಯುಳ್ಳ<br><b>निष्पत्तिः - </b>वि + आप्लृ (व्याप्तौ) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>न व्याप्नोति<br><br>

अव्याप्त
अव्याप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಿಮಿತಿಯುಳ್ಳ<br><br>अव्याप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಡದಿರುವ<br><b>व्युत्पत्तिः - </b>न व्याप्तः<br><br>

अव्याप्ति
अव्याप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲವು ಲಕ್ಷ್ಯಗಳಲ್ಲಿ ಲಕ್ಷಣವಿಲ್ಲದಿರುವುದು<br><br>अव्याप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಪಿಸದಿರುವುದು /ಹರಡದಿರುವುದು<br><br>

अव्याप्य
अव्याप्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲಾ ಕಡೆಯಲ್ಲೂ ಹರಡದಿರುವ /ಎಲ್ಲದರ ಸಂಬಂಧ ಪಡೆಯದ<br><br>अव्याप्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಪ್ತಿಯಿಲ್ಲದ<br><br>अव्याप्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹರಡದೆ /ಹಬ್ಬದೆ<br><b>निष्पत्तिः - </b>वि + आप्लृ (व्याप्तौ) - "ल्यप्" (७-१-३७)<br><br>

अव्याप्यवृत्ति
अव्याप्यवृत्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನ ಅಭಾವವಿರುವ ವಸ್ತುವಿನಲ್ಲೂ ತಾನು ಇರುವ<br><br>

अव्यावर्तक
अव्यावर्तक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮತ್ತೊಂದರಿಂದ ಬೇರ್ಪಡಿಸದ /ಮತ್ತೊಂದನ್ನು ತಡೆಯದ<br><br>अव्यावर्तक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮತ್ತೊಂದರಿಂದ ಭೇದವನ್ನು ಉಂಟುಮಾಡದ<br><b>निष्पत्तिः - </b>वि + आ + वृतु (वर्तने) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>न व्यावर्तयति<br><br>

अव्यावर्तन
अव्यावर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೊಂದರಿಂದ ಬೇರ್ಪಡಿಸದಿರುವಿಕೆ<br><br>अव्यावर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೊಂದರಿಂದ ತಡೆಯಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न व्यावर्तनम्<br><br>अव्यावर्तन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮತ್ತೊಂದರಿಂದ ಬೇರ್ಪಡಿಸದ<br><br>अव्यावर्तन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಶೇಷ ಧರ್ಮದಿಂದ ತಡೆಹೊಂದಿದ<br><b>निष्पत्तिः - </b>वि + आ + वृतु (वर्तने) + णिच् - "ल्युट्" (३-३-११५)<br><b>व्युत्पत्तिः - </b>न व्यावर्तनं यस्य<br><br>

अव्याहत
अव्याहत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಯವಾದ ಮಾತು<br><br>अव्याहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಯಿಲ್ಲದ /ಆತಂಕವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न विशेषेण आहतः<br><b>प्रयोगाः - </b>"अव्याहतैः स्वगतैस्स तस्याः सम्राट् समाराधनतत्परोऽभूत्"<br><b>उल्लेखाः - </b>रघु० २-५<br><br>

अव्युत्पन्न
अव्युत्पन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಬ್ದಗಳ ಅವಯವಾರ್ಥಜ್ಞಾನವಿಲ್ಲದವನು /ವ್ಯಾಕರಣ ಜ್ಞಾನವಿಲ್ಲದವನು<br><br>अव्युत्पन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಯವಾರ್ಥವಿಲ್ಲದೆ ಕೇವಲ ಸಮುದಾಯದ ಅರ್ಥವನು ಹೊಂದಿರುವ ಶಬ್ದ<br><br>

अशकुन
अशकुन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದುಃಶಕುನ /ಅನಿಷ್ಟವನ್ನು ಸೂಚಿಸುವ ಉತ್ಪಾತ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>अप्राशस्त्ये न० त०<br><b>प्रयोगाः - </b>"कलयन्निव सव्यथोऽवतस्थेऽशकुनेन स्खलितः किलेतरोऽपि"<br><b>उल्लेखाः - </b>माघ० ९-८३<br><br>

अशक्त
अशक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಮರ್ಥ /ಕಾರ್ಯಕ್ಕೆ ಅನರ್ಹ /ಕೈಯಲ್ಲಾಗದವನು<br><br>अशक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿಧಾ ಶಕ್ತಿಯಿಲ್ಲದ ಪದ<br><br>

अशक्तता
अशक्तता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಾಮರ್ಥ್ಯ /ಕಾರ್ಯಕ್ಕೆ ಅನರ್ಹತೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>अशक्तस्य भावः<br><br>

अशक्ति
अशक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಾಮರ್ಥ್ಯ /ಕಾರ್ಯಕ್ಕೆ ಅನರ್ಹತೆ<br><b>व्युत्पत्तिः - </b>न शक्तिः<br><b>प्रयोगाः - </b>"श्रमेण तदशक्त्या वा न गुणानामियत्तया"<br><b>उल्लेखाः - </b>रघु० १०-३२<br><br>

अशक्नुवत्
अशक्नुवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಮರ್ಥನಾದ /ಬಲಹೀನನಾದ<br><b>प्रयोगाः - </b>"अशक्नुवन् सोढुमधीरलोचनः सहस्ररश्मेरिव यस्य दर्शनम्"<br><b>उल्लेखाः - </b>माघ० १-५३<br><br>

अशक्य
अशक्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಾಧ್ಯವಾದ /ಸಾಧ್ಯವಿಲ್ಲದ<br><b>निष्पत्तिः - </b>शक्लृ (शक्तौ) - "यत्" (३-१-९९)<br><b>प्रयोगाः - </b>"अशक्यशङ्कव्यभिचारहेतुर्वाणी न वेदा यदि सन्तु के तु"<br><b>उल्लेखाः - </b>नैष० ३-७८<br><br>

अशङ्क
अशङ्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಶಯವಿಲ್ಲದ<br><br>अशङ्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति शङ्का यस्य<br><br>

अशङ्का
अशङ्का<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಶಯವಿಲ್ಲದಿರುವಿಕೆ<br><br>अशङ्का<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭಯವಿಲ್ಲದಿರುವಿಕೆ<br><br>

अशङ्कित
अशङ्कित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯಪಡದ /ಹೆದರದ<br><br>अशङ्कित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂದೇಹಪಡದ<br><br>

अशन
अशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೋಜನ /ಅಶನ<br><b>निष्पत्तिः - </b>अश (भोजने) - "ल्युट्" (३-३-११५)<br><br>अशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಹಾರ /ಅನ್ನ<br><b>निष्पत्तिः - </b>अश - कर्म० "ल्युट्" (३-३-११७)<br><br>अशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಪನೆ /ಹರಡುವಿಕೆ<br><b>निष्पत्तिः - </b>अशू (व्याप्तौ) - भावे "ल्युट्" (३-३-११५)<br><br>

अशनाया
अशनाया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೋಜನದ ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>अशन - "क्यच्" (३-१-८) । "अः" (३-३-१०३)<br><b>व्युत्पत्तिः - </b>अशनस्येच्छा<br><br>

अशनायित
अशनायित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೋಜನದ ಅಪೇಕ್ಷೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>अशनाया जाताऽस्य<br><br>

अशनि
अशनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಜ್ರಾಯುಧ<br><b>निष्पत्तिः - </b>अश (भोजने) - "अनिः" (उ० २-१०२)<br><b>प्रयोगाः - </b>"अशनिरिव कठोरः शीतमाल्भोदपङ्क्तौ"<br><b>उल्लेखाः - </b>चं० रा०<br><br>अशनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಿಡಿಲು<br><br>अशनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿದ್ಯುತ್ತು<br><b>विस्तारः - </b>"वज्रे विद्युति चाशनिः" - त्रिकाण्ड० ।<br><br>अशनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><br>अशनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಹ್ನಿ /ಬೆಂಕಿ<br><br>अशनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರುವನ್ನು ನಾಶಮಾಡುವ ಅನುಯಾಜವೆಂಬ ಯಾಗ<br><br>

अशरण
अशरण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಕನಿಲ್ಲದ /ಸಹಾಯಕನಿಲ್ಲದ<br><br>अशरण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೃಹವಿಲ್ಲದ /ಮನೆಯಿಲ್ಲದ<br><br>

अशरीर
अशरीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ<br><br>अशरीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><br>अशरीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ /ಮನ್ಮಥ<br><b>व्युत्पत्तिः - </b>नास्ति शरीरं यस्य<br><b>प्रयोगाः - </b>"निजमैक्षि मन्दमनिशं निशितैः क्रशितं शरीरमशरीरशरैः"<br><b>उल्लेखाः - </b>माघ० ९-६१<br><br>अशरीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><br>अशरीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶರೀರಾಭಿಮಾನವನ್ನು ತ್ಯಜಿಸಿದ ಸಂನ್ಯಾಸಿ<br><br>अशरीर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೇಹವಿಲ್ಲದ /ಶರೀರವಿಲ್ಲದ<br><br>

अशरीरिन्
अशरीरिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><br>अशरीरिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ<br><br>अशरीरिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><br>अशरीरिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೇಹವಿಲ್ಲದ /ಶರೀರವಿಲ್ಲದ<br><br>

अशरीरिणी
अशरीरिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अशरीरिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

अशर्मन्
अशर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಂತೋಷ /ದುಃಖ<br><b>प्रयोगाः - </b>"एकौघभूतं तदशर्म कृष्णां विभावरीं द्वान्तमिव प्रपेदे"<br><b>उल्लेखाः - </b>किरा० ३-३५<br><br>अशर्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಖವಿಲ್ಲದ /ಸಂತೋಷವಿಲ್ಲದ<br><br>

अशान्त
अशान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೆಮ್ಮದಿಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न शान्तः<br><b>प्रयोगाः - </b>"नास्ति बुद्धिरयुक्तस्य न चायुक्तस्य भावना । न चाभावयतः शान्तिः अशान्तस्य कुतः सुखम् ॥"<br><b>उल्लेखाः - </b>गीता० २-६६<br><br>

अशान्ति
अशान्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಂತಿಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अशान्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಮಗುಣವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति शान्तिः यस्य<br><br>

अशाश्वत
अशाश्वत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸ್ಥಿರವಾದ<br><b>व्युत्पत्तिः - </b>न शाश्वतः<br><br>

अशास्त्र
अशास्त्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೇದಶಾಸ್ತ್ರವಿರುದ್ಧವಾದ ನಾಸ್ತಿಕ ಮತ<br><br>

अशास्त्रीय
अशास्त्रीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರವಿರುದ್ಧವಾದ<br><b>निष्पत्तिः - </b>शास्त्र - "छः" (४-२-११४)<br><br>

अशिक्षित
अशिक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಕ್ಷಿಸಲ್ಪಡದ<br><br>

अशित
अशित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿನ್ನಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अश (भोजने) - "क्तः" (३-२-१०२)<br><br>अशित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹವ್ಯ /ಚರು /ದೇವತೆಗಳ ನೈವೇದ್ಯಕ್ಕಾಗಿ ಮಾಡುವ ಅನ್ನ<br><br>

अशित्र
अशित्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹವ್ಯ /ಚರು /ದೇವತೆಗಳ ನೈವೇದ್ಯಕ್ಕಾಗಿ ಮಾಡುವ ಅನ್ನ<br><b>निष्पत्तिः - </b>अशू (व्याप्तौ सङ्घाते च ) - "इत्रः" (उ० ४-१७२)<br><br>

अशिथिल
अशिथिल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಗಿಯಾದ /ಸಡಿಲವಲ್ಲದ<br><br>अशिथिल<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ /ದೃಢವಾಗಿ<br><b>प्रयोगाः - </b>"अशिथिलमपरावसज्य कण्ठे दृढपरिरब्धबृहद्बहिःस्तनेन"<br><b>उल्लेखाः - </b>माघ० ७-१६<br><br>

अशिर
अशिर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಕ್ಷಸ<br><b>निष्पत्तिः - </b>अश (भोजने० - "किरच्" (उ० १-५२)<br><br>अशिर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>अशिर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ<br><b>विस्तारः - </b>"अशिरो वीतिहोत्रे स्यात् राक्षसे भास्करे पुमान्" - मेदि० ।<br><br>अशिर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯು /ಗಾಳಿ<br><br>

अशिरा
अशिरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸು<br><br>

अशिरस्
अशिरस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯಿಲ್ಲದ ದೇಹ /ಮುಂಡ<br><br>अशिरस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಲೆಯಿಲ್ಲದ<br><br>अशिरस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ರವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति शिरो यस्य<br><br>

अशिव
अशिव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮಂಗಳ<br><br>अशिव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶುಭವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न शिवम्<br><b>प्रयोगाः - </b>"अदभ्रदर्भामधिशय्य स स्थलीं जहासि निद्रामशिवैः शिवारुतैः"<br><b>उल्लेखाः - </b>किरा० १-३८<br><br>अशिव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಗ್ರವಾದ<br><b>व्युत्पत्तिः - </b>नास्ति शिवं यस्मात्<br><br>

अशिवा
अशिवा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂತ /ರಾಕ್ಷಸಿ<br><br>

अशिशिषा
अशिशिषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೋಜನೇಚ್ಛೆ<br><b>निष्पत्तिः - </b>अश (भोजने) + सन् - "अः" (३-३-१-६)<br><b>व्युत्पत्तिः - </b>अशितुमिच्छा<br><br>

अशिष्ट
अशिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಾಧು<br><br>अशिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಸ್ತಿಕ<br><br>अशिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಶಿಕ್ಷಿತ<br><br>अशिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮುಕ<br><br>

अशिष्ठ
अशिष्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><br>अशिष्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಊಟಮಾಡುವ<br><b>निष्पत्तिः - </b>"इष्ठन्" (५-३-५५)<br><b>व्युत्पत्तिः - </b>अतिशयेन अशिता<br><br>

अशिष्य
अशिष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಕ್ಷಾನರ್ಹ /ಕಲಿಸಲು ಯೋಗ್ಯನಲ್ಲದ<br><br>अशिष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಷ್ಯನಲ್ಲದ<br><br>अशिष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಧಿಸಲು ಅರ್ಹನಲ್ಲದ<br><br>

अशीति
अशीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಂಭತ್ತು<br><b>निष्पत्तिः - </b>"तिः" प्रत्ययः अश्यादेशश्च निपात्यते (५-१-५९)<br><b>व्युत्पत्तिः - </b>अष्टौ दशतः परिमाणमस्य<br><br>

अशुच्
अशुच्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುಃಖವಿಲ್ಲದ /ಶೋಕವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति शुक् यस्य<br><br>

अशुचि
अशुचि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಬಣ್ಣ<br><br>अशुचि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪವಿತ್ರತೆ /ಮೈಲಿಗೆ<br><br>अशुचि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪವಿತ್ರವಾದ<br><br>अशुचि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಳಕಾದ<br><br>अशुचि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪ್ಪಾಗಿರುವ<br><br>

अशुद्ध
अशुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪವಿತ್ರವಾದ<br><br>अशुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಳಕಾದ<br><br>अशुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಪ್ಪಾಗಿರುವ<br><br>

अशुद्धि
अशुद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪವಿತ್ರತೆ /ಮೈಲಿಗೆ<br><br>अशुद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಪ್ಪು /ದೋಷ<br><br>अशुद्धि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪವಿತ್ರವಾದ<br><br>

अशुभ
अशुभ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮಂಗಳ<br><b>प्रयोगाः - </b>"यः सर्वत्रानभिस्नेहः तत्तत्प्राप्य शुभाशुभम् । नाभिनन्दति न द्वेष्टि तस्य प्रज्ञा प्रतिष्ठिता ॥"<br><b>उल्लेखाः - </b>गीता० २-५७<br><br>अशुभ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಪತ್ತು<br><br>अशुभ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ದೈವ /ದುರ್ದಶೆ<br><b>निष्पत्तिः - </b>विरोधे न० त० ।<br><b>व्युत्पत्तिः - </b>न शुभम्<br><b>प्रयोगाः - </b>"प्रायः शुभं च विदधात्यशुभं च जन्तोः सर्वङ्कषा भगव्ती भवितव्यथैव"<br><b>उल्लेखाः - </b>मालती० १-२६<br><br>अशुभ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಮಂಗಳವಾದ<br><br>अशुभ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪವಿತ್ರವಾದ<br><br>

अशून्य
अशून्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಖಾಲಿಯಿಲ್ಲದ<br><b>प्रयोगाः - </b>"अङ्कमङ्कपरिवर्तनोचिते तस्य निन्यतुरशून्यतामुभे"<br><b>उल्लेखाः - </b>रघु० १९-१३<br><br>

अशृत
अशृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇಯಿಸಲ್ಪಡದ<br><br>

अशेष
अशेष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಸ್ತ /ಸಕಲ<br><b>प्रयोगाः - </b>"जगत्प्रकाशं तदशेषमिज्जया भवद्गुरुर्लङ्घयितुं ममोद्यतः"<br><b>उल्लेखाः - </b>रघु० ३-४८<br><br>

अशेषम्
अशेषम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣವಾಗಿ<br><b>प्रयोगाः - </b>"अलं विवादेन यथा श्रुतस्त्वया तथाविधस्तावदशेषमस्तु सः"<br><b>उल्लेखाः - </b>कुमा० ५-८२<br><br>

अशेषेण
अशेषेण<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣವಾಗಿ<br><b>प्रयोगाः - </b>"येन भूतान्यशेषेण द्रक्षस्यात्मन्यथो मयि"<br><b>उल्लेखाः - </b>गीता० ४-३५<br><br>

अशेषतः
अशेषतः<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣವಾಗಿ<br><b>प्रयोगाः - </b>"ज्येष्ठ एव तु गृह्णीयात् पित्र्यं धनमशेषतः"<br><b>उल्लेखाः - </b>मनु० ९-१०५<br><br>

अशोक
अशोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>अशोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಗಧದೇಶದ ಸಾರ್ವಭೌಮನಾದ ಅಶೋಕ ಚಕ್ರವರ್ತಿ<br><br>अशोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶೋಕವೃಕ್ಷ<br><b>प्रयोगाः - </b>"असूत सद्यः कुसुमान्यशोकः स्कन्धात्प्रभृत्येव सपल्लवानि । पादेन नापैक्षत सुन्दरीणां सम्पर्कमासिञ्जितनूपुरेण ।"<br><b>उल्लेखाः - </b>कुमा० ३-२६<br><br>अशोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಕುಳ ವೃಕ್ಷ /ಪವಳದ ಗಿಡ<br><br>अशोक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾದರಸ<br><br>अशोक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶೋಕವಿಲ್ಲದ /ದುಃಖವಿಲ್ಲದ<br><br>

अशोका
अशोका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಟುಕರೋಹಿಣಿ<br><b>विस्तारः - </b>"शोकस्त्रिषु निःशोके पुंसि कङ्केलिपादपे । स्त्रियाम् तु कटुरोहिण्यां पारदे स्यान्नपुंसकम्" - मेदि० ।<br><br>अशोका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚೈತ್ರ ಶುಕ್ಲ ಷಷ್ಠಿ<br><br>

अशोकपूर्णिमा
अशोकपूर्णिमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಫಾಲ್ಗುಣ ಮಾಸದ ಹುಣ್ಣಿಮೆ<br><br>

अशोकरोहिणी
अशोकरोहिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಟುಕರೋಹಿಣಿ<br><br>

अशोकवनिता
अशोकवनिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶೋಕ ವನ /ಅಶೋಕವೃಕ್ಷಗಳತೋಪು<br><br>

अशोच्य
अशोच्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುಃಖಿಸಲು ಅಯೋಗ್ಯ<br><b>निष्पत्तिः - </b>शुच (शोके० - "ण्यत्" (३-१-१२४)<br><b>व्युत्पत्तिः - </b>न शोच्यः<br><b>प्रयोगाः - </b>"अशोच्यानन्वशोचस्त्वं प्रज्ञावादांश्च भाषसे"<br><b>उल्लेखाः - </b>गीता० २-११<br><br>

अशोधन
अशोधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶುದ್ಧಿ ಮಾಡದಿರುವಿಕೆ<br><br>अशोधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಲ ತೀರಿಸದಿರುವಿಕೆ<br><br>

अशोधित
अशोधित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶುದ್ಧಿ ಮಾದಲ್ಪಡದ<br><br>अशोधित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೀರಿಸಲ್ಪಡದ ಸಾಲ<br><br>

अशोष्य
अशोष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಣಗಿಸಲಾಗದ<br><b>व्युत्पत्तिः - </b>न शोषयितुं शक्यम्<br><b>प्रयोगाः - </b>"अच्छेद्योऽयमदाह्योऽयमक्लेद्योऽशोष्य एव च"<br><b>उल्लेखाः - </b>गीता० २-२४<br><br>

अशौच
अशौच<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶುಚಿ /ಅಪವಿತ್ರತೆ<br><br>अशौच<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶೌಚ /ಮೈಲಿಗೆ /ಸೂತಕ<br><br>

अशौचसङ्कर
अशौचसङ्कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜನನ ಮತ್ತು ಮರಣಶೌಚಗಳ ಮಧ್ಯೆ ಮತ್ತೊಂದು ಅಶೌಚವು ಬರುವುದು<br><br>

अश्नीतपिबता
अश्नीतपिबता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೋಜನ ಪಾನಗಳು ಯಥೇಚ್ಛವಾಗಿ ನಡೆಯಲೆಂದು ಉಪಚಾರದ ಮಾತನ್ನು ಹೇಳುವ ಸಮಾರಂಭ<br><b>प्रयोगाः - </b>"अश्नीत पिबत इत्युच्यते यस्यां निदेशक्रियायाम् ।" "अश्नीतपिबतीयन्ती प्रसिता स्मरकर्मणि"<br><b>उल्लेखाः - </b>भट्टि० ५-९२<br><br>

अश्मगर्भ
अश्मगर्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರಕತಮಣಿ /ಪಚ್ಚೆಕಲ್ಲು<br><br>

अश्मगर्भज
अश्मगर्भज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರಕತಮಣಿ /ಪಚ್ಚೆಕಲ್ಲು<br><br>अश्मगर्भज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಲೆಯಿಂದ ಉಂಟಾದ ಬೆಂಕಿ /ಚಕಮಕಿ ಕಲ್ಲಿನಿಂದ ಹೊರಟ ಬೆಂಕಿ<br><br>

अश्मज
अश्मज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಲಾಜತು<br><br>अश्मज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣ<br><br>

अश्मदारण
अश्मदारण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲನ್ನು ಒಡೆಯುವ ಉಳಿ<br><b>निष्पत्तिः - </b>दृ (विदारणे) + णिच् - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अश्मानं दारयति<br><br>

अश्मन्
अश्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಲೆ /ಕಲ್ಲು<br><b>निष्पत्तिः - </b>अशू (व्याप्तौ सङ्घाते च) - "मनिन्" (३-२-७५)<br><b>व्युत्पत्तिः - </b>अश्नुते<br><b>प्रयोगाः - </b>"नारचक्षेपणीयाश्मनिष्पेषोत्पतितानलम्"<br><b>उल्लेखाः - </b>रघु० ४-७७<br><br>अश्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಟ್ಟ /ಪರ್ವತ<br><br>अश्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><br>अश्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರಕತಮಣಿ /ಪಚ್ಚೆಕಲ್ಲು<br><br>अश्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಡೆ /ದೊಡ್ಡ ಕಲ್ಲು<br><br>अश्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಜ್ರಾಯುಧ<br><br>अश्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಡುವ /ವ್ಯಾಪಿಸುವ<br><br>

अश्मन्त
अश्मन्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಲೆ<br><br>अश्मन्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೈದಾನ /ಬಯಲು<br><b>व्युत्पत्तिः - </b>अश्मनोऽप्यन्तोऽत्र<br><br>अश्मन्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರಣ<br><br>अश्मन्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಶುಭವಾದ<br><br>अश्मन्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಧಿಯಿಲ್ಲದ /ಎಲ್ಲೆ<br><b>विस्तारः - </b>"अश्मन्तमशुभे चुल्ल्यां मरणेऽनवधावपि । क्षेत्रेऽपि" - मेदि० ।<br><br>

अश्मन्तक
अश्मन्तक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋವಿದಾರವೃಕ್ಷ<br><br>अश्मन्तक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಲೆ<br><br>अश्मन्तक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೀಪದ ಮೇಲಿನ ಮುಸುಕು<br><br>

अश्मयोनि
अश्मयोनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರಕತಮಣಿ /ಪಚ್ಚೆಕಲ್ಲು<br><b>व्युत्पत्तिः - </b>अश्मा योनिरस्य<br><br>

अश्मर
अश्मर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಲೆಯಿಂದ ನಿರ್ಮಿತವಾದ /ಶಿಲಾಮಯವಾದ<br><b>निष्पत्तिः - </b>अश्मन् - "रः" (४-२-८०)<br><br>

अश्मरी
अश्मरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂತ್ರರೋಗ /ಕಲ್ಲಿನಂತೆ ಗಟ್ಟಿಯಾದ ಮಾಂಸಖಂಡವು ಮೂತ್ರದಲ್ಲಿ ಬೀಳುವ ರೋಗ<br><b>निष्पत्तिः - </b>रा (दाने) - "कः" (३-२-३) । "ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>अश्मानं राति<br><b>विस्तारः - </b>"अश्मरी मूत्रकृच्छ्रं स्यात्" - अम० ।<br><br>

अश्मरीघ्न
अश्मरीघ्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರುಣವೃಕ್ಷ /ವಲಸೆ ಗಿಡ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) - "टक्" (३-२-५३)<br><b>व्युत्पत्तिः - </b>अश्मरीं हन्ति<br><br>

अश्मसार
अश्मसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣ<br><br>

अश्मार्म
अश्मार्म<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂತ್ರರೋಗ<br><b>व्युत्पत्तिः - </b>अश्मकारकं कर्म<br><br>

अश्मीर
अश्मीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂತ್ರರೋಗ<br><br>

अश्र
अश्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಬನಿ /ಕಣ್ಣೀರು<br><b>निष्पत्तिः - </b>अशू (व्याप्तौ) - "रक्" बाहु० ।<br><b>व्युत्पत्तिः - </b>अश्नुते<br><b>प्रयोगाः - </b>"सखीभिरश्रोत्तरमीक्षितामिमाम्"<br><b>उल्लेखाः - </b>कुमा० ५-६१<br><br>

अश्रद्दधान
अश्रद्दधान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಂಬದಿರುವ /ವಿಶ್ವಾಸವಿಡದಿರುವ<br><b>व्युत्पत्तिः - </b>न श्रद्दधानः<br><b>प्रयोगाः - </b>"अश्रद्दधानाः पुरुषाः धर्मस्यास्य परन्तप । अप्राप्य मां निवर्तन्ते मृत्युसंसारवर्त्मनि ॥"<br><b>उल्लेखाः - </b>गीता० ९-३<br><br>

अश्रद्ध
अश्रद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಂಬಿಕೆಯಿಲ್ಲದ /ವಿಶ್ವಾಸವಿಲ್ಲದ<br><br>

अश्रद्धा
अश्रद्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಂಬಿಕೆಯಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न श्रद्धा<br><b>प्रयोगाः - </b>"अश्रद्धय हुतं दत्तं तपस्तप्तं कृतं च यत् । असदित्युच्यते पार्थ न च तत्प्रेत्य नो इह ॥"<br><b>उल्लेखाः - </b>गीता० १७-२८<br><br>अश्रद्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪನಂಬಿಕೆ<br><b>निष्पत्तिः - </b>विरोधे न० त० ।<br><br>अश्रद्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಸೆಯಿಲ್ಲದಿರುವಿಕೆ<br><b>विस्तारः - </b>"श्रद्धादरे च काङ्क्षायाम्" - मेदि० ।<br><br>

अश्रद्धेय
अश्रद्धेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಂಬಲನರ್ಹವಾದ<br><b>व्युत्पत्तिः - </b>न श्रद्धेयम्<br><b>प्रयोगाः - </b>"किमनेनाश्रद्धेयव्याधवचनप्रत्ययमात्रपरिगृहीतेनाण्डजेन"<br><b>उल्लेखाः - </b>पञ्चतं<br><br>

अश्रम
अश्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಯಾಸವಿಲ್ಲದಿರುವಿಕೆ /ಶ್ರಮವಿಲ್ಲದಿರುವಿಕೆ<br><br>अश्रम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರಮವಿಲ್ಲದ /ಆಯಾಸವಿಲ್ಲದ<br><br>

अश्रवण
अश्रवण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ /ಹಾವು<br><br>अश्रवण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಳದಿರುವಿಕೆ /ಕಿವುಡು<br><br>अश्रवण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೋತ್ರವಿಲ್ಲದ /ಶ್ರವಣೇಂದ್ರಿಯವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न श्रवणं श्रवणेन्द्रियं यस्य<br><br>

अश्रान्त
अश्रान्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶ್ರಾಂತಿಯಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>श्रमु (तपसि खेदे च) - "क्तः" (३-३-११४)<br><br>अश्रान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರಮ ಹೊಂದದ /ದಣಿಯದ<br><br>अश्रान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿರಾಮವಿಲ್ಲದ /ನಿರಂತರವಾದ<br><b>प्रयोगाः - </b>"अश्रान्तसन्ततिभिराभरणप्रकाशैः"<br><b>उल्लेखाः - </b>याद० १९-३<br><br>अश्रान्त<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ವಿರಾಮವಿಲ್ಲದೆ /ಬಿಡುವಿಲ್ಲದೆ<br><br>

अश्रि
अश्रि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆಯ ಒಂದು ಕೋಣ /ಒಂದು ಮೂಲೆ<br><b>निष्पत्तिः - </b>अशू (व्याप्तौ सङ्घाते च) - "क्रिः" (उ० ४-६६)<br><br>अश्रि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತಿಯ ಅಲುಗು /ಕತ್ತಿಯ ಅಂಚು<br><b>निष्पत्तिः - </b>आ + श्रिञ् (सेवायाम्) - "इण्" आङो ह्रस्वश्च (उ० ४-१३७)<br><b>व्युत्पत्तिः - </b>आश्रीयते<br><b>प्रयोगाः - </b>"वृत्रस्य हन्तुः कुलिशं कुण्ठिताश्रीव लक्ष्यते"<br><b>उल्लेखाः - </b>कुमा० २-२०<br><br>

अश्रीक
अश्रीक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದರಿದ್ರ /ಬಡವ<br><b>व्युत्पत्तिः - </b>नास्ति श्रीः सम्पद्यस्य<br><br>अश्रीक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಂತಿಯಿಲ್ಲದ /ಪ್ರಕಾಶವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति श्रीः कान्तिर्यस्य<br><b>प्रयोगाः - </b>"अश्रीकाः काश्चिदन्तर्दिश इव दधिरे दाहमुद्भ्रान्तसत्त्वाः"<br><b>उल्लेखाः - </b>माघ० १५-९६<br><br>

अश्रु
अश्रु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಬನಿ /ಕಣ್ಣೀರು<br><b>निष्पत्तिः - </b>अशू (व्याप्तौ) - "रुन्" (उ० ५-२९)<br><b>व्युत्पत्तिः - </b>अश्नुते<br><b>प्रयोगाः - </b>"रघुर्भृशं वक्षसि तेन ताडितः पपात भूमौ सह सैनिकाश्रुभिः"<br><b>उल्लेखाः - </b>रघु० ३-६१<br><br>

अश्रुत
अश्रुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೇಳಲ್ಪಡದ<br><br>अश्रुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರಾಭ್ಯಾಸವಿಲ್ಲದ /ಶಾಸ್ತ್ರಜ್ಞಾನವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति श्रुतः शास्त्रज्ञानं यस्य<br><br>

अश्रुति
अश्रुति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ರವಣ /ಕೇಳದಿರುವಿಕೆ<br><br>अश्रुति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇದದ ಪ್ರಮಾಣವಿಲ್ಲದಿರುವಿಕೆ<br><br>अश्रुति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿವಿಯಿಲ್ಲದ /ಶ್ರವಣೇಂದ್ರಿಯವಿಲ್ಲದ<br><br>

अश्रुपात
अश्रुपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣೀರು ಸುರಿಯುವುದು<br><br>

अश्रेयस्
अश्रेयस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಡು /ತೊಂದರೆ<br><b>व्युत्पत्तिः - </b>न श्रेयः<br><br>अश्रेयस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೀನವಾದ /ನೀಚವಾದ<br><b>व्युत्पत्तिः - </b>न श्रेयान्<br><br>अश्रेयस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯವಾದ<br><br>

अश्लील
अश्लील<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಭ್ಯವಾದ ಮಾತು<br><b>निष्पत्तिः - </b>ला (आदाने) - "कः" (३-२-३) । रस्य लत्वम्<br><b>व्युत्पत्तिः - </b>श्रियं लाति<br><br>अश्लील<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಾಮ್ಯಭಾಷೆ<br><br>अश्लील<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಕಾವ್ಯದೋಷ<br><br>

अश्व
अश्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆ<br><b>निष्पत्तिः - </b>अशू (व्याप्तौ) - "क्वन्" (उ० १-१४९)<br><b>प्रयोगाः - </b>"सिद्धं मुखे नवसु वीथिषु कश्चिदशवं वल्गाविभागकुशलो गमयाम्बभूव"<br><b>उल्लेखाः - </b>माघ० ५-६०<br><br>अश्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಬಲವುಳ್ಳ ಒಂದು ಜಾತಿಯ ಮನುಷ್ಯ<br><br>अश्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><br>अश्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಪ್ತ ಸಂಖ್ಯೆ<br><br>अश्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಪಕವಾದ<br><br>

अश्वक
अश्वक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಕುದುರೆ /ಸಣ್ಣ ಜಾತಿಯ ಕುದುರೆ<br><b>निष्पत्तिः - </b>"कः" (५-३-८५)<br><b>व्युत्पत्तिः - </b>अल्पोऽश्वः<br><br>अश्वक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೋಲಿ ಕುದುರೆ<br><b>निष्पत्तिः - </b>"कः" (५-३-७४)<br><b>व्युत्पत्तिः - </b>कुत्सितोऽश्वः<br><br>अश्वक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜಮಾನನಿಲ್ಲದ ಕುದುರೆ<br><b>निष्पत्तिः - </b>अज्ञाते "कः" (५-३-७३)<br><b>व्युत्पत्तिः - </b>कस्यायमश्वः<br><br>

अश्वकन्दा
अश्वकन्दा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಗಂಧಿ ಗಿಡ<br><b>व्युत्पत्तिः - </b>अश्वस्य मेढ्रमिव कन्दोऽस्य<br><br>

अश्वकर्ण
अश्वकर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತಿಮರ<br><b>व्युत्पत्तिः - </b>अश्वस्य कर्ण इव पत्रं यस्य<br><br>

अश्वकिनी
अश्वकिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಿನೀನಕ್ಷತ್ರ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५) । "ङीप्" (४-१-५)<br><b>व्युत्पत्तिः - </b>अश्वस्य कं मुखमिवाकारोऽस्त्यस्य<br><br>

अश्वकुटी
अश्वकुटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಲಾಯ<br><br>

अश्वखरज
अश्वखरज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಸರಗತ್ತೆ /ಕತ್ತೆ ಮತ್ತು ಕುದುರೆಗಳಿಂದ ಜನಿಸಿದ ಮಿಶ್ರಜಾತಿಯ ಪ್ರಾಣಿ<br><b>व्युत्पत्तिः - </b>अश्वस्य खरी व्च अश्वा च खरश्च वा ताभ्यां जातः<br><br>

अश्वगन्धा
अश्वगन्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಗಂಧಿ ಗಿಡ<br><br>

अश्वग्रीव
अश्वग्रीव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಯಗ್ರೀವಾವತಾರವನ್ನು ಸ್ವೀಕರಿಸಿದ ಮಹಾವಿಷ್ಣು<br><br>अश्वग्रीव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಯಗ್ರೀವನೆಂಬ ಒಬ್ಬ ರಾಕ್ಷಸ<br><br>

अश्वघ्न
अश्वघ्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗನ್ನೇರಳೆ ಗಿಡ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) - "टक्" (३-२-५३)<br><b>व्युत्पत्तिः - </b>अश्वं हन्ति<br><br>

अश्वचिकित्सक
अश्वचिकित्सक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ವೈದ್ಯ /ಕುದುರೆಗಳಿಂದ ಹುಟ್ಟಿದ ಮಿಶ್ರಜಾತಿಯ ಪ್ರಾಣಿ<br><br>

अश्वतर
अश्वतर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಸರಗತ್ತೆ /ಕತ್ತೆ ಮತ್ತು ಕುದುರೆಗಳಿಂದ ಜನಿಸಿದ ಮಿಶ್ರಜಾತಿಯ ಪ್ರಾಣಿ<br><b>निष्पत्तिः - </b>तनुत्वे "ष्टरच्" (५-३-९१)<br><b>व्युत्पत्तिः - </b>तनुः न्यूनः अश्वः<br><br>अश्वतर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸರ್ಪ<br><br>

अश्वतरी
अश्वतरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अश्वतर ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

अश्वत्थ
अश्वत्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಳಿ ಮರ /ಅಶ್ವತ್ಥ ವೃಕ್ಷ<br><b>निष्पत्तिः - </b>ष्ठा (गतिनिवृत्तौ) - "कः" (३-२-४) । पृषो० ।<br><b>व्युत्पत्तिः - </b>वटाद्यपेक्षया न श्वश्चिरं तिष्ठति<br><b>प्रयोगाः - </b>"अश्वत्थः सर्ववृक्षाणां देवर्षीणां च नारदः"<br><b>उल्लेखाः - </b>गीता० १०-२६<br><br>अश्वत्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಂದಿಮರ<br><br>अश्वत्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಸುರಿ ಮರ<br><br>अश्वत्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಸಾರವೃಕ್ಷ<br><b>प्रयोगाः - </b>"ऊर्ध्वमूलमधःशाखमश्वत्थं प्राहुरव्ययम् । छदांसि यस्य पर्णानि यस्त्वं वेद स वेदवित् ॥"<br><b>उल्लेखाः - </b>गीता० १५-१<br><br>अश्वत्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಿನೀನಕ್ಷತ್ರ<br><br>अश्वत्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಿನೀನಕ್ಷತ್ರದಿಂದ ಕೂಡಿದ ಕಾಲ<br><b>निष्पत्तिः - </b>"अण्" (४-२-३) । तस्य लुप् (४-२-५)<br><b>व्युत्पत्तिः - </b>अश्वत्थेन अश्विनीनक्षत्रेण युक्तः कालः<br><b>विस्तारः - </b>"अश्वत्थो मुहूर्तः" - सि० कौ० ।<br><br>अश्वत्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಳೀ ಹಣ್ಣು<br><b>व्युत्पत्तिः - </b>अश्वत्थस्य फलम्<br><br>

अश्वत्थक
अश्वत्थक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಳಿ ಮರ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><br>अश्वत्थक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವತ್ಥವೃಕ್ಷವು ಫಲಿಸುವ ಕಾಲದಲ್ಲಿ ಕೊಡುವ ಸಾಲ<br><b>निष्पत्तिः - </b>अश्वत्थ - "वुन्" (४-३-४८)<br><b>व्युत्पत्तिः - </b>अश्वत्थस्य फलमश्वत्थः । तद्युक्तः कालोऽप्यश्वत्थः । अश्वत्थे तत्फलकाले देयमृणम्<br><br>

अश्वत्थकुण
अश्वत्थकुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಳಿಯ ಹಣ್ಣು ಬಿಡುವ ಕಾಲ<br><b>निष्पत्तिः - </b>"कुणप्" (५-२-२४)<br><b>व्युत्पत्तिः - </b>अश्वत्थस्य पाकः<br><br>

अश्वत्थामन्
अश्वत्थामन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ರೋಣಾಚಾರ್ಯರ ಪುತ್ರ /ಕೃಪಾಚಾರ್ಯರ ತಂಗಿ ಕೃಪಿಯ ಮಗ<br><b>व्युत्पत्तिः - </b>अश्वस्येव स्थाम बलमस्य<br><b>प्रयोगाः - </b>"स जातमात्रो व्यनदद्यथैवोच्चैःश्रवा हयः । तच्छ्रुत्वान्तर्हितं भूतमन्तरीक्षस्थमब्रवीत् । अश्वस्येवास्य यत् स्थाम नदतः प्रदिशो गतम् । अश्वत्थामैव बालोऽयं तस्मान्नाम्ना भविष्यति ॥"<br><b>उल्लेखाः - </b>भा० आदि० १४०-४९<br><br>

अश्वत्थिक
अश्वत्थिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಳಿ ಹಣ್ಣನ್ನು ತಿಂದು ಜೀವಿಸುವ<br><b>निष्पत्तिः - </b>"ष्ठन्" (४-४-१०)<br><b>व्युत्पत्तिः - </b>अश्वत्थेन चरति<br><br>

अश्वदंष्ट्रा
अश्वदंष्ट्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೆಗ್ಗಿಲುಗಿಡ<br><br>

अश्वनाय
अश्वनाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಪಾಲಕ<br><br>

अश्वप
अश्वप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಪಾಲಕ<br><b>निष्पत्तिः - </b>पा (रक्षणे) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>अश्वं पाति<br><br>

अश्वपति
अश्वपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಕಯರಾಜ<br><b>निष्पत्तिः - </b>पा (रक्षणे) - "ण्वुल्" (३-१-१३३)<br><br>अश्वपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಯಜಮಾನ<br><br>अश्वपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾವಿತ್ರಿಯ ತಂದೆ<br><br>

अश्वपर्ण
अश्वपर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಥ<br><b>व्युत्पत्तिः - </b>अश्वानां पर्णं गमनं यत्र<br><br>अश्वपर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><b>व्युत्पत्तिः - </b>अश्वं व्यापि पर्णं यस्य<br><br>

अश्वपाल
अश्वपाल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುದುರೆಯನ್ನು ಕಾಪಾಡುವವನು<br><b>निष्पत्तिः - </b>पा (रक्षणे) + णिच् - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>अश्वं पालयति<br><br>

अश्वपालक
अश्वपालक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುದುರೆಯನ್ನು ಕಾಪಾಡುವವನು<br><b>निष्पत्तिः - </b>पा (रक्षणे) + णिच् -"ण्वुल्" (३-१-१३३)<br><br>

अश्वपुच्छी
अश्वपुच्छी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡು ಉದ್ದಿನ ಗಿಡ<br><br>

अश्वमहिषिका
अश्वमहिषिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆ ಮತ್ತು ಎಮ್ಮೆಗಳ ವೈರ<br><b>निष्पत्तिः - </b>वुन् (४-३-१२५)<br><b>व्युत्पत्तिः - </b>अश्वस्य महिषस्य च समाहारः । अश्वमहिषस्य वैरम्<br><br>

अश्वमार
अश्वमार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗನ್ನೇರಳೆ ಗಿಡ<br><b>निष्पत्तिः - </b>मृङ् (प्राणत्यागे) + णिच् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>अश्वं मारयति<br><br>

अश्वमारक
अश्वमारक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗನ್ನೇರಳೆ ಗಿಡ<br><b>निष्पत्तिः - </b>"ण्वुल्" (३-१-१३३)<br><br>

अश्वमुख
अश्वमुख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿನ್ನರ /ಕುದುರೆಯ ಮುಖವುಳ್ಳ ಮತ್ತು ಮನುಷ್ಯಾಕಾರದ ಕಿಂಪುರುಷ<br><b>व्युत्पत्तिः - </b>अश्वस्य मुखमिव मुखमस्य<br><br>

अश्वमुखी
अश्वमुखी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿನ್ನರಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीष्" (४-१-६३)<br><br>

अश्वमेध
अश्वमेध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಮೇಧಯಾಗ<br><b>निष्पत्तिः - </b>मेधृ (हिंसने) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>प्रधानतया मेध्यते हिंस्यतेऽत्र<br><br>

अश्वमेधीय
अश्वमेधीय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಮೇಧ ಯಾಗಕ್ಕೆ ಅರ್ಹವಾದ ಕುದುರೆ<br><b>निष्पत्तिः - </b>"छः" (५-१-५)<br><b>व्युत्पत्तिः - </b>अश्वमेधाय हितः<br><br>

अश्वयुज्
अश्वयुज्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಿನೀ ನಕ್ಷತ್ರ<br><b>निष्पत्तिः - </b>युजिर् (योगे) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>अश्वं युनक्ति<br><br>अश्वयुज्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಯುಜ ಮಾಸ<br><b>निष्पत्तिः - </b>अधि० "क्विप्"<br><b>व्युत्पत्तिः - </b>अश्वेन श्वाकारतया नक्षत्रेन युज्यते पौर्णमास्यत्र<br><br>अश्वयुज्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯಿಂದ ಕೂಡಿದ ರಥ<br><br>अश्वयुज्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಶ್ವಿನೀನಕ್ಷತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१६) । वा लुक् ।<br><b>व्युत्पत्तिः - </b>अश्वयुजि जातः<br><br>अश्वयुज्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಥಕ್ಕೆ ಕುದುರೆಯನ್ನು ಕಟ್ಟುವ<br><br>

अश्वरत्न
अश्वरत्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ ಕುದುರೆ<br><br>अश्वरत्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಚ್ಚೈಃಶ್ರವಸ್ಸು<br><b>व्युत्पत्तिः - </b>अश्वो रत्नमिव<br><br>

अश्वराज
अश्वराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಚ್ಚೈಃಶ್ರವಸ್ಸು<br><b>निष्पत्तिः - </b>"टच्" (५-४-९१)<br><b>व्युत्पत्तिः - </b>अश्वानां राजा<br><br>

अश्ववार
अश्ववार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಸವಾರ<br><b>निष्पत्तिः - </b>वृञ् (वरणे) + णिच् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>अश्वं वारयति<br><b>प्रयोगाः - </b>"परस्परोत्पीडितजानुभागा दुःखेन निश्चक्रमुरश्ववाराः"<br><b>उल्लेखाः - </b>माघ० ३-६६<br><br>

अश्ववाह
अश्ववाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಸವಾರ<br><b>निष्पत्तिः - </b>वह (प्रापणे) + णिच् - "आण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>अश्वं वाहयति<br><br>

अश्ववाहक
अश्ववाहक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಸವಾರ<br><b>निष्पत्तिः - </b>"ण्वुल्" (३-१-१३३)<br><br>

अश्ववाहन
अश्ववाहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಸವಾರ<br><b>निष्पत्तिः - </b>"ल्युः" (३-१-१३४)<br><br>

अश्वविक्रयिन्
अश्वविक्रयिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ವ್ಯಾಪಾರಿ /ಕುದುರೆಯ ಮಾರಾಟಗಾರ<br><b>निष्पत्तिः - </b>"णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अश्वं विक्रेतुं शीलमस्य<br><br>

अश्ववैद्य
अश्ववैद्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ರೋಗಕ್ಕೆ ಚಿಕಿತ್ಸೆ ನಡೆಸುವವನು<br><br>

अश्वशास्त्र
अश्वशास्त्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಶುಭಾಶುಭಲಕ್ಷಣಗಳನ್ನು ತಿಳಿಸುವ ಶಾಸ್ತ್ರ<br><br>

अश्वसाद
अश्वसाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಸವಾರ<br><b>निष्पत्तिः - </b>षद्लृ (विशरणादौ) + णिच् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>अश्वं सादयति<br><br>

अश्वसादिन्
अश्वसादिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಸವಾರ<br><b>निष्पत्तिः - </b>षद्लृ (विशरणादौ) - "णिनिः" (३-३-१७०)<br><b>व्युत्पत्तिः - </b>अश्वे सीदत्यवश्यम्<br><b>प्रयोगाः - </b>"पूर्वं प्रहर्ता न जघान भूयः प्रतिप्रहाराक्षममश्वसादी"<br><b>उल्लेखाः - </b>रघु० ७-४७<br><br>

अश्वारोह
अश्वारोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಸವಾರ<br><b>निष्पत्तिः - </b>आ + रुह (बीजजन्मनि प्रादुर्भावे च) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>अश्वमारोहति<br><b>प्रयोगाः - </b>"अश्वारोहा गजारोहप्राणान् प्रासैरपाहरन्"<br><b>उल्लेखाः - </b>कुमा० १६-२९<br><br>

अश्वारोहा
अश्वारोहा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಗಂಧಿ ಗಿಡ<br><br>

अश्विक
अश्विक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಮೇಲೆ ಕುಳಿತು ಸಂಚರಿಸುವವನು<br><b>निष्पत्तिः - </b>चर (गतिभक्षणयोः) - "ष्ठन्" (४-४-१०)<br><b>व्युत्पत्तिः - </b>अश्वेन चरति<br><br>

अश्विन्
अश्विन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಿನೀ ದೇವತೆಗಳು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५) ।<br><b>व्युत्पत्तिः - </b>प्रशस्ताः अश्वाः सन्त्यनयोः<br><b>विस्तारः - </b>द्विवचनान्तं रूपम् ।<br><br>

अश्विनी
अश्विनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಿನೀ ನಕ್ಷತ್ರ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५) । "ङीप्" (४-१-५)<br><b>व्युत्पत्तिः - </b>अश्वः अश्वरूपमस्त्यस्याः<br><br>अश्विनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ರೂಪವನ್ನು ಧರಿಸಿದ ಸೂರ್ಯನ ಪತ್ನಿ /ಅಶ್ವಿನೀ ದೇವತೆಗಳ ತಾಯಿ<br><br>

अश्विनीकुमार
अश्विनीकुमार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವರೂಪವನ್ನು ಹೊಂದಿದ ಸೂರ್ಯನ ಪತ್ನಿ ಸಂಜ್ಞಾ ದೇವಿಯ ಕುಮಾರರು<br><br>

अश्वीय
अश्वीय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಸಮೂಹ /ಕುದುರೆಗಳ ಗುಂಪು<br><b>निष्पत्तिः - </b>"छः" (४-२-४८)<br><b>व्युत्पत्तिः - </b>अश्वानां समूहः<br><b>प्रयोगाः - </b>"वर्ध्राबद्धाधौरितेन प्रयातामश्वीयानामुच्चकैरुच्चलन्तः"<br><b>उल्लेखाः - </b>माघ० १८-५<br><br>

अषडक्षीण
अषडक्षीण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂರನೆಯವನಿಗೆ ತಿಳಿಯದಂತೆ ಇಬ್ಬರು ಮಾತ್ರ ಕಲೆತು ಮಾಡುವ ಮಂತ್ರಾಲೋಚನೆ<br><b>निष्पत्तिः - </b>"खः" (५-४-७)<br><b>व्युत्पत्तिः - </b>न सन्ति षडक्षीणि अत्र<br><br>

अषाढ
अषाढ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಷಾಢ ಮಾಸ<br><b>निष्पत्तिः - </b>"अण्" (४-२-२१)<br><b>व्युत्पत्तिः - </b>अषाढया युक्ता पौर्णमासी अषाढा । सा यत्र मासे<br><br>अषाढ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಚಾರಿಯು ಹಿಡಿಯುವ ಪಾಲಾಶದಂಡ /ಮುತ್ತುಗದ ದಂಡ<br><b>निष्पत्तिः - </b>"अण्" (५-१-११०)<br><b>व्युत्पत्तिः - </b>अषाढी पूर्णिमा प्रयोजनमस्य<br><br>

अषाढा
अषाढा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂರ್ವಾಷಾಢಾ ಮತ್ತು ಉತ್ತರಾಷಾಢಾ ನಕ್ಷತ್ರಗಳು<br><br>

अष्टक
अष्टक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>೮ ಅಧ್ಯಾಯವನ್ನೊಳಗೊಂಡ ಪಾಣಿನಿ ಸೂತ್ರ<br><b>निष्पत्तिः - </b>"कन्" (५-१-२२)<br><b>व्युत्पत्तिः - </b>अष्टौ अध्यायाः परिमाणमस्य<br><br>अष्टक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>೮ ಸಂಖ್ಯೆ<br><br>अष्टक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಣಿನಿ ಸೂತ್ರಗಳನ್ನು ತಿಳಿದವರು ಮತ್ತು ಅಧ್ಯಯನ ಮಾಡುವವರು<br><b>निष्पत्तिः - </b>"अण्" (४-१-५९) । तस्य लुक् (४-२-६५)<br><b>व्युत्पत्तिः - </b>अष्टकं पाणिनिसूत्रं विदन्ति अधीयते वा<br><br>अष्टक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಋಗ್ವೇದದ ಒಂದು ಭಾಗ<br><br>अष्टक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಂಟರಷ್ಟಾದ<br><b>निष्पत्तिः - </b>"कन्" (५-१-२२)<br><b>व्युत्पत्तिः - </b>अष्टौ परिमाणमस्य<br><br>

अष्टकर्ण
अष्टकर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ /ಚರ್ತುರ್ಮುಖ<br><b>व्युत्पत्तिः - </b>अष्टौ कर्णा अस्य<br><br>

अष्टकर्मन्
अष्टकर्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ /ದೊರೆ<br><b>व्युत्पत्तिः - </b>अष्टौ कर्माण्यस्य<br><br>

अष्टका
अष्टका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾರ್ಗಶೀರ್ಷ ಮೊದಲು ನಾಲ್ಕು ತಿಂಗಳ ಕೃಷ್ಣಪಕ್ಷದ ಸಪ್ತಮಿ ಅಷ್ಟಮಿ ಮತ್ತು ನವಮಿ ತಿಥಿತ್ರಯ<br><br>अष्टका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಈ ತಿಥಿಗಳಲ್ಲಿ ಮಾಡತಕ್ಕ ಶ್ರಾದ್ಧ<br><b>निष्पत्तिः - </b>अश (भोजने) - "तकन्" शकारस्य षत्वष्टुत्वे (उ० ३-१४८)<br><b>व्युत्पत्तिः - </b>अश्नन्ति पित्रर्थे ब्राह्मणः यस्याम्<br><br>अष्टका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಷ್ಟಮೀ ತಿಥಿ<br><b>प्रयोगाः - </b>"अमावास्या गुरुं हन्ति शिष्यं हन्ति चतुर्दशी । ब्रह्माष्टकापौर्णमास्यौ तस्मात्ताः परिवर्जयेत् ॥"<br><b>उल्लेखाः - </b>मनु० ४-११४<br><br>

अष्टकिक
अष्टकिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಷ್ಟಕೆಯಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५)<br><b>व्युत्पत्तिः - </b>अष्टकास्त्यस्य<br><br>

अष्टकिन्
अष्टकिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಷ್ಟಕಾಶ್ರಾದ್ಧವನ್ನು ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>अष्टका - "इनिः" (५-२-११५)<br><br>

अष्टक्य
अष्टक्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಂಟರಿಂದ ಕೊಳ್ಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"यत्" (५-१-२)<br><b>व्युत्पत्तिः - </b>अष्टकेन क्रीतम्<br><br>

अष्टगुण
अष्टगुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಂಟು ಗುಣಗಳಿಂದ ಕೂಡಿದ ಬ್ರಾಹ್ಮಣ<br><br>अष्टगुण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಂಟರಿಂದ ಗುಣಿಸಲ್ಪಟ್ಟ<br><br>

अष्टचत्वारिंश
अष्टचत्वारिंश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>೪೮ನೆಯ<br><b>निष्पत्तिः - </b>"डट्" (५-२-४८)<br><b>व्युत्पत्तिः - </b>अष्टचत्वारिंशतः पूरणः<br><br>अष्टचत्वारिंश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>೪೮ನೆಯ<br><b>निष्पत्तिः - </b>पक्षे "डट्"<br><br>

अष्टचत्वारिंशत्
अष्टचत्वारिंशत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಲವತ್ತೆಂಟು<br><b>व्युत्पत्तिः - </b>अष्टभिरधिका चत्वारिंशत्<br><br>

अष्टचत्वारिंशत्तम
अष्टचत्वारिंशत्तम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>೪೮ನೆಯ<br><b>निष्पत्तिः - </b>वा "तमट्" (५-२-५६)<br><b>व्युत्पत्तिः - </b>अष्टचत्वारिंशतः पूरणः<br><br>

अष्टतय
अष्टतय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಂಟು /ಎಂಟು ಭಾಗಳಸಮೂಹ<br><br>अष्टतय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಂಟು ಭಾಗಗಳುಳ್ಳ<br><b>निष्पत्तिः - </b>"तयप्" (५-२-४२)<br><b>व्युत्पत्तिः - </b>अष्टौ अवयवा यस्य<br><br>

अष्टत्रिक
अष्टत्रिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>೨೪<br><br>

अष्टत्रिंश
अष्टत्रिंश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>೩೮ ನೆಯ<br><b>निष्पत्तिः - </b>"डट्" (५-२-४८)<br><b>व्युत्पत्तिः - </b>अष्टत्रिंशतः पूरणः<br><br>

अष्टत्रिंशत्
अष्टत्रिंशत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>೩೮<br><b>विस्तारः - </b>೮ ದಿಗ್ಗಜಗಳ ಪತ್ನಿಯರು - ಅಭ್ರಮು, ಕಪಿಲೆ, ಪಿಂಗಳೆ, ಅನುಪಮೆ, ತಾಮ್ರಪರ್ಣಿ, ಶುಭ್ರದಂತಿ, ಅಂಗನೆ ಮತ್ತು ಅಂಜನಾವತಿ<br><br>

अष्टदल
अष्टदल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಷ್ಟದಳಪದ್ಮ<br><b>व्युत्पत्तिः - </b>अष्टौ दलान्यस्य<br><b>विस्तारः - </b>೮ ದಿಕ್ಕುಗಳ ಅಧಿಪತಿಗಳು - ಇಂದ್ರ, ಅಗ್ನಿ, ಯಮ, ನಿರೃತಿ, ವರುಣ , ವಾಯು, ಕುಬೇರ ಮತ್ತು ಈಶ<br><br>

अष्टदिक्करिणी
अष्टदिक्करिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>೮ ದಿಗ್ಗಜಗಳ ಪತ್ನಿಯರು<br><b>विस्तारः - </b>೮ ದಿಕ್ಕುಗಳಲ್ಲಿರುವ ಆನೆಗಳು - ಐರಾವತ, ಪುಂಡರೀಕ, ವಾಮನ, ಕುಮುದ, ಅಂಜನ, ಪುಷ್ಪದಂತ, ಸಾರ್ವಭೌಮ, ಸುಪ್ರತೀಕ<br><br>

अष्टदिक्पाल
अष्टदिक्पाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೮ ದಿಕ್ಕುಗಳ ಅಧಿಪತಿಗಳು<br><br>

अष्टदिग्गज
अष्टदिग्गज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೮ ದಿಕ್ಕುಗಳಲ್ಲಿರುವ ಆನೆಗಳು<br><br>

अष्टद्रव्य
अष्टद्रव्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗಕ್ಕೆ ಬೇಕಾಗುವ ೮ ದ್ರವ್ಯಗಳು<br><b>प्रयोगाः - </b>"अश्वत्थोदुम्बरप्लक्षन्यग्रोधसमिधस्तिलाः । सिद्धार्थपायसाज्यानि द्रव्याण्यष्टौ विदुर्बुधाः ॥"<br><br>

अष्टधा
अष्टधा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎಂಟು ಪ್ರಕಾರವಾಗಿ<br><b>निष्पत्तिः - </b>अष्टन् - प्रकारे "धा" (५-३-४२)<br><b>प्रयोगाः - </b>"सुरद्विपानामिव सामयोनिर्भिन्नोष्टधा विप्रससार वंशः"<br><b>उल्लेखाः - </b>रघु० १६-३<br><br>

अष्टधातु
अष्टधातु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುವರ್ಣ ಮೊದಲಾದ ೮ ಧಾತುಗಳು<br><b>प्रयोगाः - </b>"स्वर्णं रूप्यं च ताम्रं च रङ्गं यशदमेव च । सीसं लोहं रसश्चेति धातवोऽष्टौ प्रकीर्तिताः ॥"<br><br>

अष्टन्
अष्टन्<br><br><b>पदविभागः - </b>त्रिलिङ्गः<br><b>कन्नडार्थः - </b>ಎಂಟು<br><b>प्रयोगाः - </b>"निन्द्यास्वष्टासु चान्यासु स्त्रियो रात्रिषु वर्जयन्"<br><b>उल्लेखाः - </b>मनु० ३-५०<br><br>

अष्टपद
अष्टपद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶರಭ ಮೃಗ<br><br>अष्टपद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೇಡರ ಹುಳು<br><b>व्युत्पत्तिः - </b>अष्टौ पदान्यस्य<br><br>

अष्टम
अष्टम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಂಟನೆಯ<br><b>निष्पत्तिः - </b>"डट्" (५-२-४८) । "मट्" (५-२-४९)<br><b>व्युत्पत्तिः - </b>अष्टानां पूरणः<br><b>प्रयोगाः - </b>"गर्भष्टमेऽब्दे कुर्वीत ब्राह्मणोस्योपनायनम्"<br><b>उल्लेखाः - </b>मनु० २-३६<br><br>

अष्टमी
अष्टमी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಂಟನೆಯ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>अष्टमी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಡ್ಯ ಮೊದಲಾಗಿ ಪಕ್ಷದ ೮ನೆಯ ತಿಥಿ<br><b>निष्पत्तिः - </b>अष्टम - "ङीप्" (४-१-१५)<br><br>

अष्टमङ्गल
अष्टमङ्गल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಗಳ ವಸ್ತುಗಳು<br><b>व्युत्पत्तिः - </b>अष्टौ मङ्गलानि<br><b>प्रयोगाः - </b>"मृगराजो वृषो नागः कलशो व्यजनं तथा । वैजयन्ती तथा भेरी दीप इत्यष्टमङ्गलम् ॥"<br><br>

अष्टमभाव
अष्टमभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಾತಕದಲ್ಲಿ ಜನ್ಮ ಲಗ್ನದಿಂದ ೮ನೆಯ ಸ್ಥಾನ /ತನ್ವಾದಿ ದ್ವಾದಶಭಾವಗಳಲ್ಲೊಂದಾದ ಆಯಃಸ್ಥಾನ<br><b>व्युत्पत्तिः - </b>अष्टमो भावः<br><b>प्रयोगाः - </b>"अष्टमं चायुषः स्थानमष्टमादष्टमं च यत् । तयोरपि व्ययस्थानं मारकस्थानमुच्यते"<br><br>

अष्टमूत्रि
अष्टमूत्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><b>व्युत्पत्तिः - </b>अष्टौ मूर्तयोऽस्य<br><b>प्रयोगाः - </b>"यामाहुः सर्वबीजप्रकृतिरिति यया प्राणिनः प्राणवन्तः । प्रत्यक्षाभिः प्रपन्नः तनुभिः अवतुवस्ताभिरष्टाभिरीशः ॥"<br><b>उल्लेखाः - </b>शाकु० १-१<br><br>अष्टमूत्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರನ ಪೃಥಿವಿ ಮೊದಲಾದ ೮ ಮೂರ್ತಿಗಳು<br><br>

अष्टमूत्रिधर
अष्टमूत्रिधर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><b>व्युत्पत्तिः - </b>अष्टानां मूर्तीनां धरः<br><b>प्रयोगाः - </b>"आप्लुतः स विमलैर्जलैरभूदष्टमूर्तिधरमूर्तिरष्टमी"<br><b>उल्लेखाः - </b>माघ० १४-१८<br><br>

अष्टवर्ग
अष्टवर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಷೋಕ್ತವಾದ ಶುಭಾಶುಭಗಳನ್ನು ತಿಳಿಸುವ ರೇಖಾಕಾರವಾದ ಒಂದು ಚಕ್ರ<br><br>अष्टवर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ನಗಳ ೮ ಗುಂಪು<br><br>

अष्टाङ्ग
अष्टाङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಂಟು ಅಂಗಗಳುಳ್ಳ ಯೋಗ<br><b>व्युत्पत्तिः - </b>अष्टौ अङ्गान्यस्य<br><b>प्रयोगाः - </b>"यमनियमासनप्राणायामप्रत्याहारधारणाध्यानसमाधयोऽष्टाङ्गानि"<br><b>उल्लेखाः - </b>पा० यो० सू० २-२९<br><br>अष्टाङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಷ್ಟಾಂಗಗಳಿಂದ ಮಾಡುವ ನಮಸ್ಕಾರ<br><b>प्रयोगाः - </b>"दोर्भ्यां पद्भ्यां च जानुभ्यामुरसा शिरसा दृशा । मनसा वचसा चेति प्रणामोऽष्टाङ्ग ईरितः ॥"<br><b>उल्लेखाः - </b>वैद्यना० आह्निक०<br><br>अष्टाङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೮ ವಿಧ ಪೂಜಾದ್ರವ್ಯಗಳು<br><b>प्रयोगाः - </b>"आपः क्षीरं कुशाग्रं च दधि सर्पिः सतण्डुलम् । यवः सिद्धार्थकश्चैव अष्टाङ्गोऽर्धः प्रकीर्तितः ॥"<br><br>अष्टाङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೮ ಅಂಗಗಳುಳ್ಳ ಆಯುರ್ವೇದ<br><br>

अष्टाङ्गधूप
अष्टाङ्गधूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ವರ ವಾಸಿಯಾಗಲು ಉಪಯೋಗಿಸುವ ಒಂದು ಧೂಪ<br><b>प्रयोगाः - </b>"पलङ्कषा निम्बपत्रं वचा कुण्ठं हरीतकी । सर्षपाः सयवाः सर्पिर्धूपनं ज्वरनाशनम् ॥"<br><b>उल्लेखाः - </b>चक्रद०<br><br>

अष्टाङ्गमैथुन
अष्टाङ्गमैथुन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತ್ರೀಸಂಬಂಧವಾದ ೮ ವಿಧ ಸುಖಾನುಭವ<br><br>

अष्टादश
अष्टादश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹದಿನೆಂಟನೆಯ<br><b>निष्पत्तिः - </b>"डट्" (५-२-४८)<br><b>व्युत्पत्तिः - </b>अष्टादशानां पूरणः<br><b>प्रयोगाः - </b>"अगाहताष्टादशतां जिगीषया नवद्वयद्वीपपृथग्जयश्रियाम्"<br><b>उल्लेखाः - </b>नैष० १-५<br><br>

अष्टादशी
अष्टादशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹದಿನೆಂಟನೆಯ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

अष्टादशद्रव्य
अष्टादशद्रव्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>೧೮ ವಿಧ ಧಾನ್ಯಗಳು<br><b>विस्तारः - </b>"यवगोधूमधान्यानि तिलाः कङ्कुकुलत्थकाः । माषा मुद्रा मसूराश्च निष्पावाः श्यामसर्षपाः । गवेधुकाश्च नीवारा आढक्योऽथ सतीनकाः । चणकाश्चीनकाश्चैव धान्यान्यष्टादशैव तु ॥" - हेमाद्रि० दा० खं०<br><br>

अष्टादशन्
अष्टादशन्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹದಿನೆಂಟು<br><b>व्युत्पत्तिः - </b>अष्टौ च दश च<br><br>

अष्टादशपुराण
अष्टादशपुराण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಸಮಹರ್ಷಿಪ್ರಣೀತವಾದ ೧೮ ಮಹಾಪುರಾಣಗಳು<br><br>

अष्टादशविद्या
अष्टादशविद्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇದ ಮೊದಲಾದ ೧೮ ವಿದ್ಯೆಗಳು<br><b>विस्तारः - </b>"अङ्गानि वेदाश्चत्वारो मीमांसा न्यायविस्तरः । धर्मशास्त्रं पुराणं च विद्याह्येताः चतुर्दश । आयुर्वेदो धनुर्वेदो गान्धर्वश्चेति ते त्रयः । अर्थशास्त्रं चतुर्थं च विद्याः अष्टादशैव तु ॥" - हेमाद्रि० ।<br><br>

अष्टादशविवादपद
अष्टादशविवादपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>೧೮ ವಿಧ ವ್ಯವಹಾರ ಸ್ಥಾನಗಳು<br><br>

अष्टादशस्मृतिकारिन्
अष्टादशस्मृतिकारिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೧೮ ಸ್ಮೃತಿಗಳನ್ನು ಬರೆದ ಮಹರ್ಷಿಗಳು<br><b>विस्तारः - </b>"विष्णुः पराशरो दक्षः संवर्तव्यासहारिताः । शातातपो वसिष्ठश्च यमापस्तम्बगौतमाः । देवलः शङ्खलिखितौ भरद्वाजोशनोऽत्रयः । शौनको याज्ञवल्क्यश्च दशाष्टौ स्मृतिकारिणः ॥"<br><br>

अष्टादशोपचार
अष्टादशोपचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜಾಸಂಬಂಧವಾದ ೧೮ ಉಪಚಾರಗಳು<br><br>

अष्टादिशाब्दिक
अष्टादिशाब्दिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೮ ಮಂದಿ ವ್ಯಾಕರಣ ಶಾಸ್ತ್ರ ಪ್ರವರ್ತಕರು<br><b>विस्तारः - </b>"इन्द्रश्चन्द्रः काशकृत्स्नापिशलिः शाकटायनः । पाणिन्यमरजैनेन्द्राः जयन्त्यष्टादि शाब्दिकाः ॥"<br><br>

अष्टापद
अष्टापद<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಣ /ಚಿನ್ನ<br><b>व्युत्पत्तिः - </b>अष्टसु लोहेषु पदं प्रतिष्ठाऽस्य<br><b>प्रयोगाः - </b>"अचेष्टताष्टापदभूमिरेणुः पादाहतो यत्सदृशं गरिम्णः"<br><b>उल्लेखाः - </b>माघ० ३-२८<br><br>अष्टापद<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಗಡೆಯ ಹಾಸು<br><b>व्युत्पत्तिः - </b>अष्टौ अष्टौ पदानि पक्क्तावस्य<br><br>अष्टापद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶರಭಮೃಗ<br><br>अष्टापद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರ್ಕಟ /ಕಪಿ<br><br>अष्टापद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೇಡರ ಹುಳು<br><b>विस्तारः - </b>"अष्टापदोऽस्त्री कनके शाराणां फलकेऽपि च । अष्टापदी चन्द्रमत्यां शरभे मर्कटे पुमान् ॥" - मेदि० ।<br><br>

अष्टापदी
अष्टापदी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಮಲ್ಲಿಗೆ<br><br>

अष्टाविंश
अष्टाविंश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಪ್ಪತ್ತೆಂಟನೆಯ<br><b>निष्पत्तिः - </b>"डट्" (५-२-४८)<br><br>

अष्टाविंशति
अष्टाविंशति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>೨೮<br><b>निष्पत्तिः - </b>"आत्" (६-३-४७)<br><b>व्युत्पत्तिः - </b>अष्टाधिका विंशतिः<br><br>

अष्टाविंशतितम
अष्टाविंशतितम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಪ್ಪತ್ತೆಂಟನೆಯ<br><b>निष्पत्तिः - </b>"डट्" (५-२-४८) । "तमट्" (५-२-५६)<br><br>

अष्टावक्र
अष्टावक्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಹೋಡ ಋಷಿಯ ಮಗ<br><b>व्युत्पत्तिः - </b>अष्टसु भागेषु वक्रः<br><b>विस्तारः - </b>"उपालब्धः शिष्यमध्ये महर्षिः स तं कोपादुदरस्थं शशाप । यस्मात् कुक्षौ वर्तमानो ब्रवीषि तस्माद्वक्रो भवितास्यष्टकृत्वः ।" - भा० वन०<br><br>

अष्टि
अष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೀಜ /ಕಾಳು<br><b>निष्पत्तिः - </b>असु (क्षेपणे० - "क्तिन्" (३-३-९४) । पृषो० ।<br><b>व्युत्पत्तिः - </b>अस्यते भूमौ क्षिप्यते<br><br>अष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಪ್ತಿ /ಹರಡುವಿಕೆ<br><br>अष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಖಸಾಧನವಾದ ದೇಹ /ಶರೀರ<br><br>अष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹದಿನಾರನೆಯ ಛಂದಸ್ಸು<br><br>अष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹದಿನಾರು ಸಂಖ್ಯೆ<br><br>अष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಗಡೆಯ ದಾಳ<br><br>

अष्ठीवत्
अष्ठीवत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಡಿ ತೊಡೆ ಮತ್ತು ಮೊಣಕಾಲುಗಳ ಸಂದು<br><b>निष्पत्तिः - </b>"मतुप्" अष्ठीभावश्च निपा० (८-२-१२)<br><b>व्युत्पत्तिः - </b>अतिशयितमस्थि यस्मिन्<br><b>विस्तारः - </b>"जानूरुपर्वाष्ठीवदस्त्रियाम्" - अम० ।<br><br>

अस|भुवि|अस्ति
अस - भुवि (अदा० पर० अक० से०) अस्ति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಇರು<br><br>

असंयत
असंयत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಂಧಿಸಲ್ಪಡ್ಡ /ಕಟ್ಟಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न संयतः<br><br>असंयत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತೋಟಿಯಲ್ಲಿಡಲ್ಪಡದ<br><b>प्रयोगाः - </b>"असंयतात्मना योगो दुष्प्राप्य इति मे मतिः"<br><b>उल्लेखाः - </b>गीता० ६-३६<br><br>

असंयुक्त
असंयुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಟ್ಟಿಗೆ ಸೇರಿಕೊಂಡಿರುವ<br><b>व्युत्पत्तिः - </b>न संयुक्तः<br><br>

असंयुत
असंयुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆರೆಸಲ್ಪಡದ /ಮಿಶ್ರ ಮಾಡಲ್ಪಡದ<br><b>निष्पत्तिः - </b>अ + सम् + यु (मिश्रणेऽमिश्रणे च) - "क्तः" (३-२-१०२)<br><br>

असंलग्न
असंलग्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಟ್ಟಿಗೆ ಸೇರಿಕೊಂಡಿರುವ<br><b>व्युत्पत्तिः - </b>न संलग्नः<br><br>

असंवृत
असंवृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನರಕ<br><b>प्रयोगाः - </b>"योऽह्यस्य धर्ममाचष्टे यश्चैवादिशति व्रतम् । सोऽसंवृतं नाम तमः सह तेनैव गच्छति ॥"<br><b>उल्लेखाः - </b>मनु० ४-८१<br><br>असंवृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಲ್ಪಡದ /ತೆರೆದಿರುವ<br><b>व्युत्पत्तिः - </b>न संवृतः<br><b>प्रयोगाः - </b>"नासंवृतमुखः कुर्यात् क्षुतं जृम्भां तथैव च"<br><br>

असंशय
असंशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂದೇಹವಿಲ್ಲದಿರುವಿಕೆ<br><br>असंशय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂದೇಹವಿಲ್ಲದ<br><br>असंशय<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಸಂದೇಹವಿಲ್ಲದೆ<br><b>प्रयोगाः - </b>"असंशयं महाबाहो मनो दुर्निग्रहं चलम् । अभ्यासेन तु कौन्तेय वैराग्येण च गृह्यते ॥"<br><b>उल्लेखाः - </b>गीता० ६-३५<br><br>

असंश्लिष्ट
असंश्लिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇರಿಕೊಂಡಿಲ್ಲದ /ಬೇರೆ ಬೇರೆಯಾಗಿರುವ<br><b>व्युत्पत्तिः - </b>न संश्लिष्टः<br><br>

असंसृष्ट
असंसृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧವಿಲ್ಲದ /ಬೆರೆತಿರದ<br><b>व्युत्पत्तिः - </b>न संसृष्टः<br><br>असंसृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಸ್ತಿಯ ವಿಭಾಗವಾದ ನಂತರ ಮತ್ತೆ ಒಂದೇ ಕುಟುಂಬದಲ್ಲಿ ಸೇರಿಕೊಂಡಿರುವ<br><br>

असंस्कृत
असंस्कृत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣಸಂಸ್ಕಾರವಿಲ್ಲದ ಅಪಶಬ್ದ<br><br>असंस्कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಸ್ಕಾರ ಮಾಡಲ್ಪಡದ<br><br>असंस्कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗರ್ಭಾಧಾನ ಮೊದಲಾದ ಸಂಸ್ಕಾರವಿಲ್ಲದ<br><br>असंस्कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಗುಣ ಹೊಂದಿಸಲ್ಪಡದ<br><br>

असंस्तुत
असंस्तुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಿಚಯವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न संस्तुतः<br><b>प्रयोगाः - </b>"प्रसह्य चेतःसु समासजन्तमसंस्तुतानामपि भावमार्द्रम्"<br><b>उल्लेखाः - </b>किरा० ३-२<br><br>असंस्तुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಸ್ತುತಿಸಲ್ಪಡದ<br><br>

असकृत्
असकृत्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪುನಃ ಪುನಃ<br><b>व्युत्पत्तिः - </b>न सकृत्<br><b>प्रयोगाः - </b>"असकृद्गृहीतबहुदेहसम्भवस्तदसौ विभक्तनवगोपुरान्तरम्"<br><b>उल्लेखाः - </b>माघ० १३-२८<br><br>

असक्त
असक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಸಕ್ತಿಯಿಲ್ಲದ /ಆಸೆಯಿಲ್ಲದ<br><b>प्रयोगाः - </b>"जुगोप आत्मानमत्रस्तो भेजे धर्ममनातुरः"<br><b>उल्लेखाः - </b>रघु० १-२१<br><br>असक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಟಿಕೊಂಡಿರದ /ಸೇರಿಕೊಂಡಿಲ್ಲದ<br><b>प्रयोगाः - </b>"आसीत् विवृत्तवदना च विमोचयन्ती शाखासु वल्कलमसक्तमपि द्रुमाणाम्"<br><b>उल्लेखाः - </b>शाकु० २-१२<br><br>असक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಸನಿಯಲ್ಲದ /ತತ್ಪರನಲ್ಲದ<br><br>असक्त<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ವ್ಯಸನಿಯಲ್ಲದೆ /ನಿಮಗ್ನನಾಗದೆ<br><b>प्रयोगाः - </b>"असक्तमारधयतो यथायथं विभज्य भक्त्या समपक्षपातया"<br><b>उल्लेखाः - </b>किरा० १-११<br><br>असक्त<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಬಂಧಕವಿಲ್ಲದೆ<br><b>प्रयोगाः - </b>"असक्तमूर्धासि पयः क्षरन्त्यमूरुपायनानीव नयन्ति धेनवः"<br><b>उल्लेखाः - </b>किरा० ४-३१<br><br>

असङ्कुस
असङ्कुस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಥಿರಬುದ್ಧಿಯುಳ್ಳ<br><b>निष्पत्तिः - </b>कस (गतौ) - "उकन्" (उ० २-२९)<br><b>व्युत्पत्तिः - </b>सङ्कसति<br><br>

असङ्ख्य
असङ्ख्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಣಿಸಲಾಗದ /ಲೆಕ್ಕವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति सङ्ख्या यस्य<br><b>प्रयोगाः - </b>"असङ्ख्यैरद्भुतैः तुङ्गैः क्रम्ये राक्षसपर्वतैः"<br><b>उल्लेखाः - </b>याद० १-३९<br><br>

असङ्ख्यात
असङ्ख्यात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಣಿಸಲಾಗದ /ಲೆಕ್ಕವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न सङ्ख्यातः<br><b>प्रयोगाः - </b>"असङ्ख्यातास्त्रौघद्रविणमदमत्तस्य च रिपोः"<br><b>उल्लेखाः - </b>वेणी० ३-२२<br><br>

असङ्ख्येय
असङ्ख्येय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>न सङ्ख्यातुं शक्यः<br><b>प्रयोगाः - </b>"असङ्ख्येयोऽप्रमेयात्मा"<br><b>उल्लेखाः - </b>वि० स०<br><br>असङ्ख्येय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಣಿಸಲಾಗದ /ಲೆಕ್ಕವಿಲ್ಲದ<br><br>असङ्ख्येय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಮಾನ್ಯ ಜನರಿಂದ ತಿಳಿಯಲಾಗದ<br><br>

असङ्ग
असङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧವಿಲ್ಲದಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"अहिंसयेन्द्रियासङ्गैर्वैदिकैश्चैव कर्मभिः"<br><b>उल्लेखाः - </b>मनु० ६-७५<br><br>असङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಂಖ್ಯಮತದಲ್ಲಿ ಪುರುಷ<br><br>असङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧವಿಲ್ಲದ<br><br>असङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಡ್ಡಿಯಿಲ್ಲದ /ಪ್ರತಿಬಂಧಕವಿಲ್ಲದ<br><b>प्रयोगाः - </b>"असङ्गमद्रिष्वपि सारवत्तया न मे त्वदन्येन विसोढमायुधम्"<br><b>उल्लेखाः - </b>रघु० ३-६३<br><br>

असङ्गत
असङ्गत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಯುಕ್ತವಾದ /ಅಸಭ್ಯವಾದ<br><br>असङ्गत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿರುದ್ಧವಾದ /ಹೊಂದಿಕೆಯಿಲ್ಲದ<br><br>असङ्गत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧವಿಲ್ಲದ<br><br>

असङ्गति
असङ्गति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಂಬದ್ಧತೆ /ಅಬದ್ಧ<br><br>असङ्गति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧವಿಲ್ಲದಿರುವಿಕೆ<br><br>असङ्गति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಂಗತಿಯೆಂಬ ಒಂದು ಅರ್ಥಾಲಂಕಾರ<br><b>प्रयोगाः - </b>"विरुद्धं भिन्नदेशत्वं कार्यहेत्वोरसङ्गतिः । विषं जलधरैः पीतं मूर्च्छिताः पथिकाङ्गनाः ॥"<br><b>उल्लेखाः - </b>चन्द्रा०<br><br>

असत्
असत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><br>असत्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸತ್ತು /ಅಭಾವ<br><br>असत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸತ್ಯ /ಸುಳ್ಳು<br><br>असत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೇಶಕಾಲಗಳ ಸಂಬಂಧವಿಲ್ಲದ<br><br>असत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯರೂಪಕ್ಕೆ ಬರದೆ ಅವ್ಯಾಕೃತವಾದ<br><b>प्रयोगाः - </b>"असद्वा इदमग्र आसीत्"<br><b>उल्लेखाः - </b>तै० उ०<br><br>असत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈಗ ಇಲ್ಲದ /ಅತೀತವಾದ<br><b>प्रयोगाः - </b>"तपाम्यहमहं वर्षं निगृह्णाम्युत्सृजामि च । अमृतं चैव मृत्युश्च सदसच्चाहमर्जुन ॥"<br><b>उल्लेखाः - </b>गीता० ९-१९<br><br>असत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳ್ಳೆಯದಲ್ಲದ<br><b>प्रयोगाः - </b>"तं सन्तः श्रोतुमर्हन्ति सदसद्व्यक्तिहेतवः"<br><b>उल्लेखाः - </b>रघु० १-१०<br><br>असत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ನಡತೆಯುಳ್ಳ<br><br>असत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರದ್ಧೆಯಿಲ್ಲದೆ ಮಾಡುವ ಕಾರ್ಯ<br><b>प्रयोगाः - </b>"अश्रद्धया हुतं दत्तं तपस्तप्तं कृतं च यत् । असदित्युच्यते पार्थ न च तत्प्रेत्य नो इह ॥"<br><b>उल्लेखाः - </b>गीता० १७-२८<br><br>असत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಲ್ಲದ /ಸುಳ್ಳಾದ<br><b>प्रयोगाः - </b>"आत्मनो ब्रह्मणो भेदमसन्तं कः करिष्यति"<br><b>उल्लेखाः - </b>सङ्क्षेपशारीरकम्<br><br>

असती
असती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಲಟೆ /ಸ್ವೈರಿಣಿ<br><br>

असत्ता
असत्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸತ್ಯ /ಮಿಥ್ಯೆ<br><br>असत्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟತನ /ದುರುಳತನ<br><br>असत्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸತ್ತು /ಅಭಾವ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>असतो भावः<br><br>

असत्त्व
असत्त्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸತ್ಯ /ಮಿಥ್ಯೆ<br><br>असत्त्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟತನ /ದುರುಳತನ<br><br>असत्त्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವ್ಯಕ್ತತೆ /ಕಾರಣಾವಸ್ಥೆ<br><br>असत्त्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಜೋಗುಣ<br><br>असत्त्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಮೋಗುಣ<br><br>असत्त्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಲವಿಲ್ಲದ /ಶಕ್ತಿಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति सत्त्वं बलं यस्य<br><br>असत्त्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸತ್ತ್ವಗುಣವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न सत्त्वं सत्त्वगुणो यस्य<br><br>असत्त्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾಣಿಗಳಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति सत्त्वानि प्राणिनो यस्य<br><br>

असत्य
असत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಿಥ್ಯೆ /ಸುಳ್ಳು<br><br>असत्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಳ್ಳಾದ<br><br>असत्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಲ್ಪನಿಕ /ನಿಜವಲ್ಲದ<br><b>प्रयोगाः - </b>"असत्यकण्ठार्पितबाहुबन्धना"<br><b>उल्लेखाः - </b>कुमा० ५-५७<br><br>

असदागम
असदागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಚ್ಛಾಸ್ತ್ರ /ನಾಸ್ತಿಕ ಮತ<br><b>व्युत्पत्तिः - </b>असंश्चावागमश्च<br><br>असदागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ಯಯವಾದ ದ್ರವ್ಯಸಂಪಾದನೆ<br><br>असदागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ರಮವಾದ ವಸ್ತುಪ್ರಾಪ್ತಿ<br><b>व्युत्पत्तिः - </b>असतः आगमः<br><br>

असदाचार
असदाचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ನಡತೆ<br><b>व्युत्पत्तिः - </b>असंश्चासावाचारश्च<br><br>असदाचार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ನಡತೆಯುಳ್ಳ<br><br>

असदृश
असदृश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಮಾನ /ಸರ್ವೋತ್ಕೃಷ್ಟವಾದ<br><b>व्युत्पत्तिः - </b>असन् आचारो यस्य<br><br>असदृश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುರೂಪವಾದ /ಹೊಂದಿಕೆಯಿಲ್ಲದ<br><br>असदृश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯವಾದ /ಅಕ್ರಮವಾದ<br><br>

असद्ग्रह
असद्ग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭ್ರಾಂತಿಜ್ಞಾನ /ಮಿಥ್ಯಾಜ್ಞಾನ<br><br>असद्ग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಕ್ಕಳ ಮೊಂಡುತನ<br><b>व्युत्पत्तिः - </b>असति अविद्यमाने मिथ्याभूते वस्तुनि ग्रहः आग्रहः<br><br>

असद्धेतु
असद्धेतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೋಷದಿಂದ ಕೂಡಿದ ಕಾರಣ<br><br>

असद्भाव
असद्भाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿರುದ್ಧಾಭಿಪ್ರಾಯ<br><br>असद्भाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಾವ /ಇಲ್ಲದಿರುವುದು<br><br>

असद्वृत्ति
असद्वृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರಾಚಾರ /ಕೆಟ್ಟ ನಡವಳಿಕೆ<br><b>व्युत्पत्तिः - </b>असती वृत्तिः<br><br>असद्वृत्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುರಾಚಾರವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>असती वृत्तिः यस्य<br><br>

असद्व्यवहार
असद्व्यवहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಅಭ್ಯಾಸ<br><br>असद्व्यवहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ನಡತೆಯುಳ್ಳವರೊಡನೆ ವ್ಯವಹಾರ<br><br>असद्व्यवहार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುರಾಚಾರವುಳ್ಳ<br><br>

असन
असन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊನ್ನೆ ಮರ<br><b>निष्पत्तिः - </b>असु (क्षेपणे) - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अस्यति रुजम्<br><br>

असन
असन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಸೆಯುವುದು /ಬಿಸಾಡುವುದು<br><b>निष्पत्तिः - </b>असु - "ल्युट्" (३-३-११५)<br><br>

असन्तुष्ट
असन्तुष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷ ಹೊಂದದ<br><b>प्रयोगाः - </b>"असन्तुष्टो द्विजो नष्टः सन्तुष्टश्च महीपतिः"<br><br>

असन्तोष
असन्तोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತೃಪ್ತಿ /ಅಸಂತೋಷ<br><br>असन्तोष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न सन्तोषो यस्य<br><br>

असन्नद्ध
असन्नद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಬ್ಬಿದ /ಗರ್ವಗೊಂಡ<br><br>असन्नद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕವಚ ತೊಟ್ಟು ಯುದ್ಧಕ್ಕೆ ಸಿದ್ಧನಾಗಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न सन्नद्धः<br><br>

असन्निकर्ष
असन्निकर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೂರ /ಸಮೀಪ ಸಂಬಂಧವಿಲ್ಲದಿರುವಿಕೆ<br><br>असन्निकर्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೂರದಲ್ಲಿರುವ<br><br>असन्निकर्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಷಯಪ್ರತ್ಯಕ್ಷಕ್ಕೆ ಬೇಕಾದ ಸಂಯೋಗ ಮೊದಲಾದ ೬ ವಿಧ ಸಂಬಂಧವಿಲ್ಲದ<br><br>

असन्निकृष्ट
असन्निकृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೂರದಲ್ಲಿರುವ<br><br>असन्निकृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಷಯಪ್ರತ್ಯಕ್ಷಕ್ಕೆ ಬೇಕಾದ ಸಂಯೋಗ ಮೊದಲಾದ ೬ ವಿಧ ಸಂಬಂಧವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न सन्निकृष्टः<br><br>

असन्निधि
असन्निधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೂರ<br><br>असन्निधि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೂರದಲ್ಲಿರುವ<br><br>

असन्निहित
असन्निहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೂರದಲ್ಲಿರುವ<br><br>

असपत्न
असपत्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಿತ್ರ /ಸುಹೃತ್ತು<br><br>असपत्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶತ್ರುವಿಲ್ಲದ /ವೈರಿಯಿಲ್ಲದ<br><b>प्रयोगाः - </b>"अवाप्य भूमावसपत्नमृद्धम्"<br><b>उल्लेखाः - </b>गीता० २-८<br><br>

असपिण्ड
असपिण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಂಶದಲ್ಲಿ ೭ ತಲೆಯ ನಂತರ ಹುಟ್ಟಿದವನು /ರಕ್ತ ಸಂಬಂಧವಿಲ್ಲದವನು<br><b>प्रयोगाः - </b>"सपिण्डता तु पुरुषे सप्तमे विनिवर्तते"<br><b>उल्लेखाः - </b>मनु० ५-६०<br><br>

असभ्य
असभ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಭೆಗೆ ಯೋಗ್ಯನಲ್ಲದವನು<br><b>निष्पत्तिः - </b>"यः" (४-४-१०५)<br><b>व्युत्पत्तिः - </b>सभायां साधुः<br><br>

असम
असम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾನವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति समो यस्य<br><br>असम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾನವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न समः<br><b>प्रयोगाः - </b>"समवतारसमैरसमैस्तटैः"<br><b>उल्लेखाः - </b>किरा० ५-७<br><br>असम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮವಲ್ಲದ<br><br>असम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಳ್ಳತಿಟ್ಟಾದ<br><br>असम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಷಮವಾದ<br><br>

असमग्र
असमग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಂಪೂರ್ಣವಾದ<br><br>

असमञ्ज
असमञ्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಗರ ಚಕ್ರವರ್ತಿಯ ಮಗ<br><br>

असमञ्जस
असमञ्जस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಂಗತವಾದ /ಅಸಂಬದ್ಧವಾದ<br><b>प्रयोगाः - </b>"असमञ्जसमिति मत्वा तथापि तरलायते चेतः"<br><b>उल्लेखाः - </b>उद्भ०<br><br>असमञ्जस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವ್ಯಕ್ತವಾದ<br><b>प्रयोगाः - </b>"स्खलदसमञ्जमुग्धजल्पितं ते"<br><b>उल्लेखाः - </b>मालती० १०-२<br><br>

असमनयन
असमनयन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><b>व्युत्पत्तिः - </b>असमानि नयनानि यस्य<br><br>

असमनेत्र
असमनेत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><b>व्युत्पत्तिः - </b>असमानि नेत्राणि यस्य<br><br>

असमलोचन
असमलोचन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><b>व्युत्पत्तिः - </b>असमानि लोचनानि यस्य<br><br>

असमय
असमय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಕಾಲ /ಯೋಗ್ಯವಲ್ಲದ ಕಾಲ<br><b>निष्पत्तिः - </b>अप्राशस्त्ये न० त०<br><b>प्रयोगाः - </b>"असमये मतिरुन्मिषति ध्रुवं करगतैव गता यदियं कुहूः"<br><b>उल्लेखाः - </b>नैष० ४-५७<br><br>असमय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಕಾಲ<br><br>

असमर्थ
असमर्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಶಕ್ತ /ದುರ್ಬಲ<br><br>असमर्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯ /ಅನರ್ಹ<br><br>असमर्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಸ್ಪರ ಸಂಬಂಧವಿಲ್ಲದೆ ಅನ್ವಯಯೋಗ್ಯತೆಯಿಲ್ಲದ ಪದ<br><br>असमर्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಯಾ ಅರ್ಥದಲ್ಲಿ ಶಕ್ತಿಯಿಲ್ಲದ ಪದ<br><br>

असमवायिकारण
असमवायिकारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಣ ಕ್ರಿಯಾರೂಪವಾದ ಕಾರಣ<br><br>

असमस्त
असमस्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಗ್ರಹವಾಕ್ಯ /ಸಮಾಸವಿಲ್ಲದ ಪದಗಳ ಗುಂಪು<br><br>असमस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಂಪೂರ್ಣವಾದ<br><br>असमस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಕ್ಷೇಪಿಸಲ್ಪಡದ<br><br>असमस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡಿಸಲ್ಪಟ್ಟ<br><br>

असमान
असमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾನವಿಲ್ಲದ<br><br>असमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾನವಲ್ಲದ<br><br>

असमापन
असमापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾಪ್ತಿಗೊಳಿಸದಿರುವಿಕೆ<br><br>

असमापित
असमापित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾಪ್ತಿಗೊಳಿಸಲ್ಪಡದ<br><b>व्युत्पत्तिः - </b>न समापितम्<br><b>प्रयोगाः - </b>"असमापितकृत्यसम्पदां हतवेगं निवयेन तावता"<br><b>उल्लेखाः - </b>किरा० २-४८<br><br>

असमाप्त
असमाप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾಪ್ತಿಗೊಳ್ಳದ<br><b>प्रयोगाः - </b>"असमाप्तप्रतिज्ञातोऽपि याते त्वयि महाभुजे"<br><b>उल्लेखाः - </b>वेणी० ६-३३<br><br>

असमाप्ति
असमाप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಗಿಯದಿರುವಿಕೆ<br><br>

असमावृत्त
असमावृत्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿದ್ಯಾಭ್ಯಾಸವನ್ನು ಪೂರ್ಣಗೊಳಿಸಿ ಗುರುವಿನಿಂದ ಅನುಮತಿ ಪಡೆದವನು /ಗೃಹಸ್ಥಾಶ್ರಮಕ್ಕಾಗಿ ಸಮಾವರ್ತನ ಮಾಡಿದವನು<br><b>व्युत्पत्तिः - </b>न समावृत्तः<br><br>

असमाहित
असमाहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏಕಾಗ್ರತೆಯಿಲ್ಲದ<br><br>

असमीक्ष्य्कारिन्
असमीक्ष्य्कारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿವೇಚನೆ ಇಲ್ಲದೆ ಕೆಲಸ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>असमीक्ष्य कर्तुं शीलमस्य<br><br>

असम्पत्ति
असम्पत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಾರಿದ್ರ್ಯ /ಬಡತನ<br><br>असम्पत्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದರಿದ್ರ /ಬಡವ<br><b>व्युत्पत्तिः - </b>नास्ति सम्पत्तिर्यस्य<br><br>

असम्पन्न
असम्पन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದರಿದ್ರ /ಬಡವ<br><br>

असम्पूर्ण
असम्पूर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಗಿಯದಿರುವ<br><br>असम्पूर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತುಂಬಿರದ<br><b>प्रयोगाः - </b>"क्रूरग्रहः सकेतुश्चन्द्रमसम्पूर्णमण्डलमिदानीम्"<br><b>उल्लेखाः - </b>मुद्रा० १-६<br><br>

असम्पृक्त
असम्पृक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇರಿಕೊಂಡಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न सम्पृक्तः<br><br>

असम्प्रज्ञात
असम्प्रज्ञात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರ್ವಿಕಲ್ಪ ಸಮಾಧಿ<br><b>व्युत्पत्तिः - </b>न सम्यक् प्रकर्षेण ज्ञातः भेदो यत्र<br><br>

असम्प्रति
असम्प्रति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯವಾದ ಕಾಲ<br><br>असम्प्रति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೂರದ ಕಾಲ<br><br>

असम्बद्ध
असम्बद्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕೃತದ ಅರ್ಥವಿಲ್ಲದ ಮಾತು /ಸಂಬಂಧವಿಲ್ಲದ ಮಾತು<br><br>असम्बद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕೃತಕ್ಕೆ ಸಂಬಂಧಿಸಿದ ಅರ್ಥವಿಲ್ಲದ<br><br>

असम्बन्ध
असम्बन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧವಿಲ್ಲದಿರುವಿಕೆ<br><br>असम्बन्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति सम्बन्धो यस्य<br><br>

असम्बाध
असम्बाध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒತ್ತಡವಿಲ್ಲದ<br><br>असम्बाध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜನರಹಿತವಾದ<br><b>व्युत्पत्तिः - </b>नास्ति सम्बाधा पीडा प्रतिबन्धो वा यत्र<br><b>प्रयोगाः - </b>"मा गाश्चिरायैकचरः प्रमादं वसन्नसम्बाधशिवेऽपि देशे"<br><b>उल्लेखाः - </b>किरा० ३-५३<br><br>

असम्बाधा
असम्बाधा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಂದರೆಯಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न सम्यक् बाधा<br><br>

असम्भव
असम्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಗದಿರುವಿಕೆ /ಅಭಾವ<br><b>व्युत्पत्तिः - </b>न सम्भवः उत्पत्तिः<br><b>प्रयोगाः - </b>"असम्भवण् हेममृगस्य जन्म" । "हरिराक्रमणेन सन्नतिं किल बिभ्रीत भियेत्यसम्भवः"<br><b>उल्लेखाः - </b>माघ० १६-३४<br><br>असम्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿ ಕಾರಣದ ಅಭಾವ<br><br>असम्भव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿಯಿಲ್ಲದ<br><br>असम्भव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿ ಕಾರಣವಿಲ್ಲದ<br><br>असम्भव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಂಭವವೆಂಬ ಒಂದು ದೋಷ<br><br>

असम्भावना
असम्भावना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಮರ್ಯಾದೆ<br><br>असम्भावना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂದೇಹವಿಲ್ಲದಿರುವಿಕೆ<br><br>असम्भावना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಲ್ಲವೆಂಬ ಭಾವನೆ<br><br>

असम्भावनीय
असम्भावनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಹಾತೀತವಾದ<br><br>असम्भावनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಾಧ್ಯವಾದ<br><br>

असम्भूति
असम्भूति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಗದಿರುವಿಕೆ /ಅಭಾವ<br><br>असम्भूति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕೃತಿ /ಮಾಯೆ<br><b>निष्पत्तिः - </b>सम् + भू (सत्तायाम्) - "क्तिन्" (३-३-९४) । अभावे न० त० ।<br><br>

असम्भृत
असम्भृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಾಭಾವಿಕವಾದ /ಅಯತ್ನಸಿದ್ಧವಾದ<br><b>प्रयोगाः - </b>"असम्भृतं मण्डनमङ्गयष्टेरनासवाख्यं करणं मदस्य"<br><b>उल्लेखाः - </b>कुमा० १-३१<br><br>असम्भृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಪೋಷಿಸಲ್ಪಡದ<br><br>असम्भृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶೇಖರಿಸಲ್ಪಡದ<br><br>

असम्मत
असम्मत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಪ್ಪಿಗೆಯಿಲ್ಲದ<br><b>प्रयोगाः - </b>"असम्मतः कस्तव मुक्तिमार्गं पुनर्भवक्लेशभयात्प्रपन्नः"<br><b>उल्लेखाः - </b>कुमा० ३-५<br><br>असम्मत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟವಿಲ್ಲದ<br><br>

असम्मति
असम्मति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಪ್ಪದಿರುವಿಕೆ<br><br>असम्मति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಷ್ಟವಿಲ್ಲದಿರುವಿಕೆ<br><br>

असम्मूढ
असम्मूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ವಯ ಜ್ಞಾನವುಳ್ಳ<br><b>प्रयोगाः - </b>"स्थिरबुद्धिरसम्मूढः"<br><b>उल्लेखाः - </b>गीता० ५-२०<br><br>

असम्मोह
असम्मोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸ್ತವಿಕ ಜ್ಞಾನ<br><b>प्रयोगाः - </b>"बुद्धिर्ज्ञानमसम्मोहः क्षमा सत्यं दमः शमः"<br><b>उल्लेखाः - </b>गीता० १०-४<br><br>असम्मोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭ್ರಮೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>

असवर्ण
असवर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಜಾತೀಯನಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न समानो वर्णो यस्य<br><b>प्रयोगाः - </b>"अपि नाम कुलपतेरियमसवर्णक्षेत्रसम्भवा स्यात्"<br><b>उल्लेखाः - </b>शाकु० १<br><br>

असह
असह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಹಿಸದ<br><b>निष्पत्तिः - </b>षह (मर्षणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>न सहते<br><br>

असहन
असहन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರು /ವೈರಿ /ಹಗೆ<br><b>निष्पत्तिः - </b>षह (मर्षणे) - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>न सहते<br><br>असहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಹನೆ<br><b>निष्पत्तिः - </b>षह - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"सोढरिपुभरोऽसहनः स जहास दत्तकरतालमुच्चकैः"<br><b>उल्लेखाः - </b>माघ० १५-३९<br><br>असहन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಹನೆಯಿಲ್ಲದ<br><br>

असहमान
असहमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಹಿಸದ<br><b>निष्पत्तिः - </b>षह (मर्षणे) - "शानच्" (३-२-१२४)<br><b>व्युत्पत्तिः - </b>न सहते<br><b>प्रयोगाः - </b>"अम्भोजभूरसहमान इवाविरासीत्"<br><b>उल्लेखाः - </b>चं० र०<br><br>

असहाय
असहाय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಹಾಯವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति सहायो यस्य<br><br>असहाय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏಕಾಕಿ<br><b>प्रयोगाः - </b>"सोऽसहायेन मूढेन लुब्धेनाकृतबुद्धिना"<br><b>उल्लेखाः - </b>मनु० ७-३०<br><br>

असहिष्णु
असहिष्णु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಾಳ್ಮೆಯಿಲ್ಲದ<br><b>प्रयोगाः - </b>"स सुश्रुवांस्तद्वचनं मुमोह राजाऽसहिष्णुः सुतविप्रयोगम्"<br><b>उल्लेखाः - </b>भट्टि० १-२०<br><br>

असह्य
असह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಹಿಸಲಾಗದ<br><b>प्रयोगाः - </b>"असह्यकुङ्कारनिवर्तितः पुरा पुरारिमप्राप्तमुखः शिलिमुखः"<br><b>उल्लेखाः - </b>कुमा० ५-५४<br><br>

असाक्षिक
असाक्षिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಕ್ಷಿಯನ್ನು ಹೊಂದದಿರುವ<br><b>निष्पत्तिः - </b>"कप्"<br><b>व्युत्पत्तिः - </b>नास्ति साक्षी साक्षाद्द्रष्टा यस्य<br><b>प्रयोगाः - </b>"असाक्षिकेष्वर्थेषु मिथो विवदमानयोः"<br><b>उल्लेखाः - </b>मनु० ८-१०९<br><br>

असाधन
असाधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರಣವಿಲ್ಲದಿರುವಿಕೆ<br><br>असाधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಕರಣವಲ್ಲದಿರುವಿಕೆ<br><br>असाधन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಕರಣವಿಲ್ಲದ<br><br>असाधन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರಣವಿಲ್ಲದ<br><br>

असाधारण
असाधारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಾರ್ಕಿಕ ಮತದಲ್ಲಿ ಸಪಕ್ಷ ಅಥವಾ ವಿಪಕ್ಷಗಳಲ್ಲಿಲ್ಲದ ಕಾರಣ<br><br>असाधारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿರ್ದಿಷ್ಟವಾದ ಒಂದೇ ಕಾರ್ಯಕ್ಕೆ ಮೀಸಲಾದ ಕಾರಣ<br><br>असाधारण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಮಾನ್ಯವಲ್ಲದ<br><br>असाधारण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮತ್ತೊಬ್ಬರ ಅಧಿಕಾರಕ್ಕೊಳಪಡದ ಕೇವಲ ತನ್ನದೇ ಆದ ಆಸ್ತಿ<br><br>

असाधु
असाधु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳ್ಳೆಯದಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न साधु<br><b>प्रयोगाः - </b>"अतोऽर्हसि क्षन्तुमसाधु साधु वा हितं मनोहारि च दुर्लभं वचः"<br><b>उल्लेखाः - </b>किरा० १-४<br><br>असाधु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುಷ್ಟನಾದ<br><br>असाधु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಭ್ರಂಶ<br><b>प्रयोगाः - </b>"असाधूनां प्रयोगे तु प्रत्यवायोऽपि नो तथा"<br><br>

असाध्य
असाध्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಧಿಸಲಾಗದ<br><b>व्युत्पत्तिः - </b>साधयितुमशक्यः<br><br>असाध्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತೀಕಾರ ಮಾಡಲಾಗದ<br><b>प्रयोगाः - </b>"असाध्यः कुरुते कोपं प्राप्ते काले गदो यथा"<br><b>उल्लेखाः - </b>माघ० २-८४<br><br>

असामञ्जस्य
असामञ्जस्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಯುಕ್ತತೆ<br><br>असामञ्जस्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ರಮ<br><br>

असामयिक
असामयिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಕಾಲಿಕ /ಸಮಯದ್ದಲ್ಲದ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-१०४)<br><b>व्युत्पत्तिः - </b>समवायोऽस्य प्राप्तः<br><b>प्रयोगाः - </b>"किमसामयिकं वितन्वता मनसि क्षोभमुपात्तरंहसः"<br><b>उल्लेखाः - </b>किरा० २-४०<br><br>

असामान्य
असामान्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಾಧಾರಣವಾದ<br><b>व्युत्पत्तिः - </b>नास्ति सामान्यं यस्य<br><b>प्रयोगाः - </b>"रामं सीतापरित्यागादसामान्यपतिं भुवः"<br><b>उल्लेखाः - </b>रघु० १५-३९<br><br>

असाम्प्रतम्
असाम्प्रतम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಯುಕ್ತ<br><b>व्युत्पत्तिः - </b>न साम्प्रतम्<br><b>प्रयोगाः - </b>"विषवृक्षोऽपि संवर्ध्य स्वयं छेत्तुमसाम्प्रतम्"<br><b>उल्लेखाः - </b>कुमा० २-५५<br><br>

असार
असार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹರಳು ಗಿಡ<br><br>असार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಲವಿಲ್ಲದ /ಶಕ್ತಿಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति सारो बलं यस्य<br><b>प्रयोगाः - </b>"निदर्शनमसाराणां लघुर्बहुतृणं नरः"<br><b>उल्लेखाः - </b>माघ० २-५०<br><br>असार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾರವಿಲ್ಲದ<br><b>प्रयोगाः - </b>"असारं संसारं परिमुषितरत्नं त्रिभुवनम्"<br><b>उल्लेखाः - </b>मालती० ५-३०<br><br>

असि
असि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಖಡ್ಗ /ಕತ್ತಿ<br><b>निष्पत्तिः - </b>असु (क्षेपणे) - "इन्" (उ० ४-११८)<br><b>व्युत्पत्तिः - </b>अस्यते<br><b>प्रयोगाः - </b>"उद्गूर्णेन चमूस्तूर्णमतिमात्रविलाऽसिना"<br><b>उल्लेखाः - </b>माघ० १९-५०<br><br>असि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದಿನ<br><br>असि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ವಾಸ /ಉಸಿರು<br><br>असि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನೀನು<br><br>

असिक
असिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳತುಟಿಗೂ ಗಲ್ಲಕ್ಕೂ ಮಧ್ಯಭಾಗ<br><b>विस्तारः - </b>"दन्तवस्त्रं च तत्प्रान्तौ सृक्कणी असिकं त्वधः । असिकाधस्तु चिबुकम्" - अभि० चि० ।<br><br>

असिक्नी
असिक्नी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕವಯಸ್ಸಿನ ಅಂತಃಪುರದ ದಾಸಿ<br><b>निष्पत्तिः - </b>असिता - "क्नः" (वा० ४-१-३९)<br><b>व्युत्पत्तिः - </b>सिता शुक्लकेशा, तद्भिन्ना असिता ।<br><br>असिक्नी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಚಿಕ್ಕ ನದಿ<br><b>विस्तारः - </b>"असिक्नी स्यादवृद्धान्तःपुरप्रेष्यानदीभिदोः" - मेदि० ।<br><br>असिक्नी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾತ್ರಿ<br><br>

असिगण्ड
असिगण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕ ತಲೆದಿಂಬು<br><b>व्युत्पत्तिः - </b>असिः क्षिप्तो गण्डो यत्र<br><br>

असिजीविन्
असिजीविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತಿಯಿಂದ ಜೀವಿಸುವ<br><b>निष्पत्तिः - </b>जीव (प्राणधारणे) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>असिना जीवति<br><br>

असित
असित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಬಣ್ಣ<br><br>असित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣ ಪಕ್ಷ<br><br>असित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶನಿಗ್ರಹ<br><br>

असिता
असिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕವಯಸ್ಸಿನ ಅಂತಃಪುರದ ದಾಸಿ<br><br>असिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೀಲಿ ಗಿಡ<br><br>

असितग्रीव
असितग्रीव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ<br><b>व्युत्पत्तिः - </b>असितं ग्रीवायां यस्य<br><br>

असितोत्पल
असितोत्पल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀಲ ಕಮಲ<br><b>व्युत्पत्तिः - </b>असितं च तदुत्पलं च<br><b>प्रयोगाः - </b>"आननैर्मधुरसो विकसद्भिः नासिकाभिरसितोत्पलगन्धः"<br><b>उल्लेखाः - </b>माघ० १०-८<br><br>

असितोपल
असितोपल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನೀಲ ಮಣಿ<br><b>व्युत्पत्तिः - </b>असितश्चासावुपलश्च<br><br>

असिद्ध
असिद्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೫ ವಿಧ ದುಷ್ಟಹೇತುಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"अनैकान्तो विरुद्धश्चासिद्धः प्रतिपक्षितः । कालात्ययापदिष्टश्च हेत्वाभासश्च पञ्चधा ॥"<br><b>उल्लेखाः - </b>भाषाप०<br><br>असिद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಿಷ್ಪನ್ನವಾದ<br><br>असिद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಕ್ವವಾದ<br><br>

असिद्धि
असिद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಿಷ್ಪತ್ತಿ<br><br>असिद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯಾಸಿದ್ಧಿ ಮೊದಲಾದ ಹೇತುವಿನ ದೋಷ<br><br>

असिधारा
असिधारा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತಿಯ ಅಂಚು<br><b>व्युत्पत्तिः - </b>असेर्धारा<br><b>प्रयोगाः - </b>"राजसेवा मनुष्याणामसिधारावलेहनम्"<br><b>उल्लेखाः - </b>कुव०<br><br>

असिधाराव्रत
असिधाराव्रत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತಿಯ ಅಂಚಿನ ಮೇಲೆ ನಿಲ್ಲುವಷ್ಟು ಕಷ್ಟವಾದ ವ್ರತ<br><b>व्युत्पत्तिः - </b>असिधारायां स्थितिरिव दुष्करं व्रतम्<br><b>प्रयोगाः - </b>"यत्रैकशयस्थापि प्रमदा नोपभुज्यते । असिधाराव्रतमिदं वदन्ति मुनिपुङ्गवाः ॥"<br><br>असिधाराव्रत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ತಪ್ಪಿದರೂ ಹೆಚ್ಚು ಅನರ್ಥವನ್ನುಂಟುಮಾಡುವ ಕೆಲಸ<br><b>प्रयोगाः - </b>"असिधाराव्रतमिदं सखे यदरिणा सह संवासः ॥"<br><b>उल्लेखाः - </b>हितो०<br><br>

असिधावक
असिधावक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತಿಯನ್ನು ಉಜ್ಜಿ ಮೆರುಗುಕೊಡುವವನು<br><b>निष्पत्तिः - </b>धावु (गतिशुद्ध्योः) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>असि धावयति<br><br>

असिधेनुका
असिधेनुका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚೂರಿ /ಚಾಕು<br><b>व्युत्पत्तिः - </b>असिः धेनुरिव यस्याः<br><br>

असिधेनु
असिधेनु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚೂರಿ /ಚಾಕು<br><b>निष्पत्तिः - </b>वा "कप्" (५-४-१५४)<br><br>

असिपत्र
असिपत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬು<br><b>व्युत्पत्तिः - </b>असिरिव तीक्ष्णं पत्रमस्य<br><br>असिपत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎರಡುಕಡೆಗೂ ಅಲಗುಳ್ಳ ಕತ್ತಿ<br><br>असिपत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತಿಯ ಒರೆ<br><br>असिपत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನರಕ<br><b>विस्तारः - </b>"असिपत्रः खड्गकोशे पुमानिक्षौ च नारके" - मेदि० ।<br><br>

असिपत्रवन
असिपत्रवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನರಕ<br><b>प्रयोगाः - </b>"यस्त्विह वै निजवेदपथादनापद्यपगतः पाखण्डं चोपगतः तमसिपत्रवनं प्रवेश्य कशया प्रहरन्ति"<br><b>उल्लेखाः - </b>भाग० ५-२६<br><br>

असिपुच्छ
असिपुच्छ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಡಲ ಹಂದಿ<br><b>व्युत्पत्तिः - </b>असिरिव पुच्छोऽस्य<br><br>

असिपुत्रिका
असिपुत्रिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚೂರಿ /ಚಾಕು<br><br>

असिहेति
असिहेति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತಿಯೇ ಆಯುಧವಾಗಿ ಉಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>असिः हेतिः साधनमस्य<br><br>

असु|क्षेपणे|असति
असु - क्षेपणे (दि० पर० सक० से०) असति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಎಸೆ /ಬಿಸಾಡು<br><br>असु - क्षेपणे (दि० पर० सक० से०) असति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಇಡು /ಹಾಕು<br><b>प्रयोगाः - </b>"ततः प्रजघटे युद्धं शस्त्राण्यासुः परस्परम्"<br><b>उल्लेखाः - </b>भट्टि० १४-७७<br><br>

अति + असु|अत्यसु|अत्यस्तः
अति + असु = अत्यस्तः<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಬಹಳ ದೂರಕ್ಕೆ ಎಸೆ<br><b>प्रयोगाः - </b>"बहुभिश्चैकमत्यस्यन् एकेन च बहून् जनान्"<br><b>उल्लेखाः - </b>भा०<br><br>

वि + अति + असु|व्यत्यसु|व्यत्यस्तः
वि + अति + असु = व्यत्यस्तः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಬದಲಾವಣೆ ಮಾಡು /ಪ್ರತಿಯಾಗಿ ಇಡು<br><b>प्रयोगाः - </b>"व्यत्यस्तपाणिना कार्यमुपसङ्ग्रहणं गुरोः"<br><b>उल्लेखाः - </b>मनु० २-७२<br><br>

अधि + असु|अध्यसु|अध्यासः
अधि + असु = अध्यासः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಆರೋಪಿಸು<br><b>प्रयोगाः - </b>"सर्वो हि पुरोऽवस्थिते विषये विषयान्तरमध्यस्यति, बाह्यधर्मानात्मन्यध्यस्यति"<br><br>

अनु + असु|अन्वसु|अन्वस्तः
अनु + असु = अन्वस्तः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಜೊತೆಯಲ್ಲಿಡು<br><br>अनु + असु = अन्वस्तः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಅನಂತರ ಇಡು<br><br>

अप + असु|अपासु|अपास्तः
अप + असु = अपास्तः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ನಿವಾರಿಸು /ದೂರ ಮಾಡು<br><b>प्रयोगाः - </b>किमित्यपास्याभरणानि यौवने धृतं त्वया वार्धकशोभि वल्कलम्"<br><b>उल्लेखाः - </b>कुमा० ५-४४<br><br>

अभि + असु|अभ्यसु|अभ्यस्तः
अभि + असु = अभ्यस्तः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಅಭ್ಯಾಸ ಮಾಡು /ಕಲಿ<br><br>अभि + असु = अभ्यस्तः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಆವೃತ್ತಿ ಮಾಡು<br><b>प्रयोगाः - </b>"शैशवेऽभ्यस्तविद्यानां यौवने विषयैषिणाम्"<br><b>उल्लेखाः - </b>रघु० १-७<br><br>

उद् + असु|उदसु|उदस्य
उद् + असु = उदस्य ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಸೆ /ಮೇಲಕ್ಕೆ ಹಾರಿಸು<br><b>प्रयोगाः - </b>"दयिताय सासवमुदस्तमपतदवसादिनः करात्"<br><b>उल्लेखाः - </b>माघ० १५-८१<br><br>उद् + असु = उदस्य ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ತಳ್ಳು<br><b>प्रयोगाः - </b>"उदस्ताधोरणः"<br><b>उल्लेखाः - </b>दशकु०<br><br>उद् + असु = उदस्य ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ತಳ್ಳಿ ಹಾಕು /ನಿವಾರಿಸು<br><b>प्रयोगाः - </b>"रिपुतिमिरमुदस्योदीयमानं दिनादौ"<br><b>उल्लेखाः - </b>किरा० १-४६<br><br>

परि + उद् + असु|पर्युदसु|पर्युदासः
परि + उद् + असु = पर्युदासः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ವಿಧಿಗೆ ಪ್ರಾಧಾನ್ಯ ಕೊಟ್ಟು ನಿಷೇಧಕ್ಕೆ ಅಪ್ರಾಧಾನ್ಯ ಕೊಡು<br><b>प्रयोगाः - </b>"प्राधान्यं हि विधेर्यत्र प्रतिषेधेऽप्रधानता । पर्युदासः स विज्ञेयः यत्रोत्तरपदेन नञ् ॥"<br><br>

वि + उद् + असु|व्युदसु|व्युदासः
वि + उद् + असु = व्युदासः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ನಿವಾರಿಸು /ತ್ಯಜಿಸು<br><b>प्रयोगाः - </b>"त्वन्तु हेतूनतीत्यैतान् कामक्रोधौ व्युदस्य च"<br><b>उल्लेखाः - </b>भा०<br><br>

उप + असु|उपासु|उपास्तः
उप + असु = उपास्तः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿಡು<br><br>

नि + असु|न्यसु|न्यासः
नि + असु = न्यासः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಇಡು /ಅರ್ಪಿಸು<br><b>प्रयोगाः - </b>"न्यासं शुभं निश्चितयोगलक्ष्म्याः"<br><b>उल्लेखाः - </b>याद० १८-५६<br><br>

उप + नि + असु|उपन्यसु|उपन्यासः
उप + नि + असु = उपन्यासः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಹೇಳು /ಉದಾಹರಿಸಿ ವಿವರಿಸು<br><b>प्रयोगाः - </b>"प्रभवति निजस्य कन्यकाजनस्य देव इत्युभयलोकविरुद्धमुत्तरौपन्यस्तम्"<br><b>उल्लेखाः - </b>मालती० २<br><br>

सम् + नि + असु|सन्न्यसु|सन्न्यासः
सम् + नि + असु = सन्न्यासः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ತ್ಯಜಿಸು /ವರ್ಜಿಸು<br><b>प्रयोगाः - </b>"काम्यानां कर्मणां न्यासं सन्न्यासं कवयो विदुः ।"<br><b>उल्लेखाः - </b>गीता० १८-२<br><br>सम् + नि + असु = सन्न्यासः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಇಡು /ಅರ್ಪಿಸು<br><b>प्रयोगाः - </b>"मयि सर्वाणि कर्माणि सन्न्यस्याध्यात्मचेतसा"<br><b>उल्लेखाः - </b>गीता० ३-३०<br><br>

निर् + असु|निरसु|निरस्तः
निर् + असु = निरस्तः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ತ್ವರೆಯಿಂದ ಹೇಳು /ಜಾಗ್ರತೆಯಾಗಿ ಹೇಳು<br><b>विस्तारः - </b>"निरस्तं त्वरितोदितम्" - अम० ।<br><br>निर् + असु = निरस्तः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಹೋಗಲಾಡಿಸು /ನಿವಾರಿಸು<br><b>प्रयोगाः - </b>"निरस्तगाम्भीर्यमपास्तपुष्पकं प्रकम्पयामास न मानसं न सः"<br><b>उल्लेखाः - </b>माघ० १-५५<br><br>

पर + असु|परासु|परास्तम्
पर + असु = परास्तम् ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸು /ನಿರಾಕರಿಸು<br><br>

परि + असु|पर्यसु|पर्यस्तः
परि + असु = पर्यस्तः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಹರಡು /ವ್ಯಾಪಿಸು<br><b>प्रयोगाः - </b>"ततोऽनुकुर्यात् विशदस्य तस्य अस्ताम्रौष्ठपर्यस्तरुचः स्मितस्य"<br><b>उल्लेखाः - </b>कुमा० १-४४<br><br>परि + असु = पर्यस्तः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ತಿರುಗು /ಸುತ್ತು<br><b>प्रयोगाः - </b>"साचीकृता चारुतरेण तस्थौ मुखेन पर्यस्तविलोचनेन"<br><b>उल्लेखाः - </b>कुमा० ३-६८<br><br>परि + असु = पर्यस्तः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಬೀಳು /ಉರುಳು<br><b>प्रयोगाः - </b>"भग्नाक्षपर्यस्तरथं क्षणेन"<br><b>उल्लेखाः - </b>रघु० ५-४९<br><br>

वि + परि + असु|विपर्यसु|विपर्यासः
वि + परि + असु = विपर्यासः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ವ್ಯತ್ಯಾಸ ಹೊಂದು /ಬದಲಾವಣೆ ಹೊಂದು<br><b>प्रयोगाः - </b>"विपर्यासं यातो धनविरलभावः क्षितिरुहाम्"<br><b>उल्लेखाः - </b>उ० रा० २-२६<br><br>वि + परि + असु = विपर्यासः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಭ್ರಾಂತಿ ಹೊಂದು /ತಪ್ಪು ಇಳಿ<br><br>

प्र + असु|प्रासु|प्रास्तम्
प्र + असु = प्रास्तम् ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಇಡು /ಹಾಕು<br><b>प्रयोगाः - </b>"अग्नौ प्रास्ताहुतिः सम्यगादित्यमुपतिष्ठते"<br><b>उल्लेखाः - </b>मनु० ३-७६<br><br>

अनु + प्र + असु|अनुप्रासु|अनुप्रासः
अनु + प्र + असु = अनुप्रासः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಕ್ರಮದಲ್ಲಿಡು /ಅನುಗುಣವಾಗಿಡು<br><b>प्रयोगाः - </b>"अनुप्रासः शब्दसाम्यं वैषम्येऽपि स्वरस्य यत्"<br><b>उल्लेखाः - </b>सा० द०<br><br>

वि + असु|व्यसु|व्यासः
वि + असु = व्यासः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ವಿಸ್ತಾರವಾಗಿಡು /ಬಿಡಿಸಿ ಇಡು<br><br>वि + असु = व्यासः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಬೇರೆ ಮಾಡು /ವಿಭಾಗಿಸು<br><b>प्रयोगाः - </b>"स चतुर्धा बभौ व्यस्तः प्रसवः पृथिवीपतेः"<br><b>उल्लेखाः - </b>रघु० १०-८४<br><br>

वि + नि + असु|विन्यसु|विन्यासः
वि + नि + असु = विन्यासः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಇಡು /ಇರಿಸು<br><b>प्रयोगाः - </b>"विन्यस्तमङ्गलमहौषधिरीश्वरायाः"<br><b>उल्लेखाः - </b>किरा० ५-३३<br><br>

सम् + असु|समसु|समासः
सम् + असु = समासः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಸಂಗ್ರಹಿಸು /ಸಂಕ್ಷೇಪಿಸು<br><b>प्रयोगाः - </b>"सिद्धिं प्राप्तो यथा ब्रह्म तथाप्नोति निबोध मे । समासेनैव कौन्तेय निष्ठा ज्ञानस्य या परा ॥"<br><b>उल्लेखाः - </b>गीता० १८-५०<br><br>

असु
असु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಸಿರು /ಶ್ವಾಸ<br><b>निष्पत्तिः - </b>असु (क्षेपणे) - "उन्" (उ० १-१०)<br><b>व्युत्पत्तिः - </b>अस्यते<br><br>असु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು /ಜಲ<br><br>असु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಸಿ /ಶಾಖ<br><br>असु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ತ /ಮನಸ್ಸು<br><br>असु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಂಚಪ್ರಾಣವಾಯುಗಳು<br><b>प्रयोगाः - </b>"अभिमानधनस्य गत्वरैरसुभिः स्थास्नु यशश्चिचीषतः"<br><b>उल्लेखाः - </b>किरा० २-१९<br><br>

असुकर
असुकर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಖವಾಗಿ ಮಾಡಲು ಆಗದ<br><b>निष्पत्तिः - </b>सु + डुक्र्ञ् (करणे) - "खल्" (३-३-१२६)<br><b>व्युत्पत्तिः - </b>सुखेन क्रियते<br><br>

असुख
असुख<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಖದ ಅಭಾವ /ದುಃಖ<br><b>प्रयोगाः - </b>"तौ धर्मं पश्यतस्तस्य पापं चातन्द्रितौ सह । याभ्यां प्राप्नोति सम्पृक्तः प्रेत्येह च सुखासुखम् ॥"<br><b>उल्लेखाः - </b>मनु० १२-१९<br><br>असुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಖವಿಲ್ಲದ<br><br>असुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಷ್ಟವಾದ<br><b>प्रयोगाः - </b>"श्रेयांसि लब्धमसुखानि विनान्तरायैः"<br><b>उल्लेखाः - </b>किरा० ५-४९<br><br>

असुखोदय
असुखोदय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸುಖಕ್ಕೆ ಕಾರಣವಾದ /ದುಃಖವನ್ನುಂಟುಮಾಡುವ<br><b>प्रयोगाः - </b>"न कर्म निष्फलं कुर्यान्नायत्यामसुखोदयम्"<br><b>उल्लेखाः - </b>मनु० ४-७०<br><br>

असुखोदर्क
असुखोदर्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುಃಖವೇ ಫಲವಾಗಿ ಉಳ್ಳ /ದುಃಖವನ್ನುಂಟುಮಾಡುವ<br><b>प्रयोगाः - </b>"तद्भवत्यसुखोदर्कं जीवितश्च मृतस्य च"<br><b>उल्लेखाः - </b>मनु० ११-१०<br><br>

असुधारण
असुधारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಣಧಾರಣೆ /ಬದುಕಿರುವುದು<br><b>व्युत्पत्तिः - </b>असूनां प्राणवायूनां धारणम्<br><br>

असुमत्
असुमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾಣಿ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>असवः सन्त्यस्य<br><b>प्रयोगाः - </b>"सततमसुमतामगम्यरूपाः परिणतदिक्करिकास्तटीर्बिभर्ति"<br><b>उल्लेखाः - </b>माघ० ४-२९<br><br>

असुर
असुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಕ್ಷಸ<br><b>निष्पत्तिः - </b>असु (क्षेपणे) - "उरन्" (उ० १-४२)<br><b>व्युत्पत्तिः - </b>अस्यन्ति क्षिपन्ति देवान्<br><b>प्रयोगाः - </b>"सुराप्रतिग्रहाद्देवाः सुरा इत्यभिविश्रुताः । अप्रतिग्रहणात्तस्या दैतेयाश्चासुरास्तथा ॥"<br><b>उल्लेखाः - </b>रामा०<br><br>असुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>विस्तारः - </b>"असुरः सूर्यदैत्ययोः । असुरा रजनीवाश्योः" - हेम० ।<br><br>असुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಜ /ಆನೆ<br><b>विस्तारः - </b>"दन्तावलो महाकायो वारणः कुञ्जरोऽसुरः" - वैज० ।<br><br>

असुरा
असुरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾತ್ರಿ<br><br>असुरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಚಿ /ಬಡಗಿಯ ಒಂದು ಆಯುಧ<br><br>

असुरी
असुरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಕ್ಷಸ ಹೆಂಗಸು<br><br>असुरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿ ಸಾಸುವೆ<br><b>विस्तारः - </b>"असुरी कृष्णिकाचासौ" - अभि० चि० ।<br><br>

असुरक्ष
असुरक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಖವಾಗಿ ಕಾಪಾಡಲು ಆಗದ<br><b>निष्पत्तिः - </b>सु + रक्ष (पालने) - "खल्" (३-३-१२६)<br><b>व्युत्पत्तिः - </b>सुखेन रक्ष्यते<br><b>प्रयोगाः - </b>"शरदभ्रचलाश्चलेन्द्रियैरसुरक्षा हि बहुच्छलाः श्रियः"<br><b>उल्लेखाः - </b>किरा० २-३९<br><br>असुरक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾಣವನ್ನು ಕಾಪಾಡುವ<br><b>निष्पत्तिः - </b>रक्ष - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>असून् रक्षति<br><br>

असुरराज्
असुरराज्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಸುರರ ದೊರೆ<br><b>व्युत्पत्तिः - </b>असुराणां राट्<br><br>असुरराज्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲಿಚಕ್ರವರ್ತಿ<br><br>

असुरराज
असुरराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಸುರರ ದೊರೆ<br><b>व्युत्पत्तिः - </b>असुराणां राजा<br><br>असुरराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲಿಚಕ್ರವರ್ತಿ<br><br>

असुररिपु
असुररिपु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ವಾಸುದೇವ<br><br>

असुरगुरु
असुरगुरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶುಕ್ರಾಚಾರ್ಯರು<br><br>

असुराधिप
असुराधिप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಕ್ಷಸರ ದೊರೆ /ಅಸುರರ ಒಡೆಯ<br><br>असुराधिप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲಿಚಕ್ರವರ್ತಿ<br><b>व्युत्पत्तिः - </b>असुराणामधिपः<br><br>

असुसू
असुसू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣ<br><b>निष्पत्तिः - </b>षू (प्रेरणे) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>असून् प्राणान् सुवति<br><b>प्रयोगाः - </b>"स सासिः सासुसूः सासो येया येया ययाययः"<br><b>उल्लेखाः - </b>किरा० १५-१<br><br>

असू
असू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಸವಿಸದ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>षूङ् (प्राणिप्रसवे) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>न सूते<br><br>

असूर्क्षण
असूर्क्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಾದರ /ತಿರಸ್ಕಾರ<br><b>निष्पत्तिः - </b>सूर्क्ष (आदरे) - "ल्युट्" (३-३-११५) । अभावे न० त० ।<br><br>

असूयक
असूयक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸೂಯೆಯುಳ್ಳ /ಗುಣದಲ್ಲಿ ದೋಷವನ್ನು ಎಣಿಸುವ<br><b>निष्पत्तिः - </b>असूञ् (उपतापे) + यक् - "ण्वुल्" (३-१-१३३)<br><b>प्रयोगाः - </b>"अहङ्कारं बलं दर्पं कामं क्रोधं च संश्रिताः । मामात्मपरदेहेषु प्रद्विषन्तोऽभ्यसूयकाः ॥"<br><b>उल्लेखाः - </b>गीता० १६-१८<br><br>

असूया
असूया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇತರರ ಗುಣದಲ್ಲಿ ದೋಷವನ್ನು ಹೇಳುವುದು<br><b>निष्पत्तिः - </b>असु (उपतापे) + कण्ड्वादि यक् - "अः" (३-३-१०६)<br><b>प्रयोगाः - </b>"असूययेव तन्नागाः सप्तधैव प्रसुस्रुवुः"<br><b>उल्लेखाः - </b>रघु० ४-२३<br><b>विस्तारः - </b>"असूया परगुणेषु दोषाविष्करणम्" - सि० कौ० ।<br><br>असूया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರೋಷ /ಕೋಪ<br><b>प्रयोगाः - </b>"आर्ये, व्रजामोऽन्यत इत्यथैनां वधूरसूयाकुटिलं ददर्श"<br><b>उल्लेखाः - </b>रघु० ६-८२<br><br>

असूर्यम्पश्य
असूर्यम्पश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನನ್ನು ನೋಡದಿರುವ<br><br>

असूर्यम्पश्या
असूर्यम्पश्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನನ್ನೂ ಕಾಣದಿರುವ ರಾಜಪತ್ನಿ /ಘೋಷಾಪದ್ಧತಿಯಲ್ಲಿರುವ ರಾಜಸ್ತ್ರೀಯರು<br><b>निष्पत्तिः - </b>दृशिर् (प्रेक्षणे) - "खश्" (३-२-३६) । मुम् (६-३-६७)<br><b>व्युत्पत्तिः - </b>न सूर्यं पश्यति<br><b>प्रयोगाः - </b>"असूर्यम्पश्यरूपा त्वं किमभीरुररार्यसे"<br><b>उल्लेखाः - </b>भट्टि० ४-२१<br><b>विस्तारः - </b>"असूर्यम्पश्याः राजदाराः" - सि० कौ० ।<br><br>

असृक्कर
असृक्कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹದಲ್ಲಿರುವ ರಸಧಾತು /ರಕ್ತಸಾರ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "टः" (३-२-२०)<br><b>व्युत्पत्तिः - </b>असृजं रक्तं करोति<br><b>प्रयोगाः - </b>"रसाद्रक्तं ततो मांसं मांसान् मेदः प्रजायते । मेदसोऽस्थि ततो मज्जाः मज्ज्ञः शुक्रं तु जायते ॥"<br><b>उल्लेखाः - </b>सुश्रुत० सूत्रस्था० १४-१०<br><br>

असृग्धरा
असृग्धरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ತವನ್ನು ಧರಿಸುವ ಚರ್ಮ<br><b>व्युत्पत्तिः - </b>असृजो रक्तस्य धरा<br><br>

असृग्धारा
असृग्धारा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ತದ ಪ್ರವಾಹ<br><b>व्युत्पत्तिः - </b>असृजो धारा<br><br>

असृग्वहा
असृग्वहा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ತ ಸಂಚರಿಸುವ ನಾಡಿ<br><b>निष्पत्तिः - </b>वह (प्रापणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>असृजो वहा<br><br>

असृग्विमोक्षण
असृग्विमोक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹದಿಂದ ರಕ್ತವನ್ನು ತೆಗೆಯುವುದು<br><b>व्युत्पत्तिः - </b>असृजः रक्तस्य देहाद्विमोक्षणम्<br><br>

असृज्
असृज्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶೋಣಿತ /ರಕ್ತ<br><b>निष्पत्तिः - </b>सृज (विसर्गे) - "क्विन्" (३-२-५९)<br><b>व्युत्पत्तिः - </b>न सृज्यते इतररागवत् संसृज्यते<br><b>प्रयोगाः - </b>"असृग्जनोऽस्त्रक्षतिमानवमज्जवसादनम्"<br><b>उल्लेखाः - </b>माघ० १९-७८<br><br>असृज्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಕುಮಕೇಸರಿ<br><br>असृज्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಜ /ಮಂಗಳಗ್ರಹ<br><br>

असृपाटी
असृपाटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ತಧಾರೆ<br><b>निष्पत्तिः - </b>पृषो०<br><b>व्युत्पत्तिः - </b>असृजः पाटी परिपाटी<br><br>

असेचनक
असेचनक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಮಣೀಯ ವಸ್ತು /ಬಹಳ ಪ್ರಿಯವಾದ ವಸ್ತು<br><b>निष्पत्तिः - </b>षिच (क्षरणे) - "ल्युट्" (३-३-११७) । "कन्" (५-३-७५)<br><b>व्युत्पत्तिः - </b>न सिच्यते मनोऽत्र<br><br>

असेवन
असेवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವೆ ಮಾಡದಿರುವಿಕೆ<br><br>असेवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದಾಸೀನತೆ<br><br>असेवन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವೆಯಿಲ್ಲದ<br><br>

असेवित
असेवित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಿಸಲ್ಪಡದ<br><br>असेवित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ<br><br>

असौम्य
असौम्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯಂಕರವಾದ /ಕುರೂಪದ<br><b>व्युत्पत्तिः - </b>न सौम्यः<br><br>

असौम्यस्वर
असौम्यस्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಯಂಕರವಾದ ಸ್ವರ<br><br>असौम्यस्वर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯಂಕರ ಶಬ್ದವುಳ್ಳ /ಕ್ರೂರವಾದ ಧ್ವನಿಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>असौम्यः स्वरो यस्य<br><br>

असौष्ठव
असौष्ठव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಣಹೀನತೆ /ಯೋಗ್ಯವಾಗಿಲ್ಲದಿರುವಿಕೆ<br><br>असौष्ठव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುರೂಪ /ವಿಕಾರ ರೂಪ<br><br>असौष्ठव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಲಹೀನವಾದ /ತೇಜೋಹೀನವಾದ<br><b>प्रयोगाः - </b>"गमनमलसं शून्या दृष्टिः शरीरमसौष्ठवं श्वसितमधिकं किन्वेतत्स्यात् किमन्यदतोऽथवा"<br><b>उल्लेखाः - </b>मालती० १-२०<br><br>

अस्खलित
अस्खलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಪ್ಪದಿರುವ<br><br>अस्खलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಥಿರವಾದ /ನಿಶ್ಚಲವಾದ<br><br>अस्खलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಗ್ಗರಿಸದಿರುವ /ಜಾರವದಿರುವ<br><br>

अस्त
अस्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಸ್ತಪರ್ವತ /ಸೂರ್ಯನು ಮುಳುಗುವ ಬೆಟ್ಟ<br><b>निष्पत्तिः - </b>असु (क्षेपणे) - अधि० "क्तः" (४-३-७६)<br><b>व्युत्पत्तिः - </b>अस्यन्ते रविकिरणा अत्र<br><b>प्रयोगाः - </b>"यात्येकतोऽस्तशिखरं पतिरोषधीनाम्"<br><b>उल्लेखाः - </b>शाकु० ४-१<br><br>अस्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ ಮೊದಲಾದ ಗ್ರಹಗಳ ಅಸ್ತಮಯ<br><b>प्रयोगाः - </b>"गतोऽस्तमर्कः"<br><br>अस्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾಪ್ತಿ /ಕೊನೆ<br><br>अस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಸೆಯಲ್ಪಟ್ಟ /ಬಿಸಾಡಲ್ಪಟ್ಟ<br><br>अस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಗಿಸಲ್ಪಟ್ಟ /ಸಮಾಪ್ತಿಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>अस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೂಡಿ ಬಿಡಲ್ಪಟ್ಟ /ಪ್ರಯೋಗಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"पश्यन्तोऽधोलोकमस्तेषुजालाः"<br><b>उल्लेखाः - </b>माघ० १८-२४<br><br>अस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲಗ್ನದಿಂದ ೭ನೆಯ ಸ್ಥಾನ<br><br>

अस्तक
अस्तक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪವರ್ಗ /ಮೋಕ್ಷ<br><b>निष्पत्तिः - </b>अस्त + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>अस्तमवसानं करोति<br><br>

अस्तम्
अस्तम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕಾಣಿಸದಿರುವಿಕೆ /ಗೋಚರವಾಗದಿರುವಿಕೆ<br><br>अस्तम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಾಶ<br><b>प्रयोगाः - </b>"विप्रोषितकुमारं तद्राज्यमस्तमितेश्वरम्"<br><b>उल्लेखाः - </b>रघु० १२-११<br><br>

अस्तमन
अस्तमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣಿಗೆ ಕಾಣಿಸದಂತೆ ಸಂಚರಿಸುವುದು<br><br>अस्तमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶ ಹೊಂದುವುದು<br><br>अस्तमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯಾದಿ ಗ್ರಹಗಳ ಮುಳುಗುವಿಕೆ<br><br>

अस्तमय
अस्तमय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯಾದಿ ಗ್ರಹಗಳ ಮುಳುಗುವಿಕೆ<br><b>निष्पत्तिः - </b>अस्तम् + इण् (गतौ) - "अच्" (३-३-५६)<br><b>प्रयोगाः - </b>"स एष कैलास उपान्तसर्पिणः करोत्यकालास्तमयं विवस्वतः"<br><b>उल्लेखाः - </b>किरा० ५-३५<br><br>अस्तमय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಳಯ /ನಾಶ<br><b>प्रयोगाः - </b>"भाग्यास्तमयमिवाक्ष्णोः हृदयस्य महोत्सवावसानमिव"<br><b>उल्लेखाः - </b>माल० २-११<br><br>अस्तमय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರೆ ಮಾಡುವುದು /ಕಾಣಿಸದಂತೆ ಅಡಗಿಸುವುದು<br><b>प्रयोगाः - </b>"कुवन्ति सामन्तशिखामणीनां प्रभाप्ररोहास्तमयं रजांसि"<br><b>उल्लेखाः - </b>रघु० ६-३३<br><br>

अस्ताचल
अस्ताचल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಶ್ಚಿಮಾದ್ರಿ /ಅಸ್ತಪರ್ವತ<br><br>

अस्ताद्रि
अस्ताद्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಶ್ಚಿಮಾದ್ರಿ /ಅಸ್ತಪರ್ವತ<br><br>

अस्ति
अस्ति<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಇರುವಿಕೆ /ಸ್ಥಿತಿ<br><br>

अस्तिकाय
अस्तिकाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲತ್ರಯ ಸಂಬಂಧವುಳ್ಳ ಮತ್ತು ಬಹುಪ್ರದೇಶ ವ್ಯಾಪ್ತಿಯುಳ್ಳ ವಸ್ತು<br><b>व्युत्पत्तिः - </b>अस्ति कायः स्वरूपं यस्य<br><br>

अस्तिक्षीरा
अस्तिक्षीरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಹಾಲುಳ್ಳ ಹಸು<br><b>व्युत्पत्तिः - </b>अस्ति क्षीरं यस्याः सा<br><br>

अस्तित्व
अस्तित्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇರುವಿಕೆ /ಸ್ಥಿತಿ<br><b>विस्तारः - </b>तिङन्तप्रतिरूपकमव्ययम् ।<br><br>

अस्तिमत्
अस्तिमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧನಿಕ /ಐಶ್ವರ್ಯವಂತ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>अस्ति विद्यमानं धनं यस्य<br><br>

अस्तिमती
अस्तिमती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಐಶ್ವರ್ಯವಂತೆ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

अस्तु
अस्तु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನುಜ್ಞೆ /ಅಪ್ಪಣೆ<br><br>अस्तु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಸೂಯೆ<br><br>अस्तु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಭಾಧೆ /ಪೀಡೆ<br><br>अस्तु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉತ್ಕರ್ಷ<br><br>अस्तु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ<br><br>अस्तु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸ್ತುತಿ /ಪ್ರಶಂಸೆ<br><br>अस्तु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಲಕ್ಷಣ /ಸೂಚನೆ<br><br>अस्तु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಸೂಯೆಯಿಂದ ಅಂಗೀಕರಿಸುವುದು<br><br>अस्तु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಕ್ಷೇಪಣೆ /ನಿಂದೆ<br><b>विस्तारः - </b>"अस्तु स्यादभ्यनुज्ञानेऽप्यसूयापीडयोरपि । प्रतिक्षेपे प्रशंसायां प्रकर्षे लक्षणेऽपि च" - मेदि० ।<br><br>

अस्तुङ्कार
अस्तुङ्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಪ್ಪಿಗೆ /ಸಮ್ಮತಿ<br><b>निष्पत्तिः - </b>अस्तु + कारः - "मुम्" (वा० ६-३-७०)<br><br>

अस्तेय
अस्तेय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕದಿಯದಿರುವಿಕೆ /ಪರಸ್ವತ್ತನ್ನು ಅಪಹರಿಸದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न स्तेयम्<br><b>प्रयोगाः - </b>"लोभस्य पुरतः केऽमी सत्यास्तेयापरिग्रहाः"<br><b>उल्लेखाः - </b>प्रबोध० १-१५<br><br>

अस्तोभ
अस्तोभ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರರ್ಥಕವಲ್ಲದ ಶಬ್ದವುಳ್ಳ /ಸಾರ್ಥಕವಾದ ಶಬ್ದವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>नास्ति स्तोभः निरर्थकशब्दः यत्र<br><b>प्रयोगाः - </b>"अल्पाक्षरमसन्दिग्धं सारवद्विश्वतोमुखम् । अस्तोभवमनवद्यं च सूत्रं सूत्रविदो विदुः ॥"<br><br>

अस्त्यान
अस्त्यान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ಬೈಗಳು<br><br>अस्त्यान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಟ್ಟುಗೀಡಿಸದಿರುವ<br><br>

अस्त्र
अस्त्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣ<br><b>निष्पत्तिः - </b>असु (क्षेपणे) - "ष्ट्रन्" (उ० ४-१५८)<br><b>व्युत्पत्तिः - </b>अस्यते<br><b>प्रयोगाः - </b>"अस्त्रज्वालावलीढप्रतिबलजलधेरन्तरौर्वायमाणे"<br><b>उल्लेखाः - </b>वेणी० ३-७<br><br>अस्त्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧನುಸ್ಸು<br><b>निष्पत्तिः - </b>कर० "ष्ट्रन्"<br><b>व्युत्पत्तिः - </b>अस्यतेऽनेन<br><b>प्रयोगाः - </b>"अस्त्रवेदमधिगम्य तत्त्वतः कस्य चेह भुजवीर्यशालिनः"<br><b>उल्लेखाः - </b>किरा० १३-६२<br><br>अस्त्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಯುಧ<br><br>अस्त्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂತ್ರಶಕ್ತಿಯಿಂದ ಪ್ರಯೋಗಿಸಲ್ಪಡುವ ಆಯುಧ<br><br>

अस्त्रजीविन्
अस्त्रजीविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಯುಧದಿಂದ ಜೀವಿಸುವ /ಆಯುಧವ್ಯಾಪಾರದಿಂದ ಜೀವನ ಮಾಡುವ<br><b>निष्पत्तिः - </b>अस्त्र + जीव (प्राणधारणे) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अस्त्रेण अस्त्रव्यापारेण जीवति<br><br>

अस्त्रधारिन्
अस्त्रधारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಯುಧವನ್ನು ಧರಿಸಿರುವ ಯೋಧ<br><b>निष्पत्तिः - </b>अस्त्र + धृञ् (धारणे) + णिच् - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>अस्त्रं धारयति<br><br>

अस्त्रमन्त्र
अस्त्रमन्त्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣವನ್ನು ಪ್ರಯೋಗಿಸುವಾಗ ಮತ್ತು ಉಪಸಂಹರಿಸುವಾಗ ಉಚ್ಚರಿಸುವ ಮಂತ್ರ<br><b>व्युत्पत्तिः - </b>अस्त्राणां प्रयोगोपसंहारयोर्मन्त्रः<br><b>प्रयोगाः - </b>"उदङ्मुखः सोऽस्त्रविदस्त्रमन्त्रं जग्राह तस्मान्निगृहीतशापात्"<br><b>उल्लेखाः - </b>रघु० ५-५९<br><br>

अस्त्रमार्ज
अस्त्रमार्ज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸ್ತ್ರಗಳಿಗೆ ಮೆರುಗು ಕೊಡುವವನು /ಅಸ್ತ್ರಗಳನ್ನು ಉಜ್ಜಿ ಹೊಳಪು ಕೊಡತಕ್ಕವನು<br><b>निष्पत्तिः - </b>मृजूष् (शुद्धौ) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>अस्त्रं मार्ष्टि<br><br>

अस्त्रमार्जक
अस्त्रमार्जक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸ್ತ್ರಗಳಿಗೆ ಮೆರುಗು ಕೊಡುವವನು /ಅಸ್ತ್ರಗಳನ್ನು ಉಜ್ಜಿ ಹೊಳಪು ಕೊಡತಕ್ಕವನು<br><b>निष्पत्तिः - </b>"ण्वुल्" (३-१-१३३)<br><br>

अस्त्रविद्
अस्त्रविद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾಣಪ್ರಯೋಗ ಮತ್ತು ಉಪಸಂಹಾರಗಳನ್ನು ಅರಿತಿರುವ<br><b>निष्पत्तिः - </b>अस्त्र + विद (ज्ञाने) - "क्विप्" (३-२-७६)<br><b>प्रयोगाः - </b>"उदङ्मुखः सोऽस्त्रविदस्त्रमन्त्रं जग्राह तस्मान्निगृहीतशापात्"<br><b>उल्लेखाः - </b>रघु० ५-५९<br><br>

अस्त्रविद्या
अस्त्रविद्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣಗಳ ಪ್ರಯೋಗ ಮತ್ತು ಉಪಸಂಹಾರಗಳನ್ನು ತಿಳಿಸುವ ವಿದ್ಯೆ<br><br>अस्त्रविद्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಧನುರ್ವೇದ<br><br>

अस्त्रवेद
अस्त्रवेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧನುರ್ವೇದ<br><b>प्रयोगाः - </b>"अस्त्रवेदमधिगम्य तत्त्वतः कस्य चेह भुजवीर्यशालिनः"<br><b>उल्लेखाः - </b>किरा० १३-६२<br><br>

अस्त्रागार
अस्त्रागार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಯುಧ ಶಾಲೆ /ಆಯುಧಗಳನ್ನು ಇಡುವ ಮನೆ<br><br>

अस्त्रिन्
अस्त्रिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಲ್ಲುಗಾರ /ಹನುಸ್ಸನ್ನು ಹಿಡಿದವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>अस्त्रं धनुरस्यास्ति<br><br>अस्त्रिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಲ್ಲು ಹಿಡಿದು ಯುದ್ಧ ಮಾಡುವವನು<br><br>

अस्थान
अस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯವಾದ ಸ್ಥಾನ /ಕೆಟ್ಟ ಜಾಗ<br><b>व्युत्पत्तिः - </b>अप्रशस्तं स्थानम्<br><b>प्रयोगाः - </b>"अस्थाने पततामतीव महतामेतादृशी स्याद्गतिः"<br><br>अस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸರಿಯಲ್ಲದ ಸ್ಥಳ<br><b>प्रयोगाः - </b>"अस्थानं परिभवस्य"<br><br>

अस्थाने
अस्थाने<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕಾರಣವಲ್ಲದೆ<br><b>प्रयोगाः - </b>"एवमेतत्, अस्थाने कोप इत्यनुपपन्नं त्वयि"<br><b>उल्लेखाः - </b>माल० ४<br><br>अस्थाने<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯವಾದ ಕಾಲ<br><b>प्रयोगाः - </b>"अस्थाने महानर्थोत्सर्गः क्रियते"<br><b>उल्लेखाः - </b>मुद्रा० ३<br><br>

अस्थायिन्
अस्थायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಂಚಲವಾದ /ಸ್ಥಿರವಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न स्थायी<br><br>

अस्थावर
अस्थावर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಲಿಸುವ /ಸ್ಥಿರವಾಗಿಲ್ಲದ<br><br>अस्थावर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಲಿಸುವ ಆಸ್ತಿ<br><br>

अस्थि
अस्थि<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಳೆ /ಎಲುಬು<br><b>निष्पत्तिः - </b>असु (क्षेपणे) - "क्थिन्" (उ० ३-१५४)<br><b>व्युत्पत्तिः - </b>अस्यते<br><br>

अस्थिकर
अस्थिकर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇದಸ್ಸು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "टः" (३-२-२०)<br><b>व्युत्पत्तिः - </b>अस्थो करोति<br><br>

अस्थिकृत्
अस्थिकृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇದಸ್ಸು<br><b>निष्पत्तिः - </b>"क्विप्" (३-२-७८)<br><br>

अस्थिज
अस्थिज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಜ್ಜೆ /ಮೂಳೆಯೊಳಗಿನ ಪೊಳ್ಳುಭಾಗದಲ್ಲಿರುವ ಮೆತ್ತನೆಯ ಕೊಬ್ಬು<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>अस्थ्नो जायते<br><br>

अस्थिति
अस्थिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸ್ತಥಿರತೆ /ಸ್ಥಿರವಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>अभावे न० त० ।<br><br>अस्थिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮರ್ಯಾದೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अस्थिति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಥಿರವಲ್ಲದ<br><br>अस्थिति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರ್ಯಾದೆಯಿಲ್ಲದ<br><br>

अस्थितुण्ड
अस्थितुण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಕ್ಷಿ /ಹಕ್ಕಿ<br><b>व्युत्पत्तिः - </b>अस्थीव कठिनं तुण्डं यस्य<br><br>

अस्थिधन्वन्
अस्थिधन्वन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><b>निष्पत्तिः - </b>"अनङ्" (५-४-१३२)<br><b>व्युत्पत्तिः - </b>अस्थि अस्थिमयं धनुर्यस्य<br><br>

अस्थिपञ्जर
अस्थिपञ्जर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಕಾಲ /ಎಲುಬಿನ ಗೂಡು<br><b>व्युत्पत्तिः - </b>अस्थि पञ्जर इव<br><br>

अस्थिभक्ष
अस्थिभक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಯಿ<br><br>अस्थिभक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಕ್ಷಿ /ಹಕ್ಕಿ<br><b>निष्पत्तिः - </b>भक्ष (अदने) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>अस्थि भक्षयति<br><br>

अस्थिमाला
अस्थिमाला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಲುಬಿನಿಂದ ತಯಾರಿಸಿದ ಸರ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११६)<br><b>व्युत्पत्तिः - </b>अस्थिमयी मालास्य<br><br>अस्थिमाला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಲುಬುಗಳಸಾಲು<br><br>

अस्थिमालिन्
अस्थिमालिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><br>

अस्थिर
अस्थिर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಂಚಲವಾದ /ಸ್ಥಿರವಲ್ಲದ<br><br>

अस्थिशेष
अस्थिशेष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕೃಶವಾಗಿರುವ /ಮಾಂಸವಿಲ್ಲದೆ ಕೇವಲ ಮೂಳೆ ಮಾತ್ರ ಉಳಿದಿರುವ ದೇಹ<br><br>

अस्थिसार
अस्थिसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಜ್ಜೆಯೆಂಬ ಧಾತು<br><br>अस्थिसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ತ ಮಾಂಸಗಳಿಲ್ಲದ ದೇಹ<br><br>

अस्थिस्नेह
अस्थिस्नेह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಜ್ಜೆಯೆಂಬ ಧಾತು<br><br>

अस्थैर्य
अस्थैर्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಂಚಲ್ಯ /ಸ್ಥಿರವಾಗಿಲ್ಲದಿರುವಿಕೆ<br><br>अस्थैर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಂಚಲವಾದ /ಸ್ಥಿರವಲ್ಲದ<br><br>

अस्नेह
अस्नेह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶ್ವಾಸವಿಲ್ಲದಿರುವಿಕೆ<br><br>अस्नेह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತುಪ್ಪ ತೈಲಗಳಿಲ್ಲದಿರುವಿಕೆ<br><br>अस्नेह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಡ್ಡಿಲ್ಲದಿರುವಿಕೆ<br><br>अस्नेह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿಯಿಲ್ಲದ<br><br>अस्नेह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೈಲವಿಲ್ಲದ<br><br>अस्नेह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಿಡ್ಡಿಲ್ಲದ<br><br>

अस्पन्द
अस्पन्द<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪವೂ ಚಲನವಿಲ್ಲದ /ಸ್ಥಿರವಾಗಿರುವ<br><b>व्युत्पत्तिः - </b>न स्पन्दो यस्य<br><b>प्रयोगाः - </b>"अङ्गैरवज्ञातकदम्बगोलैरस्पन्दमन्देन विलोचनेन"<br><b>उल्लेखाः - </b>याद० १३-३<br><br>

अस्पन्दन
अस्पन्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪವೂ ಚಲನವಿಲ್ದಿರುವಿಕೆ<br><br>अस्पन्दन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಲನವಿಲ್ಲದ<br><br>

अस्पष्ट
अस्पष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವ್ಯಕ್ತವಾದ /ಅಸ್ಫುಟವಾದ<br><br>

अस्पृश्य
अस्पृश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಪರ್ಶಕ್ಕೆ ಯೋಗ್ಯವಲ್ಲದ /ಮುಟ್ಟಲು ಅರ್ಹವಲ್ಲದ<br><b>निष्पत्तिः - </b>स्पृश (संस्पर्शने) - "क्यप्" (३-३-१६९)<br><b>व्युत्पत्तिः - </b>न स्प्रष्टुमर्हः<br><b>प्रयोगाः - </b>"मलमूत्रपुरीषास्थिनिर्गतं ह्यशुचि स्मृतम् ।" "अस्पृश्यस्पर्शने चैव सद्यः स्थानं समाचरेत्"<br><br>

अस्पृह
अस्पृह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಸೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति स्पृहा यस्य<br><br>

अस्पृहा
अस्पृहा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಸೆಯಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न स्पृहा<br><b>प्रयोगाः - </b>"यथोत्पन्नेन सन्तोषः कर्तव्योऽत्यल्पवस्तुना । परस्याचिन्तयित्वार्थं सास्पृहा परिकीर्तिता ॥"<br><br>

अस्फुट
अस्फुट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಪಷ್ಟವಲ್ಲದ /ಚೆನ್ನಾಗಿ ತೋರದಿರುವ<br><b>व्युत्पत्तिः - </b>न स्फुटः<br><b>प्रयोगाः - </b>"क्वचित्प्रकाशां क्वचिदस्फुटार्णसम्"<br><b>उल्लेखाः - </b>नैष० ९-४<br><br>

अस्फुटवाच्
अस्फुटवाच्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸ್ಪಷ್ಟವಾಗಿ ಮಾತನಾಡುವ<br><b>व्युत्पत्तिः - </b>अस्फुटा वाक् यस्य<br><b>विस्तारः - </b>"लोहलः स्यादस्फुटावाक्" - अम० ।<br><br>

अस्मद्
अस्मद्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶರೀರದಲ್ಲಿ ಅಭಿಮಾನವುಳ್ಳ ಜೀವ<br><b>प्रयोगाः - </b>"यूयं वयं वयं यूयमित्यासीन्मतिरावयोः । किं जातमधुना येन यूयं यूयं वयं वयम् ॥"<br><br>अस्मद्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><b>प्रयोगाः - </b>"अहमात्मा गुडाकेश सर्वभूताशयस्थितः"<br><b>उल्लेखाः - </b>गीता० १०-२०<br><br>अस्मद्<br><br><b>पदविभागः - </b>त्रिलिङ्गः<br><b>कन्नडार्थः - </b>ನಾನು ಎಂಬ ಅರ್ಥವನ್ನು ಕೊಡುವ ಒಂದು ಸರ್ವನಾಮ ಶಬ್ದ<br><b>प्रयोगाः - </b>"सोऽहमाजन्मशुद्धानां आफलोसयकर्मणाम्" । "तथापि वक्तुं व्यवसायन्ति मां निरस्तनारीसमयदुराधयः" । "अहमेव गुरुः सुदारुणानामिति हालाहल मास्म तात दृप्तः । ननु सन्ति भावदृशानि भूयो भुवनेऽस्मिन् वचनानि दुर्जनानाम् ॥"<br><b>उल्लेखाः - </b>रघु० १-५, किरा० १-२८,<br><br>

अस्मदीय
अस्मदीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಮ್ಮದಾದ /ನಮ್ಮ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>अस्मद् - "छः" (४-२-१२४)<br><b>व्युत्पत्तिः - </b>अस्माकमिदम्<br><br>

अस्मद्र्यञ्च्
अस्मद्र्यञ्च्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಮ್ಮ ಕಡೆಗೆ ತಿರುಗಿದ /ನಮಗೆ ಅಭಿಮುಖವಾದ<br><b>निष्पत्तिः - </b>अञ्चु (गतौ) - अद्र्यादेशः । "क्विन्" (३-२-५९)<br><b>व्युत्पत्तिः - </b>अस्मान् अञ्चति<br><br>

अस्मि
अस्मि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಾನು<br><br>

अस्मिता
अस्मिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಹಂಭಾವ /ನಾನು ಎಂಬ ಅಭಿಮಾನ<br><br>

अस्र
अस्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಣ /ಮೂಲೆ<br><b>निष्पत्तिः - </b>असु (क्षेपणे) - "रक्" बाहु० ।<br><br>अस्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಶ /ಕೂದಲು<br><br>अस्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣೀರು<br><br>अस्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ತ<br><b>प्रयोगाः - </b>"प्रावर्तयन्नधीरस्रैर्द्विषां तद्योषितां च सः"<br><b>उल्लेखाः - </b>माघ० १९-११५<br><b>विस्तारः - </b>"अस्रह् कोणे कचे पुंसि क्लीबमश्रुणी शोणिते" - मेदि० ।<br><br>

अस्रकण्ठ
अस्रकण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣ<br><b>व्युत्पत्तिः - </b>अस्रः कोण इव कण्ठोऽस्य<br><br>

अस्रज
अस्रज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಂಸ<br><b>निष्पत्तिः - </b>अस्र + जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>अस्रात् रक्तात् जायते<br><br>

अस्रप
अस्रप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಕ್ಷಸ<br><b>निष्पत्तिः - </b>अस्र + पा (पाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>अस्रं रक्तं पिबति<br><br>अस्रप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಕ್ಷಸದೇವತಾಕವಾದ ಮೂಲಾನಕ್ಷತ್ರ<br><br>

अस्रपा
अस्रपा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಗಣೆ /ರಕ್ತವನ್ನು ಹೀರುವ ಒಂದು ಹುಳ<br><br>अस्रपा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಕ್ಷಸಿ<br><br>

अस्रार्जक
अस्रार्जक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿತುಲಸಿ ಗಿಡ<br><b>निष्पत्तिः - </b>अर्ज (प्रतियन्ते) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>अस्रं रक्तं अर्जयति<br><br>अस्रार्जक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ತವನ್ನುಂಟುಮಾಡುವ ದೇಹರಸ<br><br>अस्रार्जक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಕ್ತವನ್ನುಂಟುಮಾಡುವ<br><br>

अस्रु
अस्रु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣೀರು<br><b>निष्पत्तिः - </b>असु (क्षेपणे) - "रुक्" (उ० ५-२९)<br><br>

अस्व
अस्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದರಿದ್ರ /ಬಡವ<br><b>व्युत्पत्तिः - </b>नास्ति स्वं यस्य<br><br>अस्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನದಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न स्वः स्वकीयः<br><br>

अस्वक
अस्वक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನದಲ್ಲದ<br><b>निष्पत्तिः - </b>अस्व - "अकच्" (५-३-७१)<br><br>

अस्विका
अस्विका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನದಲ್ಲದ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्"<br><br>

अस्वच्छन्द
अस्वच्छन्द<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರತಂತ್ರ /ಸ್ವತಂತ್ರನಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न स्वच्छन्दः<br><br>

अस्वतन्त्र
अस्वतन्त्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರತಂತ್ರ /ಸ್ವತಂತ್ರನಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न स्वतन्त्रः<br><br>

अस्वतन्त्रा
अस्वतन्त्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರತಂತ್ರ /ಸ್ವತಂತ್ರನಲ್ಲದ<br><b>प्रयोगाः - </b>"अस्वतन्त्राः स्त्रियः कार्याः पुरुषैः स्वैर्दिवानिशम्"<br><b>उल्लेखाः - </b>मनु० ९-२<br><br>

अस्वन्त
अस्वन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾವು /ಮರಣ<br><b>व्युत्पत्तिः - </b>असूनामन्तः<br><br>अस्वन्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಲೆ<br><br>अस्वन्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಪರಿಣಾಮವುಳ್ಳ<br><br>

अस्वप्न
अस्वप्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><b>व्युत्पत्तिः - </b>नास्ति स्वप्नो निद्रा यस्य<br><br>अस्वप्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿದ್ರೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>अस्वप्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿದ್ರೆಯಿಲ್ಲದ<br><br>

अस्वस्थ
अस्वस्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೋಗಪೀಡಿತನಾದ<br><br>अस्वस्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ತಕ್ಕೆ ನೆಮ್ಮದಿಯಿಲ್ಲದ<br><br>

अस्वाच्छन्द्य
अस्वाच्छन्द्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸ್ವತಂತ್ರತೆ<br><b>व्युत्पत्तिः - </b>नास्ति स्वाच्छन्द्यं यस्य<br><br>अस्वाच्छन्द्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಾಧೀನ /ಅಸ್ವತಂತ್ರ<br><br>

अस्वतन्त्र्य
अस्वतन्त्र्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಾಧೀನತೆ<br><br>अस्वतन्त्र्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಾಧೀನ<br><br>

अस्वाध्याय
अस्वाध्याय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನಧ್ಯಯನ ಕಾಲ /ವೇದಾಧ್ಯಯನಕ್ಕೆ ನಿಷಿದ್ಧವಾದ ಕಾಲ<br><b>व्युत्पत्तिः - </b>न स्वाध्यायो वेदाध्ययनं यस्मिन्<br><br>अस्वाध्याय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇದಾಧ್ಯಯನ ಮಾಡದವನು<br><b>व्युत्पत्तिः - </b>नास्ति स्वाध्यायो वेदाध्ययनं यस्य<br><br>

अस्वामिक
अस्वामिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಜಮಾನನಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न स्वामी यस्य<br><b>प्रयोगाः - </b>"अटव्यः पर्वताः पुण्या नद्यस्तीर्थानि यानि च । सर्वाण्यस्च्वामिकान्याहुः न हि तेषु परिग्रहः ॥"<br><br>अस्वामिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾರಸುದಾರನಿಲ್ಲದ ನಿಧಿ<br><br>

अस्वामिन्
अस्वामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಜಮಾನನಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>न स्वामी<br><br>अस्वामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಜಮಾನನಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>नास्ति स्वामी यस्य<br><br>

अस्वामिविक्रय
अस्वामिविक्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಡೆಯನಲ್ಲದವನಿಂದ ಮಾಡಲ್ಪಡುವ ಮಾರಾಟ<br><b>व्युत्पत्तिः - </b>अस्वामिना कृतो विक्रयः<br><b>प्रयोगाः - </b>"निक्षिप्तं वा परद्रव्यं नष्टं लब्ध्वाऽपहृत्य वा । विक्रीयतेऽसमक्षं यत् स ज्ञेयोऽस्वामिविक्रयः ॥"<br><br>

अस्वाम्य
अस्वाम्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವತ್ವವಿಲ್ಲದಿರುವಿಕೆ /ಹಕ್ಕಿಲ್ಲದಿರುವಿಕೆ<br><br>अस्वाम्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಡೆತನವಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>न स्वाम्यं यस्य<br><br>

अस्वास्थ्य
अस्वास्थ्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೆಮ್ಮದಿಯಿಲ್ಲದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>न स्वास्थ्यम्<br><b>प्रयोगाः - </b>"विगृह्य चक्रे नमुचिद्विषा बली य इत्थमस्वास्थ्यमहर्दिवं दिवः"<br><b>उल्लेखाः - </b>माघ० १-५१<br><br>अस्वास्थ्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆರೋಗ್ಯವಿಲದಿರುವಿಕೆ<br><br>अस्वास्थ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೆಮ್ಮದಿಯಿಲ್ಲದ<br><br>अस्वास्थ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆರೋಗ್ಯವಿಲ್ಲದ<br><br>

अह
अह<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪೂಜೆ<br><br>अह<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಶಂಸೆ /ಹೊಗಳಿಕೆ<br><br>अह<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಜ್ಞೆ /ಅಪ್ಪಣೆ<br><br>अह<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಗ್ರಹ<br><br>अह<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಂದೆ<br><b>विस्तारः - </b>"अह प्रशंसाक्षिपयोर्नियोगे न विनिग्रहे" - मेदि० ।<br><br>

अहंयु
अहंयु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಹಂಕಾರದಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>अहम् - "युस्" (५-२-१४०)<br><b>प्रयोगाः - </b>"अहंयुनाऽथ क्षितिपः शुभंयुरुचे वचस्तापसकुञ्जरेण"<br><b>उल्लेखाः - </b>भट्टि० १-२०<br><br>

अहःपति
अहःपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>अह्नः पतिः<br><br>अहःपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಕ್ಕದ ಗಿಡ<br><br>

अहःशेष
अहःशेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಗಲಿನ ಕೊನೆಯ ಭಾಗ<br><b>व्युत्पत्तिः - </b>अह्नः शेषः<br><br>

अहङ्कार
अहङ्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ವ /ನಾನು ಎಂಬ ದುರಭಿಮಾನ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>अहमिति क्रियतेऽनेन<br><br>अहङ्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತಃಕರಣದ ಒಂದು ಭೇದ<br><b>प्रयोगाः - </b>"मनोबुद्धिरहङ्कारश्चित्तं करणमान्तरम्"<br><br>अहङ्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಮ್ಮೆ /ಸೊಕ್ಕು<br><br>

अहङ्कारिन्
अहङ्कारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿಮಾನವುಳ್ಳ<br><br>अहङ्कारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗರ್ವದಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>अहङ्कारोऽस्यास्ति<br><br>

अहङ्कृत
अहङ्कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾನು ಮಾಡುತ್ತೇನೆ ನಾನು ಮಾಡಿದೆನು ಎಂಬ ಭಾವದಿಂದ ಕೂಡಿದ /ದುರಭಿಮಾನದಿಂದ ಕೂಡಿದ<br><b>व्युत्पत्तिः - </b>अहमिति कृतं येन<br><b>प्रयोगाः - </b>"यस्य नाहङ्कृतो भावः बुद्धिर्यस्य न लिप्यते । हत्वापि स इमान् लोकान् न हन्ति न निबध्यते ॥"<br><b>उल्लेखाः - </b>गीता० १८-१७<br><br>अहङ्कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಮ್ಮೆ ಪಡುವ /ಸೊಕ್ಕುಳ್ಳ<br><b>प्रयोगाः - </b>"जातिरूपवयोवृत्तविद्यादिभिरहङ्कृतः"<br><b>उल्लेखाः - </b>याज्ञ० ३-१५१<br><br>

अहङ्कृति
अहङ्कृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಹಂಕಾರ /ದುರಭಿಮಾನ<br><br>अहङ्कृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ವ /ಸೊಕ್ಕು<br><b>निष्पत्तिः - </b>अहम् + डुकृञ् (करणे) - "क्तिन्" (३-३-९४)<br><br>

अहत
अहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಗೆಯದ ಬಟ್ಟೆ /ಚಲುವೆ ಮಾಡಲ್ಪಡದ ಬಟ್ಟೆ<br><br>अहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಯೋಗಿಸಲ್ಪಡದ ಬಟ್ಟೆ<br><br>अहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಿಯದ ಬಟ್ಟೆ /ಉಟ್ಟು ನಾಶಪಡಿಸಲ್ಪಡದ ಬಟ್ಟೆ<br><br>अहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಡೆಯಲ್ಪಡದ<br><br>

अहन्
अहन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಗಲು /ದುವಸ<br><b>निष्पत्तिः - </b>ओहाक् (त्यागे) - "कनिन्" (उ० १-१५६)<br><b>व्युत्पत्तिः - </b>न जहाति<br><b>प्रयोगाः - </b>"अव्यापारामहनि न तथा पीडयेन्मद्वियोगः"<br><b>उल्लेखाः - </b>मेघ० २-२५<br><br>अहन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾಶ<br><br>अहन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಗಲು ರಾತ್ರಿ ಸೇರಿದ ಒಂದು ದಿನ<br><br>अहन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>"अहः संवत्सरो व्यालः प्रत्ययः सर्वदर्शनः"<br><b>उल्लेखाः - </b>वि० स०<br><br>

अहन्ता
अहन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಹಂಭಾವ /ನಾನು ಎಂಬ ಅಭಿಮಾನ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>अहमो भावः<br><br>

अहम्
अहम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಾನು<br><br>अहम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಹಂಕಾರ<br><br>

अहमहमिका
अहमहमिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾನು ತಾನು ಎಂಬ ಪರಸ್ಪರ ಅಹಂಕಾರ /ತಾನೇ ಶ್ರೇಷ್ಠ ತಾನೇ ಸಮರ್ಥ ಎಂದು ಅಹಂಕಾರಪಡುವಿಕೆ<br><b>निष्पत्तिः - </b>वीप्सायां द्वित्वम् (८-१-२) । "ठन्" (५-२-११६)<br><b>व्युत्पत्तिः - </b>अहमहं शब्दोऽस्त्यत्र<br><b>विस्तारः - </b>"अहमहमिका तु सा स्यात्परस्परं यो भवत्यहङ्कारः" - अम० ।<br><br>अहमहमिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾನು ಮುಂದು ತಾನು ಮುಂದು ಎಂಬ ಸ್ಪರ್ಧೆ<br><b>प्रयोगाः - </b>"क्रियासातत्येनाप्यहमहमिकाक्रान्तमनसः"<br><b>उल्लेखाः - </b>म० वी० ६-५४<br><br>

अहम्पूर्विका
अहम्पूर्विका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾನು ಮೊದಲು ತಾನು ಮೊದಲು ಎಂದು ಸಂತೋಷದಿಂದ ಸೈನಿಕರ ಮುಂದೋಟ<br><b>व्युत्पत्तिः - </b>अहम्पूर्वमहम्पूर्वमित्यस्यां क्रियायाम्<br><b>प्रयोगाः - </b>"सुगेषु दुर्गेषु च तुल्यविक्रमैर्जवादहम्पूर्विकया यियासुभिः"<br><b>उल्लेखाः - </b>किरा० १४-३२<br><br>

अहम्प्रत्यय
अहम्प्रत्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾನು ನನ್ನದು ಎಂಬ ಜ್ಞಾನ<br><b>व्युत्पत्तिः - </b>अहमिति प्रत्ययः<br><br>

अहम्भाव
अहम्भाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾನು ಎಂಬ ದುರಭಿಮಾನ /ಗರ್ವ<br><b>व्युत्पत्तिः - </b>अहमिति भावः<br><br>

अहम्पति
अहम्पति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾನು ಎಂಬ ಜ್ಞಾನ /ಅವಿದ್ಯೆ<br><b>व्युत्पत्तिः - </b>अहमिति मतिः<br><br>

अहर्गण
अहर्गण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಿನಗಳ ಗುಂಪು /ದಿನಗಳ ಸಮುಹ<br><b>निष्पत्तिः - </b>रेफः (८-२-६९)<br><b>व्युत्पत्तिः - </b>अह्नां गुणः<br><br>

अहर्दिव
अहर्दिव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿದಿನದಲ್ಲಿಯೂ<br><b>निष्पत्तिः - </b>वीप्सायां द्वन्द्वो निपा० (५-४-७७)<br><b>व्युत्पत्तिः - </b>अहनि च दिवा च<br><b>प्रयोगाः - </b>"विगृह्य चक्रे नमुचिद्विषा बली य इत्थमस्वास्थ्यमहर्दिवं दिवः"<br><b>उल्लेखाः - </b>माघ० १-५१<br><br>

अहर्निश
अहर्निश<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಗಲು ಮತ್ತು ರಾತ್ರಿ /ಒಂದು ದಿನ<br><b>व्युत्पत्तिः - </b>अहश्च निशा च<br><b>प्रयोगाः - </b>"विरमेत्पक्षिणीं रात्रिं तदेवैकमहर्निशम्"<br><b>उल्लेखाः - </b>मनु० ४-९७<br><br>

अहर्पति
अहर्पति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಗಲಿನ ಒಡೆಯ /ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>रेफः (८-२-६९)<br><b>व्युत्पत्तिः - </b>अह्नः पतिः<br><b>प्रयोगाः - </b>"द्यावापृथिव्योः प्रत्यग्रमहर्पतिरिवातपम्"<br><b>उल्लेखाः - </b>रघु० १०-५४<br><br>अहर्पति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಕ್ಕದ ಗಿಡ<br><br>

अहर्मणि
अहर्मणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>अह्नो मणिरिव<br><br>अहर्मणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಕ್ಕದ ಗಿಡ<br><br>

अहर्मुख
अहर्मुख<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾತಃಕಾಲ /ದಿವಸದ ಪ್ರಾರಂಭಕಾಲ<br><b>व्युत्पत्तिः - </b>अह्नो मुखम्<br><br>

अहल्य
अहल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೇಗಿಲಿನಿಂದ ಉಳಲು ಯೋಗ್ಯವಲ್ಲದ ಭೂಮಿ /ಸಾಗುವಳಿಗೆ ಅರ್ಹವಲ್ಲದ<br><br>अहल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೇಗಿಲಿನಿಂದ ಉಳಲ್ಪಡದ<br><b>निष्पत्तिः - </b>"यत्" (४-४-९७) । न० त० ।<br><b>व्युत्पत्तिः - </b>हलेन कृष्यम्<br><br>

अहल्या
अहल्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೌತಮ ಮಹರ್ಷಿಯ ಪತ್ನಿ ಅಹಲ್ಯಾದೇವಿ<br><b>प्रयोगाः - </b>"अहल्या द्रौपदी सीता तारा मण्डोदरी तथा । पञ्चकन्याः स्मरेन्नित्यं महापातकनाशिनीः ॥"<br><br>

अहल्याचार
अहल्याचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><br>

अहल्याह्रद
अहल्याह्रद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೌತಮಮಹರ್ಷಿಯ ಆಶ್ರಮದಲ್ಲಿರುವ ಒಂದು ತೀರ್ಥ<br><br>

अहस्कर
अहस्कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "टः" (३-२-२१) । "सः" (८-३-४८)<br><b>व्युत्पत्तिः - </b>अहः करोति<br><b>प्रयोगाः - </b>"अधर्मधर्मोदकबिन्दुमौक्तिकैरलञ्चकारास्य वधूरहस्करः"<br><b>उल्लेखाः - </b>माघ० १-५८<br><br>अहस्कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಕ್ಕದ ಗಿಡ<br><br>

अहह
अहह<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಶ್ಚರ್ಯ<br><br>अहह<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ದುಃಖ<br><br>अहह<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕಷ್ಟ /ಶ್ರಮ<br><br>अहह<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಬೋಧನೆ /ಕರೆ<br><br>अहह<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷ<br><b>निष्पत्तिः - </b>ओहाक् (त्यागे) - "डः" (३-२-१०१)<br><b>व्युत्पत्तिः - </b>अहं जहाति<br><b>विस्तारः - </b>"अहहेत्यद्भुते खेदे परिक्लेशप्रहर्षयोः । सम्बोधनेऽपि" - मेदि० ।<br><br>

अहार्य
अहार्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತ /ಬೆಟ್ಟ<br><b>निष्पत्तिः - </b>हृञ् (हरणे) - "ण्यत्" (३-१-१२४)<br><b>व्युत्पत्तिः - </b>न हार्यः<br><br>अहार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಯ್ಯಲಾಗದ /ಕದಿಯಲಾಗದ<br><br>अहार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಯ್ಯಲನರ್ಹವಾದ<br><br>अहार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೇದಿಸಲಾಗದ<br><br>अहार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೃಢವಾದ<br><b>प्रयोगाः - </b>"विमुच्य सा हारमहार्यनिश्चया विलोलयष्टिप्रविलुप्तचन्दनम्"<br><b>उल्लेखाः - </b>कुमा० ५-८<br><br>

अहि
अहि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ /ಹಾವು<br><b>निष्पत्तिः - </b>आ + हन (हिंसागत्योः) - "इण्" आङो ह्रस्वश्च (उ० ४-१३७)<br><b>व्युत्पत्तिः - </b>आहन्ति<br><b>प्रयोगाः - </b>"करेण शम्भोर्वलयीकृताहिना सहिष्यते तत्प्रथमावलम्बनम्"<br><b>उल्लेखाः - </b>कुमा० ५-६६<br><br>अहि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃತ್ರಾಸುರ<br><br>अहि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>अहि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಹು<br><br>अहि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಥಿಕ /ಪಾಂಥ<br><br>अहि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ಲೇಷಾ ನಕ್ಷತ್ರ<br><br>अहि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು /ಜಲ<br><br>अहि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿ<br><br>अहि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರೆಯುವ ಹಸು<br><br>अहि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೀಸಲೋಹ<br><br>अहि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಪಕವಾದ /ಹರಡುವ /ಪಸರಿಸುವ<br><br>अहि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೂಮಿ ಮತ್ತು ಆಕಾಶ<br><br>

अहिंसा
अहिंसा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸದಿರುವಿಕೆ<br><br>अहिंसा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಷ್ಟಾಂಗಯೋಗದ ಅಂಗವಾದ ಯಮದ ಭೇದ<br><b>प्रयोगाः - </b>"अहिंसासत्यास्तेयब्रह्मचर्यापरिग्रहा यमाः"<br><b>उल्लेखाः - </b>पा० यो० सू० २-३०<br><br>

अहिंस्र
अहिंस्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸದಿರುವ<br><br>

अहिच्छत्र
अहिच्छत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಜುನನು ಗೆದ್ದು ದ್ರೋಣಾಚಾರ್ಯರಿಗೆ ಒಪ್ಪಿಸಿದ ಒಂದು ದೇಶ<br><br>अहिच्छत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲಮುರಿ ಗಿಡ /ಕುರಟಗೆ ಗಿಡ<br><br>

अहिजित्
अहिजित्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣ /ಕಾಳಿಯಮರ್ದನ<br><br>अहिजित्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><br>

अहित
अहित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರು /ವೈರಿ /ಹಗೆ<br><b>व्युत्पत्तिः - </b>न हितः<br><b>प्रयोगाः - </b>"अहितनभि वाहिन्या स मानी चतुरङ्गया"<br><b>उल्लेखाः - </b>माघ० १९-२५<br><br>अहित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಷ್ಟ /ಹಾನಿ<br><b>प्रयोगाः - </b>"अहितं न विचिन्तितं मयैतत्"<br><b>उल्लेखाः - </b>याद० १५-२७<br><br>अहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಥ್ಯವಲ್ಲದ /ಹಿತವಲ್ಲದ<br><br>अहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನರ್ಥಕರವಾದ /ಹಾನಿಯನ್ನುಂಟುಮಾಡುವ<br><b>प्रयोगाः - </b>"अहितादनपत्रपस्त्रसन्नतिमात्रोज्झितभीरनास्तिकः"<br><b>उल्लेखाः - </b>माघ० १६-७<br><br>

अहितुण्डिक
अहितुण्डिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾವಾಡಿಗ /ಹಾವಿನೊಡನೆ ಆಟವಾಡುವವನು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-२) । सञ्ज्ञापूर्वकत्वात् वृद्ध्यभावे रूपम् ।<br><b>व्युत्पत्तिः - </b>अहितुण्डेन दीव्यति<br><br>

अहिद्विष्
अहिद्विष्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರುಡ<br><br>अहिद्विष्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣ /ಕಾಳಿಯಮರ್ದನ<br><br>अहिद्विष्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂಗುಸಿ<br><br>अहिद्विष्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಯೂರ /ನವಿಲು<br><b>निष्पत्तिः - </b>द्विष (अप्रीतौ) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>अहिं सर्पं द्वेष्टि<br><br>अहिद्विष्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><b>निष्पत्तिः - </b>द्विष (अप्रीतौ) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>अहिं वृत्रासुरं द्वेष्टि<br><b>प्रयोगाः - </b>"समस्तकार्येषु गतेन धुर्यतामहिद्विषस्तद्भवता निशम्यताम्"<br><b>उल्लेखाः - </b>माघ० १-४१<br><br>

अहिनकुल
अहिनकुल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪಗಳು ಮತ್ತು ಮುಂಗುಸಿಗಳು<br><b>व्युत्पत्तिः - </b>अहयश्च नकुलश्च एषां समाहारः<br><br>

अहिनिर्मोक
अहिनिर्मोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾವಿನ ಸೋಲೆ /ಹಾವಿನ ಪೊರೆ<br><br>

अहिपति
अहिपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪರಾಜ /ವಾಸುಕಿ<br><br>

अहिराज
अहिराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪರಾಜ /ವಾಸುಕಿ<br><br>

अहिफेन
अहिफेन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾವಿನ ನೊರೆ<br><br>अहिफेन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಫೀಮು<br><br>

अहिभय
अहिभय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನಿಗೆ ತನ್ನವರಾದ ವಿಶ್ವಾಸಘಾತಕರಿಂದುಂಟಾಗುವ ಭಯ<br><b>विस्तारः - </b>"महीभुजामहिभयं स्वपक्षप्रभवं भयम्" - अम० ।<br><br>अहिभय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾವಿನ ಭಯ<br><br>

अहिभानु
अहिभानु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ ಸಂಚಾರಕ್ಕೆ ಕಾರಣವಾದ ವಾಯು<br><br>

अहिभुज्
अहिभुज्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರುಡ<br><br>अहिभुज्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂಗುಸಿ<br><br>अहिभुज्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಯೂರ /ನವಿಲು<br><b>निष्पत्तिः - </b>भुज (पालनाभ्यवहारयोः) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>अहिं भुनक्ति<br><br>

अहिभृत्
अहिभृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><b>निष्पत्तिः - </b>डुभृञ् (धारणपोषणयोः) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>अहिं बिभर्ति<br><br>

अहिम
अहिम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಷ್ಣತೆ /ಬಿಸಿ<br><br>अहिम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಸಿಯಾದ<br><br>

अहिमकर
अहिमकर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>अहिमः करः यस्य<br><br>

अहिमद्युति
अहिमद्युति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>अहिमा द्युतिः यस्य<br><br>

अहुमरुचि
अहुमरुचि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>अहिमा रुचिः यस्य<br><b>प्रयोगाः - </b>"अहिमरुचौ हिमधाम्नि याति चास्तम्"<br><b>उल्लेखाः - </b>माघ० ४-२०<br><br>

अहिमर्दिनी
अहिमर्दिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪಾಕ್ಷೀ /ಈಶ್ವರೀ ಹಂಬು<br><b>निष्पत्तिः - </b>मृद (क्षोदे) - "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>अहिर्मद्यतेऽनया<br><br>

अहिमार
अहिमार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಗ್ಗಲಿ ಮರ<br><br>अहिमार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರುಡ<br><br>अहिमार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಯೂರ /ನವಿಲು<br><br>अहिमार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂಗುಸಿ<br><b>निष्पत्तिः - </b>मृङ् (प्राणत्यागे) + णिच् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>अहिं मारयति<br><br>

अहिमारक
अहिमारक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಗ್ಗಲಿ ಮರ<br><b>निष्पत्तिः - </b>"ण्वुल्" (३-१-१३३)<br><br>अहिमारक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರುಡ<br><br>अहिमारक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಯೂರ /ನವಿಲು<br><br>अहिमारक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂಗುಸಿ<br><br>

अहिमांशु
अहिमांशु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>अहिमा अंशवोऽस्य<br><b>प्रयोगाः - </b>"दोषाणि नूनमहिमांशुरसौ किलेति"<br><b>उल्लेखाः - </b>माघ० ४-४६<br><br>

अहिमेद
अहिमेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಗ್ಗಲಿ ಮರ<br><br>

अहिरिपु
अहिरिपु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರುಡ<br><br>अहिरिपु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂಗುಸಿ<br><br>अहिरिपु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಯೂರ /ನವಿಲು<br><br>अहिरिपु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣ /ಕಾಳಿಯಮರ್ದನ<br><b>व्युत्पत्तिः - </b>अहेः सर्पस्य रिपुः<br><br>अहिरिपु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><b>व्युत्पत्तिः - </b>अहेः वृत्रासुरस्य रिपुः<br><br>

अहिलता
अहिलता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೀಳ್ಯದೆಲೆಯ ಬಳ್ಳಿ<br><br>अहिलता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪಾಕ್ಷೀ /ಈಶ್ವರೀ ಹಂಬು<br><br>

अहिहन्
अहिहन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರುಡ<br><br>अहिहन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>अहिं सर्पं वृत्रासुरं वा हतवान्<br><br>

अहीन
अहीन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪರಾಜ /ವಾಸುಕಿ<br><b>व्युत्पत्तिः - </b>अहीनां इनः स्वामी<br><br>अहीन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನೇಕ ದಿನಗಳಲ್ಲಿ ಮಾಡಬಹುದಾದ ಯಾಗ<br><b>निष्पत्तिः - </b>"खः" (५-१-८७)<br><b>व्युत्पत्तिः - </b>अहोभिः साध्यते<br><br>अहीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡದಿರುವ<br><br>अहीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣವಾದ /ಕಡಿಮೆಯಾಗಿಲ್ಲದ<br><br>अहीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಕೃಷ್ಟವಲ್ಲದ /ಶ್ರೇಷ್ಠವಾದ<br><br>

अहीन्द्र
अहीन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪರಾಜ /ವಾಸುಕಿ<br><b>व्युत्पत्तिः - </b>अहीनामिन्द्रः<br><b>प्रयोगाः - </b>"अहीन्द्रदामभिर्भीमैरंसलम्बिभिरंसलः"<br><b>उल्लेखाः - </b>याद० १६-५१<br><br>

अहे
अहे<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿಯೋಗ /ಅಗಲಿಕೆ<br><br>अहे<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ದುಃಖ<br><br>अहे<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಂದೆ ಇವುಗಳನ್ನು ಸೂಚಿಸುವ ಶಬ್ದ<br><br>

अहेरु
अहेरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತಮೂಲ ಗಿಡ /ಶತಾವರಿ ಗಿಡ<br><br>

अहो
अहो<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಶ್ಚರ್ಯ<br><b>प्रयोगाः - </b>"अहो स्थिरः कोऽपि तवेप्सितो युवा चिराय कर्णोत्पलशून्यतां गते"<br><b>उल्लेखाः - </b>कुमा० ५-४७<br><br>अहो<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ದಯೆ /ಕನಿಕರ<br><b>प्रयोगाः - </b>"अहो दुरन्ता बलवद्विरोधिता"<br><b>उल्लेखाः - </b>किरा० १-२३<br><br>अहो<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ಬೈಗಳು<br><br>अहो<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕರೆ /ಸಂಬೋಧನೆ<br><b>प्रयोगाः - </b>"अहो अहो देवगणाः सुरेन्द्रमुख्याः शृणुध्वं वचनं ममैते"<br><b>उल्लेखाः - </b>कुमा० १२-५४<br><br>अहो<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಶೋಕ /ದುಃಖ<br><br>अहो<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಸೂಯೆ /ಹೊಟ್ಟೆಕಿಚ್ಚು<br><br>अहो<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂದೇಹ /ಸಂಶಯ<br><br>अहो<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಶಂಸೆ /ಹೊಗಳಿಕೆ<br><br>अहो<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪಾದಪೂರಣ<br><br>अहो<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ತೃಪ್ತಿ /ಸಂತೋಷ<br><b>विस्तारः - </b>"अहो घिगर्थे शोके च करणार्थविषादयोः । सम्बोधने प्रशंसायां विस्मये पादपूरणे । असूयायां वितर्के च" - मेदि० ।<br><br>

अहोरात्र
अहोरात्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಗಲು ರಾತ್ರಿ ಇವುಗಳಿಂದ ಕೂಡಿದ ಒಂದು ದಿನ<br><b>निष्पत्तिः - </b>"अच्" (५-४-८७)<br><b>व्युत्पत्तिः - </b>अहश्च रात्रिश्च अनयोः समाहारः<br><br>

अहोबत
अहोबत<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಬೋಧನೆ /ಕರೆ<br><br>अहोबत<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ದಯೆ /ಕನಿಕರ<br><br>अहोबत<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಶ್ಚರ್ಯ<br><b>प्रयोगाः - </b>"अहोबत महत्पापं कर्तुं व्यवसिता वयम्"<br><b>उल्लेखाः - </b>गीता० १-४५<br><br>

अह्नाय
अह्नाय<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಶೀಘ್ರವಾಗಿ /ಜಾಗ್ರತೆಯಾಗಿ<br><b>प्रयोगाः - </b>"अह्नाय कोपकलुषो विकटं विहस्य"<br><b>उल्लेखाः - </b>कुमा० १७-२५<br><br>

अह्रीक
अह्रीक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ಷಪಣಿಕ /ಜೈನ ಸಂನ್ಯಾಸಿ<br><br>अह्रीक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲಜ್ಜೆಯಿಲದ /ನಾಚಿಕೆಯನ್ನು ತ್ಯಜಿಸಿದ<br><b>व्युत्पत्तिः - </b>नास्ति ह्रीर्यस्य<br><br>

अह्वल
अह्वल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೇರುಮರ<br><br>अह्वल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಹ್ವಲನಲ್ಲದ /ಧೈರ್ಯಶಾಲಿ<br><br>

आ
आ<br><br><b>कन्नडार्थः - </b>ಆಕಾರ<br><br>आ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸ್ಮೃತಿ /ಸ್ಮರಣೆ<br><b>निष्पत्तिः - </b>आप्लृ (व्याप्तौ) - "क्विप्" (३-२-१७८)<br><b>प्रयोगाः - </b>"आ एवं किल तत्"<br><br>आ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಾಕಾರ್ಥ ಸೂಚನೆ<br><b>प्रयोगाः - </b>"आ एवं नु मन्यसे"<br><br>आ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನುಕಂಪ /ದಯೆ<br><br>आ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಮುಚ್ಚಯ<br><b>विस्तारः - </b>"आ प्रगृह्यं स्मृतौ वाक्येऽनुकम्पायां समुच्चये" - मेदि० ।<br><br>

आकम्प
आकम्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ನಡುಕ<br><b>निष्पत्तिः - </b>आ + कपि (चलने) - "घञ्" (३-३-१८)<br><br>आकम्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಚಲನೆ<br><br>

आकम्पन
आकम्पन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ನಡುಕ<br><br>आकम्पन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಚಲನೆ<br><b>निष्पत्तिः - </b>आ + कपि (चलने) - भावे "ल्युट्" (३-३-११५)<br><br>आकम्पन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ನಡುಕವುಳ್ಳ<br><br>आकम्पन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಚಲನೆಯನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>आ + कपि (चलने) + णिच् - "ल्युः" (३-१-१३४)<br><br>

आकम्पित
आकम्पित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಅಲ್ಲಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + कपि (चलने) - भावे "क्तः" (३-३-११४)<br><br>आकम्पित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಅಲ್ಲಾಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + कपि (चलने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"पृक्तस्तुषारैर्गिरिनिर्झराणामनोकहाकम्पितपुष्पगन्धी"<br><b>उल्लेखाः - </b>रघु० २-१३<br><br>

आकर
आकर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೂಹ /ಗುಂಪು<br><b>निष्पत्तिः - </b>आ + डुकृञ् (करणे) - "घः" (३-३-११८)<br><b>प्रयोगाः - </b>"ततो मन्दानिलोद्धूतकमलाकरशोभिना"<br><b>उल्लेखाः - </b>कुमा० २-२९<br><br>आकर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಣಿ /ಚಿನ್ನ ಬೆಳ್ಳಿ ಮುಂತಾದುವುಗಳ ಉತ್ಪತ್ತಿ ಸ್ಥಾನ<br><b>निष्पत्तिः - </b>आ + कॄ (विक्षेपे) - "अप्" (३-३-५७)<br><b>व्युत्पत्तिः - </b>अकीर्यन्ते धातवोऽत्र<br><b>प्रयोगाः - </b>"दिलीपसूनुर्मणिराकरोद्भवः प्रयुक्तसंस्कार इवाधिकं बभौ"<br><b>उल्लेखाः - </b>रघु० ३-१८<br><br>

आकरिक
आकरिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನಿಂದ ನೇಮಿಸಲ್ಪಟ್ಟ ಗಣಿಯ ಅಧಿಕಾರಿ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-६९)<br><b>व्युत्पत्तिः - </b>आकरे नियुक्तः<br><br>

आकरिन्
आकरिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಣಿಯಲ್ಲಿ ಹುಟ್ಟಿದ /ಗಣಿಯೇ ಉತ್ಪತ್ತಿಸ್ಥಾನವಾಗಿ ಉಳ್ಳ<br><br>आकरिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ ಉತ್ಪತ್ತಿಸ್ಥಾನವುಳ್ಳ<br><b>निष्पत्तिः - </b>आकर - "इनिः" (५-२-११५)<br><b>प्रयोगाः - </b>"दधतमाकरिभिः करिभिः क्षतैः समवतारसमैरसमैस्तटैः"<br><b>उल्लेखाः - </b>किरा० ५-७<br><br>

आकर्ण
आकर्ण<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕಿವಿಯವರೆಗೂ<br><b>व्युत्पत्तिः - </b>कर्णमभिव्याप्य<br><b>प्रयोगाः - </b>"आकर्णमुल्लसितमम्बु विकासिकाशनीकाशमाप समतां सितचामरस्य"<br><b>उल्लेखाः - </b>माघ० ५-३५<br><br>

आकर्णन
आकर्णन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರವಣ ಮಾಡುವುದು /ಕೇಳುವುದು<br><b>निष्पत्तिः - </b>आ + कर्ण (भेदने) + णिच् - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"द्रुतं विधूयान्यदभूयतानया मुदा तदाकर्णनसज्जकर्णया"<br><b>उल्लेखाः - </b>नैष० १-३५<br><br>

आकर्णित
आकर्णित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೇಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + कर्ण (भेदने) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अस्मिन् धनाधीश्वरराजधान्यामाकर्णितं हैमवतीसुखेन"<br><b>उल्लेखाः - </b>याद० १८-२४<br><br>

आकर्ष
आकर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ಯೂತ /ಜೂಜು<br><br>आकर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಗಡೆಕಾಯಿ<br><br>आकर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಗಡೆಯಾಟದ ಹಲಗೆ<br><b>निष्पत्तिः - </b>आ + कृष (विलेखने) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>आकृष्यते<br><br>आकर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕರ್ಷಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + कृष (विलेखने) - भावे "घञ्" (३-३-१८)<br><br>आकर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒರೆಗಲ್ಲು<br><br>आकर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಣೆಕಲ್ಲು<br><b>निष्पत्तिः - </b>अधि० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>आकृष्यतेऽत्र<br><br>आकर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಣದಲ್ಲಿ ಧಾನ್ಯವನ್ನು ಬೇರ್ಪಡಿಸಿ ಹುಲ್ಲು ಕಡ್ಡಿಗಳನ್ನು ಎಳೆಯಲು ಅಂಕುಶದಂತೆ ಮಾಡಿರುವ ಕೋಲು<br><b>निष्पत्तिः - </b>कर० "घञ्" (३-३-१२१)<br><br>आकर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧನುರ್ವಿದ್ಯಾಭ್ಯಾಸಕ್ಕಾಗಿ ಉಪಯೋಗಿಸುವ ವಸ್ತು<br><br>आकर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಯಸ್ಕಾಂತ /ಸೂಜಿಗಲ್ಲು<br><br>आकर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯ<br><br>आकर्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕರ್ಷಿಸುವ /ಎಳೆಯುವ<br><b>निष्पत्तिः - </b>आ + कृष (विलेखने) - कर्त० "अच्" (३-१-१३४)<br><b>विस्तारः - </b>"आकर्षो द्यूत इन्द्रिये । पाशके शारिफलके कोदण्डाभ्यासवस्तुनि । आकर्षणेऽपि पुंसि स्यात्" - मेदि० ।<br><br>

आकर्षक
आकर्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಯಸ್ಕಾಂತ /ಸೂಜಿಗಲ್ಲು<br><br>आकर्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಣದಲ್ಲಿ ಧಾನ್ಯವನ್ನು ಬೇರ್ಪಡಿಸಿ ಹುಲ್ಲು ಕಡ್ಡಿಗಳನ್ನು ಎಳೆಯಲು ಅಂಕುಶದಂತೆ ಮಾಡಿರುವ ಕೋಲು<br><b>निष्पत्तिः - </b>आ + कृष (विलेखने) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>आकर्षति<br><br>आकर्षक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯುವವನು<br><br>

आकर्षण
आकर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + कृष (विलेखने) - "ल्युट्" (३-३-११५)<br><br>आकर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಹಗೊಳಿಸುವಿಕೆ<br><br>आकर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಶೀಕರಣಸಾಧನವಾದ ಒಂದು ಕಾರ್ಯ<br><b>निष्पत्तिः - </b>आ + कृष (विलेखने) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>आकृष्यतेऽनेन<br><br>

आकर्षणी
आकर्षणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಂತ್ರೋಕ್ತವಾದ ಒಂದು ವಿಧ ಮುದ್ರೆ<br><br>आकर्षणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಿಡದಿಂದ ಹಣ್ಣು ಹೂವು ಮೊದಲಾದುವುಗಳನ್ನು ಎಳೆದುಕೊಳ್ಳಲು ಮಾಡಿರುವ ತುದಿಯಲ್ಲಿ ಬಗ್ಗಿರುವ ಕೋಲು /ದೋಟಿ<br><b>निष्पत्तिः - </b>आ + कृष (विलेखने) - कर० "ल्युट्" (३-३-११७) । "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>आकृष्यतेऽनया<br><br>

आकर्षिन्
आकर्षिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯುವವನು<br><b>निष्पत्तिः - </b>आ + कृष (विलेखने) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आकर्षति<br><br>

आकर्षिणी
आकर्षिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆಯುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आकलन
आकलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆ /ಆಸೆ<br><br>आकलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಸಂಧಾನ /ವಿಮರ್ಶೆ<br><br>आकलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಹಣ /ತಿಳಿದುಕೊಳ್ಳುವಿಕೆ<br><br>आकलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲೆಕ್ಕ /ಎಣಿಕೆ<br><br>आकलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಾಧೀನಪಡಿಸಿಕೊಳ್ಳುವುದು<br><b>प्रयोगाः - </b>"सेव्योऽपि सानुनयमाकलनाय यन्त्रा"<br><b>उल्लेखाः - </b>माघ० ५४२<br><br>

आकलित
आकलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಲ್ಪಟ್ಟ /ರಚಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + कल (शब्दसङ्ख्यानयोः) - "क्तः" (३-२-१०२)<br><br>आकलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಟ್ಟಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"सुवर्णसूत्राकलिताधराम्बरां विडम्बयन्तं शितिवाससस्तनुम्"<br><b>उल्लेखाः - </b>माघ० १-६<br><br>आकलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಮರ್ಶಿಸಲ್ಪಟ್ಟ<br><br>

आकल्प
आकल्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇಷ /ಉಡುವುದು ಮತ್ತು ತೊಡುವುದು<br><br>आकल्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಷಣ /ಒಡವೆ /ಅಲಂಕಾರ<br><b>निष्पत्तिः - </b>आ + कृपू (सामर्थ्ये) + णिच् - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"अवधिं दर्शनीयानामाकल्पमनघं दिवः"<br><b>उल्लेखाः - </b>याद० १६-१८<br><br>आकल्प<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕಲ್ಪಕಾಲದವರೆಗೂ<br><br>

आकष
आकष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಣೆಕಲ್ಲು<br><br>आकष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒರೆಗಲ್ಲು<br><b>निष्पत्तिः - </b>आ + कष (हिंसायाम्) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आकषति<br><br>

आकस्मिक
आकस्मिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಕಸ್ಮಾತ್ತಾಗಿ ಉಂಟಾದ /ಅನಿರೀಕ್ಷಿತವಾದ<br><br>आकस्मिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರಣವಿಲ್ಲದ<br><b>निष्पत्तिः - </b>"ठक्" (५-४-३४)<br><b>व्युत्पत्तिः - </b>अकस्मात् भवः<br><br>

आकस्मिकी
आकस्मिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आकस्मिक ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><b>प्रयोगाः - </b>"अतर्कितप्रत्युपकारलेशामाकस्मिकीमाद्रियतानुकम्पाम्"<br><b>उल्लेखाः - </b>याद० २०-८७<br><br>

आकाङ्क्षा
आकाङ्क्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಸೆ /ಅಭಿಲಾಷೆ<br><b>निष्पत्तिः - </b>आ + काक्षि (काङ्क्षायाम्) - "अः" (३-३-१०३)<br><br>आकाङ्क्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಕ್ಯಾರ್ಥವು ಪೂರ್ತಿಯಾಗಲು ಬೇಕಾದ ಪದಗಳ ಅಪೇಕ್ಷೆ<br><b>प्रयोगाः - </b>"आकाङ्क्षा प्रतीतिप्रर्यवसायविरहः"<br><b>उल्लेखाः - </b>सा० द० २<br><br>

आकाङ्क्षित
आकाङ्क्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + काक्षि (काङ्क्षायाम्) - "क्तः" (३-२-१०२)<br><br>

आकाङ्क्षिन्
आकाङ्क्षिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>आ + काक्षि (काङ्क्षायाम्) - "णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"अफलाकाङ्क्षिभिर्यज्ञो विधिर्दृष्टो य इज्यते"<br><b>उल्लेखाः - </b>गीता० १७-११<br><br>आकाङ्क्षिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೇಳುವ /ಪ್ರಶ್ನೆ ಮಾಡುವ<br><br>

आकाङ्क्षिणी
आकाङ्क्षिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><b>प्रयोगाः - </b>"तं भावार्थं प्रसवसमयाकाङ्क्षिणीनां प्रजानाम्"<br><b>उल्लेखाः - </b>रघु० १९-५७<br><br>

आकार
आकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೂಪ /ಮೂರ್ತಿ<br><b>निष्पत्तिः - </b>आ + डुकृञ् (करणे) - "घञ्" (३-३-१८)<br><br>आकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೋಟ /ತೋರಿಕೆ<br><b>प्रयोगाः - </b>"आकारसदृशप्रज्ञः प्रज्ञया सदृशागमः"<br><b>उल्लेखाः - </b>रघु० १-१५<br><br>आकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನೋಭಾವವನ್ನು ಸೂಚಿಸುವ ಮುಖರಾಗಾದಿಗಳು /ಹೊರಗಿನ ರೂಪ<br><b>निष्पत्तिः - </b>कर० "घञ्" (३-३-१२१)<br><b>प्रयोगाः - </b>"तस्य संवृतमन्त्रस्य गूढाकारेङ्गितस्य च"<br><b>उल्लेखाः - </b>रघु० १-२०<br><br>आकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಚನೆ /ಸಂಜ್ಞೆ<br><br>आकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆ ಎಂಬ ಅಕ್ಷರ<br><br>

आकारगुप्ति
आकारगुप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮನೋಭಾವವನ್ನು ಮುಚ್ಚುವುದು<br><br>आकारगुप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುರಾಗಾದಿಗಳಿಂದ ಉಂಟಾದ ಚೇಷ್ಟೆಯನ್ನು ಮರೆಮಾಚುವುದು<br><b>व्युत्पत्तिः - </b>आकारस्य गुप्तिः<br><br>

आकारगोपन
आकारगोपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾರಗುಪ್ತಿ ಪದದ ಅರ್ಥ<br><br>

आकारण
आकारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಹ್ವಾನ /ಕರೆ<br><b>निष्पत्तिः - </b>आ + डुकृञ् (करणे) + णिच् - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"तैश्च मणीभद्राकारणाय कश्चित् प्रेषितः"<br><b>उल्लेखाः - </b>पञ्चतं०<br><br>

आकारणा
आकारणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಹ್ವಾನ /ಕರೆ<br><b>निष्पत्तिः - </b>आ + डुकृञ् (करणे) + णिच् - "युच्" (३-३-१०७)<br><br>

आकारित
आकारित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + डुकृञ् (करणे) + णिच् - "क्तः" (३-२-१०२)<br><br>

आकालिक
आकालिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಕಾಲದಲ್ಲಿ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>"ठक्" (४-३-६०)<br><b>व्युत्पत्तिः - </b>अकाले भवः<br><br>आकालिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲ್ಪಕಾಲದ<br><b>निष्पत्तिः - </b>समानकाल - "इकट्" आकालादेशश्च निपा० (५-१-११४)<br><b>व्युत्पत्तिः - </b>समानकालावाद्यन्तौ यस्य आकालिकः ।<br><b>प्रयोगाः - </b>"विद्युत्स्तनितवर्षेषु महोल्कानां च सम्प्लवे । आकालिकमनध्यायमेतेषु मनुरब्रवीत् ॥"<br><b>उल्लेखाः - </b>मनु० ४-१०३<br><br>

आकालिकी
आकालिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಿಂಚು ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><b>प्रयोगाः - </b>"तपस्विनः स्थाणुवनौकसस्तामाकालिकीं वीक्ष्य मधुप्रवृतिम्"<br><b>उल्लेखाः - </b>कुमा० ३-३४<br><br>

आकाश
आकाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಗನ /ಅಂತರಿಕ್ಷ<br><b>निष्पत्तिः - </b>काशृ (दीप्तौ) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>आसमन्तात् काशन्ते सूर्यादयोऽत्र<br><b>प्रयोगाः - </b>"आकाशं काशपुष्पच्छविमभिभवता भस्मना शुक्लयन्ती"<br><b>उल्लेखाः - </b>मुद्रा० ३-२०<br><br>आकाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಂಧ್ರ /ಛಿದ್ರ<br><br>आकाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜ್ಯ /ಸೊನ್ನೆ<br><br>

आकाशग
आकाशग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಕ್ಷಿ /ಹಕ್ಕಿ<br><br>आकाशग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕಾಶದಲ್ಲಿ ಸಂಚರಿಸುವ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "डः" (वा० ३-२-४८)<br><b>व्युत्पत्तिः - </b>आकाशे गच्छति<br><br>

आकाशगङ्गा
आकाशगङ्गा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಗಾನದಿ<br><b>प्रयोगाः - </b>"उभौ यदि व्योम्नि पृथक्प्रवाहावाकाशगङ्गापयसः पतेताम्"<br><b>उल्लेखाः - </b>माघ० ३-८<br><br>

आकाशदीप
आकाशदीप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ತಿಕಮಾಸದಲ್ಲಿ ಸಾಯಂಕಾಲ ಎತ್ತರವಾದ ಕಂಬದ ತುದಿಯಲ್ಲಿ ಹಚ್ಚುವ ದೀಪ<br><br>आकाशदीप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಬದ ತುದಿಯಲ್ಲಿನ ದೀಪ<br><br>

आकाशभाषित
आकाशभाषित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾಶದಿಂದ ಹೊರಡುವ ಮಾತು /ದೇವತೆಗಳು ಅದೃಶ್ಯರಾಗಿ ಆಕಾಶದಲ್ಲಿ ಆಡುವ ಮಾತು<br><b>व्युत्पत्तिः - </b>आकाशे भाषितम्<br><br>आकाशभाषित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರೊಂದು ಪಾತ್ರ ಪ್ರವೇಶವೇ ಇಲ್ಲದಿದ್ದರೂ ಆಕಾಶದಲ್ಲಿ ಯರೋ ಮಾತನಾಡಿದಂತೆ ಭಾವಿಸಿ ಅದನ್ನು ಅನುವಾದ ಮಾಡುತ್ತ ಉತ್ತರಕೊಟ್ಟು ಮಾತನಾಡುವುದು<br><b>प्रयोगाः - </b>"किं ब्रवीष्येवमित्यादि विना पात्रं ब्रवीति यत् । शृत्वेवानुक्तमप्येकस्तत्स्यादाकाशभाषितम् ॥"<br><b>उल्लेखाः - </b>सा० द०<br><br>

आकाशयान
आकाशयान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಮಾನ<br><b>निष्पत्तिः - </b>या (प्रापणे) - "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>आकाशे यान्त्यनेन<br><br>

आकाशवचन
आकाशवचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾಶಭಾಷಿತ ಪದದ ಅರ್ಥ<br><br>

आकाशवर्त्मन्
आकाशवर्त्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾಶಮಾರ್ಗ /ವಿಮಾನ ಮೊದಲಾದುವು ಸಂಚರಿಸುವ ಮಾರ್ಗ<br><br>आकाशवर्त्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕಾಶದಲ್ಲಿ ಸಂಚರಿಸುವ<br><br>

आकाशवाणी
आकाशवाणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶರೀರವಾಕ್ಕು<br><br>

आकारस्फटिक
आकारस्फटिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಲಿಕಲ್ಲು<br><br>

आकिञ्चन्य
आकिञ्चन्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಾರಿದ್ರ್ಯ /ದುರ್ಗತಿ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अकिञ्चनस्य भावः<br><br>

आकीर्ण
आकीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಪ್ತವಾದ /ಹರಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + कॄ (विक्षेपे) - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>आकीर्यते<br><b>प्रयोगाः - </b>"आकीर्णमृषिपत्नीनामुटजद्वाररोधिभिः"<br><b>उल्लेखाः - </b>रघु० १-५०<br><br>

आकुञ्चन
आकुञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಕೋಚ /ಎಳೆದುಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>आ + कुञ्च (कौटिल्याल्पीभावयोः) - "ल्युट्" (३-३-११५)<br><br>

आकुञ्चित
आकुञ्चित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆದುಕೊಳ್ಳಲ್ಪಟ್ಟ<br><br>आकुञ्चित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಕ್ರವಾಗಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + कुञ्च (कौटिल्याल्पीभावयोः) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"नतांसमाकुञ्चितसव्यपादम्"<br><b>उल्लेखाः - </b>कुमा० ३-७०<br><br>

आकुटिल
आकुटिल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ವಕ್ರವಾದ<br><b>व्युत्पत्तिः - </b>आ ईषत् कुटिलः<br><b>प्रयोगाः - </b>"तं तावदाकुटिलपक्ष्मविलग्नमद्य"<br><b>उल्लेखाः - </b>शाकु० ७-२५<br><br>

आकुल
आकुल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಡಿರುವ<br><b>निष्पत्तिः - </b>आ + कुल (संस्त्याने बन्धुषु च) - "कः" (३-१-१३५)<br><b>प्रयोगाः - </b>"विलम्बमानाकुलकेशपाशया कयाचिदाविष्कृतबाहुमूलया"<br><b>उल्लेखाः - </b>किरा० ८-१८<br><br>आकुल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಂತಾಕ್ರಾಂತವಾದ<br><b>प्रयोगाः - </b>"अभिचैद्यं प्रतिष्ठासुरासीत्कार्यद्वयाकुलः"<br><b>उल्लेखाः - </b>माघ० २-१<br><br>आकुल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ಲೇಶದಿಂದ ಕೂಡಿದ<br><br>आकुल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತುಂಬಿರುವ<br><b>प्रयोगाः - </b>"प्रचदूर्मिमालकुलम्"<br><b>उल्लेखाः - </b>भर्तृ० १-३<br><br>आकुल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದಲ್ಲಿ ಮಗ್ನನಾದ<br><b>प्रयोगाः - </b>"विभवगुरुभिः कृत्यैस्तस्य प्रतिक्षणमाकुला"<br><b>उल्लेखाः - </b>शाकु० ४-२८<br><br>आकुल<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ದಿಗ್ಭ್ರಮೆ ಹೊಂದಿ<br><b>प्रयोगाः - </b>"किमेतदित्याकुलमीक्षितं जनैः"<br><b>उल्लेखाः - </b>माघ० १-२<br><br>

आकुलित
आकुलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ಲೇಶಪಡಿಸಲ್ಪಟ್ಟ<br><br>आकुलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆದುರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + कुल (संस्त्याने बन्धुषु च) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"मार्गाचलव्यतिकराकुलितेव सिन्धुः शैलाधिराजतनया न ययौ न तस्थौ"<br><b>उल्लेखाः - </b>कुमा० ५-८५<br><br>आकुलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆದರಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"मनोज्ञ एव प्रमदामुखानामम्भोविहाराकुलितोऽपि वेषः"<br><b>उल्लेखाः - </b>रघु० १६-६७<br><br>आकुलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಿಗ್ಭ್ರಮೆಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>

आकुलीकृत
आकुलीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತುಂಬಿಸಲ್ಪಟ್ಟ /ಕೂಡಿಸಲ್ಪಟ್ಟ<br><br>आकुलीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಿಗ್ಭ್ರಮೆಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>आकुलीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಂದರೆಪಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आकुल + च्वि + डुकृञ् (करणे) - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>अनाकुलः आकुलः कृतः<br><br>आकुलीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆದುರಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"मदनशरशल्यवेदनाकूणितत्रिभागेन"<br><b>उल्लेखाः - </b>कादं०<br><br>

आकूणित
आकूणित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಬಗ್ಗಿಸಲ್ಪಟ್ಟ /ಸ್ವಲ್ಪ ಸಂಕೊಚ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + कूण (सङ्कोचे) - "क्तः" (३-२-१०२)<br><br>

आकूत
आकूत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಪ್ರಾಯ /ಆಶಯ<br><b>निष्पत्तिः - </b>आ + कूण (सङ्कोचे) - भावे 'क्तः" (३-३-११४)<br><b>प्रयोगाः - </b>"इतीरिताकूतमनीलवाजिनं जयाय दूतः प्रतितर्ज्य तेजसा"<br><b>उल्लेखाः - </b>किरा० १४-२६<br><br>

आकूति
आकूति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಪ್ರಾಯ /ಆಶಯ<br><b>निष्पत्तिः - </b>आ + कू (शब्दे) - "क्तिन्" (३-३-९४)<br><br>

आकृति
आकृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರೂಪ /ಮೂರ್ತಿ<br><b>निष्पत्तिः - </b>आ + डुकृञ् (करणे) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"किमिव हि मधुराणां मण्डनं नाकृतीनाम्"<br><b>उल्लेखाः - </b>शाकु० १-१७<br><br>आकृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹ /ಶರೀರ<br><br>आकृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾದರಿ /ಲಕ್ಷಣ<br><br>आकृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಂದರವಾದ ನೋಟ<br><b>प्रयोगाः - </b>"न ह्याकृतिः सुसदृशं विजहाति वृत्तम्"<br><b>उल्लेखाः - </b>मृच्छ० ९-१६<br><br>आकृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಾತಿ /ಬಗೆ<br><br>आकृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಾತಿಯ ಅಭಿವ್ಯಂಜಕವಾದ ಅವಯವಗಳ ಜೋಡಣೆ<br><br>

आकृष्ट
आकृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + कृष (विलेखने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आकृष्टप्रतनुवपुर्लतैस्तरद्भिः तस्याम्भस्तदथ सरो महार्णवस्य"<br><b>उल्लेखाः - </b>माघ० ८-२५<br><br>

आकृष्टि
आकृष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆತ /ಆಕರ್ಷಣ<br><b>निष्पत्तिः - </b>आ + कृष (विलेखने) - "क्तिन्" (३-३-९४)<br><br>

आकेकरा
आकेकरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧ ತೆರೆದು ಅರ್ಧ ಮುಚ್ಚಿದ ದೃಷ್ಟಿ /ಕಡೆಗಣ್ಣಿನ ಕಡೆ ಮುಚ್ಚಿಕೊಂಡು ಉಳಿದ ಭಾಗದಲ್ಲಿ ತೆರೆದುಕೊಂಡು ಕಣ್ಣಿನ ಗುಡ್ಡೆಗಳನ್ನು ತಿರುಗಿಸುತ್ತ ನೋಡುವ ನೋಟ<br><b>प्रयोगाः - </b>"निद्राच्छेदाभिताम्रा चिरमवतु हरेर्दृष्टिराकेकरा वः"<br><b>उल्लेखाः - </b>मुद्रा० ३-२१<br><b>विस्तारः - </b>"आकुञ्चितपुटापाङ्गसङ्गतार्धनिमेषिणी । मुहुर्व्यावृत्ततारा च दृष्टिराकेकरा स्मृता ॥"<br><br>

आक्रन्द
आक्रन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಹ್ವಾನ /ಕರೆ<br><b>निष्पत्तिः - </b>आ + क्रदि (आह्वाने रोदने च) - "घञ्" (३-३-१८)<br><br>आक्रन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದ /ಗಟ್ಟಿಯಾದ ಕೂಗು<br><b>प्रयोगाः - </b>"आक्रन्दे चाप्यपैहीति न दण्डं मनुरब्रवीत्"<br><b>उल्लेखाः - </b>मनु० ८-२९२<br><br>आक्रन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಯಂಕರವಾದ ಯುದ್ಧ<br><br>आक्रन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದವುಂಟಾಗುವಂತೆ ರೋದನ<br><b>प्रयोगाः - </b>"तासामाक्रन्दशब्देन सहसोद्भ्रान्तलोचनः"<br><b>उल्लेखाः - </b>रामा०<br><br>आक्रन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ನೇಹಿತ /ಮಿತ್ರ /ಗೆಳೆಯ<br><br>आक्रन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರ್ಷ್ಣಿಗ್ರಾಹಕನಿಗೆ ಹಿಂಭಾಗದಲ್ಲಿರುವ ರಾಜ<br><b>निष्पत्तिः - </b>कर्म० "घञ्" (३-३-१९)<br><b>प्रयोगाः - </b>"पार्ष्णिग्राहास्ततः पश्चादाक्रन्दस्तदनन्तरम् । आसारावनयोश्चैव विजिगीषोस्तु पृष्ठतः ॥"<br><br>आक्रन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಹೋದರ<br><b>विस्तारः - </b>"आक्रन्दः क्रन्दने ह्वाने मित्रदारुणयुद्धयोः । भ्रातर्यपि च पुंसि स्यात्" - मेदि० ।<br><br>आक्रन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಳುವ ಜಾಗ<br><br>

आक्रन्दन
आक्रन्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಹ್ವಾನ /ಕರೆ<br><b>निष्पत्तिः - </b>आ + क्रदि (आह्वाने रोदने च) - "ल्युट्" (३-३-११५)<br><br>आक्रन्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದವುಂಟಾಗುವಂತೆ ರೋದನ<br><br>आक्रन्दन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರೆಯುವ<br><br>आक्रन्दन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಳುವ<br><b>निष्पत्तिः - </b>आ + क्रदि (आह्वाने रोदने च) - "ल्युः" (३-१-१३४)<br><br>

आक्रन्दिक
आक्रन्दिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಳುವ ಜಾಗಕ್ಕೆ ಓಡಿ ಹೋಗುವ<br><b>निष्पत्तिः - </b>"ठञ्" (४-४-२८)<br><b>व्युत्पत्तिः - </b>आक्रन्दं रोदनस्थानं धावति<br><br>

आक्रन्दिकी
आक्रन्दिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಳುವ ಜಾಗಕ್ಕೆ ಓಡಿ ಹೋಗುವ<br><b>निष्पत्तिः - </b>स्त्रियाम् "ङीप्" (४-१-१५)<br><br>

आक्रन्दिन्
आक्रन्दिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೋದನ ಪೂರ್ವಕ ಆಹ್ವಾನ ಮಾಡುವ<br><b>निष्पत्तिः - </b>आ + क्रदि (आह्वाने रोदने च) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आक्रन्दति<br><b>प्रयोगाः - </b>"परस्पराक्रन्दिनि चक्रवाकयोः परो वियुक्ते मिथुने कृपावती"<br><b>उल्लेखाः - </b>कुमा० ५-२६<br><br>

आक्रम
आक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಣ<br><br>आक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುತ್ತುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + क्रमु (पादविक्षेपे) - "घञ्" (३-३-१८)<br><br>आक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಾಕ್ರಮ<br><br>आक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಕ್ತಿಯಿಂದ ಸ್ವಾಧೀನಪಡಿಸಿಕೊಳ್ಳುವಿಕೆ<br><br>आक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಪ್ತಿ<br><br>आक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೋಲಿಸುವಿಕೆ<br><br>

आक्रमण
आक्रमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>आक्रम ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"हरिराक्रमणेन सनतिं किल बिभ्रीत भियेत्यसम्भवः"<br><b>उल्लेखाः - </b>माघ० १६-३४<br><br>

आक्रम्यमाण
आक्रम्यमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುತ್ತಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + क्रमु (पादविक्षेपे) - कर्म० "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"असह्य वैगैस्सहसा बलौघैराक्रम्यमाणा बलिनां यदूनाम्"<br><b>उल्लेखाः - </b>याद० २०-१७<br><br>

आक्रान्त
आक्रान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಿಸಲ್ಪಟ್ಟ<br><br>आक्रान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುತ್ತಿಗೆ ಹಾಕಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + क्रमु (पादविक्षेपे) - "क्तः" (३-२-१०२)<br><br>आक्रान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"ननाम मध्योऽतिगुरुत्वभाजा नितान्तमाक्रान्त इवाङ्गनानाम्"<br><b>उल्लेखाः - </b>माघ० ३-१५<br><br>आक्रान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮಿಸಲ್ಪಟ್ಟ /ಮೀರಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"आक्रान्ता तिलकक्रियापि तिलकैर्लग्नद्विरेफाञ्जनैः"<br><b>उल्लेखाः - </b>माल० ३-५<br><br>आक्रान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಪಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"तस्येदमाक्रान्तविमानमार्गम्"<br><b>उल्लेखाः - </b>रघु० १३-३७<br><br>आक्रान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"तामङ्कमारोप्य कृशाङ्गयष्टिं वर्णान्तराक्रान्तपयोधराग्रम्"<br><b>उल्लेखाः - </b>रघु० १४-२७<br><br>

आक्रान्ति
आक्रान्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಣ /ಹಿಡಿಯುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + क्रमु (पादविक्षेपे) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"आक्रान्तिसम्भावितपादपीठम्"<br><b>उल्लेखाः - </b>कुमा० ३-११<br><br>आक्रान्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲೆ ಬೀಳುವಿಕೆ<br><br>आक्रान्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತುಂಬುವುದು<br><b>प्रयोगाः - </b>"नालङ्कुर्वन्ति रथ्याः पृथुजघनभराक्रान्तिमन्दैः प्रयातैः"<br><b>उल्लेखाः - </b>मुद्रा० ३-१०<br><br>आक्रान्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶೌರ್ಯ<br><b>प्रयोगाः - </b>"आक्रान्तितो न वशमेति महान् परस्य"<br><b>उल्लेखाः - </b>माघ० ५-४१<br><br>

आक्रीड
आक्रीड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರೀಡಾಸ್ಥಾನ /ಆಟವಾಡುವ ಜಾಗ<br><b>निष्पत्तिः - </b>आ + क्रीडृ (विहारे) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>आक्रीडन्त्यत्र<br><b>प्रयोगाः - </b>"आक्रीडपर्वतास्तेन कल्पितास्तेषु वेश्मसु"<br><b>उल्लेखाः - </b>कुमा० २-४३<br><br>आक्रीड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಟದ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>आ + क्रीडृ (विहारे) - कर्त० "अच्" (३-१-१३४)<br><br>

आक्रीडत्
आक्रीडत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ರೀಡಿಸುತ್ತಿರುವ /ಆಟವಾಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>आ + क्रीडृ (विहारे) - "शतृ" (३-२-१२४)<br><br>

आक्रीडन
आक्रीडन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರೀಡೆ /ಆಟ<br><b>निष्पत्तिः - </b>आ + क्रीडृ (विहारे) - भावे "ल्युट्" (३-३-११५)<br><br>

आक्रीडिन्
आक्रीडिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಟವಾಡುವ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>आ + क्रीडृ (विहारे) - "घिनुण्" (३-२-१४२)<br><br>

आक्रीडिनी
आक्रीडिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಟವಾಡುವ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>स्त्रियाम् "ङीप्" (४-१-६)<br><br>

आक्रुष्ट
आक्रुष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಠಿನವಾದ ಮಾತು /ಬೈಗುಳು<br><b>निष्पत्तिः - </b>आ + क्रुश (आह्वाने रोदने च) - "क्तः" (३-३-११४)<br><br>आक्रुष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪಗೊಳ್ಳಲ್ಪಟ್ಟ<br><br>आक्रुष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರೆಯಲ್ಪಟ್ಟ<br><br>आक्रुष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೂಷಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"भेरीभिराकृष्टमहागुहामुखः"<br><b>उल्लेखाः - </b>माघ० १२-२७<br><br>

आक्रोश
आक्रोश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೂಗಾಟ /ಚೀರಾಟ<br><br>आक्रोश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕ್ಷೇಪಣೆ<br><br>आक्रोश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೈಗಳು /ಶಾಪ<br><b>निष्पत्तिः - </b>आ + क्रुश (आह्वाने रोदने च) - "घञ्" (३-३-१८)<br><br>

आक्रोशक
आक्रोशक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೂಗಾಡುವವನು<br><br>आक्रोशक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿಸುವವನು /ದೂಷಿಸುವವನು<br><br>आक्रोशक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೈಯುವವನು<br><b>निष्पत्तिः - </b>आ + क्रुश (आह्वाने रोदने च) - "ण्वुल्" (३-१-१३३)<br><br>

आक्रोशन
आक्रोशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಪ /ಬೈಗಳು<br><br>आक्रोशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೂಗಾಟ<br><b>निष्पत्तिः - </b>आ + क्रुश (आह्वाने रोदने च) - "ल्युट्" (३-३-११५)<br><br>

आक्रोष्टृ
आक्रोष्टृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೈಯುವವನು<br><br>आक्रोष्टृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿಸುವವನು /ದೂಷಿಸುವವನು<br><br>आक्रोष्टृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ ಕೂಗಾಡುವವನು<br><b>निष्पत्तिः - </b>आ + क्रुश (आह्वाने रोदने च) - "तृच्" (३-१-१३३)<br><br>

आक्लेद
आक्लेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೆನಸುವುದು /ಒದ್ದೆ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>आ + क्लिदू (आर्द्रीभावे) - "घञ्" (३-३-१८)<br><br>

आक्षद्यूतिक
आक्षद्यूतिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಗಟೆಯಾಟದಿಂದ ಉಂಟಾದ ವೈರ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-१९)<br><b>व्युत्पत्तिः - </b>अक्षद्यूतेन निर्वृत्तम्<br><br>

आक्षपाटीक
आक्षपाटीक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೂಜಾಟದ ಅಧ್ಯಕ್ಷ<br><br>आक्षपाटीक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನ್ಯಾಯಾಧೀನ /ತೀರ್ಪುಗಾರ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-६९)<br><b>व्युत्पत्तिः - </b>अक्षपटे नियुक्तः<br><br>

आक्षार
आक्षार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಭಿಚಾರದ ದೋಷಾರೋಪಣೆ<br><b>निष्पत्तिः - </b>आ + क्षर (सञ्चलने) + णिच् - "घञ्" (३-३-१८)<br><br>

आक्षारण
आक्षारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಭಿಚಾರದ ದೋಷಾರೋಪಣೆ<br><b>निष्पत्तिः - </b>आ + क्षर (सञ्चलने) + णिच् - "ल्युट्" (३-३-११५)<br><br>

आक्षारणा
आक्षारणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಭಿಚಾರದ ದೋಷಾರೋಪಣೆ<br><b>निष्पत्तिः - </b>आ + क्षर (सञ्चलने) + णिच् - "युच्" (३-३-१०७)<br><br>

आक्षारित
आक्षारित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಬಿಚಾರದೋಷದಿಂದ ದೂರಲ್ಪಟ್ಟವನು<br><b>निष्पत्तिः - </b>आ + क्षर (सञ्चलने) + णिच् - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>आक्षार्यते<br><b>विस्तारः - </b>"आक्षारितः क्षारितोऽभिशस्ते" - अम० ।<br><br>

आक्षिक
आक्षिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಗಡೆಯಾಟವಾಡುವವನು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-२)<br><b>व्युत्पत्तिः - </b>अक्षेण दीव्यति<br><br>आक्षिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಗಡೆಯಾಟದಿಂದ ಜಯಿಸುವವನು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-२)<br><b>व्युत्पत्तिः - </b>अक्षेण जयति<br><br>आक्षिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಗಡೆಯಾಟದಿಂದ ಜಯಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-२)<br><b>व्युत्पत्तिः - </b>अक्षेण जितम्<br><br>

आक्षिप्त
आक्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕ್ಷೇಪಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + क्षिप (प्रेरणे) - "क्तः" (३-२-१०२)<br><br>आक्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಸೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + क्षिपु (निरसने) - "क्तः" (३-२-१०२)<br><br>आक्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಯಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"आक्षिप्तसम्पातमपेतशोभम्"<br><b>उल्लेखाः - </b>किरा० १६-४१<br><br>आक्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಡಿಯಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"आक्षिप्ता अपि दन्तीन्द्रैः कोपनैः पत्तयः परम्"<br><b>उल्लेखाः - </b>कुमा० १६-३३<br><br>आक्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಹರಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"आक्षिप्तचापावरणेषुजालश्छिन्नोत्तमासिः स मृधेऽवधूतः"<br><b>उल्लेखाः - </b>किरा० १७-५९<br><br>आक्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಾಬರಿಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>आक्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಥಾಪತ್ತಿಪ್ರಮಾಣದಿಂದ ಸಿದ್ಧವಾದ<br><br>आक्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೂಷಿಸಲ್ಪಟ್ಟ<br><br>

आक्षेप
आक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆದರಿಸುವಿಕೆ<br><br>आक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಸೆಯುವುದು /ಬಿಸಾಡುವುದು<br><br>आक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆದುಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>आ + क्षिप (प्रेरणे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"वदनमपहरन्तीं तत्कृताक्षेपमीशः"<br><b>उल्लेखाः - </b>कुमा० ७-९५<br><br>आक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರ<br><b>प्रयोगाः - </b>"विरुद्धमाक्षेपवचस्तितिक्षितम्"<br><b>उल्लेखाः - </b>किरा० १४-२५<br><br>आक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪವಾದ<br><br>आक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಕ್ಷೇಪ /ಕೂಡುಹಣ<br><br>आक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಡುವಿಕೆ<br><b>प्रयोगाः - </b>"गोरोचनाक्षेपनितान्तगौरे"<br><b>उल्लेखाः - </b>कुमा० ७-१७<br><br>आक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಮಾನ<br><br>आक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥಾಪತ್ತಿಪ್ರಮಾಣದಿಂದ ಕಲ್ಪಿಸುವಿಕೆ<br><br>आक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಅರ್ಥಾಲಂಕಾರ<br><b>प्रयोगाः - </b>"आक्षेपः स्वयमुक्तस्य प्रतिषेधो विचारणात् । चन्द्र सन्दर्शयात्मानमथवास्ति प्रियामुखम् ॥"<br><b>उल्लेखाः - </b>चन्द्रा०<br><br>

आक्षेपक
आक्षेपक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಧ /ಬೇಡರವನು<br><br>आक्षेपक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಾತರೋಗ<br><br>आक्षेपक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಅರ್ಥಸಿದ್ಧಿಯ ಉಪಪಾದಕವಾಗಿ ಹೇಳುವ ಮಾತು<br><br>आक्षेपक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿಸುವವನು<br><br>आक्षेपक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಸೆಯುವವನು<br><br>आक्षेपक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯುವವನು /ಆಕರ್ಷಿಸುವವನು<br><b>विस्तारः - </b>"आक्षेपकोऽनिलव्याधौ व्याधे निन्दाकरेऽपि च" - मेदि० ।<br><br>

आक्षेपण
आक्षेपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>आक्षेप ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>आ + क्षिप (प्रेरणे) - "ल्युट्" (३-३-११५)<br><br>

आक्षेपिन्
आक्षेपिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>आक्षेपक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>आ + क्षिप (प्रेरणे) - "णिनिः" (३-२-७८)<br><br>

आख
आख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸನಿಕೆ /ಗುದ್ದಲಿ<br><b>निष्पत्तिः - </b>खनु (अवदारणे) - "डः" (वा० ३-३-१२५)<br><b>व्युत्पत्तिः - </b>आखनत्यनेन<br><br>

आखकी
आखकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಗುದ್ದಲಿ /ಕೈಗುದ್ದಲಿ<br><b>निष्पत्तिः - </b>आख - अल्पार्थे "कन्" । गौरा० "ङीष्" (४-१-४१०<br><br>

आखण्डल
आखण्डल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ /ದೇವತೆಗಳ ಒಡೆಯ<br><b>निष्पत्तिः - </b>खडि (भेदने० - "कलच्" (उ० १-१०६)<br><b>व्युत्पत्तिः - </b>आखण्डयति पर्वतान्<br><b>प्रयोगाः - </b>"अखण्डमाखण्डलतुल्यधामभिः"<br><b>उल्लेखाः - </b>किरा० १-२९<br><br>

आखन
आखन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸನಿಕೆ /ಗುದ್ದಲಿ<br><b>निष्पत्तिः - </b>आ + खनु (अवदारणे) - "घः" (३-३-१२५)<br><b>व्युत्पत्तिः - </b>आखनत्यनेन<br><br>

आखनिक
आखनिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೋರ /ಕಳ್ಳ<br><b>निष्पत्तिः - </b>आ + खनु (अवदारणे) - "इकः" (वा० ३-३-१२५)<br><b>व्युत्पत्तिः - </b>आखनत्यनेन<br><br>आखनिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸನಿಕೆ /ಗುದ್ದಲಿ<br><br>आखनिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರಾಹ /ಹಂದಿ<br><br>आखनिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಷಿಕ /ಇಲಿ<br><b>निष्पत्तिः - </b>आ + खनु (अवदारणे) - "इकन्" (उ० २-४६)<br><br>आखनिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗೆಯುವವನು<br><b>विस्तारः - </b>"भवेदाखनिकश्चौरे सूकरे मूषिकेऽपि च" - मेदि० ।<br><br>

आखनिकबक
आखनिकबक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸನಿಕೆ /ಗುದ್ದಲಿ<br><b>निष्पत्तिः - </b>आ + खनु (अवदारणे) - "इकवक" (वा० ३-३-१२५)<br><br>आखनिकबक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೋರ /ಕಳ್ಳ<br><br>आखनिकबक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಷಿಕ /ಇಲಿ<br><br>आखनिकबक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರಾಹ /ಹಂದಿ<br><br>आखनिकबक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗೆಯುವವನು<br><br>

आखर
आखर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸನಿಕೆ /ಗುದ್ದಲಿ<br><b>निष्पत्तिः - </b>आ + खनु (अवदारणे) - "डरः" (वा० ३-३-१२५)<br><b>व्युत्पत्तिः - </b>आखनत्यनेन<br><br>

आखान
आखान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸನಿಕೆ /ಗುದ್ದಲಿ<br><b>निष्पत्तिः - </b>आ + खनु (अवदारणे) - "घञ्" (३-३-१२५)<br><b>व्युत्पत्तिः - </b>आखनत्यनेन<br><br>आखान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ಅಗೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + खनु (अवदारणे) - भावे "घञ्" (३-३-१५)<br><br>

आखु
आखु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಷಿಕ /ಇಲಿ<br><b>निष्पत्तिः - </b>आ + खनु (अवदारणे) - "डुः" (उ० १-३३)<br><b>व्युत्पत्तिः - </b>आखनति<br><b>प्रयोगाः - </b>"अत्तुं वाञ्छति शाम्भवो गण्पतेराखुं क्षुधार्तः"<br><b>उल्लेखाः - </b>पञ्चतं०<br><br>आखु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೋರ /ಕಳ್ಳ<br><br>आखु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರಾಹ /ಹಂದಿ<br><br>आखु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸನಿಕೆ /ಗುದ್ದಲಿ<br><br>आखु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಪಣ /ಜಿಪುಣ<br><b>विस्तारः - </b>"विभवे सति नैवात्ति न ददाति जुहोति च । तमाहुराखुम्" । "आखनिकस्त्वाखुरिव किरावुन्दुरुचौरयोः" - हेम० ।<br><br>आखु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತಾಳೆ ಮರ<br><br>

आखुकर्णी
आखुकर्णी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಲಿಕಿವಿ ಗಿಡ<br><b>निष्पत्तिः - </b>"ङीष्" (४-१-५४)<br><b>व्युत्पत्तिः - </b>आखोः मूषिकस्य कर्ण इव पर्णमस्याः<br><br>

आखुग
आखुग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಣಪತಿ /ವಿನಾಯಕ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "डः" (वा० ३-२-४८)<br><b>व्युत्पत्तिः - </b>आखुना गच्छति<br><br>

आखुघात
आखुघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಲುಯನ್ನು ಕೊಲ್ಲುವ ಶೂದ್ರ<br><br>

आखुपर्णी
आखुपर्णी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಲಿಕಿವಿ ಗಿಡ<br><br>

आखुपाषाण
आखुपाषाण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೋಹಕಾಂತ /ಸೂಜಿಗಲ್ಲು<br><br>

आखुभुज्
आखुभुज्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾರ್ಜಾರ /ಬೆಕ್ಕು<br><b>निष्पत्तिः - </b>भुज (पालनाभ्यवहारयोः) - "क्विप्" (३-२-१७८)<br><b>व्युत्पत्तिः - </b>आखुं भुङ्क्ते<br><br>

आखुविषहा
आखुविषहा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತಾಳೆ ಮರ<br><br>

आखेट
आखेट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಟೆ<br><b>निष्पत्तिः - </b>आ + खिट (त्रासे) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>आखिट्यतेऽत्र<br><br>

आखेटक
आखेटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಟೇಗಾರ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><br>आखेटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಟೆ<br><br>

आख्या
आख्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಳುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + ख्या (प्रकथने) - "अङ्" (३-३-१०६)<br><b>व्युत्पत्तिः - </b>आख्यायतेऽनेन<br><b>प्रयोगाः - </b>"उमेति मात्रा तपसो निषिद्धा पश्चादुमाख्यां सुमुखी जगाम"<br><b>उल्लेखाः - </b>कुमा० १-२६<br><br>आख्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಮಧೇಯ<br><br>

आख्यात
आख्यात<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧಾತುವಿನ ಮುಂದೆ ವಿಧಿಸಲ್ಪಡುವ तिङ् ಪ್ರತ್ಯಯ<br><b>प्रयोगाः - </b>"आश्वास्य रामावरजः सतीं तामाख्यातवाल्मीकिनिकेतमार्गः"<br><b>उल्लेखाः - </b>रघु० १४-५८<br><br>आख्यात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + ख्या (प्रकथने) - "क्तः" (३-२-१०२)<br><br>आख्यात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಸಿದ್ಧವಾದ<br><br>

आख्यातव्य
आख्यातव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + ख्या (प्रकथने) - "तव्यः" (३-१-९६)<br><b>प्रयोगाः - </b>"आख्यातव्यं तु तत्तैस्मै पृच्छते यदि पृच्छति"<br><b>उल्लेखाः - </b>मनु० ११-१७<br><br>

आख्याति
आख्याति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಳುವುದು<br><b>निष्पत्तिः - </b>आ + ख्या (प्रकथने) - "क्तिन्" (३-३-९४)<br><br>आख्याति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಸಿದ್ಧಪಡಿಸುವುದು<br><br>आख्याति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಶಸ್ಸು /ಕೀರ್ತಿ<br><br>आख्याति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಸರು<br><br>

आख्यातृ
आख्यातृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳುವವನು<br><br>आख्यातृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪದೇಶಕ /ಉಪಾಧ್ಯಾಯ<br><b>निष्पत्तिः - </b>आ + ख्या (प्रकथने) - "तृच्" (३-१-१३३)<br><br>

आख्यात्री
आख्यात्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪದೇಶಕಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आख्यान
आख्यान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಳುವುದು<br><b>निष्पत्तिः - </b>आ + ख्या (प्रकथने) - भावे "ल्युट्" (३-३-११५)<br><br>आख्यान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂರ್ವಕಥೆಯನ್ನು ಹೇಳುವುದು<br><b>विस्तारः - </b>"आख्यानं पूर्ववृत्तोक्तिः" - सा० द०<br><br>आख्यान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಪಿತ ಕಥೆ<br><br>

आख्यानक
आख्यानक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಥೆ /ಕಲ್ಪಿತವಾದ ಸಣ್ಣ ಕಥೆ /ಉಪಕಥೆ<br><b>प्रयोगाः - </b>"कदाचिदाख्यानकाख्यायिकेतिहासपुराणाकर्णनेन"<br><b>उल्लेखाः - </b>कादं०<br><br>

आख्यायक
आख्यायक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೂತ /ಸಂದೇಶವನ್ನು ತಿಳಿಸುವವನು<br><b>निष्पत्तिः - </b>आ + ख्या (प्रकथने) - "ण्वुल्" (३-१-१३३)<br><b>प्रयोगाः - </b>"आख्यायकेभ्यः श्रुतसूनुवृत्तिः"<br><b>उल्लेखाः - </b>भट्टि० २-४४<br><br>आख्यायक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳುವ /ತಿಳಿಸುವ<br><br>

आख्यायिका
आख्यायिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಥಾರ್ಥವಾದ ಕಥೆ /ನಿಜವಾಗಿ ನಡೆದ ಕಥೆ /ಹರ್ಷಚರಿತ ಮುಂತಾದ ಗದ್ಯಕಾವ್ಯ<br><b>निष्पत्तिः - </b>आ + ख्या (प्रकथने) - "ण्वुल्" (३-१-१३३)<br><b>प्रयोगाः - </b>"अपादः पदसन्तानो गद्यमाख्यायिका कथा । इति तस्य प्रभेदौ द्वौ ।"<br><b>उल्लेखाः - </b>काव्या० १-२३<br><br>

आख्यायिन्
आख्यायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳುವವನು /ತಿಳಿಸುವವನು<br><b>प्रयोगाः - </b>"रहस्याख्यायीव स्वनति मृदु कर्णानितिकचरः<br><b>उल्लेखाः - </b>शाकु० १-२०<br><br>

आख्येय
आख्येय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಸಲು ಅರ್ಹವಾದ<br><b>निष्पत्तिः - </b>आ + ख्या (प्रकथने) - "यत्" (३-१-९१)<br><b>व्युत्पत्तिः - </b>आख्यातुं योग्यम्<br><b>प्रयोगाः - </b>"शब्दाख्येयं यदपि किल ते यः सखीनां पुरस्तात्"<br><b>उल्लेखाः - </b>मेघ० २-४०<br><br>

आगत
आगत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಗಮನ /ಬರುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + गम्लृ (गतौ) - "क्तः" (३-३-११४)<br><br>आगत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಭವ /ಸಂಘಟನೆ /ಆಗು<br><br>आगत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂದಿರುವ<br><b>प्रयोगाः - </b>"आगतानगणितप्रतियातान्"<br><b>उल्लेखाः - </b>माघ० १०-२०<br><br>आगत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಭವಿಸಿರುವ<br><b>प्रयोगाः - </b>"आगतेयमसमिक्ष्यकारिता"<br><b>उल्लेखाः - </b>याद० १७-१११<br><br>आगत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪಾದಿಸಿದ /ಗಳಿಸಿದ<br><b>निष्पत्तिः - </b>आ + गम्लृ (गतौ) - कर्त० "क्तः" (३-४-७२)<br><br>

आगतवत्
आगतवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಂದಿರುವ /ಆಗಮಿಸಿರುವ<br><b>निष्पत्तिः - </b>आ + गम्लृ (गतौ) - "क्तवतुः" (३-२-१०२)<br><br>

आगति
आगति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಗಮನ /ಬರುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + गम्लृ (गतौ) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"इति निश्चितप्रियतमागतयः"<br><b>उल्लेखाः - </b>माघ० ९-४३<br><br>आगति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಡೆಯುವಿಕೆ /ಹೊಂದುವಿಕೆ<br><br>

आगन्तव्य
आगन्तव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಶ್ಯವಾಗಿ ಬರಬೇಕಾಗಿರುವ<br><b>निष्पत्तिः - </b>आ + गम्लृ (गतौ) - "तव्यः" (३-१-९६)<br><br>

आगन्तु
आगन्तु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಥಿ /ಮನೆಗೆ ಹೊಸದಾಗಿ ಬಂದು ಇಳಿದುಕೊಂಡಿರುವವನು<br><b>निष्पत्तिः - </b>आ + गम्लृ (गतौ) - "तुन्" (उ० १-६९)<br><b>व्युत्पत्तिः - </b>आगच्छति<br><b>प्रयोगाः - </b>"मेने यथा तत्र जनः समेतो वैदर्भमागन्तुमजं गृहेशम्"<br><b>उल्लेखाः - </b>रघु० ५-६२<br><br>आगन्तु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಕಸ್ಮಾತ್ತಾಗಿ ಮನೆಗೆ ಬಂದಿರುವ /ಅಪರಿಚಿತನಾದ<br><b>प्रयोगाः - </b>"आगन्तुना सह मैत्री न कार्या"<br><b>उल्लेखाः - </b>हितो०<br><br>

आगन्तुक
आगन्तुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಕಸ್ಮಾತ್ತಾಗಿ ಮನೆಗೆ ಬಂದಿರುವ /ಅಪರಿಚಿತನಾದ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><b>प्रयोगाः - </b>"त्वया च मूलभृत्यानपास्यायमागन्तुकः"<br><b>उल्लेखाः - </b>हितो०<br><br>

आगन्तुज
आगन्तुज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಕಸ್ಮಾತ್ತಾಗಿ ಉಂಟಾದ ರೋಗ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>आगन्तोः अकस्मादुपस्थितात् जायते<br><b>प्रयोगाः - </b>"आगन्तुजे भिषग्रोगे शास्त्रेणोत्कृत्य यत्नतः"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

आगम
आगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬರುವಿಕೆ /ಸೇರುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + गम्लृ (गतौ) - "अप्" (३-३-५८)<br><b>प्रयोगाः - </b>"तनोति नस्तामुदितात्मगौरवो गुरुस्तवैवागम एष धृष्टताम्"<br><b>उल्लेखाः - </b>माघ० १-३०<br><br>आगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರ<br><b>प्रयोगाः - </b>"आगमादिव तमोऽपहादितः सम्भवन्ति मतयो भवच्छिदः"<br><b>उल्लेखाः - </b>किरा० ५-२२<br><br>आगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿ /ಜನನ<br><b>प्रयोगाः - </b>"आगमापायिनोऽनित्याः तांस्तितिक्षस्व भारत"<br><b>उल्लेखाः - </b>गीता० २-१४<br><br>आगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಭ /ಪ್ರಾಪ್ತಿ /ಸಂಪಾದನೆ<br><b>प्रयोगाः - </b>"एषोऽस्या मुद्राया आगमः'<br><b>उल्लेखाः - </b>मुद्रा० १<br><br>आगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರಜ್ಞಾನ /ಶಾಸ್ತ್ರಪರಿಚಯ<br><b>प्रयोगाः - </b>"आकारसदृशप्रज्ञः प्रज्ञया सदृशागमः । आगमैः सदृशारम्भः"<br><b>उल्लेखाः - </b>रघु० १-१५<br><br>आगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನ್ಯಾಯಸಮ್ಮತವಾದ ಸಂಪಾದನೆ<br><b>प्रयोगाः - </b>"आगमोऽभ्यधिको भोगाद्विना पूर्वक्रमागतान्"<br><b>उल्लेखाः - </b>याज्ञ० २-२७<br><br>आगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಾರ್ಶನಿಕರು ಅಂಗೀಕರಿಸಿರುವ ಶಬ್ದಪ್ರಮಾಣ<br><br>आगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇದ<br><b>प्रयोगाः - </b>"बहुधाप्यागमैर्भिन्नाः पन्थानः सिद्धिहेतवः"<br><b>उल्लेखाः - </b>रघु० १०-२६<br><br>आगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣಶಾಸ್ತ್ರದಲ್ಲಿ ಒಂದು ವರ್ಣದ ಜೊತೆಗೆ ವಿಧಿಸಲ್ಪಡುವ ಮತ್ತೊಂದು ವರ್ಣ<br><br>आगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಗುಣ ಮತ್ತು ನಿರ್ಗುಣೋಪಾಸನೆಯ ಕ್ರಮವನ್ನು ತಿಳಿಸುವ ಭಗವನ್ಮುಖೋದಿತವಾದ ಒಂದು ಶಾಸ್ತ್ರ<br><b>व्युत्पत्तिः - </b>आ समन्तात् गमयति<br><b>विस्तारः - </b>"आसमन्तात् गमयति धर्माधर्मौ परम्पदम् । आगमस्तेन कथित इति वेदविदो विदुः ॥"<br><br>

आगमन
आगमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬರುವಿಕೆ /ಸೇರುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + गम्लृ (गतौ) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"गतस्पृहोप्यागमनप्रयोजनं वदेति वक्तुं व्यवसीयते यया"<br><b>उल्लेखाः - </b>माघ० १-३०<br><br>आगमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಭ /ಪ್ರಾಪ್ತಿ /ಸಂಪಾದನೆ<br><b>प्रयोगाः - </b>"एतत्ते सर्वमाख्यातं वैरस्यागमनं महत्"<br><b>उल्लेखाः - </b>रामा०<br><br>आगमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿ /ಜನನ<br><br>

आगमवृद्ध
आगमवृद्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನವೃದ್ಧ /ಪರಿಪೂರ್ಣ ಶಾಸ್ತ್ರಜ್ಞಾನವುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>आगमेन शास्त्रज्ञानेन वृद्धः<br><br>

आगमवेत्तृ
आगमवेत्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇದವನ್ನು ತಿಳಿದಿರುವ<br><b>निष्पत्तिः - </b>विद (ज्ञाने) - "तृच्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>आगमं वेत्ति<br><br>

आगमवेत्त्री
आगमवेत्त्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇದಾಭ್ಯಾಸ ಮಾಡಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आगमवेदिन्
आगमवेदिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಶಂಕರಾಚಾರ್ಯರ ಪರಮ ಗುರುಗಳಾದ ಗೌಡಪಾದಾಚಾರ್ಯರು<br><br>आगमवेदिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇದವನ್ನು ತಿಳಿದಿರುವ<br><b>निष्पत्तिः - </b>विद (ज्ञाने) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>आगमं वेत्ति<br><br>

आगमवेदिनी
आगमवेदिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇದವನ್ನು ತಿಳಿದಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आगमापायिन्
आगमापायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿ ಮತ್ತು ನಾಶ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>आगमश्चापायश्च आगमापायौ, तौ विद्यतेऽस्य<br><b>प्रयोगाः - </b>"आगमापायिनोऽनित्याः तांस्तितिक्षस्व भारत"<br><b>उल्लेखाः - </b>गीता० २-१४<br><br>

आगमापायिनी
आगमापायिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿ ಮತ್ತು ನಾಶ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आगमिन्
आगमिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದೆ ಬರುವ /ಮುಂದೆ ಉಂಟಾಗುವ<br><b>निष्पत्तिः - </b>आ + गम्लृ (गतौ) - "इनिः" (३-३-३)<br><br>आगमिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರ ಜ್ಞಾನವುಳ್ಳ /ಶಾಸ್ತ್ರಾಭ್ಯಾಸವುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>आगमोऽस्यास्ति<br><b>प्रयोगाः - </b>"द्वावपि किलागमिनौ प्रयोगनिपुणौ च"<br><b>उल्लेखाः - </b>माल० ३<br><br>आगमिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಗಮವು ವಿಧಿಸಲ್ಪಡುವ ಪ್ರಕೃತಿ ಪ್ರತ್ಯಯ ಮುಂತಾದುದು<br><br>आगमिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬರುವ /ತಲುಪುವ<br><br>

आगमिनी
आगमिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आगमिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आगर
आगर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಮಾವಾಸ್ಯೆ<br><b>निष्पत्तिः - </b>गॄ (निगरणे) - "अप्" (३-३-५७)<br><b>व्युत्पत्तिः - </b>आगीर्यते उद्वमितुमारभ्यते चन्द्रोऽत्र<br><br>

आगवीन
आगवीन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೋಪಾಲಕ<br><b>निष्पत्तिः - </b>आ + गो - "खः" (५-२-१४)<br><b>व्युत्पत्तिः - </b>गोः प्रत्यर्पणपर्यन्तं कर्म करोति<br><br>

आगस्
आगस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪರಾಧ /ತಪ್ಪು /ಅಪಚಾರ<br><b>निष्पत्तिः - </b>इण् (गतौ) - "असुन्" आगादेशश्च (उ० ४-२९२)<br><b>प्रयोगाः - </b>"यत्ते चतुर्विधमकारि रणे तदागः क्षन्तव्यमद्य भवता करुणार्णवेन"<br><b>उल्लेखाः - </b>चं० भा०<br><br>आगस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><b>विस्तारः - </b>"आगोऽपराधे पापेऽपि" - मेदि० ।<br><br>

आगस्कृत्
आगस्कृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪರಾಧಿ /ತಪ್ಪು ಮಾಡಿದವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>आगः करोति<br><b>प्रयोगाः - </b>"अभ्यर्णमागस्कृतमस्पृशद्भिः"<br><b>उल्लेखाः - </b>रघु० २-३२<br><br>आगस्कृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪಕೃತ್ಯವನ್ನೆಸಗುವವನು<br><br>

आगस्ती
आगस्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣ ದಿಕ್ಕು /ಅಗಸ್ತ್ಯ ಸಂಬಂಧವಾದ ದಿಕ್ಕು<br><b>निष्पत्तिः - </b>"अण्" (४-२-१२०) । "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>अगस्त्यस्येयम्<br><br>आगस्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸ್ತ್ಯಗೋತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

आगस्त्य
आगस्त्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣ ದಿಗ್ವಿಭಾಗ<br><b>प्रयोगाः - </b>"कौबेरदिग्भागमपास्य मार्गमागस्त्यमुष्णांशुरिवावतीर्णः"<br><b>उल्लेखाः - </b>माघ० ३-१<br><br>आगस्त्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸ್ತ್ಯಮಹರ್ಷಿಯ ಪುತ್ರ<br><b>निष्पत्तिः - </b>"यञ्" (४-१-१०५)<br><b>व्युत्पत्तिः - </b>अगस्तेरपत्यम्<br><br>आगस्त्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸ್ತ್ಯಗೋತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><b>निष्पत्तिः - </b>"अण्" (४-२-१११)<br><b>व्युत्पत्तिः - </b>अगस्त्यस्य गोत्रापत्यम्<br><br>आगस्त्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗಸ್ತ್ಯ ಸಂಬಂಧವಾದ ದಿಕ್ಕು ಮೊದಲಾದುದು<br><br>

आगार
आगार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹ /ಮನೆ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>अगान् वृक्षान् स्तम्भभूतान् ऋच्छति<br><br>

आगारगोधिका
आगारगोधिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಲ್ಲಿ /ಗೌಳಿ<br><br>

आगुर्
आगुर्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಜ್ಞೆ<br><b>निष्पत्तिः - </b>आ + गुरी (उद्यमने) - "क्विप्"<br><br>

आगूः
आगूः<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಜ್ಞೆ<br><br>

आगुरण
आगुरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ಯಮ /ಪ್ರಯತ್ನ<br><b>निष्पत्तिः - </b>आ + गुरी (उद्यमने) - "ल्युट्" (३-३-११५)<br><br>

आगू
आगू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಜ್ಞೆ<br><b>निष्पत्तिः - </b>आ + गुरी (उद्यमने) - "डूः" (उ० २-६८)<br><br>

आगूर्ण
आगूर्ण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನ<br><b>निष्पत्तिः - </b>आ + गुरी (उद्यमने) - भावे "क्तः" (३-३-११४)<br><br>आगूर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನವುಳ್ಳ<br><b>निष्पत्तिः - </b>आ + गुरी (उद्यमने) - "क्तः" (३-४-७२)<br><br>

आग्नापौष्ण
आग्नापौष्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ ಮತ್ತು ಪೂಷ ದೇವತೆಗಳಿಗೆ ಸಂಬಂಧಿಸಿದ ಹವಿಸ್ಸು<br><b>निष्पत्तिः - </b>"अण्" (४-२-२४)<br><b>व्युत्पत्तिः - </b>अग्निश्च पूषा च अग्नापूषणौ । ते देवते अस्य<br><br>

आग्नावैष्णव
आग्नावैष्णव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ ಮತ್ತು ವಿಷ್ಣು ದೇವತೆಗಳಿಗೆ ಸಂಬಂಧಿಸಿದ ಹವಿಸ್ಸು<br><b>निष्पत्तिः - </b>"अण्" (४-२-२४)<br><b>व्युत्पत्तिः - </b>अग्निश्च विष्णुश्च अग्नाविष्णू, ते देवतेऽस्य<br><br>

आग्निपद
आग्निपद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಸನ್ನಿಧಿಯಲ್ಲಿ ಮಾಡುವ ಕಾರ್ಯ<br><br>आग्निपद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಸನ್ನಿಧಿಯಲ್ಲಿ ಕೊಡುವ ಪದಾರ್ಥ<br><b>निष्पत्तिः - </b>"अण्" (वा० ५-१-९७)<br><b>व्युत्पत्तिः - </b>अग्निपदे कार्यं दीयते वा<br><br>

आग्निमारुत
आग्निमारुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ ಮತ್ತು ಮರುತ್ತುಗಳಿಗೆ ಸಂಬಂಧಿಸಿದ ಹವಿಸ್ಸು<br><b>निष्पत्तिः - </b>"अण्" (४-२-२४)<br><b>व्युत्पत्तिः - </b>अग्निश्च मरुतश्च अग्नामरुतौ । ते देवतेऽस्य<br><br>

आग्निवारुण
आग्निवारुण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ ಮತ್ತು ವರುಣ ದೇವತೆಗಳಿಗೆ ಸಂಬಂಧಿಸಿದ ಹವಿಸ್ಸು<br><b>निष्पत्तिः - </b>"अण्" (४-२-२४) । "इत्" (६-३-२८)<br><b>व्युत्पत्तिः - </b>अग्निश्च वरुणश्च अग्वीवरुणौ । ते देवतेऽस्य<br><br>

आग्निष्टोमिक
आग्निष्टोमिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಷ್ಟೋಮಯಾಗವನ್ನು ತಿಳಿದವನು<br><br>आग्निष्टोमिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಷ್ಟೋಮಯಾಗದ ವಿಷಯವನ್ನು ತಿಳಿಸುವ ಗ್ರಂಥದ ಅಧ್ಯಯನ ಮಾಡುವ<br><b>निष्पत्तिः - </b>"ठक्" (४-२-६०)<br><b>व्युत्पत्तिः - </b>अग्निष्टोमं वेत्ति तत्प्रतिपादकं ग्रन्थमधीते वा<br><br>आग्निष्टोमिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಷ್ಟೋಮಯಾಗಕ್ಕೆ ಸಂಬಂಧಿಸಿದ<br><br>

आग्निष्टोमिकी
आग्निष्टोमिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಷ್ಟೋಮ ಯಾಗದ ದಕ್ಷಿಣೆ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-९५) । "ङीप्" (४-१-५)<br><b>व्युत्पत्तिः - </b>अग्निष्टोमस्य दक्षिणा<br><br>

आग्नीध्र
आग्नीध्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಋತ್ವಿಕ್ಕು /ಯಾಜಕ<br><b>व्युत्पत्तिः - </b>अग्निमिन्धयति अग्नीत् । तस्य स्थानमाग्नीध्रम् । तात्स्थ्यात् सोऽप्याग्नीध्रः ।<br><br>आग्नीध्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಗ್ನೀಧ್ರನೆಂಬ ಋತ್ವಿಕ್ಕಿನ ಸ್ಥಾನ<br><b>निष्पत्तिः - </b>"रण्" (वा० ४-३-१२०)<br><b>व्युत्पत्तिः - </b>अग्निमिन्धयति इति अग्नीत् । तस्य स्थानम्<br><br>आग्नीध्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಗ್ನೀಧ್ರನ ಕರ್ಮ<br><b>निष्पत्तिः - </b>"अण्"<br><b>व्युत्पत्तिः - </b>आग्नीध्रस्य कर्म भावो वा<br><br>

आग्नीध्र्या
आग्नीध्र्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಶಾಲೆ /ಅಗ್ನಿಗೆ ಯೋಗ್ಯವಾದ ಸ್ಥಾನ<br><b>निष्पत्तिः - </b>"यत्"<br><b>व्युत्पत्तिः - </b>आग्नीध्रस्थानमर्हति<br><br>

आग्नेन्द्र
आग्नेन्द्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ ಮತ್ತು ಇಂದ್ರ ದೇವತೆಗಳಿಗೆ ಸಂಬಂಧಿಸಿದ ಹವಿಸ್ಸು<br><b>निष्पत्तिः - </b>"अण्" (४-२-२४)<br><b>व्युत्पत्तिः - </b>अग्निश्च इन्द्रस्य अग्नेन्द्रौ । तौ देवतेऽस्य<br><br>

आग्नेय
आग्नेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ತೀಕೇಯ /ಷಣ್ಮುಖ<br><b>व्युत्पत्तिः - </b>अग्नेरपत्यम्<br><br>आग्नेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸ್ತ್ಯಮಹರ್ಷಿಯ<br><br>आग्नेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣಾಪಥದಲ್ಲಿ ಕಿಷ್ಕಿಂಧಾಪಟ್ಟಣಕ್ಕೆ ಸಮೀಪದಲ್ಲಿರುವ ಒಂದು ದೇಶ<br><br>आग्नेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಪರ್ವತ<br><br>आग्नेय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿನ್ನ /ಸುವರ್ಣ<br><br>आग्नेय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತ್ತಿಕಾ ನಕ್ಷತ್ರ<br><br>आग्नेय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ತ<br><br>आग्नेय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಉಪಾಸನೆಯ ಮಂತ್ರ<br><br>आग्नेय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರಗು<br><br>आग्नेय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಘೃತ /ತುಪ್ಪ<br><br>आग्नेय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಸ್ನಾನ<br><b>प्रयोगाः - </b>"आग्नेयं भस्मना स्नानम्"<br><br>आग्नेय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿದೇವತಾಕವಾದ ಒಂದು ಅಸ್ತ್ರ<br><br>आग्नेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಸಂಬಂಧವಾದ<br><br>आग्नेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯನ್ನು ಅಭಿವೃದ್ಧಿಪಡಿಸುವ<br><br>आग्नेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಾಠರಾಗ್ನಿಯನ್ನುಂಟುಮಾಡುವ<br><br>आग्नेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿದೇವತಾಕವಾದ ಹವಿಸ್ಸು ಮೊದಲಾದುದು<br><br>आग्नेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಭಕ್ತ /ಅಗ್ನಿಯ ಉಪಾಸಕ<br><b>निष्पत्तिः - </b>"ढक्" (वा० ४-२-२४)<br><b>व्युत्पत्तिः - </b>अग्नेर्भक्तः<br><br>

आग्नेयी
आग्नेयी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಾಹಾದೇವಿ /ಅಗ್ನಿಯ ಪತ್ನಿ<br><br>आग्नेयी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಗ್ನೇಯ ದಿಕ್ಕು /ಪೂರ್ವ ಮತ್ತು ದಕ್ಷಿಣ ದಿಕ್ಕುಗಳ ಮಧ್ಯಭಾಗ<br><br>आग्नेयी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಪತ್ ತಿಥಿ /ಪಕ್ಷದ ಮೊದಲನೆಯ ತಿಥಿ<br><br>

आग्न्याधानिकी
आग्न्याधानिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಗ್ನ್ಯಾಧಾನ / ಯಜ್ಞ ದಕ್ಷಿಣೆ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-९५) । "ङीप्" (४-१-५)<br><b>व्युत्पत्तिः - </b>अग्न्याधानस्य यज्ञस्य दक्षिणा<br><br>

आग्रभोजनिक
आग्रभोजनिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ರಭೋಜನಕ್ಕೆ ಯೋಗ್ಯನಾದ ಬ್ರಾಹ್ಮಣ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-६३)<br><b>व्युत्पत्तिः - </b>अग्रभोजनमर्हति<br><br>आग्रभोजनिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಥಮಭೋಜನಕ್ಕೆ ಕುಳ್ಳಿರಿಸಲ್ಪಡುವ ಬ್ರಾಹ್ಮಣ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-६६)<br><b>व्युत्पत्तिः - </b>अग्रभोजनं नियतं दीयतेऽस्मै<br><br>

आग्रयण
आग्रयण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಸ ಧಾನ್ಯವು ಬಂದಾಗ ದೇವತೆಗಳ ಪ್ರೀತ್ಯರ್ಥವಾಗಿ ಅದರಿಂದ ಮಾಡುವ ಯಜ್ಞ<br><b>निष्पत्तिः - </b>पृषो० ।<br><b>व्युत्पत्तिः - </b>अग्रस्य नवधान्यादेः अयनं देवान् प्रति प्रापणं येन कर्मणा<br><b>प्रयोगाः - </b>"शस्यं नाश्नीयादनिहोत्रमहुत्वा"<br><b>उल्लेखाः - </b>आश्व० शौ० सू०<br><br>

आग्रह
आग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆವೇಶ /ಆಸಕ್ತಿ<br><b>प्रयोगाः - </b>"चलेऽपि काकस्य पदार्पणाग्रहः"<br><b>उल्लेखाः - </b>नैष० १२-२१<br><br>आग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಳ್ಳುವಿಕೆ<br><br>आग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಗ್ರಹ<br><br>आग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಣ<br><b>विस्तारः - </b>"आग्रहोऽनुग्रहासक्त्योराक्रमे ग्रहणेऽपि च" - मेदि० ।<br><br>

आग्रहायण
आग्रहायण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾರ್ಗಶೀರ್ಷ ಮಾಸ<br><b>निष्पत्तिः - </b>"अण्" (४-२-२१)<br><b>व्युत्पत्तिः - </b>अग्रे हायनमस्त्यस्याः आग्रहायणी सा पौर्णमास्यत्यत्र मासे<br><br>

आग्रहायणक
आग्रहायणक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾರ್ಗಶೀರ್ಷಮಾಸದ ಹುಣ್ಣಿಮೆಯ ದಿನ ಕೊಡಬೇಕಾದ ಸಾಲ<br><b>निष्पत्तिः - </b>"वुञ्" (४-३-५०)<br><b>व्युत्पत्तिः - </b>आग्रहायण्यां देयम् ऋणम्<br><br>

आग्रहायणिक
आग्रहायणिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾರ್ಗಶೀರ್ಷ ಮಾಸ<br><b>निष्पत्तिः - </b>"ठक्" (४-२-२२)<br><b>व्युत्पत्तिः - </b>आग्रहायणी पौर्णमास्यस्मिन् मासे<br><br>आग्रहायणिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾರ್ಗಶೀರ್ಷಮಾಸದ ಹುಣ್ಣಿಮೆಯ ದಿನ ಕೊಡಬೇಕಾದ ಸಾಲ<br><br>

आग्रहायणी
आग्रहायणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾರ್ಗಶೀರ್ಷ ಮಾಸದ ಹುಣ್ಣಿಮೆ<br><b>निष्पत्तिः - </b>"अण्" (५-४-३८) । "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>अग्रे हायनमस्याः<br><br>

आग्रहारिक
आग्रहारिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-६६)<br><b>व्युत्पत्तिः - </b>अग्रहारो नियतं दीयतेऽस्मै<br><br>

आघट्टक
आघट्टक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಪು ಉತ್ತರೇಣಿ ಗಿಡ<br><b>निष्पत्तिः - </b>घट्ट (चलने) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>आघट्टयति रोगान्<br><br>

आघट्टन
आघट्टन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಡೆತ /ತಿಕ್ಕಾಟ<br><b>निष्पत्तिः - </b>आ + घट्ट (चलने) - भावे "ल्युट्" (३-३-११५)<br><br>

आघट्टना
आघट्टना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಡೆತ /ತಿಕ್ಕಾಟ<br><b>निष्पत्तिः - </b>आ + घट्ट (चलने) + णिच् - "युच्" (३-३-१०७)<br><b>प्रयोगाः - </b>"रणद्भिराघट्टनया नभस्वतः पृथग्विभिन्नश्रुतिमण्डलैः"<br><b>उल्लेखाः - </b>माघ० १२-६४<br><br>

आघर्ष
आघर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಜ್ಜುವಿಕೆ /ತಿಕ್ಕಾಟ<br><b>निष्पत्तिः - </b>आ + घृषु (सङ्घर्षे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"गण्डस्थलाघर्षगलन्मदोदकद्रवद्रुमस्कन्धनिलायिनोऽलयः"<br><b>उल्लेखाः - </b>माघ० १२-६४<br><br>

आघर्षण
आघर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಜ್ಜುವಿಕೆ /ತಿಕ್ಕಾಟ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

आघर्षणी
आघर्षणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೂರ್ಚ /ಕುಂಚ<br><br>आघर्षणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಜ್ಜುವ ವಸ್ತು<br><b>निष्पत्तिः - </b>आ + घृषु (सङ्घर्षे) - "ल्युट्" (३-३-११७) । "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>आघृष्यतेऽनेन<br><br>

आघाट
आघाट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರೇಣಿ ಗಿಡ<br><br>आघाट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಡಿ /ಎಲ್ಲೆ<br><br>आघाट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈತಾಳ /ಝಲ್ಲರಿ<br><br>आघाट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಡೆಯುವ<br><b>निष्पत्तिः - </b>आ + घट (चेष्टायाम्) - "घञ्" (३-३-१९)<br><br>

आघात
आघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಡೆತ /ಬಡಿತ<br><br>आघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಧೆ /ಕೊಲೆ<br><br>आघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಯ<br><b>निष्पत्तिः - </b>आ + हन (हिंसागत्योः) - "घञ्" (३-३-१८)<br><br>आघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಧ್ಯಸ್ಥಾನ /ಕೊಲೆ ಮಾಡುವ ಜಾಗ<br><b>निष्पत्तिः - </b>आ + हन (हिंसागत्योः) - अधि० "घञ्" (३-३-१२१)<br><br>

आघातन
आघातन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಧ್ಯಸ್ಥಾನ /ಕೊಲೆ ಮಾಡುವ ಜಾಗ<br><b>निष्पत्तिः - </b>आ + हन (हिंसागत्योः) + णिच् - "ल्युट्" (३-३-११७)<br><br>आघातन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಲೆ /ವಧೆ<br><br>

आघार
आघार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಘೃತ /ತುಪ್ಪ<br><b>निष्पत्तिः - </b>आ + घृ (सेचने) + णिच् - कर्म० "घञ्" (३-३-१९)<br><br>आघार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಘೃತಸೇಚನೆ /ಅಗ್ನಿಗೆ ವಾಯವ್ಯದಿಂದ ಆಗ್ನೇಯ ಸಿಕ್ಕಿನವರೆಗೂ ನಿರೃತಿ ದಿಕ್ಕಿನಿಂದ ಈಶಾನ್ಯದವರೆಗೂ ಅವಿಚ್ಛಿನ್ನವಾಗಿ ಮಾಡುವ ತುಪ್ಪದ ಹೋಮ<br><br>

आघूर्णन
आघूर्णन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುತ್ತುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + घूर्ण (भ्रमणे) - "ल्युट्" (३-३-११५)<br><br>

आघूर्णित
आघूर्णित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುತ್ತಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + घूर्ण (भ्रमणे) - "क्तः" (३-२-१०२)<br><br>

आघोषण
आघोषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಲ್ಲಾ ಕಡೆಯಲ್ಲೂ ಪ್ರಚಾರವಾಗಲು ಗಟ್ಟಿಯಾಗಿ ಹೇಳುವುದು<br><b>निष्पत्तिः - </b>आ + घुषिर् (विशब्दने) - "ल्युट्" (३-३-११५)<br><br>

आघोषणा
आघोषणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಲ್ಲಾ ಕಡೆಯಲ್ಲೂ ಪ್ರಚಾರವಾಗಲು ಗಟ್ಟಿಯಾಗಿ ಹೇಳುವುದು<br><b>निष्पत्तिः - </b>आ + घुषिर् (विशब्दने) + णिच् - "युच्" (३-३-१०७)<br><br>

आघ्राण
आघ्राण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸನೆ ನೋಡುವುದು<br><br>आघ्राण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂತೋಷ /ತೃಪ್ತಿ<br><b>निष्पत्तिः - </b>आ + घ्रा (गन्धोपादाने) - "ल्युट्" (३-३-११५)<br><b>विस्तारः - </b>"तृप्तिः सौहित्यमाघ्राणम्" - अभि० चि० ।<br><br>आघ्राण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಸನೆ ನೋಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + घ्रा (गन्धोपादाने) - कर्म० "क्तः" (३-२-१०२)<br><br>आघ्राण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೃಪ್ತಿ ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>कर्त० "क्तः" (३-४-७२)<br><br>

आघ्रात
आघ्रात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಸನೆ ನೋಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + घ्रा (गन्धोपादाने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आघ्रातवर्त्न्मानमरण्यभागेष्वारण्यकैराश्रितधेनुभावैः"<br><b>उल्लेखाः - </b>याद० ४-८१<br><br>

आघ्रापित
आघ्रापित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಸನೆ ನೋಡಲ್ಪಟ್ಟ<br><br>आघ्रापित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೃಪ್ತಿ ಪಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + घ्रा (गन्धोपादाने) + णिच् - "क्तः" (३-२-१०२)<br><br>

आघ्रायक
आघ्रायक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಸನೆ ನೋಡುವವನು<br><br>आघ्रायक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೃಪ್ತಿ ಪಡಿಸುವವನು<br><b>निष्पत्तिः - </b>आ + घ्रा (गन्धोपादाने) - "ण्वुल्" (३-१-१३३)<br><br>

आघ्रायिका
आघ्रायिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आघ्रायक ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><br>

आघ्रेय
आघ्रेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಸನೆ ನೋಡಲು ಅರ್ಹವಾದ<br><br>आघ्रेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಸನೆ ನೋಡಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + घ्रा (गन्धोपादाने) - "यत्" (३-१-९७)<br><br>

आङ्
आङ्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ<br><br>आङ्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲೆ /ಗಡಿ<br><b>प्रयोगाः - </b>"आसमुद्रक्षितीशानाम्"<br><b>उल्लेखाः - </b>रघु० १-५<br><br>आङ्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಭಿವಿಧಿ<br><b>प्रयोगाः - </b>"सोऽहमाजन्मशुद्धानाम्"<br><b>उल्लेखाः - </b>रघु० १-५<br><br>आङ्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಧಾತುವಿನೊಡನೆ ಸೇರಿದಾಗ ಕ್ರಿಯಾವಿಶೇಷವನ್ನು ಸೂಚಿಸುವ ಉಪಸರ್ಗ<br><b>प्रयोगाः - </b>"तेनोपमीयेत तमालनीलमामुक्तमुक्तालतस्य वक्षः"<br><b>उल्लेखाः - </b>माघ० ३-८<br><b>विस्तारः - </b>"आङीषदर्थेऽभिव्याप्तौ सीमार्थे धातुयोगजे" - अम० ।<br><br>

आङ्कुशिक
आङ्कुशिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಕುಶವೇ ಆಯುಧವಾಗಿ ಉಳ್ಳವನು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-५७)<br><b>व्युत्पत्तिः - </b>अङ्कुशः प्रहरणमस्य<br><br>

आङ्ग
आङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗದೇಶದ ದೊರೆ<br><b>व्युत्पत्तिः - </b>अङ्गानां राजा<br><br>आङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗರಾಜನ ಮಗ<br><br>आङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಮಲವಾದ ಶರೀರ<br><b>निष्पत्तिः - </b>अङ्ग - स्वार्थे "अण्" (५-४-३८)<br><br>आङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣಶಾಸ್ತ್ರದಲ್ಲಿ ಅಂಗಧಿಕಾರದಲ್ಲಿ ಉಕ್ತವಾದ ಕಾರ್ಯ<br><b>प्रयोगाः - </b>"वार्णादाङ्गं बलीयः"<br><b>उल्लेखाः - </b>परि० ५६<br><br>आङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಾರೀರಕ /ಶರೀರಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>अङ्गस्येदम्<br><br>आङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗದೇಶದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>"अण्"<br><b>व्युत्पत्तिः - </b>अङ्गेषु भवः<br><br>

आङ्गक
आङ्गक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗರಾಜನ ಸೇವಕ<br><br>आङ्गक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗದೇಶದ ಸೇವಕ<br><b>निष्पत्तिः - </b>"वुञ्" (४-३-१००)<br><b>व्युत्पत्तिः - </b>अङ्गः क्षत्रियाः जनपदो वा भक्तिरस्य<br><br>आङ्गक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗದೇಶದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>"वुञ्" (४-२-१२५)<br><b>व्युत्पत्तिः - </b>अङ्गेषु भवः<br><br>

आङ्गविद्य
आङ्गविद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಕ್ಷೆ ವ್ಯಾಕರಣ ಮೊದಲಾದ ಅಂಗವಿದ್ಯೆಯನ್ನು ತಿಳಿದಿರುವ<br><br>आङ्गविद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂದಸಾಮುದ್ರಿಕವನ್ನು ತಿಳಿದಿರುವ<br><b>निष्पत्तिः - </b>"अण्" (४-२-५९)<br><b>व्युत्पत्तिः - </b>अङ्गविद्यां वेत्ति<br><br>आङ्गविद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗವಿದ್ಯೆಯ ವ್ಯಾಖ್ಯಾನ ಗ್ರಂಥ<br><b>निष्पत्तिः - </b>"अण्" (४-३-६६)<br><b>व्युत्पत्तिः - </b>अङ्गविद्याया व्याख्यानो ग्रन्थः<br><br>आङ्गविद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗವಿದ್ಯೆಯಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"अण्" (६-३-६६)<br><b>व्युत्पत्तिः - </b>अङ्गविद्यायां भवः<br><br>

आङ्गविद्या
आङ्गविद्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣ ಮೊದಲಾದ ಅಂಗವಿದ್ಯೆ<br><br>आङ्गविद्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಮುದ್ರಿಕಶಾಸ್ತ್ರ<br><b>व्युत्पत्तिः - </b>आङ्गी च सा विद्या च<br><br>

आङ्गार
आङ्गार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಡದ ರಾಶಿ<br><b>निष्पत्तिः - </b>"अण्" (४-२-३८)<br><b>व्युत्पत्तिः - </b>अङ्गाराणां समूहः<br><br>

आङ्गिक
आङ्गिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಾವಸೂಚಕವಾದ ಅಂಗಗಳ ಅಭಿನಯ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-२९)<br><b>व्युत्पत्तिः - </b>अङ्गेन अङ्गचापलेन निर्वृत्तम्<br><b>प्रयोगाः - </b>"भवेदभिनयोऽवस्थानुकारः स चतुर्विधः । आङ्गिको वाचिकश्चैचमाहार्यः सात्त्विकस्तथा ॥"<br><b>उल्लेखाः - </b>सा० द० ६-२<br><br>

आङ्गिरस
आङ्गिरस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗಿರಸ್ಸಿನ ಮಗ ಬೃಹಸ್ಪತಿ, ಉತಥ್ಯ, ಸಂವರ್ತ<br><b>निष्पत्तिः - </b>"अण्" (४-१-९२)<br><b>व्युत्पत्तिः - </b>अङ्गिरसोऽपत्यम्<br><b>प्रयोगाः - </b>"त्रयस्त्वङ्गिरसः पुत्रा लोके सर्वत्र विश्रुताः । बृहस्पतिरुतथ्यश्च संवर्तश्च धृतव्रताः ॥" "अध्यापयामास पितॄन् शिशुराङ्ङिरसः कविः । पुत्रका इतिहोवाच ज्ञानेन परिगृह्य तान् ॥"<br><b>उल्लेखाः - </b>भा० आदि० ६७-५। मनु० २-१५१<br><br>आङ्गिरस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಥರ್ವವೇದದ ಒಂದು ಸೂಕ್ತ<br><b>निष्पत्तिः - </b>"अण्" (४-२-७)<br><b>व्युत्पत्तिः - </b>अङ्गिरसा दृष्टम्<br><br>

आङ्गिरस
आङ्गिरस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೀವಾತ್ಮ<br><br>

आचक्षाण
आचक्षाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಥೆಯನ್ನು ಹೇಳುವ<br><b>निष्पत्तिः - </b>आ + चक्षिङ् (व्यक्तायं वाचि) - "शानच्" (३-२-१२४)<br><b>व्युत्पत्तिः - </b>आचक्षते<br><br>

आचक्षुस्
आचक्षुस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿದವನು /ಪೂರ್ವಕಥೆ ಬಲ್ಲವನು<br><b>निष्पत्तिः - </b>आ + चक्षिङ् (व्यक्तायं वाचि) - "उसिः" (उ० २-१२०)<br><br>

आचतुर
आचतुर<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಾಲ್ಕರವರೆಗೂ /ನಾಲ್ಕು ತಲೆಯ ಪರ್ಯಂತ<br><b>निष्पत्तिः - </b>आ + चतुर् - "टच्" (५-४-१०७)<br><b>व्युत्पत्तिः - </b>चतुःपर्यन्तम्<br><br>

आचतुर्य
आचतुर्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಪುಣನಾಗಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अचतुरस्य भावः<br><br>

आचमन
आचमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲಪಾನ /ಶುದ್ಧಿಗಾಗಿ ಮಾಡುವ ಮಂತ್ರಪೂರ್ವಕ ಜಲಪಾನ<br><b>निष्पत्तिः - </b>आ + चमु (अदने) - "ल्युट्" (३-३-११५)<br><br>आचमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಚಮನದ ನೀರು<br><b>निष्पत्तिः - </b>कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>आचम्यतेऽनेन<br><br>

आचमनक
आचमनक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಚಮನದ ನೀರು<br><b>निष्पत्तिः - </b>कर० "ल्युट्" (३-३-११७) । ततः स्वार्थे "कन्"<br><b>व्युत्पत्तिः - </b>आचम्यतेऽनेन<br><br>आचमनक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಯಿನೀರನ್ನು ಉಗುಳುವ ಪಾತ್ರೆ<br><br>

आचमनीय
आचमनीय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಚಮನದ ನೀರು<br><b>निष्पत्तिः - </b>"छः" (५-१-५)<br><b>व्युत्पत्तिः - </b>आचमनाय हितम्<br><br>

आचय
आचय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೂಡಿಸಿಡುವುದು /ಶೇಖರಿಸಿಡುವುದು<br><b>निष्पत्तिः - </b>आ + चिञ् (चयने) - "अच्" (३-३-५६)<br><br>

आचरण
आचरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತಿ /ಮಾಡುವಿಕೆ<br><br>आचरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಡತೆ<br><b>निष्पत्तिः - </b>आ + चर (गतौ) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"अधीतिबोधाचरणप्रचारणैः दशाश्चतस्रः प्रणयन्नुपाधिभिः"<br><b>उल्लेखाः - </b>नैष० १-४<br><br>आचरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪ್ರದಾಯ /ವಾಡಿಕೆ<br><br>आचरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಥ /ಗಾಡಿ<br><b>निष्पत्तिः - </b>कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>आचरत्यनेन<br><br>

आचरणीय
आचरणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಚರಿಸಲು ಯೋಗ್ಯವಾದ<br><br>आचरणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಶ್ಯವಾಗಿ ಮಾಡಬೇಕಾದ<br><b>निष्पत्तिः - </b>आ + चर (गतौ) - "अनीयर्" (३-१-९६)<br><br>

आचरित
आचरित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಡತೆ /ನಡವಳಿಕೆ<br><b>निष्पत्तिः - </b>आ + चर (गतौ) - भावे "क्तः" (३-३-११४)<br><br>आचरित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಟ್ಟ ಸಾಲವನ್ನು ಹಿಂದಕ್ಕೆ ಪಡೆಯುವ ೫ ಉಪಾಯಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"धर्मेण व्यवहारेण छलेनाचरितेन च । प्रयुक्तं साधयेदर्थं पञ्चमेन बलेन च ॥"<br><b>उल्लेखाः - </b>मनु० ८-४९<br><br>आचरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + चर (गतौ) - कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"शुभस्य पूर्वाचरितैः कृतं शुभैः"<br><b>उल्लेखाः - </b>माघ० १-२६<br><br>

आचरितव्य
आचरितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಶ್ಯವಾಗಿ ಮಾಡಬೇಕಾದ<br><br>आचरितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಚರಿಸಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>आ + चर (गतौ) - "तव्यः" (३-१-९६)<br><br>

आचर्य
आचर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಚರಣೆಗೆ ಯೋಗ್ಯವಾದ ದೇಶ<br><b>निष्पत्तिः - </b>आ + चर (गतौ) - "यत्" (वा० ३-१-१००)<br><br>

आचान्त
आचान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಚಮನ ಮಾಡಿದವನು<br><b>निष्पत्तिः - </b>आ + चमु (अदने) - "क्तः" (३-४-७२)<br><br>

आचाम
आचाम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಚಮನ<br><b>निष्पत्तिः - </b>आ + चमु (अदने) - "घञ्" (३-३-१८)<br><br>आचाम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನದ ಮೇಲಿನ ಕೆನೆ<br><br>आचाम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಕ್ಷ್ಯ /ತಿಂಡಿ<br><b>निष्पत्तिः - </b>आ + चमु (अदने) - कर्म० "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>आचम्यते<br><br>

आचार
आचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಚರಣೆ /ಅನುಷ್ಠಾನ<br><b>निष्पत्तिः - </b>आ + चर (गतौ) - "घञ्" (३-३-१८)<br><br>आचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಳ್ಳೆಯ ನಡತೆ<br><b>प्रयोगाः - </b>"आचारमागन्तुकदम्पतीनाम्"<br><b>उल्लेखाः - </b>याद० १३-८९<br><br>आचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪ್ರದಾಯ /ವಾಡಿಕೆ<br><b>प्रयोगाः - </b>"आचारलाजैरिव पौरकन्याः"<br><b>उल्लेखाः - </b>रघु० २-१०<br><br>आचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಮ /ರಿತಿ<br><br>आचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಧಿ /ಕಟ್ಟಳೆ<br><b>प्रयोगाः - </b>"आचार इत्यवहितेन मया गृहीता या वेत्रयष्टिरवरोधगृहेषु राज्ञः"<br><b>उल्लेखाः - </b>शाकु० ५-३<br><br>

आचारदीप
आचारदीप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆರತಿ ಎತ್ತುವ ದೀಪ<br><b>व्युत्पत्तिः - </b>आचारार्थो दीपः<br><br>

आचारवत्
आचारवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸದಾಚಾರವುಳ್ಳ /ಒಳ್ಳೆಯ ನಡತೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>प्रशस्त आचारोऽस्त्यस्य<br><br>

आचारवती
आचारवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸದಾಚಾರವುಳ್ಳ /ಒಳ್ಳೆಯ ನಡತೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

आचारपूत
आचारपूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸದಾಚಾರದಿಂದ ಪವಿತ್ರನಾದ<br><b>व्युत्पत्तिः - </b>आचारेण पूतः<br><b>प्रयोगाः - </b>"तमातपक्लान्तमनातपत्रमाचारपूतं पवनः सिषेवे"<br><b>उल्लेखाः - </b>रघु० २-१३<br><br>

आचारलाज
आचारलाज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪ್ರದಾಯದಂತೆ ರಾಜನ ಅಥವಾ ಇತರ ಮಹಾಪುರುಷರ ಮೇಲೆ ಗೌರವದಿಂದ ಶುಭವನ್ನು ಕೋರಿ ಎರಚುವ ಅರಳು<br><b>प्रयोगाः - </b>"अवाकिरन् बाललताः प्रसूनैराचारलाजैरिव पौरकन्याः"<br><b>उल्लेखाः - </b>रघु० २-२०<br><br>

आचारवेत्तृ
आचारवेत्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಪ್ರದಾಯವನ್ನು ತಿಳಿದಿರುವ /ಪದ್ಧತಿಯನ್ನು ಅರಿತಿರುವ<br><b>निष्पत्तिः - </b>विद (ज्ञाने) - "तृच्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>आचारं वेत्ति<br><br>

आचारवेत्त्री
आचारवेत्त्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪ್ರದಾಯವನ್ನು ತಿಳಿದಿರುವ /ಪದ್ಧತಿಯನ್ನು ಅರಿತಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आचारवेदिन्
आचारवेदिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಪ್ರದಾಯವನ್ನು ತಿಳಿದಿರುವ /ಪದ್ಧತಿಯನ್ನು ಅರಿತಿರುವ<br><b>निष्पत्तिः - </b>विद (ज्ञाने) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>आचारं वेत्ति<br><br>

आचारवेदिनी
आचारवेदिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪ್ರದಾಯವನ್ನು ತಿಳಿದಿರುವ /ಪದ್ಧತಿಯನ್ನು ಅರಿತಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आचारिन्
आचारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸದಾಚಾರಸಂಪನ್ನ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>आचारोऽस्यास्ति<br><br>

आचारिणी
आचारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸದಾಚಾರಸಂಪನ್ನ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आचार्य
आचार्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಾಧ್ಯಾಯ<br><b>निष्पत्तिः - </b>आ + चर (गतौ) - "ण्यत्" (३-१-१२४)<br><br>आचार्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪನಯನ ಮಾಡಿ ಸಾಂಗವೇದಾಧ್ಯಯನ ಮಾಡಿಸುವ ಗುರು /ಮಂತ್ರೋಪದೆಶ ಮಾಡುವ ಗುರು<br><b>प्रयोगाः - </b>"अन्वेष्यन् दित्सितदक्षिणोऽहमाचार्यसान्दीपिनिसूनुवृत्तम्"<br><b>उल्लेखाः - </b>याद० १८-१०९<br><b>विस्तारः - </b>"उपनीय तु यः शिष्यं वेदमध्यापयेत् द्विजः । साङ्गं च सारहस्यं च तमाचार्यं प्रचक्षते ॥"<br><br>आचार्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರಾರ್ಥಗಳನ್ನು ವಿವರಿಸಿ ತಾನೂ ಶಾಸ್ತ್ರಕ್ಕನುಗುಣವಾಗಿ ನಡೆದುಕೊಂಡು ಜನರಿಗೆ ಮಾರ್ಗದರ್ಶಿಯಾಗಿರುವ ಮತಪ್ರವರ್ತಕ<br><b>विस्तारः - </b>"आचिनोति हि शास्त्रार्थं आचारे स्थापयत्यपि । स्वयमाचरते यस्मात् तस्मादाचार्य उच्यते ॥"<br><br>आचार्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞದಲ್ಲಿ ಕರ್ಮೋಪದೇಶ ಮಾಡುವವನು<br><br>आचार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜ್ಯ<br><br>

आचार्यक
आचार्यक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುರುತ್ವ /ಗುರುವಿನ ಕಾರ್ಯ /ಶಿಕ್ಷಣ<br><br>आचार्यक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಕ್ಷಣದ ನೈಪುಣ್ಯ<br><b>निष्पत्तिः - </b>"वुञ्" (५-१-१३२)<br><b>व्युत्पत्तिः - </b>आचार्यस्य कर्म भावो वा<br><b>प्रयोगाः - </b>"तद्भूरिसत्त्विकविकारमपास्तधैर्यमाचार्यकं विजयि मान्मथमाविरासीत्"<br><b>उल्लेखाः - </b>मालती० १-२९<br><br>

आचार्यभोगीन
आचार्यभोगीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುರುವಿನ ಸೌಖ್ಯಕ್ಕಾಗಿ ಕೊಡುವ ಧನ /ಆಚಾರ್ಯನ ಜೀವನಕ್ಕೆ ಹಿತವಾದ ಧನ<br><b>निष्पत्तिः - </b>"खः" (५-१-९)<br><b>व्युत्पत्तिः - </b>आचार्यभोगाय हितम्<br><br>

आचार्यमिश्र
आचार्यमिश्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜ್ಯನಾದ<br><br>

आचार्या
आचार्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂತ್ರವ್ಯಾಖ್ಯಾನ ಮಾಡುವವಳು /ವಿದ್ಯೆ ಕಲಿಸುವವಳು<br><b>निष्पत्तिः - </b>आ + चर (गतौ) - "ण्यत्" (३-१-१२४)<br><br>

आचार्यानी
आचार्यानी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಚಾರ್ಯನ ಪತ್ನಿ /ಗುರುಪತ್ನಿ<br><b>निष्पत्तिः - </b>"आनुक्" ङीष्" च (४-१-४९)<br><b>व्युत्पत्तिः - </b>आचार्यस्य स्त्री<br><b>प्रयोगाः - </b>"शत्रुमूलमनुत्खाय न पुनर्द्रष्टुमुत्सहे । त्र्यम्बकं देवमाचार्यमाचार्यानीं च पार्वतीम् ॥"<br><b>उल्लेखाः - </b>म० वी० ३-६<br><br>

आचिख्यासा
आचिख्यासा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಳಲು ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>आ + ख्या (प्रकथने) + सन् - "अः" (३-३-१०३)<br><b>व्युत्पत्तिः - </b>आख्यातुमिच्छा<br><br>

आचिख्यासु
आचिख्यासु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲು ಅಪೇಕ್ಷಿಸುವ<br><b>निष्पत्तिः - </b>आ + ख्या (प्रकथने) + सन् - "उः" (३-२-१३८)<br><b>व्युत्पत्तिः - </b>आख्यातुमिच्छुः<br><br>

आचित
आचित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಬಂಡಿಯ ಹೊರೆ /ಒಂದು ಬಂಡಿಯಲ್ಲಿ ತುಂಬಬಹುದಾದ ಚಿನ್ನ<br><br>आचित<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತು ಭಾರಗಳ ತೂಕ /೨೦೦೦೦ ಪಲಗಳ ತೂಕ<br><b>निष्पत्तिः - </b>आ + चिञ् (चयने) - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>आचूयते<br><b>विस्तारः - </b>"आचितो दश भाराः स्युः शाकटो भार आचितः" - अम० ।<br><br>आचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"वनान्तशय्यकठिनीकृताकृती कचाचितौ विष्वगिवागजौ गजौ"<br><b>उल्लेखाः - </b>किरा० १-३६<br><br>आचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಟ್ಟಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अर्धाचिता सत्वरमुत्थितायाः"<br><b>उल्लेखाः - </b>कुमा० ७-६१<br><br>आचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತುಂಬಿರುವ<br><br>आचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಲ್ಪಟ್ಟ<br><br>आचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಟ್ಟುಗೂಡಿಸಲ್ಪಟ್ಟ<br><br>आचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಗ್ರಹಿಸಲ್ಪಟ್ಟ<br><br>

आचितिक
आचितिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಆಚಿತ ತೂಕದಷ್ಟು ಹಿಡಿಸುವ<br><br>आचितिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಆಚಿತಕ್ಕೆ ಸಮವಾದ<br><br>आचितिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಆಚಿತದಷ್ಟು ಬೇಯಿಸುವ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-५३)<br><b>व्युत्पत्तिः - </b>आचितं सम्भवति अवहरति पचति वा<br><br>

आचितिकी
आचितिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आचितिक ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

आचितीन
आचितीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>आचितिक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"खः" (५-१-५३)<br><b>व्युत्पत्तिः - </b>आचितं सम्भवत्यवहरति पचति वा<br><br>

आचितीना
आचितीना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आचितिक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्" (४-१-४)<br><br>

आचूषण
आचूषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಯಿಂದ ಹೀರುವುದು<br><b>निष्पत्तिः - </b>आ + चूष (पाने) - "ल्युट्" (३-३-११५)<br><br>आचूषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ ಮೊದಲಾದುವನ್ನು ದೇಹದಿಂದ ಹೊರಕ್ಕೆ ತೆಗೆಯಲು ಮಾಡುವ ಯಂತ್ರವ್ಯಾಪಾರ<br><br>आचूषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹದಿಂದ ವಿಷ ಮುಂತಾದುವನ್ನು ಎಳೆಯುವ ಯಂತ್ರ<br><b>निष्पत्तिः - </b>कर० "ल्युट्" (३-३-११७)<br><br>

आच्छन्न
आच्छन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + छद (अपवारणे) - "क्तः" (३-२-१०२)<br><br>

आच्छाद
आच्छाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸ್ತ್ರ /ಬಟ್ಟೆ<br><b>निष्पत्तिः - </b>आ + छद (अपवारणे) + णिच् - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>आच्छाद्यतेऽनेन<br><br>आच्छाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊದಿಕೆ<br><br>

आच्छादक
आच्छादक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊದಿಸುವ<br><br>आच्छादक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚುವ /ಮರೆ ಮಾಡುವ<br><b>निष्पत्तिः - </b>आ + छद (अपवारणे) + णिच् - "ण्वुल्" (३-१-१३३)<br><br>

आच्छादन
आच्छादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಸ್ತ್ರ /ಬಟ್ಟೆ<br><b>निष्पत्तिः - </b>आ + छद (अपवारणे) + णिच् - कर० "ल्युट्" (३-३-११७)<br><b>प्रयोगाः - </b>"तस्मादेताः सदा पूज्याः भूषणाच्छादनाशनैः"<br><b>उल्लेखाः - </b>मनु० ३-५९<br><br>आच्छादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಳ<br><br>आच्छादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಚ್ಚುವಿಕೆ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

आच्छादित
आच्छादित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊದಿಸಲ್ಪಟ್ಟ<br><br>आच्छादित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + छद (अपवारणे) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आच्छादितायतदिगम्बरमुच्चकैर्गाम्"<br><b>उल्लेखाः - </b>माघ० ४-१९<br><br>

आच्छादिन्
आच्छादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚುವ /ಮರೆ ಮಾಡುವ<br><b>निष्पत्तिः - </b>आ + छद (अपवारणे) + णिच् - "णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"स्तनयुगपरिणाहाच्छादिना वल्कलेन"<br><br>आच्छादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊದಿಸುವ<br><br>

आच्छाद्य
आच्छाद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊದಿಸಲ್ಪಡುವ<br><br>आच्छाद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + छद (अपवारणे) + णिच् - "यत्" (३-१-९७)<br><br>आच्छाद्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಿ /ಮರೆ ಮಾಡಿ<br><br>आच्छाद्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೊದಿಸಿ<br><b>निष्पत्तिः - </b>आ + छद (अपवारणे) + णिच् - "ल्यप्" (७-३-३७)<br><br>

आच्छुरित
आच्छुरित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ ನಗುವಿಕೆ /ಶಬ್ದವಾಗುವಂತೆ ನಗುವುದು<br><b>निष्पत्तिः - </b>आ + छुर (छेदने) - "क्तः" (३-३-११४)<br><br>आच्छुरित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಗುರಿನಿಂದ ನುಡಿಸಬಹುದಾದ ಒಂದು ವಾದ್ಯ<br><br>आच्छुरित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಗುರಿನಿಂದ ಗೀರುವುದು<br><br>आच्छुरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಿಶ್ರವಾದ /ಬೆರೆತಿರುವ<br><br>आच्छुरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆರಳಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कर्म० "क्तः" (३-२-१०२)<br><br>आच्छुरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಗುರಿನಿಂದ ಗೀರಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"सामोन्मुखेनाच्छुरिता प्रियेण दत्तेऽथ काचित् पुलकेन भेदे"<br><b>उल्लेखाः - </b>भट्टि० ११-१४<br><br>

आच्छुरितक
आच्छुरितक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದವಾಗುವಂತೆ ಗಟ್ಟಿಯಾಗಿ ನಗುವಿಕೆ<br><br>आच्छुरितक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಗುರಿನಿಂದ ಗೀರುವಿಕೆ<br><b>निष्पत्तिः - </b>आच्छुरित - स्वार्थे "कः"<br><br>

आच्छेद
आच्छेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ಕತ್ತರಿಸುವುದು<br><br>आच्छेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಕತ್ತರಿಸುವುದು<br><b>निष्पत्तिः - </b>आ + छिदिर् (द्वैधीकरणे) - "घञ्" (३-३-१८)<br><br>आच्छेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲಾತ್ಕಾರದಿಂದ ತೆಗೆದುಕೊಳ್ಳುವುದು<br><br>

आच्छेदन
आच्छेदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>आच्छेद ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>आ + छिदिर् (द्वैधीकरणे) - "ल्युट्" (३-३-११५)<br><br>

आच्छोटन
आच्छोटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚುಟಕೆ ಹಾಕುವುದು<br><b>निष्पत्तिः - </b>आ + छुट (छेदने) - "ल्युट्" (३-३-११५)<br><br>

आच्छोटित
आच्छोटित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚುಟಕೆ ಹಾಕಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + छुट (छेदने) - "क्तः" (३-२-१०२)<br><br>

आच्छोदन
आच्छोदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಟೆ<br><b>निष्पत्तिः - </b>आ + छिदिर् (द्वैधीकरणे) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>आच्छिद्यतेऽत्र<br><br>

आज
आज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಸೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>अज (गतिक्षेपणयोः) - "घञ्" (३-३-१८)<br><br>आज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತುಪ್ಪ<br><b>निष्पत्तिः - </b>आ + अञ्जू (व्यक्त्यादौ) - "कः" (वा० ३-३-५८०<br><b>व्युत्पत्तिः - </b>आ अज्यतेऽनेन<br><br>आज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಡಿನ ತುಪ್ಪ<br><br>आज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಡಿನ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>अजस्येदम्<br><br>

आजक
आजक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಡುಗಳ ಸಮೂಹ<br><b>निष्पत्तिः - </b>"वुञ्" (४-२-३९)<br><b>व्युत्पत्तिः - </b>अजानां समूहः<br><br>

आजगव
आजगव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವನ ಧನಸ್ಸು<br><b>निष्पत्तिः - </b>अजगव - स्वार्थे "अण्" (५-४-३८)<br><br>आजगव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವಧನಸ್ಸಿನಂತೆ ದೃಢವಾದ ಮನಸ್ಸು<br><b>प्रयोगाः - </b>"तथेत्युक्त्वा पृथुर्वैन्यो गृहीत्वाऽजगवं धनुः"<br><b>उल्लेखाः - </b>भा० द्रोण० ६९-३०<br><br>

आजनन
आजनन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಸಿದ್ಧವಾದ ಜನನ<br><b>निष्पत्तिः - </b>आ + जनी (प्रादुर्भावे) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"तेषामाजननं पुण्यं कर्मणः प्रीतिमावहेत्"<br><b>उल्लेखाः - </b>भा० आदि०<br><br>आजनन<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಜನ್ಮಪರ್ಯಂತ<br><br>आजनन<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹುಟ್ಟಿದದ ಮೊದಲುಗೊಂಡು<br><b>निष्पत्तिः - </b>अव्ययी०<br><b>व्युत्पत्तिः - </b>जननमभिव्याप्य<br><br>

आजन्म
आजन्म<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹುಟ್ಟುವ ಪರ್ಯಂತ<br><br>आजन्म<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹುಟ್ಟಿದ ಮೊದಲುಗೊಂಡು<br><b>निष्पत्तिः - </b>अव्ययी०<br><b>व्युत्पत्तिः - </b>जन्माभिव्याप्य<br><b>प्रयोगाः - </b>"सोऽहमाजन्मशुद्धानामाफलोदयकर्मणाम्"<br><b>उल्लेखाः - </b>रघु० १-५<br><br>

आजन्मसुरभिपत्र
आजन्मसुरभिपत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರುಗ<br><br>

आजान
आजान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜನ್ಮ /ಉತ್ಪತ್ತಿ<br><b>निष्पत्तिः - </b>आ + जनी (प्रादुर्भावे) - "घञ्" (३-३-१८)<br><br>आजान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಭಾವ /ಪ್ರಕೃತಿ<br><b>प्रयोगाः - </b>"आजानसम्पदवलेपैवादधानैः"<br><b>उल्लेखाः - </b>याद० १८-१२८<br><br>आजान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜನನ ಸಾಧನ<br><br>आजान<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹುಟ್ಟಿದ ಮೊದಲುಗೊಂಡು<br><b>प्रयोगाः - </b>"आजानपावनक्षीरां वृषानन्दविधायिनाम्"<br><b>उल्लेखाः - </b>चं रा०<br><br>आजान<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಜನರ ಗುಂಪಿನ ಸುತ್ತಲೂ<br><b>व्युत्पत्तिः - </b>आसमन्तात् जानम्<br><br>आजान<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸ್ವಭಾವವಾಗಿ<br><br>

आजानज
आजानज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಮಾರ್ತಕರ್ಮಗಳಿಂದ ದೇವತೆಗಳಾಗಿ ಹುಟ್ಟಿದವರು<br><b>व्युत्पत्तिः - </b>आजानं जन्मारभ्य देवः<br><br>

आजानदेव
आजानदेव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿಯಿಂದಲೇ ದೇವತ್ವವನ್ನು ಹೊಂದಿದವರು<br><b>व्युत्पत्तिः - </b>आजेन क्षेपेनानेयाः<br><br>

आजानेय
आजानेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ ಕುದುರೆ<br><b>निष्पत्तिः - </b>अज (गतिक्षेपणयोः) - "इण्" (वा० ३-३-१०८)<br><b>व्युत्पत्तिः - </b>अजन्त्यस्याम्<br><br>

आजि
आजि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾರ್ಗ /ರಸ್ತೆ<br><br>आजि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಶರಥ<br><br>आजि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ /ಚತುರ್ಮುಖ<br><b>निष्पत्तिः - </b>"इञ्" (४-१-९५)<br><b>व्युत्पत्तिः - </b>अजस्य अजमहाराजस्य विष्णोर्वा अपत्यम्<br><br>आजि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕ್ಷೇಪ<br><br>आजि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಮಿಷ /ಕ್ಷಣ<br><br>आजि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ<br><b>प्रयोगाः - </b>"ते तु यावन्त एवाजौ तावांश्च ददृशे स तैः"<br><b>उल्लेखाः - </b>रघु० १२-४५<br><br>आजि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಭೂಮಿ<br><b>विस्तारः - </b>"आजिः क्षणे समक्ष्यायां युधि" - हेम० ।<br><br>

आजिगीषा
आजिगीषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಯಿಸಲು ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>आ + जि (जये) + सन्- "अः" (३-३-१०२)<br><br>

आजिगीषु
आजिगीषु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಯಿಸಲು ಅಪೇಕ್ಷೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>आ + जि (जये) + सन्- "उः" (३-२-१६८)<br><br>

आजिहीर्षा
आजिहीर्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಂಡು ಬರಲು ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>आ + हृञ् (हरणे) + सन्- "अः" (३-३-१०२)<br><b>व्युत्पत्तिः - </b>आहर्तुमिच्छा<br><br>

आजिहीर्षु
आजिहीर्षु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಂಡು ಬರಲು ಅಪೇಕ್ಷೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>आ + हृञ् (हरणे) + सन्- "उः" (३-२-१६८)<br><b>व्युत्पत्तिः - </b>आहर्तुमिच्छुः<br><br>

आजीव
आजीव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶರೀರಪೋಷಣೆ<br><b>निष्पत्तिः - </b>आ + जीव (प्राणधारणे) - "घञ्" (३-३-१८)<br><br>आजीव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ಯೋಗ /ಕಸುಬು<br><b>निष्पत्तिः - </b>कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>आजीवत्यनेन<br><b>प्रयोगाः - </b>"विशुद्ध इदानीमाजीवः"<br><b>उल्लेखाः - </b>शाकु० ६<br><br>आजीव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಸುಬುದಾರ<br><b>निष्पत्तिः - </b>कर्त० "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आजीवति<br><br>आजीव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬದುಕಿರುವವರೆಗೂ<br><b>निष्पत्तिः - </b>अव्ययी०<br><b>व्युत्पत्तिः - </b>जीवमभिव्याप्य<br><br>

आजीवक
आजीवक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಿಕ್ಷುಕ /ತಿರುಕ<br><b>निष्पत्तिः - </b>आ + जीव (प्राणधारणे) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>आजीवति<br><br>

आजीवन
आजीवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೋಷಣೆ<br><b>निष्पत्तिः - </b>आ + जीव (प्राणधारणे) - भावे "ल्युट्" (३-३-११५)<br><br>आजीवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ಯೋಗ /ಕಸುಬು<br><b>निष्पत्तिः - </b>आ + जीव (प्राणधारणे) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>आजीवत्यनेन<br><br>

आजीविका
आजीविका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ಯೋಗ /ಕಸುಬು<br><b>निष्पत्तिः - </b>आ + जीव (प्राणधारणे) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>प्रयोगाः - </b>"आर्ये कलेति शिक्षिता । आजीविकेदानीं संवृत्ता"<br><b>उल्लेखाः - </b>मृच्छ० २<br><br>

आजीव्य
आजीव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೀವನಕ್ಕಾಗಿ ಆಶ್ರಯಿಸಲ್ಪಡುವವನು<br><b>निष्पत्तिः - </b>आ + जीव (प्राणधारणे) - "ण्यत्" (३-१-१२४)<br><br>आजीव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೀವನಕ್ಕಾಗಿ ಸೇರಲು ಯೋಗ್ಯವಾದ ದೇಶ<br><br>

आजू
आजू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೂಲಿ ಕೊಡದೆ ಬಲಾತ್ಕಾರದಿಂದ ಕೆಲಸ ಮಾಡಿಸುವಿಕೆ<br><br>आजू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭದ್ರವೆಂಬ ಒಂದು ಕರಣ<br><b>व्युत्पत्तिः - </b>आजुषतेऽनया नरकम्<br><br>आजू<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೂಲಿ ಕೊಡದೆ ಬಲಾತ್ಕಾರದಿಂದ ಕೆಲಸ ಮಾಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + जृ (गतौ) - "क्विप्" (३-१-१७८)<br><b>व्युत्पत्तिः - </b>आजवति<br><br>आजू<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೂಲಿ ಪಡೆಯದೆ ಕೆಲಸ ಮಾಡುವವನು<br><br>

आजूर्
आजूर्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಷ್ಟಿ /ಕೂಲಿ ಕೊಡದೆ ಕೆಲಸ ಮಾಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + ज्वर (रोगे) - "क्विप्" (३-२-७६) । "ऊठ्" (६-४-२०)<br><br>आजूर्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತಾಪವುಳ್ಳವನು<br><br>

आज्ञप्त
आज्ञप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + ज्ञप (ज्ञाने) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आज्ञप्तास्मि देव्या धारिण्या । अचिरप्रवृत्तोपदेशं छलिकं नाम नाट्यमन्तरेण आर्यगणदासं प्रष्टुम् ॥"<br><b>उल्लेखाः - </b>माल० १<br><br>आज्ञप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ತಿಳಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + ज्ञप (ज्ञाने)- "क्तः" (३-२-१०२)<br><br>

आज्ञप्ति
आज्ञप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆ /ಆಜ್ಞೆ<br><b>निष्पत्तिः - </b>आ + ज्ञप (ज्ञाने) + णिच् - "क्तिन्" (३-३-९४)<br><br>

आज्ञा
आज्ञा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆ<br><b>निष्पत्तिः - </b>आ + ज्ञा (नियोगे) - "अङ्" (३-३-१०६)<br><b>प्रयोगाः - </b>"आज्ञामवाप्य महतीं द्विषतां निपातान्निर्वर्त्य तां सपदि लब्धसुखप्रसादः"<br><b>उल्लेखाः - </b>प्रबोध० २-२४<br><br>आज्ञा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜನ್ಮಲಗ್ನದಿಂದ ಹತ್ತನೆಯ ಸ್ಥಾನ<br><br>

आज्ञाकर
आज्ञाकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಕ /ಆಳು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आज्ञायाः करः<br><br>

आज्ञाकारिन्
आज्ञाकारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆಯಂತೆ ನಡೆಯುವವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>करोतीति करः । आज्ञां करोति<br><br>

आज्ञाकारिणी
आज्ञाकारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆಯನ್ನು ನಡೆಸುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आज्ञाचक्र
आज्ञाचक्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹದಲ್ಲಿರುವ ಸುಷುಮ್ನಾ ನಾಡಿಯ ಮಧ್ಯದಲ್ಲಿ ಹುಬ್ಬುಗಳ ಮಧ್ಯದಲ್ಲಿರುವ ದ್ವಿದಳಪದ್ಮಾಕಾರದ ಒಂದು ಚಕ್ರ<br><b>प्रयोगाः - </b>"आज्ञाचक्रं तदूर्ध्वं तु आत्मनोऽधिष्ठितं परम् । आज्ञासङ्क्रमणं तत्र गुरोराज्ञेति कीर्तिता ॥"<br><br>

आज्ञान
आज्ञान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಜ್ಞೆಯಂತೆ ನಡೆಯುವುದು<br><br>

आज्ञानुग
आज्ञानुग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆಯಂತೆ ನಡೆಯುವವನು<br><b>निष्पत्तिः - </b>आज्ञा + अनु + गम्लृ (गतौ) - "डः" (वा० ३-२-४८)<br><b>व्युत्पत्तिः - </b>आज्ञामनुगच्छति<br><br>

आज्ञानुगामिन्
आज्ञानुगामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆಯಂತೆ ನಡೆಯುವವನು<br><b>निष्पत्तिः - </b>आज्ञा + अनु + गम्लृ (गतौ) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आज्ञामनुगच्छति<br><br>

आज्ञानुगामिनी
आज्ञानुगामिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆಯಂತೆ ನಡೆಯುವವಳು<br><br>

आज्ञानुयायिन्
आज्ञानुयायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆಯಂತೆ ನಡೆಯುವ<br><b>निष्पत्तिः - </b>आज्ञा + अनु + या (प्रापणे) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आज्ञामनुयाति<br><br>

आज्ञानुवर्तिन्
आज्ञानुवर्तिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆಯಂತೆ ನಡೆಯುವ<br><b>निष्पत्तिः - </b>आज्ञा + अनु + वृतु (वर्तने) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आज्ञामनुवर्तते<br><br>

आज्ञानुसारिन्
आज्ञानुसारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆಯಂತೆ ನಡೆಯುವ<br><b>निष्पत्तिः - </b>आज्ञा + अनु + सृ (गतौ) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आज्ञामनुसरति<br><br>

आज्ञानुयायिनी
आज्ञानुयायिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಜ್ಞೆಯನ್ನು ಪಾಲಿಸುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आज्ञानुसारिणी
आज्ञानुसारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಜ್ಞೆಯನ್ನು ಪಾಲಿಸುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आज्ञानुवर्तिनी
आज्ञानुवर्तिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಜ್ಞೆಯನ್ನು ಪಾಲಿಸುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आज्ञापक
आज्ञापक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>आ + ज्ञा (नियोगे) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>आज्ञापयति<br><b>प्रयोगाः - </b>"दातुं क्षमाअया दयिते तदानीमाज्ञापको नूनमभूदनङ्गः"<br><b>उल्लेखाः - </b>याद० १३-५<br><br>

आज्ञापत्र
आज्ञापत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆಯ ಕಾಗದ /ಶಾಸನ ಮಾಡಿ ಹೊರಡಿಸುವ ಕಾಗದ<br><b>व्युत्पत्तिः - </b>आज्ञासूचकं पत्रम्<br><br>

आज्ञापन
आज्ञापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆ ಮಾಡುವುದು<br><br>आज्ञापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿಳಿಯಪಡಿಸುವುದು<br><b>निष्पत्तिः - </b>आ + ज्ञा (नियोगे) + णिच् - "ल्युट्" (३-३-११५)<br><br>

आज्ञाभङ्ग
आज्ञाभङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಸನವನ್ನು ಮುರಿಯುವುದು<br><b>व्युत्पत्तिः - </b>आज्ञायाः भङ्गः<br><b>प्रयोगाः - </b>"नाज्ञाभङ्गं सहन्ते नृवर, नृपतयस्त्वादृशाः"<br><b>उल्लेखाः - </b>मुद्रा० ३-२२<br><br>आज्ञाभङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜದ್ರೋಹ<br><br>

आज्ञावह
आज्ञावह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಧೇಯ /ಸೇವಕ<br><b>निष्पत्तिः - </b>वह (प्रापणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>वहतीति वहः । आज्ञायाः वहः<br><br>

आज्य
आज्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಘೃತ /ತುಪ್ಪ<br><b>निष्पत्तिः - </b>आ + अञ्चू (व्यक्तिश्लक्ष्णकान्तिगतिषु) - "क्यप्" (वा० ६-१-७१)<br><b>प्रयोगाः - </b>"अन्वदीपि गरुडः प्रतापवानाज्यसिक्त इव वह्निराध्वरः"<br><b>उल्लेखाः - </b>याद० १७-५५<br><br>

आज्यदोह
आज्यदोह<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಮವೇದದ ಒಂದು ಸೂಕ್ತ<br><br>

आज्यप
आज्यप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೈಶ್ಯರ ಪಿತೃದೇವತೆಗಳು /ಪುಲಸ್ತ್ಯನ ಪುತ್ರರು<br><b>प्रयोगाः - </b>"सोमपा नाम विप्राणां क्षत्रियाणां हविर्भुजः । वैश्यानामाज्यपा नाम शूद्राणां तु सुकालिनः ॥"<br><b>उल्लेखाः - </b>मनु० ३-१९७<br><br>आज्यप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತುಪ್ಪವನ್ನು ಕುಡಿಯುವ<br><b>निष्पत्तिः - </b>पा (पाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>आज्यं पिबति<br><br>

आज्यपात्र
आज्यपात्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೋಮಕ್ಕಾಗಿ ಕರಗಿಸಿದ ತುಪ್ಪವನ್ನು ಇಟ್ಟುಕೊಳ್ಳುವ ಪಾತ್ರೆ<br><br>

आज्यभुज्
आज्यभुज्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>निष्पत्तिः - </b>भुज (पालनाभ्यवहारयोः) - "क्विप्" (३-२-१७८)<br><b>व्युत्पत्तिः - </b>आज्यं मन्त्रपूर्वकं प्रक्षिप्तं सर्पिः भुङ्क्ते<br><br>

आञ्जन
आञ्जन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಂಜನೇಯ /ಹನುಮಂತ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>अञ्जनाया अयम्<br><br>आञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ಅಂಜನವನ್ನು ಹಾಕುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + अञ्जू (व्यक्त्यादौ) - "ल्युट्" (३-३-११५)<br><br>आञ्जन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಣ್ಣಿನ ಮುಲಾಮಿಗೆ ಸಂಬಂಧಿಸಿದ<br><b>व्युत्पत्तिः - </b>अञ्जनस्येदम्<br><br>

आञ्जनेय
आञ्जनेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹನುಮಂತ್ರ /ಅಂಜನಾದೇವಿಯ ಮಗ<br><b>निष्पत्तिः - </b>"ढक्" (४-१-१२०)<br><b>व्युत्पत्तिः - </b>अञ्जनाया अपत्यम्<br><br>

आटविक
आटविक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಣ್ಯದಲ್ಲಿ ಸಂಚರಿಸುವವನು<br><b>निष्पत्तिः - </b>"टक्" (४-३-६७)<br><b>व्युत्पत्तिः - </b>अटव्यां चरति भवो वा<br><b>प्रयोगाः - </b>"दण्डे सुहूत्कुमाराटविका सामन्तसैनिकाद्याश्च"<br><b>उल्लेखाः - </b>सा० द०<br><br>आटविक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>೬ ವಿಧ ಸೈನ್ಯಗಳಲ್ಲೊಂದು<br><b>विस्तारः - </b>"मौलं भृत्यं सुहृत्च्छ्रेणीद्विषदाटविकं बलम्" - अम० ।<br><br>

आटि
आटि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರಕುಟಿಗ ಹಕ್ಕಿ<br><b>निष्पत्तिः - </b>अट (गतौ) - "इन्" (उ० ४-११७)<br><b>व्युत्पत्तिः - </b>आ अटति<br><br>आटि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಮೀನು<br><br>

आटीकन
आटीकन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಕರುಗಳ ಹಾರಾಟ<br><b>निष्पत्तिः - </b>आ + टीकृ (गतौ) - "ल्युट्" (३-३-११५)<br><br>आटीकन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೇಗವಾಗಿ ಮೇಲಕ್ಕೆ ಏಳುವುದು<br><br>

आटीमुख
आटीमुख<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರಕುಟಿಗ ಹಕ್ಕಿಯ ಮುಖದಂತಿರುವ ಆಯುಧ /ರಕ್ತವನ್ನು ಹೊರತೆಗೆಯಲು ಉಪಯೋಗಿಸುವ ಒಂದು ಶಸ್ತ್ರ<br><b>व्युत्पत्तिः - </b>आट्याः मुखमिव मुखं यस्य<br><br>

आटोप
आटोप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದರ್ಪ /ಗರ್ವ /ಅಹಂಕಾರ<br><b>निष्पत्तिः - </b>आ+ तुप (हिंसायाम्) - "घञ्" (३-३-१९)<br><br>आटोप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಡಂಬರ /ತೋರಿಕೆ /ಪ್ರದರ್ಶನ<br><b>व्युत्पत्तिः - </b>पटाटोपः, घनपटाटोपः ।<br><br>आटोप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂರಂಭ /ಸಡಗರ<br><b>प्रयोगाः - </b>"साटोपमुर्वीमनिशं नदन्तः"<br><b>उल्लेखाः - </b>माघ० ३-७४<br><br>आटोप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಟ್ಟೆಯೊಳಗಿನ ವಾಯುನಿನ ಶಬ್ದ<br><b>प्रयोगाः - </b>"आमाटोपापचिश्लेष्मगुल्मे क्रिमिविकारिणाम्"<br><b>उल्लेखाः - </b>सुश्रु०<br><br>

आडम्बर
आडम्बर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹರ್ಷ /ಸಂತೋಷ<br><br>आडम्बर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತುತ್ತೂರಿಯ ಶಬ್ದ<br><br>आडम्बर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರದರ್ಶನ /ತೋರಿಕೆ<br><br>आडम्बर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ<br><br>आडम्बर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂರಂಭ /ಸಡಗರ<br><br>आडम्बर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದರ್ಪ /ಗರ್ವ /ಅಹಂಕಾರ<br><br>आडम्बर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಗರ್ಜನೆ<br><br>आडम्बर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎವೆ /ರೆಪ್ಪೆ<br><br>आडम्बर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧದ ನಗಾರಿ<br><b>निष्पत्तिः - </b>आ + डबि (क्षेपे) - "घञ्" (३-३-१९) । रा (दाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>आडम्बं राति<br><b>विस्तारः - </b>"आडम्बरः समारम्भे गजगर्जिततूर्ययोः" - विश्व० । "आडम्बरः तूर्यपक्ष्मसंरम्भे गजगर्जिते" - मेदि० ।<br><br>

आडि
आडि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮರಕುಟಿಗ ಹಕ್ಕಿ<br><br>आडि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಮೀನು<br><b>निष्पत्तिः - </b>आ + अड (उद्यमे) - "इन्" (उ० ४-११७)<br><br>

आडी
आडी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आडि ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां वा "ङीष्" (४-१-४५)<br><br>

आडू
आडू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೆಪ್ಪ<br><b>निष्पत्तिः - </b>अण (शब्दे) - "ऊः" डश्चादेशः (उ० १-८६)<br><br>

आढक
आढक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಕೊಳಗ<br><b>निष्पत्तिः - </b>ढौकृ (गतौ) - "अच्" (३-१-१३४) । पृषो० ।<br><b>व्युत्पत्तिः - </b>आढौकते<br><br>

आढकिक
आढकिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕೊಳಗ ಧಾನ್ಯವನ್ನು ತೆಗೆದುಕೊಂಡು ಹೋಗಬಹುದಾದ<br><br>आढकिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕೊಳಗ ಧಾನ್ಯವನ್ನು ಇಡಬಹುದಾದ<br><br>आढकिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕೊಳಗ ಧಾನ್ಯವನ್ನು ಬೇಯಿಸಬಹುದಾದ<br><b>निष्पत्तिः - </b>वा "ठञ्" (५-१-५३)<br><b>व्युत्पत्तिः - </b>आढकं सम्भवत्यवहरति पचति<br><br>

आढकी
आढकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಗರಿ<br><br>आढकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸುವಾಸನೆಯುಳ್ಳ ಭೂಮಿ<br><br>

आढकीन
आढकीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>आढकिक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>वा "खः" (५-१-५३)<br><b>व्युत्पत्तिः - </b>आढकं सम्भवत्यवहरति पचति<br><br>

आढ्य
आढ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧನಿಕ /ಐಶ್ವರ್ಯವಂತ<br><b>निष्पत्तिः - </b>आ + ध्यै (चिन्तायाम्) - "कः" (३-१-१३६) प्रृषो० ।<br><b>प्रयोगाः - </b>"आढ्योऽभिजनवानस्मि कोऽन्योऽस्ति सदृशो मया"<br><b>उल्लेखाः - </b>गीता० १६-१५<br><br>आढ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೂಡಿರುವ /ತುಂಬಿರುವ<br><b>व्युत्पत्तिः - </b>धनाढ्यः सत्याढ्यः<br><br>आढ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆರೆತಿರುವ /ಮಿಶ್ರವಾದ<br><br>आढ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೃದ್ಧವಾದ /ಹೆಚ್ಚಾದ<br><br>

आढ्यकुलीन
आढ्यकुलीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೀಮಂತನ ಕುಲದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>"खः" (४-१-१३९)<br><b>व्युत्पत्तिः - </b>आढ्यकुले भवः<br><br>

आढ्यङ्करण
आढ्यङ्करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧನಿಕನನ್ನಾಗಿ ಮಾಡುವ ಉಪಾಯ /ಸಾಧನ<br><b>निष्पत्तिः - </b>आढ्य + कृञ् (करणे) - "ख्युन्" (३-२-५६) । मुम् (६-३-६७)<br><b>व्युत्पत्तिः - </b>अनाढ्यं आढ्यं करोत्यनेन<br><br>

आढ्यचर
आढ्यचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂದೆ ಧನಿಕನಗಿದ್ದವನು ಈಗ ಬಡವನಾಗಿರುವವನು<br><b>निष्पत्तिः - </b>"चरट्" (५-३-५३)<br><b>व्युत्पत्तिः - </b>भूतपूर्वः आढ्यः<br><br>

आढ्यचरी
आढ्यचरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂದೆ ಧನಿಕನಗಿದ್ದವಳು ಈಗ ಬಡವನಾಗಿರುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><b>प्रयोगाः - </b>"आढ्यम्भविष्णुर्यशसा कुमारः"<br><b>उल्लेखाः - </b>भट्टि० ३-१<br><br>

आढ्यतम
आढ्यतम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಐಶ್ವರ್ಯವಂತ<br><b>निष्पत्तिः - </b>"तमप्" (५-३-५५)<br><b>व्युत्पत्तिः - </b>अतिशयेनाढ्यः<br><br>

आढ्यम्भविष्णु
आढ्यम्भविष्णु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧನಿಕನಾಗಿ ಆಗುವವನು /ದರಿದ್ರನಾಗಿದ್ದು ಐಶ್ವರ್ಯವನ್ನು ಪಡೆಯುವವನು<br><b>निष्पत्तिः - </b>"खिष्णुच्" (३-२-५७)<br><b>व्युत्पत्तिः - </b>अनाढ्यः आढ्यो भवति<br><br>

आढ्यम्भावुक
आढ्यम्भावुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"खुकञ्" (३-२-५७) । मुम्<br><b>व्युत्पत्तिः - </b>अनाढ्यः आढ्यो भवति<br><br>

आढ्यता
आढ्यता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೃದ್ಧಿ /ಐಶ್ವರ್ಯ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>आढ्यस्य भावः<br><br>

आणक
आणक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಸಂಭೋಗ<br><b>प्रयोगाः - </b>"आणकं सुरतं नाम दम्पत्योः पार्श्वसंस्थयोः"<br><br>आणक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಮ /ನೀಚ<br><b>निष्पत्तिः - </b>अण (शब्दे) - "अच्" (३-१-१३४) । कुत्सायां "कन्" । स्वार्थे "अण्" (५-४-३८)<br><b>व्युत्पत्तिः - </b>अणति<br><br>

आणव
आणव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಣುತ್ವ<br><b>निष्पत्तिः - </b>"अण्" (५-१-१२२)<br><b>व्युत्पत्तिः - </b>अणोर्भावः<br><br>

आणवमल
आणवमल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಏಕದಲ್ಲಿ ಅನೇಕತ್ವಕ್ಕೆ ಕಾರಣವಾದ ಮೂಲಮಹಾಮಾಯೆ<br><br>

आणवीन
आणवीन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಕ್ಷ್ಮಧಾನ್ಯಗಳು ಬೆಳೆಯುವ ಭೂಮಿ /ಕಿರುನೆಲ್ಲು ಕಿರುನವಣೆ ಮೊದಲಾದುವುದು ಬೆಳೆಯುವ ಕ್ಷೇತ್ರ<br><b>निष्पत्तिः - </b>अणु - "खञ्" (५-२-१)<br><b>व्युत्पत्तिः - </b>अणूनां भवनं क्षेत्रम्<br><br>

आणव्य
आणव्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>आणवीन ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"यत्" (५-२-४)<br><b>व्युत्पत्तिः - </b>अणूनां भवनं क्षेत्रम्<br><br>

आणि
आणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಡಿಯ ಕಡಾಣಿ /ಚಕ್ರವು ಬೀಳದಂತೆ ತಡೆಗಟ್ಟುವ ಕಬ್ಬಿಣದ ಸಲಾಕಿ<br><br>आणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಲ್ಲೆ /ಗಡಿ<br><b>निष्पत्तिः - </b>अण (शब्दे) - "इन्" (वा० ३-३-१०८)<br><br>आणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತಿಯ ತುದಿ<br><b>विस्तारः - </b>"आणिराणिवदक्षाग्रकीलाश्रिसीमसु द्वयोः" - मेदि० ।<br><br>

आण्ड
आण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿರಣ್ಯಗರ್ಭ /ಬ್ರಹ್ಮ<br><b>प्रयोगाः - </b>"अप एव ससर्जादौ तासु वीर्यमवासृजत् । तदण्डमभवद्धैमं सहस्रांशुसमप्रभम् । तस्मिन् जज्ञे स्वयं ब्रह्मा सर्वलोकपितामहः ॥"<br><b>उल्लेखाः - </b>मनु० १-८, ९<br><br>आण्ड<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಟ್ಟೆಗಳ ರಾಶಿ<br><b>निष्पत्तिः - </b>"अण्" (४-२-३७)<br><b>व्युत्पत्तिः - </b>अण्डानां समूहः<br><br>आण्ड<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುರುಷನ ವೃಷಣಗಳ ಕೋಶ<br><br>आण्ड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊಟ್ಟೆಯಿಂದ ಹುಟ್ಟಿದ ಹಕ್ಕಿ ಮೊದಲಾದುದು<br><br>

आण्डज
आण्डज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಟ್ಟೆಯಿಂದ ಹುಟ್ಟಿದ ಹಕ್ಕಿ ಮೊದಲಾದುದು<br><br>आण्डज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಟ್ಟೆಯಿಂದ ಹುಟ್ಟಿದ ಹಾವು ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९६) । स्वार्थे "अण्" (५-४-३८)<br><b>व्युत्पत्तिः - </b>अण्डात् जायते<br><br>आण्डज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಕ್ಕಿ ಮತ್ತು ಹಾವಿನ ಶರೀರ<br><br>

आण्डायन
आण्डायन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊಟ್ಟೆಯಿಂದ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>अण्ड - "फक्" (४-२-८०)<br><b>व्युत्पत्तिः - </b>अण्डेन निर्वृत्तम्<br><br>

आत्
आत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾರ ಎಂಬ ಅಕ್ಷರ<br><b>प्रयोगाः - </b>"वृद्धिरादैच्"<br><b>उल्लेखाः - </b>पा० सू० १-१-१<br><br>

आत
आत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ಹರಡಿರುವ<br><b>निष्पत्तिः - </b>आ + अत (सातत्यगमने) - "अच्" (३-१-१३४)<br><br>

आतक
आतक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸರ್ಪ<br><br>आतक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವಾಗಲೂ ಸಂಚರಿಸುವ<br><b>निष्पत्तिः - </b>आ + अत (सातत्यगमने) - "ण्वुल्" (३-१-१३३)<br><br>

आतङ्क
आतङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗ /ವ್ಯಾಧಿ<br><b>निष्पत्तिः - </b>आ + तकि (कूच्छ्रजीवने) - "घञ्" (३-३-१२१)<br><b>प्रयोगाः - </b>"दीर्घतीव्रामयग्रस्तं ब्राह्मणं गामथापि वा । दृष्ट्वा पथि निरातङ्कं कृत्वा तु ब्रह्महा शुचिः ॥"<br><b>उल्लेखाः - </b>याज्ञ० ३-२४५<br><br>आतङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾಪ<br><b>प्रयोगाः - </b>"आतङ्कश्रमसाध्वसव्यतिकरोत्कम्पः कथं सह्यताम्"<br><b>उल्लेखाः - </b>म० वी० २-२१<br><br>आतङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಶಯ /ಸಂದೇಹ<br><br>आतङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಯ /ದಿಗಿಲು<br><b>प्रयोगाः - </b>"पुरुषायुषजीविन्यो निरातङ्का निरीतयः"<br><b>उल्लेखाः - </b>रघु० १-६३<br><br>आतङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುರಜ ಧ್ವನಿ /ಮೃದಂಗದ ಶಬ್ದ<br><b>विस्तारः - </b>"आतङ्को रोगसन्तापशङ्कासु मुरजध्वनौ" - मेदि० ।<br><br>

आतञ्चन
आतञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಲಿಗೆ ಹೆಪ್ಪು ಹಾಕುವುದು<br><br>आतञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೇಗ<br><br>आतञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೃಪ್ತಿಪಡಿಸುವಿಕೆ<br><br>आतञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಪ್ಪು ಹಾಕುವ ವಸ್ತು<br><b>निष्पत्तिः - </b>आ + तञ्चु (गतौ) - भावे कर० वा "ल्युट्" (३-३-११५, ११७)<br><b>विस्तारः - </b>"आतञ्चनं प्रतिवापजवनाप्यायनेषु च" - मेदि० ।<br><br>

आतत
आतत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಡಲ್ಪಟ್ಟ /ವಿಸ್ತರಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"शास्त्रेष्वव्याहता बुद्धिः मौर्वी धनुषि चातता"<br><b>उल्लेखाः - </b>रघु० १-१९<br><br>

आततायिन्
आततायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಲ್ಲುವ ಪ್ರಯತ್ನವುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>आततेन विस्तीर्णेन शस्त्रादिना अयितुं शीलमस्य<br><b>प्रयोगाः - </b>"अर्चनीयचरणाम्बुजे भवत्याततायिपदवीमुपेयुषाम्"<br><b>उल्लेखाः - </b>याद० १७-११५<br><br>

आतनु
आतनु<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ತನು ಧಾತುವಿನ ಅರ್ಥ<br><br>

आतन्वत्
आतन्वत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಸ್ತಾರಗೊಳಿಸುವ<br><b>निष्पत्तिः - </b>आ + तनु (विस्तारे) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"आतन्वद्भिर्दिक्षु तत्राग्रनादं प्राप्तैर्दूरादाशु तीक्ष्णैर्मुखाग्रैः"<br><b>उल्लेखाः - </b>माघ० १८-७४<br><br>आतन्वत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡತ್ತಲಿರುವ<br><br>

आतन्वान
आतन्वान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>आतन्वत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>आ + तनु (विस्तारे) - "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"आतन्वानं भुजगशयने कामपि क्षौमगौरे निद्रामुद्रां निखिलजगतीरक्षणे जागरूकाम्"<br><b>उल्लेखाः - </b>चं० रा०<br><br>

आतप
आतप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಸಿಲು /ಸೂರ್ಯನ ಪ್ರಕಾಶ<br><b>निष्पत्तिः - </b>आ + तप (सन्तापे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आतपति<br><b>प्रयोगाः - </b>"आतपे धृतिमता सह वध्वा यामिनीविरहिणा विघगेन"<br><b>उल्लेखाः - </b>किरा० ९-३०<br><br>आतप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶ<br><b>विस्तारः - </b>"प्रकाशस्तु द्योत आलोक आतपः" - वैज० ।<br><br>

आतपत्र
आतपत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಛತ್ರಿ /ಕೊಡೆ<br><b>निष्पत्तिः - </b>त्रैङ् (पालने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>आतपात् त्रायते<br><b>प्रयोगाः - </b>"आतपत्रमथ तत्प्रचेतसो मन्दरस्य मणिशृङ्गमुन्नतम्"<br><b>उल्लेखाः - </b>याद० १७-१<br><br>

आतपवत्
आतपवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಸಿಲಿನಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>आतपोऽस्यास्ति<br><b>प्रयोगाः - </b>"शृङ्गानि यस्यातपवन्ति सिद्धाः"<br><b>उल्लेखाः - </b>कुमा० १-५<br><br>

आतपवारण
आतपवारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಛತ್ರಿ /ಕೊಡೆ<br><b>निष्पत्तिः - </b>वृञ् (वरणे) + णिच् - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आतपं वारयति<br><b>प्रयोगाः - </b>"नृपतिककुदं दत्त्वा यूने सितातपवारणम्"<br><b>उल्लेखाः - </b>रघु० ३-७०<br><br>

आतपात्यय
आतपात्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಪ್ರಕಾಶ ಕಡಿಮೆಯಾಗುವುದು<br><b>व्युत्पत्तिः - </b>आतपस्य अत्ययः<br><b>प्रयोगाः - </b>"आतपात्ययसङ्क्षिप्तनीवारासु निषादिभिः"<br><b>उल्लेखाः - </b>रघु० १-५२<br><br>आतपात्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಯಂಕಾಲ<br><b>व्युत्पत्तिः - </b>आतपस्यात्ययो यत्र<br><br>

आतपीय
आतपीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಸಿಲಿಗೆ ಸಮೀಪದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"छः" (४-२-९०)<br><b>व्युत्पत्तिः - </b>आतपस्यादूरभवः<br><br>

आतपोदक
आतपोदक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೃಗತೃಷ್ಣಿಕೆ /ಬಿಸಿಲುಗುದುರೆ<br><b>व्युत्पत्तिः - </b>आतपे सूर्यकिरणे लक्ष्यमाणमुदकम्<br><br>

आतर
आतर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನದಿಯನ್ನು ದಾಟಿಸೌ ಕೊಡುವ ಕೂಲಿ<br><b>निष्पत्तिः - </b>आ + तॄ (प्लवनतरणयोः) - "अप्" (३-३-५७)<br><b>व्युत्पत्तिः - </b>आतरत्यनेन<br><b>प्रयोगाः - </b>"तस्मै सौमित्रिमैत्रीमयमुपकृतवानातरं नाविकाय"<br><b>उल्लेखाः - </b>अनर्घ०<br><br>

आतापि
आतापि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬರಾಕ್ಷಸ /ಅಗಸ್ತ್ಯಮಹರ್ಷಿಯಿಂದ ತಿನ್ನಲ್ಪಟ್ಟವನು<br><b>प्रयोगाः - </b>"आतापिर्भक्षितो येन वातापिश्च महासुरः । समुद्रः शोषितो येन स मेऽगस्त्यः प्रसीदतु ॥"<br><br>

आतापिन्
आतापिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ದವಾದ ರೆಕ್ಕೆಗಳುಳ್ಳ ಹದ್ದು<br><b>निष्पत्तिः - </b>आ + तप (सन्तापे) + णिच् - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आतापयति<br><br>

आति
आति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರಕುಟಗ ಹಕ್ಕಿ<br><br>

आतिथेय
आतिथेय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆತಿಥ್ಯ /ಅತಿಥಿಸತ್ಕಾರ<br><b>प्रयोगाः - </b>"आतिथेयमनिवारितातिथिः कर्तुमाश्रमगुरुः स नाश्रमत्"<br><b>उल्लेखाः - </b>माघ० १४-३८<br><br>आतिथेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಥಿಸತ್ಕಾರದಲ್ಲಿ ಸಮರ್ಥನಾದವನು<br><b>निष्पत्तिः - </b>"ढञ्" (४-४-१०४)<br><b>व्युत्पत्तिः - </b>अतिथिषु साधुः<br><b>प्रयोगाः - </b>"प्रत्युज्जगामातिथिमातिथेयः"<br><b>उल्लेखाः - </b>रघु० ५-२<br><br>

आतिथेयी
आतिथेयी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आतिथेय ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><b>प्रयोगाः - </b>"आतिथेयीमथासाद्य सुतादपचितिं हरिः"<br><b>उल्लेखाः - </b>किरा० ११-९<br><br>

आतिथ्य
आतिथ्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಥಿ<br><b>निष्पत्तिः - </b>अतिथि - स्वार्थे "ष्यञ्"<br><br>आतिथ्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆತಿಥ್ಯ /ಅತಿಥಿಸತ್ಕಾರ<br><b>निष्पत्तिः - </b>"ञ्यः" (५-४-२६)<br><b>व्युत्पत्तिः - </b>अतिथये इदम्<br><b>प्रयोगाः - </b>"तमातिथ्यक्रियाशान्तरथक्षोभपरिश्रमम्"<br><b>उल्लेखाः - </b>रघु० १-५८<br><br>

आतिदेशिक
आतिदेशिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿದೇಶದಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>"ठञ्" (४-२-११५)<br><b>व्युत्पत्तिः - </b>अतिदेशादागतः<br><br>

आतिवाहिक
आतिवाहिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈ ಲೋಕದಿಂದ ಲೋಕಾಂತರಕ್ಕೆ ಕರೆದುಕೊಂಡು ಹೋಗಲು ನೇಮಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-६९)<br><b>व्युत्पत्तिः - </b>अतिवाहे इहलोकात् परलोकप्रापणे नियुक्तः<br><br>

आतिशय्य
आतिशय्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಶಯ /ಆಧಿಕ್ಯ<br><b>निष्पत्तिः - </b>स्वार्थे "ष्यञ्"<br><b>व्युत्पत्तिः - </b>अतिशय एव<br><br>

आतु
आतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೆಪ್ಪ<br><b>निष्पत्तिः - </b>अत (सातत्यगमने) - "उण्" (उ० १-१)<br><br>

आतुर
आतुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೋಗಪೀಡಿತನಾದ<br><b>निष्पत्तिः - </b>आ + तुर (त्वरणे) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>आतुतोर्ति<br><b>प्रयोगाः - </b>"जराशोकसमाविष्टं रोगायतनमातुरम्"<br><b>उल्लेखाः - </b>मनु ६-७७<br><br>आतुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಯಿಸಲ್ಪಟ್ಟ /ಗಾಯಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>आतुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೀಡಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"रावणावरजा तत्र राघवं मदनातुरा"<br><b>उल्लेखाः - </b>रघु० १२-३२<br><br>आतुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಔತ್ಸುಕ್ಯಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>

आतुरोपक्रमण
आतुरोपक्रमण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗಿಯ ಚಿಕಿತ್ಸೆಗಾಗಿ ಆಯುರ್ದಾಯ ವ್ಯಾಧಿಯ ಸ್ವರೂಪ ಋತು ವಯಸ್ಸು ದೇಹಶಕ್ತಿ ಪ್ರಕೃತಿದೇಶ ಮತ್ತು ಔಷಧ ಇವುಗಳನ್ನು ಅನುಸರಿಸಿ ಮಾಡುವ ಕೆಲಸ<br><b>व्युत्पत्तिः - </b>आतुरमधिकृत्य उपक्रमणीयम्<br><br>आतुरोपक्रमण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗಿಯ ಚಿಕಿತ್ಸಾ ಕ್ರಮವನ್ನು ಹೇಳುವ ಗ್ರಂಥ<br><b>निष्पत्तिः - </b>"छः" (४-३-८८)<br><b>व्युत्पत्तिः - </b>आतुरोपक्रमणमधिकृत्य कृतो ग्रन्थः<br><br>

आतोद्य
आतोद्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೀಣೆ<br><b>निष्पत्तिः - </b>तुद (व्यथने) - "ण्यत्" (३-१-१२४)<br><b>व्युत्पत्तिः - </b>आसमन्तात् तुद्यते<br><b>प्रयोगाः - </b>"स्रजमातोद्यशिरोनिवेशिताम्"<br><b>उल्लेखाः - </b>रघु० ८-३४<br><br>

आत्त
आत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವೀಕರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + डुदाञ् (दाने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आत्तदेहमिव स्वर्गमासेचनकदर्शनम्"<br><b>उल्लेखाः - </b>याद० १६-३<br><br>

आत्तगर्व
आत्तगर्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>आत्तः शत्रुणा गृहीतो गर्वः यस्य<br><br>आत्तगर्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗರ್ವವನ್ನು ಹೊಂದಿದ<br><b>व्युत्पत्तिः - </b>आत्तो गृहीतो गर्वो येन<br><br>

आत्मकर्मन्
आत्मकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಂತಕೆಲಸ /ತನ್ನ ಕರ್ತವ್ಯ<br><b>प्रयोगाः - </b>"आत्मकर्मक्षमं देहं क्षात्रो धर्म इवाश्रितः"<br><b>उल्लेखाः - </b>रघु० १-१३<br><br>

आत्मकाम
आत्मकाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆತ್ಮಜ್ಞಾನವನ್ನು ಅಪೇಕ್ಷಿಸುವ<br><br>आत्मकाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆತ್ಮನನ್ನು ಅಪೇಕ್ಷಿಸುವ /ವಿರಕ್ತನಾದ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>आत्मानमेव कामयते<br><br>

आत्मगत
आत्मगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನಲ್ಲಿರುವ<br><br>आत्मगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನ ಮನಸ್ಸಿನಲ್ಲಿರುವ<br><b>व्युत्पत्तिः - </b>आत्मनि गतम्<br><br>आत्मगत<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ತನ್ನಲ್ಲಿಯೇ<br><b>प्रयोगाः - </b>"सर्वश्राव्यं प्रकाशं स्यत् अश्राव्यं स्वगतं मतम्"<br><br>

आत्मगुप्त
आत्मगुप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನಿಂದಲೇ ರಕ್ಷಿಸಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>आत्मना गुप्तः<br><br>

आत्मगुप्ता
आत्मगुप्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿತುರಚಿ ಗಿಡ<br><b>व्युत्पत्तिः - </b>आत्मना गुप्ता<br><br>

आत्मग्राहिन्
आत्मग्राहिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಾರ್ಥಪರ<br><b>निष्पत्तिः - </b>ग्रह (उपादाने) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आत्मार्थं गृह्णाति<br><br>आत्मग्राहिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆತ್ನನನ್ನು ತಿಳಿದ<br><b>निष्पत्तिः - </b>ग्रह - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आत्मानं गृह्णाति<br><br>

आत्मघात
आत्मघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮಹತ್ಯೆ<br><b>प्रयोगाः - </b>"वृद्धः शौचक्रियालुप्तः प्रत्याख्यातभिष्क्क्रियः । आत्मानं घातयेद्यस्तु भृग्वग्न्यनशनाम्बुभिः ॥"<br><br>आत्मघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಖಂಡಮತ<br><br>

आत्मघातिन्
आत्मघातिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಶಾಸ್ತ್ರೀಯವಾಗಿ ಆತ್ಮಹತ್ಯೆ ಮಾಡಿಕೊಳ್ಳುವವನು<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आत्मानं हन्ति<br><b>प्रयोगाः - </b>"आत्मघातिभिरहम्मतिग्रहात्"<br><b>उल्लेखाः - </b>याद० १७-९३<br><br>आत्मघातिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಖಂಡಿ /ವೇದಮತಬಾಹ್ಯ<br><br>आत्मघातिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆತ್ನಜ್ಞಾನ ಸಂಪಾದಿಸದೆ ಬಾಹ್ಯಸುಖದಲ್ಲೇ ಆಸಕ್ತನಾಗಿರುವವನು<br><br>

आत्मघोष
आत्मघोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ<br><br>आत्मघोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಕ್ಕುಟ<br><b>निष्पत्तिः - </b>घुषिर् (विशब्दने) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>आत्मानं घोषयति<br><br>

आत्मज
आत्मज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರ /ಮಗ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>आत्मनो देहाज्जायते<br><b>प्रयोगाः - </b>"अयाचितदयासिन्धुमात्मजस्य शुभां गतिम्"<br><b>उल्लेखाः - </b>याद० १६-११०<br><br>आत्मज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ /ಮನ್ಮಥ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>आत्मनो मनसो जायते<br><br>

आत्मजा
आत्मजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಗಳು<br><br>आत्मजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿ<br><br>

आत्मजन्मन्
आत्मजन्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರ /ಮಗ<br><b>व्युत्पत्तिः - </b>आत्मनो जन्म यस्य<br><b>प्रयोगाः - </b>"आत्मा वै पुत्रनामासि" । "अत आहर्तुमिच्छामि पार्वतीमात्मजन्मने"<br><b>उल्लेखाः - </b>कुमा० ६-२८<br><br>आत्मजन्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ /ಮನ್ಮಥ<br><br>

आत्मज्ञ
आत्मज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಪಸ್ವಿ /ಆತ್ಮಸ್ವರೂಪವನ್ನು ಅರಿತವನು<br><br>आत्मज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನನ್ನು ಅರಿತವನು<br><b>निष्पत्तिः - </b>ज्ञा (अवबोधने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>आत्मानं जानाति<br><br>

आत्मज्ञान
आत्मज्ञान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮಸ್ವರೂಪದ ಅರಿವು<br><b>प्रयोगाः - </b>"सर्वेषामपि चैतेषामात्मज्ञानं परं स्मृतम् । तद्ध्यग्र्यं सर्वविद्यानां प्राप्यते ह्यमृतं यतः ॥"<br><b>उल्लेखाः - </b>मनु० १२-८५<br><br>आत्मज्ञान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನ ಸ್ವರೂಪದ ತಿಳುವಳಿಕೆ<br><b>व्युत्पत्तिः - </b>आत्मनो ज्ञानम्<br><br>

आत्मतत्त्व
आत्मतत्त्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮನ ನಿಜ ಸ್ವರೂಪ<br><b>व्युत्पत्तिः - </b>आत्मनः तत्त्वम्<br><br>

आत्मदर्श
आत्मदर्श<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದರ್ಪಣ /ಕನ್ನಡಿ<br><b>निष्पत्तिः - </b>दृशिर् (प्रेक्षणे) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>आत्मा दृश्यतेऽत्र<br><b>प्रयोगाः - </b>"निःश्वासबाष्पापगमात्प्रपन्नः प्रसादमात्मीयमिवात्मदर्शः"<br><b>उल्लेखाः - </b>रघु० ७-६८<br><br>आत्मदर्श<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮಸಾಕ್ಷಾತ್ಕಾರ<br><b>व्युत्पत्तिः - </b>आत्मनो दर्शः दर्शनम्<br><br>

आत्मदर्शन
आत्मदर्शन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮಸಾಕ್ಷಾತ್ಕಾರ<br><b>व्युत्पत्तिः - </b>आत्मनो दर्शनम्<br><br>आत्मदर्शन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮಸಾಕ್ಷಾತ್ಕಾರಕ್ಕೆಸಾಧನ /ಪರಮಾತ್ಮನನ್ನು ಎದುರಿಗೆ ಕಾಣಲು ಉಪಾಯ<br><b>निष्पत्तिः - </b>दृशिर् (प्रेक्षणे) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>आत्मा दृश्यतेऽनेन<br><b>प्रयोगाः - </b>"आत्मा वा अरे द्रष्टव्यः श्रोतव्यो मन्तव्यो निदिध्यासितव्यः"<br><b>उल्लेखाः - </b>श्रुतिः<br><br>

आत्मध्यान
आत्मध्यान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮನ ಧ್ಯಾನ<br><b>व्युत्पत्तिः - </b>आत्मनो ध्यानम्<br><br>

आत्मन्
आत्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ /ಬ್ರಹ್ಮ<br><b>निष्पत्तिः - </b>अत (सातत्यगमने) - "मनिन्" (उ० ४-१५३)<br><b>प्रयोगाः - </b>"आत्मेव दृष्टः सहसा प्रजानामादर्शनेच्छामितरेषु दत्ते"<br><b>उल्लेखाः - </b>याद० १८-९३<br><b>विस्तारः - </b>"यच्चप्नोति यदादत्ते यच्चात्ति विषयानिह । यच्चास्य सन्ततो भावः तस्मादात्मेति कीर्त्यते ॥"<br><br>आत्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೀವಾತ್ಮ<br><b>प्रयोगाः - </b>"आत्मानं रथिनं विद्धि मनः प्रग्रहमेव च । इन्द्रियाणि हयानाहुः विषयांस्तेषु गोचरम् । आत्मेन्द्रियमनोयुक्तं भोक्तेत्याहुर्मनीषिणः ॥"<br><b>उल्लेखाः - </b>कठ०<br><br>आत्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶರೀರ /ದೇಹ<br><b>प्रयोगाः - </b>"आत्मानमालोक्य च शोभमानमादर्शबिम्बे स्तिमितायताक्षी"<br><b>उल्लेखाः - </b>कुमा० ७-२२<br><br>आत्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯತ್ನ<br><br>आत्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಭಾವ<br><b>प्रयोगाः - </b>"तमात्मसम्पन्नमनिन्दितात्मा"<br><b>उल्लेखाः - </b>रघु० १८-१८<br><br>आत्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನಸ್ಸು /ಚಿತ್ತ<br><b>प्रयोगाः - </b>"आरेभिरे जितात्मानः पुत्रीयामिष्टिमृत्विजः"<br><b>उल्लेखाः - </b>रघु० १०-४<br><br>आत्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿ /ಜ್ಞಾನ<br><b>प्रयोगाः - </b>"तमात्मसम्पन्नमनिन्दितात्मा कृत्वा युवानं युवराजमेव"<br><b>उल्लेखाः - </b>रघु० १८-१८<br><br>आत्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧೈರ್ಯ<br><br>आत्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಯಂ /ತಾನು<br><b>प्रयोगाः - </b>"आत्मानममृतोदन्वदन्तस्स्थितममन्यत"<br><b>उल्लेखाः - </b>याद० १६-१३८<br><br>आत्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರೂಪ<br><b>प्रयोगाः - </b>"अथ विश्वात्मने गौरी सन्दिदेश मिथः सखीम्"<br><b>उल्लेखाः - </b>कुमा० ६-१<br><br>आत्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><br>आत्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>आत्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯು<br><br>आत्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರ /ಮಗ<br><b>प्रयोगाः - </b>"आत्मा वै पुत्रनामासि"<br><br>आत्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯ<br><b>विस्तारः - </b>"आत्मा चित्ते धृतौ यत्ने धिषणायां कलेबरे । परमात्मनि जीवेऽर्के हुताशनसमीरयोः । स्वभावे" - हेम० ।<br><br>

आत्मनिन्दा
आत्मनिन्दा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನನ್ನು ದೂಷಿಸಿಕೊಳ್ಳುವುದು<br><br>

आत्मनिष्ठ
आत्मनिष्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೋಕ್ಷಾರ್ಥಿ /ಬ್ರಹ್ಮಜ್ಞಾನವನ್ನು ಅಪೇಕ್ಷಿಸುವವನು<br><b>निष्पत्तिः - </b>ष्ठा (गतिनिवृत्तौ) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>आत्मनि नितरं तिष्ठति<br><br>

आत्महीन
आत्महीन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರ /ಮಗ<br><br>आत्महीन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಯಾಲ /ಭಾವಮೈದುನ<br><br>आत्महीन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿದೂಷಕ<br><br>आत्महीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನಗೆ ಹಿತವಾದ<br><b>निष्पत्तिः - </b>आत्मन् - "खः" (५-१-९)<br><b>व्युत्पत्तिः - </b>आत्मने हितम्<br><b>प्रयोगाः - </b>"नैवात्मनीनमथवा क्रियते मदान्धैः"<br><b>उल्लेखाः - </b>माघ० ५-४४<br><br>आत्महीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೇತನ /ಜೀವ /ಪ್ರಾಣಹೊಂದಿರುವ<br><b>विस्तारः - </b>"आत्मनीनः सुते स्याले प्राणधारिणि दूषके" - वैज० ।<br><br>

आत्मनेपद
आत्मनेपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಿಯೆಯಿಂದ ಹುಟ್ಟಿದ ಫಲವು ಆತ್ಮಗಾಮಿ ಎಂದು ತಿಳಿಸುವುದಕ್ಕಾಗಿರುವ ಪ್ರತ್ಯಯ<br><b>निष्पत्तिः - </b>सप्तम्या अलुक् (६-३-७)<br><b>व्युत्पत्तिः - </b>आत्मने आत्मार्थफलबोधनाय पदम्<br><br>

आत्मनेपदिन्
आत्मनेपदिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮನೇಪದದ ಪ್ರಕೃತಿಯಾದ ಧಾತು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>आत्मने पदमस्त्यस्य<br><br>

आत्मप्रभ
आत्मप्रभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><br>आत्मप्रभ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಯಂಪ್ರಕಾಶವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>आत्मना प्रकर्षेण भाति<br><br>

आत्मप्रभा
आत्मप्रभा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನ ಪ್ರಕಾಶ<br><b>व्युत्पत्तिः - </b>आत्मनः प्रभा<br><br>

आत्मप्रभव
आत्मप्रभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರ /ಮಗ<br><br>आत्मप्रभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ /ಮನ್ಮಥ<br><b>व्युत्पत्तिः - </b>आत्मा देहः मनो वा प्रभवो यस्य<br><br>आत्मप्रभव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕಾಶ ಮೊದಲಾದ ಪ್ರಪಂಚ<br><b>व्युत्पत्तिः - </b>आत्मा परमात्मा प्रभवो यस्य<br><br>

आत्मप्रभवा
आत्मप्रभवा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ಯೆ /ಮಗಳು<br><br>आत्मप्रभवा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿ<br><br>

आत्मबन्धु
आत्मबन्धु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ನೇಹಿತ<br><br>आत्मबन्धु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾಯಿಯ ಸಹೋದರಿಯ ಮಕ್ಕಳು<br><b>विस्तारः - </b>"आत्ममातृष्वसुः पुत्राः आत्मपितृष्वसुः सुताः । आत्ममातुअलपुत्राश्च विज्ञेया ह्यात्मबन्धवः ॥"<br><br>आत्मबन्धु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನ ಹಿತವನ್ನು ಸಾಧಿಸುವಮನಸ್ಸು<br><b>प्रयोगाः - </b>"आत्मैव ह्यात्यमनो बन्धुः आत्मैव रिपुरात्मनः"<br><b>उल्लेखाः - </b>गीता० ६-५<br><br>

आत्मबान्धव
आत्मबान्धव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ನೇಹಿತ<br><b>प्रयोगाः - </b>"आत्मबुद्धिः सुखायैव गुरुबुद्धिः विशेषतः । परबुद्धिर्विनाशाय स्त्रीबुद्धिः प्रलयावहा ॥"<br><br>आत्मबान्धव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾಯಿಯ ಸಹೋದರಿಯ ಮಕ್ಕಳು<br><br>आत्मबान्धव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನ ಹಿತವನ್ನು ಸಾಧಿಸುವಮನಸ್ಸು<br><br>

आत्मबुद्धि
आत्मबुद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನ ಸ್ವಂತ ಬುದ್ಧಿ<br><b>व्युत्पत्तिः - </b>आत्मनो बुद्धिः<br><b>प्रयोगाः - </b>"आत्मबुद्धिः सुखायैव गुरुबुद्धिः विशेषतः । परबुद्धिर्विनाशाय स्त्रीबुद्धिः प्रलयावहा ॥"<br><br>

आत्मभू
आत्मभू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರ /ಮಗ<br><b>निष्पत्तिः - </b>भू (सत्तायाम्) - "क्विप्" (३-२-१७९)<br><b>व्युत्पत्तिः - </b>आत्मनो देहात् भवति<br><br>आत्मभू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ /ಮನ್ಮಥ<br><b>निष्पत्तिः - </b>भू (सत्तायाम्) - "क्विप्" (३-२-१७९)<br><b>व्युत्पत्तिः - </b>आत्मनो मनसो भवति<br><br>आत्मभू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ /ಈಶ್ವರ<br><b>व्युत्पत्तिः - </b>आत्मनैव भवति<br><br>आत्मभू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿರಣ್ಯಗರ್ಭ /ಬ್ರಹ್ಮ<br><b>व्युत्पत्तिः - </b>आत्मनो विष्णोः सकाशात् आत्मना स्वयमेव वा भवति<br><b>प्रयोगाः - </b>"वचस्यवसिते तस्मिन् ससर्ज गिरमात्मभूः"<br><b>उल्लेखाः - </b>कुमा० २-५३<br><br>आत्मभू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ಯೆ /ಮಗಳು<br><br>आत्मभू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿ /ಜ್ಞಾನ<br><br>आत्मभू<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕಾಶಾದಿ ಪ್ರಪಂಚ<br><br>

आत्मभूत
आत्मभूत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರ /ಮಗ<br><br>आत्मभूत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ /ಮನ್ಮಥ<br><b>व्युत्पत्तिः - </b>आत्मनो देहान्मनसो वा भूतः<br><br>आत्मभूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೇಹದಿಂದ ಹುಟ್ಟಿದ<br><br>आत्मभूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನಸ್ಸಿನಿಂದ ಉಂಟಾದ<br><b>व्युत्पत्तिः - </b>आत्मनो भूतः<br><br>आत्मभूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನ ಕರ್ತವ್ಯವನ್ನು ನಿರ್ವಹಿಸುವ<br><b>व्युत्पत्तिः - </b>अनात्मा आत्मा सम्पद्यमानो भूतः<br><br>

आत्मभूता
आत्मभूता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಗಳು<br><br>आत्मभूता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿ /ಜ್ಞಾನ<br><br>

आत्मभूय
आत्मभूय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಭಾವ /ಬ್ರಹ್ಮನಾಗಿ ಆಗುವಿಕೆ<br><b>निष्पत्तिः - </b>भू (सत्तायाम्) - "क्यप्" (३-१-१०७)<br><b>व्युत्पत्तिः - </b>आत्मनो भावः<br><br>आत्मभूय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಸಾಯುಜ್ಯ<br><br>

आत्ममय
आत्ममय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆತ್ಮಸ್ವರೂಪವನ್ನು ಹೊಂದಿದ /ಬ್ರಹ್ಮಭಾವವನ್ನು ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>आत्मन् - "मयट्" (५-४-२१)<br><br>

आत्ममानिन्
आत्ममानिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆತ್ಮಾಭಿಮಾನವುಳ್ಳ /ತಾನೇ ಶ್ರೇಷ್ಠನೆಂಬ ಅಹಂಕಾರವುಳ್ಳ<br><b>निष्पत्तिः - </b>मन (ज्ञाने) - "णिनिः᳚ (३-२-८२)<br><b>व्युत्पत्तिः - </b>आत्मानमुत्कर्षेण मन्यते<br><br>आत्ममानिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆತ್ಮಗೌರವವುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>आत्ममानोऽस्यास्ति<br><br>आत्ममानिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲರನ್ನೂ ತನ್ನಂತೆಯೇ ತಿಳಿಯುವ<br><br>

आत्ममानिनी
आत्ममानिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आत्ममानिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आत्ममूल
आत्ममूल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಗತ್ತು /ವಿಶ್ವ /ಬ್ರಹ್ಮಾಂಡ<br><b>व्युत्पत्तिः - </b>आत्मा परमात्मा मूलमस्य<br><br>

आत्ममूली
आत्ममूली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೀಟಕ ಸಂಧಿ<br><b>निष्पत्तिः - </b>"ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>आत्मैव रक्षणे मूलमस्याः<br><br>

आत्मम्भरि
आत्मम्भरि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನ ಹೊಟ್ಟೆಯನ್ನು ಮಾತ್ರ ತುಂಬಿಕೊಳ್ಳುವವನು /ಸ್ವಾರ್ಥಪರ<br><b>निष्पत्तिः - </b>डुभृञ् (धारणपोषणयोः) - "इन्" मुमागमश्च (३-२-२६)<br><b>व्युत्पत्तिः - </b>आत्मानं बिभर्ति<br><b>प्रयोगाः - </b>"आत्मम्भरिस्त्वं पिशितैर्नराणाम्"<br><b>उल्लेखाः - </b>भट्टि० २-३३<br><br>

आत्मयाजिन्
आत्मयाजिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಾರ್ಪಣ ಭಾವನೆಯಿಂದ ಜ್ಯೋತಿಷ್ಟೋಮಾದಿ ಯಾಗಗಳನ್ನು ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>यज (देवपूजादौ) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>आत्मानं ब्रह्मरूप्रेण भावयन् यजते<br><br>आत्मयाजिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲಾ ಪ್ರಾಣಿಗಳಲ್ಲಿಯೂ ತನ್ನನ್ನೂ ತನ್ನಲ್ಲಿ ಎಲ್ಲಾ ಪ್ರಾಣಿಗಳನ್ನೂ ಸಮವಾಗಿ ಕಾಣುವವನು<br><b>प्रयोगाः - </b>"सर्वभूतेषु चात्मानं सर्वभूतानि चात्मनि । समं पश्यन्नात्मयाजी स्वाराज्यमधिगच्छति ॥"<br><b>उल्लेखाः - </b>मनु० १२-९१<br><br>

आत्मयोनि
आत्मयोनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ /ಚತುರ್ಮುಖ<br><br>आत्मयोनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>आत्मयोनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ /ಶಿವ<br><br>आत्मयोनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ /ಮನ್ಮಥ<br><b>व्युत्पत्तिः - </b>आत्मा योनिरस्य<br><b>प्रयोगाः - </b>"ददर्श चक्रीकृतचारुचापं प्रहर्तुमभ्युद्यतमात्मयोनिम्"<br><b>उल्लेखाः - </b>कुमा० ३-७०<br><br>

आत्मराम
आत्मराम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಜ್ಞಾನದಿಂದ ಸಂತೋಷಪಡುವವನು<br><b>व्युत्पत्तिः - </b>आत्मनि रामो रमणं यस्य<br><br>

आत्मलाभ
आत्मलाभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜನ್ಮ /ಉತ್ಪತ್ತಿ<br><b>व्युत्पत्तिः - </b>आत्मनो लाभः<br><b>प्रयोगाः - </b>"रूपादीन् विषयान् निरूप्य करणैः आत्मलाभस्त्वया"<br><b>उल्लेखाः - </b>मुद्रा० ३-१<br><br>आत्मलाभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಕ್ತಿ ಪಡೆಯುವಿಕೆ<br><br>

आत्मलोमन्
आत्मलोमन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಗೂದಲು<br><br>आत्मलोमन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಡ್ಡ /ದಾಡಿ<br><b>व्युत्पत्तिः - </b>आत्मनो लोम<br><br>

आत्मवत्
आत्मवत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>आत्मन् - "मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>आत्मा अस्मिन् स्वस्मिन् अस्ति<br><b>प्रयोगाः - </b>"अनुत्तमो दुराधर्षः कृतज्ञः कृतिरात्मवान्"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"स्वे महिम्नि प्रतिष्ठानात् आत्मवानभिधीयते"<br><br>आत्मवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ತವನ್ನು ಜಯಿಸಿದ /ಮನೋನಿಗ್ರಹವುಳ್ಳ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>आत्मा वश्यतयाऽस्त्यस्य<br><b>प्रयोगाः - </b>"अथ वीक्ष्य रघुः प्रतिष्ठितं प्रकृतिष्वात्मजमात्मावत्तया"<br><b>उल्लेखाः - </b>रघु० ८-१०<br><br>आत्मवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಕಾರ ಹೊಂದದ ಮನಸ್ಸುಳ್ಳ /ದೃಢಚಿತ್ತನಾದ<br><br>आत्मवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆತ್ಮಜ್ಞಾನವನ್ನು ಉಂಟುಮಾಡುವ ಶಾಸ್ತ್ರ<br><b>व्युत्पत्तिः - </b>आत्मा प्रकाश्यतास्त्यस्य<br><b>प्रयोगाः - </b>"उदये मदवाच्यमुज्झता श्रुतिमाविष्कृतमात्मवत्तया"<br><b>उल्लेखाः - </b>रघु० ८-८४<br><br>आत्मवत्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ತನ್ನಂತೆ /ತನಗೆಸಮಾನವಾಗಿ<br><b>निष्पत्तिः - </b>"वतिः" (५-१-११५)<br><b>व्युत्पत्तिः - </b>आत्मना तुल्यः<br><b>प्रयोगाः - </b>"आत्मवत् सर्वभूतानि यः पश्यति स पश्यति"<br><br>

आत्मविक्रय
आत्मविक्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನ ದೇಹವನ್ನು ಮಾರಿಕೊಳ್ಳುವಿಕೆ<br><b>व्युत्पत्तिः - </b>आत्मनो देहस्य विक्रयः<br><b>प्रयोगाः - </b>"गोवधोऽयाज्यसंयाज्यपारदार्यात्मविक्रयाः"<br><b>उल्लेखाः - </b>मनु० ११-५९<br><br>

आत्मविद्
आत्मविद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆತ್ಮನನ್ನು ಅರಿತಿರುವ<br><b>निष्पत्तिः - </b>विद (ज्ञाने) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>आत्मानं वेत्ति<br><br>आत्मविद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನ ಸ್ವರೂಪವನ್ನು ಅರಿತಿರುವ<br><b>प्रयोगाः - </b>"य इहात्मविदो विपक्षमध्ये सह संवृद्धियुजोऽपि भूभुजः स्युः"<br><b>उल्लेखाः - </b>माघ० २-११६<br><br>

आत्मविद्या
आत्मविद्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮವಿದ್ಯೆ /ಅಧ್ಯಾತ್ಮ ವಿದ್ಯೆ<br><b>व्युत्पत्तिः - </b>आत्मनो विद्या<br><b>प्रयोगाः - </b>"आन्विक्षिकीं चात्मविद्यां वार्तारम्भांश्च लोकतः"<br><b>उल्लेखाः - </b>मनु० ७-४३<br><br>

आत्मवीर
आत्मवीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರ /ಮಗ<br><br>आत्मवीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಾವಮೈದುನ /ಹೆಂಡತಿಯ ಸಹೋದರ<br><br>आत्मवीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿದೂಷಕ<br><br>आत्मवीर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಬಲಶಾಲಿ<br><b>विस्तारः - </b>"आत्मवीरः प्राणवति स्यालके च विदूषके" - मेदि० ।<br><br>

आत्मवृत्त
आत्मवृत्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮಕಥೆ<br><b>व्युत्पत्तिः - </b>आत्मनो वृत्तं चरितम्<br><br>

आत्मवृत्ति
आत्मवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ತವೃತ್ತಿ /ಮನಸ್ಸಿನ ಸ್ಥಿತಿ<br><b>व्युत्पत्तिः - </b>आत्मनो वृत्तिः<br><b>प्रयोगाः - </b>"जगच्छरण्यस्य निराशिषः सतः किमेभिराशोपहतात्मवृत्तिभिः"<br><b>उल्लेखाः - </b>कुमा० ५-७६<br><br>आत्मवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನ ವ್ಯಾಪಾರ /ತನ್ನ ಕೆಲಸ<br><b>प्रयोगाः - </b>"विस्मापयन् विस्मितमात्मवृत्तौ सिंहोरुसत्त्वं निजगाद सिंहः"<br><b>उल्लेखाः - </b>रघु० २-३३<br><br>आत्मवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನ ಉದ್ಯೋಗ<br><br>

आत्मशक्ति
आत्मशक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮನ ಮಾಯೆ /ಜಗತ್ತನ್ನು ಸೃಷ್ಟಿಸುವ ಶಕ್ತಿ<br><br>आत्मशक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮಬಲ /ದೇಹಬಲ<br><br>आत्मशक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮನೋಬಲ<br><b>व्युत्पत्तिः - </b>आत्मनो शक्तिः<br><b>प्रयोगाः - </b>"दैवं निहत्य कुरु पौरुषमात्मशक्त्या"<br><b>उल्लेखाः - </b>पञ्चतं०<br><br>

आत्मशक्या
आत्मशक्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶತಾವರೀ ಗಿಡ<br><br>

आत्मशुद्धि
आत्मशुद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹಶುದ್ಧಿ<br><br>आत्मशुद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮನಃಶುದ್ಧಿ<br><br>आत्मशुद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿಶಕ್ತಿ<br><b>व्युत्पत्तिः - </b>आत्मनो देहस्य मनसः बुद्धेर्वा शुद्धिः<br><b>प्रयोगाः - </b>"अद्भिः शुद्ध्यन्ति गात्राणि बुद्धिर्ज्ञानेन शुद्ध्यति । अहिंसया च भूतात्मा मनः सत्येन शुद्ध्यति ॥"<br><br>आत्मशुद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮನಲ್ಲಿ ಹಿಂದಿನ ಜನ್ಮಗಳಲ್ಲಿ ಸೇರಿಕೊಂಡಿರುವ ಕರ್ಮಗಳ ನಾಶದಿಂದ ಉಂಟಾಗುವ ಬುದ್ಧಿ<br><b>प्रयोगाः - </b>"योगिनः कर्म कुर्वन्ति सङ्गं त्यक्त्वात्मशुद्धये ॥"<br><b>उल्लेखाः - </b>गीता० ५-११<br><br>

आत्मश्लाघा
आत्मश्लाघा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನನ್ನು ತಾನೇ ಹೊಗಳಿಕೊಳ್ಳುವಿಕೆ<br><b>व्युत्पत्तिः - </b>आत्मनः श्लाघा<br><br>

आत्मश्लाघन
आत्मश्लाघन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನನ್ನು ತಾನೇ ಹೊಗಳಿಕೊಳ್ಳುವಿಕೆ<br><b>व्युत्पत्तिः - </b>आत्मनः श्लाघनम्<br><br>

आत्मस्तुति
आत्मस्तुति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನನ್ನು ತಾನೇ ಹೊಗಳಿಕೊಳ್ಳುವಿಕೆ<br><b>व्युत्पत्तिः - </b>आत्मनः स्तुतिः<br><br>

आत्मसंयम
आत्मसंयम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನೋನಿಗ್ರಹ /ಮನಸ್ಸನ್ನು ಸ್ವಾಧೀನದಲ್ಲಿಟ್ಟುಕೊಳ್ಳುವುದು<br><b>व्युत्पत्तिः - </b>आत्मनो मनसः संयमः<br><b>प्रयोगाः - </b>"आत्मसंयमयोगाग्नौ जुह्वति ज्ञानदीपिते"<br><b>उल्लेखाः - </b>गीता० ४-२७<br><br>

आत्मस्मुदभव
आत्मस्मुदभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>आत्मस्मुदभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ /ಶಿವ<br><b>व्युत्पत्तिः - </b>आत्मना समुद्भवति<br><br>आत्मस्मुदभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ /ಚತುರ್ಮುಖ<br><b>व्युत्पत्तिः - </b>आत्मा परमात्मा समुद्भवो यस्य<br><br>आत्मस्मुदभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರ /ಮಗ<br><br>आत्मस्मुदभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥ<br><b>व्युत्पत्तिः - </b>आत्मा देहः मनो वा समुद्भवो यस्य<br><br>आत्मस्मुदभव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮನಿಂದ ಉಂಟಾದ ಆಕಾಶ ಮೊದಲಾದುದು<br><br>आत्मस्मुदभव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನಸ್ಸಿನಲ್ಲಿ ಉಂಟಾದ ಸುಖದುಃಖಗಳು<br><br>

आत्मसमुद्भवा
आत्मसमुद्भवा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ಯೆ /ಮಗಳು<br><br>आत्मसमुद्भवा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿ<br><br>

आत्मसम्भव
आत्मसम्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>आत्मस्मुदभव ಪದದ ಅರ್ಥ<br><b>प्रयोगाः - </b>"चकार नाम्ना रघुमात्मसम्भवम्"<br><b>उल्लेखाः - </b>रघु० ३-२१<br><br>

आत्मसम्पन्न
आत्मसम्पन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿಶಾಲಿ /ಮೇಧಾವಿ<br><b>व्युत्पत्तिः - </b>आत्मना सम्पन्नः<br><b>प्रयोगाः - </b>"तमात्मसम्पन्नमनिन्दितात्मा कृत्वा युवनं युवराजमेव"<br><b>उल्लेखाः - </b>रघु० १८-१८<br><br>

आत्मसात्
आत्मसात्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ತನ್ನ ಅಧೀನವಾಗಿ<br><b>निष्पत्तिः - </b>आत्मन् - "सातिः" (५-४-५४)<br><b>प्रयोगाः - </b>"आत्मसात् करोति"<br><br>

आत्मसिद्ध
आत्मसिद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಾನಾಗಿಯೇ ಸಿದ್ಧಿಸಿದ /ಯತ್ನವಿಲ್ಲದೆ ಉಂಟಾದ<br><br>

आत्मसुख
आत्मसुख<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಕ್ಷಸುಖ /ಪರಮಾತ್ಮ ಪ್ರಾಪ್ತಿರೂಪವಾದ ಸುಖ<br><br>आत्मसुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆತ್ಮಲಾಭದಿಂದ ಸುಖವುಳ್ಳ<br><br>

आत्मस्थ
आत्मस्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆತ್ಮನಿಷ್ಠನಾದ /ಪರಮಾತ್ಮ ಧ್ಯಾನದಲ್ಲಿರುವ /ಬ್ರಹ್ಮಜ್ಞಾನಕ್ಕಾಗಿ ಪ್ರಯತ್ನಪಡುವ<br><b>निष्पत्तिः - </b>ष्ठा (गतिनिवृत्तौ) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>आत्मने तिष्ठति<br><br>आत्मस्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನಸ್ಸಿನಲ್ಲಿರುವ<br><br>आत्मस्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೇಹದಲ್ಲಿರುವ<br><br>

आत्महत्या
आत्महत्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಣತ್ಯಾಗ /ಪ್ರಾಣವನ್ನು ಕಳೆದುಕೊಳ್ಳುವುದು<br><b>व्युत्पत्तिः - </b>आत्मनो हत्या हननम्<br><br>

आत्महन्
आत्महन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮಜ್ಞಾನವನ್ನು ಸಂಪಾದಿಸದೆ ಆತ್ಮನನ್ನು ವ್ಯರ್ಥಪಡಿಸಿಕೊಳ್ಳುವವನು<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>आत्मानं हतवान्<br><b>प्रयोगाः - </b>"नृदेहमाद्यं सुलभं प्लवं सुकल्पं गुरुकर्णधारम् । मयानुकूलेन नभस्वतेरितं पुमान् भवाब्धिं‍न तरेत् स आत्महा ॥"<br><b>उल्लेखाः - </b>भाग० ११-२०-१७<br><br>

आत्माधीन
आत्माधीन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರ /ಮಗ<br><br>आत्माधीन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿದೂಷಕ<br><br>आत्माधीन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಾವಮೈದುನ /ಹೆಂಡತಿಯ ಸಹೋದರ<br><br>आत्माधीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವತಂತ್ರ<br><br>आत्माधीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಕ್ತಿವಂತ<br><b>निष्पत्तिः - </b>आत्माधि - "खः" (५-४-७)<br><b>विस्तारः - </b>"आत्माधीनः सुते प्राणाधारे स्याले विदूषके" - हेम० ।<br><br>

आत्मानुरूप
आत्मानुरूप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನಗೆ ಯೋಗ್ಯವಾದ /ತನಗೆ ತಕ್ಕುದಾದ<br><b>व्युत्पत्तिः - </b>आत्मनोऽनुरूपः<br><b>प्रयोगाः - </b>"तस्यामात्मानुरूपायामात्मजन्मसमुत्सुकः"<br><b>उल्लेखाः - </b>रघु० १-३३<br><br>

आत्मापहारक
आत्मापहारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನ ವಾಸ್ತವವಿಚಾರವನ್ನು ಮರೆಮಾಚುವವನು<br><b>निष्पत्तिः - </b>अप + हृञ् (हरणे) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>आत्मानमपहरति<br><b>प्रयोगाः - </b>"योऽन्यथासन्तमात्मानमन्यथा सत्सु भाषते । स पापकृत्तमो लोके स्तेन आत्मापहारकः ॥"<br><b>उल्लेखाः - </b>मनु० ४-२५५<br><br>

आत्मापहारिन्
आत्मापहारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನ ವಾಸ್ತವವಿಚಾರವನ್ನು ಮರೆಮಾಚುವವನು<br><b>निष्पत्तिः - </b>"णिनिः" (३-२-७८)<br><b>प्रयोगाः - </b>"किं तेन न कृतं पापं चौरेणात्मापहारिणा"<br><br>

आत्मापहारिणी
आत्मापहारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನ ವಾಸ್ತವವಿಚಾರವನ್ನು ಮರೆಮಾಚುವವನಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आत्माराम
आत्माराम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಜ್ಞಾನಕ್ಕಾಗಿ ಧ್ಯಾನಸಕ್ತನಾದ ಯೋಗಿ<br><b>व्युत्पत्तिः - </b>आत्मैवारामो वनं‍यस्य । आत्मनि आरमन्ते वा<br><b>प्रयोगाः - </b>"आत्मारामा विहितरतयो निर्विकल्पे समाधौ"<br><b>उल्लेखाः - </b>वेणी० १-२३<br><br>आत्माराम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಭಾವದಿಂದ ಆನಂದಪಡುತ್ತಿರುವ<br><b>व्युत्पत्तिः - </b>आत्मनि आरामः आनन्दानुभवो यस्य<br><br>

आत्माशिन्
आत्माशिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ಸ್ಯ /ಮೀನು<br><b>निष्पत्तिः - </b>अश (भोजने) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>आत्मानं स्वकुलमश्नाति<br><b>प्रयोगाः - </b>"मत्स्या इव जना नित्यं भक्षयन्ति परस्परम्"<br><b>उल्लेखाः - </b>रामा०<br><br>

आत्माश्रय
आत्माश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮಾವಲಂಬನ<br><b>व्युत्पत्तिः - </b>आत्मनः आश्रयः<br><br>आत्माश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನ ಸಿದ್ಧಿಗಾಗಿ ತನ್ನನ್ನೂ ತನ್ನ ಜ್ಞಾನವನ್ನೂ ಆಶ್ರಯಿಸುವಿಕೆ<br><b>व्युत्पत्तिः - </b>आत्मा आश्रयो यस्य<br><br>आत्माश्रय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವತಂತ್ರ<br><b>व्युत्पत्तिः - </b>आत्मैवाश्रयो यस्य<br><br>आत्माश्रय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನ ಮನಸ್ಸಿನ ಆಶ್ರಯಪಡೆದ<br><br>

आत्मीय
आत्मीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"छः" (४-२-११४)<br><b>व्युत्पत्तिः - </b>आत्मनः अयम्<br><b>प्रयोगाः - </b>"आत्मीयपर्यङ्कभुजङ्गकल्पौ"<br><b>उल्लेखाः - </b>याद० ४-१००<br><br>

आत्मेश्वर
आत्मेश्वर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ತವನ್ನು ಸ್ವಾಧೀನದಲ್ಲಿ ಇಟ್ಟಿರುವ /ಮನೋನಿಗ್ರಹವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>आत्मनः ईश्वरः<br><b>प्रयोगाः - </b>"आत्मेश्वराणां न हि जातु विघ्नां समाधिभेदप्रभवो भवन्ति"<br><b>उल्लेखाः - </b>कुमा० ३-४०<br><br>

आत्मोदय
आत्मोदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನ ಅಭಿವೃದ್ಧಿ<br><b>व्युत्पत्तिः - </b>आत्मनः उदयः<br><b>प्रयोगाः - </b>"आत्मोदयः परज्यानिः द्वयं नीतिरितीयती"<br><b>उल्लेखाः - </b>माघ० २-३०<br><br>

आत्मोद्भव
आत्मोद्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರ /ಮಗ<br><br>आत्मोद्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ /ಮನ್ಮಥ<br><br>आत्मोद्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುಃಖ ಶೋಕ ಮುಂತಾದುದು<br><b>व्युत्पत्तिः - </b>आत्मा देहः मनो व उद्भवो यस्य<br><br>आत्मोद्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹದಲ್ಲಿ ಹುಟ್ಟಿದ<br><br>आत्मोद्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನಸ್ಸಿನಲ್ಲಿ ಉಂಟಾದ<br><br>

आत्मोद्भवा
आत्मोद्भवा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ಯೆ /ಮಗಳು<br><br>आत्मोद्भवा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿ /ಜ್ಞಾನ<br><br>

आत्मोपजीविन्
आत्मोपजीविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನ ಶರೀರಶ್ರಮದಿಂದ ಜೀವಿಸುವವನು<br><b>निष्पत्तिः - </b>उप + जीव (प्राणधारणे) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आत्मना स्वदेहव्यापारेण उपजीअति<br><br>

आत्मोपम
आत्मोपम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಗ /ಪುತ್ರ<br><br>आत्मोपम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನಗೆ ಸಮಾನನಾದ<br><b>व्युत्पत्तिः - </b>आत्म देहः उपमा यस्य<br><br>

आत्मौपम्य
आत्मौपम्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನ ಹೋಲಿಕೆ<br><b>व्युत्पत्तिः - </b>आत्मन औपम्यम्<br><b>प्रयोगाः - </b>"आत्मौपम्येन सर्वत्र समं पश्यति योऽर्जुन"<br><b>उल्लेखाः - </b>गीता० ६-३२<br><br>

आत्यन्तिक
आत्यन्तिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆತ್ಯಂತವಾದ /ಅಧಿಕವಾದ<br><b>निष्पत्तिः - </b>अत्यन्तम् - "ठक्" (५-४-३४)<br><b>प्रयोगाः - </b>"सा विष्णोरिव विष्णुगुप्तहतकस्यात्यन्तिकश्रेयसे"<br><b>उल्लेखाः - </b>मुद्रा० २-१५<br><br>आत्यन्तिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತ್ಯುತ್ತಮವಾದ /ಶ್ರೇಷ್ಠವಾದ<br><b>व्युत्पत्तिः - </b>अन्तमतिक्रान्तमत्यन्तम् । अत्यन्तमेव<br><b>प्रयोगाः - </b>"सुखमात्यन्तिकं यत्तत् बुद्धिग्राह्यमतीन्द्रियम्"<br><b>उल्लेखाः - </b>गीता० ६-२१<br><br>

आत्यन्तिकदुःखनिवृत्ति
आत्यन्तिकदुःखनिवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಕ್ಷ /ಮುಕ್ತಿ<br><b>व्युत्पत्तिः - </b>आत्यन्तिकी दुःखनिवृत्तिः<br><br>

आत्यन्तिकप्रलय
आत्यन्तिकप्रलय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಲ್ಕು ವಿಧ ಪ್ರಳಯಗಳಲ್ಲೊಂದು<br><br>

आत्यन्तिकसुख
आत्यन्तिकसुख<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿರತಿಶಯವಾದ ಸುಖ /ಶಾಶ್ವತ ಸುಖ<br><b>व्युत्पत्तिः - </b>आत्यन्तिक च तत् सुखं च<br><b>प्रयोगाः - </b>"सुखमात्यन्तिकं यत्तत् बुद्धिग्राह्यमतीन्द्रियम्"<br><b>उल्लेखाः - </b>गीता० ६-२१<br><br>

आत्ययिक
आत्ययिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಕ್ಕೆ ಕಾರಣವಾದ ಕೆಲಸ<br><b>निष्पत्तिः - </b>"ठक्" (५-१-१०१)<br><b>व्युत्पत्तिः - </b>अत्ययो नाशः प्रयोजनमस्त्यस्य<br><b>प्रयोगाः - </b>"कच्चिदात्यन्तिकं श्रुत्वा तदर्थमनुचिन्त्यच । प्रियाण्यनुभवन् शेषे न त्वमन्तःपुरे नृप ॥"<br><b>उल्लेखाः - </b>भा० सभा० ५-८८<br><br>

आत्रेय
आत्रेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತ್ರಿಮಹರ್ಷಿಯ ಮಗ ಚಂದ್ರ, ದುರ್ವಾಸಮಿನಿ ,ದತ್ತಾತ್ರೇಯ<br><b>निष्पत्तिः - </b>अत्रि - "ढक्" (४-१-१२२)<br><b>व्युत्पत्तिः - </b>अत्रेरपत्यम्<br><br>आत्रेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತ್ರಿಮಹರ್ಷಿಯ ಮಗ ಚಂದ್ರ, ದುರ್ವಾಸಮಿನಿ ,ದತ್ತಾತ್ರೇಯ<br><br>

आत्रेयी
आत्रेयी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನದಿ<br><br>आत्रेयी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅತ್ರಿಮಹರ್ಷಿಯ ಪತ್ನಿ<br><br>आत्रेयी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅತ್ರಿಮಹರ್ಷಿಯ ಮಗಳು<br><br>आत्रेयी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಜಸ್ವಲೆ /ಋತುಮತಿಯಾದ ಹೆಂಗಸು<br><br>

आथर्वण
आथर्वण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಥರ್ವವೇದವನ್ನು ಅಧ್ಯಯನ ಮಾಡಿದವನ ಧರ್ಮ<br><br>आथर्वण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಥರ್ವವೇದ<br><b>निष्पत्तिः - </b>अथर्वन् - "ठक्" (४-२-६३) । "अण्" इकलोपश्च (४-३-१३३)<br><b>व्युत्पत्तिः - </b>अथर्वणा प्रोक्तो वेदः अथर्वा । तमधीते आथर्वणिकः । तस्यायमाथर्वणो धर्मः आम्नायो वा ।<br><br>

आथर्वण
आथर्वण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಥರ್ವಶಾಖೆಯ ಪುರೋಹಿತ<br><br>आथर्वण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥರ್ವವೇದಮಂತ್ರಗಳ ಗುಂಪು<br><b>निष्पत्तिः - </b>"अण्" (४-२-३८)<br><b>व्युत्पत्तिः - </b>अथर्वणां समूहः<br><br>आथर्वण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಥರ್ವವೇದವಿಹಿತಕರ್ಮ /ಆಭಿಚಾರಿಕೃತ್ಯ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>अथर्वण इदम्<br><br>

आथर्वणिक
आथर्वणिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಥರ್ವವೇದಾಧ್ಯಯನ ಮಾಡಿದ ಬ್ರಾಹ್ಮಣ<br><b>निष्पत्तिः - </b>"ठक्" (४-२-६३)<br><b>व्युत्पत्तिः - </b>अथर्वणा प्रोक्तो वेदः अथर्वा । तमधीते<br><br>

आदंश
आदंश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಚ್ಚುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + दंश (दशने) "घञ्" (३-३-१८)<br><br>आदंश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಂತ /ಹಲ್ಲು<br><b>निष्पत्तिः - </b>"घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>आदश्यतेऽनेन<br><br>आदंश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಚ್ಚಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अधि० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>आदश्यतेऽत्र<br><br>

आदर
आदर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹ /ಕುತೂಹಲ<br><b>निष्पत्तिः - </b>आ + दृङ् (अनादरे) - "अप्" (३-३-५८)<br><b>प्रयोगाः - </b>"तद्दर्शनादभूच्छम्भोर्भूयान् दारार्थमादरः"<br><b>उल्लेखाः - </b>कुमा० ६-१३<br><br>आदर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ನಣೆ /ಗೌರವ<br><b>प्रयोगाः - </b>"प्रायः प्रत्ययमाधत्ते स्वगुणेषूत्तमादरः"<br><b>उल्लेखाः - </b>कुमा० ६-२०<br><br>आदर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯತ್ನ<br><b>प्रयोगाः - </b>"गृहयन्त्रपताकाश्रीरपौरादरनिर्मिता"<br><b>उल्लेखाः - </b>कुमा० ६-४१<br><br>आदर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ<br><br>आदर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿ /ವಿಶ್ವಾಸ<br><b>प्रयोगाः - </b>"अमर्षशून्येन जनस्य जन्तुना न जातहार्देन न विद्विषादरः"<br><b>उल्लेखाः - </b>किरा० १-३३<br><br>

आदरण
आदरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೌರವ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>आदरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿ /ವಿಶ್ವಾಸ<br><br>

आदरणीय
आदरणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೌರವಾರ್ಹ /ಮರ್ಯಾದೆಗೆ ಯೋಗ್ಯನಾದ<br><b>निष्पत्तिः - </b>आ + दृङ् (अनादरे) - "अनीयर्" (३-१-९६)<br><br>आदरणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿಸಲ್ಪಡುವ<br><br>

आदर्तव्य
आदर्तव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>आदरणीय ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>आ + दृङ् (अनादरे) - "तव्यः" (३-१-९६)<br><br>

आदर्श
आदर्श<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ನಡಿ<br><b>निष्पत्तिः - </b>आ + दृशिर् (प्रेक्षणे) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>आदृश्यतेऽत्र रूपम्<br><b>प्रयोगाः - </b>"आदृश्यतादर्शतलामलेषु च्छायेव या स्वर्जलधेर्जलेषु"<br><b>उल्लेखाः - </b>माघ० ३=३५<br><br>आदर्श<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಟೀಕೆ /ಟಿಪ್ಪಣಿ<br><b>व्युत्पत्तिः - </b>आदृश्यते सम्यक् ज्ञायते ग्रन्थार्थोऽत्र<br><br>आदर्श<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುಸ್ತಕದ ಮೂಲ ಪ್ರತಿ<br><br>आदर्श<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾದರಿ<br><br>आदर्श<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಂಥದ ಪ್ರತಿ<br><br>आदर्श<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಶದ ಎಲ್ಲೆ<br><b>विस्तारः - </b>"आदर्शो दर्पणे टीकाप्रतिपुस्तकयोरपि" - मेदि० ।<br><br>

आदाञ्|आ + दाञ्|दाने 
आ + दाञ् - दाने (जु० उभ० सक० अनि०)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>दाञ्<br><br>

आदातृ
आदातृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಳ್ಳುವವನು<br><b>निष्पत्तिः - </b>आ + डुदाञ् (दाने) - "तृच्" (३-१-१३३)<br><b>प्रयोगाः - </b>"आअदाननित्याच्चादातुराहरेदप्रत्यच्छतः"<br><b>उल्लेखाः - </b>मनु० ११-१५<br><br>

आदात्री
आदात्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಳ್ಳುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आदान
आदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಳ್ಳುವುದು /ಸ್ವೀಕರಿಸುವುದು<br><b>निष्पत्तिः - </b>आ + डुदाञ् (दाने) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"आदानं हि विसर्गाय सतां वारिमुचामिव"<br><b>उल्लेखाः - </b>रघु० ४-८६<br><br>आदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಆಭರಣ<br><b>विस्तारः - </b>"आदानं ग्रहणेऽपि स्यादलङ्कारे च वाजिनाम्" - मेदि० ।<br><br>आदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ /ಸಮ್ಮತಿ /ಒಪ್ಪಿಗೆ<br><br>आदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಲ್ಲಿನಲ್ಲಿ ಬಾಣವನ್ನು ಹೂಡುವುದು<br><b>विस्तारः - </b>"आदानमिषोर्ज्यायां समूहनम्" - वैज० ।<br><br>आदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಖಾಯಿಲೆಯ ಲಕ್ಷಣ /ಅನಾರೋಗ್ಯದ ಗುರುತು<br><br>आदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + दाप् (लवने) - "ल्युट्" (३-३-११५)<br><br>

आदाय
आदाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಳ್ಳುವುದು /ಸ್ವೀಕರಿಸುವುದು<br><b>निष्पत्तिः - </b>आ + डुदाञ् (दाने) - भावे "घञ्" (३-३-१८)<br><br>आदाय<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಂಡು /ಸ್ವೀಕರಿಸಿ<br><b>निष्पत्तिः - </b>आ + डुदाञ् (दाने) - "ल्यप्" (७-१-३७)<br><b>प्रयोगाः - </b>"आदाय शालिस्तबकानदूरात् प्राप्ता शुकश्रेणिरसौ विभाति"<br><b>उल्लेखाः - </b>याद० १८-७६<br><br>

आदायचर
आदायचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಂಡು ಹೊರಡುವವನು<br><b>निष्पत्तिः - </b>चर (गतौ) - "टः" (३-२-१७)<br><b>व्युत्पत्तिः - </b>आदाय चरति<br><b>प्रयोगाः - </b>"द्विषन् वनेचराग्र्याणां त्वमादायचरो वने"<br><b>उल्लेखाः - </b>भट्टि० ५-९७<br><br>

आदायचरी
आदायचरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಂಡು ಹೊರಡುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

आदायिन्
आदायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಳ್ಳುವ /ಸ್ವೀಕರಿಸುವ<br><b>निष्पत्तिः - </b>आ + डुदाञ् (दाने) - "णिनिः" (३-२-७८)<br><br>

आदायिनी
आदायिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಳ್ಳುವ /ಸ್ವೀಕರಿಸುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आदि
आदि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊದಲು /ಪ್ರಾರಂಭ<br><b>निष्पत्तिः - </b>आ + डुदाञ् (दाने) - "किः" (३-३-९२)<br><b>प्रयोगाः - </b>"आदौ लक्ष्मीरभजत हरिं रुक्मिणीरूपदृश्या"<br><b>उल्लेखाः - </b>याद० १४-७८<br><br>आदि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರಣ<br><b>प्रयोगाः - </b>"न मे विदुः सुरगणाः प्रभवं न महर्षयः । अहमादिर्हि देवानां महर्षीणां च सर्वशः ॥"<br><b>उल्लेखाः - </b>गीता० १०-२<br><br>आदि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಮೀಪ್ಯ /ಹತ್ತಿರ<br><br>आदि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊದಲನೆಯ ಭಾಗ<br><b>प्रयोगाः - </b>"आदिरन्त्येन सहेता"<br><b>उल्लेखाः - </b>पा० सू० १-१-७१<br><br>आदि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ /ಅವಲಂಬನ<br><b>प्रयोगाः - </b>"विष्णुरादिः पृयासूनोः भीष्मादिश्च सुयोधनः । ते जयन्ति रणे शत्रून् येषां विष्णुः सदाश्रयः ॥"<br><br>आदि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊದಲನೆಯ<br><b>प्रयोगाः - </b>"जगदादिरनादिस्त्वं जगदन्तो निरन्तकः"<br><b>उल्लेखाः - </b>कुमा० २-९<br><br>आदि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಖ್ಯವಾದ /ಪ್ರಧಾನವಾದ<br><br>आदि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸದೃಶವಾದ<br><b>प्रयोगाः - </b>"भूवादयो धातवः"<br><b>उल्लेखाः - </b>पा० सू० १-३-१<br><br>

आदिकर्तृ
आदिकर्तृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊದಲನೆಯದಾಗಿ ಸೃಷ್ಟಿಸುವವನು /ಈಶ್ವರ /ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>आदिः कर्ता<br><b>प्रयोगाः - </b>"गरीयसे ब्रह्मणोऽप्यादिकर्त्रे"<br><b>उल्लेखाः - </b>गीता० ११-३७<br><br>

आदिकर्मन्
आदिकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊದಲನೆಯ ಕೆಲಸ /ಕೆಲಸದ ಪ್ರಾರಂಭ<br><b>प्रयोगाः - </b>"आदिकर्मणि क्तः कर्तरि च"<br><b>उल्लेखाः - </b>पा० सू० ३-४-७१<br><br>आदिकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊದಲು ನಡೆಸಿದ ಕೆಲಸ<br><br>

आदिकवि
आदिकवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ /ಚತುರ್ಮುಖ<br><b>प्रयोगाः - </b>"जन्माद्यस्य यतोऽन्वयादितरतश्चार्थेष्वभिज्ञः स्वराट् तेने ब्रह्म हृदा च आदिकवये मुह्यन्ति यत्सूरयः"<br><b>उल्लेखाः - </b>भाग० १-१<br><br>आदिकवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಲ್ಮೀಕಿ ಮಹರ್ಷಿ<br><br>

आदिकारण
आदिकारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊದಲನೆಯ ಕಾರಣ<br><br>आदिकारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಗತ್ತಿನ ಸೃಷ್ಟಿಗೆ ಕಾರಣನಾದ ಪರಮಾತ್ಮ<br><br>आदिकारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಂಖ್ಯಮತದಲ್ಲಿ ಮೂಲಪ್ರಕೃತಿ ಯಪ್ರಧಾನ<br><br>आदिकारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜೈನಮತದಲ್ಲಿ ಪುದ್ಗಲ ರೂಪಾಅದ ಪರಮಾಣು<br><br>आदिकारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೈಯಾಯಿಕ ಮತ್ತು ವೈಶೇಷಿಕ ಮತದಲ್ಲಿ ನಿಮಿತ್ತಕಾರಣನಾದ ಈಶ್ವರ ಮತ್ತು ಉಪಾದಾನಕಾರಣವಾದ ಪರಮಾಣು<br><br>

आदिकाव्य
आदिकाव्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಲ್ಮೀಕಿವಿರಚಿತವಾದ ಶ್ರೀಮದ್ರಾಮಾಯಣ<br><br>

आदितस्
आदितस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮೊದಲು /ಪ್ರಾರಂಭದಲ್ಲಿ<br><b>निष्पत्तिः - </b>आदि - "तस्" (वा० ५-४-४४)<br><b>व्युत्पत्तिः - </b>आदौ<br><b>प्रयोगाः - </b>"पतीन् प्रजानामसृजं महर्षीनादितो दश"<br><b>उल्लेखाः - </b>मनु० १-३४<br><br>आदितस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮೊದಲಿನಿಂದ /ಪ್ರಾರಂಭದಿಂದ<br><br>

आदिता
आदिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆದ್ಯತೆ /ಕಾರಣತ್ವ<br><br>आदिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊದಲನೆಯದಾಗಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"आदितामजननाय देहिनामन्ततां च दधतेऽनपायिने"<br><b>उल्लेखाः - </b>माघ० १४-६५<br><br>

आदिताल
आदिताल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಗೀತಶಾಸ್ತ್ರೋಕ್ತವಾದ ಒಂದು ತಾಳ<br><b>प्रयोगाः - </b>"एक एव लघुर्यत्र आदितालः स उच्यते"<br><br>

आदितेय
आदितेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ /ಅದಿತಿಯ ಪುತ್ರ<br><b>निष्पत्तिः - </b>"ढक्" (४-१-१२०)<br><b>व्युत्पत्तिः - </b>आदित्या अपत्यम्<br><br>आदितेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>

आदित्य
आदित्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ /ಅದಿತಿಯ ಪುತ್ರ<br><br>आदित्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>"ण्यः" (४-१-८५)<br><b>व्युत्पत्तिः - </b>आदित्या अपत्यम्<br><b>प्रयोगाः - </b>"जिगीषुरेको दिनकृदादित्येष्विव कल्पते"<br><b>उल्लेखाः - </b>माघ० २-८१<br><br>आदित्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>"स्वयम्भूउः शम्भुरादित्यः" । "आदित्यानामहं विष्णुः ज्योतिषां रविरंशुमान्" ।<br><b>उल्लेखाः - </b>वि० स०, गीता० १०-२१<br><br>आदित्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾಶ<br><b>प्रयोगाः - </b>"अग्नौ प्रास्ताहुतिः सम्यगादित्यमुपतिष्ठते । आदित्याज्जायते वृष्टिः वृष्टेरन्नं ततः प्रजाः ॥"<br><b>उल्लेखाः - </b>मनु० ३-७६<br><br>आदित्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಕ್ಕದ ಗಿಡ<br><br>आदित्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಾನುವಾರ<br><br>आदित्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಸ್ತನಕ್ಷತ್ರ<br><br>

आदित्यकेतु
आदित्यकेतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಸಾರಥಿಯಾದ ಅರುಣ<br><b>व्युत्पत्तिः - </b>आदित्यस्य केतुः<br><br>आदित्यकेतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧೃತರಾಷ್ಟ್ರನ ಒಬ್ಬ ಮಗ<br><br>

आदित्यपत्र
आदित्यपत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಕ್ಕದ ಎಲೆ<br><br>

आदित्यपुत्र
आदित्यपुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಮಗ ಶನಿ<br><br>आदित्यपुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣ<br><br>आदित्यपुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಗ್ರೀವ<br><br>आदित्यपुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಮ<br><br>

आदित्यसुत
आदित्यसुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಮಗ ಶನಿ<br><br>आदित्यसुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣ<br><br>आदित्यसुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಗ್ರೀವ<br><br>आदित्यसुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಮ<br><br>

आदित्यसूनु
आदित्यसूनु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಮಗ ಶನಿ<br><br>आदित्यसूनु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣ<br><br>आदित्यसूनु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಗ್ರೀವ<br><br>आदित्यसूनु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಮ<br><br>

आदित्यसुता
आदित्यसुता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಮುನಾ ನದಿ<br><br>आदित्यसुता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಪತೀ ನದಿ<br><br>

आदित्सा
आदित्सा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಳ್ಳಲು ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>आ + डुदाञ् (दाने) + सन् - "अः" (३-३-१०२)<br><b>व्युत्पत्तिः - </b>आदातुमिच्छा<br><br>

आदित्सु
आदित्सु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಳ್ಳಲು ಅಪೇಕ್ಷೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>आ + डुदाञ् (दाने) + सन् - "उः" (३-२-१६८)<br><b>व्युत्पत्तिः - </b>आदातुमिच्छुः<br><b>प्रयोगाः - </b>"आदित्सुभिर्नूपुरशिञ्जितानि"<br><b>उल्लेखाः - </b>कुमा० १-३४<br><br>

आदिदेव
आदिदेव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>"आदिदेवो महादेवः देवेशः"<br><b>उल्लेखाः - </b>वि० स०<br><br>आदिदेव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>आदिदेव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ /ಶಿವ<br><br>आदिदेव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಬ್ರಹ್ಮ /ಮೂಲಕಾರಣ<br><b>प्रयोगाः - </b>"त्वमादिदेवः पुरुषः पुराणः त्वमस्य विश्वस्य परं निधानम्"<br><b>उल्लेखाः - </b>गीता० ११-३८<br><br>

आदिदैत्य
आदिदैत्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿರಣ್ಯಕಶಿಪು<br><b>प्रयोगाः - </b>"आदिदैत्यो महावीर्यो हिरण्यकशिपुः पुरा"<br><b>उल्लेखाः - </b>भा० वन० १०१-२३<br><br>

आदिन्
आदिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಕ್ಷಿಸುವ /ತಿನ್ನುವ<br><b>निष्पत्तिः - </b>अद (भक्षणे) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>अत्ति<br><br>

आदिनी
आदिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭಕ್ಷಿಸುವ /ತಿನ್ನುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><b>प्रयोगाः - </b>"पूत्रादिनी त्वमसि पापे"<br><b>उल्लेखाः - </b>सि० कौ०<br><br>

आदिपर्वन्
आदिपर्वन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾಭಾರತದ ೧೮ ಪರ್ವಗಳಲ್ಲಿ ಒದಲನೆಯದು<br><br>

आदिपुराण
आदिपुराण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಲ್ಲಾ ಪುರಾಣಗಳಿಗೂ ಮೂಲಭೂತವಾದ ಪುರಾಣ<br><br>

आदिपुरुष|आदिपूरुष
आदिपुरुष (आदिपूरुष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಪುರುಷ /ನಾರಾಯಣ<br><br>आदिपुरुष (आदिपूरुष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿರಣ್ಯಗರ್ಭ<br><b>प्रयोगाः - </b>"तमर्घ्यमर्घ्यादिकयादिपूरुषः"<br><b>उल्लेखाः - </b>माघ० १-१४<br><br>

आदिम
आदिम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊದಲು ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>"डिमच्" (वा० ४-३-२३)<br><b>व्युत्पत्तिः - </b>आदौ भवः<br><br>

आदिमत्
आदिमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭವುಳ್ಳ /ಕಾರಣಸಹಿತವಾದ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>आदिरस्यास्ति<br><br>

आदिराज
आदिराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೃಥುಮಹಾರಾಜ<br><b>निष्पत्तिः - </b>"टच्" (५-४-९१)<br><b>व्युत्पत्तिः - </b>आदिः आद्यो राजा<br><br>

आदिवराह
आदिवराह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಶಾವತಾರಗಳಲ್ಲೊಂದಾದ ವಿಷ್ಣುವಿನ ಮೂರನೆಯ ಅವತಾರ<br><br>

आदिशक्ति
आदिशक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮನ ಮಾಯಾರೂಪವಾದ ಶಕ್ತಿ<br><br>आदिशक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ<br><br>

आदिशरीर
आदिशरीर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಿಂಗ ಶರೀರ /ಪಾಪಪುಣ್ಯಗಳನ್ನು ಕೂಡಿಡಲು ಯೋಗ್ಯವಾದ ಒಂದು ಶರೀರ<br><b>प्रयोगाः - </b>"अयमादिशरीरेण देवसृष्टेन मानवः । शुभानामशुभानां च कुरुते सञ्चयं महत् । आयुषोऽन्ते प्रहायेदं क्षीणप्रायं कलेबरम् । सम्भवत्येव युगपद्यतो नास्त्यन्तराभवः । तत्रास्य स्वकृतं कर्म छायेवानुगतं तदा । फलत्यथ सुखार्हो वा दुःखार्हो वाऽथ जायते ॥"<br><b>उल्लेखाः - </b>भा० वन० १८६-२४,२५<br><br>आदिशरीर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರಣಶರೀರ /ಸೂಕ್ಷ್ಮಶರೀರ<br><br>

आदिष्ट
आदिष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಚ್ಛಿಷ್ಟ /ಊಟ ಮಾಡಿ ಉಳಿದ ಅನ್ನ<br><br>आदिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪದೇಶಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अग्रे भवन् गुरुरिव स्वयमाककानामादिष्टसम्पदिव कन्धरया तवैषः"<br><b>उल्लेखाः - </b>याद० १९-२३<br><br>आदिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + दिश (अतिसर्जने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आदिष्टोऽस्मि महाराजमहामोहेन ।"<br><b>उल्लेखाः - </b>प्रबोध० २<br><br>आदिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣದಲ್ಲಿ ಹೇಳಿರುವ ಆದೇಶ ಹೊಂದಿದ ವರ್ಣ<br><br>

आदिसर्ग
आदिसर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಗತ್ತಿನ ಮೊದಲನೆಯ ಸೃಷ್ಟಿ /ಮಹಾಪ್ರಳಯದ ನಂತರ ಪ್ರಪಂಚದ ಸೃಷ್ಟಿ<br><br>

आदीनव
आदीनव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೋಷ /ತಪ್ಪು<br><b>निष्पत्तिः - </b>आ + दीङ् (क्षये) - "क्तः" (३-३-११४) । वा (गतुगन्धनयोः) - "कः" (वा० ३-३-११४)<br><b>व्युत्पत्तिः - </b>आसीनस्य वानं प्राप्तिः ।<br><br>आदीनव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ಲೇಶ /ಕಷ್ಟ<br><br>आदीनव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುರಂತ<br><br>आदीनव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೋಷ /ಕೋಪ<br><br>आदीनव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ಲೇಶ ಹೊಂದಿದ /ಕಷ್ಟಪಟ್ಟ<br><b>निष्पत्तिः - </b>कर्त० "क्तः" (३-४-७२)<br><b>विस्तारः - </b>"आदीनवः पुमान् दोषे परिक्लेशदुरन्तयोः" - मेदि० ।<br><br>

आदीपी|आ + दिपी|दीप्तौ 
आ + दीपी (दीप्तौ) - (दि० आत्म० अक० से०)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಉರಿಸು<br><br>आ + दीपी (दीप्तौ) - (दि० आत्म० अक० से०)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಬೆಂಕಿಯಿಟ್ಟು ಸುಡು<br><br>आ + दीपी (दीप्तौ) - (दि० आत्म० अक० से०)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಗೊಳಿಸು<br><br>आ + दीपी (दीप्तौ) - (दि० आत्म० अक० से०)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹುರಿದುಂಬಿಸು /ಪ್ರೇರಿಸು<br><br>

आदीपक
आदीपक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಗೊಳಿಸುವ<br><br>आदीपक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುರಿದುಂಬಿಸುವ<br><b>निष्पत्तिः - </b>आ + दिपी (दीप्तौ) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>आदीपयति<br><br>आदीपक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಡುವವನು /ದಹಿಸುವವನು<br><b>प्रयोगाः - </b>"राज्ञो वधं चिकीर्षेद्यः तस्य चित्रो वधो भवेत् । आदीपकस्य स्तेनस्य वर्णसङ्करिकस्य च ॥"<br><b>उल्लेखाः - </b>भा० शान्ति० ८५-२२<br><br>आदीपक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉರಿಸುವ<br><br>

आदीपन
आदीपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೇರಣೆ /ಉತ್ತೇಜನಗೊಳಿಸುವಿಕೆ<br><br>आदीपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಕಿ ಹಚ್ಚುವಿಕೆ<br><br>आदीपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಗೊಳಿಸುವಿಕೆ<br><br>आदीपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉರಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + दिपी (दीप्तौ) + णिच् - "ल्युट्" (३-३-११५)<br><br>आदीपन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>आदीपन ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>आ + दिपी (दीप्तौ) + णिच् -"ल्युः" (३-१-१३४)<br><br>

आदीपित
आदीपित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>आदीपित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೇರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + दिपी (दीप्तौ) + णिच् -"क्तः" (३-२-१०२)<br><br>आदीपित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆಂಕಿ ಹಚ್ಚಲ್ಪಟ್ಟ<br><br>आदीपित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉರಿಸಲ್ಪಟ್ಟ<br><br>

आदृत
आदृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೌರವಿಸಲ್ಪಟ್ಟ<br><br>आदृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಟ್ಟ<br><br>आदृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + दृङ् (आदरे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आदृता नखपदैः परिरम्भाश्चुम्बितानि घनदन्तनिपातैः"<br><b>उल्लेखाः - </b>किरा० ९-४९<br><br>आदृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿಸುವ /ಆದರದಿಂದ ಕಾಣುವ<br><b>निष्पत्तिः - </b>कर्त० "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"आत्मानमादृतो रक्षेत् प्रमादद्धि विनश्यति"<br><b>उल्लेखाः - </b>पञ्चतं०<br><br>

आदृत्य
आदृत्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆದರಿಸಲ್ಪಡುವ /ಪ್ರೀತಿಸಲ್ಪಡುವ<br><br>आदृत्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೌರವಿಸಲ್ಪಡುವ<br><br>आदृत्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆದರಿಸಲು ಯೋಗ್ಯವಾದ<br><br>आदृत्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೌರವಿಸಲು ಅರ್ಹವಾದ<br><b>निष्पत्तिः - </b>आ + दृङ् (आदरे) - "ण्यत्" (३-१-१२४)<br><br>

आदेय
आदेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಳ್ಳಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>आ + डुदाञ् (दाने) - "यत्" (३-१-९७) । "ईत्" (३-४-६५)<br><b>व्युत्पत्तिः - </b>आदातुं योग्यम्<br><b>प्रयोगाः - </b>"अनादेयस्य चादानादादेयस्य च वर्जनात्"<br><b>उल्लेखाः - </b>मनु० ८-१७१<br><br>

आदेश
आदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆ /ಆಜ್ಞೆ<br><b>निष्पत्तिः - </b>आ + दिश (अतिसर्जने) - भावे "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"आदेशं देशकालज्ञः शिष्यः शासितुरानतः"<br><b>उल्लेखाः - </b>रघु० १-९२<br><br>आदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪದೇಶ /ಸಲಹೆ<br><br>आदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಚನೆ /ಮುಂದಾಗಿ ತಿಳಿಸುವಿಕೆ<br><br>आदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣದಲ್ಲಿ ಒಂದು ವರ್ಣದ ಅಥವಾ ಧಾತುವಿನ ಸ್ಥಾನದಲ್ಲಿ ಮತ್ತೊಂದು ವರ್ಣವು ಅಥವಾ ಧಾತುವು ಬರುವುದು<br><b>प्रयोगाः - </b>"धातोः स्थान इवादेशं सुग्रीवं सन्न्यवेशयत्" । "स्थानिवदादेशोऽनविधौ" ।<br><b>उल्लेखाः - </b>रघु० १२-५८ । पा० सू० १-१-५६<br><br>आदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಃಶಾಸ್ತ್ರದಲ್ಲಿ ಗ್ರಹಗಳ ಯೋಗದಿಂದುಂಟಾಗುವ ಶುಭಾಶುಭಫಲಗಳು<br><br>आदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭವಿಷ್ಯದ ನುಡಿ /ಮುಂದಾಗುವುದನ್ನು ಹೇಳುವಿಕೆ<br><b>प्रयोगाः - </b>"अन्यथा क्व सिद्धादेशप्रत्ययप्रार्थितायाः शिम्हलेश्वरदुहितुः प्रवहणभङ्गनिमग्नायाः फलकासादनम् ॥"<br><b>उल्लेखाः - </b>रत्ना० १<br><br>आदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪದೇಶದಿಂದ ಮಾತ್ರ ತಿಳಿಯಲ್ಪಡುವ ಬ್ರಹ್ಮ<br><b>निष्पत्तिः - </b>कर्म० "घञ्" (३-३-१९)<br><br>

आदेशक
आदेशक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪದೇಶಿಸುವವನು<br><br>आदेशक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>आ + दिश (अतिसर्जने) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>आदिशति<br><br>

आदेशन
आदेशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆ /ಆಜ್ಞೆ<br><br>आदेशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪದೇಶ /ಸಲಹೆ<br><b>निष्पत्तिः - </b>आ + दिश (अतिसर्जने) - "ल्युट्" (३-३-११५)<br><br>

आदेशिन्
आदेशिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೈವಜ್ಞ /ಶುಭಾಶುಭ ಫಲಗಳನ್ನು ಹೇಳುವವನು<br><br>आदेशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಲಹೆಗಾರ<br><br>आदेशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆ ಮಾಡುವ<br><b>निष्पत्तिः - </b>आ + दिश (अतिसर्जने) - "णिनिः" (३-१-१३४)<br><br>

आदेश्य
आदेश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆ ಮಾಡಲ್ಪಡುವ<br><br>आदेश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪದೇಶಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + दिश (अतिसर्जने) - "ण्यत्" (३-१-१२४)<br><br>

आदेष्टृ
आदेष्टृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>आ + दिश (अतिसर्जने) - "तृच्" (३-१-१३३)<br><br>आदेष्टृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಜ್ಞೆ ಮಾಡುವ<br><br>

आदेष्ट्री
आदेष्ट्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आदेष्टृ ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आद्य
आद्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯ<br><b>निष्पत्तिः - </b>अद (भक्षणे) - "ण्यत्" (३-१-१२४)<br><br>आद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊದಲನೆಯ<br><br>आद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಖ್ಯ /ಪ್ರಧಾನ<br><b>प्रयोगाः - </b>"आसीन्महीक्षितामाद्यः प्रणवच्छन्दसामिव"<br><b>उल्लेखाः - </b>रघु० १-११<br><br>आद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾಚೀನವಾದ<br><b>प्रयोगाः - </b>"आद्यकोललुलिताप्रकम्पनैः कम्पितां मुहुरनीदृगात्मनि"<br><b>उल्लेखाः - </b>माघ० १४-४३<br><br>आद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿನ್ನಲ್ಪಡುವ<br><br>आद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿನ್ನಲು ಯೋಗ್ಯವಾದ<br><br>

आद्यकवि
आद्यकवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ /ಚತುರ್ಮುಖ<br><br>आद्यकवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಲ್ಮೀಕಿ ಮಹರ್ಷಿ<br><br>

आद्यमाषक
आद्यमाषक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೫ ಗುಲಗಂಜಿಗಳ ತೂಕ<br><b>व्युत्पत्तिः - </b>आद्यः माषकः<br><b>विस्तारः - </b>"दशार्धगुञ्जं प्रवदन्ति माषकम्"<br><br>

आद्यबीज
आद्यबीज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಗತ್ತಿನ ಮೂಲಕಾರಣ<br><br>

आद्या
आद्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ<br><br>आद्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಿಂಗಳಿನ ಮೊದಲನೆಯ ದಿವಸ /ಪ್ರತಿಪತ್ ತಿಥಿ<br><br>

आद्यून
आद्यून<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಂಡಾಡಿ /ಹೊಟ್ಟೆಬಾಕ<br><b>निष्पत्तिः - </b>आ + दिवु (क्रीडायाम्) - "क्तः" (३-४-७२) । अविजिगीषायां नत्वम् (८-२-४९)<br><b>प्रयोगाः - </b>"आद्यूनः सद्गृहिण्येव प्रायो यष्ट्यावलम्बितः"<br><b>उल्लेखाः - </b>किरा० ११-५<br><br>

आद्योपान्त
आद्योपान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊದಲಿನಿಂದ ಕೊನೆಯವರೆಗಿನ<br><b>व्युत्पत्तिः - </b>आद्यावधि उपान्तः<br><br>

आधमर्ण्य
आधमर्ण्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಋಣಬದ್ಧತೆ /ಋಣಿತ್ವ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अधमर्णस्य भावः कर्म वा<br><br>

आधर्मिक
आधर्मिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧರ್ಮಶೀಲ<br><b>निष्पत्तिः - </b>"ठक्" (वा० ४-४-४१)<br><b>व्युत्पत्तिः - </b>अधर्मं चरति<br><br>

आधर्ष
आधर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲಾತ್ಕರವಾಗಿ ಹಿಂಸಿಸುವುದು<br><br>आधर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರ<br><br>आधर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಮಾನ /ಅಗೌರವ<br><b>निष्पत्तिः - </b>आ + धृष (प्रहसने) - भावे "घञ्" (३-३-१८)<br><br>

आधर्षण
आधर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಧರ್ಷ ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>आ + धृष (प्रहसने) - भावे "ल्युट्" (३-३-११५)<br><br>

आधर्षित
आधर्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಲಾತ್ಕಾರವಾಗಿ ಪೀಡಿಸಲ್ಪಟ್ಟ<br><br>आधर्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ<br><br>आधर्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಮಾನಗೊಳಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + धृष (प्रहसने) - "क्तः" (३-२-१०२)<br><br>

आधातृ
आधातृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಡತಕ್ಕವನು<br><b>निष्पत्तिः - </b>आ + डुधाञ् (धारणपोषणयोः) - "तृच्" (३-१-१३३)<br><b>प्रयोगाः - </b>"पात्रविशेषे न्यस्तं गुणान्तरं व्रजति शिल्पमाधातुः"<br><b>उल्लेखाः - </b>माल० १-६<br><br>

आधान
आधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯನ್ನು ಸಂಸ್ಕಾರಪೂರ್ವಕ ಪ್ರತಿಷ್ಠಿಸುವುದು<br><br>आधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಂಟುಮಾಡುವುದು /ಉತ್ಪತ್ತಿ ಮಾಡುವುದು<br><br>आधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಡುವುದು /ಇರಿಸುವುದು<br><br>आधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಸ್ತುವಿನಲ್ಲಿ ಬೇರೆ ಗುಣವನ್ನುಂಟುಮಾಡುವುದು<br><b>निष्पत्तिः - </b>आ + डुधाञ् (धारणपोषणयोः) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"प्रजानां विनयाधानाद्रक्षणाद्भरणादपि । स पिता पितरस्तासां केवलं जन्महेतवः ॥"<br><b>उल्लेखाः - </b>रघु० १-२४<br><br>आधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಿರವಿ /ಅಡವು<br><br>

आधाय
आधाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಧಾನ /ಇಡುವುದು<br><b>निष्पत्तिः - </b>आ + डुधाञ् (धारणपोषणयोः) - "घञ्" (३-३-१८)<br><br>आधाय<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಇಟ್ಟು /ಇರಿಸಿ<br><b>निष्पत्तिः - </b>आ + डुधाञ् (धारणपोषणयोः) - "ल्यप्" (७-१-३७)<br><br>

आधार
आधार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಬಲ /ಒತ್ತಾಸೆ<br><b>निष्पत्तिः - </b>आ + धृङ् (अवस्थाने) - "घञ्" (३-३-१८)<br><br>आधार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ /ಅಧಿಕರಣ<br><b>निष्पत्तिः - </b>आ + धृङ् (अवस्थाने) - "घञ्" (वा० ३-३-१२२)<br><b>प्रयोगाः - </b>"अवृष्टिसंरम्भमिवाम्बुवाहमपामिवाधारमनुत्तरङ्गम्"<br><b>उल्लेखाः - </b>कुमा० ३-४८<br><br>आधार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಿಡದ ಪಾತಿ<br><b>प्रयोगाः - </b>"आधारबन्धप्रमुखैः प्रयत्नैः संवर्धितानां सुतनिर्विशेषम्"<br><b>उल्लेखाः - </b>रघु० ५-६<br><br>आधार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾತ್ರೆ<br><br>आधार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲುವೆ<br><br>आधार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನ ಮಡು /ಹಳ್ಳ<br><br>आधार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಣೆಕಟ್ಟು<br><br>आधार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣದಲ್ಲಿ ಹೇಳಿರುವ ಕ್ರಿಯೆಗೆ ಕರ್ತೃಕರ್ಮಗಳ ಮೂಲಕ ಆಶ್ರಯಭೂತವಾದ ಅಧಿಕರಣ ಕಾರಕ<br><br>

आधारनिलय
आधारनिलय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ /ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>जगदाधाराणां प्रह्लादविभीषणपाण्डवादीनां निलयः आस्पदम्<br><b>प्रयोगाः - </b>"आधारनिलयो धाता पुष्पहासः प्रजागरः"<br><b>उल्लेखाः - </b>वि० स०<br><br>

आधाराधेयभाव
आधाराधेयभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸ್ತುವನ್ನು ಇಡುವ ಜಾಗ ಮತ್ತು ಇಡಲ್ಪಡುವ ವಸ್ತು ಇವುಗಳಿಗಿರುವ ಸಂಬಂಧ<br><br>

आधि
आधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನೋರೋಗ<br><b>निष्पत्तिः - </b>आ + डुधाञ् (धारणपोषणयोः) -"किः" (३-३-९२)<br><b>व्युत्पत्तिः - </b>आधीयतेऽनेन<br><b>प्रयोगाः - </b>"भूयिष्ठं भव दक्षिणा परिजने भाग्येष्वनुत्सेकिनी यान्त्येवं गृहिणीपदं युवतयो वामाः कुलस्याधयः ॥"<br><b>उल्लेखाः - </b>शाकु० ४-१७<br><br>आधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಡವು /ಗಿರವಿ<br><br>आधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಳ /ಜಾಗ<br><br>आधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಸನ /ದುಃಖ<br><br>आधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯಾಶೆ /ನಿರೀಕ್ಷಣೆ<br><br>आधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಾಮೀನು /ಈಡು /ಹೊಣೆ<br><b>विस्तारः - </b>"आधिः पुमांश्चित्तपीडाप्रत्याशाबन्धकेषु च । व्यसने चाप्यधिष्ठानेऽपि" - मेदि० ।<br><br>

आधिकरणिक
आधिकरणिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನ್ಯಾಯಾಧೀಶ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-६९)<br><b>व्युत्पत्तिः - </b>अधिकरणे नियुक्तः<br><br>

आधिदैविक
आधिदैविक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆಗಳಿಂದ ಸಂಭವಿಸಬಹುದಾದ ದುಃಖ<br><b>निष्पत्तिः - </b>"ठञ्" (४-३-६०)<br><b>व्युत्पत्तिः - </b>देवेषु अधिदैवम् । तत्र भवम्<br><br>

आधिपत्य
आधिपत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜತ್ವ /ಪ್ರಭುತ್ವ<br><b>निष्पत्तिः - </b>"यक्" (५-१-१२८)<br><b>व्युत्पत्तिः - </b>अधिपतेर्भावः<br><b>प्रयोगाः - </b>"प्रजापतिः कल्पितयज्ञभावं शैलाधिपत्यं स्वयमन्वतिष्ठत्"<br><b>उल्लेखाः - </b>कुमा० १-१७<br><br>आधिपत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಜಾಸಂರಕ್ಷಣಾದಿ ರಾಜನ ಕರ್ತವ್ಯ<br><b>निष्पत्तिः - </b>"यक्" (५-१-१२८)<br><b>व्युत्पत्तिः - </b>अधिपतेः कर्म<br><br>

आधिभौतिक
आधिभौतिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಸ್ತ್ರಾಘಾತಾದಿಗಳಿಂದ ಮತ್ತು ದುಷ್ಟಪ್ರಾಣಿಗಳಿಂದ ಸಂಭವಿಸುವ ದುಃಖ<br><b>निष्पत्तिः - </b>"ठञ्" (वा० ४-३-६०)<br><b>व्युत्पत्तिः - </b>भूतेष्वधिभूतम् ।तत्र भवम्<br><br>

आधिराज्य
आधिराज्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಧಿಪತ್ಯ /ಪ್ರಭುತ್ವ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अधिको राजा अधिराजा । तस्य भावः कर्म वा<br><b>प्रयोगाः - </b>"पितुरनन्तरं ममाधिराज्यपदस्य प्रथममर्धं भवते वितीर्य ततः परमर्धमहमनुभविष्यामीति"<br><b>उल्लेखाः - </b>चं० भा० २<br><br>

आधिवेदनिक
आधिवेदनिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದ್ವಿತೀಯಾದಿ ವಿವಾಹ ಮಾಡಿಕೊಳ್ಳಲು ಮೊದಲನೆಯ ಪತ್ನಿಯ ಸಂತೋಷಾರ್ಥವಾಗಿ ಪತಿಯು ಕೊಡುವ ಸ್ತ್ರೀಧನ<br><b>निष्पत्तिः - </b>"ठक्" (५-१-९६)<br><b>व्युत्पत्तिः - </b>अधिवेदने दीयते<br><b>प्रयोगाः - </b>"अधिविन्नस्त्रियै दद्यादाधिवेदनिकं समम्"<br><b>उल्लेखाः - </b>याज्ञ० २-१४८<br><br>

आधुत
आधुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲ್ಲಾಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + धूञ् (कम्पने) - "क्तः" (३-२-१०२)<br><br>

आधुनिक
आधुनिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈ ಕಾಲದ ಈಗಿನ ಕಾಲದ<br><br>आधुनिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈಗ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>"ठञ्" (४-३-११)<br><b>व्युत्पत्तिः - </b>अधुना भवः<br><br>

आधृष्टि
आधृष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರ<br><br>आधृष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಮಾನ<br><br>आधृष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲೆ ಬೀಳುವುದು /ಧಾಳಿ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>आ+ धृष (प्रहसने) - "क्तिन्" (३-३-९४)<br><br>

आधेय
आधेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಡಲು ಯೋಗ್ಯವಾದ<br><br>आधेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಯಾರಿಸಲ್ಪಡುವ /ಸೃಷ್ಟಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + धाञ् - कर्म० "यत्" (३-१-९७)<br><br>आधेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಸಂಸ್ಕಾರದಿಂದ ಸಂಸ್ಕರಿಸಲ್ಪಟ್ಟ ಅಗ್ನಿ<br><br>

आधोरण
आधोरण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾವಟಿಗ /ಆನೆಯ ಸಾರಥಿ<br><b>निष्पत्तिः - </b>आ + धोर (गतिचातुर्ये) - "ल्युः" (३-१-१३४)<br><b>प्रयोगाः - </b>"आधोरणानां गजसन्निपाते शिरांसि चक्रैर्निशितैः क्षुराग्रैः"<br><b>उल्लेखाः - </b>रघु० ७-४६<br><br>

आध्यात्म
आध्यात्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ<br><br>आध्यात्म<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಬ್ದವುಂಟುಮಾಡಲ್ಪಟ್ಟ /ಧ್ವನಿಯುಕ್ತವಾದ<br><b>प्रयोगाः - </b>"परेषामुन्नेयो भवति चिरमाध्यात्मातहृदयः"<br><b>उल्लेखाः - </b>उ० रा० १-२९<br><br>आध्यात्म<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಹಿಸಲ್ಪಟ್ಟ /ಸುಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + ध्मा (शब्दाग्निसंयोगयोः) - "क्तः" (३-२-१०२)<br><br>आध्यात्म<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊದಲ್ಪಟ್ಟ /ಉರುವಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कर्त० "क्तः" (३-४-७२)<br><br>आध्यात्म<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಬ್ಬಿರುವ /ಊದಿರುವ<br><br>आध्यात्म<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಟ್ಟೆಯುಬ್ಬರದ ರೋಗದಿಂದ ಕೂಡಿದ<br><br>

आध्मान
आध्मान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯುರೋಗ<br><br>आध्मान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಟ್ಟೆಯುಬ್ಬರ<br><br>आध्मान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿದಿ<br><b>निष्पत्तिः - </b>आ + ध्मा (शब्दाग्निसंयोगयोः) - कर० "ल्युट्" (३-३-११७)<br><br>आध्मान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಡಾಯಿ ಕೊಚ್ಚಿಕೊಳ್ಳುವುದು<br><br>आध्मान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಬ್ಬುವುದು /ಹಿಗ್ಗುವುದು<br><br>आध्मान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದ ಮಾಡುವುದು<br><br>आध्मान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಕಿಯನ್ನು ಊದುವುದು<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

आध्मापन
आध्मापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದವುಂಟುಮಾಡುವುದು<br><br>आध्मापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಬ್ಬಿಸುವುದು<br><b>निष्पत्तिः - </b>आ + ध्मा (शब्दाग्निसंयोगयोः) + णिच् - "ल्युट्" (३-३-११५)<br><br>

आध्यात्मिक
आध्यात्मिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮನಸ್ಸು ಮತ್ತು ಶರೀರಗಳ ನಿಮಿತ್ತವಾಗಿ ಸಂಭವಿಸುವ ದುಃಖ<br><b>निष्पत्तिः - </b>"ठञ्" (वा० ४-३-६०)<br><b>व्युत्पत्तिः - </b>आत्मनि अध्यात्मम् । अध्यात्मं भवम्<br><br>आध्यात्मिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆತ್ಮನಿಗೆ ಸಂಬಂಧಿಸಿದ /ಆತ್ಮನನ್ನು ಕುರಿತು ಉಂಟಾದ<br><br>आध्यात्मिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶರೀರ ಸಂಬಂಧವಾದ<br><br>

आध्यात्मिकी
आध्यात्मिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಂಖ್ಯಮತದಲ್ಲಿ ಹೇಳಿರುವ ಪ್ರಕೃತಿ /ಉಪಾದಾನ ಕಾಲ ಮತು ಭಾಗ್ಯಗಳೆಂಬ ನಾಲ್ಕು ವಿಧ ತುಷ್ಟಿಗಳು<br><br>

आध्यान
आध्यान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಮರಣೆ /ಉತ್ಸಾಹಪೂರ್ವಕ ನೆನೆಯುವುದು<br><b>निष्पत्तिः - </b>आ + ध्यै (चिन्तायाम्) - "ल्युट्" (३-३-११५)<br><br>आध्यान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಂತೆ<br><br>

आध्यासिक
आध्यासिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭ್ರಾಂತಿಯಿಂದ ಕಲ್ಪಿತವಾದ ವಸ್ತು /ಬ್ರಹ್ಮನಲ್ಲಿ ಅಧ್ಯಾಸದಿಂದ ಕಲ್ಪಿತವಾದ ಜಗತ್ತು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-१९)<br><b>व्युत्पत्तिः - </b>अध्यासेन निर्वृत्तम्<br><br>

आनक
आनक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಟಹ /ತಮಟೆ<br><b>निष्पत्तिः - </b>अन (प्राणने) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>आनयति सोत्साहान् करोति योधान्<br><b>प्रयोगाः - </b>"आनकानां च दिव्यानां दुन्दुभीनां च निस्वनैः"<br><b>उल्लेखाः - </b>याद० १-२८<br><br>आनक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೃದಂಗ /ಮದ್ದಳೆ<br><br>आनक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಡುಗಿನಿಂದ ಕೂಡಿದ ಮೇಘ<br><br>आनक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಗಾರಿ<br><br>आनक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೋತ್ಸಾಹಿಸುವ<br><b>विस्तारः - </b>"आनकः पटहे भेर्यां मृदङ्गे ध्वनदम्बुदे" - मेदि० ।<br><br>

आनकदुन्दुभि
आनकदुन्दुभि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸುದೇವ /ಶ್ರೀಕೃಷ್ಣನ ತಂದೆ<br><b>व्युत्पत्तिः - </b>आनकः प्रोत्साहको दुन्दुभिर्यस्य<br><br>आनकदुन्दुभि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೊಡ್ಡ ನಗಾರಿ<br><br>

आनडुह
आनडुह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೃಷಭಸಂಬಂಧವಾದ ಗೋಮಯ ತೊಗಲು ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>अनडुहः इदम्<br><b>प्रयोगाः - </b>"प्रच्छिद्य प्रच्छिद्य प्रागग्राज्छमीपर्णैः सह मात्रे प्रयच्छति तानानडुहे गोमये निदधाति"<br><b>उल्लेखाः - </b>आश्व० गृ० अ० १<br><br>

आनत
आनत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೌರವದಿಂದ ನಮಸ್ಕರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + णम (प्रह्वत्वे शब्दे) - "क्तः" (३-२-१०२)<br><br>आनत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧೋಮುಖವಾದ /ಬಗ್ಗಿದ ಮುಖವುಳ್ಳ<br><br>आनत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೌರವದಿಂದ ನಮಸ್ಕಾರ ಮಾಡಿದ<br><b>निष्पत्तिः - </b>कर्त० "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"आदेशं देशकालज्ञः शिष्यः शासितुरानतः"<br><b>उल्लेखाः - </b>रघु० १-९१<br><br>आनत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿರುವ /ವಿಧೇಯತೆಯಿಂದ ನಮ್ರನಾದ<br><b>प्रयोगाः - </b>"स्पृशन् करेणानतपूर्वकायं सम्प्रस्थितो वाचमुवाच कौत्सः"<br><b>उल्लेखाः - </b>रघु० ५-३२<br><br>

आनति
आनति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿರುವಿಕೆ<br><br>आनति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಮಸ್ಕಾರ<br><b>निष्पत्तिः - </b>आ + णम (प्रह्वत्वे शब्दे) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"निवर्त्य सोऽनुव्रजतः कृतानतीनतीन्द्रियज्ञाननिधिर्नभस्सदः"<br><b>उल्लेखाः - </b>माघ० १-११<br><br>आनति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಧೇಯತೆ<br><br>

आनद्ध
आनद्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಮಟೆ<br><br>आनद्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೃದಂಗ /ಮದ್ದಳೆ<br><br>आनद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಂಟು ಹಾಕಲ್ಪಟ್ಟ<br><br>आनद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಟ್ಟಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + णह (बन्धने) - "क्तः" (३-२-१०२)<br><br>

आनन
आनन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಖ<br><b>निष्पत्तिः - </b>आ + अन (प्राणने) - कर० "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"आननैर्मधुरसो विकसद्भिर्नासिकाभिरसितोत्पलगन्धः"<br><b>उल्लेखाः - </b>माघ० १०-८<br><br>

आनन्तर्य
आनन्तर्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವ್ಯವಧಾನ /ಮಧ್ಯೆ ಅವಕಾಶವಿಲ್ಲದೆ ಸೇರಿಕೊಂಡಿರುವಿಕೆ /ಎಡೆಬಿಡದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अनन्तरस्य भावः<br><br>

आनन्त्य
आनन्त्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನೆಯಿಲ್ಲದಿರುವಿಕೆ /ಎಲ್ಲೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>आनन्त्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶವಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अनन्तस्य भावः<br><br>आनन्त्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ವತ್ರ ವ್ಯಪಿಸಿರುವುದರಿಂದ ದೇಶ ಪರಿಚ್ಛೇದವಿಲ್ಲದಿರುವಿಕೆ<br><br>आनन्त्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲ ಪರಿಚ್ಛೇದವಿಲ್ಲದಿರುವಿಕೆ<br><br>आनन्त्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಕಲವೂ ಬ್ರಹ್ಮಸ್ವರೂಪ ಅಥವಾ ಬ್ರಹ್ಮನ ಶರೀರವೇ ಆಗಿರುವುದರಿಂದ ವಸ್ತು ಪರಿಚ್ಛೇದವಿಲ್ಲದಿರುವಿಕೆ<br><br>

आनन्द
आनन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂತೋಷ /ಹರ್ಷ<br><b>निष्पत्तिः - </b>आ + टुनदि (समृद्धौ) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"यदिन्दावानन्दं प्रणयिनि जने वा न भजते"<br><b>उल्लेखाः - </b>मालती० ३-९<br><br>आनन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಬ್ರಹ್ಮ<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>आनन्दोऽस्यास्ति<br><br>आनन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನಂದ ಸಂವತ್ಸರ<br><br>आनन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>"आनन्दो नन्दनो नन्दः"<br><b>उल्लेखाः - </b>वि० स०<br><br>आनन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಂಡಕರ ಒಂದು ಭೇದ<br><br>आनन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾರ ಮತ್ತು ನಕ್ಷತ್ರಗಳ ಸಂಬಂಧದಿಂದ ಉಂಟಾಗುವ ಒಂದು ಯೋಗ<br><br>आनन्द<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ<br><br>आनन्द<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆನಂದವನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>आ + नदि + णिच् - "अच्" (३-१-१३४)<br><br>

आनन्दथु
आनन्दथु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನಂದ /ಸಂತೋಷ<br><b>निष्पत्तिः - </b>आ + टुनदि (समृद्धौ) - भावे "अथुच्" (३-३-८९)<br><br>

आनन्दन
आनन्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂತೋಷವುಂಟುಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + टुनदि (समृद्धौ) - भावे "ल्युट्" (३-३-११५)<br><br>आनन्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಿತ್ರರ ಭೇಟಿಯ ಕಾಲದಲ್ಲಿ ಮಾಡುವ ಕುಶಲಪ್ರಶ್ನೆ<br><b>विस्तारः - </b>"आनन्दनं सङ्गतं स्यात् अप्रच्छन्नं सभाजनम्" - वैज० ।<br><br>आनन्दन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷವನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>आ + टुनदि (समृद्धौ) + णिच् - "ल्युः" (३-१-१३४)<br><b>प्रयोगाः - </b>"आनन्दानि मदनज्वरदीपनानि"<br><b>उल्लेखाः - </b>मालती० ९-४८<br><br>

आनन्दभैरव
आनन्दभैरव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ /ಶಿವ<br><br>

आनन्दभैरवी
आनन्दभैरवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರ್ವತಿ<br><br>

आनन्दमय
आनन्दमय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><br>आनन्दमय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆನಂದದಿಂದ ತುಂಬಿದ<br><br>

आनन्दमयी
आनन्दमयी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿಯ ಮೂರ್ತಿ<br><br>

आनन्दि
आनन्दि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹರ್ಷ /ಸಂತೋಷ<br><br>आनन्दि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುತೂಹಲ /ಜಿಜ್ಞಾಸೆ<br><b>निष्पत्तिः - </b>आ + टुनदि (समृद्धौ) - "इन्" (उ० ४-११७)<br><br>

आनन्दित
आनन्दित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷಗಿಳಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + टुनदि (समृद्धौ) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आनन्दिताशेषजना बभूव सर्वाङ्गसङ्गिन्यपरैव लक्ष्मीः"<br><b>उल्लेखाः - </b>माघ० ३-१३<br><br>

आनन्दिन्
आनन्दिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಖವುಳ್ಳ /ಸಂತೋಷವುಳ್ಳ<br><b>निष्पत्तिः - </b>आनन्द - "इनिः" (५-२-११५)<br><br>आनन्दिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷವನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>आ + टुनदि (समृद्धौ) + णिच् - "णिनिः" (३-१-१३४)<br><br>

आनमन
आनमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಬಗ್ಗುವುದು<br><b>निष्पत्तिः - </b>आ + णम (प्रह्वत्वे शब्दे) + णिच् - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"श्रुत्वा विदर्भपतिमानमितं बलैश्च"<br><b>उल्लेखाः - </b>माल० ५-३<br><br>आनमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಮಸ್ಕಾರ<br><br>

आनमित
आनमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + णम (प्रह्वत्वे शब्दे) + णिच् - "क्तः" (३-२-१०२)<br><br>आनमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಧೇಯನಾಗಿ ಮಾಡಲ್ಪಟ್ಟ<br><br>

आनम्य
आनम्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಮಸ್ಕರಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + णम (प्रह्वत्वे शब्दे) + णिच् -"यत्" (३-१-९८)<br><br>आनम्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಮಸ್ಕರಿಸಿ<br><br>आनम्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿ /ಬಾಗಿ<br><b>निष्पत्तिः - </b>आ + णम (प्रह्वत्वे शब्दे) - "ल्यप्" (७-१-३७)<br><br>

आनमय्य
आनमय्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿಸಿ<br><b>निष्पत्तिः - </b>आ + णम (प्रह्वत्वे शब्दे) + णिच् - "ल्यप्" (७-१-३७)<br><br>

आनय
आनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತರುವುದು<br><b>निष्पत्तिः - </b>आ + णीञ् (प्रापणे) - भावे "अच्" (३-३-५६)<br><br>

आनयन
आनयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತರುವುದು<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

आनर्त
आनर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ<br><br>आनर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೃತ್ಯಶಾಲೆ<br><b>निष्पत्तिः - </b>आ + नृती (गात्रविक्षेपे) - अधि० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>आनृत्यन्त्यत्र<br><br>आनर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯವಂಶದ ದೊರೆ<br><b>व्युत्पत्तिः - </b>आनर्तानां राजा<br><br>आनर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನರ್ತದೇಶವಾಸಿ<br><b>व्युत्पत्तिः - </b>आनर्तोऽभिजनोऽस्य<br><br>आनर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದೇಶ<br><b>विस्तारः - </b>"आनर्तो देशभ्देऽपि नृत्यस्थाने जले रणे" - मेदि० ।<br><br>आनर्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><br>आनर्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನರ್ತನ<br><br>

आनर्तपुर
आनर्तपुर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆನರ್ತದೇಶದ ರಾಜಧಾನಿ /ದ್ವಾರಕಾನಗರ<br><br>

आनर्तित
आनर्तित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಣಿಸಲ್ಪಟ್ಟ /ನರ್ತನ ಮಾಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + नृती (गात्रविक्षेपे) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"मरुद्भिरानर्तितनक्तमाले"<br><b>उल्लेखाः - </b>रघु० ५-४२<br><br>

आनर्थक्य
आनर्थक्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೈಯರ್ಥ್ಯ /ವ್ಯರ್ಥತೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अनर्थकस्य भावः<br><br>

आनसूय
आनसूय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತ್ರಿಪತ್ನಿಯಾದ ಅನಸೂಯಾ ದೇವಿಯಿಂದ ಕೊಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"अण्" (४-२-९२)<br><b>व्युत्पत्तिः - </b>अनुसूयया दत्तम्<br><br>

आनाथ्य
आनाथ्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಜಮಾನನಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अनाथस्य भावः<br><br>

आनाय
आनाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲೆ<br><b>निष्पत्तिः - </b>आ + णीञ् (प्रापणे) - भावे "घञ्" (३-३-१२४)<br><b>व्युत्पत्तिः - </b>आनीयन्ते मत्स्यादतोऽनेन<br><br>

आनायिन्
आनायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೀನು ಹಿಡಿಯವವನು /ಬೆಸ್ತರವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>आनायोऽस्यास्ति<br><b>प्रयोगाः - </b>"स तीरभूमौ विहितोपकार्यामानायिभिस्तामपकृष्टनक्राम्"<br><b>उल्लेखाः - </b>रघु० १६-५५<br><br>

आनाय्य
आनाय्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವಹನೀಯಸ್ಥಾನದಿಂದ ತೆಗೆದು ದಕ್ಷಿಣಾಗ್ನಿಯಾಗಿ ಸಂಸ್ಕರಿಸಲ್ಪಡುವ ಅಗ್ನಿ<br><b>निष्पत्तिः - </b>आ + णीञ् (प्रापणे) - "ण्यत्" (३-१-१२७) निपा० ।<br><b>व्युत्पत्तिः - </b>आनियते<br><br>आनाय्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತರಿಸಿ ತೆಗೆದುಕೊಂಡು ಬರುವಂತೆ ಮಾಡಿ<br><br>आनाय्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರೆತರುವಂತೆ ಮಾಡಿ<br><b>निष्पत्तिः - </b>आ + णीञ् (प्रापणे) + णिच् - "ल्यप्" (७-१-३७)<br><br>

आनाह
आनाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಟ್ಟೆಯ ಉದ್ದ /ನೀಳ<br><br>आनाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೯೬೦೦೦ ಅಂಗುಲಗಳು<br><br>आनाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಲಬದ್ಧತೆ<br><b>निष्पत्तिः - </b>आ + णह (बन्धने) - "घञ्" (३-३-१८)<br><b>विस्तारः - </b>"आनाहो मलविष्टम्भः" - वैज० ।<br><br>

आनिरुद्ध
आनिरुद्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನಿರುದ್ಧನ ಮಗ<br><b>निष्पत्तिः - </b>"अण्" (४-१-११४)<br><b>व्युत्पत्तिः - </b>अनिरुद्धस्यापत्यम्<br><br>

आनिरुद्धी
आनिरुद्धी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಿರುದ್ಧನ ಮಗಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

आनिरुद्धि
आनिरुद्धि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಡೆಯಲ್ಪಡದವನ ಮಗ<br><b>निष्पत्तिः - </b>"इञ्" (४-१-९५)<br><b>व्युत्पत्तिः - </b>अनिरुद्धस्यापत्यम्<br><br>

आनिल
आनिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯುಪುತ್ರನಾದ ಆಂಜನೇಯ /ಭೀಮಸೇನ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>अनिलस्यायम्<br><br>आनिल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಿಲ ಸಂಬಂಧವಾದ<br><br>आनिल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಯುದೇವತಾಕವಾದ ನಕ್ಷತ್ರ ಮಂತ್ರ ಹವಿಸ್ಸು<br><br>

आनिलि
आनिलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯುಪುತ್ರನಾದ ಆಂಜನೇಯ<br><br>आनिलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯುಪುತ್ರನಾದ ಭೀಮಸೇನ<br><b>निष्पत्तिः - </b>"इञ्" (४-१-९५)<br><b>व्युत्पत्तिः - </b>अनिलस्यापत्यम्<br><br>

आनीत
आनीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತರಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + णीञ् (प्रापणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आनीतमग्रे निजबन्धनार्थं दामाखिलं संहितमप्यपूर्णम्"<br><b>उल्लेखाः - </b>याद० ४-३४<br><br>

आनीति
आनीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತರುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + णीञ् (प्रापणे) - "क्तिन्" (३-३-९४)<br><br>

आनील
आनील<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಅಂಡಕೋಶವುಳ್ಳ ಕುದುರೆ<br><b>विस्तारः - </b>"आनीलः स्यान्नीलकोशः" - वैज० ।<br><br>आनील<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಕಪ್ಪಗಿರುವ<br><br>

आनुकल्पिक
आनुकल्पिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕಲ್ಪವನ್ನು ತಿಳಿದಿರುವ /ಮುಖ್ಯವಲ್ಲದ ಎರಡನೆಯ ಪಕ್ಷವನ್ನು ಅರಿತಿರುವ<br><b>निष्पत्तिः - </b>"ठक्" (४-२-६०)<br><b>व्युत्पत्तिः - </b>अनुकल्पं वेत्ति<br><br>आनुकल्पिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕಲ್ಪವನ್ನು ತಿಳಿಸುವ ಗ್ರಂಥವನ್ನು ಅಧ್ಯಯನ ಮಾಡುವ<br><b>निष्पत्तिः - </b>"ठक्" (४-२-६०)<br><b>व्युत्पत्तिः - </b>अनुकल्पं तद्बोधकं ग्रन्थमधीते<br><br>आनुकल्पिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕಲ್ಪದಿಂದ ಹೊಂದಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-९३)<br><b>व्युत्पत्तिः - </b>अनुकल्पेन लभ्यम्<br><br>

आनुकूलिक
आनुकूलिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕೂಲವಾಗಿರುವ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-२८)<br><b>व्युत्पत्तिः - </b>अनुकूलं वर्तते<br><br>

आनुकूल्य
आनुकूल्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಕೂಲವಾಗಿರುವಿಕೆ /ಹೊಂದಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अनुकूलस्य भावः<br><br>

आनुगतिक
आनुगतिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಿಸುವಿಕೆಯಿಂದುಂಟಾದ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-१९)<br><b>व्युत्पत्तिः - </b>अनुगतेन अनुगमनेन निर्वृत्तः<br><br>

आनुगत्य
आनुगत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಿಸುವಿಕೆಯಿಂದುಂಟಾದ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अनुगतस्य भावः<br><br>

आनुगुणिक
आनुगुणिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಗುಣವಾಗಿ ತಿಳಿದಿರುವ<br><br>आनुगुणिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಗುಣವಾಗಿ ತಿಳಿಯಿಸುವ ಗ್ರಂಥವನ್ನು ಅಧ್ಯಯನ ಮಾಡುವ<br><b>निष्पत्तिः - </b>वा "ठक्" (४-२-६३)<br><b>व्युत्पत्तिः - </b>अनुगुणं वेत्ति अधीते<br><br>

आनुगुण्य
आनुगुण्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಗುಣವಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अनुगुणस्य भावः<br><br>

आनुग्रामिक
आनुग्रामिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗ್ರಾಮದ ಹಿಂಭಾಗದಲ್ಲಿ ಉಂಟಾಗ<br><b>निष्पत्तिः - </b>"ठञ्" (४-३-६३)<br><b>व्युत्पत्तिः - </b>ग्रामस्य पश्चात् अनुग्रामम्, अनुग्रामं भवः<br><br>

आनुनाश्य
आनुनाश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶದ ಅನಂತರ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>"ण्यः" (४-२-८०)<br><b>व्युत्पत्तिः - </b>अनुनाशं विनाशस्य पश्चात् भवः<br><br>

आनुनासिक्य
आनुनासिक्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುನಾಸಿಕದ ಧರ್ಮ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अनुनासिकस्य भावः<br><b>प्रयोगाः - </b>"प्रतिज्ञानुनासिक्याः पाणिनीयाः" - सि० कौ० ।<br><br>

आनुपथ्य
आनुपथ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾರ್ಗದ ಹಿಂಭಾಗದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"ञ्यः" (वा० ४-३-५९)<br><b>व्युत्पत्तिः - </b>अनुपथं भवः<br><br>

आनुपदिक
आनुपदिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಇಸಿ ಓಡಿ ಬರುವ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-३७)<br><b>व्युत्पत्तिः - </b>अनुपदं धावति<br><br>आनुपदिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪದಪಾಠವನ್ನು ಅಧ್ಯಯನ ಮಾಡುವ<br><br>आनुपदिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪದಪಾಠವನ್ನು ತಿಳಿದಿರುವ<br><b>निष्पत्तिः - </b>"ठक्" (४-२-६०)<br><b>व्युत्पत्तिः - </b>अनुपदं अधीते वेत्ति वा<br><br>

आनुपूर्वी
आनुपूर्वी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಕ್ರಮ /ಒಂದಾದ ಮೇಲೆ ಒಂದು ಬರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४) । "ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>पूर्वमनुक्रम्य अनुपूर्वम् । अनुपूर्वं भावः<br><br>

आनुपूर्व्य
आनुपूर्व्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಮ /ಪರ್ಯಾಯ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अनुपूर्वं भावः<br><b>प्रयोगाः - </b>"वसीरन्नानुपूर्व्येण शाणक्षौमाविकानि च"<br><b>उल्लेखाः - </b>मनु० २-४१<br><br>

आनुमानिक
आनुमानिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಮಾನದಿಂದ ಸಿದ್ಧವಾದ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-१९)<br><b>व्युत्पत्तिः - </b>अनुमानेन निर्वृत्तम्<br><br>आनुमानिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಪ್ತಿವಿಶಿಷ್ಟ ಲಿಂಗ ಜ್ಞಾನದಿಂದ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-१९)<br><b>व्युत्पत्तिः - </b>अनुमानेन व्याप्तिविशिष्टलिङ्गज्ञानेन निर्वृत्तम्<br><br>आनुमानिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಧಾನ<br><b>प्रयोगाः - </b>"आनुमानिकमप्येकेषामिति चेन्न"<br><b>उल्लेखाः - </b>ब्रह्म० सू० १-४-१<br><br>

आनुयात्रिक
आनुयात्रिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಬಾಲಕ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-१०९)<br><b>व्युत्पत्तिः - </b>अनुयात्रा प्रयोजनमस्य<br><b>प्रयोगाः - </b>"गृहीतविशेषमण्डनः प्रतीक्ष्यतामानुयात्रिको जनः"<br><b>उल्लेखाः - </b>मालती० ६<br><br>

आनुरक्ति
आनुरक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುರಾಗ /ಪ್ರೀತಿ<br><b>निष्पत्तिः - </b>आ + अनु + रञ्ज (रागे) - "क्तिन्" (३-३-९४)<br><br>

आनुलोमिक
आनुलोमिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕೂಲವಾಗಿರುವ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-२८)<br><b>व्युत्पत्तिः - </b>अनुलोमं वर्तते<br><br>

आनुलोम्य
आनुलोम्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಕೂಲವಾಗಿರುವಿಕೆ /ಹೊಂದಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अनुलोमस्य भावः<br><br>

आनुवंश्य
आनुवंश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಂಶಕ್ರಮವಾಗಿ ಬಂದಿರುವ<br><b>निष्पत्तिः - </b>"ञ्यः" (वा० ४-३-५९)<br><b>व्युत्पत्तिः - </b>अनुवंशं भवः<br><br>

आनुवेश्य
आनुवेश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೆರಮನೆಯ ಪಕ್ಕದ ಮನೆಯಲ್ಲಿ ವಾಸಮಾಡುವ<br><b>निष्पत्तिः - </b>"ञ्यः" (वा० ४-३-५९)<br><b>व्युत्पत्तिः - </b>अनुवेशं भवः<br><br>

आनुश्रविक
आनुश्रविक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇದವಿಹಿತವಾದ ಕರ್ಮ<br><b>निष्पत्तिः - </b>"ठञ्" (वा० ४-३-६०)<br><b>व्युत्पत्तिः - </b>अनुश्रूयते गुरुमुखात् इति अनुश्रवो वेदः, तत्र भवः<br><b>प्रयोगाः - </b>"दृष्टवदानुश्रविकः स ह्यविशुद्धिक्षयातिशययुक्तः"<br><b>उल्लेखाः - </b>सां० का० २<br><br>

आनुषङ्गिक
आनुषङ्गिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾಸಂಗಿಕವಾಗಿ ಒದಗಿದ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-९३)<br><b>व्युत्पत्तिः - </b>अनुषङ्गेण लभ्यम्<br><br>

आनुषङ्गिकी
आनुषङ्गिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಸಂಗಿಕವಾಗಿ ಒದಗಿದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

आनुष्टुभ
आनुष्टुभ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಷ್ಟುಭ್ ಛಂದಸ್ಸು<br><b>निष्पत्तिः - </b>अनुष्टुभ् - स्वार्थे "अण्" (५-४-३८)<br><br>आनुष्टुभ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಷ್ಟುಭ್ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>अनुष्टुभ इदम्<br><br>आनुष्टुभ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಷ್ಟುಭ್ ಛಂದಸ್ಸಿನ ಮಂತ್ರ<br><br>

आनृण्य
आनृण्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಋಣಶೂನ್ಯತೆ /ಸಾಲವಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अनृणस्य भावः<br><br>

आनृशंस्य
आनृशंस्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರುಣ್ಯ /ದಯಾಳುತ್ವ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अनृशंसस्य भावः<br><b>प्रयोगाः - </b>"अनृशंस्यमथवा न भज्यते तस्य संश्रितजनेषु जातुचित्"<br><b>उल्लेखाः - </b>याद० १७-६६<br><br>

आनेतृ
आनेतृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರೆತರುವ /ಬರಮಾಡುವ<br><b>निष्पत्तिः - </b>आ + णीञ् (प्रापणे) - "तृच्" (३-१-१३३)<br><br>

आनेत्री
आनेत्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರೆತರುವ /ಬರಮಾಡುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आनेय
आनेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರೆತರಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + णीञ् (प्रापणे) - "अच्" (३-३-५६)<br><br>

आन्तरतम्य
आन्तरतम्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪ ಸಂಬಂಧ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अन्तरतमस्य भावः<br><br>

आन्तरगारिक
आन्तरगारिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂತಃಪುರದಲ್ಲಿ ನಿಯುಕ್ತನಾದ ಪುರುಷನ ಧರ್ಮ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-४७)<br><b>व्युत्पत्तिः - </b>अन्तरागारस्य धर्म्यम्<br><br>

आन्तरिक्ष
आन्तरिक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂತರಿಕ್ಷದಲ್ಲಿ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-५३)<br><b>व्युत्पत्तिः - </b>अन्तरिक्षे भवः<br><br>

आन्तर्गेहिक
आन्तर्गेहिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನೊಯೊಳಗಿರುವ<br><b>निष्पत्तिः - </b>"ठञ्" (४-३-६७)<br><b>व्युत्पत्तिः - </b>अन्तर्गेहं भवः<br><br>

आन्तर्य
आन्तर्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಳಗಿನ ಭಾವ /ಹೃದಯದ ಆಶಯ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अन्तर्स्य भावः<br><br>आन्तर्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾದೃಶ್ಯ /ಹೋಲಿಕೆ<br><b>प्रयोगाः - </b>"यत्रानेकविधमान्तर्यं तत्र स्थानत आन्तर्यं बलीयः"<br><b>उल्लेखाः - </b>परि० १४<br><br>आन्तर्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೇದ /ವೈಲಕ್ಷಣ್ಯ<br><br>

आन्तिका
आन्तिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠ ಸಹೋದರಿ<br><br>

आन्त्र
आन्त्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರುಳು<br><b>निष्पत्तिः - </b>अम (गतौ) - "क्त्रः" (उ० ४-१६४)<br><b>व्युत्पत्तिः - </b>अमत्यनेन<br><b>प्रयोगाः - </b>"आन्त्रैः कल्पितमङ्गलप्रतिसराः"<br><b>उल्लेखाः - </b>मालती० ५-१८<br><br>

आन्दोल
आन्दोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಯ್ಯಾಲೆ /ತೂಗುಮಣೆ<br><b>निष्पत्तिः - </b>आन्दोल (दोलने) + णिच् - कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>आन्दोलयति अनेन<br><br>आन्दोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೂಗುವಿಕೆ<br><br>

आन्दोलक
आन्दोलक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೂಗುವವನು<br><br>

आन्दोलन
आन्दोलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಯ್ಯಾಲೆ /ತೂಗುಮಣೆ<br><b>निष्पत्तिः - </b>आन्दोल (दोलने) + णिच् - "ल्युट्" (३-३-११७)<br><br>आन्दोलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಮರವನ್ನು ಆಡಿಸುವುದು<br><br>

आन्दोलित
आन्दोलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಂಚಲವಾದ<br><br>आन्दोलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೂಗಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आन्दोल (दोलने) + णिच् - "क्तः" (३-२-१०२)<br><br>

आन्धसिक
आन्धसिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಡಿಗೆಯವನು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-५५)<br><b>व्युत्पत्तिः - </b>अन्धो भक्तं शिल्पमस्य<br><b>विस्तारः - </b>"आरालिका आन्धसिका सूदा औदनिका गुणाः" - अम० ।<br><br>

आन्ध्य
आन्ध्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುಡು /ಕಣ್ಣು ಕಾಣಿಸದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अन्धस्य भावः<br><br>

आन्ध्र
आन्ध्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಂಧ್ರದೇಶ<br><br>आन्ध्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆ ದೇಶದ ನಿವಾಸಿಗಳು<br><br>आन्ध्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆ ದೇಶದ ದೊರೆ<br><br>

आन्वाहिक
आन्वाहिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿದಿನವೂ ಉಂಟಾಗುವ<br><b>निष्पत्तिः - </b>"ठञ्" (वा० ४-३-६०)<br><b>व्युत्पत्तिः - </b>अहन्यहनि अन्वहम् । तत्र भवः<br><br>

आन्वीक्षिकी
आन्वीक्षिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತರ್ಕಶಾಸ್ತ್ರ<br><b>निष्पत्तिः - </b>"ठक्" (५-१-१०९)<br><b>व्युत्पत्तिः - </b>अनु श्रवणानन्तरं ईक्षणं परीक्षणं अन्वीक्षा, सा प्रयोजनमस्याः<br><br>आन्वीक्षिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಧ್ಯಾತ್ಮವಿದ್ಯೆ<br><b>प्रयोगाः - </b>"आन्वीक्षिक्यात्मविद्या स्यादीक्षणात्सुखदुःखयोः । ईक्षमाणस्तया तत्त्वं हर्षशोकौ व्युदस्यति ॥"<br><b>उल्लेखाः - </b>काम० नी० २-११<br><br>

आप
आप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಷ್ಟ ವಸುಗಳಲ್ಲೊಬ್ಬ<br><b>प्रयोगाः - </b>"धरो ध्रुवः सोमनामा तथापोऽप्यनिलोऽनलः । प्रत्यूषश्च प्रभासश्च वसवोऽष्टौ प्रकीर्तिताः ॥"<br><b>उल्लेखाः - </b>विष्णुध०<br><br>आप<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲರಾಶಿ /ನೀರಿನ ಸಮೂಹ<br><b>निष्पत्तिः - </b>"अण्" (४-२-३७)<br><b>व्युत्पत्तिः - </b>अपां समूहः<br><br>

आपक
आपक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದುವ /ಪಡೆಯುವ<br><b>निष्पत्तिः - </b>आप्लृ (व्याप्तौ) - "ण्वुल्" (३-१-१३३)<br><br>

आपगा
आपगा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನದಿ /ಹೊಳೆ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "डः" (वा० ३-२-४८)<br><b>व्युत्पत्तिः - </b>आपेन जलसमूहेन गच्छति<br><b>प्रयोगाः - </b>"श्रुतिप्रणयिनीं सोऽयमापगामापगामिव"<br><b>उल्लेखाः - </b>चं० रा० १<br><br>

आपगेय
आपगेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೀಷ್ಮಾಚಾರ್ಯರು<br><b>निष्पत्तिः - </b>"ढक्" (४-१-१२०)<br><b>व्युत्पत्तिः - </b>आपगाया अपत्यम्<br><br>

आपण
आपण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗಡಿ<br><b>निष्पत्तिः - </b>आ + पण (व्यवहारे स्तुतौ च) - "घः" (३-३-११९)<br><b>व्युत्पत्तिः - </b>आसमन्तात् पणन्तेऽत्र<br><b>प्रयोगाः - </b>"पूर्णापणं विपणिनो विपणीर्विभेजुः"<br><b>उल्लेखाः - </b>माघ० ५-२४<br><br>आपण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಯ ಮತ್ತು ವಿಕ್ರಯಗಳ ವ್ಯವಹಾರ<br><b>निष्पत्तिः - </b>आ + पण (व्यवहारे स्तुतौ च) - भावे "घञ्" (३-३-१८)<br><br>

आपणिक
आपणिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ತಕ<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५)<br><b>व्युत्पत्तिः - </b>आपणे व्यवहारोऽस्यास्ति<br><br>आपणिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಪಾರಸ್ಥಳದ ತೆರಿಗೆ<br><br>आपणिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೇಟೆ ಧಾರಣೆ /ಮಾರಾಟ ಪದಾರ್ಥಗಳ ದರ<br><br>आपणिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗಡಿಯಿಂದ ಬಂದ ಸುಂಕ<br><b>निष्पत्तिः - </b>"ठक्" (४-३-७५)<br><b>व्युत्पत्तिः - </b>आपणादागतः<br><br>

आपतत्
आपतत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಓಡಿ ಬರುವ<br><b>निष्पत्तिः - </b>आ + पत्लृ (गतौ) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"तमापतन्तं नृपतेरवध्यः वन्यः करोति श्रुतवान् कुमारः"<br><b>उल्लेखाः - </b>रघु० ५-५०<br><br>

आपतन
आपतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಭವ /ಘಟನೆ<br><br>आपतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಗಮನ /ಬರುವಿಕೆ<br><br>आपतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿಳುವಳಿಕೆ /ಜ್ಞಾನ<br><b>प्रयोगाः - </b>"प्राकरणिकादर्थात् अप्राकरणिकार्थस्यापतनम्"<br><br>आपतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಾನಾಗಿ ಬೀಳುವುದು<br><b>निष्पत्तिः - </b>आ + पत्लृ (गतौ) - भावे "ल्युट्" (३-३-११५)<br><br>

आपतित
आपतित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಭವಿಸಿದ<br><br>आपतित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಬಿದ್ದ<br><b>निष्पत्तिः - </b>आ + पत्लृ (गतौ) - "क्तः" (३-४-७२)<br><br>आपतित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಕಸ್ಮಾತ್ತಾಗಿ ಬಂದ<br><br>

आपत्कल्प
आपत्कल्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಷ್ಟದಿಂದ ಕೂಡಿದ ಕಾಲ<br><b>व्युत्पत्तिः - </b>आपदि उचितः कल्पः विधिः<br><b>प्रयोगाः - </b>"अब्राह्मणादध्ययनमापत्काले विधीयते"<br><b>उल्लेखाः - </b>मनु० २-२४१<br><br>

आपत्काल
आपत्काल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೊಂದರೆಯ ಕಾಲದಲ್ಲಿ ಉಂಟಾದ<br><br>

आपत्कालिक
आपत्कालिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಂದರೆಯ ಕಾಲದಲ್ಲಿ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>"ठञ्" "ञिठो" वा (वा० ४-२-११६)<br><b>व्युत्पत्तिः - </b>आपत्काले भवः<br><br>

आपत्कालिकी
आपत्कालिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಂದರೆಯ ಕಾಲದಲ್ಲಿ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>स्त्रियां ठञि "ङीप्" (४-१-१५)<br><br>

आपत्कालिका
आपत्कालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಂದರೆಯ ಕಾಲದಲ್ಲಿ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>स्त्रियां ञिठि "टाप्" (४-१-४)<br><br>

आपत्ति
आपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಪತ್ತು /ತೊಂದರೆ<br><b>निष्पत्तिः - </b>आ + पद (गतौ) - "क्तिन्" (३-३-९४)<br><br>आपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಪ್ತಿ<br><br>आपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಿಷ್ಟಪ್ರಸಂಗ<br><br>आपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಪದ್ಯಮಾನ ಅರ್ಥದಿಂದ ಉಪಪಾದಕಕಲ್ಪನೆ<br><br>

आपद्
आपद्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಂದರೆ /ಕಷ್ಟ<br><b>निष्पत्तिः - </b>आ + पद (गतौ) - "क्विप्" (वा० ३-३-९४)<br><b>प्रयोगाः - </b>"सहसा विदधीत न क्रियाम् अविवेकः परमापदां पदम्"<br><b>उल्लेखाः - </b>किरा० २-३०<br><br>

आपन्न
आपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಪತ್ತಿಗೆ ಒಳಗಾಗಿರುವವನು<br><b>निष्पत्तिः - </b>आ + पद (गतौ) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"आपन्नाभयसत्रेषु दीक्षिताः खलु पौरवाः"<br><b>उल्लेखाः - </b>शाकु० २-१६<br><br>आपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಟ್ಟ<br><br>

आपन्नसत्त्वा
आपन्नसत्त्वा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ಭಿಣಿ<br><b>व्युत्पत्तिः - </b>आपन्नं सत्त्वं प्राणी यया<br><b>प्रयोगाः - </b>"सममपन्नसत्त्वस्या रेजुरापाण्डुरत्विषः"<br><b>उल्लेखाः - </b>रघु० १०-५९<br><br>

आपमित्यक
आपमित्यक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬದಲಾವಣೆಯಿಂದ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>"कक्" (४-४-२१)<br><b>व्युत्पत्तिः - </b>अपमित्य परिवर्त्य निर्वृत्तम्<br><br>

आपराह्णिक
आपराह्णिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪರಾಹ್ಣದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"ठञ्" (४-३-११)<br><b>व्युत्पत्तिः - </b>अपराह्णे भवः<br><br>आपराह्णिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪರಾಹ್ಣಕಾಲದಲ್ಲಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-७९)<br><b>व्युत्पत्तिः - </b>अपराह्णेन निर्वृत्तम्<br><br>

आपस्
आपस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><b>निष्पत्तिः - </b>आप्लृ (व्याप्तौ) - "असुन्" (उ० ४-२०७)<br><br>

आपस्तम्ब
आपस्तम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಪಸ್ತಂಭ ಋಷಿ<br><br>आपस्तम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಪಸ್ತಂಭ ಧರ್ಮಸೂತ್ರ<br><br>आपस्तम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಪಸ್ತಂಭ ಗೃಹ್ಯ ಸೂತ್ರ<br><br>आपस्तम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಪಸ್ತಂಭ ಶ್ರೌತಸೂತ್ರ<br><br>

आपाक
आपाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆವಿಗೆ ಮನೆ /ಕುಂಬಾರನು ಮಣ್ಣಿನ ಪಾತ್ರೆಗಳನ್ನು ಬೇಯಿಸುವ ಸ್ಥಳ<br><b>निष्पत्तिः - </b>आ + डुपचष् (पाके) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>आसमन्तात् परिवेष्ट्य पच्यतेऽत्र<br><br>

आपात
आपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನಿರೀಕ್ಷಿತವಾದ ಆಗಮನ<br><b>निष्पत्तिः - </b>आ + पत्लृ (गतौ) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"गरुडापात विश्लिष्टमेघनादास्त्रबन्धनः"<br><b>उल्लेखाः - </b>रघु० १२-७६<br><br>आपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿವೇಚನೆ ಮಾಡದೆ ಅರ್ಥಮಾಡಿಕೊಳ್ಳುವಿಕೆ<br><b>प्रयोगाः - </b>"आपाततो यदर्थस्य पौनरुक्त्येन भासनम्"<br><b>उल्लेखाः - </b>सा० द० १०-२<br><br>आपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ /ಉಪಕ್ರಮ<br><b>प्रयोगाः - </b>"शक्तः परिजने दाता स्वजने दुःखजीविनि । मध्वापातो विषास्वादः स धर्मप्रतिरूपकः ॥"<br><b>उल्लेखाः - </b>मनु० ११-९<br><br>आपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ತಮಾನ ಕಾಲ<br><b>प्रयोगाः - </b>"आपातरम्या विषयाः पर्यन्तपरितापिनः"<br><b>उल्लेखाः - </b>किरा० ११-१२<br><b>विस्तारः - </b>"तदात्वे पात आपातः" - वैज० ।<br><br>

आपातलिका
आपातलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೃತ್ತರತ್ನಾಕರದಲ್ಲಿ ಹೇಳಿರುವ ಮಾತ್ರಾವೃತ್ತದ ಒಂದು ಭೇದ<br><b>प्रयोगाः - </b>"आपातलिका कथितेयं भाद्गुरुकावथ पूर्ववदन्यत्"<br><b>उल्लेखाः - </b>वृ० र०<br><br>

आपाततस्
आपाततस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಕಸ್ಮಾತ್ತಾಗಿ<br><br>आपाततस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿವೇಚನೆ ಮಾಡದೆ<br><b>प्रयोगाः - </b>"आपाततो यदर्थस्य पौनरुक्त्येन भासनम्"<br><b>उल्लेखाः - </b>सा० द० १०-२<br><br>

आपाद
आपाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಗಮನ<br><b>निष्पत्तिः - </b>आ + पद (गतौ) - "घञ्" (३-३-१८)<br><br>आपाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಪ್ತಿ<br><br>आपाद<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕಾಲಿನವರೆಗೂ<br><b>व्युत्पत्तिः - </b>पादमभिव्याप्य<br><br>

आपादन
आपादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪಾದನೆ<br><br>आपादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಪಾದನೆ /ತಪು ಹೊರಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + पद (गतौ) + णिच् - "ल्युट्" (३-३-११५)<br><br>

आपान
आपान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾನಗೋಷ್ಠಿ<br><b>निष्पत्तिः - </b>आ + पा (पाने) - अधि० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>आ सम्भूय पिबन्त्यत्र<br><br>आपान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಟ್ಟಿಗೆ ಕಲೆತು ಪಾನಮಾಡುವುದು<br><b>निष्पत्तिः - </b>आ + पा (पाने) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"ताम्बूलीनां दलैस्तत्र रचितापानभूमयः"<br><b>उल्लेखाः - </b>रघु० ४-४२<br><br>

आपायिन्
आपायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾನ ಮಾಡುವ<br><b>निष्पत्तिः - </b>आ + पा (पाने) - "णिनिः" (३-२-७८)<br><br>

आपायिनी
आपायिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾನ ಮಾಡುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आपालि
आपालि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೇನು /ಕೂರೆ<br><b>निष्पत्तिः - </b>अल (भूषणादौ) - "इन्" (उ० ४-११७)<br><b>व्युत्पत्तिः - </b>आपार्थं रक्तपानार्थं अलति<br><br>

आपिञ्जर
आपिञ्जर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಂಬಣ್ಣ /ಹಳದಿ ಬಣ್ಣ<br><br>आपिञ्जर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುವರ್ಣ /ಚಿನ್ನ<br><b>व्युत्पत्तिः - </b>आ ईषत् पिञ्जरम्<br><br>आपिञ्जर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂಬಣ್ಣದ<br><b>प्रयोगाः - </b>"आपिञ्जरा बद्धरजःकणत्वात्"<br><b>उल्लेखाः - </b>रघु० १५-५१<br><br>

आपिशल
आपिशल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಪಿಶಲಿಯ ಗ್ರಂಥವನ್ನು ಓಡುವ ಶಿಷ್ಯ<br><b>निष्पत्तिः - </b>"अण्" (४-२-११२) । "अण्" (४-२-५९) । "लुक्" (४-२-६४)<br><b>व्युत्पत्तिः - </b>आपिशलिना प्रोक्तमधीते<br><br>

आपिशलि
आपिशलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣಶಾಸ್ತ್ರದ ಪ್ರವರ್ತಕರಲ್ಲೊಬ್ಬ<br><b>निष्पत्तिः - </b>"इञ्" (४-१-९५)<br><b>व्युत्पत्तिः - </b>आपिशलस्यापत्यम्<br><b>प्रयोगाः - </b>"इन्द्रश्चन्द्रः काशकृत्स्नापिशलिः शाकटायनः । पाणिन्यमरजैनेन्द्राः जयन्त्यष्टाब्दिशाब्दिकाः ॥"<br><br>

आपी
आपी<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೊಡ್ಡ ದಾದ /ದಪ್ಪನಾದ<br><b>निष्पत्तिः - </b>आ + ओप्यायी (वृद्धौ) - "क्विप्" (३-२-७६)<br><br>

आपीड
आपीड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾರ /ಪುಷ್ಪಮಾಲೆ<br><b>निष्पत्तिः - </b>आ + पीड (अवगाहने) + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आपीडयति<br><br>आपीड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯ ಆಭರಣ /ಶಿರೋಭೂಷಣ<br><b>प्रयोगाः - </b>"चूडापीडकपालसङ्कुलगलन्मन्दाकिनीवारयो विद्युत्प्रायललाटलोचनशिखिज्वालावमिश्रत्विषः"<br><b>उल्लेखाः - </b>मालती० १-१<br><br>आपीड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೀಡಿಸುವ /ಹಿಂಸಿಸುವ<br><br>आपीड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಮುಕುವ /ಹಿಸುಕುವ<br><br>

आपीडन
आपीडन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮುಕುವುದು<br><b>निष्पत्तिः - </b>आ + पीड (अवगाहने) - भावे "ल्युट्" (३-३-११५)<br><br>आपीडन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೋಯಿಸುವುದು<br><br>आपीडन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಲಿಂಗನ<br><br>

आपीडित
आपीडित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಸುಕಲ್ಪಟ್ಟ<br><br>आपीडित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಲಿಂಗಿಸಲ್ಪಟ್ಟ<br><br>आपीडित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಲೆಯ ಆಭರಣದಿಂದ ಅಲಂಕರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + पीड (अवगाहने) - "क्तः" (३-२-१०२)<br><br>आपीडित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಯಿಸಲ್ಪಟ್ಟ<br><br>

आपीत
आपीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂಬಣ್ಣದ<br><b>व्युत्पत्तिः - </b>आसमन्तात् पीतम्<br><br>आपीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಕುಡಿಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + पा (पाने) - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>आ ईषत् पीतम्<br><br>

आपीन
आपीन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೂಪ /ಬಾವಿ<br><br>आपीन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸು ಮೊದಲಾದ ಪ್ರಾಣಿಗಳ ಕೆಚ್ಚಲು<br><b>निष्पत्तिः - </b>आ + ओप्यायी (वृद्धौ) - "क्तः" (३-४-७२) पीभावः (वा० ६-१-२८)<br><b>प्रयोगाः - </b>"आपीनभारोद्वहनप्रयत्नाद्गृष्टिर्गुरुत्वाद्वपुषो नरेन्द्रः"<br><b>उल्लेखाः - </b>रघु० २-१८<br><br>आपीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ದಪ್ಪನಾಗಿರುವ<br><br>आपीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ದಪ್ಪನಾಗಿರುವ<br><br>

आपूपिक
आपूपिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಪೂಪಗಳ ರಾಶಿ<br><b>निष्पत्तिः - </b>"ठक्" (४-२-४८)<br><b>व्युत्पत्तिः - </b>अपूपानां समूहः<br><br>आपूपिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೊಟ್ಟಿ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-५५)<br><b>व्युत्पत्तिः - </b>अपूपः शिल्पमस्य<br><br>आपूपिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೊಟ್ಟಿಯನ್ನು ತಿನ್ನುವ ಸ್ವಭಾವದವನು<br><b>निष्पत्तिः - </b>"ठक्"(४-४-६१)<br><b>व्युत्पत्तिः - </b>अपूपभक्षणं शीलमस्य<br><br>आपूपिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೊಟ್ಟಿಯನ್ನು ಮಾರುವವನು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-५१)<br><b>व्युत्पत्तिः - </b>अपूपः पण्यमस्य<br><br>आपूपिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೊಟ್ಟಿಯನ್ನು ತಿನ್ನಲು ಹಿತವಾದ ಬೆಲ್ಲ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>"ठञ्" (४-४-१०३)<br><b>व्युत्पत्तिः - </b>अपूपभक्षणे साधु<br><br>आपूपिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೊಟ್ಟಿಯನ್ನು ತಿನ್ನಲು ಹಿತವಾಗಿರುವ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-६५)<br><b>व्युत्पत्तिः - </b>अपूपभक्षणं हितमस्मै<br><br>

आपूप्य
आपूप्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೊಟ್ಟಿಯನ್ನು ತಯಾರಿಸುವ ಹಿಟ್ಟು<br><b>निष्पत्तिः - </b>"यत्" (४-४-९८)<br><b>व्युत्पत्तिः - </b>अपूपाय साधुः<br><br>

आपूर
आपूर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನ ಪ್ರವಾಹ<br><b>निष्पत्तिः - </b>आ + पूरी (आप्यायने) + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आपूरयति<br><b>प्रयोगाः - </b>"स्वेदापूरो युवतिसरितां व्याप गण्डस्थलानि"<br><b>उल्लेखाः - </b>माघ० ७-७४<br><br>आपूर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ತುಂಬುವುದು<br><b>निष्पत्तिः - </b>भावे "घञ्" (३-३-१८)<br><br>

आपूरण
आपूरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ತುಂಬುವುದು<br><b>निष्पत्तिः - </b>आ + पूरी (आप्यायने) - भावे "ल्युट्" (३-३-११५)<br><br>आपूरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ತುಂಬುವ<br><b>निष्पत्तिः - </b>आ + पूरी (आप्यायने) - "ल्युः" (३-१-१३४)<br><br>

आपूरित
आपूरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ತುಂಬಲ್ಪಟ್ಟ<br><br>आपूरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಸುತ್ತಲೂ ಹರಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + पूरी (आप्यायने) + णिच् - "क्तः" (३-२-१०२)<br><br>

आपूर्ण
आपूर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ತುಂಬಲ್ಪಟ್ಟ /ಸಂಪೂರ್ಣವಾಗಿರುವ<br><b>निष्पत्तिः - </b>आ + पूरी (आप्यायने) - "क्तः" (३-२-१०२)<br><br>

आपूर्यमाण
आपूर्यमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ತುಂಬಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + पॄ (पालनपूरणयोः) - कर्म० "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"आपूर्यमाणमचलप्रतिष्ठं समुद्रमापः प्रविशन्ति यद्वत्"<br><b>उल्लेखाः - </b>गीता० २-७०<br><br>

आपूष
आपूष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತವರ<br><b>निष्पत्तिः - </b>आ + पूष (वृद्धौ) - "घञ्" (३-३-१२१)<br><br>

आपृच्छा
आपृच्छा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಿಳಿದುಕೊಳ್ಳುವ ಅಪೇಕ್ಷೆ<br><br>आपृच्छा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಶಲಪ್ರಶ್ನೆ<br><br>आपृच्छा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಭಾಷಣೆ<br><b>निष्पत्तिः - </b>आ + प्रच्छ (ज्ञीप्सायाम्) - "अः" (३-३-१०३)<br><br>

आपृच्छ्य
आपृच्छ्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೇಳಿ /ಪ್ರಶ್ನೆ ಮಾಡಿ<br><b>निष्पत्तिः - </b>आ + प्रच्छ (ज्ञीप्सायाम्) - "ल्यप्" (७-१-३७)<br><br>

आपेक्षिक
आपेक्षिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆಯಿಂದ ಬಂದ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-७९)<br><b>व्युत्पत्तिः - </b>अपेक्षया निर्वृत्तम्<br><br>

आपोक्लिम
आपोक्लिम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಗ್ನದಿಂದ ೩ ೬ ೯ ಮತ್ತು ೧೨ ನೆಯ ಸ್ಥಾನಗಳು<br><b>प्रयोगाः - </b>"तृतीयं षष्ठनवममन्त्यं चापोक्लिमं विदुः"<br><br>

आपोमय
आपोमय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲವಿಕಾರ<br><br>आपोमय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಲಮಯವಾದ<br><b>निष्पत्तिः - </b>आपस् - विकारार्थे प्राचुर्यार्थे "मयट्" (४-३-१४३)<br><br>

आपोशन
आपोशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೋಜನಕ್ಕೆ ಪೂರ್ವದಲ್ಲಿ ಮತ್ತು ಭೋಜನಾನಂತರ ಆಹಾರಕ್ಕೆ ಆಸ್ತರಣ ಮತ್ತು ಪಿಧಾನರೂಪವಾಗಿ ಮಂತ್ರಪೂರ್ವಕ ಮಾಡುವ ಜಲಪ್ರಾಶನ<br><b>निष्पत्तिः - </b>आपस् + अश (भोजने) - "ल्युट्" (३-३-११५)<br><br>

आप्त
आप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಟ್ಟ /ಪಡೆಯಲ್ಪಟ್ಟ<br><br>आप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಂಬಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आप्लृ (व्याप्तौ) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"कुमारभृत्याकुशलैरनुष्ठिते भिषग्भिराप्तैरथ गर्भभर्मणि"<br><b>उल्लेखाः - </b>रघु० ३-१२<br><br>आप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರವೀಣ /ನಿಪುಣ<br><b>प्रयोगाः - </b>"प्राजकश्चेदभवेदाप्तः प्राजको दण्डमर्हति"<br><b>उल्लेखाः - </b>मनु० ८-२९४<br><br>आप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪ ಸಂಬಂಧವುಳ್ಳ<br><b>प्रयोगाः - </b>"आप्तबन्धुरदितेरजं सुतः"<br><b>उल्लेखाः - </b>याद० १७-१२७<br><br>आप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಂಧು /ನೆಂಟ<br><b>प्रयोगाः - </b>"निग्रहात् स्वसुराप्तानां वधाच्च धनदानुजः"<br><b>उल्लेखाः - </b>रघु० १२-५२<br><br>आप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸರಿಯಾದ ಕಾರಣದಿಂದ ಕೂಡಿದ<br><br>आप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧಾರಾಳವಾದ<br><b>प्रयोगाः - </b>"यजेत राजा क्रतुभिर्विविधैराप्तदक्षिणैः"<br><b>उल्लेखाः - </b>मनु० ७-७९<br><br>

आप्तकाम
आप्तकाम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><br>आप्तकाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟಾರ್ಥವನ್ನು ಹೊಂದಿರುವ<br><b>प्रयोगाः - </b>"आप्तकाम, सृजसि त्रिजगत्किम्"<br><b>उल्लेखाः - </b>नैष० २१-१०५<br><br>आप्तकाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾಪಂಚಿಕ ಸೌಖ್ಯವನ್ನು ತ್ಯಜಿಸಿದ<br><b>व्युत्पत्तिः - </b>आप्तः प्राप्तः कामो येन<br><br>

आप्तवचन
आप्तवचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಂಬಿಕೆಯಾದ ಮಾತು /ಯುಕ್ತಿಯಿಂದ ಕೂಡಿದ ಮಾತು<br><br>

आप्तवाक्य
आप्तवाक्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಂಬಿಕೆಯಾದ ಮಾತು /ಯುಕ್ತಿಯಿಂದ ಕೂಡಿದ ಮಾತು<br><br>

आप्तवाच्
आप्तवाच्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇದ<br><br>आप्तवाच्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಮೃತಿ ಇತಿಹಾಸಾದಿಗಳು<br><b>व्युत्पत्तिः - </b>आप्ता वाक्<br><b>प्रयोगाः - </b>"आप्तवागनुमानाभ्यां साध्यं त्वां प्रति का कथा"<br><b>उल्लेखाः - </b>रघु० १०-२८<br><br>आप्तवाच्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಂಬಿಕೆಗೆ ಅರ್ಹನಾದವನ ಮಾತು<br><br>आप्तवाच्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಂಬಿಕೆಯಾದ ಮಾತುಳ್ಳ<br><b>व्युत्पत्तिः - </b>आप्ता वाग्यस्य<br><br>

आप्तश्रुति
आप्तश्रुति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇದ<br><br>आप्तश्रुति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಮೃತಿ ಇತಿಹಾಸಾದಿಗಳು<br><br>

आप्ति
आप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಂದುವಿಕೆ /ಪಡೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>आप्लृ (व्याप्तौ) - "क्तिन्" (३-३-९४)<br><br>आप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ /ಯೋಗ<br><b>विस्तारः - </b>"प्राप्तिसम्बन्धयोराप्तिः" - शाश्व० । "आप्तिः सम्बन्धलाभयोः" - हेम० ।<br><br>आप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತ್ರೀಸಂಬಂಧ<br><b>विस्तारः - </b>"आप्तिः स्त्रीयोगसम्प्राप्तयोः" - मेदि० ।<br><br>आप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಲುಪುವುದು /ಸೇರುವುದು<br><br>आप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯುಕ್ತತೆ /ಔಚಿತ್ಯ<br><br>

आप्य
आप्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲವಿಕಾರ /ನೀರಿನಿಂದ ಉಂಟಾದ ನೊರೆ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०) । ततः स्वार्थे "ष्यञ्" (वा० ७-३-३१)<br><b>व्युत्पत्तिः - </b>अपामिदम्<br><br>आप्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಂದಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>आप्लृ (व्याप्तौ) - "ण्यत्" (३-१-१२४)<br><b>व्युत्पत्तिः - </b>आप्तुं योग्यम्<br><br>

आप्यान
आप्यान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುರಾಗ /ಪ್ರೀತಿ<br><br>आप्यान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೃದ್ಧಿ /ಬೆಳವಣಿಗೆ<br><br>आप्यान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿ ಹೊಂದಿದ<br><br>आप्यान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೃದ್ಧಿ ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>आ + ओप्यायी (वृद्धौ) - "क्तः" (३-४-७२) । नत्वम् (८-२-४५)<br><br>

आप्यायन
आप्यायन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿಸುವುದು<br><br>आप्यायन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೃಪ್ತಿಪಡಿಸುವುದು<br><br>आप्यायन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೃದ್ಧಿಪಡಿಸುವುದು<br><b>निष्पत्तिः - </b>आ + ओप्यायी (वृद्धौ) - "ल्युट्" (३-३-११५)<br><br>आप्यायन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿ<br><br>आप्यायन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೃದ್ಧಿ<br><br>आप्यायन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆಳೆಸುವ /ಅಧಿಕಪಡಿಸುವ<br><b>निष्पत्तिः - </b>आ + ओप्यायी (वृद्धौ) - "ल्युः" (३-१-१३४)<br><br>

आप्यायित
आप्यायित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೃಪ್ತಿಪಡಿಸಲ್ಪಟ್ಟ<br><br>आप्यायित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + ओप्यायी (वृद्धौ) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"तदुक्तिभिस्स्वादुतमाभिरासीदाप्यायितो नूनमनाविलाभिः"<br><b>उल्लेखाः - </b>याद० १३-३७<br><br>आप्यायित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆಳೆಸಲ್ಪಟ್ಟ<br><br>

आप्रच्छन
आप्रच्छन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಧುಗಳ ಬೇಟಿಯ ಕಾಲದಲ್ಲಿ ಮಾಡುವ ಪರಸ್ಪರ ಕುಶಲಪ್ರಶ್ನೆ<br><br>आप्रच्छन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊರಡುವಾಗ ಪಡೆಯುವ ಅಪ್ಪಣೆ<br><br>

आप्रच्छन्न
आप्रच्छन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಅಂತರಂಗವಾದ<br><b>निष्पत्तिः - </b>आ + प्र + छदिर् (अपवारणे) - "क्तः" (३-२-१०२)<br><br>

आप्रपद
आप्रपद<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕಾಲಿನ ತುದಿಯವರೆಗೂ<br><b>निष्पत्तिः - </b>अव्ययी०<br><b>व्युत्पत्तिः - </b>प्रपदमभिव्याप्य<br><br>

आप्रपदीन
आप्रपदीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಲಿನ ತುದಿಯವರೆಗೂ ಜೊಲಾಡುವ<br><b>निष्पत्तिः - </b>"खः" (५-२-८)<br><b>व्युत्पत्तिः - </b>आप्रपदं प्राप्नोति<br><br>

आप्लव
आप्लव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ನಾನ<br><br>आप्लव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರನ್ನು ಚಿಮುಕಿಸುವುದು<br><b>निष्पत्तिः - </b>आ + प्लुङ् (गतौ) - "अप्" (३-३-५७)<br><br>आप्लव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ನಾನ ಮಾಡುವ<br><b>निष्पत्तिः - </b>आ + प्लुङ् (गतौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आप्लवते<br><br>

आप्लवन
आप्लवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ನಾನ<br><b>निष्पत्तिः - </b>आ + प्लुङ् (गतौ) - भावे "ल्युट्" (३-३-११५)<br><br>

आप्लवव्रतिन्
आप्लवव्रतिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ನಾತಕ /ಸಾಂಗ ವೇದಾಧ್ಯಯನ ಮಾಡಿ ವಿವಾಹಕ್ಕೆ ಮುಂಚಿತವಾಗಿ ವ್ರತಸ್ನಾನ ಮಾಡಿದವನು<br><b>व्युत्पत्तिः - </b>आप्लवश्चासै व्रती च<br><br>

आप्लाव
आप्लाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ನಾನ<br><br>आप्लाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರನ್ನು ಚಿಮುಕಿಸುವುದು<br><br>आप्लाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನಲ್ಲಿ ಮುಳುಗಿಸುವುದು<br><br>आप्लाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರವಾಹ<br><b>निष्पत्तिः - </b>आ + प्लुङ् (गतौ) - "घञ्" (३-३-५०)<br><br>

आप्लावित
आप्लावित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರಿನ ಪ್ರವಾಹದಲ್ಲಿ ಮುಳುಗಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + प्लुङ् (गतौ) + णिच् - "क्तः" (३-२-१०२)<br><br>

आप्लुङ्|आ + प्लुङ्|गतौ 
आ + प्लुङ् - गतौ<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>प्लुङ् ಧಾತುವಿನ ಅರ್ಥ<br><br>

आप्लुत
आप्लुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ನಾತಕ /ಸಾಂಗ ವೇದಾಧ್ಯಯನ ಮಾಡಿ ವಿವಾಹಕ್ಕೆ ಮುಂಚಿತವಾಗಿ ವ್ರತಸ್ನಾನ ಮಾಡಿದವನು<br><b>निष्पत्तिः - </b>आ + प्लुङ् (गतौ) - "क्तः" (३-४-७२)<br><br>आप्लुत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ನಾನ<br><b>निष्पत्तिः - </b>भावे "क्तः" (३-३-११४)<br><br>आप्लुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ನಾನ ಮಾಡಿದ<br><b>निष्पत्तिः - </b>कर्त० "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"आप्लुतास्तीरमन्दारकुसुमोत्किरवीचिषु"<br><b>उल्लेखाः - </b>कुमा० ६-५<br><br>आप्लुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೆನೆದಿರುವ<br><b>निष्पत्तिः - </b>कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"यावन्नाश्यायते वेदिरभिषेकजलाप्लुता"<br><b>उल्लेखाः - </b>रघु० १७-३७<br><br>

आप्लुतव्रतिन्
आप्लुतव्रतिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>आप्लवव्रतिन् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>आप्लुतस्य व्रतमस्त्यस्य<br><br>

आप्लुत्य
आप्लुत्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸ್ನಾನ ಮಾಡಿ<br><br>आप्लुत्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರಿ<br><b>निष्पत्तिः - </b>आ + प्लुङ् (गतौ) - "ल्यप्" (७-१-३७)<br><br>

आल्पुष्ट
आल्पुष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಸುಡಲ್ಪಟ್ಟ<br><br>आल्पुष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಸುಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + प्लुष (दाहे)- "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>आ सम्यक् ईषद् वा प्लुष्टः<br><br>

आबद्ध
आबद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಟ್ಟಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>आसमन्तात् बद्धः<br><b>प्रयोगाः - </b>"आबद्धप्रचुरपरार्ध्यकिङ्किणीकः"<br><b>उल्लेखाः - </b>माघ० ८-४५<br><br>आबद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + बन्ध (बन्धने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"मृगद्वन्द्वेषु पश्यन्तौ स्यन्दनाबद्धदृष्टिषु"<br><b>उल्लेखाः - </b>रघु० १-४०<br><br>आबद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಲ್ಪಟ್ಟ<br><br>आबद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಯಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"पयोधिमाबद्धचलज्जलाविलं विलङ्घ्य लङ्कां निकषा हनिष्यति"<br><b>उल्लेखाः - </b>माघ० १-६८<br><br>आबद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಟ್ಟ<br><br>आबद्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಡವೆ /ಆಭರಣ<br><b>विस्तारः - </b>"अलङ्कारोऽपि चाबद्धः" - त्रिकाण्ड० ।<br><br>आबद्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೊಗಕಟ್ಟು<br><br>आबद्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿ<br><br>

आबन्ध
आबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೊಗಕಟ್ಟು<br><br>आबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೃಢವಾಗಿ ಕಟ್ಟುವುದು<br><br>आबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿ<br><b>निष्पत्तिः - </b>आ + बन्ध (बन्धने) - भावे कर० अधि० वा "घञ्" (३-३-१८, १२१)<br><br>आबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ<br><b>प्रयोगाः - </b>"प्रेमाबन्धविवर्धिताधिकरसा प्रीतिस्तु या सा त्वयि"<br><b>उल्लेखाः - </b>रत्ना० ३-१८<br><br>

आबन्धन
आबन्धन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>आबन्ध ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

आबर्ह
आबर्ह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸುವುದು<br><b>निष्पत्तिः - </b>आ + बर्ह (हिंसायाम्) - भावे "घञ्" (३-३-१८)<br><br>आबर्ह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿತ್ತು ಒಗೆಯುವುದು<br><br>

आबर्हण
आबर्हण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>आबर्ह ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

आबाध
आबाध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೀಡೆ /ತೊಂದರೆ<br><br>आबाध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಡೆ<br><b>निष्पत्तिः - </b>आ + बाधृ (विलोडने) - भावे "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"न चैनं पादतः कुर्यान्नप्राणाबाधमाचरेत्"<br><b>उल्लेखाः - </b>मनु० ४-५५<br><br>

आबाधा
आबाधा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೀಡೆ /ತೊಂದರೆ<br><br>आबाधा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಷ್ಟ /ಕ್ಲೇಶ<br><b>निष्पत्तिः - </b>आ + बाधृ (विलोडने) - "अः" (३-३-१०३)<br><br>

आभरण
आभरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಷಣ /ಒಡವೆ<br><b>निष्पत्तिः - </b>आ + भृञ् (भरणे) - "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>आ भ्रियतेऽनेन<br><b>प्रयोगाः - </b>"किमित्यपास्याभरणानि यौवने धृतं त्वया वार्धकशोभि वल्कलम्"<br><b>उल्लेखाः - </b>कुमा० ५-४४<br><br>आभरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಪೋಷಿಸುವುದು<br><b>निष्पत्तिः - </b>आ + भृञ् (भरणे) - भावे "ल्युट्" (३-३-११५)<br><br>

आभरित
आभरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತುಂಬಲ್ಪಟ್ಟ<br><br>आभरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲಂಕರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>आभरोऽस्य सञ्जातः<br><br>

आभर्मन्
आभर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಪೋಷಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + डुभृञ् (धारणपोषणयोः) - "मनिन्" (उ० ४-१४५)<br><br>

आभा
आभा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂತಿ /ಬೆಳಕು<br><br>आभा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾದೃಶ್ಯ /ಹೋಲಿಕೆ<br><b>निष्पत्तिः - </b>आ + भा (दीप्तौ) - "अङ्" (३-३-१०६)<br><b>प्रयोगाः - </b>"मरुत्प्रयुक्ताश्च मरुत्सखाभं तमर्च्यमारादभिवर्तमानम्"<br><b>उल्लेखाः - </b>रघु० २-१०<br><br>

आभाति
आभाति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಬಿಂಬ /ಛಾಯೆ<br><b>निष्पत्तिः - </b>आ + भा (दीप्तौ) - "क्तिच्" (३-३-१७४)<br><br>

आभाणक
आभाणक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೋಕೋಕ್ತಿ /ಗಾದೆ<br><br>

आभाषण
आभाषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಸ್ಪರ ಮಾತಾಡುವುದು<br><b>निष्पत्तिः - </b>आ + भाष (व्यक्तायां वाचि) - "ल्युट्" (३-३-११७)<br><b>प्रयोगाः - </b>"सम्बन्धमाभाषणपूर्वमाहुर्वृत्तः स नौ सङ्गतयोर्वनान्ते"<br><b>उल्लेखाः - </b>रघु० २-५८<br><br>आभाषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬೋಧನೆ<br><br>

आभाष्य
आभाष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾತಾಡಲ್ಪಡುವ<br><br>आभाष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬೋಧಿಸಲು ಯೋಗ್ಯನಾದ<br><b>निष्पत्तिः - </b>आ + भाष (व्यक्तायां वाचि) - "ण्यत्" (३-१-१२४)<br><br>आभाष्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಬೋಧಿಸಿ<br><br>आभाष्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮಾತನಾಡಿಸಿ<br><b>निष्पत्तिः - </b>आ + भाष (व्यक्तायां वाचि) - "ल्यप्" (७-१-३७)<br><br>

आभास
आभास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೇತುವಿನಂತೆ ತೋರುವ ಮಿಥ್ಯೆಯಾದ ಹೇತು /ನಿಜವಲ್ಲದ ಹೇತು<br><br>आभास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೇತುವಿನ ದೋಷ<br><br>आभास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಬಿಂಬ /ಛಾಯೆ<br><b>निष्पत्तिः - </b>आ + भासृ (दीप्तौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आ समन्तात् भासते<br><br>आभास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾದೃಶ್ಯ /ಹೋಲಿಕೆ<br><b>प्रयोगाः - </b>"नभश्च रुधिराभासम्"<br><b>उल्लेखाः - </b>रामा०<br><br>आभास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ದೇಶ /ತಾತ್ಪರ್ಯ<br><br>आभास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭ್ರಾಂತಿ /ತಪ್ಪು ತಿಳುವಳಿಕೆ<br><br>आभास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭ್ರಾಂತಿಯ ವಿಷಯ /ತಪ್ಪಾಗಿ ತಿಳಿಯಲ್ಪಡುವ ವಸ್ತು<br><br>

आभासुर
आभासुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಪ್ರಕಾಶಿಸುವ<br><b>निष्पत्तिः - </b>आ + भासृ (दीप्तौ) - "घुरच्" (३-२-१६१)<br><br>

आभास्वर
आभास्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೬೪ ಗಣದೇವತೆಗಳಸಮುದಾಯ<br><br>आभास्वर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಪ್ರಕಾಶಿಸುವ<br><b>निष्पत्तिः - </b>आ + भासृ (दीप्तौ) - "वरच्" (३-२-१७५)<br><br>

आभिचरणिक
आभिचरणिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶತ್ರುನಿಗ್ರಹ ಮತ್ತು ಶತ್ರುವಶೀಕರಣಗಳಿಗಾಗಿ ಮಾಡುವ ಮಾಟ /ಶೂನ್ಯ ಮೊದಲಾದುವುಗಳ ಮಂತ್ರ<br><br>आभिचरणिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಟ ಶೂನ್ಯ ಮುಂತಾದುವುಗಳ ಕ್ರಮ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-१०९)<br><b>व्युत्पत्तिः - </b>अभिचरणं प्रयोजनमस्य<br><br>

आभिचरणिकी
आभिचरणिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आभिचरणिक ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

आभिचारिक
आभिचारिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>आभिचरणिक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-१०९)<br><b>व्युत्पत्तिः - </b>अभिचारः प्रयोजनमस्य<br><br>

आभिचारिकी
आभिचारिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आभिचरणिक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

आभिजन
आभिजन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಂಶದಿಂದ ಬಂದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-७४)<br><b>व्युत्पत्तिः - </b>अभिजनादागतः<br><b>प्रयोगाः - </b>"तां पार्वतीमाभिजनेन नाम्ना बन्धुप्रियां बन्धुजनो जुहाव"<br><b>उल्लेखाः - </b>कुमा० १-२६<br><br>

आभिजात्य
आभिजात्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಕುಲಪ್ರಸೂತತ್ವ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अभिजातस्य भावः<br><b>प्रयोगाः - </b>"इत्थं नः सहसाभिजात्यजनिता सेवैव देव्याः परम्"<br><b>उल्लेखाः - </b>रत्ना० ३-१८<br><br>आभिजात्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಂಡಿತ್ಯ /ವೈದುಷ್ಯ<br><br>आभिजात्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನ್ಯಾಯ /ಕ್ರಮ<br><b>विस्तारः - </b>"न्याय्ये कुलीनबुधयोरभिजातपदं विदुः" - शाश्व० ।<br><br>

आभिजित
आभिजित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿಜಿತ್ ನಕ್ಷತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-२५)<br><b>व्युत्पत्तिः - </b>अभिजिति नक्षत्रे जातः<br><br>

आभिधा
आभिधा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>अभिधा ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्वार्थे "अण्"<br><br>

आभिधानिक
आभिधानिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಶಗಾರ /ನಿಘಂಟುವಿನ ಲೇಖಕ<br><b>निष्पत्तिः - </b>"ठक्" (४-२-६३)<br><b>व्युत्पत्तिः - </b>अभिधानं वेत्ति<br><br>

आभिमुख्य
आभिमुख्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರಾಗುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अभिमुखस्य भावः<br><b>प्रयोगाः - </b>"तैस्तैर्बन्धुवधूजनस्य वचनैर्नीताभिमुख्यं पुनः"<br><b>उल्लेखाः - </b>रत्ना० १-२<br><br>आभिमुख्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಕೂಲವಾಗಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"विशेषादाभिमुख्येन चरणाद्व्यभिचारिणः"<br><b>उल्लेखाः - </b>सा० द० ३-१४०<br><br>

आभिरूपक
आभिरूपक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌಂದರ್ಯ<br><b>निष्पत्तिः - </b>"वुञ्" (५-१-१३३)<br><b>व्युत्पत्तिः - </b>अभिरूपस्य भावः<br><br>

आभिरूप्य
आभिरूप्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌಂದರ್ಯ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अभिरूपस्य भावः<br><b>प्रयोगाः - </b>"अर्चकस्य तपोयोगात् अर्चनस्यातिशायनात् । आभिरूप्याच्च बिम्बानां देवः सान्निध्यमृच्छति ॥"<br><br>

आभिषिक्त
आभिषिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿಷೇಕದಿಂದುಂಟಾದ<br><b>निष्पत्तिः - </b>"अञ्" (४-२-७५)<br><b>व्युत्पत्तिः - </b>अभिषिक्तमभिषेकः । अभिषिक्तेन निर्वृत्तम्<br><br>

आभिषेचनिक
आभिषेचनिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿಷೇಕದ ವಸ್ತು /ಅಭಿಷೇಕ ಸಂಬಂಧವಾದ ಪದಾರ್ಥ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-१०९)<br><b>व्युत्पत्तिः - </b>अभिषेचनमभिषेकः, प्रयोजनमस्य<br><b>प्रयोगाः - </b>"अभिषेचनिकं यत्ते रामार्थमुपकल्पितम्"<br><b>उल्लेखाः - </b>रामा०<br><br>आभिषेचनिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ನಾನ ಮಾಡುವ ವಿಧಾನ<br><br>आभिषेचनिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ನಾನದ ಮಂತ್ರ ಮತ್ತು ಸ್ನಾನೋಪಯೋಗಿ ವಸ್ತು<br><b>निष्पत्तिः - </b>"ठञ्"<br><b>व्युत्पत्तिः - </b>अभिषेचनं स्नानं प्रयोजनमस्य<br><br>

आभिषेचनिकी
आभिषेचनिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಷೇಕದ ವಸ್ತು /ಅಭಿಷೇಕ ಸಂಬಂಧವಾದ ಪದಾರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

आभिहारिक
आभिहारिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದುರುಗೊಳ್ಳಲು ಉಪಯುಕ್ತವಾದ ವಸ್ತು<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-१०९)<br><b>व्युत्पत्तिः - </b>अभिहारः आभिमुख्येन हरणं प्रयोजनमस्य<br><br>आभिहारिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೇಟಿಯ ಕಾಲದಲ್ಲಿ ಕೊಡುವ ಗೌರವ ಕಾಣಿಕೆ<br><br>

आभीक्ष्ण्य
आभीक्ष्ण्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೌನಃಪುನ್ಯ /ವಿರಾಮವಿಲ್ಲದೆ ಕೆಲಸ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अभीक्ष्णस्य भावः<br><br>

आभीर
आभीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೋಪಾಲಕ<br><b>निष्पत्तिः - </b>रा (दाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>आसमन्तात् भियं राति<br><b>प्रयोगाः - </b>"ब्राह्मणादुग्रकन्यायां आवृतो नाम जायते । आभीरोऽम्बष्ठकन्यायामायोगव्यां तु धिग्वणः ॥"<br><b>उल्लेखाः - </b>मनु० १०-१५<br><br>आभीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಭೀರದೇಶ<br><br>आभीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಭೀರದೇಶದ ನಿವಾಸಿ<br><br>आभीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಭೀರದೇಶದ ದೊರೆ<br><br>

आभीरी
आभीरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೊಲ್ಲನ ಪತ್ನಿ<br><b>निष्पत्तिः - </b>"ङीष्" (४-१-४८)<br><b>व्युत्पत्तिः - </b>आभीरस्य स्त्री<br><br>आभीरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೊಲ್ಲರ ಜಾತಿಯ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>जाति० "ङीष्" (४-१-६३)<br><br>

आभील
आभील<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಷ್ಟ /ಕ್ಲೇಶ<br><b>निष्पत्तिः - </b>ला (आदाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>आसमन्तात् भियं लाति<br><br>आभील<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದುಃಖ /ವ್ಯಸನ<br><br>आभील<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಷ್ಟವುಳ್ಳ<br><br>आभील<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯಂಕರವಾದ<br><b>प्रयोगाः - </b>"आभीलानि प्राणिनः प्रत्यवस्यन् कालो नूनं व्याददावाननानि"<br><b>उल्लेखाः - </b>माघ० १८-७८<br><br>

आभुग्न
आभुग्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಬಗ್ಗಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>भुज (कौटिल्ये) - "क्तः" (३-२-१०२) । नत्वम् (८-२-४५)<br><b>व्युत्पत्तिः - </b>आ ईषत् भुग्नम्<br><br>

आभूतसम्प्लव
आभूतसम्प्लव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಳಯಪರ್ಯಂತವಿರತಕ್ಕ ಲೋಕ<br><b>प्रयोगाः - </b>"आभूतसम्प्लवं स्थानममृतत्वं हि भाष्यते"<br><br>

आभोग
आभोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೂರ್ಣವಾಗದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + भुज (पालनाभ्यवहारयोः) - "घञ्" (३-३-१८)<br><b>व्युत्पत्तिः - </b>आभुज्यते<br><b>प्रयोगाः - </b>"रुचिरकनककुम्भश्रीमदाभोगतुङ्गस्तनविनिहितहस्तस्वस्तिकाभिर्वधूभिः"<br><b>उल्लेखाः - </b>मालती० ४-१०<br><br>आभोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನ<br><b>निष्पत्तिः - </b>कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>आभुज्यते फलमनेन<br><br>आभोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರುಣನ ಛತ್ರಿ<br><br>आभोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಖಾನುಭವ<br><b>विस्तारः - </b>"आभोगो वरुणच्छत्रे पूर्णतायत्नयोरपि" - मेदि० ।<br><br>आभोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಸ್ತಾರ /ಬಹುದೇಶ ವ್ಯಾಪ್ತಿ<br><b>प्रयोगाः - </b>"औज्ज्वल्यं परभागतः प्रकटयत्याभोगभीमं तमः"<br><b>उल्लेखाः - </b>मालती० ५-११<br><br>आभोग<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಭೋಗಪರ್ಯಂತ<br><b>व्युत्पत्तिः - </b>भोगमनुभवमभिव्याप्य<br><br>

आभ्यन्तर
आभ्यन्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಧ್ಯದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"अण्" (४-३-५३)<br><b>व्युत्पत्तिः - </b>अभ्यन्तरे भवः<br><br>आभ्यन्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಕ್ಷರಗಳನ್ನು ಉಚ್ಚರಿಸುವ ಸಮಯದಲ್ಲಿ ವರ್ಣೋತ್ಪತ್ತಿಗೆ ಪೂರ್ವಭಾವಿಯಾದ ಬಹಳ ಹತ್ತಿರದ ಪ್ರಯತ್ನ<br><br>

आभ्यवहारिक
आभ्यवहारिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೋಜನಕ್ಕೆ ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-१०३)<br><b>व्युत्पत्तिः - </b>अभ्यवहारे साधुः<br><br>

आभ्युदयिक
आभ्युदयिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭ್ಯುದಯಶ್ರಾದ್ಧ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-१०९)<br><b>व्युत्पत्तिः - </b>अभ्युदयः प्रयोजनमस्य<br><br>आभ्युदयिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ್ಯಕರ್ಮ /ಆಸೆ ಹುಟ್ಟಿಸಿ ತನ್ನಲ್ಲೀ ಮನುಷ್ಯನು ಪ್ರವರ್ತಿಸುವಂತೆ ಮಾಡುವ ಕರ್ಮ<br><b>निष्पत्तिः - </b>"ठञ्"<br><b>व्युत्पत्तिः - </b>अभ्युदयः अभिवृद्धिः प्रयोजनमस्य<br><br>

आभ्रिक
आभ्रिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರದ ಗುದ್ದಲಿಯಿಂದ ಅಗೆಯುವವನು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-२)<br><b>व्युत्पत्तिः - </b>अभ्र्या खनति<br><br>

आभ्रिकी
आभ्रिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮರದ ಗುದ್ದಲಿಯಿಂದ ಅಗೆಯುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

आम्
आम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯಬುದ್ಧಿ<br><br>आम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ /ಒಪ್ಪಿಗೆ<br><br>आम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿವಚನ /ಉತ್ತರ<br><br>आम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನೆನಪು /ಸ್ಮರಣೆ<br><b>निष्पत्तिः - </b>अम (गत्यादौ) + णिच् - "क्विप्" (३-२-१७८)<br><b>विस्तारः - </b>"आम् ज्ञाननिश्चयस्मृत्योः" - मेदि० ।<br><br>

आम
आम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗ /ವ್ಯಾಧಿ<br><br>आम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಜೀರ್ಣ ರೋಗ<br><b>निष्पत्तिः - </b>अम (रोगे) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>अम्यतेऽनेन<br><b>प्रयोगाः - </b>"आहारस्य रसः सारः यो न पक्वोऽग्निलाघवात् । आमसञ्ज्ञां स लभते बहुव्याधिसमाश्रयः ॥"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>आम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಲಬದ್ಧತೆ<br><br>आम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುರಿಗಾಳು ಪುರಿ ಮುಂತಾದ ಹುರಿದ ಧಾನ್ಯ<br><br>आम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಸಿಯಾದ<br><br>आम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಡಲ್ಪಡುವ<br><br>आम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೀರ್ಣವಾಗದಿರುವ<br><br>

आमगन्धि
आमगन्धि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇಯಿಸಲ್ಪಡದ ಮಾಂಸದ ವಾಸನೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"इत्" (५-४-१३७)<br><b>व्युत्पत्तिः - </b>आमस्येव गन्धोऽस्य<br><br>

आमज्वर
आमज्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಜೀರ್ಣಜ್ವರ<br><b>व्युत्पत्तिः - </b>आमोऽपक्वः ज्वरः<br><b>प्रयोगाः - </b>"स्वेद्यमामज्वरं प्राप्य कोऽम्भसा परिषिञ्चति"<br><b>उल्लेखाः - </b>माघ० २-५४<br><br>

आमनस्य
आमनस्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದುಃಖ /ವ್ಯಸನ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अप्रशस्तं मनो यस्य । तस्य भावः<br><br>

आमन्त्र
आमन्त्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಏರಂಡವೃಕ್ಷ /ಹರಳು ಗಿಡ<br><b>निष्पत्तिः - </b>त्रैङ् (पालने) - "कः" (३-२-३) । पृषो० ।<br><b>व्युत्पत्तिः - </b>आमात् अजीर्णात् त्रायते स्वतैलेन<br><br>

आमन्त्रण
आमन्त्रण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆ ಪಡೆಯುವಿಕೆ<br><br>आमन्त्रण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರ್ಯಾದೆ /ಉಪಚಾರ<br><br>आमन्त्रण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವೇಚ್ಛೆಯಿಂದ ನಡೆದುಕೊಳ್ಳಲು ಅನುಮತಿ<br><br>आमन्त्रण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಭಾಷಣೆ<br><b>निष्पत्तिः - </b>आ + मत्रि (गुप्तपरिभाषणे) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"अन्योन्यामन्त्रणं यत्स्यात् तज्जनान्ते जनान्तिकम्"<br><b>उल्लेखाः - </b>सा० द०<br><br>आमन्त्रण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಹ್ವಾನ /ಕರೆ<br><br>

आमन्त्रयितृ
आमन्त्रयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರೆಯುವ /ಆಹ್ವಾನ ಮಾಡುವ<br><br>आमन्त्रयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿನಂದಿಸುವ<br><br>आमन्त्रयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಭಾಷಣೆ ಮಾಡುವ<br><br>

आमन्त्रित
आमन्त्रित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬೋಧನ /ಪ್ರಥಮಾವಿಭಕ್ತ್ಯಂತ ಪದ<br><br>आमन्त्रित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರೆ /ಆಹ್ವಾನ<br><br>आमन्त्रित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬೋಧನೆ<br><br>आमन्त्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರೆಯಲ್ಪಟ್ಟ<br><br>आमन्त्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಾವಶ್ಯಕವಾದ ಕಾರ್ಯದಲ್ಲಿ ನಿಯಮಿಸಲ್ಪಟ್ಟ<br><br>आमन्त्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬೋಧಿಸಲ್ಪಟ್ಟ<br><br>

आमन्त्र्य
आमन्त्र्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರೆಯಲ್ಪಡುವ<br><br>आमन्त्र्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಯಮಿಸಲ್ಪಡುವ<br><br>आमन्त्र्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕರೆದು<br><br>आमन्त्र्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಬೋಧಿಸಿ<br><br>आमन्त्र्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆ ಪಡೆದು<br><b>निष्पत्तिः - </b>आ + मत्रि (गुप्तपरिभाषणे) - "ल्यप्" (७-१-३७)<br><br>

आमन्द्र
आमन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಭೀರವಾದ ಶಬ್ದ<br><b>व्युत्पत्तिः - </b>आ ईषत् मन्द्रः<br><br>आमन्द्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಂಭೀರವಾದ ಶಬ್ದವುಳ್ಳ<br><b>प्रयोगाः - </b>"आमन्द्राणां फलमविकलं लप्स्यते गर्जितानाम्"<br><b>उल्लेखाः - </b>मेघ० १-३४<br><br>

आमपात्र
आमपात्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆವಿಗೆಯಲ್ಲಿ ಬೇಯಿಸಲ್ಪಡದ ಮಣ್ಣಿನ ಪಾತ್ರೆ<br><br>

आमय
आमय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗ /ವ್ಯಾಧಿ<br><b>निष्पत्तिः - </b>या (प्रापणे) - "कः" (वा० ३-३-५८)<br><b>व्युत्पत्तिः - </b>आमं यात्यनेन<br><b>प्रयोगाः - </b>"समौ हि शिष्टैराम्नातौ वर्त्स्यन्तावामयः स च"<br><b>उल्लेखाः - </b>माघ० २-१०<br><br>

आमयाविन्
आमयाविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೋಗಿ /ವ್ಯಾಧಿಗ್ರಸ್ತ<br><b>निष्पत्तिः - </b>"विनिः" (वा० ५-२-१२१)<br><b>व्युत्पत्तिः - </b>आमयोऽस्यास्ति<br><b>विस्तारः - </b>"ग्लानग्लास्नू आमयावी विकृतो व्याधितोऽपटुः" - अम० ।<br><br>

आमरक्त
आमरक्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಮಶಂಕೆ<br><b>व्युत्पत्तिः - </b>आममपक्वं रक्तम्<br><br>

आमरणान्तिक
आमरणान्तिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರಣಕಾಲದವರೆಗಿನ<br><b>प्रयोगाः - </b>"अन्योन्यस्याव्यभिचारो भवेदामरणान्तिकः"<br><b>उल्लेखाः - </b>मनु० ९-१०१<br><br>

आमर्द
आमर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲಾತ್ಕಾರವಾಗಿ ಎಳೆದು ಹಿಸುಕುವುದು<br><b>निष्पत्तिः - </b>आ + मृद (क्षोदे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"अर्धपीतस्तनं मातुरामर्दक्लिष्टकेसरम्"<br><b>उल्लेखाः - </b>शाकु० ७-१४<br><br>

आमर्दन
आमर्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಲಾತ್ಕಾರವಾಗಿ ಎಳೆದು ಹಿಸುಕುವುದು<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

आमर्श
आमर्श<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಮರ್ಶೆ /ಪರ್ಯಾಲೋಚನೆ<br><b>निष्पत्तिः - </b>आ + मृश (आमर्शने) - "घञ्" (३-३-१८)<br><br>

आमर्शन
आमर्शन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಮರ್ಶೆ /ಪರ್ಯಾಲೋಚನೆ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

आमलक
आमलक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೆಲ್ಲಿಕಾಯಿ<br><b>निष्पत्तिः - </b>"मयट्" (४-३-१४४) । लुक् (४-३-१६३)<br><b>व्युत्पत्तिः - </b>आमलक्याः फलम्<br><br>

आमलकी
आमलकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೆಲ್ಲಿಮರ<br><b>निष्पत्तिः - </b>आ + मल (धारणे) - "क्वुन्" (उ० २-३२) जाति "ङीष्" (४-१-६३)<br><b>व्युत्पत्तिः - </b>आमलते<br><br>

आमावास्य
आमावास्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಮಾವಾಸ್ಯೆಯಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१६)<br><b>व्युत्पत्तिः - </b>अमावास्यायां भवः<br><br>

आमीक्षा
आमीक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಸಿಹಾಲಿನಲ್ಲಿ ಮೊಸರು ಸೇರಿಸಿ ನಂತರ ಒಡೆದ ಗಟ್ಟಿಯಾದ ಭಾಗ<br><b>निष्पत्तिः - </b>आ + मिषु (सेचने) - "सक्" बाहु० ।<br><b>व्युत्पत्तिः - </b>आमिष्यते<br><br>

आमित्र
आमित्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶತ್ರು ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>अमित्रस्यायम्<br><br>आमित्र<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮಿತ್ರನವರೆಗೂ<br><br>आमित्र<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನವರೆಗೂ<br><b>व्युत्पत्तिः - </b>मित्रमभिव्याप्य<br><br>

आमित्रि
आमित्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರುವಿನ ಮಗ<br><b>निष्पत्तिः - </b>"इञ्" (४-१-९५)<br><b>व्युत्पत्तिः - </b>अमित्रस्यापत्यम्<br><br>

आमिष
आमिष<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಂಸ<br><b>निष्पत्तिः - </b>आ + मिषु (सेचने) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>आमिष्यते भुज्यते<br><b>प्रयोगाः - </b>"उपानयत् पिण्डमिवामिषस्य"<br><b>उल्लेखाः - </b>रघु० २-५९<br><br>आमिष<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೋಗ್ಯವಸ್ತು<br><br>आमिष<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅತ್ಯಾಸೆ<br><b>प्रयोगाः - </b>"अध्यात्मरतिरासीनो निरपेक्षो निरामिषः"<br><b>उल्लेखाः - </b>मनु० ६-४९<br><br>आमिष<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಂಚ<br><br>आमिष<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಂದರಕಾಂಡ<br><br>आमिष<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಭೋಗ<br><b>विस्तारः - </b>"आमिषं पुन्नपुंसकम् । भोग्यवस्तुनि सम्बोगेऽप्युत्कोचे पललेऽपि च ।" - मेदि० । "आमिषं पलले । सुन्दराकाररूपादौ सम्भोगे लोभलञ्चयोः" - हेम० ।<br><br>

आमिषप्रिय
आमिषप्रिय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಣಹದ್ದು<br><br>आमिषप्रिय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹದ್ದು<br><br>आमिषप्रिय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಂಸದಲ್ಲಿ ಅಬಿರುಚಿಯುಳ್ಳ<br><br>

आमिषाशिन्
आमिषाशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಂಸವನ್ನು ತಿನ್ನುವ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>अश (भोजने) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>आमिषमश्नाति<br><br>

आमिषी
आमिषी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಟಾಮಾಂಸಿ<br><br>

आमीलन
आमीलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣು ಮುಚ್ಚುವುದು<br><b>निष्पत्तिः - </b>आ + मील (निमेषणे) - "ल्युट्" (३-३-११५)<br><br>

आमीलित
आमीलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಮುಚ್ಚಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + मील (निमेषणे) - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>आ समन्तात् मीलितम्<br><br>आमीलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಮುಚ್ಚಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>आ ईषत् मीलितम्<br><br>

आमुक्त
आमुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಡಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"तेनोपमीयेत तमालनीलमामुक्तमुक्तालतमस्य वक्षः"<br><b>उल्लेखाः - </b>माघ० ३-८<br><br>आमुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡಲ್ಪಟ್ಟ<br><br>

आमुक्ति
आमुक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಡುವಿಕೆ<br><br>आमुक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಡುವುದು<br><br>आमुक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಕ್ತಿ /ಮೋಕ್ಷ<br><br>आमुक्ति<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮೋಕ್ಷದವರೆಗೂ<br><b>व्युत्पत्तिः - </b>आमुक्ति आमुक्तेर्वा संसारः<br><br>

आमुख
आमुख<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಸ್ತಾವನೆ<br><b>निष्पत्तिः - </b>आ + मुख + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आमुखयति अभिमुखीकरोति परिषदनेन<br><b>प्रयोगाः - </b>"सूत्रधारो नटीं ब्रूते मारिषं च विदूषकम् । स्वकार्यप्रस्तुताक्षेपि चित्रिक्त्या यत्तदामुखम् । प्रस्तावना वा"<br><b>उल्लेखाः - </b>प्रताप०<br><br>आमुख<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ /ಉಪಕ್ರಮ<br><br>

आमुष्मिक
आमुष्मिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಲೋಕಕ್ಕೆ ಸಂಬಂಧಿಸಿದ<br><b>निष्पत्तिः - </b>"ठञ्" (४-३-६७)<br><b>व्युत्पत्तिः - </b>अमुष्मिन् भवः<br><br>

आमुष्मिकी
आमुष्मिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಲೋಕಕ್ಕೆ ಸಂಬಂಧಿಸಿದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><b>प्रयोगाः - </b>"नैवालोच्य गरीयसीरपि चिरादामुष्मिकीर्यातनाः"<br><b>उल्लेखाः - </b>सा० द०<br><br>

आमुष्यकुलिका
आमुष्यकुलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇವನ ವಂಶದಲ್ಲಿ ಹುಟ್ಟುವಿಕೆ<br><b>निष्पत्तिः - </b>षष्ठ्या अलुक् । "वुञ्" (५-१-१३३)<br><b>व्युत्पत्तिः - </b>अमुष्य कुलम्<br><br>

आमुष्यपुत्रिका
आमुष्यपुत्रिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇವನ ಮಗನಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>षष्ठ्या अलुक् । "वुञ्" (५-१-१३३)<br><b>व्युत्पत्तिः - </b>अमुष्य पुत्रः<br><br>

आमुष्यायण
आमुष्यायण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈ ಕುಲದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>"फक्" (४-१-९९)<br><b>व्युत्पत्तिः - </b>आमुष्यापत्यम्<br><b>प्रयोगाः - </b>"तदामुष्यायणस्य तत्र भवतो भट्टगोपालस्य पौत्रः -------भवभूतिर्नाम कविः"<br><b>उल्लेखाः - </b>मालती० १<br><br>

आमृष्ट
आमृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಟ್ಟಲ್ಪಟ್ಟ<br><br>आमृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಲಾತ್ಕಾರವಾಗಿ ಹಿಡಿಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + मृष (आमर्शने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आमृष्टं नः परैः पदम्"<br><b>उल्लेखाः - </b>कुमा० २-३१<br><br>आमृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒರೆಸಲ್ಪಟ್ಟ<br><br>आमृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಳಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"आमृष्टास्तिलकरुचः स्रजो निरस्ताः नीरक्तं वसनमपाकृतोऽङ्गरागः"<br><b>उल्लेखाः - </b>माघ० ८-६१<br><br>आमृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಜ್ಜಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + मृजूष् (शुद्धौ) - कर्म० "क्तः" (३-२-१०२)<br><br>

आमोद
आमोद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸನೆ /ಪರಿಮಳ<br><b>निष्पत्तिः - </b>आ + मृद (हर्षे) - "अच्" (३-१-१३४)<br><b>प्रयोगाः - </b>"आमोदमुपजिघ्रन्तौ स्वनिःश्वासानुकारिणम्"<br><b>उल्लेखाः - </b>रघु० १-४३<br><br>आमोद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹರ್ಷ /ಸಂತೋಷ<br><br>आमोद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತಮ ಜಾತಿಯ ಹೆಂಗಸಿನ ಉಸಿರಿನ ವಾಸನೆ<br><b>प्रयोगाः - </b>"आमोदवासितचलाधरपल्लवेषु"<br><b>उल्लेखाः - </b>किरा० ९-७७<br><b>विस्तारः - </b>"प्रमोदगन्धावामोदौ" - शाश्व० ।<br><br>

आमोदन
आमोदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂತೋಷಪಡಿಸುವುದು<br><b>निष्पत्तिः - </b>आ + मृद (हर्षे) - "ल्युट्" (३-३-११५)<br><br>आमोदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುವಾಸನೆಯುಂಟುಮಾಡುವಿಕೆ<br><br>आमोदन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷಪಡಿಸುವ<br><b>निष्पत्तिः - </b>आ + मृद (हर्षे) + णिच् - "ल्युः" (३-१-१३४)<br><br>आमोदन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುವಾಸನೆಯುಂಟುಮಾಡುವ<br><br>

आमोदित
आमोदित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>आमोदित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುವಾಸನೆಯುಂಟುಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + मृद (हर्षे) + णिच् - "क्तः" (३-२-१०२)<br><br>आमोदित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷಗೊಂಡ<br><b>निष्पत्तिः - </b>आ + मृद (हर्षे) + स्वार्थे णिच् - कर्त० "क्तः" (३-४-७२)<br><br>आमोदित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಿಮಳವುಳ್ಳ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>आमोदोऽस्य सञ्जातः<br><br>

आमोदितवत्
आमोदितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆನಂದಪಟ್ಟ<br><br>आमोदितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುವಾಸನೆಯುಂಟು ಮಾಡಿದ<br><b>निष्पत्तिः - </b>आ + मृद (हर्षे) - "क्तवतुः" (३-२-१०२)<br><br>

आमोदिन्
आमोदिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಸನೆಯುಂಟು ಮಾಡುವ ಕೇಸರಿ<br><b>निष्पत्तिः - </b>आ + मृद (हर्षे) + णिच् - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>आमोदयति सुरभीकरोति<br><br>आमोदिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷವುಳ್ಳ<br><br>आमोदिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುವಾಸನೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>आमोदोऽस्यास्ति<br><br>

आम्नात
आम्नात<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಳ್ಳೆಯ ಅಭ್ಯಾಸ<br><br>आम्नात<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಳ್ಳೆಯ ಅಧ್ಯಯನ<br><b>निष्पत्तिः - </b>आ + म्ना (अभ्यासे) - भावे "क्तः" (३-३-११४)<br><br>आम्नात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಅಭ್ಯಾಸ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + म्ना (अभ्यासे) - "क्तः" (३-२-१०२)<br><br>आम्नात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಅಧ್ಯಯನ ಮಾಡಲ್ಪಟ್ಟ<br><br>आम्नात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"समौ हि शिष्टैराम्नातो वर्त्स्यन्तावामयः स च"<br><b>उल्लेखाः - </b>माघ० २-१०<br><br>

आम्नातिन्
आम्नातिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇದಾಧ್ಯಯನ ಮಾಡಿದವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-८८)<br><b>व्युत्पत्तिः - </b>आम्नातमनेन<br><br>आम्नातिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇದಾಭ್ಯಾಸ ಮಾಡಿದ<br><br>

आम्नान
आम्नान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಅಭ್ಯಾಸ ಮಾಡುವುದು /ಮನನ ಮಾಡುವುದು<br><br>आम्नान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಅಧ್ಯಯನ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>आ + म्ना (अभ्यासे) - "ल्युट्" (३-३-११५)<br><br>

आम्नाय
आम्नाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇದ<br><b>निष्पत्तिः - </b>आ + म्ना (अभ्यासे) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>आम्नायते अभ्यस्यते<br><b>प्रयोगाः - </b>"आम्नायगन्धरुचिरस्फुरिताधरोष्ठम्"<br><b>उल्लेखाः - </b>गोपालविंशतिः<br><br>आम्नाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಅಭ್ಯಾಸ ಮಾಡುವುದು /ಮನನ ಮಾಡುವುದು<br><br>आम्नाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪ್ರದಾಯ<br><br>आम्नाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪದೇಶ /ಸಲಹೆ<br><br>आम्नाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶ /ಕುಲ<br><b>विस्तारः - </b>"आम्नाउअः कुल आगमे । उपदेशे च" - हेम० ।<br><br>

आम्बरीषपुत्रक
आम्बरीषपुत्रक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಬರೀಷ ಮಹಾರಾಜನ ಮಗನು ವಾಸಮಾಡುವ ದೇಶ<br><b>निष्पत्तिः - </b>"वुञ्" (४-२-५३)<br><b>व्युत्पत्तिः - </b>अम्बरीषपुत्रस्य विषयो देशः<br><br>

आम्बिकेय
आम्बिकेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧೃತರಾಷ್ಟ್ರ<br><br>आम्बिकेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಮಾರಸ್ವಾಮಿ /ಸ್ಕಂದ<br><br>आम्बिकेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಣಪತಿ<br><b>निष्पत्तिः - </b>"ढक्" (४-१-१२०)<br><b>व्युत्पत्तिः - </b>अम्बिकायाः पार्वत्याः तन्नाम्न्या राजपुत्र्या वा अपत्यम्<br><br>

आम्भसिक
आम्भसिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ಸ್ಯ /ಮೀನು<br><br>आम्भसिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಲಚರ /ನೀರಿನಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"ठक्" (४-३-७२)<br><b>व्युत्पत्तिः - </b>अम्भसि भवः<br><br>

आम्र
आम्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾವಿನ ಮರ<br><b>निष्पत्तिः - </b>अम (गत्यादौ) - "रक्" दीर्घश्च (उ० २-१६)<br><b>व्युत्पत्तिः - </b>अम्यते<br><br>आम्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾವಿನ ಹಣ್ಣು<br><b>निष्पत्तिः - </b>"अण्" (४-३-१३५) । अणो लुक् (४-३-१६३)<br><b>व्युत्पत्तिः - </b>आम्रस्य फलम्<br><b>प्रयोगाः - </b>"मन्दानलत्वं विषमज्वरं च रक्तामयं बद्धगुरोदरं च । आम्रातियोगो नयनामयं वा करोति तस्मादति तानि नाद्यात् ॥"<br><br>

आम्रकूट
आम्रकूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಪರ್ವತ<br><b>प्रयोगाः - </b>"वक्षत्यध्वश्रमपरिगतं सानुमानाम्रकूटः"<br><b>उल्लेखाः - </b>मेघ० १-१७<br><br>

आम्रवण
आम्रवण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾವಿನ ತೋಪು<br><b>निष्पत्तिः - </b>णत्वम् (८-४-५)<br><b>व्युत्पत्तिः - </b>आम्रस्य वनम्<br><b>प्रयोगाः - </b>"स्मरहुताशनमुर्मुरचूर्णतां दधुरिवाम्रवणस्य रजःकणाः"<br><b>उल्लेखाः - </b>माघ० ६-६<br><br>

आम्रातक
आम्रातक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಮಟೆ ಮರ<br><b>निष्पत्तिः - </b>अत (सातत्यगमने) - "वुन्" (उ० ५-३५)<br><b>व्युत्पत्तिः - </b>आम्रमतति<br><br>आम्रातक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಮಟೆ ಕಾಯಿ<br><br>

आम्रेडन
आम्रेडन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುನರುಕ್ತಿ<br><b>निष्पत्तिः - </b>आ + म्रेडृ (उन्मादे) - "ल्युट्" (३-३-११५)<br><br>

आम्रेडित
आम्रेडित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುನರುಕ್ತಿ<br><b>निष्पत्तिः - </b>आ + म्रेडृ (उन्मादे) - भावे "क्तः" (३-३-११४)<br><br>आम्रेडित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎರಡು ಮೂರಾವೃತ್ತಿ ಹೇಳಲ್ಪಟ್ಟ ಮಾತು<br><b>निष्पत्तिः - </b>आ + म्रेडृ (उन्मादे) - कर्म० "क्तः" (३-२-१०२)<br><br>आम्रेडित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದ್ವಿರ್ಭಾವ ಹೊಂದಿದ ಶಬ್ದಸ್ವರೂಪದ ಎರಡನೆಯ ಭಾಗ<br><br>

आम्ल
आम्ल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಳಿ<br><br>

आम्ला
आम्ला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹುಣಸೆ ಮರ<br><b>व्युत्पत्तिः - </b>आ सम्यक् अम्ला अम्लरसयुक्ता<br><br>

आय
आय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಭ /ಪ್ರಾಪ್ತಿ<br><br>आय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪಾದನೆ /ಆದಾಯ<br><br>आय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಮೀನಿನಿಂದ ಬರುವ ಕಂದಾಯ /ಭೂಮಿಯ ತೆರಿಗೆ<br><br>आय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಗ್ನದಿಂದ ೧೧ ನೆಯ ಸ್ಥಾನ<br><br>आय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತಃಪುರದ ರಕ್ಷಕ /ರಾಜಸ್ತ್ರೀಯರ ವಾಸಗೃಹವನ್ನು ಕಾಯುವವನು<br><br>आय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೆರಿಗೆ<br><br>आय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಮನ /ಹೋಗುವಿಕೆ<br><br>

आयःशूलिक
आयःशूलिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಠಿನೋಪಾಯದಿಂದ ದ್ರವ್ಯವನ್ನು ಸಂಪಾದಿಸುವವನು<br><b>निष्पत्तिः - </b>"ठक्" (५-२-७६)<br><b>व्युत्पत्तिः - </b>तीक्ष्णोपायोऽयःशूलम्, अयःशूलेन अन्विच्छति<br><br>

आयत
आयत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ದವಾದ /ದೀರ್ಘವಾದ<br><b>निष्पत्तिः - </b>आ + यम (उपरमे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आयताङ्गुलिरभूदतिरिक्तः सुभ्रुवां क्रशिमशालिनि मध्ये"<br><b>उल्लेखाः - </b>माघ० १०-६५<br><br>आयत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अवेक्षितानायतवल्गमग्रे तुरङ्गिभिर्यत्ननिरुद्धवाहैः"<br><b>उल्लेखाः - </b>माघ० ३-३०<br><br>आयत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೂರವಾಗಿ ಎಳೆಯಲ್ಪಟ್ಟ<br><br>आयत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿಸಲ್ಪಟ್ಟ<br><br>आयत<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉದ್ದವಾಗಿ /ನೀಳವಾಗಿ<br><br>

आयतच्छदा
आयतच्छदा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಳೆ ಗಿಡ<br><b>व्युत्पत्तिः - </b>आयतः दीर्घः छदो अस्याः<br><b>विस्तारः - </b>"कदलीत्वायतच्छदा" - त्रिकाण्ड० ।<br><br>

आयतन
आयतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞವೇದಿಕೆ /ಯಾಗದ ಸ್ಥಳ<br><br>आयतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪವಿತ್ರ ಸ್ಥಳ<br><b>निष्पत्तिः - </b>आ + यती (प्रयत्ने) - अधि० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>आयतन्तेऽत्र<br><br>आयतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶ್ರಾಂತಿ ಸ್ಥಾನ<br><br>आयतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ /ಮನೆ<br><b>प्रयोगाः - </b>"सम्बन्धिभिन्नोऽपि गिरेः कुलस्य स्नेहस्तदेकायतनं जगाम"<br><b>उल्लेखाः - </b>कुमा० ७-५<br><br>आयतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣಜ /ಉಗ್ರಾಣ<br><br>

आयति
आयति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂದಿನ ಕಾಲ /ಭವಿಷ್ಯತ್ತು<br><b>निष्पत्तिः - </b>आ + यम (उपरमे) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"इपदोऽभिभवन्त्यविक्रमं रहयत्यापदुपेतमायतिः"<br><b>उल्लेखाः - </b>किरा० २-१४<br><br>आयति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಭಾವ /ಪ್ರತಾಪ<br><br>आयति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೈರ್ಘ್ಯ<br><br>आयति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಫಲವನ್ನು ಕೊಡುವ ಕಾಲ<br><b>प्रयोगाः - </b>"नियता लघुता निरायतेरगरीयान्न पदं नृपश्रियः"<br><b>उल्लेखाः - </b>किरा० २-१४<br><br>आयति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯ /ಕೆಲಸ<br><b>प्रयोगाः - </b>"यथा मित्रं ध्रुवं लब्ध्वा कृशमप्यायतिक्षमम्"<br><b>उल्लेखाः - </b>मनु० ७-२०८<br><br>आयति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ /ಸಂಗಮ<br><b>विस्तारः - </b>"आयतिः स्यात् प्रभावोत्तरकालयोः । दैर्घ्ये सङ्गेऽपि" - हेम० ।<br><br>आयति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಕೆ /ಹತೋಟಿ<br><br>

आयतीगव
आयतीगव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮೇಯಲು ಹೋಗಿರುವ ಹಸುಗಳು ಮನೆಗೆ ಬರುವ ಕಾಲ<br><b>निष्पत्तिः - </b>शत्रादेशः पुंवद्भावाभावः समासान्तश्च निपात्यते (२-१-१७)<br><b>व्युत्पत्तिः - </b>आयत्यो गावो यस्मिन् काले<br><br>

आयतीसम
आयतीसम<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂವತ್ಸರಗಳು ಬರುವ ಕಾಲ<br><b>निष्पत्तिः - </b>निपा०<br><b>व्युत्पत्तिः - </b>आयन्ति समाः यस्मिन् काले<br><br>

आयत्त
आयत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧೀನ /ಪರತಂತ್ರ<br><b>निष्पत्तिः - </b>आ + यती (प्रयत्ने) - "क्तः" (३-४-७२)<br><b>व्युत्पत्तिः - </b>आयतते स्म<br><b>प्रयोगाः - </b>"दैवायत्तं कुले जन्म मदायत्तं तु पौरुषम्"<br><b>उल्लेखाः - </b>वेणी० ३-३७<br><br>आयत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನಿಸಿದ<br><br>आयत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಧೇಯ /ಸಾಧು<br><br>

आयत्ति
आयत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಧೀನತೆ /ಪರತಂತ್ರತೆ<br><b>निष्पत्तिः - </b>आ + यती (प्रयत्ने) - "क्तिन्" (३-३-९४)<br><br>आयत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ನೇಹ /ವಾತ್ಸಲ್ಯ<br><br>आयत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಲ್ಲೆ /ಗಡಿ<br><br>आयत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಿವಸ<br><br>आयत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಲ /ಸಾಮರ್ಥ್ಯ<br><b>विस्तारः - </b>"आयत्तिस्तु स्त्रियां स्नेहे वशित्वे वासरे बले" - मेदि० ।<br><br>आयत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಾಯ<br><br>आयत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೌರವ<br><br>आयत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಭಾವ /ಪ್ರತಾಪ<br><br>

आयथातथ्य
आयथातथ्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನೌಚಿತ್ಯ /ಅಯುಕ್ತತೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४) वा पूर्वपदवृद्धिः (७-३-३१)<br><b>व्युत्पत्तिः - </b>तथात्वमनतिक्रम्य यथातथा । न यथातथा । अयथातथा भावः<br><b>प्रयोगाः - </b>"गुणानामायथातथ्यादर्थं विप्लावयन्ति ये"<br><b>उल्लेखाः - </b>माघ० २-५६<br><br>आयथातथ्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸತ್ಯ /ಸುಳ್ಳು<br><br>

आयथापुर्य
आयथापुर्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂರ್ವದಂತೆ ಇಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४) वा पूर्वपदवृद्धिः (७-३-३१)<br><b>व्युत्पत्तिः - </b>न यथापुर्यम् अयथापुर्यम् । तस्य भावः<br><br>

आयद्वसु
आयद्वसु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಐಶ್ವರ್ಯವು ಬರಲಿರುವ /ಸಂಪತ್ತು ಪ್ರಾಪ್ತವಾಗಲಿರುವ<br><b>व्युत्पत्तिः - </b>आयत् वसु यस्य<br><br>

आयमन
आयमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ದ<br><br>आयमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಕೆ /ಹತೋಟಿ<br><br>आयमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತುಂಡಾಗಿರುವುದನ್ನು ಎಳೆದು ಉದ್ದವಾಗಿ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>आ + यम (उपरमे) - "ल्युट्" (३-३-११५)<br><br>

आयस
आयस<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣ<br><b>निष्पत्तिः - </b>स्वार्थे "अण्"<br><b>व्युत्पत्तिः - </b>अय एव<br><br>आयस<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣದ ಆಯುಧ<br><br>आयस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲೋಹಮಯವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१३४)<br><b>व्युत्पत्तिः - </b>अयसो विकारः<br><b>प्रयोगाः - </b>"मूढं बुद्धमिवात्मानं हैमीभूतमिवायसम्"<br><b>उल्लेखाः - </b>कुमा० ६-५५<br><br>

आयसी
आयसी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲೋಹಕವಚ<br><br>

आयसीय
आयसीय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣಕ್ಕೆ ಹತ್ತಿರದ ಪ್ರದೇಶ<br><b>निष्पत्तिः - </b>"अण्" (४-२-८०)<br><b>व्युत्पत्तिः - </b>अयसो अदूरभवो देशः<br><br>आयसीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣದಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"अण्" (४-२-८०)<br><b>व्युत्पत्तिः - </b>अयसा निर्वृत्तम्<br><br>

आयस्कार
आयस्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮ್ಮಾರ /ಕಬ್ಬಿಣದ ಕೆಲಸದವನು<br><b>निष्पत्तिः - </b>अयस्कार - स्वार्थे "अण्" (५-४-३८)<br><br>

आयस्त
आयस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಸೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + यसु (प्रयत्ने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आयस्तभीमभुजमन्दरवेल्लनाभिः"<br><b>उल्लेखाः - </b>वेणी० ६-९<br><br>आयस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಷ್ಟಪಡಿಸಲ್ಪಟ್ಟ<br><br>आयस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಿತವಾಗಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + यसु (प्रयत्ने) - कर्म० "क्तः" (३-२-१०२)<br><br>आयस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಳಲಿದ /ಆಯಾಸಗೊಂಡ<br><b>निष्पत्तिः - </b>कर्त० "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"आयस्तमैक्षत जनः चटुलाग्रपाद्दम्"<br><b>उल्लेखाः - </b>माघ० ५-६<br><br>

आयस्थान
आयस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೆರಿಗೆ ವಸೂಲಿಯ ಜಾಗ /ಸುಂಕದ ಕಟ್ಟೆ<br><br>आयस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಭಸ್ಥಾನ /ಲಗ್ನದಿಂದ ೧೧ ನೆಯ ಸ್ಥಾನ<br><br>

आयस्य
आयस्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಪ್ರಯತ್ನಪಟ್ಟು<br><b>निष्पत्तिः - </b>आ + यसु (प्रयत्ने) - "ल्यप्" (७-१-३७)<br><br>

आयात
आयात<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಧಿಕ್ಯ<br><b>निष्पत्तिः - </b>आ + या (प्रापणे) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"दिव्यास्त्रीणां सचरणलाक्षारागाः रागायाते निपतितपुष्पापीडाः"<br><b>उल्लेखाः - </b>किरा० ५-२३<br><br>आयात<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಗಮನ<br><b>निष्पत्तिः - </b>आ + या (प्रापणे) - भावे "क्तः" (३-३-११४)<br><br>आयात<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಗಮಿಸಿದ ಸ್ಥಳ<br><b>निष्पत्तिः - </b>आ + या (प्रापणे) - अधि० "क्तः" (३-४-७६)<br><br>आयात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಂದಿರುವ /ಆಗಮಿಸಿರುವ<br><br>

आयाति
आयाति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಗಮನ<br><b>निष्पत्तिः - </b>आ + या (प्रापणे) - "क्तिन्" (३-३-९४)<br><br>

आयाम
आयाम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ದ /ದೈರ್ಘ್ಯ<br><b>निष्पत्तिः - </b>आ + यम (उपरमे) -- "घञ्" (३-३-१९)<br><b>प्रयोगाः - </b>"तेनोदीचीं दिशमनुसरेस्तिर्यगायामशोभी"<br><b>उल्लेखाः - </b>मेघ० १-५७<br><br>आयाम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಕೆ /ಹತೋಟಿ<br><b>प्रयोगाः - </b>"प्राणापानगती रुद्ध्वा प्राणायामपरायणाः"<br><b>उल्लेखाः - </b>गीता० ४-२९<br><br>आयाम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಸ್ತಾರ /ವೈಶಾಲ್ಯ<br><br>आयाम<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಾಮಪರ್ಯಂತವಾಗಿ<br><b>निष्पत्तिः - </b>अव्ययी०<br><b>व्युत्पत्तिः - </b>याममभिव्याप्य<br><br>

आयामवत्
आयामवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಸ್ತಾರವಾದ<br><br>आयामवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ದವಾದ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>आयामोऽस्यास्ति<br><b>प्रयोगाः - </b>"आयामवद्भिः करिणां घटाशतैरधःकृताट्टालकपङ्क्तिरुच्चकैः"<br><b>उल्लेखाः - </b>माघ० १२-६५<br><br>

आयास
आयास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಪ್ರಯತ್ನ<br><b>निष्पत्तिः - </b>आ + यसु (प्रयत्ने) - "घञ्" (३-३-१८)<br><br>आयास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಯಾಸ /ದಣಿವು<br><b>प्रयोगाः - </b>"स्नेहमूलानि दुःखानि देहजानि भयानि च । शौकहर्षौ तथायासः सर्वं स्नेहात्प्रवर्तते ॥"<br><b>उल्लेखाः - </b>भा० वन० २००<br><br>

आयासक
आयासक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಯಾಸವನ್ನುಂಟು ಮಾಡುವ<br><b>निष्पत्तिः - </b>आ + यसु (प्रयत्ने) - "ण्वुल्" (३-१-१३३)<br><br>

आयासिन्
आयासिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಯಾಸವುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>प्रयोगाः - </b>"कामं प्रिया न सुलभा मनस्तु तद्भावदर्शनायासि"<br><b>उल्लेखाः - </b>शाकु० २-१<br><br>

आयिन्
आयिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲಾಭವುಳ್ಳ<br><br>आयिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಪಾದನೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>आयो लाभोऽस्यास्ति<br><br>

आयुक्त
आयुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಯಮಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"कुशलोऽन्वेषणस्याहमायुक्तो दूतकर्मणि"<br><b>उल्लेखाः - </b>भट्टि० ८-११५<br><br>आयुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧಪಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + युजिर् (योगे) - कर्म० "क्तः" (३-२-१०२)<br><br>आयुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಸೇರಿಸಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>आ ईषत् युक्तः<br><b>विस्तारः - </b>"आयुक्तः शकटे गौः" - सि० कौ० ।<br><br>आयुक्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೇಮಕ /ವ್ಯವಸ್ಥೆ<br><b>निष्पत्तिः - </b>आ + युजिर् (योगे) -भावे "क्तः" (३-३-११४)<br><br>

आयुध
आयुध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಯುಧ /ಅಸ್ತ್ರ<br><b>निष्पत्तिः - </b>आ + युध (प्रहारे) - घञर्थे "कः" (वा० ३-३-५०)<br><b>व्युत्पत्तिः - </b>आयुध्यतेऽनेन<br><b>प्रयोगाः - </b>"धृतायुधो याअदहं तावदन्यैः किमायुधैः"<br><b>उल्लेखाः - </b>वेणी० ३-४६<br><br>

आयुधजीविन्
आयुधजीविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಯುಹದಿಂದ ಜೀವಿಸುವವನು<br><b>निष्पत्तिः - </b>जीव (प्राणधारणे) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>आयुधेन जीवति<br><br>

आयुधधर्मिणी
आयुधधर्मिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಯಂತೀವೃಕ್ಷ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५) । "गीप्" (४-१-५)<br><b>व्युत्पत्तिः - </b>आयुधस्येव धर्मोऽस्यास्ति<br><br>

आयुधागार
आयुधागार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಯುಧ ಶಾಲೆ<br><b>व्युत्पत्तिः - </b>आयुधानामगारम्<br><b>प्रयोगाः - </b>"आर्य, नेयमायुधागारम्, पाञ्चाल्याश्चतुःशालकमिदम्"<br><b>उल्लेखाः - </b>वेणी० १<br><br>

आयुधागारिक
आयुधागारिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಯುಧ ಶಾಲೆಯಲ್ಲಿ ನಿಯಮಿಸಲ್ಪಟ್ಟವನು<br><b>निष्पत्तिः - </b>"ठञ्" (४-४-७०)<br><b>व्युत्पत्तिः - </b>आयुधागारे नियुक्तः<br><br>

आयुधिक
आयुधिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಯುಧದಿಂದ ಜೀವಿಸುವವನು<br><b>निष्पत्तिः - </b>"ठन्" (४-४-१४)<br><b>व्युत्पत्तिः - </b>आयुधेन जीवति<br><br>

आयुधिन्
आयुधिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಸ್ತ್ರವನ್ನು ಧರಿಸಿರುವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>आयुधमस्त्यस्य<br><br>

आयुधीय
आयुधीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಯುಧದಿಂದ ಜೀವಿಸುವವನು<br><b>निष्पत्तिः - </b>"छः" (४-४-१४)<br><b>व्युत्पत्तिः - </b>आयुधेन जीवति<br><br>

आयुर्दाय
आयुर्दाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಹಗಳು ಬಲವಾದ ಸ್ಥಾನಗಳಿದ್ದು ಹೆಚ್ಚು ಆಯಸ್ಸನ್ನು ಕೊಡುವುದು<br><b>व्युत्पत्तिः - </b>आयुषो दायः दानम्<br><br>

आयुर्द्रव्य
आयुर्द्रव्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಔಷಧ<br><b>व्युत्पत्तिः - </b>आयुःसाधनं द्रव्यम्<br><br>आयुर्द्रव्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಘೃತ /ತುಪ್ಪ<br><br>

आयुर्योग
आयुर्योग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಯಸ್ಸನ್ನು ಹೆಚ್ಚಿಸುವ ಗ್ರಹಗಳ ಒಂದು ಯೋಗ<br><b>व्युत्पत्तिः - </b>प्रशस्तस्यायुषो ज्ञापको योगः<br><br>

आयुर्वृद्धि
आयुर्वृद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಯುರ್ವೃದ್ಧಿ<br><br>

आयुर्वेद
आयुर्वेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಯಸ್ಸನ್ನು ಕೊಡತಕ್ಕ ಶಾಸ್ತ್ರ /ಆರೋಗ್ಯವನ್ನು ಕಾಪಾಡುವ ಶಾಸ್ತ್ರ<br><b>व्युत्पत्तिः - </b>आयुरस्मिन् विद्यते अस्तीत्यायुर्वेदः, आयुर्विद्यते ज्ञायते अनेनेत्यायुर्वेदः, आयुर्विद्यते विचार्यतेऽनेन , आयुरनेन विन्दति प्राप्नोति इत्यायुर्वेदङ् इति वा ।<br><br>

आयुष्क
आयुष्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತಮವಾದ ಆಯಸ್ಸುಳ್ಳವನು<br><b>निष्पत्तिः - </b>कै (शब्दे) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>आयुषा कायति<br><br>

आयुष्काम
आयुष्काम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಯಸ್ಸನ್ನು ಅಪೇಕ್ಷಿಸುವವನು<br><b>निष्पत्तिः - </b>कमु (कान्तौ) + णिङ् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>आयुः कामयते<br><b>प्रयोगाः - </b>"आयुष्कामेन वप्तव्यं न जातु परयोषिति"<br><b>उल्लेखाः - </b>मनु० ९-४१<br><br>

आयुष्टोम
आयुष्टोम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಯುಷ್ಯ ಹೋಮ<br><b>व्युत्पत्तिः - </b>आयुःसाधनं स्तोमः<br><br>

आयुष्मत्
आयुष्मत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಕಂಭಾದಿ ೨೭ ಯೋಗಗಳಲ್ಲೊಂದು<br><br>आयुष्मत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೀರ್ಘಾಯುಸ್ಸುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>प्रशस्तमायुरस्यास्ति<br><b>प्रयोगाः - </b>"यदाज्ञापयत्यायुष्मान्"<br><b>उल्लेखाः - </b>शाकु० १<br><br>आयुष्मत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೃದ್ಧ /ಹೆಚ್ಚು ವಯಸ್ಸಾದವನು<br><br>

आयुष्य
आयुष्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಯುರ್ವೃದ್ಧಿ<br><b>निष्पत्तिः - </b>आयुष् - स्वार्थे "ष्यञ्" (५-१-१२४)<br><b>प्रयोगाः - </b>"आयुष्यं प्राङ्मुखो भुङ्क्ते यशस्यं दक्षिणामुखः । श्रियं प्रत्यङ्मुखो भुङ्क्ते ऋतं भुङ्क्ते ह्युदङ्मुखः ॥"<br><b>उल्लेखाः - </b>मनु० २-५२<br><br>आयुष्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜನನವಾದನಂತರ ಮಾಡುವ ಜಾತಕರ್ಮ<br><br>आयुष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಯುರ್ವೃದ್ಧಿಗೆ ಕಾರಣವಾದ ಆಯುಷ್ಯ ಹೋಮ<br><b>निष्पत्तिः - </b>"यत्" (वा० ५-१-१११)<br><b>व्युत्पत्तिः - </b>आयुः प्रयोजनमस्य<br><b>प्रयोगाः - </b>"धन्यं यशस्यमायुष्यं स्वर्ग्यं वातिथिपूजनम्"<br><b>उल्लेखाः - </b>मनु० ३-१०६<br><br>

आयुस्
आयुस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜೀವಿತದ ಕಾಲ<br><b>निष्पत्तिः - </b>इण् (गतौ) - "उसिः" (उ० २-११८)<br><b>व्युत्पत्तिः - </b>एति<br><b>प्रयोगाः - </b>"शृङ्गं सदृप्तविनयाधिकृतः परेषामत्युच्छ्रितं न ममृषे न तु दीर्घमायुः"<br><b>उल्लेखाः - </b>रघु० ९-६२<br><br>आयुस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಯುಸ್ಸು ಬೆಳೆಯಲು ಮಾಡುವ ಆಯುಷ್ಯ ಹೋಮ<br><br>

आयोधन
आयोधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ<br><b>निष्पत्तिः - </b>आ + युध (सम्प्रहारे) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"आयोधने कृष्णगतिं सहायम्"<br><b>उल्लेखाः - </b>रघु० ६-४२<br><br>आयोधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧಕ್ಷೇತ್ರ<br><b>निष्पत्तिः - </b>अधि० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>आयुध्यतेऽत्र<br><br>आयोधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಲ್ಲುವುದು<br><b>विस्तारः - </b>"आयोधनं घातनं स्यात् युद्धमायोधनं मतम्" - शाश्व० ।<br><br>

आर
आर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಜಗ್ರಹ<br><br>आर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶನಿಗ್ರಹ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आ ऋच्छति<br><br>आर<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿತ್ತಾಳೆ<br><br>आर<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಮೂಲೆ<br><br>आर<br><br><b>कन्नडार्थः - </b>ದೂರ /ಅಂತರ<br><br>

आरा
आरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚರ್ಮವನ್ನು ಕತ್ತರಿಸುವ ಉಳಿ<br><br>आरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಾವಟಿ<br><b>प्रयोगाः - </b>"सङ्क्रीडन्ती तेजिताश्वस्य रागादुद्यम्यारामग्रहायोत्थितस्य"<br><b>उल्लेखाः - </b>माघ० १८-७<br><br>आरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚರ್ಮವನ್ನು ಕತ್ತರಿಸುವ ಉಳಿ<br><b>विस्तारः - </b>"आरा चर्मप्रभेदिन्यां पुंसि भौमे शनैश्चरे" - मेदि० ।<br><br>आरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಾವಟಿ<br><br>

आरकूट
आरकूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿತ್ತಾಳೆ<br><b>निष्पत्तिः - </b>कूट (दाहे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आरं कूटयते<br><br>

आरक्ष
आरक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಕುಂಭಸ್ಥಳದ ಕೆಳಗಿನ ಪ್ರದೇಶ<br><b>निष्पत्तिः - </b>आ + रक्ष (पालने) - "अच्" (३-१-१३४)<br><b>प्रयोगाः - </b>"आरक्षमग्नमवमत्य सृणिं शिताग्रमेकः पलायत जवेन कृतार्तनादः"<br><b>उल्लेखाः - </b>माघ० ५-५<br><br>आरक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ತಲೆಯ ಚರ್ಮ<br><br>आरक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೈನ್ಯ<br><br>आरक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆ<br><b>निष्पत्तिः - </b>आ + रक्ष (पालने) - भावे "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"तेषामारक्षभूतं तु पूर्वं दैवं नियोजयेत्"<br><b>उल्लेखाः - </b>मनु० ३-२०४<br><br>आरक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಕ<br><b>प्रयोगाः - </b>"शतसाहस्रमारक्षं मध्यमं रक्षसां कपिः"<br><b>उल्लेखाः - </b>भट्टि० ८-३७<br><br>

आरक्षक
आरक्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾವಲುಗಾರ<br><br>आरक्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನ್ಯಾಯಾಧೀಶ<br><br>

आरक्षा
आरक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆ<br><b>निष्पत्तिः - </b>आ + रक्ष (पालने) - "अः" (३-३-१०३)<br><br>

आरग्वध
आरग्वध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಕ್ಕೆ ಗಿಡ<br><b>विस्तारः - </b>"आरग्वधे राजवृक्षशम्याकचतुरङ्गुलाः" - अम० ।<br><br>आरग्वध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಕ್ಕೆ ಕಾಯಿ<br><br>

आरणि
आरणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಳಿಯಿಂದ ಕೂಡಿದ ಜಲಾಶಯ<br><br>

आरणेय
आरणेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶುಕಮಹರ್ಷಿ<br><b>निष्पत्तिः - </b>"ढक्" (४-१-१२०)<br><b>व्युत्पत्तिः - </b>अरण्या अपत्यम्<br><br>

आरण्य
आरण्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಣ್ಯ /ಕಾಡು<br><br>आरण्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಸುವಿನ ಸಗಣಿ<br><br>आरण्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಣ್ಯದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>"णः" (वा० ८-३-१०१)<br><b>व्युत्पत्तिः - </b>अरण्ये भवः<br><br>

आरण्यक
आरण्यक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆರಣ್ಯಕ /ಬ್ರಾಹ್ಮಣಕ್ಕೆ ಸಂಬಂಧಿಸಿದ ವೇದದ ಒಂದು ಭಾಗ<br><b>प्रयोगाः - </b>"तैत्तिरीयारण्यकम्, बृहदारण्यकम्"<br><br>आरण्यक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾಭಾರತದ ವನಪರ್ವ<br><br>आरण्यक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಮದ್ರಾಮಾಯಣದ ಅರಣ್ಯಕಾಂಡ<br><b>निष्पत्तिः - </b>अरण्य - "वुञ्" (४-२-१२९)<br><br>आरण्यक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸುವಿನ ಸಗಣಿ<br><b>निष्पत्तिः - </b>अरण्य - वा "वुञ्" (वा० ४-२-१२९)<br><br>आरण्यक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಣ್ಯಕ್ಕೆ ಸಂಬಂಧಿಸಿದ ಮಾರ್ಗ /ದಾರಿ<br><br>आरण्यक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಣ್ಯಕ್ಕೆ ಸಂಬಂಧಿಸಿದ ಅಧ್ಯಾಯ<br><b>प्रयोगाः - </b>"आरण्यकानां प्रभवः फलानाम्"<br><b>उल्लेखाः - </b>याद० ४-३०<br><br>आरण्यक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಣ್ಯಕ್ಕೆ ಸಂಬಂಧಿಸಿದ ನ್ಯಾಯ<br><br>आरण्यक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಣ್ಯಕ್ಕೆ ಸಂಬಂಧಿಸಿದ ವಿಹಾರ<br><br>आरण्यक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಣ್ಯಕ್ಕೆ ಸಂಬಂಧಿಸಿದ ಮನುಷ್ಯ<br><b>प्रयोगाः - </b>"आरण्यकोपात्तफलप्रसूतिः"<br><b>उल्लेखाः - </b>रघु० ५-१५<br><br>

आरण्यपर्वन्
आरण्यपर्वन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾಭಾರತದ ಅರಣ್ಯಪರ್ವ<br><br>

आरण्यपशु
आरण्यपशु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಣ್ಯದಲ್ಲಿ ಹುಟ್ಟಿದ ಪಶು<br><br>

आरत
आरत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿವೃತ್ತಿ ಹೊಂದಿದ<br><br>आरत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿರಾಮ ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>आ + रमु (क्रीडायाम्) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"उदितपक्षमिवारतनिःस्वनैः पृथुनितम्बविलम्बिभिरम्बुदैः"<br><b>उल्लेखाः - </b>किरा० ५-६<br><br>

आरति
आरति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿವೃತ್ತಿ<br><br>आरति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿರಾಮ<br><b>निष्पत्तिः - </b>आ + रमु (क्रीडायाम्) - "क्तिन्" (३-३-९४)<br><br>

आरनाल
आरनाल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಜಿ /ಅಂಬಲಿ<br><b>निष्पत्तिः - </b>वा "कप्" (५-४-१५४)<br><b>व्युत्पत्तिः - </b>आरो नालो गन्धो यस्य<br><br>

आरनालक
आरनालक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಜಿ /ಅಂಬಲಿ<br><br>

आरब्ध
आरब्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭಿಸಲ್ಪಟ್ಟ /ಉಪಕ್ರಮಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + रभ (राभत्स्ये) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"व्रतयज्ञविवाहेषु श्राद्धे होमेऽएचने जपे । आरब्धे सूतकं न स्यात् अनारब्धे तु सूतकम् ॥"<br><br>

आरभट
आरभट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೀರ /ಶೂರ<br><br>

आरभटी
आरभटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆರಭಟೀ ವೃತ್ತಿ /ಒಂದು ವಿಧವಾದ ಭಾಷೆಯ ಶೈಲಿ<br><b>प्रयोगाः - </b>"आरभटी पुनः । रसे रौद्रे च बीभत्से"<br><b>उल्लेखाः - </b>सा० द०<br><br>आरभटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನರ್ತನದ ಒಂದು ರೀತಿ<br><br>

आरभ्य
आरभ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭಿಸಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>आ + रभ (राभत्स्ये) - "ण्यत्" (३-१-१२४)<br><br>आरभ्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉಪಕ್ರಮಿಸಿ<br><b>निष्पत्तिः - </b>आ + रभ (राभत्स्ये) - "ल्यप्" (७-१-३७)<br><br>आरभ्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮೊದಲುಗೊಂಡು<br><b>प्रयोगाः - </b>"मालत्याः प्रथमावलोकनदितादारभ्य"<br><b>उल्लेखाः - </b>मालती० ६-३<br><br>

आरमण
आरमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶ್ರಾಂತಿ<br><b>निष्पत्तिः - </b>आ + रमु (क्रीडायाम्) - "ल्युट्" (३-३-११५)<br><br>आरमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶ್ರಾಂತಿ ಸ್ಥಾನ<br><b>निष्पत्तिः - </b>अधि० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>आरम्यतेऽत्र<br><br>

आरम्भ
आरम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ<br><b>निष्पत्तिः - </b>आ + रभ (राभत्स्ये) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"चण्डारम्भः समीरो वहति परिदिशं भीरु किं सम्भ्रमेण"<br><b>उल्लेखाः - </b>वेणी० २-१९<br><br>आरम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನ<br><b>प्रयोगाः - </b>"सक्ताङ्गुलिः सायकपुङ्ख एव चित्रार्पितारम्भ इवावतस्थे"<br><b>उल्लेखाः - </b>रघु० २-३१<br><br>आरम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇಗ /ತ್ವರೆ<br><br>आरम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸ /ವ್ಯಾಪಾರ<br><b>प्रयोगाः - </b>"आगमैः सदृशारम्भः प्रारम्भसदृशोदयः"<br><b>उल्लेखाः - </b>रघु० १-१५<br><br>आरम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಸ್ತಾವನೆ<br><br>आरम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಹಂಕಾರ /ದರ್ಪ<br><br>आरम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಧೆ /ಕೊಲ್ಲುವಿಕೆ<br><b>विस्तारः - </b>"आरम्भस्तु स्यादुद्यमे वधदर्पयोः" - मेदि० ।<br><br>आरम्भ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭಿಸಲ್ಪಟ್ಟ<br><br>

आरम्भण
आरम्भण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ<br><br>आरम्भण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನ<br><br>आरम्भण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಸ್ತಾವನೆ<br><br>आरम्भण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಹಂಕಾರ /ದರ್ಪ<br><b>निष्पत्तिः - </b>आ + रभ (राभत्स्ये) - "ल्युट्" (३-३-११५)<br><br>आरम्भण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಾಧಾನ ಕಾರಣ<br><b>निष्पत्तिः - </b>अधि० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>आरभ्यतेऽनेन<br><br>

आरम्भणीय
आरम्भणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭಿಸಲ್ಪಡಬೇಕಾದ<br><b>निष्पत्तिः - </b>आ + रभ (राभत्स्ये) - "अनीयर्" (३-१-९६)<br><br>

आरम्भवाद
आरम्भवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿತ್ಯವಾದ ಪರಮಾಣುವೇ ಜಗತ್ತಿನ ಉತ್ಪತ್ತಿಗೆ ಕಾರಣೆಅವೆಂದು ಹೇಳುವ ತಾರ್ಕಿಕರ ವಾದ<br><b>विस्तारः - </b>"द्रव्याणि द्रव्यान्तरमारम्भन्ते गुणाश्च गुणान्तरम्" - वै० सू० ।<br><br>

आरव
आरव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದ /ಧ್ವನಿ<br><b>प्रयोगाः - </b>"ऋज्वीर्दधानैरवमत्य कन्धराश्चलावचूडाः कलघर्घरारवैः"<br><b>उल्लेखाः - </b>माघ० १२-१८<br><br>

आरात्
आरात्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ದೂರದಲ್ಲಿ<br><b>निष्पत्तिः - </b>आ + रा (दाने) - "आतिः" बाहु० ।<br><br>आरात्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ<br><b>प्रयोगाः - </b>"किं तावत्सरति सरोजमेतदारात्"<br><b>उल्लेखाः - </b>माघ० ८-२९<br><b>विस्तारः - </b>"आराद्दूरसमीपयोः" - अम० ।<br><br>

आराति
आराति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರು /ವೈರಿ<br><b>निष्पत्तिः - </b>आ + रा (दाने) - "क्तिच्" (३-३-१७४)<br><br>

आरातीय
आरातीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೂರದಲ್ಲಿರುವ<br><br>आरातीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದಲ್ಲಿರುವ<br><br>आरातीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೂರದಲ್ಲಿ ಉಂಟಾದ<br><br>आरातीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ ಉಂಟಾದ<br><br>आरातीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೂರದಿಂದ ಬಂದ<br><br>आरातीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಿಂದ ಬಂದ<br><b>निष्पत्तिः - </b>"छः" (४-२-११४)<br><b>व्युत्पत्तिः - </b>आरात् भवः जातः आगतो वा<br><br>

आरात्रिक
आरात्रिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆರತಿ /ಮಂಗಳಾರತಿ<br><br>

आराधक
आराधक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಚಕ /ಪೂಜೆ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>आ + राध (संसिद्धौ) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>आराध्नोति<br><br>

आराधन
आराधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ /ಉಪಾಸನೆ<br><b>निष्पत्तिः - </b>आ + राध (संसिद्धौ) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"अघोपघातं मघवा विभूत्यै भवोद्भवाराधनमादिदेश"<br><b>उल्लेखाः - </b>किरा० ११-८०<br><br>आराधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವೆ /ಶುಶ್ರೂಷೆ<br><b>प्रयोगाः - </b>"आरधनायास्य सखीसमेतां समादिदेश प्रयतां तनूजाम्"<br><b>उल्लेखाः - </b>कुमा० १-५८<br><br>आराधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂತೋಷಪಡಿಸುವಿಕೆ<br><b>प्रयोगाः - </b>"आरधनधनाय लोकानां मुञ्चतो नास्ति मे व्यथा"<br><b>उल्लेखाः - </b>उ० रा- १-१२<br><br>आराधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜಾಸಾಧನ<br><b>निष्पत्तिः - </b>कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>आराध्यतेऽनेन<br><b>प्रयोगाः - </b>"इदं तु ते भक्तिनम्रं सतामाराधनं वपुः"<br><b>उल्लेखाः - </b>कुमा० ६-७३<br><br>आराधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಕ /ಅಡಿಗೆ ಮಾಡುವುದು<br><br>आराधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪಾದನೆ /ಪ್ರಾಪ್ತಿ /ಲಾಭ<br><b>विस्तारः - </b>"आराधनं साधने स्यादवाप्तौ तोषणेऽपि च" - अम० । "आराधनं च पचने प्राप्तौ सन्तोषणेऽपि च" - मेदि० ।<br><br>

आराधना
आराधना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ /ಉಪಾಸನೆ<br><br>आराधना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವೆ /ಶುಶ್ರೂಷೆ<br><b>निष्पत्तिः - </b>आ + राध (संसिद्धौ) + णिच् - "युच्" (३-३-१०७)<br><br>

आराधनीय
आराधनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + राध (संसिद्धौ) - "अनीयर्" (३-१-९६)<br><b>प्रयोगाः - </b>"सोऽहं कथं नाम वताचरेयमाराधनीयस्य धृतेर्विघातम्"<br><b>उल्लेखाः - </b>रघु० १६-८२<br><br>

आराधयितृ
आराधयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸುವವನು<br><br>आराधयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಿಸುವವನು<br><br>आराधयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಿಚಾರಕ<br><b>निष्पत्तिः - </b>आ + राध (संसिद्धौ) - "तृच्" (३-१-१३३)<br><b>प्रयोगाः - </b>"नन्वयमाराधयिता जनस्तव समीपे वर्तते"<br><b>उल्लेखाः - </b>शाकु० ३<br><br>

आराधयित्री
आराधयित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आराधयितृ ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आराधित
आराधित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಟ್ಟ<br><br>

आराधित
आराधित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + राध (संसिद्धौ) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"राधेयमाराधितजामदग्न्यम्"<br><b>उल्लेखाः - </b>किरा० ३-२१<br><br>

आराध्य
आराध्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + राध (संसिद्धौ) - "ण्यत्" (३-१-१२४)<br><br>आराध्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಿ<br><b>निष्पत्तिः - </b>आ + राध (संसिद्धौ) - "ल्यप्" (७-१-३७)<br><b>प्रयोगाः - </b>"आराध्य वा सहस्राक्षमयशःशल्यमुद्धरे"<br><b>उल्लेखाः - </b>किरा० ११-७९<br><br>

आराम
आराम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈತೋಟ<br><b>निष्पत्तिः - </b>आ + रमु (क्रीडायाम्) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>आरम्यतेऽत्र<br><b>प्रयोगाः - </b>"योऽन्तःसुखोऽन्तरारामस्तथान्तर्ज्योतिरेव सः"<br><b>उल्लेखाः - </b>गीता० ५-२४<br><br>आराम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಹಾರ /ಕ್ರೀಡೆ<br><br>आराम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂತೋಷ<br><b>प्रयोगाः - </b>"रामभद्रः गुणाराम भ्रातृभिस्त्वं पुरस्कृतः"<br><b>उल्लेखाः - </b>म० वी० ७-४०<br><br>

आरामिक
आरामिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೋಟದ ಕಾವಲುಗಾರ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-६९)<br><b>व्युत्पत्तिः - </b>आरामे नियुक्तः<br><br>

आरालिक
आरालिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಡಿಗೆಯವನು<br><br>आरालिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಕ್ರಗತಿಯುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-८)<br><b>व्युत्पत्तिः - </b>अरालं कुटिलं चरति<br><br>

आराव
आराव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧ್ವನಿ /ಶಬ್ದ<br><b>निष्पत्तिः - </b>आ + रु (शब्दे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"नारावं व्यतनुत मेखलाकलापः कस्मिन् वा सजलगुणे गिरां पटुत्वम्"<br><b>उल्लेखाः - </b>माघ० ८-४५<br><br>

आराविन्
आराविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧ್ವನಿಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>आरावः शब्दोऽस्त्यत्र<br><b>प्रयोगाः - </b>"अनेन तनुमध्यया महुरनूपुराराविणा"<br><b>उल्लेखाः - </b>माल० ३-१७<br><br>

आरित्रिक
आरित्रिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಡಗಿನ ಲಂಗರಿನಲ್ಲಿರುವ<br><br>आरित्रिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲಂಗರಿನಲ್ಲಿ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>"ठञ्" "ञिठः" च (४-२-११६)<br><b>व्युत्पत्तिः - </b>अरित्रे भवः जातो वा<br><br>

आरित्रिकी
आरित्रिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आरित्रिक ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां ठञि "ङीप्" (४-१-१५)<br><br>

आरित्रिका
आरित्रिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आरित्रिक ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां ञिठि "टाप्" (४-१-४)<br><br>

आरित्सा
आरित्सा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸಲು ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>आ + राध (संसिद्धौ) + सन् - "अः" (३-३-१०२)<br><br>

आरित्सु
आरित्सु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸಲು ಅಪೇಕ್ಷೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>आ + राध (संसिद्धौ) + सन् - "उः" (३-२-१६८)<br><br>

आरिरात्सा
आरिरात्सा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲು ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>आ + राध (संसिद्धौ) + सन् - "अः" (३-३-१०२)<br><b>व्युत्पत्तिः - </b>आराद्धुमिच्छा<br><br>

आरिरात्सु
आरिरात्सु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲು ಅಪೇಕ್ಷೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>आ + राध (संसिद्धौ) + सन् - "उः" (३-२-१६८)<br><b>व्युत्पत्तिः - </b>आराद्धुमिच्छुः<br><br>

आरिराधयिषा
आरिराधयिषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ ಮಾಡಿಸಲು ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>आ + राध (संसिद्धौ) + णिच् + सन् - "अः" (३-३-१०२)<br><b>व्युत्पत्तिः - </b>आराधयितुमिच्छा<br><br>

आरिराधयिषु
आरिराधयिषु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜೆ ಮಾಡಿಸಲು ಅಪೇಕ್ಷೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>आ + राध (संसिद्धौ) + णिच् + सन् - "उः" (३-२-१६८)<br><b>व्युत्पत्तिः - </b>आराधयितुमिच्छुः<br><br>

आरीहणक
आरीहणक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆರೀಹಣ ರಾಜನಿಂದ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"वुञ्" (४-२-८०)<br><b>व्युत्पत्तिः - </b>आरीहणेन निर्वृत्तम्<br><br>

आरुरुक्षा
आरुरुक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಏರಲು ಇಚ್ಛೆ<br><b>निष्पत्तिः - </b>आ + रुह (बीजजन्मनि प्रादुर्भावे च) + सन् - "अः" (३-३-१०२)<br><b>व्युत्पत्तिः - </b>आरोढुमिच्छा<br><br>

आरुरुक्षु
आरुरुक्षु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏರಲು ಇಚ್ಛೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>आ + रुह (बीजजन्मनि प्रादुर्भावे च) + सन् - "उः" (३-२-१६८)<br><b>व्युत्पत्तिः - </b>आरोढुमिच्छुः<br><br>

आरूढ
आरूढ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + रुह (बीजजन्मनि प्रादुर्भावे च) - भावे "क्तः" (३-३-११४)<br><b>प्रयोगाः - </b>"अत्यारूढं रिपोः सोढं चन्दनेनेव भोगिनः"<br><b>उल्लेखाः - </b>रघु० १०-४२<br><br>आरूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹತ್ತಿದ<br><b>निष्पत्तिः - </b>कर्त० "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"आरूढः पतित इति स्वसम्भवोऽपि"<br><b>उल्लेखाः - </b>माघ० ८-५४<br><br>आरूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಂಟಾದ<br><b>प्रयोगाः - </b>"तदाग्मारूढगुरुप्रहर्षः"<br><b>उल्लेखाः - </b>रघु० ५-६१<br><br>आरूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + रुह (बीजजन्मनि प्रादुर्भावे च) - कर्म० "क्तः" (३-२-१०२)<br><br>

आरूढि
आरूढि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತುವಿಕೆ /ಏರುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + रुह (बीजजन्मादौ) - "क्तिन्" (३-३-९४)<br><br>

आरेक
आरेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಧಿಕ್ಯ<br><br>आरेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಕೋಚಮಾಡಿಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>आ + रिच (वियोजनसम्पर्चनयोः) - "घञ्" (३-३-१८)<br><br>

आरेचित
आरेचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಕೋಚ ಮಾಡಿಕೊಳ್ಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + रिच (वियोजनसम्पर्चनयोः) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आरेचितभ्रूचतुरैः कटाक्षैः"<br><b>उल्लेखाः - </b>कुमा० ३-५<br><br>

आरेवत
आरेवत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಕ್ಕೆ ಗಿಡ<br><b>निष्पत्तिः - </b>आ + रेचृ (गतौ) + णिच् - "विच्" (३-२-७५)<br><b>व्युत्पत्तिः - </b>आरेवयति निःसारयति मलम्<br><br>आरेवत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಕ್ಕೆ ಕಾಯಿ<br><br>

आरोग्य
आरोग्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗವಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अरोगस्य भावः<br><b>प्रयोगाः - </b>"आरोग्यं भास्करादिच्छेत् मोक्षमिच्छेत् जनार्दनात् । ज्ञानं महेश्वरादिच्छेत् शियमिच्छेत् हुताशनात् ॥"<br><br>

आरोग्यव्रत
आरोग्यव्रत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆರೋಗ್ಯಕ್ಕಾಗಿ ಆಚರಿಸಲ್ಪಡುವ ವ್ರತ<br><b>व्युत्पत्तिः - </b>आरोग्यार्थं व्रतम्<br><b>विस्तारः - </b>"अतः परं महाराज व्रतमारोग्यसञ्ज्ञितम् । सितायां माघमासस्य सप्तम्या समुपोषितः । षष्ट्यां चैव कृताहारः सप्तम्यामुपवासकृत् । अष्टम्यां चैव भुञ्जीत एष एव विधिर्मतः । अनेन वत्सरं पूर्णं विधिना योऽर्चयेद्रविम् । तस्यारोग्यं धनं धान्यमिह जन्मनि जायते ॥" - वराहपु०<br><br>

आरोग्यशाला
आरोग्यशाला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಕಿತ್ಸಾ ಗೃಹ<br><b>व्युत्पत्तिः - </b>आरोग्यार्था शाला<br><b>प्रयोगाः - </b>"आरोग्यशालां कुर्वीत महौषधिपरिच्छदाम् । विदग्धवैद्यसंयुक्तां बह्वन्नरससंयुताम् । वैद्यस्तु शास्त्रवित्प्राज्ञः दृष्टौषधपराक्रमः । ओषधीमूलतत्त्वज्ञः समुद्धरणकालवित् । त्यागिवद्देहिनां तद्वदनुकूलप्रियंवदः ॥"<br><br>

आरोग्यस्नान
आरोग्यस्नान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆರೋಗ್ಯಾನಂತರ ಮಾಡುವ ಸ್ನಾನ<br><b>व्युत्पत्तिः - </b>आरोग्यनिमित्तं स्नानम्<br><br>

आरोढृ
आरोढृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆನೆ ಕುದುರೆ ಮೊದಲಾದುವುಗಳ ಮೇಲೆ ಹತ್ತುವವನು<br><b>निष्पत्तिः - </b>आ + रुह (बीजजन्मादौ) - "तृच्" (३-१-१३३)<br><b>प्रयोगाः - </b>"आरोढुः समवनतस्य पीतशेषे"<br><b>उल्लेखाः - </b>किरा० ७-३३<br><br>

आरोप
आरोप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + रुह (बीजजन्मादौ) + णिच् - "घञ्" (३-३-१८)<br><br>आरोप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಸ್ತುವಿನಲ್ಲಿ ಮತ್ತೊಂದರ ಜ್ಞಾನ<br><br>आरोप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಣದಲ್ಲಿ ದೋಷವನ್ನು ಹೇಳುವುದು<br><br>आरोप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಿಡ ಮುಂತಾದುವನ್ನು ನೆಟ್ಟು ಬೆಳೆಸುವುದು<br><br>आरोप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲೆ ಇಡುವುದು<br><br>आरोप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಪ್ಪು ಹೊರಿಸುವುದು<br><br>

आरोपक
आरोपक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏರಿಸುವವನು<br><br>आरोपक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಿಡಗಳನ್ನು ನೆಟ್ಟು ಬೆಳೆಸುವವನು<br><b>निष्पत्तिः - </b>आ + रुह (बीजजन्मादौ) + णिच् - "ण्वुल्" (३-१-१३३)<br><br>आरोपक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎತ್ತಿ ಇಡುವವನು /ಮೇಲೆ ಇರಿಸುವವನು<br><br>

आरोपण
आरोपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿಸುವುದು /ಮೇಲಕ್ಕೆ ಏರಿಸುವುದು<br><b>निष्पत्तिः - </b>आ + रुह (बीजजन्मादौ) + णिच् - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"जयापती लौकिकमेषणीयमार्द्राक्षतारोपणमन्वभूताम्"<br><b>उल्लेखाः - </b>कुमा० ७-८८<br><br>

आरोपणीय
आरोपणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆರೋಪಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + रुह (बीजजन्मादौ) + णिच् - "अनीयर्" (३-१-९६)<br><br>आरोपणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏರಿಸಲ್ಪಡುವ<br><br>

आरोप्य
आरोप्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆರೋಪಿಸಲ್ಪಡುವ<br><br>आरोप्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿಸಲ್ಪಡುವ<br><br>आरोप्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭ್ರಾಂತಿಯಿಂದ ತಿಳಿಯಲ್ಪಡುವ<br><br>

आरोपित
आरोपित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆರೋಪಿಸಲ್ಪಟ್ಟ<br><br>आरोपित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏರಿಸಲ್ಪಟ್ಟ<br><br>आरोपित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೆಟ್ಟು ಬೆಳೆಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + रुह (बीजजन्मादौ) + णिच् - "क्तः" (३-२-१०२)<br><br>आरोपित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अथाभिपश्यन्निव पुरःपुरोधसारोपितहेतिसंहतिः"<br><b>उल्लेखाः - </b>किरा० ३-५६<br><br>आरोपित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭ್ರಾಂತಿಯಿಂದ ತಿಳಿಯಲ್ಪಟ್ಟ<br><br>

आरोह
आरोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತುವುದು<br><br>आरोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತರ<br><br>आरोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಳಕೆ<br><br>आरोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಹಂಕಾರ<br><br>आरोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ದ /ನೀಳ<br><br>आरोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತ್ರೀಯರ ನಿತಂಬ<br><br>आरोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಳಿಯುವುದು<br><br>आरोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆ ಕುದುರೆ ಮೊದಲಾದುವುಗಳ ಮೇಲೆ ಸವಾರಿ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>आ + रुह (बीजजन्मादौ) - "घञ्" (३-३-१८)<br><b>विस्तारः - </b>"आरोहस्त्ववरोहे च वरारोहाकटावपि । आरोहणे गजारोहे दीर्घत्वे च समुच्छ्रये" - मेदि० ।<br><br>

आरोहण
आरोहण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹತ್ತುವುದು<br><b>निष्पत्तिः - </b>आ + रुह (बीजजन्मादौ) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"आरोहणार्थं नवयौवनेन कामस्य सोपानमिव प्रयुक्तम्"<br><b>उल्लेखाः - </b>कुमा० १-३९<br><br>आरोहण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೀಜವು ಅಂಕುರಿಸುವುದು<br><br>आरोहण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೋಪಾನ /ಮೆಟ್ಟಿಲು<br><b>निष्पत्तिः - </b>आ + रुह (बीजजन्मादौ) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>आरुह्यतेऽनेन<br><b>विस्तारः - </b>"आरोहणं स्यात् सोपाने समारोहे प्ररोहणे" - मेदि० ।<br><br>आरोहण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಗೀತದ ಸ್ವರಗಳ ಏರಿಕೆ<br><br>

आरोहणीय
आरोहणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + रुह (बीजजन्मादौ) - "अनीयर्" (३-१-९६)<br><br>आरोहणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹತ್ತಲು ಉಪಯೋಗಿಸಲ್ಪಡುವ ಸಾಧನ<br><b>निष्पत्तिः - </b>"छः" (५-१-१११)<br><b>व्युत्पत्तिः - </b>आरोहणं प्रयोजनमस्य<br><br>

आरोहिन्
आरोहिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹತ್ತುವವನು<br><b>निष्पत्तिः - </b>आ + रुह (बीजजन्मादौ) - "णिनिः" (३-१-१३४)<br><br>

आरोहिणी
आरोहिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹತ್ತುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>आरोहिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೊತಿಷೋಕ್ತವಾದ ಸೂರ್ಯಾದಿ ಗ್ರಹಗಳ ದಶೆ<br><br>

आर्कायण
आर्कायण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಗತಿ<br><br>आर्कायण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೂರ್ಯವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>"फञ्" (४-१-११०)<br><b>व्युत्पत्तिः - </b>अर्कस्य गोत्रापत्यम्<br><br>

आर्कि
आर्कि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನಪುತ್ರ ಶನಿದೇವ<br><br>आर्कि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಮ<br><br>आर्कि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣ<br><br>आर्कि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಗ್ರೀವ<br><br>आर्कि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನು<br><br>आर्कि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಿನೀ ಕುಮಾರರು<br><b>निष्पत्तिः - </b>"इञ्" (४-१-९५)<br><b>व्युत्पत्तिः - </b>अर्कस्यापत्यम्<br><br>

आर्क्ष
आर्क्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಕ್ಷತ್ರ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>ऋक्षस्येदम्<br><br>

आर्क्ष्य
आर्क्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಕ್ಷತ್ರದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"यञ्" (४-१-१०५)<br><b>व्युत्पत्तिः - </b>ऋक्षे भवः<br><br>

आर्गल
आर्गल<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಳಿ /ಬಾಗಿಲಿಗೆ ಹಾಕುವ ಮರ<br><b>निष्पत्तिः - </b>अर्गल - स्वार्थे "अण्"<br><br>

आर्गली
आर्गली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಳಿ /ಬಾಗಿಲಿಗೆ ಹಾಕುವ ಮರ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

आर्घा
आर्घा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚೂಪಾದ ಮೂತಿಯುಳ್ಳ ಹಳದಿ ಬಣ್ಣದ ಒಂದು ಜಾತಿಯ ಜೇನುಹುಳ<br><br>

आर्घ्य
आर्घ्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಳದಿ ಬಣ್ಣದ ಜೇನುಹುಳುವಿನಿಂದ ಉಂಟಾದ ಜೇನುತುಪ್ಪ<br><br>आर्घ्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜರತ್ಕಾರು ಋಷಿಯ ಆಶ್ರಮದ ಹಿಪ್ಪೆ ಮರದಿಂದ ಹೊರಟ ರಸ<br><b>प्रयोगाः - </b>"मधूकवृक्षा निर्यासं जरत्कार्वाश्रमोद्भवाः । स्रवन्त्यार्घ्यं तदाख्यातं श्वेतकं मालवे पुनः । तीक्ष्णतुण्डास्तु याः पीताः मक्षिकाः षट्पदोपमाः । आर्घास्ताः तत्कृतं यत् स्यात् आर्घ्यमित्यपरे जगुः ॥"<br><br>

आर्च
आर्च<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಾಕಾರ್ಯವುಳ್ಳ<br><b>निष्पत्तिः - </b>"णः" (५-२-१०१)<br><b>व्युत्पत्तिः - </b>अर्च्यास्त्यस्य<br><br>

आर्चिक
आर्चिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಋಗ್ವೇದಲ್ಲಿ ಉಕ್ತವಾದ<br><b>निष्पत्तिः - </b>"ठक्" (४-३-७२)<br><b>व्युत्पत्तिः - </b>ऋचि भवः<br><br>आर्चिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಋಕ್ಕುಗಳ ವ್ಯಾಖ್ಯಾನ<br><b>निष्पत्तिः - </b>"ठक्" (४-३-७२)<br><b>व्युत्पत्तिः - </b>ऋचां व्याख्यानो ग्रन्थः<br><br>

आर्चीक
आर्चीक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಋಚೀಕಪರ್ವತ<br><br>आर्चीक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಋಚೀಕಪರ್ವತಕ್ಕೆ ಸಂಬಂಧಿಸಿದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-५३)<br><b>व्युत्पत्तिः - </b>ऋचीके भवः<br><br>

आर्जक
आर्जक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಪಾದಿಸುವವನು<br><b>निष्पत्तिः - </b>आ + अर्ज (अर्जने) - "ण्वुल्" (३-१-१३३)<br><b>प्रयोगाः - </b>"पार्थ एव सहजेष्वखिलेषु प्रायशो युधि बलं श्रुतवत्याः । अन्वभूदधिकमीक्षणवृष्टीरार्जकांशमिव राजसुतायाः ॥"<br><b>उल्लेखाः - </b>चं० भा०<br><br>

आर्जव
आर्जव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸರಳತೆ /ನೇರವಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"अण्" (५-१-१२२)<br><b>व्युत्पत्तिः - </b>ऋजोर्भावः<br><b>प्रयोगाः - </b>"ऋजुता वक्रतां प्राप वक्रता च तथार्जवम्"<br><b>उल्लेखाः - </b>चं० रा०<br><br>आर्जव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಮಾಣಿಕತೆ<br><br>आर्जव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಧೇಯತೆ<br><b>प्रयोगाः - </b>"ददर्श गोपानुपधेनु पाण्डवः कृतानुकारानिव गोभिरार्जवे"<br><b>उल्लेखाः - </b>किरा० ४-१३<br><br>

आर्जुनायन
आर्जुनायन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಜುನನ ಗೋತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><b>निष्पत्तिः - </b>"फञ्" (४-१-११०)<br><b>व्युत्पत्तिः - </b>अर्जुनस्य गोत्रापत्यम्<br><br>

आर्जुनायना
आर्जुनायना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಜುನನ ಗೋತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्"<br><br>

आर्जुनि
आर्जुनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಜುನನ ಮಗ /ಅಭಿಮನ್ಯು<br><b>निष्पत्तिः - </b>"इञ्" (४-१-९५)<br><b>व्युत्पत्तिः - </b>अर्जुनस्यापत्यम्<br><br>

आर्त
आर्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೀಡಿಸಲ್ಪಟ್ಟ<br><br>आर्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುಃಖಗೊಂಡ<br><b>प्रयोगाः - </b>"तदीयमाक्रन्दितमार्तसाधोर्गुहानिबद्धप्रतिशब्ददीर्घम्"<br><b>उल्लेखाः - </b>रघु० २-२८<br><br>आर्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೋಗಿ /ವ್ಯಾಧಿಗ್ರಸ್ತ<br><b>निष्पत्तिः - </b>आ + ऋ (गतौ) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"द्वेष्योऽपि सम्मतः शिष्टस्तस्यार्तस्य यथौषधम्"<br><b>उल्लेखाः - </b>रघु० १-२८<br><br>

आर्तगल
आर्तगल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀಲಿ ಹೂವಿನ ಗೋರಂಟಿ<br><br>

आर्तपर्णि
आर्तपर्णि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಋತುಪರ್ಣಮಹಾರಾಜನ ಮಗ<br><b>निष्पत्तिः - </b>"इञ्" (४-१-९५)<br><b>व्युत्पत्तिः - </b>ऋतुपर्णस्यापत्य्म्<br><br>

आर्तव
आर्तव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಟ್ಟು /ರಜಸ್ಸು<br><b>निष्पत्तिः - </b>ऋतु - "अण्" (५-४-३८)<br><b>प्रयोगाः - </b>"नोपगच्छेत् प्रमत्तोऽपि स्त्रियमार्तवदर्शने"<br><b>उल्लेखाः - </b>मनु० ४-४०<br><br>आर्तव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಸಂತಾದಿ ಋತು ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (५-१-१०५)<br><b>व्युत्पत्तिः - </b>ऋतुरस्य प्राप्तः<br><b>प्रयोगाः - </b>"अवधीरितार्वतवगुणं सुखताम् नयता रुचां निचयमंशुमतः"<br><b>उल्लेखाः - </b>किरा० ६-२५<br><br>

आर्ति
आर्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಂದರೆ /ಪೀಡೆ<br><br>आर्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೋವು /ದುಃಖ<br><br>आर्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಧನುಸ್ಸಿನ ಅಗ್ರಭಾಗ<br><br>आर्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿನಾಶ /ಅಳಿವು<br><b>निष्पत्तिः - </b>आ + ऋ (गतौ) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"आपन्नार्तिप्रशमनफलाः सम्पदो ह्युत्तमानाम्"<br><b>उल्लेखाः - </b>मेघ० १-५३<br><br>आर्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗ /ವ್ಯಾಧಿ<br><br>

आर्त्विज
आर्त्विज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಋತ್ವಿಕ್ಕಿನ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>ऋत्विज इदम्<br><br>

आर्त्विजीन
आर्त्विजीन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜಮಾನ /ಯಾಗ ಮಾಡುವವನು<br><b>व्युत्पत्तिः - </b>ऋत्विजमर्हति<br><br>आर्त्विजीन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಋತ್ವಿಕ್ಕು<br><b>निष्पत्तिः - </b>"खञ्" (वा० ५-१-७१)<br><b>व्युत्पत्तिः - </b>ऋत्विजं तत्कर्मार्हति<br><b>प्रयोगाः - </b>"दक्षिण्यदिष्टं कृतमार्त्विजीनैस्तद्यातुधानैश्चिचिते प्रसर्पत्"<br><b>उल्लेखाः - </b>भट्टि० २-२९<br><br>

आर्त्विज्य
आर्त्विज्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಋತ್ವಿಕ್ಕಿನ ಕಾರ್ಯ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>ऋत्विजो भावः कर्म वा<br><br>

आर्थ
आर्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಾತ್ತಶಬ್ದದಿಂದ ಉಂಟಾಗದೆ ಅರ್ಥದಿಂದ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-७४)<br><b>व्युत्पत्तिः - </b>अर्थादागतः<br><br>आर्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಥಲಬ್ಧವಾದ ವ್ಯಂಜನೆ<br><br>

आर्थिक
आर्थिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಥದಿಂದುಂಟಾದ<br><b>निष्पत्तिः - </b>"ठक्" (४-३-७४)<br><b>व्युत्पत्तिः - </b>अर्थादागतः<br><br>आर्थिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಥವನ್ನು ತೆಗೆದುಕೊಳ್ಳುವ /ದ್ರವ್ಯವನ್ನು ತೆಗೆದುಕೊಳ್ಳುವ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-४०)<br><b>व्युत्पत्तिः - </b>अर्थं गृह्णाति<br><br>

आर्द्र
आर्द्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೆನೆದಿರುವ<br><b>निष्पत्तिः - </b>अर्द (गतौ) - "रक्" दीर्घश्च (उ० २-१८)<br><b>व्युत्पत्तिः - </b>अर्द्यते स्म<br><b>प्रयोगाः - </b>"प्रत्यंसं विलुलितमूर्धजा चिराय स्नानार्द्रं वपुरुदवापयत्किलैषा"<br><b>उल्लेखाः - </b>माघ० ८-६८<br><br>आर्द्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಸವತ್ತಾದ<br><b>प्रयोगाः - </b>"आर्द्रं द्रव्यं द्विधा प्रोक्तं सरसं नीरसं तथा । सदुग्धं गुप्तरसकं द्विधा नीरसमुच्यते ॥"<br><br>आर्द्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೃದುವಾದ<br><b>प्रयोगाः - </b>"प्रेमार्द्राः प्रणयस्पृशः परिचयादुद्गाढरागोदयाः"<br><b>उल्लेखाः - </b>मालती० ५-७<br><br>आर्द्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಸದಾದ<br><b>प्रयोगाः - </b>"ते पुत्रयोर्नैरृतशस्त्रमार्गानार्द्रानिवाङ्गे स्पृशन्त्यौ"<br><b>उल्लेखाः - </b>रघु० १४-४<br><br>

आर्द्रक
आर्द्रक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆರ್ದ್ರಾನಕ್ಷತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><b>निष्पत्तिः - </b>"वुन्" (४-३-२८)<br><b>व्युत्पत्तिः - </b>अर्द्रायां जातः<br><br>आर्द्रक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸಿಶುಂಠಿ<br><b>निष्पत्तिः - </b>"क्वुन्" (उ० २-३२)<br><b>व्युत्पत्तिः - </b>आर्द्रयति जिह्वाम् । आर्द्रायां भूमौ जातं वा ।<br><br>

आर्द्रपदी
आर्द्रपदी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒದ್ದೆಯಾದ ಕಾಲುಗಳುಳ್ಳ ಹೆಂಗಸು<br><br>

आर्द्रमाषा
आर्द्रमाषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುದ್ದಿನ ಗಿಡ<br><br>

आर्द्रशाक
आर्द्रशाक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸಿಶುಂಠಿ<br><br>

आर्द्रालुब्धक
आर्द्रालुब्धक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇತುಗ್ರಹ<br><br>

आर्द्रा
आर्द्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆರಿದ್ರಾನಕ್ಷತ್ರ<br><br>

आर्धधातुक
आर्धधातुक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧಾತುವಿನ ಮುಂದೆ ವಿಧಿಸಲ್ಪಡುವ ಪ್ರತ್ಯಯ<br><br>

आर्धरात्रिक
आर्धरात्रिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಧರಾತ್ರಿಯಲ್ಲಿ ಉಂಟಾದ<br><b>व्युत्पत्तिः - </b>अर्धरात्रे भवः<br><br>

आर्धिक
आर्धिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೈಶ್ಯ ಹೆಂಗಸಿನಲ್ಲಿ ಜನಿಸಿ ಬ್ರಾಹ್ಮಣನ ಮನೆಯಲ್ಲಿ ಬೆಳೆದು ಸುಸಂಕೃತನಾದವನು /ಅಂಬಷ್ಠನೆಂಬ ಬೆರಕೆ ಜಾತಿಯವನು<br><br>आर्धिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಮೀನನ್ನು ಸಾಗುವಳಿ ಮಾಡಿ ಯಜಮಾನನಿಂದ ಅರ್ಧಭಾಗ ಧಾನುಅಗಳನ್ನು ಪಡೆಯುವ ಹಕ್ಕುಳ್ಳ ರೈತ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-६३)<br><b>व्युत्पत्तिः - </b>अर्धमर्हति<br><b>प्रयोगाः - </b>"आर्धिकः कुलमित्रं च गोपालो दासनापितौ"<br><b>उल्लेखाः - </b>मनु० ४-२५३<br><br>

आर्धिकी
आर्धिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आर्धिक ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

आर्य
आर्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಾಧ್ಯಾಯ /ಗುರು<br><br>आर्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ನೇಹಿತ /ಮಿತ್ರ<br><br>आर्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಾಮಿ /ಯಜಮಾನ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "ण्यत्" (३-१-१२४)<br><br>आर्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ವಶುರ<br><br>आर्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಚುಕಿ<br><br>आर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಲೀನ<br><br>आर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾನ್ಯ /ಪೂಜ್ಯ<br><br>आर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠನಾದವನು<br><br>आर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದಾರ ಚಿತ್ತವುಳ್ಳವನು<br><br>आर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಧು /ಶಾಂತಚಿತ್ತ<br><b>विस्तारः - </b>"आर्यः साधौ सोविदल्लेपि" - विश्व० ।<br><br>आर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸದಾಚಾರಸಂಪನ್ನ<br><b>प्रयोगाः - </b>"ग्रहीतुमार्यान् परिचर्यया मुहुर्महानुभावा हि नितान्तमर्थिनः"<br><b>उल्लेखाः - </b>माघ० १-१७<br><br>आर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನ್ಯಾಯವಾದ<br><br>आर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಡತಕ್ಕವನು<br><br>आर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಟಕದಲ್ಲಿ ಪೂಜ್ಯನ ಸಂಬೋಧನೆ<br><b>प्रयोगाः - </b>"राषन्नित्यृषिभिर्वाच्य सोऽप्रत्यप्रत्ययेन च । स्वेच्छया नामभिर्विप्रैः विप्र आर्येति चेतरैः । वाचयु नटीसूत्रधारौ आर्यनाम्ना परस्परम् ॥"<br><b>उल्लेखाः - </b>सा- द०<br><br>

आर्या
आर्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜ್ಯಳು<br><b>प्रयोगाः - </b>"आर्याप्यरुन्धती तत्र व्यापारां कर्तुमर्हति"<br><b>उल्लेखाः - </b>कुमा० ६-३२<br><br>आर्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠಚಿತ್ತವೃತ್ತಿಯುಳ್ಳಹೆಂಗಸು<br><br>आर्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರ್ವತಿ<br><b>विस्तारः - </b>"गौर्यामार्या त्रिषुत्वेष कुलीनन्याय्यसाधुषु" - नानार्थर० ।<br><br>आर्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರ್ವತಿ /ಗೌರಿ<br><br>आर्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತಮ ಹೆಂಗಸು<br><br>आर्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅತ್ತೆ /ಪತಿಯ ತಾಯಿ<br><br>आर्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾತ್ರಾಛಂದಸ್ಸಿನ ಒಂದು ವೃತ್ತ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "ण्यत्" (३-१-१२४)<br><b>विस्तारः - </b>"आर्यः साधौ सौविदल्लेऽप्यार्योमावृत्तभेदयोः" - विश्व० ।<br><br>

आर्यक
आर्यक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಿತಾಮಹ /ತಂದೆಯ ತಂದೆ<br><br>आर्यक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾತಾಮಹ /ತಾಯಿಯ ತಂದೆ<br><b>प्रयोगाः - </b>"आर्यकेण च दृष्टः स पृथाया आर्यकेण च । तदा दौहित्रदौहित्रः परिष्वक्तः सुपीडितम् ॥"<br><b>उल्लेखाः - </b>भा०<br><br>आर्यक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೌರವಾರ್ಹ /ಪೂಜ್ಯ<br><b>निष्पत्तिः - </b>आर्य - स्वार्थे "कन्"<br><br>

आर्यगृह्य
आर्यगृह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆರ್ಯರಿಂದ ಗೌರವಿಸಪಡತಕ್ಕವನು /ಪೂಜ್ಯರ ಗುಂಪಿಗೆ ಸೇರಿದವನು<br><b>निष्पत्तिः - </b>ग्रह (उपादाने) - "क्यप्" (३-१-११९)<br><b>व्युत्पत्तिः - </b>आर्यैर्गृह्यते<br><b>प्रयोगाः - </b>"तमार्यगृह्यं निगृहीतधेनुर्मनुष्यवाचा मनुवंशकेतुम्"<br><b>उल्लेखाः - </b>रघु० २-३३<br><br>

आर्यधर्म
आर्यधर्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿರಿಯರ ಸಂಪ್ರದಾಯ /ಸದಾಚಾರ<br><b>व्युत्पत्तिः - </b>अर्याणां धर्मः<br><br>

आर्यपुत्र
आर्यपुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪತಿ /ಗಂಡ<br><b>व्युत्पत्तिः - </b>आर्यस्य श्वशुरस्य पुत्रः<br><br>आर्यपुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜ್ಯರ ಮಗ<br><br>आर्यपुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಚಾರ್ಯರ ಮಗ<br><b>प्रयोगाः - </b>"आर्यपुत्र, इयमस्मि । आज्ञापयत्वार्यपुत्रः को नियोगोऽनुष्ठीयतामिति"<br><b>उल्लेखाः - </b>रत्ना० १<br><br>

आर्यभट्ट
आर्यभट्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ದೊಡ್ಡ ಹಿರಿಯ ಜ್ಯೋತಿಃಶಾಸ್ತ್ರಜ್ಞ<br><br>

आर्यमिश्र
आर्यमिश्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜ್ಯ /ಗೌರವಾನ್ವಿತ<br><b>प्रयोगाः - </b>"नन्वार्यमिश्रैः प्रथममेवाज्ञप्तमभिज्ञानशाकुन्तलं नामापूर्वं नाटकं प्रयोगेऽधिक्रियतामिति"<br><b>उल्लेखाः - </b>शाकु० १<br><br>

आर्यागीति
आर्यागीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾತ್ರಾವೃತ್ತಗಳಲ್ಲೊಂದು ಭೇದ<br><b>प्रयोगाः - </b>"आर्यापूर्वार्धं यदि, गुरुणैकेनाधिकेन निधने युक्तम् । इतरत्तद्वन्निखिलं दलं यदीयमुदितेयमार्यागीतिः ॥"<br><b>उल्लेखाः - </b>वृ० र०<br><br>

आर्यावर्त
आर्यावर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಂಧ್ಯ ಮತ್ತು ಹಿಮಾಚಲಗಳ ಮಧ್ಯದ ಪ್ರದೇಶ /ಪೂರ್ವ ಮತ್ತು ಪಶ್ಚಿಮ ಸಮುದ್ರಗಳ ಮಧ್ಯದಲ್ಲಿರುವ ದೇಶ<br><b>निष्पत्तिः - </b>आ + वृतु (वर्तने) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>आर्याः आवर्तन्तेऽत्र<br><b>प्रयोगाः - </b>"आ समुद्रात् वै पूर्वादा समुद्रात्तु पश्चिमात् । तयोरेवान्तरं गिर्योरार्यावर्तं विदुर्बुधाः ॥"<br><b>उल्लेखाः - </b>मनु० २-२२<br><b>विस्तारः - </b>"आर्यावर्तः पुण्यभूमिर्मध्यं विन्ध्यहिमागयोः" - अम० ।<br><br>

आर्ष
आर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೮ ವಿಧ ವಿವಾಹಗಳಲ್ಲೊಂದು<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>ऋषिर्वेदः तस्यापत्य्म्<br><b>प्रयोगाः - </b>"ब्राह्मो दैवस्तथैवार्षः प्राजापत्यस्तथासुरः । गान्धर्वो राक्षसश्चैव पैशाचश्चाष्टमोऽधमः ॥"<br><b>उल्लेखाः - </b>मनु० ३-२१<br><br>आर्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಋಷಿ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>ऋषेरिदम्<br><br>आर्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಋಷಿಪ್ರಣೀತವಾದ<br><b>प्रयोगाः - </b>"आर्षं धर्मोपदेशं च वेदशास्त्राविरोधिना । यस्तर्केणानुसन्धत्ते स धर्मं वेद नेतरः ॥"<br><b>उल्लेखाः - </b>मनु० १२-१०६<br><br>आर्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇದ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>ऋषिर्वेदः तस्देदम्<br><br>

आर्षधर्म
आर्षधर्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಋಷಿಗಳಿಂದ ಹೇಳಲ್ಪಟ್ಟ ಮಾನವಧರ್ಮ<br><br>आर्षधर्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆರ್ಷವಿವಾಹ<br><br>

आर्षभ
आर्षभ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೃಷಭಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>ऋषभस्येदम्<br><br>

आर्षभि
आर्षभि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಋಷಭದೇವನ ಮಗ<br><b>निष्पत्तिः - </b>"इञ्" (४-१-९५)<br><b>व्युत्पत्तिः - </b>ऋषभस्यापत्यम्<br><br>

आर्षभ्य
आर्षभ्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೂಳಿಯಾಗುವ ಹೋರಿ<br><b>निष्पत्तिः - </b>"ञ्यः" (५-१-१४)<br><b>व्युत्पत्तिः - </b>ऋषभाय अयम्<br><b>विस्तारः - </b>"आर्षभ्यः षण्डतायोग्यः" - अम० ।<br><br>

आर्हत
आर्हत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೈನ<br><br>आर्हत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜೈನಮತ<br><br>आर्हत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೈನಮತಸಂಬಂಧವಾದ<br><br>आर्हत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೈನಮತಾನುಯಾಯಿ<br><br>

आर्हन्ती
आर्हन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯೋಗ್ಯತೆ /ಅರ್ಹತೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" नुम् च (वा० ५-१-१२४) । "ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>अर्हतो भावः<br><b>प्रयोगाः - </b>"श्रोत्रार्हन्तीचणैर्गुण्यैः"<br><b>उल्लेखाः - </b>सि० कौ०<br><br>

आर्हन्त्य
आर्हन्त्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯೋಗ್ಯತೆ /ಅರ್ಹತೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" नुम् च (वा० ५-१-१२४) ।<br><b>व्युत्पत्तिः - </b>अर्हतो भावः<br><br>

आल
आल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹರಿದಳ<br><br>आल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾದ<br><b>निष्पत्तिः - </b>आ + ला (आदाने) - "कः" (३-१-१३६)<br><b>व्युत्पत्तिः - </b>आलति<br><b>विस्तारः - </b>"आलं स्यादनल्पहरितालयोः" - हेम० ।<br><br>आल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ<br><br>

आलक्षयत्
आलक्षयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡುವವನು<br><b>निष्पत्तिः - </b>आ + लक्ष (दर्शनाङ्कनयोः) + णिच् - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"रामं सलक्ष्मणमालक्षयन्नेवमवोचत"<br><b>उल्लेखाः - </b>चं० रा०<br><br>

आलक्षित
आलक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ತಿಳಿಯಲ್ಪಟ್ಟ<br><br>आलक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಮಾನದಿಂದ ತಿಳಿಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + लक्ष (दर्शनाङ्कनयोः) + णिच् - "क्तः" (३-२-१०२)<br><br>

आलक्ष्य
आलक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ತಿಳಿಯಲ್ಪಡುವ<br><br>आलक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಕಾಣುವ<br><b>व्युत्पत्तिः - </b>आ समन्तात् लक्ष्यम्<br><br>आलक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಕಾಣುವ<br><b>व्युत्पत्तिः - </b>आ ईषत् लक्ष्यम्<br><b>प्रयोगाः - </b>"आलक्ष्यदन्तमुकुलाननिमित्तहासैः"<br><b>उल्लेखाः - </b>शाकु० ७-१७<br><br>आलक्ष्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ನೋಡಿ<br><br>आलक्ष्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ತಿಳಿದುಕೊಂಡು<br><b>निष्पत्तिः - </b>आ + लक्ष (दर्शनाङ्कनयोः) + णिच् - "ल्यप्" (७-१-३७)<br><br>

आलपन
आलपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾತಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + लप (व्यक्तायां वाचि) - भावे "ल्युट्" (३-३-११५)<br><br>

आलपनीय
आलपनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಶ್ಯವಾಗಿ ಹೇಳಲ್ಪಡುವ<br><br>आलपनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲು ಅರ್ಹವಾದ<br><b>निष्पत्तिः - </b>आ + लप (व्यक्तायां वाचि) - "अनीयर्" (३-१-९६)<br><br>

आलपितव्य
आलपितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>आलपनीय ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>आ + लप (व्यक्तायां वाचि) - "तव्यः" (३-१-९६)<br><br>

आलप्य
आलप्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮಾತನಾಡಿ /ಹೇಳಿ<br><b>निष्पत्तिः - </b>आ + लप (व्यक्तायां वाचि) - "ल्यप्" (७-१-३७)<br><b>प्रयोगाः - </b>"आलप्यालमिदं बभ्रोर्यत्स दारानपाहरत् । कथापि खलु पापानामलमश्रेयसे यतः ॥"<br><b>उल्लेखाः - </b>माघ० २-४०<br><br>

आलब्ध
आलब्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆರೆಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + डुलभष् (प्राप्तौ) - "क्तः" (३-२-१०२)<br><br>आलब्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇರಿಸಲ್ಪಟ್ಟ<br><br>आलब्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸಲ್ಪಟ್ಟ<br><br>आलब्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಟ್ಟಲ್ಪಟ್ಟ<br><br>

आलब्धि
आलब्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಪರ್ಶ /ಮುಟ್ಟುವಿಕೆ<br><br>आलब्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸೆ<br><b>निष्पत्तिः - </b>आ + डुलभष् (प्राप्तौ) - "क्तिन्" (३-३-९४)<br><br>

आलभन
आलभन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸೆ /ಕೊಲ್ಲುವುದು<br><br>आलभन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರ್ದಿಸುವುದು<br><br>आलभन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಪರ್ಶ /ಮುಟ್ಟುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + डुलभष् (प्राप्तौ) - "ल्युट्" (३-३-११५)<br><br>

आलभनीय
आलभनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಟ್ಟಲ್ಪಡುವ<br><br>आलभनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರ್ದಿಸಲ್ಪಡುವ<br><br>आलभनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + डुलभष् (प्राप्तौ) - "अनीयर्" (३-१-९६)<br><br>

आलभ्य
आलभ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಟ್ಟಲ್ಪಡುವ<br><br>आलभ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + डुलभष् (प्राप्तौ) - "ण्यत्" (३-१-१२४)<br><br>आलभ्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮುಟ್ಟಿ /ಸ್ಪರ್ಶ ಮಾಡಿ<br><br>आलभ्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸಿ<br><b>निष्पत्तिः - </b>आ + डुलभष् (प्राप्तौ) - "ल्यप्" (७-१-३७)<br><br>

आलम्ब
आलम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ /ಅವಲಂಬನ<br><br>आलम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒತ್ತುಗಂಬ<br><b>निष्पत्तिः - </b>आ + लबि (अवस्रंसने) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"विनिपातनिवर्तनक्षमं मतमालम्बनमात्मपौरुषम्"<br><b>उल्लेखाः - </b>किरा० २-१३<br><br>आलम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೋಲಾಡುವಿಕೆ<br><br>

आलम्बन
आलम्बन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ /ಆಧಾರ<br><br>आलम्बन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒತ್ತುಗಂಬ<br><br>आलम्बन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶೃಂಗಾರಾದಿ ರಸಗಳಿಗೆ ಆಶ್ರಯಭೂತರಾದ ನಾಯಿಕಾನಾಯಕಾದಿಗಳು<br><br>

आलम्बित
आलम्बित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧರಿಸಲ್ಪಟ್ಟ<br><br>आलम्बित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಳ್ಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + लबि (अवस्रंसने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आलम्बिता नम्रमुखी भवत्या"<br><b>उल्लेखाः - </b>याद० १८-३<br><br>

आलम्बिन्
आलम्बिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೋಲಾಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>आ + लबि (अवस्रंसने) - "णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"देवसूतभुजालम्बी जैत्रमध्यास्त राघवः"<br><b>उल्लेखाः - </b>रघु० १२-८५<br><br>आलम्बिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧರಿಸಿರುವ<br><b>प्रयोगाः - </b>"गजाजिनालम्बि दुकूलधारि वा"<br><b>उल्लेखाः - </b>कुमा० ५-७८<br><br>आलम्बिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ ಕೊಡುವ<br><br>

आलम्भ
आलम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಪರ್ಶ /ಮುಟ್ಟುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + डुलभष् (प्राप्तौ) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"स्त्रीणां च प्रेक्षणालम्भमुपघातं परस्य च "<br><b>उल्लेखाः - </b>मनु० २-१७९<br><br>आलम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸೆ /ಪೀಡಿಸುವಿಕೆ<br><b>प्रयोगाः - </b>"आलभ्यसमये तस्मिन् गृहीतेषु पशुष्वथ । महर्षयो महाभाग बभूवुः कृपयान्विताः ॥"<br><b>उल्लेखाः - </b>भा०<br><br>

आलम्भ्य
आलम्भ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + डुलभष् (प्राप्तौ) - "ण्यत्" (३-१-१२४) । नुम् (७-१-६५)<br><b>विस्तारः - </b>"आलभ्यो गौः" - सि० कौ० ।<br><br>

आलय
आलय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹ /ಮನೆ<br><b>निष्पत्तिः - </b>आ + लीङ् (संश्लेषणे) - "घः" (३-३-११८)<br><b>व्युत्पत्तिः - </b>आलीयन्तेऽत्र<br><b>प्रयोगाः - </b>"न हि दुष्टात्मनामार्या निवसन्त्यालये चिरम्"<br><b>उल्लेखाः - </b>रामा०<br><br>आलय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ /ಆಧಾರ<br><b>प्रयोगाः - </b>"अस्त्युत्तरस्यां दिशि देवतात्मा हिमालयो नाम नगाधिराजः"<br><b>उल्लेखाः - </b>कुमा० १-१<br><br>आलय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ<br><br>आलय<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಲಯಪರ್ಯಂತ /ಪ್ರಳಯಕಾಲದವರೆಗೆ<br><b>प्रयोगाः - </b>"पिबत भागवतं रसमालयम्"<br><b>उल्लेखाः - </b>भाग० १-१-३<br><br>

आलयविज्ञान
आलयविज्ञान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೌದ್ಧಮತದಲ್ಲಿ ನಾನು ಎಂಬ ಭಾವನೆಯಿಂದ ಆತ್ಮವೆನ್ನಲ್ಪಡುವ ಸೂಕ್ಷ್ಮಚಿತ್ತ<br><b>व्युत्पत्तिः - </b>आलयं लयपर्यन्तं स्थायि विज्ञानम्<br><b>प्रयोगाः - </b>"तत् स्यात् आलयविज्ञानं यद्भवेदहमास्पदम्"<br><b>उल्लेखाः - </b>स० द० सं०<br><br>

आलर्क
आलर्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಚ್ಚುನಾಯಿಯ ಸಂಬಂಧವಾದ ವಿಷ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>आलर्कस्येदम्<br><b>प्रयोगाः - </b>"आलर्कं विषमिव सर्वतः प्रवृत्तम्"<br><b>उल्लेखाः - </b>उ० रा० १-४०<br><br>

आलवाल
आलवाल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಿಡದ ಪಾತಿ /ಗಿಡದ ಕೆಳಗೆ ನೀರು ನಿಲ್ಲುವಂತೆ ಮಾಡಿರುವ ಗುಣಿ<br><b>निष्पत्तिः - </b>आ + ला (आदाने) - "कः" (वा० ३-२-५)<br><b>व्युत्पत्तिः - </b>आ समन्तात् जललवमालयति<br><b>प्रयोगाः - </b>"विश्वासाय विहङ्गानामालवालाम्बुपायिनाम्"<br><b>उल्लेखाः - </b>रघु० १-५१<br><br>

आलस
आलस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೋಮಾರಿ<br><b>निष्पत्तिः - </b>आ + लस (श्लेषणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आ लसति ईषत् व्याप्रियते<br><br>

आलस्य
आलस्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೋಮಾರಿತನ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>अलसस्य भावः<br><b>प्रयोगाः - </b>"शक्तस्य चाप्यनुत्साहः कर्मस्वालस्यमुच्यते"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>आलस्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೋಮಾರಿ<br><b>निष्पत्तिः - </b>अलस - स्वार्थे "ष्यञ्"<br><br>

आलान
आलान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯನ್ನು ಕಟ್ಟುವ ಕಂಬ<br><b>निष्पत्तिः - </b>आ + लीङ् (संश्लेषणे) - "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>आलीयतेऽत्र<br><b>प्रयोगाः - </b>"अरुन्तुदमिवालानमनिर्वाणस्य दन्तिनः"<br><b>उल्लेखाः - </b>रघु० १-७१<br><br>आलान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಧನ /ಕಟ್ಟಿ ಹಾಕುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + लीङ् (संश्लेषणे) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"गजालानपरिक्लिष्टैरक्षोटैः सार्धमानताः"<br><b>उल्लेखाः - </b>रघु० ४-६९<br><br>आलान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯನ್ನು ಕಟ್ಟುವ ಹಗ್ಗ<br><b>निष्पत्तिः - </b>आ + लीङ् (संश्लेषणे) - कर० "ल्युट्" (३-३-११७)<br><br>

आलानिक
आलानिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆನೆಯನ್ನು ಕಟ್ಟು ಹಾಕುವ ಕಂಬ<br><b>निष्पत्तिः - </b>"ठक्" (५-१-१०९)<br><b>व्युत्पत्तिः - </b>आलानं प्रयोजनमस्य<br><b>प्रयोगाः - </b>"सोढुं न तत्पूर्वमवर्णमीशे आलानिकं स्थाणुमिव द्विपेन्द्रः"<br><b>उल्लेखाः - </b>रघु० १४-३८<br><br>

आलाप
आलाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾತಾಡುವುದು<br><b>निष्पत्तिः - </b>आ + लप (व्यक्तायां वाचि) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"प्रकुर्वते वारिदरोधनिर्गताः परस्परालापमिवामला दिशः"<br><b>उल्लेखाः - </b>किरा० ४-३०<br><br>आलाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರಗಳನ್ನು ಸರಿಪಡಿಸಿಕೊಳ್ಳುವ ಸರಿಗಮ ಮೊದಲಾದ ಅಕ್ಷರ<br><b>निष्पत्तिः - </b>कर० "घञ्" (३-३-१२१)<br><b>प्रयोगाः - </b>"आलपकालसमपल्लविताङ्कवीणासौरभ्यपातिमधुपारवसङ्कुलस्य"<br><b>उल्लेखाः - </b>चं० भा०<br><br>आलाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಸ್ಪರ ಮಾತಾಡುವುದು<br><b>निष्पत्तिः - </b>आ + लप (व्यक्तायां वाचि) + णिच् - "अच्" (३-१-१३४)<br><b>प्रयोगाः - </b>"अये, दक्षिणेन वृक्षवाटिकामालाप इव श्रूयते"<br><b>उल्लेखाः - </b>शाकु० १<br><br>

आलापन
आलापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಸ್ಪರ ಮಾತಾಡುವುದು<br><b>निष्पत्तिः - </b>आ + लप (व्यक्तायां वाचि) + णिच् - "ल्युट्" (३-३-११५)<br><br>आलापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾತಾಡುವುದು /ಹೇಳುವುದು<br><b>प्रयोगाः - </b>"नाथेति नागशयनेति जगन्निवासेत्यालापनं प्रतिपदं कुरु मे मुकुन्द"<br><b>उल्लेखाः - </b>मु० मा० १<br><br>आलापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಸ್ತಿವಾಚನ<br><br>आलापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಗವನ್ನು ವಿಸ್ತರಿಸುವ ಸರಿಗಮಾದಿ ಅಕ್ಷರಗಳ ಗುಂಪು<br><br>

आलाप्य
आलाप्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + लप (व्यक्तायां वाचि) - "ण्यत्" (३-१-१२४)<br><br>आलाप्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲು ಯೋಗ್ಯವಾದ<br><br>आलाप्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮಾತನಾಡಿಸಿ<br><br>

आलावर्त
आलावर्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಟ್ಟೆಯಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ ಬೀಸಣಿಗೆ<br><b>निष्पत्तिः - </b>आ + वृतु (वर्तने) + णिच् - कर्म० "अच्" (३-३-५६)<br><b>व्युत्पत्तिः - </b>आलं पर्याप्तमावर्त्यते<br><b>विस्तारः - </b>"व्यजनं तालवृन्तं तत् धवित्रं मृगचर्मणः । आलावर्तं तु वस्त्रस्य" - अभि० चि० ।<br><br>

आलास्य
आलास्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಸಳೆ<br><b>व्युत्पत्तिः - </b>आलं अधिकं आस्यं यस्य<br><b>विस्तारः - </b>"नक्रः कुम्भीर आलास्यः" - अभि० चि० ।<br><br>

आलि
आलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಶ್ಚಿಕ /ಚೇಳು<br><b>निष्पत्तिः - </b>आ + अल (भूषणादौ) - "इन्" (उ० ४-११८)<br><b>व्युत्पत्तिः - </b>आलति दंशे समर्थो भवति<br><br>आलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭ್ರಮರ /ದುಂಬಿ<br><b>प्रयोगाः - </b>"लीनालिः सुरकरिणां कपोलकाषः"<br><b>उल्लेखाः - </b>किरा० ५-२६<br><br>आलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ<br><br>आलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಖಿ /ಗೆಳತಿ<br><b>निष्पत्तिः - </b>आ + अल (भूषणादौ) + णिच् - "इन्" (उ० ४-११८)<br><b>व्युत्पत्तिः - </b>आलयति भूषयति<br><b>प्रयोगाः - </b>"निवार्यतामालि किमप्ययं वटुः"<br><b>उल्लेखाः - </b>कुमा० ५-८३<br><br>आलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೇತುವೆ /ಅಣೆಕಟ್ಟು<br><b>व्युत्पत्तिः - </b>आलयति च्वारयति जलम्<br><b>विस्तारः - </b>"सेतौ पाल्यालिसंवाराः" - अभि० चि० ।<br><br>आलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಂಕ್ತಿ /ಸಾಲು<br><b>प्रयोगाः - </b>"तोयान्तर्भास्करालीव रेजे मुनिपरम्परा"<br><b>उल्लेखाः - </b>कुमा० ६-४९<br><br>आलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೇಖೆ /ಗೆರೆ<br><b>प्रयोगाः - </b>"विषमहरिचन्दनालिना"<br><b>उल्लेखाः - </b>माघ०<br><br>आलि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶುದ್ಧವಾದ ಮನಸ್ಸುಳ್ಳ<br><br>

आलिखत्
आलिखत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬರೆಯುವ<br><b>निष्पत्तिः - </b>आ + लिख (अक्षरविन्यासे) - "शतृ" (३-२-१२४)<br><br>आलिखत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಣ್ಣ ಬಳಿಯುವ<br><br>

आलिख्यमान
आलिख्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬರೆಯಲ್ಪಡುವ ಕಾಗದ<br><br>आलिख्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಣ್ಣ ಹಾಕಲ್ಪಡುವ ಚಿತ್ರ<br><b>निष्पत्तिः - </b>आ + लिख (अक्षरविन्यासे) - कर्म० "शानच्" (३-२-१२४)<br><br>

आलिलिखिषा
आलिलिखिषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬರೆಯುವ ಅಪೇಕ್ಷೆ<br><br>आलिलिखिषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಣ್ಣ ಹಾಕುವ ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>आ + लिख (अक्षरविन्यासे) + सन् - "अः" (३-३-१०२)<br><b>व्युत्पत्तिः - </b>आलिखितुमिच्छा<br><br>

आलिलिखिषु
आलिलिखिषु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬರೆಯುವ ಅಪೇಕ್ಷೆಯುಳ್ಳ<br><br>आलिलिखिषु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಣ್ಣ ಹಾಕುವ ಅಪೇಕ್ಷೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>आ + लिख (अक्षरविन्यासे) + सन् - "उः" (३-२-१६८)<br><b>व्युत्पत्तिः - </b>आलिखितुमिच्छुः<br><br>

आलिङ्गन
आलिङ्गन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ಪಿಕೊಳುವುದು<br><b>निष्पत्तिः - </b>आ + लिगि (गतौ) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"आलिङ्गनान्यधिकृताः स्फुटमापुरेव"<br><b>उल्लेखाः - </b>माघ० ५-१८<br><br>

आलिङ्गित
आलिङ्गित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಿಕೊಳ್ಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + लिगि (गतौ) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"इत्यालिङ्गितमालोक्य जयलक्ष्म्या झषध्वजम्"<br><b>उल्लेखाः - </b>माघ० १९-२४<br><br>

आलिङ्गिन्
आलिङ्गिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಿಕೊಳ್ಳುವ<br><b>निष्पत्तिः - </b>आ + लिगि (गतौ) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आलिङ्गते<br><br>

आलिङ्ग्य
आलिङ्ग्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೃದಂಗ /ಮದ್ದಳೆ<br><br>आलिङ्ग्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಲಿಂಗಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + लिगि (गतौ) - "ण्यत्" (३-१-१२४)<br><b>व्युत्पत्तिः - </b>आलिङ्ग्यते<br><br>आलिङ्ग्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಲಿಂಗಿಸಿಕೊಂಡು<br><b>निष्पत्तिः - </b>आ + लिगि (गतौ) - "ल्यप्" (७-१-३७)<br><b>प्रयोगाः - </b>"चतुरङ्गुलहीनोऽङ्क्यान्मुखे चैकाङ्गुलेन यः । यवाकृतिः स आलिङ्ग्य आलिङ्ग्य स हि जायते ॥"<br><br>

आलिञ्जर
आलिञ्जर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಣ್ಣಿನ ದೊಡ್ಡ ಪಾತ್ರೆ<br><b>निष्पत्तिः - </b>आलिञ्जर - स्वार्थे "अण्" (५-४-३८)<br><br>

आलिन्
आलिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಶ್ಚಿಕ /ಚೇಳು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>आलमस्यास्ति<br><br>

आलिन्द
आलिन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊರಬಾಗಿಲಿನ ಸಮೀಪದ ಕೈಸಾಲೆ<br><br>आलिन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆಯೊಳಗಿನ ಶಯನವೇದಿಕೆ<br><b>निष्पत्तिः - </b>स्वार्थे "अण्" (५-४-३८)<br><b>व्युत्पत्तिः - </b>आलिन्द एव<br><br>

आलिम्पन
आलिम्पन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೋಡೆಗೆ ಸುಣ್ಣ ಬಳಿಯುವುದು<br><br>आलिम्पन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ಕಿಯ ಹಿಟ್ಟನ್ನು ನೀರಿನಲ್ಲಿ ಕದಡಿ ನೆಲಕ್ಕೆ ರಂಗವಲ್ಲಿ ಹಾಕುವುದು<br><br>

आलीढ
आलीढ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೈನಿಕನು ಯುದ್ಧಮಾಡುವಾಗ ಬಲಗಾಲನ್ನು ಮುಂದಕ್ಕೆ ಇಟ್ಟು ಎಡಮಂಡಿಯನ್ನು ಊರಿಕೊಂಡು ನಿಲ್ಲುವ ರೀತಿ<br><b>निष्पत्तिः - </b>आ + लिह (आस्वादने) - भावे "क्तः" (३-३-११४)<br><b>प्रयोगाः - </b>"अतिष्ठदालीढविशेषशोभिना वपुःप्रकर्षेण विडम्बितेश्वरः"<br><b>उल्लेखाः - </b>रघु० ३-५२<br><br>आलीढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ರುಚಿ ನೋಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + लिह (आस्वादने) - कर्म० "क्तः" (३-२-१०२)<br><br>आलीढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಾಯಗೊಳಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"सेनान्यमालीढमिवासुरास्त्रैः"<br><b>उल्लेखाः - </b>रघु० २-३७<br><br>

आलीढक
आलीढक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಕರುಗಳ ಆಟ<br><br>

आलीन
आलीन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಗರ /ತವರ<br><br>आलीन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ<br><b>निष्पत्तिः - </b>आ + लीङ् (श्लेषणे) - "क्तः" (३-३-११४)<br><br>आलीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಿಕೊಳಲ್ಪಟ್ಟ<br><br>आलीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಳಿಯಲ್ಪಟ್ಟ<br><br>आलीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಪ್ತವಾದ<br><b>प्रयोगाः - </b>"स निर्विश्य यथाकामं तटेष्वालीनचन्दनौ"<br><b>उल्लेखाः - </b>रघु० ४-५१<br><br>

आलु
आलु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೂಬೆ<br><br>आलु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಿಂಡಿ /ಕೊಳವೆಯಿರುವ ನೀರಿನ ಚೊಂಬು<br><br>आलु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೆಪ್ಪ /ಹರಿಗೋಲು<br><br>आलु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಲೂಗೆಡ್ಡೆ<br><b>निष्पत्तिः - </b>आ + ला (आदाने) - "डुः" (वा० ३-२-१८०)<br><b>विस्तारः - </b>"आलुर्गलन्तिकायां स्त्री क्लीबं मूले च भेलके" - मेदि० ।<br><br>

आलुक
आलुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆದಿಶೇಷ<br><br>आलुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿಮರ<br><b>निष्पत्तिः - </b>आलु - सञ्ज्ञायां "कन्"<br><br>आलुक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಲೂಗೆಡ್ಡೆ<br><b>निष्पत्तिः - </b>आलु - स्वार्थे "कन्"<br><br>

आलुञ्चन
आलुञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹರಿಯುವುದು<br><br>आलुञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೆಗೆದು ಹಾಕುವುದು<br><b>निष्पत्तिः - </b>आ + लुञ्च (अपनयने) - "ल्युट्" (३-३-११५)<br><br>आलुञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಚ್ಚುವುದು<br><br>

आलुञ्चित
आलुञ्चित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿತ್ತು ಹಾಕಲ್ಪಟ್ಟ<br><br>आलुञ्चित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಿಯಲ್ಪಟ್ಟ<br><br>आलुञ्चित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಸರಲ್ಪಟ್ಟ /ಗಂಟು ಬಿಚ್ಚಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + लुञ्च (अपनयने) -"क्तः" (३-२-१०२)<br><br>

आलुण्टन
आलुण्टन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೋಚಿಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>आ + लुठि (स्तेये) - "ल्युट्" (३-३-११५)<br><br>

आलू
आलू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>आलु ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>आ + लूञ् (छेदने) - "क्विप्" (३-२-७६)<br><br>

आलून
आलून<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಕತ್ತರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + लूञ् (छेदने) - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>आ ईषत् लूनम्<br><br>आलून<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಕತ್ತರಿಸಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>आ सम्यक् लूनम्<br><b>प्रयोगाः - </b>"तेनामरवधूहस्तसदयालूनपल्लवाः"<br><b>उल्लेखाः - </b>कुमा० २-४१<br><br>

आलेख
आलेख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪತ್ರ /ಕಾಗದ<br><b>निष्पत्तिः - </b>आ + लिख (अक्षरविन्यासे) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>आलिख्यतेऽत्र<br><br>आलेख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಸ್ತೈವೇಜು<br><br>आलेख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬರವಣಿಗೆ<br><b>निष्पत्तिः - </b>आ + लिख (अक्षरविन्यासे) - भावे "घञ्" (३-३-१८)<br><br>

आलेखन
आलेखन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗು ಬರೆಯುವುದು<br><br>आलेखन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರಗಳಿಗೆ ಬಣ್ಣ ಹಾಕುವುದು<br><b>निष्पत्तिः - </b>आ + लिख (अक्षरविन्यासे) - "ल्युट्" (३-३-११५)<br><br>आलेखन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬರೆಯುವವನು<br><br>आलेखन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರಕ್ಕೆ ಬಣ್ಣ ಹಾಕುವವನು<br><b>निष्पत्तिः - </b>आ + लिख (अक्षरविन्यासे) - कर्त० "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आलिखति<br><br>

आलेखनी
आलेखनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬರೆಯುವ ಸಾಧನ /ಲೇಖನಿ<br><br>आलेखनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರಗಳಿಗೆ ಬಣ್ಣ ಹಾಕುವ ಕುಂಚ<br><b>निष्पत्तिः - </b>आ + लिख (अक्षरविन्यासे) - कर० "ल्युट्" (३-३-११७)<br><br>

आलेख्य
आलेख्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರ<br><b>निष्पत्तिः - </b>आ + लिख (अक्षरविन्यासे) - "ण्यत्" (३-१-१२४)<br><b>प्रयोगाः - </b>"इति संरम्भिणो वाणीर्बलस्यालेख्यदेवताः"<br><b>उल्लेखाः - </b>माघ० २-६७<br><br>आलेख्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬರೆಯಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + लिख (अक्षरविन्यासे) - कर्म० "ण्यत्" (३-१-१२४)<br><br>

आलेख्यशेष
आलेख्यशेष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರದಲ್ಲಿ ಮಾತ್ರ ಉಳಿದಿರುವ<br><b>व्युत्पत्तिः - </b>आलेख्यमेव शेषो यस्य<br><b>प्रयोगाः - </b>"आलेख्यशेषस्य पितुर्विवेश"<br><b>उल्लेखाः - </b>रघु० १४-१५<br><br>

आलेप
आलेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಳಿಯುವುದು /ಪೂಸುವುದು<br><br>आलेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ಕಿಹಿಟ್ಟನ್ನು ಕದಡಿ ನೆಲಕ್ಕೆ ರಂಗವಲ್ಲಿ ಹಾಕುವುದು<br><br>आलेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೆಲವನ್ನು ಸಗಣಿಯಿಂದ ಸಾರಿಸುವುದು<br><b>निष्पत्तिः - </b>आ + लिप (उपदेहे) - भावे "घञ्" (३-३-१८)<br><br>आलेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಲಾಮು<br><b>निष्पत्तिः - </b>आ + लिप (उपदेहे) - कर० "घञ्" (३-३-१२१)<br><br>

आलोक
आलोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶ /ಬೆಳಕು<br><b>निष्पत्तिः - </b>आ + लोकृ (दर्शने) - कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>आलोक्यतेऽनेन<br><b>प्रयोगाः - </b>"असारं संसारं परिमुषितरत्नं त्रिभुवनं निरालोकं लोकं मरणशरणं बान्धवजनम्"<br><b>उल्लेखाः - </b>मालती० ५-३०<br><br>आलोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೋಟ /ದರ್ಶನ<br><b>निष्पत्तिः - </b>आ + लोकृ (दर्शने) - भावे "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"यदालोके सूक्ष्मं व्रजति सहसा तदिपुलताम्"<br><b>उल्लेखाः - </b>शाकु० १-९<br><br>आलोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಯಶಬ್ದ /ಹೊಗಳಿಕೆ<br><b>प्रयोगाः - </b>"ययावुदीरितालोकः सुधर्मानवमां सभाम्"<br><b>उल्लेखाः - </b>रघु० १७-२७<br><br>

आलोकन
आलोकन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೋಟ /ದರ್ಶನ<br><b>निष्पत्तिः - </b>आ + लोकृ (दर्शने) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"ततः स सम्प्रेक्ष्य शरद्गुणश्रियं शरद्गुणालोकनलोलचक्षुषा"<br><b>उल्लेखाः - </b>किरा० ४-२०<br><br>

आलोकनीय
आलोकनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡಲು ಯೋಗ್ಯವಾದ /ಸುಂದರವಾದ<br><b>निष्पत्तिः - </b>आ + लोकृ (दर्शने) - "अनीयर्" (३-१-९६)<br><br>

आलोकनीयता
आलोकनीयता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೋಡಲು ಯೋಗ್ಯವಾದ /ಸುಂದರವಾದ<br><b>निष्पत्तिः - </b>भावे "तल्" (५-१-११९)<br><b>प्रयोगाः - </b>"चित्रन्यस्ता इव गताः प्रकामालोकनीयताम्"<br><b>उल्लेखाः - </b>कुमा० २-२४<br><br>

आलोकमान
आलोकमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>आ + लोकृ (दर्शने) - "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"आलोकमाना वरलोकलक्ष्मीं तात्कालिकीमप्सरसो रसोत्काः"<br><b>उल्लेखाः - </b>नैष० १०-५५<br><br>

आलोकयत्
आलोकयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>आ + लोकृ (दर्शने) + णिच् - "शतृ" (३-२-१२४)<br><br>

आलोकित
आलोकित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೋಟ /ದರ್ಶನ<br><b>निष्पत्तिः - </b>आ + लोकृ (दर्शने) - भावे "क्तः" (३-३-११४)<br><b>प्रयोगाः - </b>"विविधमहमभूवं पात्रमालोकितानाम्"<br><b>उल्लेखाः - </b>मालती० १-३०<br><br>आलोकित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + लोकृ (दर्शने) - कर्म० "क्तः" (३-२-१०२)<br><br>

आलोकितवत्
आलोकितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡಿದ<br><b>निष्पत्तिः - </b>आ + लोकृ (दर्शने) - "क्तवतुः" (३-२-१०२)<br><br>

आलोकितवती
आलोकितवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೋಡಿದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

आलोकितृ
आलोकितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡುವ<br><b>निष्पत्तिः - </b>आ + लोकृ (दर्शने) - "तृच्" (३-१-१३३)<br><br>

आलोक्य
आलोक्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>आ + लोकृ (दर्शने) - "ण्यत्" (३-१-१२४)<br><br>आलोक्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನೋಡಿ /ದರ್ಶನ ಮಾಡಿ<br><b>निष्पत्तिः - </b>आ + लोकृ (दर्शने) - "ल्यप्" (७-१-३७)<br><b>प्रयोगाः - </b>"आलोक्य व्यवदधतं पुरो मयूरम्"<br><b>उल्लेखाः - </b>माघ० ८-११<br><br>

आलोक्यमान
आलोक्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + लोकृ (दर्शने) - कर्म० "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"अयं कथं स्यादिति बाष्पगर्भमालोक्यमानो वनदेवताभिः"<br><b>उल्लेखाः - </b>चं० रा<br><br>

आलोचक
आलोचक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಲೋಚನೆ ಮಾಡುವ<br><b>निष्पत्तिः - </b>आ + लोचृ (दर्शने) + णिच् - "ण्वुल्" (३-१-१३३)<br><br>

आलोचन
आलोचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಲೋಚನೆ /ವಿಚಾರ<br><br>आलोचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮನನ /ಧ್ಯಾನ<br><b>निष्पत्तिः - </b>आ + लोचृ (दर्शने) - "ल्युट्" (३-३-११५)<br><br>आलोचन<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಲೋಚನಪರ್ಯಂತ<br><b>व्युत्पत्तिः - </b>लोचनमभिव्याप्य<br><b>प्रयोगाः - </b>"आलोचनान्तं श्रवणे वितत्य"<br><b>उल्लेखाः - </b>कुमा० ७-८४<br><br>

आलोचना
आलोचना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೋಟ /ದರ್ಶನ<br><br>

आलोचयत्
आलोचयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯೋಚಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>आ + लोचृ (दर्शने) + णिच् - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"आलोचयन्तो विस्तारमम्भसां दक्षिणोदधेः"<br><b>उल्लेखाः - </b>भट्टि० ७-४०<br><br>

आलोचित
आलोचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಚಾರ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + लोचृ (दर्शने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"असंशयालोचितकार्यनुन्नः"<br><b>उल्लेखाः - </b>किरा० ३-३३<br><br>

आलोचितवत्
आलोचितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿವೇಚನೆ ಮಾಡಿದ<br><b>निष्पत्तिः - </b>आ + लोचृ (दर्शने) - "क्तवतुः" (३-२-१०२)<br><br>

आलोचितवती
आलोचितवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವೇಚನೆ ಮಾಡಿದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

आलोचितृ
आलोचितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಚಾರ ಮಾಡಿ<br><b>निष्पत्तिः - </b>आ + लोचृ (दर्शने) - "तृच्" (३-१-१३३)<br><br>

आलोच्य
आलोच्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಲೋಚಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + लोचृ (दर्शने) + णिच् - "ण्यत्" (३-१-१२४)<br><br>आलोच्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿವೇಚನೆ ಮಾಡಿ<br><b>निष्पत्तिः - </b>आ + लोचृ (दर्शने) - "ल्यप्" (७-१-३७)<br><br>

आलोडन
आलोडन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲಕುವುದು<br><b>निष्पत्तिः - </b>आ + लुड (विलोडने) - "ल्युट्" (३-३-११५)<br><br>आलोडन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆರಸುವುದು<br><br>

आलोडित
आलोडित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಲಕಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + लुड (विलोडने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अतिभैरवारवभ्रमितवारिसञ्चयमायतमपि तत्सरः समन्तादालोडितम्"<br><b>उल्लेखाः - </b>वेणी० ६<br><br>आलोडित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆರೆಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"आलोडिताः काञ्चनभूपरागाः"<br><b>उल्लेखाः - </b>माघ० ३-२७<br><br>

आलोल
आलोल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಚಂಚಲವಾದ<br><b>व्युत्पत्तिः - </b>आ ईषत् लोलः<br><b>प्रयोगाः - </b>"आलोलपादपलतान्तरनिर्गतानाम्"<br><b>उल्लेखाः - </b>किरा० ५-४१<br><br>

आलोलित
आलोलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಅಲುಗಾಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + लुल (विमर्दने) + णिच् - "क्तः" (३-२-१०२)<br><br>

आलोलितवत्
आलोलितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಅಲುಗಾಡಿಸಿದ<br><b>निष्पत्तिः - </b>आ + लुल (विमर्दने) + णिच् - "क्तवतुः" (३-२-१०२)<br><br>

आवनेय
आवनेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗಾರಕ /ಕುಜಗ್ರಹ<br><b>निष्पत्तिः - </b>"ढक्" (४-१-१२०)<br><b>व्युत्पत्तिः - </b>अवन्त्याः भूमेरपत्यम्<br><br>

आवपन
आवपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿಯಲ್ಲಿ ಬೀಜವನ್ನು ಬಿತ್ತುವುದು<br><b>निष्पत्तिः - </b>आ + डुवप् (बीजसन्ताने) - "ल्युट्" (३-३-११५)<br><br>आवपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯವನ್ನು ಇಡುವ ಪಾತ್ರೆ<br><b>निष्पत्तिः - </b>अधि० "ल्युट्" (३-३-११७)<br><br>आवपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿತ್ತುವ ಕಾಳು /ಬೀಜ<br><br>आवपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹದಲ್ಲಿ ಸಹೋದರನು ಹೋಮಕ್ಕಾಗಿ ವಧುವಿನ ಕೈಯಲ್ಲಿ ಲಾಜವನು ಹಾಕುವುದು<br><br>आवपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೋಣಿಚೀಲ<br><b>निष्पत्तिः - </b>अधि० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>ओप्यते स्थाप्यते धान्यादिरत्र<br><br>आवपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಶಖಂಡನ<br><br>

आवरक
आवरक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಳ<br><b>निष्पत्तिः - </b>आ + वृञ् (वरणे) - "ण्वुल्" (३-१-१३३)<br><br>आवरक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರದೆ /ಮುಸುಕು<br><br>आवरक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚುವ /ಮರೆ ಮಾಡುವ<br><br>

आवरण
आवरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಚ್ಚುವುದು<br><b>निष्पत्तिः - </b>आ + वृञ् (वरणे) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"सूर्ये तपत्यावरणाय दृष्टेः कल्पेत लोकस्य कथं तमिस्रा"<br><b>उल्लेखाः - </b>रघु० ५-१३<br><br>आवरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಳ<br><b>निष्पत्तिः - </b>कर० "ल्युट्" (३-३-११७)<br><b>प्रयोगाः - </b>"उत्सृज्य कुसुमशयनं नलिनीदलकल्पितस्तनावरणम्"<br><b>उल्लेखाः - </b>शाकु० ३-१९<br><br>आवरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಜ್ಞಾನ<br><br>आवरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುರಾಣಿ /ಕತ್ತಿಯ ಏಟಿನಿಂದ ದೇಹವನ್ನು ರಕ್ಷಿಸುವ ಹಲಗೆ<br><br>आवरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಲಿ<br><b>प्रयोगाः - </b>"इह सिन्धवश्च वरणावरणाः करिणां मुदे सनलदानलदाः"<br><b>उल्लेखाः - </b>किरा० ५-२५<br><br>आवरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಡ್ಡಿ /ಆತಂಕ<br><b>प्रयोगाः - </b>"कालेनावरणात्ययात् परिणते यत्प्रेमसारे स्थितं भद्रं तस्य सुमानुषस्य कथमप्येकं हि तत्प्रार्थ्यते"<br><b>उल्लेखाः - </b>उ० रा० १-३९<br><br>

आवर्जन
आवर्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿಸುವುದು<br><br>आवर्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಡುವುದು /ದಾನ ಮಾಡುವುದು<br><br>आवर्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಡುವುದು<br><br>आवर्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಶಪಡಿಸಿಕೊಳ್ಳುವುದು<br><br>आवर्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪಾದಿಸಿ ಕೂಡಿಡುವುದು<br><b>निष्पत्तिः - </b>आ + वृजी (वर्जने) - "ल्युट्" (३-३-११५)<br><br>आवर्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುರಿಯುವುದು<br><br>

आवर्जित
आवर्जित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + वृजी (वर्जने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आवर्जिता किञ्चिदिव स्तनाभ्यां वासो वसाना तरुणार्करागम्"<br><b>उल्लेखाः - </b>कुमा० ३-५४<br><br>आवर्जित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"मत्परं दुर्लभं मत्वा नूनमावर्जितं मया"<br><b>उल्लेखाः - </b>रघु० १-३७<br><br>आवर्जित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತ್ಯಾಗ ಮಾಡಲ್ಪಟ್ಟ<br><br>आवर्जित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಶಪಡಿಸಿಕೊಳ್ಳಲ್ಪಟ್ಟ<br><br>आवर्जित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಪಾದಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"चतुर्दिगावर्जितसम्भृतां यो मृत्पात्रशेषामकरोद्विभूतिम्"<br><b>उल्लेखाः - </b>रघु० ६-७६<br><br>आवर्जित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುರಿಯಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अपि त्वदावर्जितवारिसम्भृतं प्रवालमासामनुबन्धि वीरुधाम्"<br><b>उल्लेखाः - </b>कुमा० ५-३४<br><br>

आवर्जितवत्
आवर्जितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿಸಿದ<br><br>आवर्जितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಟ್ಟ /ದಾನ ಮಾಡಿದ<br><b>निष्पत्तिः - </b>आ + वृजी (वर्जने) - कर्त० "क्तवतुः" (३-२-१०२)<br><br>आवर्जितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತ್ಯಾಗ ಮಾಡಿದ<br><br>आवर्जितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಶಪಡಿಸಿಕೊಂಡ<br><br>आवर्जितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಪಾದಿಸಿದ<br><br>आवर्जितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುರಿದ<br><br>

आवर्जितवती
आवर्जितवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आवर्जितवत् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><b>प्रयोगाः - </b>"मरीचिमावर्जितवतीव श्लाघसे"<br><b>उल्लेखाः - </b>दशकु०<br><br>

आवर्त
आवर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನ ಸುಳಿ<br><b>प्रयोगाः - </b>"आवर्तगर्तसम्भ्रान्तविमानप्लवविप्लवा"<br><b>उल्लेखाः - </b>चं० रा०<br><br>आवर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಬೆನ್ನಿನ ಮೇಲಿನ ಸುಳಿ<br><br>आवर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುನರಾಲೋಚನೆ<br><br>आवर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನುಷ್ಯನ ದೇಹದಲ್ಲಿರುವ ಕೂದಲಿನ ಸುಳಿ<br><br>आवर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಶಯ /ಸಂದೇಹ<br><b>निष्पत्तिः - </b>आ + वृतु (वर्तने) + णिच् - कर्म० "अच्" (३-३-५६)<br><br>आवर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೋಹವನ್ನು ಕರಗಿಸುವುದು<br><br>आवर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಸಾರ<br><br>आवर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆವರ್ತವೆಂಬ ಒಂದು ಮೇಘ<br><br>आवर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿರುಗುವಿಕೆ<br><b>विस्तारः - </b>"आवर्तश्चिन्तने वारिभ्रमे चावर्तने पुमान्" - मेदि० ।<br><br>आवर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹದೊಳಗಿನ ಸುಳಿಯ ಆಕಾರದ ಒಂದು ನಾಡಿ<br><br>

आवर्तक
आवर्तक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆವರ್ತಕಎಂಬ ಒಂದು ಮೇಘ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><b>व्युत्पत्तिः - </b>आवर्त एव<br><b>प्रयोगाः - </b>"तदीयास्तोयदेष्वद्य पुष्करावर्तकादिषु"<br><b>उल्लेखाः - </b>कुमा० २-५०<br><br>आवर्तक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣಿನ ಹುಬ್ಬುಗಳ ಮೇಲಿನ ತಗ್ಗುಪ್ರದೇಶ<br><br>आवर्तक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನ ಸುಳಿ<br><br>आवर्तक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೂದಲಿನ ಸುಳಿ<br><br>आवर्तक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುತ್ತುವುದು<br><br>

आवर्तन
आवर्तन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>आ + वृतु (वर्तने) + णिच् - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आवर्तयति<br><b>प्रयोगाः - </b>"आवर्तनो निवृत्तात्मा"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"आवर्तनोऽसौ संसारचक्रस्यावर्तनान्मुहुः"<br><br>आवर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿರುಗುವುದು<br><br>आवर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಡೆಯುವುದು<br><br>आवर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರಗಿಸುವಿಕೆ<br><br>आवर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುನಃ ಪುನಃ ಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + वृतु (वर्तने) + णिच् - "ल्युट्" (३-३-११५)<br><br>आवर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಧ್ಯಾಹ್ನ ಕಾಲ /ನೆರಳು ಪಶ್ಚಿಮದಿಂದ ಪೂರ್ವದಿಕ್ಕಿಗೆ ತಿರುಗುವ ಸಮಯ<br><b>निष्पत्तिः - </b>आ + वृतु (वर्तने) + णिच् - अधि० "ल्युट्" (३-३-११७)<br><br>

आवर्तनी
आवर्तनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದರ್ವಿ<br><br>आवर्तनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಷೆ /ಮೂಸಿ<br><b>निष्पत्तिः - </b>आ + वृतु (वर्तने) + णिच् - कर० "ल्युट्" (३-३-११७) । "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>आवर्त्यतेऽनया<br><br>

आवर्तनीय
आवर्तनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರಗಿಸಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>आ + वृतु (वर्तने) + णिच् -<br><br>आवर्तनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಡೆಯಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + वृतु (वर्तने) + णिच् - "अनीयर्" (३-१-९६)<br><br>आवर्तनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಿಸಲ್ಪಡುವ<br><br>

आवर्तित
आवर्तित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರಗಿಸಲ್ಪಟ್ಟ<br><br>आवर्तित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಿಸಲ್ಪಟ್ಟ<br><br>आवर्तित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭ್ಯಾಸ ಮಾಡಲ್ಪಟ್ಟ<br><br>आवर्तित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಡೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + वृतु (वर्तने) + णिच् - "क्तः" (३-२-१०२)<br><br>

आवर्तिन्
आवर्तिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುನಃ ಪುನಃ ಸುತ್ತುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>आ + वृतु (वर्तने) + णिच् - "णिनिः" (३-२-७८)<br><b>प्रयोगाः - </b>"आब्रह्मभुवनाल्लोकाः पुनरावर्तिनोऽर्जुन"<br><b>उल्लेखाः - </b>गीता० ८-१६<br><br>आवर्तिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರಗಿಸುವ<br><br>आवर्तिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಡೆಯುವ<br><b>निष्पत्तिः - </b>आ + वृतु (वर्तने) + णिच् - "णिनिः" (३-१-१३४)<br><br>

आवर्तिनी
आवर्तिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आवर्तिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>आवर्तिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಲಮುರಿ ಗಿಡ<br><br>आवर्तिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಳಿಯ ಮಡು<br><br>

आवलि
आवलि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಂಕ್ತಿ /ಸಾಲು<br><b>निष्पत्तिः - </b>आ + वल (संवरणे) - "इन्" (उ० ४-११८)<br><b>व्युत्पत्तिः - </b>आवलते<br><b>प्रयोगाः - </b>"द्विजावलिव्याजनिशाकरांशुभिः"<br><b>उल्लेखाः - </b>माघ० १-२५<br><br>आवलि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಂಪರೆ<br><br>

आवली
आवली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आवलि ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>वा "ङीप्" (ग० ४-१-४५)<br><br>

आवलित
आवलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ತಿರುಗಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + वल (सज्चलने) - "क्तः" (३-२-१०२)<br><br>आवलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಚಲಿಸಿರುವ<br><br>आवलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣವಾಗಿ ಚಲಿಸಿರುವ<br><b>निष्पत्तिः - </b>कर्त० "क्तः" (३-४-७२)<br><br>

आवश्यक
आवश्यक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗತ್ಯ /ಅನಿವಾರ್ಯ ವಿಚಾರ<br><br>आवश्यक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಯತವಾದ<br><br>आवश्यक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗತ್ಯವಾಗಿ ಮಾಡಬೇಕಾದ<br><b>निष्पत्तिः - </b>"वुञ्" (५-१-१३३)<br><b>व्युत्पत्तिः - </b>अवश्यं भावः<br><br>

आवश्यपुत्र
आवश्यपुत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಗನು ಅಧೀನದಲ್ಲಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"वुञ्" (५-१-१३३)<br><b>व्युत्पत्तिः - </b>न वश्यः अवश्यः पुत्रः तस्य भावः<br><br>

आवसति
आवसति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧರಾತ್ರಿ /ಸಮರಾತ್ರಿ<br><b>व्युत्पत्तिः - </b>वसत्यत्र गृहे वसतिः रात्रिः आ समुअक् वसतिः<br><br>

आवसथ
आवसथ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸಸ್ಥಾನ /ಮನೆ<br><b>निष्पत्तिः - </b>आ + वस (निवासे) - "अथः" (उ० ३-११६)<br><b>प्रयोगाः - </b>"निवसन्नावसथे पराद्बहिः"<br><b>उल्लेखाः - </b>रघु० ८-७४<br><br>आवसथ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶ್ರಾಂತಿ ಸ್ಥಾನ<br><br>आवसथ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಾಮ /ಹಳ್ಳಿ<br><br>आवसथ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಮ /ತಪಸ್ವಿಗಳ ವಾಸಸ್ಥಳ<br><br>आवसथ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗಾಗ್ನಿಯನ್ನು ರಕ್ಷಿಸಿಡುವ ಸ್ಥಳ<br><br>

आवसथिक
आवसथिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆಯಲ್ಲಿ ವಾಸ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>"ष्ठल्" (४-४-७४)<br><b>व्युत्पत्तिः - </b>आवसथे गृहे वसति<br><br>

आवसथिकी
आवसथिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆಯಲ್ಲಿ ವಾಸ ಮಾಡುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीष्" (४-१-४१)<br><br>

आवसथ्य
आवसथ्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗಾಗ್ನಿ<br><br>आवसथ्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೌಕಿಕಾಗ್ನಿ<br><br>आवसथ्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಂಚಾಗ್ನಿಗಳಲ್ಲೊಂದು<br><b>निष्पत्तिः - </b>"यत्" (४-३-५४)<br><b>व्युत्पत्तिः - </b>आवसथस्यायम्<br><b>प्रयोगाः - </b>"आवसथ्याहवनीयौ दक्षिणाग्निस्तथैव च । अन्वाहार्यो गार्हपत्य इत्येते पञ्च वह्नयः ॥"<br><br>

आवसान
आवसान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗ್ರಾಮದ ಹೊರಗೆ ವಾಸ ಮಾಡುವ<br><b>निष्पत्तिः - </b>"अण्" (४-३-९०)<br><b>व्युत्पत्तिः - </b>अवसानमभिजनोऽस्य<br><br>

आवसित
आवसित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣದಲ್ಲಿ ರಾಶಿ ಹಾಕಿ ಸಿದ್ಧಪಡಿಸಿದ ಧಾನ್ಯ<br><b>निष्पत्तिः - </b>षो (अन्तकर्मणि) - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>आवसीयते<br><b>विस्तारः - </b>"ऋद्धमावसितं धान्यम्" - अम० ।<br><br>आवसित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಹಣ್ಣಾಗಿರುವ ಧಾನ್ಯ<br><br>आवसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರ್ಣಯಿಸಲ್ಪಟ್ಟ<br><br>आवसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಗಿಸಲ್ಪಟ್ಟ<br><br>

आवह
आवह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಪ್ತ ವಾಯುಗಳಲ್ಲೊಂದು<br><b>निष्पत्तिः - </b>आ + वह (प्रापणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आवहति आभिमुख्येन गच्छति<br><b>प्रयोगाः - </b>"आवहः प्रवहश्चैव विवहश्च समीरणः । परावहः संवहश्च उद्वहश्च महाबलः ॥"<br><b>उल्लेखाः - </b>हरिवं०<br><br>आवह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿಸುವ /ಸೇರಿಸುವ<br><b>निष्पत्तिः - </b>आ + वह (प्रापणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आवहयति प्रापयति<br><b>प्रयोगाः - </b>"क्लेशावहा भर्तृरलक्षणाहम्"<br><b>उल्लेखाः - </b>रघु० १४-५<br><br>

आवाप
आवाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೀಜವನ್ನು ಬಿತ್ತುವುದು<br><b>निष्पत्तिः - </b>आ + डुवप् (बीजसन्ताने) - "घञ्" (३-३-१८)<br><br>आवाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಿಡದ ಪಾತಿ<br><b>निष्पत्तिः - </b>आ + डुवप् (बीजसन्ताने) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>आवपन्ति जलमत्र<br><br>आवाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯವನ್ನು ಇಡುವ ಪಾತ್ರೆ<br><br>आवाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರುರಾಷ್ಟ್ರದ ಚಿಂತೆ<br><b>प्रयोगाः - </b>"तन्त्रावापविदा योगैर्मण्डलान्यधितिष्ठिता"<br><b>उल्लेखाः - </b>माघ० २-८८<br><br>आवाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಧಾನ ಹೋಮ<br><br>आवाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಳೆ /ಕಡಗ<br><b>विस्तारः - </b>"कटको वलयं पारिहार्यावापौ च कङ्कणम्" - अभि० चि० ।<br><br>आवाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕ್ಷೇಪಣೆ<br><br>आवाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಳ್ಳತಿಟ್ಟಾದ ಪ್ರದೇಶ<br><br>आवाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕ್ಷೇಪ<br><br>

आवापक
आवापक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಳೆ /ಕಡಗ<br><b>निष्पत्तिः - </b>आ + डुवप् (बीजसन्ताने) - "घञ्" (३-३-१९) । सञ्ज्ञायां "कन्" (५-३-७५)<br><b>व्युत्पत्तिः - </b>आ उप्यते<br><br>आवापक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೀಜವನ್ನು ಬಿತ್ತುವವನು<br><br>आवापक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಪಿತ<br><br>

आवापन
आवापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಗ್ಗ<br><br>आवापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೂಲು ಸುತ್ತುವ ಕಂಡಿಕೆ<br><b>निष्पत्तिः - </b>आ + डुवप् (बीजसन्ताने) - कर० "ल्युट्" (३-३-११७)<br><br>आवापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಶಖಂಡನ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

आवाल
आवाल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಿಡದ ಪಾತಿ<br><b>निष्पत्तिः - </b>आ + वल (सञ्चलने) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>आवलतेऽम्भोऽत्र<br><b>विस्तारः - </b>"स्यादालवालमावाल्म्" - अम० ।<br><br>

आवास
आवास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆ /ವಾಸಗೃಹ<br><b>निष्पत्तिः - </b>आ + वस (निवासे) - "घञ्" (३-३-१२१)<br><b>प्रयोगाः - </b>"आवासो लयनं मनोहरमभिप्रायानुरूपा वणिङ्नार्यो वाञ्छितकालमिष्टमशनं शय्या मृदुप्रस्तराः"<br><b>उल्लेखाः - </b>प्रबोध० ३-९<br><br>आवास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಣೆ /ಕೊಠಡಿ<br><br>

आवाहन
आवाहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆಗಳು ವಿಗ್ರಹ ಮೊದಲಾದುವುಗಳಲ್ಲಿ ಸನ್ನಿಹಿತರಾಗಲು ಕರೆಯುವುದು<br><b>निष्पत्तिः - </b>आ + वह (प्रापणे) + णिच् - "ल्युट्" (३-३-११५)<br><br>आवाहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>೧೬ ವಿಧ ಉಪಚಾರಗಳಲ್ಲೊಂದು<br><br>

आवाहनी
आवाहनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆಗಳ ಪ್ರಾರ್ಥನೆಗಾಗಿ ಮಾಡುವ ಹಸ್ತಮುದ್ರೆ<br><b>विस्तारः - </b>"हस्ताभ्यामञ्जलिबद्ध्वाऽनामिकामूलपर्वणोः । अङ्गुष्ठौ निक्षिपेद्यत्र मुद्रा साऽवहनी स्मृता ॥"<br><br>

आविक
आविक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಬಳಿ /ಉಣ್ಣೆಯಿಂದ ಮಾಡಿದ ಬಟ್ಟೆ<br><b>निष्पत्तिः - </b>"ठक्" (५-१-७९)<br><b>व्युत्पत्तिः - </b>अविना तल्लोम्ना निर्वृत्तम्<br><br>आविक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಷ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>अवि - स्वार्थे "कः" । "अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>अविकस्येदम्<br><br>

आविकसौत्रिक
आविकसौत्रिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಣ್ಣೆಯ ದಾರದಿಂದ ತಯಾರಾದ<br><b>निष्पत्तिः - </b>"ठक्" (५-१-७९)<br><b>व्युत्पत्तिः - </b>आविकसूत्रेण निर्वृत्तम्<br><br>

आविग्न
आविग्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಷ್ಟಕ್ಕೊಳಗಾದ /ತೊಂದರೆ ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + ओविजी (भयचलनयोः) - "क्तः" (३-४-७२)<br><br>

आविद्ध
आविद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಟಿಲವಾದ<br><b>निष्पत्तिः - </b>आ + व्यध (ताडने) - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>आविध्यते स्म<br><br>आविद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಡೆಯಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"पादपाविद्धपरिधः शिलानिष्पिष्टमुद्गरः"<br><b>उल्लेखाः - </b>रघु० १२-७३<br><br>आविद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೇರಿಸಲ್ಪಟ್ಟ<br><br>आविद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊರೆಯಲ್ಪಟ್ಟ<br><br>आविद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಸೆಯಲ್ಪಟ್ಟ<br><br>

आविध
आविध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಳಿ /ರಂಪಿಗೆ<br><br>आविध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೈರಿಗೆ<br><b>निष्पत्तिः - </b>आ + व्यध (ताडने) - "कः" (वा० ३-३-५८)<br><b>व्युत्पत्तिः - </b>आविध्यतेऽनेन<br><br>

आविर्भवत्
आविर्भवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಟ್ಟುವ /ಮೈದೋರುವ<br><b>निष्पत्तिः - </b>आविस् + भू (सत्तायाम्) - "शतृ" (३-२-१२४)<br><br>

आविर्भवन्ती
आविर्भवन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹುಟ್ಟುವ /ಮೈದೋರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><b>प्रयोगाः - </b>"आविर्भवन्ती प्रथमं प्रियायाः सोच्छ्वासमन्तःकरणं करोति"<br><b>उल्लेखाः - </b>मालती० ३-४<br><br>

आविर्भाव
आविर्भाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿ /ಕಾಣಿಸಿಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>आविस् + भू (सत्तायाम्) - "घञ्" (३-३-१८)<br><br>आविर्भाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆಗಳು ಮನುಷ್ಯ ರೂಪದಿಂದ ಅವತರಿಸುವಿಕೆ<br><br>आविर्भाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವ್ಯಕ್ತಿ /ಅಸ್ಪಷ್ಟವಾಗಿದ್ದು ಸ್ಪಷ್ಟವಾಗಿ ಕಾಣಿಸಿಕೊಳ್ಳುವಿಕೆ<br><br>

आविर्भूत
आविर्भूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಣಿಸಿಕೊಂಡ<br><br>आविर्भूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶ ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>आविस् + भू (सत्तायाम्) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"आविर्भूतमपां मध्ये पारिजातमिवापरम्"<br><b>उल्लेखाः - </b>रघु० १-११<br><br>

आविल
आविल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಲುಷವಾದ /ಬಗ್ಗಡವಾದ<br><b>प्रयोगाः - </b>"पङ्किच्छिदः फलस्येव निकषेणाविलं पयः"<br><b>उल्लेखाः - </b>माल० २-८<br><br>आविल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶುದ್ಧವಲ್ಲದ /ಮಲಿನವಾದ<br><b>प्रयोगाः - </b>"स्रजं न काचिद्विजहौ जलाविलाम्"<br><b>उल्लेखाः - </b>किरा० ८-३७<br><br>

आविष्करण
आविष्करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೋರಿಕೆ /ಕಾಣಿಸಿಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>आविस् + डुकृञ् (करणे) - "ल्युट्" (३-३-११५)<br><br>आविष्करण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸುವ ಸಾಧನ<br><b>निष्पत्तिः - </b>आविस् + डुकृञ् (करणे) - "ल्युट्" (३-३-११७)<br><br>

आविष्करणी
आविष्करणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आविष्करण ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

आविष्कर्तृ
आविष्कर्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸುವವನು<br><b>निष्पत्तिः - </b>आविस् + डुकृञ् (करणे) - "तृच्" (३-१-१३३)<br><br>

आविष्कत्री
आविष्कत्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आविष्कार
आविष्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೋರಿಕೆ /ಕಾಣಿಸಿಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>आविस् + डुकृञ् (करणे) - "घञ्" (३-३-१८)<br><br>

आविष्कृत
आविष्कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आविस् + डुकृञ् (करणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अथ चेदवधिः प्रतीक्ष्यते कथमाविष्कृतजिह्मवृत्तिना"<br><b>उल्लेखाः - </b>किरा० २-१६<br><br>

आविष्ट
आविष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೂತದ ಆವೇಶವುಳ್ಳ<br><br>आविष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + विश (प्रवेशने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आविष्टशङ्कासुरसन्निवेशम्"<br><b>उल्लेखाः - </b>याद० १८-१०९<br><br>आविष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತತ್ಪರನಾದ /ಆಸಕ್ತನಾದ<br><br>आविष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಪ್ತವಾದ<br><b>निष्पत्तिः - </b>आ + विष्लृ (व्याप्तौ) - "क्तः" (३-२-१०२)<br><br>

आविस्
आविस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕಾಣಬರುವುದು<br><b>प्रयोगाः - </b>"आचार्यकं विजयि मान्मथमाविरासीत्"<br><b>उल्लेखाः - </b>मालती० १-२६<br><br>

आवी
आवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಜಸ್ವಲೆ /ಋತುಮತಿಯಾದ<br><b>निष्पत्तिः - </b>अवि स्वार्थे "अण्" (५-४-३८)<br><br>आवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ಭಿಣಿ /ಗರ್ಭ ಧರಿಸಿದ ಹೆಂಗಸು<br><b>प्रयोगाः - </b>"गर्भस्पन्दनमावीनां प्रणाशः श्यावपाण्डुता"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

आवीत
आवीत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಚೀನಾವೀತ /ಬಲತೋಳಿನ ಮೇಲೂ ಎಡತೋಳಿನ ಕೆಳಗೂ ಇರುವಂತೆ ಧರಿಸಲ್ಪಡುವ ಯಜ್ಞೋಪವೀತ<br><br>

आवीतिन्
आवीतिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಜ್ಞೋಪವೀತವನ್ನು ಎಡತೋಳಿನ ಕೆಳಗೆ ಹಾಕಿಕೊಂಡಿರುವವನು<br><b>प्रयोगाः - </b>"उद्धृते दक्षिणे प्राणाव्य्पवीत्युच्यते बुधैः । सव्ये प्राचीन आवीती निवीती कण्ठलम्बिते ॥"<br><b>उल्लेखाः - </b>मनु० २-६३<br><br>

आवुक
आवुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಂದೆ<br><b>निष्पत्तिः - </b>अव (रक्षणे) - "उकण्" बाहु० ।<br><b>व्युत्पत्तिः - </b>अवति<br><br>

आवुत्त
आवुत्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಾವ /ಸಹೋದರಿಯ ಗಂಡ<br><br>

आवृत्
आवृत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಕ್ರಮ /ಪರ್ಯಾಯ<br><br>आवृत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುನಃ ಪುನಃ ಮಾಡುವುದು<br><br>आवृत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸುತ್ತುತ್ತಿರುವುದು<br><br>आवृत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತೆ ಮತ್ತೆ ಆಡಿಸುವುದು<br><br>आवृत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂತಿರುಗುವುದು<br><br>आवृत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಸ್ಕಾರ<br><br>आवृत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದವಿಲ್ಲದೆ ಸುಮ್ಮನಿರುವಿಕೆ<br><br>

आवृत
आवृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + वृञ् (वरणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आवृतान्यपि निरन्तरमुच्चैर्योषितामुरसिजद्वितयेन"<br><b>उल्लेखाः - </b>माघ० १०-५६<br><br>आवृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುತ್ತುವರೆಯಲ್ಪಟ್ಟ<br><br>आवृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಿಶ್ರ ಜಾತಿಯವನು<br><b>प्रयोगाः - </b>"ब्राह्मणादुग्रकन्यायामावृतो नाम जायते"<br><b>उल्लेखाः - </b>मनु० १०-१५<br><br>

आवृति
आवृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आवरण ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>आ + वृञ् (वरणे) - "क्तिन्" (३-३-९४)<br><br>आवृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಲಿ<br><br>

आवृत्त
आवृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರುಗಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + वृतु (वर्तने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आवृत्तवृन्तशतपत्रनिभं वहन्त्या"<br><b>उल्लेखाः - </b>मालती० १-३२<br><br>आवृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುನಃ ಪುನಃ ಅಭ್ಯಾಸ ಮಾಡಲ್ಪಟ್ಟ<br><br>आवृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುನಃ ಪುನಃ ಓದಲ್ಪಟ್ಟ<br><br>आवृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂದಿರುಗಿದ<br><br>

आवृत्ति
आवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಡಿದ್ದನ್ನೇ ಮತ್ತೆ ಮಾಡುವುದು<br><br>आवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಓದುದ್ದನ್ನೇ ಮತ್ತೆ ಓದುವುದು<br><br>आवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂದಿರುಗುವಿಕೆ<br><br>आवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸುತ್ತುವಿಕೆ<br><br>आवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಿರುಗಿ ಬರುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + वृतु (वर्तने) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"संस्कारक्वाणदीर्घं पटु रटति कृतावृत्ति खट्वाङ्गघण्टा"<br><b>उल्लेखाः - </b>मालती० ५-४<br><br>

आवेग
आवेग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವಸರ /ಗಡಿಬಿಡಿ<br><b>निष्पत्तिः - </b>आ + ओविजी (भयचलनयोः) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"सावेगमग्राङ्गुलिरस्य तूणौ"<br><b>उल्लेखाः - </b>किरा० १७-३८<br><br>आवेग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವ್ಯಬಿಚಾರಿ ಭಾವ<br><br>

आवेगी
आवेगी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಂತನ ಗೊಂಡೆಸೊಪ್ಪು<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७) । "ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>आवेगोऽस्यास्ति<br><br>आवेगी<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆವೇಗವುಳ್ಳವನು<br><br>

आवेदक
आवेदक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಿಸುವವನು<br><b>निष्पत्तिः - </b>आ + विद (ज्ञाने) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>आवेदयति<br><br>आवेदक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾದಿ /ಅರ್ಜಿದಾರ<br><br>

आवेदन
आवेदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿಳಿಯಿಸುವುದು<br><br>आवेदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೂರು /ಅರ್ಜಿ<br><br>आवेदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಳುವುದು /ವಿಜ್ಞಾಪಿಸುವುದು<br><b>निष्पत्तिः - </b>आ + विद (ज्ञाने) - भावे "ल्युट्" (३-३-११५)<br><br>

आवेदनीय
आवेदनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಜ್ಞಾಪಿಸಲ್ಪಡುವ<br><br>आवेदनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲು ಅರ್ಹವಾದ<br><br>आवेदनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವರದಿ ಮಾಡಲ್ಪಡುವ<br><br>आवेदनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೂರು ಹೇಳಲು ಅರ್ಹವಾದ<br><b>निष्पत्तिः - </b>आ + विद (ज्ञाने) + णिच् - "अनीयर्" (३-१-९६)<br><br>

आवेदयत्
आवेदयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಸುವ<br><br>आवेदयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಜ್ಞಾಪಿಸುವ<br><b>निष्पत्तिः - </b>आ + विद (ज्ञाने) + णिच् - "शतृ" (३-२-१२४)<br><br>

आवेदित
आवेदित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಸಲ್ಪಟ್ಟ<br><br>आवेदित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಜ್ಞಾಪಿಸಲ್ಪಟ್ಟ<br><br>आवेदित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಜಿ ಮೂಲಕ ತಿಳಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + विद (ज्ञाने) + णिच् - "क्तः" (३-२-१०२)<br><br>

आवेदिन्
आवेदिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಜ್ಞಾಪಿಸುವ<br><br>आवेदिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಪಡಿಸುವ<br><b>निष्पत्तिः - </b>आ + विद (ज्ञाने) + णिच् - "णिनिः" (३-१-१३४)<br><br>आवेदिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೂರು ಹೇಳುವ /ವಾದಿ<br><br>आवेदिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಜ್ಞೆ ಮಾಡುವವನು<br><br>

आवेदिनी
आवेदिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आवेदिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आवेद्य
आवेद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಜ್ಞಾಪಿಸಲ್ಪಡುವ<br><br>आवेद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + विद (ज्ञाने) + णिच् - "यत्" (३-१-९७)<br><br>आवेद्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿಜ್ಞಾಪಿಸಿ<br><b>निष्पत्तिः - </b>आ + विद (ज्ञाने) + णिच् - "ल्यप्" (७-१-३७)<br><br>

आवेद्यमान
आवेद्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಪಡಿಸಲ್ಪಡುತ್ತಿರುವ<br><br>आवेद्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಜ್ಞಾಪಿಸಲ್ಪಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>आ + विद (ज्ञाने) + णिच् - कर्म० "शानच्" (३-२-१२४)<br><br>

आवेध्य
आवेध्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊರೆಯಲ್ಪಡುವ /ತೂತು ಮಾಡಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + व्यध (ताडने) - "ण्यत्" (३-१-१२४)<br><br>आवेध्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೂಕಲ್ಪಡುವ<br><br>आवेध्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಸೆಯಲ್ಪಡುವ<br><br>आवेध्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಡೆಯಲ್ಪಡುವ<br><br>

आवेश
आवेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರವೇಶ<br><br>आवेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಹಂಕಾರ<br><b>निष्पत्तिः - </b>आ + विश (प्रवेशने) - "घञ्" (३-३-१८)<br><br>आवेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಹಗಳ ಆವೇಶ /ಗ್ರಹಗಳು ಹಿಡಿಯುವುದು<br><br>आवेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಹಗಳ ಭಯ<br><br>आवेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನೋವಿಕಾರ<br><br>आवेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿನಿವೇಶ /ಆಸಕ್ತಿ<br><br>आवेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪ<br><b>प्रयोगाः - </b>"ततो यथावद्विदिताध्वराय तस्मै स्मयावेशविवर्जिताय"<br><b>उल्लेखाः - </b>रघु० ५-१९<br><br>आवेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹ /ಮನೆ<br><br>

आवेशन
आवेशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಲ್ಪಶಾಲೆ<br><br>आवेशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರವೇಶ<br><br>आवेशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪ<br><br>आवेशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂತಾದಿಗಳು ಹಿಡಿಯುವಿಕೆ<br><br>आवेशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯಚಂದ್ರರ ಪರಿಧಿ<br><b>निष्पत्तिः - </b>आ + विश (प्रवेशने) - "ल्युट्" (३-३-११५)<br><br>आवेशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹ /ಮನೆ<br><br>

आवेशिक
आवेशिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಥಿ<br><b>निष्पत्तिः - </b>"ठञ्" (४-३-६०)<br><b>व्युत्पत्तिः - </b>आवेशे गृहे भवः<br><b>विस्तारः - </b>"वेशो वेश्यागृहे गृहे" - मेदि० ।<br><br>आवेशिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಶೇಷವಾದ<br><br>आवेशिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನೆಯಲ್ಲಿರುವ ಬಂಧು ಜನರು<br><b>व्युत्पत्तिः - </b>आवेशे गृहे भवः<br><br>

आवेशित
आवेशित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + विश (प्रवेशने) + णिच् - "क्तः" (३-२-१०२)<br><br>

आवेष्टन
आवेष्टन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುತ್ತುವರಿಯುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + वेष्ट (वेष्टने) - भावे "ल्युट्" (३-३-११५)<br><br>आवेष्टन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಲಿ /ಪ್ರಾಕಾರ /ಸುತ್ತುಗೋಡೆ<br><b>निष्पत्तिः - </b>कर० "ल्युट्" (३-३-११७)<br><br>आवेष्टन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಲಿ ಹಾಕುವ ಸಾಧನ<br><br>

आश
आश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೋಜನ /ಊಟ<br><b>निष्पत्तिः - </b>अश (भोजने) - "घञ्" (३-३-१८)<br><br>आश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿನ್ನುವ /ಊಟ ಮಾಡುವ<br><br>

आशंसत्
आशंसत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸುವ<br><b>निष्पत्तिः - </b>आ + शसि (इच्छायाम्) - "शतृ" (३-२-१२४)<br><br>आशंसत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳುವ<br><b>प्रयोगाः - </b>"आशंसता बाणगतिं वृषाङ्के कार्यं त्वया नः प्रतिपन्नकल्पम्"<br><b>उल्लेखाः - </b>कुमा० ३-१४<br><br>आशंसत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಗಳುವ<br><b>निष्पत्तिः - </b>आ + शंसु (स्तुतौ) - "शतृ" (३-२-१२४)<br><br>

आशंसन
आशंसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಚ್ಛೆ /ಅಪೇಕ್ಷೆ<br><br>आशंसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಳುವುದು<br><br>आशंसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಗಳಿಕೆ<br><b>निष्पत्तिः - </b>आ + शसि (इच्छायाम्) , आ + शंसु (स्तुतौ) - "ल्युट्" (३-३-११५)<br><br>

आशंसा
आशंसा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮನೋರಥ /ಅಭಿಲಾಷೆ<br><b>निष्पत्तिः - </b>आ + शसि (इच्छायाम्) - "अः" (३-३-१०३)<br><b>प्रयोगाः - </b>"आशंसापरिकल्पितास्वपि भवत्यानन्दसान्द्रो लयः"<br><b>उल्लेखाः - </b>मालती० ५-७<br><br>आशंसा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಚ್ಛೆ /ಬಯಕೆ<br><b>प्रयोगाः - </b>"निदधे विजयाशंसां चापे सीतां च लक्ष्मणे"<br><b>उल्लेखाः - </b>रघु० १२-४४<br><br>आशंसा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಳುವುದು<br><br>आशंसा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಗಳಿಕೆ<br><b>निष्पत्तिः - </b>आ + शंसु (स्तुतौ) - "अः" (३-३-१०३)<br><br>

आशंसित
आशंसित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಚ್ಛೆ /ಬಯಕೆ<br><b>निष्पत्तिः - </b>आ + शसि (इच्छायाम्) - भावे "क्तः" (३-३-११४)<br><br>आशंसित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಳಿಕೆ<br><br>आशंसित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತುತಿ<br><b>निष्पत्तिः - </b>आ + शंसु (स्तुतौ) - भावे "क्तः" (३-३-११४)<br><br>आशंसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಟ್ಟ<br><br>आशंसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲ್ಪಟ್ಟ<br><br>आशंसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಗಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + शंसु (स्तुतौ) - कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आशंसितापचितिचारुपुरःसुराणाम्"<br><b>उल्लेखाः - </b>किरा० ६-४६<br><br>

आशंसितृ
आशंसितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸುವ<br><b>निष्पत्तिः - </b>आ + शसि (इच्छायाम्) - "तृन्" (३-२-१३५)<br><b>व्युत्पत्तिः - </b>आशंसते<br><br>आशंसितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಗಳುವ<br><br>आशंसितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳುವ<br><b>निष्पत्तिः - </b>आ + शंसु (स्तुतौ) - "तृन्" (३-२-१३५)<br><br>

आशंसित्री
आशंसित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आशंसितृ ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आशंसिन्
आशंसिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>आशंसितृ ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>आ + शसि (इच्छायाम्), आ + शंसु (स्तुतौ) - "णिनिः" (३-१-१३४)<br><br>

आशंसिनी
आशंसिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आशंसितृ ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आशंसु
आशंसु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸುವ /ಇಚ್ಛಿಸುವ<br><b>निष्पत्तिः - </b>आ + शसि - "उः" (३-२-१६८)<br><b>व्युत्पत्तिः - </b>आशंसते<br><b>प्रयोगाः - </b>"मांसं हतनामिव राक्षसानामाशंसवः क्रूरिगिरो रुवन्तः"<br><b>उल्लेखाः - </b>भट्टि० १२-७२<br><br>

आशक्त
आशक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಕ್ಷ /ಸಮರ್ಥ<br><b>व्युत्पत्तिः - </b>आ सम्यक् शक्तः<br><br>

आशक्ति
आशक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಕ್ತಿ /ಸಾಮರ್ಥ್ಯ<br><br>

आशङ्कनीय
आशङ्कनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಶಯಪಡಲು ಅರ್ಹನಾದ<br><b>निष्पत्तिः - </b>आ + शकि (शङ्कायाम्) - "अनीयर्" (३-१-९६)<br><br>आशङ्कनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯ ಪಡಲು ಯೋಗ್ಯವಾದ<br><br>

आशङ्कमान
आशङ्कमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆದರುವ<br><br>आशङ्कमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಂಕಿಸುವ<br><b>निष्पत्तिः - </b>आ + शकि (शङ्कायाम्) - "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"आशङ्कमानो वैदेहीं खादितां निहतां मृताम्"<br><b>उल्लेखाः - </b>भट्टि० ६-६<br><br>

आशङ्का
आशङ्का<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭಯ /ಹೆದರಿಕೆ<br><b>निष्पत्तिः - </b>आ + शकि (शङ्कायाम्) - "अः" (३-३-१०३)<br><br>आशङ्का<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಶಯ /ಸಂದೇಹ<br><br>आशङ्का<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಸೆ<br><b>प्रयोगाः - </b>"भुक्तं मानविवर्जितं परगृहेष्वाशङ्कया काकवत्"<br><b>उल्लेखाः - </b>भर्तृ० ३-२<br><br>

आशङ्कित
आशङ्कित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಶಯ /ಸಂದೇಹ<br><br>आशङ्कित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭಯ /ಹೆದರಿಕೆ<br><br>आशङ्कित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಡಕಿನ ಚಿಂತೆ<br><b>निष्पत्तिः - </b>आ + शकि (शङ्कायाम्) - "क्तः" (३-३-११४)<br><br>आशङ्कित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆದರಿದ /ಭಯಗೊಂಡ<br><b>निष्पत्तिः - </b>कर्त० "क्तः" (३-४-७२)<br><br>आशङ्कित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂದೇಹಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कर्म० "क्तः" (३-२-१०२)<br><br>

आशङ्किन्
आशङ्किन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆದರುವ /ಭಯಪಡುವ<br><b>निष्पत्तिः - </b>आ + शकि (शङ्कायाम्) - "णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"रघोरभिभवाशङ्कि चुक्षुभे द्विषतां मनः"<br><b>उल्लेखाः - </b>रघु० ४-२१<br><br>आशङ्किन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂದೇಹಪಡುವ<br><b>प्रयोगाः - </b>"कुब्जा नीचतयैव यान्ति शनकैरात्मेक्षणाशङ्किनः"<br><b>उल्लेखाः - </b>रत्ना० २-३<br><br>

आशङ्किनी
आशङ्किनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आशङ्किन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आशङ्क्य
आशङ्क्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂದೇಹಪಡಬಹುದಾದ<br><b>निष्पत्तिः - </b>आ + शकि (शङ्कायाम्) - "ण्यत्" (३-१-१२४)<br><br>आशङ्क्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಶಯಗೊಂಡು<br><b>निष्पत्तिः - </b>आ + शकि (शङ्कायाम्) - "ल्यप्" (७-१-३७)<br><b>प्रयोगाः - </b>"आशङ्क्य दैतेयबलोपयानं दृढार्गलां देवपुरीमकुर्वन्"<br><b>उल्लेखाः - </b>याद० २०-४४<br><br>

आशन
आशन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಜ್ರಾಯುಧ<br><br>आशन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಟ ಮಾಡಿಸುವ<br><br>

आशय
आशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಪ್ರಾಯ<br><b>निष्पत्तिः - </b>आ + शीङ् (स्वप्ने) - "अच्" (३-३-५६)<br><b>प्रयोगाः - </b>"इदमीदृगनीदृगाशयः"<br><b>उल्लेखाः - </b>किरा० २-२८<br><br>आशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಧಾರ /ಆಸರೆ<br><b>प्रयोगाः - </b>"विषमोऽपि विगाह्यते नयः कृततीर्थः पयसामिवाशयः"<br><b>उल्लेखाः - </b>किरा० २-३<br><br>आशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ತ /ಮನಸ್ಸು<br><b>निष्पत्तिः - </b>आ + शीङ् (स्वप्ने) - अधि० "अच्" (३-३-५६)<br><b>प्रयोगाः - </b>"अहमात्मा गुडाकेश सर्वभूताशयस्थितः"<br><b>उल्लेखाः - </b>गीता० १०-१०<br><br>आशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಯನ /ಹಾಸಿಗೆ<br><b>निष्पत्तिः - </b>आ + शीङ् (स्वप्ने) - अधि० "अच्" (३-३-५६)<br><br>आशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಲಗುವುದು<br><b>निष्पत्तिः - </b>आ + शीङ् (स्वप्ने) - भावे "अच्" (३-३-५६)<br><br>आशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆ /ಗೃಹ<br><br>आशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಪಣ /ಜಿಪುಣ<br><br>आशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಣಜ /ಉಗ್ರಾಣ<br><br>आशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅದೃಷ್ಟ /ದೈವ<br><br>आशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಸ್ತಿ /ಸ್ವತ್ತು<br><br>आशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪನಸವೃಕ್ಷ /ಹಲಸಿನ ಮರ<br><br>आशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಳ್ಳ /ಗುಣಿ<br><b>प्रयोगाः - </b>"आस्ते परमसन्तप्तो नूनं सिंह इवाशये"<br><b>उल्लेखाः - </b>भा० वन० ३५-१२<br><br>आशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನೋಧರ್ಮ /ಸಂಸ್ಕಾರ<br><b>प्रयोगाः - </b>"क्लेशकर्मविपाकाशयैरपरामृष्टः पुरुषविशेष ईश्वरः"<br><b>उल्लेखाः - </b>पा० यो० सू० १-२४<br><br>आशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಳೆಯದಾದ /ಬಾಡಿದ<br><b>विस्तारः - </b>"कोट्टारे कृपणे जीर्णे स्थानेऽभिप्राय आश्यः" - वैज० । "आशयः स्यादभिप्राये पनसाधारयोरपि" - मेदि० । "आशयः स्यादभिप्राये मानसाधारयोरपि" - विश्व० ।<br><br>

आशयाश
आशयाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>निष्पत्तिः - </b>अश (भोजने) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>आशयमाश्रयमश्नाति<br><br>

आशर
आशर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><br>आशर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಕ್ಷಸ<br><b>निष्पत्तिः - </b>आ + शृ (हिंसायाम्) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आशृणाति<br><b>विस्तारः - </b>"आशरस्तु पुमान् वैश्वानरे च रजनीचरे" - मेदि० ।<br><br>

आशा
आशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಿಕ್ಕು<br><b>प्रयोगाः - </b>"अनुजगुरुरथ दिव्यं दुन्दुभिध्वानमाशाः"<br><b>उल्लेखाः - </b>किरा० ३-६०<br><br>आशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿರೀಕ್ಷೆ /ಪ್ರತ್ಯಾಶೆ<br><b>प्रयोगाः - </b>"राघवो रथमप्राप्तां तामाशां च सुरद्विषाम्"<br><b>उल्लेखाः - </b>रघु० १२-९६<br><br>आशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಸೆ /ಅಪೇಕ್ಷೆ<br><b>प्रयोगाः - </b>"महोत्सवमिवाशानामाशाभ्यधिकसम्पदम्"<br><b>उल्लेखाः - </b>याद० १६-४<br><br>आशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಾಧ್ಯವಾದುದನ್ನು ಪಡೆಯುವ ಬಯಕೆ<br><b>प्रयोगाः - </b>"आशा बलवती राजन् पुत्राणां तेऽभवत्तदा"<br><b>उल्लेखाः - </b>भा० शल्य० ७-१६<br><br>

आशागज
आशागज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಿಗ್ಗಜ /ದಿಕ್ಕುಗಳನ್ನು ಕಾಯುವ ಆನೆ<br><br>

आशातन्तु
आशातन्तु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಸೆಯೆಂಬ ತಂತು /ದುರ್ಬಲವಾದ ಆಸೆ<br><b>व्युत्पत्तिः - </b>आशैव तन्तुः<br><b>प्रयोगाः - </b>"चिरादाशातन्तुस्त्रुटतु बिसिनीसूत्रभिदुरः"<br><b>उल्लेखाः - </b>मालती० ४-३<br><br>

आशापाल
आशापाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಿಕ್ಪಾಲಕ<br><b>निष्पत्तिः - </b>पाल (रक्षणे) + णिच् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>आशां दिशं पालयति<br><br>

आशापिशाचिका
आशापिशाचिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಸೆಯೆಂಬ ಭೂತ /ಮೋಸಮಾಡುವ ಆಸೆ<br><b>व्युत्पत्तिः - </b>आशैव पिशाचिका<br><br>

आशाबन्ध
आशाबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೇಡರ ಹುಳುವಿನ ಬಲೆ /ಜೇಡರ ಹುಳುವಿನ ಗೂಡು<br><b>निष्पत्तिः - </b>बन्ध (बन्धने) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आशां दिशं बध्नाति<br><br>आशाबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಸೆಯ ಕಟ್ಟು /ಆಸೆಯ ಬಂಧನ<br><b>प्रयोगाः - </b>"आशाबन्धः कुसुमसदृशं प्रायशोह्यङ्गनानाम्"<br><b>उल्लेखाः - </b>मेघ० १-१०<br><br>आशाबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ವಾಸನ /ಸಮಾಧಾನ<br><b>प्रयोगाः - </b>"आशाबन्धं कमपि कुरुते छाययार्थी जनोऽयम्"<br><b>उल्लेखाः - </b>वेणी० ६-२६<br><b>विस्तारः - </b>"आशाबन्धः समाश्वासे तथा मर्कटजालके" - विश्व० ।<br><br>आशाबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಿಗ್ಬಂಧನ<br><br>

आशाभङ्ग
आशाभङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿರಾಶೆ /ಕಾರ್ಯನಾಶ<br><br>

आशावह
आशावह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಸೆಯನ್ನುಂಟುಮಾಡುವ<br><b>व्युत्पत्तिः - </b>आशायाः आवहः<br><br>

आशासत्
आशासत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಣೆ ಮಾಡುವ<br><b>निष्पत्तिः - </b>आ + शासु (अनुशिष्टौ) - "शतृ" (३-२-१२४)<br><br>

आशासान
आशासान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸುವ<br><b>निष्पत्तिः - </b>आ + शासु (इच्छायाम्) - "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"आशासानाः कतिचन विभो त्वत्परिष्वङ्गधन्यैरङ्गीकारं क्षणमपि दये हार्दतुङ्गैरपाङ्गैः"<br><b>उल्लेखाः - </b>दयाश० ४२<br><br>

आशास्य
आशास्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಶೀರ್ವಾದ /ಮಂಗಳ ಶಾಸನ<br><b>प्रयोगाः - </b>"आशास्यमन्यत्पुनरुक्तभूतं श्रेयांसि सर्वाण्यधिजग्मुषस्ते"<br><b>उल्लेखाः - </b>रघु० ५-३४<br><br>आशास्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮನೋರಥ /ಬಯಕೆ<br><b>प्रयोगाः - </b>"आशास्यमीतिविगमप्रभृति प्रजानाम्"<br><b>उल्लेखाः - </b>माल० ५-२०<br><br>आशास्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಡುವ<br><b>प्रयोगाः - </b>"अगस्त्यचरितामाशामनाशास्यजयो ययौ"<br><b>उल्लेखाः - </b>रघु० ४-४४<br><br>आशास्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿರಿಯರ ಅಮುಗ್ರಹದಿಂದ ಲಭ್ಯವಾಗುವ<br><br>आशास्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಾರ್ಥಿಸಿ /ಬೇಡಿ<br><b>निष्पत्तिः - </b>आ + शासु (इच्छायाम्) - "ल्यप्" (७-१-३७)<br><b>प्रयोगाः - </b>"आशास्य लाजाञ्जलिहोमभाजा"<br><b>उल्लेखाः - </b>याद० १३-८६<br><br>

आशित
आशित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೃಪ್ತಿಕರವಾದ ಭೋಜನ /ಸರಿಯಾದ ಊಟ<br><b>निष्पत्तिः - </b>आ + अश (भोजने) - "क्तः" (३-३-११४)<br><br>आशित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿನ್ನಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + अश (भोजने) - "क्तः" (३-२-१०२)<br><br>आशित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸರಿಯಾಗಿ ಊಟ ಮಾಡಿದ<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>आशितमस्त्यस्य<br><br>

आशितङ्गवीन
आशितङ्गवीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೋವುಗಳು ಹುಲ್ಲು ಮೇಯ್ದು ತೃಪ್ತಿ ಹೊಂದಿದ ಪ್ರದೇಶ<br><b>निष्पत्तिः - </b>"खः" (५-४-७) । मुम् निपा० ।<br><b>व्युत्पत्तिः - </b>आशिता गावोऽस्मिन्<br><br>

आशितम्भव
आशितम्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಹಾರದಿಂದ ತೃಪ್ತಿ ಹೊಂದುವಿಕೆ<br><b>निष्पत्तिः - </b>आशित + भू (सत्तायाम्) - भावे "खच्" (३-२-४५) । मुम् (६-३-६७)<br><br>आशितम्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನ /ಆಹಾರ<br><b>निष्पत्तिः - </b>आशित + भू (सत्तायाम्) - कर० "खच्" (३-२-४५) । मुम् (६-३-६७)<br><b>व्युत्पत्तिः - </b>आशितो भवत्यनेन<br><br>

आशितृ
आशितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಊಟ ಮಾಡುವ<br><b>निष्पत्तिः - </b>आ + अश (भोजने) - "तृच्" (३-१-१३३)<br><br>

आशित्री
आशित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಊಟ ಮಾಡುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आशिन्
आशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಟ ಮಾಡುವ<br><b>निष्पत्तिः - </b>आ + अश (भोजने) - "णिनिः" (३-२-७८)<br><br>

आशिर
आशिर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><br>आशिर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>आशिर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಕ್ಷಸ<br><br>आशिर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೋಜನ /ಊಟ<br><b>निष्पत्तिः - </b>आ + अश (भोजने) , अशू (व्याप्तौ) - "किरच्" (उ० १-५२)<br><br>आशिर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುದಿಸಲ್ಪಟ್ಟ ಗಟ್ಟಿಯಾದ ಹಾಲು<br><b>विस्तारः - </b>"आशिरः क्षीरविकृतौ भोजने पावके रवौ" - वैज० । "आशिरो वह्निराक्षसयोः" - सि० कौ० ।<br><br>

आशिष्ट
आशिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶೀರ್ವಾದ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + शासु (इच्छायाम्) - "क्तः" (३-२-१०२)<br><br>

आशिस्
आशिस्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಷ್ಟವಾದುದನ್ನು ಪ್ರಾರ್ಥಿಸುವ ವಾಕ್ಯ /ಹಿತವನ್ನು ಕೋರುವ ಮಾತು<br><b>निष्पत्तिः - </b>आ + शासु (इच्छायाम्) - "क्विप्" (३-२-७६)<br><b>प्रयोगाः - </b>"आशास्य लाजाञ्जलिहोमभाजा क्षेमाशिषा किञ्चिदशेषहृद्यम्"<br><b>उल्लेखाः - </b>याद० १३-८६<br><b>विस्तारः - </b>"इष्टावधारकं वाक्यं आशीस्सा परिकीर्तिता"<br><br>आशिस्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಲಾಷೆ /ಅಪೇಕ್ಷೆ<br><b>प्रयोगाः - </b>"जगच्छरण्यस्य निराशिषः सतᳲ किमेभिराशोपहतात्मवृत्तिभिः"<br><b>उल्लेखाः - </b>कुमा० ५-७६<br><br>आशिस्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾವಿನ ಹಲ್ಲು<br><b>विस्तारः - </b>"आशीरुरगदंष्ट्रायां शुभवाक्याभिलाषयोः" - वैज० ।<br><br>

आशी
आशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪದ ವಿಷದಂತ<br><b>निष्पत्तिः - </b>आ + शॄ (हिंसायाम्) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>आशीर्यतेऽनया<br><b>प्रयोगाः - </b>"विषमाशीभिरनारतं वमन्तः"<br><b>उल्लेखाः - </b>माघ०<br><br>

आशीर्वाद
आशीर्वाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಷ್ಟವಾದುದನ್ನು ಪ್ರಾರ್ಥಿಸುವ ವಾಕ್ಯ /ಹಿತವನ್ನು ಕೋರುವ ಮಾತು<br><b>व्युत्पत्तिः - </b>आशिषो वादः वचनम्<br><b>प्रयोगाः - </b>"अवितथफलमाशीर्वादमारोपयन्तः"<br><b>उल्लेखाः - </b>किरा० १८-४६<br><br>

आशीविष
आशीविष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ /ಹಾವು<br><b>व्युत्पत्तिः - </b>आश्यां विषमस्य<br><b>प्रयोगाः - </b>"तयोरुपान्तस्थितसिसिद्धसैनिकं गरुत्मदाशीविषभीमदर्शनैः"<br><b>उल्लेखाः - </b>रघु० ३-५७<br><br>

आशु
आशु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಟಲ ಧಾನ್ಯ /ಕೆಂಪು ಬತ್ತ<br><b>निष्पत्तिः - </b>अशू (व्याप्तौ) - "उण्" (उ० १-१)<br><b>विस्तारः - </b>"आशुर्वीहिः पाटलः स्यात्" - अम० ।<br><br>आशु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಜಾಗ್ರತೆಯಾಗಿ /ವೇಗವಾಗಿ<br><b>प्रयोगाः - </b>"तदाशु कर्तुं त्वयि जिह्ममुद्यते विधीयतां तत्र विधेयमुत्तरम्"<br><b>उल्लेखाः - </b>किरा० १-२५<br><br>

आशुकारिन्
आशुकारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಾಗ್ರತೆಯಾಗಿ ಕೆಲಸ ಮಾಡುವ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) -"णिनिः" (३-२-७६)<br><b>व्युत्पत्तिः - </b>आशु करोति<br><br>

आशुकारिणी
आशुकारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಾಗ್ರತೆಯಾಗಿ ಕೆಲಸ ಮಾಡುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आशुकृत्
आशुकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಾಗ್ರತೆಯಾಗಿ ಕೆಲಸ ಮಾಡುವ<br><b>निष्पत्तिः - </b>"क्विप्" (३-२-७६)<br><br>

आशुकोपिन्
आशुकोपिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಾಗ್ರತೆಯಾಗಿ ಕೋಪಬರುವ ಸ್ವಭಾವದವನು /ಮುಂಗೋಪಿ<br><b>निष्पत्तिः - </b>कुप (क्रोधे) - "णिनिः" (३-२-७६)<br><b>व्युत्पत्तिः - </b>आशु कुप्यति<br><br>

आशुग
आशुग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯು /ಗಾಳಿ<br><br>आशुग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "डः" (वा० ३-२-४८)<br><b>व्युत्पत्तिः - </b>आशु गच्छति<br><b>प्रयोगाः - </b>"चापैराकर्णमाकृष्टैर्विमुक्ता दूरमाशुगाः"<br><b>उल्लेखाः - </b>कुमा० १६-१३<br><br>आशुग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>आशुग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಾಗ್ರತೆಯಾಗಿ ನಡೆಯುವ<br><br>

आशुगामिन्
आशुगामिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>आशुगामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಾಗ್ರತೆಯಾಗಿ ನಡೆಯುವ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>आशु गच्छति<br><br>

आशुगामिनी
आशुगामिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಾಗ್ರತೆಯಾಗಿ ನಡೆಯುವ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आशुतोष
आशुतोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><br>आशुतोष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಾಗ್ರತೆಯಾಗಿ ಸಂತೋಷಪಡುವ<br><b>व्युत्पत्तिः - </b>आशु शीघ्रं तोषो यस्य<br><br>

आशुव्रीहि
आशुव्रीहि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಟಲ ಧಾನ್ಯ<br><br>

आशुशुक्षणि
आशुशुक्षणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>निष्पत्तिः - </b>क्षणु (हिंसायाम्) - "इन्" (उ० ४-११८) । आ + शुष (शोषणे) + सन् - "अनिः" (उ० २-१०३)<br><b>व्युत्पत्तिः - </b>आशु शीघ्रं शु क्षणोति । आशोष्टुमिच्छति ।<br><br>आशुशुक्षणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯು /ಗಾಳಿ<br><br>

आशौच
आशौच<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶುಚಿ /ಅಶುದ್ಧಿ<br><b>निष्पत्तिः - </b>"अण्" (५-१-१३१) । उत्तरपदवृद्धिः (७-३-३०)<br><b>व्युत्पत्तिः - </b>अशुचेर्भावः<br><br>

आश्चर्य
आश्चर्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅದ್ಭುತ ರಸ<br><b>निष्पत्तिः - </b>आ + चर (गतौ) - "यत्" सुट् (६-१-१४०)<br><b>व्युत्पत्तिः - </b>आ इति चर्यते<br><br>आश्चर्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅದ್ಭುತ /ವಿಸ್ಮಯ<br><b>प्रयोगाः - </b>"आश्चर्यमुत्पलदृशो वदनामलेन्दुसान्निध्यतो मम मुहुर्जडिमानमेत्य"<br><b>उल्लेखाः - </b>मालती० ३-५<br><br>आश्चर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ಚರ್ಯದಿಂದ ಕೂಡಿದ<br><b>प्रयोगाः - </b>"आश्चर्यो गवां दोहोऽगोपेन"<br><br>

आश्चोतन
आश्चोतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಸುರಿಯುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + श्चुतिर् (क्षरणे) - "ल्युट्" (३-३-११५)<br><br>आश्चोतन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಸುರಿಯುವ /ಚೆನ್ನಾಗಿ ನೀರನ್ನು ಚಿಮುಕಿಸುವ<br><b>निष्पत्तिः - </b>आ + श्चुतिर् (क्षरणे) - "ल्युः" (३-१-१३४)<br><br>

आश्म
आश्म<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಲ್ಲಿನಿಂದ ತಯಾರಿಸಪಟ್ಟ ವಸ್ತು<br><b>निष्पत्तिः - </b>अश्मन् - "अण्" (४-३-१३४)<br><b>व्युत्पत्तिः - </b>अश्मनो विकारः<br><br>

आश्मिक
आश्मिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಾರವಾದ ಕಲ್ಲನ್ನು ಹೊರುವ<br><b>निष्पत्तिः - </b>अश्मन् - "ठक्" (५-१-५०)<br><b>व्युत्पत्तिः - </b>भारभूतमश्मानं वहति हरत्यावहति च<br><br>आश्मिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಾರವಾದ ಕಲ್ಲನ್ನು ತೆಗೆದೊಯ್ಯುವ<br><br>आश्मिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಾರವಾದ ಕಲ್ಲನ್ನು ತೆಗೆದುಕೊಂಡು ಬರುವ<br><br>

आश्यान
आश्यान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಣಗಿದ /ಗಟ್ಟಿಯಾದ<br><b>निष्पत्तिः - </b>आ+ श्यैङ् (गतौ) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"सरितः कुर्वती गाधाः पथश्चाश्यानकर्दमान्"<br><b>उल्लेखाः - </b>रघु० ४-२४<br><br>

आश्रम
आश्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>विस्तारः - </b>"तेषां तु योगभ्रष्टानां हेतुर्वैष्णवसद्मसु । सुभिक्षपरविद्येषु विश्रान्तेराश्रमः स्मृतः ॥" - निरुक्तिः ।<br><br>आश्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ಣಶಾಲೆ<br><b>निष्पत्तिः - </b>आ + श्रमु (तपसि खेदे च) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>आश्राम्यन्त्यत्र<br><b>प्रयोगाः - </b>"तौ दम्पती वसिष्ठस्य गुरोर्जग्मतुराश्रमम्"<br><b>उल्लेखाः - </b>रघु० १-३५<br><br>आश्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಚರ್ಯ ಮೊದಲಾದ ೪ ಆಶ್ರಮಗಳು<br><b>प्रयोगाः - </b>"चत्वार आश्रमाश्चैव ब्राह्मणस्य प्रकीर्तिताः । गार्हस्थ्यं ब्रह्मचर्यं च वानप्रस्थं तु भिक्षुकम् । क्षत्रिये चापि कथिता आश्रमास्त्रय एव हि । ब्रह्मचर्यं च गार्हस्थ्यमाश्रमद्वितयं विशः । गार्हस्थ्यमुचितन्त्वेकं शूद्रस्य क्षणमावहेत् ॥"<br><br>आश्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿದ್ಯಾಶಾಲೆ /ಪಾಠಶಾಲೆ<br><br>

आश्रमगुरु
आश्रमगुरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ /ದೊರೆ<br><b>व्युत्पत्तिः - </b>आश्रमाणां ब्रह्मचर्यादीनां गुरुः नियन्ता<br><b>प्रयोगाः - </b>"आतिथेयमनिवारितातिथिः कर्तुमाश्रमगुरुः स नाश्रमत्"<br><b>उल्लेखाः - </b>माघ० १४-३८<br><br>

आश्रमधर्म
आश्रमधर्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಚರ್ಯಾದಿ ಆಶ್ರಮವಿಹಿತವಾದ ಧರ್ಮ /ಆಯಾ ಆಶ್ರಮಗಳಲ್ಲಿ ಮಾಡಬೇಕಾದ ಕಾರ್ಯ<br><b>व्युत्पत्तिः - </b>आश्रमविहितो धर्मः<br><b>प्रयोगाः - </b>"वानप्रस्थं भैक्ष्यचर्यं गार्हस्थ्यं च महाश्रमम् । ब्रह्मचर्याश्रमं प्राहुश्चतुर्थं ब्रह्मणेरितम् ॥"<br><b>उल्लेखाः - </b>भा० शान्ति० ६०-२<br><br>

आश्रमपद
आश्रमपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಪೋವನ /ತಪಸ್ವಿಗಳ ವಾಸಸ್ಥಾನ<br><b>प्रयोगाः - </b>"शान्तमिदमाश्रमपदं स्फुरति च बाहुः कुतः फलमिहास्य"<br><b>उल्लेखाः - </b>शाकु० १-१४<br><br>

आह्रमवास
आह्रमवास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಪಸ್ವಿಗಳು ತಪೋವನದಲ್ಲಿ ವಾಸ ಮಾಡುವುದು<br><br>

आश्रमवासिक
आश्रमवासिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧೃತರಾಷ್ಟ್ರ ಮೊದಲಾದವರ ಆಶ್ರಮವಾಸವನ್ನು ಹೇಳುವ ಮಹಾಭಾರತದ ಒಂದು ಪರ<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५)<br><b>व्युत्पत्तिः - </b>आश्रमवासः प्रतिपाद्यतयाऽस्त्यस्य<br><br>

आश्रमवासिन्
आश्रमवासिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುನಿ /ತಪಸ್ವಿ<br><b>निष्पत्तिः - </b>वस (निवासे) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आश्रमे वसति<br><br>

आश्रमसद्
आश्रमसद्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುನಿ /ತಪಸ್ವಿ<br><b>निष्पत्तिः - </b>षद्लृ (विशरणादौ) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>आश्रमे सीदति<br><br>

आश्रमिक
आश्रमिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಚರ್ಯಾದ್ಯಾಶ್ರಮವುಳ್ಳ<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५)<br><b>व्युत्पत्तिः - </b>आश्रमोस्त्यस्य<br><br>

आश्रमिन्
आश्रमिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಮವುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>आश्रमोस्त्यस्य<br><br>

आश्रय
आश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + श्रिञ् (सेवायाम्) - "अच्" (३-३-५६)<br><b>प्रयोगाः - </b>"गुणवदाश्रयलुब्धगुणोदये मलिनिमालिनि माधवयोषिताम्"<br><b>उल्लेखाः - </b>माघ० ६-४<br><br>आश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಬಲರ ರಕ್ಷಣಾಲಯ /ಅನಾಥರ ಆಲಯ<br><br>आश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸಗೃಹ /ಮನೆ<br><br>आश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಹಾಯ್ಯಕ್ಕಾಗಿ ಇತರನನ್ನು ಸೇರುವುದು<br><b>प्रयोगाः - </b>"साऽभूद्रामाश्रया भूयः"<br><b>उल्लेखाः - </b>रघु० १२-३५<br><br>आश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ /ಮನೆ<br><b>प्रयोगाः - </b>"तदहमाश्रमयोऽमूलनेनैव त्वामकामां करोमि"<br><b>उल्लेखाः - </b>मुद्रा० ३<br><br>आश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಧಾರ /ಅವಲಂಬನ<br><b>प्रयोगाः - </b>"तमाश्रयं दुष्टसहस्य तेजसः"<br><b>उल्लेखाः - </b>रघु० ३-५८<br><br>आश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣಗಳ ಚೀಲ /ಬತ್ತಳಿಕೆ<br><b>प्रयोगाः - </b>"उन्मुखः सपदि लक्ष्मणाग्रजा बाणमाश्रममुखात्समुद्धरन्"<br><b>उल्लेखाः - </b>रघु० ११-२६<br><br>आश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜರ ಸಂಧಿ ವಿಗ್ರಹ ಮೊದಲಾದ ೬ ಗುಣಗಳಲ್ಲೊಂದು<br><br>आश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒತ್ತುಗಂಬ /ಆಧಾರಸ್ತಂಭ<br><b>प्रयोगाः - </b>"वृक्षेषु विद्धमिषुभिर्जघनाश्रयेषु"<br><b>उल्लेखाः - </b>रघु० ९-६०<br><br>आश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಹಾಯ್ಯ /ನೆರವು<br><br>

आश्रयण
आश्रयण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ ಹೊಂದುವಿಕೆ<br><br>आश्रयण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಲಂಬನ /ಆಶ್ರಯ<br><b>निष्पत्तिः - </b>आ + श्रिञ् (सेवायाम्) - भावे "ल्युट्" (३-३-११५)<br><br>आश्रयण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯಪಡೆಯುವ<br><b>निष्पत्तिः - </b>आ + श्रिञ् (सेवायाम्) - "ल्युः" (३-१-१३४)<br><br>

आश्रयणीय
आश्रयणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ ಹೊಂದಲು ಯೋಗ್ಯನಾದ<br><b>निष्पत्तिः - </b>आ + श्रिञ् (सेवायाम्) - "अनीयर्" (३-१-९६)<br><br>

आश्रयवत्
आश्रयवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯವುಳ್ಳ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>आश्रयोऽस्यास्ति<br><br>

आश्रयाश
आश्रयाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>निष्पत्तिः - </b>अश (भोजने) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>आश्रयमश्नाति<br><br>आश्रयाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತ್ತಿಕಾ ನಕ್ಷತ್ರ<br><br>आश्रयाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರಮೂಲದ ಗಿಡ<br><br>आश्रयाश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಸರೆಯನ್ನು ನಾಶಗೊಳಿಸುವ<br><br>

आश्रयासिद्ध
आश्रयासिद्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನ್ಯಾಯಮತಸಿದ್ಧವಾದ ೫ ವಿಧ ಹೇತ್ವಾಭಾಸಗಳಲ್ಲೊಂದು<br><b>व्युत्पत्तिः - </b>आश्रयस्य पक्षस्यासिद्धिः<br><br>

आश्रयासिद्धि
आश्रयासिद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಿದ್ಧಿಯೆಂಬ ಹೇತುವಿನ ಒಂದು ದೋಷ<br><b>व्युत्पत्तिः - </b>आश्रयस्यासिद्धिः<br><br>

आश्रयिन्
आश्रयिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ ಹೊಂದಿರುವ<br><b>निष्पत्तिः - </b>आ + श्रिञ् (सेवायाम्) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आश्रयति<br><br>

आश्रव
आश्रव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ /ಒಪ್ಪಿಗೆ<br><br>आश्रव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಜ್ಞೆ<br><br>आश्रव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಷ್ಟ /ಕ್ಲೇಶ<br><br>आश्रव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಧೇಯ<br><b>निष्पत्तिः - </b>आ + श्रु (श्रवणे) - "अप्" (३-३-५७)<br><b>व्युत्पत्तिः - </b>आशृणोति<br><b>प्रयोगाः - </b>"शाधि शासक जगत्त्रयस्य मामाश्रवोऽस्मि भवतः सहानुजः"<br><b>उल्लेखाः - </b>माघ० १४-११<br><b>विस्तारः - </b>"आश्रयोऽङ्गीकृतौ क्लेशे नान्यवद्वचनस्थिते" - मेदि० ।<br><br>

आश्राव
आश्राव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಜ್ಞೆ ಮಾಡಿಸುವುದು<br><br>आश्राव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ ಮಾಡಿಸುವುದು<br><br>आश्राव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಳುವಂತೆ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>आ + श्रु (श्रवणे) + णिच् - "अच्" (३-१-१३४)<br><br>

आश्रित
आश्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ ಪಡೆದವನು<br><br>आश्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆ ಹೊಂದಿದವನು<br><br>आश्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಧಾರವುಳ್ಳ<br><b>निष्पत्तिः - </b>आ + श्रिञ् (सेवायाम्) - "क्तः" (३-४-७२)<br><br>आश्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + श्रिञ् (सेवायाम्) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आश्रितं रत्नपूर्णेन कुम्भेन च महीयसा"<br><b>उल्लेखाः - </b>याद० १६-११<br><br>आश्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೆಲೆಸಿರುವ<br><b>प्रयोगाः - </b>"इमं स्फटिकशिलास्तम्भमाश्रितो भवामि"<br><b>उल्लेखाः - </b>माल० ४<br><br>आश्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಕ /ಆಳು<br><b>प्रयोगाः - </b>"प्रायश्चलं गौरवमाश्रितेषु"<br><b>उल्लेखाः - </b>कुमा० ३-१<br><br>

आश्रित्य
आश्रित्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ ಹೊಂದಿರುವ<br><br>आश्रित्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆ ಪಡೆದು<br><br>आश्रित्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒತ್ತಾಸೆ ಪಡೆದು<br><b>निष्पत्तिः - </b>आ + श्रिञ् (सेवायाम्) - "ल्यप्" (७-१-३७)<br><br>

आश्रुत्
आश्रुत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ<br><br>आश्रुत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಜ್ಞೆ<br><b>निष्पत्तिः - </b>आ + श्रु (श्रवणे) - "क्विप्" (३-३-९४)<br><br>आश्रुत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗೀಕರಿಸುವ<br><br>आश्रुत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಜ್ಞೆ ಮಾಡುವ<br><b>निष्पत्तिः - </b>आ + श्रु (श्रवणे) कर्त० "क्विप्"<br><b>व्युत्पत्तिः - </b>आ शृणोति<br><br>

आश्रुत
आश्रुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + श्रु (श्रवणे) - "क्तः" (३-२-१०२)<br><br>आश्रुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಜ್ಞೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"आश्रुतस्य विफलत्वमस्ति चेदाः श्रुतस्य रचितोऽयमञ्जलिः"<br><b>उल्लेखाः - </b>चं० रा०<br><br>आश्रुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೇಳಲ್ಪಟ್ಟ<br><br>

आश्रुति
आश्रुति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಜ್ಞೆ<br><br>आश्रुति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ<br><br>आश्रुति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಳುವುದು /ಶ್ರವಣ<br><b>निष्पत्तिः - </b>आ + श्रु (श्रवणे) - "क्तिन्" (३-३-९४)<br><br>

आश्लिष्ट
आश्लिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಲಿಂಗಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + श्लिष (आलिङ्गने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आश्लिष्टभूमिं रसितारमुच्चैर्लोलद्भुजाकारबृहत्तरङ्गम्"<br><b>उल्लेखाः - </b>माघ० ३-७२<br><br>आश्लिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇರಿಕೊಂಡಿರುವ<br><b>प्रयोगाः - </b>"विदिद्युते बाडवजातवेदसः शिखाभिराश्लिष्ट इवाम्भसां निधिः"<br><b>उल्लेखाः - </b>माघ० १-२०<br><br>

आश्लेष
आश्लेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಲಿಂಗನ /ಅಪ್ಪಿಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>आ + श्लिष (आलिङ्गने) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"आश्लेषलोलुपपवधूस्तनकार्कश्यसाक्षिणीम्"<br><b>उल्लेखाः - </b>माघ० २-१७<br><br>आश्लेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಸಂಬಂಧ /ಏಕದೇಶದಲ್ಲಿ ಮಾತ್ರ ಸೇರಿಕೊಂಡಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>आ ईषत् श्लेषः सम्बन्धः<br><br>

आश्लेषा
आश्लेषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ಲೇಷಾ ನಕ್ಷತ್ರ<br><b>प्रयोगाः - </b>"आश्लेषा नक्षत्रं सर्पा देवताः"<br><b>उल्लेखाः - </b>तैत्ति० सं०<br><br>

आश्व
आश्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಗಳ ಗುಂಪು<br><b>निष्पत्तिः - </b>"अण्" (४-२-३७)<br><b>व्युत्पत्तिः - </b>अश्वानां समूहः<br><br>आश्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಸ್ವಭಾವ<br><b>निष्पत्तिः - </b>"अञ्" (५-१-१२९)<br><b>व्युत्पत्तिः - </b>अश्वस्य भावः<br><br>आश्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಸಂಬಂಧವಾದ<br><br>आश्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುದುರೆಯಿಂದ ಎಳೆಯಲ್ಪಟ್ಟ ಗಾಡಿ ರಥ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>अश्व - "अण्" (४-२-९२)<br><br>

आश्वत्थ
आश्वत्थ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರಳಿ ಹಣ್ಣು<br><b>निष्पत्तिः - </b>"अण्" (४-३-१६४)<br><b>व्युत्पत्तिः - </b>अश्वत्थस्य फलम्<br><br>आश्वत्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಳಿ ಮರದ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>अश्वत्थस्येयम्<br><br>

आश्वत्थी
आश्वत्थी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಿನೀ ನಕ್ಷತ್ರದಿಂದ ಕೂಡಿದ ರಾತ್ರಿ<br><br>

आश्वत्थिक
आश्वत्थिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ವಯುಜ ಮಾಸ<br><b>निष्पत्तिः - </b>अश्वत्थ - "ठक्" (४-२-२२)<br><b>व्युत्पत्तिः - </b>अश्वत्थेन युक्ता पौर्णमास्यस्मिन्<br><br>

आश्वपत
आश्वपत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಪತಿಯ ಮಗ<br><b>निष्पत्तिः - </b>"अण्" (४-१-८४)<br><b>व्युत्पत्तिः - </b>अश्वपतेरपत्यम्<br><br>आश्वपत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಶ್ವಪತಿ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>अश्वपतेरिदम्<br><br>

आश्वभारिक
आश्वभारिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುದುರೆಯು ಹೊರುವಷ್ಟು ಭಾರವನ್ನು ಒಯ್ಯುವ /ಹೊರುವ /ತೆಗೆದುಕೊಂಡು ಬರುವ<br><b>निष्पत्तिः - </b>"ठक्" (५-१-५०)<br><b>व्युत्पत्तिः - </b>अश्वभारं अश्ववाह्यं भारं हरति वहति आवहति वा<br><br>

आश्वमेधिक
आश्वमेधिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧರ್ಮರಾಜನ ಅಶ್ವಮೇಧಯಾಗದ ವಿಷಯವನ್ನು ತಿಳಿಸುವ ಮಹಾಭಾರತದ ಒಂದು ಪರ್ವ<br><b>निष्पत्तिः - </b>"ठक्" (५-४-३४)<br><b>व्युत्पत्तिः - </b>अश्वमेध एव<br><br>आश्वमेधिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಶ್ವಮೇಧಯಾದ ಸಂಬಂಧವಾದ<br><br>

आश्वयुज
आश्वयुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ವಯುಜ ಮಾಸ<br><b>निष्पत्तिः - </b>"अण्" (४-२-२१)<br><b>व्युत्पत्तिः - </b>आश्वयुजी पौर्णमास्यस्मिन्<br><br>

आश्वयुजक
आश्वयुजक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ವಯುಜ ಮಾಸದ ಹುಣ್ಣಿಮೆಯ ದಿನ ಬಿತ್ತಿದ ಉದ್ದು<br><b>निष्पत्तिः - </b>"वुञ्" (४-३-४५)<br><b>व्युत्पत्तिः - </b>आश्वयुज्यामुप्तो माषः<br><br>

आश्वयुजी
आश्वयुजी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ವಯುಜ ಮಾಸದ ಹುಣ್ಣಿಮೆ<br><b>निष्पत्तिः - </b>"अण्" (४-२-३)<br><b>व्युत्पत्तिः - </b>अश्वयुजा अश्विनीनक्षत्रेण युक्ता पौर्णमासी<br><br>

आश्वरथ
आश्वरथ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಗಾಡಿಯ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>अश्वरथस्येदम्<br><br>

आश्वलक्षणिक
आश्वलक्षणिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಲಕ್ಷಣವನ್ನು ತಿಳಿದಿರುವ<br><b>निष्पत्तिः - </b>"ठक्" (वा० ४-२-६०)<br><b>व्युत्पत्तिः - </b>अश्वलक्षणं वेत्ति तद्ग्रन्थमधीते वा<br><br>आश्वलक्षणिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಲಕ್ಷಣವನ್ನು ತಿಳಿಸುವ ಶಾಸ್ತ್ರವನ್ನು ಅಧ್ಯಯನ ಮಾಡುವ<br><br>

आश्वलायन
आश्वलायन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಲ ಋಷಿಯ ಮಗ /ಋಗ್ವೇದದ ಶ್ರೌತ ಮತ್ತು ಗೃಹ್ಯ ಸೂತ್ರಗಳನ್ನು ಬರೆದ ಋಷಿ<br><b>निष्पत्तिः - </b>"फक्" (४-१-९९)<br><b>व्युत्पत्तिः - </b>आश्वलः कश्चन मुनिः तस्यापत्यम्<br><br>

आश्वास
आश्वास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆಯ ಭರವಸೆ<br><br>आश्वास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಲ್ಲುವಿಕೆ<br><br>आश्वास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾಧಾನಗೊಳ್ಳುವುದು<br><br>आश्वास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಂಥದ ಭಾಗ<br><br>आश्वास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಸಿರಾಡುವುದು<br><b>निष्पत्तिः - </b>आ + श्वस (प्राणने) - "घञ्" (३-३-१८)<br><br>

आश्वासक
आश्वासक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾಧಾನಪಡಿಸುವ<br><br>आश्वासक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧೈರ್ಯವನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>आ + श्वस (प्राणने) + णिच् - "ण्वुल्" (३-१-१३३)<br><br>

आश्वासन
आश्वासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾಧಾನಗೊಳಿಸುವುದು<br><b>निष्पत्तिः - </b>आ + श्वस (प्राणने) + णिच् - "ल्युट्" (३-३-११५)<br><br>आश्वासन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾಧಾನಗೊಳಿಸುವ<br><b>निष्पत्तिः - </b>आ + श्वस (प्राणने) + णिच् - "ल्युः" (३-१-१३४)<br><br>

आश्वासिन्
आश्वासिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾಧಾನವುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>आश्वासोऽस्यास्ति<br><b>प्रयोगाः - </b>"कामं प्रिया न सुलभा मनस्तु तद्भावदर्शनाश्वासि"<br><b>उल्लेखाः - </b>शाकु० २-१<br><br>

आश्वास्य
आश्वास्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾಧಾನಗೊಳಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + श्वस (प्राणने) + णिच् - "यत्" (३-१-९७)<br><br>आश्वास्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಮಾಧಾನಗೊಳಿಸಿ<br><b>निष्पत्तिः - </b>आ + श्वस (प्राणने) + णिच् - "ल्यप्" (७-१-३७)<br><br>

आश्विक
आश्विक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಾರವಾಗಿರುವ ಕುದುರೆಯನ್ನು ಒಯ್ಯುವ<br><b>निष्पत्तिः - </b>"ठक्" (५-१-५०)<br><b>व्युत्पत्तिः - </b>भारभूतमश्वं हरति वहत्यावहति च<br><br>आश्विक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಶ್ವದ ಲಾಭವನ್ನು ಸೂಚಿಸುವ ಶುಭಶಕುನ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-३८)<br><b>व्युत्पत्तिः - </b>अश्वस्य निमित्तं संयोगः उत्पातो वा<br><br>

आश्विन
आश्विन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ವಯುಜ ಮಾಸ<br><b>निष्पत्तिः - </b>"अण्" (४-२-२१)<br><b>व्युत्पत्तिः - </b>आश्विनी पौर्णमास्यस्मिन्<br><br>आश्विन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಿನೀಕುಮಾರರು<br><br>आश्विन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಶ್ವಿನೀದೇವತೆಯ ಸಂಬಂಧವಾದ<br><br>

आश्विनी
आश्विनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ವಯುಜ ಮಾಸದ ಹುಣ್ಣಿಮೆ<br><b>निष्पत्तिः - </b>"अण्" (४-२-३)<br><b>व्युत्पत्तिः - </b>अश्विन्या युक्ता पूर्णिमा<br><br>

आश्विनेय
आश्विनेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಿನೀ ದೇವತೆಯ ಕುಮಾರರು<br><b>निष्पत्तिः - </b>"ढक्" (४-१-१२०)<br><b>व्युत्पत्तिः - </b>अश्विन्या अपत्ये<br><b>विस्तारः - </b>द्विवचनान्तं रूपम् ।<br><br>

आश्वीन
आश्वीन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಮೇಲೆ ಒಂದು ದಿನ ಪ್ರಯಾಣಮಾಡುವಷ್ಟು ದೂರದ ಮಾರ್ಗ /ಕುದುರೆಯು ಒಂದು ದಿನ ನಡೆಯುವಷ್ಟು ದಾರಿ<br><b>निष्पत्तिः - </b>"खञ्" (५-२-१९)<br><b>व्युत्पत्तिः - </b>अश्वस्य एकाहगमः<br><br>

आषाढ
आषाढ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಷಾಢ ಮಾಸ<br><b>निष्पत्तिः - </b>"अण्" (४-२-२१)<br><b>व्युत्पत्तिः - </b>आषाढी पूर्णिमाऽस्मिन् मासे<br><br>आषाढ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಲಾಶದಂಡ<br><b>निष्पत्तिः - </b>"अण्" (५-१-११०)<br><b>व्युत्पत्तिः - </b>आषाढी पूर्णिमा प्रयोजनमस्य<br><b>प्रयोगाः - </b>"अथाजिनाषाढधरः प्रगल्भवाक्"<br><b>उल्लेखाः - </b>कुमा० ५-३०<br><br>आषाढ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಲಯ ಪರ್ವತ<br><b>विस्तारः - </b>"आषाढो व्रतिनां दण्डे मासे मलयपर्वते" - मेदि० ।<br><br>

आषाढा
आषाढा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂರ್ವಾಷಾಢಾ ಮತ್ತು ಉತ್ತರಾಷಾಢಾ ನಕ್ಷತ್ರಗಳು<br><br>

आषाढाभव
आषाढाभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಜ /ಅಂಗಾರಕ<br><b>निष्पत्तिः - </b>भू (सत्तायाम्) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>आषाढायां भवः<br><br>

आषाढभू
आषाढभू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಜ /ಅಂಗಾರಕ<br><b>निष्पत्तिः - </b>"क्विप्" (३-२-७६)<br><br>

आषाढी
आषाढी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಷಾಢ ಮಾಸದ ಹುಣ್ಣಿಮೆ<br><b>निष्पत्तिः - </b>"अण्" (४-२-३) । "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>आषाढया नक्षत्रेण युक्ता पौर्णमासी<br><br>

आषाढीय
आषाढीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಷಾಢಾ ನಕ್ಷತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>"छः" (४-२-११४)<br><b>व्युत्पत्तिः - </b>आषाढायां जातः<br><br>आषाढीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಷಾಢಾ ನಕ್ಷತ್ರ ಸಂಬಂಧವಾದ<br><br>

आष्ट्र
आष्ट्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾಶ /ಗಗನ<br><b>निष्पत्तिः - </b>अशू (व्याप्तौ) - "ष्ट्रन्" (उ० ४-१५९)<br><br>

आस|उपवेशने|आस्ते
आस - उपवेशने (अदा० आत्म० अक० से०) आस्ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕುಳಿತುಕೊ /ಕೂಡು /ಕೂರು<br><b>प्रयोगाः - </b>"कर्मेन्द्रियाणि संयम्य य आस्ते मनसा स्मरन्"<br><b>उल्लेखाः - </b>गीता० ३-६<br><br>

अधि + आस|अध्यास|अध्यासितम्
अधि + आस = अध्यासितम् ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಮೇಲೆ ಕೂರು /ಆಶ್ರಯ ಹೊಂದು<br><b>प्रयोगाः - </b>"धेन्वा तदध्यासितकातराक्ष्या"<br><b>उल्लेखाः - </b>रघु० २-५२<br><br>

अनु + आस|अन्वास|अन्वासितम्
अनु + आस = अन्वासितम् ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಅನಂತರ ಕುಳಿತುಕೊಳ್ಳುವುದರಿಂದ ಸೇವಿಸು<br><b>प्रयोगाः - </b>"अन्वासितमरुन्धत्या स्वाहयेव हविर्भुजम्"<br><b>उल्लेखाः - </b>रघु० १-५६<br><br>

अभि + आस|अभ्यास|अभ्यासः
अभि + आस = अभ्यासः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಕುಳಿತುಕೊ<br><br>अभि + आस = अभ्यासः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಆವೃತ್ತಿ /ಪುನಃ ಪುನಃ ಮಾಡು<br><b>प्रयोगाः - </b>"अभ्यासेन च कौन्तेय वैराग्येण च गृह्यते"<br><b>उल्लेखाः - </b>गीता० ६-३५<br><br>अभि + आस = अभ्यासः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಸಾಮೀಪ್ಯ<br><b>प्रयोगाः - </b>"व्रीडादिवाभ्यासगतैर्विलिल्ये"<br><b>उल्लेखाः - </b>माघ० ३-४०<br><br>

उद् + आस|उदास|उदासीनः
उद् + आस = उदासीनः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಉದಾಸೀನನಾಗು<br><b>प्रयोगाः - </b>"उदासितारं निगृहीतमानसैर्गृहीतमध्यात्मदृशा कथञ्चन"<br><b>उल्लेखाः - </b>माघ० १-३३<br><br>

उप + आस|उपास|उपासनम्
उप + आस = उपासनम् ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಉಪಾಸಿಸು /ಸೇವಿಸು<br><b>प्रयोगाः - </b>"उद्यानपालसामान्यमृतवस्तमुपासते"<br><b>उल्लेखाः - </b>कुमा० २-३६<br><br>

परि + उप + आस|पर्युपास|पर्युपास्ते
परि + उप + आस = पर्युपास्ते ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಸೇವಿಸು<br><b>प्रयोगाः - </b>"स्थिरः प्रदीपतामेत्य भुजङ्गाः पर्युपासते"<br><b>उल्लेखाः - </b>कुमा० २-३८<br><br>

सम् + उप + आस|समुपास|समुपास्ते
सम् + उप + आस = समुपास्ते ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಉಪಾಸಿಸು /ಸೇವಿಸು<br><b>प्रयोगाः - </b>"समुपास्यत पुत्रभोग्यया स्नुषयेवाविकृतेन्द्रियः श्रिया"<br><b>उल्लेखाः - </b>रघु० ८-१४<br><br>

सम् + आस|समास|समासीनः
सम् + आस = समासीनः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಕುಳಿತುಕೊ /ಕೂಡು /ಕೂರು<br><b>प्रयोगाः - </b>"पश्चिमां तु समासीनो मलं हन्ति दिवाकृतम्"<br><br>

आस्
आस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೋಪ<br><b>प्रयोगाः - </b>"आः क एष मयि स्थिते चन्द्रमभिभवितुमिच्छति बलात्"<br><b>उल्लेखाः - </b>मुद्रा० १<br><br>आस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಕ್ಷೇಪಣೆ<br><b>प्रयोगाः - </b>"आः, दुरात्मन् वृथामङ्गलपाठक"<br><b>उल्लेखाः - </b>वेणी० १<br><br>आस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂತಾಪ<br><br>आस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಖೇದ /ದುಃಖ<br><b>प्रयोगाः - </b>"विद्यामातरमाः प्रदर्श्य नृपशून् भिक्षामहे निस्त्रपाः"<br><b>उल्लेखाः - </b>उद्भ०<br><b>विस्तारः - </b>"आः सन्तापप्रकोपयोः" - हेम० ।<br><br>

आस
आस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧನಸ್ಸು /ಬಿಲ್ಲು<br><b>निष्पत्तिः - </b>असु (क्षेपणे) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>आस्यतेऽनेन<br><b>प्रयोगाः - </b>"ससासिः साससूः सासः"<br><b>उल्लेखाः - </b>किरा० १५-५<br><br>आस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಸನ /ಪೀಠ<br><b>निष्पत्तिः - </b>आस (उपवेशने) - अधि० "घञ्" (३-३-१२१)<br><br>आस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೂರುವಿಕೆ /ಕುಳಿತುಕೊಳ್ಳುವಿಕೆ<br><b>निष्पत्तिः - </b>आस - भावे "घञ्" (३-३-१८)<br><br>आस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಸನ /ಗುಹ್ಯಪ್ರದೇಶ<br><b>निष्पत्तिः - </b>आस - कर० "घञ्" (३-३-१२१)<br><b>प्रयोगाः - </b>"कप्यासं पुण्डरीकमेवमक्षिणी"<br><b>उल्लेखाः - </b>छान्दोग्य०<br><br>

आसक्त
आसक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಅಂಟಿಕೊಂಡಿರುವ<br><b>निष्पत्तिः - </b>आ + षञ्ज (सङ्गे) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"आसक्तमेतदनपेक्षितहेतु चेतः"<br><b>उल्लेखाः - </b>मालती० १-२६<br><br>आसक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರದ್ಧೆಯುಳ್ಳ<br><br>आसक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರ್ತೃತ್ವಾಭಿಮಾನವುಳ್ಳ<br><br>

आसक्ति
आसक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರದ್ದೆ /ತತ್ಪರತೆ<br><b>निष्पत्तिः - </b>आ + षञ्ज (सङ्गे) - "क्तिन्" (३-३-९४)<br><br>आसक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ತೃತ್ವಾಭಿಮಾನ<br><br>

आसङ्ग
आसङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರದ್ಧೆ /ತತ್ಪರತೆ<br><br>आसङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ<br><b>निष्पत्तिः - </b>आ + षञ्ज (सङ्गे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"पादाकृष्टव्रततिवलयासङ्गसञ्जातपाशः"<br><b>उल्लेखाः - </b>शाकु० १-२९<br><br>आसङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಹವಾಸ<br><br>आसङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾನು ಮಾಡಿದೆನೆಂಬ ಅಭಿಮಾನ<br><br>आसङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೊರೆತ ವಸ್ತುವಿನ ರಕ್ಷಣೆಯಲ್ಲಿ ಅಭಿಲಾಷೆ<br><br>आसङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿರಾಮವಿಲ್ಲದ<br><br>आसङ्ग<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸತತವಾಗಿ<br><br>

आसङ्गिन्
आसङ्गिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸತತವಾದ ಸಂಬಂಧವುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>आसङ्गोऽस्यास्ति<br><br>

आसङ्गिनी
आसङ्गिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸತತವಾದ ಸಂಬಂಧವುಳ್ಳ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>आसङ्गिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಂಟರಗಾಳಿ /ಸುಳಿಗಾಳಿ<br><br>

आसञ्जन
आसञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಳಿ /ಕೊಂಡಿ<br><br>आसञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ /ಸಂಪರ್ಕ<br><br>आसञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರದ್ಧೆ /ಭಕ್ತಿ<br><br>आसञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇರಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + षञ्ज (सङ्गे) - "ल्युट्" (३-३-११५)<br><br>

आसञ्जित
आसञ्जित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + षञ्ज (सङ्गे) +णिच् - "क्तः" (३-२-१०२)<br><br>

आसत्ति
आसत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪ ಸಂಬಂಧ<br><b>निष्पत्तिः - </b>आ + षद्लृ (विशरणादौ) - "क्तिन्" (३-३-९४)<br><br>आसत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಭ /ಪ್ರಾಪ್ತಿ /ಸಂಪಾದನೆ<br><br>आसत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಾರ್ಕಿಕ ಮತದಲ್ಲಿ ಶಾಬ್ದಬೋಧವುಂಟಾಗಲು ಪದಗಳನ್ನು ವಿಲಂಬವಿಲ್ಲದೆ ಉಚ್ಚರಿಸುವುದು<br><b>विस्तारः - </b>"कारणं सन्निधानं तु पदस्यासत्तिरुच्यते" - भाषापा०<br><br>आसत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ /ಸೇರಿಕೆ<br><br>

आसदन
आसदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಭ /ಪ್ರಾಪ್ತಿ /ಸಂಪಾದನೆ<br><br>आसदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪ ಸಂಬಂಧ<br><b>निष्पत्तिः - </b>आ + षद्लृ (विशरणादौ) - "ल्युट्" (३-३-११५)<br><br>

आसन
आसन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊನ್ನೆ ಮರ<br><b>विस्तारः - </b>"आसनो वीजकद्रुमे" - विश्व० ।<br><br>आसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೀಠ /ಕುಳಿತುಕೊಳ್ಳುವ ಮಣೆ<br><b>निष्पत्तिः - </b>आस (उपवेशने) - "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>आस्यतेऽत्र<br><b>प्रयोगाः - </b>"तदनुमतमलञ्चकार पश्चात्प्रशम इव श्रुतमासनं नरेन्द्रः"<br><b>उल्लेखाः - </b>किरा० २-५८<br><br>आसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಳಿತುಕೊಳ್ಳುವಿಕೆ<br><b>निष्पत्तिः - </b>आस - भावे "ल्युट्" (३-३-११५)<br><br>आसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಹೆಗಲು<br><b>निष्पत्तिः - </b>अधि० "ल्युट्" (३-३-११७)<br><br>आसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನು ಶತ್ರುವಿನೊಡನೆ ಯುದ್ಧ ಮಾಡಲು ಕಾಲವನ್ನು ನಿರೀಕ್ಷಿಸಿಕೊಂಡು ಕುಳಿತುಕೊಳ್ಳುವುದು /ರಾಜನ ೬ ಗುಣಗಳಲ್ಲೊಂದು<br><br>आसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವರ ಪೂಜಾಕಾಲದಲ್ಲಿ ಪೂಜಾಂಗವಾಗಿ ಸಮರ್ಪಿಸುವ ಆಸನ<br><br>आसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಸೆಯುವುದು<br><br>आसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮಶಾಸ್ತ್ರದಲ್ಲಿ ಉಕ್ತವಾದ ೮೪ ಆಸನಗಳು<br><br>आसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯೋಗಶಾಸ್ತ್ರದಲ್ಲಿ ಹೇಳಿರುವ ಪದ್ಮಾಸನ<br><br>

आसनबन्ध
आसनबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಕಾಲು ಕಟ್ಟಿಕೊಂಡು ಕುಳಿತುಕೊಳ್ಳುವುದು<br><b>प्रयोगाः - </b>"स्थितः स्थितामुच्चलितः प्रयातां निषेदुषीमासनबन्धधीरः । जलाभिलाषी जलमाददानां छायेव तां भूपतिरन्वगच्छत्"<br><b>उल्लेखाः - </b>रघु० २-६<br><br>

आसना
आसना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇರುವಿಕೆ /ಸ್ಥಿತಿ<br><br>आसना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಳಿತುಕೊಳ್ಳುವಿಕೆ<br><b>निष्पत्तिः - </b>आस (उपवेशने) - "युच्" (३-३-१०७)<br><br>

आसनी
आसनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗಡಿ<br><b>निष्पत्तिः - </b>आस (उपवेशने) - "ल्युट्" (३-३-११५) । "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>आस्यतेऽत्र<br><br>आसनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇರುವಿಕೆ /ಸ್ಥಿತಿ<br><br>आसनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಳಿತುಕೊಳ್ಳುವಿಕೆ<br><b>विस्तारः - </b>"आसनी विपणौ स्थित्याम्" - मेदि० ।<br><br>

आसन्द
आसन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸುದೇವ /ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>आ + षद्लृ (विशरणादौ) - "दन्" (उ० ४-९८) निपा० ।<br><b>व्युत्पत्तिः - </b>आसीदत्यस्मिन्<br><br>

आसन्दी
आसन्दी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಸನ /ಪೀಠ<br><br>आसन्दी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಮಂಚ /ಶಯ್ಯೆ<br><br>आसन्दी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಭೆಯ ವೇದಿಕೆ /ಅಧ್ಯಕ್ಷ ಸ್ಥಾನ<br><b>निष्पत्तिः - </b>आ + षद्लृ (विशरणादौ) - "दन्" (उ० ४-९८) निपा० । "ङीप्" (४-१-५)<br><b>विस्तारः - </b>"आसन्दो वासुदेवे स्यात् खट्वाभेदे च योषिति" - मेदि० ।<br><br>

आसन्न
आसन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿರುವ /ಹತ್ತಿರದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>आ + षद्लृ (विशरणादौ) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"उद्धूताः कठिनकुचस्थलाभिघातादासन्नां भृशमपराङ्गनामधाक्षुः"<br><b>उल्लेखाः - </b>माघ० ८-४०<br><br>आसन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರಕ್ಕೆ ಬಂದ<br><br>आसन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪದಗಳ ಸಮೀಪ ಸಂಬಂಧ ಹೊಂದಿದ<br><br>आसन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಇಡಲ್ಪಟ್ಟ<br><br>आसन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಮೂರ್ಷು /ಮರಣಾವಸ್ಥೆಯಲ್ಲಿರುವ<br><br>

आसम्बाध
आसम्बाध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ತಡೆಯಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>आसमन्तात् सम्बाधा यत्र<br><br>

आसव
आसव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ /ಸುರೆ<br><b>निष्पत्तिः - </b>आ + षूञ् (अभिषवे) - कर्म० "अप्" (३-३-५७)<br><b>व्युत्पत्तिः - </b>आसूयते<br><b>प्रयोगाः - </b>"नारिकेलासवं योधाः शात्रवं च पपुर्यशः"<br><b>उल्लेखाः - </b>रघु० ४-४२<br><br>आसव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಟ್ಟಿ ಇಳಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + षूञ् (अभिषवे) - भावे "अप्"<br><br>आसव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಟ್ಟಿ ಇಳಿಸುವ ಪಾತ್ರೆ<br><b>निष्पत्तिः - </b>आ + षूञ् (अभिषवे) - अधि० "अप्"<br><b>व्युत्पत्तिः - </b>आसूयतेऽत्र<br><br>

आसादन
आसादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ತರುವುದು<br><br>आसादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಗೆ ಇಡುವುದು<br><br>आसादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಂದುವುದು /ಪಡೆಯುವುದು<br><b>निष्पत्तिः - </b>आ + षद्लृ (विशरणादौ) + णिच् - "ल्युट्" (३-३-११५)<br><br>

आसादित
आसादित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + षद्लृ (विशरणादौ) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"उपाससादोपजनं जनप्रियः प्रियामिवासादितयौवनां भुवम्"<br><b>उल्लेखाः - </b>किरा० ४-१<br><br>आसादित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಡಿಯಲ್ಪಟ್ಟ /ಆಕ್ರಮಿಸಲ್ಪಟ್ಟ<br><br>आसादित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ತರಲ್ಪಟ್ಟ<br><br>आसादित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇರಲ್ಪಟ್ಟ<br><br>

आसाद्य
आसाद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + षद्लृ (विशरणादौ) + णिच् - "यत्" (३-१-९७)<br><b>प्रयोगाः - </b>"न हीष्टमस्य त्रिदिवेऽपि भूपतेरभूदनासाद्यमधिज्यधन्वनः"<br><b>उल्लेखाः - </b>रघु० ३-६<br><br>आसाद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ತರಲ್ಪಡುವ<br><br>आसाद्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿ /ಪಡೆದು<br><b>निष्पत्तिः - </b>आ + षद्लृ (विशरणादौ) + णिच् - "ल्यप्" (७-१-३७)<br><b>प्रयोगाः - </b>"आसाद्य वाचं स भृशं दिदीपे"<br><b>उल्लेखाः - </b>किरा० ३-५५<br><br>

आसार
आसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇಗವಾದ ಮಳೆ<br><br>आसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನ ಧಾರೆ<br><b>निष्पत्तिः - </b>आ + सृ (गतौ) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"आसारसिक्तक्षितिबाष्पयोगान्मामक्षिणोद्यत्र विभिन्नकोशैः"<br><b>उल्लेखाः - </b>किरा० ४-३५<br><br>आसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹರಡಿಕೊಳ್ಳುವುದು<br><br>आसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೈನ್ಯವು ಎಲ್ಲಾ ಕಡೆಯಲ್ಲೂ ಹರಡಿಕೊಳ್ಳುವುದು<br><br>आसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಿತ್ರ ಸೈನ್ಯ<br><b>विस्तारः - </b>"स्यादासारः प्रसरणे वेगवृष्टौ सुहृद्बले" - मेदि० ।<br><br>आसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ವಾದಶರಾಜರ ಪೈಕಿ ಒಬ್ಬ<br><br>

आसिक
आसिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತಿಯಿಂದ ಯುದ್ಧ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-५७)<br><b>व्युत्पत्तिः - </b>असिः प्रहरणमस्य<br><br>

आसिका
आसिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಳಿತುಕೊಳ್ಳುವಿಕೆ<br><b>निष्पत्तिः - </b>आस (उपवेशने) - "ण्वुच्" (३-३-१११)<br><b>प्रयोगाः - </b>"दुरीश्वरद्वारबहिर्वितर्दिकादुरासिकायै रचितोऽयमञ्जलिः"<br><b>उल्लेखाः - </b>वै० प०<br><br>आसिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಮದಿಂದ ಕುಳಿತುಕೊಳ್ಳುವುದು<br><br>

आसिक्त
आसिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಸಿಂಪಿಸಲ್ಪಟ್ಟ<br><br>आसिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಸಿಂಪಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + षिच (क्षरणे) - "क्तः" (३-२-१०२)<br><br>

आसिधार
आसिधार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಿಧಾರೆಯ ಮೇಲೆನಿಲ್ಲುವುದಕ್ಕೆ ಸಮಾನವಾದ ವ್ರತ<br><b>निष्पत्तिः - </b>"अण्" (५-३-१०७)<br><b>व्युत्पत्तिः - </b>असिधारेव<br><b>प्रयोगाः - </b>"इयन्ति वर्षाणि तया सहोग्रमभ्यस्यतीव व्रतमासिधाराम्"<br><b>उल्लेखाः - </b>रघु० १३-६७<br><br>

आसिद्ध
आसिद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿವಾದಿ /ವಾದಿಯಿಂದ ತಡೆಯಲ್ಪಟ್ಟವನು<br><b>निष्पत्तिः - </b>आ + षिध (गत्याम्) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"नासिद्धस्तं विलङ्घयेत्"<br><b>उल्लेखाः - </b>नारदः<br><br>

आसीन
आसीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಳಿತಿರುವ<br><b>निष्पत्तिः - </b>आस (उपवेशने) - "शानच्" (३-२-१२४) । ईत् (७-२-८३)<br><b>प्रयोगाः - </b>"आसीना तटभुवि सस्मितेन रम्भोरूरवतरितुं सरस्यनिच्छुः"<br><b>उल्लेखाः - </b>माघ० ८-१९<br><br>

आसुत्
आसुत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮದ್ಯವನ್ನು ಇಳಿಸುವ<br><b>निष्पत्तिः - </b>आ + षुञ् (अभिषवे) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>आसुनोति<br><br>

आसुति
आसुति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೋಮಲತೆಯನ್ನು ಹಿಂಡಿ ರಸ ತೆಗೆಯುವಿಕೆ<br><br>आसुति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭಟ್ಟಿ ಇಳಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + षुञ् (अभिषवे) - "क्तिन्" (३-३-९४)<br><br>आसुति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಸವ /ಹೆರಿಗೆ<br><br>

आसुतीवल
आसुतीवल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಜ್ಞಿಕ /ಸೋಮಲತೆಯನ್ನು ಹಿಂಡಿ ರಸ ತೆಗೆಯುವವನು<br><br>आसुतीवल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯವನ್ನು ತಯಾರಿಸುವವನು<br><b>निष्पत्तिः - </b>"वलच्" (५-२-११२)<br><b>व्युत्पत्तिः - </b>आसुतिरस्यास्ति<br><br>

आसुर
आसुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಸುರಧರ್ಮದಿಂದ ಮಾಡುವ ವಿವಾಹ /೮ ವಿಧ ವಿವಾಹಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"ज्ञातिभ्यो द्रविणं दत्वा कन्यायै चैव शक्तितः । कन्याप्रदानं स्वाच्छन्द्यादासुरो धर्म उच्यते ॥"<br><b>उल्लेखाः - </b>मनु० ३-३१<br><br>आसुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಕ್ಷಸ<br><br>आसुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸುರ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>असुरस्येदम्<br><b>प्रयोगाः - </b>"आसुरे लोकवित्रासविधायिनि महाहवे"<br><b>उल्लेखाः - </b>किरा० १५-२८<br><br>आसुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸುರರಂತೆ ಭಯಂಕರ ಕೃತ್ಯವುಳ್ಳ<br><b>प्रयोगाः - </b>"द्वौ भूतसर्गौ लोकेऽस्मिन् दैव आसुर एव च । दैवो विस्तरशः प्रोक्त आसुरं पार्थ मे श्रुणु ॥"<br><b>उल्लेखाः - </b>गीता० १६-६<br><br>

आसुरी
आसुरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಸುರೀ ಸಂಪತ್ತು /ದುರ್ಗತಿಯನ್ನು ಹೊಂದಲು ಅರ್ಹವಾದ ಸ್ವಭಾವ<br><b>प्रयोगाः - </b>"दम्भो दर्पोऽभिमानश्च क्रोधः पारुष्यमेव च । अज्ञानं चाभिजातस्य पार्थ सम्पदमासुरीम् ॥"<br><b>उल्लेखाः - </b>गीता० १६-४<br><br>आसुरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಸ್ತ್ರಚಿಕಿತ್ಸೆ<br><br>आसुरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿಸಾಸುವೆ /ರಾಜಸಾಸುವೆ<br><br>

आसुरत्व
आसुरत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞಯಾಗಾದಿಗಳನ್ನು ಮಾಡದಿರುವವನು ಧನ<br><b>व्युत्पत्तिः - </b>आसुरस्य स्वम्<br><b>प्रयोगाः - </b>"अयज्वनां तु यद्द्रव्यमासुरस्त्वं तदुच्यते"<br><b>उल्लेखाः - </b>मनु० ११-२०<br><br>

आसेक
आसेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರನ್ನು ಚಿಮುಕಿಸುವುದು<br><b>निष्पत्तिः - </b>आ + षिच (क्षरणे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"शीतानि बलवदुपेयुषेव नीरैरासेकाच्छिशिरसमीरकम्पितेन"<br><b>उल्लेखाः - </b>माघ० ८-६२<br><br>

आसेचन
आसेचन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಷ್ಟು ನೋಡಿದರೂ ಮನಸ್ಸನ್ನು ತೃಪ್ತಿ ಪಡಿಸದ ವಸ್ತು<br><b>निष्पत्तिः - </b>आ + षिच (क्षरणे) - "ल्युट्" (३-३-११७) । "अण्" (५-४-३८)<br><b>व्युत्पत्तिः - </b>सिच्यते मनोऽत्र । न सेचनम् ।<br><br>आसेचन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಮುಕಿಸುವುದು<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>आसेचन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರನ್ನು ಚಿಮುಕಿಸುವ ಪಾತ್ರೆ<br><b>निष्पत्तिः - </b>कर० "ल्युट्" (३-३-११७)<br><br>

आसेचनी
आसेचनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आसेचन ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

आसेचनक
आसेचनक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಷ್ಟು ನೋಡಿದರೂ ಮನಸ್ಸನ್ನು ತೃಪ್ತಿ ಪಡಿಸದ ವಸ್ತು<br><b>निष्पत्तिः - </b>आ + षिच (क्षरणे) - "ल्युट्" (३-३-११७) । "अण्" (५-४-३८) । सञ्ज्ञायां "कन्" (५-३-७५)<br><b>व्युत्पत्तिः - </b>सिच्यते मनोऽत्र । न सेचनम् ।<br><b>प्रयोगाः - </b>"आत्तदेहमिव स्वर्गमासेचनकदर्शनम्"<br><b>उल्लेखाः - </b>याद० १६-३<br><br>

आसेदिवस्
आसेदिवस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿರುವ /ಪಡೆದಿರುವ<br><b>निष्पत्तिः - </b>आ + षद्लृ (विशरणादौ) - "क्वसुः" (३-२-१०८)<br><br>आसेदिवस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಬಂದಿರುವ<br><b>प्रयोगाः - </b>"आसेदुषां गोत्रभिदोऽनुवृत्त्या गोपायकानां भुवनत्रयस्य"<br><b>उल्लेखाः - </b>किरा० १८-१८<br><br>

आसेदुषी
आसेदुषी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आसेदिवस् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><b>प्रयोगाः - </b>"आसेदुषीं सादितशत्रुपक्षां बालामबालेन्दुमुखीं बभाषे"<br><b>उल्लेखाः - </b>रघु० ६-५३<br><br>

आसेद्धृ
आसेद्धृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನ್ಯಾಯಾಸ್ಥಾನದ ಅಪ್ಪಣೆಯಂತೆ ಪ್ರತಿವಾದಿಯನ್ನು ತಡೆದು ನಿಲ್ಲಿಸುವವನು<br><b>निष्पत्तिः - </b>आ + षिध (गत्याम्) - "तृच्" (३-१-१३३)<br><br>

आसेध
आसेध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿವಾದಿಯನ್ನು ತಡೆದು ನಿಲ್ಲಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + षिध (गत्याम्) - "घञ्" (३-३-१८)<br><br>

आसेवन
आसेवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿರಂತರವಾದ ಸೇವೆ<br><b>निष्पत्तिः - </b>आ + षेवृ (सेवायाम्) - "ल्युट्" (३-३-११५)<br><br>आसेवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೌನಃಪುನ್ಯ /ಪುನರಾವೃತ್ತಿ<br><b>विस्तारः - </b>"निसस्तपतावनासेवने" (८-३-१०२) । आसेचनं पौनःपुन्यम् - सि० कौ० ।<br><br>

आसेवा
आसेवा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आसेवन ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>आ + षेवृ (सेवायाम्) - "अङ्" (३-३-१०६)<br><b>प्रयोगाः - </b>"आयुक्तकुशलाभ्यामासेवायाम्"<br><br>

आसेवित
आसेवित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಸೇವಿಸಲ್ಪಟ್ಟ<br><br>आसेवित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುನಃ ಪುನಃ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + षेवृ (सेवायाम्) - "क्तः" (३-२-१०२)<br><br>

आसेवितिन्
आसेवितिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಸೇವಿಸುವ<br><br>आसेवितिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮತ್ತೆ ಮತ್ತೆ ಸೇವಿಸುವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-८८)<br><b>व्युत्पत्तिः - </b>आसेवितमनेन<br><br>

आसेवितिनी
आसेवितिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आसेवितिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आस्कन्द
आस्कन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರುವುದು<br><br>आस्कन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುತ್ತಿಗೆ /ಆಕ್ರಮಣ<br><b>निष्पत्तिः - </b>आ + स्कदिर् (गतिशोषणयोः) - "घञ्" (३-३-१८)<br><br>आस्कन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರ<br><br>आस्कन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಣಗುವುದು<br><br>आस्कन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಒಂದು ವಿಧ ನಾಗಾಲೋಟ<br><br>

आस्कन्दन
आस्कन्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ /ಕದನ<br><b>निष्पत्तिः - </b>आ + स्कदिर् (गतिशोषणयोः) - अधि० "ल्युट्" (३-३-११७)<br><br>आस्कन्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರ<br><br>आस्कन्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಣಗಿಸುವುದು<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>आस्कन्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಣ<br><b>प्रयोगाः - </b>"विचकर्ष च संहितेषुरुच्चैश्चरणास्कन्दननामिताचलेन्द्रः"<br><b>उल्लेखाः - </b>किरा० १३-१८<br><b>विस्तारः - </b>"आस्कन्दनं तिरस्कारे रणे संशोषणेऽपि च" - मेदि० ।<br><br>

आस्कन्दित
आस्कन्दित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಒಂದು ವಿಧ ನಾಗಾಲೋಟ<br><b>निष्पत्तिः - </b>आ + स्कदिर् (गतिशोषणयोः) + णिच् - "क्तः" (३-३-११४)<br><br>आस्कन्दित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಿಸಲ್ಪಟ್ಟ<br><br>आस्कन्दित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಣಗಿಸಲ್ಪಟ್ಟ<br><br>आस्कन्दित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಮಾನಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>

आस्कन्दिन्
आस्कन्दिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಣ ಮಾಡುವ<br><b>निष्पत्तिः - </b>आ + स्कदिर् (गतिशोषणयोः) - "णिनिः" (३-२-७८)<br><b>प्रयोगाः - </b>"न हि सिंहो गजास्कन्दी भयाद्गिरिगुहाशयः"<br><b>उल्लेखाः - </b>रघु० १७-५२<br><br>

आस्तर
आस्तर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಬೆನ್ನಿನ ಮೇಲೆ ಹೊದಿಸುವ ರತ್ನಗಂಬಳಿ /ಕವುದಿ<br><b>निष्पत्तिः - </b>आ + स्तॄञ् (आच्छादने) - कर्म० "अप्" (३-३-५७)<br><br>आस्तर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರತ್ನಗಂಬಳಿ<br><br>आस्तर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಪೆ /ಮಂದಲಿಗೆ<br><br>आस्तर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹರಡುವಿಕೆ<br><b>निष्पत्तिः - </b>भावे "अप्" (३-३-५७)<br><br>

आस्तरण
आस्तरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಪೆ /ಮಂದಲಿಗೆ<br><br>आस्तरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರತ್ನಗಂಬಳಿ<br><br>आस्तरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಸಿಗೆ<br><b>निष्पत्तिः - </b>आ + स्तॄञ् (आच्छादने) - "ल्युट्" (३-३-११३)<br><b>व्युत्पत्तिः - </b>आस्तीर्यते<br><b>प्रयोगाः - </b>"तमालपत्रास्तरणासु रन्तुं प्रसीद शश्वन्मलयस्थलीषु"<br><b>उल्लेखाः - </b>रघु० ६-६४<br><br>आस्तरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹರಡುವಿಕೆ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>आस्तरण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಾಪೆ ಮುಂತಾದುವುಗಳ ಮೇಲೆ ಕೊಡಲ್ಪಡುವ<br><br>आस्तरण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಾಪೆ ಮುಂತಾದುವುಗಳ ಮೇಲೆ ಮಾಡಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>"अण्" (५-१-९७)<br><b>व्युत्पत्तिः - </b>आस्तरणे दीयते कार्यं वा<br><br>

आस्तरण
आस्तरण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾಗದಲ್ಲಿ ದರ್ಭೆಯನ್ನು ಸಾಲಾಗಿ ಹರಡುವವನು<br><b>निष्पत्तिः - </b>आ + स्तॄञ् (आच्छादने) - कर्त० "ल्युः" (३-१-१३४)<br><br>

आस्तरणिक
आस्तरणिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಾಸುವುದಕ್ಕೆ ಉಪಯೋಗವಾದ ಬಟ್ಟೆ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-१०९)<br><b>व्युत्पत्तिः - </b>आस्तरणं प्रयोजनमस्य<br><br>

आस्तार
आस्तार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹರಡುವುದು<br><b>निष्पत्तिः - </b>आ + स्तॄञ् (आच्छादने) - भावे "घञ्" (३-३-१८)<br><b>व्युत्पत्तिः - </b>आस्तीर्यते<br><br>

आस्ताव
आस्ताव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗ /ಯಜ್ಞ<br><br>आस्ताव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗದಲ್ಲಿ ಮಂತ್ರವನ್ನು ಪಠಿಸುವ ಪ್ರದೇಶ<br><b>निष्पत्तिः - </b>आ + ष्टुञ् (स्तुतौ) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>आस्तुवन्त्यत्र<br><br>आस्ताव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂತ್ರಗಳ ಪಠನ /ಸ್ತುತಿ<br><b>निष्पत्तिः - </b>भावे "घञ्" (३-३-१८)<br><br>

आस्तिक
आस्तिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜರತ್ಕಾರು ಮುನಿಯ ಮಗ ಆಸ್ತಿಕ ಋಷಿ<br><br>आस्तिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೇವರು ಪರಲೋಕ ಶಾಸ್ತ್ರಗಳು ಇವುಗಳಲ್ಲಿ ನಂಬಿಕೆಯುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-६०)<br><b>व्युत्पत्तिः - </b>अस्ति परलोक इति मतिर्यस्य<br><br>

आस्तिक्य
आस्तिक्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವರಲ್ಲಿ ವಿಶ್ವಾಸ /ಶಾಸ್ತ್ರಗಳಲ್ಲಿ ನಂಬಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>आस्तिकस्य भावः<br><b>प्रयोगाः - </b>"आस्तिक्यशुद्धमवतः प्रियधर्म धर्मं धर्मात्मजस्य विहितागसि शत्रुवर्गे"<br><b>उल्लेखाः - </b>किरा० १८-४३<br><br>

आस्तीर्ण
आस्तीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"आस्तिीर्णतल्परचितावसथः क्षणेन वेश्यायनः कृतनवप्रतिकर्मकाम्यः"<br><b>उल्लेखाः - </b>माघ० ५-२७<br><br>

आस्तृत
आस्तृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + स्तॄञ् (आच्छादने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आस्तृतेऽभिनवपल्लवपुष्पैरप्यनारतरताभिरताभ्यः"<br><b>उल्लेखाः - </b>माघ० १०-८९<br><br>

आस्था
आस्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆ /ಅಭಿಲಾಷೆ<br><b>निष्पत्तिः - </b>आ + ष्ठा (गतिनिवृत्तौ) - "अङ्" (३-३-१०६)<br><br>आस्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆದರ /ಗೌರವ<br><b>प्रयोगाः - </b>"दैवात्सर्गादवध्यत्वं मर्त्येष्वास्थापराङ्मुखः"<br><b>उल्लेखाः - </b>रघु० १०-४३<br><br>आस्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯತ್ನ /ಪ್ರಯತ್ನ<br><b>प्रयोगाः - </b>"आस्थामालम्ब्य नीतेषु वशं क्षुद्रेष्वरातिषु"<br><b>उल्लेखाः - </b>किरा० १५-४<br><br>आस्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುರಾಗ /ಪ್ರೀತಿ<br><br>आस्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಭೆ /ಆಸ್ಥಾನ<br><br>आस्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಲಂಬನ /ಆಧಾರ<br><b>विस्तारः - </b>"आअस्थानी यत्नयोरास्था" - अम० । "आस्थात्वालम्बनास्थानयत्नापेक्षासु योषिति" - मेदि० ।<br><br>आस्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಿತಿ /ಅವಸ್ಥೆ<br><br>

आस्थान
आस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಭೆ /ಆಸ್ಥಾನ<br><b>निष्पत्तिः - </b>आ + ष्ठा (गतिनिवृत्तौ) - अधि० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>आस्थीयतेऽत्र<br><b>प्रयोगाः - </b>"अनेकराजन्यरथाश्वसङ्कुलं तदीयमास्थाननिकेतनाजिरम्"<br><b>उल्लेखाः - </b>किरा० १-१६<br><br>आस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶ್ರಾಂತಿಸ್ಥಾನ<br><br>आस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರದ್ಧೆ /ಆಸಕ್ತಿ<br><br>आस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಸ್ಥೆ /ಅವಸ್ಥೆ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

आस्थानी
आस्थानी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಭೆ /ಆಸ್ಥಾನ<br><b>निष्पत्तिः - </b>आ + ष्ठा (गतिनिवृत्तौ) - अधि० "ल्युट्" (३-३-११७) । "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>आतिष्ठन्त्यस्याम्<br><br>

आस्थापन
आस्थापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸರಿಯಾಗಿ ಇಡುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + ष्ठा (गतिनिवृत्तौ) + णिच् - "ल्युट्" (३-३-११५)<br><br>आस्थापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಸ್ತಿಕ್ರಿಯೆ ಪಿಚಕಾಣಿ ಹೊಡೆಯುವುದು /ದೇಹದೊಳಗಿನ ಶುದ್ಧಿಗಾಗಿ ಮಾಡುವ ಒಂದು ವಿಧ ಚಿಕಿತ್ಸೆ<br><br>

आस्थापित
आस्थापित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಇಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + ष्ठा (गतिनिवृत्तौ) + णिच् - "क्तः" (३-२-१०२)<br><br>

आस्थित
आस्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + ष्ठा (गतिनिवृत्तौ) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"उपतस्थुरास्थितविषादधियः"<br><b>उल्लेखाः - </b>किरा० ६-२९<br><br>आस्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"श्वगणिवागुरिकैः प्रथमास्थितं व्यपगतानलदस्यु विवेश सः"<br><b>उल्लेखाः - </b>रघु० ९-५३<br><br>आस्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಪ್ತವಾದ<br><b>प्रयोगाः - </b>"आस्थितः स्थगितवारिदपङ्क्त्या सन्ध्यया गगनपश्चिमभागः"<br><b>उल्लेखाः - </b>किरा० ९-९<br><br>आस्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿದ /ಏರಿದ<br><b>प्रयोगाः - </b>"स्निग्धगम्भीरनिर्घोषमेकं स्यन्दनमास्थितौ"<br><b>उल्लेखाः - </b>रघु० १-३६<br><br>आस्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿದ<br><b>प्रयोगाः - </b>"उपायमस्थितस्यापि नश्यन्त्यर्थाः प्रमाद्यतः"<br><b>उल्लेखाः - </b>माघ० २-८०<br><br>आस्थित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇರುವಿಕೆ /ಸ್ಥಿತಿ<br><b>निष्पत्तिः - </b>भावे "क्तः" (३-३-११४)<br><br>

आस्थिति
आस्थिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇರುವಿಕೆ /ಸ್ಥಿತಿ<br><br>आस्थिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಸ್ಥೆ /ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>आ + ष्ठा (गतिनिवृत्तौ) - "क्तिन्" (३-३-९४)<br><br>

आस्पद
आस्पद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಾನ /ಎಡೆ /ಜಾಗ<br><b>व्युत्पत्तिः - </b>आपद्यतेऽत्र<br><b>प्रयोगाः - </b>"नतभ्रुवो मण्डयति स्म विग्रहे बलिक्रिया चातिलकं तदास्पदम्"<br><b>उल्लेखाः - </b>किरा० ८-५२<br><br>आस्पद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸಸ್ಥಳ<br><b>प्रयोगाः - </b>"आस्पदं त्वमसि सर्वसम्पदम्"<br><b>उल्लेखाः - </b>किरा० १३-३९<br><br>आस्पद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ /ಅವಲಂಬನ<br><br>आस्पद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೃತ್ತಿ /ಉದ್ಯೋಗ /ವ್ಯಾಪಾರ<br><br>आस्पद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಷ್ಠೆ<br><b>प्रयोगाः - </b>"लब्धास्पदोऽस्मीति विवादभीरोस्तितिक्षमाणस्य परेण निन्दाम्"<br><b>उल्लेखाः - </b>माल० १-१७<br><br>आस्पद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಯ<br><b>प्रयोगाः - </b>"उक्तानुक्तास्पदाद्यात्र सिद्धासिद्धास्पदे परे"<br><b>उल्लेखाः - </b>चन्द्रा०<br><br>आस्पद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಗ್ನದಿಂದ ೧೦ನೆಯ ಸ್ಥಾನ<br><br>

आस्फाल
आस्फाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡಿಸುವಿಕೆ<br><br>आस्फाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಕಿವಿಯನ್ನಾಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + स्फुल (सञ्चलने) - "घञ्" (३-३-१८० । आत्वम् (६-१-४७)<br><br>

आस्फालन
आस्फालन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಡೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + स्फुल (सञ्चलने) + णिच् - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"ऐरावतास्फालनकर्कशेन हस्तेन पर्स्पर्श तदङ्गमिन्द्रः"<br><b>उल्लेखाः - </b>कुमा० ३-२२<br><br>आस्फालन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡಿಸುವಿಕೆ<br><br>आस्फालन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದರ್ಪ /ಗರ್ವ /ಅಹಂಕಾರ<br><br>

आस्फालित
आस्फालित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಡೆಯಲ್ಪಟ್ಟ<br><br>आस्फालित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಲಿಸುವಂತೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + स्फुल (सञ्चलने) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अजस्रमास्फालितवल्लकोगुणक्षतोज्ज्वलाङ्गुष्ठनखांशुभिन्नया"<br><b>उल्लेखाः - </b>माघ० १-९<br><br>

आस्फोट
आस्फोट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಕ್ಕದ ಗಿಡ<br><br>आस्फोट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೀರಪುರುಷರು ತೋಳು ತಟ್ಟುವ ಶಬ್ದ<br><br>आस्फोट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಡೆತ ಏಟು ತಿಕ್ಕಾಟ ಇವುಗಳಿಂದ ಆಗುವ ಶಬ್ದ<br><b>निष्पत्तिः - </b>आ + स्फुट (विकसने) - "घञ्" (३-३-१८)<br><br>

आस्फोटन
आस्फोटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭುಜಗಳನ್ನು ತಟ್ಟಿ ಶಬ್ದ ಮಾಡುವಿಕೆ<br><br>आस्फोटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡಿಸುವಿಕೆ<br><br>आस्फोटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಡೆಯುವುದು<br><br>आस्फोटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊರದಿಂದ ಧಾನ್ಯವನ್ನು ಒನೆಯುವುದು<br><br>आस्फोटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸುವುದು<br><br>आस्फोटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಡೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + स्फुटिर् (विकसने) - भावे "ल्युट्" (३-३-११५)<br><br>

आस्फोटनी
आस्फोटनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೈರಿಗೆ /ಮರಕ್ಕೆ ರಂಧ್ರಮಾಡುವ ಸಾಧನ /ತೂತು ಕೊರೆಯುವ ಹಿಡಿಸರಳು<br><b>निष्पत्तिः - </b>आ + स्फुट (भेदने) + णिच् - "ल्युट्" (३-३-११५) । "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>आस्फोट्यतेऽनया<br><br>

आस्फोटित
आस्फोटित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸಿಕೊಳ್ಳುವುದು<br><br>आस्फोटित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೋಳುಗಳನ್ನು ಅಪ್ಪಳಿಸುವುದು<br><b>निष्पत्तिः - </b>आ + स्फुट (भेदने) + णिच् - भावे "क्तः" (३-३-११४)<br><br>आस्फोटित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊರೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + स्फुट (भेदने) + णिच् - कर्म० "क्तः" (३-२-१०२)<br><br>

आस्फोत
आस्फोत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಕ್ಕದ ಗಿಡ<br><br>आस्फोत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಗಾಂಚಾಳದ ಗಿಡ<br><br>आस्फोत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುತ್ತುಗದ ಮರ<br><br>

आस्फोता
आस्फोता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣುಕ್ರಾಂತಿ ಗಿಡ<br><br>आस्फोता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೊಗದೆ ಗಿಡ<br><br>आस्फोता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಮಲ್ಲಿಗೆ ಗಿಡ<br><br>

आस्माक
आस्माक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಮ್ಮ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०) । अस्माकादेशः (४-३-२)<br><b>व्युत्पत्तिः - </b>अस्माकमिदम्<br><b>प्रयोगाः - </b>"आस्माकदन्तिसान्निध्याद्वामनीभूतरुहः"<br><b>उल्लेखाः - </b>माघ० २-६३<br><br>

आस्माकी
आस्माकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಮ್ಮ ಸಂಬಂಧವಾದ<br><b>प्रयोगाः - </b>"आस्माकी युवतिदृशामसौ तनोति च्छायैव श्रियमनपायिनीं किमेभिः"<br><b>उल्लेखाः - </b>माघ० ८-५०<br><br>

आस्माकीन
आस्माकीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಮ್ಮ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"खञ्" (४-३-१) । अस्माकादेशः (४-३-२)<br><b>व्युत्पत्तिः - </b>अस्माकमिदम्<br><br>

आस्य
आस्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಖ /ಬಾಯಿ<br><b>निष्पत्तिः - </b>असु (क्षेपणे) - "ण्यत्" (३-१-१२४)<br><b>व्युत्पत्तिः - </b>अस्यन्ते वर्णा अनेन अस्यते ग्रासोऽस्मिन् वा<br><b>प्रयोगाः - </b>"यस्यास्येन सदाश्नन्ति हव्यानि त्रिदिवौकसः"<br><b>उल्लेखाः - </b>मनु० १-९५<br><br>आस्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಣೆ ಮುಖದ ಮಧ್ಯಭಾಗ<br><br>आस्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದವಡೆ /ತಾಲು ಮೊದಲಾದ ಪ್ರದೇಶ<br><b>निष्पत्तिः - </b>"यत्" (५-१-६)<br><b>व्युत्पत्तिः - </b>आस्ये भवम्<br><b>विस्तारः - </b>"मुखं मुखान्तरालं च द्वयमास्यमुदाहृतम्" - शाश्व० ।<br><br>

आस्यन्धय
आस्यन्धय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧರಾಮೃತವನ್ನು ಪಾನ ಮಾಡುವ<br><b>निष्पत्तिः - </b>धेट् (पाने) - "शः" (३-१-१३७)<br><b>व्युत्पत्तिः - </b>आस्यं धयति<br><br>

आस्यलोमन्
आस्यलोमन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಾಡಿ /ಗಡ್ಡ<br><b>व्युत्पत्तिः - </b>आस्यस्य लोम<br><br>

आस्या
आस्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇರುವಿಕೆ /ಸ್ಥಿತಿ<br><b>निष्पत्तिः - </b>आस (उपवेशने) - "ण्यत्" (३-३-११३)<br><b>विस्तारः - </b>"स्थितावास्या च विश्रुता" - विश्व० ।<br><br>

आस्यासव
आस्यासव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೊಲ್ಲು /ಲಾಲಾಜಲ<br><b>व्युत्पत्तिः - </b>आस्यस्यासव इव<br><br>

आस्र
आस्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ತ<br><b>निष्पत्तिः - </b>स्वार्थे "अण्" (५-४-३८)<br><b>व्युत्पत्तिः - </b>अस्रमेव<br><br>

आस्रप
आस्रप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಕ್ಷಸ<br><b>निष्पत्तिः - </b>पा (पाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>आस्रं पिबति<br><br>आस्रप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಕ್ಷಸ ದೇವತಾಕವಾದ ಮೂಲಾನಕ್ಷತ್ರ<br><br>

आस्रव
आस्रव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ಲೇಶ /ತೊಂದರೆ /ಕಷ್ಟ<br><b>निष्पत्तिः - </b>स्रु (गतौ) - "अप्" (३-३-५७)<br><b>व्युत्पत्तिः - </b>आस्रवति मनोऽनेन<br><br>

आस्राव
आस्राव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಯ /ಹುಣ್ಣು<br><b>निष्पत्तिः - </b>आ + स्रु (गतौ) - अपादाने "घञ्" (३-३-१९)<br><b>प्रयोगाः - </b>"जात एव तवास्रावः त्वन्तु मोहान्न बुध्यसे"<br><br>आस्राव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ರವಿಸುವಿಕೆ<br><br>आस्राव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಲಾಜಲ<br><br>आस्राव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೊಂದರೆ /ಕ್ಲೇಶ<br><br>आस्राव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೋರುವ<br><b>निष्पत्तिः - </b>आ + स्रु (गतौ) - "णः᳚ (३-१-१४१)<br><br>

आस्वाद
आस्वाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಸವನ್ನು ಕುಡಿಯುವುದು<br><br>आस्वाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿನ್ನುವುದು<br><b>निष्पत्तिः - </b>आ + ष्वद (आस्वादने) - "घञ्" (३-३-१८)<br><b>व्युत्पत्तिः - </b>आसाद्यते<br><b>प्रयोगाः - </b>"चूताङ्कुरास्वादकषायकण्ठः"<br><b>उल्लेखाः - </b>कुमा० ३-३२<br><br>आस्वाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರುಚಿ /ಸವಿ<br><b>प्रयोगाः - </b>"ज्ञातास्वादो विवृतजघनां को विहातुं समर्थः"<br><b>उल्लेखाः - </b>मेघ० १-४१<br><br>आस्वाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೃಂಗಾರಾದಿ ರಸಗಳು<br><br>आस्वाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಿಹಿ ಮೊದಲಾದ ೬ ಭೋಜ್ಯರಸಗಳು<br><b>निष्पत्तिः - </b>आ+ ष्वद (आस्वादने) - कर्म० "घञ्" (३-३-१९)<br><br>

आस्वादक
आस्वादक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರುಚಿ ನೋಡುವವನು<br><b>निष्पत्तिः - </b>आ + ष्वद (आस्वादने) -"ण्वुल्" (३-१-१३३)<br><br>

आस्वादन
आस्वादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರುಚಿ ನೋಡುವುದು<br><b>निष्पत्तिः - </b>आ + ष्वद (आस्वादने) - "ल्युट्" (३-३-११५)<br><br>

आस्वादयत्
आस्वादयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರುಚಿ ನೋಡುತ್ತಲಿರುವ<br><br>आस्वादयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾನ ಮಾಡುತ್ತಲಿರುವ<br><b>निष्पत्तिः - </b>आ + ष्वद (आस्वादने) + णिच् - "शतृ" (३-२-१२४)<br><br>आस्वादयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಸವತ್ತಾದ /ರುಚಿಕರವಾದ<br><b>प्रयोगाः - </b>"आस्वादयद्भिः कबलैस्तृणानां कण्डूयनैर्दंशनिवारणैश्च"<br><b>उल्लेखाः - </b>रघु० २-५<br><br>

आस्वादयन्ती
आस्वादयन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आस्वादयत् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><b>प्रयोगाः - </b>"आस्वादयन्त्यः सुदृशस्तदानीम्"<br><b>उल्लेखाः - </b>याद० १३-६९<br><br>

आस्वादित
आस्वादित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರುಚಿ ನೋಡಲ್ಪಟ್ಟ<br><br>आस्वादित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿನ್ನಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + ष्वद (आस्वादने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आस्वादितार्द्रक्रमुकाः समुद्रादभ्यागतस्य प्रतिपत्तुमीयुः"<br><b>उल्लेखाः - </b>माघ० ३-८१<br><br>

आस्वाद्य
आस्वाद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿನ್ನಲು ಯೋಗ್ಯವಾದ<br><br>आस्वाद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರುಚಿ ನೋಡಲು ಅರ್ಹವಾದ<br><b>निष्पत्तिः - </b>आ + ष्वद (आस्वादने) + णिच् - "यत्" (३-१-९७)<br><b>प्रयोगाः - </b>"आस्वाद्यतोयाः प्रवहन्ति नद्यः समुद्रमासाद्य भवन्त्यपेयाः"<br><b>उल्लेखाः - </b>हितो०<br><br>आस्वाद्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ರುಚಿ ನೋಡಿ<br><br>आस्वाद्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ತಿಂದು /ಅನುಭವಿಸಿ<br><b>प्रयोगाः - </b>"धृतराष्ट्रसुतेन सुत्यजाश्चि रमास्वाद्य नरेन्द्रसम्पदः"<br><b>उल्लेखाः - </b>किरा० २-१६<br><br>

आह
आह<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೇಳಿದನು<br><b>प्रयोगाः - </b>"अथाह वर्णी विदितो महेश्वरस्तदर्थिनी त्वं पुनरेव वर्तसे"<br><b>उल्लेखाः - </b>कुमा० ५-६५<br><br>

आहक
आहक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧವಾದ ಮೂಗಿನ ರೋಗ /ಮೂಗಿನ ಜ್ವರ<br><b>प्रयोगाः - </b>"तनुना रक्तशोधेन युक्तो नासापुटान्तरे । गात्रशूलज्वरकरः श्लेष्मणा ह्याहको ज्वरः ॥"<br><br>

आहत
आहत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಢಕ್ಕೆ /ನಗಾರಿ<br><b>निष्पत्तिः - </b>आ + हन (हिंसागत्योः) - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>आहन्यते<br><br>आहत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯವಹಾರವಿರುದ್ಧವಾದ<br><br>आहत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಳೆಯ ಬಟ್ಟೆ<br><br>आहत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಸಬಟ್ಟೆ<br><b>प्रयोगाः - </b>"ईषद्धौतं नवं शुभ्रं सदशं यन्न धारितम् । आहतं तद्विजानीयात् सर्वकर्मसु पावनम् ॥"<br><br>आहत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಏಟು /ಹೊಡೆತ<br><b>निष्पत्तिः - </b>भावे "क्तः" (३-३-११४)<br><b>प्रयोगाः - </b>"बाहुपीडनकचग्रहणाभ्यामाहतेन नखदन्तनिपातैः"<br><b>उल्लेखाः - </b>माघ० १०-७२<br><br>आहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಡೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आहतं कुचतटेन तरुण्याः साधु सोढममुनेति पपात"<br><b>उल्लेखाः - </b>माघ० १०-७४<br><br>आहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತುಳಿಯಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"पादाहतं यदुत्थाय मूर्धानमधिरोहति"<br><b>उल्लेखाः - </b>माघ० २-४६<br><br>आहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುಣಿಸಲ್ಪಟ್ಟ<br><br>आहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೀಡಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"तेनाहतास्त्रिदशसैन्यपदातयोऽपि"<br><b>उल्लेखाः - </b>कुमा० १७-३२<br><b>विस्तारः - </b>"आहतं गुणिते चापि ताडिते च मृषार्थके । स्यात् पुरातनवस्त्रेऽपि नववस्त्रे च नाऽनके" - मेदि० ।<br><br>

आहतलक्षण
आहतलक्षण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸದ್ಗುಣಗಳಿಂದ ಪ್ರಸಿದ್ಧನಾದವನು<br><b>व्युत्पत्तिः - </b>आहतं गुणितं लक्षणं यस्य<br><br>

आहति
आहति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಡೆತ /ಶಬ್ದವಾಗುವಂತೆ ಎರಡು ಪದರ್ಥಗಳ ಸಂಬಂಧ<br><b>निष्पत्तिः - </b>आ + हन (हिंसागत्योः) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"कृताहतिः कृष्णनिपातवेगादानद्धरूपा विततैस्तरङ्गैः"<br><b>उल्लेखाः - </b>याद० ४-११३<br><br>आहति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಏಟು /ಹೊಡೆತ<br><br>आहति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮರ್ದನ /ತುಳಿತ<br><br>आहति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಸುಕುವಿಕೆ<br><br>आहति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಣಾಕಾರ /ಹೆಚ್ಚಿಸುವುದು<br><br>आहति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಗಮನ<br><br>

आहनन
आहनन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಲು /ದೊಣ್ಣೆ<br><b>निष्पत्तिः - </b>आ + हन (हिंसागत्योः) - कर० "ल्युट्" (३-३-११७)<br><br>आहनन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಏಟು /ಹೊಡೆತ<br><br>आहनन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಣಾಕಾರ /ಹೆಚ್ಚಿಸುವುದು<br><br>आहनन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರ್ದನ /ತುಳಿತ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

आहर
आहर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತರುವ /ತೆಗೆದುಕೊಂಡು ಬರುವ<br><b>निष्पत्तिः - </b>आ + हृञ् (हरणे) - "अच्" (३-२-९)<br><b>प्रयोगाः - </b>"वनान्तरादुपावृत्तैः समित्कुशफलाहरैः"<br><b>उल्लेखाः - </b>रघु० १-४९<br><br>

आहरकरटा
आहरकरटा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಂಡು ಬಾ ಎಂದು ಕರಟಕ್ಕೆ ಕಾಗೆಗೆ ಅಪ್ಪಣೆ ಮಾಡುವ ಕೆಲಸ<br><b>निष्पत्तिः - </b>मयूर०<br><b>व्युत्पत्तिः - </b>आहर करट इत्युच्यते यस्यां क्रियायाम्<br><br>

आहरचेटा
आहरचेटा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಂಡು ಬಾ ಎಂದು ಕರಟಕ್ಕೆ ಸೇವಕನಿಗೆ ಅಪ್ಪಣೆ ಮಾಡುವ ಕೆಲಸ<br><b>निष्पत्तिः - </b>मयूर०<br><b>व्युत्पत्तिः - </b>आहर चेट इत्युच्यते यस्यां क्रियायाम्<br><br>

आहरण
आहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತರುವುದು /ಒಯ್ಯುವುದು<br><b>निष्पत्तिः - </b>आ + हृञ् (हरणे) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"राजन्, समिदाहरणाय प्रस्थिता वयम्"<br><b>उल्लेखाः - </b>शाकु० १<br><br>आहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಳ್ಳುವುದು /ಕಸಿದುಕೊಳ್ಳುವುದು<br><b>प्रयोगाः - </b>"वातोऽपि नास्रंसयदंशुकानि को लम्बयेदाहरणाय हस्तम्"<br><b>उल्लेखाः - </b>रघु० ६-७५<br><br>आहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಷ್ಠಾನ<br><b>प्रयोगाः - </b>"अश्वमेधस्य कौरव्य चकारहरणे मतिम्"<br><b>उल्लेखाः - </b>भा०<br><br>आहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹಕಾಲದಲ್ಲಿ ಕನ್ಯೆಗೆ ಕೊಡುವ ಬಳುವಳಿ<br><b>प्रयोगाः - </b>"सत्त्वानुरूपाहरणीकृतश्रीः"<br><b>उल्लेखाः - </b>रघु० ७-३२<br><br>

आहव
आहव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ /ಕದನ<br><b>निष्पत्तिः - </b>आ + ह्वेञ् (स्पर्धायां शब्दे च० - "अप्" (३-३-७३)<br><b>व्युत्पत्तिः - </b>आहूयते रिपुरत्र<br><b>प्रयोगाः - </b>"न च श्रेयोऽनुपश्यामि हत्वा स्वजनमाहवे"<br><b>उल्लेखाः - </b>गीता० १-३१<br><br>आहव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞ /ಯಾಗ<br><b>निष्पत्तिः - </b>आ + हु (दानादनयोः) - "अप्" (३-३-५७)<br><b>प्रयोगाः - </b>"तत्र नाभवदसौ महाहवे शात्रवादिव पराङ्मुखोऽर्थिनः"<br><b>उल्लेखाः - </b>माघ० १४-४४<br><br>

आहवनीय
आहवनीय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂರು ವಿಧ ಅಗ್ನಿಗಳಲ್ಲೊಂದು<br><b>निष्पत्तिः - </b>आ + हु (दानादनयोः) - "अनीयर्" (३-१-९६)<br><b>व्युत्पत्तिः - </b>आहूयते प्रक्षिप्यते हविरत्र<br><b>प्रयोगाः - </b>"गुरुराहवनीयस्तु साग्नित्रेता गरीयसी"<br><b>उल्लेखाः - </b>मनु० २-२३१<br><br>

आहार
आहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೋಜನ /ಊಟ<br><b>निष्पत्तिः - </b>आ + हृञ् (हरणे) - "घञ्" (३-३-१८)<br><br>

आहार्य
आहार्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಟ್ಯಶಾಸ್ತ್ರದಲ್ಲಿ ವೇಷಾದಿಗಳಿಂದ ಮಾಡುವ ಅಭಿನಯ<br><b>प्रयोगाः - </b>"भवेदभिनयोऽवस्थानुकारः स चतुर्विधः । आङ्गिको वाचिकश्चैवमाहार्यः सात्त्विकस्तथा ॥"<br><b>उल्लेखाः - </b>सा० द० ६-२<br><br>आहार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನ್ಯಾಯಶಾಸ್ತ್ರದಲ್ಲಿ ಭಾಧಕಾಲದಲ್ಲಿ ಉಂಟಾಗುವ ಇಚ್ಛಾಜನ್ಯ ಜ್ಞಾನ<br><br>आहार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತರಲು ಯೋಗ್ಯವಾದ /ತರಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आ + हृञ् (हरणे) - "ण्यत्" (३-१-१२४)<br><br>

आहाव
आहाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾವಿಗಳ ಪಕ್ಕದಲ್ಲಿ ಪಶುಗಳು ನೀರು ಕುಡಿಯಲು ಕಟ್ಟಿರುವ ನೀರಿನ ತೊಟ್ಟಿ<br><b>निष्पत्तिः - </b>आ + ह्वेञ् (स्पर्धायां शब्दे च) - "अप्" वृद्धिश्च (३-३-७४)<br><b>व्युत्पत्तिः - </b>आहूयन्ते पशवोऽत्र<br><br>

आहित
आहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಡಲ್ಪಟ್ಟ /ಇರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + डुधाञ् (धारणपोषणयोः) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"व्यावर्तनैरहिपतेरयमाहिताङ्कः"<br><b>उल्लेखाः - </b>किरा० ५-३०<br><br>आहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಪಾದಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"आहिते न मधुना मधुरत्वे चेष्टितस्य गमिते तु विकासम्"<br><b>उल्लेखाः - </b>किरा० ९-६९<br><br>

आहिताग्नि
आहिताग्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಧಾನಪೂರ್ವಕ ಸಂಸ್ಕೃತವಾದ ಅಗ್ನಿಯುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>आहितः अग्निः येन<br><br>

आहितुण्डिक
आहितुण्डिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾವಾಡಿಗ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-२)<br><b>व्युत्पत्तिः - </b>अहितुण्डेन दीव्यति<br><b>प्रयोगाः - </b>"अमात्य, एष खलु आहितुण्डिको विज्ञापयति - न केवलमहं सर्वोपजीवी, प्राकृतकविः खल्वहम्"<br><b>उल्लेखाः - </b>मुद्रा० २<br><br>

आहुत
आहुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಮ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + हु (दानादनयोः) - "क्तः" (३-२-१०२)<br><br>आहुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನುಷ್ಯ ಯಜ್ಞ<br><br>आहुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೂತಯಜ್ಞ<br><br>

आहुति
आहुति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆಗಳನ್ನುದ್ದೇಶಿಸಿ ಅಗ್ನಿಯಲ್ಲಿ ಹವಿಸ್ಸನ್ನು ಅರ್ಪಿಸುವುದು<br><b>निष्पत्तिः - </b>आ + हु (दानादनयोः) - भावे "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"अग्नौ प्रास्ताहुतिः सम्यगादित्यमुपतिष्ठते"<br><b>उल्लेखाः - </b>मनु० ३-७६<br><br>आहुति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೋಮದ್ರವ್ಯ /ಹವಿಸ್ಸು<br><b>निष्पत्तिः - </b>आ + हु (दानादनयोः) - कर्म० "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"पुनानं पवनोद्धूतैर्धूमराहुतिगन्धिभिः"<br><b>उल्लेखाः - </b>रघु० १-५३<br><br>

आहूत
आहूत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಹ್ವಾನ /ಕರೆ<br><b>निष्पत्तिः - </b>आ + ह्वेञ् (स्पर्धायां शब्दे च) - भावे "क्तः" (३-३-११४)<br><br>आहूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"यियक्षमाणेनाहूतः पार्थेनाथ द्विषन्मुरम्"<br><b>उल्लेखाः - </b>माघ० २-१<br><br>आहूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಸರಿಡಲ್ಪಟ್ಟ<br><br>

आहूतप्रपलायिन्
आहूतप्रपलायिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾದಕ್ಕಾಗಿ ನ್ಯಾಯಾಸ್ಥಾನದಿಂದ ಕರೆಯಲ್ಪಟ್ಟು ಹಾಜರಾಗದಿರುವ ಪ್ರತಿವಾದಿ<br><b>व्युत्पत्तिः - </b>आहुतः पलायते<br><b>प्रयोगाः - </b>"अन्यवादी क्रियाद्वेषी नोपस्थाता निरुत्तरः । आहूतप्रपलायी च हीनः पञ्चविधः स्मृतः ॥"<br><br>

आहूतसम्प्लव
आहूतसम्प्लव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಳಯ ಕಾಲ<br><b>व्युत्पत्तिः - </b>आहूतस्य नाम्ना कृतव्यवहारस्य जगतः सम्प्लवो नाशो यस्मिन्<br><b>प्रयोगाः - </b>"अआहूतसम्प्लवं स्थानममृतत्वं हि भाष्यते"<br><br>

आहूति
आहूति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರೆ /ಆಹ್ವಾನ<br><b>निष्पत्तिः - </b>आ + ह्वेञ् (स्पर्धायां शब्दे च) - "क्तिन्" (३-३-९४)<br><br>

आहूय
आहूय<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕರೆದು /ಆಹ್ವಾನ ಮಾಡಿ<br><b>निष्पत्तिः - </b>आ + ह्वेञ् (स्पर्धायां शब्दे च) - "ल्यप्" (७-१-३७)<br><b>प्रयोगाः - </b>"आहूय रामं विनयाभिराममाविःप्रमोदः प्रभुरेवमूचे"<br><b>उल्लेखाः - </b>चं० रा०<br><br>

आहृत
आहृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತರಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + हृञ् (हरणे) - "क्तः" (३-२-१०२)<br><br>

आहृति
आहृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತರುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + हृञ् (हरणे) - "क्तिन्" (३-३-९४)<br><br>

आहेय
आहेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸರ್ಪ ಸಂಬಂಧವಾದ ವಿಷ ಮೂಳೆ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>अहेरिदम्<br><br>

आहेयी
आहेयी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ ಸಂಬಂಧವಾದ ವಿಷ ಮೂಳೆ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

आहो
आहो<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ<br><b>निष्पत्तिः - </b>आ + हन (हिंसागत्योः) -"डोः" बाहु० ।<br><br>आहो<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿಕಲ್ಪ<br><b>प्रयोगाः - </b>"आहो निवत्स्यति समं हरिणाङ्गनाभिः"<br><b>उल्लेखाः - </b>शाकु० १-२३<br><br>आहो<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿತರ್ಕ<br><b>विस्तारः - </b>"आहो वितर्के प्रश्ने च" - मेदि० ।<br><br>

आहोपुरुषिका
आहोपुरुषिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಹಂಕಾರದಿಂದ ತನ್ನ ಶ್ರೇಷ್ಠತೆಯನ್ನು ಭಾವಿಸುವುದು<br><b>प्रयोगाः - </b>"आहोपुरुषिकां पश्य मम सद्रत्नकान्तिभिः"<br><b>उल्लेखाः - </b>भट्टि० ५-२७<br><br>

आहोस्वित्
आहोस्वित्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿಕಲ್ಪ<br><b>व्युत्पत्तिः - </b>आहो च स्विच्च<br><b>प्रयोगाः - </b>"आहोस्वित् प्रसवो ममापचारितैर्विष्टम्भितो वीरुधाम्"<br><b>उल्लेखाः - </b>शाकु० ५-९<br><br>

आह्न
आह्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಿನಗಳಸಮೂಹ<br><b>निष्पत्तिः - </b>अहन्- "अञ्" (४-२-४५)<br><b>व्युत्पत्तिः - </b>अह्नां समूहः<br><br>आह्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಹಗಲಿನಲ್ಲಿ ಮಾಡಿದ<br><b>निष्पत्तिः - </b>"अञ्" (४-३-७५)<br><b>व्युत्पत्तिः - </b>अह्ना निर्वृत्तम्<br><br>

आह्नी
आह्नी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आह्न ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

आह्निक
आह्निक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಿನದಲ್ಲಿ ಸತ್ಕರಿಸಿ ಕೆಲಸಕ್ಕೆ ಇರಿಸಲ್ಪಟ್ಟ ಉಪಾಧ್ಯಾಯ /ಗೌರವಪೂರ್ವಕ ಪಾಠ ಪ್ರವಚನಾದಿಗಳಿಗೆ ಏರ್ಪಡಿಸಲ್ಪಟ್ಟ ಉಪಾಧ್ಯಾಯ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-८०)<br><b>व्युत्पत्तिः - </b>अह्नः अधीष्टः आह्निकोऽध्यापकः<br><br>आह्निक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಧಿ /ಜ್ವರ<br><b>व्युत्पत्तिः - </b>अहः भूतः आह्निको व्याधिः<br><br>आह्निक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೋಜನ /ಊಟ<br><br>आह्निक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿದಿನದ ಕರ್ತವ್ಯ<br><br>आह्निक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿತ್ಯವೂ ಮಾಡುವ ಮತಸಂಬಂಧವಾದ ಕಾರ್ಯ /ನಿತ್ಯಕರ್ಮ<br><br>आह्निक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾತಂಜಲ ಮಹಾಭಾಷ್ಯದ ಒಂದೊಂದು ಭಾಗ<br><b>विस्तारः - </b>"आह्निकं दिननिर्वर्त्ये भोजने नित्यकर्मणि" - विश्व० ।<br><br>आह्निक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಗಲಲ್ಲಿ ಮಾಡಿದ<br><b>निष्पत्तिः - </b>अहन् - "ठञ्" (५-१-७९)<br><b>व्युत्पत्तिः - </b>अह्ना निर्वृत्तम्<br><br>आह्निक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ದಿನದಲ್ಲಿ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>अहन् - "ठञ्" (४-३-११)<br><b>व्युत्पत्तिः - </b>अह्नि भवः<br><br>आह्निक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಿನ ಸಂಬಂಧವಾದ<br><b>प्रयोगाः - </b>"स्थानमाह्निकमपास्य दन्तिनः"<br><b>उल्लेखाः - </b>कुमा० ८-३३<br><br>

आह्लाद
आह्लाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನಂದ /ಸಂತೋಷ<br><b>निष्पत्तिः - </b>आ + ह्लादी (सुखे च) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"नन्दस्यात्मज उत्पन्ने जाताह्लादो महामनाः"<br><b>उल्लेखाः - </b>भाग०<br><br>

आह्लादन
आह्लादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂತೋಷಪಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>आ + ह्लादी (सुखे च) + णिच् - "ल्युट्" (३-३-११५)<br><br>आह्लादन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷಪಡಿಸುವ /ಸಂತೋಷವುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>आ + ह्लादी (सुखे च) + णिच् - कर्त० "ल्युः" (३-१-१३४)<br><br>आह्लादन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆನಂದಕ್ಕೆ ಕಾರಣವಾದ<br><b>निष्पत्तिः - </b>कर० "ल्युट्" (३-३-११७)<br><br>

आह्लादित
आह्लादित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷಪಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + ह्लादी (सुखे च) + णिच् - "क्तः" (३-२-१०२)<br><br>आह्लादित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆನಂದವುಂಟಾದ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>आह्लादोऽस्य सञ्जातः<br><br>

आह्लादिन्
आह्लादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷವುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><br>आह्लादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷಪಡಿಸುವ<br><b>निष्पत्तिः - </b>आ + ह्लादी (सुखे च) + णिच् - "णिनिः" (३-२-७८)<br><br>

आह्लादिनी
आह्लादिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>आह्लादिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

आह्व
आह्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರೆಯುವ /ಆಹ್ವಾನ ಮಾಡುವ<br><b>निष्पत्तिः - </b>आ + ह्वेञ् (स्पर्धायां शब्दे च) - "डः" (वा० ३-२-३)<br><b>व्युत्पत्तिः - </b>आह्वयति<br><br>

आह्वय
आह्वय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಸರು /ನಾಮಧೇಯ<br><b>निष्पत्तिः - </b>या (प्रापणे) - "कः" (वा० ३-३-५८)<br><b>व्युत्पत्तिः - </b>आह्वैर्यायते प्राप्यते<br><br>आह्वय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಡು ಕೋಳಿ ಮೊದಲಾದ ಪ್ರಾಣಿಗಳನ್ನು ಪಣವಾಗಿಟ್ಟು ಆಡುವ ಆಟ<br><b>प्रयोगाः - </b>"अप्राणिभिर्यत्क्रियते तल्लोके द्यूतमुच्यते । प्राणिभिः क्रियमाणं तु स विज्ञेयः समाह्वयः ॥"<br><b>उल्लेखाः - </b>मनु० ९-२२३<br><br>

आह्वयन
आह्वयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಸರು /ನಾಮಧೇಯ<br><br>आह्वयन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರೆಯುವ /ಆಹ್ವಾನ ಮಾಡುವ<br><b>निष्पत्तिः - </b>आह्वय + णिच् - "ल्युट्" (३-३-११५)<br><b>व्युत्पत्तिः - </b>आह्वयं करोत्यनेन<br><br>

आह्वयितव्य
आह्वयितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರೆಯಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>आह्वय + णिच् - कर्म० "तव्यः" (३-१-९६)<br><br>

आह्वा
आह्वा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಹ್ವಾನ /ಕರೆ<br><b>निष्पत्तिः - </b>आ + ह्वेञ् (स्पर्धायां शब्दे च) - "अङ्" (३-३-१०६)<br><br>आह्वा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಸರು /ನಾಮಧೇಯ<br><b>निष्पत्तिः - </b>आ + ह्वेञ् (स्पर्धायां शब्दे च) - कर० "अङ्" (३-३-१०६)<br><br>

आह्वान
आह्वान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರೆಯುವುದು<br><b>निष्पत्तिः - </b>आ + ह्वेञ् (स्पर्धायां शब्दे च) - "ल्युट्" (३-३-११५)<br><br>आह्वान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಸರು /ನಾಮಧೇಯ<br><br>आह्वान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನ್ಯಾಯಾಸ್ಥಾನದ ಮುಂದೆ ಹಾಜರಾಗಲು ಬರುವ ಆಜ್ಞಾಪತ್ರ<br><b>निष्पत्तिः - </b>आ + ह्वेञ् (स्पर्धायां शब्दे च) - कर० "ल्युट्" (३-३-११७)<br><br>आह्वान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಕದ್ದಮೆಯ ತೀರ್ಪಿಗಾಗಿ ನ್ಯಾಯಾಸ್ಥಾನದ ಕರೆ<br><br>

आह्वानपत्र
आह्वानपत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹ ಮುಂತಾದ ಉತ್ಸವಗಳಲ್ಲಿ ಕರೆ ಕೊಡುವ ಪತ್ರಿಕೆ<br><br>

आह्वानपत्रिका
आह्वानपत्रिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹ ಮುಂತಾದ ಉತ್ಸವಗಳಲ್ಲಿ ಕರೆ ಕೊಡುವ ಪತ್ರಿಕೆ<br><br>

इ
इ<br><br><b>कन्नडार्थः - </b>ಇಕಾರ<br><br>इ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ /ಮನ್ಮಥ<br><b>निष्पत्तिः - </b>अ - "इञ्" (४-१-९५)<br><b>व्युत्पत्तिः - </b>अस्य विष्णोरपत्यम्<br><b>विस्तारः - </b>"इकार उच्यते कामः" - एका० ।<br><br>इ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ /ಹಾವು<br><br>इ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರತ್ನ<br><br>इ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂತಿ<br><br>इ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂಭಾಗ<br><br>इ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಹಸ್ಯ<br><br>इ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ<br><br>इ<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಆನೆ<br><br>इ<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತಃಪುರ<br><br>इ<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರನ ಕಿರಣ<br><b>विस्तारः - </b>"इकारः फणिरत्नार्चिष्वग्रतोऽर्थगुहार्थयोः । हरे करेणौ कक्ष्यान्ते निशाकरकरे स्मरे" - नानार्थर० ।<br><br>इ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕನಿಕರ /ದಯೆ<br><br>इ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಶ್ಚರ್ಯ<br><br>इ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ<br><br>इ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೋಪದ ಮಾತು<br><br>इ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಖೇದ<br><br>इ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿರಾಕರಣೆ<br><b>विस्तारः - </b>"इ विचित्रे स्मरे पुमान्" - वैज० । "इ खेदे च रुषोक्तौ चापाकरणानुकम्पयोः" - मेदि० ।<br><br>

इ|गतौ|अयति
इ - गतौ (भ्वा० पर० सक० अनि०) अयति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೋಗು /ಹೊಂದು<br><br>

इक्|स्मरणे|अध्येति
इक् - स्मरणे (अदा० पर० सक० अनि०) अध्येति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸ್ಮರಿಸು /ನೆನೆ<br><br>इक् - स्मरणे (अदा० पर० सक० अनि०) अध्येति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಧ್ಯಯನ ಮಾಡು<br><br>

इकट
इकट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಸಿರಿನ ಮೊಳಕೆ<br><br>

इक्कट
इक्कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಪೆಯನ್ನು ತಯಾರಿಸುವ ಹುಲ್ಲು<br><br>

इक्षु
इक्षु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬು<br><b>निष्पत्तिः - </b>इषु (इच्छायाम्) - "क्सुः" (उ० ३-१५७)<br><b>व्युत्पत्तिः - </b>इष्यते<br><b>प्रयोगाः - </b>"इक्षुच्छायानिषादिन्यस्तस्य गोप्तुर्गुणोदयम्"<br><b>उल्लेखाः - </b>रघु० ४-२०<br><br>इक्षु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಚ್ಛೆ /ಬಯಕೆ<br><br>

इक्षुकाण्ड
इक्षुकाण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿನ ಜಲ್ಲೆ<br><b>प्रयोगाः - </b>"क्षिप्तं पुरो न जगृहे मुमुरिक्षिकाण्डम्"<br><b>उल्लेखाः - </b>माघ० ५-५०<br><br>इक्षुकाण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೊಂಡುಹುಲ್ಲು<br><br>इक्षुकाण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಣಳ ಗಿಡ<br><br>

इक्षुकीय
इक्षुकीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿನಿಂದ ಕೂಡಿದ ಪ್ರದೇಶ<br><b>निष्पत्तिः - </b>"छः" कुक् च (४-२-९१)<br><b>व्युत्पत्तिः - </b>इक्षवः सन्त्यत्र<br><br>

इक्षुकुट्टक
इक्षुकुट्टक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬನ್ನು ತುಂಡುಮಾಡಿ ಗಾಣಕ್ಕೆ ಕೊಟ್ಟು ಬೆಲ್ಲವನ್ನು ತಯಾರಿಸುವ ರೈತ<br><b>निष्पत्तिः - </b>कुट्ट (छेदने) - "ष्वुन्" (३-१-१४५)<br><b>व्युत्पत्तिः - </b>कुट्टयति । इक्षोः कुट्टकः ।<br><br>

इक्षुगन्धा
इक्षुगन्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೆಗ್ಗಿಲು ಗಿಡ<br><br>इक्षुगन्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಳವಳಿಕೆ ಗಿಡ<br><br>इक्षुगन्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜೊಂಡುಹುಲ್ಲು<br><br>इक्षुगन्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿನೆಲಗಂಬಳ<br><b>विस्तारः - </b>"इक्षुगन्धा कोकिलाक्षे क्रोष्ट्यां काशे च गोक्षरे" - मेदि० ।<br><br>

इक्षुज
इक्षुज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿನಿಂದುಂಟಾದ ಬೆಲ್ಲ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>इक्षोर्जायते<br><br>

इक्षुदण्ड
इक्षुदण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿನ ಜಲ್ಲೆ<br><br>

इक्षुयष्टि
इक्षुयष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿನ ಜಲ್ಲೆ<br><br>

इक्षुनेत्र
इक्षुनेत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿನ ಜಲ್ಲೆಯ ಕಣ್ಣು<br><br>

इक्षुपाक
इक्षुपाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಲ್ಲ<br><br>इक्षुपाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಕ್ಕರೆ<br><br>

इक्षुमती
इक्षुमती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನದಿ<br><br>

इक्षुमूल
इक्षुमूल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿದಿರು<br><br>इक्षुमूल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿನ ಬುಡ<br><br>

इक्षुमेह
इक्षुमेह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಧುಮೇಹ ರೋಗ<br><br>

इक्षुयन्त्र
इक्षुयन्त्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬನ್ನು ಹಿಂಡುವ ಯಂತ್ರ<br><br>

इक्षुयोनि
इक्षुयोनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಟಾಪಟ ಕಬ್ಬು<br><br>

इक्षुर
इक्षुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಳವಳಿಕೆ ಗಿಡ<br><br>इक्षुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬು<br><br>इक्षुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಂಬುಹುಲ್ಲು<br><br>

इक्षुरस
इक्षुरस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿನ ಹಾಲು<br><br>इक्षुरस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಕಂಬಿ<br><br>

इक्षुरसक्वाथ
इक्षुरसक्वाथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿನ ಹಾಲಿನ ಪಾಕ<br><br>

इक्षुवल्ली
इक्षुवल्ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿ ನೆಲಗಂಬಳ<br><br>

इक्षुसमुद्र
इक्षुसमुद्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಪ್ತ ಸಮುದ್ರಗಳಲ್ಲೊಂದು<br><br>

इक्ष्वाकु
इक्ष्वाकु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯವಂಶದ ಒಬ್ಬ ದೊರೆ<br><br>इक्ष्वाकु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಕ್ಷ್ವಾಕುವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದ ದೊರೆಗಳು<br><b>प्रयोगाः - </b>"इक्ष्वाकूणां दुरापेऽर्थे त्वदधीना हि सिद्धयः"<br><b>उल्लेखाः - </b>रघु० १-७२<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>

इङ्|अध्ययने|अधीते
इङ् - अध्ययने (अदा० आत्म० सक० अनि०) अधीते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಧ್ಯಯನ ಮಾಡು<br><br>

इङ्ग
इङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂಗಿತ /ಅಭಿಪ್ರಾಯ ಸೂಚನೆ<br><br>इङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಲನೆ /ಅಲುಗಾಟ<br><b>निष्पत्तिः - </b>इगि (गतौ) - "घञ्" (३-३-१८)<br><br>इङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನ<br><br>इङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಲಿಸುವ<br><b>निष्पत्तिः - </b>इगि (गतौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>इङ्गति<br><br>इङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅದ್ಭುತವಾದ<br><b>विस्तारः - </b>"इङ्गः स्यात् अद्भुते ज्ञाने जङ्गमेङ्गितयोरपि" - मेदि० ।<br><br>

इङ्गन
इङ्गन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂಗಿತ /ಅಭಿಪ್ರಾಯ ಸೂಚನೆ<br><br>इङ्गन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಲನ /ಅಲುಗಾಟ<br><br>इङ्गन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನ<br><b>निष्पत्तिः - </b>इगि (गतौ) - "ल्युट्" (३-३-११५)<br><br>

इङ्गित
इङ्गित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಪ್ರಾಯ ಸೂಚನೆ<br><br>इङ्गित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಪ್ರಾಯ /ಮನೋಭಾವ<br><b>निष्पत्तिः - </b>इगि (गतौ) - "क्तः" (३-३-११४)<br><b>प्रयोगाः - </b>"तस्य संवृतमन्त्रस्य गूढाकारेङ्गितस्य च"<br><b>उल्लेखाः - </b>रघु० १-२०<br><br>इङ्गित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಲನೆ /ಅಲುಗಾಟ<br><br>इङ्गित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಲಿಸಿದ<br><b>निष्पत्तिः - </b>इगि - "क्तः" (३-४-७२)<br><br>

इङ्गितज्ञ
इङ्गितज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿಪ್ರಾಯವನ್ನು ತಿಳಿದ<br><b>निष्पत्तिः - </b>ज्ञा (अवबोधने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>इङ्गितं जानाति<br><b>प्रयोगाः - </b>"न हीङ्गितज्ञोऽवसरेऽवसीदति"<br><b>उल्लेखाः - </b>किरा० ४-२०<br><br>

इङ्गुदी
इङ्गुदी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಾರೆ ಗಿಡ<br><b>निष्पत्तिः - </b>दो (अवखण्डने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>इङ्गुः रोगः । तं द्यति<br><b>प्रयोगाः - </b>"प्रस्निग्धाः क्वचिदिङ्गुदीफलभिदः सूच्यन्त एवोपलाः"<br><b>उल्लेखाः - </b>शाकु० १-१३<br><br>

इच्छक
इच्छक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸುವ<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७) । स्वार्थे "कन्"<br><b>व्युत्पत्तिः - </b>इच्छा अस्त्यस्य<br><br>

इच्छत्
इच्छत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಯಸುವ /ಆಸೆಪಡುವ<br><b>निष्पत्तिः - </b>इषु (इच्छायाम्) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"न महानपि भूतिमिच्छता फलसम्पत्प्रवणः परिक्षयः"<br><b>उल्लेखाः - </b>किरा० २-८<br><br>

इच्छा
इच्छा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆ /ಅಭಿಲಾಷೆ<br><b>प्रयोगाः - </b>"तथापि कल्याणकरीं गिरं ते मां श्रोतुमिच्छा मुखरीकरोति"<br><b>उल्लेखाः - </b>किरा० ३-९<br><br>

इच्छानिवृत्ति
इच्छानिवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಸೆಯನ್ನು ತೊರೆಯುವುದು<br><b>व्युत्पत्तिः - </b>इच्छाया निवृत्तिः<br><br>

इच्छावत्
इच्छावत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>इच्छाऽस्त्यस्य<br><br>

इच्छावती
इच्छावती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮುಕ /ಪುರುಷನ ಸಂಗಮಾಕ್ಷೇಯುಳ್ಳ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

इच्छावसु
इच्छावसु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರ<br><br>इच्छावसु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಾನುಸಾರ ಧನಸಂಪತ್ತುಳ್ಳವನು<br><br>

इज्वल
इज्वल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ಹಲಸಿನ ಮರ<br><br>

इज्य
इज्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७) ।<br><b>व्युत्पत्तिः - </b>इज्यास्यास्ति<br><b>प्रयोगाः - </b>"यज्ञो इज्यो महेज्यश्च"<br><b>उल्लेखाः - </b>वि० स०<br><br>इज्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೃಹಸ್ಪತ್ಯಾಚಾರ್ಯರು<br><br>इज्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುಷ್ಯನಕ್ಷತ್ರ<br><br>इज्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುರು /ಉಪಾಧ್ಯಾಯ<br><br>इज्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜ್ಯನಾದ /ಪೂಜಾರ್ಹನಾದ<br><br>

इज्या
इज्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞ /ಯಾಗ<br><b>निष्पत्तिः - </b>यज (देवपूजायाम्) - "क्यप्" (३-३-९८) । सम्प्रसारणम् (६-१-१५)<br><b>प्रयोगाः - </b>"सोऽहमिज्याविशुद्धात्मा प्रजालोपनिमीलितः"<br><b>उल्लेखाः - </b>रघु० १-६८<br><br>इज्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಾನ<br><br>इज्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ<br><br>इज्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಗಮ /ಸೇರುವುದು<br><b>विस्तारः - </b>"इज्या दानेऽध्वरेऽर्चायां सङ्गमे स्त्री गुरौ त्रिषु" - मेदि० ।<br><br>इज्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಮೆ /ವಿಗ್ರಹ<br><br>

इज्याशील
इज्याशील<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾಗ ಮಾಡುವ ಸ್ವಭಾವದವನು<br><b>व्युत्पत्तिः - </b>इज्या शीलमस्य<br><b>विस्तारः - </b>"इज्याशीलो यायजूकः" - अम० ।<br><br>

इञ्चाक
इञ्चाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೀಗಡಿ /ಒಂದು ಜಾತಿಯ ಸಣ್ಣ ಮೀನು<br><br>

इट्चर
इट्चर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೂಳಿ /ಹೋರಿ<br><b>निष्पत्तिः - </b>इषु (इच्छायाम्) - "क्विप्" (३-२-१७८) । चर (गतौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>इषा इच्छया चरति<br><br>

इडा
इडा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸು /ಗೋವು<br><br>इडा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿ<br><br>इडा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಕ್ಕು /ಮಾತು<br><br>इडा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬುಧನ ಪತ್ನಿ<br><b>निष्पत्तिः - </b>इल (उत्क्षेपे) - "कः" (३-१-१३५)<br><b>विस्तारः - </b>"इडा तु बुधयोषिति । सौरभेय्यां च वचने वसुमत्यामपि स्त्रियाम्" - मेदि० ।<br><br>इडा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹದೊಳಗಿನ ಒಂದು ನಾಡಿ<br><b>प्रयोगाः - </b>"इडा च पिङ्गला चैव सुषुम्णाचापरा स्मृता । गान्धारी हस्तजिह्वा च पूषा वसुवशा तथा । अलम्बुषा कुहूश्चैव शङ्खिनी दशमी स्मृता । तालुजिह्वेभजिह्वा च विजया कामदा परा । अमृता बहुला नाम नाड्यो वायुसमीरिताः ॥"<br><br>इडा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಗ<br><b>विस्तारः - </b>"गोभूनाडीद्युवाक्ष्विडा" - वैज० ।<br><br>इडा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ<br><br>

इडाचिका
इडाचिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣಜದ ಹುಳ<br><br>

इण्|गतौ|एति
इण् - गतौ (अदा० पर० सक० अनि०) एति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೋಗು<br><b>प्रयोगाः - </b>"अपीदानीं स धर्मात्मा इयान्मे दर्शनं रहः"<br><b>उल्लेखाः - </b>भा०<br><br>इण् - गतौ (अदा० पर० सक० अनि०) एति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ತಲುಪು /ಸೇರು<br><br>इण् - गतौ (अदा० पर० सक० अनि०) एति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪಡೆ /ಹೊಂದು<br><br>

अति + इण्|अतीण्|अत्येति
अति + इण् = अत्येति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮಿಸು /ಮೀರು<br><b>प्रयोगाः - </b>"अतीत्य वाचां मनसां च गोचरम्"<br><b>उल्लेखाः - </b>किरा० १८-४१<br><br>अति + इण् = अत्येति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ನಾಶ /ಧ್ವಂಸ<br><b>प्रयोगाः - </b>"अत्ययः"<br><br>अति + इण् = अत्येति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕಾಲ ಕಳೆದು ಹೋಗು<br><br>

अधि + इण्|अधीण्|अध्येति
अधि + इण् = अध्येति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನ ಹೊಂದು /ಪಠಿಸು<br><b>प्रयोगाः - </b>"ग्रन्थानधीत्य व्याकर्तुमिति दुर्मेधसोऽप्यलम्"<br><b>उल्लेखाः - </b>माघ० २-२६<br><br>

अनु + इण्|अन्विण्|अन्वेति
अनु + इण् = अन्वेति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸು<br><b>प्रयोगाः - </b>"तदन्वये शुद्धमिति प्रसूतः शुद्धिमत्तरः"<br><b>उल्लेखाः - </b>रघु० १-१२<br><br>

अप + इण्|अपेण्|अपैति
अप + इण् = अपैति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೊರಡು /ಹಿಂತಿರುಗಿ ಹೋಗು<br><b>प्रयोगाः - </b>"कुतोऽत्र पश्चात्तापस्य प्रसादस्य वा कारणम्"<br><b>उल्लेखाः - </b>रत्ना० ३<br><br>अप + इण् = अपैति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕಳೆದು ಹೋಗು /ದೂರವಾಗು<br><b>प्रयोगाः - </b>"अपेतसम्मोहिमिवात्मवेदिनम्"<br><b>उल्लेखाः - </b>याद० १४-६५<br><br>अप + इण् = अपैति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ನಾಶವಾಗು /ಲಯ ಹೊಂದು<br><br>

अभि + इण्|अभीण्|अभ्येति
अभि + इण् = अभ्येति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಹೋಗು<br><b>प्रयोगाः - </b>"अभ्येति भानुरुदयाद्रिमसह्यतेजाः"<br><b>उल्लेखाः - </b>याद० १९-४१<br><br>अभि + इण् = अभ्येति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೊಂದು /ಪಡೆ<br><b>प्रयोगाः - </b>"अभ्येति भस्मपरिपाण्डुरितस्मरारेः"<br><b>उल्लेखाः - </b>माघ० ४-२८<br><br>

अभि + आ + इण्|अभ्येण|अभ्याति
अभि + आ + इण् = अभ्याति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಬಾ<br><b>प्रयोगाः - </b>"अभ्यायतः सन्ततधूमधूम्रम्"<br><b>उल्लेखाः - </b>किरा० १६-६<br><br>

अभि + उद् + इण्|अभ्युदिण्|अभ्युदेति
अभि + उद् + इण् = अभ्युदेति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಏಳಿಗೆ ಹೊಂದು<br><br>

अभि + उप + इण्|अभ्युपेति
अभि + उप + इण् = अभ्युपेति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಸಮೀಪಕ್ಕೆ ಬಾ<br><br>अभि + उप + इण् = अभ्युपेति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಮ್ಮತಿಸು /ಒಪ್ಪಿಗೆ ಕೊಡು<br><b>प्रयोगाः - </b>"अभ्युपेत्य"<br><br>अभि + उप + इण् = अभ्युपेति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೊಂದು /ಪಡೆ<br><b>प्रयोगाः - </b>"अभ्युपेत्बडिशामिषनीतिम्"<br><b>उल्लेखाः - </b>याद० २१-२१<br><br>

अव + इण्|अवेण्|अवैति
अव + इण् = अवैति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ತಿಳಿದುಕೊಳ್ಳು<br><b>प्रयोगाः - </b>"अवेहि मां किङ्करमष्टमूर्तेः"<br><b>उल्लेखाः - </b>रघु० २-३५<br><br>

आ + इण्|एण्|एति
आ + इण् = एति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಬಾ /ಆಗಮಿಸು<br><b>प्रयोगाः - </b>"द्विरदानिव दिग्विभावितांश्चतुरस्तोयनिधीनिवायतः"<br><b>उल्लेखाः - </b>किरा० २-२३<br><br>

उद् + इण्|उदिण्|उदेति
उद् + इण्<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹುಟ್ಟು /ಆವಿರ್ಭವಿಸು<br><b>प्रयोगाः - </b>"अविभिद्य निशकृतम् तमः प्रभया नांशुमताप्युदीयते"<br><b>उल्लेखाः - </b>किरा० २-३६<br><br>

उप + इण्|उपेण्|उपैति
उप + इण् = उपैति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಹೋಗು<br><b>प्रयोगाः - </b>तदुपेत्य मास्म तमुपालभथाः"<br><b>उल्लेखाः - </b>माघ० ९-६०<br><br>उप + इण् = उपैति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಆಗಮಿಸು /ಬಾ<br><b>प्रयोगाः - </b>"उपेत्य च स्वनगुरुपक्षमारुतं दिवस्त्विषा कपिशितदूरदिङ्मुखः"<br><b>उल्लेखाः - </b>माघ० १७-२८<br><br>उप + इण् = उपैति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೊಂದು /ಪಡೆ<br><b>प्रयोगाः - </b>"उपैति सस्यं परिणामरम्यता"<br><b>उल्लेखाः - </b>किरा० ४-२२<br><br>उप + इण् = उपैति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಬಾ<br><br>

परि + इण्|परीण्|पर्येति
परि + इण् = पर्येति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ವ್ಯಾಪಿಸು /ಕೂಡಿಕೊಂಡಿರು<br><b>प्रयोगाः - </b>"परीरमारात्प्रतिहारपालैः"<br><b>उल्लेखाः - </b>याद० १३-१५<br><br>परि + इण् = पर्येति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ವ್ಯಾಪಿಸು<br><b>प्रयोगाः - </b>"जनाकीर्णं मन्ये हुतवहपरीतं गृहमिव"<br><b>उल्लेखाः - </b>शाकु० ५-१०<br><br>

प्र + इण्|प्रेण्|प्रेति
प्र + इण् = प्रेति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪರಲೋಕ ಹೊಂದು<br><br>

अभि + प्र + इण्|अभिप्रेण्|अभिप्रैति
अभि + प्र + इण् = अभिप्रैति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸು<br><b>प्रयोगाः - </b>"कर्मणा यमभिप्रैति स सम्प्रदानम्"<br><br>

प्रति + इण्|प्रतीण्|प्रत्येति
प्रति + इण् = प्रत्येति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹಿಂತಿರುಗು<br><b>प्रयोगाः - </b>"इत्थं प्रयुज्याशिषमग्रजन्मा राज्ञे प्रतीयाय गुरोः सकाशम्"<br><b>उल्लेखाः - </b>रघु० ५-३५<br><br>प्रति + इण् = प्रत्येति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಂತೋಷ ಹೊಂದು<br><b>प्रयोगाः - </b>"तथेति तस्यावितथं प्रतीतः"<br><b>उल्लेखाः - </b>रघु० ५-२६<br><br>प्रति + इण् = प्रत्येति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನ ಸಂಪಾದಿಸು<br><b>प्रयोगाः - </b>"प्रतीत्य सत्राजित एतदप्रियम्"<br><b>उल्लेखाः - </b>याद० १४-३<br><br>प्रति + इण् = प्रत्येति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ವಿಶ್ವಾಸವಿಡು<br><b>प्रयोगाः - </b>"बलवदपि शिक्षितानामात्यन्यप्रत्ययं चेतः"<br><b>उल्लेखाः - </b>शाकु० १-३<br><br>प्रति + इण् = प्रत्येति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪ್ರಸಿದ್ಧಿ ಹೊಂದು<br><b>प्रयोगाः - </b>"प्रतीतः"<br><br>

प्रति + उद् + इण्|प्रत्युदिण्|प्रत्युदेति
प्रति + उद् + इण् = प्रत्युदेति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಎದುರುಗೊಳ್ಳು<br><b>प्रयोगाः - </b>"सपर्यया प्रत्य्दिताय पार्वती"<br><b>उल्लेखाः - </b>कुमा० ५-३१<br><br>

वि + परि + इण्|विपरीण्|विपर्ययः
वि + परि + इण् = विपर्ययः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ವ್ಯತ್ಯಾಸ ಹೊಂದು<br><br>वि + परि + इण् = विपर्ययः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಭ್ರಾಂತಿ ಹೊಂದು<br><br>

सम् + अनु + इण्|समन्विण्|समन्वयः
सम् + अनु + इण् = समन्वयः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ ಹೊಂದು<br><br>

सम् + अव + इण्|समवेण्|समवायः
सम् + अव + इण् = समवायः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ<br><br>

सम् + प्रति + इण्|सम्प्रतीण्|सम्प्रत्ययः
सम् + प्रति + इण् = सम्प्रत्ययः ।<br><br><b>पदविभागः - </b>नामपदम्<br><b>कन्नडार्थः - </b>ವಿಶ್ವಾಸ /ನಂಬಿಕೆ<br><br>

इण्ड्र
इण्ड्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗದಲ್ಲಿ ಅಗ್ನಿಕುಂಡದಿಂದ ಕಾದಿರುವ ತಟ್ಟೆ ಮೊದಲಾದುವನ್ನು ತೆಗೆಯಲು ಇಕ್ಕಳದಂತೆ ಮಾಡಿರುವ ಸಾಧನ<br><br>

इत्
इत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಗುವವನು<br><b>निष्पत्तिः - </b>इण् (गतौ) - "क्विप्" (३-२-१७८)<br><b>व्युत्पत्तिः - </b>एति गच्छति<br><br>इत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣದಲ್ಲಿ ಇತ್ ಎಂಬ ಒಂದು ಸಂಜ್ಞೆ<br><br>इत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇತ್ ಸಂಜ್ಞೆಯುಳ್ಳ ವರ್ಣ<br><br>

इत
इत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>इण् (गतौ) - भावे "क्तः" (३-३-११४)<br><br>इत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಮರಿಸಲ್ಪಟ್ಟ<br><b>विस्तारः - </b>"इतं स्मृते गते त्रिषु" - मेदि० ।<br><br>इत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಪಟ್ಟ<br><br>इत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಟ್ಟ<br><br>इत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಗುವ /ನಡೆಯುವ<br><br>इत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿರುವ /ಪಡೆದಿರುವ<br><b>निष्पत्तिः - </b>इण् - कर्त० "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"रमणेन रमण्यचिरांशुलतारुचिरङ्कमनीयत रागमिता"<br><b>उल्लेखाः - </b>माघ० ६-७१<br><br>इत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿದಿರುವ<br><br>इत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗತಿ /ಗಮನ<br><br>इत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನ /ತಿಳುವಳಿಕೆ<br><b>निष्पत्तिः - </b>इण् - भावे "क्तः" (३-३-११४)<br><br>इत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಮರಣೆ /ನೆನಪು<br><b>निष्पत्तिः - </b>इक् (स्मरणे) - भावे "क्तः" (३-३-११४)<br><br>

इतर
इतर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆಯವನಾದ<br><br>इतर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀಚ /ಪಾಮರ<br><b>निष्पत्तिः - </b>तॄ (प्लवनतरणयोः) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>इना कामेन तरति<br><b>प्रयोगाः - </b>"इतरानपि तादृशानिहैतान्न च गोपो न च यादव स्समर्च्यः"<br><b>उल्लेखाः - </b>याद० १५-४९<br><br>

इतरेतर
इतरेतर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನ್ಯೋನ್ಯವಾಗಿ<br><b>प्रयोगाः - </b>"इतरेतरानभिभवेन मृगास्तमुपासते गुरुमिवान्तसदः"<br><b>उल्लेखाः - </b>किरा० ६-३४<br><br>

इतरेतरयोग
इतरेतरयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇತರೇತರಯೋಗ ದ್ವಂದ್ವ<br><br>इतरेतरयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಸ್ಪರ ಸಂಬಂಧ<br><b>प्रयोगाः - </b>"मेदितालिरितरेतरयोगादन्यतामभजतातिशयं नु"<br><b>उल्लेखाः - </b>माघ० १०-२४<br><br>

इतरेतराश्रय
इतरेतराश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ಯೋನ್ಯಾಶ್ರಯ ದೋಷ<br><br>

इतरेतरद्युस्
इतरेतरद्युस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ದಿವಸದಲ್ಲಿ /ಮತ್ತೊಂದು ದಿವಸದಲ್ಲಿ<br><b>निष्पत्तिः - </b>इतर - "एद्युस्" (५-३-२२) । निपा० ।<br><br>

इतस्
इतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಇಲ್ಲಿಂದ /ಇವನಿಂದ<br><b>निष्पत्तिः - </b>इदम् - "तसिल्" (५-३-७) । इश् (५-३-३)<br><b>प्रयोगाः - </b>"इतो गमिष्याम्यथवेति वादिनी चचाल बाला स्तनभिन्नवल्कला"<br><b>उल्लेखाः - </b>कुमा० ५-८४<br><br>इतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಇದರಲ್ಲಿ /ಇವನಲ್ಲಿ<br><b>निष्पत्तिः - </b>इदम् - "तसिः" (वा० ५-४-४४)<br><b>प्रयोगाः - </b>"इतो हिरण्यप्रमुखैः प्रभुक्ता शोणाधरे शोणितराजधानी"<br><b>उल्लेखाः - </b>याद० १८-२६<br><br>

इति
इति<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೇತು /ಕಾರಣ<br><b>प्रयोगाः - </b>"माधवोऽपि मदनोद्यानं प्रभातेऽनुप्रेषितः । तत्र किल मालती गमिष्यति । ततोऽन्योन्यदर्शनं भविष्यतीति ॥"<br><b>उल्लेखाः - </b>मालती० १<br><br>इति<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸ್ವರೂಪ<br><b>प्रयोगाः - </b>"षड्गुणाः शक्तयस्तिस्रः सिद्धयश्चोदयास्त्रयः । ग्रन्थानधीत्य व्याकर्तुमिति दुर्मेधसोऽप्यलम् ॥"<br><b>उल्लेखाः - </b>माघ० १-३<br><br>इति<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಕರಣ<br><b>प्रयोगाः - </b>"उदितेऽनुदिते चैव समयाध्युषिते तथा । सर्वथा वर्तते यज्ञः इतीयं वैदिकी श्रुतिः ॥"<br><b>उल्लेखाः - </b>मनु० २-१५<br><br>इति<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹಿೀಗೆ /ಈ ರೀತಿಯಾಗಿ<br><b>प्रयोगाः - </b>"व्याहृत्य मरुतां पत्याविति वाचमवस्थिते"<br><b>उल्लेखाः - </b>किरा० ११-३७<br><br>इति<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮುಂದಿನ ರೀತಿಯಲ್ಲಿ<br><b>प्रयोगाः - </b>"रत्नाकरं वीक्ष्य मिथः स जायां रामाभिधानो हरिरित्युवाच"<br><b>उल्लेखाः - </b>रघु० १३-१<br><br>इति<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರದರ್ಶನ<br><b>प्रयोगाः - </b>हरिशब्दस्य प्रकाश इरिहरि ।<br><br>इति<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿದರ್ಶನ<br><br>इति<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನುಕರಣ<br><br>इति<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಾನ್ನಿಧ್ಯ<br><br>इति<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆದಿ<br><br>इति<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಮಾಪ್ತಿ /ಕೊನೆ<br><br>इति<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅವಧಾರಣ<br><br>इति<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪರಾಮರ್ಶ<br><b>विस्तारः - </b>"इति स्वरूपे सान्निध्ये विवक्षानियमेऽपि च । हेतौ प्रकारप्रत्यक्षप्रकाशेष्ववधारणे । एवमर्थे समाप्तौ स्यात्" - हेम० ।<br><br>

इतिकथ
इतिकथ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಂಬಲನರ್ಹವಾದ ಮಾತನಾಡುವ<br><b>व्युत्पत्तिः - </b>इतिकथा यस्य<br><br>

इतिकथा
इतिकथा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥವಿಲ್ಲದ ಮಾತು<br><br>

इतिकर्तव्य
इतिकर्तव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈ ರೀತಿ ಮಾಡಬೇಕಾದ<br><br>

इतिकर्तव्यता
इतिकर्तव्यता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಈ ರೀತಿ ಮಾಡಬೇಕಾಗಿರುವಿಕೆ<br><br>

इतिवृत्त
इतिवृत्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಥೆ /ಚರಿತ್ರೆ<br><br>इतिवृत्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಘಟನೆ /ನಡೆದ ಕಾರ್ಯ<br><br>

इतिह
इतिह<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಪ್ರದಾಯ /ಉಪದೇಶ ಪರಂಪರೆ<br><b>प्रयोगाः - </b>इति एवं ह किल<br><br>

इतिहास
इतिहास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುರಾತನ ಕಥೆಯನ್ನು ಹೇಳುವ ಭಾರತ ಮೊದಲಾದ ಗ್ರಂಥ<br><br>इतिहास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೂರ್ವ ಕಥೆ /ಹಿಂದಿನ ಚರಿತ್ರೆ<br><br>इतिहास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುರಾಣದ ಪ್ರಮಾಣ /ಐತಿಹ್ಯ<br><br>

इतिहासवाद
इतिहासवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೂರ್ವದಲ್ಲಿ ನಡೆದ ಕಥೆ<br><b>प्रयोगाः - </b>"शाकुन्तलादीनितिहासवादान्"<br><b>उल्लेखाः - </b>मालती० ३-३<br><br>

इत्थम्
इत्थम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಈ ರೀತಿಯಾಗಿ<br><b>निष्पत्तिः - </b>इदम् - "थमुः" (५-३-२४)<br><b>प्रयोगाः - </b>"इत्थं विहृत्य वनिताभिरुदस्यमानं पीनस्तनोरुजघनस्थलशालिनीभिः"<br><b>उल्लेखाः - </b>किरा० ८-५५<br><br>

इत्थङ्कारम्
इत्थङ्कारम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಈ ರೀತಿಯಾಗಿ<br><b>निष्पत्तिः - </b>इत्थम् - "णमुल्" (३-४-२७)<br><b>विस्तारः - </b>"इत्थङ्कारं भुङ्क्ते - इत्थं भुङ्क्ते इत्यर्थः ।"<br><br>

इत्थम्भाव
इत्थम्भाव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈ ರೀತಿಯನ್ನು ಹೊಂದುವಿಕೆ<br><b>निष्पत्तिः - </b>भू (प्राप्तौ) - "घञ्" (३-३-१८)<br><b>व्युत्पत्तिः - </b>इत्थं भावः प्राप्तिः<br><br>

इत्थम्भूत
इत्थम्भूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈ ಪ್ರಕಾರವನ್ನು ಹೊಂದಿದ<br><b>प्रयोगाः - </b>"ननु मूर्तिभिरष्टाभिरित्थम्भूतोऽस्मि सूचितः"<br><b>उल्लेखाः - </b>कुमा० ६-२६<br><br>

इत्य
इत्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>इण् (गतौ) - "क्यप्" (३-१-१०९)<br><br>

इत्वन्
इत्वन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಗುವ /ನಡೆಯುವ<br><b>निष्पत्तिः - </b>इण् (गतौ) - "क्वनिप्" (३-२-७५) ।<br><br>

इत्वर
इत्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಷಂಡ /ನಪುಂಸಕ<br><br>इत्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಥಿಕ /ದಾರಿ ನಡೆಯುವವನು<br><br>इत्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರೂರವಾದ ಕಾರ್ಯವುಳ್ಳವನು<br><br>इत्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಮ /ನೀಚ<br><br>इत्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದರಿದ್ರ /ಬಡವ<br><b>निष्पत्तिः - </b>इण् (गतौ) - "क्वरप्" (३-२-१६३)<br><br>

इत्वरी
इत्वरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>इत्वर ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>इत्वरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಸಾರಿಕೆ<br><br>इत्वरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಭಿಚಾರಿಣಿ /ಸ್ವೈರಿಣಿ<br><br>

इदम्
इदम्<br><br><b>पदविभागः - </b>त्रिलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿರುವ /ಮುಂಭಾಗದಲ್ಲಿರುವ<br><br>इदम्<br><br><b>पदविभागः - </b>त्रिलिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಕಾಣುತ್ತಿರುವ<br><br>इदम्<br><br><b>पदविभागः - </b>त्रिलिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿಗೆ ಗೋಚರವಾದ<br><b>प्रयोगाः - </b>"इदमस्तु सन्निकृष्टं समिपतरवर्तिचैतदो रूपम् । अदसस्तु विप्रकृष्टं तदिति परोक्षे विजानीयात् ॥"<br><br>इदम्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಕಾಣುತ್ತಿರುವ<br><b>प्रयोगाः - </b>"अयमतिजठराः प्रकामगुर्वीरलघुविलम्बिपयोधरोपरुद्धाः"<br><b>उल्लेखाः - </b>माघ० ४-२९<br><br>इदम्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಕಾಣುತ್ತಿರುವ<br><b>प्रयोगाः - </b>"इयमिष्टगुणाय रोचतां रुचिरार्था भवतेऽपि भारती"<br><b>उल्लेखाः - </b>किरा० २-५<br><br>इदम्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರಿಗೆ ಕಾಣುತ್ತಿರುವ<br><b>प्रयोगाः - </b>"इदं तु ते भक्तिनम्रं सतामाराधनं वपुः"<br><b>उल्लेखाः - </b>कुमा० ६-७३<br><br>

इदमीय
इदमीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇವನ ಸಂಬಂಧವಾದ /ಇವಳ ಸಂಬಂಧವಾದ /ಇದರ ಸಂಬಂಧವಾದ<br><b>प्रयोगाः - </b>"ग्रहणशक्तिरभूदिदमीययोरपि न सम्मुखवास्तुनि वस्तुनि"<br><b>उल्लेखाः - </b>नैष० ४-१२<br><br>

इदम्पर
इदम्पर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇದೇ ಮುಖ್ಯವಾಗಿ ಉಳ್ಳ /ಇದೇ ಧ್ಯೇಯವಾಗಿ ಉಳ್ಳ<br><b>निष्पत्तिः - </b>पॄ (पालनपूरणयोः) - "अप्" (३-३-५७)<br><b>व्युत्पत्तिः - </b>अनेन पूर्यते<br><b>प्रयोगाः - </b>"विधुनोति त्वदालम्बं ब्रह्मास्तम्बमिदम्परः"<br><b>उल्लेखाः - </b>याद० १६-३०<br><br>

इदानीम्
इदानीम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಈಗ /ಈ ಕಾಲದಲ್ಲಿ<br><b>निष्पत्तिः - </b>इदम् - "दानीम्" (५-३-१८)<br><b>प्रयोगाः - </b>"अहो प्रतिबुद्धमिदानीं मकरन्दपूर्णचन्द्रोदयेन"<br><b>उल्लेखाः - </b>मालती० ४<br><br>

इदानीन्तन
इदानीन्तन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈಗ ಉಂಟಾದ /ಈ ಸಮಯದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"ट्युल्" तुट् च् (४-३-२३)<br><b>व्युत्पत्तिः - </b>इदानीं भवः<br><br>

इदानीन्तनी
इदानीन्तनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಈಗ ಉಂಟಾದ /ಈ ಸಮಯದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><b>प्रयोगाः - </b>"वासना चेदिदानीन्तनी प्राक्तनी च रसास्वादहेतुः"<br><b>उल्लेखाः - </b>सा० द०<br><br>

इदानीन्तनयत्
इदानीन्तनयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈಗಿನ ಕಾಲದ್ದನ್ನಾಗಿ ಮಾಡುವ<br><b>निष्पत्तिः - </b>इदानीन्तन + णिच् - "शतृ" (३-२-१२४)<br><b>व्युत्पत्तिः - </b>इदानीन्तनं करोति<br><b>प्रयोगाः - </b>"एष कल्पान्तवृत्तान्तमिदानीन्तनयन्निव"<br><b>उल्लेखाः - </b>याद० १६-३०<br><br>

इद्ध
इद्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶ /ಕಾಂತಿ<br><br>इद्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ಚರ್ಯ<br><br>इद्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಸಿಲು /ಸೂರ್ಯನ ಪ್ರಕಾಶ<br><b>निष्पत्तिः - </b>ञि इन्धी (दीप्तौ) - भावे "क्तः" (३-३-११४)<br><b>विस्तारः - </b>"इद्धमातपदीप्तयोः" - मेदि० ।<br><br>इद्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಮಾನವಾದ /ಹೊಳೆಯುವ<br><b>निष्पत्तिः - </b>ञि इन्धी (दीप्तौ) - कर्त० "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"तन्वन्तमिद्धमभितो गुरुमंशुजालं लक्ष्मीमुवाह सकलस्य शशाङ्कमूर्तेः"<br><b>उल्लेखाः - </b>किरा० २-५९<br><br>इद्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಗ್ರವಾದ /ಉರಿಯುತ್ತಿರುವ<br><b>प्रयोगाः - </b>"क्रोधेद्धैर्दृष्टिपातैर्मुहुरुअपशमिता वह्नयोऽमी त्रयोऽपि"<br><b>उल्लेखाः - </b>रत्ना० १-४<br><br>इद्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉರಿಸಲ್ಪಟ್ಟ<br><br>इद्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कर्म० "क्तः" (३-२-१०२)<br><br>

इध्म
इध्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥ /ಕಾಮ<br><br>इध्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸಂತ ಋತು<br><br>इध्म<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌದೆ /ಕಟ್ಟಿಗೆ<br><br>इध्म<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಲಾಶ ಮೊದಲಾದ ಸಮಿತ್ತು /ಯಾಗಾದಿಗಳಲ್ಲಿ ಹೋಮ ಮಾಡುವ ಮುತುಗ ಮೊದಲಾದ ಸಮಿತ್ತು<br><br>इध्म<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೊತ್ತಾದ ಅಳತೆ ಮತ್ತು ಸಂಖ್ಯೆಯುಳ್ಳ ಸಮಿತ್ತುಗಳ ಕಟ್ಟು<br><b>निष्पत्तिः - </b>ञि इन्धी (दीप्तौ) - "मक्" (उ० १-१४५)<br><b>विस्तारः - </b>"इध्मः समिद्भिदि । कामे वसन्ते काष्ठे स्यात्" - हेम० ।<br><br>

इध्वजिह्व
इध्वजिह्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>व्युत्पत्तिः - </b>इध्मं काष्ठं जिह्वेवास्य<br><br>

इध्मवाह
इध्मवाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸ್ತ್ಯಮಹರ್ಷಿಯ ಮಗ<br><b>निष्पत्तिः - </b>वह (प्रापणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>इध्मं वहति<br><br>

इन
इन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>इण् (गतौ) - "नक्" (उ० ३-२)<br><b>प्रयोगाः - </b>"यजतां पाण्डवः स्वर्गमवत्विन्द्रस्तपस्विनः"<br><b>उल्लेखाः - </b>माघ० २-६५<br><br>इन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜಮಾನ /ಸ್ವಾಮಿ<br><b>प्रयोगाः - </b>"तमधिगम्य तथैव पुनर्बभौ न न महीनमहीनपराक्रमम्"<br><b>उल्लेखाः - </b>रघु० ९-५<br><br>इन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ /ದೊರೆ<br><b>विस्तारः - </b>"इनः सूर्ये नृपे पत्यौ" - विश्व० ।<br><br>इन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಕ್ತ /ಸಮರ್ಥ /ಬಲಶಾಲಿ<br><br>

इनसभ
इनसभ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜಸಭೆ<br><b>निष्पत्तिः - </b>नपुंसकता (२-४-२३)<br><b>व्युत्पत्तिः - </b>इनस्य राज्ञः सभा<br><br>

इन्दिन्दिर
इन्दिन्दिर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭ್ರಮರ /ದುಂಬಿ<br><b>निष्पत्तिः - </b>इदि (परमैश्वर्ये) - "क्विप्" । पूर्वनिपातः ।<br><b>व्युत्पत्तिः - </b>इन्दिरया इन्दति<br><br>

इन्दिरा
इन्दिरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಮೀ<br><b>निष्पत्तिः - </b>इदि (परमैश्वर्ये) - "किरच्" बाहु० । "टाप्"<br><br>इन्दिरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶೋಭೆ /ಕಾಂತಿ<br><b>प्रयोगाः - </b>"निशि निःसरदिन्दिरं कथं तुलयामः कलयापि पङ्कजम्"<br><b>उल्लेखाः - </b>भा० वि०<br><br>

इन्दिरामन्दिर
इन्दिरामन्दिर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>इन्दिरामन्दिर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲ /ತಾವರೆ<br><br>इन्दिरामन्दिर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಮಿಯ ವಾಸಸ್ಥಾನ<br><br>

इन्दी
इन्दी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಮೀ<br><b>निष्पत्तिः - </b>इदि (परमैश्वर्ये) - "इन्" (उ० ४-११८) । "ङीष्" (ग० ४-१-४५)<br><br>

इन्दीवर
इन्दीवर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀಲಕಮಲ<br><b>व्युत्पत्तिः - </b>इन्द्याः लक्ष्म्याः वरम्<br><b>प्रयोगाः - </b>"इन्दीवरश्यामतनुर्नृपोऽसौ त्वं रोचनागौरशरीरयष्टिः"<br><b>उल्लेखाः - </b>रघु० ६-६५<br><br>

इन्दीवरिणी
इन्दीवरिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೀಲಕಮಲದ ರಾಶಿ /ನೀಲೋತ್ಪಲದ ಸಮೂಹ<br><b>निष्पत्तिः - </b>"इनिः" (वा० ४-२-५१)<br><b>व्युत्पत्तिः - </b>इन्दीवराणां समूहः<br><br>इन्दीवरिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೀಲಕಮಲಗಳಿಂದ ಕೂಡಿದ ಪ್ರದೇಶ<br><br>

इन्दीवरी
इन्दीवरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶತಮೂಲು /ಶತಾವರಿ ಗಿಡ<br><br>

इन्दु
इन्दु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>निष्पत्तिः - </b>उन्दी (क्लेदने) - "उः" (उ० १-१२) । आदेः इति च ।<br><b>व्युत्पत्तिः - </b>उनत्ति क्लेदयति भुवं चन्द्रिकया<br><b>प्रयोगाः - </b>"इन्दुरिन्दुरिव श्रीमानित्यादौ तदनन्वयः"<br><b>उल्लेखाः - </b>चन्द्रा०<br><br>इन्दु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರದೇವತಾಕವಾದ ಮೃಗಶೀರ್ಷ ನಕ್ಷತ್ರ<br><br>इन्दु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸಂಖ್ಯೆ<br><br>

इन्दुकला
इन्दुकला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರನ ಹದಿನಾರನೆಯ ಒಂದು ಭಾಗ<br><b>प्रयोगाः - </b>"तस्याः सखे नियतमिन्दुकलामृणालज्योत्स्नादिकारणमभून्मदनश्च वेधाः"<br><b>उल्लेखाः - </b>मालती० १-२४<br><br>

इन्दुकलिका
इन्दुकलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರನ ಕಲೆ<br><br>इन्दुकलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಳೆ ಗಿಡ<br><br>

इन्दुकान्त
इन्दुकान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರಕಾಂತ ಶಿಲೆ<br><br>

इन्दुकान्ता
इन्दुकान्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಳೆ ಗಿಡ<br><br>इन्दुकान्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರನ ಪತ್ನಿ<br><br>इन्दुकान्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾತ್ರಿ<br><br>

इन्दुक्षय
इन्दुक्षय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಮಾವಾಸ್ಯೆ<br><b>निष्पत्तिः - </b>क्षि (क्षये) - "अच्" (३-३-५६)<br><b>व्युत्पत्तिः - </b>इन्दुः क्षीयतेऽत्र<br><br>इन्दुक्षय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರನ ಕ್ಷಯ /ಚಂದ್ರನ ಕಲೆಗಳು ಕಡಿಮೆಯಾಗುವಿಕೆ<br><br>

इन्दुज
इन्दुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬುಧಗ್ರಹ<br><br>

इन्दुजा
इन्दुजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನರ್ಮದಾ ನದಿ<br><br>

इन्दुभ
इन्दुभ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೃಗಶೀರ್ಷ ನಕ್ಷತ್ರ<br><br>इन्दुभ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಕಾಟಕ ರಾಶಿ<br><br>

इन्दुभृत्
इन्दुभृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><b>निष्पत्तिः - </b>डुभृञ् (धारणपोषणयोः) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>इन्दुं बिभर्ति<br><br>

इन्दुमणि
इन्दुमणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರಕಾಂತ ಮಣಿ<br><br>इन्दुमणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುತ್ತು /ಮುಕ್ತಾಫಲ<br><br>

इन्दुमण्डल
इन्दुमण्डल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರಬಿಂಬ<br><br>

इन्दुमती
इन्दुमती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಜಮಹಾರಾಜನ ಪತ್ನಿ<br><b>प्रयोगाः - </b>"वसुधामपि हस्तगामिनीमहरोदिन्दुमतीमिवापराम्"<br><b>उल्लेखाः - </b>रघु० ८-१<br><br>इन्दुमती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣ ಚಂದ್ರನಿಂದ ಕೂಡಿದ ಹುಣ್ಣಿಮೆ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>प्रशस्तः इन्दुरस्यास्ति<br><br>

इन्दुमौलि
इन्दुमौलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><b>व्युत्पत्तिः - </b>इन्दुः मौलौ यस्य<br><b>प्रयोगाः - </b>"अथ विबुधगणांस्तानिन्दुमौलिर्विसृज्य"<br><b>उल्लेखाः - </b>कुमा० ७-९४<br><br>

इन्दुरत्न
इन्दुरत्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುತ್ತು /ಮುಕ್ತಾಫಲ<br><br>

इन्दुलेखा
इन्दुलेखा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರನ ಕಲೆ /ಚಂದ್ರಬಿಂಬದ ಹದಿನಾರನೆಯ ಒಂದು ಭಾಗ<br><br>इन्दुलेखा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೋಮಾತೆ<br><br>इन्दुलेखा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಳಲೆ ಗಿಡ<br><br>इन्दुलेखा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮೃತಬಳ್ಳಿ<br><b>विस्तारः - </b>"इन्दुलेखाऽमृता सोमलताशशिकलासु च" - मेदि० ।<br><br>

इन्दुलोक
इन्दुलोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರಲೋಕ<br><br>

इन्दुलौह
इन्दुलौह<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಜತ /ಬೆಳ್ಳಿ<br><br>

इन्दुव्रत
इन्दुव्रत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಂದ್ರಾಯಣ ವ್ರತ<br><b>व्युत्पत्तिः - </b>इन्दुलोकप्राप्त्यर्थं व्रतम्<br><br>

इन्दुशेखर
इन्दुशेखर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><b>व्युत्पत्तिः - </b>इन्दुः शेखरे यस्य<br><br>

इन्द्र
इन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ /ದೇವತೆಗಳ ಒಡೆಯ<br><b>निष्पत्तिः - </b>इदि (परमैश्वर्ये) - "रन्" (उ० २-२८)<br><b>प्रयोगाः - </b>"अवातताराभिगिरिं गिरीशगौरीपदन्यासविशुद्धमिन्द्रः"<br><b>उल्लेखाः - </b>कुमा० १२-२<br><br>इन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೧೨ ಮಂದಿ ಆದಿತ್ಯರಲ್ಲೊಬ್ಬ<br><b>प्रयोगाः - </b>"धातार्यमा च मित्रश्च वरुणोंऽशुर्भगस्तथा । इन्द्रो विवस्वान् पूषा च पर्जन्यो दशमः स्मृतः । ततस्त्वष्टा ततो विष्णुरजघन्यो जघन्यजः ॥"<br><br>इन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಷ್ಟದಿಕ್ಪಾಲಕರಲ್ಲೊಬ್ಬ<br><br>इन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಕಂಭ ಮೊದಲಾದ ೨೬ ವಿಧ ಯೋಗಗಳಲ್ಲಿ ಒಂದು<br><br>इन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತರಾತ್ಮ<br><b>विस्तारः - </b>"इन्द्रः शक्रासित्यभेदे योगभेदेऽन्तरात्मनि" - मेदि० ।<br><br>इन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ<br><br>इन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ /ಪ್ರಭು<br><b>विस्तारः - </b>"इन्द्रो विपार्कशक्रात्मस्वीश्वरे" - विश्व० ।<br><br>इन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾತ್ರಿ<br><br>इन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಟಜವೃಕ್ಷ /ಬೆಟ್ಟ ಮಲ್ಲಿಗೆ<br><br>इन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಾರತವರ್ಷದಲ್ಲಿರುವ ಒಂದು ದ್ವೀಪ<br><br>इन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠಾ ನಕ್ಷತ್ರ<br><br>इन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><br>इन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೮ ಮಂದಿ ವ್ಯಾಕರಣ ಶಾಸ್ತ್ರಪ್ರವರ್ತಕರಲ್ಲೊಬ್ಬ<br><br>इन्द्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಐಶ್ವರ್ಯ<br><b>निष्पत्तिः - </b>इदि (परमैश्वर्ये) - भावे "रन्" (उ० २-२८)<br><br>

इन्द्रा
इन्द्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾವುಮೆಕ್ಕೆ ಗಿಡ<br><br>

इन्द्रक
इन्द्रक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಭಾಮಂದಿರ<br><b>व्युत्पत्तिः - </b>इन्द्रस्य राज्ञः कं सुखं यत्र<br><br>

इन्द्रकर्मन्
इन्द्रकर्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>इन्द्राय इन्द्ररक्षणार्थं कर्म यस्य<br><b>प्रयोगाः - </b>"इन्द्रकर्म महाकर्मा कृतकर्मा"<br><b>उल्लेखाः - </b>वि० स०<br><br>

इन्द्रकील
इन्द्रकील<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಕೀಲಪರ್ವತ /ಅರ್ಜುನನು ಪಾಶುಪತಾಸ್ತ್ರ ಸಂಪಾದನೆಗಾಗಿ ತಪಸ್ಸು ಮಾಡಿದ ಪರ್ವತ<br><b>व्युत्पत्तिः - </b>इन्द्रस्य कील इव<br><b>प्रयोगाः - </b>"जीमूतैरपिहितसानुरिन्द्रकीलः"<br><b>उल्लेखाः - </b>किरा० ७-१७<br><br>इन्द्रकील<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಧ್ವಜ<br><b>व्युत्पत्तिः - </b>इन्द्रस्य कुञ्जरः<br><br>

इन्द्रकुञ्जर
इन्द्रकुञ्जर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಐರಾವತ<br><br>

इन्द्रकूट
इन्द्रकूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ ಕೂಟ ಪರ್ವತ<br><br>

इन्द्रकोश
इन्द्रकोश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಚ<br><br>इन्द्रकोश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಲ್ಲಂಗು /ಮೆತ್ತೆಯ ಕುರ್ಚಿ<br><br>

इन्द्रगिरि
इन्द्रगिरि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹೇಂದ್ರ ಪರ್ವತ<br><br>

इन्द्रगोप
इन्द्रगोप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಳೆಗಾಲದಲ್ಲಿ ಹುಟ್ಟುವ ಒಂದು ಜಾತಿ ಹುಳ /ಮಿಂಚುಹುಳ<br><br>

इन्द्रचाप
इन्द्रचाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಧನಸ್ಸು /ಕಾಮನಬಿಲ್ಲು<br><b>प्रयोगाः - </b>"धृतेन्द्रचापा न पयोदपङ्क्तयः"<br><b>उल्लेखाः - </b>किरा० ४-२३<br><br>

इन्द्रछन्दस्
इन्द्रछन्दस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸಾವಿರ ಎಳೆಗಳುಳ್ಳ ಹಾರ<br><b>निष्पत्तिः - </b>चदि (आह्लादने) - "असुन्" आदेश्छः (उ० ४-२१८)<br><b>व्युत्पत्तिः - </b>इन्द्र इव सहस्रनेत्रेण सहस्रगुच्छेन चाद्यते<br><br>

इन्द्रजाल
इन्द्रजाल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಯಾವಿದ್ಯೆ /ಕಣ್ಣು ಕಟ್ಟುವ ವಿದ್ಯೆ<br><b>व्युत्पत्तिः - </b>इन्द्रेण कौशलाद्यैश्वर्येण जालं द्रष्टुर्नेत्रावरणम्<br><b>प्रयोगाः - </b>"आर्यपुत्र, तिष्ठतु तावदिन्द्रजालिकम् । मातुलकुलादमात्यप्रधानो वसुभूतिरागतः"<br><b>उल्लेखाः - </b>रत्ना० ४<br><br>

इन्द्रजालिक
इन्द्रजालिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಾರುಡಿಗಾರ /ಕಣ್ಣು ಕಟ್ಟು ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५)<br><b>व्युत्पत्तिः - </b>इन्द्रजालमस्त्यस्य<br><b>प्रयोगाः - </b>"आः दास्याः पुत्र इन्द्रजालिक, किमेतैर्देवैरप्सरोभिश्च दर्शितैः । यदि तेऽनेन परितुष्टेन कार्यं तद्दर्शय सागरिकम् ॥"<br><b>उल्लेखाः - </b>रत्ना० ४<br><br>

इन्द्रजित्
इन्द्रजित्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾವಣನ ಮಗ ಇಂದ್ರಜಿತ್ತು /ಮೇಘನಾದ<br><br>इन्द्रजित्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಕ್ಷುಷ ಮನ್ವಂತರದಲ್ಲಿ ಕಶ್ಯಪನ ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದ ಒಬ್ಬ ಅಸುರ<br><b>प्रयोगाः - </b>"इन्द्रजित्सर्वजिच्चैव वज्रनाभस्तथैव च"<br><b>उल्लेखाः - </b>हरिवं०<br><br>

इन्द्रदमन
इन्द्रदमन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣಾಸುರನ ಮಗ<br><br>

इन्द्रदारु
इन्द्रदारु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವದಾರು ವೃಕ್ಷ<br><br>

इन्द्रद्युम्न
इन्द्रद्युम्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಸುರರ ಒಬ್ಬ ದೊರೆ<br><br>इन्द्रद्युम्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವಂತಿದೇಶದ ಒಬ್ಬ ರಾಜ<br><br>इन्द्रद्युम्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು ಭಕ್ತನಾದ ಪಾಂಡ್ಯದೇಶದ ಒಬ್ಬ ದೊರೆ<br><br>

इन्द्रद्रु
इन्द्रद्रु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಜುನ ವೃಕ್ಷ /ದೇವದಾರು ಮರ<br><br>

इन्द्रद्रुम
इन्द्रद्रुम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಜುನ ವೃಕ್ಷ /ದೇವದಾರು ಮರ<br><br>

इन्द्रधनुस्
इन्द्रधनुस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಧನಸ್ಸು /ಕಾಮನಬಿಲ್ಲು<br><br>

इन्द्रध्वज
इन्द्रध्वज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಧ್ವಜ /ಇಂದ್ರನ ಬಾವುಟ<br><b>व्युत्पत्तिः - </b>इन्द्रस्य इन्द्रसन्तोषार्थो ध्वजः<br><br>

इन्द्रनेत्र
इन्द्रनेत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಕಣ್ಣು<br><br>इन्द्रनेत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸಾವಿರ ಸಂಖ್ಯೆ<br><br>

इन्द्रनील
इन्द्रनील<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನೀಲಮಣಿ<br><b>व्युत्पत्तिः - </b>इन्द्र इव नीलः<br><b>प्रयोगाः - </b>"क्वचित्प्रभालेपिभिरिन्द्रनीलैर्मुक्तामयी यष्टिरिवानुविद्धा"<br><b>उल्लेखाः - </b>रघु० १३-५४<br><br>

इन्द्रपत्नी
इन्द्रपत्नी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಪತ್ನಿ /ಶಚೀದೇವಿ<br><b>व्युत्पत्तिः - </b>इन्द्रस्य पत्नी<br><br>

इन्द्रपर्वत
इन्द्रपर्वत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹೇಂದ್ರ ಪರ್ವತ<br><br>इन्द्रपर्वत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನೀಲ ಪರ್ವತ<br><br>

इन्द्रप्रस्थ
इन्द्रप्रस्थ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಪ್ರಸ್ಥನಗರ /ಈಗಿನ ದೆಹಲಿ ನಗರ<br><b>प्रयोगाः - </b>"इन्द्रप्रस्थं वृकप्रस्थं जयन्तं वारणावतम् । प्रयच्छ चतुरो ग्रामान् कञ्चिदेकं तु पञ्चमम् ॥"<br><b>उल्लेखाः - </b>वेणी० १-१६<br><br>

इन्द्रभेषज
इन्द्रभेषज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶುಂಠಿ<br><br>

इन्द्रमुख
इन्द्रमुख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಸಂತೋಷರ್ಥವಾಗಿ ವರ್ಷ ಋತುವಿನಲ್ಲಿ ಮಾಡುವ ಯಜ್ಞ<br><br>

इन्द्रयज्ञ
इन्द्रयज्ञ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಸಂತೋಷರ್ಥವಾಗಿ ವರ್ಷ ಋತುವಿನಲ್ಲಿ ಮಾಡುವ ಯಜ್ಞ<br><br>

इन्द्रमह
इन्द्रमह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಷ ಋತುವಿನಲ್ಲಿ ಇಂದ್ರನ ಸಂತೋಷಾರ್ಥವಾಗಿ ಮಾಡುವ ಉತ್ಸವ<br><b>व्युत्पत्तिः - </b>इन्द्रसन्तोषार्थो महः उत्सवः<br><br>इन्द्रमह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಷ ಋತು<br><b>व्युत्पत्तिः - </b>इन्द्रस्य महो यत्र<br><br>

इन्द्रमहकामुक
इन्द्रमहकामुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಯಿ<br><b>व्युत्पत्तिः - </b>इन्द्रमहे वर्षाकाले कामुकः कमयिता<br><br>

इन्द्रयव
इन्द्रयव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಟ್ಟಮಲ್ಲಿಗೆಯ ಬೀಜ<br><b>व्युत्पत्तिः - </b>इन्द्रस्य कुटजवृक्षस्य यवः यवाकारबीजत्वात् यव इव बीजम्<br><br>

इन्द्रलुप्त
इन्द्रलुप्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲನ್ನು ಉದಿರಿಸುವ ಒಂದು ರೋಗ<br><b>व्युत्पत्तिः - </b>इन्द्रः इन्द्रवर्णो नीलः केशो लुप्तो यस्मात्<br><br>

इन्द्रवंशा
इन्द्रवंशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೃತ್ತರತ್ನಾಕರದಲ್ಲಿ ಉಕ್ತವಾಗಿರುವ ೧೨ ನೆಯ ಛಂದಸ್ಸಿನ ಒಂದು ವೃತ್ತ<br><b>प्रयोगाः - </b>"स्यादिन्द्रवंशा ततजैरसंयुतैः"<br><b>उल्लेखाः - </b>वृ० र०<br><br>

इन्द्रवज्रा
इन्द्रवज्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೃತ್ತರತ್ನಾಕರದಲ್ಲಿ ಉಕ್ತವಾಗಿರುವ ೧೧ ನೆಯ ಛಂದಸ್ಸಿನ ಒಂದು ವೃತ್ತ<br><b>प्रयोगाः - </b>"स्यादिन्द्रवज्रा ततजास्ततो गौ"<br><b>उल्लेखाः - </b>वृ० र०<br><br>

इन्द्रवल्ली
इन्द्रवल्ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರಿಜಾತದ ಗಿಡ<br><br>इन्द्रवल्ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾವುಮೆಕ್ಕೆ ಗಿಡ<br><br>

इन्द्रबस्ति
इन्द्रबस्ति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಣಕಾಲು /ಮೊಣಕಾಲು<br><br>

इन्द्रवारुणी
इन्द्रवारुणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾವುಮೆಕ್ಕೆ ಗಿಡ<br><br>

इन्द्रवृक्ष
इन्द्रवृक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವದಾರು ವೃಕ್ಷ<br><br>

इन्द्रव्रत
इन्द्रव्रत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಜಾಪರಿಪಾಲನ ರೂಪವಾದ ರಾಜನ ಕರ್ತವ್ಯ<br><br>

इन्द्रशत्रु
इन्द्रशत्रु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃತ್ರಾಸುರ<br><b>प्रयोगाः - </b>"मन्त्रो हीनः स्वरतो वर्णतो वा मिथ्याप्रयुक्तो न तमर्थमाह । स वाग्वज्रो यजमानं हिनस्ति यथेन्द्रशत्रुः स्वरतोऽपराधात् ॥"<br><b>उल्लेखाः - </b>शिक्षा०<br><br>

इन्द्रसारथि
इन्द्रसारथि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಸಾರಥಿ /ಮಾತಲಿ<br><br>

इन्द्रसावर्णि
इन्द्रसावर्णि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೧೪ ಮಂದಿ ಮನುಗಳಲ್ಲೊಬ್ಬ<br><br>

इन्द्रसुत
इन्द्रसुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಮಗ ಜಯಂತ<br><br>इन्द्रसुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಮಗ ಅರ್ಜುನ<br><br>इन्द्रसुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಮಗ ವಾಲಿ<br><br>इन्द्रसुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಜುನ ವೃಕ್ಷ /ದೇವದಾರು ಮರ<br><br>

इन्द्रसूनु
इन्द्रसूनु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಮಗ ಜಯಂತ<br><br>इन्द्रसूनु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಮಗ ಅರ್ಜುನ<br><b>प्रयोगाः - </b>"जग्राह पाथेयमिवेन्द्रसूनुः"<br><b>उल्लेखाः - </b>किरा० ३-३७<br><br>इन्द्रसूनु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಮಗ ವಾಲಿ<br><br>इन्द्रसूनु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಜುನ ವೃಕ್ಷ /ದೇವದಾರು ಮರ<br><br>

इन्द्रसुरस
इन्द्रसुरस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಕಿ ಗಿಡ<br><br>

इन्द्रसेन
इन्द्रसेन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಜ /ನಳಚಕ್ರವರ್ತಿಯ ಮಗ<br><br>

इन्द्रसेना
इन्द्रसेना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಸೈನ್ಯ<br><br>इन्द्रसेना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೌದ್ಗಲ್ಯ ಋಷಿಯ ಪತ್ನಿ /ನಾಳಾಯನಿ<br><br>

इन्द्रसेनानी
इन्द्रसेनानी<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಸೇನಾಪತಿ /ಷಣ್ಮುಖ<br><b>निष्पत्तिः - </b>णीञ् (प्रापणे) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>इन्द्रसेनां नयति<br><br>

इन्द्रा
इन्द्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುರುಗದ ಗಿಡ<br><br>इन्द्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಚೀದೇವಿ<br><br>इन्द्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾವುಮೆಕ್ಕೆ ಗಿಡ<br><b>निष्पत्तिः - </b>इदि (परमैश्वर्ये) - "रन्" (उ० २-२८)<br><br>

इन्द्राग्नि
इन्द्राग्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ ಮತ್ತು ಅಗ್ನಿದೇವತೆಗಳು<br><br>इन्द्राग्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶಾಖಾ ನಕ್ಷತ್ರ<br><br>

इन्द्राग्निधूम
इन्द्राग्निधूम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಮ /ಮಂಜು<br><b>व्युत्पत्तिः - </b>इन्द्राग्नेः धूम इव<br><br>

इन्द्राणिका
इन्द्राणिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಕಿ ಗಿಡ<br><br>

इन्द्राणी
इन्द्राणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಪತ್ನಿ /ಶಚೀದೇವಿ<br><b>निष्पत्तिः - </b>"ङीष्" आनुक् च (४-१-४९)<br><b>व्युत्पत्तिः - </b>इन्द्रस्य पत्नी<br><br>इन्द्राणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ<br><br>इन्द्राणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಕಿ ಗಿಡ<br><br>इन्द्राणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಲಕ್ಕಿ ಕಾಯಿ<br><b>निष्पत्तिः - </b>अन (प्राणने) + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>इन्द्र इव आनयति जीवयति<br><br>

इन्द्रानुज
इन्द्रानुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ತಮ್ಮ /ಉಪೇಂದ್ರಾವತಾರ ಮಾಡಿದ ಶ್ರೀಮನ್ನಾರಾಯಣ<br><b>व्युत्पत्तिः - </b>इन्द्रस्यानुजः<br><br>

इन्द्रावरज
इन्द्रावरज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ತಮ್ಮ /ಉಪೇಂದ್ರಾವತಾರ ಮಾಡಿದ ಶ್ರೀಮನ್ನಾರಾಯಣ<br><b>व्युत्पत्तिः - </b>इन्द्रस्यावरजः<br><br>

इन्द्रायुध
इन्द्रायुध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾದಂಬರಿಯಲ್ಲಿ ವರ್ಣಿತವಾದ ಒಂದು ಕುದುರೆ<br><br>इन्द्रायुध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಧನಸ್ಸು /ಕಾಮನಬಿಲ್ಲು<br><br>इन्द्रायुध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಅಸ್ತ್ರ<br><b>प्रयोगाः - </b>"इन्द्रायुधद्योतिततोरणाङ्कम्"<br><b>उल्लेखाः - </b>रघु० ७-४<br><br>

इन्द्रारि
इन्द्रारि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಸುರ /ರಾಕ್ಷಸ<br><b>व्युत्पत्तिः - </b>इन्द्रस्यारिः<br><br>

इन्द्रावसान
इन्द्रावसान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರುಭೂಮಿ<br><b>व्युत्पत्तिः - </b>इन्द्रस्य मेघस्यावसानमत्र<br><br>

इन्द्राशन
इन्द्राशन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಗೀಗಿಡದ ನಾರು<br><b>व्युत्पत्तिः - </b>इन्द्राय ऐश्वर्याय अश्यते भुज्यते<br><br>

इन्द्रिय
इन्द्रिय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರಣ /ಸಾಧನ<br><b>निष्पत्तिः - </b>"घच्" (५-२-९३) । निपा० ।<br><b>व्युत्पत्तिः - </b>इन्द्रस्यात्मनो लिङ्गम् अनुमापकम् । इन्द्रेण दृष्टं ज्ञातम् । इन्द्रेण सृष्टम् । इन्द्रेण जुष्टं सेवितम् । इन्द्रेण दुर्जयम्<br><br>इन्द्रिय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರೇತಸ್ಸು /ವೀರ್ಯ<br><br>

इन्द्रियगोचर
इन्द्रियगोचर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯಗಳಿಗೆ ವೇದ್ಯವಾಗುವ<br><b>व्युत्पत्तिः - </b>इन्द्रियाणां गोचरः<br><br>

इन्द्रियग्राम
इन्द्रियग्राम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯಗಳ ಸಮೂಹ<br><b>व्युत्पत्तिः - </b>इन्द्रियाणां ग्रामः समूहः<br><b>प्रयोगाः - </b>"बलवानिन्द्रियग्रामो विद्वांसमपि कर्षति"<br><b>उल्लेखाः - </b>मनु० २-२१५<br><br>

इन्द्रियज
इन्द्रियज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯಗಳಿಂದ ಹುಟ್ಟಿದ ಪ್ರತ್ಯಕ್ಷಜ್ಞಾನ<br><br>

इन्द्रियनिग्रह
इन्द्रियनिग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯಗಳ ಹತೋಟಿ /ಇಂದ್ರಿಯಗಳನ್ನು ಅಂಕೆಯಲ್ಲಿಡುವುದು<br><b>व्युत्पत्तिः - </b>इन्द्रियाणां यथेच्छं प्रवृत्तानां निग्रहो निरोधः<br><b>प्रयोगाः - </b>"धृतिः क्षमा दमोऽस्तेयं शौचमिन्द्रियनिग्रहः । धीर्विद्या सत्यमक्रोधो दशकं धर्मलक्षणम् ॥"<br><b>उल्लेखाः - </b>मनु० ६-९२<br><br>इन्द्रियनिग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯೋಗಾಭ್ಯಾಸದ ಒಂದು ಅಂಗ<br><br>

इन्द्रियवध
इन्द्रियवध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯಗಳು ಸ್ವೇಚ್ಛೆಯಿಂದ ಪ್ರವರ್ತಿಸದಂತೆ ಅವುಗಳ ಶಕ್ತಿಯನ್ನು ಕುಗ್ಗಿಸುವುದು /ಇಂದ್ರಿಯಗಳಹತೋಟಿ<br><br>

इन्द्रियवत्
इन्द्रियवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ ಇಂದ್ರಿಯವುಳ್ಳ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>प्रशस्तानि इन्द्रियाण्यस्य<br><br>इन्द्रियवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯದಂತೆ<br><b>व्युत्पत्तिः - </b>इन्द्रियेण तुल्यम्<br><br>

इन्द्रियवर्ग
इन्द्रियवर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯಗಳಸಮೂಹ<br><b>व्युत्पत्तिः - </b>इन्द्रियाणां वर्गः<br><b>प्रयोगाः - </b>"स्वादुनि प्रणदितालिनि शीते निर्ववार मधुनीन्द्रियवर्गः"<br><b>उल्लेखाः - </b>माघ० १०-३<br><br>

इन्द्रियवृत्ति
इन्द्रियवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯಗಳ ವ್ಯಾಪಾರ /ಆಯಾ ಇಂದ್ರಿಯಗಳು ಸಂಬಂಧಪಟ್ಟ ವಿಷಯಗಳಲ್ಲಿ ಮಾಡುವ ಕೆಲಸ<br><br>

इन्द्रियव्यापार
इन्द्रियव्यापार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯಗಳು ಸಂಬಂಧಪಟ್ಟ ವಿಷಯಗಳಲ್ಲಿ ಮಾಡುವ ಕೆಲಸ<br><b>व्युत्पत्तिः - </b>इन्द्रियाणां व्यापारः<br><br>

इन्द्रियसन्निकर्ष
इन्द्रियसन्निकर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯಗಳಿಗೆ ಆಯಾ ವಿಷಯಗಳಲ್ಲಿ ಸಂಬಂಧ / ವಿಷಯ ಪ್ರತ್ಯಕ್ಷವುಂಟಾಗುವಂತೆ ಆಯಾ ಇಂದ್ರಿಯಗಳಿಗೆ ಸಂಬಂಧಿಸಿದ ವಿಷಯಗಳಲ್ಲಿ ಇಂದ್ರಿಯ ಸಂಬಂಧರೂಪವಾದ ವ್ಯಾಪಾರ<br><b>व्युत्पत्तिः - </b>इन्द्रियाणां स्वस्वविषयैः सह सन्निकर्षः सम्बन्धः<br><br>

इन्द्रियस्वाप
इन्द्रियस्वाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯಗಳು ತಮಗೆ ಸಂಬಂಧಿಸಿದ ವಿಷಯಗಳಲ್ಲಿ ಕೆಲಸ ಮಾಡದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>इन्द्रियाणां स्वस्वविषयेषु स्वापः अप्रवृत्तिः<br><br>

इन्द्रियाधिष्ठातृ
इन्द्रियाधिष्ठातृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯಗಳು ತಮ್ಮ ತಮ್ಮ ಕಾರ್ಯಗಳನ್ನು ಮಾಡಲು ಅವುಗಳಲ್ಲಿ ಸೇರಿಕೊಂಡಿರುವ ದೇವತೆ<br><b>व्युत्पत्तिः - </b>इन्द्रियाणामधिष्ठाता<br><br>

इन्द्रियायतन
इन्द्रियायतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹ /ಶರೀರ /ಮೈ<br><b>व्युत्पत्तिः - </b>इन्द्रियाणां श्रोत्रादीनामायतनम्<br><br>इन्द्रियायतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮ /ಜೀವ<br><br>इन्द्रियायतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯಗಳ ಸ್ಥಾನ /ದೇಹದಲ್ಲಿ ಆಯಾ ಇಂದ್ರಿಯಗಳು ಇರುವ ಸ್ಥಾನ<br><br>

इन्द्रियाराम
इन्द्रियाराम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯ ಸೌಖ್ಯವನ್ನು ಅನುಭವಿಸುವವನು<br><b>व्युत्पत्तिः - </b>इन्द्रियाण्यारामो यस्य<br><b>प्रयोगाः - </b>"अघायुरिन्द्रियारामो मोघं पार्य स जीवति"<br><b>उल्लेखाः - </b>गीता० ३-१६<br><br>

इन्द्रियार्थ
इन्द्रियार्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯಗಳಿಗೆ ವೇದ್ಯವಾಗುವ ವಿಷಯ<br><b>व्युत्पत्तिः - </b>इन्द्रियस्यार्थः<br><b>प्रयोगाः - </b>"तस्माद्यस्य महाबाहो निगृहीतानि सर्वशः । इन्द्रियाणीन्द्रियार्थेभ्यः तस्य प्रज्ञा प्रतिष्ठिता ॥"<br><b>उल्लेखाः - </b>गीता० २-६८<br><br>

इन्द्रियेश
इन्द्रियेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೀವ /ಆತ್ಮ<br><br>इन्द्रियेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯಗಳಿಗೆ ಅಧಿಷ್ಠಾತೃ ದೇವತೆ<br><br>

इन्ध
इन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೌದೆ /ಕಟ್ಟಿಗೆ<br><b>निष्पत्तिः - </b>ञि इन्धी (दीप्तौ) - कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>इन्धेऽग्निरनेन<br><br>इन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><br>इन्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಂತಿಯುಕ್ತವಾದ /ಪ್ರಕಾಶಮಾನವಾದ<br><b>निष्पत्तिः - </b>ञि इन्धी (दीप्तौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>इन्धे<br><br>

इन्धन
इन्धन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌದೆ /ಕಟ್ಟಿಗೆ<br><b>निष्पत्तिः - </b>ञि इन्धी (दीप्तौ) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>इन्धेऽग्निरनेन<br><b>प्रयोगाः - </b>"इन्धनौघधगप्यग्निस्त्विषा नात्येति पूषणम्"<br><b>उल्लेखाः - </b>माघ० २-२३<br><br>इन्धन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸುವುದು /ಉರಿಯುವುದು<br><b>निष्पत्तिः - </b>ञि इन्धी (दीप्तौ) + णिच् - "ल्युट्" (३-३-११५)<br><br>इन्धन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸುವ<br><b>निष्पत्तिः - </b>ञि इन्धी (दीप्तौ) - कर्त० "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>इन्धयति<br><br>

इभ
इभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಜ /ಆನೆ<br><b>निष्पत्तिः - </b>इण् (गतौ) - "भः" (उ० ३-१५३)<br><b>व्युत्पत्तिः - </b>एति<br><b>प्रयोगाः - </b>"बन्धाय चिच्छिदुरिभास्यरसात्मनैव नैवात्मनीनमथवा क्रियते मदान्धैः"<br><b>उल्लेखाः - </b>माघ० ५-४४<br><br>इभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೮ ಸಂಖ್ಯೆ<br><br>

इभकणा
इभकणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಜ ಹಿಪ್ಪಲಿ<br><br>

इभकेसर
इभकेसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಗಕೇಸರ<br><br>

इभनिमीलिका
इभनिमीलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಗೀಗಿಡ<br><br>इभनिमीलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೈದಗ್ಧ್ಯ /ಚಾತುರ್ಯ<br><br>

इभपालक
इभपालक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾವಟಿಗ<br><b>निष्पत्तिः - </b>पाल (रक्षणे) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>इभं पालयति<br><br>

इभपोटा
इभपोटा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಡು ಆನೆಯ ಲಕ್ಷಣದಿಂದ ಕೂಡಿದ ಹೆಣ್ಣಾನೆ<br><b>व्युत्पत्तिः - </b>पोट पुंलक्षणा इभी<br><br>

इभानन
इभानन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಣಪತಿ /ವಿನಾಯಕ<br><b>व्युत्पत्तिः - </b>इभः आनानमस्य<br><br>

इभारि
इभारि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಿಂಹ<br><b>व्युत्पत्तिः - </b>इभस्यारिः<br><br>

इभेषणा
इभेषणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಜಹಿಪ್ಪಲಿ<br><br>

इभ्य
इभ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆನೆ ಮೊದಲಾದ ಸಂಪತ್ತಿನಿಂದ ಕೂಡಿದ /ಶ್ರೀಮಂತ<br><b>निष्पत्तिः - </b>इभ - "यः" (५-१-६६)<br><b>व्युत्पत्तिः - </b>इभमर्हति<br><b>विस्तारः - </b>"इभ्य आढ्यो धनी" - अम० ।<br><br>

इभ्या
इभ्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣಾನೆ /ಕರೇಣು<br><br>इभ्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಲ್ಲಕೀ ವೃಕ್ಷ /ಆನೆಬೇಲದ ಮರ<br><b>निष्पत्तिः - </b>इभ - "यः" (५-१-६६)<br><b>व्युत्पत्तिः - </b>इभमर्हति<br><b>विस्तारः - </b>"इभ्या करेणुसल्लक्योः स्त्रियमाढ्ये तु वाच्यवत्" - मेदि० ।<br><br>

इयत्
इयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟು /ಇಷ್ಟು ಪರಿಮಾಣವುಳ್ಳ<br><b>निष्पत्तिः - </b>इद्दम् - "वतुप्" (५-२-४०) । वस्य च घः । इयादेशः । इदम ईश् ।<br><b>व्युत्पत्तिः - </b>इदं परिमाणमस्य<br><br>इयत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಷ್ಟು /ಇಷ್ಟು ಪರಿಮಾಣವುಳ್ಳ<br><b>प्रयोगाः - </b>"सत्यं जनोऽयमियतो दिवसानमैषीत्"<br><b>उल्लेखाः - </b>मालती० ६-१४<br><br>इयत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಷ್ಟು /ಇಷ್ಟು ಪರಿಮಾಣವುಳ್ಳ<br><br>इयत्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಷ್ಟು /ಇಷ್ಟು ಪರಿಮಾಣವುಳ್ಳ<br><br>

इयत्ता
इयत्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಳತೆ /ಪರಿಮಾಣ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>इयतो भावः<br><b>प्रयोगाः - </b>"श्रमेण तदशक्त्या वा न गुणानामियत्तया"<br><b>उल्लेखाः - </b>रघु० १०-३२<br><br>

इरम्मद
इरम्मद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಜ್ರಾಯುಧದ ಕಾಂತಿ /ಮೇಘದ ತೇಜಸ್ಸು<br><b>निष्पत्तिः - </b>मदी (हर्षग्लेपनयोः) - "खश्" (३-२-३७) । निपा० ।<br><b>व्युत्पत्तिः - </b>इरया जलेन माद्यति<br><br>इरम्मद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಡಬಾಗ್ನಿ<br><br>

इरा
इरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿ<br><br>इरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಕ್ಕು /ಮಾತು<br><br>इरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸುರೆ /ಮದ್ಯ<br><br>इरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನ<br><br>इरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><b>निष्पत्तिः - </b>रा (दाने) - "कः" (३-२-३) । इण् (गतौ) - "रन्" वा (उ० २-२९)<br><b>व्युत्पत्तिः - </b>इं कामं राति<br><b>विस्तारः - </b>"इरा भूवाक्सुराम्बुषु । अन्ने च स्यात्" - वैज० ।<br><br>

इराचर
इराचर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಣಿಕಲ್ಲು /ವರ್ಷೋಪಲ<br><br>इराचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೂಮಿಯಲ್ಲಿ ಸಂಚರಿಸುವ<br><br>इराचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರಿನಲ್ಲಿ ಸಂಚರಿಸುವ<br><b>निष्पत्तिः - </b>चर (गतौ) - "टः" (३-२-१६)<br><b>व्युत्पत्तिः - </b>इरायां भूमौ जले वा चरति<br><br>

इरावत्
इरावत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ<br><br>इरावत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><br>इरावत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಲೂಪಿಯಲ್ಲಿ ಅರ್ಜುನನಿಗೆ ಜನಿಸಿದ ಮಗ ಇರಾವಂತ<br><br>

इरिण
इरिण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಷರ ಭೂಮಿ /ಕರಳುಮಣ್ಣಿನ ಭೂಮಿ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "इनन्" (उ० २-५२)<br><b>प्रयोगाः - </b>"यथेरिणि बीजमुप्त्वा वप्ता न लभते फलम्"<br><b>उल्लेखाः - </b>मनु० ३-१४२<br><br>इरिण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶೂನ್ಯ /ಪಾಳು<br><br>इरिण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯವಿಲ್ಲದ<br><br>

इरेश
इरेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ<br><br>इरेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರುಣ<br><br>इरेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀವಿಷ್ಣು<br><br>इरेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಗೀಶ /ಬೃಹಸ್ಪತಿ<br><b>व्युत्पत्तिः - </b>इराया ईशः<br><br>

इल
इल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿದ್ರೆಯ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>इल (स्वप्ने) - "कः" (३-१-१३५)<br><br>

इलबिला
इलबिला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಲಸ್ತ್ಯ ಬ್ರಹ್ಮನ ಸೊಸೆ /ವಿಶ್ರವಸ್ಸಿನ ಪತ್ನಿ<br><br>

इला
इला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೋವು /ಹಸು<br><br>इला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಕ್ಕು /ಮಾತು<br><br>इला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿ<br><br>इला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬುಧನ ಪತ್ನಿ<br><b>निष्पत्तिः - </b>इल (उत्क्षेपे) - "कः" (३-१-१३५)<br><b>विस्तारः - </b>"इला कलत्रे सौम्यस्य धरित्र्यां गवि वाचि च" - मेदि० ।<br><br>

इलावृत
इलावृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಂಬೂದ್ವೀಪದ ಒಂದು ಖಂಡ /ಜಂಬೂದ್ವೀಪದ ೯ ಭಾಗಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"इलावृतान्तं निषधादपाचीम्"<br><b>उल्लेखाः - </b>याद० १८-१३<br><br>

इल्वल
इल्वल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಕ್ಷಸ /ವಾತಾಪಿಯ ಸಹೋದರ<br><br>

इव
इव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಾದೃಶ್ಯ /ಹೋಲಿಕೆ<br><b>प्रयोगाः - </b>"जिगीषुरेको दिनकृदादित्येष्विव कल्पते"<br><b>उल्लेखाः - </b>माघ० २-८१<br><br>इव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉತ್ಪ್ರೇಕ್ಷೆ<br><b>प्रयोगाः - </b>"लीनेव प्रतिबिम्बितेव लिखितेवोत्कीर्णरूपेव च"<br><b>उल्लेखाः - </b>मालती० ५-१०<br><br>इव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ<br><b>प्रयोगाः - </b>"आवर्जिता किञ्चिदिव स्तनभ्यां वासो वसाना तरुणार्करागम्"<br><b>उल्लेखाः - </b>कुमा० ३-५४<br><br>इव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಾಕ್ಯಾಲಂಕಾರ<br><b>प्रयोगाः - </b>"श्रममादधावसुकरं न तपः किमिवावसादकरमात्मवताम्"<br><b>उल्लेखाः - </b>किरा० ६-१९<br><br>

इष|गतौ|इष्यति
इष - गतौ (दिवा० पर० सक० से०) इष्यति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೋಗು /ನಡೆ<br><br>

अनु + इष|अन्विष|अन्वेषणम्
अनु + इष = अन्वेषणम् ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹುಡುಕುವುದು<br><b>प्रयोगाः - </b>"अन्विषतः प्रमथनाय ममापि दर्पात्"<br><b>उल्लेखाः - </b>म० वी० २-३१<br><br>

परि + इष|परीष|पर्येषणा
परि + इष = पर्येषणा ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಧರ್ಮಾದಿ ವಿಮರ್ಶೆ ಮಾಡುವುದು<br><br>

प्र + इष|प्रेष|प्रेषणम्
प्र + इष = प्रेषणम् ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪ್ರೇರಿಸುವುದು<br><b>प्रयोगाः - </b>"प्रेषितां हरिहयेन भीषणां ह्रादिनीं हृतवति त्रिधामनि"<br><b>उल्लेखाः - </b>माघ० १७-७७<br><br>प्र + इष = प्रेषणम् ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕಳುಹಿಸುವುದು<br><b>प्रयोगाः - </b>"इमान्याभरणानि कुमारेण स्वशरीरादवतार्य प्रेषितानि धारयितुमर्हत्यार्यः"<br><b>उल्लेखाः - </b>मुद्रा० २<br><br>

इषु|इच्छायाम्|इच्छति
इषु - इच्छायाम् (तुदा- पर० सक० से०) इच्छति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಇಷ್ಟ ಪಡು<br><br>

अनु + इषु|अन्विषु|अन्वेषः
अनु + इषु = अन्वेषः ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹುಡುಕುವುದು<br><b>प्रयोगाः - </b>"वयं तत्त्वान्वेषान्मधुकर हतास्त्वं खलु कृती"<br><b>उल्लेखाः - </b>शाकु० १-२०<br><br>

अभि + इषु|अभीषु|अभीष्टम्
अभि + इषु = अभीष्टम् ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆ /ಇಷ್ಟ<br><b>प्रयोगाः - </b>"अभीष्टमासाद्य चिराय काले"<br><b>उल्लेखाः - </b>माघ० ६-७४<br><br>

परि + इषु|परीषु|पर्येषणम्
परि + इषु = पर्येषणम् ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹುಡುಕುವುದು<br><br>

प्रति + इषु|प्रतीषु|प्रतीच्छति
प्रति + इषु = प्रतीच्छति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಗ್ರಹ /ಸ್ವೀಕಾರ<br><b>प्रयोगाः - </b>"इयं सीता मम सुता सहधर्मचरी तव । प्रतीच्छ चैनां भद्रं ते पाणिं गृह्णीष्व पाणिना ॥"<br><b>उल्लेखाः - </b>रामा०<br><br>

इष
इष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ವಯುಜ ಮಾಸ<br><b>निष्पत्तिः - </b>इष (गतौ) - "क्विप्" (३-२-१७८) । "अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>एषमिट् यात्रा । सास्मिन्नस्ति<br><b>प्रयोगाः - </b>"श्रुततदीरितकोमलगीतकध्वनिमिषेऽनिमिषेक्षणमग्रतः"<br><b>उल्लेखाः - </b>माघ० ६-४९<br><br>

इषिर
इषिर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>निष्पत्तिः - </b>इषु (इच्छायाम्) - "किरच्" (उ० १-५१)<br><br>

इषीका
इषीका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಕಣ್ಣುಗುಡ್ಡೆ /ಆನೆಯ ಕಣ್ಣು ಗೋಳಕ<br><b>निष्पत्तिः - </b>इष (गतौ) - "इकन्" धातोः ह्रस्वश्च (उ० ४-२१)<br><br>इषीका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶತೃಣ /ಜಂಬುಹುಲ್ಲು<br><b>प्रयोगाः - </b>"तस्मिन्नास्थदिषीकास्त्रं रामो रामावबोधितः"<br><b>उल्लेखाः - </b>रघु० १३-२३<br><br>

इषु
इषु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣ<br><b>निष्पत्तिः - </b>ईष (गतिहिंसादर्शनेषु) - "उः" आदेरिच्च (उ० १-१३)<br><b>व्युत्पत्तिः - </b>इष्यते हिंसयतेऽनेन<br><b>प्रयोगाः - </b>"उत्कर्षः स च धन्विनां यदिषवः सिद्ध्यन्ति लक्ष्ये चले"<br><b>उल्लेखाः - </b>शाकु० २-५<br><br>इषु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೫ ಸಂಖ್ಯೆ<br><br>

इषुकार
इषुकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣವನ್ನು ತಯಾರಿಸುವವನು<br><br>

इषुधर
इषुधर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣವನ್ನು ಹಿಡಿದಿರುವವನು /ಬಿಲ್ಲುಗಾರ<br><b>निष्पत्तिः - </b>धृञ् (धारणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>धरतीति धरः । इषोर्धरः<br><br>

इषुधि
इषुधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬತ್ತಳಿಕೆ /ಬಾಣಗಳ ಚೀಲ<br><b>निष्पत्तिः - </b>"किः" (३-३-९३)<br><b>व्युत्पत्तिः - </b>इषवो धीयन्तेऽत्र<br><b>प्रयोगाः - </b>"स धनुर्महेषुधि बिभर्ति"<br><b>उल्लेखाः - </b>किरा० १२-२७<br><br>

इषुमात्र
इषुमात्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣದ ಅಳತೆ /ಬಾಣದ ಉದ್ದ<br><br>इषुमात्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾಣದ ಅಳತೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"मात्रच्" (५-२-३७)<br><b>व्युत्पत्तिः - </b>इषुः प्रमाणमस्य<br><br>

इषुविक्षेप
इषुविक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣವನ್ನು ಎಸೆಯುವಷ್ಟು ದೂರ /೧೫೦ ಮೊಳದಷ್ಟು ದೂರ<br><br>

इष्ट
इष्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>"इष्टोऽविशिष्टः शिष्टेष्टः"<br><b>उल्लेखाः - </b>वि० स०<br><br>इष्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹರಳು ಗಿಡ<br><br>इष्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗದಿಂದ ಸಂತೋಷಪಡಿಸಲ್ಪಟ್ಟ ಪರಮಾತ್ಮ<br><br>इष्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪತಿ /ಗಂಡ<br><br>इष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆ /ಅಭಿಲಾಷೆ<br><b>निष्पत्तिः - </b>इषु (इच्छायाम्) - भावे "क्तः" (३-३-११४)<br><br>इष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗ /ಯಜ್ಞ<br><b>निष्पत्तिः - </b>यज (देवपूजायाम्) - भावे "क्तः" (३-३-११४)<br><b>प्रयोगाः - </b>"पुरोडाशभुजामिष्टमिष्टं कर्तुमलन्तराम्"<br><b>उल्लेखाः - </b>माघ० २-१०६<br><br>इष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧರ್ಮಕಾರ್ಯ /ಮನುಷ್ಯನ ಕರ್ತವ್ಯ<br><b>प्रयोगाः - </b>"अग्निहोत्रं तपः सत्यं वेदानाञ्चानुपालनम् । आतिथ्यं वैश्वदेवं च प्राहुरिष्टमिति स्मृतम् ॥"<br><br>इष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೌತಕಾರ್ಯ<br><br>इष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>इषु (इच्छायाम्) - कर्म० "क्तः" (३-२-१०२)<br><br>इष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಟ್ಟ<br><br>इष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೌರವಿಸಲ್ಪಟ್ಟ<br><br>इष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಿಯವಾದ /ಪ್ರೀತಿಪಾತ್ರವಾದ<br><b>प्रयोगाः - </b>"इष्टप्रवासजनितान्यबलाजनस्य"<br><b>उल्लेखाः - </b>शाकु० ४-२<br><br>

इष्टकचित
इष्टकचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಟ್ಟಿಗೆಗಳಿಂದ ಕಟ್ಟಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>ह्रस्वः (६-३-६५)<br><b>व्युत्पत्तिः - </b>इष्टकाभिश्चितः<br><b>प्रयोगाः - </b>"घनेष्टकचितभित्तेरश्लक्ष्णतिरस्करिणीपटलस्य"<br><b>उल्लेखाः - </b>चं० रा०<br><br>

इष्टका
इष्टका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಟ್ಟಿಗೆ<br><b>निष्पत्तिः - </b>इषु (इच्छायाम्) - "तकन्" (उ० ३-१४८) । "इष्टकेषीकामालानां चिततूलभारिषु" इति निर्देशात् "प्रत्ययस्थात्" इति इत्वं न ।<br><br>

इष्टकापथ
इष्टकापथ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಮಂಚದ ಬೇರು<br><b>व्युत्पत्तिः - </b>इष्टं कापथमस्य<br><br>इष्टकापथ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಟ್ಟಿಗೆಯಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ ದಾರಿ<br><br>

इष्टगन्ध
इष्टगन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಗಂಧ /ಸುವಾಸನೆ<br><b>व्युत्पत्तिः - </b>इष्टश्चासौ गन्धश्च<br><br>इष्टगन्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುವಾಸನೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>इष्टो गन्धोऽस्य<br><br>इष्टगन्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುರಸುರಕೆ ಗಿಡ<br><br>

इष्टतम
इष्टतम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಪ್ರೀತಿಪಾತ್ರವಾದ<br><b>निष्पत्तिः - </b>"तमप्" (५-३-५५)<br><b>व्युत्पत्तिः - </b>अतिशयेन इष्टः<br><br>

इष्टतर
इष्टतर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಬ್ಬರಲಿ ಹೆಚ್ಚು ಪ್ರೀತಿಪಾತ್ರನಾದ ಒಬ್ಬ<br><b>निष्पत्तिः - </b>"तरप्" (५-३-५७)<br><b>व्युत्पत्तिः - </b>द्वयोरतिशयेन इष्टः<br><br>

इष्टदेव
इष्टदेव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಷ್ಟದೇವತೆ /ವಂಶಪರಂಪರೆಯಾಗಿ ಆರಾಧಿಸುವ ದೇವರು<br><br>इष्टदेव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಾಸ್ಯದೇವತೆ /ಉಪಾಸನೆ ಮಾಡುವ ಮಂತ್ರದ ದೇವತೆ<br><br>इष्टदेव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೇವತೆಗಳನ್ನು ಪೂಜಿಸಿದವನು<br><br>

इष्टप्रयोग
इष्टप्रयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣನಿಯಮದಂತೆ ಮಾಡುವ ಶಬ್ದಗಳ ಪ್ರಯೋಗ /ಶಾಸ್ತ್ರ ನಿಯಮದಂತೆ ಮಾಡುವ ಹಿರಿಯರ ಪ್ರಯೋಗ<br><br>

इष्टव्रत
इष्टव्रत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟವಾದ ವ್ರತವನ್ನು ಆಚರಿಸುವ<br><b>व्युत्पत्तिः - </b>इष्टं व्रतं यस्य<br><br>

इष्टसाधन
इष्टसाधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಷ್ಟವಾದುದನ್ನು ಸಾಧಿಸುವುದು<br><b>व्युत्पत्तिः - </b>इष्टस्य साधनम्<br><br>इष्टसाधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗ ಮೊದಲಾದುದು<br><br>

इष्टापत्ति
इष्टापत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಷ್ಟವಾದ ಘಟನೆ /ಇಷ್ಟವಾದುದು ಸಂಭವಿಸುವಿಕೆ<br><b>व्युत्पत्तिः - </b>इष्टस्य आपत्तिः<br><b>प्रयोगाः - </b>"इष्टापत्तिं ब्रुवाणस्य त्रैलोक्ये नास्ति दूषणम्"<br><br>

इष्टापूर्त
इष्टापूर्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧರ್ಮ ಕಾರ್ಯಾಚರಣೆ<br><b>निष्पत्तिः - </b>दीर्घः पृषो० ।<br><b>व्युत्पत्तिः - </b>इष्टं च पूर्तं च अनयोः समाहारः<br><b>प्रयोगाः - </b>"इष्टापूर्तविधेः सपत्नशमनात्"<br><b>उल्लेखाः - </b>म० वी० ३-१<br><br>

इष्टार्थ
इष्टार्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿತವಾದ ವಿಷಯ /ಇಷ್ಟವಾದ ವಿಷಯ<br><br>

इष्टार्थोद्युक्त
इष्टार्थोद्युक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟವಾದುದನ್ನು ಪಡೆಯುವುದರಲ್ಲಿ ಉದ್ಯೋಗವುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>इष्टार्थे उद्युक्तः<br><br>

इष्टि
इष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗ<br><b>निष्पत्तिः - </b>यज (देवपूजायाम्) -"क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"इष्टिं वैश्वानरीं नित्यं निर्वपेदब्दपर्यये"<br><b>उल्लेखाः - </b>मनु० ११-२७<br><br>इष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಚ್ಛೆ /ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>इषु (इच्छायाम्) - "क्तिन्" (३-३-९४)<br><b>विस्तारः - </b>"इष्टिर्मखेच्छयोः" - हेम० ।<br><br>इष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಣಿನಿ ಮತಾನುಸಾರವಾಗಿ ಮಹಾಭಾಷ್ಯಕಾರರ ಸಮ್ಮತಿವಚನ<br><b>प्रयोगाः - </b>"द्चिपर्यन्तानामेवेष्टिः"<br><br>

इष्टिका
इष्टिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಟ್ಟಿಗೆ<br><br>

इष्टिकापथ
इष्टिकापथ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಮಂಚದ ಬೇರು<br><br>

इष्टिन्
इष्टिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗ ಮಾಡಿದವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-८८)<br><b>व्युत्पत्तिः - </b>इष्टमनेन<br><br>

इष्टिपच
इष्टिपच<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಪಣ /ಲೋಭಿ<br><br>इष्टिपच<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಾಕ್ಷಸ<br><b>निष्पत्तिः - </b>डुपचष् (पाके) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>इष्टये इच्छायै पचति<br><br>

इष्ट्वा
इष्ट्वा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಾಗ ಮಾಡಿ<br><b>निष्पत्तिः - </b>यज (देवपूजायाम्) - "क्त्वा" (३-४-२१)<br><br>इष्ट्वा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಿ<br><b>निष्पत्तिः - </b>इषु (इच्छायाम्) - "क्त्वा" (३-४-२१)<br><br>

इष्वसन
इष्वसन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧನುಸ್ಸು /ಬಿಲ್ಲು<br><b>निष्पत्तिः - </b>असु (क्षेपणे) - "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>इषवः अस्यन्तेऽनेन<br><b>प्रयोगाः - </b>"राममिष्वसनदर्शनोत्सुकं मैथिलाय कथयाम्बभूव सः"<br><b>उल्लेखाः - </b>रघु० ११-३७<br><br>

इष्वास
इष्वास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧನುಸ್ಸು /ಬಿಲ್ಲು<br><b>निष्पत्तिः - </b>असु (क्षेपणे) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>इषवः अस्यन्तेऽनेन<br><b>प्रयोगाः - </b>"अत्र शूरा महेष्वासा भीमार्जुनसमा युधि"<br><b>उल्लेखाः - </b>गीता० १-४<br><br>इष्वास<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾಣವನ್ನು ಬಿಡುವವನು /ಅಸ್ತ್ರಪ್ರಯೋಗ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>असु (क्षेपणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>इषून् अस्यति<br><br>

इह
इह<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಇಲ್ಲಿ /ಈ ಪ್ರದೇಶದಲ್ಲಿ /ಈ ಜಾಗದಲ್ಲಿ<br><b>प्रयोगाः - </b>"उअ इमे कृष्णमिहार्चयन्त्यनन्याः"<br><b>उल्लेखाः - </b>याद० १५-९३<br><br>इह<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಈಗ /ಈ ಕಾಲದಲ್ಲಿ<br><br>इह<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಈ ಜನ್ಮದಲ್ಲಿ<br><b>प्रयोगाः - </b>"नेह नामुत्र तद्भवेत्"<br><b>उल्लेखाः - </b>मनु० ३-१८१<br><br>इह<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಈ ಲೋಕದಲ್ಲಿ<br><b>निष्पत्तिः - </b>इदम् - "हः" (५-३-११) । इश् (५-३-३)<br><b>प्रयोगाः - </b>"इह नाकदसो न मानुषास्ते"<br><b>उल्लेखाः - </b>याद० १५-९३<br><br>

इहतन
इहतन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈಗ ಇರುವ /ಈ ಕಾಲದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>इह - "ट्युल्" तुट् च (४-३-२३)<br><br>

इहत्य
इहत्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈ ಪ್ರದೇಶದಲ್ಲಿರುವ<br><br>इहत्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈ ಕಾಲದಲ್ಲಿರುವ<br><br>इहत्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈ ಜನ್ಮದಲ್ಲಿರುವ<br><br>इहत्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈ ಲೋಕದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"त्यप्" (४-२-१०४) । स्वार्थे "कन्"<br><b>व्युत्पत्तिः - </b>इह भवः<br><br>

इहत्यिका
इहत्यिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>इहत्य ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><br>

इहलोक
इहलोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈ ಲೋಕ /ನಾವು ಈಗ ಇರುವ ಲೋಕ<br><br>

इहस्थ
इहस्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಲ್ಲಿರುವ /ಈ ಪ್ರದೇಶದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>ष्ठा (गतिनिवृत्तौ) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>इह तिष्ठति<br><br>

ई
ई<br><br><b>कन्नडार्थः - </b>ಈಕಾರ<br><br>ई<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥ /ಕಾಮದೇವ<br><br>ई<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣ<br><br>ई<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ /ಹಾವು<br><br>ई<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂದರ /ಗುಹೆ<br><br>ई<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಮಿ<br><br>ई<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪದ್ಮದ ದಳ<br><br>ई<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಹ್ವೆ /ನಾಲಗೆ<br><br>ई<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಧನಸ್ಸು<br><br>ई<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸರಸ್ವತಿ<br><br>ई<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪದ್ಮದ ಕೇಸರ /ತಾವರೆ ಹೂವಿನ ಕುಸುರು<br><br>ई<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ದಯೆ /ಅನುಕಂಪ<br><br>ई<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿಷಾದ /ದುಃಖ<br><br>ई<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೋಪ<br><br>ई<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಬೋಧನೆ /ಕರೆ<br><b>विस्तारः - </b>"ई विषादेऽनुकम्पायां लक्ष्म्यां पुनरनव्ययम्" - मेदि० । "ईकारोऽब्जदले लक्ष्म्यां वाण्यां कमलकेसरे । रसनायां शक्रचापे बाणे फणिनि कन्दरे" - रत्न० ।<br><br>

ईक्ष|दर्शने|ईक्षते
ईक्ष - दर्शने (भ्वा० आत्म० सक० से०) ईक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ನೋಡು /ವೀಕ್ಷಿಸು<br><b>प्रयोगाः - </b>"क्षणलक्ष्यमाणवक्त्रश्रियः सभयकौतुकमीक्षते स्म"<br><b>उल्लेखाः - </b>माघ० ५-१७<br><br>

अधीक्ष|अधि + ईक्ष|अधीक्षते  
अधि + ईक्ष - अधीक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ವಿವೇಚಿಸು /ವಿಮರ್ಶಿಸು<br><b>प्रयोगाः - </b>"कुहकचकितो लोकः सत्येऽप्यपायमधीक्षते"<br><b>उल्लेखाः - </b>हितो० ४-१०२<br><br>

अनु + ईक्ष|अन्वीक्ष|अन्वीक्षते
अनु + ईक्ष = अन्वीक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚಿಂತಿಸು /ಧ್ಯಾನಿಸು<br><b>प्रयोगाः - </b>"अन्वीक्षमाणो रामस्तु विषण्णं भ्रान्तचेतनम्"<br><b>उल्लेखाः - </b>रामा०<br><br>

अप + ईक्ष|अपेक्ष|अपेक्षते
अप + ईक्ष = अपेक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸು /ಬಯಸು<br><b>प्रयोगाः - </b>"स तारकापातमपेक्षमाणः"<br><b>उल्लेखाः - </b>कुमा० १३-१३<br><br>

वि + अप + ईक्ष|व्यपेक्ष|व्यपेक्षते
वि + अप + ईक्ष = व्यपेक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸು /ಬಯಸು<br><b>प्रयोगाः - </b>"अन्तरेव विहरन् दिवानिशं न व्यपैक्षत समुत्सुकाः प्रजाः"<br><b>उल्लेखाः - </b>रघु० १९-६<br><br>

अव + ईक्ष|अवेक्ष|अवेक्षते
अव + ईक्ष = अवेक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ನೋಡು /ವೀಕ್ಷಿಸು<br><b>प्रयोगाः - </b>"विधत्सतः कलहमवेक्ष्य विद्विषः"<br><b>उल्लेखाः - </b>माघ० १७-५०<br><br>अव + ईक्ष = अवेक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಯೋಚಿಸು<br><b>प्रयोगाः - </b>"यदवोचदवेक्ष्य मानिनी परितः स्नेहमयेन चक्षुषा"<br><b>उल्लेखाः - </b>किरा० २-२<br><br>

अनु + अव + ईक्ष|अन्ववेक्ष|अन्ववेक्षते
अनु + अव + ईक्ष = अन्ववेक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪರ್ಯಾಲೋಚಿಸು<br><b>प्रयोगाः - </b>"सूक्ष्मतां चान्ववेक्षेत योगेन परमात्मनः"<br><b>उल्लेखाः - </b>मनु० ६-६५<br><br>

परि + अव + ईक्ष|पर्यवेक्ष|पर्यवेक्षते
परि + अव + ईक्ष = पर्यवेक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ನೋಡು<br><b>प्रयोगाः - </b>"निर्जितेन हरिणा हरिः स्वयं पर्यवैक्षि शरणं प्रियासखः"<br><b>उल्लेखाः - </b>याद० १७-८७<br><br>

प्रति + अव + ईक्ष|प्रत्यवेक्ष|प्रत्यवेक्षते
प्रति + अव + ईक्ष = प्रत्यवेक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ವಿಮರ್ಶಿಸಿ ನೋಡು /ಸರಿಯಾಗಿ ನೋಡು<br><b>प्रयोगाः - </b>"कामकीर्तिपताकाभिस्स ताभिः प्रत्यवेक्षितः"<br><b>उल्लेखाः - </b>याद० १६-१३८<br><br>प्रति + अव + ईक्ष = प्रत्यवेक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹಿಂತಿರುಗಿ ನೋಡು<br><b>प्रयोगाः - </b>"प्रत्यवेक्षणपदं प्रतीहि माम्"<br><b>उल्लेखाः - </b>याद० ११-११७<br><br>

सम् + अव + ईक्ष|समवेक्ष|समवेक्षते
सम् + अव + ईक्ष = समवेक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ನೋಡು<br><b>प्रयोगाः - </b>"यदि दृष्टं बलं सर्वं वयञ्च समवेक्षिताः"<br><b>उल्लेखाः - </b>भा०<br><br>

उद् + ईक्ष|उदीक्ष|उदीक्षते
उद् + ईक्ष = उदीक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಮೇಲೆ ನೋಡು<br><b>प्रयोगाः - </b>"सहस्ररश्मिना साक्षात् सप्रणाममुदीक्षिताः"<br><b>उल्लेखाः - </b>कुमा० ६-७<br><br>उद् + ईक्ष = उदीक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪ್ರತೀಕ್ಷಿಸು /ನಿರೀಕ್ಷಿಸು<br><b>प्रयोगाः - </b>"त्रीणि वर्षाण्युदीक्षेत कुमार्यृतुमती सती"<br><b>उल्लेखाः - </b>मनु० ९-९०<br><br>

उद् + वि + ईक्ष|उद्वीक्ष|उद्वीक्षते
उद् + वि + ईक्ष = उद्वीक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ನೋಡು /ವೀಕ್ಷಿಸು<br><b>प्रयोगाः - </b>"उद्वीक्ष्य प्रियकरकुड्मलापविद्धैर्वक्षोजद्वयमभिषिक्तमन्यनार्याः"<br><b>उल्लेखाः - </b>माघ० ८-३७<br><br>

उप + ईक्ष|उपेक्ष|उपेक्षते
उप + ईक्ष = उपेक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಉಪೇಕ್ಷಿಸು /ಉದಾಸೀನನಾಗಿರು<br><b>प्रयोगाः - </b>"उपेक्षते यः श्लथलम्बिनीर्जटाः"<br><b>उल्लेखाः - </b>कुमा० ५-४७<br><br>

सम् + उप + ईक्ष|समुपेक्ष|समुपेक्षते
सम् + उप + ईक्ष = समुपेक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಉಪೇಕ್ಷಿಸು<br><b>प्रयोगाः - </b>"शत्रुपक्षं समाधातुं यो मोहात् समुपेक्षते"<br><b>उल्लेखाः - </b>भा० सभा०<br><br>

निर् + ईक्ष|निरीक्ष|निरीक्षते
निर् + ईक्ष = निरीक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ನೋಡು<br><b>प्रयोगाः - </b>"निरीक्ष्य रामा बुबुधे नभश्चरैः"<br><b>उल्लेखाः - </b>किरा० ७-४०<br><br>

परि + ईक्ष|परीक्ष|परीक्षते
परि + ईक्ष = परीक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ತಿಳಿ /ತತ್ತ್ವವನ್ನು ಅರಿ<br><b>प्रयोगाः - </b>"मायां मयोद्भाव्य परीक्षितोऽसि"<br><b>उल्लेखाः - </b>रघु० २-६२<br><br>

प्र + ईक्ष|प्रेक्ष|प्रेक्षते
प्र + ईक्ष = प्रेक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ನೋಡು /ಸರಿಯಾಗಿ ನೋಡು<br><b>प्रयोगाः - </b>"प्रेक्ष्य देवपृतनामदूयत"<br><b>उल्लेखाः - </b>याद० १७-७०<br><br>

उत् + प्र + ईक्ष|उत्प्रेक्ष|उत्प्रेक्षते
उत् + प्र + ईक्ष = उत्प्रेक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಒಂದು ವಸ್ತುವಿನಲ್ಲಿ ಇನ್ನೊಂದರ ಧರ್ಮಸಂಬಂಧದಿಂದ ಅದರಂತೆಯೇ ನೋಡುವುದು<br><b>प्रयोगाः - </b>"उत्प्रेक्षामो वयं तावन्मतिमन्तं विभीषणम्"<br><b>उल्लेखाः - </b>रामा०<br><br>

सम् + प्र + ईक्ष|सम्प्रेक्ष|सम्प्रेक्षते
सम् + प्र + ईक्ष = सम्प्रेक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ನೋಡು<br><b>प्रयोगाः - </b>"सम्प्रेक्ष्य नासिकाग्रं स्वम्"<br><b>उल्लेखाः - </b>गीता० ६-१३<br><br>

प्रति + ईक्ष|प्रतीक्ष|प्रतीक्षते
प्रति + ईक्ष = प्रतीक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅನುಸರಿಸು<br><br>प्रति + ईक्ष = प्रतीक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಗೌರವಿಸು /ಪೂಜಿಸು<br><b>प्रयोगाः - </b>"प्रतीक्ष्य तत्प्रतीक्ष्यायै"<br><b>उल्लेखाः - </b>माघ० २-१०८<br><br>प्रति + ईक्ष = प्रतीक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸು /ಬಯಸು<br><b>प्रयोगाः - </b>"दयिततमामपरश्चिरं प्रतीक्ष्य"<br><b>उल्लेखाः - </b>माघ० ७-१३<br><br>

वि + ईक्ष|वीक्ष|वीक्षते
वि + ईक्ष = वीक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ನೋಡು /ಹೆಚ್ಚಾಗಿ ನೋಡು<br><b>प्रयोगाः - </b>"हरिवीक्षणक्षणिकचक्षुषान्यया"<br><b>उल्लेखाः - </b>माघ० १३-४४<br><br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸು /ಬಯಸು<br><b>प्रयोगाः - </b>"अन्तरेव विहरन् दिवानिशं न व्यपैक्षत समुत्सुकाः प्रजाः"<br><b>उल्लेखाः - </b>रघु० १९-६<br><br>

अभि + वि + ईक्ष|अभिवीक्ष|अभिवीक्षते
अभि + वि + ईक्ष = अभिवीक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ನೋಡು /ಸುತ್ತಲೂ ನೋಡು<br><b>प्रयोगाः - </b>"अभिवीक्ष्य विदर्भराजपुत्रीकुचकाश्मीरजचिह्नमच्युतोरः"<br><b>उल्लेखाः - </b>माघ० २०-६<br><br>

निर् + वि + अप + ईक्ष|निर्व्यपेक्ष|निर्व्यपेक्षते
निर् + वि + अप + ईक्ष = निर्व्यपेक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಆಸೆಯನ್ನು ತೊರೆ /ನಿಃಸ್ಪೃಹನಾಗಿರು<br><b>प्रयोगाः - </b>"उपस्थितायामपि निर्व्यपेक्षः"<br><b>उल्लेखाः - </b>रघु० १४-३९<br><br>

परि + वि + ईक्ष|परिवीक्ष|परिवीक्षते
परि + वि + ईक्ष = परिवीक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ತಿಳಿದುಕೊಳ್ಳು /ಅರ್ಥಮಾಡಿಕೊಳ್ಳು<br><b>प्रयोगाः - </b>"वीक्षितेन परिवीक्ष्य पार्वती मूर्धकम्पमयमुत्तरं ददौ"<br><b>उल्लेखाः - </b>कुमा० ८-६<br><br>

सम् + ईक्ष|समीक्ष|समीक्षते
सम् + ईक्ष = समीक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ನೋಡು /ವಿಮರ್ಶಿಸಿ ನೋಡು<br><b>प्रयोगाः - </b>"समीक्षिता ब्रह्मसुतस्य पत्नी सर्वैरभूत्सादरदर्शनीया"<br><b>उल्लेखाः - </b>याद० १३-९६<br><br>

प्र + सम् + ईक्ष|प्रसमीक्ष|प्रसमीक्षते
प्र + सम् + ईक्ष = प्रसमीक्षते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ತಿಳಿ /ಸರಿಯಾಗಿ ಅರಿತುಕೊಳ್ಳು<br><b>प्रयोगाः - </b>"कुलं ख्यातिं च वृत्तं च बुद्ध्यातु प्रसमीक्ष्य च"<br><b>उल्लेखाः - </b>भा०<br><br>

ईक्षक
ईक्षक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡುವಾನು<br><b>निष्पत्तिः - </b>ईक्ष (दर्शने) - "ण्वुल्" (३-१-१३३)<br><br>

ईक्षण
ईक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೇತ್ರ /ಕಣ್ಣು<br><b>निष्पत्तिः - </b>ईक्ष (दर्शने) - कर० "ल्युट्" (३-३-११७)<br><b>प्रयोगाः - </b>"ननन्दुरानन्दजलाविलेक्षणाः"<br><b>उल्लेखाः - </b>याद० १४-६४<br><br>ईक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದರ್ಶನ /ನೋಟ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"तेषां मध्यगता साध्वी पत्युः पादार्पितेक्षणा"<br><b>उल्लेखाः - </b>कुमा० ६-११<br><br>

ईक्षणिक
ईक्षणिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಮುದ್ರಿಕ ಲಕ್ಷಣಗಳ ನ್ನರಿತು ಶುಭಾಶುಭ ಫಲಗಳನ್ನು ಹೇಳುವವನು<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५)<br><b>व्युत्पत्तिः - </b>ईक्षणमस्त्यस्य<br><br>

ईक्षणिका
ईक्षणिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಮುದ್ರಿಕ ಲಕ್ಷಣಗಳ ನ್ನರಿತು ಶುಭಾಶುಭ ಫಲಗಳನ್ನು ಹೇಳುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्"<br><br>

ईक्षति
ईक्षति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೋಟ /ದರ್ಶನ<br><b>निष्पत्तिः - </b>ईक्ष (दर्शने) - "अतिः" बाहु० ।<br><br>

ईक्षा
ईक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೋಟ /ದರ್ಶನ<br><b>निष्पत्तिः - </b>ईक्ष (दर्शने) - "अः" (३-३-१०३)<br><br>ईक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಮರ್ಶೆ /ಪರ್ಯಾಲೋಚನೆ<br><br>

ईक्षित
ईक्षित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೋಟ /ದರ್ಶನ<br><b>निष्पत्तिः - </b>ईक्ष (दर्शने) - भावे "क्तः" (३-३-११४)<br><br>ईक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>ईक्ष (दर्शने) - कर्म० "क्तः" (३-२-१०२)<br><br>

ईडा
ईडा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತುತಿ /ಹೊಗಳಿಕೆ<br><b>निष्पत्तिः - </b>ईड (स्तुतौ) - "अः" (३-३-१०३)<br><br>

ईडित|ईलित 
ईडि(लि)त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ತ್ರೋತ್ರ ಮಾಡಲ್ಪಟ್ಟ /ಹೊಗಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>ईड (स्तुतौ) - कर्म० "क्तः" (३-२-१०२) । डलयोरभेदः ।<br><br>

ईड्य
ईड्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಗಳಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>ईड (स्तुतौ) - "ण्यत्" (३-१-१२४)<br><b>प्रयोगाः - </b>"पुत्रं लभस्वात्मगुणानुरूपं भवन्न्तमीड्यं भवतः पितेव"<br><b>उल्लेखाः - </b>रघु० ५-३४<br><br>

ईति
ईति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪದ್ರವ /ತೊಂದರೆ<br><b>निष्पत्तिः - </b>ईङ् (गतौ) - "क्तिच्" (३-३-१७४)<br><b>व्युत्पत्तिः - </b>ईयतेऽनया<br><b>प्रयोगाः - </b>"पुरुषायुषजीविन्यो निरातङ्का निरीतयः"<br><b>उल्लेखाः - </b>रघु० १-६३<br><b>विस्तारः - </b>"अतिवृष्टिरनावृष्टिर्मूषकाः शलभाः खगाः । अत्यासन्नाश्च राजानः षडेता ईतयः स्मृताः ॥"<br><br>ईति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯಾಣ /ಪ್ರವಾಸ<br><br>ईति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮರಿ /ಶಿಶು<br><b>विस्तारः - </b>"ईतिर्डिम्बे प्रवासेऽतिवृष्ट्यादिषट्सु च स्त्रियाम्" - मेदि० ।<br><br>

ईदृक्ता
ईदृक्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೀಗಿರುವಿಕೆ /ಈ ವಿಧವಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>ईदृशो भावः<br><b>प्रयोगाः - </b>"विष्णोरिवास्यानवधारणीयमीदृक्तया रूपमियत्तया वा"<br><b>उल्लेखाः - </b>रघु० १३-४<br><br>

ईदृश्
ईदृश्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈ ವಿಧವಾದ /ಈ ತೆರವಾದ<br><b>निष्पत्तिः - </b>इदम् + दृशिर् (प्रेक्षणे) - कर्मकर्त० "क्विन्" (३-२-६०) । ईश् आदेशः (६-३-९०)<br><b>व्युत्पत्तिः - </b>अयमिव पश्यति<br><b>प्रयोगाः - </b>"इदमीदृगनीदृगाशयः प्रसभं वक्तुमुपक्रमेत कः"<br><b>उल्लेखाः - </b>किरा० २-२८<br><br>

ईदृश
ईदृश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಂತಹ /ಈ ವಿಧವಾದ<br><b>निष्पत्तिः - </b>इदम् + दृशिर् (प्रेक्षणे) - कर्मकर्त० "कञ्" (३-२-६०) । ईश् आदेशः (६-३-९०)<br><b>व्युत्पत्तिः - </b>अयमिव पश्यति<br><b>प्रयोगाः - </b>"ईदृशस्य भवतः कथमेतल्लाघवं मुहुरतीव रतेषु"<br><b>उल्लेखाः - </b>माघ० १०-७७<br><br>

ईदृशी
ईदृशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂತಹ /ಈ ವಿಧವಾದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><b>प्रयोगाः - </b>"तेजसो महत ईदृशी गतिः"<br><b>उल्लेखाः - </b>कुमा० ८-४३<br><br>

ईदृक्ष
ईदृक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಂತಹ /ಈ ವಿಧವಾದ<br><b>निष्पत्तिः - </b>इदम् + दृशिर् (प्रेक्षणे) - कर्मकर्त० "क्सः" । ईश् आदेशः (६-३-९०)<br><br>

ईप्सा
ईप्सा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಂದಲು ಆಸೆ /ಪಡೆಯಲು ಆಸೆ<br><b>निष्पत्तिः - </b>आप्लृ (व्याप्तौ) + सन् - "अः" (३-३-१०२) । ईत् (७-४-५५)<br><b>व्युत्पत्तिः - </b>आप्तुमिच्छा<br><br>ईप्सा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಚ್ಛೆ /ಅಪೇಕ್ಷೆ<br><br>

ईप्सित
ईप्सित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಸೆ /ಹೊಂದಲು ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>आप्लृ (व्याप्तौ) + सन् - भावे "क्तः" (३-३-११४)<br><b>प्रयोगाः - </b>"ईप्सितं तदवज्ञानाद्विद्धि सार्गलमात्मनः"<br><b>उल्लेखाः - </b>रघु० १-७९<br><br>ईप्सित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಡೆಯಲು ಅಪೇಕ್ಷಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"क ईप्सितार्थस्थिरनिश्चयं मनः"<br><b>उल्लेखाः - </b>कुमा० ५-५<br><br>

ईप्सु
ईप्सु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲು ಅಪೇಕ್ಷೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>आप्लृ (व्याप्तौ) + सन् - "उः" (३-२-१६८) । ईत् (७-४-५५)<br><b>व्युत्पत्तिः - </b>आप्तुमिच्छुः<br><b>प्रयोगाः - </b>"सौरभ्यमीप्सुरिव ते मुखमारुतस्य"<br><b>उल्लेखाः - </b>रघु० ५-६९<br><br>

ईयिवस्
ईयिवस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿರುವ /ಪಡೆದಿರುವ<br><b>निष्पत्तिः - </b>इण् (गतौ) - "क्वसुः" (३-२-१०९) निपा० ।<br><br>

ईर|क्षेपे|ईरयति|ईरयते
ईर - क्षेपे (वा चुरा० उभ० सक० से०) ईरयति-ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಎಸೆ /ಬಿಸಾಡು<br><br>ईर - क्षेपे (वा चुरा० उभ० सक० से०) ईरयति-ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚೋದಿಸು /ಪ್ರೇರಿಸು<br><br>

उद् + ईर|उदीर|उदीरयति
उद् + ईर = उदीरयति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಸೆ /ಎರಚು<br><br>उद् + ईर = उदीरयति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಉಚ್ಚರಿಸು /ನುಡಿ<br><b>प्रयोगाः - </b>"उदीरितां तामिति याज्ञसेन्या"<br><b>उल्लेखाः - </b>किरा० ३-५५<br><br>

अभि + उद् + ईर|अभ्युदीर|अभ्युदीरयति
अभि + उद् + ईर = अभ्युदीरयति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಹೇಳು<br><br>अभि + उद् + ईर = अभ्युदीरयति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಎರಚು /ಎಸೆ<br><b>प्रयोगाः - </b>"निधाय पाणावृषिणाभ्युदीरितः"<br><b>उल्लेखाः - </b>माघ० १-१८<br><br>

सम् + उद् + ईर|समुदीर|समुदीरयति
सम् + उद् + ईर = समुदीरयति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಹೇಳು /ಸರಿಯಾಗಿ ಉಚ್ಚರಿಸು<br><br>

प्र + ईर|प्रेर|प्रेरयति
प्र + ईर = प्रेरयति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚೋದಿಸು /ಪ್ರೇರಿಸು<br><br>प्र + ईर = प्रेरयति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಬಿಡು /ಕಳುಹಿಸು<br><b>प्रयोगाः - </b>"प्रेरितः शशधरेण करौघः"<br><b>उल्लेखाः - </b>किरा० ९-२८<br><br>

सम् + ईर|समीर|समीरयति
सम् + ईर = समीरयति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಹೇಳು /ಸರಿಯಾಗಿ ಉಚ್ಚರಿಸು<br><br>सम् + ईर = समीरयति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪ್ರೇರಿಸು<br><br>

ईर
ईर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಸೆಯುವ /ಎರಚುವ<br><br>ईर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೋಗುವ<br><br>ईर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಲಿಸುವ /ಅಲುಗಾಡುವ<br><b>निष्पत्तिः - </b>ईर (गतौ कम्पने क्षेपे च) - "अच्" (३-१-१३४)<br><br>

ईरण
ईरण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯು /ಗಾಳಿ<br><b>निष्पत्तिः - </b>ईर (गतौ) - "युच्" (३-२-१४८)<br><br>ईरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಮನ /ಸಂಚಾರ<br><br>ईरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಲನ /ಅಲುಗಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>ईर (गतौ) - भावे "ल्युट्" (३-३-११५)<br><br>ईरण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೋದಿಸುವ /ಪ್ರೇರಿಸುವ<br><b>निष्पत्तिः - </b>ईर - कर्त० "ल्युः" (३-१-१३४)<br><br>

ईरिण
ईरिण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಷರಭೂಮಿ /ಉಪ್ಪು ಮಣ್ಣಿನ ಭೂಮಿ<br><br>

ईरित
ईरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>ईर (गतौ कम्पने क्षेपे च) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"यद्वासुदेवेनादीनमनादीनवमीरितम्"<br><b>उल्लेखाः - </b>माघ० २-२२<br><br>ईरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೇರಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अपरागसमीरणेरितः क्रमशीर्णाकुलमूलसन्ततिः"<br><b>उल्लेखाः - </b>किरा० २-५०<br><br>

ईरिन्
ईरिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಲಿಸುವ /ಅಲುಗಾಡುವ<br><br>ईरिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಗುವ /ಸಂಚರಿಸುವ<br><br>

ईर्म
ईर्म<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ರಣ /ಹುಣ್ಣು<br><b>निष्पत्तिः - </b>ईर (गतौ) - "मन्" बाहु० ।<br><b>व्युत्पत्तिः - </b>ईरयति सुखम्<br><br>

ईर्वारु
ईर्वारु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೌತೆಗಿಡ<br><b>निष्पत्तिः - </b>ईर (गतौ) - "क्विप्" (वा० ३-३-९४) । वृञ् (वरणे) - "उण्" बाहु० ।<br><b>व्युत्पत्तिः - </b>ईरं वारयति ।<br><br>

ईर्ष्यन्
ईर्ष्यन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸೂಯೆಪಡುತ್ತಿರುವ /ಅಸಹನೆ ತೋರಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>ईर्ष्य (ईर्ष्यायाम्) - "शतृ" (३-२-१२४)<br><br>

ईर्ष्यन्ती
ईर्ष्यन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸೂಯೆಪಡುತ್ತಿರುವ /ಅಸಹನೆ ತೋರಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><b>प्रयोगाः - </b>"ईर्ष्यन्त्या वदनमसिक्तमप्यनल्पस्वेदाम्बुस्नपितमजायतेतरस्याः"<br><b>उल्लेखाः - </b>माघ० ८-३६<br><br>

ईर्ष्या
ईर्ष्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಹನೆ /ಇತರರ ಅಭಿವೃದ್ಧಿಯನ್ನು ಸಹಿಸದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>ईर्ष्य (ईर्ष्यायाम्) -"अः" (३-३-१०३)<br><b>प्रयोगाः - </b>"निःशङ्कमन्याः सममाहितेर्ष्याः"<br><b>उल्लेखाः - </b>माघ० ३-१६<br><br>

ईली
ईली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಈಳಿಗೆ ಮಣೆಯ ಕತ್ತಿ<br><br>ईली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಟುಕತ್ತಿ /ತುಂಡುಕತ್ತಿ<br><b>निष्पत्तिः - </b>ईर (गतौ) - "इन्" (उ० ४-११७) । रलयोरभेदः ।<br><b>व्युत्पत्तिः - </b>ईर्ते<br><br>

ईश
ईश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><b>निष्पत्तिः - </b>ईश (ऐश्वर्ये) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>ईष्टे<br><b>प्रयोगाः - </b>"सम्भोगवेश्म प्रविशन्तमन्तर्ददर्श पारावतमेकमीशः"<br><b>उल्लेखाः - </b>कुमा० ९-१<br><br>ईश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><br>ईश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪತಿ /ಗಂಡ<br><br>ईश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಜಮಾನ /ದಣಿ /ಒಡೆಯ<br><b>प्रयोगाः - </b>"प्रयत्नसंस्तम्भितविक्रयिणां कथञ्चिदिशा मनसां बभूवुः"<br><b>उल्लेखाः - </b>कुमा० ३-३४<br><br>ईश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮರ್ಥ /ಶಕ್ತ<br><br>

ईशकोण
ईशकोण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೂರ್ವ ಮತ್ತು ಉತ್ತರ ದಿಕ್ಕುಗಳ ಮಧ್ಯದ ವಿದಿಕ್ಕು /ಈಶ್ವರನು ಅಧಿಪತಿಯಾಗಿರುವ ಈಶಾನ್ಯ ದಿಕ್ಕು<br><b>व्युत्पत्तिः - </b>ईशस्वामिकः कोणः<br><br>

ईशा
ईशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಐಶ್ವರ್ಯವಂತ ಹೆಂಗಸು<br><br>ईशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ<br><br>

ईशान
ईशान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><b>निष्पत्तिः - </b>ईश (ऐश्वर्ये) - ताच्छील्ये "चानश्" (३-३-१२९)<br><b>व्युत्पत्तिः - </b>ईष्टे<br><b>प्रयोगाः - </b>"परीत्येशानं त्रिः स्तुतिभिरुपगीतः सुरगणैः"<br><b>उल्लेखाः - </b>किरा० १८-४५<br><br>ईशान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರನ ೮ ಮೂರ್ತಿಗಳಲ್ಲೊಂದು<br><br>ईशान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ ದೇವತಾಕವಾದ ಆರಿದ್ರಾನಕ್ಷತ್ರ<br><br>ईशान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಜಮಾನ /ದಣಿ /ಒಡೆಯ<br><br>ईशान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಐಶ್ವರ್ಯದಿಂದ ಕೂಡಿದ<br><br>

ईशिता
ईशिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಣಿಮಾದಿ ೮ ಐಶ್ವರ್ಯಗಳಲ್ಲೊಂದು<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>ईशिनो भावः<br><br>

ईशित्व
ईशित्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಣಿಮಾದಿ ೮ ಐಶ್ವರ್ಯಗಳಲ್ಲೊಂದು<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

ईशितृ
ईशितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಜಮಾನ /ದಣಿ /ಒಡೆಯ<br><b>निष्पत्तिः - </b>ईश (ऐश्वर्ये) - "तृन्" (३-२-१३५)<br><b>व्युत्पत्तिः - </b>ईष्टे<br><b>प्रयोगाः - </b>"तदीशितारं चेदीनां भवांस्तमवमंस्त मा"<br><b>उल्लेखाः - </b>माघ० २-९५<br><br>

ईशित्री
ईशित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಡತಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

ईशिन्
ईशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಭು /ಸ್ವಾಮಿ /ಒಡೆಯ<br><br>ईशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪತಿ /ಗಂಡ<br><b>निष्पत्तिः - </b>ईश (ऐश्वर्ये) - "णिनिः" (३-३-१७०)<br><br>

ईशिनी
ईशिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ईशिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

ईश्वर
ईश्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><b>निष्पत्तिः - </b>ईश (ऐश्वर्ये) - "वरच्" (३-२-१७५)<br><b>व्युत्पत्तिः - </b>ईष्टे<br><b>प्रयोगाः - </b>"ईश्वरोऽपि दिवसात्ययोचितं मन्त्रपूर्वमनुतस्थिवान्विधिम्"<br><b>उल्लेखाः - </b>कुमा० ८-५०<br><br>ईश्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ /ಪರಮೇಶ್ವರ<br><b>प्रयोगाः - </b>"ईश्वरः सर्वभूतानां हृद्देशेऽर्जुन तिष्ठति"<br><b>उल्लेखाः - </b>गीता० १८-६१<br><br>ईश्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥ /ಕಾಮದೇವ<br><br>ईश्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ /ದೊರೆ<br><b>प्रयोगाः - </b>"ऐश्वर्यादनपेतमीश्वरमयं लोकोऽर्थतः सेवते"<br><b>उल्लेखाः - </b>मुद्रा० १-१४<br><br>ईश्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಭವಾದಿ ಸಂವತ್ಸರಗಳಲ್ಲಿ ಒಂದು<br><br>ईश्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೀವ<br><br>ईश्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪತಿ /ಗಂಡ<br><br>ईश्वर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧನಿ /ಸಾಹುಕಾರ<br><br>ईश्वर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಜಮಾನ /ಸ್ವಾಮಿ<br><b>विस्तारः - </b>"ईश्वरो अन्मथे शम्भौ नाढ्ये स्वामिनि वाच्यवत्" - मेदि० ।<br><br>

ईश्वरा
ईश्वरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೌರಿ /ಪಾರ್ವತಿ<br><b>प्रयोगाः - </b>"विन्यस्तमङ्गलमहौषधिरीश्वरायाः"<br><b>उल्लेखाः - </b>किरा० ५-३३<br><br>ईश्वरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಮಿ<br><br>

ईश्वरी
ईश्वरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೌರಿ /ಪಾರ್ವತಿ<br><br>ईश्वरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರೀಹಂಬು<br><br>ईश्वरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಐಶ್ವರ್ಯವಂತನ ಹೆಂಗಸು<br><br>

ईषत्
ईषत्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ /ಕೊಂಚ<br><b>निष्पत्तिः - </b>ईष (गतिहिंसादर्शनेषु) - "अत्"<br><b>प्रयोगाः - </b>"ईषत्तिर्यग्वलनविषमं कूणितप्रान्तमेतत्"<br><b>उल्लेखाः - </b>मालती० ४-२<br><br>ईषत्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕದಾದ /ಸಣ್ಣದಾದ<br><br>

ईषत्कर
ईषत्कर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಪ್ರಯಾಸದಿಂದ ಮಾಡುವ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "खल्" (३-३-१२६)<br><b>व्युत्पत्तिः - </b>ईषत्करोति<br><b>विस्तारः - </b>"ईषत्करः प्रपञ्चो हरिणा" - सि० कौ०<br><br>

ईषत्पाण्डु
ईषत्पाण्डु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆ ಬಿಳುಪುಬಣ್ಣ<br><br>ईषत्पाण्डु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಬಿಳುಪಾದ<br><b>व्युत्पत्तिः - </b>ईषत् पाण्डुः<br><br>

ईषदुष्ण
ईषदुष्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಬಿಸಿಯಾದ /ಬೆಚ್ಚನಾದ<br><br>

ईषद्रक्त
ईषद्रक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆಗೆಂಪು<br><br>ईषद्रक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಗೆಂಪಾದ<br><br>

ईषा
ईषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೇಗಿಲಿನ ದಂಡ /ನೇಗಿಲಿನ ಈಚು<br><br>ईषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಡಿಯ ಮೂಕಿಮರ /ರಥದ ಒಂದು ಅವಯವ<br><b>निष्पत्तिः - </b>ईष (गतौ) - "अः" (३-३-१०३)<br><b>प्रयोगाः - </b>"ईषामन्ये हयानन्ये सूतमन्यं न्यपातयन्"<br><b>उल्लेखाः - </b>भा० वन० १४२-३३<br><br>

ईषादन्त
ईषादन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೇಗಿಲಿನಂತೆ ಉದ್ದವಾದ ಕೊಂಬುಳ್ಳ ಆನೆ<br><b>व्युत्पत्तिः - </b>ईषेव दीर्घो दन्तोऽस्य<br><b>प्रयोगाः - </b>"उत्क्षिप्योच्चैः प्रस्फुरन्तं रदाभ्यामीषादन्तः कुञ्जरं शात्रवीयम्"<br><b>उल्लेखाः - </b>माघ० १८-३८<br><br>ईषादन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಬ್ಬಿದ ಹಲ್ಲುಳ್ಳ ಮನುಷ್ಯ<br><br>

ईषिका
ईषिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಕಣ್ಣುಗುಡ್ಡೆ<br><br>ईषिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೌಂಜಿ ಹುಲ್ಲಿನಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ ಅಸ್ತ್ರ<br><b>प्रयोगाः - </b>"सोऽभिमन्त्र्य शरेषीकामीषिकास्त्रेण वीर्यवान् । काकं तमभिसन्धाय ससर्ज पुरुषर्षभः ॥"<br><b>उल्लेखाः - </b>रामा०<br><br>

ईषीका
ईषीका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೂಲಿಕೆ /ಕುಂಚ<br><br>

ईष|चेष्टायाम्|ईहते
ईष - चेष्टायाम् (भ्वा० आत्म० अक० से०) ईहते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸು /ಬಯಸು<br><br>ईष - चेष्टायाम् (भ्वा० आत्म० अक० से०) ईहते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನಿಸು<br><b>प्रयोगाः - </b>"दुरोदरच्छद्मजितां समीहते नयेन जेतुं जगतीं सुयोधनः"<br><b>उल्लेखाः - </b>किरा० १-७<br><br>

ईहन
ईहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸುವಿಕೆ<br><br>ईहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>ईष (चेष्टायाम्) - "ल्युट्" (३-३-११५)<br><br>

ईहनीय
ईहनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>ईष (चेष्टायाम्) - "अनीयर्" (३-१-९६)<br><br>

ईहमान
ईहमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸುವ /ಇಚ್ಛಿಸುವ<br><b>निष्पत्तिः - </b>ईष (चेष्टायाम्) - "शानच्" (३-२-१२४)<br><br>ईहमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನಪಡುವ<br><br>

ईहा
ईहा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆ<br><br>ईहा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನ<br><br>ईहा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚೇಷ್ಟೆ /ವ್ಯಾಪಾರ<br><b>निष्पत्तिः - </b>ईष (चेष्टायाम्) - "अः" (३-३-१०३)<br><br>

ईहामृग
ईहामृग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೋಳ /ವೃಕ<br><b>व्युत्पत्तिः - </b>ईहाप्रधानो मृगः<br><br>ईहामृग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಶರೂಪಕಗಳಲ್ಲೊಂದು<br><b>विस्तारः - </b>"ईहामृगस्तु पुंसि स्यात् कोकरूपकभेदयोः ।" - मेदि० ।<br><br>

ईहावृक
ईहावृक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೋಳ /ವೃಕ<br><b>व्युत्पत्तिः - </b>ईहाप्रधानो वृकः<br><br>

ईहित
ईहित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆ /ಅಭಿಲಾಷೆ<br><br>ईहित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನ<br><br>ईहित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚೇಷ್ಟೆ /ವ್ಯಾಪಾರ<br><b>निष्पत्तिः - </b>ईष (चेष्टायाम्) - भावे "क्तः" (३-३-११४)<br><b>प्रयोगाः - </b>"अकृत्रिमप्रेमरसाहितैर्मनो हरन्ति रामा कृतकैरपीहितैः"<br><b>उल्लेखाः - </b>किरा० ८-४६<br><br>ईहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"यद्विस्मर्तुमपीहितं शमवता शान्तिं कुलस्येच्छता"<br><b>उल्लेखाः - </b>वेणी० १-२४<br><br>ईहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಡಲು ಪ್ರಯತ್ನಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"ह्रीमत्या शिरसीहितः सपुलकस्वेदोद्गमोत्कम्पया"<br><b>उल्लेखाः - </b>रत्ना० १-१<br><br>

उ
उ<br><br><b>कन्नडार्थः - </b>ಉಕಾರ<br><b>विस्तारः - </b>ಇದು ವರ್ಣಮಾಲೆಯಲ್ಲಿ ಐದನೆಯ ಸ್ವರವರ್ಣವು. ಉದಾತ್ತ ಅನುದಾತ್ತ ಮತ್ತು ಸ್ವರಿತ ಭೇದದಿಂದ ಮೂರು ವಿಧವಾಗಿ ಪುನಃ ಅನುನಾಸಿಕ ಅನನುನಾಸಿಕ ಭೇದದಿಂದ ೬ ವಿಧವಾಗುವುದು. ಇದು ಆಭ್ಯಂತರ ವಿವೃತ ಪ್ರಯತ್ನದಿಂದ ಓಷ್ಠ ಸ್ಥಾನದಲ್ಲಿ ಹುಟ್ಟುವುದು.<br><br>उ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ<br><b>प्रयोगाः - </b>"अकारो विष्णुरुद्दिश्य उकारस्तु महेश्वरः"<br><br>उ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ಷತ್ರಿಯ<br><br>उ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೇತ್ರ /ಕಣ್ಣು<br><br>उ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರನ ಶಿರಸ್ಸು<br><br>उ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>विस्तारः - </b>"उकारः क्षत्रिये नेत्रे हरमौलौ हरे हरौ" - नानार्थर० ।<br><br>उ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಬೋಧನೆ /ಕರೆ<br><b>प्रयोगाः - </b>"उ मेति मात्रा तपसो निषिद्धा पश्चादुमाख्यायां सुमुखी जगाम"<br><b>उल्लेखाः - </b>कुमा० १-२६<br><br>उ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೋಪದ ಮಾತು<br><br>उ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ<br><br>उ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ<br><br>उ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪಾದಪೂರಣ<br><br>उ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನುಕಂಪ /ದಯೆ<br><br>उ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಯೋಗ /ಅಪ್ಪಣೆ<br><b>विस्तारः - </b>"उ सम्बोधने रोषिक्त्योरनुकम्पानियोगयोः । पदस्य पूरणे पादपूरणेऽपि च दृश्यते" - मेदि० ।<br><br>

उकार
उकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ /ಶಿವ<br><br>उकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉ ವರ್ಣ<br><br>

उक्त
उक्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಕ್ತಿ /ಮಾತು<br><b>निष्पत्तिः - </b>वच (परिभाषणे) - भावे "क्तः"(३-३-११४)<br><b>प्रयोगाः - </b>"बालादपि ग्रहीतव्यं युक्तमुक्तं ननीषिभिः"<br><b>उल्लेखाः - </b>हितो०<br><br>उक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>वच - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"सम्प्रत्यसाम्प्रतं वक्तुमुक्ते मुसलपाणिना"<br><b>उल्लेखाः - </b>माघ० २-७०<br><br>उक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಸಲ್ಪಟ್ಟ /ಹೇಳಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"असावनुक्तोऽपि सहाय एव"<br><b>उल्लेखाः - </b>कुमा० ३-२१<br><br>

उक्ता
उक्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಅಕ್ಷರದ ಪಾದವುಳ್ಳ ಛಂದಸ್ಸು<br><b>प्रयोगाः - </b>"उक्तानुक्ता तथा मध्या"<br><b>उल्लेखाः - </b>वृ० र०<br><br>

उक्तवत्
उक्तवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಿದವನು /ಮಾತನಾಡಿದವನು<br><b>निष्पत्तिः - </b>वच (परिभाषणे) - "क्तवतुः" (३-२-१०२)<br><b>प्रयोगाः - </b>"इत्युक्तवन्तं व्रज साधयेति"<br><b>उल्लेखाः - </b>किरा० ३-२४<br><br>

उक्ति
उक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾತು<br><b>निष्पत्तिः - </b>वच (परिभाषणे) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"इत्युक्तवानुक्तिविशेषरम्यं मनः समाधाय जयोपपत्तौ"<br><b>उल्लेखाः - </b>किरा० ३-१०<br><br>उक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದ ಶಕ್ತಿ /ಶಬ್ದಕ್ಕೆ ಅರ್ಥವನ್ನು ಕೊಡುವ ಯೋಗ್ಯತೆ<br><br>

उक्ष|सेचने|उक्षति
उक्ष - सेचने (भ्वा० पर० सक० से०) उक्षति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಿಂಪಿಸು /ಸೇಚನೆ ಮಾಡು<br><b>प्रयोगाः - </b>"उक्षाम्बभूवुरभितो वपुरम्बुवर्षैः"<br><b>उल्लेखाः - </b>माघ० ५-३०<br><br>

अभि + उक्ष|अभ्युक्ष|अभ्युक्षति
अभि + उक्ष = अभ्युक्षति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹಸ್ತವನ್ನು ಕೆಳಮುಖವಾಗಿ ಮಾಡಿ ನೀರನ್ನು ಚಿಮುಕಿಸುವಿಕೆ<br><br>

अव + उक्ष|अवोक्ष|अवोक्षति
अव + उक्ष = अवोक्षति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹಸ್ತವನ್ನು ಓರೆ ಮಾಡಿ ನೀರನ್ನು ಚೆಲ್ಲುವುದು<br><br>

प्र + उक्ष|प्रोक्ष|प्रोक्षति
प्र + उक्ष = प्रोक्षति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹಸ್ತವನ್ನು ಮೇಲುಮುಖ ಮಾಡಿ ನೀರನ್ನು ಚೆಲ್ಲುವುದು<br><b>प्रयोगाः - </b>"उत्तानेनैव हस्तेन प्रोक्षणं परिकीर्तितम् । न्यञ्चताऽभ्युक्षणं प्रोक्तं तिरश्चावोक्षणं स्मृतम् ॥"<br><br>

उक्षण
उक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರನ್ನು ಪ್ರೋಕ್ಷಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>उक्ष (सेचने) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"वसिष्ठमन्त्रोक्षणजात्प्रभावात् उदन्वदाकाशमहीधरेषु"<br><b>उल्लेखाः - </b>रघु० ५-२७<br><br>

उक्षतर
उक्षतर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಹೋರಿ /ಗಾಡಿಗೆ ಕಟ್ಟುವ ವಯಸ್ಸಿನ ಹೋರಿ<br><b>निष्पत्तिः - </b>"तरप्"<br><b>व्युत्पत्तिः - </b>अल्पः उक्षा<br><b>प्रयोगाः - </b>"अनुक्षणं नोक्षतरः प्रतीच्छति"<br><b>उल्लेखाः - </b>माघ० १२-१०<br><br>

उक्षन्
उक्षन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಷಭ /ಎತ್ತು<br><b>निष्पत्तिः - </b>उक्ष (सेचने) - "कनिः" (उ० १-१५७)<br><b>प्रयोगाः - </b>"परीतमुक्षावजये जयश्रिया नदन्तमुच्चैः क्षतसिन्धुरोधसम्"<br><b>उल्लेखाः - </b>किरा० ४-११<br><b>विस्तारः - </b>ಕೆಲವೆಡೆ ಸಮಾಸಾಂತ್ಯದಲ್ಲಿ ಅಜಂತವಾಗಿ महोक्षः, वृद्धोक्षः ಇತ್ಯಾದಿ ರೂಪವಾಗುವುದು.<br><br>उक्षन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರನ್ನು ಚೆಲ್ಲುವ /ನೀರನ್ನು ಸಿಂಪಿಸುವ<br><br>

उक्षित
उक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೆನೆಸಲ್ಪಟ್ಟ /ತೋಯಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उक्ष (सेचने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"शस्त्रैर्द्विषच्छिरच्छेदप्रोच्छलच्छोणितोक्षितैः"<br><b>उल्लेखाः - </b>माघ० २-६६<br><br>

उखा
उखा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಡಿಗೆಯ ತಪ್ಪಲೆ /ಅನ್ನ ಬೇಯಿಸುವ ಪಾತ್ರೆ<br><b>निष्पत्तिः - </b>उख (गतौ) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>ओखति<br><br>उखा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಕುಂಡ<br><br>

उख्य
उख्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಡಕೆಯಲ್ಲಿ ಬೇಯಿಸಲ್ಪಟ್ಟ ಅನ್ನ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>"यत्" (४-२-१७)<br><b>व्युत्पत्तिः - </b>उखायां संस्कृतम्<br><b>प्रयोगाः - </b>"शूलमुख्यं च होमवान्"<br><b>उल्लेखाः - </b>भट्टि० ४-९<br><br>

उग्र
उग्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ /ಮಹಾದೇವ<br><b>निष्पत्तिः - </b>उच (समवाये)- "रन्" गश्चान्तादेशः (उ० २-२८)<br><b>प्रयोगाः - </b>"वहन्विरूपं वपुरुग्ररेतश्चयेन वह्निः किल निर्जगाम"<br><b>उल्लेखाः - </b>कुमा० ९-१७<br><br>उग्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯು /ಗಾಳಿ<br><b>विस्तारः - </b>"वैश्याशूद्रयोस्तु राजन्यात् माहिष्योग्रौ सुतौ स्मृतौ" - शङ्खलिं०<br><br>उग्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ಷತ್ರಿಯನಿಂದ ಶೂದ್ರಹೆಂಗಸಿನಲ್ಲಿ ಹುಟ್ಟಿದ ಬೆರಕೆ ಜಾತಿಯವನು<br><br>उग्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನುಗ್ಗೆ ಮರ<br><br>उग्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇರಳ ದೇಶ<br><br>उग्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೌದ್ರರಸ<br><br>उग्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರಶವ /ಶೂದ್ರ ಸ್ತ್ರೀಯಲ್ಲಿ ಬ್ರಾಹ್ಮಣನಿಗೆ ಜನಿಸಿದ ಸಂಕರ ಜಾತಿಯವನು /ಕೋಟೆ ಬೊಕ್ಕಸ ಮತ್ತು ಅಂತಃಪುರಗಳನ್ನು ರಕ್ಷಿಸುವವನು<br><b>विस्तारः - </b>"उग्रः पारशवो दुर्गन्धनान्तःपुरपालनात्" - वैज० ।<br><br>उग्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪ /ಸಿಟ್ಟು<br><br>उग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಪ್ಪಿಗೆ ತಕ್ಕ ಶಿಕ್ಷೆ ವಿಧಿಸುವವನು<br><br>उग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ರೂರ /ದಯೆಯಿಲ್ಲದವನು<br><br>उग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೀವ್ರವಾದ /ತೀಕ್ಷ್ಣವಾದ<br><br>उग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೀರ್ಘವಾದ /ಉದ್ದವಾದ<br><br>उग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪ ಸ್ವಭಾವದ<br><br>उग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಾಕ್ರಮಿ /ಬಲಶಾಲಿ<br><br>उग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೀತಿಯನ್ನುಂಟುಮಾಡುವ<br><br>

उग्रा
उग्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಜೆ<br><br>उग्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಜವಾನ /ಓಮ<br><br>उग्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರ್ವತಿ<br><br>उग्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರೂರ ಹೆಂಗಸು<br><br>

उग्रकर्मन्
उग्रकर्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ರೂರವಾದ ಕೆಲಸವುಳ್ಳ /ಕರುಣೆಯಿಲ್ಲದ /ನಿರ್ದಯ<br><b>व्युत्पत्तिः - </b>उग्रं कर्मास्य<br><br>

उग्रकाण्ड
उग्रकाण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಗಲ ಗಿಡ<br><br>

उग्रगन्ध
उग्रगन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪಿಗೆ ಮರ<br><br>उग्रगन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೇಗದ ಮರ<br><br>उग्रगन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಳ್ಳುಳ್ಳಿ<br><br>उग्रगन्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಗು<br><br>उग्रगन्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಕಟವಾದ ವಾಸನೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>उग्रो गन्धो यस्य<br><br>

उग्रगन्धा
उग्रगन्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಜವಾನ /ಓಮ<br><br>उग्रगन्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಜೆ<br><b>विस्तारः - </b>"उग्रगन्धाजमोदायां वचायां चिक्किकोषधौ" - मेदि० । "वचाजमोदयोरुग्रगन्धा स्त्री लशुने तु ना" - नानार्थर० ।<br><br>

उग्रता
उग्रता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಗ್ರವಾದ ಕೆಲಸ<br><br>उग्रता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೀಕ್ಷ್ಣ್ಣತೆ /ಚುರುಕು<br><br>उग्रता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವ್ಯಭಿಚಾರಿ ಭಾವ<br><b>प्रयोगाः - </b>"शौर्यापराधादिभवं भवेच्चण्डत्वमुग्रता"<br><b>उल्लेखाः - </b>सा० द०<br><br>

उग्रतारा
उग्रतारा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವಿ /ಭಯಂಕರ ವಿಪತ್ತಿನಿಂದ ಪಾರುಮಾಡುವ ಮಹಾದೇವಿ<br><b>प्रयोगाः - </b>"तारकत्वात्सदा तारा महामोक्षप्रदायिनी । उग्रापत्तारिणी यस्मादुग्रतारा प्रकीर्तिता ॥"<br><br>

उग्रदण्ड
उग्रदण्ड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಠಿನವಾದ ಶಿಕ್ಷೆ ಕೊಡುವವನು<br><b>व्युत्पत्तिः - </b>उग्रो दण्डो यस्य<br><br>

उग्रधन्वन्
उग्रधन्वन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><br>उग्रधन्वन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯಂಕರವಾದ ಧನುಸ್ಸುಳ್ಳ<br><b>निष्पत्तिः - </b>"अनङ्" (५-४-१३२)<br><b>व्युत्पत्तिः - </b>उग्रं धनुर्यस्य<br><br>

उग्रनासिक
उग्रनासिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ದವಾದ ಮೂಗುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>उग्रा दीर्घा नासिका यस्य<br><br>

उग्रम्पश्य
उग्रम्पश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ರೂರವಾದ ನೋಟವುಳ್ಳ /ಭಯಂಕರವಾಗಿ ನೋಡುವ<br><b>निष्पत्तिः - </b>दृशिर् (प्रेक्षणे) - "खश्" (३-२-३७) । निपा० ।<br><b>व्युत्पत्तिः - </b>उग्रं पश्यति<br><br>

उग्रशेखरा
उग्रशेखरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಗಾನದಿ<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>उग्रस्य शेखरः आवासत्वेनास्त्यस्याः<br><br>

उग्रसेन
उग्रसेन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೋಮವಂಶದಲ್ಲಿ ಜನಿಸಿದ ಧೃತರಾಷ್ಟ್ರನ ಒಬ್ಬ ಮಗ<br><br>उग्रसेन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಂಡವರ ಮೊಮ್ಮಗನಾದ ಪರೀಕ್ಷಿತ್ತಿನ ಮಗ /ಜನಮೆಜಯನ ಸಹೋದರ<br><br>उग्रसेन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಸನ ತಂದೆ /ಆಹುಕನ ಮಗ /ದೇವಕನ ಸಹೋದರ<br><b>प्रयोगाः - </b>"तस्याहुकश्चाहुकी च कन्या चैवाहुकात्मजौ । देवकश्चोग्रसेनश्च चत्वारो देवकात्मजाः ॥"<br><b>उल्लेखाः - </b>भाग० ९-२४<br><br>

उचित
उचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯೋಗ್ಯವಾದ /ಅರ್ಹವಾದ<br><b>निष्पत्तिः - </b>उच (समवाये) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"परिभ्रमँल्लोहितचन्दनोचितः"<br><b>उल्लेखाः - </b>किरा० १-३४<br><br>उचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಳಗಿದ /ಪರಿಚಿತವಾದ<br><b>प्रयोगाः - </b>"अपत्यैरिव नीवारभागधेयोचितैर्मृगैः"<br><b>उल्लेखाः - </b>रघु० १-५०<br><br>उचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ /ಪ್ರಶಸ್ತವಾದ /ಸ್ತುತ್ಯವಾದ<br><br>उचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರಾರ್ಹವಾದ /ಗ್ರಾಹ್ಯವಾದ<br><br>

उच्च
उच्च<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಹಗಳ ಉಚ್ಚರಾಶಿ<br><br>उच्च<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉನ್ನತವಾದ /ಎತ್ತರವಾದ<br><b>निष्पत्तिः - </b>उद् + चिञ् (चयने) - "डः" (३-२-१०१)<br><b>व्युत्पत्तिः - </b>उत्क्षिप्य बाहू चीयते<br><b>प्रयोगाः - </b>"क्षीरसिन्धुरिव मन्दरभिन्नः काननान्यविरलोच्चतरूणि" । "उच्चा रणत्पक्षिगणास्तटीस्तम्" ।<br><b>उल्लेखाः - </b>किरा० ९-२८, माघ० ४-१८<br><br>

उच्चकैस्
उच्चकैस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉನ್ನತವಾದ /ಎತ್ತರವಾದ<br><b>निष्पत्तिः - </b>उच्चैः - टेः प्राक् "अकच्" (५-३-७३)<br><b>प्रयोगाः - </b>"अथोच्चकैरासनतः परार्ध्यात्"<br><b>उल्लेखाः - </b>किरा० २-५७<br><br>उच्चकैस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ /ಅತಿಶಯವಾದ<br><b>प्रयोगाः - </b>"युवा कराक्रान्तमभीभृदुच्चकैरसंशयं सम्प्रति तेजसा रविः"<br><b>उल्लेखाः - </b>माघ० १-७०<br><br>उच्चकैस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾದ<br><br>

उच्चटा
उच्चटा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಳ್ಳುಳ್ಳಿ<br><br>उच्चटा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಲಗಂಜಿ ಗಿಡ<br><br>उच्चटा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಗಮುಸ್ತೆ /ಕೊನ್ನಾರಿಯ ಒಂದು ಭೇದ<br><br>उच्चटा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೂಟಾಟಿಕೆ<br><b>विस्तारः - </b>"उच्चटा दम्भचर्यायां प्रभेदे लशुनस्य च"- हेम० ।<br><br>

उच्चण्ड
उच्चण्ड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕೋಪ ಸ್ವಭಾವದ<br><br>उच्चण्ड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ತೀಕ್ಷ್ಣವಾದ /ಬಹಳ ಚುರುಕಾದ<br><br>उच्चण्ड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶೀಘ್ರವಾದ /ಸಾವಕಾಶವಿಲ್ಲದ /ವಿಳಂಬವಿಲ್ಲದ<br><b>निष्पत्तिः - </b>उद् + चडि (कोपे) - "अच्" (३-१-१३४)<br><b>विस्तारः - </b>"उच्चण्डमविलम्बितम्" - अम० ।<br><br>

उच्चदेव
उच्चदेव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀವಾಸುದೇವ /ಶ್ರೀಕೃಷ್ಣ<br><br>

उच्चनीच
उच्चनीच<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಳ್ಳತಿಟ್ಟಾದ /ಎತ್ತರ ಮತ್ತು ತಗ್ಗಾದ<br><br>उच्चनीच<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನೇಕ ವಿಧವಾದ<br><b>व्युत्पत्तिः - </b>उच्चैश्च नीचैश्च<br><br>

उच्चय
उच्चय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಶಿ /ಕುಪ್ಪೆ /ಗುಡ್ಡೆ /ಸಮೂಹ<br><b>निष्पत्तिः - </b>उद् + चिञ् (चयने) - "अच्" (३-३-५६)<br><b>प्रयोगाः - </b>"चित्रे निवेश्य परिकल्पितसत्वयोगा रूपोच्चयेन मनसा विधिना कृता नु"<br><b>उल्लेखाः - </b>शाकु० २-९<br><br>उच्चय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಗ್ರಹಿಸುವಿಕೆ /ಶೇಖರಿಸಿಡುವುದು<br><b>प्रयोगाः - </b>"इति पुष्पोच्चयं निरूपयति"<br><b>उल्लेखाः - </b>शाकु० ४<br><br>उच्चय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸರ ಸೀರೆಯ ಸೊಂಟದ ಗಂಟು /ಸೀರೆಯನ್ನುಡುವಾಗ ಸೊಂಟದಲ್ಲಿ ಹಾಕುವ ಗಂಟು /ನೀವೀಬಂಧ<br><b>प्रयोगाः - </b>"प्रियेऽपरा यच्छति वाचमुन्मुखी निबद्धदृष्टिः शिथिलाकुलोच्चया"<br><b>उल्लेखाः - </b>किरा० ९-१५<br><br>

उच्चरत्
उच्चरत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಚ್ಚರಿಸುವ /ಹೇಳುತ್ತಿರುವ /ಮಾತನಾಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + चर (गतौ) - "शतृ" (३-२-१२४)<br><br>उच्चरत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಲ್ಲಂಘಿಸುವ /ಮೀರುವ<br><br>उच्चरत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹೋಗುತ್ತಿರುವ<br><br>

उच्चरित
उच्चरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಚ್ಚರಿಸಲ್ಪಟ್ಟ /ನುಡಿಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + चर (गतौ) - अन्तर्भावितण्यर्थः "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"सकृदुच्चरितः शब्दः सकृदर्थं गमयति"<br><br>

उच्चलत्
उच्चलत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹೋಗುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + चल (सञ्चलने) - "शतृ" (३-२-१२४)<br><br>

उच्चलित
उच्चलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊರಟಿರುವ /ಹೊರಡಲು ಪ್ರಯತ್ನಿಸಿರುವ<br><b>निष्पत्तिः - </b>उद् + चल (सञ्चलने) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"स्थितः स्थितामुच्चलितः प्रयातां निषेदुषीमासनबन्धधीरः"<br><b>उल्लेखाः - </b>रघु० २-६<br><br>

उच्चाटन
उच्चाटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿತ್ತು ಹಾಕುವುದು /ಬುಡಸಹಿತ ತೆಗೆದು ಹಾಕುವುದು<br><b>निष्पत्तिः - </b>उद् + चट (भेदने) + णिच् - "ल्युट्" (३-३-११५)<br><br>उच्चाटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರ್ಪಡಿಸುವುದು /ವಿಶ್ಲೇಷವುಂಟುಮಾಡುವುದು<br><br>उच्चाटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶೂನ್ಯ /ಮಾಟ ಮಂತ್ರ ಪ್ರಯೋಗ ಆಭಿಚಾರಿಕಕೃತ್ಯ ಇವುಗಳಿಂದ ಭೂತಗಳನ್ನು ಓಡಿಸುವುದು<br><br>उच्चाटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರಿಸುವುದು<br><br>

उच्चार
उच्चार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಚ್ಚರಿಸುವಿಕೆ /ನುಡಿಯುವುದು<br><b>निष्पत्तिः - </b>उद् + चर (गतौ) + णिच् - "घञ्" (३-३-१८)<br><br>उच्चार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುರೀಷ /ಅಮೇಧ್ಯ /ಮಲ<br><b>प्रयोगाः - </b>"मूत्रोच्चारसमुत्सर्गं दिवा कुर्यात् उदङ्मुखः"<br><b>उल्लेखाः - </b>मनु० ४-५०<br><br>उच्चार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಹಗಳು ರಾಶಿಯಿಂದ ರಾಶಿಗೆಸಂಚರಿಸುವುದು<br><br>

उच्चारण
उच्चारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಣಗಳನು ಉಚ್ಚರಿಸುವಿಕೆ /ನುಡಿಯುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + चर (गतौ) + णिच् - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"उच्चारणोज्ञोऽथ गिरां दधानमुच्चारणत्पक्षिगणास्तटीस्तम्"<br><b>उल्लेखाः - </b>माघ० ४-१८<br><br>

उच्चारित
उच्चारित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಲವಿಸರ್ಜನೆ ಮಾಡಿದ<br><b>निष्पत्तिः - </b>उच्चार - "इतच्" (५-२-३६)<br><br>उच्चारित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಚ್ಚರಿಸುವಂತೆ ಮಾಡಲ್ಪಟ್ಟ /ನುಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + चर (गतौ) + णिच् - "क्तः" (३-२-१०२)<br><br>

उच्चार्य
उच्चार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಚ್ಚರಿಸಲು ಅರ್ಹವಾದ /ನುಡಿಯಲು ಯೊಗ್ಯವಾದ /ಹೇಳಬಹುದಾದ<br><b>निष्पत्तिः - </b>उद् + चर (गतौ) + णिच् - "यत्" (३-१-९७)<br><br>उच्चार्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉಚ್ಚರಿಸಿ /ನುಡಿದು<br><b>निष्पत्तिः - </b>उद् + चर (गतौ) + णिच् - "ल्यप्" (७-१-३७)<br><b>प्रयोगाः - </b>"लक्ष्मीं समुत्सुकयितासि भृशं परेषामुच्चार्य वाचमिति तेन तिरोबभूवे"<br><b>उल्लेखाः - </b>किरा० ११-८१<br><br>

उच्चार्यमाण
उच्चार्यमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಚ್ಚರಿಸಲ್ಪಡುವ /ಹೇಳಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उद् + चर (गतौ) + णिच् - कर्म० "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"मुखसहितनासिकयोच्चार्यमाणो वर्नः अनुनासिकसञ्ज्ञः स्यात्"<br><b>उल्लेखाः - </b>सि० कौ०<br><br>

उच्चावच
उच्चावच<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನೇಕ ವಿಧವಾದ /ನಾನಾ ಬಗೆಯಾದ<br><b>व्युत्पत्तिः - </b>उदक् चावाक् च<br><b>विस्तारः - </b>"उच्चावचं नौकभेदम्" - अम० ।<br><br>उच्चावच<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಳ್ಳತಿಟ್ಟಾದ /ಎತ್ತರ ಮತ್ತು ತಗ್ಗಾದ<br><b>प्रयोगाः - </b>"भिन्नेषु रत्नकिरणैः किरणेष्विवेन्दोरुच्चावचैरुपगतेषु सहस्रसङ्ख्याम्"<br><b>उल्लेखाः - </b>माघ० ४-४६<br><br>

उच्चिचीषा
उच्चिचीषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಷ್ಪವನ್ನು ಕೀಳುವ ಆಸೆ /ಹೂವನ್ನು ಬಿಡಿಸುವ ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>उद् + चिञ् (चयने) + सन् - "अः" (३-३-१-३)<br><b>व्युत्पत्तिः - </b>उच्चेतुमिच्छा<br><br>

उच्चिचीषु
उच्चिचीषु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುಷ್ಪವನ್ನು ಕೀಳುವ ಆಸೆಯುಳ್ಳ /ಹೂವನ್ನು ಬಿಡಿಸುವ ಅಪೇಕ್ಷೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>उद् + चिञ् (चयने) + सन् - "उः" (३-२-१६८)<br><b>व्युत्पत्तिः - </b>उच्चेतुमिच्छुः<br><br>

उच्चैःशिरस्
उच्चैःशिरस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದಾರವಾದ ಮನಸ್ಸುಳ್ಳ /ದೊಡ್ಡ ಮನಸ್ಸುಳ್ಳವನು /ಮಹಾತ್ಮ<br><b>व्युत्पत्तिः - </b>उच्चैरुन्नतं शिरो यस्य<br><b>प्रयोगाः - </b>"क्षुद्रेऽपि नूनं शरणं प्रपन्ने ममत्वमुच्चैःशिरसां सतीव"<br><b>उल्लेखाः - </b>कुमा० १-१२<br><br>

उच्चैःश्रवस्
उच्चैःश्रवस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಕುದುರೆ<br><b>प्रयोगाः - </b>"धन्वन्तरिस्तथा मद्यं श्रीर्देवी कौस्तुभो मणिः । शशाङ्को विमलश्चापि समुत्तस्थुः समन्ततः । उच्चैःश्रवा हयो रम्यः पीयूषं तदनन्तरम् ॥" "न चित्रमुच्चैःश्रवसः पदक्रमम्" ।<br><b>उल्लेखाः - </b>हरिवं०, माघ० १-५२<br><br>उच्चैःश्रवस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎತ್ತರವಾದ ಕಿವಿಯುಳ್ಳ /ಉದ್ದದ ಕಿವಿಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>उच्चैरुन्नतं श्रवोऽस्य<br><br>उच्चैःश्रवस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿವುಡ<br><b>निष्पत्तिः - </b>"असुन्" (उ० ४-१८९)<br><b>व्युत्पत्तिः - </b>उच्चैरुन्नतं श्ब्दं शृणोति<br><br>

उच्चैर्घुष्ट
उच्चैर्घुष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಘೋಷಣೆ /ಡಂಗುರ ಹೊಡೆಯುವುದು /ಗಟ್ಟಿಯಾಗಿ ಕೂಗಿ ಹೇಳುವುದು<br><b>निष्पत्तिः - </b>उच्चैः + धुषिर् (अविशब्दने) - "क्तः" (३-३-११४)<br><b>व्युत्पत्तिः - </b>उच्चैः घुष्यते स्म<br><br>

उच्चैर्घोष
उच्चैर्घोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾದ ಶಬ್ದ /ಎಲ್ಲರೂ ಕೇಳುವಂತೆ ಉಚ್ಚಸ್ಚರದಿಂದ ಹೇಳುವುದು<br><b>निष्पत्तिः - </b>उच्चैः + धुषिर् (अविशब्दने) - "घञ्" (३-३-१८)<br><br>

उच्चैर्घोषण
उच्चैर्घोषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾದ ಶಬ್ದ /ಎಲ್ಲರೂ ಕೇಳುವಂತೆ ಉಚ್ಚಸ್ಚರದಿಂದ ಹೇಳುವುದು<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

उच्चैस्
उच्चैस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎತ್ತರವಾದ /ಉನ್ನತವಾದ<br><b>निष्पत्तिः - </b>उद् + चिञ् (चयने) - "डैसिः" (उ० ५-१२)<br><b>प्रयोगाः - </b>"उच्चैर्महारजतराजिविराजितासौ"<br><b>उल्लेखाः - </b>माघ० ४-२८<br><br>उच्चैस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಚುರವಾದ /ಅಧಿಕವಾದ /ಹೆಚ್ಚಾದ<br><b>प्रयोगाः - </b>"प्रवादमुच्चैरयशस्करं श्रियः"<br><b>उल्लेखाः - </b>माघ० १-४४<br><br>उच्चैस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ /ಎಲ್ಲರಿಗೂ ಕೇಳಿಸುವಂತೆ<br><b>प्रयोगाः - </b>"प्रयच्छतोच्चैः कुसुमानि मानिनी विपक्षगोत्रं दयितेन लम्भिता"<br><b>उल्लेखाः - </b>किरा० ८-१४<br><br>उच्चैस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎತ್ತರ /ಔನ್ನತ್ಯ<br><br>उच्चैस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮಹತ್ತರವಾದ /ದೊಡ್ಡದಾದ /ಶ್ರೇಷ್ಠವಾದ<br><b>प्रयोगाः - </b>"जनोऽयमुच्चैःपदलङ्घनोत्सुकः"<br><b>उल्लेखाः - </b>कुमा० ५-६४<br><br>

उच्छिन्न
उच्छिन्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶ ಹೊಂದಿದ /ಲುಪ್ತವಾದ<br><b>निष्पत्तिः - </b>उद् + छद (अपवारणे) - "क्तः" (३-४-७२)<br><br>उच्छिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂಲೋತ್ಪಾಟನ ಮಾಡಲ್ಪಟ್ಟ /ಬುಡಸಹಿತ ಕಿತ್ತುಹಾಕಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + छिदिर् (द्वैधीकरणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"उच्छिन्नमित्रो विगुणैरुपेतः"<br><b>उल्लेखाः - </b>भट्टि० १२-३९<br><br>

उच्छलत्
उच्छलत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರುತ್ತಿರುವ /ಮೇಲಕ್ಕೆ ಏಳುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + शल (गतौ) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"यस्याश्चलद्वारिधिवारिवीचिच्छदोच्छलच्छङ्खकुलाकुलेन"<br><b>उल्लेखाः - </b>माघ० ३-३७<br><br>

उच्छलन
उच्छलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೆಲಕ್ಕೆ ಹಾರುವಿಕೆ /ಮೇಲಕ್ಕೆ ಏಳುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + शल (गतौ) - "ल्युट्" (३-३-११५)<br><br>

उच्छादन
उच्छादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊದಿಕೆ<br><br>उच्छादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಗಂಧದ್ರವ್ಯವನ್ನು ಮೈಗೆ ಹಚ್ಚುವುದು<br><b>निष्पत्तिः - </b>उद् + छद (अपवारणे) + णिच् - "ल्युट्" (३-३-११५)<br><br>

उच्छास्त्र
उच्छास्त्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರವನ್ನು ಮೀರಿದ /ಶಾಸ್ತ್ರಮರ್ಯಾದೆಯನ್ನು ಉಲ್ಲಂಘಿಸಿದ<br><br>उच्छास्त्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರಕ್ಕೆ ವಿರೋಧವಾದ /ಶಾಸ್ತ್ರಕ್ಕೆ ಪ್ರತಿಕೂಲವಾದ<br><b>व्युत्पत्तिः - </b>उद्गतं शास्त्रं येन<br><br>

उच्छास्न
उच्छास्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಜ್ಞೆಯನ್ನು ಮೀರಿದ /ಆಜ್ಞೆಗೆ ವಿಧೇಯನಲ್ಲದ /ಹತೋಟಿಗೆ ಒಳಪಡದ<br><b>व्युत्पत्तिः - </b>उत्क्रान्तः शासनम्<br><br>

उच्छिख
उच्छिख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉರಿಯುತ್ತಿರುವ /ಜ್ವಲಿಸುತ್ತಿರುವ ಬೆಂಕಿ<br><b>व्युत्पत्तिः - </b>उद्गता शिखा यस्य<br><b>प्रयोगाः - </b>"शमीतरुं शुष्कमिवाग्निरुच्छिखः"<br><b>उल्लेखाः - </b>किरा० १-३२<br><br>उच्छिख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹರಡಿದ ಕಾಂತಿಯುಳ್ಳ<br><b>प्रयोगाः - </b>"यतः परार्ध्यानि भृतान्यनूनैः प्रस्थैर्मुहुर्भूरिभिरुच्छिखानि"<br><b>उल्लेखाः - </b>माघ० ४-११<br><br>

उच्छिङ्घन
उच्छिङ्घन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರಿ ಕಫವನ್ನು ಉಗಿಯುವುದು<br><b>निष्पत्तिः - </b>उद् + शिघि (आघ्राणे) - "ल्युट्" (३-३-११५)<br><br>

उच्छित्ति
उच्छित्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬುಡಸಹಿತ ಕಿತ್ತು ಹಾಕುವುದು /ಮೂಲೋತ್ಪಾಟನ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>उद् + छिदिर् (द्वैधीकरणे) - "क्तिन्" (३-३-९४)<br><br>

उच्छिन्दत्
उच्छिन्दत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುತ್ತಿರುವ /ಕಡಿಯುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + छिदिर् (द्वैधीकरणे) - "शतृ" (३-२-१२४)<br><br>

उच्छिरस्
उच्छिरस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎತ್ತರವಾದ /ಉನ್ನತವಾದ<br><br>उच्छिरस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ದವಾದ ತಲೆಯುಳ್ಳ<br><br>उच्छिरस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಹಾತ್ಮ /ಪ್ರಭಾವಶಾಲಿ /ಮಹಾಮಾನ್ವಿತ<br><b>व्युत्पत्तिः - </b>उन्नतं शिरो यस्य<br><b>प्रयोगाः - </b>"शैलात्मजापि पितुरुच्छिरसोऽभिलाषम्" । "प्रभावेण द्वितीयेन तथैवोच्छिरसा त्वया" ।<br><b>उल्लेखाः - </b>कुमा० ३-७५, कुमा० ६-७०<br><br>उच्छिरस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಿದ ತಲೆಯುಳ್ಳ<br><br>

उच्छिष्ट
उच्छिष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞಶೇಷ<br><br>उच्छिष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವರಿಗೆ ನಿವೇದನ ಮಾಡಿದ ಅನ್ನ ಮೊದಲಾದುದು<br><br>उच्छिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಟಮಾಡಿ ಉಳಿದ /ತಿಂದು ಅವಶಿಷ್ಟವಾದ<br><b>निष्पत्तिः - </b>उद् + शिष (असर्वोपयोगे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"यातयामं गतरसं पूति पर्युषितं च यत् । उच्छिष्टमपि चामेध्यं भोजनं तामसप्रियम् ॥"<br><b>उल्लेखाः - </b>गीता० १७-१०<br><br>उच्छिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತ್ಯಜಿಸಲ್ಪಟ್ಟ /ಬಿಡಲ್ಪಟ್ಟ<br><br>उच्छिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಶುಚಿಯಾದ /ಊಟಮಾಡಿ ಎಂಜಲಾದ<br><b>प्रयोगाः - </b>"रेवतीवदनोच्छिष्टपरिपूतपुटे दृशौ"<br><b>उल्लेखाः - </b>माघ० २-१६<br><br>उच्छिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಳೆಯದಾದ /ತಂಗಳಾದ<br><br>

उच्छिष्टगणेश
उच्छिष्टगणेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಂತ್ರೋಕ್ತನಾದ ಗಣಪತಿ<br><b>प्रयोगाः - </b>"भुक्त्वोच्छिष्टो जपेन्नित्यं गणेशस्य सदा प्रियः" । "उच्छिष्टश्चाशुचिर्भूत्वा जपपूजनमाचरेत् । अनुच्छिष्टो न सिद्ध्येत्तु तस्मादेवं समाचरेत् ॥"<br><br>

उच्छिष्टभोजन
उच्छिष्टभोजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇತರರು ತಿಂದು ಉಳಿದುದನ್ನು ತಿನ್ನುವುದು<br><br>उच्छिष्टभोजन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಜ್ಞಶೇಷವನ್ನು ತಿನ್ನುವುದು<br><b>व्युत्पत्तिः - </b>उच्छिष्टं भोजनं यस्य<br><b>प्रयोगाः - </b>"यज्ञशिष्टाशिनः सन्तो मुच्यन्ते सर्वकिल्बिषैः"<br><b>उल्लेखाः - </b>गीता० ३-१३<br><br>उच्छिष्टभोजन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೇವರಿಗೆ ನಿವೇದನೆ ಮಾಡಿ ಊಟಮಾಡುವವನು<br><b>प्रयोगाः - </b>"तैर्दत्तानप्रदायैभ्यो यो भुङ्क्ते स्तेन एव सः"<br><b>उल्लेखाः - </b>गीता० ३-१२<br><br>

उच्छिष्टभोजिन्
उच्छिष्टभोजिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಂಡು ಉಳಿದುದನ್ನು ತಿನ್ನುವವನು /ಉಚ್ಛಿಷ್ಟವನ್ನು ತಿನ್ನುವ ಸ್ವಭಾವದವನು<br><b>निष्पत्तिः - </b>भुज (परिपालनाभ्यवहारयोः) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>उच्छिष्टं भुङ्क्ते<br><br>

उच्छीर्षक
उच्छीर्षक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆದಿಂಬು<br><b>निष्पत्तिः - </b>"कप्"<br><b>व्युत्पत्तिः - </b>उत् उत्तोल्य स्थापितं शीर्षं यत्र<br><br>उच्छीर्षक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆ<br><br>उच्छीर्षक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಲೆಯನ್ನು ಮೇಲಕ್ಕೆ ಎತ್ತಿರುವ /ಮೇಲಕ್ಕೆ ಎತ್ತಿದ ತಲೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>उद्गतं शीर्षं यस्य<br><br>

उच्छून
उच्छून<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎತ್ತರವಾದ /ಉನ್ನತವಾದ<br><br>उच्छून<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಬ್ಬಿರುವ /ಊದಿಕೊಂಡಿರುವ<br><b>निष्पत्तिः - </b>उद् + टुओश्वि (गतिवृद्ध्योः) - "क्तः" (३-४-७२) । नत्वम् (८-२-४५)<br><b>प्रयोगाः - </b>"अनवरतरुदितोच्छूनताम्रदृष्टिमद्राक्षम्"<br><b>उल्लेखाः - </b>दशकु०<br><br>उच्छून<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಥೂಲವಾದ /ದಪ್ಪವಾದ<br><b>प्रयोगाः - </b>"स्वर्गग्रामटिकाविलुण्ठनवृथोच्छूनैः किमेभिर्भुजैः"<br><b>उल्लेखाः - </b>हनु० ना०<br><br>

उच्छृङ्खल
उच्छृङ्खल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಬಂಧಕವಿಲ್ಲದ /ಅಡ್ಡಿಯಿಲ್ಲದ /ತಡೆಯಿಲ್ಲದ<br><b>निष्पत्तिः - </b>(वा० १-४-७९)<br><b>व्युत्पत्तिः - </b>उत्क्रान्तः शृङ्खलातः<br><b>प्रयोगाः - </b>"अन्यदुच्छृङ्खलं सत्त्वमन्यच्छास्त्रनियन्त्रितम्"<br><b>उल्लेखाः - </b>माघ० २-६२<br><br>उच्छृङ्खल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಕ್ಷಕನಿಲ್ಲದ /ಯಜಮಾನನಿಲ್ಲದ /ಸ್ವೇಚ್ಛೆಯಿಂದ ವರ್ತಿಸುವ<br><br>उच्छृङ्खल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಕ್ರಮವಾದ /ಅವ್ಯವಸ್ಥಿತವಾದ<br><br>

उच्छेत्तृ
उच्छेत्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸುವ /ಧ್ವಂಸ ಮಾಡುವ<br><b>निष्पत्तिः - </b>उद् + छिदिर् (द्वैधीकरणे) - "तृच्" (३-१-१३३)<br><br>उच्छेत्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬುಡಸಹಿತ ಕಿತ್ತು ಹಾಕುವ<br><br>

उच्छेद
उच्छेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶ /ಧ್ವಂಸ<br><b>निष्पत्तिः - </b>उद् + छिदिर् (द्वैधीकरणे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"उच्छेदं जन्मनः कर्तुमेधि शान्तस्तपोधन" । "किमिति सर्वपशूच्छेदः क्रियते" ।<br><b>उल्लेखाः - </b>किरा० ११-३१, हितो०<br><br>उच्छेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬುಡಸಹಿತ ಕಿತ್ತುಹಾಕುವುದು<br><br>उच्छेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವುದು<br><br>उच्छेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಯ್ಯುವುದು<br><br>

उच्छेदन
उच्छेदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>उच्छेद ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>उद् + छिदिर् (द्वैधीकरणे) - भावे "ल्युट्"(३-३-११५)<br><br>

उच्छेद्य
उच्छेद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸಲು ಅರ್ಹವಾದ<br><br>उच्छेद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸಲು ಅರ್ಹವಾದ<br><b>निष्पत्तिः - </b>उद् + छिदिर् (द्वैधीकरणे) - "ण्यत्" (३-१-१२४)<br><br>उच्छेद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸಲ್ಪಡುವ<br><br>उच्छेद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>कर्म० "ण्यत्"<br><br>

उच्छेषण
उच्छेषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಳಿಕೆ /ಶೇಷ<br><br>उच्छेषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಊಟಮಾಡಿದ ಶೇಷ /ಉಂಡು ಉಳಿದ ಎಂಜಲು<br><b>प्रयोगाः - </b>"सरस्वतीमुखग्रहणोच्छेषणीकृतो दशनच्छद एष चुम्बितुम्"<br><b>उल्लेखाः - </b>दशकु०<br><br>

उच्छोषण
उच्छोषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಣಗಿಸುವುದು /ಬಾಡಿಸುವುದು<br><b>निष्पत्तिः - </b>उद् + शुष (शोषणे) + णिच् - "ल्युट्" (३-३-११५)<br><br>उच्छोषण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಣಗಿಸುವ /ಬಾಡಿಸುವ<br><br>उच्छोषण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತಾಪಗೊಳಿಸುವ /ಸುಡುವ<br><b>निष्पत्तिः - </b>उद् + शुष (शोषणे) + णिच् - "ल्युः" (३-१-१३४)<br><b>प्रयोगाः - </b>"न हि प्रपश्यामि ममापनुद्याद्यच्छोकमुच्छोषणमिन्द्रियाणाम्"<br><b>उल्लेखाः - </b>गीता० २-८<br><br>

उच्छ्रय
उच्छ्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಔನ್ನತ್ಯ /ಎತ್ತರ<br><b>निष्पत्तिः - </b>उद् + श्रिञ् (सेवायाम्) - "अच्" (३-३-५६)<br><br>

उच्छ्रयण
उच्छ्रयण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಔನ್ನತ್ಯ /ಎತ್ತರ<br><br>उच्छ्रयण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಳವಣಿಗೆ /ಅಭಿವೃದ್ಧಿ<br><b>निष्पत्तिः - </b>उद् + श्रिञ् (सेवायाम्) - "ल्युट्" (३-३-११५)<br><br>

उच्छ्राय
उच्छ्राय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಔನ್ನತ್ಯ /ಎತ್ತರ<br><b>निष्पत्तिः - </b>उद् + श्रिञ् (सेवायाम्) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"भवन्ति नोद्दामगिरां कवीनामुच्छ्रायसौन्दर्यगुणा मृषोद्याः" । "मनोहरोच्छ्रायनितम्बशोभया" ।<br><b>उल्लेखाः - </b>माघ० ४-१०, किरा० ८-२३<br><br>उच्छ्राय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಳವಣಿಗೆ /ಅಭಿವೃದ್ಧಿ<br><b>प्रयोगाः - </b>"नीतोच्छ्रायं मुहुरशिशिररश्मेरुस्रैः"<br><b>उल्लेखाः - </b>किरा० ५-३१<br><br>

उच्छ्रायिन्
उच्छ्रायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉನ್ನತವಾದ /ಎತ್ತರವಾದ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>उच्छ्रायोऽस्यास्ति<br><b>प्रयोगाः - </b>"छायाविधायिभिरनुज्झितभूतिशोभैरुच्छ्रायिभिर्बहलपाटलधातुरागैः"<br><b>उल्लेखाः - </b>माघ० ५-२१<br><br>

उच्छ्रित
उच्छ्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉನ್ನತವಾದ /ಎತ್ತರವಾದ<br><b>निष्पत्तिः - </b>उद् + श्रिञ् (सेवायाम्) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"अभिययौ स हिमाचलमुच्छ्रितं समुदितं नु विलङ्घयितुं नभः"<br><b>उल्लेखाः - </b>किरा० ५-१<br><br>उच्छ्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆಳೆದಿರುವ /ಅಭಿವೃದ್ಧಿ ಹೊಂದಿದ<br><br>उच्छ्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರಿದ /ಮೇಲಕ್ಕೆ ಹರಡಿರುವ<br><b>प्रयोगाः - </b>"विततशीकररश्मिभिरुच्छ्रितैरुपलरोधविवर्तिभिरम्बुभिः" । "उत्क्षिप्तमुच्छ्रितसितांशुकरावलम्बैः" ।<br><b>उल्लेखाः - </b>किरा० ५-१५, माघ० ४-२५<br><br>उच्छ्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಟ್ಟಿದ /ಉತ್ಪತ್ತಿ ಹೊಂದಿದ<br><b>विस्तारः - </b>"जातोन्नद्धप्रवृद्धाः स्युरुच्छ्रिताः" - अम० । "उच्छ्रितं त्रिषु सञ्जाते समुन्नद्धप्रवृद्धयोः" - मेदि० ।<br><br>

उच्छ्रिति
उच्छ्रिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃಢಿ /ಬೆಳವಣಿಗೆ<br><br>उच्छ्रिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಔನ್ನತ್ಯ /ಎತ್ತರ<br><b>निष्पत्तिः - </b>उद् + श्रिञ् (सेवायाम्) - "क्तिन्" (३-३-९४)<br><br>

उच्छ्वसत्
उच्छ्वसत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಸಿರಾಡುತ್ತಿರುವ /ಬದುಕಿರುವ<br><b>निष्पत्तिः - </b>उद् + श्वस (प्राणने) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"निःसृतस्तिमिरभारनिरोधादुच्छ्वसन्निव रराज दिगन्तः"<br><b>उल्लेखाः - </b>किरा० ९-२१<br><br>उच्छ्वसत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಕಾಸಹೊಂದುತ್ತಿರುವ /ಅರಳುತ್ತಿರುವ<br><b>प्रयोगाः - </b>"उच्छ्वसत्कमलगन्धये ददौ पार्वतीवदनगन्धवाहिने"<br><b>उल्लेखाः - </b>कुमा० ८-१९<br><br>

उच्छ्वसन
उच्छ्वसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಟ್ಟುಸಿರು ಬಿಡುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + श्वस (प्राणने) - "ल्युट्" (३-३-११५)<br><br>उच्छ्वसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಸಿರಾಡುವಿಕೆ<br><br>उच्छ्वसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಡಿಲವಾಗುವಿಕೆ<br><b>प्रयोगाः - </b>"नीवीबन्धोच्छ्वसनमधरस्पन्दनं दोर्विषादः"<br><b>उल्लेखाः - </b>मालती० २-५<br><br>

उच्छ्वसित
उच्छ्वसित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಿನ ಉಸಿರು /ಪ್ರಾಣವಾಯು<br><b>निष्पत्तिः - </b>उद् + श्वस (प्राणने) - "क्तः" (३-३-११४)<br><br>उच्छ्वसित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಫುರಣ /ಹಾರುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + श्वस (प्राणने) - "क्तः" (३-३-११४)<br><b>प्रयोगाः - </b>"वामेतरः संशयमस्य बाहुः केयूरबन्धोच्छ्वसितैर्नुनोद"<br><b>उल्लेखाः - </b>रघु० ६-६८<br><br>उच्छ्वसित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಡಿಲವಾಗುವಿಕೆ<br><br>उच्छ्वसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಸಿರಾಡುವ<br><b>प्रयोगाः - </b>"विरजस्कैर्नभस्वद्भिर्दिश उच्छ्वसिता इव"<br><b>उल्लेखाः - </b>रघु० १०-७३<br><br>उच्छ्वसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ವಾಸನದಿಂದ ಕೂಡಿದ /ಸಮಾಧಾನ ಹೊಂದಿದ<br><b>प्रयोगाः - </b>"त्वामुत्कण्ठोच्छ्वसितहृदया वीक्ष्य सम्भाष्य चैवम्"<br><b>उल्लेखाः - </b>मेघ० २-३७<br><br>उच्छ्वसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಬ್ಬಿರುವ /ವಿಕಾಸ ಹೊಂದಿದ<br><br>उच्छ्वसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಲಿಸುವ /ಹಾರಾಡುವ<br><b>प्रयोगाः - </b>"इदमुच्छ्वसितालकं मुखम्"<br><b>उल्लेखाः - </b>रघु० ८-५५<br><br>उच्छ्वसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಡಿಲವಾದ<br><b>प्रयोगाः - </b>"तद्दुकूलमथ दूरमुच्छ्वसितनीविबन्धनम्"<br><b>उल्लेखाः - </b>कुमा० ८-४<br><br>

उच्छ्वास
उच्छ्वास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಿನ ಉಸಿರು /ಪ್ರಾಣವಾಯು<br><b>निष्पत्तिः - </b>उद् + श्वस (प्राणने) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"उष्णोच्छ्वासं समधिकतरोच्छ्वासिना दूरवर्ती"<br><b>उल्लेखाः - </b>मेघ० २-३९<br><br>उच्छ्वास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾಧಾನ /ಆಶ್ವಾಸನ<br><br>उच्छ्वास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಂಥದ ಒಂದು ಭಾಗ<br><br>

उच्छ्वासिन्
उच्छ्वासिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಸಿರಾಡುವ /ಉಸಿರನ್ನು ಎಳೆದುಕೊಳ್ಳುವ<br><b>निष्पत्तिः - </b>उद् + श्वस (प्राणने) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>उच्छ्वसिति<br><b>प्रयोगाः - </b>"उष्णोच्छ्वासं समधिकतरोच्छ्वासिना दूरवर्ती"<br><b>उल्लेखाः - </b>मेघ० २-३९<br><br>उच्छ्वासिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಲಿಸುವ /ಹಾರಾಡುವ<br><br>उच्छ्वासिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲು ಶ್ವಾಸವುಳ್ಳ /ಮೇಲುಮುಖವಾದ ಪ್ರಾಣವಾಯುವುಳ್ಳ<br><br>उच्छ्वासिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದ್ದು ಹೋಗುವ /ಅಳಿಸಿ ಹೋಗುವ<br><b>निष्पत्तिः - </b>उद् + श्वस (प्राणने) - "णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"तदीषदार्द्रारुणगण्डलेखमुच्छ्वासिकालाञ्जनरागमक्ष्णोः"<br><b>उल्लेखाः - </b>कुमा० ७-८२<br><br>

उच्छ्वासिनी
उच्छ्वासिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उच्छ्वासिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उज्जयिनी
उज्जयिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಕ್ರಮಾದಿತ್ಯನ ರಾಜಧಾನಿ /ಅವಂತಿದೇಶದ ಮುಖ್ಯಪಟ್ಟಣ<br><br>

उज्जासन
उज्जासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಲ್ಲುವಿಕೆ /ಪ್ರಾಣ ತೆಗೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + जसु (हिंसायाम्) + णिच् - "ल्युट्" (३-३-११५)<br><br>

उज्जासित
उज्जासित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಲ್ಲಲ್ಪಟ್ಟ /ಪ್ರಾಣ ತೆಗೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + जसु (हिंसायाम्) + णिच् - "क्तः" (३-२-१०२)<br><br>

उज्जीवन
उज्जीवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬದುಕುವುದು /ನಾಶ ಹೊಂದುತ್ತಿರುವವನು ಪುನಃ ಸುಧಾರಿಸಿಕೊಳ್ಳುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + जीव (प्राणधारणे) - "ल्युट्" (३-३-११५)<br><br>

उज्जीवित
उज्जीवित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬದುಕಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + जीव (प्राणधारणे) + णिच् - "क्तः" (३-२-१०२)<br><br>

उज्जीविन्
उज्जीविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಳೆಗುಂದಿ ಪುನಃ ಚೇತರಿಸಿಕೊಳ್ಳುವ /ಪುನಃ ಬಲಗೊಳ್ಳುವ<br><b>निष्पत्तिः - </b>उद् + जीव (प्राणधारणे) - "णिनिः" (३-१-१३४)<br><br>

उज्जीविनी
उज्जीविनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಳೆಗುಂದಿ ಪುನಃ ಚೇತರಿಸಿಕೊಳ್ಳುವ /ಪುನಃ ಬಲಗೊಳ್ಳುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उज्जृम्भ
उज्जृम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಳುವಿಕೆ<br><br>उज्जृम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಳಿಕೆ<br><b>निष्पत्तिः - </b>उद् + जृभि (गात्रविनामे) - "घञ्" (३-३-१८)<br><br>उज्जृम्भ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕಳಿಸುವ<br><br>उज्जृम्भ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಳಿರುವ /ವಿಕಾಸ ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>उद् + जृभि (गात्रविनामे) - "अच्" (३-१-१३४)<br><b>प्रयोगाः - </b>"उज्जृम्भवदनाम्भोजा भिनत्त्यङ्गानि साऽङ्गना"<br><b>उल्लेखाः - </b>सा० द०<br><br>

उज्जृम्भण
उज्जृम्भण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರಳುವಿಕೆ /ವಿಕಾಸ ಹೊಂದುವಿಕೆ /ದೊಡ್ಡದಾಗುವಿಕೆ<br><br>उज्जृम्भण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಳಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + जृभि (गात्रविनामे) - "ल्युट्" (३-३-११५)<br><br>उज्जृम्भण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಧಿಕ್ಯ /ಅತಿಶಯ<br><b>प्रयोगाः - </b>"विषज्योतिरुज्जृम्भणोड्डामरव्यस्तविस्तारिदोःखण्डपर्यासिततक्ष्माधरम्"<br><b>उल्लेखाः - </b>मालती० ५-२३<br><br>

उज्जृम्भा
उज्जृम्भा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उज्जृम्भण ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "अः" (३-३-१०३)<br><br>

उज्जृम्भित
उज्जृम्भित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಳಿಕೆ<br><br>उज्जृम्भित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನ /ವ್ಯಾಪಾರ<br><b>निष्पत्तिः - </b>उद् + जृभि (गात्रविनामे) - भावे "क्तः" (३-३-११४)<br><br>उज्जृम्भित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಳಿದ /ವಿಕಾಸ ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>उद् + जृभि (गात्रविनामे) - कर्त० "क्तः" (३-४-७२)<br><br>

उज्ज्य
उज्ज्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆದೆಯೇರಿಸಲ್ಪಟ್ಟ ಧನುಸ್ಸು /ನಾಣು ಕಟ್ಟಲ್ಪಟ್ಟ ಬಿಲ್ಲು<br><b>व्युत्पत्तिः - </b>उद्गता ज्या यस्य<br><br>

उज्ज्वल
उज्ज्वल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೃಂಗಾರರಸ<br><b>निष्पत्तिः - </b>उद् + ज्वल (दीप्तौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उच्चैर्ज्वलति प्रकाशते<br><br>उज्ज्वल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಣ /ಚಿನ್ನ<br><br>उज्ज्वल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಳೆಯುತ್ತಿರುವ /ಪ್ರಕಾಶಮಾನವಾದ<br><b>प्रयोगाः - </b>"अथ स्वमायाकृतमन्दिरोज्ज्वलं ज्वलन्मणि व्योमसदां सनातनम्"<br><b>उल्लेखाः - </b>किरा० ८-१<br><br>उज्ज्वल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜ್ವಲಿಸುವ /ಉರಿಯುವ<br><b>प्रयोगाः - </b>"उज्ज्वलालोकया स्निग्धा त्वया त्यक्ता न राजते"<br><b>उल्लेखाः - </b>मालती० १०-४<br><br>उज्ज्वल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶುಭ್ರವಾದ /ಸ್ವಚ್ಛವಾದ<br><br>उज्ज्वल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಳಿದ /ವಿಕಾಸ ಹೊಂದಿದ<br><br>उज्ज्वल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಡ್ಡಿಯಿಲ್ಲದ /ಆತಂಕವಿಲ್ಲದ<br><b>प्रयोगाः - </b>"स्वातन्त्र्यमुज्ज्वलमवाप करेणुराजः"<br><b>उल्लेखाः - </b>माघ० ५-४८<br><b>विस्तारः - </b>"उज्ज्वलो दीप्तशृङ्गारविशदेषु विकासिनि" -मेदि० ।<br><br>

उज्ज्वलन
उज्ज्वलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉರಿಯುವಿಕೆ<br><br>उज्ज्वलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + ज्वल (दीप्तौ) - भावे "ल्युट्" (३-३-११५)<br><br>उज्ज्वलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಚ್ಛವಾಗಿರುವಿಕೆ<br><br>

उज्ज्वलित
उज्ज्वलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>उज्ज्वलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + ज्वल (दीप्तौ) - "क्तः" (३-२-१०२)<br><br>

उज्झ|उत्सर्गे|उज्झति
उज्झ - उत्सर्गे ( तुदा० पर० सक० से०) उज्झति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ತ್ಯಜಿಸು /ಬಿಡು /ವಿಸರ್ಜಿಸು<br><b>प्रयोगाः - </b>"अद्यापि नोज्झति हरः किल कालकूटम्" । "सपदि विगतनिद्रस्तल्पमुज्झाञ्चकार" । "प्राणानौज्झीच्च खड्गेन छिन्नैस्तेनैव मूर्धभिः" ।<br><b>उल्लेखाः - </b>चोरपं०, रघु० ५-७५, भट्टि० १५-८४<br><br>

उज्झ
उज्झ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡುವ /ತ್ಯಜಿಸುವ<br><b>निष्पत्तिः - </b>उज्झ (उत्सर्गे) - "अच्" (३-१-१३४)<br><br>

उज्झत्
उज्झत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡುವ /ತ್ಯಜಿಸುವ<br><b>निष्पत्तिः - </b>उज्झ (उत्सर्गे) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"परस्य मर्माविधमुज्झतां निजं द्विजिह्वतादोषमजिह्मगामिभिः" । "स्रोतोभिर्मदजलमुज्झतामजस्रम्" ।<br><b>उल्लेखाः - </b>माघ० १-६३, किरा० ७-३८<br><br>

उज्झती
उज्झती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಡುವ /ತ್ಯಜಿಸುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><b>प्रयोगाः - </b>"उज्झती शुचिमिवाशु तमिस्राम्"<br><b>उल्लेखाः - </b>किरा० ९-१८<br><br>

उज्झित
उज्झित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡಲ್ಪಟ್ಟ /ತ್ಯಜಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उज्झ (उत्सर्गे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"मुक्तमुललघुरुज्झितपूर्वः पश्चिमे नभसि सम्भृतसान्द्रः" । "प्रवृत्त एव स्वयमुज्झितश्रमः" ।<br><b>उल्लेखाः - </b>किरा० ९-५, माघ० १-४०<br><br>

उञ्छ
उञ्छ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗದ್ದೆಗಳಲ್ಲಿ ಯಜಮಾನನು ಧಾನ್ಯವನ್ನು ತೆಗೆದುಕೊಂಡ ನಂತರ ಕೆಳಗೆ ಉದುರಿದ್ದ ಕಾಳುಗಳನ್ನು ಆರಿಸಿಕೊಳ್ಳುವುದು<br><br>उञ्छ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗಡಿಗಳಲ್ಲಿ ವ್ಯಾಪಾರ ಮಾಡಿದ ನಂತರ ಕೆಳಗೆ ಬಿದ್ದಿರುವ ಧಾನ್ಯವನು ಆರಿಸಿಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>उछि (उञ्छे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"तान्युञ्छषष्ठाङ्कितसैकतानि"<br><b>उल्लेखाः - </b>रघु० ५-८<br><b>विस्तारः - </b>"उञ्छो धान्यश आदानम्" - वैज० ।<br><br>

उञ्छन
उञ्छन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗಡಿಯ ಮುಂಭಾಗದಲ್ಲಿ ಬಿದ್ದಿರುವ ಕಾಳುಗಳನ್ನು ಆರಿಸಿ ತೆಗೆದುಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>उछि (उञ्छे) - "ल्युट्" (३-३-११५)<br><br>

उञ्छवृत्ति
उञ्छवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗದ್ದೆಯನ್ನು ಕೊಯ್ದ ನಂತರ ಕೆಳಗೆ ಉದುರಿರುವ ಕಾಳುಗಳನು ಆರಿಸಿಕೊಂಡು ಅದರಿಂದ ಜೀವಿಸುವಿಕೆ<br><br>

उञ्छशिल
उञ्छशिल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗದ್ದೆಗಳಲ್ಲಿ ಯಜಮಾನನು ಧಾನ್ಯವನ್ನು ತೆಗೆದುಕೊಂಡ ನಂತರ ಕೆಳಗೆ ಉದುರಿದ್ದ ಕಾಳುಗಳನ್ನು ಆರಿಸಿಕೊಳ್ಳುವುದು<br><br>

उट
उट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಲೆ<br><br>उट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೃಣ /ಹುಲ್ಲು<br><br>

उटज
उटज<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ಣಶಾಲೆ /ತಪಸ್ವಿಗಳು ವಾಸಮಾಡಲು ಎಲೆ ಸೊಪ್ಪು ಮೊದಲಾದುವುಗಳಿಂದ ನಿರ್ಮಿತವಾದ ಮನೆ /ಋಷಿಗಳ ವಾಸಸ್ಥಾನ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>उटेभ्यो जायते<br><b>प्रयोगाः - </b>"नवोटजाभ्यन्तरसम्भृतानलम्" । "उटजद्वारविरूढं नीवारबलिं विलोकयतः" ।<br><b>उल्लेखाः - </b>कुमा० ५-१७, शाकु० ४-२०<br><br>उटज<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಡಿಸಲು /ಕುಟೀರ<br><br>

उडु
उडु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಕ್ಷತ್ರ<br><b>निष्पत्तिः - </b>डीङ् (विहायासा गतौ) - "डुः" (३-२-१८०)<br><b>व्युत्पत्तिः - </b>उ क्रोधं डयते<br><b>प्रयोगाः - </b>"उत्तम्भितोडुभिरतीवतरां शिरोभिः"<br><b>उल्लेखाः - </b>माघ० ४-२५<br><br>उडु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><br>

उडुचक्र
उडुचक्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಕ್ಷತ್ರ ಮಂಡಲ<br><b>व्युत्पत्तिः - </b>उडूनां चक्रम्<br><b>प्रयोगाः - </b>वप्रेण पर्यन्तचरोडुचक्रः सुमेरुवप्रोऽन्वहमन्वकारि"<br><b>उल्लेखाः - </b>माघ० ३-३७<br><br>

उडुप
उडुप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>निष्पत्तिः - </b>पा (रक्षणे) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>उडुः उडून् वा पाति<br><br>उडुप<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೆಪ್ಪ /ಹರಿಗೋಲು<br><b>निष्पत्तिः - </b>पा (रक्षणे) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>उडुनो जलात् पाति<br><b>प्रयोगाः - </b>"तितीर्षुर्दुस्तरं मोहादुडुपेनास्मि सागरम्"<br><b>उल्लेखाः - </b>रघु० १-२<br><br>

उडुपति
उडुपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><br>उडुपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರುಣ /ಜಲಾಧಿಪತಿ<br><b>व्युत्पत्तिः - </b>उडूनां नक्षत्राणां जलानां वा पतिः<br><b>प्रयोगाः - </b>"उपजीवतिस्म सततं दधतः परिमुग्धतां वणिगिवोडुपतेः"<br><b>उल्लेखाः - </b>माघ० ९-३२<br><br>

उडुपथ
उडुपथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತರಿಕ್ಷ /ಆಕಾಶ /ಗಗನ<br><b>निष्पत्तिः - </b>"अः" (५-४-७४)<br><b>व्युत्पत्तिः - </b>उडूनां नक्षत्राणां पन्थाः<br><br>

उडुराज्
उडुराज्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>निष्पत्तिः - </b>राजृ (दीप्तौ) - "क्विप्" (३-१-६१)<br><b>व्युत्पत्तिः - </b>उडुषु राजते<br><br>

उडुराज
उडुराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>निष्पत्तिः - </b>"टच्" (५-४-९१)<br><b>व्युत्पत्तिः - </b>उडूनां राजा<br><br>

उडुलोमन्
उडुलोमन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಋಷಿಯ ಹೆಸರು<br><b>व्युत्पत्तिः - </b>उडुरिव लोमास्य<br><br>

उड्डयन
उड्डयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರುವುದು /ಹಕ್ಕಿಗಳು ಆಕಾಶಮಾರ್ಗದಲ್ಲಿ ಹಾರಾಡುವುದು<br><b>निष्पत्तिः - </b>उद् + डीङ् (विहायासा गतौ) - "ल्युट्" (३-३-११५)<br><br>

उड्डामर
उड्डामर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯಂಕರವಾದ ಭೀತಿಯನ್ನುಂಟುಮಾಡುವ<br><b>व्युत्पत्तिः - </b>उत्कृष्टो डामरः<br><b>प्रयोगाः - </b>"निर्यद्विषज्योतिरुज्जृम्भणोड्डामरव्यस्त------"<br><b>उल्लेखाः - </b>मालती० ५-२३<br><br>उड्डामर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ /ಉತ್ತಮವಾದ<br><br>

उड्डीन
उड्डीन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಕ್ಕಿಗಳು ಮೇಲಕ್ಕೆ ಹಾರುವಿಕೆ /ಆಕಾಶದಲ್ಲಿ ಹಕ್ಕಿಗಳ ಹಾರಾಟ<br><b>निष्पत्तिः - </b>उद् + डीङ् (विहायासा गतौ) - "क्तः" (३-३-११४)<br><br>

उड्डीयमान
उड्डीयमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಾರಾಡುತ್ತಿರುವ /ಆಕಾಶದಲ್ಲಿ ಸಂಚರಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + डीङ् (विहायासा गतौ) - कर्म० "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"उड्डीयमानाः प्रतियान्त्यमी त्वां मुञ्चस्वराः मानसहंसदाराः"<br><b>उल्लेखाः - </b>याद० १८-२५<br><br>

उड्डीश
उड्डीश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯೋಗಶಕ್ತಿಯಿಂದ ಮೇಲಕ್ಕೆ ಹಾರುವ ಯೋಗಿಗಳಿಗೆ ಅಧಿಪತಿಯಾದ ಈಶ್ವರ<br><br>उड्डीश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯೋಗಿಗಳು ಮೇಲಕ್ಕೆ ಹಾರುವ ಉಪಾಯವನ್ನು ತಿಳಿಸುವ ತಂತ್ರಗ್ರಂಥ<br><br>

उत्
उत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ<br><br>उत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಶಯ /ಸಂದೇಹ<br><br>उत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿತರ್ಕ /ವಿಚಾರ /ವಿಮರ್ಶೆ<br><br>उत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಧಿಕ್ಯ /ಅತಿಶಯ<br><br>उत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಊರ್ಧ್ವಭಾಗ /ಮೇಲುಭಾಗ<br><br>

उत
उत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾರದಿಂದ ನೇಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>वेञ् (तन्तुसन्ताने) - "क्तः" (३-२-१०२)<br><br>उत<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿಕಲ್ಪ /ಸಂಶಯ<br><br>उत<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ<br><br>उत<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಮುಚ್ಚಯ<br><br>उत<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿತರ್ಕ /ವಿಚಾರ /ವಿಮರ್ಶೆ<br><br>उत<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅತಿಶಯ /ಆಧಿಕ್ಯ<br><b>प्रयोगाः - </b>"किमयमातपदोषः स्यादुत यथा मे मनसि वर्तते" । "वीरो रसः किमयमेत्युत दर्प एषः" ।<br><b>उल्लेखाः - </b>शाकु० ३, उ० रा० ६-१९<br><b>विस्तारः - </b>"उत प्रश्ने वितर्के स्यादुताऽप्यर्थविकल्पयोः" । "उत बाढविकल्पयोः" - शाश्व० ।<br><br>

उतथ्य
उतथ्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗಿರಸ್ಸಿನ ಮಗ /ಬೃಹಸ್ಪತಿಯ ಅಣ್ಣ<br><b>प्रयोगाः - </b>"त्रयोह्यङ्गिरसः पुत्राः एते सर्वत्र विश्रुताः । बृहस्पतिरुतथ्यश्च संवर्तश्च दृढव्रतः ॥"<br><br>

उतथ्यानुज
उतथ्यानुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುರು /ಬೃಹಸ್ಪತಿ /ಉತಥ್ಯಮಹರ್ಷಿಯ ತಮ್ಮ<br><b>प्रयोगाः - </b>"तथ्यामुतथ्यानुजवज्जागादाग्रे गदाग्रजम्"<br><b>उल्लेखाः - </b>माघ० २-६९<br><br>

उताहो
उताहो<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿಕಲ್ಪ /ಸಂಶಯ<br><br>उताहो<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿತರ್ಕ /ವಿಚಾರ /ವಿಮರ್ಶೆ<br><br>उताहो<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ<br><b>व्युत्पत्तिः - </b>उत चाहो च अनयोः समाहारः<br><b>प्रयोगाः - </b>"वन्दे वाञ्छितलाभाय कर्म किं तन्न कथ्यते । किं दम्पतिमिति ब्रूयामुताहो दम्पती इति ॥"<br><b>उल्लेखाः - </b>नीलकं० १-१<br><b>विस्तारः - </b>"आहो उताहो किमुत विकल्पे" - अम० । "उताहो परिप्रश्नविचारयोः" - मेदि० ।<br><br>

उत्क
उत्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತವಕವುಳ್ಳ /ಆತುರವುಳ್ಳ<br><b>निष्पत्तिः - </b>उद्गतमनस्कवृत्तेरुच्छब्दात्स्वार्थे "कन्" (५-२-८०)<br><b>व्युत्पत्तिः - </b>उद्गतं मनोऽस्य<br><b>प्रयोगाः - </b>"उत्कं धरं द्रष्टुमवेक्ष्य शौरिमुत्कन्धरं दारुक इत्युवाच"<br><b>उल्लेखाः - </b>माघ० ४-१८<br><br>

उत्कट
उत्कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲವಂಗಪತ್ರೆ/ದಾಲ್ಚಿನ್ನಿ<br><br>उत्कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶುಂಠಿ<br><br>उत्कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೆಣಸು<br><br>उत्कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಪ್ಪಲಿ<br><b>निष्पत्तिः - </b>उत् - "कटच्" (५-२-२९)<br><br>उत्कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದವೇರಿದ ಆನೆ<br><br>उत्कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಮಲು /ಮದ /ಮತ್ತು<br><br>उत्कट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೀವ್ರವಾದ /ತೀಕ್ಷ್ಣವಾದ<br><br>उत्कट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಬಲವಾದ /ಅತಿಶಯವಾದ<br><b>प्रयोगाः - </b>"अत्युत्कटैः पुण्यपापैरिहैव फलमश्नुते"<br><b>उल्लेखाः - </b>हितो०<br><br>उत्कट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಷ್ಟವಾದ /ವಿಷಮವಾದ /ಬಿಕ್ಕಟ್ಟಿನ<br><br>उत्कट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗರ್ವಿಷ್ಠ /ಸೊಕ್ಕಿನಿಂದ ಕೂಡಿದ /ದುರಭಿಮಾನಿ<br><br>उत्कट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮದವೇರಿದ /ಅಮಲೇರಿದ<br><b>विस्तारः - </b>"उत्कटस्तीव्रमत्तयोः" - मेदि० ।<br><br>

उत्कण्ठ
उत्कण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುರತಸಂಬಂಧವಾದ ಒಂದು ಬಂಧ<br><b>व्युत्पत्तिः - </b>उद्गतः कण्ठं पादो यत्र<br><b>प्रयोगाः - </b>"नारीपादौ च हस्तेन धारयेत् गलके पुनः । स्तनार्पितकरः कामी बन्धश्चोत्कण्ठसञ्ज्ञितः ॥"<br><br>उत्कण्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆತ್ತಿದ ಕತ್ತುಳ್ಳ<br><b>व्युत्पत्तिः - </b>उद्गतः कण्ठो यस्य<br><b>प्रयोगाः - </b>"रथस्वनोत्कण्ठमृगे वाल्मीकीये तपोवने"<br><b>उल्लेखाः - </b>रघु० १५-११<br><br>उत्कण्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತವಕವುಳ್ಳ /ಆತುರವುಳ್ಳ<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>उत्कण्ठास्यास्ति<br><br>

उत्कण्ठा
उत्कण्ठा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಷ್ಟವಾದ ವಸ್ತುವನ್ನು ಹೊಂದಲು ಆಸೆ /ಪ್ರಿಯವಸ್ತುವನ್ನು ಪಡೆಯಲು ತವಕ /ಔತ್ಸುಕ್ಯ<br><b>निष्पत्तिः - </b>उत् + कठि (शोके) - "अः" (३-३-१०३)<br><b>प्रयोगाः - </b>"सर्वेन्द्रियसुखास्वादो यत्रास्तीत्यभिमन्यते । तत्प्राप्तीच्छां ससङ्कल्पामुत्कण्ठां कवयो विदुः ॥"<br><br>उत्कण्ठा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಮಾಧಾನ /ವ್ಯಾಕುಲತೆ /ಕನವರಿಕೆ<br><b>प्रयोगाः - </b>"यास्यत्यद्य शकुन्तलेति हृदयं संस्पृष्टमुत्कण्ठया"<br><b>उल्लेखाः - </b>शाकु० ४-५<br><br>

उत्कण्ठित
उत्कण्ठित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತವಕಪಡುವ /ಇಷ್ಟವಾದ ವಸ್ತುವನ್ನು ಪಡೆಯಲು ಆಸೆ ಪಡುವ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>उत्कण्ठाऽस्य सञ्जाता<br><br>उत्कण्ठित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಂತೆಯಿಂದ ಕೂಡಿದ /ವ್ಯಗ್ರನಾದ /ವ್ಯಾಕುಲನಾದ<br><br>

उत्कण्ठिता
उत्कण्ठिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಂತೆಯಿಂದ ಕೂಡಿದ /ವ್ಯಗ್ರನಾದ /ವ್ಯಾಕುಲನಾದ<br><b>प्रयोगाः - </b>"उत्कण्ठिता च कुलटा जगामास्तं च भानुमान्"<br><b>उल्लेखाः - </b>चन्द्रा०<br><br>उत्कण्ठिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>೮ ವಿಧ ನಾಯಿಕೆಯರಲ್ಲೊಬ್ಬಳು /ಪ್ರಿಯನು ಬರುವುದಾಗಿ ಹೇಳಿ ಅವನು ಬಾರದಿರುವುದರಿಂದ ದುಃಖಾಕ್ರಾಂತಳಾದ ನಾಯಿಕೆ<br><b>प्रयोगाः - </b>"आगन्तुं कृतचितोऽपि दैवान्नायाति यत्प्रियः । तदनागमदुःखार्ता विरहोत्कण्ठिता तु सा ॥"<br><b>उल्लेखाः - </b>सा० द०<br><br>

उत्कता
उत्कता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತವಕ /ಆಸೆ /ಪಡೆಯುವ ಆತುರ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>उत्कस्य भावः<br><br>

उत्कन्धर
उत्कन्धर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎತ್ತಿದ ಕತ್ತುಳ್ಳ /ಕತ್ತನ್ನು ಮೇಲಕ್ಕೆ ಎತ್ತಿ ನೋಡುವ<br><b>व्युत्पत्तिः - </b>उद्गता कन्धरा यस्य<br><b>प्रयोगाः - </b>"उत्कं धरं द्रष्टुमवेक्ष्य शौरिमुत्कन्धरं दारुक इत्युवाच"<br><b>उल्लेखाः - </b>माघ० ४-१८<br><br>

उत्कम्प
उत्कम्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಡುಕ /ತತ್ತರ /ಕಂಪನ<br><b>व्युत्पत्तिः - </b>उत्कृष्टः कम्पः<br><br>उत्कम्प<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗುವ /ಕಂಪಿಸುವ<br><b>निष्पत्तिः - </b>उत् + कपि (चलने) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उत्कम्पते<br><br>

उत्कम्पन
उत्कम्पन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಡುಕ /ತತ್ತರ /ಕಂಪನ<br><b>निष्पत्तिः - </b>उत् + कपि (चलने) - "ल्युट्" (३-३-११५)<br><br>

उत्कम्पिन्
उत्कम्पिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗುವ /ಕಂಪಿಸುವ<br><b>निष्पत्तिः - </b>उत् + कपि (चलने) - "णिनिः" (३-१-१३४)<br><br>

उत्कम्पिनी
उत्कम्पिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಡುಗುವ /ಕಂಪಿಸುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उत्कम्प्र
उत्कम्प्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಕದ ಸ್ವಭಾವದ /ಕಂಪಿಸುವ /ತತ್ತರಿಸುವ<br><b>निष्पत्तिः - </b>उत् + कपि (चलने) - "रः" (३-२-१६७)<br><br>

उत्कर
उत्कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯ ಮೊದಲಾದುವುಗಳ ರಾಶಿ /ಗುಪ್ಪೆ<br><b>निष्पत्तिः - </b>उत् + कॄ (विक्षेपे) -"अप्" (३-३-५७)<br><b>प्रयोगाः - </b>"स्फुरन्नखांशूत्करमञ्जरीभृतः" । "बहिः पुष्पोत्करैः कीर्णतीरां दूर्वाक्षतान्वितैः" ।<br><b>उल्लेखाः - </b>किरा० ८-५, कुमा० १०-४५<br><br>उत्कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೂಹ /ಗುಂಪು<br><br>उत्कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಸದ ರಾಶಿ<br><br>

उत्कर्तन
उत्कर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>उत् + कृती (छेदने) - "ल्युट्" (३-३-११५)<br><br>उत्कर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿತ್ತು ಹಾಕುವಿಕೆ<br><b>निष्पत्तिः - </b>उत् +कृष (विलेखने) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"उत्कर्षः स च धन्विनां यदिषवः सिद्ध्यन्ति लक्ष्ये चले"<br><b>उल्लेखाः - </b>शाकु० २-५<br><br>

उत्कर्ष
उत्कर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠತೆ /ಮೇಲ್ಮೆ<br><b>प्रयोगाः - </b>"पञ्चानामपि भूतानामुत्कर्षं पुपुषुर्गुणाः"<br><b>उल्लेखाः - </b>रघु० ४-११<br><br>उत्कर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಶಯ /ಆಧಿಕ್ಯ<br><br>उत्कर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಂಬ /ಬಡಾಯಿ /ಜಲ್ಲಿ<br><b>प्रयोगाः - </b>"निनीषुः कुलमुत्कर्षम्"<br><b>उल्लेखाः - </b>मनु० ४-२४४<br><br>उत्कर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಘನತೆ /ದೊಡ್ಡಸ್ತಿಕೆ<br><br>उत्कर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಳೆಯುವಿಕೆ<br><br>उत्कर्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ /ಮೇಲ್ಮೆ ಪಡೆದ<br><br>उत्कर्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಶಯವಾದ /ಹೆಚ್ಚಾದ<br><br>उत्कर्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಂಬದಿಂದ ಕೂಡಿದ /ಬಡಾಯಿ ಕೊಚ್ಚಿಕೊಳ್ಳುವ<br><b>निष्पत्तिः - </b>उत् +कृष (विलेखने) - "अच्" (३-१-१३४)<br><br>

उत्कर्षण
उत्कर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಳೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

उत्कर्षक
उत्कर्षक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠತೆಯನ್ನುಂಟುಮಾಡುವ<br><br>उत्कर्षक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಿಸುವ /ಅಧಿಕಪಡಿಸುವ<br><br>उत्कर्षक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಳೆಯುವ<br><b>निष्पत्तिः - </b>उत् +कृष (विलेखने) + णिच् - "ण्वुल्" (३-१-१३३)<br><br>

उत्कर्षित
उत्कर्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠತೆಯನ್ನು ಪಡೆದ /ಮೇಲ್ಮೆ ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>उत्कर्षोऽस्य सञ्जातः<br><br>

उत्कर्षिन्
उत्कर्षिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲ್ಮೆಯುಳ್ಳ /ಶ್ರೇಷ್ಠತೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>उत्कर्षोऽस्यास्ति<br><br>उत्कर्षिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಳೆಯುವ<br><b>निष्पत्तिः - </b>उत् +कृष (विलेखने) - "णिनिः" (३-१-१३४)<br><br>

उत्कल
उत्कल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಕಲದೇಶ /ಒರಿಸ್ಸಾ ಪ್ರಾಂತ<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>उत्कल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಕಲದೇಶದ ನಿವಾಸಿಗಳು<br><br>उत्कल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಕಲದೇಶದ ದೊರೆಗಳು<br><b>प्रयोगाः - </b>"उत्कलादर्शितपथः कलिङ्गाभिमुखो ययौ"<br><b>उल्लेखाः - </b>रघु० ४-३८<br><br>उत्कल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಕ್ಕಿಯ ಬೇಟೆಗಾರ<br><br>उत्कल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಾರವನ್ನು ಹೊರುವ ಕೂಲಿಯಾಳು<br><br>

उत्कलिका
उत्कलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಔತ್ಸುಕ್ಯ /ಆಸೆ /ಬಯಕೆ<br><b>निष्पत्तिः - </b>उत् +कल (शब्दसङ्ख्यानयोः) - "वुन्" (उ० ५-३५)<br><br>उत्कलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಂತೆ /ವ್ಯಾಕುಲತೆ /ಕಾಮಸಂಬಂಧವಾದ ಸ್ಮರಣೆ<br><br>उत्कलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತರಂಗ /ಅಲೆ<br><b>प्रयोगाः - </b>"क्षुभितमुत्कलिकातरलं मनः"<br><b>उल्लेखाः - </b>मालती० ३-१०<br><br>उत्कलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶೃಂಗಾರಚೇಷ್ಟೆ /ಸ್ತ್ರೀಯರ ಹಾವಭಾವಗಳು<br><b>विस्तारः - </b>"कथितोत्कलिकातरलं हेलासलिलवीचिषु" - मेदि० ।<br><br>उत्कलिका<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹೊರಟಿರುವ ಮೊಗ್ಗುಳ್ಳ /ಹೊರಕ್ಕೆ ಬಂದಿರುವ ಮೊಗ್ಗುಳ್ಳ<br><b>व्युत्पत्तिः - </b>उद्गता कलिका यस्य<br><b>प्रयोगाः - </b>"उद्दामोत्कलिकां विपाण्डुररुचं प्रारब्धजृम्भां क्षणात्"<br><b>उल्लेखाः - </b>रत्ना० २-४<br><br>

उत्कलिकाप्राय
उत्कलिकाप्राय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗದ್ಯಕಾವ್ಯದ ಒಂದು ಭೇದ /ಕರ್ಕಶ ವರ್ಣಗಳಿಂದಲೂ ಸಮಸ್ತಪದಗಳಿಂದಲೂ ಕೂಡಿದ ಗದ್ಯಕಾವ್ಯದ ಒಂದು ಭೇದ<br><br>

उत्कषण
उत्कषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆಯುವುದು<br><b>निष्पत्तिः - </b>उत् +कष (हिंसायाम्) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"सद्यः सीरोत्कषणसुरभि क्षेत्रमारुह्य मालम्"<br><b>उल्लेखाः - </b>मेघ० १-१६<br><br>उत्कषण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಳೆಯುವ<br><b>निष्पत्तिः - </b>उत् +कष - "ल्युः" (३-१-१३४)<br><br>

उत्कार
उत्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯವನ್ನು ತೂರಿ ರಾಶಿ ಹಾಕುವುದು /ಧಾನ್ಯವನ್ನು ಗುಪ್ಪೆ ಹಾಕುವಿಕೆ<br><b>निष्पत्तिः - </b>उत् + कॄ (विक्षेपे) - "घञ्" (३-३-३०)<br><br>

उत्किर
उत्किर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎರಚುವ /ಎಸೆಯುವ<br><b>निष्पत्तिः - </b>उत् + कॄ (विक्षेपे) - "कः" (३-१-१३५)<br><b>प्रयोगाः - </b>"आप्लुतास्तीरमन्दारकुसुमोत्किरवीचिषु" । "पुष्परेणूत्किरैर्वार्तैः" ।<br><b>उल्लेखाः - </b>कुमा० ६-५, रघु० १-३८<br><br>

उत्किीर्ण
उत्किीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊರೆಯಲ್ಪಟ್ಟ /ರಂಧ್ರ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उत् + कॄ (विक्षेपे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"मणौ वज्रसमुत्कीर्णे सूत्रस्येवास्ति मे मतिः"<br><b>उल्लेखाः - </b>रघु० १-४<br><br>उत्किीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರ ಕೊರೆಯಲ್ಪಟ್ಟ /ನಕಾಶೆ ಕೆತ್ತಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"लीनेव प्रतिबिम्बितेव लिखितेवोत्कीर्णरूपेव च"<br><b>उल्लेखाः - </b>मालती० ५-१०<br><br>उत्किीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಬ್ಬಿಸಲ್ಪಟ್ಟ /ಮೇಲಕ್ಕೆ ಹೊರಡಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"रजोभिस्तुरगोत्कीर्णैरस्पृष्टालकवेष्टनौ"<br><b>उल्लेखाः - </b>रघु० १-४२<br><br>उत्किीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿತ್ತು ಹಾಕಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"उत्कीर्णचामीकरपङ्कजानां दिग्दन्तिदानद्रवदूषितानाम्"<br><b>उल्लेखाः - </b>कुमा० १३-३९<br><br>

उत्कीर्तन
उत्कीर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಚ್ಚಸ್ವರದಿಂದ ಹೇಳುವುದು /ಗಟ್ಟಿಯಾಗಿ ಹೇಳುವುದು<br><b>व्युत्पत्तिः - </b>उच्चैः कीर्तनम्<br><br>उत्कीर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತೋತ್ರ ಮಾಡುವುದು /ಕೊಂಡಾಡುವುದು<br><b>निष्पत्तिः - </b>उत् + कॄत (संशब्दने) - "ल्युट्" (३-३-११५)<br><br>

उत्कीर्तित
उत्कीर्तित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ ಹೇಳಲ್ಪಟ್ಟ /ಸಾರಲ್ಪಟ್ಟ<br><br>उत्कीर्तित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ತುತಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उत् + कॄत (संशब्दने) - "क्तः" (३-२-१०२)<br><br>

उत्कुण
उत्कुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೇನು /ಕೂರೆ<br><br>

उत्कूट
उत्कूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಛತ್ರಿ /ಕೊಡೆ<br><b>व्युत्पत्तिः - </b>उन्नतं कूटमस्य<br><br>

उत्कूल
उत्कूल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಡವನ್ನು ಮೀರಿಸುವ /ತೀರವನ್ನು ಮೀರಿ ಬಂದಿರುವ<br><b>व्युत्पत्तिः - </b>उत्क्रान्तः कूलात्<br><br>उत्कूल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಡವನ್ನು ಮುಟ್ಟಿರುವ /ತೀರದವರೆಗೂ ಬಂದಿರುವ<br><b>व्युत्पत्तिः - </b>उद्गतः कूलम्<br><br>

उत्कूलित
उत्कूलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಡ ಮುಟ್ಟಿಸಲ್ಪಟ್ಟ /ತೀರದವರೆಗೂ ಒಯ್ಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उत् + कूल (आवरणे) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"वनावलीरुत्कलिकासहस्रप्रतिक्षणोत्कूलितशैवलाभाः"<br><b>उल्लेखाः - </b>माघ० ३-७०<br><br>

उत्कृति
उत्कृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೃತ್ತರತ್ನಾಕರೋಕ್ತವಾದ ೨೬ನೆಯ ಛಂದಸ್ಸು<br><br>

उत्कृत्त्य
उत्कृत्त्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸಿ /ತುಂಡುಮಾಡಿ<br><b>निष्पत्तिः - </b>उत् + कृती (छेदने) - "ल्यप्" (७-१-३७)<br><b>प्रयोगाः - </b>"उत्कृत्त्योत्कृत्य कृतिं प्रथममथ पृथूत्सेधभूयांसि मांसानि"<br><b>उल्लेखाः - </b>मालती० ५-१६<br><br>

उत्कृष्ट
उत्कृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತಮವಾದ /ಶ್ರೇಷ್ಠವಾದ<br><br>उत्कृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಶಯವಾದ /ಹೆಚ್ಚಾದ<br><br>उत्कृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೊಡ್ಡದಾದ /ಘನತೆಯನ್ನು ಪಡೆದ /ಮೇಲ್ಮೆ ಪಡೆದ<br><br>उत्कृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಳೆಯಲ್ಪಟ್ಟ<br><br>उत्कृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಷಿ ಮಾಡಲ್ಪಟ್ಟ ಭೂಮಿ /ಸಾಗುವಳಿ ಮಾಡಲ್ಪಟ್ಟ ಜಮೀನು<br><b>निष्पत्तिः - </b>उत् +कृष (विलेखने) - कर्त० कर्म० वा "क्तः" (३-४-७२) (३-२-१०२)<br><br>उत्कृष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ ಕೂಗುವುದು<br><br>उत्कृष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ ಮಾತಾಡುವುದು<br><br>उत्कृष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ ಅಳುವುದು<br><b>निष्पत्तिः - </b>उत् +कुश (आह्वाने रोदने च) - "क्तः" (३-३-११४)<br><br>उत्कृष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ ಕೂಗಲ್ಪಟ್ಟ<br><br>उत्कृष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ ಹೇಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कर्म० "क्तः" (३-२-१०२)<br><br>

उत्कोच
उत्कोच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಂಚ /ವ್ಯವಹಾರವನ್ನು ನ್ಯಾಯವಿರುದ್ಧವಾಗಿ ತನ್ನಿಷ್ಟದಂತೆ ನಿರ್ಣಯಿಸಲು ಅಧಿಕಾರಿಗೆ ಕೊಡುವ ಧನ /ತನಗಿರುವ ಆತಂಕವನ್ನು ನಿವಾರಿಸಲು ಅಧಿಕಾರಿಗೆ ಕೊಡುವ ಹಣ<br><br>

उत्कोचक
उत्कोचक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲಂಚ ಪಡೆಯುವ ಅಧಿಕಾರಿ<br><b>निष्पत्तिः - </b>उत् +कुच (सम्पर्चने) - "ण्वुल्" (३-१-१३३)<br><br>

उत्क्रम
उत्क्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿರುದ್ಧವಾದ ಕ್ರಮ /ಪ್ರತಿಕೂಲವಾಗಿ ಹೋಗುವುದು /ದಾರಿ ತಪ್ಪಿ ಹೋಗುವುದು<br><b>निष्पत्तिः - </b>उत् +क्रमु (पादविक्षेपे) - "घञ्" (३-३-१८)<br><br>उत्क्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹೋಗುವುದು /ಊರ್ಧ್ವಗಮನ<br><br>

उत्क्रमण
उत्क्रमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹೋಗುವುದು /ಊರ್ಧ್ವಗಮನ<br><br>उत्क्रमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿರ್ಗಮನ /ಹೊರಡುವುದು /ಪ್ರಯಾಣ<br><br>उत्क्रमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಣ ಹಾರಿ ಹೋಗುವುದು<br><b>निष्पत्तिः - </b>उत् +क्रमु (पादविक्षेपे) - "ल्युट्" (३-३-११५)<br><br>

उत्क्रान्त
उत्क्रान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರಿ ಹೋದ<br><b>निष्पत्तिः - </b>उत् +क्रमु (पादविक्षेपे) - "क्तः" (३-४-७२)<br><br>

उत्क्रान्ति
उत्क्रान्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರಿ ಹೋಗುವುದು<br><b>निष्पत्तिः - </b>उत् +क्रमु (पादविक्षेपे) - "क्तिन्" (३-३-९४)<br><br>

उत्क्रामत्
उत्क्रामत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರುತ್ತಿರುವ /ಊರ್ಧ್ವಮುಖವಾಗಿ ಹೋಗುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उत् +क्रमु (पादविक्षेपे) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"उत्क्रामन्तं स्थितं वापि भुञ्जानं वा गुणान्वितम्"<br><b>उल्लेखाः - </b>गीता० १५-१०<br><br>

उत्क्रोश
उत्क्रोश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರವಹಕ್ಕಿ /ನೀರಿನ ಮೇಲೆ ತೇಲಾಡುವ ಸ್ವಭಾವದ ಒಂದು ಜಲಚರ ಪ್ರಾಣಿ<br><b>निष्पत्तिः - </b>उत् + क्रुश (आह्वाने) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उत्क्रोशति<br><br>उत्क्रोश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ ಕೂಗುವುದು<br><b>निष्पत्तिः - </b>भावे "घञ्" (३-३-१८)<br><br>उत्क्रोश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ ಕೂಗುವ<br><br>

उत्क्लेश
उत्क्लेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಊರ್ಧ್ವಮುಖವಾದ ವಾಯುವಿನಿಂದ ಉಂಟಾಗುವ ತೊಂದರೆ /ವಾಕರಿಕೆ<br><br>उत्क्लेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶರೀರದೊಳಗಿನ ಧಾತುವಿನ ವ್ಯತ್ಯಾಸ /ರಸದ ಅವ್ಯವಸ್ಥೆ<br><b>निष्पत्तिः - </b>उत् +क्लिशू (विबाधने) - "घञ्" (३-३-१८)<br><br>

उत्क्लेशन
उत्क्लेशन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶರೀರದೊಳಗಿನ ರಸವನ್ನು ಅವ್ಯವಸ್ಥೆಗೊಳಿಸುವ /ತ್ರಿದೋಷಗಳನು ತಾರುಮಾರು ಮಾಡುವ<br><b>निष्पत्तिः - </b>उत् +क्लिशू (विबाधने) - "ल्युः" (३-१-१३४)<br><br>

उत्क्षिप्त
उत्क्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಸೆಯಲ್ಪಟ್ಟ /ಮೇಲಕ್ಕೆ ಹಾರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उत् +क्षिपु (निरसने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"क्षणं क्षणोत्क्षिप्तगजेन्द्रकृत्तिना" ।<br><b>उल्लेखाः - </b>माघ० १-४<br><br>उत्क्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"उत्क्षिप्तगात्रः स्म विडम्बयन्नभः समुत्पतिष्यन्तमगेन्द्रमुच्चकैः"<br><b>उल्लेखाः - </b>माघ० १२-५<br><br>उत्क्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿತ್ತುಹಾಕಲ್ಪಟ್ಟ /ನಿರ್ಮೂಲ ಮಾಡಲ್ಪಟ್ಟ<br><br>उत्क्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಳ್ಳಿ ಹಾಕಲ್ಪಟ್ಟ /ನಿರಾಕರಿಸಲ್ಪಟ್ಟ<br><br>

उत्क्षिप्तिका
उत्क्षिप्तिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಿನ ಕಿವಿಗೆ ಹಾಕಿಕೊಳ್ಳುವ ಚಂದ್ರಮುರು<br><b>विस्तारः - </b>"उत्क्षिप्तिका तु कर्णाकः" - वैज० ।<br><br>

उत्क्षेप
उत्क्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಸೆಯುವುದು<br><br>उत्क्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರುವುದು<br><b>निष्पत्तिः - </b>उत् +क्षिपु (निरसने) - "घञ्"(३-३-१८)<br><b>प्रयोगाः - </b>"बिन्दूत्क्षेपान् पिपासुः परिसरति शिखी भ्रान्तिमद्वारियन्त्रम्"<br><b>उल्लेखाः - </b>माल० २-१२<br><br>उत्क्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಳ್ಳಿ ಹಾಕುವುದು /ನಿರಾಕರಿಸುವುದು<br><br>

उत्क्षेपक
उत्क्षेपक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಸೆಯುವ<br><b>निष्पत्तिः - </b>उत् +क्षिपु (निरसने) - "ण्वुल्" (३-१-१३३)<br><br>उत्क्षेपक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೋರ /ಕಳ್ಳ<br><br>

उत्क्षेपण
उत्क्षेपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಸೆಯುವುದು<br><b>निष्पत्तिः - </b>उत् +क्षिपु (निरसने) - "ल्युट्" (३-३-११५)<br><br>उत्क्षेपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತುವುದು<br><b>प्रयोगाः - </b>"स्रस्तांसावतिमात्रलोहिततलौ बाहू घटोत्क्षेपणात्"<br><b>उल्लेखाः - </b>शाकु० १-२६<br><br>उत्क्षेपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯವನ್ನು ಬಡಿಯುವ ಕೋಲು /ಕಣದಲ್ಲಿ ತೆನೆಗಳಿಂದ ಧಾನ್ಯವನ್ನು ಬೇರ್ಪಡಿಸುವ ಕೋಲು<br><br>उत्क्षेपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯವನ್ನು ತೂರುವ ಮೊರ /ಕೊಂಗ<br><b>निष्पत्तिः - </b>कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>उत्क्षिप्यतेऽनेन<br><br>उत्क्षेपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೀಸಣಿಗೆ<br><b>निष्पत्तिः - </b>कर्म० "ल्युट्"<br><b>व्युत्पत्तिः - </b>उत्क्षिप्यते<br><b>विस्तारः - </b>"उत्क्षेपणन्तु व्यजने धान्यमर्दनवस्तुनि"- मेदि० ।<br><br>

उत्खचित
उत्खचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎತ್ತಿ ಕಟ್ಟಲ್ಪಟ್ಟ<br><br>उत्खचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ರಚಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उत् +खच (बन्धने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"कुसुमोत्खचितान् वलीभृतश्चलयन् भृङ्गरुचस्तवालकान्"<br><b>उल्लेखाः - </b>रघु० ८-५३<br><br>

उत्खन्यमान
उत्खन्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗೆಯಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उत् +खनु (अवदारणे) - कर्म० "शानच्" (३-२-१२४)<br><br>

उत्खात
उत्खात<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಳ್ಳ ತೋಡುವುದು /ಗುಣಿ ಮಾಡುವುದು /ಅಗೆಯುವುದು<br><br>उत्खात<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸುವುದು /ಹಾಳು ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>उत् +खनु (अवदारणे) - भावे "क्तः" (३-३-११४)<br><br>उत्खात<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೀಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उत् +खनु (अवदारणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"फलैः संवर्धयामासुरुत्खातप्रतिरोपिताः" । "विधातुमुत्खातविषाणमण्डलः" ।<br><b>उल्लेखाः - </b>रघु० ४-३७, माघ० १-५७<br><br>उत्खात<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರು ಸಹಿತ ಕಿತ್ತು ಹಾಕಲ್ಪಟ್ಟ /ಬುಡಸಹಿತ ತೆಗೆಯಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"उत्खातविफुलस्तम्भा नागास्त्रुटितशृङ्खलाः"<br><b>उल्लेखाः - </b>याद० १६-२०<br><br>उत्खात<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆಯಲ್ಪಟ್ಟ /ಮೇಲಕ್ಕೆ ತೆಗೆಯಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"लीलोत्खातमृणालकाण्डकवलच्छेदेषु सम्पादिताः"<br><b>उल्लेखाः - </b>मालती० ९-३४<br><br>

उत्खातकेलि
उत्खातकेलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಪ್ರಕ್ರೀಡೆ /ಆನೆ ಗೂಳಿ ಮೊದಲಾದುವು ಕೊಂಬಿನಿಂದ ಮಣ್ಣನ್ನು ಅಗೆಯುವ ಆಟ<br><b>व्युत्पत्तिः - </b>उत्खातमेव केलिः<br><br>

उत्खाय
उत्खाय<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕಿತ್ತು ಹಾಕಿ /ನಿರ್ಮೂಲ ಮಾಡಿ /ತೆಗೆದುಹಾಕಿ<br><b>निष्पत्तिः - </b>उत् +खनु (अवदारणे) - "ल्यप्" (७-१-३७)<br><b>प्रयोगाः - </b>"वङ्गानुत्खाय तरसा नेता नौसाधनोद्यतान्"<br><b>उल्लेखाः - </b>रघु० ४-३६<br><br>

उत्त
उत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒದ್ದೆಯಾದ /ತೇವವಾದ<br><b>निष्पत्तिः - </b>उन्दी (छेदने) - "क्तः" (३-४-७२)<br><br>

उत्तंस
उत्तंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣಾಭರಣ /ಕುಂಡಲ<br><b>निष्पत्तिः - </b>उद् + तसि (अलङ्कारे) - "घञ्" (३-३-१२१)<br><b>प्रयोगाः - </b>"नोत्तंसं क्षिपति क्षितौ श्रवणतः सा मे स्फुटेऽप्यागसि"<br><b>उल्लेखाः - </b>सा० द०<br><br>उत्तंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿರೋಭೂಷಣ /ತಲೆಯಲ್ಲಿ ಧರಿಸುವ ಒಡವೆ<br><br>

उत्तप्त
उत्तप्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಣಗಿಸಲ್ಪಟ್ಟ ಮಾಂಸ<br><b>निष्पत्तिः - </b>उत् + तप (सन्तापे) - "क्तः" (३-२-१०२)<br><br>उत्तप्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ತಾಪ /ಹೆಚ್ಚು ಬಿಸಿ<br><br>उत्तप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಸಿ ಮಾಡಲ್ಪಟ್ಟ /ಕಾಯಿಸಲ್ಪಟ್ಟ<br><br>उत्तप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ನಾನ ಮಾಡಿದ /ತಾಪ ಪರಿಹಾರ ಮಾಡಿಕೊಂಡ<br><b>व्युत्पत्तिः - </b>उद्गतं तप्तं तापो यस्य<br><br>

उत्तम
उत्तम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತಾನಪಾದರಾಯನ ಮಗ /ಸುರುಚಿಯ ಪುತ್ರ<br><br>उत्तम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಕೃಷ್ಟವಾದ /ಶ್ರೇಷ್ಠವಾದ<br><b>निष्पत्तिः - </b>उत् + तमप् (५-३-५५)<br><b>प्रयोगाः - </b>"विघ्नैः पुनःपुनरपि प्रतिहन्यमानाः प्रारन्धमुत्तमगुणास्त्वमिवोद्वहन्ति"<br><b>उल्लेखाः - </b>मुद्रा० २-१७<br><br>उत्तम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳ್ಳೆಯ ಗುಣವುಳ್ಳ /ಶ್ರೇಷ್ಠ ಗುಣವುಳ್ಳ<br><b>प्रयोगाः - </b>"प्रायःप्रययमादत्ते स्वगुणेषूत्तमादरः"<br><b>उल्लेखाः - </b>कुमा० ६-२०<br><br>उत्तम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕವಾದ /ಹೆಚ್ಚಾದ<br><b>प्रयोगाः - </b>"द्वैप्यानसावुत्तमलाभभाजः"<br><b>उल्लेखाः - </b>माघ० ३-७६<br><br>

उत्तमगुण
उत्तमगुण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳ್ಳೆಯ ಗುಣವುಳ್ಳ /ಶ್ರೇಷ್ಠ ಗುಣವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>उत्तमा गुणा यस्य<br><b>प्रयोगाः - </b>"विघ्नैः पुनःपुनरपि प्रतिहन्यमानाः प्रारन्धमुत्तमगुणास्त्वमिवोद्वहन्ति"<br><b>उल्लेखाः - </b>मुद्रा० २-१७<br><br>

उत्तमपुरुष
उत्तमपुरुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><b>प्रयोगाः - </b>"उत्तमः पुरुषस्त्वन्यः परमात्मेत्युदाहृतः"<br><b>उल्लेखाः - </b>गीता० १५-१७<br><br>

उत्तमफलिनी
उत्तमफलिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಲುತೊಟ್ಟಿನ ಗಿಡ /ಕೀರಹಾಲೆ ಸೊಪ್ಪಿನ ಗಿಡ<br><br>

उत्तमसाहस
उत्तमसाहस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊದಲನೆಯ ದರ್ಜೆಯ ಜುಲ್ಮಾನೆ /ದಂಡಾಧಿಕಾರಿಯಿಂದ ವಿಧಿಸಲ್ಪಟ್ಟ ೧೦೦೦ ರೂಪಾಯಿ ದಂಡ<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>साहसमधिकृततयाऽस्त्यस्य<br><b>प्रयोगाः - </b>"पणानां द्वे शते सार्धे प्रथमः साहसः स्मृतः । मध्यमः पञ्च विज्ञेयः सहस्रं त्वेव चोत्तमः ॥"<br><b>उल्लेखाः - </b>मनु० ८-१३८<br><br>उत्तमसाहस<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಣಿ ಹಿಂಸೆ ಮೊದಲಾದ ಕ್ರೂರವಾದ ಕೆಲಸ /ಜನೋಪಕಾರಕವಾದ ಕೆರೆ ಕಟ್ಟೆ ಮೊದಲಾದುವನ್ನು ಒಡೆದು ಹಾಕುವುದು ಮುಂತಾದ ತೊಂದರೆಯ ಕೆಲಸ<br><br>

उत्तमा
उत्तमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತಮ ಹೆಂಗಸು /ಶ್ರೇಷ್ಠ ಗುಣವುಳ್ಳ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>उद् - "तमप्" (५-३-५५)<br><br>

उत्तमाङ्ग
उत्तमाङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆ /ಶಿರಸ್ಸು<br><b>व्युत्पत्तिः - </b>उत्तमं च तत् अङ्गं च<br><b>प्रयोगाः - </b>"स तद्दुकूलादविदूरमौलिर्बभौ पतद्रङ्गं इवोत्तमाङ्गे"<br><b>उल्लेखाः - </b>कुमा० ७-४१<br><br>

उत्तम्भ
उत्तम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವಲಂಬನ /ಒತ್ತುಗಂಬ /ಆಧಾರಸ್ತಂಭ<br><b>निष्पत्तिः - </b>उद् + स्तम्भु (रोधने) - "घञ्" (३-३-१२१)<br><br>

उत्तम्भन
उत्तम्भन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಲಂಬನ /ಆಧಾರ /ಆಶ್ರಯ<br><b>निष्पत्तिः - </b>उद् + स्तम्भु (रोधने) - भावे "ल्युट्" (३-३-११५)<br><br>उत्तम्भन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಲಂಬನ /ಒತ್ತುಗಂಬ /ಆಧಾರಸ್ತಂಭ<br><b>निष्पत्तिः - </b>उद् + स्तम्भु (रोधने) -कर० "ल्युट्" (३-३-११७)<br><b>प्रयोगाः - </b>"लब्धायामं दन्तयोर्युग्ममेव स्वं नागस्य प्रापदुत्तम्भनत्वम्"<br><b>उल्लेखाः - </b>माघ० १८-४६<br><br>

उत्तर
उत्तर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರಕುಮಾರ/ವಿರಾಟರಾಯನ ಮಗ<br><br>उत्तर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>उद् + तॄ (प्ल्वनतरणयोः) - "अप्" (३-३-५७)<br><b>व्युत्पत्तिः - </b>उत्तीर्यते संसारोऽस्मात्<br><b>प्रयोगाः - </b>"उत्तरो गोपतिर्गोप्ता"<br><b>उल्लेखाः - </b>वि० स०<br><br>उत्तर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ<br><br>उत्तर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರದೇಶ<br><br>उत्तर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರಕಾಲ /ಮುಂದಿನ ಕಾಲ<br><br>उत्तर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><br>उत्तर<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>೧೨ನೆಯ ೨೧ನೆಯ ಮತ್ತು ೨೬ನೆಯ ನಕ್ಷತ್ರಗಳು /ಉತ್ತರಫಲ್ಗುನಿ ಉತ್ತರಾಷಾಢಾ ಮತ್ತು ಉತ್ತರಾಭಾದ್ರಾ ನಕ್ಷತ್ರಗಳು<br><br>उत्तर<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರ /ಬದಲು ಮಾತು /ಪ್ರತಿವಚನ<br><b>प्रयोगाः - </b>"वीक्षितेन परिवीक्ष्य पार्वती मूर्धकम्पमयमुत्तरं ददौ"<br><b>उल्लेखाः - </b>कुमा० ८-६<br><br>उत्तर<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಸ್ತಪದದಲ್ಲಿ ಕೊನೆಯ ಪದ<br><br>उत्तर<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿರ್ಣಯ /ಸಿದ್ಧಾಂತ<br><br>उत्तर<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಠರಾವು /ನಿರ್ಣಯ<br><br>उत्तर<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಕ್ತಾಯ /ಸಮಾಪ್ತಿ<br><br>उत्तर<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲ್ಮೆ /ಶ್ರೇಷ್ಠತೆ<br><br>उत्तर<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೀಮಾಂಸಕರ ಅಧಿಕರಣದ ಪಂಚಾವಯವಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"विषयो विशयश्चैव पूर्वपक्षस्तथोत्तरम् ।निर्णयश्चेति सिद्धान्ताः शास्त्रेऽधिकरणं स्मृतम् ॥"<br><br>उत्तर<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲುಭಾಗ<br><br>उत्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊರ್ಧ್ವಭಾಗದಲ್ಲಿರುವ<br><br>उत्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಡಭಾಗದ /ವಾಮಭಾಗದ<br><br>उत्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕವಾದ /ಹೆಚ್ಚಾದ<br><br>उत्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದಿನ /ಅನಂತರದ<br><b>प्रयोगाः - </b>"विधीयतां तत्र विधेयमुत्तरम्"<br><b>उल्लेखाः - </b>किरा० १-२५<br><br>उत्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದಿನ ಕಾಲದ<br><br>उत्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಧಾನವಾದ /ಮುಖ್ಯವಾದ<br><b>प्रयोगाः - </b>"धर्मोत्तरं मध्यममाश्रयन्ते"<br><b>उल्लेखाः - </b>रघु० १३-७<br><br>उत्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತಮವಾದ /ಶ್ರೇಷ್ಠವಾದ<br><br>उत्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರದಿಕ್ಕಿನ<br><br>उत्तर<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನಂತರ /ಆಮೇಲೆ<br><br>उत्तर<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮುಂದಕ್ಕೆ<br><br>

उत्तरा
उत्तरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿರಾಟರಾಯನ ಮಗಳು ಉತ್ತರೆ /ಅಭಿಮನ್ಯುವಿನ ಪತ್ನಿ /ಅರ್ಜುನನ ಸೊಸೆ<br><br>उत्तरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರದಿಕ್ಕು<br><b>प्रयोगाः - </b>"अस्त्युत्तरस्यां दिशि देवतात्मा हिमालयो नाम नगाधिराजः"<br><b>उल्लेखाः - </b>कुमा० १-१<br><br>उत्तरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಧನುಸ್ಸಿನ ಸೌಂದರ್ಯ /ಬಿಲ್ಲಿನ ಸೊಬಗು<br><b>विस्तारः - </b>"उत्तरं प्रतिवाक्ये स्यादूर्ध्वोदीच्योत्तमेऽन्यवत् । उत्तरस्तु विराटस्य तनये दिशि चोत्तरा" - विश्व० । "उत्तरं प्रतिवाक्ये स्यादुदीच्ये प्रवरोर्ध्वयोः । स्त्रीलिङ्गत्वे धनुर्लक्ष्मां पुरुषे पावके च ना" - वैज० ।<br><br>उत्तरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರದಿಕ್ಕು<br><br>उत्तरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿರಾಟರಾಯನ ಮಗಳು /ಅಭಿಮನ್ಯುವಿನ ಹೆಂಡತಿ<br><br>उत्तरा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉತ್ತರದಿಕ್ಕಿನಲ್ಲಿ<br><br>उत्तरा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉತ್ತರದೇಶದಲ್ಲಿ<br><br>उत्तरा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉತ್ತರ ಕಾಲದಲ್ಲಿ /ಮುಂದಿನ ಕಾಲದಲ್ಲಿ<br><b>निष्पत्तिः - </b>उत्तर - "आ" (५-३-३६)<br><br>

उत्तरकाण्ड
उत्तरकाण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಮದ್ರಾಮಾಯಣದ ಉತ್ತರಕಾಂಡ<br><br>

उत्तरकोसल
उत्तरकोसल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಸಲ ದೇಶ<br><br>

उत्तरकोसला
उत्तरकोसला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಯೋಧ್ಯಾನಗರ<br><br>

उत्तरङ्ग
उत्तरङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏಳುವ ಅಲೆಗಳುಳ್ಳ<br><b>व्युत्पत्तिः - </b>उद्गताः तरङ्गाः यस्य<br><b>प्रयोगाः - </b>"अवृष्टिसंरम्भमिवाम्बुवाहमपामिवाधारमनुत्तरङ्गम्"<br><b>उल्लेखाः - </b>कुमा० ३-४८<br><br>

उत्तरतस्
उत्तरतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉತ್ತರದಿಕ್ಕಿನಲ್ಲಿ /ಉತ್ತರ ಪ್ರದೇಶದಲ್ಲಿ<br><br>उत्तरतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉತ್ತರ ದಿಕ್ಕಿನಿಂದ /ಉತ್ತರ ಪ್ರದೇಶದಿಂದ<br><br>उत्तरतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮೇಲುಗಡೆ /ಊರ್ಧ್ವಭಾಗ<br><br>उत्तरतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನಂತರ<br><b>निष्पत्तिः - </b>उत्तर - "अतसुच्" (५-३-२८)<br><br>

उत्तरत्र
उत्तरत्र<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉತ್ತರದಿಕ್ಕಿನಲ್ಲಿ /ಉತ್ತರ ಪ್ರದೇಶದಲ್ಲಿ<br><br>उत्तरत्र<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನಂತರದಲ್ಲಿ<br><b>निष्पत्तिः - </b>उत्तर - "त्रल्" (५-३-१०)<br><br>

उत्तरस्त्य
उत्तरस्त्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರ ದಿಕ್ಕಿನಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>उत्तरतस् - "त्यप्" (४-२-२०४)<br><br>

उत्तरत्रत्य
उत्तरत्रत्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರ ದಿಕ್ಕಿನಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>उत्तरत्र - "त्यप्" (४-२-२०४)<br><br>

उत्तरद
उत्तरद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರ ಕೊಡುವ<br><br>उत्तरद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬದಲು ಮಾತಾಡುವ /ಎದುರು ಮಾತಾಡುವ<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>उत्तरं ददाति<br><br>

उत्तरदायक
उत्तरदायक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರ ಕೊಡುವ<br><br>उत्तरदायक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬದಲು ಮಾತಾಡುವ /ಎದುರು ಮಾತಾಡುವ /ಅಧಿಕಪ್ರಸಂಗಿ<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>उत्तरं ददाति<br><br>

उत्तरदिक्पालक
उत्तरदिक्पालक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರ /ಉತ್ತರದಿಕ್ಕನ್ನು ರಕ್ಷಿಸುವವನು<br><br>

उत्तरदिक्पाश
उत्तरदिक्पाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರ ದಿಕ್ಕಿನ ಪಾಶಚಕ್ರ<br><br>

उत्तरदिक्शूल
उत्तरदिक्शूल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರದಿಕ್ಕಿನಲ್ಲಿ ಪ್ರಯಾಣವನ್ನು ನಿಷೇಧಿಸುವ ಬುಧವಾದ<br><br>उत्तरदिक्शूल<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರಫಲ್ಗುನೀ ನಕ್ಷತ್ರ<br><br>

उत्तरदिगीश
उत्तरदिगीश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರ<br><br>

उत्तरदिग्द्वार
उत्तरदिग्द्वार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರ ದಿಕ್ಕಿನಲ್ಲಿ ಪ್ರಯಾಣಕ್ಕೆ ಪ್ರಶಸ್ತವಾದ ನಕ್ಷತ್ರಗಳು<br><b>व्युत्पत्तिः - </b>उत्तरदिशि द्वारं मुखमस्य<br><br>

उत्तरदिग्बलिन्
उत्तरदिग्बलिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶುಕ್ರ<br><br>उत्तरदिग्बलिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>प्रयोगाः - </b>"प्राच्यां सौम्यसुराचार्यौ याम्यां भास्करभूमिजौ । प्रत्यक् सौरिरुदीच्यां तु सितेन्दू दिग्बलान्वितौ ॥"<br><br>

उत्तरपक्ष
उत्तरपक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರಪಕ್ಷ /ತಿಂಗಳಿನ ಎರಡನೆಯ ಅರ್ಧಭಾಗ<br><br>उत्तरपक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾದದ ಕೊನೆಯ ಭಾಗ /ಸಿದ್ಧಾಂತ /ನಿರ್ಣಯ<br><br>उत्तरपक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೀಮಾಂಸಕರ ಅಧಿಕರಣದ ಪಂಚಾವಯವಗಳಲ್ಲೊಂದು<br><br>

उत्तरपट
उत्तरपट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರೀಯ /ಹೊದೆಯುವ ವಸ್ತ್ರ<br><br>उत्तरपट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಸಿಗೆಯ ಮೇಲೆ ಹಾಸುವ ಬಟ್ಟೆ /ಮಗ್ಗಲು ಹಾಸಿಗೆ /ದುಪ್ಪಟ<br><br>

उत्तरपथ
उत्तरपथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರದಿಕ್ಕಿನ ದಾರಿ /ಉತ್ತರದಿಕ್ಕಿಗೆ ಹೋಗುವ ಮಾರ್ಗ<br><br>उत्तरपथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆಗಳು ಸಂಚರಿಸುವ ದಾರಿ<br><br>उत्तरपथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಜ್ಞಾನಿಗಳು ಬ್ರಹ್ಮಲೋಕಕ್ಕೆ ಹೋಗುವ ಅರ್ಚಿರಾದಿ ಮಾರ್ಗ /ಉತ್ತರಾಯಣ<br><b>निष्पत्तिः - </b>"अः" (५-४-७४)<br><b>व्युत्पत्तिः - </b>उत्तरश्चासौ पन्थाश्च<br><b>प्रयोगाः - </b>"अग्निर्ज्योतिरहः शुक्लः षण्मासा उत्तरायणम् । तत्र प्रयाता गच्छन्ति ब्रह्म ब्रह्मविदो जनाः ॥"<br><b>उल्लेखाः - </b>गीता० ८-२४<br><br>

उत्तरपथिक
उत्तरपथिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರದೇಶದ ಯಾತ್ರಿಕ<br><b>निष्पत्तिः - </b>"ष्कन्" (५-१-७५)<br><b>व्युत्पत्तिः - </b>पन्थानं गच्छति । उत्तरश्चासौ पथिकश्च<br><br>

उत्तरपद
उत्तरपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಸ್ತಪದದಲ್ಲಿ ಕೊನೆಯ ಪದ<br><br>उत्तरपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂದಿನ ಪದ<br><b>व्युत्पत्तिः - </b>उत्तरं च तत् पदं च<br><br>

उत्तरपश्चिमा
उत्तरपश्चिमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರ ಮತ್ತು ಪಶ್ಚಿಮ ದಿಕ್ಕುಗಳ ಮಧ್ಯದ ದಿಕ್ಕು<br><b>व्युत्पत्तिः - </b>उत्तरस्याः पश्चिमायाश्च दिशोऽन्तरालम्<br><br>

उत्तरपाद
उत्तरपाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯವಹಾರದ ಎರಡನೆಯ ಹಂತ<br><b>प्रयोगाः - </b>"पूर्वपक्षः स्मृतः पादो द्वितीयश्चोत्तरः स्मृतः । क्रियापादः तृतीयः स्यात् चतुर्थो निर्णयः स्मृतः ॥"<br><br>

उत्तरपूर्वा
उत्तरपूर्वा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರ ಮತ್ತು ಪೂರ್ವ ದಿಕ್ಕುಗಳ ಮಧ್ಯದ ದಿಕ್ಕು /ಈಶಾನ್ಯ ದಿಕ್ಕು<br><b>व्युत्पत्तिः - </b>उत्तरस्याः पूर्वस्याश्च दिशोऽन्तरालम्<br><br>

उत्तरफल्गुनी
उत्तरफल्गुनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರ ಫಲ್ಗುನೀ ನಕ್ಷತ್ರ<br><b>निष्पत्तिः - </b>फल (निष्पत्तौ) - "उनन्" गुक् च (उ० ३-५६)<br><b>व्युत्पत्तिः - </b>फलति । उत्तरा च सा फल्गुनी च ।<br><b>प्रयोगाः - </b>"दाता दयालुः स्वजने सुशीलो विशालकीर्तिः सुमतिः प्रधानः । धीरो नरोऽत्यन्तमृदुस्वभावश्चेदुत्तराफल्गुनिकाप्रसूतिः ॥"<br><br>

उत्तरमीमांसा
उत्तरमीमांसा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇದವ್ಯಾಸಮಹರ್ಷಿ ಪ್ರಣೀತವಾದ ನಾಲ್ಕು ಅಧ್ಯಾಯಗಳುಳ್ಳ ಶಾರೀರಕಸೂತ್ರ /ಬ್ರಹ್ಮಸ್ವರೂಪದ ವಿಚಾರಮಾಡುವ ವೇದಾಂತ ಗ್ರಂಥ<br><b>व्युत्पत्तिः - </b>उत्तरस्य वेदशेषभागस्य उपनिषद्रूपस्य मीमांसा विचारः<br><br>

उत्तररामचरित
उत्तररामचरित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭವಭೂತಿ ರಚಿತವಾದ ಒಂದು ನಾಟಕ<br><b>व्युत्पत्तिः - </b>उत्तरं रामस्य चरित्रं यत्र<br><br>

उत्तरवादिन्
उत्तरवादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿವಾದಿ /ವ್ಯವಹಾರದಲ್ಲಿ ಪ್ರತಿಪಕ್ಷದವನು<br><b>निष्पत्तिः - </b>वद (व्यक्तायां वाचि) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उत्तरमुत्तरपक्षं सिद्धान्तं वदति<br><br>

उत्तरसाक्षिन्
उत्तरसाक्षिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನ ಪಕ್ಷದ ಇತರ ಸಾಕ್ಷಿಗಳ ವರದಿಯಿಂದ ಯಥಾರ್ಥವನ್ನು ನುಡಿದು ವ್ಯವಹಾರವನ್ನು ಸಾಧಿಸುವ ಸಾಕ್ಷಿ<br><b>विस्तारः - </b>"साक्षिणामपि यः साक्ष्यं स्वपक्षं परिभाषताम् । श्रवणात् श्रावणाद्वापि स साक्ष्युत्तरसञ्ज्ञकः ॥"<br><br>

उत्तरात्
उत्तरात्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉತ್ತರದಿಕ್ಕು /ಉತ್ತರ ದಿಕ್ಕಿನಿಂದ /ಉತ್ತರ ದಿಕ್ಕಿನಲ್ಲಿ<br><br>उत्तरात्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉತ್ತರದೇಶ /ಉತ್ತರದೇಶದಿಂದ /ಉತ್ತರ ದೇಶದಲ್ಲಿ<br><br>उत्तरात्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉತ್ತರ ಕಾಲ /ಉತ್ತರ ಕಾಲದಿಂದ /ಉತ್ತರ ಕಾಲದಲ್ಲಿ<br><b>निष्पत्तिः - </b>उत्तर (दिग्देशकालविषये) - "आतिः" (५-३-३४)<br><br>

उत्तराधर
उत्तराधर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಿನ ತುಟಿ<br><b>प्रयोगाः - </b>"निवार्यतामालि किमप्ययं वटुः पुनर्विवक्षुः स्फुरितोत्तराधरः"<br><b>उल्लेखाः - </b>कुमा० ५-८३<br><br>

उत्तराधिकारिन्
उत्तराधिकारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಕ್ಕುದಾರ /ವಾರಸುದಾರ /ಯಜಮಾನನ ಕಾಲಾನಂತರ ಆಸ್ತಿ ಪಾಸ್ತಿಗಳಿಗೆ ಅಧಿಕಾರಿಯಾಗಿರುವವನು<br><b>निष्पत्तिः - </b>अधि + डुकृञ् (करणे) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उत्तरमनन्तरमधिकरोति स्वत्त्वमाप्नोति<br><br>

उत्तराधिकारिणी
उत्तराधिकारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಜಮಾನನ ಕಾಲಾನಂತರ ಆಸ್ತಿ ಪಾಸ್ತಿಗಳಿಗೆ ಅಧಿಕಾರಿಯಾಗಿರುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उत्तरापरा
उत्तरापरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರ ಮತ್ತು ಪಶ್ಚಿಮ ದಿಕ್ಕುಗಳ ಮಧ್ಯದ ದಿಕ್ಕು /ವಾಯವ್ಯ ದಿಕ್ಕು<br><b>व्युत्पत्तिः - </b>उत्तरस्याः परस्याश्च दिशोऽन्तरालम्<br><br>

उत्तराभाद्रपद्
उत्तराभाद्रपद्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಿನ್ಯಾದಿ ೨೬ನೆಯ ನಕ್ಷತ್ರ<br><b>निष्पत्तिः - </b>पदशब्देन समासे "टाप्" (४-१-४)<br><b>व्युत्पत्तिः - </b>भद्राय हितः भाद्रः, भाद्रः पत् पादो यस्याः । उत्तरा च सा भाद्रपच्च<br><b>प्रयोगाः - </b>"धनी कुलीनः कुशलः क्रियादौ भूपालमान्यो बलवान् महौजाः । सत्कर्मकर्ता निजबन्धुभुक्तो यद्युत्तराभाद्रपदाप्रसूतः ॥"<br><br>

उत्तराभाद्रपदा
उत्तराभाद्रपदा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಿನ್ಯಾದಿ ೨೬ನೆಯ ನಕ್ಷತ್ರ<br><b>व्युत्पत्तिः - </b>उत्तरा उत्तरस्यामयनं सूर्यस्य सञ्चारः<br><br>

उत्तरायण
उत्तरायण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರ ದಿಕ್ಕಿನಲ್ಲಿ ಸೂರ್ಯನ ಸಂಚಾರ<br><b>प्रयोगाः - </b>"कर्कटादिस्थिते भानौ दक्षिणायनमुच्यते । उत्तरायणमप्युक्तं मकरस्थे दिवाकरे ॥"<br><br>उत्तरायण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನು ಉತ್ತರ ದಿಕ್ಕಿನಲ್ಲಿ ಸಂಚರಿಸುವ ಕಾಲ /ಮಕರ ಸಂಕ್ರಾಂತಿಯಿಂದ ಕರ್ಕಾಟಕ ಸಂಕ್ರಾಂತಿವರೆಗಿನ ಕಾಲ<br><br>

उत्तराशा
उत्तराशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರ ದಿಕ್ಕು<br><br>उत्तराशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂದಿನ ಆಶೆ<br><br>

उत्तराशाधीश
उत्तराशाधीश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬುಧಗ್ರಹ<br><br>उत्तराशाधीश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರ<br><br>

उत्तराषाढा
उत्तराषाढा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರಾಷಾಢಾ ನಕ್ಷತ್ರ<br><br>

उत्तरासङ्ग
उत्तरासङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರೀಯ /ಹೊದೆಯುವ ಬಟ್ಟೆ<br><b>निष्पत्तिः - </b>आ + षञ्ज (सङ्गे) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>उत्तरे ऊर्ध्वभागे आसज्यते<br><b>प्रयोगाः - </b>कृष्णोत्तरासङ्गरुचं विदधच्चौतपल्लवीम्"<br><b>उल्लेखाः - </b>माघ० २-१९<br><br>

उत्तराह
उत्तराह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂದಿನ ದಿನ /ಮಾರನೆಯ ದಿನ<br><b>निष्पत्तिः - </b>"टच्" (५-४-९१)<br><b>व्युत्पत्तिः - </b>उत्तरमहः<br><br>

उत्तराहि
उत्तराहि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉತ್ತರ ದಿಕ್ಕು /ಉತ್ತರ ದಿಕ್ಕಿನಿಂದ /ಉತ್ತರ ದಿಕ್ಕಿನಲ್ಲಿ<br><br>उत्तराहि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉತ್ತರದೇಶ /ಉತ್ತರ ದೇಶದಿಂದ /ಉತ್ತರ ದೇಶದಲ್ಲಿ<br><br>उत्तराहि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉತ್ತರ ಕಾಲ /ಉತ್ತರ ಕಾಲದಿಂದ /ಉತ್ತರ ಕಾಲದಲ್ಲಿ<br><b>निष्पत्तिः - </b>उत्तर - "आहि" (५-३-३८)<br><b>विस्तारः - </b>ಈ ರೀತಿ उत्तर ಶಬ್ದದ ಮೇಲೆ अतसुच्, आच्, आतिःಮತ್ತು आहि ಈ ನಾಲ್ಕು ಪ್ರತ್ಯಯಗಳು ಬರಲಾಗಿ उत्तरतः, उत्तरा, उत्तरात् ಮತ್ತು उत्तराहि ಎಂದು ದಿಗ್ದೇಶಕಾಲ ವಿಷಯಗಳಲ್ಲಿ ಪ್ರಥಮಾ, ಪಂಚಮೀ ಮತ್ತು ಸಪ್ತಮ್ಯರ್ಥಗಳಲ್ಲಿ ನಾಲ್ಕು ರೂಪಗಳಾಗುವುವು.<br><br>

उत्तरीय
उत्तरीय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊದೆಯುವ ಬಟ್ಟೆ<br><b>निष्पत्तिः - </b>"छः" (४-२-१३८)<br><b>व्युत्पत्तिः - </b>उत्तरस्मिन् देहभागे भवम्<br><b>प्रयोगाः - </b>"हृतोत्तरीयां प्रसभं सभायामागतह्रियः" । "धौतोत्तरीयप्रतिमच्छवीनि" ।<br><b>उल्लेखाः - </b>किरा० ११-४९, माघ० ४-५<br><br>

उत्तरेण
उत्तरेण<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉತ್ತರದ ಕಡೆ /ಉತ್ತರದ ದಿಕ್ಕಿನಲ್ಲಿ<br><b>निष्पत्तिः - </b>उत्तर - "एनप्" (५-३-३५)<br><b>प्रयोगाः - </b>"तत्रागारं धनपतिगृहानुत्तरेनास्मदीयम्"<br><b>उल्लेखाः - </b>मेघ० २-१२<br><br>

उत्तरेद्युस्
उत्तरेद्युस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮಾರನೆಯ ದಿನ /ಮರುದಿನ /ಮುಂದಿನ ದಿನ<br><b>निष्पत्तिः - </b>उत्तर - "एद्युस्" (५-३-२२)<br><br>

उत्तरोत्तर
उत्तरोत्तर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರದ ಮೇಲೆ ಉತ್ತರ /ಉತ್ತರಕ್ಕೆ ಬದಲು ಮಾತು<br><br>उत्तरोत्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದು ಮುಂದಿನ<br><br>उत्तरोत्तर<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮೇಲೆ ಮೇಲೆ /ಮುಂದೆ ಮುಂದೆ<br><b>प्रयोगाः - </b>"उत्तरोत्तरमुत्कर्षः सार इत्यभिधीयते" । "परनित्यान्तरङ्गापवादानां उत्तरोत्तरं बलीयः" ।<br><b>उल्लेखाः - </b>चन्द्रा०, परि०<br><br>

उत्तस्थिवस्
उत्तस्थिवस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎದ್ದಿರುವ<br><b>निष्पत्तिः - </b>उद् + ष्ठा (गतिनिवृत्तौ) - "क्वसुः" (३-२-१०७)<br><br>

उत्तान
उत्तान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲುಮುಖವಾದ<br><b>प्रयोगाः - </b>"उत्तानपाणिद्वयसन्निवेशात्"<br><b>उल्लेखाः - </b>कुमा० ३-४५<br><br>उत्तान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎತ್ತರವಾದ /ಉಬ್ಬಿರುವ<br><b>व्युत्पत्तिः - </b>उद्गतस्तानो विस्तारोऽस्मात्<br><b>प्रयोगाः - </b>"पत्रावलीप्रसाधनोत्तानवक्षःस्थल----"<br><b>उल्लेखाः - </b>मालती० ७<br><br>उत्तान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಳವಿಲ್ಲದ /ಸ್ವಲ್ಪನೀರುಳ್ಳ<br><br>उत्तान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲುಮುಖವಾಗಿ ಮಲಗಿರುವ /ಅಂಗಲಾಚಿ ಮಲಗಿರುವ<br><b>विस्तारः - </b>"उत्तानमगभीरे स्यादूर्ध्वास्यशयितेऽपि च" -मेदि० ।<br><br>

उत्तानपाद
उत्तानपाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಾಯಂಭುವ ಮನುವಿನ ಮಗ /ಒಬ್ಬ ದೊರೆ<br><br>उत्तानपाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>उत्तानः ऊर्ध्वस्थितः पादोऽस्य<br><br>

उत्तानपादज
उत्तानपादज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧ್ರುವಕುಮಾರ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>उत्तानपादाज्जातः<br><br>

उत्तानशय
उत्तानशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಶು /ಅಂಗಲಾಚಿ ಮಲಗುವ ಎಳೆಯ ಮಗು<br><b>निष्पत्तिः - </b>शीङ् (स्वप्ने) - "अच्" (वा० ३-२-१५)<br><b>व्युत्पत्तिः - </b>उत्तानः शेते<br><br>

उत्तानशायिन्
उत्तानशायिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಶು /ಅಂಗಲಾಚಿ ಮಲಗುವ ಎಳೆಯ ಮಗು<br><b>निष्पत्तिः - </b>"णिनिः" (३-२-७८)<br><br>

उत्तार
उत्तार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಾಟುವುದು /ಅಡ್ಡ ಹಾಯುವುದು<br><br>उत्तार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಂತಿ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>उद् + तॄ (प्ल्वनतरणयोः) - "घञ्" (३-३-१८०<br><br>उत्तार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಒಯ್ಯುವ<br><br>उत्तार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಡವನ್ನು ಮುಟ್ಟಿಸುವ /ತೀರಕ್ಕೆ ಒಯ್ಯುವ<br><br>

उत्तारक
उत्तारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಡವನ್ನು ಮುಟ್ಟಿಸುವ /ತೀರಕ್ಕೆ ಒಯ್ಯುವ<br><b>निष्पत्तिः - </b>उद् + तॄ (प्ल्वनतरणयोः) + णिच् - "अच्" (३-१-१३४)<br><b>प्रयोगाः - </b>"यत्रासौ संसारसागरोत्तारतरणिकर्णधारो भगवान् हरिः स्वयं प्रतिवसति"<br><b>उल्लेखाः - </b>प्रबोध० ५<br><br>उत्तारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಕ /ವಿಪತ್ತಿನಿಂದ ಪಾರುಮಾಡುವವನು<br><b>निष्पत्तिः - </b>उद् + तॄ (प्ल्वनतरणयोः) + णिच् - "ण्वुल्" (३-१-१३३)<br><br>

उत्तारण
उत्तारण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>उद् + तॄ (प्ल्वनतरणयोः) + णिच् - "ल्युः" (३-१-१३४)<br><b>प्रयोगाः - </b>"उत्तारणो दुष्कृतिहा पुण्यो दुःस्वप्ननाशनः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"सारसस्तं तारितवानित्युत्तारण ईरितः" - निरुक्तिः<br><br>उत्तारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಡವನ್ನು ಮುಟ್ಟಿಸುವುದು /ತೀರಕ್ಕೆ ಒಯ್ಯುವುದು<br><b>निष्पत्तिः - </b>उद् + तॄ (प्ल्वनतरणयोः) + णिच् - भावे "ल्युट्" (३-३-११५)<br><br>उत्तारण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಡವನ್ನು ಮುಟ್ಟಿಸುವ /ತೀರಕ್ಕೆ ಒಯ್ಯುವ<br><b>निष्पत्तिः - </b>कर्त० "अच्" (३-१-१३४)<br><br>

उत्तारयितृ
उत्तारयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾಟಿಸುವ<br><br>उत्तारयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಪಾಡುವ /ರಕ್ಷಿಸುವ<br><b>निष्पत्तिः - </b>उद् + तॄ (प्ल्वनतरणयोः) + णिच् - "तृच्" (३-१-१३३)<br><br>

उत्तारित
उत्तारित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾಟಿಸಲ್ಪಟ್ಟ /ದಡಕ್ಕೆ ಒಯ್ಯಲ್ಪಟ್ಟ<br><br>उत्तारित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಿಸಲ್ಪಟ್ಟ /ಕಾಪಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + तॄ (प्ल्वनतरणयोः) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"उत्तारितां शत्रुभयादुदीर्णात्"<br><b>उल्लेखाः - </b>याद० १३-२८<br><br>

उत्तार्य
उत्तार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾಟಲು ಅರ್ಹವಾದ<br><br>उत्तार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಂತಿ ಮಾಡಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उद् + तॄ (प्ल्वनतरणयोः) - "ण्यत्" (३-१-९७)<br><br>उत्तार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾಟಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उद् + तॄ (प्ल्वनतरणयोः) + णिच् - "ण्यत्" (३-१-९७)<br><br>उत्तार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾಟಿಸಿ<br><br>उत्तार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಂತಿ ಮಾಡಿಸಿ<br><b>निष्पत्तिः - </b>उद् + तॄ (प्ल्वनतरणयोः) + णिच् - "ल्यप्" (७-१-३७)<br><br>

उत्ताल
उत्ताल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೊಡ್ಡ ಶಬ್ದ ಮಾಡುವ ಗಾಳಿ<br><b>प्रयोगाः - </b>"उत्तालः किङ्किणीनामनवरतरणत्कारहेतुः पताकाम्"<br><b>उल्लेखाः - </b>मालती० ५-४<br><br>उत्ताल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೊಡ್ಡದಾದ /ಉನ್ನತವಾದ<br><b>प्रयोगाः - </b>"उत्तालतालीवनसम्प्रवृत्तसमीरसीमन्तितकेतकीकाः"<br><b>उल्लेखाः - </b>माघ० ३-८०<br><br>उत्ताल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯಂಕರವಾದ /ಪ್ರಚಂಡವಾದ<br><b>प्रयोगाः - </b>"उत्तालाः कटपूतनाप्रभृतयः सांराविणं कुर्वते"<br><b>उल्लेखाः - </b>मालती० ५-११<br><br>उत्ताल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಫುಟವಾದ /ಸ್ಪಷ್ಟವಾಗಿ ತೋರುವ<br><b>प्रयोगाः - </b>"तूर्यारावैराहितोत्तालतालैर्गायन्तीभिः काहलं काहलाभिः"<br><b>उल्लेखाः - </b>माघ० १८-५४<br><br>

उत्तितीर्षा
उत्तितीर्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಾಟಲು ಇಚ್ಛೆ/ದಡ ಮುಟ್ಟಲು ಆಸೆ<br><b>निष्पत्तिः - </b>उद् + तॄ (प्ल्वनतरणयोः) + सन् - "अः" (३-३-१०२)<br><b>व्युत्पत्तिः - </b>उत्तरितुमिच्छा<br><br>उत्तितीर्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೇರ್ಗಡೆ ಹೊಂದಲು ಆಸೆ /ವಿದ್ಯಾಭ್ಯಾಸದಲ್ಲಿ ಮುಂದಿನ ಹಂತವನ್ನು ಏರಲು ಆಸೆ<br><br>

उत्तितीर्षु
उत्तितीर्षु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಡವನ್ನು ಮುಟ್ಟಲು ಆಸೆಯುಳ್ಳ /ದಾಟಲು ಇಚ್ಛೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>उद् + तॄ (प्ल्वनतरणयोः) + सन् - "उः" (३-२-१६८)<br><br>उत्तितीर्षु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರೀಕ್ಷೆಯಲ್ಲಿ ತೇರ್ಗಡೆ ಹೊಂದಲು ಆಸೆಯುಳ್ಳ /ವಿದ್ಯಾಭ್ಯಾಸದಲ್ಲಿ ಮುಂದಿನ ಹಂತವನ್ನು ಮುಟ್ಟಲು ಇಚ್ಛೆಯುಳ್ಳ<br><br>

उत्तिष्ठत्
उत्तिष्ठत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏಳುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + ष्ठा (गतिनिवृत्तौ) - "शतृ" (३-२-१२४)<br><br>

उत्तिष्ठन्ती
उत्तिष्ठन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏಳುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

उत्तिष्ठमान
उत्तिष्ठमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + ष्ठा (गतिनिवृत्तौ) - अनूर्ध्वकर्मणि "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"उत्तिष्ठमानस्तु परो नोपेक्ष्यः पथ्यमिच्छता"<br><b>उल्लेखाः - </b>माघ० २-१०<br><br>

उत्तिष्ठासा
उत्तिष्ठासा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏಳುವ ಆಸೆ<br><b>निष्पत्तिः - </b>उद् + ष्ठा (गतिनिवृत्तौ) + सन् - "अः"(३-३-१०२)<br><b>व्युत्पत्तिः - </b>उत्थातुमिच्छा<br><br>

उत्तिष्ठासु
उत्तिष्ठासु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏಳಲು ಅಪೇಕ್ಷಿಸುವ<br><br>

उत्तिर्ण
उत्तिर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನದಿಯನ್ನು ದಾಟಿದ /ದಡವನ್ನು ಮುಟ್ಟಿದ<br><br>उत्तिर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಷ್ಟದಿಂದ ಪಾರಾದ<br><br>उत्तिर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿದ್ಯಾಭ್ಯಾಸದಲ್ಲಿ ಮೇಲಿನ ಹಂತವನ್ನು ಮುಟ್ಟಿದ /ಪರೀಕ್ಷೆಯಲ್ಲಿ ತೇರ್ಗಡೆ ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>उद् + तॄ (प्ल्वनतरणयोः) -कर्त० "क्तः"(३-४-७२)<br><br>उत्तिर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾಟಲ್ಪಟ್ಟ<br><br>

उत्तिर्ण
उत्तिर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಷ್ಟದಿಂದ ಬಿಡಲ್ಪಟ್ಟ<br><br>उत्तिर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಳೆಯಲ್ಪಟ್ಟ /ಕೆಳಗಿಳಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + तॄ (प्ल्वनतरणयोः) - कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"उत्तीर्णभारलघुनाप्यलघूलषौधसौहित्यनिःसहतरेण तरोरधस्तात्"<br><b>उल्लेखाः - </b>माघ० ५-६२<br><br>

उत्तुङ्ग
उत्तुङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉನ್ನತವಾದ /ಎತ್ತರವಾದ<br><b>व्युत्पत्तिः - </b>उत्कृष्टः तुङ्गः<br><b>प्रयोगाः - </b>"अध्यासामासुरुत्तुङ्गहेमपीठानि यान्यमी" । "उत्तुङ्गस्तनभरभङ्गभीरुमध्याम्" ।<br><b>उल्लेखाः - </b>माघ० २-५, माघ० ४-३८<br><br>

उत्तुङ्गता
उत्तुङ्गता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತರ /ಔನ್ನತ್ಯ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>उत्तुङ्गस्य भावः<br><b>प्रयोगाः - </b>"यच्छालमुत्तुङ्गतया विजेतुं दूरादुदस्थीयत सागरस्य"<br><b>उल्लेखाः - </b>माघ० ३-४०<br><br>

उत्तुष
उत्तुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುರಿ /ಹುರಿದ ಧಾನ್ಯ<br><b>व्युत्पत्तिः - </b>उद्गतस्तुषोऽस्मात्<br><br>

उत्तेजक
उत्तेजक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ರೇಕಗೊಳಿಸುವ<br><br>उत्तेजक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುರಿದುಂಬಿಸುವ /ಪ್ರೋತ್ಸಾಹಿಸುವ<br><br>उत्तेजक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಣೆ ಕೊಡುವ /ಹರಿತ ಮಾಡುವ<br><br>उत्तेजक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೆರಗುಕೊಡುವ<br><b>निष्पत्तिः - </b>उद् + तिज (निशाने) - "ण्वुल्" (३-१-१३३)<br><br>

उत्तेजन
उत्तेजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ರೇಕಗೊಳಿಸುವುದು<br><br>उत्तेजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೀಕ್ಷ್ಣಮಾಡುವುದು /ಸಾಣೆ ಕೊಡುವುದು<br><br>उत्तेजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹುರಿದುಂಬಿಸುವುದು<br><b>निष्पत्तिः - </b>उद् + तिज (निशाने) + णिच् - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"चन्द्रगुप्तः समुत्तेजनसमर्थैः श्लोकैरुपश्लोकयितव्यः"<br><b>उल्लेखाः - </b>मुद्रा० ४<br><br>

उत्तेजना
उत्तेजना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಪ್ಪಕೊಡುವುದು /ಮೆರುಗು ಹಾಕುವುದು<br><b>निष्पत्तिः - </b>उद् + तिज (निशाने) + णिच् - "युच्" (३-३-१०७)<br><b>प्रयोगाः - </b>"तमङ्गदे मन्दरकूटकोटिव्याघट्टनोत्तेजनया मणीनाम्"<br><b>उल्लेखाः - </b>माघ० ३-६<br><br>

उत्तेजित
उत्तेजित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುರಿದುಂಬಿಸಲ್ಪಟ್ಟ<br><br>उत्तेजित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೀಕ್ಷ್ಣಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>उत्तेजित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ರೇಕಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>उत्तेजित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೆರುಗುಕೊಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + तिज (निशाने) - "क्तः" (३-२-१०२)<br><br>उत्तेजित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕಗೊಳಿಸಲ್ಪಟ್ಟ /ಹೆಚ್ಚಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"उत्तेजितजयोत्साहमायुधैरनघोद्यमैः"<br><b>उल्लेखाः - </b>याद० १-७०<br><br>

उत्तोरण
उत्तोरण<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತರವಾದ ತೋರಣ<br><b>व्युत्पत्तिः - </b>उन्नतं तोरणम्<br><br>उत्तोरण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎತ್ತರವಾದ ಹೊರಬಾಗಿಲುಳ್ಳ<br><br>उत्तोरण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎತ್ತರವಾದ ತೋರಣವುಳ್ಳ /ಉನ್ನತವಾದ ತೋರಣಗಳಿಂದ ಅಲಂಕೃತವಾದ<br><b>व्युत्पत्तिः - </b>उन्नतं तोरणं यत्र<br><b>प्रयोगाः - </b>"तावत्पताकाकुलमुन्दुमौलिरुत्तोरणं राजपथं प्रपेदे"<br><b>उल्लेखाः - </b>कुमा० ७-६३<br><br>

उत्तोलन
उत्तोलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತುವುದು /ತಕ್ಕಡಿಯಿಂದ ಮೇಲಕ್ಕೆ ಎತ್ತಿ ತೂಗುವುದು<br><b>निष्पत्तिः - </b>उद् + तुल (उन्माने) - भावे "ल्युट्" (३-३-११५)<br><br>

उत्तोलित
उत्तोलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + तुल (उन्माने) - "क्तः" (३-२-१०२)<br><br>

उत्थ
उत्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎದ್ದಿರುವ<br><b>निष्पत्तिः - </b>उद् + ष्ठा (गतिनिवृत्तौ) - "कः" (३-१-१३६)<br><br>उत्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಂಟಾದ /ಉತ್ಪನ್ನವಾದ<br><b>प्रयोगाः - </b>"भवत्सम्भावनोत्थाय परितोषाय मूर्च्छते" । "वनं बबाधे विषषावकोत्था विपन्नगानामविपन्नगानाम्"<br><b>उल्लेखाः - </b>माघ० ४-१५<br><br>

उत्थान
उत्थान<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏಳುವುದು<br><b>निष्पत्तिः - </b>उद् + ष्ठा (गतिनिवृत्तौ) - "ल्युट्" (३-३-११५)<br><br>उत्थान<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದಯ /ಹುಟ್ಟಿ ಮೇಲಕ್ಕೆ ಬರುವುದು /ಅಭಿವೃದ್ಧಿ ಹೊಂದುವುದು<br><b>प्रयोगाः - </b>"निदर्शयामास विशेषदृश्यमिन्दुं नवोत्थानमिवेन्दुमत्यै"<br><b>उल्लेखाः - </b>रघु० ६-३१<br><br>उत्थान<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನ /ಉದ್ಯಮ<br><b>प्रयोगाः - </b>"मेदच्छेदकृशोदरं लघु भवत्युत्थानयोग्यं वपुः"<br><b>उल्लेखाः - </b>शाकु० २-५<br><br>उत्थान<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುನರುಜ್ಜೀವನ /ಪುನಃ ಚೇತರಿಸಿಕೊಳ್ಳುವಿಕೆ<br><br>उत्थान<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಲವಿಸರ್ಜನೆ /ವಿರೇಚನ<br><br>उत्थान<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಸ್ತಕ<br><br>उत्थान<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ /ಕದನ<br><br>उत्थान<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗಳ<br><br>उत्थान<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹರ್ಷ /ಸಂತೋಷ<br><br>उत्थान<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೌರುಷ /ಶೌರ್ಯ<br><br>उत्थान<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಂತ್ರ /ಸ್ವರಾಷ್ಟ್ರ ಚಿಂತೆ<br><br>उत्थान<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಚ್ಚರಗೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>उद् + ष्ठा (गतिनिवृत्तौ) - कर० "ल्युट्" (३-३-११७)<br><b>विस्तारः - </b>"उत्थानमुद्यमे तन्त्रे पौरुषे पुस्तके रणे । प्राङ्गणोद्यमहर्षेषु मलवेगेऽपि च द्वयोः" -मेदि० ।<br><br>

उत्थानैकादशी
उत्थानैकादशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ತಿಕ ಶುಕ್ಲಪಕ್ಷದ ಏಕಾದಶಿ<br><br>

उत्थापन
उत्थापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಬ್ಬಿಸುವುದು<br><br>उत्थापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿದ್ದೆಯಿಂದ ಎಬ್ಬಿಸುವುದು /ಎಚ್ಚರಗೊಳಿಸುವುದು<br><br>उत्थापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಂತಿ ಮಾಡಿಸುವಿಕೆ<br><br>उत्थापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕದಲಿಸುವುದು /ಅಲುಗಾಡಿಸುವುದು<br><br>उत्थापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಬ್ಬಿಸುವುದು /ಉದ್ರೇಕಗೊಳಿಸುವುದು<br><br>उत्थापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೇರಿಸುವುದು<br><b>निष्पत्तिः - </b>उद् + ष्ठा (गतिनिवृत्तौ) + णिच् - "ल्युट्" (३-३-११५)<br><br>

उत्थापयत्
उत्थापयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಬ್ಬಿಸುತ್ತಿರುವ<br><br>उत्थापयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ರೇಕಗೊಳಿಸುತ್ತಿರುವ<br><br>उत्थापयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕದಲಿಸುತ್ತಿರುವ<br><br>उत्थापयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿದ್ದೆಯಿಂದ ಎಚ್ಚರಗೊಳಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + ष्ठा (गतिनिवृत्तौ) + णिच् -"शतृ" (३-२-१२४)<br><br>

उत्थापयितृ
उत्थापयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಬ್ಬಿಸುವ<br><br>उत्थापयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ರೇಕಗೊಳಿಸುವ<br><br>उत्थापयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕದಲಿಸುವ<br><br>उत्थापयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೇರಿಸುವ /ಹುರಿದುಂಬಿಸುವ<br><b>निष्पत्तिः - </b>उद् + ष्ठा (गतिनिवृत्तौ) + णिच् - "तृच्" (३-१-१३३)<br><br>

उत्थापयित्री
उत्थापयित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उत्थापयितृ ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उत्थापित
उत्थापित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಬ್ಬಿಸಲ್ಪಟ್ಟ<br><br>उत्थापित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಚ್ಚರಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>उत्थापित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಂತಿ ಮಾಡಿಸಲ್ಪಟ್ಟ<br><br>उत्थापित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕದಲಿಸಲ್ಪಟ್ಟ /ಅಲುಗಾಡಿಸಲ್ಪಟ್ಟ<br><br>उत्थापित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೇರಿಸಲ್ಪಟ್ಟ /ಉದ್ರೇಕಗೊಳಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + ष्ठा (गतिनिवृत्तौ) + णिच् -"क्तः" (३-२-१०२)<br><br>

उत्थाप्य
उत्थाप्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಬ್ಬಿಸಲ್ಪಡುವ<br><br>उत्थाप्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उद् + ष्ठा (गतिनिवृत्तौ) + णिच् -"यत्" (३-१-९७)<br><br>उत्थाप्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎಬ್ಬಿಸಿ /ಮೇಲಕ್ಕೆ ಎತ್ತಿ ನಿಲ್ಲಿಸಿ<br><b>निष्पत्तिः - </b>उद् + ष्ठा (गतिनिवृत्तौ) + णिच् - "ल्पप्" (७-१-३७)<br><br>

उत्थित
उत्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದಿದ /ಬೆಳವಣಿಗೆ ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>उद् + ष्ठा (गतिनिवृत्तौ) + णिच् -"क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"अन्येभ्यो वनदेवताकरतलैरापर्वभागोत्थितैः"<br><b>उल्लेखाः - </b>शाकु० ४-४<br><br>उत्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಸನದಿಂದ ಮೇಲಕ್ಕೆ ಎದ್ದಿರುವ<br><b>प्रयोगाः - </b>"वचो निशम्योत्थितमुत्थितः सन्" । "न यावदेतावुदपश्यदुत्थितौ"<br><b>उल्लेखाः - </b>रघु० २-६१, माघ० १-१५<br><br>उत्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೂಮಿಯಿಂದ ಮೇಲಕ್ಕೆ ಎದ್ದ<br><b>प्रयोगाः - </b>"पांशुर्दिशां मुखमतुत्थयदुत्थितोऽद्रेः"<br><b>उल्लेखाः - </b>माघ० ५-११<br><br>उत्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಟ್ಟಿದ /ಉತ್ಪನ್ನವಾದ<br><b>प्रयोगाः - </b>"वचो निशम्योत्थितमुत्थितः सन्"<br><b>उल्लेखाः - </b>रघु० २-६१<br><br>उत्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನಶಾಲಿ /ಉದ್ಯೋಗಶೀಲ /ವ್ಯವಸಾಯ ಸ್ವಭಾವದವನು<br><b>प्रयोगाः - </b>"प्रणमन्त्यनपायमुत्थितं प्रतिपच्चन्द्रमिव प्रजा नृपम्"<br><b>उल्लेखाः - </b>किरा० २-११<br><br>

उत्थिति
उत्थिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ /ಬೆಳವಣಿಗೆ<br><br>उत्थिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏಳುವುದು<br><b>निष्पत्तिः - </b>उद् + ष्ठा (गतिनिवृत्तौ) + णिच् - "क्तिन्" (३-३-९४)<br><br>

उत्पतिष्णु
उत्पतिष्णु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಿ ಬೇಯಿಸುವ ಸ್ವಭಾವದ<br><br>उत्पतिष्णु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲುಭಾಗದಲ್ಲಿ ಹಣ್ಣಾಗುವ ಸ್ವಭಾವದ /ತುದಿಯಲ್ಲಿ ಕಾಳು ಮೊದಲಾದುವು ಬಲಿಯುವ ಸ್ವಭಾವದ ಬತ್ತ ರಾಗಿ ಜೋಳ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>उत् + डुपचष् (पाके) - "इष्णुच्" (३-२-१३६)<br><br>उत्पतिष्णु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರುವ ಸ್ವಭಾವದ /ಮೇಲಕ್ಕೆ ನೆಗೆಯುವ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>उत् + पत्लृ (गतौ) - "इष्णुच्" (३-२-१३६)<br><b>प्रयोगाः - </b>"ससञ्जुरश्वक्षुण्णानामेलानामुत्पतिष्णवः"<br><b>उल्लेखाः - </b>रघु० ४-४७<br><br>

उत्पत
उत्पत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಕ್ಷಿ /ಹಕ್ಕಿ<br><br>उत्पत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರುವ<br><b>निष्पत्तिः - </b>उत् + पत्लृ (गतौ) - "अच्" (३-१-१३४)<br><b>विस्तारः - </b>"स्युः खगोत्पतवारङ्ककण्ठग्निर्व्योमचारिणः" - त्रिकाण्ड० ।<br><br>

उत्पतत्
उत्पतत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರಿತ್ತಿರುವ /ಮೇಲಕ್ಕೆ ಹೋಗುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उत् + पत्लृ (गतौ) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"उत्पतन्तमवनम्य माधवम्" । "कुर्वन्ति द्यामुत्पतन्तः स्मरार्तस्वर्लोकस्त्रीगात्रनिर्वाणमत्र" ।<br><b>उल्लेखाः - </b>याद० १७-३, माघ० ४-२३<br><br>

उत्पतन्ती
उत्पतन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರಿತ್ತಿರುವ /ಮೇಲಕ್ಕೆ ಹೋಗುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

उत्पतन
उत्पतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರುವಿಕೆ<br><br>उत्पतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹೋಗುವಿಕೆ /ಮೇಲಕ್ಕೆ ಹತ್ತುವಿಕೆ<br><br>उत्पतन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿ /ಹುಟ್ಟಿವಿಕೆ<br><b>निष्पत्तिः - </b>उत् + पत्लृ (गतौ) - "ल्युट्" (३-३-११५)<br><b>विस्तारः - </b>"स्यादुत्पतनमुत्पत्तौ तथोऽर्ध्वगमनेऽपि च" - मेदि० ।<br><br>

उत्पतित
उत्पतित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರಿದ<br><br>उत्पतित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹೋದ<br><b>निष्पत्तिः - </b>उत् + पत्लृ (गतौ) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"तस्मिन्नुत्पतिते पुरः सुरमुनाविन्दोः श्रियं बिभ्रति"<br><b>उल्लेखाः - </b>माघ० १-७५<br><br>

उत्पतितृ
उत्पतितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರುವ ಸ್ವಭಾವದ<br><br>उत्पतितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹೋಗುವ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>उत् + पत्लृ (गतौ) - "तृन्" (३-२-१३५)<br><b>व्युत्पत्तिः - </b>उत्पतति<br><br>

उत्पतित्री
उत्पतित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उत्पतितृ ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उत्पत्ति
उत्पत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹುಟ್ಟುವಿಕೆ /ಜನ್ಮ<br><b>निष्पत्तिः - </b>उत् + पत्लृ (गतौ) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"उत्पत्तिरेव विप्रस्य मूर्तिर्धर्मस्य शाश्वती"<br><b>उल्लेखाः - </b>मनु० १-९८<br><br>उत्पत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಯಾರಿಕೆ /ವಸ್ತು ನಿರ್ಮಾಣ /ಸೃಷ್ಟಿ<br><br>उत्पत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಭ /ಹುಟ್ಟುವಳಿ<br><br>उत्पत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಳೆ /ಫಸಲು<br><br>उत्पत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಲ /ಕಾರಣ<br><b>निष्पत्तिः - </b>उत् + पत्लृ (गतौ) - अपा०"क्तिन्" (३-३-९४)<br><b>व्युत्पत्तिः - </b>उत्पद्यतेऽस्मात्<br><br>

उत्पत्तिक्रम
उत्पत्तिक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಗತ್ತಿನ ಸೃಷ್ಟಿ ಕ್ರಮ<br><br>उत्पत्तिक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಣಿಗಳ ಉತ್ಪತ್ತಿ ಕ್ರಮ<br><br>

उत्पत्तिमत्
उत्पत्तिमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜನ್ಮವುಳ್ಳ /ಹುಟ್ಟುವ ಸ್ವಭಾವದ /ಸೃಷ್ಟಿಗೆ ಒಳಪಟ್ಟಿರುವ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>उत्पत्तिरस्यास्ति<br><b>प्रयोगाः - </b>"विपदुत्पत्तिमतामुपस्थिता"<br><b>उल्लेखाः - </b>रघु० ८-८३<br><br>

उत्पत्य
उत्पत्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರಿ /ಮೇಲಕ್ಕೆ ನೆಗೆದು<br><b>निष्पत्तिः - </b>उत् + पत्लृ (गतौ) - "ल्पप्"(७-१-३७)<br><br>

उत्पथ
उत्पथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಪ್ಪು ದಾರಿ /ನ್ಯಾಯವಲ್ಲದ ಮಾರ್ಗ<br><b>व्युत्पत्तिः - </b>उत्क्रान्तः पन्थानम्<br><b>प्रयोगाः - </b>गुरोरल्पवलिप्तस्य कार्याकर्यमजानतः । उत्पथं प्रतिपन्नस्य कार्यं भवति शासनम् ॥" "क्षिप्तावरोधाङ्गनमुत्पथेन गाम्" ।<br><b>उल्लेखाः - </b>भा०, माघ० १२-२४<br><br>

उत्पन्न
उत्पन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಟ್ಟಿದ /ಉತ್ಪತ್ತಿ ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>उत्+ पत्लृ (गतौ) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"स हि धर्मार्थमुत्पन्नो बह्मभूयाय कल्पते"<br><b>उल्लेखाः - </b>मनु० १-९८<br><br>उत्पन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹೋಗಿರುವ /ಮೇಲಕ್ಕೆ ಹಾರಿರುವ<br><br>

उत्पन्नविनाशिन्
उत्पन्नविनाशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಟ್ಟಿದ ಕೂಡಲೆ ನಾಶ ಹೊಂದಿದ<br><b>व्युत्पत्तिः - </b>उत्पन्नः सन् विनश्यति<br><br>

उत्पल
उत्पल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀಲಕಮಲ /ಕನ್ನೈದಿಲೆ<br><b>निष्पत्तिः - </b>उत् + पत्लृ (गतौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उत्पलति<br><b>प्रयोगाः - </b>"आददे मृदुविलोलपलाशैरुत्पलैश्चषकवीचिषु कम्पः"<br><b>उल्लेखाः - </b>किरा० ९-५६<br><br>उत्पल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂಗಲು ಕೋಷ್ಠದ ಮರ<br><br>उत्पल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಂಸಖಂಡವಿಲ್ಲದ /ಪುಷ್ಟಿಯೀಲದ /ಕೃಶವಾಗಿರುವ<br><b>व्युत्पत्तिः - </b>उत्क्रान्तः पलं मांसम्<br><b>विस्तारः - </b>"उत्पलं कुष्ठभूरुहे । इन्दीवरे मांसशून्ये" - हेम० ।<br><br>

उत्पलपत्र
उत्पलपत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೈದಿಲೆಯ ದಳ<br><br>उत्पलपत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಖಕ್ಷತ್ರ /ಸ್ತ್ರೀಯರ ಸ್ತನಗಳ ಮೇಲಿನ ಉಗುರಿನ ಗಾಯ<br><b>विस्तारः - </b>"उत्पलपत्रमुत्पलदले स्त्रीणां नखक्षते" - हेम० ।<br><br>

उत्पलशारिवा
उत्पलशारिवा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೊಗದೆ ಗಿಡ<br><b>व्युत्पत्तिः - </b>उत्पला च सा शारिवा च<br><br>

उत्पलिनी
उत्पलिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪಲ ಲತೆ /ಕನ್ನೈದಿಲೆ ಗಿಡ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>उत्पलमस्यास्ति<br><br>उत्पलिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ನೈದಿಲೆಗಳಿಂದ ಕೂಡಿದ ದೇಶ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-१३५)<br><b>व्युत्पत्तिः - </b>उत्पलान्यत्रसन्ति<br><b>प्रयोगाः - </b>"पुण्याय मन्ये मृतमुत्पलिन्या"<br><b>उल्लेखाः - </b>नैष० ७-३५<br><br>

उत्पाटक
उत्पाटक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬುಡಸಹಿತ ಕಿತ್ತು ಹಾಕುವ /ನಿರ್ಮೂಲ ಮಾಡುವ<br><b>निष्पत्तिः - </b>उत् + पट (भाषार्थे) + णिच् - "ण्वुल्" (३-१-१३३)<br><br>

उत्पाटन
उत्पाटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿತ್ತು ಹಾಕುವಿಕೆ /ಬುಡಸಹಿತ ತೆಗೆದು ಹಾಕುವಿಕೆ<br><b>निष्पत्तिः - </b>उत् + पट (भाषार्थे) + णिच् - "ल्युट्" (३-३-११५)<br><br>

उत्पाटित
उत्पाटित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿತ್ತು ಹಾಕಲ್ಪಟ್ಟ /ಬುಡಸಹಿತ ತೆಗೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उत् + पट (भाषार्थे) + णिच् - "क्तः" (३-२-१०२)<br><br>

उत्पात
उत्पात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರುವುದು<br><b>निष्पत्तिः - </b>उत् +पत्लृ (गतौ) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"एकोत्पातेन ते लङ्कामेष्यन्ति हरियूधपाः"<br><b>उल्लेखाः - </b>रामा०<br><br>उत्पात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶುಭಾಶುಭಸೂಚಕವಾದ ಚಿಹ್ನೆ<br><b>प्रयोगाः - </b>"उत्पात इव भूतामुद्बभूव भयानकः"<br><b>उल्लेखाः - </b>याद० १६-२७<br><br>उत्पात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಘಟನೆ /ಸಾರ್ವಜನಿಕ ವಿಪತ್ತು /ಅನಾಹುತ<br><br>

उत्पातक
उत्पातक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರುವ /ಮೇಲಕ್ಕೆ ನೆಗೆಯುವ<br><b>निष्पत्तिः - </b>उत् +पत्लृ (गतौ) -"ण्वुल्" (३-१-१३३)<br><br>उत्पातक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಪಾತವನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>उत् +पत्लृ (गतौ) +णिच् -"ण्वुल्" (३-१-१३३)<br><br>

उत्पातिन्
उत्पातिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಾರುವ ಸ್ವಭಾವದ /ಮೇಲಕ್ಕೆ ನೆಗೆಯುವ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>उत् +पत्लृ (गतौ) - "णिनिः" (३-२-७८)<br><b>प्रयोगाः - </b>"ससम्भ्रमोत्पातिपतत्कुलाकुलं सरः प्रपद्योत्कतयाऽनुकम्प्रताम्"<br><b>उल्लेखाः - </b>नैष० १-१२६<br><br>

उत्पाद
उत्पाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿ /ಹುಟ್ಟಿವಿಕೆ<br><b>निष्पत्तिः - </b>उत् + पद (गतौ)- भावे "घ्ञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"दुःखे च शोणितोत्पादे शाखाङ्गच्छेदने तथा"<br><b>उल्लेखाः - </b>याज्ञ० २-२२५<br><br>उत्पाद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಿನ ಕಾಲುಗಳುಳ್ಳ<br><b>व्युत्पत्तिः - </b>उद्गतः पादो यस्य<br><br>

उत्पादक
उत्पादक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಂದೆ /ಜನಕ /ಅಪ್ಪ<br><b>निष्पत्तिः - </b>उत् + पद (गतौ)+ णिच् - "ण्वुल्" (३-१-१३३)<br><b>प्रयोगाः - </b>"उत्पादकब्रह्मदात्रोर्गरीयान् ब्रह्मदः पिता"<br><b>उल्लेखाः - </b>मनु० २-१४६<br><br>उत्पादक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶರಭಮೃಗ /೮ ಕಾಲುಗಳುಳ್ಳ ಒಂದು ಜಾತಿಯ ಮೃಗ<br><b>व्युत्पत्तिः - </b>उत् ऊर्ध्वस्थिताः पादा यस्य<br><br>उत्पादक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿ ಮಾಡುವ /ತಯಾರಿಸುವ<br><br>

उत्पादिका
उत्पादिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಯಿ /ಜನನಿ<br><br>उत्पादिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಯಾರಿಸುವ ಹೆಂಗಸು<br><br>उत्पादिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೆದ್ದಲು ಹುಳ<br><br>

उत्पादन
उत्पादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಯಾರಿಸುವಿಕೆ /ಸೃಷ್ಟಿಸುವಿಕೆ /ನಿರ್ಮಾಣ<br><b>निष्पत्तिः - </b>उत् + पद (गतौ)+ णिच् - "ल्युट्" (३-३-११५)<br><br>

उत्पादशय
उत्पादशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಶು /ಮಗು /ಕೂಸು<br><b>निष्पत्तिः - </b>शीङ् (स्वप्ने) - "अच्" (वा० ३-२-१५)<br><b>व्युत्पत्तिः - </b>उत्पासः सन् शेते<br><br>

उत्पादशयन
उत्पादशयन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಶು /ಮಗು /ಕೂಸು<br><br>

उत्पादित
उत्पादित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಂಟುಮಾಡಲ್ಪಟ್ಟ /ಸೃಷ್ಟಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उत् + पद (गतौ)+ णिच् - "क्तः" (३-२-१०२)<br><br>उत्पादित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಪಾದಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अप्यनारभमाणस्य विभोरुत्पादिताः परैः"<br><b>उल्लेखाः - </b>माघ० २-९१<br><br>

उत्पादिन्
उत्पादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿಯುಳ್ಳ /ಸೃಷ್ಟಿಗೊಳಪಟ್ಟ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>उत्पादोऽस्यास्ति<br><b>प्रयोगाः - </b>"सर्वमुत्पादि भङ्गुरम्"<br><b>उल्लेखाः - </b>हितो०<br><br>उत्पादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರ್ಮಿಸುವ /ತಯಾರಿಸುವ<br><b>निष्पत्तिः - </b>उत् + पद (गतौ)+ णिच् - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उत्पादयति<br><br>

उत्पाद्य
उत्पाद्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರೂಪಕದ ಇತಿವೃತ್ತಗಳಲ್ಲೊಂದು ಭೇದ<br><br>उत्पाद्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮಸಂಜ್ಞೆಯ ಒಂದು ಭೇದ<br><br>उत्पाद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೃಷ್ಟಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उत्+ पद (गतौ)+ णिच् -"यत्" (३-१-९७)<br><b>प्रयोगाः - </b>"शेषाङ्गनिर्माणविधौ विधातुर्लावण्य उत्पाद्य इवास यत्नः"<br><b>उल्लेखाः - </b>कुमा० १-३५<br><br>उत्पाद्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸೃಷ್ಟಿಸಿ /ನಿರ್ಮಿಸಿ /ತಯಾರಿಸಿ<br><b>निष्पत्तिः - </b>उत् + पद (गतौ)+ णिच् -"ल्पप्" (७-१-३७)<br><br>

उत्पाद्यमान
उत्पाद्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೃಷ್ಟಿಸಲ್ಪಡುತ್ತಿರುವ /ತಯಾರಿಸಲ್ಪಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उत् + पद (गतौ)+ णिच् - "शानच्" (३-२-१२४)<br><br>

उत्पित्सा
उत्पित्सा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರಲು ಆಸೆ /ಮೇಲಕ್ಕೆ ನೆಗೆಯುವ ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>उत्+ पद (गतौ) + सन् - "अः" (३-३-१०२)<br><b>व्युत्पत्तिः - </b>उत्पतितुमिच्छा<br><br>

उत्पित्सित
उत्पित्सित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರಲು ಅಪೇಕ್ಷೆಯುಂಟಾಗಿರುವ /ಮೇಲಕ್ಕೆ ನೆಗೆಯುವ ಆಸೆ ಹುಟ್ಟಿರುವ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>उत्पिस्ताऽस्य सञ्जाता<br><br>

उत्पित्सु
उत्पित्सु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರಲು ಅಪೇಕ್ಷಿಸುವ /ಮೇಲಕ್ಕೆ ನೆಗೆಯಲು ಆಸೆ ಪಡುವ<br><b>निष्पत्तिः - </b>उत् + पत्लृ (गतौ) + सन् - "उः" (३-२-१६८)<br><b>प्रयोगाः - </b>"उत्पित्सवोऽन्तर्नदभर्तुरुच्चैः"<br><b>उल्लेखाः - </b>माघ० ३-७७<br><br>

उत्प्रेक्षण
उत्प्रेक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಊಹೆ /ತರ್ಕ /ಕಲ್ಪನೆ<br><br>उत्प्रेक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧರ್ಮಸಾಮ್ಯದಿಂದ ಒಂದು ವಸ್ತುವನ್ನು ಮತ್ತೊಂದರಂತೆ ಊಹಿಸುವುದು /ಸಂಭಾವನೆ<br><br>उत्प्रेक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲುನೋಟ /ಮೇಲುಗಡೆ ನೋಡುವುದು<br><b>निष्पत्तिः - </b>उत् + प्र + ईक्ष (दर्शने) - "ल्युट्" (३-३-११५)<br><br>

उत्प्रेक्षा
उत्प्रेक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಭಾವನೆ /ಉಪಮಾನದ ಧರ್ಮಸಂಬಂಧದಿಂದ ಉಪಮೇಯ ವಸ್ತುವನ್ನು ಉಪಮಾನವಸ್ತುವನ್ನಾಗಿ ಊಹಿಸುವುದು<br><b>निष्पत्तिः - </b>उत् + प्र + ईक्ष (दर्शने) - "अः" (३-३-१०३)<br><b>प्रयोगाः - </b>"सम्भावना स्यादुत्प्रेक्षा वस्तुहेतुफलात्मना" । "सखीजनं प्रेमगुरूकृतादरं निरीक्षमाणा इव नम्रमूर्तयः" ।<br><b>उल्लेखाः - </b>चन्द्रा०, किरा० ८-११<br><br>

उत्प्लव
उत्प्लव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರುವಿಕೆ /ಮೇಲಕ್ಕೆ ನೆಗೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>उत् + प्लुङ् (गतौ) - "अप्" (३-३-५७)<br><b>प्रयोगाः - </b>"तदात्तमात्मानमवेत्य सम्भ्रामात्पुनःपुनः प्रायसदुत्प्लवाय सः"<br><b>उल्लेखाः - </b>नैष० १-१२५<br><br>

उत्प्लवन
उत्प्लवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರುವಿಕೆ /ಮೇಲಕ್ಕೆ ನೆಗೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>उत् + प्लुङ् (गतौ) - "ल्युट्" (३-३-११५)<br><br>

उत्प्लवा
उत्प्लवा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಡಗು<br><br>उत्प्लवा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೋಣಿ<br><br>उत्प्लवा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೆಪ್ಪ /ಹರಿಗೋಲು<br><b>निष्पत्तिः - </b>उत् + प्लुङ् (गतौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उत्प्लवते<br><br>

उत्फुल्ल
उत्फुल्ल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಳಿದ /ವಿಕಾಸ ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>उत् + फुल्ल (विकसने) - "अच्" (३-१-१३४)<br><b>प्रयोगाः - </b>"उत्फुल्लस्थलनलिनीवनादमुष्यादुद्भूतः सरसिजसम्भवः परागः"<br><b>उल्लेखाः - </b>किरा० ५-३९<br><br>उत्फुल्ल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗಲವಾದ /ವಿಸ್ತಾರವಾದ<br><br>

उत्स
उत्स<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಊಟೆ /ಬುಗ್ಗೆ /ನೀರು ಜಿನುಗುವ ಜಾಗ<br><b>निष्पत्तिः - </b>उन्दी (क्लेदने) - "सः" नलोपश्च (उ० ३-६८)<br><b>व्युत्पत्तिः - </b>उनत्ति जलेन<br><br>उत्स<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನ ಪ್ರವಾಹ<br><br>

उत्सङ्ग
उत्सङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೊಡೆ<br><b>निष्पत्तिः - </b>उत् + षञ्ज (सङ्गे) - "घञ्" (३-३-१२१)<br><b>प्रयोगाः - </b>"सम्पूर्णलब्धललनालपनोपमानमुत्सङ्गसङ्गिहरिणस्य मृगाङ्कमूर्तेः"<br><b>उल्लेखाः - </b>माघ० ४-२२<br><br>उत्सङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಧ್ಯಭಾಗ<br><b>प्रयोगाः - </b>"दरीगृहोत्सङ्गनिषक्तभासः"<br><b>उल्लेखाः - </b>कुमा० १-१०<br><br>उत्सङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಖರ /ತುದಿ<br><b>प्रयोगाः - </b>"उत्सङ्गे समविषमे समं महाद्रेः क्रान्तानां वियदभिपातलाघवेन"<br><b>उल्लेखाः - </b>किरा० ७-२१<br><br>उत्सङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲುಮೈ /ಮೇಲುಭಾಗ<br><b>प्रयोगाः - </b>"दृषदो वासितोत्सङ्गा निषण्णमृगनाभिभिः"<br><b>उल्लेखाः - </b>रघु० ४-७४<br><br>उत्सङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂನ್ಯಾಸಿ<br><b>व्युत्पत्तिः - </b>उत्क्रान्तः सङ्गम्<br><br>उत्सङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಊರ್ಧ್ವಸಂಸರ್ಗ /ಮೇಲಿನ ಸಂಬಂಧ<br><br>

उत्सङ्गित
उत्सङ्गित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ ಹೊಂದಿಸಲ್ಪಟ್ಟ /ಸಂಬಂಧವುಳ್ಳದ್ದಾಗಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उत्सङ्गिन् + णिच् - कर्म० "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>उत्सङ्गी कृतः<br><b>प्रयोगाः - </b>"उत्सङ्गिताम्भःकणको नभस्वानुदन्वतः स्वेदलवान् ममार्ज"<br><b>उल्लेखाः - </b>माघ० ३-७९<br><br>

उत्सङ्गिन्
उत्सङ्गिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಿನ ಸಂಬಂಧವುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>उत्सङ्गः ऊर्ध्वसंसर्गः अस्त्यस्य<br><br>

उत्सञ्जन
उत्सञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲುಭಾಗದಲ್ಲಿ ಸೇರಿಸುವಿಕೆ /ಮೇಲಕ್ಕೆ ಎತ್ತಿ ಇಡುವಿಕೆ<br><b>निष्पत्तिः - </b>उत् + षञ्ज (सङ्गे) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"सम्माननोत्सञ्जनाचार्यकरणज्ञानभृतिविगणनव्ययेषु नियः"<br><b>उल्लेखाः - </b>पा० सू० १-३-३६<br><br>

उत्सर्ग
उत्सर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಮಾನ್ಯಶಾಸ್ತ್ರ /ಎಲ್ಲಾ ಕಡೆಗಳಲ್ಲಿಯೂ ಪ್ರವರ್ತಿಸುವ ಶಾಸ್ತ್ರ<br><b>निष्पत्तिः - </b>उत् + सृज (विसर्गे) - कर्म० "घञ्" (३-३-१९)<br><b>प्रयोगाः - </b>"अपवादैरिवोत्सर्गाः कृतव्यावर्तयः परैः"<br><b>उल्लेखाः - </b>कुमा० २-२७<br><br>उत्सर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಯ /ಖರ್ಚು<br><b>प्रयोगाः - </b>"वृषल, किमयमस्थाने महानर्थोत्सर्गः क्रियते"<br><b>उल्लेखाः - </b>मुद्रा० ३<br><br>उत्सर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತ್ಯಾಗ /ದಾನ<br><b>प्रयोगाः - </b>"विभज्य मेरुर्नयदर्थिसात्कृतो न सिन्धुरुत्सर्गजलव्ययैर्मरुः"<br><b>उल्लेखाः - </b>नैष० १-१६<br><br>उत्सर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಿತ್ಯಾಗ /ತ್ಯಜಿಸುವುದು /ಬಿಡುವುದು<br><b>प्रयोगाः - </b>"श्रीलक्षणोत्सर्गविनीतवेषाः"<br><b>उल्लेखाः - </b>कुमा० ७-४५<br><br>उत्सर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾಪ್ತಿ /ಕೊನೆಗಾಣಿಸುವಿಕೆ<br><br>उत्सर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿ ಪುಷ್ಯ ಮಾಸದಲ್ಲಿ ಮಾಡುವ ವೇದಾಧ್ಯಯನದ ಉತ್ಸರ್ಜನೆ /ವೇದಾಧ್ಯಯನವನ್ನು ತತ್ಕಾಲದಲ್ಲಿ ನಿಲ್ಲಿಸುವುದು<br><b>विस्तारः - </b>"अत ऊर्ध्वं तु छन्दांसि शुक्लेषु नियतः पठेत् । वेदाङ्गानि च सर्वाणि कृष्णपक्षेषु सम्पठेत् ॥" -मनु० ४-९८<br><br>उत्सर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಲಮೂತ್ರಾದಿಗಳ ವಿಸರ್ಜನೆ<br><br>

उत्सर्जन
उत्सर्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಾನ /ಕೊಡುಗೆ<br><b>निष्पत्तिः - </b>उत् + सृज (विसर्गे) - भावे "ल्युट्" (३-३-११५)<br><br>

उत्सर्पण
उत्सर्पण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಬರುವುದು /ಹತ್ತಿರಕ್ಕೆ ಬರುವುದು<br><br>उत्सर्पण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಬರುವುದು<br><b>निष्पत्तिः - </b>उत् + सृप्लृ (गतौ) - भावे "ल्युट्" (३-३-११५)<br><br>

उत्सर्पिणी
उत्सर्पिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜೈನರ ಕಲ್ಪಕಾಲದ ಒಂದು ಭಾಗ<br><br>उत्सर्पिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उत्सर्पिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्"(४-१-५)<br><b>प्रयोगाः - </b>"उत्सर्पिणी खलु महतां प्रार्थना" । "उत्सर्पिणी न किल तस्य तरङ्गिणी या" ।<br><b>उल्लेखाः - </b>शाकु० ७, नैष० ११-७७<br><br>

उत्सर्पित
उत्सर्पित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಬ್ಬಿಸಲ್ಪಟ್ಟ<br><br>उत्सर्पित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ತರಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उत् + सृप्लृ (गतौ) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"उत्सर्पितोर्मिचयलङ्घिततीरदेशमौत्सुक्यनुन्नमिव वारि पुरः प्रथस्थे"<br><b>उल्लेखाः - </b>किरा० ८-५५<br><br>

उत्सर्पिन्
उत्सर्पिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹರಡುವ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>उत् + सृप्लृ (गतौ) - "णिनिः" (३-२-७८)<br><b>प्रयोगाः - </b>"ततः शरच्चन्द्रकराभिरामैरुत्सर्पिभिः प्रांशुमिवांशुजालैः"<br><b>उल्लेखाः - </b>किरा० ३-१<br><br>उत्सर्पिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರುವ /ಮೇಲಕ್ಕೆ ನೆಗೆಯುವ<br><b>प्रयोगाः - </b>"पयोधरोत्सर्पिषु शीर्यमाणः संलक्ष्यते न च्छिदुरोऽपि हारः"<br><b>उल्लेखाः - </b>रघु० १६-६२<br><br>उत्सर्पिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಶಯವಾದ /ಬಹಳ ಶ್ರೇಷ್ಠವಾದ /ಮೇಲ್ಮಟ್ಟದ<br><br>

उत्सव
उत्सव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂತೋಷವನ್ನುಂಟುಮಾಡುವ ಸಮಾರಂಭ /ಹಬ್ಬ<br><br>उत्सव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂತೋಷ /ಆನಂದ /ಹರ್ಷ<br><b>निष्पत्तिः - </b>उत् + षु (प्रसवैश्वर्ययोः) - "अप्" (३-३-५७)<br><b>प्रयोगाः - </b>"श्लाघ्यान्वयेति नयनोत्सवकारिणीति निर्व्यूढसौहृदरसेति गुणोज्ज्वलेति" । "विधुर्विधुन्तुदस्येव पूर्णस्तस्योत्सवाय सः" । "पराभवोऽप्युत्सव एव मानिनाम्" ।<br><b>उल्लेखाः - </b>मालती० ६-१७, माघ० २-६१, किरा० १-४१<br><br>उत्सव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚುಚಿಕೆ<br><br>उत्सव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪ /ಸಿಟ್ಟು<br><br>उत्सव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಸೆಯು ಹೆಚ್ಚುವಿಕೆ<br><b>विस्तारः - </b>"उत्सेकामर्षयोरिच्छाप्रसवे मह उत्सवः" - अम० । "उत्सवो मह उत्सेके इच्छाप्रसवकोपयोः" - मेदि० ।<br><br>

उत्सवसङ्केत
उत्सवसङ्केत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಮಾಲಯದಲ್ಲಿ ವಾಸಿಸುವ ಕಾಡುಮನುಷ್ಯರು<br><b>व्युत्पत्तिः - </b>उत्सवः आनन्दजनकः सङ्केतः स्त्रीपुंसयोः रत्यर्थमनुरागादाह्वानं येषाम्<br><b>प्रयोगाः - </b>"पौरवं युधि निर्जित्य दस्यून् पर्वतवासिनः । गणानुत्सवसङ्केतानजयत्सप्त पाण्डवः ॥" "शरैरुत्सवसङ्केतान् स कृत्वा विरतोत्सवान्" ।<br><b>उल्लेखाः - </b>भा० सभा० २८-१६, रघु० ४-७८<br><br>

उत्सादन
उत्सादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಯನ್ನು ಉಜ್ಜಿ ಶುದ್ಧಿಮಾಡುವ ಪುಡಿ<br><b>निष्पत्तिः - </b>उद् +षद्लृ (विशरणादौ) + णिच् - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>उत्साद्यतेऽनेन<br><b>प्रयोगाः - </b>"उत्सादनं च गात्राणां स्नापनोच्छिष्टभोजने । न कुर्यात् गुरुपुत्रस्य पादयोश्चावनेजनम् ॥"<br><b>उल्लेखाः - </b>मनु० २-२०९<br><br>उत्सादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಯನ್ನು ಉಜ್ಜಿ ಶುದ್ಧಿಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"उत्सादनार्थं लोकानां धुन्धुर्नाम महासुरः"<br><b>उल्लेखाः - </b>भा०<br><br>उत्सादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸುವಿಕೆ<br><br>

उत्सादनीय
उत्सादनीय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಯನ್ನು ಉಜ್ಜಿ ಶುದ್ಧಿಮಾಡುವ ಪುಡಿ<br><br>उत्सादनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸಲು ಯೋಗ್ಯವಾದ<br><br>उत्सादनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उद् +षद्लृ (विशरणादौ) + णिच् - "अनीयर्" (३-१-९६)<br><br>

उत्सादित
उत्सादित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸಲ್ಪಟ್ಟ<br><br>उत्सादित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಸನೆಯ ಪುಡಿಯಿಂದ ಉಜ್ಜಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् +षद्लृ (विशरणादौ) + णिच् - "क्तः" (३-२-१०२)<br><br>

उत्सारक
उत्सारक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ವಾರಪಾಲಕ<br><b>निष्पत्तिः - </b>उत् + सृ (गतौ) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>उत्सारयति जनान्<br><br>उत्सारक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೋಲೀಸಿನವನು /ಜನರ ಗುಂಪನ್ನು ಚದುರಿಸುವವನು<br><br>

उत्सारण
उत्सारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚದುರಿಸಲ್ಪಟ್ಟ<br><br>उत्सारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಾರಿಯನ್ನು ಬಿಡಿಸಿ ಓಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>उत् + सृ (गतौ) + णिच् - "ल्युट्" (३-३-११५)<br><br>

उत्सारित
उत्सारित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚದುರಿಸಲ್ಪಟ್ಟ<br><br>उत्सारित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಓಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उत् + सृ (गतौ) + णिच् - "क्तः" (३-२-१०२)<br><br>

उत्साह
उत्साह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಚ್ಛೆ /ಪ್ರವೃತ್ತಿ /ಕ್ರಿಯಾಶಕ್ತಿ<br><b>निष्पत्तिः - </b>उत् + षह (मर्षणे) - "घञ्" (३-३-१२१)<br><b>प्रयोगाः - </b>"मन्दोत्साहः कृतोऽस्मि मृगयापवादिना माढव्येन"<br><b>उल्लेखाः - </b>शाकु० २<br><br>उत्साह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನ ಮೂರು ವಿಧ ಶಕ್ತಿಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"प्रजोत्साहवतः स्वामी यतेताधातुमात्मनि"<br><b>उल्लेखाः - </b>माघ० २-७६<br><b>विस्तारः - </b>ಪ್ರಭುಶಕ್ತಿ, ಮಂತ್ರಶಕ್ತಿ, ಉತ್ಸಾಹ ಶಕ್ತಿ - ಇವು ರಾಜನ ೩ ಶಕ್ತಿಗಳು. "शक्तयस्तिस्रः प्रभावोत्साहमन्त्रजाः" - अम० ।<br><br>उत्साह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಿರ ಬುದ್ಧಿಯಿಂದ ನಡೆಸುವ ಸುದೀರ್ಘಪ್ರಯತ್ನ<br><br>उत्साह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಧ್ಯವಸಾಯ /ನಿಶ್ಚಯ<br><br>उत्साह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೀರರಸದ ಸ್ಥಾಯಿಭಾವ<br><b>प्रयोगाः - </b>"उत्तमप्रकृतिर्वीर उत्साहस्थायिभावकः"<br><b>उल्लेखाः - </b>सा० द० ३-२३२<br><br>उत्साह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂತ್ರ /ದಾರ<br><b>विस्तारः - </b>"उत्साहस्तूद्यमे सूत्रे" - मेदि० ।<br><br>

उत्साहक
उत्साहक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹವನ್ನುಂಟುಮಾಡುವ/ಕ್ರಿಯಾಶಕ್ತಿಯನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>उत् + षह (मर्षणे) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>उत्साहयति<br><br>

उत्साहन
उत्साहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹವನ್ನುಂಟುಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>उत् + षह (मर्षणे) - "ल्युट्" (३-३-११५)<br><br>

उत्साहवर्धन
उत्साहवर्धन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹವನ್ನು ಅಧಿಕಗೊಳಿಸುವ ವೀರರಸ<br><b>निष्पत्तिः - </b>वृधु (वृद्धौ) + णिच् - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उत्साहं वर्धयति<br><br>उत्साहवर्धन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹದ ವೃದ್ಧಿ /ಉತ್ಸಾಹವು ಹೆಚ್ಚುವಿಕೆ<br><b>निष्पत्तिः - </b>वृधु (वृद्धौ) - "ल्युट्" (३-३-११५)<br><b>व्युत्पत्तिः - </b>उत्साहस्य वर्धनम्<br><br>उत्साहवर्धन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹವನ್ನು ಹೆಚ್ಚಿಸುವ<br><br>

उत्साहशक्ति
उत्साहशक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನ ಮೂರು ವಿಧ ಶಕ್ತಿಗಳಲ್ಲೊಂದು /ರಾಜನ ಪರಾಕ್ರಮವನ್ನು ಹೆಚ್ಚಿಸುವ ಶಕ್ತಿ<br><b>विस्तारः - </b>"शक्तयस्तिस्रः प्रभावोत्साहमन्त्रजाः" - अम० ।<br><br>

उत्साहिन्
उत्साहिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹವುಳ್ಳ /ಕಾರ್ಯಾಸಕ್ತನಾದ /ಪ್ರಯತ್ನಶಾಲಿಯಾದ<br><b>निष्पत्तिः - </b>उत्साह - "इनिः" (५-२-११५)<br><br>

उत्सिक्त
उत्सिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗರ್ವಗೊಂಡ /ಕೊಬ್ಬಿದ<br><br>उत्सिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಿದ /ಅಧಿಕಗೊಂಡ /ವೃದ್ಧಿ ಹೊಂದಿದ<br><br>उत्सिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಲಕಲ್ಪಟ್ಟ /ನೆಮ್ಮದಿಗೆ ಭಂಗ ತರಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उत् + षिच (क्षरणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"जानीयादस्थिरां वाचमुत्सिक्तमनसां तथा"<br><b>उल्लेखाः - </b>मनु० ८-७१<br><br>

उत्सुक
उत्सुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟವಾದುದನ್ನು ಪಡೆಯಲು ಪ್ರಯತ್ನವುಳ್ಳ<br><br>उत्सुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟವಾದುದನ್ನು ಪಡೆಯಲು ತವಕಪಡುವ<br><b>निष्पत्तिः - </b>उत् + षू (प्रेरणे) -"डुः" (वा० ३-२-१८०) । "कन्" (५-४-५) । ह्रस्वः (७-४-१३)<br><b>व्युत्पत्तिः - </b>उत्सुवति<br><b>प्रयोगाः - </b>"तमुत्सुकाश्चक्रुरवेक्षणोत्सुकं गवां गणाः प्रस्नुतपीवरौधसः" । "विहारभूमेरभिघोषमुत्सुकाः" । "श्रुत्वा रामः प्रियोदन्तं मेने तत्सङ्गमोत्सुकः" ।<br><b>उल्लेखाः - </b>किरा० ४-१०,३१, रघु० १२-६६<br><br>

उत्सुकता
उत्सुकता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಔತ್ಸುಕ್ಯ /ಇಷ್ಟವಾದುದನ್ನು ಪಡೆಯಲು ಆಸೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>उत्सुकस्य भावः<br><b>प्रयोगाः - </b>"नयति सन्ततमुत्सुकतामयम्"<br><b>उल्लेखाः - </b>किरा० ५-१९<br><br>

उत्सूत्र
उत्सूत्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾರವನ್ನು ಬಿಟ್ಟಿರುವ /ದಾರದಿಂದ ಬೇರೆಯಾಗಿರುವ<br><b>व्युत्पत्तिः - </b>उत्क्रान्तः सूत्रम्<br><b>प्रयोगाः - </b>"हाराणां मणिभिरुषाश्रितौ समन्तादुत्सूत्रैर्गुणवदुपघ्नकाम्ययेव"<br><b>उल्लेखाः - </b>माघ० ८-५३<br><br>उत्सूत्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಯಮವನ್ನು ಮೀರಿದ /ನೀತಿಶಾಸ್ತ್ರವನ್ನು ಅತಿಕ್ರಮಿಸಿದ<br><b>प्रयोगाः - </b>"अनुत्सूत्रपदन्यासा सद्वृत्तिः सन्निबन्धना"<br><b>उल्लेखाः - </b>माघ० २-११२<br><br>

उत्सृज्य
उत्सृज्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ತ್ಯಜಿಸಿ /ಬಿಟ್ಟು<br><b>निष्पत्तिः - </b>उत् + सृज (विसर्गे) - "ल्यप्"(७-१-३७)<br><b>प्रयोगाः - </b>"उत्सृज्य कुसुमशयनं नलिनीदलकल्पितस्तनावरणम्"<br><b>उल्लेखाः - </b>शाकु० ३-१९<br><br>

उत्कृष्ट
उत्कृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತ್ಯಜಿಸಲ್ಪಟ್ಟ /ಬಿಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उत् + सृज (विसर्गे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"भयोत्सृष्टविभूषाणां तेन केरलयोषिताम्"<br><b>उल्लेखाः - </b>रघु० ४-५४<br><br>उत्कृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಿ ಹಾಕಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"उत्सृष्ट ध्वजकुथकङ्कटा धरित्रीमानीता विदितनयैः श्रमं विनेतुम्"<br><b>उल्लेखाः - </b>किरा० ७-३०<br><br>उत्कृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಡಲ್ಪಟ್ಟ /ದಾನ ಮಾಡಲ್ಪಟ್ಟ<br><br>उत्कृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡಲ್ಪಟ್ಟ /ಪ್ರಯೋಗಿಸಲ್ಪಟ್ಟ<br><br>उत्कृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡಲ್ಪಟ್ಟ ಹಗ್ಗ /ಬಿಚ್ಚಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"तुरङ्गमुत्सृष्टमनर्गलं पुनः"<br><b>उल्लेखाः - </b>रघु० ३-३९<br><br>

उत्सृष्टि
उत्सृष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಿತ್ಯಾಗ /ಬಿಡುವಿಕೆ<br><b>निष्पत्तिः - </b>उत् + सृज (विसर्गे) - "क्तिन्" (३-३-९४)<br><br>

उत्सेक
उत्सेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ವ /ಅಹಂಕಾರ<br><b>निष्पत्तिः - </b>उत् + षिच (क्षरणे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"उपदा विविशुः शश्वन्नोत्सेकाः कोसलेश्वरम्"<br><b>उल्लेखाः - </b>रघु० ४-७०<br><br>उत्सेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ರೇಕ /ಹೆಚ್ಚುವಿಕೆ /ಅಧಿಕವಾಗಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"सौहित्यात्पृथवः क्वथन्ति रुधिरोत्सेकाश्चमत्कारिणः"<br><b>उल्लेखाः - </b>म० वी० ५-३३<br><br>उत्सेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಿ ಸುರಿಯುವುದು<br><b>प्रयोगाः - </b>"उत्सेकिना बलमदेन विगाहमानम्"<br><b>उल्लेखाः - </b>मुद्रा० १-२७<br><br>

उत्सेकिन्
उत्सेकिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾದ /ಅಧಿಕವಾದ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>उत्सेकोऽस्यास्ति<br><br>उत्सेकिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗರ್ವವುಳ್ಳ /ಅಹಂಕಾರದಿಂದ ಕೂಡಿದ<br><br>

उत्सेकिनी
उत्सेकिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उत्सेकिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्"(४-१-५)<br><b>प्रयोगाः - </b>"भूयिष्ठं भव दक्षिणा परिजने भाग्येष्वनुत्सेकिनी"<br><b>उल्लेखाः - </b>शाकु० ४-१७<br><br>

उत्सेचन
उत्सेचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಿ ಸುರಿಯುವಿಕೆ<br><b>निष्पत्तिः - </b>उत् + षिच (क्षरणे) - "ल्युट्" (३-३-११५)<br><br>

उत्सेध
उत्सेध<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತರ /ಔನ್ನತ್ಯ<br><b>निष्पत्तिः - </b>उत् + षिध (गत्याम्) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"बबन्ध बालारुणबभ्रु वल्कलं पयोधरोत्सेधविशीर्णसंहति"<br><b>उल्लेखाः - </b>कुमा० ५-८<br><br>उत्सेध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹ /ಶರೀರ<br><b>विस्तारः - </b>"उत्सेधश्चोच्छ्रये काये" - विश्व० । "उत्सेधस्तूच्छ्रये न स्त्री क्लीबं संहननेऽपि च" - मेदि० ।<br><br>

उत्स्वन
उत्स्वन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾದ ಶಬ್ದ<br><b>व्युत्पत्तिः - </b>उत् उच्चैः स्वनः<br><br>उत्स्वन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾದ ಶಬ್ದವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>उच्चैः स्वनो यस्य<br><br>

उत्स्वप्न
उत्स्वप्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕನವರಿಸುವ /ನಿದ್ರೆಯಲ್ಲೂ ಸ್ಪಷ್ಟವಾಗಿ ಮಾತನಾಡುವ<br><b>व्युत्पत्तिः - </b>उत्क्रान्तः अतिक्रान्तः स्वप्नं स्वप्नमर्यादायाम्<br><br>

उद्
उद्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸುವುದು /ಹೊರಗೆಡಹುವುದು<br><b>प्रयोगाः - </b>उद्घोषति, उच्चरति<br><br>उद्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯೇಕವಾಗುವುದು /ಬೇರ್ಪಡಿಸುವುದು<br><b>प्रयोगाः - </b>उद्गच्छति<br><br>उद्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಊರ್ಧ್ವಕರ್ಮ /ಮೇಲಕ್ಕೆ ಏಳುವುದು<br><b>प्रयोगाः - </b>उत्तिष्ठति<br><br>उद्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಶ್ಚರ್ಯ<br><br>उद्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಾಧಾನ್ಯ<br><br>उद्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರುವುದು<br><b>प्रयोगाः - </b>"तस्मिन्नुत्पतिते पुरः सुरमुनाविन्दोः श्रियं बिभ्रति"<br><b>उल्लेखाः - </b>माघ० १-७५<br><br>उद्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಭಾವ<br><br>उद्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮೋಕ್ಷ /ಮುಕ್ತಿ /ಬಿಡುಗಡೆ<br><br>उद्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಾಧಾನ್ಯ<br><br>उद्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮೇಲುಮುಖ<br><b>प्रयोगाः - </b>"उद्ग्रीवैर्घनरवशङ्कया मयूरैः"<br><b>उल्लेखाः - </b>किरा० ७-२२<br><br>उद्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಊರ್ಧ್ವಮುಖವಾಗಿ ಹೋಗುವುದು<br><b>प्रयोगाः - </b>"उद्ग्तेन्दुमविभिन्नतमिस्रां पश्यन्ति स्म रजनीमवितृप्तः"<br><b>उल्लेखाः - </b>किरा० ९-२४<br><br>उद्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಲಾಭ /ಸಂಪಾದನೆ<br><b>प्रयोगाः - </b>उत्पत्तिः । उत्पन्नम् ।<br><br>उद्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಬಂಧನ<br><br>उद्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಶಕ್ತಿ<br><b>विस्तारः - </b>"उत् प्रकाशे विभागे च प्राबल्यास्वास्थ्यशक्तिषु । प्राधान्ये बन्धनेऽभावे मोक्षे लाभोर्ध्वकर्मणोः" - मेदि० ।<br><br>

उदक
उदक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು /ಜಲ<br><b>निष्पत्तिः - </b>उन्दी (क्लेदने) - "क्वुन्" (उ० २-३९)<br><b>प्रयोगाः - </b>"अनीत्वा पङ्कतां धूलिमुदकं नावतिष्ठते"<br><b>उल्लेखाः - </b>माघ० २-३४<br><br>

उदकान्त
उदकान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನ ದಡ /ನೀರಿನ ಅಂಚು<br><b>प्रयोगाः - </b>"भगवन्, उदकान्तात् स्निग्धो जनोऽनुगन्तव्य इति श्रूयते"<br><b>उल्लेखाः - </b>शाकु० ४<br><br>

उदकुम्भ
उदकुम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನ ಕೊಡ /ನೀರಿನ ಅಂಚು<br><b>निष्पत्तिः - </b>उदकस्य उदादेशः (६-३-५७)<br><b>व्युत्पत्तिः - </b>उदकस्य कुम्भः<br><br>

उदकेचर
उदकेचर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಲಚರ ಪ್ರಾಣಿ /ನೀರಿನಲ್ಲಿ ಸಂಚರಿಸುವ ಜಂತು /ಮೀನು ಹಕ್ಕಿ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>चर (गतौ) - "टः" (३-२-१६) । सप्तम्या वा अलुक् (६-३-१४)<br><b>व्युत्पत्तिः - </b>उदके चरति<br><br>

उदकेचारिन्
उदकेचारिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಲಚರ ಪ್ರಾಣಿ /ನೀರಿನಲ್ಲಿ ಸಂಚರಿಸುವ ಜಂತು /ಮೀನು ಹಕ್ಕಿ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>"णिनिः" (३-२-७८)<br><br>

उदकेचारिणी
उदकेचारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲಚರ ಪ್ರಾಣಿ /ನೀರಿನಲ್ಲಿ ಸಂಚರಿಸುವ ಜಂತು /ಮೀನು ಹಕ್ಕಿ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्"(४-१-५)<br><br>

उदक्त
उदक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾವಿಯಿಂದ ಮೇಲಕ್ಕೆ ಎತ್ತಲ್ಪಟ್ಟ ನೀರು ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>उद् + अञ्चु (गतौ) - "क्तः" (३-२-१०२)<br><b>विस्तारः - </b>"उदक्तमुदकं कूपात्" - सि० कौ० ।<br><br>

उदक्प्रवण
उदक्प्रवण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣ ದಿಕ್ಕಿನಿಂದ ಉತ್ತರಕ್ಕೆ ತಗ್ಗಾದ /ಉತ್ತರ ದಿಕ್ಕಿನ ಕಡೆಗೆ ಇಳಿಜಾರಾಗಿರುವ<br><br>

उदक्य
उदक्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರನ್ನು ಅಪೇಕ್ಷಿಸುವ /ನೀರಿನಿಂದ ಬೆಳೆಯಲು ಅರ್ಹವಾದ<br><b>निष्पत्तिः - </b>"यत्" (५-१-६६)<br><b>व्युत्पत्तिः - </b>उदकमर्हति<br><br>उदक्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಶುಚಿ /ಮೈಲಿಗೆ<br><br>

उदक्या
उदक्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಜಸ್ವಲೆ /ಋತುಮತಿಯಾದ ಹೆಂಗಸು<br><b>विस्तारः - </b>"ऋतुमत्यप्युदक्यापि" - अम० ।<br><br>

उदगयन
उदगयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರಾಯಣ<br><b>व्युत्पत्तिः - </b>उदक् उदीच्यामयनं यत्र<br><br>उदगयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರ ದಿಕ್ಕಿನಲ್ಲಿ ಸಂಚಾರ<br><b>व्युत्पत्तिः - </b>उदक् उदीच्यामयनम्<br><br>

उदग्दश
उदग्दश<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರದಲ್ಲಿ ತುದಿಯುಳ್ಳ ಬಟ್ಟೆ<br><b>व्युत्पत्तिः - </b>उदक् उदीच्यां दशा अञ्चलं यस्य<br><br>

उदग्र
उदग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉನ್ನತವಾದ /ಎತ್ತರವಾದ<br><b>व्युत्पत्तिः - </b>उद्गतमग्रं यस्य<br><b>प्रयोगाः - </b>"उदग्रतालध्वजमेतदग्रे सीमान्तरं सीरभृतो गुरोर्नः" । "आक्रम्य संस्थितमुदग्रविशालशृङ्गम्" ।<br><b>उल्लेखाः - </b>याद० १८-१२३, माघ० ४-१९<br><br>उदग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾದ /ಅಧಿಕವಾದ<br><b>प्रयोगाः - </b>"नयन् मधुलिहः श्वैत्यमुदग्रदशनांशुभिः"<br><b>उल्लेखाः - </b>माघ० २-२१<br><br>उदग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೊಡ್ಡದಾದ /ಉದಾರವಾದ<br><b>प्रयोगाः - </b>"हरिन्मणिश्याममुदग्रविग्रहम्"<br><b>उल्लेखाः - </b>किरा० १४-४१<br><br>उदग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಸಿದ್ಧವಾದ /ಘನತೆ ಪಡೆದ<br><b>प्रयोगाः - </b>"वीर्योदग्रे राजशब्दे मृगेषु"<br><b>उल्लेखाः - </b>रघु० ९-६४<br><br>उदग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಬ್ಬಿರುವ /ಉದ್ರೇಕಗೊಂಡ<br><b>प्रयोगाः - </b>"मदोदग्राः ककुद्मन्तः सरितां कूलमुद्रुजाः"<br><b>उल्लेखाः - </b>रघु० ४-२२<br><br>उदग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಕ್ತಿವಂತ /ಬಲಶಾಲಿ<br><b>प्रयोगाः - </b>"तत उदग्र इव द्विरदे मुनौ रणमुपेयुषि भीमभुजायुधे"<br><b>उल्लेखाः - </b>किरा० १८-१<br><br>उदग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೀಕ್ಷ್ಣವಾದ /ತೀವ್ರವಾದ /ಸಹಿಸಲಶಕ್ಯವಾದ<br><b>प्रयोगाः - </b>"अखिद्यतासन्नमुदयतापं रविं दधानेऽप्यरविन्दधाने"<br><b>उल्लेखाः - </b>माघ० ४-१२<br><br>

उदग्रदत्
उदग्रदत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ದವಾದ ದಂತವುಳ್ಳ /ಎತ್ತರವಾದ ಹಲ್ಲುಗಳುಳ್ಳ<br><b>निष्पत्तिः - </b>दतृ आदेशः (५-४-१४५)<br><b>व्युत्पत्तिः - </b>उदग्रा दन्ता यस्य<br><br>

उदग्रदती
उदग्रदती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ದವಾದ ದಂತವುಳ್ಳ /ಎತ್ತರವಾದ ಹಲ್ಲುಗಳುಳ್ಳ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्"(४-१-५)<br><br>

उदङ्क
उदङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚರ್ಮದ ಚೀಲ /ಎಣ್ಣೆ ತುಪ್ಪ ಮುಂತಾದುವನ್ನು ಇಡುವ ತೊಗಲಿನ ಚೀಲ<br><b>निष्पत्तिः - </b>उद् + अञ्चु (गतौ) - अधि० "घञ्" (३-३-१२३)<br><b>व्युत्पत्तिः - </b>उद्च्यतेऽत्र<br><br>उदङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಕ್ಕುಳ<br><b>निष्पत्तिः - </b>कर० "घञ्"<br><b>व्युत्पत्तिः - </b>उदच्यतेऽनेन<br><b>प्रयोगाः - </b>"हृदयोदङ्कसंस्थानं कृतान्तानायसन्निभम्"<br><b>उल्लेखाः - </b>भट्टि० ७-८३<br><br>उदङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಋಷಿ<br><br>

उदङ्मुख
उदङ्मुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರಾಭಿಮುಖವಾದ /ಉತ್ತರ ದಿಕ್ಕಿಗೆ ಎದುರಾದ<br><b>व्युत्पत्तिः - </b>उदक् मुखं यस्य<br><br>

उदक्|उदच्
उदक्(च्)<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹೋಗುವ /ಊರ್ಧ್ವಮುಖವಾಗಿ ಏಳುವ<br><br>उदक्(च्)<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲುಭಾಗದ /ಊರ್ಧ್ವಪ್ರದೇಶದ<br><br>उदक्(च्)<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರ ದಿಕ್ಕಿನ<br><br>उदक्(च्)<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರ ಕಾಲದ /ಮುಂದಿನ ಕಾಲದ<br><b>निष्पत्तिः - </b>उद् + अञ्चु (गतौ) - "क्विन्"<br><br>उदक्(च्)<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉತ್ತರ ದಿಕ್ಕು /ಉತ್ತರ ದಿಕ್ಕಿನಿಂದ /ಉತ್ತರ ದಿಕ್ಕಿನಲ್ಲಿ<br><br>उदक्(च्)<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉತ್ತರ ದೇಶ /ಉತ್ತರ ದೇಶದಿಂದ /ಉತ್ತರ ದೇಶದಲ್ಲಿ<br><br>उदक्(च्)<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉತ್ತರ ಕಾಲ /ಉತ್ತರ ಕಾಲದಿಂದ /ಉತ್ತರ ಕಾಲದಲ್ಲಿ<br><b>निष्पत्तिः - </b>उद् + अञ्चु (गतौ) - "क्विन्" (३-२-५९) । "अस्तातिः"(५-३-२७) । अस्तातेर्लुक् (५-३-३०)<br><b>प्रयोगाः - </b>"तेनोदीचीं दिशमनुसरेस्तिर्यगायामशोभी"<br><b>उल्लेखाः - </b>मेघ० १-५७<br><br>

उदञ्चत्
उदञ्चत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏಳುತ್ತಿರುವ /ಮೇಲಕ್ಕೆ ಹೊರಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + अञ्चु (गतौ) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"पिकाद्वने शृण्वति भृङ्गहुङ्कृतैर्दशामुदञ्चत्करणे वियोगिनाम्"<br><b>उल्लेखाः - </b>नैष० १-८८<br><br>

उदञ्चन
उदञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತುವುದು /ಮೇಲಕ್ಕೆ ಎಳೆಯುವುದು<br><b>निष्पत्तिः - </b>उद् + अञ्चु (गतौ) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"ज्ञानामृतोदञ्चनलालसानां लीलाघटीयन्त्रमिवाश्रितानाम्"<br><b>उल्लेखाः - </b>हयग्री०<br><br>उदञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಳ /ಮುಚ್ಚುವ ತಟ್ಟೆ<br><b>निष्पत्तिः - </b>उद् + अञ्चु (गतौ) + णिच् - कर० "ल्युट्" (३-३-११७)<br><br>उदञ्चन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾವಿಯಿಂದ ನೀರನ್ನು ಎತ್ತಿ ತರುವ<br><b>निष्पत्तिः - </b>उद् + अञ्चु (गतौ) - कर्त० "ल्युः" (३-१-१३४)<br><br>उदञ्चन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ಧರಣೆ<br><b>निष्पत्तिः - </b>उद् + अञ्चु (गतौ) - कर० "ल्युट्"<br><br>

उदञ्चित
उदञ्चित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲ್ಪಟ್ಟ /ಮೇಲಕ್ಕೆ ಎಳೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + अञ्चु (गतौ) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"उदञ्चिता बाहुलतेतरस्या मौलिस्रजा हस्तगृहीतयाऽसीत्"<br><b>उल्लेखाः - </b>याद० १३-४९<br><br>उदञ्चित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಟ್ಟ /ಗೌರವಿಸಲ್ಪಟ್ಟ<br><br>

उदधान
उदधान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><br>उदधान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಡ /ಬಿಂದಿಗೆ<br><b>निष्पत्तिः - </b>डुधाञ् (धारणपोषणयोः) - "ल्युट्" (३-३-११७) । उदकस्य उदादेशः (६-३-५७)<br><b>व्युत्पत्तिः - </b>उदकं धीयतेऽत्र<br><br>

उदधि
उदधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ /ಕಡಲು<br><b>निष्पत्तिः - </b>डुधाञ् (धारणपोषणयोः) - "किः" (३-३-९३) । उदकस्य उदादेशः (६-३-५७)<br><b>व्युत्पत्तिः - </b>उदकानि धीयन्तेऽत्र<br><b>प्रयोगाः - </b>"उदधेरिव मन्थेन पीडितस्य समुत्थितैः"<br><b>उल्लेखाः - </b>याद० १६-५<br><br>उदधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಘಟ /ಕೊಡ /ಬಿಂದಿಗೆ<br><b>विस्तारः - </b>"उदकं धीयतेऽस्मिन् उदधिर्घटः" - सि० कौ० ।<br><br>उदधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><br>उदधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಲಾಶಯ /ನೀರಿನ ಮಡು<br><br>उदधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಲ್ಕು ಸಂಖ್ಯೆ<br><br>

उदधिकन्या
उदधिकन्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರರಾಜನ ಮಗಳು /ಲಕ್ಷ್ಮಿ<br><b>व्युत्पत्तिः - </b>उदधेः कन्या<br><br>

उदधिसुता
उदधिसुता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರರಾಜನ ಮಗಳು /ಲಕ್ಷ್ಮಿ<br><b>व्युत्पत्तिः - </b>उदधेः सुता<br><br>

उदधिमल
उदधिमल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರದ ನೊರೆ<br><b>व्युत्पत्तिः - </b>उदधेर्मल इव<br><br>

उदधिमेखला
उदधिमेखला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿ /ಭೂಮಂಡಲ<br><b>व्युत्पत्तिः - </b>उदधिर्मेखलेव यस्याः<br><br>

उदन्त
उदन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃತ್ತಾಂತ /ಸಮಾಚಾರ<br><b>व्युत्पत्तिः - </b>उद्गतोऽन्तो यस्य<br><b>प्रयोगाः - </b>"श्रुत्वा रामः प्रियोऽदन्तं तत्सङ्कमोत्सुकः"<br><b>उल्लेखाः - </b>रघु० १२-६६<br><br>उदन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಧು /ಗುಣಶಾಲಿ /ಧಾರ್ಮಿಕ /ಪುಣ್ಯಾತ್ಮ<br><b>विस्तारः - </b>"उदन्तः साधुवार्तयोः" - मेदि० ।<br><br>

उदन्या
उदन्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಯಾರಿಕೆ /ನೀರಡಿಕೆ<br><b>निष्पत्तिः - </b>"क्यच्" (३-१-८) । उदन्य "अः" (३-३-१०२) । उदन्नादेशः निपा० (७-४-३४)<br><b>व्युत्पत्तिः - </b>उदकस्येच्छा । उदकमात्मन इच्छति<br><b>प्रयोगाः - </b>"मुने निर्वर्त्यतामुदन्याप्रतीकारः"<br><b>उल्लेखाः - </b>वेणी० ६<br><br>

उदन्वत्
उदन्वत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ /ಕಡಲು<br><b>निष्पत्तिः - </b>उदक - "मतुप्" उदन्नभावश्च निपा० (८-२-१३)<br><b>व्युत्पत्तिः - </b>उदकानि सन्त्यत्र<br><b>प्रयोगाः - </b>"न सुखं प्रार्थये नार्थमुदन्वद्वीचिचञ्चलम्" । "उदन्वता खातवती समन्तात् अयत्नवप्रायिततुङ्गवेला" ।<br><b>उल्लेखाः - </b>किरा० ११-६६, याद० १८-१२१<br><br>

उदपात्र
उदपात्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನ ಪಾತ್ರೆ<br><b>निष्पत्तिः - </b>उदादेशः (६-३-५७)<br><b>व्युत्पत्तिः - </b>उदकस्य पात्र,<br><b>प्रयोगाः - </b>"रुद्धे गजेन सरितः सरुषावतारे रिक्तोदपात्रकरमास्त चिरं जनौघः"<br><b>उल्लेखाः - </b>माघ० ५-३३<br><br>

उदपान
उदपान<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೂಪ /ಬಾವಿ<br><b>निष्पत्तिः - </b>पा (पाने) - "ल्युट्" (३-३-११७) । उदादेशः ।<br><b>व्युत्पत्तिः - </b>उदकं पिबन्त्र्यत्र<br><b>प्रयोगाः - </b>"यावानर्थ उदपाने सर्वतः सम्प्लुतोदके । तावान् सर्वेषु वेदेषु ब्राह्मणस्य विजानतः ॥"<br><b>उल्लेखाः - </b>गीता० २-४६<br><br>

उदभार
उदभार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನ ಪ್ರವಾಹ /ನೀರಿನ ರಾಶಿ<br><b>निष्पत्तिः - </b>वा उदादेशः (६-३-६०)<br><b>व्युत्पत्तिः - </b>उदकस्य भारः<br><br>

उदमान
उदमान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಅಳತೆ /ಆಢಕದ ೫೦ನೆಯ ಒಂದು ಭಾಗ /ಕೊಳಗದ ೫೦ ನೆಯ ಒಂದು ಭಾಗದ ಅಳತೆ<br><b>प्रयोगाः - </b>"कुल्या स्यात् अष्टभिर्द्रोणैः द्रोणपादेन चाढकः । अस्यार्धशतिको भाग उदमान उदाहृतः ॥"<br><br>

उदमेघ
उदमेघ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನಿಂದ ತುಂಬಿದ ಮೋಡ<br><b>निष्पत्तिः - </b>उदादेशः (६-३-५७)<br><b>व्युत्पत्तिः - </b>उदकेन पूर्णो मेघः<br><br>

उदय
उदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದಯ ಪರ್ವತ /ಪ್ರಾತಃಕಾಲದಲ್ಲಿಸೂರ್ಯನು ಕಾಣಿಸಿಕೊಳ್ಳುವ ಪರ್ವತ<br><b>निष्पत्तिः - </b>उद् + इण् (गतौ) - "अच्" (३-३-५६)<br><b>प्रयोगाः - </b>"उदयमुदितदीप्तिर्याति यः सङ्गतौ मे पतति न वरमिन्दुः सोऽपरामेष गत्वा"<br><b>उल्लेखाः - </b>माघ० ११-१२<br><br>उदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ /ಏಳಿಗೆ /ಉನ್ನತಿ<br><b>प्रयोगाः - </b>"द्विषतामुदयः सुमेधसा गुरुरस्वन्ततरः सुमर्षणः"<br><b>उल्लेखाः - </b>किरा० २-८<br><br>उदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿ /ಕಾಣಿಸಿಕೊಳ್ಳುವಿಕೆ /ಹುಟ್ಟುವಿಕೆ<br><b>प्रयोगाः - </b>"अपेक्षते प्रत्ययमुत्तमं त्वां बीजाङ्कुरः प्रागुदयादिवम्भः"<br><b>उल्लेखाः - </b>कुमा० ३-१८<br><br>उदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಭ /ಹುಟ್ಟುವಳಿ /ಆದಾಯ<br><b>प्रयोगाः - </b>"विशेषतोऽसहायेन किं नु राज्यं महोदयम्"<br><b>उल्लेखाः - </b>मनु० ७-५५<br><br>उदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ ಚಂದ್ರ ಮೊದಲಾದ ಗ್ರಹಗಳ ಹುಟ್ಟುವಿಕೆ<br><b>प्रयोगाः - </b>"निवातस्तिमितां वेलां चन्द्रोदय इवोदधेः"<br><b>उल्लेखाः - </b>रघु० १२-३६<br><br>उदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿರ್ಮಾಣ /ಸೃಷ್ಟಿ<br><b>प्रयोगाः - </b>"यौ तु स्वप्नावबोधौ तौ भूतानां प्रलयोदयौ"<br><b>उल्लेखाः - </b>कुमा० २-८<br><br>उदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೇಯಸ್ಸು<br><b>प्रयोगाः - </b>"विहीयमानानुदयाय तेन"<br><b>उल्लेखाः - </b>किरा० ३-३२<br><br>उदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ /ಏಳಿಗೆ /ಉನ್ನತಿ<br><b>प्रयोगाः - </b>"तेजोद्वयस्य युगपद्व्यसनोदयाभ्यां लोको नियम्यत इवात्मदशान्तरेषु"<br><b>उल्लेखाः - </b>शाकु० ४-१<br><br>उदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನ ವೃದ್ಧಿ ಕ್ಷಯ ಸ್ಥಾನಗಳು<br><b>प्रयोगाः - </b>"षड्गुणाः शक्तयस्तिस्रः सिद्धयश्चोदयास्त्रयः"<br><b>उल्लेखाः - </b>माघ० २-२६<br><br>उदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏಳುವುದು<br><br>उदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯಫಲ /ಪರಿಣಾಮ<br><b>प्रयोगाः - </b>"अथेप्सितं भर्तुरुपस्थितोदयं सखीजनोद्वेक्षणकौमुदीमुखम्"<br><b>उल्लेखाः - </b>रघु० ३-१<br><br>उदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯಸಿದ್ಧಿ /ಕಾರ್ಯವು ನೆರವೇರುವಿಕೆ<br><b>प्रयोगाः - </b>"आगमैः सदृशारम्भः प्रारम्भसदृशोदयः"<br><b>उल्लेखाः - </b>रघु० १-१५<br><br>उदय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಗ್ನ /ರಾಶಿಗಳ ಪ್ರಾರಂಭ ಸ್ಥಾನ<br><br>

उदयगामिनी
उदयगामिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯೋದಯದ ಸಮಯವನ್ನು ವ್ಯಾಪಿಸಿರುವ ತಿಥಿ /ಸೂರ್ಯೋದಯದ ಕಾಲದ ಸಂಬಂಧವನ್ನು ಹೊಂದಿರುವ ತಿಥಿ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "णिनिः" (३-१-१३४) । "ङीप्" (४-१-५)<br><b>व्युत्पत्तिः - </b>उदयं सूर्योदयं गच्छति<br><b>प्रयोगाः - </b>"उदयन्नेव सविता यां तिथिं प्रतिपद्यते । सा तिथिः सकला ज्ञेया दानाध्ययनकर्मसु ॥"<br><br>

उदयगिरि
उदयगिरि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದಯ ಪರ್ವತ /ಪ್ರಾತಃಕಾಲದಲ್ಲಿಸೂರ್ಯನು ಕಾಣಿಸಿಕೊಳ್ಳುವ ಪರ್ವತ<br><b>प्रयोगाः - </b>"तत उदयगिरेरिवैक एष स्फुरितगुणद्युतिसुन्दरः कलावान्"<br><b>उल्लेखाः - </b>मालती० २-१०<br><br>

उदयत्
उदयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಟ್ಟುತ್ತಿರುವ /ಮೇಲಕ್ಕೆ ಏಳುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् +इ (गतौ) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"उदयति विततोर्ध्वरश्मिरज्जावहिमकरे हिमधाम्नि याति चास्तम्"<br><b>उल्लेखाः - </b>माघ० ४-२०<br><br>

उदयन
उदयन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವತ್ಸರಾಜ /ಚಂದ್ರವಂಶದ ಒಬ್ಬ ದೊರೆ<br><br>उदयन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸ್ತ್ಯ ಮಹರ್ಷಿ<br><br>उदयन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದಯನಾಚಾರ್ಯರು /ಕಿರಣಾವಲೀ ಕುಸುಮಾಂಜಲಿ ಮೊದಲಾದ ಗ್ರಂಥಕಾರರು<br><br>उदयन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯಾದಿ ಗ್ರಹಗಳ ಉದಯ<br><b>निष्पत्तिः - </b>उद् + इण् (गतौ) - "ल्युट्" (३-३-११५)<br><b>विस्तारः - </b>"उदयनमुदये क्लीबं वत्सेशागस्त्ययोः पुंसि" - मेदि० ।<br><br>

उदयवेला
उदयवेला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉದಯಕಾಲ /ಸೂರ್ಯಾದಿ ಗ್ರಹಗಳು ಹುಟ್ಟುವ ಕಾಲ<br><br>उदयवेला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರುಣೋದಯದ ಕಾಲ<br><br>

उदर
उदर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಟ್ಟೆ<br><b>निष्पत्तिः - </b>उद् +ऋ (गतौ) - "अच्" (३-१-१३४)<br><b>प्रयोगाः - </b>"वलिव्यपायस्फुटरोमराजिना निरायतत्वादुदरेण ताम्यता"<br><b>उल्लेखाः - </b>किरा० ८-१७<br><br>उदर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಧ್ಯಭಾಗ /ಒಳಭಾಗ<br><b>प्रयोगाः - </b>"ताम्रोदरेषु पतितं तरुपल्लवेषु निर्धौतहारगुलिकाविशदं हिमाम्भः"<br><b>उल्लेखाः - </b>रघु० ५-७०<br><br>उदर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ<br><br>उदर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಉದರರೋಗ /ಪ್ಲೀಹ<br><b>विस्तारः - </b>"उदरं जठरे युधि" - मेदि० ।<br><br>

उदरग्रन्थि
उदरग्रन्थि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ಲೀಹ /ಗುಲ್ಮರೋಗ<br><br>

उदरत्राण
उदरत्राण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಟ್ಟೆಯ ಕಟ್ಟು /ನಡುಕಟ್ಟು /ಹೊಟ್ಟೆಗೆ ಕಟ್ಟುವ ಪಟ್ಟಿ<br><br>

उदरथि
उदरथि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಗರ /ಸಮುದ್ರ<br><b>निष्पत्तिः - </b>उद् +ऋ (गतौ) - "घथिन्" (उ० ४-८८)<br><b>विस्तारः - </b>"उदरथिः समुद्रः" - सि० कौ० ।<br><br>

उदरम्भरि
उदरम्भरि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಟ್ಟೆಬಾಕ /ತನ್ನ ಹೊಟ್ಟೆಯ ಪಾಡನ್ನು ಮಾತ್ರ ನೋಡಿಕೊಳ್ಳುವವನು<br><b>निष्पत्तिः - </b>डुभृञ् (धारणपोषणयोः) - "इन्" मुम् च (३-२-२६) । निपा० ।<br><b>व्युत्पत्तिः - </b>उदरं बिभर्ति<br><b>प्रयोगाः - </b>"ज्योत्स्नाकरम्बमुदरम्भरयश्चकोराः"<br><b>उल्लेखाः - </b>अनर्घ०<br><br>

उदराध्मान
उदराध्मान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾತರೋಗ<br><br>

उदरावर्त
उदरावर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಭಿ /ಹೊಕ್ಕಳು<br><b>व्युत्पत्तिः - </b>उदरस्य आवर्त इव<br><br>

उदर्क
उदर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂದಿನ ಕಾಲ /ಉತ್ತರ ಕಾಲ<br><b>निष्पत्तिः - </b>अर्क (सेचने) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>उदर्क्यते<br><br>उदर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂದಿನ ಫಲ /ಉತ್ತರಕಾಲದ ಫಲ<br><b>प्रयोगाः - </b>"नन्वयमुदर्कः प्राक्तनस्य दुष्कर्मणः"<br><b>उल्लेखाः - </b>दशकु०<br><br>उदर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದನ ಕಂಟಕ /ಪ್ರೀತಿಯಿಂದ ಏಳುವ ರೋಮಾಂಚನ<br><b>विस्तारः - </b>"उदर्क उत्तरे काले यच्च स्यात् फलमुत्तरम्" - वैज० । "उदर्क एष्यत्काले तत्फले मदनकण्ठके" - मेदि० ।<br><br>

उदर्चिस्
उदर्चिस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>व्युत्पत्तिः - </b>उद् ऊर्ध्वम् अर्चिः शिखाऽस्य<br><b>प्रयोगाः - </b>"प्रक्षिप्योदर्चिषं कक्षे शेरते तेऽभिमारुतम्"<br><b>उल्लेखाः - </b>माघ० २-४२<br><br>उदर्चिस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥ<br><br>उदर्चिस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ<br><br>उदर्चिस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹರಡಿರುವ ಕಾಂತಿಯುಳ್ಳ /ಊರ್ಧ್ವಮುಖವಾದ ಜ್ವಾಲೆಯುಳ್ಳ<br><b>प्रयोगाः - </b>"अफुरन्नुदर्चिः सहसा तृतीयादक्ष्णः कृशानुः किल निष्पपात"<br><b>उल्लेखाः - </b>कुमा० ३-७१<br><br>

उदलावणिक
उदलावणिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪ್ಪು ನೀರಿನಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-३)<br><b>व्युत्पत्तिः - </b>उदकीभूतं लवणमुदकलवणम्, तेन संस्कृतम्<br><br>

उदवज्र
उदवज्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನ ರೂಪವಾದ ವಜ್ರಾಯುಧ /ನೀರೆಂಬ ವಜ್ರಾಯುಧ<br><b>निष्पत्तिः - </b>उदादेशः (६-३-५७)<br><b>व्युत्पत्तिः - </b>उदकमेव वज्रोऽशनिः<br><b>प्रयोगाः - </b>"मानिन्या वपुषि पतन्निसर्गमन्दो भिन्दानो हृदयमसाहि नोदवज्रः"<br><b>उल्लेखाः - </b>माघ० ७-३९<br><br>

उदवसित
उदवसित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹ /ಮನೆ<br><b>निष्पत्तिः - </b>उद् + अव + षो (अन्तकर्मणि) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"इदमुदवसितानामस्फुटालोकसम्पत्"<br><b>उल्लेखाः - </b>माघ० ११-१८<br><br>

उदवास
उदवास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಲಾಧಿವಾಸ /ನೀರಿನಲ್ಲಿ ವಾಸ ಮಾಡುವ<br><b>निष्पत्तिः - </b>उदादेशः (६-३-५७)<br><b>व्युत्पत्तिः - </b>उदके वासः<br><b>प्रयोगाः - </b>"निनाय साऽत्यन्तहिमोत्किरानिलाः सहस्यरात्रीरुदवासतत्परा"<br><b>उल्लेखाः - </b>कुमा० ५-२६<br><br>

उदवाहन
उदवाहन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರನ್ನು ಹೊತ್ತು ತರುವ<br><b>निष्पत्तिः - </b>उदादेशः (६-३-५७)<br><b>व्युत्पत्तिः - </b>उदकस्य वाहनः<br><br>

उदश्रु
उदश्रु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಣ್ಣೀರು ಸುರಿಸುತ್ತಿರುವ /ಅಳುತ್ತಿರುವ<br><b>व्युत्पत्तिः - </b>उदग्तमश्रु यस्य<br><b>प्रयोगाः - </b>"तस्य पश्यन् ससौमित्रेरुदश्रुर्वसतिद्रुमान्"<br><b>उल्लेखाः - </b>रघु० १२-१४<br><br>

उदश्वित्
उदश्वित्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧಭಾಗ ನೀರು ಬೆರೆಸಿ ಕಡೆದ ಮೊಸರು<br><b>निष्पत्तिः - </b>टो ओश्वि (गतिवृद्ध्योः) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>उदकेन श्वयति वर्धते<br><b>विस्तारः - </b>"तक्रं ह्युदश्विन्मथितं पादाम्ब्वर्धाम्बु निर्जलम्" - अम० ।<br><br>

उदसन
उदसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಸೆಯುವುದು<br><b>निष्पत्तिः - </b>उद् + असु (क्षेपणे) - "ल्युट्"(३-३-११५)<br><br>उदसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊರಕ್ಕೆ ತಳ್ಳುವಿಕೆ<br><br>

उदस्त
उदस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ತಳ್ಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + असु (क्षेपणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"उदस्ताधोरणः"<br><b>उल्लेखाः - </b>दशकु०<br><br>उदस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಸೆಯಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"दयिताय सासवमुदस्तमपतदवसादिनः करात्"<br><b>उल्लेखाः - </b>माघ० १५-८१<br><br>उदस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಳ್ಳಿ ಹಾಕಲ್ಪಟ್ಟ<br><br>

उदस्थान
उदस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ತುಂಬಿದ ಪ್ರದೇಶ<br><b>निष्पत्तिः - </b>उदादेशः (६-३-५७)<br><b>व्युत्पत्तिः - </b>उदकस्य स्थानम्<br><br>

उदस्थाली
उदस्थाली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ತುಂಬಿಡುವ ಪಾತ್ರೆ /ಹಂಡೆ /ಕಡಾಯ<br><b>निष्पत्तिः - </b>उदादेशः (६-३-५७)<br><b>व्युत्पत्तिः - </b>उदकस्य स्थाली<br><br>

उदस्यमान
उदस्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಸೆಯಲ್ಪಡುತ್ತಿರುವ /ಮೇಲಕ್ಕೆ ಎರಚಲ್ಪಡುತ್ತಿರುವ /ಮುಂದಕ್ಕೆ ತಳ್ಳಲ್ಪಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् +असु (क्षेपणे) -कर्म० "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"इत्थं विहृत्य वनिताभिरुदस्यमानं पीनस्तनोरुजघनस्थलशालिनीभिः"<br><b>उल्लेखाः - </b>किरा० ८-५५<br><br>

उदहरण
उदहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಂದಿಗೆ /ಕೊಡ<br><b>निष्पत्तिः - </b>हृञ् (हरणे) - "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>उदकं ह्रियतेऽनेन<br><br>

उदहार
उदहार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರನ್ನು ಹೊತ್ತು ತರುವ<br><b>निष्पत्तिः - </b>हृञ् (हरणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>उदकं हरति<br><b>प्रयोगाः - </b>"प्रविविक्ता नदीं रारावुदहारोऽहमागतः"<br><br>

उदात्त
उदात्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲುಭಾಗದಲ್ಲಿ ಉಚ್ಚರಿಸಲ್ಪಡುವ ಸ್ವರವರ್ಣ<br><b>निष्पत्तिः - </b>उद् + दाञ् (दाने) - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>उद् उच्चैरादीयते<br><b>प्रयोगाः - </b>"निहन्त्यरीनेकपदे य उदात्तस्वरानिव" । "उच्चैरुदात्तः" ।<br><b>उल्लेखाः - </b>माघ० २-९५, पा० सू०<br><br>उदात्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಲ್ಕು ವಿಧ ನಾಯಕರಲ್ಲೊಬ್ಬ<br><br>उदात्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಗಾರಿ /ಭೇರಿ /ದುಂದುಭಿ<br><br>उदात्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಅರ್ಥಾಲಂಕಾರ<br><b>प्रयोगाः - </b>"लोकातिशयसम्पत्तिवर्णनोदात्तमुच्यते । यद्वापि प्रस्तुतस्याङ्गं महतां चरितं भवेत् ॥"<br><b>उल्लेखाः - </b>सा० द० १०-९४<br><br>उदात्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಘನತೆ ಹೊಂದಿದ /ಹಿರಿಮೆ ಪಡೆದ /ಶ್ರೇಷ್ಠವಾದ<br><br>उदात्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಸಿದ್ಧವಾದ<br><b>प्रयोगाः - </b>"तस्याभवद्दतक इत्युदात्तः क्षमी मृदुर्धर्मपरस्तनूजः"<br><b>उल्लेखाः - </b>माघ० २०-८२<br><br>उदात्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದಾರ /ತ್ಯಾಗಶೀಲ /ದಾನಿ<br><br>

उदान
उदान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಂಚ ಪ್ರಾಣವಾಯುಗಳಲ್ಲೊಂದು<br><b>निष्पत्तिः - </b>"घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>उद् ऊर्ध्वेनानित्यनेन<br><br>

उदार
उदार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾನಿ /ತ್ಯಾಗಶೀಲ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उच्चैरासमन्तात् ऋच्छति<br><b>प्रयोगाः - </b>"उदाराः सर्व एवैते ज्ञानीत्वात्मैव मे मतम्"<br><b>उल्लेखाः - </b>गीता० ७-१८<br><br>उदार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಘನತೆ ಹೊಂದಿದ /ಹಿರಿಮೆ ಪಡೆದ /ಶ್ರೇಷ್ಠವಾದ<br><b>प्रयोगाः - </b>"इत्यर्घ्यपात्रानुमितव्ययस्य रधोरुदारामपि गां निशम्य"<br><b>उल्लेखाः - </b>रघु० ५-१२<br><br>उदार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಸಿದ್ಧವಾದ /ಖ್ಯಾತಿ ಪಡೆದ<br><b>निष्पत्तिः - </b>ऋ - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>उदर्यते<br><b>प्रयोगाः - </b>"उदारकीर्तेरुदयं दयावतः प्रशान्तबाधं दिशतोऽभिरक्षया"<br><b>उल्लेखाः - </b>किरा० १-१८<br><br>उदार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳವಾದ /ಸಮೃದ್ಧಿಯಾದ<br><b>प्रयोगाः - </b>"ददत्या शालीनामवनतिमुदारे सति फले"<br><b>उल्लेखाः - </b>मुद्रा० ३-८<br><br>उदार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೃದು ಸ್ವಭಾವದ /ದಯಾಳು /ಸಹೃದಯ<br><b>प्रयोगाः - </b>"विनोदयिष्यन्ति नवाभिषङ्गामुदारवाचो मुनिकन्यकास्त्वाम्"<br><b>उल्लेखाः - </b>रघु० १४-७७<br><br>उदार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಮಣೀಯವಾದ /ಮನೋಹರವಾದ<br><b>प्रयोगाः - </b>"दूष्यैरिव क्षितिभृतां द्विरदैरुदारतारावलीविरचनैर्व्यरुचन्निवासाः"<br><b>उल्लेखाः - </b>माघ० ५-२१<br><br>उदार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೊಡ್ಡದಾದ /ವಿಸ್ತಾರವಾದ /ಅಗಲವಾದ<br><b>प्रयोगाः - </b>"शत्रुघ्नप्रतिविहितोपकार्यमार्यः साकेतोपवनमुदारमध्युवास"<br><b>उल्लेखाः - </b>रघु० १३-७९<br><br>उदार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಋಜುವಾದ /ಸರಳವಾದ /ಪ್ರಾಮಾಣಿಕ<br><br>उदार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಥವತ್ತಾದ<br><b>प्रयोगाः - </b>"उदारचेता गिरमित्युदाराम्"<br><b>उल्लेखाः - </b>किरा० ३-१०<br><br>

उदारकीर्ति
उदारकीर्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಕೀರ್ತಿಶಾಲಿಯಾದ /ಹೆಚ್ಚು ಯಶಸ್ಸು ಪಡೆದ /ಖ್ಯಾತಿವಂತನಾದ<br><b>व्युत्पत्तिः - </b>उदारा कीर्तिर्यस्य<br><b>प्रयोगाः - </b>"उदारकीर्तेरुदयं दयावतः प्रशान्तबाधं दिशतोऽभिरक्षया"<br><b>उल्लेखाः - </b>किरा० १-१८<br><br>

उदारचेतस्
उदारचेतस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದಾರವಾದ ಮನಸ್ಸುಳ್ಳ /ಧಾರಾಳ ಹೃದಯವುಳ್ಳ /ದೊಡ್ಡ ಮನಸ್ಸುಳ್ಳ<br><b>व्युत्पत्तिः - </b>उदारं चेतो यस्य<br><b>प्रयोगाः - </b>"उदारचेता गिरमित्युदाराम्"<br><b>उल्लेखाः - </b>किरा० ३-१०<br><br>

उदारता
उदारता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಔದಾರ್ಯ /ದಾನಶೀಲತೆ /ಕೊಡುವ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>उदारस्य भावः<br><br>उदारता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಂಭೀರ್ಯ<br><br>उदारता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌಂದರ್ಯ<br><b>प्रयोगाः - </b>"यत्प्रौढित्वमुदारता च वचसां यच्चार्थतो गौरवम्"<br><b>उल्लेखाः - </b>मालती० १-१०<br><br>उदारता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಠಿನವರ್ಣಗಳಿಂದ ಕೂಡಿದ ಶಬ್ದದಲ್ಲಿರುವ ವಿಕಟತ್ವ ಲಕ್ಷಣರೂಪವಾದ ಒಂದು ಶಬ್ದಗುಣ<br><b>प्रयोगाः - </b>"विकटत्वमुदारता"<br><b>उल्लेखाः - </b>का० सू० ३-१-२२<br><br>

उदारधी
उदारधी<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>उदारा सार्वज्ञ्यलक्षणा धीरस्य<br><b>प्रयोगाः - </b>"निमिषोऽनिमिषः स्रग्वी वाचस्पतिरुदारधीः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"सर्वोपजीव्यसार्वज्ञ्यादुच्यते स उदारधीः" - निरुक्तिः ।<br><br>उदारधी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತಮವಾದ ಬುದ್ಧಿ /ಧಾರಾಳವಾದ ಬುದ್ಧಿ<br><br>उदारधी<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತಮವಾದ ಬುದ್ಧಿಯುಳ್ಳ /ಉದಾರ ಬುದ್ಧಿಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>उदारा बुद्धिर्यस्य<br><br>

उदास
उदास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದಾಸೀನತೆ /ಉಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>उद् + आस (उपवेशने) - "घञ्" (३-३-१८)<br><br>उदास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿರಕ್ತ /ಪ್ರಾಪಂಚಿಕ ಸೌಖ್ಯವನ್ನು ತ್ಯಜಿಸುವ ಸಂನ್ಯಾಸಿ<br><br>उदास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಃಸ್ಪೃಹ /ಆಸೆಯಿಲ್ಲದವನು<br><b>निष्पत्तिः - </b>उद् + आस (उपवेशने) - कर्त० "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उदास्ते<br><br>उदास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದಾಸೀನ /ಯಾವ ಪಕ್ಷಕ್ಕೂ ಸೇರದವನು<br><br>

उदासित
उदासित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದಾಸೀನನಾಗಿರುವ /ಉಪೇಕ್ಷೆಯಿಂದಿರುವ<br><b>निष्पत्तिः - </b>उद् + आस (उपवेशने) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"उदासितेनैव मयेदमुद्यसे भिया न तेभ्यः स्मरतानवन्न वा"<br><b>उल्लेखाः - </b>नैष० ९-१३५<br><br>

उदासितृ
उदासितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದಾಸೀನ /ಉಪೇಕ್ಷೆಯಿಂದಿರುವವನು /ತಟಸ್ಥ<br><b>निष्पत्तिः - </b>उद् + आस (उपवेशने) - "तृच्" (३-१-१३३)<br><b>प्रयोगाः - </b>"उदासितारं निगृहीतमानसैर्गृहीतमध्यात्मदृशा कथञ्चन"<br><b>उल्लेखाः - </b>माघ० १-३३<br><br>

उदासीन
उदासीन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರು ಅಥವಾ ಮಿತ್ರ ರಾಷ್ಟ್ರಕ್ಕೆ ಆಚಿನ ರಾಷ್ಟ್ರದ ರಾಜ<br><b>निष्पत्तिः - </b>उद् + आस (उपवेशने) - "शानच्" (३-२-१२४) । ईत्वम् (७-२-८३)<br><b>व्युत्पत्तिः - </b>उदास्ते<br><b>विस्तारः - </b>"उदासीनः परतरः"- अम० ।<br><br>उदासीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಟಸ್ಥ /ಉಪೇಕ್ಷೆಯಿಂದ ಕೂಡಿದ /ಯಾವ ಚಿಂತೆಯೂ ಇಲ್ಲದ<br><b>प्रयोगाः - </b>"यानमाहुरुदासीनं त्वामुत्थापयति द्वयम्" । "कुमार, इह खलु अर्थशास्त्रव्यवहारिणामरिमित्रोदासीनव्य्वस्था" ।<br><b>उल्लेखाः - </b>माघ० २-५७, मुद्रा० ५<br><br>

उदास्थित
उदास्थित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತೀಹಾರ /ದ್ವಾರಪಾಲಕ<br><br>उदास्थित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಧ್ಯಕ್ಷ /ಮೇಲ್ವಿಚಾರಕ<br><br>उदास्थित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೂಢಾಚಾರ<br><br>उदास्थित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೂತ<br><b>विस्तारः - </b>"उदास्थितः प्रतीहारेऽध्यक्षे प्रणिधौ चरे" - विश्व० । "उदास्थितः प्रतीहारे चरभेदे च कीर्तितः" - शाश्व० ।<br><br>

उदाहरण
उदाहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಥನ /ವಿವರಣಪೂರ್ವಕ ಹೇಳುವುದು<br><br>उदाहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಭಾಷಣೆ<br><b>निष्पत्तिः - </b>उद् +आ + हृञ् (हरणे) - "ल्युट्"(३-३-११५)<br><b>व्युत्पत्तिः - </b>उदाह्रियते<br><b>प्रयोगाः - </b>"अथाङ्गिरसमग्रण्यमुदाहरणवस्तुषु"<br><b>उल्लेखाः - </b>कुमा० ६-६५<br><br>उदाहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಸಿದ್ಧಪಡಿಸುವ ವಾಕ್ಯ<br><b>प्रयोगाः - </b>"जयोदाहरणं बाह्वोर्गापयामास किङ्करान्"<br><b>उल्लेखाः - </b>रघु० ४-७८<br><br>उदाहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೃಷ್ಟಾಂತ<br><b>प्रयोगाः - </b>"प्रध्वंसितान्धतमसस्तत्रोदाहरणं रविः"<br><b>उल्लेखाः - </b>माघ० २-३३<br><br>उदाहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಾರ್ಕಿಕಮತದಲ್ಲಿ ಪ್ರತಿಜ್ಞಾದಿ ಪಂಚಾವಯವಗಳಲ್ಲೊಂದು<br><br>

उदाहार
उदाहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪೋದ್ಘಾತ /ಮಾತಿನ ಪ್ರಾರಂಭ<br><br>उदाहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೃಷ್ಟಾಂತ<br><b>निष्पत्तिः - </b>उद् +आ + हृञ् (हरणे) - "घञ्" (३-३-१८)<br><br>

उदाहृत
उदाहृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದಾಹರಿಸಲ್ಪಟ್ಟ<br><br>उदाहृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲ್ಪಟ್ಟ /ವಿವರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् +आ + हृञ् (हरणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"योऽङ्गीकृतगुणैः श्लाघ्यः सविस्मयमुदाहृतः"<br><b>उल्लेखाः - </b>किरा० ११-७२<br><br>

उदाहृति
उदाहृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉದಾಹರಣ ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>उद् +आ + हृञ् (हरणे) - "क्तिन्" (३-३-९४)<br><br>

उदित
उदित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಥನ /ವಿವರಣಪೂರ್ವಕ ಹೇಳುವುದು<br><b>निष्पत्तिः - </b>वद (व्यक्तायां वाचि) - भावे "क्तः" (३-३-११४)<br><br>उदित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>वद - कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"उदितं प्रियां प्रति सहार्दमिति श्रदधीयत प्रियतमेन वचः" । "भवादृशेषु प्रमदाजनोचितं भवत्यधिक्षेप इवानुशासनम्" ।<br><b>उल्लेखाः - </b>माघ० ९-६९, किरा० १-२८<br><br>उदित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದಯವನ್ನು ಹೊಂದಿದ /ಉದಯಿಸಿರುವ<br><b>निष्पत्तिः - </b>उद् +इण् (गतौ) - कर्त० "क्तः"(३-४-७२)<br><b>प्रयोगाः - </b>"उदिते ततः सपदि लब्धपदैः क्षणदाकरेऽनुपदिभिः" । "मन्दमन्दमुदितः प्रययौ" ।<br><b>उल्लेखाः - </b>माघ० ९-७०, किरा० ९-२६<br><br>उदित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎದ್ದಿರುವ /ಮೇಲಕ್ಕೆ ಹೊರಟಿರುವ /ಮೇಲಕ್ಕೆ ಹರಡಿರುವ<br><b>प्रयोगाः - </b>"व्यक्तोदितस्मितमयूखविभासितोष्ठः"<br><b>उल्लेखाः - </b>किरा० २-५९<br><br>उदित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉನ್ನತವಾದ /ಎತ್ತರವಾದ<br><b>प्रयोगाः - </b>"उदितोपलस्खलनसंवलिताः"<br><b>उल्लेखाः - </b>किरा० ६-४<br><br>उदित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಂಟಾದ /ಉತ್ಪನ್ನವಾದ /ಹುಟ್ಟಿದ<br><b>प्रयोगाः - </b>"उदितोरुसादमतिवेपथुमत्सुदृशोऽभिभर्तृ विधुरं त्रपया" । "उदितः प्रणवाङ्कुरात्मना त्वद्विविधस्कन्धविभक्तरूढशाखः" ।<br><b>उल्लेखाः - </b>माघ० ९-७७, याद० १५-१२<br><br>

उदित्वर
उदित्वर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹೋಗುವ ಸ್ವಭಾವದ /ಮೇಲುಮುಖವಾಗಿ ಹೋಗುವ<br><b>निष्पत्तिः - </b>उद् +इण् (गतौ) -"क्वरप्" (३-२-१६३)<br><b>प्रयोगाः - </b>"शशिमयं दहनास्त्रमुदित्वरं मनसिजस्य विमृश्य वियोगिनी"<br><b>उल्लेखाः - </b>नैष० ४-३८<br><br>

उदित्वरी
उदित्वरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹೋಗುವ ಸ್ವಭಾವದ /ಮೇಲುಮುಖವಾಗಿ ಹೋಗುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

उदीक्षण
उदीक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ನೋಡುವುದು<br><b>निष्पत्तिः - </b>उद् + ईक्ष (दर्शने) - भावे "ल्युट्" (३-३-११५)<br><br>उदीक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಪನೆ /ಊಹೆ<br><br>उदीक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಸ್ತುವಾರಿ ನೋಡಿಕೊಳ್ಳುವಿಕೆ /ಎಚ್ಚರಿಕೆಯಿಂದ ನೋಡಿಕೊಳ್ಳುವಿಕೆ<br><br>

उदीक्षमाण
उदीक्षमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ನೋಡುತ್ತಿರುವ<br><br>उदीक्षमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಹಿಸುತ್ತಿರುವ /ಕಲ್ಪನೆ ಮಾಡುತ್ತಿರುವ<br><br>उदीक्षमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಸ್ತುವಾರಿ ನೋಡಿಕೊಳ್ಳುತ್ತಿರುವ /ಎಚ್ಚರಿಕೆಯಿಂದ ನೋಡಿಕೊಳ್ಳುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + ईक्ष (दर्शने) - "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"क्षत्रधर्मे स्थितो भूत्वा यथाशास्त्रं यथाविधि । उदीक्षमाणः पृतनां जयामि युधि वासव ॥"<br><b>उल्लेखाः - </b>भा० शान्ति० ९८-९<br><br>

उदीक्ष्य
उदीक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಹಿಸಲು ಅರ್ಹವಾದ<br><br>उदीक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲೆ ನೋಡಲು ಅರ್ಹವಾದ<br><b>निष्पत्तिः - </b>उद् + ईक्ष (दर्शने) - "ण्यत्" (३-१-१२४)<br><br>उदीक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡಿ /ಮೇಲೆ ನೋಡಿ<br><b>निष्पत्तिः - </b>उद् + ईक्ष (दर्शने) - "ल्यप्" (७-१-३७)<br><br>

उदीची
उदीची<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರದಿಕ್ಕು<br><b>निष्पत्तिः - </b>उद् +अञ्चु (गतौ) - "ईत्" (६-४-१३९) । "ङीप्" (४-१-६)<br><b>व्युत्पत्तिः - </b>उद् उत्तरमञ्चत्यर्कम्<br><b>प्रयोगाः - </b>"आसाद्य वाचं स भृशं दिदीपे काष्ठामुदीचीमिव तिग्मरश्मिः"<br><b>उल्लेखाः - </b>किरा० ३-५५<br><br>

उदीचीन
उदीचीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರದೇಶದಲ್ಲಿರುವ<br><br>उदीचीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರ ದೇಶದ<br><br>उदीचीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರ ಕಾಲದ<br><b>निष्पत्तिः - </b>"खः" (५-४-८)<br><b>व्युत्पत्तिः - </b>उदीच्यां भवः<br><br>

उदीच्य
उदीच्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರ ದೇಶದಲ್ಲಿರುವ<br><br>उदीच्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರ ದಿಕ್ಕಿನಲ್ಲಿರುವ<br><br>उदीच्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರ ಕಾಲದ<br><b>निष्पत्तिः - </b>"यत्" (४-२-१०१)<br><b>व्युत्पत्तिः - </b>उदीच्यां भवः<br><b>प्रयोगाः - </b>"शरैरस्रैरिवोदीच्यानुद्धरिष्यन् रसानिव"<br><b>उल्लेखाः - </b>रघु० ४-६६<br><br>

उदीत
उदीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಪನ್ನವಾದ /ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>उद् + ईङ् (गतौ) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"नृपः स पश्यन्नपि तामुदीतस्तम्भो न धर्तुं सहसा शशाक"<br><b>उल्लेखाः - </b>नैष० ६-५२<br><br>

उदीप
उदीप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ಹರಿದು ಬರುವ ಸ್ಥಳ /ಪ್ರವಾಹದಿಂದ ಕೂಡಿದ ಪ್ರದೇಶ<br><b>निष्पत्तिः - </b>समासान्तः "अः" (५-४-७४) । "ईत्" (६-३-९७)<br><b>व्युत्पत्तिः - </b>उद्गता आपो यत्र<br><br>

उदीयमान
उदीयमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದಯಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>ईङ् (गतौ) -कर्त० "शानच्" (३-२-१२४)<br><b>व्युत्पत्तिः - </b>उदीयते<br><b>प्रयोगाः - </b>"रिपुतिमिरमुदस्योदीयमानं दिनादौ दिनकृतमिव लक्ष्मीस्त्वां समभ्येतु भूयः"<br><b>उल्लेखाः - </b>किरा० १-४६<br><br>

उदीरण
उदीरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಚ್ಚಾರಣ<br><b>निष्पत्तिः - </b>उद् + ईर (गतौ) + णिच् - "ल्युट्"(३-३-११५)<br><b>प्रयोगाः - </b>"उद्घातः प्रणवो यासां न्यायैस्त्रिभिरुदीरणम्"<br><b>उल्लेखाः - </b>कुमा० २-१२<br><br>

उदीरणा
उदीरणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಚ್ಚಾರಣ<br><b>निष्पत्तिः - </b>स्त्रियां "युच्" (३-३-१०७)<br><br>

उदीरयत्
उदीरयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಟಗೊಳಿಸುತ್ತಿರುವ /ಪ್ರತ್ಯಕ್ಷವಾಗಿ ತೋರಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + ईर (गतौ) + णिच् - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"तिसृभिस्त्वमवस्थाभिर्महिमानमुदिरयन्"<br><b>उल्लेखाः - </b>कुमा० २-६<br><br>

उदीरित
उदीरित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾತು<br><b>निष्पत्तिः - </b>उद् + ईर (गतौ) + णिच् - भावे "क्तः" (३-३-११४)<br><br>उदीरित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಚ್ಚರಿಸಲ್ಪಟ್ಟ /ಹೇಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + ईर (गतौ) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"उदीरितां तामिति याज्ञसेन्या"<br><b>उल्लेखाः - </b>किरा० ३-५५<br><br>उदीरित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ರೇಕಗೊಳಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"कथं न मन्युः ज्वलयत्युदीरितः शमीतरुं शुष्कमिवाग्निरुच्छिखः"<br><b>उल्लेखाः - </b>किरा० १-३२<br><br>उदीरित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಂಟುಮಾಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"मृदुचलदपरान्तोदीरितान्दूनिनादम्"<br><b>उल्लेखाः - </b>माघ० ११-७<br><br>उदीरित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೇರಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अभिलाषमुदीरितेन्द्रियः"<br><b>उल्लेखाः - </b>कुमा० ४-४१<br><br>उदीरित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಬ್ಬಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"यावद्व्यगाहन्त न दन्तिनां घटास्तुरङ्गमैस्तावदुदीरितं खुरैः"<br><b>उल्लेखाः - </b>माघ० १२-५८<br><br>

उदीर्ण
उदीर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>उद् + ऋ (गतौ) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"उदीर्णः सर्वतश्चक्षुरनीशः शाश्वतस्थिरः"<br><b>उल्लेखाः - </b>वि० स०<br><br>उदीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆಳೆದಿರುವ /ಮೇಲಕ್ಕೆ ಎದ್ದಿರುವ<br><br>उदीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಟ್ಟಿದ /ಉಂಟಾದ<br><b>प्रयोगाः - </b>"आकम्प्राग्रैः केतुभिः सन्निपातं तारोदीर्णग्रैवनादं व्रजन्तः"<br><b>उल्लेखाः - </b>माघ० १८-३७<br><br>उदीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ರೇಕಗೊಂಡ /ಬಲಗೊಂಡ<br><b>प्रयोगाः - </b>"उदीर्णरागप्रतिरोधकं जनैरभीक्ष्णमक्षुण्णतयातिदुर्गमम्"<br><b>उल्लेखाः - </b>माघ० १-३२<br><br>उदीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಿದ /ಅಧಿಕವಾದ<br><br>उदीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿರಿದಾದ /ದೊಡ್ಡದಾದ<br><br>उदीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಚ್ಚರಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अनिदीर्णवर्णनिभृतार्थमाह्वयत्"<br><b>उल्लेखाः - </b>माघ० १३-४२<br><br>उदीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಬ್ಬಿದ /ಗರ್ವಗೊಂಡ<br><b>प्रयोगाः - </b>"भवल्लब्धवरोदीर्णस्तारकाख्यो महासुरः"<br><b>उल्लेखाः - </b>कुमा० २-३२<br><br>

उदुम्बर
उदुम्बर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತ್ತಿಮರ<br><b>निष्पत्तिः - </b>वृञ् (वरणे) - "खच्" (३-२-४६) । मुम् (६-३-६७)<br><b>व्युत्पत्तिः - </b>उं शम्भुं वृणोति । उत्कृष्टमुम्बरम् ।<br><br>उदुम्बर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹಳಿ /ಹೊಸ್ತಲು<br><br>उदुम्बर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಷಂಡ /ನಪುಂಸಕ<br><br>उदुम्बर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಷ್ಠರೋಗ<br><br>उदुम्बर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಮ್ರ<br><br>उदुम्बर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅತ್ತಿಹಣ್ಣು<br><b>विस्तारः - </b>"उदुम्बरतु देहल्यां वृक्षजातौ च षण्डके । उदुम्बरं स्मतं ताम्रे कुष्ठभेदेऽप्युदुम्बरः" - विश्व० ।<br><br>

उदूखल
उदूखल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒರಳು<br><b>निष्पत्तिः - </b>ला (आदाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>ऊर्ध्वं‍च तत् खं च । ऊर्ध्वखं लाति<br><br>उदूखल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಗ್ಗುಳ /ಸುಗಂಧದ್ರವ್ಯ<br><b>विस्तारः - </b>"उदूखलं गुग्गुलौ स्यादुलूखलेऽपि न द्वयोः" - मेदि० ।<br><br>

उदूढ
उदूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧರಿಸಿರುವ /ಹೊಂದಿರುವ<br><b>निष्पत्तिः - </b>उद् + वह (प्रापणे) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"उदूढलोकत्रितयेन साम्प्रतं गुरुर्धरित्री क्रियतेतरां त्वया"<br><b>उल्लेखाः - </b>माघ० १-३६<br><br>उदूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಥೂಲವಾದ /ದಪ್ಪವಾದ<br><br>उदूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮದುವೆಯಾದ /ವಿವಾಹಿತನಾದ<br><br>उदूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉನ್ನತವಾದ /ಎತ್ತರವಾದ<br><b>प्रयोगाः - </b>"उदूढवक्षःस्थगितैकदिङ्मुखः"<br><b>उल्लेखाः - </b>किरा० १४-३१<br><br>

उदूढा
उदूढा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹಿತ ಹೆಂಗಸು<br><b>विस्तारः - </b>"उदूरः पीवरोढयोः" - हेम० ।<br><br>

उदेजय
उदेजय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ವೇಗವುಂಟುಮಾಡುವ /ನಡುಕವುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>उद् + एजृ (कम्पने) -"खश्" (३-२-२८)<br><b>प्रयोगाः - </b>"उदेजयान् भूतगणान् न्यषेधीत्"<br><b>उल्लेखाः - </b>भट्टि० १-१५<br><br>

उद्गत
उद्गत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎದ್ದಿರುವ /ಮೇಲಕ್ಕೆ ಹೊರಟಿರುವ /ಮೇಲಕ್ಕೆ ಹರಡಿರುವ<br><b>निष्पत्तिः - </b>उद् + गम्लृ (गतौ) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"केलिशैलमणिमेखलापदादुद्गतामिह तमालवाटिकाम्"<br><b>उल्लेखाः - </b>याद० १७-२२<br><br>उद्गत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದಯಿಸಿರುವ<br><b>प्रयोगाः - </b>"उद्गतेन्दुमविभिन्नतमिस्राम्"<br><b>उल्लेखाः - </b>किरा० ९-२४<br><br>उद्गत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಪನ್ನವಾದ /ಹುಟ್ಟಿದ<br><br>उद्गत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಂತಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + गम्लृ (गतौ) - "क्तः" (३-२-१०२)<br><br>

उद्गति
उद्गति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉದಯ<br><br>उद्गति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿ /ಹುಟ್ಟುವಿಕೆ<br><br>उद्गति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏಳುವುದು<br><br>उद्गति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಂತಿ ಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + गम्लृ (गतौ) - "क्तिन्" (३-३-९४)<br><br>

उदगत्वर
उदगत्वर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹೋಗುವ ಸ್ವಭಾವದ /ಊರ್ಧ್ವಗಾಮಿಯಾದ<br><b>निष्पत्तिः - </b>उद् + गम्लृ (गतौ) - "क्वरप्" अनुनासिकलोपश्च (३-२-१६४) निपा० ।<br><br>

उद्गत्वरी
उद्गत्वरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹೋಗುವ ಸ್ವಭಾವದ /ಊರ್ಧ್ವಗಾಮಿಯಾದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्"(४-१-१५)<br><b>प्रयोगाः - </b>"उद्गत्वरीभिच्छुरितं वितेने निजं वपुर्वायुसखः शिखाभिः"<br><b>उल्लेखाः - </b>नैष० १४-६३<br><br>

उद्गम
उद्गम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿ /ಹುಟ್ಟುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + गम्लृ (गतौ) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"कुतो वा महोदधिं वर्जयित्वा पारिजातस्योद्गमः"<br><b>उल्लेखाः - </b>मालती० २<br><br>उद्गम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎದ್ದಿರುವಿಕೆ /ಚಾಚಿಕೊಂಡಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"बाहुबन्धनापवारुतपयोधरोद्गमम्"<br><b>उल्लेखाः - </b>मालती० ७<br><br>उद्गम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಕುರ /ಮೊಳಕೆ<br><b>प्रयोगाः - </b>"परिसरविषयेषु लीढमुक्ता हरिततृणोद्गमशङ्कया मृगीभिः"<br><b>उल्लेखाः - </b>किरा० ५-३८<br><br>उद्गम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎದ್ದು ನಿಲ್ಲುವಿಕೆ /ಮೇಲಕ್ಕೆ ಹೊರಟು ಬರುವಿಕೆ<br><b>प्रयोगाः - </b>"रोमोद्गमः प्रादुरभूदुमायाः"<br><b>उल्लेखाः - </b>कुमा० ७-७७<br><br>

उद्गमन
उद्गमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>उद्गम ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>उद् + गम्लृ (गतौ) - भावे "ल्युट्" (३-३-११५)<br><br>

उद्गमनीय
उद्गमनीय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಗೆದು ಶುದ್ಧ ಮಾಡಿದ ಒಂದು ಜೊತೆ ಪಂಚೆ<br><b>निष्पत्तिः - </b>उद् + गम्लृ (गतौ) - "अनीयर्" (३-१-९६)<br><b>व्युत्पत्तिः - </b>उद्गम्यते<br><b>प्रयोगाः - </b>"सा मङ्गलस्नानविशुद्धागात्री गृहीतपत्युद्गमनीयवस्त्रा"<br><b>उल्लेखाः - </b>कुमा० ७-११<br><br>उद्गमनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹೊರಡಿಸಲು ಯೋಗ್ಯವಾದ<br><br>

उद्गमित
उद्गमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹೊರಡಿಸಲ್ಪಟ್ಟ /ಮೇಲಕ್ಕೆ ಎಬ್ಬಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + गम्लृ (गतौ) +णिच् - "क्तः" (३-२-०१२)<br><b>प्रयोगाः - </b>"नैनं त्यज क्षीरधिमन्थनाद्यैरस्यानुजायोद्गमितामरैः श्रीः"<br><b>उल्लेखाः - </b>नैष० ६-८०<br><br>

उद्गाढ
उद्गाढ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಿಗೆ /ಅತಿಶಯ<br><br>उद्गाढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾದ /ಅತಿಶಯವಾದ<br><b>निष्पत्तिः - </b>उद् + गाहू (विलोडने) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"प्रेमार्द्राः प्रणयस्पृशः परिचयादुद्गाढरागोदयाः"<br><b>उल्लेखाः - </b>मालती० ५-७<br><br>उद्गाढ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾಗಿ /ಅತಿಶಯವಾಗಿ<br><br>

उद्गातृ
उद्गातृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗದಲ್ಲಿ ಸಾಮವೇದ ಗಾನಮಾಡುವವನು<br><b>निष्पत्तिः - </b>गै (शब्दे) - "तृच्" (उ० २-९४)<br><b>व्युत्पत्तिः - </b>उद्गायति साम<br><b>विस्तारः - </b>"अध्वर्यूद्गातृहोतारो यजुःसामर्ग्विदः क्रमात्" - अम० ।<br><br>

उद्गार
उद्गार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಕ್ಕುವಿಕೆ /ವಾಂತಿ ಮಾಡುವಿಕೆ/ಬಾಯಿಂದ ಹೊರಕ್ಕೆ ಹೊರಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + गॄ (निगरणे) - "घञ्" (३-३-३९)<br><b>प्रयोगाः - </b>"खर्जूरीस्कन्धनद्धानां मदोद्गारसुगन्धिशु" । "सनिर्झरोद्गार इवाद्रिराजः" ।<br><b>उल्लेखाः - </b>रघु० ४-५७, रघु० ६-६०<br><br>उद्गार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತಿ ಹೇಳುವುದು /ಉದಾಹರಿಸುವುದು<br><b>प्रयोगाः - </b>"पुरावृत्तोद्गारैरपि च कथिता कार्यपदवी"<br><b>उल्लेखाः - </b>मालती० २-१३<br><br>उद्गार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಗುಳು<br><br>उद्गार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೇಗು<br><br>उद्गार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಠಧ್ವನಿ /ಶಬ್ದ<br><br>उद्गार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಧ್ವನಿ /ಎದುರು ಶಬ್ದ<br><b>प्रयोगाः - </b>"गम्भीरगद्गदोद्गारघोरघोषणगोदावरीमुखरितविशालमेखलाभुवः"<br><b>उल्लेखाः - </b>मालती० ९<br><br>

उद्गारशोधन
उद्गारशोधन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿ ಜೀರಿಗೆ<br><br>

उद्गारिन्
उद्गारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಂತಿ ಮಾಡುವ<br><b>निष्पत्तिः - </b>उद् + गॄ (निगरणे) - "णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"धारास्वनोद्गारिदरीमुखोऽसौ शृङ्गाग्रलग्नाम्बुदवप्रसङ्गः"<br><b>उल्लेखाः - </b>रघु० १३-४७<br><br>

उद्गिरण
उद्गिरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಕ್ಕುವುದು /ವಾಂತಿ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>उद् + गॄ (निगरणे) - "ल्युट्" (३-३-११५)<br><br>उद्गिरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಗುಳುವುದು<br><br>उद्गिरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೇಗುವುದು<br><br>

उद्गिरत्
उद्गिरत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಂತಿ ಮಾಡುತ್ತಿರುವ /ಕಕ್ಕುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + गॄ (निगरणे) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"अभ्युन्नताङ्गुष्ठनखप्रभाभिर्निक्षेपणाद्रागमिवोद्गिरन्तौ"<br><b>उल्लेखाः - </b>कुमा० १-३३<br><br>उद्गिरत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಗುಳುತ್ತಿರುವ<br><br>उद्गिरत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೇಗುತ್ತಿರುವ<br><br>

उद्गिरन्ती
उद्गिरन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उद्गिरत् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><b>प्रयोगाः - </b>"इत्थं मधूत्थं रसमुद्गिरन्ती तदोष्ठबन्धूकधनुर्विसृष्टा"<br><b>उल्लेखाः - </b>नैष० ८-५०<br><br>

उद्गीति
उद्गीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾದ ಸ್ವರದಿಂದ ಗಾನ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>उद् + गै (शब्दे) - "क्तिन्" (३-३-९४)<br><br>उद्गीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾತ್ರಾ ಛಂದಸ್ಸಿನ ಒಂದು ವೃತ್ತ<br><br>

उद्गीयमान
उद्गीयमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಾಡಲ್ಪಡುತ್ತಿರುವ /ಗಾನದಿಂದ ಹೊಗಳಲ್ಪಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + गै (शब्दे) - कर्म० "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"शुश्राव कुञ्जेषु यशः स्वमुच्चैरुद्गीयमानं वनदेवताभिः"<br><b>उल्लेखाः - </b>रघु० २-१२<br><br>

उद्गीर्ण
उद्गीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಕ್ಕಲ್ಪಟ್ಟ /ವಾಂತಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + गॄ (निगरणे) - "क्तः" (३-२-१०२)<br><br>उद्गीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹೊರಡಿಸಲ್ಪಟ್ಟ /ಮೇಲಕ್ಕೆ ಎಬ್ಬಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"प्रशमादर्चिषामेतदनुद्गीर्णसुरायुधम्"<br><b>उल्लेखाः - </b>कुमा० २-२०<br><br>

उद्गूर्ण
उद्गूर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + गुरी (उद्यमने) - "क्तः" (३--१०२)<br><b>व्युत्पत्तिः - </b>उद्गूर्यते<br><b>प्रयोगाः - </b>"उद्गूर्णलोष्टलगुडैः परितोऽनुविद्धम्" । "क्रोधाद्गूर्णगदस्य नास्ति सदृशः सत्यं रणे मारुतेः" ।<br><b>उल्लेखाः - </b>माघ० ५-२५, वेणी० ६-१३<br><br>

उद्ग्रथित
उद्ग्रथित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಿ ಕಟ್ಟಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + ग्रन्थ (बन्धने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"लताप्रतानोद्ग्रथितैः स केशैः अधिज्यधन्वा विचचार दावम्"<br><b>उल्लेखाः - </b>रघु० २-८<br><br>

उद्ग्रन्थ
उद्ग्रन्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಡುಗಡೆ<br><br>उद्ग्रन्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡಿಸಲ್ಪಟ್ಟ /ಸಡಿಲಿಸಲ್ಪಟ್ಟ<br><br>उद्ग्रन्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಿನ ದರ್ಜೆಯ ಗ್ರಂಥ<br><br>उद्ग्रन्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗ್ರಂಥವನ್ನು ಮೀರಿದ /ಗ್ರಂಥಕ್ಕೆ ವಿರುದ್ಧವಾದ<br><br>

उद्ग्रन्थि
उद्ग्रन्थि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಡುಗಡೆ /ಬಂಧನದಿಂದ ವಿಮೋಚನೆ<br><br>

उद्ग्राह
उद्ग्राह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತುವುದು<br><b>निष्पत्तिः - </b>उद् + ग्रह (उपादाने) - "घञ्" (३-३-३५)<br><br>

उद्ग्राहित
उद्ग्राहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲ್ಪಟ್ಟ<br><br>उद्ग्राहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಟ್ಟಲ್ಪಟ್ಟ<br><br>उद्ग्राहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಳ್ಳುವಂತೆ ಮಾಡಲ್ಪಟ್ಟ /ಗ್ರಹಿಸುವಂತೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + ग्रह (उपादाने) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"उदीरितां तामिति याज्ञसेन्या नविकृतोद्ग्राहितविप्रकाराम्"<br><b>उल्लेखाः - </b>किरा० ३-५५<br><b>विस्तारः - </b>"उद्ग्राहितमुदीर्णे स्याद्बद्धग्राहितयोस्त्रिषु" - मेदि० ।<br><br>

उद्ग्रीव
उद्ग्रीव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲ್ಪಟ್ಟ ಕತ್ತುಳ್ಳ /ಕತ್ತನ್ನು ಮೇಲಕ್ಕೆ ಎತ್ತಿರುವ<br><b>व्युत्पत्तिः - </b>उद्गता ग्रीवा यस्य<br><b>प्रयोगाः - </b>"उद्ग्रीवैर्घनरवशङ्कया मयूरैः"<br><b>उल्लेखाः - </b>किरा० ७-२२<br><br>

उद्घ
उद्घ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಶಂಸೆ /ಹೊಗಳಿಕೆ<br><br>उद्घ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಸ್ತಪುಟ /ಅಂಗೈ<br><br>उद्घ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶರೀರದೊಳಗಿನ ವಾಯು<br><b>निष्पत्तिः - </b>उद् + हन (हिंसागत्योः) - कर्म० "अप्" (३-३-८६) निपा० ।<br><b>व्युत्पत्तिः - </b>उद्धन्यते उत्कृष्टो ज्ञायते<br><b>विस्तारः - </b>"मतल्लिकादयो नियतलिङ्गाः न तु विशेष्यलिङ्गाः" - सि० कौ० ।<br><br>उद्घ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ<br><b>विस्तारः - </b>"उद्घो हस्तपुटे वह्नौ श्लाघायां देहजानिले" - हेम० । "उद्घः स्याद्देहजानिले । अग्नौ हस्तपुटे शस्तेऽपि" - मेदि० ।<br><br>उद्घ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಶಸ್ತವಾದ /ಶ್ರೇಷ್ಠವಾದ<br><br>

उद्घटन
उद्घटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರ್ಪಡಿಸುವಿಕೆ /ಪ್ರತ್ಯೇಕಮಾಡುವಿಕೆ<br><br>उद्घटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಳ ತೆಗೆಯುವಿಕೆ<br><br>उद्घटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕದವು ತೆಗೆಯುವಿಕೆ<br><br>उद्घटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಯಿ ತೆರೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + घट (भाषार्थे) + णिच् - "ल्युट्" (३-३-११५)<br><br>

उद्घटित
उद्घटित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರ್ಪಡಿಸಲ್ಪಟ್ಟ<br><br>उद्घटित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಳ ತೆಗೆಯಲ್ಪಟ್ಟ<br><br>उद्घटित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕದವು ತೆಗೆಯಲ್ಪಟ್ಟ<br><br>उद्घटित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾಯಿ ತೆರೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + घट (भाषार्थे) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"वर्गावुभौ देवमहीधराणां द्वारे पुरस्योद्घटितापिधाने"<br><b>उल्लेखाः - </b>कुमा० ७-५३<br><br>

उद्घट्टन
उद्घट्टन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಹಾರ /ಏಟು /ಹೊಡೆತ<br><b>निष्पत्तिः - </b>उद् + घट्ट (चलने) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"तत्रावश्यं वलयकुलिशोद्घट्टनोद्गीर्णतोयं नेष्यन्ति त्वां सुरयुवतयो यन्त्रधारागृहत्वम्"<br><b>उल्लेखाः - </b>मेघ० १-६१<br><br>उद्घट्टन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಳ ತೆಗೆಯುವಿಕೆ<br><br>उद्घट्टन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕದವು ತೆಗೆಯುವಿಕೆ<br><br>उद्घट्टन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಯಿ ತೆರೆಯುವಿಕೆ<br><br>उद्घट्टन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರ್ಪಡಿಸುವಿಕೆ /ಪ್ರತ್ಯೇಕಮಾಡುವಿಕೆ<br><br>

उद्घट्टित
उद्घट्टित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಡೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + घट्ट (चलने) - "क्तः" (३-२-१०२)<br><br>उद्घट्टित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕದವು ತೆಗೆಯಲ್ಪಟ್ಟ<br><br>उद्घट्टित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಳ ತೆಗೆಯಲ್ಪಟ್ಟ<br><br>उद्घट्टित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾಯಿ ತೆರೆಯಲ್ಪಟ್ಟ<br><br>उद्घट्टित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯೇಕಗೊಳಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अनुकृतिमनुवेलं घट्टितोद्घट्टितस्य व्रजति नियमभाजां मुग्धमुक्तापुटस्य"<br><b>उल्लेखाः - </b>माघ० ११-४२<br><br>

उद्घन
उद्घन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರಗೆಲಸ ಮಾಡುವಾಗ ಕೆಳಗೆ ಇಟ್ಟುಕೊಳ್ಳುವ ಅಡಿತುಂಡು<br><b>निष्पत्तिः - </b>उद् +हन (हिंसागत्योः) - अधि० "अप्" (३-३-८०)<br><b>व्युत्पत्तिः - </b>ऊर्ध्वं‍ हन्यतेऽत्र<br><br>

उद्घर्षण
उद्घर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನವೆ ಹೋಗುವುದಕ್ಕಾಗಿ ಕೆರೆಯುವುದು<br><br>उद्घर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೈ ಕೊಳೆ ಹೋಗುವುದಕ್ಕಾಗಿ ತಿಕ್ಕುವುದು<br><b>निष्पत्तिः - </b>उद् + घृषु (सङ्घर्षे) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"उद्घर्षणं तु विज्ञेयं कण्डूकीटमलापहम्"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

उद्घाटक
उद्घाटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾವಿಯ ಹಗ್ಗ<br><br>उद्घाटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಏತದ ಕೊಳಗ /ಏತದ ಮೂಲಕ ನೀರನ್ನು ಮೇಲಕ್ಕೆ ಎತ್ತುವ ತೊಟ್ಟಿ<br><br>उद्घाटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೀಗದ ಕೈ<br><b>प्रयोगाः - </b>"उद्घाटको भवति यन्त्रदृढे कपाटे"<br><b>उल्लेखाः - </b>मृच्छक० ३-१६<br><br>उद्घाटक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾವಿಯಿಂದ ನೀರನ್ನು ಸೇದುವವನು /ಏತದ ಮೂಲಕ ಬಾವಿಯ ನೀರನ್ನು ಎತ್ತುವವನು<br><br>उद्घाटक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಗೆಯುವವನು /ತೆರೆಯುವವನು<br><b>निष्पत्तिः - </b>उद् + घट (सङ्घाते) +णिच् - "ण्वुल्" (३-१-१३३)<br><br>उद्घाटक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಟಿಸುವ /ಪ್ರಕಾಶಗೊಳಿಸುವ /ಬಹಿರಂಗ ಪಡಿಸುವ<br><br>

उद्घाटन
उद्घाटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೆರೆಯುವುದು /ಮುಚ್ಚಿರುವ ಬಾಗಿಲನ್ನು ತೆಗೆಯುವುದು<br><b>निष्पत्तिः - </b>उद् + घट (सङ्घाते) +णिच् - भावे "ल्युट्" (३-३-११५)<br><br>उद्घाटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸುವುದು /ಪ್ರಕಟಿಸುವುದು<br><b>प्रयोगाः - </b>"द्यूतसभाद्यपकारस्थानोद्घाटनमेवेदं मन्ये"<br><b>उल्लेखाः - </b>वेणी० १<br><br>उद्घाटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಏತದ ಕೊಳಗ /ಏತದ ಮೂಲಕ ನೀರನ್ನು ಎತ್ತುವ ತೊಟ್ಟಿ<br><br>उद्घाटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಏತದ ರಾಟೆ<br><br>

उद्घाटित
उद्घाटित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಗೆಯಲ್ಪಟ್ಟ /ತೆರೆಯಲ್ಪಟ್ಟ ಬಾಗಿಲು<br><b>निष्पत्तिः - </b>उद् + घट (सङ्घाते) + णिच् - "क्तः" (३-२-१०२)<br><br>उद्घाटित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸಲ್ಪಟ್ಟ<br><br>उद्घाटित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲ್ಪಟ್ಟ<br><br>

उद्घात
उद्घात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ /ಉಪಕ್ರಮ<br><b>निष्पत्तिः - </b>उद् + हन (हिंसागत्योः) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"उद्घातः प्रणवो यासां न्यायैस्त्रिभिरुदीरणम्" । "आकुमारकथोद्घातं शालिगोप्यो जगुर्यशः" ।<br><b>उल्लेखाः - </b>कुमा० २-१२, रघु० ४-२०<br><br>उद्घात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಲುಕಾಟ /ಅದುರುವಿಕೆ<br><b>प्रयोगाः - </b>"ययावनुद्घातसुखेन मार्गं स्वेनैव पूर्णेन मनोरथेन"<br><b>उल्लेखाः - </b>रघु० २-७२<br><br>उद्घात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುತ್ತಿಗೆ /ಕೊಡತಿ /ಚಮ್ಮಟಿಗೆ<br><br>उद्घात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲು ಜಾರುವುದು /ಎಡಹುವುದು<br><br>उद्घात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಣವಾಯುವಿನಿಂದ ನೂಕಲ್ಪಟ್ಟ ಅಪಾನವಾಯುವುದು ಶಿರಸ್ಸಿನವರೆಗೂ ಹೋಗಿ ಹಿಂತಿರುಗುವಿಕೆ<br><br>उद्घात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎತ್ತರವಾದ /ಉನ್ನತವಾದ<br><b>विस्तारः - </b>"उद्घातस्तु पुमान् पादस्खलने समुपक्रमे । पवनाभ्यासयोगाय कुम्भकादित्रयेऽपि च । उत्तुङ्ङे मुद्गरेऽपि स्यात्" - मेदि० ।<br><br>

उद्घुषित
उद्घुषित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಪ್ರಾಯವನ್ನು ತಿಳಿಸಿದ ಮಾತು /ಆಶಯವನ್ನು ಹೊರಪಡಿಸಿದ ಮಾತು<br><br>उद्घुषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಟಪಡಿಸಲ್ಪಟ್ಟ /ಸಾರಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + घुषिर् (विशब्दने) - "क्तः" (३-२-१०२)<br><br>

उद्घुष्ट
उद्घुष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ ಕೂಗಿ ಮಾಡಲ್ಪಟ್ಟ ಶಬ್ದ /ಗಟ್ಟಿಯಾಗಿ ಹೇಳಲ್ಪಟ್ಟ ಮಾತು<br><br>उद्घुष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಸೆಯಲ್ಪಟ್ಟ /ತಯಾರಿಸಲ್ಪಟ್ಟ ಹಗ್ಗ<br><br>

उद्घोष
उद्घोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ ಶಬ್ದ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>उद् + घुषिर् (अविशब्दने) - "घञ्" (३-३-१८)<br><br>उद्घोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾರುವುದು /ಡಂಗುರ ಹಾಕುವುದು<br><br>

उद्घोषक
उद्घोषक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ ಶಬ್ದ ಮಾಡುವ /ಗಟ್ಟಿಯಾಗಿ ಕೂಗಿ ಹೇಳುವ<br><b>निष्पत्तिः - </b>उद् + घुषिर् (अविशब्दने) - "ण्वुल्" (३-१-१३३)<br><br>उद्घोषक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಡಂಗುರ ಹೊಡೆಯುವ /ಸಾರುವ /ಬಹಿರಂಗ ಪಡಿಸುವ<br><br>

उद्घोषण
उद्घोषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾರುವಿಕೆ /ಡಂಗುರ ಹೊಡೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + घुषिर् (अविशब्दने) - "ल्युट्" (३-३-११५)<br><br>उद्घोषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ ಕೂಗಿ ಹೇಳುವಿಕೆ /ಗಟ್ಟಿಯಾಗಿ ಶಬ್ದ ಮಾಡುವಿಕೆ<br><br>

उद्घोषणा
उद्घोषणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उद्घोषण ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>उद् + घुषिर् (अविशब्दने) + णिच् - "युच्" (३-३-१०७)<br><br>

उद्दंश
उद्दंश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿಗಣೆ<br><br>उद्दंश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೇನು<br><br>उद्दंश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಶಕ<br><b>निष्पत्तिः - </b>उद् + दंश (दशने) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उद्दिशति<br><br>

उद्दण्ड
उद्दण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತರವಾದ ಕೋಲು<br><br>उद्दण्ड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಚಂಡ /ಭಯಂಕರ<br><br>उद्दण्ड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಕ್ಷೆಗೂ ಒಳಪಡದ<br><b>व्युत्पत्तिः - </b>उत्क्रान्तो दण्डं दमनम्<br><br>उद्दण्ड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ದವಾದ ಕೋಲುಳ್ಳ /ಉದ್ದವಾದ ತೊಟ್ಟುಳ್ಳ<br><b>व्युत्पत्तिः - </b>उद्गतो दण्डो यस्य<br><br>

उद्दमित
उद्दमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಡಗಿಸಲ್ಪಟ್ಟ /ಶಿಕ್ಷಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + दमु (उपशमे) - "क्तः" (३-२-१०२)<br><br>

उद्दान
उद्दान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಧನ /ಕಟ್ಟು<br><b>निष्पत्तिः - </b>उद् + दो (अवखण्डने) - "ल्युट्" (३-३-११५)<br><br>उद्दान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ಯಮ /ಪ್ರಯತ್ನ<br><br>उद्दान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಲೆ<br><br>उद्दान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಡಬಾಗ್ನಿ<br><br>उद्दान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಧ್ಯಭಾಗ /ಸೊಂಟ /ನಡು<br><br>

उद्दान्त
उद्दान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>उद्दमित ಪದದ ಅರ್ಥ<br><br>

उद्दाम
उद्दाम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರುಣ<br><br>उद्दाम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಂಡಕದ ಒಂದು ಭೇದ<br><b>प्रयोगाः - </b>"यदि नयुगलं ततः सप्तरेफास्तदा चण्डवृष्टिप्रयातो भवेद्दण्डकः । प्रतिचरणविवृद्धरेफाः स्युरर्णार्णवव्यालजीमूतलीलाकरोद्दामशङ्खादयः"<br><b>उल्लेखाः - </b>वृ० र०<br><br>उद्दाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಂಧನವಿಲ್ಲದ<br><br>उद्दाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಡ್ಡಿಯಿಲ್ಲದ /ಸ್ವತಂತ್ರವಾದ<br><b>निष्पत्तिः - </b>समासान्तोऽच् ।<br><b>व्युत्पत्तिः - </b>उद्गतं दाम्नः<br><b>प्रयोगाः - </b>"उद्दामप्रमदाकपोलनिपतत्सिन्धूररागारुणैः सैन्दूरीक्रियते जनेन चरणन्यासैः पुरः कुट्टिमम्"<br><b>उल्लेखाः - </b>रत्ना० १-११<br><br>उद्दाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧೈರ್ಯವುಳ್ಳ /ಪ್ರಗಲ್ಭನಾದ<br><b>प्रयोगाः - </b>"भवन्ति नोद्दामगिरां कवीनामुच्छ्रायसौन्दर्यगुणा मृषोद्याः"<br><b>उल्लेखाः - </b>माघ० ४-१०<br><br>उद्दाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಬಲವಾದ /ಶಕ್ತಿಯುತವಾದ<br><b>प्रयोगाः - </b>"उद्दामदेहपरिदाहमहाज्वराणि"<br><b>उल्लेखाः - </b>मालती० ६-१३<br><br>उद्दाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮದಿಸಿದ /ಅಮಲೇರಿದ<br><b>व्युत्पत्तिः - </b>दाम्न उद्गतः<br><b>प्रयोगाः - </b>"नदत्याकाशगङ्गायाः स्रोतस्युद्दामदिग्गजे"<br><b>उल्लेखाः - </b>रघु० १-७८<br><br>उद्दाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯಂಕರವಾದ /ಭೀತುಯನ್ನುಂಟುಮಾಡುವ<br><b>प्रयोगाः - </b>"विषमडामरोद्दामशरीरसन्निवेशः"<br><b>उल्लेखाः - </b>मालती० ३<br><br>उद्दाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಶಯವಾದ /ಸಮೃದ್ಧಿಯಾದ<br><b>प्रयोगाः - </b>"उद्दामोत्कलिकां विपाण्डुररुचं प्रारब्धजृम्भां क्षणात्"<br><b>उल्लेखाः - </b>रत्ना० २-४<br><br>उद्दाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಂಭೀರವಾದ<br><b>विस्तारः - </b>"उद्दामो बन्धरहिते स्वतन्त्रे च प्रचेतसि" - मेघ० ।<br><br>

उद्दाल
उद्दाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಳ್ಳೆ ಮರ<br><b>निष्पत्तिः - </b>उद् + दल (विशरणे) + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उद्दालयति<br><b>विस्तारः - </b>"शेलुः श्लेष्मातकः शीत उद्दालो बहुवारकः" - अम० ।<br><br>

उद्दालक
उद्दालक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಳ್ಳೆ ಮರ<br><b>निष्पत्तिः - </b>उद् + दल (विशरणे) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>उद्दालयति<br><br>उद्दालक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ದಾಲಕ ಮಹರ್ಷಿ /ಶ್ವೇತಕೇತುವಿಕೆ ಬ್ರಹ್ಮೋಪದೇಶ ಮಾಡಿದ ಋಷಿ<br><br>उद्दालक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಟ್ಟಲ್ಪಟ್ಟ<br><br>

उद्दित
उद्दित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಟ್ಟಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + दो (अवखण्डने) - "क्तः" (३-२-१०२)<br><br>

उद्दिधीर्षा
उद्दिधीर्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲು ಅಪೇಕ್ಷೆ /ಉದ್ದಾರ ಮಾಡಲು ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>उद् + धृञ् (धारणे) + सन् - "अः" (३-३-१०२)<br><b>प्रयोगाः - </b>"तथा व्यथामग्नतदुद्दिधीर्षया दयालुरागाल्लघु हेमहंसराट्"<br><b>उल्लेखाः - </b>नैष० ९-१२७<br><br>उद्दिधीर्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಷ್ಟದಿಂದ ಪಾರುಮಾಡಲು ಅಪೇಕ್ಷೆ<br><br>

उद्दिधीर्षु
उद्दिधीर्षु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಷ್ಟದಿಂದ ಪಾರುಮಾಡಲು ಅಪೇಕ್ಷಿಸುವ<br><br>उद्दिधीर्षु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲು ಅಪೇಕ್ಷಿಸುವ<br><b>निष्पत्तिः - </b>उद् + धृञ् (धारणे) + सन् - "उः" (३-२-१६८)<br><br>

उद्दिष्ट
उद्दिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಟ್ಟ /ಬಯಸಲ್ಪಟ್ಟ<br><br>उद्दिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿವರಣಪೂರ್ವಕ ಉಪದೇಶಿಸಲ್ಪಟ್ಟ /ವಿಶದವಾಗಿ ಕಲಿಸಲ್ಪಟ್ಟ<br><br>उद्दिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಲ್ಲೇಖಿಸಲ್ಪಟ್ಟ /ನಿರ್ದೇಶಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + दिश (अतिसर्जने) - "क्तः" (३-२-१०२)<br><br>

उद्दीपक
उद्दीपक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಗೊಳಿಸುವ<br><br>उद्दीपक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ರೇಕಗೊಳಿಸುವ /ಪ್ರೇರಿಸುವ /ಹುರಿದುಂಬಿಸುವ<br><b>निष्पत्तिः - </b>उद् + दीपी (दीप्तौ) - "ण्वुल्" (३-१-१३३)<br><br>

उद्दीपन
उद्दीपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಗೊಳಿಸುವುದು<br><b>निष्पत्तिः - </b>उद् + दीपी (दीप्तौ) - "ल्युट्" (३-३-११५)<br><br>उद्दीपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೇರಿಸುವುದು /ಹುರಿದುಂಬಿಸುವುದು<br><b>निष्पत्तिः - </b>उद् + दीपी (दीप्तौ) - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उद्दीपयति<br><b>प्रयोगाः - </b>"उद्दीपनविभावास्ते रसमुद्दीपयन्ति ये"<br><b>उल्लेखाः - </b>सा० द० ३-१३१<br><br>उद्दीपन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತೇಜನ ಕೊಡುವ /ರಸೋತ್ಪತ್ತಿಗೆ ಕಾರಣವಾದ ಸಾಮಗ್ರಿ<br><br>

उद्दीपित
उद्दीपित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕಗೊಳಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + दीपी (दीप्तौ) + णिच् - "क्तः" (३-२-१०२)<br><br>

उद्दीप्त
उद्दीप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಮಾನವಾದ /ಹೊಳೆಯುವ<br><b>निष्पत्तिः - </b>उद् + दीपी (दीप्तौ) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"उद्दीप्तकोपदहनोऽथ सुरेन्द्रशत्रुरह्नाय सारथिमवोचत चण्डबाहुः"<br><b>उल्लेखाः - </b>कुमा० १७-८<br><br>

उद्दीप्र
उद्दीप्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಗ್ಗುಳು /ಧೂಪ<br><br>उद्दीप्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಮಾನವಾದ /ಹೊಳೆಯುವ<br><b>निष्पत्तिः - </b>उद् + दीपी (दीप्तौ) - "रः" (३-२-१६७)<br><br>

उद्दृप्त
उद्दृप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಬ್ಬಿದ /ಅಹಂಕಾರದಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>उद् + दृप (हर्षमोहनयोः) - "क्तः" (३-४-७२)<br><br>

उद्देश
उद्देश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರದೇಶ /ಜಾಗ /ಸ್ಥಳ<br><b>निष्पत्तिः - </b>उद् + दिश (अतिसर्जने) - "घञ्" (३-३-१९)<br><b>प्रयोगाः - </b>"अये प्रवातसुभगोऽयमुद्देशः"<br><b>उल्लेखाः - </b>शाकु० ३<br><br>उद्देश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಯಾನ್ವೇಷಣ /ವಿಚಾರ /ವಿಮರ್ಶೆ<br><br>उद्देश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪದೇಶ<br><br>उद्देश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪದೇಶದ ಸ್ಥಳ<br><b>निष्पत्तिः - </b>उद् + दिश (अतिसर्जने) - अधि० "घञ्" (३-३-१२१)<br><br>उद्देश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿವರಣೆ /ಸ್ಪಷ್ಟವಾಗಿ ತಿಳಿಸುವಿಕೆ<br><br>उद्देश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಸಂಧಾನ<br><br>उद्देश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಲಾಷೆ /ಅಪೇಕ್ಷೆ /ಇಚ್ಛೆ<br><br>उद्देश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಕ್ಷೇಪ /ಸಂಗ್ರಹ<br><b>प्रयोगाः - </b>"एष तूद्देशतः प्रोक्तो विभूतेर्विस्तरे मया"<br><b>उल्लेखाः - </b>गीता० १०-४०<br><br>उद्देश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಯ /ಗುರಿ<br><br>

उद्देशक
उद्देशक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿವರಣಪೂರ್ವಕ ಉಪದೇಶಿಸುವವನು<br><b>निष्पत्तिः - </b>उद् + दिश (अतिसर्जने) - "ण्वुल्" (३-१-१३३)<br><br>

उद्देश्य
उद्देश्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುವಾದ್ಯ /ವಿಧಿಸುವ ಸ್ಥಳ<br><b>निष्पत्तिः - </b>उद् + दिश (अतिसर्जने) - "ण्यत्" (३-१-१२४)<br><br>उद्देश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿವರಿಸಲ್ಪಡುವ /ಉದಾಹರಿಸಲ್ಪಡುವ<br><br>उद्देश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯಿಸಲ್ಪಡುವ<br><br>उद्देश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ದೇಶಿಸಲ್ಪಡುವ<br><br>

उद्द्योत
उद्द्योत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶ /ಬೆಳಕು<br><b>निष्पत्तिः - </b>उद् + द्युत (दीप्तौ) - "घञ्" (३-३-१७)<br><br>उद्द्योत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾಭಾಷ್ಯದ ಒಂದು ವ್ಯಾಖ್ಯಾನ<br><br>उद्द्योत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾವ್ಯಪ್ರಕಾಶದ ಒಂದು ವ್ಯಾಖ್ಯಾನ<br><br>उद्द्योत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶವುಂಟುಮಾಡುವ /ಬೆಳಗಿಸುವ<br><b>निष्पत्तिः - </b>उद् + द्युत (दीप्तौ) - "अच्" (३-१-१३४)<br><br>

उद्द्राव
उद्द्राव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಓಟ /ಪಲಾಯನ<br><b>निष्पत्तिः - </b>उद् + द्रु (गतौ) - "घञ्" (३-३-४९)<br><br>उद्द्राव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇಗವಾದ ನಡಗೆಯುಳ್ಳ /ಓಟವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>उत्कृष्टो द्रावो यस्य<br><br>

उद्धत
उद्धत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನ ಜಟ್ಟ /ರಾಜನ ಆಸ್ಥಾನದ ಪೈಲ್ವಾನ /ಕುಸ್ತಿಗಾರ<br><br>उद्धत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಬ್ಬಿದ /ಗರ್ವಿತನಾದ<br><b>निष्पत्तिः - </b>उद् + हन (हिंसागत्योः) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"उपजापसहान् विलङ्घयन् न विधाता नृपतीन् मदोद्धतः"<br><b>उल्लेखाः - </b>किरा० २-४७<br><br>उद्धत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವಿನೀತ /ಅವಿಧೇಯ<br><br>उद्धत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎದ್ದಿರುವ /ಮೇಲಕ್ಕೆ ಹಾರಿದ<br><b>प्रयोगाः - </b>"निमज्जतीनां श्वसितोद्धतस्तनः श्रमो नु तासां मदनो नु पप्रथे" । "यदस्य यात्रासु बलोद्धतं रजः" ।<br><b>उल्लेखाः - </b>किरा० ८-५३, नैष० १-८<br><br>उद्धत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಿಕವಾದ /ಹೆಚ್ಚಾದ<br><b>प्रयोगाः - </b>"योषिदुद्धतमनोभवरागा मानवत्यपि ययौ दयिताङ्गम्"<br><b>उल्लेखाः - </b>किरा० ९-६८<br><br>उद्धत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಠಿನವಾದ /ಪರುಷವಾದ /ನಿಷ್ಠುರವಾದ<br><b>प्रयोगाः - </b>"वचनैरसतां महीयसो न खलु व्येति गुरुत्वमद्धतैः"<br><b>उल्लेखाः - </b>माघ० १६-२७<br><br>उद्धत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಭೀರವಾದ /ಭವ್ಯವಾದ<br><br>

उद्धति
उद्धति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೇಳುವುದು<br><br>उद्धति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಿ ಹೊಡೆಯುವುದು<br><b>निष्पत्तिः - </b>उद् + हन (हिंसागत्योः) - "क्तिन्" (३-३-९४)<br><br>उद्धति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಹಂಕಾರ<br><b>प्रयोगाः - </b>"न लङ्घयामास महाजनानां शिरांसि नैवोद्धतिमाजगाम"<br><b>उल्लेखाः - </b>माघ० ३-२८<br><br>उद्धति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡುವುದು /ದುಡುಗಾಡುವುದು<br><br>उद्धति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಿಧೇಯತೆ /ಉದ್ಧಟತನ<br><b>प्रयोगाः - </b>"नयति द्रुतमुद्धतिश्रितः प्रसभं भङ्गमभङ्गुरोदयः"<br><b>उल्लेखाः - </b>माघ० १६-७२<br><br>

उद्धरण
उद्धरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಂದರೆಯಿಂದ ಬಿಡುಗಡೆ ಮಾಡುವುದು /ವಿಮೋಚನೆ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>उद् + हृञ् (हरणे) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"सप्त व्यतीयुः त्रिगुणानि तस्य दिनानि दीनोद्धरणोचितस्य"<br><b>उल्लेखाः - </b>रघु० २-२५<br><br>उद्धरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆಯುವುದು /ಕಿತ್ತು ಹಾಕುವುದು<br><br>उद्धरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬುಡಸಹಿತ ನಾಶಪಡಿಸುವುದು /ನಿರ್ಮೂಲನಗೊಳಿಸುವುದು<br><br>उद्धरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಣ್ತಿ ಮಾಡುವಿಕೆ<br><br>उद्धरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಲ ತೀರಿಸುವಿಕೆ<br><br>उद्धरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಕ್ತಿ /ಬಂಧವಿಮೋಚನೆ<br><br>उद्धरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಬ್ಬಿಸುವುದು<br><br>उद्धरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಿ ತರುವುದು<br><b>प्रयोगाः - </b>"यत्नवानपि तु श्रीमाँल्लाङ्गूलोद्धरणे ततः"<br><b>उल्लेखाः - </b>भा० वन० १४९-२२<br><br>

उद्धरणीय
उद्धरणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಿ ತರಲ್ಪಡುವ<br><br>उद्धरणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬುಡಸಹಿತ ನಾಶಪಡಿಸಲ್ಪಡುವ<br><br>उद्धरणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯಲ್ಪಡುವ<br><br>उद्धरणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡುಗಡೆ ಮಾಡಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उद् + हृञ् (हरणे) - कर्म० "अनीयर्" (३-३-९६)<br><br>

उद्धर्तृ
उद्धर्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತುವ<br><br>उद्धर्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸುವ /ನಿರ್ಮೂಲಮಾಡುವ<br><b>निष्पत्तिः - </b>उद् + हृञ् (हरणे) - "तृच्" (३-१-१३३)<br><b>प्रयोगाः - </b>"अनम्राणां समुद्धर्तुः तस्यात्सिन्धुरयादिव"<br><b>उल्लेखाः - </b>रघु० ४-३५<br><br>उद्धर्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡುಗಡೆ ಮಾಡುವ<br><br>

उद्धत्री
उद्धत्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उद्धर्तृ ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

उद्धर्ष
उद्धर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಹರ್ಷ /ಅಧಿಕ ಸಂತೋಷ<br><br>उद्धर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಬ್ಬ /ಉತ್ಸವ /ಸಮಾರಂಭ<br><br>उद्धर्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರ್ಷವುಳ್ಳ /ಆನಂದವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>उद्गतो हर्षो यस्य<br><br>

उद्धर्षण
उद्धर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೋತ್ಸಾಹಪಡಿಸುವುದು /ಉತ್ತೇಜನ ಕೊಡುವುದು<br><b>निष्पत्तिः - </b>उद् + हृष (हृष्टौ) + णिच् - "ल्युट्" (३-३-११५)<br><br>उद्धर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರೋಮಾಂಚ /ಮೌಗೂದಲು ಎಚ್ಚರಗೊಳ್ಳುವಿಕೆ<br><br>उद्धर्षण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೋತ್ಸಾಹಿಸುವ /ಉತ್ತೇಜನ ಕೊಡುವ<br><b>प्रयोगाः - </b>"इतमुद्धर्षणं चैव उवाच प्रथितं वचः"<br><b>उल्लेखाः - </b>रामा०<br><br>

उद्धर्षिन्
उद्धर्षिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಸಂತೋಷವುಂಟುಮಾಡುವ /ಅಧಿಕ ಆನಂದ ಪಡಿಸುವ<br><b>निष्पत्तिः - </b>उद् + हृष (हृष्टौ) + णिच् - "णिनिः" (३-१-१३४)<br><br>

उद्धर्षिणी
उद्धर्षिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಸಂತೋಷವುಂಟುಮಾಡುವ /ಅಧಿಕ ಆನಂದ ಪಡಿಸುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

उद्धव
उद्धव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಸವ /ಹಬ್ಬ /ಆನಂದ<br><b>निष्पत्तिः - </b>धूञ् (कम्पने) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उद्धुनोति दुःखम्<br><br>उद्धव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗಾಗ್ನಿ /ಯಜ್ಞ ಸಂಬಂಧವಾದ ಅಗ್ನಿ<br><br>उद्धव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣನ ಸ್ನೇಹಿತನಾದ ಒಬ್ಬ ಯಾದವ<br><b>प्रयोगाः - </b>"भारतीमाहितभरामथानुद्धतमुद्धवः" ।<br><b>उल्लेखाः - </b>माघ० २-६९<br><b>विस्तारः - </b>उद्धवो यादवभिदि महे च क्रतुपावके । - मेदि०<br><br>

उद्धवदूत
उद्धवदूत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೋಪಾಂಗನೆಯರು ಉದ್ಧವನನ್ನು ದೂತನನ್ನಾಗಿ ಮಾಡಿ ಹೇಳಿದ ಒಂದು ಕಾವ್ಯ<br><b>व्युत्पत्तिः - </b>उद्धवः दूतो यत्र<br><br>

उद्धवसन्देश
उद्धवसन्देश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೋಪಾಂಗನೆಯರು ಉದ್ಧವನನ್ನು ದೂತನನ್ನಾಗಿ ಮಾಡಿ ಹೇಳಿದ ಒಂದು ಕಾವ್ಯ<br><b>व्युत्पत्तिः - </b>उद्धवः सन्दिश्यतेऽत्र<br><br>

उद्धस्त
उद्धस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಿದ ಕೈಯುಳ್ಳ /ತೋಳುಗಳನ್ನು ಮೇಲಕ್ಕೆ ಎತ್ತಿರುವ<br><b>व्युत्पत्तिः - </b>उद्गतौ हस्तौ यस्य<br><br>

उद्धान
उद्धान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಲೆ<br><b>निष्पत्तिः - </b>डुधाञ् (धारणपोषणयोः) - "ल्युट्" (३-३-११७) ।<br><b>व्युत्पत्तिः - </b>उद्दीयतेऽस्मिन् अग्निः<br><br>उद्धान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎದ್ದಿರುವ<br><b>विस्तारः - </b>"उद्धानमुद्गते वाच्यलिङ्गं चुल्यां नपुंसकम्" - मेदि० ।<br><br>

उद्धार
उद्धार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತುವುದು<br><b>निष्पत्तिः - </b>उद् + हृञ् (हरणे) - भावे "घञ्" (३-३-१८)<br><br>उद्धार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಋಣ /ಸಾಲ<br><b>निष्पत्तिः - </b>कर्म० "घञ्" (३-३-१९)<br><b>प्रयोगाः - </b>"गोत्रोद्धारप्रवृत्तोऽपि गोत्रोद्भेदं पुराऽकरोः"<br><b>उल्लेखाः - </b>चन्द्रा०<br><b>विस्तारः - </b>"उद्धारश्चोद्धृतावृणे" - मेदि० ।<br><br>उद्धार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಋಣವಿಮೋಚನೆ /ಸಾಲದಿಂದ ಬಿಡುಗಡೆ<br><b>निष्पत्तिः - </b>भावे "घञ्"<br><br>उद्धार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೊಂದರೆಯಿಂದ ಪಾರು ಮಾಡುವುದು<br><br>उद्धार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೇಷ್ಠಪುತ್ರನಿಗೆ ಕೊಡುವ ಅಧಿಕಭಾಗ /ಆಸ್ತಿಯ ವಿಭಾಗ ಕಾಲದಲ್ಲಿ ಒಟ್ಟು ಆಸ್ತಿಯಲ್ಲಿ ತೆಗೆದಿಟ್ಟು ಹಿರಿಯ ಮಗನಿಗೆ ಕೊಡುವ ಅಧಿಕಾಂಶ<br><b>निष्पत्तिः - </b>कर्म० "घञ्" (३-३-१९)<br><b>प्रयोगाः - </b>"ज्येष्ठस्य विंश उद्धारः सर्वद्रव्याच्च यद्वरम् । ततोऽर्ध्वं मध्यमस्य स्यात् तुरीयं तु यवीयसः ॥"<br><b>उल्लेखाः - </b>मनु० ९-११२<br><br>उद्धार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧದಲ್ಲಿ ಯೋಧರು ಕೊಳ್ಳೆ ಹೊಡೆಯುವುದರಲ್ಲಿ ರಾಜನಿಗೆ ಅಏರಬೇಕಾದ ಉತ್ಕೃಷ್ಟ ಭಾಗ<br><b>प्रयोगाः - </b>"राज्ञश्च दद्युरुद्धारमित्येषा वैदिकी श्रुतिः । राज्ञा च सर्वयोधेभ्यो दातव्यमपृथग्जितम् ॥"<br><b>उल्लेखाः - </b>मनु० ७-९७<br><br>उद्धार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಕ್ತಿ /ಮೋಕ್ಷ<br><br>उद्धार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ /ಉತ್ಕರ್ಷ /ಅಭ್ಯುದಯ<br><br>

उद्धारक
उद्धारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಂದರೆಯಿಂದ ಪಾರುಮಾಡುವವನು /ಕಷ್ಟದಿಂದ ಬಿಡುಗಡೆ ಮಾಡುವವನು<br><br>उद्धारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬುಡಸಹಿತ ಕಿತ್ತು ಹಾಕುವವನು<br><b>निष्पत्तिः - </b>उद् + हृञ् (हरणे) - "ण्वुल्" (३-१-१३३)<br><br>

उद्धारण
उद्धारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಬ್ಬಿಸುವುದು<br><b>निष्पत्तिः - </b>उद् + हृञ् (हरणे) + णिच् - "ल्युट्" (३-३-११५)<br><br>

उद्धुर
उद्धुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಾರವಿಲ್ಲದ /ಹೊರೆಯಿಲ್ಲದ<br><b>निष्पत्तिः - </b>"अः" (५-४-७४)<br><b>व्युत्पत्तिः - </b>उद्गता धूरस्मात्<br><br>उद्धुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೃಢವಾದ /ಮಜಭೂತಾದ<br><b>प्रयोगाः - </b>"प्रसकलकुचबन्धुरोद्धुरोरःप्रसभविभिन्नतनूत्तरीयबन्धा"<br><b>उल्लेखाः - </b>माघ० ७-३४<br><br>उद्धुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾದ /ಉಚ್ಚವಾದ ಶಬ್ದ<br><b>प्रयोगाः - </b>"पश्चाद्बद्धभुजं पितरमुद्धुरध्वनिमहाजनानुयातमानीय"<br><b>उल्लेखाः - </b>दशकु०<br><br>उद्धुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತುಂಬಿರುವ /ಪೂರ್ಣವಾದ<br><b>प्रयोगाः - </b>"जग्मे जयोद्धुरविशालविषाणमुक्ष्णा"<br><b>उल्लेखाः - </b>माघ० ५-६४<br><br>उद्धुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮರ್ಥ /ಶಕ್ತ<br><br>उद्धुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಸುಕನಾದ /ಉತ್ಸಾಹವುಳ್ಳ<br><b>प्रयोगाः - </b>"प्रियमपासुमुपासितुमुद्धुराः"<br><b>उल्लेखाः - </b>नैष० ४-४६<br><br>

उद्धूत
उद्धूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡಿಸಲ್ಪಟ್ಟ /ಅಲ್ಲಾಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + धूञ् (कम्पने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"पुनानं पवनोद्धूतैर्धूमैराहुतिगन्धिभिः"<br><b>उल्लेखाः - </b>रघु० १-५३<br><br>उद्धूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಬ್ಬಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"उत्फुल्लस्थलनलिनीवनादमुष्मादुद्धूतः सरसिजसम्भवः परागः"<br><b>उल्लेखाः - </b>किरा० ५-३९<br><br>

उद्धूनन
उद्धूनन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + धूञ् (कम्पने) - "ल्युट्" (३-३-११५)<br><br>

उद्धूयमान
उद्धूयमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡಿಸಲ್ಪಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + धूञ् (कम्पने) - कर्म० "शानच्" (३-२-१२४)<br><br>

उद्धूलन
उद्धूलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಡಿಯನ್ನು ಚೆಲ್ಲುವುದು /ಸುಗಂಧಚೂರ್ಣ ಮುಂತಾದುವನ್ನು ಮೈಗೆ ಒತ್ತುವುದು<br><b>निष्पत्तिः - </b>उद् + धूलि + णिच् - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"भस्मोद्धूलन भद्रमस्तु भवते रुद्राक्षमाले शुभं हा सोपानपरम्परे गिरिसुताकान्तालयालङ्कृते"<br><b>उल्लेखाः - </b>कुव०<br><br>उद्धूलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಸಾಲೆಪುಡಿ ಪದಾರ್ಥಗಳನ್ನು ಕುಟ್ಟಿ ಅಡುಗೆಗೆ ಹಾಕುವ ಸಂಬಾರದ ಪುಡಿ<br><br>

उद्धूषण
उद्धूषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರೋಮಾಂಚ /ಮೈಗೂದಲು ಎಚ್ಚರಗೊಳ್ಳುವುದು<br><br>

उद्धृत
उद्धृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + हृञ् (हरणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"निक्षेपणाय पदमुद्धृतमुद्वहन्ती"<br><b>उल्लेखाः - </b>कुमा० ५-८५<br><br>उद्धृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರ್ಪಡಿಸಲ್ಪಟ್ಟ<br><br>उद्धृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಭವಿಸಿ ಬಿಡಲ್ಪಟ್ಟ<br><br>उद्धृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಳೆದು ಬಿಡಲ್ಪಟ್ಟ ಬಾವಿಯ ನೀರು<br><br>उद्धृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿತ್ತು ಹಾಕಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"न जातु वैनायकमेकमुद्धृतं विषाणमद्यापि पुनः प्ररोहति"<br><b>उल्लेखाः - </b>माघ० १-६०<br><br>उद्धृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಳ್ಳಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"नोद्धृतं तिमिरमद्रिवनेभ्यः"<br><b>उल्लेखाः - </b>किरा० ९-२५<br><br>उद्धृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚದರಿಸಲ್ಪಟ್ಟ /ಓಡಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"जाताभिषङ्गो नृपतिर्निषाङ्गादुद्धर्तुमैच्छर्प्रसभोद्धृतारिः"<br><b>उल्लेखाः - </b>रघु० २-३०<br><br>

उद्धृति
उद्धृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತುವುದು<br><b>निष्पत्तिः - </b>उद् + धृञ् (धारणे) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"उद्धृतिस्खलदिलापरिरम्भात्"<br><b>उल्लेखाः - </b>नैष० २१-५८<br><br>उद्धृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊರಕ್ಕೆ ಎಳೆದು ಬಿಡುವುದು<br><br>उद्धृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಂದರೆಯಿಂದ ಪಾರು ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>उद् + हृञ् (हरणे) - "क्तिन्" (३-३-९४)<br><br>उद्धृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಕ್ತಿ /ಮೋಕ್ಷ<br><b>प्रयोगाः - </b>"त्रपन्ते तीर्थानि त्वरितमिह यस्योद्धृतिविधौ"<br><b>उल्लेखाः - </b>गङ्गाल०<br><br>

उद्बन्ध
उद्बन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಟ್ಟಿ ಹಾಕುವುದು /ಗಂಟು ಹಾಕುವುದು<br><b>निष्पत्तिः - </b>उद् + बन्ध (बन्धने) - "घञ्" (३-३-१८)<br><br>उद्बन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೂಗು ಹಾಕುವುದು /ನೇಣು ಹಾಕುವುದು<br><b>प्रयोगाः - </b>"विषमुद्बन्धनं चैव शास्त्रमग्निप्रवेशनम् । करिष्ये न हि तानृद्धान् पुनर्द्रष्टुमिहोत्सहे ॥"<br><b>उल्लेखाः - </b>भा० वन० ७-६<br><br>उद्बन्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಂಧನದಿಂದ ಬಿಡುಗಡೆ ಹೊಂದಿದ /ಕಟ್ಟು ಬಿಚ್ಚಿರುವ<br><b>प्रयोगाः - </b>"उद्बन्धक्र्शश्चुतपत्रलेखः"<br><b>उल्लेखाः - </b>रघु० १६-६७<br><br>

उद्बन्धन
उद्बन्धन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>उद्बन्ध ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

उद्बन्धक
उद्बन्धक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಮಿಶ್ರ ಜಾತಿಯವನು /ರಜಕವೃತ್ತಿಯವನು /ಬಟ್ಟೆ ಒಗೆಯುವವನು<br><b>प्रयोगाः - </b>"आयोगवेन विप्रायां जातास्ताम्रोपजीविनः । तस्यैव नृपकन्यायां जातः सूनिक उच्यते ॥ सूनिकस्य नृपायां तु जाता उद्बन्धकाः स्मृताः । निर्णेजयेयुर्वस्त्राणि अस्पृश्याश्च भवन्त्यतः ॥"<br><br>

उद्बाष्प
उद्बाष्प<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಣ್ಣೀರಿನಿಂದ ತುಂಬಿದ<br><b>व्युत्पत्तिः - </b>उद्गतो बाष्पो यत्र<br><b>प्रयोगाः - </b>"हृदयानि समाविवेश स क्षणमुद्बाष्पदृशां तपोभृताम्"<br><b>उल्लेखाः - </b>किरा० ३-५९<br><br>

उद्बाहु
उद्बाहु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಿದ ತೋಳುಗಳುಳ್ಳ<br><b>व्युत्पत्तिः - </b>उद्गतौ बाहू यस्य<br><b>प्रयोगाः - </b>"प्रांशुलभ्ये फले लोभात् उद्बाहुरिव वामनः"<br><b>उल्लेखाः - </b>रघु० १-३<br><br>

उद्बुद्ध
उद्बुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಳಿದ /ವಿಕಾಸ ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>उद् + बुध (अवगमने) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"उद्बुद्धमुग्धकनकाब्जनिभं वहन्तीमासङ्गतिर्यगपवर्तितदृष्टिवक्त्रम्"<br><b>उल्लेखाः - </b>मालती० १-४३<br><br>उद्बुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆರಳಿಸಲ್ಪಟ್ಟ /ಎಚ್ಚರಗೊಂಡ<br><br>उद्बुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳುವಳಿಕೆ ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>उद् + बुध -कर्त० "क्तः" (३-४-७२)<br><br>

उद्बोध
उद्बोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಮರಣೆ /ನೆನಪು<br><br>उद्बोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಚ್ಚರಿಕೆ<br><br>उद्बोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಿಕವಾಗುವಿಕೆ /ಹೆಚ್ಚುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + बुध (अवगमने) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"उत्साहादिसमुद्बोधः साधारण्याभिमानतः"<br><b>उल्लेखाः - </b>सा० द० ३-११<br><br>

उद्बोधन
उद्बोधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>उद्बोध ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

उद्बोधक
उद्बोधक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜ್ಞಾಪಿಸುವ /ನೆನಪಿಗೆ ತರುವ<br><br>उद्बोधक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಚ್ಚರಗೊಳಿಸುವ<br><br>उद्बोधक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳುವಳಿಕೆ ಕೊಡುವ<br><br>उद्बोधक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಿಸುವ /ಅಧಿಕಗೊಳಿಸುವ<br><b>निष्पत्तिः - </b>उद् + बुध (अवगमने) + णिच् - "ण्वुल्"(३-१-१३३)<br><b>प्रयोगाः - </b>"रत्यादुद्बोधका लोके विभावाः काव्यनाट्ययोः"<br><b>उल्लेखाः - </b>सा० द० ३-२८<br><br>

उद्बोधयत्
उद्बोधयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜ್ಞಾಪಿಸುತ್ತಿರುವ /ನೆನಪಿಗೆ ತರುತ್ತಿರುವ<br><br>उद्बोधयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + बुध (अवगमने) + णिच् - "शतृ" (३-२-१२४)<br><br>

उद्बोधयन्ती
उद्बोधयन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उद्बोधयत् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

उद्बोधित
उद्बोधित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜ್ಞಾಪಿಸಲ್ಪಟ್ಟ /ನೆನಪಿಗೆ ತರಲ್ಪಟ್ಟ<br><br>उद्बोधित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಿಸಲ್ಪಟ್ಟ /ಅಧಿಕಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>उद्बोधित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಸಲ್ಪಟ್ಟ<br><br>उद्बोधित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಚ್ಚರಗೊಳಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + बुध (अवगमने) + णिच् - "क्तः" (३-२-१०२)<br><br>

उद्भट
उद्भट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ಕಿ ಮೊದಲಾದುವನ್ನು ಕೇರುವ ಶೂರ್ಪ /ಮೊರ<br><b>निष्पत्तिः - </b>उद् + भट (भृतौ) - कर० "घः" (३-३-११८)<br><br>उद्भट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೂರ್ಮ /ಆಮೆ<br><br>उद्भट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>विस्तारः - </b>"उद्भटः कच्छपे सूर्ये" - मेदि० ।<br><br>उद्भट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತಮವಾದ /ಶ್ರೇಷ್ಠವಾದ<br><b>प्रयोगाः - </b>"पदे पदे सन्ति भटा रणोद्भटाः"<br><b>उल्लेखाः - </b>नैष० १-१३२<br><br>उद्भट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದಾರವಾದ /ಗಂಭೀರವಾದ<br><br>

उद्भव
उद्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>उद्गतो भवो भवबन्धो यस्मात्<br><b>प्रयोगाः - </b>"उद्भवः क्षोभणो देवः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"समुद्गतो भवो यस्मादुद्भवः परिकीर्तितः"<br><br>उद्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿ /ಜನ್ಮ /ಹುಟ್ಟು<br><b>निष्पत्तिः - </b>उद् + भू - भावे "अप्" (३-३-५७)<br><b>प्रयोगाः - </b>"दिलीपसूनुर्मणिराकरोद्भवः" । "स्थैर्यं चतुर्थे त्वङ्गानां पञ्चमे शोणितोद्भवः" ।<br><b>उल्लेखाः - </b>रघु० ३-१८, याज्ञ० ३-८०<br><br>उद्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಲ /ಉತ್ಪತ್ತಿಗೆ ಕಾರಣ<br><br>उद्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿಯ ಸ್ಥಾನ /ಮೂಲಸ್ಥಾನ<br><b>निष्पत्तिः - </b>उद् + भू - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उद्भवत्यस्मात्<br><b>प्रयोगाः - </b>"मृत्युः सर्वहरश्चाहमुद्भवश्च भविष्यताम्"<br><b>उल्लेखाः - </b>गीता० १०-३४<br><br>उद्भव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಸಾರದಿಂದ ಬಿಡುಗಡೆ ಹೊಂದಿದ /ಸಂಸಾರವನ್ನು ದಾಟಿದ<br><b>व्युत्पत्तिः - </b>उद्गतो भवात्<br><br>

उद्भवन
उद्भवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>उद्भव ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

उद्भवत्
उद्भवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ಭವಿಸುವ /ಹುಟ್ಟುವ<br><b>निष्पत्तिः - </b>उद् + भू (सत्तायाम्) - "शतृ" (३-२-१२४)<br><br>

उद्भवन्ती
उद्भवन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ಭವಿಸುವ /ಹುಟ್ಟುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

उद्भावन
उद्भावन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಊಹೆ /ಕಲ್ಪನೆ<br><br>उद्भावन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೃಷ್ಟಿಸುವಿಕೆ /ನಿರ್ಮಿಸುವಿಕೆ /ಉಂಟುಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + भू (सत्तायाम्) + णिच् - "ल्युट्" (३-३-११५)<br><br>उद्भावन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಂತಿಸುವುದು /ಆಲೋಚಿಸುವುದು<br><br>उद्भावन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಥನ /ಹೇಳುವುದು<br><b>प्रयोगाः - </b>"यदि स्वभावान्मम नोज्जवलं कुलं ततस्तदुद्भावनमौचिती"<br><b>उल्लेखाः - </b>नैष० ९-१०<br><br>

उद्भावना
उद्भावना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उद्भावन ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"युच्" (३-३-१०७)<br><br>

उद्भावनीय
उद्भावनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಲ್ಪಿಸಲ್ಪಡುವ /ಊಹಿಸಲ್ಪಡುವ<br><br>उद्भावनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೃಷ್ಟಿಸಲ್ಪಡುವ<br><br>उद्भावनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೃಷ್ಟಿಸಲು ಅರ್ಹವಾದ<br><b>निष्पत्तिः - </b>उद् + भू (सत्तायाम्) + णिच् - "अनीयर्" (३-१-९६)<br><br>

उद्भावयत्
उद्भावयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಟ್ಟಿಸುತ್ತಿರುವ /ಉಂಟುಮಾಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + भू (सत्तायाम्) + णिच् - "शतृ" (३-२-१२४)<br><br>

उद्भावयन्ती
उद्भावयन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹುಟ್ಟಿಸುತ್ತಿರುವ /ಉಂಟುಮಾಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

उद्भास
उद्भास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶ /ಕಾಂತಿ /ಬೆಳಕು<br><b>निष्पत्तिः - </b>उद् + भासृ (दीप्तौ) - "घञ्" (३-३-१८)<br><br>

उद्भासक
उद्भासक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಗೊಳಿಸುವ /ಬೆಳಕನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>उद् + भासृ (दीप्तौ) - "ण्वुल्" (३-१-१३३)<br><br>

उद्भासयत्
उद्भासयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸುವ<br><b>निष्पत्तिः - </b>उद् + भासृ (दीप्तौ) + णिच् - "शतृ" (३-२-१२४)<br><br>

उद्भासवत्
उद्भासवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಂತಿಯುಕ್ತವಾದ /ಪ್ರಕಾಶದಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>उद्भास - "मतुप्" (५-२-९४)<br><br>

उद्भासित
उद्भासित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಗೊಳಿಸಲ್ಪಟ್ಟ /ಬೆಳಗಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + भासृ (दीप्तौ) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"यथायथं ताः सहिता नभश्चरैः प्रभाभिरुद्भासितशैलवीरुधः"<br><b>उल्लेखाः - </b>किरा० ८-२<br><br>

उद्भासिन्
उद्भासिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಿಸುವ /ಹೊಳೆಯುವ<br><b>निष्पत्तिः - </b>उद् + भासृ (दीप्तौ) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उद्भासते<br><b>प्रयोगाः - </b>"विभीषणोद्भासि पिनद्धभोगि वा गजाजिनालम्बि दुकूलधारि वा"<br><b>उल्लेखाः - </b>कुमा० ५-७८<br><br>

उद्भिज्ज
उद्भिज्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿಯನ್ನು ಭೇದಿಸಿಕೊಂಡು ಹುಟ್ಟುವ ಗಿಡ ಮರ ಬಳ್ಳಿ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>उद्भिदो जातम्<br><b>प्रयोगाः - </b>"उद्भिज्जाः स्थावराः सर्वे बीजकाण्डप्ररोहिणः"<br><b>उल्लेखाः - </b>मनु० १-४६<br><br>उद्भिज्ज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಕುರಿಸುವ /ಮೊಳಕೆ ಹೊರಡುವ<br><br>

उद्भिद्
उद्भिद्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಿಡ ಮರ ಬಳ್ಳಿ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>उद् + भिदिर् (विदारणे) - "क्विप्" (३-२-७६)<br><b>प्रयोगाः - </b>"उद्भिद्विरचितावासः कपोतादिव तत्र सः"<br><b>उल्लेखाः - </b>नैष० १७-२१५<br><b>विस्तारः - </b>"उद्भिदस्तरुगुल्माद्याः" -अम० ।<br><br>

उद्भिद
उद्भिद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಿಡ ಮರ ಬಳ್ಳಿ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>उद् + भिदिर् (विदारणे) - "कः" (३-१-१३५)<br><br>उद्भिद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಕುರಿಸುವ /ಮೊಳಕೆ ಹೊರಡುವ<br><br>

उद्भिन्न
उद्भिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಟ್ಟಿದ /ಉತ್ಪನ್ನವಾದ<br><b>निष्पत्तिः - </b>उद् + भिदिर् (विदारणे) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"उद्भिन्नाषरमृदुतरकिसलय इव लक्ष्यतेऽशोकः"<br><b>उल्लेखाः - </b>रत्ना० १-२१<br><br>उद्भिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹೊರಟಿರುವ /ಅಂಕುರಿಸಿದ /ಮೊಳಕೆ ಹೊರಟಿರುವ<br><b>प्रयोगाः - </b>"उद्भिन्नरोमाञ्चततिर्बभासे कान्तप्ररोहा कमलस्थलीव"<br><b>उल्लेखाः - </b>याद० १३-११<br><br>उद्भिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಡೆಯಲ್ಪಟ್ಟ /ಸೀಳಲ್ಪಟ್ಟ /ಭೇದಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"यौवनोद्भिन्नशैशवा"<br><br>उद्भिन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊರಗೆಡಹಲ್ಪಟ್ಟ ಹೇದಯವುಳ್ಳ /ಪ್ರಕಾಶಪಡಿಸಲ್ಪಟ್ಟ ಆಶಯವುಳ್ಳ<br><b>प्रयोगाः - </b>"उद्भिन्नास्मि सहवासिन्या मालत्या"<br><b>उल्लेखाः - </b>मालती० ७<br><br>

उद्भूत
उद्भूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಟ್ಟಿದ /ಉತ್ಪತ್ತಿ ಹೊಂದಿದ /ಉಂಟಾದ<br><b>निष्पत्तिः - </b>उद् + भू (सत्तायाम्) - "क्तः" (३-४-७२)<br><br>उद्भूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯಕ್ಷ ಯೋಗ್ಯವಾದ /ಇಂದ್ರಿಯ ಗೋಚರವಾದ<br><br>उद्भूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆಳೆದಿರುವ /ವೃದ್ಧಿಯಾದ /ಹೆಚ್ಚಿದ<br><br>

उद्भूतरूप
उद्भूतरूप<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣಿಗೆ ಕಾಣುವ ರೂಪ<br><br>उद्भूतरूप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಣುವಂತಿರುವ ರೂಪವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>उद्भूतं प्रत्यक्षयोग्यं रूपं यस्य<br><br>

उद्भूति
उद्भूति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿ /ಹುಟ್ಟುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + भू (सत्तायाम्) - "क्तिन्" (३-३-९४)<br><br>उद्भूति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉನ್ನತಿ /ಏಳಿಗೆ /ಅಭಿವೃದ್ಧಿ<br><b>प्रयोगाः - </b>"उमा वधूर्भवान् दाता याचितार इमे वयम् । वरः शम्भुरलं ह्येष त्वत्कुलोद्भूतये विधिः ॥"<br><b>उल्लेखाः - </b>कुमा० ६-८२<br><br>

उद्भेद
उद्भेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೇದಿಸಿಕೊಂಡು ಹೊರಡುವುದು /ಪ್ರತ್ಯಕ್ಷವಾಗುವುದು /ಕಣ್ಣಿಗೆ ಕಾಣಿಸಿಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>उद् + भिदिर् (विदारणे)- "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"उमास्तनोद्भेदमनुप्रवृद्धो मनोरथो यः प्रथमं बभूव"<br><b>उल्लेखाः - </b>कुमा० ७-२४<br><br>उद्भेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಡೆಯುವುದು /ಸೀಳುವುದು /ತುಂಡು ಮಾಡುವುದು<br><br>उद्भेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನ ಬುಗ್ಗೆ /ಊಟೆ<br><br>उद्भेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರೆಯಾಗುವಿಕೆ /ಬಿಟ್ಟು ಹೋಗುವಿಕೆ<br><br>उद्भेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಮೇಲೆ ಮುಳ್ಳೇರುವುದು<br><br>

उद्भ्रम
उद्भ्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ವೇಗ /ಕಳವಳ<br><br>उद्भ्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಯ /ಹೆದರಿಕೆ<br><b>निष्पत्तिः - </b>उद् + भ्रमु (चलने) - कर० "घञ्" (३-३-१२१)<br><br>उद्भ्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭ್ರಾಂತಿ /ತಪ್ಪಾಗಿ ತಿಳಿದುಕೊಳ್ಳುವಿಕೆ<br><b>प्रयोगाः - </b>"प्रसूनमाला नलस्योद्भ्रमवीक्षितस्य"<br><b>उल्लेखाः - </b>नैष० ६-४९<br><br>उद्भ्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ತಿರುಗುವಿಕೆ /ಗರಗರನೆ ತಿರುಗುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + भ्रमु (चलने) - भावे "घञ्" (३-३-१८)<br><br>

उद्भ्रमण
उद्भ्रमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>उद्भ्रम ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

उद्भ्रान्त
उद्भ्रान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಾಬರಿಗೊಂಡ /ಕಳವಳ ಗೊಂಡ<br><br>उद्भ्रान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆದರಿದ /ಭಯಗೊಂಡ<br><b>निष्पत्तिः - </b>उद् + भ्रमु (चलने) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"अथ रामशिरश्छेददर्शनोद्भ्रान्तचेतसाम्"<br><b>उल्लेखाः - </b>रघु० १२-७४<br><br>उद्भ्रान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರಿದ /ಮೇಲೆ ಸುತ್ತುತ್ತಿರುವ<br><b>प्रयोगाः - </b>"मारीचोद्भ्रान्तहारिता मलयाद्रेरुपत्यकाः"<br><b>उल्लेखाः - </b>रघु० ४-४६<br><br>

उद्यच्छमान
उद्यच्छमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನಪಡುತ್ತಿರುವ /ಯತ್ನ ನಡೆಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + यम (उपरमे) - "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"उद्यच्छमाना गमनाय पश्चात्पुरो निवेशे पथि च व्रजन्ती"<br><b>उल्लेखाः - </b>रघु० १६-२९<br><br>

उद्यत्
उद्यत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏಳುವ /ಮೇಲಕ್ಕೆ ಎದ್ದು ನಿಲ್ಲುವ<br><b>निष्पत्तिः - </b>उद् +इण् (गतौ) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"अथोच्चकैरासनतः परार्ध्यादुद्यन् स धूरारुणवल्कलाग्रः"<br><b>उल्लेखाः - </b>किरा० २-५७<br><br>उद्यत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹೊರಡುವ /ಮೇಲಕ್ಕೆ ಹೋಗುತ್ತಿರುವ<br><b>प्रयोगाः - </b>"उद्यत्कृशानुशकलेषु खुराभिघातात्"<br><b>उल्लेखाः - </b>माघ० ५-९<br><br>उद्यत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ಯಿಸುತ್ತಿರುವ /ಮೇಲಕ್ಕೆ ಎದ್ದು ಬರುತ್ತಿರುವ<br><b>प्रयोगाः - </b>"नेक्षेतोद्यन्तमादित्यं नास्तं यन्तं कदाचन"<br><b>उल्लेखाः - </b>मनु० ४-३७<br><br>

उद्यत
उद्यत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ಯಮ /ಪ್ರಯತ್ನ<br><b>निष्पत्तिः - </b>उद् + यम (उपरमे) - "क्तः"(३-३-११४)<br><br>उद्यत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನಗೊಂಡ /ಯತ್ನಿಸಿರುವ<br><b>निष्पत्तिः - </b>उद् + यम (उपरमे) - कर्त० "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"तदाशु कर्तुं त्वयि जिह्ममुद्यते विधीयतां तत्र विधेयमुत्तरम्" । "पक्षच्छेदोद्यतं शक्रं शिलावर्षीव पर्वतः" ।<br><b>उल्लेखाः - </b>किरा० १-२५, रघु० ४-४०<br><br>उद्यत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲ್ಪಟ್ಟ /ಎತ್ತಿ ಹಿಡಿಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + यम (उपरमे) - कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"न तेन सज्यं क्वचिदुद्यतं धनुः" । "प्रजार्थसाधने तौ हि पर्यायोद्यतकार्मुकौ" ।<br><b>उल्लेखाः - </b>किरा० १-२१, रघु० ४-१६<br><br>

उद्यति
उद्यति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನ<br><br>उद्यति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + यम (उपरमे) - "क्तिन्" (३-३-९४)<br><br>

उद्यम
उद्यम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನ<br><b>निष्पत्तिः - </b>उद् + यम (उपरमे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"निशम्य चैनां तपसे कृतोद्यमां सुतां गिरीशप्रतिसक्तनसाम्"<br><b>उल्लेखाः - </b>कुमा० ५-३<br><br>उद्यम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಿ ಹಿಡಿಯುವುದು<br><br>

उद्यमन
उद्यमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>उद्यम ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

उद्यमित
उद्यमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೇರಿಸಲ್ಪಟ್ಟ /ಪ್ರಯತ್ನಪಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + यम (उपरमे) + णिच् - "क्तः" (३-२-१०)<br><b>प्रयोगाः - </b>"भर्तृषूपसखि निक्षिपतीनामत्मनो मधुमदोद्यमितानाम्"<br><b>उल्लेखाः - </b>किरा० ९-६६<br><br>उद्यमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಿ ಹಿಡಿಸಲ್ಪಟ್ಟ<br><br>

उद्यमिन्
उद्यमिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನವುಳ್ಳ /ಉದ್ಯೋಗಶೀಲ<br><b>निष्पत्तिः - </b>उद्यम - "इनिः" (५-२-११५)<br><br>

उद्यात
उद्यात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎದ್ದಿರುವ<br><b>निष्पत्तिः - </b>उद् +या (प्रापणे) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"उद्यातमुद्रुतमनोकहजालमध्यात्"<br><b>उल्लेखाः - </b>माघ० ५-२५<br><br>

उद्यान
उद्यान<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪವನ /ಕೈತೋಟ /ಕ್ರೀಡಾವನ<br><b>प्रयोगाः - </b>"व्यावृत्तगतिरुद्याने कुसुमस्तेयसाध्वसात्" । "बाह्योद्यानस्थितहरशिरश्चन्द्रिकाधौतहर्म्या"।<br><b>उल्लेखाः - </b>कुमा० २-३५, मेघ० १-७<br><br>उद्यान<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊರಕ್ಕೆ ಹೊರಡುವುದು<br><br>उद्यान<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯೋಜನ<br><b>विस्तारः - </b>उद्यानं वनभेदे स्यात् निःसृतौ च प्रयोजने" - विश्व० ।<br><br>

उद्यानपाल
उद्यानपाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೋಟದ ಕಾವಲುಗಾರ /ಮಾಲಿ /ತೋಟದ ರಕ್ಷಕ<br><b>निष्पत्तिः - </b>पाल (रक्षणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>उद्यानं पालयति<br><b>प्रयोगाः - </b>"उद्यानपालसामान्यमृतवस्तमुपासते"<br><b>उल्लेखाः - </b>कुमा० २-३६<br><br>

उद्यानपालक
उद्यानपालक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೋಟದ ಕಾವಲುಗಾರ /ಮಾಲಿ /ತೋಟದ ರಕ್ಷಕ<br><br>

उद्यापन
उद्यापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ರತ ಮೊದಲಾದುವನ್ನು ಸಮಾಪ್ತಿಗೊಳಿಸುವುದು /ಪೂರ್ಣಗೊಳಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + या (प्रापणे) + णिच् - "ल्युट्" (३-३-११५)<br><br>

उद्यापित
उद्यापित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂರ್ಣಮಾಡಲ್ಪಟ್ಟ /ಸಮಾಪ್ತಿಗೊಳಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + या (प्रापणे) + णिच् - "क्तः" (३-२-१०२)<br><br>

उद्याम
उद्याम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಕ್ಯ /ಕಾವಡಿಯ ನೆಲವು /ಭಾರ ಹೊರುವುದಕ್ಕಾಗಿ ಹಗ್ಗದಿಂದ ಮಾಡಿದ ನೆಲವು<br><b>निष्पत्तिः - </b>उद् + यम (उपरमे) - कर० "घञ्" (३-३-१२१)<br><br>

उद्यास
उद्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ಯಮ /ಪ್ರಯತ್ನ<br><b>निष्पत्तिः - </b>उद् + यसु (प्रयत्ने) - "घञ्" (३-३-१८)<br><br>

उद्युक्त
उद्युक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹಪೂರ್ವಕ ಪ್ರಯತ್ನವುಳ್ಳ /ಉದ್ಯೋಗಶೀಲ /ಸಾಹಸಿ<br><b>निष्पत्तिः - </b>उद् + युजिर् (योगे) - "क्तः" (३-४-७२)<br><br>

उद्योग
उद्योग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ಯಮ /ಪ್ರಯತ್ನ<br><b>निष्पत्तिः - </b>उद् + युजिर् (योगे) - "घञ्" (३-३-१९)<br><b>प्रयोगाः - </b>"उद्योगादनिवृत्तस्य सुसहायस्य धीमतः । छायेवानुगता तस्य नित्यं श्रीः सहकारिणी ॥" "तद्दैवमिति सञ्चिन्त्य त्यजेन्नोद्योगमात्मनः" ।<br><b>उल्लेखाः - </b>पञ्चतं०<br><br>

उद्योगपर्वन्
उद्योगपर्वन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾಭಾರತದ ಉದ್ಯೋಗಪರ್ವ<br><br>

उद्योगिन्
उद्योगिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ಯೋಗಶೀಲ /ಪ್ರಯತ್ನವುಳ್ಳವನು<br><b>प्रयोगाः - </b>"उद्योगिनं पुरुषसिंहमुपैति लक्ष्मीः दैवेन देयमिति कापुरुषा वदन्ति । दैवं निहत्य कुरु पौरुषमात्मशक्त्या यत्ने कृते यदि न दिध्यति कोऽत्र दोषः ॥"<br><b>उल्लेखाः - </b>हितो० १-३२<br><br>

उद्योजक
उद्योजक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನಪಡಿಸುವ /ಕೆಲಸ ಮಾಡುವ<br><b>निष्पत्तिः - </b>उद् + युजिर् (योगे) +णिच् - "ण्वुल्" (३-१-१३३)<br><br>

उद्र
उद्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿ ಜಲಜಂತು /ಕಡಲ ಹಂದಿ<br><b>निष्पत्तिः - </b>उन्दी (क्लेदने) - "रक्" (उ० २-१३)<br><b>व्युत्पत्तिः - </b>उनत्ति<br><b>विस्तारः - </b>"तद्भेदाः शिंशुमारोद्रशङ्कवो मकरादयः" - अम० ।<br><br>

उद्रथ
उद्रथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಡಿಯ ಕಡಾಣಿ /ಗಾಡಿಯ ಚಕ್ರದ ತಡೆಗಾಗಿ ಹಾಕುವ ಕೀಲು<br><b>व्युत्पत्तिः - </b>उद्गतो रथो यस्मात्<br><br>उद्रथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಕ್ಕುಟ /ಕೋಳಿ<br><b>विस्तारः - </b>"उद्रथो रथकीले स्यात् तारचूडाख्यपक्षिणि" - मेदि० ।<br><br>

उद्रिक्त
उद्रिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕವಾದ /ಹೆಚ್ಚಾದ<br><br>उद्रिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಫುಟವಾದ /ಸ್ಪಷ್ಟವಾದ<br><b>निष्पत्तिः - </b>उद् + रिचिर् (विरेचने) - "क्तः" (३-४-७२)<br><br>

उद्रुत
उद्रुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಲಾಯನ ಮಾಡಿದ /ಓಡಿ ಹೋದ<br><b>निष्पत्तिः - </b>उद् + द्रु (गतौ) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"उद्यातमुद्रुतमनोकहजालमध्यादन्यः शशं गुणमनल्पमवन्नवाप"<br><b>उल्लेखाः - </b>माघ० ५-२५<br><br>

उद्रेक
उद्रेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಶಯ /ಆಧಿಕ್ಯ<br><b>निष्पत्तिः - </b>उद् + रिचिर् (विरेचने) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"ज्ञानोद्रेकाद्विघटिततमोग्रन्थयः सत्त्वनिष्ठाः"<br><b>उल्लेखाः - </b>वेणी० १-२३<br><br>उद्रेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃದ್ಧಿ /ಬೆಳವಣಿಗೆ<br><br>

उद्वपन
उद्वपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಾನ /ಧರ್ಮ /ಕೊಡುಗೆ<br><br>उद्वपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಿ ಸುರಿಯುವುದು<br><br>उद्वपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬುಡಸಹಿತ ಕಿತ್ತು ಹಾಕುವುದು<br><b>निष्पत्तिः - </b>उद् + डुवप् (बीजसन्ताने) - "ल्युट्" (३-३-११५)<br><br>

उद्वमत्
उद्वमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಮನ ಮಾಡುತ್ತಿರುವ /ವಾಂತಿ ಮಾಡುತ್ತಿರುವ<br><br>उद्वमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಡುತ್ತಿರುವ /ಪಸರಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + टुवमु (उद्गिरणे) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"उद्वमन्नभिराज समन्तादङ्गराग इव लोहितरागः"<br><b>उल्लेखाः - </b>किरा० ९-२७<br><br>

उद्वमन
उद्वमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಮನ /ವಾಂತಿ ಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + टुवमु (उद्गिरणे) - "ल्युट्" (३-३-११५)<br><br>

उद्वमित
उद्वमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಂತಿ ಮಾಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + टुवमु (उद्गिरणे) + णिच् - "क्तः" (३-२-१०२)<br><br>

उद्वर्त
उद्वर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೇಷ /ಉಳಿಕೆ<br><b>निष्पत्तिः - </b>उद् + वृतु (वर्तने) - "घञ्" (३-३-१८)<br><br>उद्वर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಧಿಕ್ಯ /ಹೆಚ್ಚಿಗೆ<br><br>उद्वर्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾಗಿ ಉಳಿದಿರುವ<br><br>उद्वर्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾಗಿರುವ /ಅಧಿಕವಾಗಿರುವ<br><br>

उद्वर्तन
उद्वर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಯನ್ನು ಶುದ್ಧಿ ಮಾಡುವ ವಾಸನೆಯ ಪುಡಿ /ಮೈಗೆ ಪೂಸುವ ಸುಗಂಧದ್ರವ್ಯ<br><b>निष्पत्तिः - </b>उद् + वृतु (वर्तने) + णिच् - "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>उद्वर्त्यतेऽनेन<br><br>उद्वर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಯನ್ನು ವಾಸನೆಯ ಪುಡಿಯಿಂದ ಶುದ್ಧಿಮಾಡುವಿಕೆ<br><br>उद्वर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರುವಿಕೆ<br><br>उद्वर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊರಳಾಡುವಿಕೆ<br><b>प्रयोगाः - </b>"चटुलशफरोद्वर्तनप्रोक्षितानि"<br><b>उल्लेखाः - </b>मेघ० १-४०<br><br>उद्वर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಜ್ಜುವಿಕೆ /ತಿಕ್ಕುವಿಕೆ<br><br>उद्वर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಳಿಯುವುದು /ಲೇಪನ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>उद् + वृतु (वर्तने) - भावे "ल्युट्" (३-३-११५)<br><br>

उद्वर्ययत्
उद्वर्ययत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಜ್ಜುತ್ತಿರುವ /ತಿಕ್ಕುತ್ತಿರುವ<br><br>उद्वर्ययत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಬ್ಬಿಸುತ್ತಿರುವ /ಮೇಲಕ್ಕೆ ಹೊರಡಿಸುತ್ತಿರುವ<br><br>उद्वर्ययत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೈಯನ್ನು ವಾಸನೆಪುಡಿಯಿಂದ ಸುಗಂಧವಾಗಿ ಮಾಡುವ<br><b>निष्पत्तिः - </b>उद् + वृतु (वर्तने) + णिच् - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"सफेनहासो जटिलप्रवालैरुद्वर्तयन्नूर्मिभुजैर्भुजङ्गम्"<br><b>उल्लेखाः - </b>याद० १८-९७<br><br>

उद्वर्तित
उद्वर्तित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಜ್ಜಲ್ಪಟ್ಟ /ತಿಕ್ಕಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + वृतु (वर्तने) - "क्तः" (३-२-१०२)<br><br>उद्वर्तित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಬ್ಬಿಸಲ್ಪಟ್ಟ /ಮೇಲಕ್ಕೆ ಹೊರಡಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"उद्वर्तितानां महसा मणीनामूर्ध्वं प्रसर्पन्तमिवोर्मिमन्तम्"<br><b>उल्लेखाः - </b>याद० १८-१०८<br><br>उद्वर्तित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಸನೆಪುಡಿಯಿಂದ ಸುಗಂಧವಾಗಿ ಮಾಡಲ್ಪಟ್ಟ<br><br>

उद्वर्धन
उद्वर्धन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂತರ್ಹಾಸ /ಮಂದಹಾಸ /ಹೊರಗೆ ತಿಳಿಯದಂತೆ ಒಳಗೇ ಮೆಲ್ಲನೆ ನಗುವುದು<br><b>निष्पत्तिः - </b>उद् + वृधु (वृद्धौ) - "ल्युट्" (३-३-११५)<br><b>विस्तारः - </b>"स्यादुर्ध्वनमन्तर्हासः" - त्रिकाण्ड० ।<br><br>उद्वर्धन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿಪಡಿಸುವುದು<br><b>निष्पत्तिः - </b>उद् + वृधु (वृद्धौ) + णिच् - "ल्युट्" (३-३-११५)<br><br>उद्वर्धन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೃದ್ಧಿಪಡಿಸುವ /ಅಧಿಕವಾಗಿಸುವ<br><b>निष्पत्तिः - </b>उद् + वृधु (वृद्धौ) + णिच् - "ल्युः" (३-१-१३४)<br><br>उद्वर्धन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಿ ಕತ್ತರಿಸುವ<br><b>निष्पत्तिः - </b>उद् + वर्ध (छेदने) - "ल्युः" (३-१-१३४)<br><br>

उद्वह
उद्वह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರ /ಮಗ<br><b>निष्पत्तिः - </b>उद् + वह (प्रापणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उद्वहति ऊर्ध्वं नयति अथवा ऊर्ध्वलोकं नयति पितॄन्<br><br>उद्वह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆವಹ ಮೊದಲಾದ ಸಪ್ತವಾಯುಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"आवहः प्रवहश्चैव विवहश्च समीरणः । परावहः संवहश्च उद्वहश्च महाबलः । तथा परिवहः श्रीमान् उत्पातभयशंसिनः । इत्येते क्षुभिताः सप्त मारुता गगनेचराः ॥"<br><b>उल्लेखाः - </b>हरिवं०<br><br>उद्वह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹ /ಮದುವೆ<br><b>निष्पत्तिः - </b>उद् + वह (प्रापणे) - "घः" (३-३-११८)<br><br>उद्वह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಂಶವನ್ನು ಮುಂದೆ ಬೆಳೆಸುವವನು /ವಂಶವನ್ನು ಮುಂದಕ್ಕೆ ತರುವವನು<br><b>प्रयोगाः - </b>"उदयमस्तमयं च रघूद्वहात्"<br><b>उल्लेखाः - </b>रघु० ९-९<br><br>उद्वह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದಕ್ಕೆ ಒಯ್ಯುವವನು /ಮುಂದಕ್ಕೆ ಸಾಗಿಸುವವನು<br><br>उद्वह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಧಾನ /ಮುಖ್ಯ /ಮುಂದಾಳು<br><br>

उद्वहा
उद्वहा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ಯೆ /ಮಗಳು<br><br>

उद्वहत्
उद्वहत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಹಿಸುತ್ತಿರುವ /ಹೊಂದಿರುವ /ಹೊತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + वह (प्रापणे) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"कान्ताऽलकान्ता ललनाः सुराणां रक्षोभिरक्षोभितमुद्वहन्तम्"<br><b>उल्लेखाः - </b>माघ० ४-९<br><br>

उद्वहन
उद्वहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊರುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + वह (प्रापणे) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"आपीनभारोद्वहनप्रयत्नात्" । "व्यादिश्यते भूधरतामवेक्ष्य कृष्णेन देहोद्वहनाय शेषः" ।<br><b>उल्लेखाः - </b>रघु० २-१८, कुमा० ३-१३<br><br>उद्वहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹ /ಮದುವೆ<br><b>प्रयोगाः - </b>"रसातलादादिभवेन पुंसाः भुवः प्रयुक्तोद्वहनक्रियायाः"<br><b>उल्लेखाः - </b>रघु० १३-८<br><br>

उद्वान
उद्वान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಂತಿ ಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + वन (सम्भक्तौ) - "घञ्" (३-३-१८)<br><br>

उद्वान्त
उद्वान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಂತಿ ಮಾಡಿದ<br><b>निष्पत्तिः - </b>उद् + टुवमु (उद्गिरणे) - "क्तः" (३-४-७२)<br><br>

उद्वाप
उद्वाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿತ್ತು ಹಾಕುವುದು<br><br>उद्वाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತುವುದು<br><br>उद्वाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊರಕ್ಕೆ ಹಾಕುವುದು /ತೆಗೆದುಹಾಕುವುದು<br><b>निष्पत्तिः - </b>उद् + टुवप् (बीजसन्ताने) - "घञ्"(३-३-१८)<br><br>उद्वाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂಡನ /ಭದ್ರಾಕರಣ<br><b>निष्पत्तिः - </b>उद् + टुवप् (बीजसन्ताने) + णिच् - "अच्" (३-१-१३४)<br><br>

उद्वास
उद्वास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಿತ್ಯಾಗ /ಬಿಟ್ಟು ಬಿಡುವುದು<br><br>उद्वास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಶದಿಂದ ಹೊರಕ್ಕೆ ಅಟ್ಟುವುದು<br><br>उद्वास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಲ್ಲುವುದು<br><b>निष्पत्तिः - </b>उद् + वास (उपसेवायाम्) - "घञ्" (३-३-१८)<br><br>

उद्वासनम्
उद्वासनम्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>उद्वास ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

उद्वाह
उद्वाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹ /ಮದುವೆ<br><b>निष्पत्तिः - </b>उद् + वह (प्रापणे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"विभावितं शिक्षितनाट्यवेदैरुद्वाहसङ्गीतमुदारक्लृप्तम्"<br><b>उल्लेखाः - </b>याद० १३-८१<br><br>उद्वाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತುವುದು /ನೀರು ಸೇದುವುದು /ಉದ್ಧರಣ<br><br>

उद्वाहन
उद्वाहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹ /ಮದುವೆ<br><b>निष्पत्तिः - </b>उद् + वह (प्रापणे) + णिच् - भावे "ल्युट्" (३-३-११५)<br><br>उद्वाहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎರಡು ಸಲ ಉಳಲ್ಪಟ್ಟ ಭೂಮಿ<br><b>व्युत्पत्तिः - </b>उद् उपरि वाहनं कर्षणं यत्र<br><br>उद्वाहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತುವುದು /ಮೇಲಕ್ಕೆ ಎಳೆಯುವುದು<br><b>विस्तारः - </b>"उद्घाटनं घटीयन्त्रं सलिलोद्वाहनं प्रहेः" - अम० ।<br><br>

उद्वाहनी
उद्वाहनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕವಡೆ<br><br>

उद्वाहिक
उद्वाहिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿವಾಹ ಸಂಬಂಧವಾದ ಮಂತ್ರ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-१०९)<br><b>व्युत्पत्तिः - </b>उद्वाहः प्रयोजनमस्य<br><b>प्रयोगाः - </b>"नोद्वाहिकेषु मन्त्रेषु नियोगः कीर्त्यते क्वचित्"<br><b>उल्लेखाः - </b>मनु० ९-६५<br><br>

उद्वाहित
उद्वाहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + वह (प्रापणे) + णिच् - "क्तः" (३-२-१०२)<br><br>उद्वाहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮದುವೆಯಾದವನು /ವಿವಾಹ ಮಾಡಿಕೊಂಡವನು<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>उद्वाहोऽस्य सञ्जातः<br><br>

उद्वाहिन्
उद्वाहिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮದುವೆಯಾಗುವವನು<br><br>उद्वाहिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾವಿಯಿಂದ ನೀರು ಸೇದುವವನು<br><br>

उद्वाहिनी
उद्वाहिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾವಿಯಿಂದ ನೀರು ಸೇದುವ ಹಗ್ಗ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५) । "ङीप्" (४-१-५)<br><b>व्युत्पत्तिः - </b>उद्वाहः उद्धरणं साध्यतयाऽस्त्यस्य<br><b>विस्तारः - </b>"उद्वाहनं द्विसीत्ये स्यात् रज्जावुद्वाहिनी मता" - मेदि० ।<br><br>

उद्विग्न
उद्विग्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ವೇಗವುಳ್ಳ /ಕಳವಳವುಳ್ಳ<br><br>उद्विग्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಂತಾಕ್ರಾಂತನಾದ /ವ್ಯಾಕುಲನಾದ<br><br>उद्विग्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆದರಿದ /ಭಯಗೊಂಡ<br><b>निष्पत्तिः - </b>उद् + ओविजी (भयचलनयोः) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"निमग्नोद्विग्नसंह्राणैः पप्रे दीनैश्च मेदिनी"<br><b>उल्लेखाः - </b>भट्टि० ४-४२<br><br>

उद्वीक्षण
उद्वीक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಊರ್ಧ್ವದೃಷ್ಟಿ /ಮೇಲುನೋಟ<br><b>निष्पत्तिः - </b>उद् + वि + ईक्ष (दर्शने) - भावे "ल्युट्" (३-३-११५)<br><br>उद्वीक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೇತ್ರ /ಕಣ್ಣು<br><b>निष्पत्तिः - </b>उद् + वि + ईक्ष (दर्शने) - कर० "ल्युट्" (३-३-११७)<br><b>प्रयोगाः - </b>"अथेप्सितं भर्तुरुपस्थितोदयं सखीजनोद्वीक्षणकौमुदीमुखम्"<br><b>उल्लेखाः - </b>रघु० ३-१<br><br>उद्वीक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತೀಕ್ಷಿಸುವಿಕೆ /ಕಾದುನೋಡುವಿಕೆ /ಎದುರು ನೋಡುವಿಕೆ<br><b>प्रयोगाः - </b>"विवरिष्यसि तच्चिरस्य नः समयोद्वीक्षणरक्षितां क्रुधम्"<br><b>उल्लेखाः - </b>माघ० १६-३७<br><br>

उद्वीक्षित
उद्वीक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲುಗಡೆ ನೋಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + वि + ईक्ष (दर्शने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"ज्योतिष्पथादवततार सविस्मयाभिरुद्वीक्षितं प्रकृतिभिर्भरतानुगाभिः"<br><b>उल्लेखाः - </b>रघु० १६-६८<br><br>

उद्वृत्त
उद्वृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎದ್ದಿರುವ /ಮೇಲಕ್ಕೆ ಏರಿರುವ<br><b>निष्पत्तिः - </b>उद् + वृतु (वर्तने) - "क्तः" (३-४-७२)<br><br>उद्वृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾರಿ ಬಿಟ್ಟು ಹೋಗಿರುವ /ತಪ್ಪು ದಾರಿಯಲ್ಲಿ ನಡೆಯುವ<br><b>व्युत्पत्तिः - </b>वृत्तमुत्क्रान्तः<br><b>प्रयोगाः - </b>"विश्लेषं युगमगमद्रथाङ्गनाम्नोरुद्धृतः क इव सुखावहः परेषाम्" । "अपामुद्वृत्तानां निजमुपदिशन्त्याः स्थितिपदम्" ।<br><b>उल्लेखाः - </b>माघ० ८-१८, मुद्रा० ३-८<br><br>उद्वृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಬ್ಬಿದ /ಅಹಂಕಾರದಿಂದ ಕೂಡಿದ<br><br>उद्वृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಭ್ಯ /ಅಶಿಕ್ಷಿತ<br><br>उद्वृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಲಕಲ್ಪಟ್ಟ /ಬುಡಮೇಲು ಮಾಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"तस्मात्समुद्रादिव मथ्यमानादुद्वृत्तनक्रात्सहसोन्ममज्ज"<br><b>उल्लेखाः - </b>रघु० १६-७९<br><br>

उद्वेग
उद्वेग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಯ /ಹೆದರಿಕೆ<br><b>प्रयोगाः - </b>"शान्तोद्वेगस्तिमितनयनं दृष्टभक्तिर्भवान्या"<br><b>उल्लेखाः - </b>मेघ० १-३६<br><br>उद्वेग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಳವಳ /ಗಾಬರಿ<br><b>प्रयोगाः - </b>"यस्मान्नोद्विजते लोको लोकान्नोद्विजते च यः । हर्षामर्षभयोद्वेगैर्मुक्तो यः स च मे प्रियः"<br><b>उल्लेखाः - </b>गीता० १२-१५<br><br>उद्वेग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಂತೆ /ಇಷ್ಟ ಜನರ ವಿರಹದಿಂದುಂಟಾದ ದುಃಖ<br><b>निष्पत्तिः - </b>उद् + ओ विजी (भयचलनयोः) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"मनोभिः सोद्वेगैः प्रणयविहतिध्वस्तरुचयः"<br><b>उल्लेखाः - </b>किरा० १०-६३<br><br>उद्वेग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಷ್ಟ /ಕ್ಲೇಶ<br><b>प्रयोगाः - </b>"यो जिह्वाग्रं बाधते उद्वेगं जनयति शिरो गृह्णीते नासिकाञ्च स्रावयति स कटुकः ॥"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>उद्वेग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಪನ /ನಡುಕ<br><br>उद्वेग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಡಕೆಕಾಯಿ<br><b>निष्पत्तिः - </b>कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>उद्विजन्तेऽनेन<br><b>प्रयोगाः - </b>"उद्वेगरागादिमृजावदाताः"<br><b>उल्लेखाः - </b>नैष० ७-४६<br><br>उद्वेग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇಗವಾದ /ಜಾಗ್ರತೆಯಾಗಿ ನಡೆತುವ<br><b>व्युत्पत्तिः - </b>उत्कृष्टो वेगो यस्य<br><br>उद्वेग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಲವಾದ /ಸ್ಥಿರವಾದ<br><b>व्युत्पत्तिः - </b>उद्गतो वेगो यस्मात्<br><br>

उद्वेजक
उद्वेजक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯವುಂಟುಮಾಡುವ /ಹೆದರಿಸುವ<br><br>उद्वेजक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನಸ್ಸನ್ನು ಕಲುಕುವ /ಕ್ಷೋಭೆಯುಂಟುಮಾಡುವ<br><br>उद्वेजक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ಲೇಶವುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>उद् + ओ विजी (भयचलनयोः) - "ण्वुल्" (३-१-१३३)<br><br>

उद्वेजन
उद्वेजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ವೇಗ /ಭಯ<br><br>उद्वेजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಳವಳ<br><b>निष्पत्तिः - </b>उद् + ओ विजी (भयचलनयोः) - "ल्युट्" (३-३-११५)<br><br>उद्वेजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾತನೆ /ಕಷ್ಟ /ತೊಂದರೆ<br><b>प्रयोगाः - </b>"परदाराभिमर्शेषु प्रवृत्तान् नॄन् महीपतिः । उद्वेजनकरैर्दण्डैश्चिह्नयित्वा प्रवासयेत् ॥"<br><b>उल्लेखाः - </b>मनु० ८-३५२<br><br>उद्वेजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿರಹ ದುಃಖ<br><br>उद्वेजन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯವುಂಟುಮಾಡುವ /ಹೆದರಿಸುವ<br><br>उद्वेजन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ಲೇಶವುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>कर्त० "ल्युः" (३-१-१३४)<br><br>

उद्वेजयितृ
उद्वेजयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯವುಂಟುಮಾಡುವ /ಹೆದರಿಸುವ<br><b>निष्पत्तिः - </b>उद् + ओ विजी (भयचलनयोः) + णिच् - "तृच्" (३-१-१३३)<br><b>प्रयोगाः - </b>"अत्यर्थमुद्वेजयिता परेषां नाम्नापि तस्यैव स नन्दकोऽभूत्"<br><b>उल्लेखाः - </b>माघ० ३-१९<br><br>उद्वेजयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ಲೇಶವುಂಟುಮಾಡುವ<br><br>

उद्वेजित
उद्वेजित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯಪಡಿಸಲ್ಪಟ್ಟ<br><br>उद्वेजित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಳವಳಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>उद्वेजित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಷ್ಟಪಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + ओ विजी (भयचलनयोः) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"उद्वेजिता वृष्टिभिराश्रयन्ते शृङ्गाणि यस्यातपवन्ति सिद्धाः"<br><b>उल्लेखाः - </b>कुमा० १-५<br><br>

उद्वेप
उद्वेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಪನ /ನಡುಕ<br><b>निष्पत्तिः - </b>उद् + टुवेपृ (कम्पने) - "घञ्" (३-३-१८)<br><br>उद्वेप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂಪಿಸುವ /ನಡುಗುವ<br><b>निष्पत्तिः - </b>कर्त० "अच्" (३-१-१३४)<br><br>

उद्वेल
उद्वेल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಡವನ್ನು ಮೀರಿರುವ /ದಡವನ್ನು ದಾಟಿ ಬಂದಿರುವ<br><b>व्युत्पत्तिः - </b>उत्क्रान्तो वेलाम्<br><b>प्रयोगाः - </b>"भयमप्रलयोद्वेलादाचख्युर्नैर्ऋतोदधेः"<br><b>उल्लेखाः - </b>रघु० १०-३४<br><br>उद्वेल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲೆ ಮೀರಿದ /ಮಿತಿ ಮೀರಿದ<br><b>प्रयोगाः - </b>"उद्वेलवेगांस्तनतो गभीरमौर्वप्रतिच्छन्दविदीप्तदृष्टीन्"<br><b>उल्लेखाः - </b>याद० २०-१५<br><br>उद्वेल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕವಾದ /ಹೆಚ್ಚಾದ<br><br>

उद्वेल्लत्
उद्वेल्लत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲೆ ಹಾರಾಡುತ್ತಿರುವ /ಮೇಲೆ ಚಲಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + वेल्ल (सञ्चलने) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"उद्वेल्लद्घनरुण्डखण्डनिकाराकीर्णस्य सङ्ख्योदधेः"<br><b>उल्लेखाः - </b>मालती० ७-९<br><br>

उद्वेल्लित
उद्वेल्लित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾಗಿ ಚಲಿಸಿರುವ /ಸ್ಥಾನ ಬಿಟ್ಟು ಹೋಗಿರುವ<br><b>व्युत्पत्तिः - </b>उद् उऊर्ध्वं वेल्लितः चलितः<br><b>प्रयोगाः - </b>"दूरोद्वेल्लितबाडबस्य जलधेरुल्लोलभिन्नाम्भसः"<br><b>उल्लेखाः - </b>म० वी० ५-२<br><br>

उद्वेष्टन
उद्वेष्टन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುತ್ತುಗೋಡೆ /ಬೇಲಿ /ಪ್ರಾಕಾರ<br><b>निष्पत्तिः - </b>उद् + वेष्ट (वेष्टने) - कर० "ल्युट्" (३-३-११७)<br><br>उद्वेष्टन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುತ್ತುಗಟ್ಟುವಿಕೆ /ಸುತ್ತುವರಿಯುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + वेष्ट (वेष्टने) - भावे "ल्युट्" (३-३-११५)<br><br>उद्वेष्टन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಡಿಲವಾದ ಗಂಟುಳ್ಳ /ಕಟ್ಟು ಸಡಿಲವಾಗಿರುವ<br><b>प्रयोगाः - </b>"आलोकमार्गं सहसा व्रजन्त्या कयाचिदुद्वेष्टनवान्तमाल्यः"<br><b>उल्लेखाः - </b>रघु० ७-६<br><br>

उद्वेष्टित
उद्वेष्टित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುತ್ತುವರಿಯಲ್ಪಟ್ಟ /ಸುತ್ತುಗಟ್ಟಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + वेष्ट (वेष्टने) - "क्तः" (३-२-१०२)<br><br>

उद्वोढृ
उद्वोढृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮದುವೆಯಾಗುವವನು<br><b>निष्पत्तिः - </b>उद् + वह (प्रापणे) - "तृच्" (३-१-१३३)<br><br>

उन्दुरु
उन्दुरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಷಿಕ /ಇಲಿ<br><b>निष्पत्तिः - </b>उन्दी (क्लेदने) - "उरुः" बाहु० ।<br><b>व्युत्पत्तिः - </b>उनत्ति<br><br>

उन्न
उन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒದ್ದೆಯಾದ /ನೆನದಿರುವ<br><br>उन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯಾಳು /ಕರುಣೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>उन्दी (क्लेदने) - "क्तः" (३-२-१०२)<br><b>विस्तारः - </b>"उन्नं क्लिन्ने दयापरे" - हेम० ।<br><br>

उन्नत
उन्नत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎತ್ತರವಾದ<br><b>प्रयोगाः - </b>"दधतमुन्नतसानुसमुद्धतां धृतसितव्यजनामिव जाह्नवीम्"<br><b>उल्लेखाः - </b>किरा० ५-१५<br><br>उन्नत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಹತ್ತಾದ /ಹಿರಿದಾದ /ದೊಡ್ಡದಾದ<br><b>प्रयोगाः - </b>"परिमलविषयस्तदुन्नतानामनुगमने खलु सम्पदोऽग्रतःस्थाः"<br><b>उल्लेखाः - </b>माघ० ७-२७<br><br>उन्नत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದಕ್ಕೆ ಉಬ್ಬಿರುವ<br><b>प्रयोगाः - </b>"सङ्क्षिप्तं निबिडोन्नतस्तनमुरः पार्श्वे प्रमृष्टे इव"<br><b>उल्लेखाः - </b>माल० २-३<br><br>

उन्नतता
उन्नतता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತರ /ಔನ್ನತ್ಯ<br><b>निष्पत्तिः - </b>"तल्"(५-१-११९)<br><b>व्युत्पत्तिः - </b>उनतस्य भावः<br><br>

उन्नतत्व
उन्नतत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತರ /ಔನ್ನತ್ಯ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

उन्नतानत
उन्नतानत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಳ್ಳತಿಟ್ಟಾದ ಪ್ರದೇಶ /ಎತ್ತರ ಮತ್ತು ತಗ್ಗಾದ ಪ್ರದೇಶ<br><b>व्युत्पत्तिः - </b>उन्नतं च तदानतं च<br><br>

उन्नति
उन्नति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ /ಅಭ್ಯುದಯ<br><b>निष्पत्तिः - </b>उद् + णम (प्रह्वत्वे) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"असतामनिशं तथाप्यहो गुरुहृद्रोगकरी तदुन्नतिः"<br><b>उल्लेखाः - </b>माघ० १६-२२<br><br>उन्नति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತರ /ಔನ್ನತ್ಯ<br><br>उन्नति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲ್ಮೆ /ಗೌರವ /ಪ್ರತಿಷ್ಠೆ<br><b>प्रयोगाः - </b>"स्तोकेनोन्नतिमायाति स्तोकेनायात्यधोगतिम्"<br><b>उल्लेखाः - </b>हितो०<br><br>उन्नति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರುಡನ ಪತ್ನಿ<br><b>विस्तारः - </b>"उन्नतिस्तार्क्ष्यभार्यायां समृद्धावुदयेऽपि च"- विश्व० ।<br><br>

उन्नद्ध
उन्नद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಿ ಕಟ್ಟಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + णह (बन्धने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"व्यूह्य स्थितः किञ्चिदिवोत्तरार्धमुन्नद्धचौडोऽञ्चितसव्यजानुः"<br><b>उल्लेखाः - </b>रघु० १८-५१<br><br>उन्नद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಿದ /ಉಬ್ಬಿದ /ಅಧಿಕವಾದ<br><br>

उन्नमत्
उन्नमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏಳುವ<br><b>निष्पत्तिः - </b>उद् + णम (प्रह्वत्वे) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"विन्ध्यायमानं दिवसस्य भर्तुर्मार्गं पुना रोद्धुमिवोन्नमद्भिः"<br><b>उल्लेखाः - </b>माघ० ४-२<br><br>उन्नमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಲೆಯನ್ನು ಮೇಲಕ್ಕೆ ಎತ್ತುತ್ತಿರುವ<br><br>

उन्नमन
उन्नमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉನ್ನತಿ /ಎತ್ತರ<br><b>निष्पत्तिः - </b>उद् + णम (प्रह्वत्वे) - "ल्युट्" (३-३-११५)<br><br>उन्नमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತುವುದು<br><br>

उन्नमित
उन्नमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲ್ಪಟ್ಟ /ಮೇಲುಮುಖವಾಗಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + णम (प्रह्वत्वे) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"सारसैः कलनिर्ह्रादैः क्वचिदुन्नमिताननौ"<br><b>उल्लेखाः - </b>रघु० १-४१<br><br>उन्नमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"उन्नमितैकभ्रूलतमाननमस्याः पदानि रचयन्त्याः" । "अयुपदुन्नमितभ्रु वीक्षितं च"<br><b>उल्लेखाः - </b>शाकु० ३-१२, किरा० १०-६१<br><br>

उन्नम्र
उन्नम्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎತ್ತರವಾದ /ಉನ್ನತವಾದ<br><b>निष्पत्तिः - </b>उद् +‍ णम (प्रह्वत्वे शब्दे च) - "रः" (३-२-१६७)<br><b>प्रयोगाः - </b>"उन्नम्रताम्रपटमण्डपमण्डितं तदानीलनागकुलसङ्कुलमाबभासे"<br><b>उल्लेखाः - </b>माघ० ५-६८<br><br>

उन्नय
उन्नय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ತರುವುದು /ಮೇಲಕ್ಕೆ ಎತ್ತುವುದು<br><b>निष्पत्तिः - </b>उद् + णीञ् (प्रापणे) - "अच्" (३-३-५६)<br><br>उन्नय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತರ್ಕ /ಊಹೆ<br><br>

उन्नयत्
उन्नयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತುತ್ತಿರುವ<br><br>उन्नयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಹಿಸುತ್ತಿರುವ<br><br>

उन्नयन
उन्नयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತರ್ಕ /ಊಹೆ<br><br>उन्नयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತುವುದು /ಮೇಲಕ್ಕೆ ಏರಿಸುವುದು<br><br>उन्नयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾವಿಯಿಂದ ನೀರನ್ನು ಮೇಲಕ್ಕೆ ಎಳೆಯುವುದು<br><b>निष्पत्तिः - </b>उद् + णीञ् (प्रापणे) - "ल्युट्" (३-३-११५)<br><br>उन्नयन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಿದ ಕಣ್ಣುಳ್ಳ /ಮೇಲೆ ನೋಡುವ<br><b>व्युत्पत्तिः - </b>उन्नमितं नयनं यस्य<br><br>

उन्नस
उन्नस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎತ್ತರವಾದ ಮೂಗುಳ್ಳ /ಉಬ್ಬಿದ ಮೂಗುಳ್ಳ<br><b>व्युत्पत्तिः - </b>उन्नता नासा यस्य<br><b>प्रयोगाः - </b>"उन्नसं दधती वक्त्रं शुद्धदल्लोलकुण्डलम्"<br><b>उल्लेखाः - </b>भट्टि० ४-१८<br><br>

उन्नाद
उन्नाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಚ್ಚಸ್ವರ /ಗಟ್ಟಿಯಾದ ಶಬ್ದ<br><b>निष्पत्तिः - </b>उद् + णद (अव्यक्ते शब्दे) - "घञ्"(३-३-१८)<br><br>

उन्नाय
उन्नाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತುವುದು /ಮೇಲಕ್ಕೆ ಏರಿಸುವುದು<br><br>उन्नाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತರ್ಕಿಸುವುದು /ಊಹಿಸುವುದು<br><b>निष्पत्तिः - </b>उद् + णीञ् (प्रापणे) - "घञ्" (३-३-२६)<br><br>

उन्नाह
उन्नाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಿ ಕಟ್ಟುವುದು<br><b>निष्पत्तिः - </b>उद् + णह (बन्धने) - "घञ्" (३-३-१८)<br><br>उन्नाह<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಜಿ /ಅಂಬಲಿ<br><b>विस्तारः - </b>"चुक्रं धातुघ्नमुन्नाहम्" - अभि० चि० ।<br><br>

उन्निद्र
उन्निद्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಳಿದ /ವಿಕಾಸ ಹೊಂದಿದ<br><b>व्युत्पत्तिः - </b>उद्गता निद्रा यस्य<br><b>प्रयोगाः - </b>"उन्निद्रपुष्पाक्षिसहस्रभाजा" । "उन्निद्रप्रियकमनोरमं रमण्याः" ।<br><b>उल्लेखाः - </b>माघ० ४-१३, माघ० ८-२८<br><br>उन्निद्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿದ್ರೆಯಿಲ್ಲದ /ಎಚ್ಚರವಾಗಿರುವ /ನಿದ್ರೆಯನ್ನು ಬಿಟ್ಟಿರುವ<br><b>व्युत्पत्तिः - </b>उद्गता निद्रा यस्मात्<br><b>प्रयोगाः - </b>"तामुन्निद्रामवनिशयनां सौधवातायनस्थः"<br><b>उल्लेखाः - </b>मेघ० २-२५<br><br>उन्निद्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿದ್ರೆಯಿಂದ ಎಚ್ಚರಗೊಂಡ<br><b>व्युत्पत्तिः - </b>उद्गता निद्रा यस्य<br><br>

उन्निनीषा
उन्निनीषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲು ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>उद् + णीञ् (प्रापणे) + सन् - "अः" (३-३-१०२)<br><b>व्युत्पत्तिः - </b>उन्नेतुमिच्छा<br><br>

उन्निनीषु
उन्निनीषु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲು ಅಪೇಕ್ಷೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>उद् + णीञ् (प्रापणे) + सन् - "उः" (३-२-१६८)<br><br>

उन्नीत
उन्नीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + णीञ् (प्रापणे) - "क्तः" (३-२-१०२)<br><br>उन्नीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತರ್ಕಿಸಲ್ಪಟ್ಟ /ಊಹಿಸಲ್ಪಟ್ಟ<br><br>

उन्नेतृ
उन्नेतृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತುವ<br><br>उन्नेतृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಹಿಸುವ<br><b>निष्पत्तिः - </b>उद् + णीञ् (प्रापणे) -"तृच्" (३-१-१३३)<br><br>

उन्नेत्री
उन्नेत्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उन्नेतृ ಪದದ ಸ್ತ್ರೀಲಿಂಗರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उन्नेय
उन्नेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲ್ಪಡುವ<br><br>

उन्नेय
उन्नेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏರಿಸಲು ಯೋಗ್ಯವಾದ<br><br>उन्नेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಹಿಸಲ್ಪಡುವ<br><br>उन्नेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಹಿಸಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>उद् + णीञ् (प्रापणे) -"यत्" (३-१-९७)<br><br>

उन्मज्जक
उन्मज्जक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂಠದವರೆಗೂ ನೀರಿನಲ್ಲಿ ನಿಂತು ತಪಸ್ಸು ಮಾಡುವವನು /ತಾಪಸ<br><b>निष्पत्तिः - </b>उद् + टुमस्जो (शुद्धौ) - "ण्वुल्" (३-१-१३३)<br><b>प्रयोगाः - </b>"कण्ठदध्ने जले स्थित्वा तपः कुर्वन् प्रवर्तते । उन्मज्जकः स विज्ञेयस्तापसो लोकपूजितः ॥"<br><br>उन्मज्जक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರಿನೊಳಗಿನಿಂದ ಎದ್ದು ತೇಲಾಡುವ<br><br>

उमज्जत्
उमज्जत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರಿನಿಂದ ಮೇಲಕ್ಕೆದ್ದು ತೇಲಾಡುತ್ತಿರುವ /ನೀರಿನಲ್ಲಿ ಮುಳುಗಿ ಮೇಲಕ್ಕೆ ಏಳುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + टुमस्जो (शुद्धौ) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"उन्मज्जन्मकर इवामरापगाया वेगेन प्रतिमुखमेत्य बाणनद्याः"<br><b>उल्लेखाः - </b>किरा० १७-६३<br><br>

उन्मज्जन
उन्मज्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನೊಳಗಿನಿಂದ ಎದ್ದು ತೇಲಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + टुमस्जो (शुद्धौ) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"सलिलोन्मज्जनमुज्झति स्फुटम्"<br><b>उल्लेखाः - </b>नैष० २-२७<br><br>

उन्मत्त
उन्मत्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಮ್ಮತ್ತಿ ಗಿಡ<br><br>उन्मत्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಚುಕುಂದ ವೃಕ್ಷ<br><b>निष्पत्तिः - </b>उन्मत्त + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उन्मत्तं करोति<br><br>उन्मत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಚ್ಚು ಹಿಡಿದವನು /ಬುದ್ಧಿಪಲ್ಲಟವಾದವನು<br><br>उन्मत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಮಲೇರಿದವನು /ಮದ್ಯಪಾನ ಮಾಡಿದವನು<br><b>निष्पत्तिः - </b>उद् + मदी (हर्षग्लेपनयोः) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"उन्मत्तं पतितं क्लीबमबीजं पापरोगिणम्"<br><b>उल्लेखाः - </b>मनु० ९-७९<br><br>उन्मत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕೋಪವುಳ್ಳ /ಕ್ರೂರ /ಪ್ರಚಂಡ<br><br>उन्मत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೂತಗ್ರಸ್ತ /ಪಿಶಾಚಿ ಹಿಡಿದವನು<br><br>उन्मत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕೊಬ್ಬಿರುವ<br><b>प्रयोगाः - </b>"मदोन्मत्तस्य भूपस्य कुञ्जरस्य च गच्छतः"<br><b>उल्लेखाः - </b>पञ्चतं०<br><br>

उन्मत्तगङ्ग
उन्मत्तगङ्ग<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಗಂಗಾನದಿಯು ಭೋರ್ಗರೆದು ಮೊರೆಯುತ್ತ ಹರಿಯುವ ದೇಶ /ಹೆಚ್ಚು ಪ್ರವಾಹದಿಂದ ಹರಿಯುತ್ತಿರುವ ಪ್ರದೇಶ<br><b>निष्पत्तिः - </b>अव्ययी० (२-१-१२)<br><b>व्युत्पत्तिः - </b>उन्मत्ता गङ्गा यस्मिन् देशे<br><br>

उन्मथन
उन्मथन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸುವಿಕೆ /ಪೀಡಿಸುವಿಕೆ<br><br>उन्मथन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಲ್ಲುವಿಕೆ /ನಾಶಪಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + मथे (विलोडने) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"अन्योन्यसूतोन्मथनादभुतां तावेव सूतौ रथिनौ च कौचित्"<br><b>उल्लेखाः - </b>रघु० ७-५२<br><br>उन्मथन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿಕ್ಕುವಿಕೆ /ಉಜ್ಜುವಿಕೆ<br><br>उन्मथन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೀಡಿಸುವ /ಹಿಂಸಿಸುವ<br><b>प्रयोगाः - </b>"विपक्षचित्तोन्मथना नखव्रणास्तिरोहिता विभ्रममण्डनेन ये"<br><b>उल्लेखाः - </b>किरा० ८-३४<br><br>

उन्मथित
उन्मथित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಕ್ಕಿ ಕೀಳಲ್ಪಟ್ಟ /ಉಜ್ಜಿ ಎಡೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + मथे (विलोडने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"कण्डूयमानेन कटं कदाचिद्वन्यद्विपेनोन्मथिता त्वगस्य"<br><b>उल्लेखाः - </b>रघु० २-३७<br><br>उन्मथित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೀಡಿಸಲ್ಪಟ್ಟ /ನೋಯಿಸಲ್ಪಟ್ಟ<br><br>

उन्मद
उन्मद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಮದವುಳ್ಳ /ಹೆಚ್ಚು ಅಮಲೇರಿದ<br><br>उन्मद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಸಂತೋಷವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>उद्गतो मदो हर्षो यस्य<br><b>प्रयोगाः - </b>"उदीरयामासुरिवोन्मदानामालोकशब्दं वयसां विरावैः"<br><b>उल्लेखाः - </b>रघु० २-९<br><br>उन्मद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮದವನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>उद् + मदी (हर्षग्लेपनयोः) + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उन्मदयति<br><b>प्रयोगाः - </b>"मधुकराङ्गनया मुहुरुन्मदध्वनिभृता निभृताक्षरमुज्जगे"<br><b>उल्लेखाः - </b>माघ० ६-२०<br><br>

उन्मदन
उन्मदन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮೋದ್ರೇಕವುಳ್ಳ /ಹೆಚ್ಚು ಮನ್ಮಥಬಾಧೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>उद्गतो मदनोऽस्य<br><b>प्रयोगाः - </b>"तदा प्रभृत्युन्मदना पितुर्गृहे ललाटिकाचन्दनधूसरालका"<br><b>उल्लेखाः - </b>कुमा० ५-५५<br><br>

उन्मदयत्
उन्मदयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಸಂತೋಷಗೊಳಿಸುವ<br><b>निष्पत्तिः - </b>उन्मद +णिच् - "शतृ" (३-२-१२४)<br><b>व्युत्पत्तिः - </b>उन्मदं करोति<br><b>प्रयोगाः - </b>"व्रजाजिरेष्वम्बुदनादशङ्किनीः शिखण्डिनामुन्मदयत्सु योषितः"<br><b>उल्लेखाः - </b>किरा० ४-१६<br><br>

उन्मदिष्णु
उन्मदिष्णु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕ ಮದವುಳ್ಳ<br><b>प्रयोगाः - </b>"सालीकदृष्टे मदनोन्मदिष्णुः"<br><b>उल्लेखाः - </b>नैष० ८-१८<br><br>उन्मदिष्णु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಸಂತೋಷಪಡುವ<br><b>निष्पत्तिः - </b>उद् + मदी (हर्षे) - "इष्णुच्"(३-२-१२६)<br><b>व्युत्पत्तिः - </b>उन्मदशीलः<br><br>

उन्मनस्
उन्मनस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಕಂಠೆಯುಳ್ಳ /ಪ್ರಿಯವಾದ ವಸ್ತುವನ್ನು ಹೊಂದುವುದರಲ್ಲಿ ತವಕಪಡುವ<br><b>व्युत्पत्तिः - </b>उद् उद्गतं मनो यस्य<br><br>उन्मनस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಸುಕನಾದ /ಪ್ರಿಯವಸ್ತುವಿಗಾಗಿ ಆಸೆಪಡುವ /ತ್ವರೆಪಡುವ<br><b>प्रयोगाः - </b>"उन्मनाः प्रथमजन्मचेष्टितान्यस्मरन्नपि बभूव राघवः"<br><b>उल्लेखाः - </b>रघु० ११-२२<br><br>उन्मनस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಳವಳಗೊಂಡ<br><br>उन्मनस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆದರಿದ<br><b>प्रयोगाः - </b>"महावनादुन्मनसः खगा इव प्रवृत्तपत्रध्वनयः शिलीमुखाः"<br><b>उल्लेखाः - </b>किरा० १४-४५<br><br>

उन्मनस्क
उन्मनस्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>उन्मनस् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>वा "कप्" (५-४-१५४)<br><br>

उन्मनायमान
उन्मनायमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಸುಕನಂತೆ ಆಚರಿಸುವ /ಉತ್ಸಾಹಿಯಂತೆ ನಡೆಯುವ<br><b>निष्पत्तिः - </b>उन्मनस् +क्यङ् - "शानच्" (३-२-१२४)<br><b>व्युत्पत्तिः - </b>उन्मना इवाचरति<br><br>

उन्मन्थ
उन्मन्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸುವಿಕೆ /ಪೀಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + मन्थ (विलोडने) - भावे "घञ्" (३-३-१८)<br><br>

उन्मन्थन
उन्मन्थन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಿನಿಂದ ಕೋಲು ಮೊದಲಾದುವುಗಳಿಂದ ಕಲಕುವುದು<br><b>निष्पत्तिः - </b>उद् + मन्थ (विलोडने) - भावे "ल्युट्" (३-३-११५)<br><br>उन्मन्थन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲಕುವ ಕೋಲು /ದಂಡ /ಮಂತು<br><b>निष्पत्तिः - </b>कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>उन्मथ्यतेऽनेन<br><br>

उन्मर्दन
उन्मर्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಸುಕುವುದು /ಮರ್ದಿಸುವುದು<br><br>उन्मर्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿಕ್ಕುವುದು /ಉಜ್ಜುವುದು<br><b>निष्पत्तिः - </b>उद् +मृद (क्षोदे) - "ल्युट्" (३-३-११५)<br><br>उन्मर्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾತವನ್ನು ಶುದ್ಧಿಗೊಳಿಸುವ ಕಾರ್ಯ<br><br>उन्मर्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಗೆ ಉಜ್ಜುವ ವಸ್ತು<br><b>निष्पत्तिः - </b>कर० "ल्युट्" (३-३-११७)<br><br>

उन्माथ
उन्माथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಧೆ /ಕೊಲ್ಲುವುದು<br><b>निष्पत्तिः - </b>उद् +मथि (हिंसायाम्) - "घञ्" (३-३-१८)<br><br>उन्माथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೃಗಗಳನ್ನು ಹಿಡಿಯುವ ಬೋನು<br><b>निष्पत्तिः - </b>उद् + मन्थ (विलोडने) - कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>उन्मथ्यतेऽनेन<br><br>उन्माथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಬ್ಬಿಸುವುದು<br><b>निष्पत्तिः - </b>मथे (विलोडने) - भावे "घञ्" (३-३-१८)<br><br>

उन्माद
उन्माद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಚ್ಚು /ಚಿತ್ತಪಲ್ಲಟ<br><b>निष्पत्तिः - </b>उद् +मदी (हर्षे) - "घञ्" (३-३-१८)<br><br>उन्माद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾತಕ ಲಕ್ಷಣೋಕ್ತವಾದ ಒಂದು ವ್ಯಭಿಚಾರಿಭಾವ<br><b>प्रयोगाः - </b>"चित्तसम्मोह उन्माद कामशोकभयादिभिः"<br><b>उल्लेखाः - </b>सा० द० ३-१६०<br><br>

उन्मादक
उन्मादक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ತಪಲ್ಲಟವನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>उद् +मदी (हर्षे) +णिच् - "ण्वुल्" (३-१-१३३)<br><br>

उन्मादन
उन्मादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹುಚ್ಚು ಹಿಡಿಸುವುದು /ಬುದ್ದಿಭ್ರಮೆಯನ್ನುಂಟುಮಾಡುವುದು<br><b>निष्पत्तिः - </b>उद् +मदी (हर्षे) +णिच् - "ल्युट्" (३-३-११५)<br><br>उन्मादन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಚ್ಚು ಹಿಡಿಸುವ /ಬುದ್ಧಿಭ್ರಮೆಯನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>उद् +मदी (हर्षे) +णिच् - "ल्युः" (३-१-१३४)<br><br>

उन्मादवत्
उन्मादवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಚ್ಚು ಹಿಡಿದಿರುವ /ಬುದ್ಧಿಭ್ರಮೆ ಹೊಂದಿರುವ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>उन्मादोऽस्यास्ति<br><br>

उन्मादवती
उन्मादवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹುಚ್ಚು ಹಿಡಿದಿರುವ /ಬುದ್ಧಿಭ್ರಮೆ ಹೊಂದಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

उन्मादिन्
उन्मादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮತ್ತನಾದ /ಚಿತ್ತಪಲ್ಲಟವುಳ್ಳ /ಹುಚ್ಚು ಹಿಡಿದ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५) ।<br><b>व्युत्पत्तिः - </b>उन्मादोऽस्यास्ति<br><br>

उन्मादिनी
उन्मादिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತನಾದ /ಚಿತ್ತಪಲ್ಲಟವುಳ್ಳ /ಹುಚ್ಚು ಹಿಡಿದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उन्मान
उन्मान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಿ ತೂಗುವುದು /ತೂಕದ ಕಲ್ಲು ಬಟ್ಟುಗಳಿಟ್ಟು ತೂಗುವುದು<br><b>निष्पत्तिः - </b>उद् + मा (माने) - भावे "ल्युट्" (३-३-११५)<br><br>उन्मान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಿನಿಂದ ಅಳತೆ ಮಾಡುವಿಕೆ<br><br>उन्मान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತ್ರಾಸು /ತಕ್ಕಡಿ<br><b>निष्पत्तिः - </b>कर० "ल्युट्" (३-३-११७)<br><br>

उन्मार्ग
उन्मार्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಪ್ಪು ದಾರಿ /ಕೆಟ್ಟ ನಡತೆ<br><b>व्युत्पत्तिः - </b>उद्गतश्चासौ मार्गश्च<br><br>उन्मार्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾರಿಬಿಟ್ಟು ನಡೆಯುವ /ತಪ್ಪು ದಾರಿಯಲ್ಲಿ ನಡೆಯುವ<br><b>व्युत्पत्तिः - </b>उत्क्रान्तो मार्गात्<br><br>

उन्मिष
उन्मिष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಕಾಸ ಹೊಂದಿದ /ಅರಳಿದ<br><b>निष्पत्तिः - </b>उद् + मिष (स्पर्धायाम्) - "कः" (३-१-१३५)<br><br>उन्मिष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಣ್ಣು ತೆರೆದಿರುವ<br><br>उन्मिष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶವಾದ<br><br>

उन्मिषत्
उन्मिषत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಕಾಸ ಹೊಂದುತ್ತಿರುವ /ಅರಳುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + मिष (स्पर्धायाम्) - "शतृ" (३-२-१२४)<br><br>उन्मिषत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಿಸುತ್ತಿರುವ /ಹೊಳೆಯುತ್ತಿರುವ<br><br>उन्मिषत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಣ್ಣು ತೆರೆಯುತ್ತಿರುವ<br><br>

उन्मिषित
उन्मिषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಟ /ವೀಕ್ಷಣ<br><b>निष्पत्तिः - </b>उद् + मिष (स्पर्धायाम्) - भावे "क्तः" (३-३-११४)<br><b>प्रयोगाः - </b>"व्यलोकयन्नुन्मिषितैस्तटिन्मयैर्महातपः साक्ष्य इव स्थिताः क्षपाः"<br><b>उल्लेखाः - </b>कुमा० ५-२५<br><br>उन्मिषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಣ್ಣು ತೆರೆದಿರುವಿಕೆ /ಬಿಟ್ಟಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"तद्वल्गुना युगपदुन्मिषितेन तावत्सद्यः परस्परतुलामधिरोहतां द्वे"<br><b>उल्लेखाः - </b>रघु० ५-६८<br><br>उन्मिषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಳಿದ /ವಿಕಾಸ ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>उद् + मिष (स्पर्धायाम्) - कर्त० "क्तः" (३-४-७२)<br><br>

उन्मीलत्
उन्मीलत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಳುತ್ತಿರುವ /ವಿಕಾಸ ಹೊಂದುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + मील (निमेषणे) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"उन्मीलन्मुकुलकरालकुन्दकोशप्रच्योतद्घनमकरन्दगन्धबन्धो"<br><b>उल्लेखाः - </b>मालती० १-४१<br><br>उन्मीलत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಣ್ಣು ತೆರೆಯುತ್ತಿರುವ<br><br>

उन्मीलन
उन्मीलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಕಾಸ /ಅರಳುವಿಕೆ<br><br>उन्मीलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣು ತೆರೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + मिष (स्पर्धायाम्) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"ज्ञानाञ्जनशलाकाभिर्नेत्रोन्मीलनकारकः"<br><b>उल्लेखाः - </b>भा०<br><br>

उन्मीलित
उन्मीलित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಕಾಸ /ಅರಳುವಿಕೆ<br><br>उन्मीलित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣು ತೆರೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + मिष (स्पर्धायाम्) - भावे "क्तः" (३-३-११४)<br><b>प्रयोगाः - </b>"निरीक्ष्यमाणा इव विस्मयाकुलैः पयोभिरुन्मीलितपद्मलोचनैः" । "ते चोन्मीलितमालतीसुरभयः प्रौढाः कदम्बानिलाः" ।<br><b>उल्लेखाः - </b>किरा० ४-३, सा० द०<br><br>उन्मीलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಕಾಸ ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>उद् + मिष (स्पर्धायाम्) - "क्तः" (३-४-७२)<br><br>उन्मीलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆರೆದಿರುವ /ಬಿಚ್ಚಿರುವ<br><br>उन्मीलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆರೆಯಲ್ಪಟ್ಟ /ಬಿಚ್ಚಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + मिष (स्पर्धायाम्) - कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अज्ञानतिमिरान्धस्य ज्ञानाञ्जनशलाकया । चक्षुरुन्मीलितं येन तस्मै श्री गुरवे नमः ॥"<br><br>उन्मीलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಣ್ಣ ಹಾಕಿ ಪ್ರಕಾಶಗೊಳಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"उन्मीलितं तूलिकयेव चित्रं सूर्यांशुभिर्भिन्नमिवारविन्दम्"<br><b>उल्लेखाः - </b>कुमा० १-३२<br><br>

उन्मुक्त
उन्मुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಡಲ್ಪಟ್ಟ /ಬಂಧನದಿಂದ ಬಿಡುಗಡೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + मुच्लृ (मोक्षणे) - "क्तः" (३-२-१०२)<br><br>

उन्मुख
उन्मुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲುಮುಖವಾದ /ಮುಖವನ್ನು ಮೇಲಕ್ಕೆ ಮಾಡಿರುವ<br><b>व्युत्पत्तिः - </b>उद् ऊर्ध्वं मुखमस्य<br><b>प्रयोगाः - </b>"मनोऽभिरामाः शृण्वन्तौ रथनेमिस्वनोन्मुखैः" । "ते सद्मनि गिरेर्वेगादुन्मुखाद्वाःस्थवीक्षिताः" ।<br><b>उल्लेखाः - </b>रघु० १-३९, कुमा० ६-४८<br><br>उन्मुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ಯುಕ್ತನಾದ /ಪ್ರಯತ್ನಶೀಲ<br><br>उन्मुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಸುಕನಾದ /ತವಕಪಡುವ<br><b>प्रयोगाः - </b>"तस्मिन् संयमिनामाद्ये जाते परिणयोन्मुखे"<br><b>उल्लेखाः - </b>कुमा० ६-३४<br><br>उन्मुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಿದ್ಧನಾಗಿರುವ /ಅಣಿಯಾಗಿರುವ<br><b>प्रयोगाः - </b>"पतिः प्रतीतः प्रसविन्मुखीं प्रियां ददर्श काले दिवमभ्रितामिव"<br><b>उल्लेखाः - </b>रघु० ३-१२<br><br>

उन्मुद्र
उन्मुद्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಳಿದ /ವಿಕಾಸ ಹೊಂದಿದ<br><br>उन्मुद्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆರೆದಿರುವ /ಬಿಚ್ಚಿರುವ<br><b>व्युत्पत्तिः - </b>उद्गता मुद्रा यस्य<br><br>

उन्मूलन
उन्मूलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರು ಸಹಿತ ಕಿತ್ತು ಹಾಕುವುದು<br><b>निष्पत्तिः - </b>उन्मूल + (नामधातु) + णिच् - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"न पादपोन्मूलनशक्ति रंहः शिलोच्चये मूर्च्छति मारुतस्य"<br><b>उल्लेखाः - </b>रघु० २-३४<br><br>

उन्मूलित
उन्मूलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರು ಸಹಿತ ಕಿತ್ತು ಹಾಕಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उन्मूल +(नामधातु) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"उन्मूलितालानबिलाभनाभिः"<br><b>उल्लेखाः - </b>नैष० ७-८५<br><br>

उन्मेय
उन्मेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಳೆಯಲ್ಪಡುವ<br><br>उन्मेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಳೆಯಲು ಅರ್ಹವಾದ<br><b>निष्पत्तिः - </b>उद् + माङ् (माने) - "यत्" (३-१-९७)<br><b>विस्तारः - </b>"आचितः शाकटोन्मेये" - मेदि० ।<br><br>

उन्मेष
उन्मेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣು ಮೊದಲಾದುವನ್ನು ತೆರೆಯುವುದು<br><br>उन्मेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಳುವುದು /ವಿಕಾಸ ಹೊಂದುವುದು<br><b>निष्पत्तिः - </b>उद् + मिष (स्पर्धायाम्) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"प्रत्यग्रोन्मेषजिह्मा क्षणमनभिमुखी रत्नदीपप्रभाणाम्" । "दीर्घिकाकमलोन्मेषो यावन्मात्रेण साध्यते"<br><b>उल्लेखाः - </b>मुद्रा० ३-२१, कुमा० २-३३<br><br>उन्मेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶ /ಬೆಳಕು<br><b>प्रयोगाः - </b>"खद्योतालीविलसितनिभां विद्युदुन्मेषदृष्टिम्"<br><b>उल्लेखाः - </b>मेघ० २-१८<br><br>

उन्मेषण
उन्मेषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>उन्मेष ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

उन्मेषिन्
उन्मेषिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಿಸುವ /ಉಜ್ಜ್ವಲವಾದ<br><b>निष्पत्तिः - </b>उद् + मिष (स्पर्धायाम्) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>उन्मिषति<br><br>उन्मेषिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಡುವ ಸ್ವಭಾವದ<br><b>प्रयोगाः - </b>"प्रेङ्खद्भूरिमयूरमेचकयैरुन्मेषिचाषच्छदच्छायासंवलितैर्विवर्तिभिरिव प्रान्तेषु पर्यावृताः" ।<br><b>उल्लेखाः - </b>मालती० ६-५<br><br>उन्मेषिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಳಿಸುವ /ವಿಕಾಸ ಪಡಿಸುವ<br><br>

उन्मेषिणी
उन्मेषिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उन्मेषिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><b>प्रयोगाः - </b>"उन्मेषिणी सुमनसामुदिता पुरस्ताच्चक्रप्रभामनुकरोति मरीचिमाला"<br><b>उल्लेखाः - </b>याद० १९-३०<br><br>

उप
उप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಧಿಕ /ಹೆಚ್ಚು<br><b>प्रयोगाः - </b>"उपपरार्धे हरेर्गुणाः"<br><br>उप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕಡಮೆ /ಹೀನ<br><b>प्रयोगाः - </b>उपगुरुः, उपपुराणम् ।<br><br>उप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಾಮೀಪ್ಯ /ಹತ್ತಿರ<br><b>प्रयोगाः - </b>उपमेखलम्<br><br>उप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಶಕ್ತಿ /ಸಾಮರ್ಥ್ಯ<br><b>प्रयोगाः - </b>उपकरोति<br><br>उप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಚಾರ್ಯನನ್ನಾಗಿ ಮಾಡುವುದು /ಗುರುವನ್ನಾಗಿ ಮಾಡುವಿಕೆ<br><b>प्रयोगाः - </b>उपनयते<br><br>उप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ದಾನ /ಕೊಡುಗೆ<br><b>प्रयोगाः - </b>उपहरति<br><br>उप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಯತ್ನ /ಗುಣಾಧಾನ<br><b>प्रयोगाः - </b>उपस्करणम् ।<br><br>उप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಪ್ತಿ /ಹರಡುವಿಕೆ<br><b>प्रयोगाः - </b>उपकीर्णम् ।<br><br>उप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪೂಜೆ<br><b>प्रयोगाः - </b>उपचारः ।<br><br>उप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅತ್ಯಯ /ನಾಶ<br><b>प्रयोगाः - </b>उपरतिः ।<br><br>उप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ದೋಷ /ಶಕ್ತಿ ಕಳೆದುಕೊಳ್ಳುವಿಕೆ<br><b>प्रयोगाः - </b>उपहतेन्द्रियः ।<br><br>उप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ<br><b>प्रयोगाः - </b>उपक्रमते ।<br><br>उप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಭೂಷಣ /ಅಲಂಕಾರ<br><b>प्रयोगाः - </b>उपस्कृता कन्या ।<br><br>उप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಗುಂಪುಕಟ್ಟುವುದು /ಒಟ್ಟಿಗೆ ಸೇರುವುದು<br><b>प्रयोगाः - </b>उपस्कृता देवाः ।<br><br>उप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿಕಾರ ಹೊಂದುವುದು /ಬದಲಾವಣೆ ಹೊಂದುವುದು<br><b>प्रयोगाः - </b>उपस्कृतं भुङ्क्ते ।<br><br>उप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಾಕ್ಯಾಧ್ಯಾಹಾರ<br><b>प्रयोगाः - </b>उपस्कृतं ब्रूते ।<br><br>उप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಾದೃಶ್ಯ /ಹೋಲಿಕೆ<br><b>प्रयोगाः - </b>उपमा , उपमितिः ।<br><br>उप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೊಂದುವ ಅಪೇಕ್ಷೆ<br><br>उप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ದಾಕ್ಷಿಣ್ಯ<br><br>उप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಮಾಧಾನ<br><b>प्रयोगाः - </b>भृत्यानुपवदते ।<br><br>उप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಾರ್ಥನೆ<br><b>प्रयोगाः - </b>उपवदते ।<br><br>उप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಭರಣ /ಪೋಷಣೆ<br><b>विस्तारः - </b>"उप सामर्थ्यदाक्षिण्यदोषाख्यानात्ययेषु च । आचार्यकरणे दाने व्याप्तावारम्भपूजयोः । तद्योगेऽपि च लिप्सायां भरणार्थोपमार्थयोः । उप हीनेऽधिके प्रोक्तोऽप्यासन्नेप्युपकीर्तितः" - विश्व० ।<br><br>

उपकण्ठ
उपकण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿರ /ಸಮೀಪ<br><b>प्रयोगाः - </b>"प्राप तालीवनश्याममुपकण्ठं महोदधेः" । "जगत्प्रसूतिर्जगदेकपावनी व्रजोपकण्ठं तनयैरुपेयुषी" ।<br><b>उल्लेखाः - </b>रघु० ४-३४, किरा० ४-३२<br><br>उपकण्ठ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಾಮದ ಕೊನೆಯ ಪ್ರದೇಶ<br><br>उपकण्ठ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಒಂದು ವಿಧ ನಡೆ /ಅಶ್ವಗತಿಯ ಒಂದು ಭೇದ<br><b>विस्तारः - </b>"उत्तेरितमुपकण्ठमास्कन्दितमामित्यपि" - अभि० चि० ।<br><br>उपकण्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದ /ಸಮೀಪದ<br><b>व्युत्पत्तिः - </b>उपगतः कण्ठः सामीप्यमस्य<br><br>उपकण्ठ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕಂಠದಲ್ಲಿ /ಕುತ್ತಿಗೆಯಲ್ಲಿ<br><b>प्रयोगाः - </b>"श्लिष्यतः प्रियवधूरुपकण्ठम्"<br><b>उल्लेखाः - </b>किरा० ९-२७<br><br>उपकण्ठ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ<br><b>प्रयोगाः - </b>"निमीलदाकेकरलोलचक्षुषां प्रियोपकण्ठं कृतगात्रवेपथुः" । "प्रेम्णोपकण्ठं मुहुरङ्कभाजः" ।<br><b>उल्लेखाः - </b>किरा० ८-५३, माघ० ३-३६<br><br>उपकण्ठ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕುತ್ತಿಗೆಯ ಸಮೀಪದಲ್ಲಿ<br><br>

उपकनिष्ठिका
उपकनिष्ठिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಾಮಿಕೆ /ಕಿರುಬೆರಳಿನ ಪಕ್ಕದ ಬೆರಳು<br><b>व्युत्पत्तिः - </b>उपगता कनिष्ठिकायाम्<br><br>

उपकरण
उपकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಹಾಯ್ಯ /ಒತ್ತಾಸೆ<br><br>उपकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಲಕರಣೆ /ಸಾಧನ /ಸಹಾಯವಸ್ತು /ಕೆಲಸದ ಸಾಮಾನುಗಳು<br><b>प्रयोगाः - </b>"परोपकारोपकरणं शरीरम्"<br><b>उल्लेखाः - </b>कादं०<br><br>उपकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜರ ಮರ್ಯಾದೆಯ ವಸ್ತು<br><br>उपकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜೀವನೋಪಾಯ<br><br>उपकरण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯವನ್ನು ಅನುಸರಿಸಿರುವ<br><b>व्युत्पत्तिः - </b>करणमुपगतः<br><br>उपकरण<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯದಲ್ಲಿ<br><b>व्युत्पत्तिः - </b>करणे उपकरणम्<br><br>उपकरण<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯದ ಸಮೀಪ<br><b>व्युत्पत्तिः - </b>करणस्य समीपम्<br><br>

उपकर्ण
उपकर्ण<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕಿವಿಯಲ್ಲಿ<br><b>व्युत्पत्तिः - </b>कर्णे<br><br>उपकर्ण<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕಿವಿಯ ಸಮೀಪ<br><b>व्युत्पत्तिः - </b>कर्णस्य समीपम्<br><br>

उपकर्तृ
उपकर्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಕಾರ ಮಾಡುವ /ಸಾಹಾಯ್ಯ ಮಾಡುವ<br><b>निष्पत्तिः - </b>उप + डुकृञ् (करणे) - "तृच्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>उपकरोति<br><b>प्रयोगाः - </b>"उपकर्त्रारिणा सन्धिर्न मित्रेणापकारिणा"<br><b>उल्लेखाः - </b>माघ० २-३७<br><br>

उपकत्री
उपकत्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಕಾರ ಮಾಡುವ /ಸಾಹಾಯ್ಯ ಮಾಡುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उपकल्पन
उपकल्पन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿರ್ಮಾಣ /ತಯಾರಿಕೆ<br><br>उपकल्पन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಿದ್ಧತೆ /ಸನ್ನಾಹ<br><b>निष्पत्तिः - </b>उप +क्लृपू (सामर्थ्ये) + णिच् - "ल्युट्" (३-३-११५)<br><br>

उपकार
उपकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಹಾಯ್ಯ /ಒತ್ತಾಸೆ<br><b>निष्पत्तिः - </b>उप + डुकृञ् (करणे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"उपकारापकारौ हि लक्ष्यं लक्षणमेतयोः" । "शाम्येत्प्रत्यपकारेण नोपकारेण दुर्जनः" ।<br><b>उल्लेखाः - </b>माघ० २-३७, कुमा० २-४०<br><br>

उपकारक
उपकारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಕಾರ ಮಾಡುವ /ಸಾಹಾಯ್ಯ ಮಾಡುವ<br><b>निष्पत्तिः - </b>उप + डुकृञ् (करणे) - "ण्वुल्" (३-१-१३३)<br><b>प्रयोगाः - </b>"आगन्तवोऽपि कदाचिदुपकारका दृश्यन्ते" । "उपकारकमायतेर्भृशं प्रसवः कर्मफलस्य भूरिणः" ।<br><b>उल्लेखाः - </b>हितो०, किरा० २-४३<br><br>

उपकारिका
उपकारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಕಾರ ಮಾಡುವ /ಸಾಹಾಯ್ಯ ಮಾಡುವ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्" (४-१-४)<br><br>उपकारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರಮನೆ /ರಾಜಗೃಹ<br><b>निष्पत्तिः - </b>उप + डुकृञ् (करणे) - "ण्वुल्" (३-१-१३३) । "टाप्" (४-१-४)<br><b>प्रयोगाः - </b>"भ्रमन्नमुष्यामुपकारिकायामायस्य भैमीविरहात्क्रशीयान्"<br><b>उल्लेखाः - </b>नैष० ६-३६<br><br>

उपकारवत्
उपकारवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಕಾರವುಳ್ಳ /ಉಪಕಾರ ಮಾಡುವ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>उपकारोऽस्त्यस्य<br><b>प्रयोगाः - </b>"युक्ताः स्वशक्त्या मुनयः प्रजानां हितोपदेशैरुपकारवन्तः"<br><b>उल्लेखाः - </b>किरा० १८-२९<br><br>

उपकारिन्
उपकारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಕಾರ ಮಾಡುವ /ಸಾಹಾಯ್ಯ ಮಾಡುವ<br><b>निष्पत्तिः - </b>उप + डुकृञ् (करणे) - "णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"हिमऋतावपि ताः स्म भृशस्विदो युवतयः सुरतामुपकारिणि" । "मन्मथेन परिलिप्लमतीनां प्रायशः स्खलितमप्युपकारि" ।<br><b>उल्लेखाः - </b>माघ० ६-६१, किरा० ९-३७<br><br>

उपकारिणी
उपकारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಕಾರ ಮಾಡುವ /ಸಾಹಾಯ್ಯ ಮಾಡುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उपकार्य
उपकार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಕಾರಕ್ಕೆ ಅರ್ಹವಾದ /ಸಾಹಾಯ್ಯ ಹೊಂದಲು ಯೋಗ್ಯನಾದ<br><b>निष्पत्तिः - </b>उप + डुकृञ् (करणे) - "ण्यत्" (३-१-१२४)<br><br>

उपकार्या
उपकार्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜಗೃಹ /ಅರಮನೆ<br><b>प्रयोगाः - </b>"रम्यां रघुप्रतिनिधिः स नवोपकार्यां बाल्यात्परामिव दशां मदनोऽध्युवास" ।<br><b>उल्लेखाः - </b>रघु० ५-४३<br><br>उपकार्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಟಗೃಹ /ಡೇರೆ /ಬಟ್ಟೆಯಿಂದ ನಿರ್ಮಿತವಾದ ಮನೆ<br><b>प्रयोगाः - </b>"स तीरभूमौ विहितोपकार्यामानायिभिस्तामपकृष्टनक्राम्" ।<br><b>उल्लेखाः - </b>रघु० १६-५५<br><br>

उपकुञ्चिका
उपकुञ्चिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿಜಿರಿಗೆ<br><br>उपकुञ्चिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಯಾಲಕ್ಕಿ<br><br>उपकुञ्चिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಸಾಂಜನ<br><b>निष्पत्तिः - </b>उप + कुञ्च (कौटिल्ये) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>उपकुञ्जति<br><br>

उपकुर्वत्
उपकुर्वत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಕಾರ ಮಾಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उप + डुकृञ् (करणे) - "शतृ" (३-२-१२४)<br><br>

उपकुर्वाण
उपकुर्वाण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣ ವೇದಾಧ್ಯೌಅನ ಮಾಡಿ ಗೃಹಸ್ಥನಾಗಲು ಸಿದ್ಧನಾಗಿರುವ ಬ್ರಹ್ಮಚಾರಿ<br><b>निष्पत्तिः - </b>उप + डुकृञ् (करणे) - "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"न पूर्वं गुरवे किञ्चित् उपकुर्वीत धर्मवित् । स्नास्यंस्तु गुरुणाज्ञप्तः शक्त्या गुर्वर्थमाहरेत् ॥"<br><b>उल्लेखाः - </b>मनु० २-२४५<br><br>उपकुर्वाण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಕಾರದ ಸ್ವಭಾವದವನು<br><b>निष्पत्तिः - </b>उप + डुकृञ् (करणे) - ताच्छील्ये "चानश्" (३-२-१२९)<br><br>

उपकुल्या
उपकुल्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಪ್ಪಲಿ ಗಿಡ<br><b>निष्पत्तिः - </b>उप + कुल (संस्त्याने बन्धुषु च) - निपा० (उ० ४-११२)<br><br>

उपकूप
उपकूप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಬಾವಿಯಲ್ಲಿ<br><b>व्युत्पत्तिः - </b>कूपे<br><br>उपकूप<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಬಾವಿಯ ಹತ್ತಿರ<br><b>व्युत्पत्तिः - </b>कूपस्य समीपम्<br><br>

उपकूल
उपकूल<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ತೀರದಲ್ಲಿ /ದಡದಲ್ಲಿ<br><b>व्युत्पत्तिः - </b>कूले<br><br>उपकूल<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ದಡದ ಹತ್ತಿರ /ತೀರದ ಸಮೀಪ<br><b>व्युत्पत्तिः - </b>कूलस्य समीपम्<br><br>

उपकृत
उपकृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಕಾರ /ಸಾಹಾಯ್ಯ<br><b>निष्पत्तिः - </b>उप + डुकृञ् (करणे) - "क्तः" (३-३-११४)<br><br>उपकृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಕಾರ ಮಾಡಲ್ಪಟ್ಟ /ಸಾಹಾಯ್ಯ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + डुकृञ् (करणे) - "क्तः" (३-२-१०२)<br><br>

उपकृति
उपकृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಕಾರ /ಸಾಹಾಯ್ಯ<br><b>निष्पत्तिः - </b>उप + डुकृञ् (करणे) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"पतगेन मया जगत्पतेरुपकृत्यै तव किं प्रभूयते"<br><b>उल्लेखाः - </b>नैष० २-१३<br><br>

उपकृतिन्
उपकृतिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಕಾರ ಮಾಡಿದವನು /ಸಾಹಾಯ್ಯ ನೀಡಿದವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-८८)<br><b>व्युत्पत्तिः - </b>उपकृतमर्थेन<br><br>

उपक्लृप्त
उपक्लृप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಿದ್ಧವಾದ<br><br>उपक्लृप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಯಾರಾದ<br><b>निष्पत्तिः - </b>उप + कृपू (सामर्थ्ये) - "क्तः" (३-४-७२)<br><br>उपक्लृप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರ ಇಡಲ್ಪಟ್ಟ /ಸಮೀಪಕ್ಕೆ ತರಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कर्म० "क्तः" (३-२-१०२)<br><br>

उपक्रम
उपक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭಿಸುವಿಕೆ /ಮೊದಲು ಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + क्रमु (पादविक्षेपे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"रामोपक्रममाचख्यौ रक्षःपरिभवं नवम्"<br><b>उल्लेखाः - </b>रघु० १२-४२<br><br>उपक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ /ಮೊದಲು<br><br>उपक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಮ ಮೊದಲಾದ ಉಪಾಯ<br><b>प्रयोगाः - </b>"उपक्रमैरस्खलितैश्चतुर्भिश्चतुर्दिगीशश्चतुरो बभूव"<br><b>उल्लेखाः - </b>रघु० १८-१५<br><br>उपक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಥಮ ಪ್ರವೇಶ /ಮೊದಲು ಸಮೀಪಕ್ಕೆ ಹೋಗುವುದು<br><b>प्रयोगाः - </b>"कुसुमधर्माणो हि योषितः सुकुमारोपक्रमाः"<br><b>उल्लेखाः - </b>मालती० ७<br><br>उपक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಕಿತ್ಸೆ /ವೈದ್ಯೋಪಚಾರ<br><b>निष्पत्तिः - </b>उप + क्रमु (पादविक्षेपे) - कर० "घञ्" (३-३-१२१)<br><br>

उपक्रमण
उपक्रमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭಿಸುವಿಕೆ /ಮೊದಲು ಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + क्रमु (पादविक्षेपे) - भावे "ल्युट्" (३-३-११५)<br><br>उपक्रमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗಿಯ ಆಯಸ್ಸನು ತಿಳಿದು ಮಾಡುವ ವೈದ್ಯ ಚಿಕಿತ್ಸೆ /ಔಷಧೋಪಚಾರ<br><b>निष्पत्तिः - </b>उप + क्रमु (पादविक्षेपे) - कर० "ल्युट्" (३-३-११७)<br><br>उपक्रमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಬರುವುದು /ಹತ್ತಿರಕ್ಕೆ ಬರುವುದು<br><br>

उपक्रमणिका
उपक्रमणिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಂಥದ ಪ್ರಸ್ತಾವನೆ /ಉಪೋದ್ಘಾತ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५) । स्वार्थे "कन्"<br><br>

उपक्रमणीय
उपक्रमणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆರಂಭಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उप + क्रमु (पादविक्षेपे) -"अनीयर्" (३-१-९६)<br><br>उपक्रमणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಕಿತ್ಸೆಗೆ ಬೇಕಾದ ದೀರ್ಘಾಯುಷ್ಯವನ್ನು ತಿಳಿಸುವ ಲಕ್ಷಣ<br><b>व्युत्पत्तिः - </b>उपक्रमणे साधु<br><br>उपक्रमणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೀಗಿಯ ಚಿಕಿತ್ಸೆಗೆ ಸಂಬಂಧಿಸಿದ ಗ್ರಂಥ<br><br>

उपक्रान्त
उपक्रान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭಿಸಲ್ಪಟ್ಟ /ಉಪಕ್ರಮಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + क्रमु (पादविक्षेपे) - "क्तः" (३-२-१०२)<br><br>

उपक्रिया
उपक्रिया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಕಾರ /ಸಾಹಾಯ್ಯ<br><b>निष्पत्तिः - </b>उप + क्रमु (पादविक्षेपे) - भावे "शः" (३-३-१००)<br><b>प्रयोगाः - </b>"अचिरादुपकर्तुराचरेदथ वात्मौपयिकीमुपक्रियाम्"<br><b>उल्लेखाः - </b>नैष० २-१४<br><br>

उपक्रोश
उपक्रोश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ<br><b>निष्पत्तिः - </b>उप + क्रुश (आह्वाने रोदने च) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"राज्येन किं तद्विपरीतवृत्तेः प्राणैरुपक्रोशमलीमसैर्वा"<br><b>उल्लेखाः - </b>रघु० २-५३<br><br>

उपक्रोष्टृ
उपक्रोष्टृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ದಭ /ಕತ್ತೆ<br><b>निष्पत्तिः - </b>उप + क्रुश (आह्वाने रोदने च) - "तृच्" (३-१-१३३)<br><br>उपक्रोष्टृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಕ /ದೂಷಿಸುವವನು<br><br>

उपक्वण
उपक्वण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೀಣಾನಾದ<br><b>निष्पत्तिः - </b>उप +क्वण (शब्दे) - वा "अप्" (३-३-५६)<br><br>

उपक्वाण
उपक्वाण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೀಣಾನಾದ<br><b>निष्पत्तिः - </b>पक्षे "घञ्" (३-३-१८)<br><br>

उपक्षय
उपक्षय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶ /ಕಡಮೆಯಾಗುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + क्षि (क्षये) - "अच्" (३-३-५६)<br><br>उपक्षय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶ ಒಂದಿದ /ಕ್ಷೀಣವಾದ<br><b>व्युत्पत्तिः - </b>उपगतः क्षयम्<br><br>उपक्षय<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮನೆಯ ಪಕ್ಕ /ಮನೆಯ ಸಮೀಪ<br><b>व्युत्पत्तिः - </b>क्षयस्य गृहस्य समीपम्<br><br>

उपक्षिपत्
उपक्षिपत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಡುವ /ಹಾಕುವ<br><b>निष्पत्तिः - </b>उप + क्षिपु (निरसने) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"वपुषि वधाय तत्र तव शस्त्रमुपक्षिपतः पततु शिरस्यकाण्डयमदण्ड इवैष भुजः"<br><b>उल्लेखाः - </b>मालती० ५-३१<br><br>उपक्षिपत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿಸುವ /ಅಪೇಕ್ಷಿಸುವ<br><br>उपक्षिपत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭಿಸುವ /ಉಪಕ್ರಮಿಸುವ<br><br>

उपक्षिप्त
उपक्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭಿಸಲ್ಪಟ್ಟ /ಉಪಕ್ರಮಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + क्षिपु (निरसने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"उपक्षिप्तमनेन किमपि"<br><b>उल्लेखाः - </b>मुद्रा० १<br><br>उपक्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಚಿಸಲ್ಪಟ್ಟ /ತಯಾರಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"उपक्षिप्तो मया तपनीयाशोकस्य वेदिकाबन्धः । यावदनुष्ठितनियोगमात्मानं देव्यै निवेदयामि ॥"<br><b>उल्लेखाः - </b>माल० ५<br><br>उपक्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಸೆಯಲ್ಪಟ್ಟ /ಬಿಸಾಡಲ್ಪಟ್ಟ<br><br>उपक्षिप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದಲ್ಲಿ ಇಡಲ್ಪಟ್ಟ<br><br>

उपक्षीण
उपक्षीण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ಷಯ ಹೊಂದಿದ /ಕಡಮೆಯಾದ<br><b>निष्पत्तिः - </b>उप + क्षि (क्षये) - "क्तः" (३-४-७२) । दीर्घः (६-४-४०) । निष्ठातस्य नत्वम् (८-२-४६)<br><br>

उपक्षेप
उपक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ ಇಡುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + क्षिपु (निरसने) - भावे "घञ्" (३-३-१८)<br><br>उपक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಸೆಯುವಿಕೆ /ಬಿಸಾಡುವಿಕೆ<br><br>उपक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಚನೆ /ಉಲ್ಲೇಖ<br><b>प्रयोगाः - </b>"दारुणः खलूपक्षेपः पापस्य"<br><b>उल्लेखाः - </b>वेणी० ५<br><br>उपक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆದರಿಕೆ /ಭಯ ಸೂಚನೆ<br><b>प्रयोगाः - </b>"कर्णनासाच्छेदोपक्षेपभीषिताभ्याम्"<br><b>उल्लेखाः - </b>दशकु०<br><br>उपक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೂಪಕಗಳಲ್ಲಿ ಮುಖಸಂಧಿಯ ಒಂದು ಅಂಗ<br><b>प्रयोगाः - </b>"पक्षेपः परिकरः परिन्यासो विलोभनम्"<br><b>उल्लेखाः - </b>सा० द० ६-८१<br><br>उपक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನು ಶತ್ರುಜಯ ಮೊದಲಾದ ಕಾರ್ಯಕ್ಕೆ ಪ್ರಯೋಗಿಸುವ ಸಾಮಾದ್ಯುಪಾಯ<br><b>निष्पत्तिः - </b>उप + क्षिपु (निरसने) - कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>उपक्षिप्यते आरभ्यतेऽनेन<br><b>प्रयोगाः - </b>"कार्योपक्षेपमादौ तनुमपि रचयन् तस्य विस्तारमिच्छन् बीजानां गर्भितानां फलमतिगहनं गूढमुद्भेदयंश्च"<br><b>उल्लेखाः - </b>मुद्रा० ४-३<br><br>

उपक्षेपण
उपक्षेपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಸೆಯುವುದು<br><br>उपक्षेपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮರ್ಪಿಸುವುದು /ಒಪ್ಪಿಸುವುದು<br><br>उपक्षेपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿಡುವುದು<br><b>निष्पत्तिः - </b>उप + क्षिपु (निरसने) - "ल्युट्" (३-३-११५)<br><br>

उपग
उपग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ ಹೋಗುವ /ಅನುಸರಿಸಿ ಹೋಗುವ<br><b>निष्पत्तिः - </b>उप + गम्लृ (गतौ) - "डः" (वा० ३-२-४८)<br><b>व्युत्पत्तिः - </b>उपगच्छति<br><br>उपग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿರುವ /ಕೂಡಿಕೊಂಡಿರುವ<br><b>प्रयोगाः - </b>"ओषध्यः फलपाकान्ता बहुपुष्पफलोपगाः"<br><b>उल्लेखाः - </b>मनु० १-४६<br><br>

उपगण
उपगण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುಂಪನ್ನು ಸೇರಿರುವ /ಗುಂಪಿನೊಡನೆ ಕಲೆತಿರುವ<br><b>व्युत्पत्तिः - </b>उपगतो गणो येन<br><br>

उपगत
उपगत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಣಸಂದ ರಶೀದಿ /ಹಣವು ಸಂದ ಬಗ್ಗೆ ಸ್ವಹಸ್ತಾಂಕನ ಮಾಡಿ ಕೊಡುವ ರಶೀದಿ<br><b>प्रयोगाः - </b>"धनी वोपगतं दद्यास्त्वहस्यपरिचिह्नितम्"<br><b>उल्लेखाः - </b>याज्ञ० २-९३<br><br>उपगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಬಂದಿರುವ /ಹತ್ತಿರ ಸೇರಿರುವ<br><b>निष्पत्तिः - </b>उप + गम्लृ (गतौ) - "क्तः" (३-४-७२)<br><br>उपगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವೀಕರಿಸಿದ /ಅಂಗೀಕರಿಸಿದ<br><b>प्रयोगाः - </b>"उपगतोऽपि च मण्डलनाभिमनुदितान्यसितातपवारणः"<br><b>उल्लेखाः - </b>रघु० ९-१५<br><br>उपगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿದಿರುವ<br><br>उपगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಂದಿರುವ /ಕೈ ಸೇರಿರುವ<br><b>प्रयोगाः - </b>"सर्वो हि नोपगतमप्यपचीयमानं वर्ढिष्णुमाश्रयमनागतमभ्युपैति" । उपगतमवधीरयन्त्यभव्याः" ।<br><b>उल्लेखाः - </b>माघ० ५-१४, किरा० १०-५१<br><br>उपगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಗಮಿಸಿರುವ /ಬಂದಿರುವ<br><b>प्रयोगाः - </b>"सहसोपगतः सविस्मयं तपसां सूतिरसूतिरापदाम्"<br><b>उल्लेखाः - </b>किरा० २-५६<br><br>उपगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಡೆದಿರುವ /ಹೊಂದಿರುವ<br><b>प्रयोगाः - </b>"उच्चावचैरुपगतेषु सहस्रसङ्ख्याम्"<br><b>उल्लेखाः - </b>माघ० ४-४६<br><br>

उपगति
उपगति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಪ್ತಿ /ಪಡೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + गम्लृ (गतौ) - "क्तिन्" (३-३-९४)<br><br>उपगति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನ /ತಿಳುವಳಿಕೆ<br><br>उपगति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವೀಕಾರ /ಅಂಗೀಕಾರ<br><br>उपगति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಬರುವುದು /ಹತ್ತಿರ ಸೇರುವುದು<br><br>

उपगन्तृ
उपगन्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಹೋಗುವ /ಹತ್ತಿರಕ್ಕೆ ಹೋಗುವ<br><br>उपगन्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯುವ<br><br>उपगन्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದುವ /ಪಡೆಯುವ<br><br>उपगन्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವೀಕರಿಸುವ /ಅಂಗೀಕರಿಸುವ<br><b>निष्पत्तिः - </b>उप + गम्लृ (गतौ) - "तृच्" (३-१-१३३)<br><br>

उपगन्त्री
उपगन्त्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उपगन्तृ ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्"(४-१-५)<br><br>

उपगम
उपगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಹೋಗುವಿಕೆ /ಹತ್ತಿರಕ್ಕೆ ಹೋಗುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + गम्लृ (गतौ) - भावे "अप्" (३-३-५८)<br><b>प्रयोगाः - </b>"तं प्राप्य सर्वावयवानवद्यं व्यावर्ततान्योपगमात्कुमारी"<br><b>उल्लेखाः - </b>रघु० ६-६९<br><br>उपगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ /ಒಪ್ಪಿಗೆ<br><br>उपगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನ /ತಿಳುವಳಿಕೆ<br><br>उपगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಪ್ತಿ /ಪಡೆಯುವಿಕೆ<br><b>प्रयोगाः - </b>"विश्वासोपगमादभिन्नगतयः शब्दं सहन्ते मृगाः"<br><b>उल्लेखाः - </b>शाकु० १-१३<br><br>उपगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಹವಾಸ /ಸಾಹಚರ್ಯ /ಸಂಸರ್ಗ<br><b>प्रयोगाः - </b>"न पुनरधनामामुपगमः"<br><b>उल्लेखाः - </b>हितो०<br><br>

उपगमन
उपगमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>उपगम ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

उपगम्य
उपगम्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಹೋಗಲು ಅರ್ಹನಾದ /ಹತ್ತಿರ ಸೇರಲು ಅರ್ಹನಾದ<br><br>उपगम्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲು ಅರ್ಹನಾದ /ಪಡೆಯಲು ಯೋಗ್ಯನಾದ<br><br>उपगम्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕರಿಸಲ್ಪಡಬಹುದಾದ /ಒಪ್ಪಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>उप + गम्लृ (गतौ) - "यत्" (३-१-९८)<br><br>उपगम्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿ /ಸಮೀಪಕ್ಕೆ ಬಂದು<br><b>निष्पत्तिः - </b>उप + गम्लृ (गतौ) - "ल्पप्" (७-१-३७)<br><b>प्रयोगाः - </b>"उपगम्य ततः क्षिप्रं राक्षसी धान्यमालिनी"<br><b>उल्लेखाः - </b>रामा०<br><br>

उपगामिन्
उपगामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಹೋಗುವವನು<br><br>उपगामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕರಿಸುವವನು /ಸಮ್ಮತಿಸುವವನು<br><b>निष्पत्तिः - </b>उप + गम्लृ (गतौ) - "णिनिः" (३-१-१३४)<br><br>उपगामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯುವವನು /ಮನವರಿಕೆಮಾಡಿಕೊಳ್ಳುವವನು<br><br>

उपगिरम्
उपगिरम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಗಿರಿಯ ಸಮೀಪ<br><b>व्युत्पत्तिः - </b>गिरेः समीपम्<br><br>उपगिरम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಬೆಟ್ಟದಲ್ಲಿ /ಪರ್ವತದಲ್ಲಿ<br><b>व्युत्पत्तिः - </b>गिरौ<br><br>

उपगीत
उपगीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ ಗಾನ ಮಾಡಲ್ಪಟ್ಟ /ಹತ್ತಿರದಲ್ಲಿ ಹಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + गै (शब्दे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"इतीष्टगन्धाढ्यमटन्नसौ वनं पिकोपगीतोऽपि शुकस्ततोऽपि च" -<br><b>उल्लेखाः - </b>नैष० १-१०४<br><br>उपगीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲಿ ಹಾಡುತ್ತಿರುವ /ಹತ್ತಿರದಲ್ಲಿ ಗಾನ ಮಾಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उप + गै (शब्दे) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"नात्र कान्तमुपगीतया तया स्वानमा नमति काऽलिमालया"<br><b>उल्लेखाः - </b>माघ० ४-५७<br><br>

उपगीति
उपगीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಥ್ಯಾರ್ಯಾವೃತ್ತದ ಉತ್ತರಾರ್ಧದ ಲಕ್ಷಣವು ಪೂರ್ವಾರ್ಧ ಮತ್ತು ಉತ್ತರಾರ್ಥಗಳೆರಡರಲೂ ಇರುವ ಒಂದು ಮಾತ್ರಾ ವೃತ್ತ<br><b>प्रयोगाः - </b>"आर्याद्वितीयकेऽर्धे यद्गदितं लक्षणं तत्स्यात् । यद्युभयोरपि दलयोरुपगीतिं तां मुनिर्ब्रूते ॥"<br><b>उल्लेखाः - </b>वृ० र०<br><br>

उपगु
उपगु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೋಪಾಲಕ /ದನ ಕಾಯುವವನು<br><b>व्युत्पत्तिः - </b>उपगतो गौरस्य<br><br>उपगु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಗೋವಿನ ಸಮೀಪ /ಹಸುವಿನ ಹತ್ತಿರ<br><b>व्युत्पत्तिः - </b>गोः समीपम्<br><br>

उपगुरु
उपगुरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಹಾಯಾಧ್ಯಾಪಕ /ಸಹಾಯೋಪಾಧ್ಯಾಯ<br><b>व्युत्पत्तिः - </b>उपगतः सादृश्येन गुरुम्<br><br>

उपगूढ
उपगूढ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಲಿಂಗನ /ಅಪ್ಪಿಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>उप + गुहू (संवरणे) - "क्तः" (३-३-११४)<br><b>प्रयोगाः - </b>"विश्रामार्थमुपगूढमजस्रं यत्प्रियैः प्रथमरत्यवसाने" । "उपगूढानि सवेपथूनि च" ।<br><b>उल्लेखाः - </b>माघ० १०-८८, कुमा० ४-१७<br><br>उपगूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಲಿಂಗಿಸಲ್ಪಟ್ಟ /ಅಪ್ಪಿಕೊಳ್ಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + गुहू (संवरणे) - कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"उपगूढवेलमलधूर्मिभुजैः"<br><b>उल्लेखाः - </b>माघ० ९-३८<br><br>उपगूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಡಿದುಕೊಳ್ಳಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"कश्चित्कराभ्यामुपगूढनालमालोलपत्राभिहतद्विरेफम्"<br><b>उल्लेखाः - </b>रघु० ६-१३<br><br>उपगूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರೆ ಮಾಡಲ್ಪಟ್ಟ /ಮುಚ್ಚಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"उपान्तवानीरवनोपगूढान्यालक्ष्य पारिप्लवसारसानि"<br><b>उल्लेखाः - </b>रघु० १३-३०<br><br>

उपगूहन
उपगूहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಲಿಂಗನ /ಅಪ್ಪಿಕೊಳ್ಳುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + गुहू (संवरणे) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"स्मरन्मुकुन्दाङ्घ्युपगूहनं पुनर्विहातुमिच्छेन्न रसग्रहो यतः"<br><b>उल्लेखाः - </b>भाग० स्क० १ अ० ५-१९<br><b>विस्तारः - </b>"परिरम्भः परिष्वङ्ग आश्लेष उपगूहनम्" - वैज० ।<br><br>

उपग्रह
उपग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಘಾತ /ಪ್ರತಿಕ್ರಿಯೆ /ವ್ಯರ್ಥಪಡಿಸುವ ಪ್ರಯತ್ನ<br><b>निष्पत्तिः - </b>उप + ग्रह (उपादाने) - भावे "अप्" (३-३-५८)<br><b>प्रयोगाः - </b>"अथ च विहिते मत्कृत्यानां निकाममुपग्रहे कथमिदमिहेत्युन्निद्रस्य प्रयान्त्यनिशं निशाः"<br><b>उल्लेखाः - </b>मुद्रा० ४-२<br><br>उपग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಯೋಗ<br><br>उपग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಕೂಲ್ಯ /ಅನುಕೂಲವಾಗಿರುವಿಕೆ<br><br>उपग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಸೆರೆ /ಬಂಧನ<br><br>उपग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಹು ಕೇತು ಮೊದಲಾದ ಉಪಗ್ರಹ<br><br>उपग्रह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೆರೆಹಿಡಿಯಲ್ಪಟ್ಟವನು /ಬಂಧಿಸಲ್ಪಟ್ಟವನು<br><b>निष्पत्तिः - </b>उप + ग्रह (उपादाने) - कर्म० "अप्" (३-३-५८)<br><b>व्युत्पत्तिः - </b>उपगृह्यते स्म<br><b>विस्तारः - </b>"उपग्रहः पुमान् बन्द्यामुपयोगेऽनुकूलने" - मेदि० ।<br><br>

उपग्रहण
उपग्रहण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪದಿಂದ ತೆಗೆದುಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>उप + ग्रह (उपादाने) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"वेदोपग्रहणार्थाय तावग्राहयत प्रभुः"<br><b>उल्लेखाः - </b>रामा०<br><br>उपग्रहण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವೀಕಾರ /ತೆಗೆದುಕೊಳ್ಳುವುದು<br><br>

उपग्राह्य
उपग्राह्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಹಾರ /ಕಾಣಿಕೆ<br><b>निष्पत्तिः - </b>उप + ग्रह (उपादाने) - "ण्यत्" (३-२-१२४)<br><b>व्युत्पत्तिः - </b>उपगृह्यते<br><br>उपग्राह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಣಿಕೆಯಾಗಿ ಕೊಡಲ್ಪಡುವ ವಸ್ತು<br><br>उपग्राह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೌರವಿಸಲ್ಪಡುವವನು /ಬಹುಮಾನಿಸಲ್ಪಡುವವನು<br><b>निष्पत्तिः - </b>उप + ग्रह (उपादाने) + णिच् - "यत्" (३-१-९७)<br><br>

उपघात
उपघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿನಾಶ /ಅಳಿವು /ಹಾಳು<br><b>निष्पत्तिः - </b>उप + हन (हिंसागत्योः) - "घञ्" (३-३-१८)<br><br>उपघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದಲ್ಲಿ ಅಸಾಮರ್ಥ್ಯ ಸಂಪಾದನೆ /ಕಾರ್ಯವುಂಟುಮಾಡುವುದರಲ್ಲಿ ಶಕ್ತಿ ಕುಂದುವುದು<br><b>प्रयोगाः - </b>"तथात्वं चेदिन्द्रियाणामुपघाते कथं स्मृतिः"<br><b>उल्लेखाः - </b>भाषापा०<br><br>उपघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗ /ವ್ಯಾಧಿ<br><b>निष्पत्तिः - </b>उप + हन (हिंसागत्योः) - कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>उपहन्यतेऽनेन<br><br>उपघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಏಟು /ಪೆಟ್ಟು /ಹೊಡೆತ<br><br>उपघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಕಾರ<br><b>प्रयोगाः - </b>"स्त्रीणां च प्रेक्षणालम्भमुपघातं परस्य च"<br><b>उल्लेखाः - </b>मनु० २-१७९<br><br>

उपघातक
उपघातक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸುವವನು /ಹಾಳು ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>उप + हन (हिंसागत्योः) - "ण्वुल्" (३-१-१३३)<br><br>उपघातक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೀಡಿಸುವವನು /ಹಿಂಸಿಸುವವನು<br><b>प्रयोगाः - </b>"कथं सक्तून् ग्रहीष्यामि भूत्वा धर्मोपघातकः"<br><b>उल्लेखाः - </b>भा० आश्व० ९२-५१<br><br>उपघातक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಡೆಯುವ<br><br>उपघातक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಕ್ತಿ ಕುಂದಿಸುವ<br><br>

उपघातिन्
उपघातिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>उपघातक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>उप + हन (हिंसागत्योः) - "णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"शस्त्रं पातयेत् मर्मसिरास्नायुसन्धीनामनुपघाति"<br><b>उल्लेखाः - </b>सुश्रुत० सूत्र० १४-२६<br><br>

उपघातिनी
उपघातिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उपघातक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्"(४-१-५)<br><br>

उपघ्न
उपघ्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದ ಆಸರೆ /ಸಮೀಪದಲ್ಲಿರುವ ಆಶ್ರಯ<br><b>निष्पत्तिः - </b>उप + हन (हिंसागत्योः) - "अप्" उपधालोपश्च (३-३-५९) निपा० ।<br><b>व्युत्पत्तिः - </b>उपहन्यते सामीप्येन गम्यते<br><b>प्रयोगाः - </b>"अपश्यतां दाशरथी जनन्यौ छेदादिवोपघ्नतरोर्व्रतत्यौ"<br><b>उल्लेखाः - </b>रघु० १४-१<br><br>

उपचक्षुस्
उपचक्षुस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ನಡಕ /ಸುಲೋಚನ<br><b>व्युत्पत्तिः - </b>उपगतं चक्षुः<br><br>

उपचय
उपचय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃದ್ಧಿ /ಬೆಳವಣಿಗೆ<br><b>निष्पत्तिः - </b>उप + चिञ् (चयने) - "अच्" (३-३-५६)<br><b>प्रयोगाः - </b>"स्वशक्त्युपचये केचित्परस्य व्यसनेऽपरे । यानमाहुरुदासीनं त्वामुत्थापयति द्वयम् ॥"<br><b>उल्लेखाः - </b>माघ० २-५७<br><br>उपचय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಶಿ /ಗುಪ್ಪೆ<br><br>उपचय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಏಳಿಗೆ /ಅಭಿವೃದ್ಧಿ /ಉತ್ಕರ್ಷ<br><br>उपचय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಗ್ನದಿಂದ ಮೂರು ಆರು ಹತ್ತು ಮತ್ತು ಹನ್ನೊಂದನೆಯ ಸ್ಥಾನ<br><b>प्रयोगाः - </b>"षष्ठत्रिदशलाभाश्च लग्नादुपचयाः स्मृताः"<br><br>उपचय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಗ್ರಹ /ಶೇಖರಣೆ /ಕೂಡಿಡುವಿಕೆ<br><b>प्रयोगाः - </b>"अनाप्तपुण्योपचयैर्दुरापा फलस्य निर्धूतरजाः सवित्री"<br><b>उल्लेखाः - </b>किरा० ३-५<br><br>

उपचरित
उपचरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಚರಿಸಲ್ಪಟ್ಟ /ಸೇವಿಸಲ್ಪಟ್ಟ<br><br>उपचरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + चर (गतौ) - "क्तः" (३-२-१०२)<br><br>उपचरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲಕ್ಷಣಾವೃತ್ತಿಯಿಂದ ತಿಳಿಸಲ್ಪಟ್ಟ<br><br>

उपचर्य
उपचर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಿಸಲು ಅರ್ಹನಾದ /ಸೇವಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उप (सृत्य) + चर (गतौ) - कर्म० "यत्" (३-१-१००)<br><b>प्रयोगाः - </b>"उपचर्यः स्त्रिया साध्व्या सततं देववत्पतिः"<br><b>उल्लेखाः - </b>मनु० ५-१५४<br><br>

उपचर्या
उपचर्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವೆ /ಶುಶ್ರೂಷೆ<br><b>निष्पत्तिः - </b>उप + चर (गतौ) - भावे "यत्" (३-१-१००)<br><br>उपचर्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಕಿತ್ಸೆ /ರೋಗನಿವಾರಣೆಗಾಗಿ ಮಾಡುವ ಔಷಧೋಪಚಾರ<br><br>

उपचायिन्
उपचायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿಯುಂಟುಮಾಡುವ /ಹೆಚ್ಚಿಸುವ<br><br>उपचायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಕರ್ಷವುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>उप + चिञ् (चयने) - "णिनिः" (३-१-१३४)<br><br>

उपचायिनी
उपचायिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उपचायिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उपचाय्य
उपचाय्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞ ವೇದಿಕೆ /ಯಾಗಾಗ್ನಿಯನ್ನು ಪ್ರತಿಷ್ಠಿಸಲು ಇಟ್ಟಿಗೆಯಿಂದ ನಿರ್ಮಿತವಾದ ಜಗುಲಿ<br><b>निष्पत्तिः - </b>उप + चर (गतौ) - "ण्यत्" आयादेशश्च (३-१-१३१)<br><br>

उपचार
उपचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವೆ /ಶುಶ್ರೂಷೆ<br><b>निष्पत्तिः - </b>उप + चर (गतौ) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"स मे चिरायास्खलितोपचारां तां‍भक्तिमेवागणयत्पुरस्तात्"<br><b>उल्लेखाः - </b>रघु० ५-२०<br><br>उपचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಕಿತ್ಸೆ /ರೋಗನಿವಾರಣೆಗಾಗಿ ಮಾಡುವ ಔಷಧೋಪಚಾರ<br><br>उपचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರ್ಯಾದೆ /ಗೌರವ /ಆದರ<br><b>प्रयोगाः - </b>"उपचारविधिर्मनस्विनीनां न तु पूर्वाभ्यधिकोऽपि भावशून्यः"<br><b>उल्लेखाः - </b>माल० ३-३<br><br>उपचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ /ಸತ್ಕಾರ<br><b>प्रयोगाः - </b>"प्राप्ताः कृच्छ्रादृष्यशृङ्गोपचारैः पुण्यश्रीकाः कोसलेम्द्रेण पुत्राः"<br><b>उल्लेखाः - </b>म० वी० १-२४<br><br>उपचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವೆಯ ಸಲಕರಣೆ /ಉಪಚಾರಕ್ಕೆ ಬೇಕಾದ ಪದಾರ್ಥ<br><b>प्रयोगाः - </b>"तस्योपकार्यारचितोपचारा वन्येतरा जानपदोपदाभिः"<br><b>उल्लेखाः - </b>रघु० ५-४१<br><br>उपचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆಯ ಸಲಕರಣೆ /ಪೂಜಾದ್ರವ್ಯ /ಪೂಜೆಗೆ ಬೇಕಾದ ಪದಾರ್ಥ /ಪೂಜೋಪಕರಣ<br><b>प्रयोगाः - </b>"क्लृप्तोपचारां चतुरस्रवेदीं तावेत्य पश्चात् कनकासनस्थौ"<br><b>उल्लेखाः - </b>कुमा० ७-८८<br><br>उपचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷಣಾವೃತ್ತಿಯಿಂದ ಬೇರೊಂದು ಅರ್ಥವನ್ನು ತಿಳಿಸುವಿಕೆ<br><br>उपचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಸತ್ಯವಚನ /ಇತರರನ್ನು ಸಂತೋಷಪಡಿಸಲು ಆಡುವ ಸುಳ್ಳುಮಾತು /ಇತರರ ಮನೋರಂಜನೆಗಾಗಿ ಅಸತ್ಯ ನುಡಿಯುವುದು /ಕೇವಲ ಗೌರವದ ಮಾತು<br><b>प्रयोगाः - </b>"उपचारपदं न चेदिदं त्वमनङ्गः कथमक्षता रतिः"<br><b>उल्लेखाः - </b>कुमा० ४-९<br><br>उपचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಕೋಚ /ಲಂಚ<br><br>उपचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರ್ಥನೆ /ಯಾಚನೆ<br><b>प्रयोगाः - </b>"सोपचारमुपशान्तविचारं सानुतर्षमनुतर्षपदेन"<br><b>उल्लेखाः - </b>माघ० १०-२<br><br>उपचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯವಹಾರ /ನಡತೆ /ನಡವಳಿಕೆ<br><br>उपचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮಾಚರಣೆ /ಕರ್ಮಾನುಷ್ಠಾನ<br><b>प्रयोगाः - </b>"इत्थं विधिज्ञेन पुरोहितेन प्रयुक्तपाणिग्रहणोपचारौ"<br><b>उल्लेखाः - </b>कुमा० ७-८६<br><b>विस्तारः - </b>"उपचारस्तु लञ्चायां व्यवहारोपचर्ययोः" - हेम० ।<br><br>

उपचार्य
उपचार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವೆ /ಶುಶ್ರೂಷೆ<br><br>उपचार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಕಿತ್ಸೆ /ರೋಗನಿವಾರಣೆಗಾಗಿ ಮಾಡುವ ಔಷಧೋಪಚಾರ<br><b>निष्पत्तिः - </b>उप + चर (गतौ) - "ण्यत्" (३-१-१२४)<br><br>उपचार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಚರಿಸಲ್ಪಡುವ /ಸೇವಿಸಲ್ಪಡುವ<br><br>उपचार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಕಿತ್ಸೆಗೆ ಅರ್ಹನಾದ /ಉಪಚಾರ ಹೊಂದಲು ತಕ್ಕವನಾದ<br><b>निष्पत्तिः - </b>उप + चर (गतौ) -कर्म० "ण्यत्" (३-१-१२४)<br><br>

उपचिकीर्षा
उपचिकीर्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಕಾರ ಮಾಡಲು ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>उप + डुकृञ् (करणे) + सन् - "अः" (३-३-१०२)<br><b>व्युत्पत्तिः - </b>उपकर्तुमिच्छा<br><br>

उपचिकीर्षु
उपचिकीर्षु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಕಾರ ಮಾಡಲು ಅಪೇಕ್ಷೆಯುಳ್ಳ /ಸಾಹಾಯ್ಯ ಮಾಡಲು ಇಷ್ಟವುಳ್ಳ<br><b>निष्पत्तिः - </b>उप + डुकृञ् (करणे) + सन् - "उः" (३-२-१६८)<br><br>

उपचिकीषा|उपचिचीषा
उपचि(की)चीषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೃದ್ಧಿಪಡಿದುವ ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>उप + चिञ् (चयने) + सन् - "अः" (३-३-१०२) । कुत्वविकल्पः (७-३-५८)<br><br>

उपचिकीषु|उपचिचीषु
उपचि(की)चीषु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೃದ್ಧಿಪಡಿಸಲು ಅಪೇಕ್ಷಿಸುವ /ಅಧಿಕಪಡಿಸಲು ಇಷ್ಟವಾದ<br><b>निष्पत्तिः - </b>उप + चिञ् (चयने) + सन् - "उः" (३-२-१६८)<br><br>

उपचिञ्
उपचिञ्<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ವೃದ್ಧಿ ಹೊಂದು<br><br>उपचिञ्<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಬಲಗೊಳ್ಳು<br><br>उपचिञ्<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಒಟ್ಟಿಗೆ ಸೇರು<br><br>

उपचित
उपचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೃದ್ಧಿ ಹೊಂದಿದ /ಅಧಿಕವಾದ<br><b>निष्पत्तिः - </b>उप + चिञ् (चयने) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"नयगुणोपचितामिव भूपतेः सदुपकारफलां श्रियमर्थिनः"<br><b>उल्लेखाः - </b>रघु० ९-२७<br><br>उपचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತುಂಬಿರುವ /ಪುಷ್ಕಳವಾದ /ನೆರೆದಿರುವ<br><b>प्रयोगाः - </b>"स्थिरतुरङ्गभूमि निपानवन्मृगवयोगवयोपचितं वनम्"<br><b>उल्लेखाः - </b>रघु० ९-५३<br><br>उपचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಲಗೊಂಡ /ಶಕ್ತಿ ಹೊಂದಿದ<br><b>प्रयोगाः - </b>"उपचितेषु परेष्वसमर्थतां व्रजति कलावशाद्बलवानपि" । "विवेकप्रध्वंसादुपचितमहामोहगहनः" ।<br><b>उल्लेखाः - </b>माघ० ६-६३, मालती० १-३३<br><br>उपचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೃದ್ಧಿ ಹೊಂದಿಸಲ್ಪಟ್ಟ /ಬೆಳೆಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + चिञ् (चयने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"मुदे मुरारेरमरैः सुमेरोरानीय यस्योपचितस्य शृङ्गैः"<br><b>उल्लेखाः - </b>माघ० ४-१०<br><br>उपचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲೇಪನೆ ಮಾಡಲ್ಪಟ್ಟ /ಬಳಿಯಲ್ಪಟ್ಟ<br><b>विस्तारः - </b>"भवेदुपचितं दिग्धे समृद्धे चान्यलिङ्गकम्" - मेदि० ।<br><br>उपचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶೇಖರಿಸಿಡಲ್ಪಟ್ಟ /ಕೂಡಿ ಹಾಕಲ್ಪಟ್ಟ<br><br>

उपचिति
उपचिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ /ಬೆಳವಣಿಗೆ<br><br>उपचिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಏಳಿಗೆ /ಅಭ್ಯುದಯ /ಉತ್ಕರ್ಷ<br><b>निष्पत्तिः - </b>उप + चिञ् (चयने) - "क्तिन्" (३-३-९४)<br><br>उपचिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೃದ್ಧಿ /ಹೆಚ್ಚುವಿಕೆ<br><br>

उपचित्रा
उपचित्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸ್ತನಕ್ಷತ್ರ<br><br>उपचित्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಾತೀ ನಕ್ಷತ್ರ<br><br>उपचित्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಲಿಯಾಲದ ಮರ<br><br>

उपचिन्वत्
उपचिन्वत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೃದ್ಧಿ ಪಡಿಸುತ್ತಿರುವ /ಅಧಿಕಗೊಳಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उप + चिञ् (चयने) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"उपचिन्वन् प्रभां तन्वीं प्रत्याह परमेश्वरः"<br><b>उल्लेखाः - </b>कुमा० ६-२५<br><br>

उपचीमयमान
उपचीमयमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೃದ್ಧಿ ಹೊಂದುತ್ತಿರುವ /ಅಧಿಕವಾಗುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उप + चिञ् (चयने) - कर्मकर्त० "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"अथ कदाचिदुपचीयमानमनोभववैभवः"<br><b>उल्लेखाः - </b>चं० रा०<br><br>

उपच्छन्दन
उपच्छन्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸವಿಮಾತಿನಿಂದ ಬೇಡುವುದು /ಒಳ್ಳೆಯ ಮಾತಿನಿಂದ ಮನವೊಲಿಸುವುದು /ಮೃದುವಚನದಿಂದ ಪುಸಲಾಯಿಸುವುದು<br><b>निष्पत्तिः - </b>उप + छदि (संवरणे) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"उपच्छन्दनैरेव स्वं ते दापयितुं प्रयतिष्ये"<br><b>उल्लेखाः - </b>दशकु०<br><br>उपच्छन्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹ ಮತ್ತು ಇತರ ಸಂತೋಷ ಕೂಟಗಳಿಗೆ ಕೊಡುವ ಆಹ್ವಾನ<br><b>विस्तारः - </b>"उपमन्त्रणमुपच्छन्दनम्"- सि० कौ० ।<br><br>

उपच्छन्दित
उपच्छन्दित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನವೊಲಿಸಲ್ಪಟ್ಟ /ಒಳ್ಳೆಯ ಮಾತಿನಿಂದ ಪುಸಲಾಯಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + छदि (संवरणे) - "क्तः" (३-२-१०२)<br><br>उपच्छन्दित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಹ್ವಾನ ಕೊಡಲ್ಪಟ್ಟ /ಕರೆಯಲ್ಪಟ್ಟ<br><br>

उपजन
उपजन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತ್ರೀ ಪುರುಷರ ಸಮಾಗಮದಿಂದ ಉಂಟಾಗುವ ಶರೀರ<br><b>निष्पत्तिः - </b>उप + जनी (प्रादुर्भावे) - "अच्" (३-१-१३४)<br><br>उपजन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿ /ಹುಟ್ಟುವಿಕೆ<br><br>उपजन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ /ಹೆಚ್ಚುವಿಕೆ<br><b>निष्पत्तिः - </b>जनी - भावे "घञ्" (३-३-१८)<br><br>

उपजाति
उपजाति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ ವಜ್ರಾ ಉಪೇಂದ್ರವಜ್ರಾ ವೃತ್ತಗಳ ಪಾದಗಳು ಸೇರುವುದರಿಂದುಂಟಾಗುವ ವೃತ್ತ<br><b>प्रयोगाः - </b>"अनन्तरोदीरितलक्ष्मभाजौ पादौ यदीयावुपजातयस्ताः । इत्थं किलान्यास्वपि मिश्रितासु वदन्ति जातिष्विदमेव नाम ॥"<br><b>उल्लेखाः - </b>वृ० र०<br><br>

उपजप्य
उपजप्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೇದೋಪಾಯದಿಂದ ಬೇರ್ಪಡಿಸಲು ಅರ್ಹನಾದವನು<br><b>निष्पत्तिः - </b>उप + जप (व्यक्तायां वाचि) - "ण्यत्" (३-१-१२४)<br><b>प्रयोगाः - </b>"उपजप्यानुपजपेत् बुध्येतैव च तत्कृतम्"<br><b>उल्लेखाः - </b>मनु० ७-१९७<br><br>

उपजाप
उपजाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೇದೋಪಾಯ /ಒಳಜಗಳವುಂಟುಮಾಡುವಿಕೆ /ಅಂತಃಕಲಹ ತಂದೊಡ್ಡುವುದು<br><b>निष्पत्तिः - </b>उप + जप (व्यक्तायां वाचि) - "घञ्" (३-३-१८)<br><b>व्युत्पत्तिः - </b>उपांशु जपनम्<br><b>प्रयोगाः - </b>"उपजापसहान् विलङ्घयन् स विधाता नृपतीन् मदोद्धतः" । "उपजापः कृतस्तेन तानाकोपवतस्त्वपि" ।<br><b>उल्लेखाः - </b>किरा० २-४७, माघ० २-९९<br><br>उपजाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಹಸ್ಯವಾಗಿ ಕಿವಿಯಲ್ಲಿ ಹೇಳುವುದು /ಕಿವಿಯಲ್ಲಿ ಪಿಸುಮಾತನಾಡುವುದು<br><br>

उपजापक
उपजापक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೇದೋಪಾಯ ಪ್ರಯೋಗಿಸುವವನು /ಶತ್ರುಗಳಲ್ಲಿ ಪರಸ್ಪರ ಜಗಳ ಹುಟ್ಟಿಸಿ ಒಡಕುಂಟುಮಾಡುವವನು<br><b>निष्पत्तिः - </b>उप + जप (व्यक्तायां वाचि) - "ण्वुल्" (३-१-१३३)<br><b>प्रयोगाः - </b>"राज्ञः कोशापहर्तॄंश्च प्रतिकूलेषु च स्थितान् । घातयेद्विविधैर्दण्डैररीणां चोपजापकान् ॥"<br><b>उल्लेखाः - </b>मनु० ९-२७५<br><br>

उपजिह्वा
उपजिह्वा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರುನಾಲಗೆ<br><br>उपजिह्वा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಲಗೆಯ ಬುಡದಲ್ಲಿ ಮಾಂಸದ ಗಂಟು ಊದುವುದರಿಂದ ಉಂಟಾಗುವ ಒಂದು ರೋಗ<br><b>प्रयोगाः - </b>"जिह्वाग्ररूपः श्वपथुर्हि जिह्वामुन्नम्य जातः कफरक्तयोनिः । प्रसेककण्डूपरिदाहयुक्ता प्रकथ्यतेऽसावुपजिह्विकेति ॥"<br><b>उल्लेखाः - </b>सुश्रुत० निदान० १६-३९<br><br>

उपजिह्विका
उपजिह्विका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೆದ್ದಲು ಹುಳ<br><b>निष्पत्तिः - </b>उपजिह्वा - स्वार्थे "कन्"<br><b>विस्तारः - </b>"वम्रो वम्र्युपदीपिकोपजिह्विका चोपदेहिका" - वैज० ।<br><br>

उपजीवक
उपजीवक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಕ /ಆಳು<br><br>उपजीवक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಿತ /ಒಬ್ಬರ ಆಸರೆಯಿಂದ ಜೀವಿಸುವವನು<br><br>उपजीवक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪವೃತ್ತಿಯಿಂದ ಜೀವಿಸುವವನು /ಮುಖ್ಯ ಜೀವನೋಪಾಯವಿಲ್ಲದೆ ಬೇರೆ ಕೈಕಸಬಿನಿಂದ ಜೀವಿಸುವವನು<br><b>निष्पत्तिः - </b>उप + जीव (प्राणधारणे) - "ण्वुल्" (३-१-१३३)<br><br>

उपजीविन्
उपजीविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪವೃತ್ತಿಯಿಂದ ಜೀವಿಸುವವನು /ಮುಖ್ಯ ಜೀವನೋಪಾಯವಿಲ್ಲದೆ ಬೇರೆ ಕೈಕಸಬಿನಿಂದ ಜೀವಿಸುವವನು<br><b>निष्पत्तिः - </b>"णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"भीमकान्तैर्नृपगुणैः स बभूवोपजीविनाम्"<br><b>उल्लेखाः - </b>रघु० १-१६<br><br>

उपजीविनी
उपजीविनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उपजीविन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उपजीवत्
उपजीवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಬ್ಬನನ್ನು ಆಶ್ರಯಿಸಿ ಜೀವಿಸುವ<br><b>निष्पत्तिः - </b>उप + जीव (प्राणधारणे) - "शतृ" (३-२-१२४)<br><br>उपजीवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೈಕಸಬಿನಿಂದ ಜೀವಿಸುವ<br><br>

उपजीवन
उपजीवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜೀವಿಕೆಗಾಗಿ ಆಶ್ರಯಿಸುವುದು /ಜೀವನಕ್ಕಾಗಿ ಒಬ್ಬನ ಆಸರೆ ಪಡೆಯುವುದು<br><b>निष्पत्तिः - </b>उप + जीव (प्राणधारणे) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"स्त्रीशूद्रविट्क्षत्रवधो निन्दितार्थोपजीवनम्"<br><b>उल्लेखाः - </b>याज्ञ० ३-२३६<br><br>उपजीवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜೀವಿಕೆ /ಜೀವನೋಪಾಯ<br><b>निष्पत्तिः - </b>उप + जीव (प्राणधारणे) - कर० "ल्युट्" (३-३-११७)<br><b>प्रयोगाः - </b>"क्षत्रियस्यैतदेवाहुर्धर्मं कष्टोपजीवनम्"<br><b>उल्लेखाः - </b>भा०<br><br>

उपजीविका
उपजीविका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜೀವನಕ್ಕಾಗಿ ಮಾಡುವ ಕೈ ಕಸಬು<br><b>निष्पत्तिः - </b>उप + जीव (प्राणधारणे) - "अः" (३-३-१०३) । "कन्" (५-३-७५)<br><b>व्युत्पत्तिः - </b>उपजीव्यतेऽनया<br><br>

उपजीव्य
उपजीव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೀವಿಕೆಯನ್ನು ಕಲ್ಪಿಸುವವನು /ಹೊಟ್ಟೆಪಾಡಿಗಾಗಿ ಕೊಡುವವನು<br><br>उपजीव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ ಕೊಡುವವನು /ಒತ್ತಾಸೆ ನೀಡುವವನು<br><b>निष्पत्तिः - </b>उप + जीव (प्राणधारणे) - "ण्यत्" (३-१-१२४)<br><br>

उपज्ञा
उपज्ञा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆದ್ಯಜ್ಞಾನ /ಉಪದೇಶವಿಲ್ಲದೆ ತಾನಾಗಿ ತಿಳಿದುಕೊಂಡುದು<br><b>निष्पत्तिः - </b>उप + ज्ञा (अवबोधने) - भावे "अङ्" (३-३-१०६)<br><b>प्रयोगाः - </b>"तिर्यञ्चमप्यञ्च मृषानभिज्ञरसज्ञतोपज्ञसमज्ञमज्ञम्"<br><b>उल्लेखाः - </b>नैष० ३-६४<br><br>उपज्ञा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪದೇಶವಿಲ್ಲದೆ ತಾನಾಗು ತಿಳಿಯಲ್ಪಟ್ಟ ಆದ್ಯಜ್ಞಾನಕ್ಕೆ ವಿಷಯವಾದುದು<br><b>निष्पत्तिः - </b>उप + ज्ञा (अवबोधने) - कर० "अङ्" (३-३-१०६)<br><b>प्रयोगाः - </b>"अथ प्राचेतसोपज्ञं रामायणमितस्ततः"<br><b>उल्लेखाः - </b>रघु० १५-६३<br><b>विस्तारः - </b>ಇದು ತತ್ಪುರುಷದಲ್ಲಿ ಉತ್ತರಪದವಾಗಿರುವಾಗ ನಪುಂಸಕವಾಗುವುದು. "पाणिनेरुपज्ञा पाणिन्युपज्ञं व्याकरणम् ।"<br><br>

उपज्ञात
उपज्ञात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪದೇಶವಿಲ್ಲದೆ ತಿಳಿಯಲ್ಪಟ್ಟ /ತನ್ನ ಶಕ್ತಿಯಿಂದಲೇ ಮೊದಲು ತಿಳಿಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + ज्ञा (अवबोधने) - "क्तः" (३-२-१०२)<br><br>

उपढौकन
उपढौकन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ ಗುರು ಮೊದಲಾದವರಿಗೆ ಸಂತೋಷಕಾಲದಲ್ಲಿ ವಸ್ತುಗಳನ್ನು ಕೊಡುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + ढौकृ (गतौ) - भावे "ल्युट्" (३-३-११५)<br><br>उपढौकन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ ಗುರು ಮೊದಲಾದವರಿಗೆಸಮರ್ಪಿಸಲ್ಪಡುವ ವಸ್ತು<br><b>निष्पत्तिः - </b>उप + ढौकृ (गतौ) - कर्म० "ल्युट्" (३-३-११३)<br><br>

उपतपन
उपतपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂತಾಪವುಂಟುಮಾಡುವಿಕೆ /ನೋವುಂಟುಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + तप (सन्तापे) - "ल्युट्" (३-३-११५)<br><br>उपतपन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತಾಪವುಂಟುಮಾಡುವ /ನೋವುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>उप + तप (सन्तापे) - कर० "ल्युट्" (३-३-११७)<br><b>प्रयोगाः - </b>"वपुरिन्द्रियोपतपनेषु सततमसुखेषु पाण्डवः"<br><b>उल्लेखाः - </b>किरा० १२-३<br><br>

उपतप्त
उपतप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಂದರೆಪಡಿಸಲ್ಪಟ್ಟ /ನೋವುಂಟುಮಾಡಲ್ಪಟ್ಟ /ಪೀಡಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"स्मरोपतप्तोऽपि भृशं न स प्रभुर्विदर्भराजं तनयामयाचत"<br><b>उल्लेखाः - </b>नैष० १-५०<br><br>उपतप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಯಿಸಲ್ಪಟ್ಟ /ಬಿಸಿ ಮಾಡಲ್ಪಟ್ಟ<br><br>

उपतप्तृ
उपतप्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಯಿಸುವ /ಬಿಸಿ ಮಾಡುವ<br><b>निष्पत्तिः - </b>उप + तप (सन्तापे) - "तृच्" (३-१-१३३)<br><br>

उपताप
उपताप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಸಿ /ಕಾವು<br><b>निष्पत्तिः - </b>उप + तप (सन्तापे) - "घञ्" (३-३-१८)<br><br>उपताप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೋವು /ವೇದನೆ<br><b>निष्पत्तिः - </b>उप + तप (सन्तापे) - कर० "घञ्" (३-३-१२१)<br><b>प्रयोगाः - </b>"सर्वथा नकञ्चन न स्पृशन्त्युपतापाः" । "स खलु दुर्मनायमानः परवानिव शरीरोपतापेन" ।<br><b>उल्लेखाः - </b>काद०, मालती० ३<br><br>उपताप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗ /ವ್ಯಾಧಿ<br><b>निष्पत्तिः - </b>उप + तप (सन्तापे) +णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उपतापयति<br><b>विस्तारः - </b>"उपतापो गदे तापे" - हेम० ।<br><br>

उपतापक
उपतापक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತಾಪವುಂಟುಮಾಡುವ<br><br>उपतापक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಸಿ ಮಾಡುವ<br><b>निष्पत्तिः - </b>उप + तप (सन्तापे) +णिच् - "ण्वुल्" (३-१-१३३)<br><br>

उपतापन
उपतापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಯಿಸುವಿಕೆ /ಬಿಸಿ ಮಾಡುವಿಕೆ<br><br>उपतापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಂದರೆಪಡಿಸುವಿಕೆ /ನೋವುಂಟು ಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + तप (सन्तापे) +णिच् - "ल्युट्" (३-३-११५)<br><br>उपतापन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಂದರೆ ಪಡಿಸುವ /ನೋವುಂಟುಮಾಡುವ<br><br>उपतापन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಯಿಸುವ /ಬಿಸಿ ಮಾಡುವ<br><b>निष्पत्तिः - </b>उप + तप (सन्तापे) +णिच् - "ल्युः" (३-१-१३४)<br><br>

उपतापिन्
उपतापिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೋಗ /ವ್ಯಾಧಿಗ್ರಸ್ತ<br><br>उपतापिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತಾಪವುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>उपतापोऽस्यास्ति<br><b>प्रयोगाः - </b>"गुर्वर्थं पितृमात्रर्थं स्वाध्यायार्थ्युपतापिनः"<br><b>उल्लेखाः - </b>मनु० ११-१<br><br>उपतापिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತಾಪವುಂಟುಮಾಡುವ<br><br>उपतापिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಯಿಸುವ /ಬಿಸಿ ಮಾಡುವ<br><b>निष्पत्तिः - </b>उप + तप (सन्तापे) +णिच् - "णिनिः" (३-१-१३४)<br><br>

उपतिष्य
उपतिष्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುನರ್ವಸು ನಕ್ಷತ್ರ<br><b>व्युत्पत्तिः - </b>उपगतं तिष्यम्<br><br>

उपत्यका
उपत्यका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಟ್ಟದ ಸಮೀಪದ ಭೂಮಿ /ಪರ್ವತದ ಹತ್ತಿರದ ಪ್ರದೇಶ<br><b>निष्पत्तिः - </b>"त्यकन्" (५-२-३४)<br><b>व्युत्पत्तिः - </b>उप आसन्ना भूमिः<br><b>प्रयोगाः - </b>"तमतनुवनराजिश्यामितोपत्यकान्तं नगमुपरि हिमानिगौरमासाद्य जिष्णुः"<br><b>उल्लेखाः - </b>किरा० ४-३८<br><br>

उपदंश
उपदंश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪ್ಪಿನಕಾಯಿ /ಚಟ್ನಿ ಮುಂತಾದ ವ್ಯಂಜನ<br><b>निष्पत्तिः - </b>उप + दंश (दशने) - कर्म० "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>उपदश्यते<br><b>प्रयोगाः - </b>"तथानुष्ठिते च तया द्वित्रानुपदंशानुपपाद्य"<br><b>उल्लेखाः - </b>दशकु०<br><br>उपदंश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತ್ರೀಸಂಬಂಧವಾದ ಒಂದು ರೋಗ /ಗರಮೀರೋಗ<br><br>उपदंश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನುಗ್ಗೆ ಮರ<br><br>उपदंश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಗರವಳ್ಳಿ<br><br>उपदंश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಚ್ಚುವುದು /ಕಡಿಯುವುದು<br><b>निष्पत्तिः - </b>उप + दंश (दशने) - भावे "घञ्" (३-३-१८)<br><br>

उपदर्शक
उपदर्शक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ವಾರಪಾಲಕ /ಬಾಗಿಲು ಕಾವಲುಗಾರ<br><br>उपदर्शक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾರಿ ತೋರಿಸುವವನು<br><b>निष्पत्तिः - </b>उप + दृशिर् (प्रेक्षणे) + णिच् - "ण्वुल्" (३-१-१३३)<br><br>उपदर्शक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಕ್ಷಿ /ಸಮೀಪದಲ್ಲಿ ನಿಂತು ನೋಡುವವನು<br><br>

उपदर्शित
उपदर्शित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರದರ್ಶಿಸಲ್ಪಟ್ಟ /ತೋರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + दृशिर् (प्रेक्षणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"नयविद्भिर्नवे राज्ञि सदसच्चोपदर्शितम्"<br><b>उल्लेखाः - </b>रघु० ४-१०<br><br>

उपदश
उपदश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಕ್ಕೆ ಹತ್ತಿರದ /ಹತ್ತರ ಸಮೀಪದ<br><br>

उपदा
उपदा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಣಿಕೆ /ನಜರು<br><b>निष्पत्तिः - </b>उप + डुदाञ् (दाने) - "अङ्" (३-३-१०६)<br><b>व्युत्पत्तिः - </b>उपदीयते<br><b>प्रयोगाः - </b>"उपदा विविशुः शश्वन्नोत्सेकाः कोसलेश्वरम्"<br><b>उल्लेखाः - </b>रघु० ४-७०<br><br>उपदा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಕೋಚ /ಲಂಚ<br><br>

उपदिदिक्षा
उपदिदिक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪದೇಶಮಾಡಲು ಅಪೇಕ್ಷೆ /ಬೋಧನೆ ಮಾಡಲು ಆಸೆ<br><b>निष्पत्तिः - </b>उप + दिश (अतिसर्जने) + सन् - "अः" (३-३-१०२)<br><b>व्युत्पत्तिः - </b>उपदेष्टुमिच्छा<br><br>

उपदिदिक्षु
उपदिदिक्षु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪದೇಶಿಸಲು ಅಪೇಕ್ಷಿಸುವ /ಬೋಧಿಸಲು ಆಸೆಪಡುವ<br><b>निष्पत्तिः - </b>उप + दिश (अतिसर्जने) + सन् - "उः" (३-२-१६८)<br><b>व्युत्पत्तिः - </b>उपदेष्टुमिच्छुः<br><br>

उपदिदृक्षा
उपदिदृक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದಲ್ಲಿ ನೋಡಲು ಅಪೇಕ್ಷೆ /ಸಮೀಪದಲಿ ನೋಡಲು ಆಸೆ<br><b>निष्पत्तिः - </b>उप + दृशिर् (प्रेक्षणे + सन् - "अः" (३-३-१०२)<br><b>व्युत्पत्तिः - </b>उपद्रष्टुमिच्छा<br><br>

उपदिदृक्षु
उपदिदृक्षु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದಲ್ಲಿ ನೋಡಲು ಅಪೆಕ್ಷೆಯುಳ್ಳ /ಸಮೀಪದಲ್ಲಿ ನೋಡಲು ಆಸೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>उप + दृशिर् (प्रेक्षणे + सन् - "उः" (३-२-१६८)<br><b>व्युत्पत्तिः - </b>उपद्रष्टुमिच्छुः<br><br>

उपदिश्
उपदिश्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪದಿಕ್ಕು /ವಿದಿಕ್ಕು /ಎರಡು ದಿಕ್ಕುಗಳ ಮಧ್ಯದ ಮೂಲೆದಿಕ್ಕು<br><br>

उपदिश्य
उपदिश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪದಿಕ್ಕಿನಲ್ಲಿರುವ /ವಿದಿಕ್ಕಿನಲ್ಲಿ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>"यत्" (४-३-५४)<br><b>व्युत्पत्तिः - </b>उपदिशि भवः<br><br>उपदिश्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉಪದೇಶ ಮಾಡಿ /ಬೋಧನೆ ಮಾಡಿ<br><b>निष्पत्तिः - </b>उप + दिश (अतिसर्जने) - "ल्यप्" (७-१-३७)<br><br>

उपदिष्ट
उपदिष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪದೇಶ /ಶಿಕ್ಷಣ<br><b>निष्पत्तिः - </b>उप + दिश (अतिसर्जने) - "क्तः" (३-३-११४)<br><br>उपदिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪದೇಶಿಸಲ್ಪಟ್ಟ /ಬೋಧಿಸಲ್ಪಟ್ಟ ಮನುಷ್ಯ<br><br>उपदिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪದೇಶಿಸಲ್ಪಟ್ಟ /ಬೋಧಿಸಲ್ಪಟ್ಟ ವಿಷಯ<br><b>निष्पत्तिः - </b>उप + दिश (अतिसर्जने) - कर्म० "क्तः" (३-२-१०)<br><b>प्रयोगाः - </b>"अवहितहृदयो विधाय सोऽर्हामृषिवदृषिप्रवरे गुरूपदिष्टाम्"<br><b>उल्लेखाः - </b>किरा० २-५८<br><br>

उपदीका
उपदीका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೆದ್ದಲು ಹುಳ<br><b>निष्पत्तिः - </b>उप + दो (अवखण्डने) - "कः" (वा०३-३-५८) । "ङीष्" । स्वार्थे "कः"<br><b>व्युत्पत्तिः - </b>उपेत्य दीयते कण्डूयते<br><b>विस्तारः - </b>"वम्रो वम्र्युपदीकोपजिह्विका चोपदेहिका" - वैज० ।<br><br>

उपदेव
उपदेव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವಕರಾಜನ ಒಬ್ಬ ಮಗ<br><b>प्रयोगाः - </b>"चत्वारो देवकात्मजाः । देववानुपदेवश्च सुदेवो देववर्धनः"<br><b>उल्लेखाः - </b>भाग० ९-२४-२२<br><br>उपदेव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ರೂರನ ಒಬ್ಬ ಮಗ<br><br>उपदेव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಕ್ಷ, ಗಂಧರ್ವ ,ಅಪ್ಸರಸ್ಸು<br><br>उपदेव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆಗಳಸಮೀಪ<br><br>

उपदेवा
उपदेवा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಸುದೇವನ ೧೪ಮಂದಿ ಪತ್ನಿಯರಲ್ಲೊಬ್ಬಳು<br><br>

उपदेश
उपदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೊಧನೆ /ಶಿಕ್ಷಣ /ಕಲಿಸುವುದು /ಪಾಠ ಹೇಳುವುದು<br><b>निष्पत्तिः - </b>उप + दिश (अतिसर्जने) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"उपदेशं विदुः शुद्धं सन्तस्तमुपदेशिनः । श्यामायते न विद्वत्सु यः काञ्चनमिवाग्निषु ॥"<br><b>उल्लेखाः - </b>माल० २-९<br><br>उपदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿತವನ್ನು ಹೇಳುವುದು /ಸಲಹೆ ಕೊಡುವುದು<br><br>उपदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯಚಂದ್ರರ ಗ್ರಹಣ ಮೊದಲಾದ ಪುಣ್ಯಕಾಲಗಳಲ್ಲಿ ಪುಣ್ಯಕ್ಷೇತ್ರಗಳಲ್ಲಿ ಮಂತ್ರಗಳನ್ನು ಹೇಳಿಕೊಡುವುದು<br><b>प्रयोगाः - </b>"चन्द्रसूर्यग्रहे तीर्थे सिद्धक्षेत्रे शिवालये । मन्त्रमात्रप्रकथनमुपदेशः स उच्यते ॥"<br><br>उपदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣ ಶಾಸ್ತ್ರ ಪ್ರವರ್ತಕಾಚಾರ್ಯರು ಪ್ರಥಮವಾಗಿ ಉಚ್ಚರಿಸಿದ ಪದಗಳು<br><b>प्रयोगाः - </b>"धातुसूत्रगणोणादिवाक्यलिङ्गानुशासनम् । आगमप्रत्ययादेशा उपदेशाः प्रकीर्तिताः ॥"<br><br>

उपदेशक
उपदेशक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಾಧ್ಯಾಯ /ವಿದ್ಯೆ ಕಲಿಸುವವನು /ಪಾಠ ಹೇಳುವವನು<br><b>निष्पत्तिः - </b>उप + दिश (अतिसर्जने) - "ण्वुल्" (३-१-१३३)<br><br>उपदेशक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂತ್ರೋಪದೇಶ ಮಾಡುವ ಗುರು<br><br>उपदेशक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಲಹೆಗಾರ<br><br>

उपदेशन
उपदेशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೋಧನೆ /ಕಲಿಸುವಿಕೆ<br><br>उपदेशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಲಹೆ /ಹಿತ ಹೇಳುವುದು<br><b>निष्पत्तिः - </b>उप + दिश (अतिसर्जने) - "ल्युट्" (३-३-११५)<br><br>उपदेशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂತ್ರೋಪದೇಶ ಮಾಡುವುದು<br><br>

उपदेशितृ
उपदेशितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>उपदेशक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>उप + दिश (अतिसर्जने) - "तृच्" (३-१-१३३)<br><br>

उपदेशित्री
उपदेशित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उपदेशक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उपदेशिन्
उपदेशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>उपदेशक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>उप + दिश (अतिसर्जने) - "णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"उपदेशं विदुः शुद्धं सन्तस्तमुपदेशिनः । श्यामायते न विद्वत्सु यः काञ्चनमिवाग्निषु ॥"<br><b>उल्लेखाः - </b>माल० २-९<br><br>

उपदेशिनी
उपदेशिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उपदेशक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उपदेश्य
उपदेश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೋಧಿಸಲ್ಪಡುವವನು /ಕಲಿಸಲ್ಪಡುವವನು<br><b>निष्पत्तिः - </b>उप + दिश (अतिसर्जने) - कर्म० "ण्यत्" (३-१-१२४)<br><b>व्युत्पत्तिः - </b>उपदिश्यते<br><br>उपदेश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪದೇಶಕ್ಕೆ ಅರ್ಹನಾದವನು<br><br>उपदेश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪದೇಶಕ್ಕೆ ಅರ್ಹವಾದ ವಿಷಯ<br><br>

उपदेष्टृ
उपदेष्टृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿದ್ಯೆ ಕಲಿಸುವ ಗುರು<br><br>उपदेष्टृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಂತ್ರೋಪದೇಶ ಮಾಡುವ ಗುರು<br><br>उपदेष्टृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಧ್ಯಾತ್ಮ ವಿದ್ಯೆ ಕಲಿಸುವ ಆಚಾರ್ಯ<br><b>प्रयोगाः - </b>"चत्वारो वयमृत्विजः स भगवान् कर्मोपदेष्टा हरिः"<br><b>उल्लेखाः - </b>वेणी० १-२५<br><br>उपदेष्टृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಲಹೆಗಾರ /ಹಿತವನ್ನು ಬೋಧಿಸುವವನು<br><b>निष्पत्तिः - </b>उप + दिश (अतिसर्जने) - "तृच्" (३-१-१३३)<br><br>

उपदेष्ट्री
उपदेष्ट्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उपदेष्टृ ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उपदेह
उपदेह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹವು ದೊಡ್ಡದಾಗುವಿಕೆ /ಗಂಡಮಾಲೆ ಬಾವು ಮೊದಲಾದುವುಗಳಿಂದ ಮೈ ಊದುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + दिह (उपचये) - कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>उपदिह्यतेऽनेन<br><b>प्रयोगाः - </b>"कण्डूर्गुरुत्वं सुप्तत्वमुपदेहोऽल्पवेदनं स्तम्भः शैत्यं च यत्र तं श्लैष्मिकमिति विद्यात्"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

उपदेहिका
उपदेहिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೆದ್ದಲು ಹುಳ<br><b>विस्तारः - </b>"वम्रो वम्र्युपदीकोपजिह्विका चोपदेहिका" - वैज० ।<br><br>

उपदोह
उपदोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಲು ಕರೆಯುವ ಪಾತ್ರೆ<br><b>निष्पत्तिः - </b>उप + दुह (प्रपूरणे) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>उपदुह्यतेऽत्र<br><br>उपदोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಸುವಿನ ಮೊಲೆಯ ತುದಿ<br><b>निष्पत्तिः - </b>उप + दुह (प्रपूरणे) - कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>उपदुह्यतेऽनेन<br><br>

उपद्रव
उपद्रव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೊಂದರೆ /ಪೀಡೆ<br><b>निष्पत्तिः - </b>उप + द्रु (गतौ) - भावे "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"पुंसामसमर्थानामुपद्रवायात्मनो भवेत्कोपः"<br><b>उल्लेखाः - </b>पञ्चतं०<br><br>उपद्रव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಪಂಚದ ಮಹಾಪ್ರಲಯ<br><br>उपद्रव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗ /ವ್ಯಾಧಿ /ಖಾಯಿಲೆ<br><br>उपद्रव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗಕ್ಕೆ ಕಾರಣವಾದ ತ್ರಿದೋಷಗಳ ಏರುಪೇರು<br><br>उपद्रव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪವ್ಯಾಧಿ /ಒಂದು ವ್ಯಾಧಿಯಿರುವಾಗ ಅಧ್ಯೆಸಂಭವಿಸುವ ಇತರ ವ್ಯಾಧಿಗಳು<br><b>विस्तारः - </b>"यो व्याधिस्तस्य यो हेतुः दोषस्तस्य प्रकोपतः । योऽन्यो विकारो भवति स उपद्रव उच्यते ॥"<br><br>

उपद्रविन्
उपद्रविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಂದರೆ ಕೊಡುವವನು /ಹಿಂಸಿಸುವವನು<br><br>

उपद्रष्टृ
उपद्रष्टृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞದಲ್ಲಿ ಒಬ್ಬ ಋತ್ವಿಕ್ಕು<br><br>उपद्रष्टृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಕ್ಷಿ /ಸಮೀಪದಲ್ಲಿ ನಿಂತು ನೋಡುವವನು<br><b>निष्पत्तिः - </b>उप +दृशिर् (प्रेक्षणे) - "तृच्" (३-१-१३३)<br><b>प्रयोगाः - </b>"उपद्रष्टाऽनुमन्ता च भर्ता भोक्ता महेश्वरः"<br><b>उल्लेखाः - </b>गीता० १३-२२<br><br>

उपद्रष्ट्री
उपद्रष्ट्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उपद्रष्टृ ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उपद्रुत
उपद्रुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೀಡಿಸಲ್ಪಟ್ಟ /ತೊಂದರೆ ಪಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + द्रु (गतौ) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"समीरसङ्गादिव नीरभङ्ग्या मया तटस्थस्त्वमुपद्रुतोऽसि"<br><b>उल्लेखाः - </b>नैष० ३-५५<br><br>

उपधर्म
उपधर्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಖ್ಯವಲ್ಲದ ಧರ್ಮ /ಅಪ್ರಧಾನ ಧರ್ಮ<br><b>व्युत्पत्तिः - </b>उपमितो धर्मेण<br><b>प्रयोगाः - </b>"वेदमेवाभ्यसेन्नित्यं यथाकालमतन्द्रितः । तं ह्यस्याहुः परं धर्ममुपधर्मोऽन्य उच्यते ॥"<br><b>उल्लेखाः - </b>मनु० ४-१४७<br><br>

उपधा
उपधा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನು ಮಂತ್ರಿಗಳ ಗುಣಗಳನ್ನು ಪರೀಕ್ಷಿಸುವುದು<br><b>निष्पत्तिः - </b>उप + डुधाञ् (धारणपोषणयोः) - "अङ्" (३-३-१०६)<br><b>व्युत्पत्तिः - </b>उपधीयते सत्यज्ञानमत्र<br><b>प्रयोगाः - </b>"धर्मार्थकाममोक्षैश्च प्रत्येकं परिशोधने । उपेत्य धीयते यस्मादुपधा तेन कीर्तिता ॥" "चिन्तावन्तः कथां चक्रुः उपधाभेदभीरवः" ।<br><b>उल्लेखाः - </b>२)भट्टि० ७-७२<br><br>उपधा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಸ /ಕಪಟ /ವಂಚನೆ<br><b>प्रयोगाः - </b>"उपधाभिश्च यः कश्चित् परद्रव्यं हरेन्नरः । ससहायः स हन्तव्यः प्रकाशं विविधैर्वधैः ॥"<br><b>उल्लेखाः - </b>मनु० ८-१९३<br><br>उपधा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಾಯ<br><b>प्रयोगाः - </b>"अयशोभिदुरालोके कोपधा मरणादृते"<br><b>उल्लेखाः - </b>माघ० १९-५८<br><br>उपधा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣ ಶಾಸ್ತ್ರದಲ್ಲಿ ಉಪಾಂತ್ಯ ವರ್ಣ /ಕೊನೆಯ ಅಕ್ಷರಕ್ಕೆ ಹಿಂದಿನ ಅಕ್ಷರ<br><b>प्रयोगाः - </b>"अलोऽन्त्यात् पूर्व उपधा"<br><b>उल्लेखाः - </b>पा० सू० १-१-६५<br><br>

उपधातु
उपधातु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿನ್ನ ಬೆಳ್ಳಿ ಮುಂತಾದ ಪ್ರಧಾನ ಧಾತುಗಳಂತಿರುವ ೭ ಧಾತುಗಳು<br><b>विस्तारः - </b>ಸ್ವರ್ಣಮಾಕ್ಷಿಕ, ತಾರಮಾಕ್ಷಿಕ, ತುತ್ಥ, ಕಂಚು, ಹಿತಾಳೆ, ಸಿಂದೂರ ಮತ್ತು ಶಿಲಾಜತು - ಇವು ೭ ಧಾತುಗಳು.<br><br>उपधातु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಯೊಳಗಿನ ರಸಾದಿ ಧಾತುಗಳಿಂದ ಉಂಟಾಗುವ ೭ ಉಪಧಾತುಗಳು<br><br>

उपधान
उपधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆದಿಂಬು<br><b>निष्पत्तिः - </b>उप + डुधाञ् (धारणपोषणयोः) - अधि० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>उपधीयते शिरोऽत्र<br><br>उपधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶೇಷ /ಅತಿಶಯ<br><b>निष्पत्तिः - </b>उप + डुधाञ् (धारणपोषणयोः) - कर्म० "ल्युट्" (३-३-११३)<br><b>प्रयोगाः - </b>"सोपधानां धियं धीराः स्थेयसीं खट्वयन्ति ये"<br><b>उल्लेखाः - </b>माघ० २-७७<br><br>उपधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಣಯ /ಪ್ರೀತಿ<br><br>उपधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ /ನಂಜು<br><b>विस्तारः - </b>"उपधानं विषे गण्डौ प्रणयेऽपि नपुंसकम्" - मेदि० ।<br><br>उपधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿಡುವುದು /ಹತ್ತಿರದಲ್ಲಿರಿಸುವುದು<br><b>निष्पत्तिः - </b>उप + डुधाञ् (धारणपोषणयोः) - भावे "ल्युट्" (३-३-११५)<br><br>

उपधानीय
उपधानीय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆದಿಂಬು<br><b>निष्पत्तिः - </b>उप + डुधाञ् (धारणपोषणयोः) - "अनीयर्" (३-१-९६)<br><b>व्युत्पत्तिः - </b>उपधीयते शिरोऽत्र<br><br>उपधानीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿಡಲ್ಪಡುವ<br><br>

उपधायिन्
उपधायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಲೆದಿಂಬಾಗಿ ಉಳ್ಳ /ತಲೆದಿಂಬಾಗಿ ಮಾಡಿಕೊಂಡಿರುವ<br><b>निष्पत्तिः - </b>उप + डुधाञ् (धारणपोषणयोः) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उपदधाति<br><br>

उपधायिनी
उपधायिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆದಿಂಬಾಗಿ ಉಳ್ಳ /ತಲೆದಿಂಬಾಗಿ ಮಾಡಿಕೊಂಡಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><b>प्रयोगाः - </b>"अशेत सा बाहुलतोपधायिनी निषेदुषी स्थण्डिल एव केवले"<br><b>उल्लेखाः - </b>कुमा० ५-१२<br><br>

उपधारण
उपधारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಿರುವ ಹಣ್ಣು ಮೊದಲಾದ ವಸ್ತುವನ್ನು ಕೊಕ್ಕೆಯಿಂದ ಎಳೆದುಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>उप + धृञ् (धारणे) + णिच् - "ल्युट्" (३-३-११५)<br><br>उपधारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಯೋಚಿಸುವುದು /ಪರ್ಯಾಲೋಚಿಸುವುದು<br><br>

उपधारणा
उपधारणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>೮ ವಿಧ ಯೋಗಾಂಗಳಲ್ಲೊಂದು /ನಾಭಿ ಚಕ್ರ ಹೃದಯ ಭ್ರೂಮಧ್ಯ ಮುಂತಾದ ಸ್ಥಾನಗಳಲ್ಲಿ ಮನಸ್ಸು ಸ್ಥಿರವಾಗಿ ನಿಲ್ಲುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + धृञ् (धारणे) + णिच् - "युच्" (३-३-१०७)<br><br>

उपधावन
उपधावन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಓಡುವುದು /ಹತ್ತಿರಕ್ಕೆ ಓಡುವುದು<br><b>निष्पत्तिः - </b>उप + धावु (गतिशुद्ध्योः) - भावे "ल्युट्" (३-३-११५)<br><br>उपधावन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯೋಚಿಸುವುದು /ಚಿಂತಿಸುವುದು<br><br>

उपधि
उपधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಛಲ /ಕಪಟ /ವ್ಯಾಜ /ನೆಪ<br><b>निष्पत्तिः - </b>उप + डुधाञ् (धारणपोषणयोः) - "किः" (३-३-९२)<br><b>व्युत्पत्तिः - </b>उपधीयतेऽनेन<br><b>प्रयोगाः - </b>"अरिषु हि विजयार्थिनः क्षितीशाः विदधति सोपधि सन्धिदूषणानि"<br><b>उल्लेखाः - </b>किरा० १-४५<br><br>उपधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಜವನ್ನು ಮುಚ್ಚುವಿಕೆ /ಒಂದು ರೀತಿಯಲ್ಲಿರುವವಸ್ತುವನ್ನು ಮತ್ತೊಂದು ರೀತಿಯಲ್ಲಿ ತೋರಿಸುವಿಕೆ<br><b>प्रयोगाः - </b>"योगधमनविक्रीतं योगदानप्रतिग्रहम् । यत्र वाप्युपधिं पश्येत् तत्सर्वं विनिवर्तयेत् ॥"<br><b>उल्लेखाः - </b>मनु० ८-१६५<br><br>उपधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಥದ ಚಕ್ರ /ಬಂಡಿಯ ಗಾಲಿ<br><b>विस्तारः - </b>"उपधिः पुंसि व्याजरथाङ्गयोः" - मेदि० ।<br><br>

उपधूपित
उपधूपित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಯಿಸಲ್ಪಟ್ಟ /ಒಣಗಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + धूप (सन्तापे) - "क्तः" (३-२-१०२)<br><br>

उपधृति
उपधृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಣ<br><b>निष्पत्तिः - </b>उप + धृञ् (धारणे) - "क्तिन्" (३-३-९४)<br><b>विस्तारः - </b>"ज्योतिरर्चिरुपधृतभीषवः" - अभि० चि० ।<br><br>उपधृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಡಿದುಕೊಳ್ಳುವಿಕೆ<br><br>

उपध्मान
उपध्मान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಓಷ್ಠ /ತುಟಿ<br><b>निष्पत्तिः - </b>उप + ध्मा (शब्दाग्निसंयोगयोः) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>उः उकारः पश्च ध्मायतेऽनेन<br><br>

उपध्मानीय
उपध्मानीय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಫಕಾರಗಳ ಹಿಂದೆ ಉಚ್ಚರಿಸಲ್ಪಡುವ ಅರ್ಧವಿಸರ್ಹ<br><b>प्रयोगाः - </b>"उपूपध्मानीयानामोष्ठौ"<br><b>उल्लेखाः - </b>सि० कौ०<br><br>

उपनक्षत्र
उपनक्षत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಿನಿ ಮೊದಲಾದ ೨೭ ನಕ್ಷತ್ರಗಳನ್ನು ಅನುಸರಿಸುವ ಉಪನಕ್ಷತ್ರಗಳು<br><b>प्रयोगाः - </b>"तानि वा एतानि सप्तविंशतिः नक्षत्राणि सप्तविंशतिः, सप्तविंशतिः हि उपनक्षत्राणि एकैकं नक्षत्रमनूपतिष्ठन्ते तानि च सप्तशतानि विंशतिश्चाधि"<br><b>उल्लेखाः - </b>शत० ब्रा०<br><br>

उपनख
उपनख<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಗುರು ಸುತ್ತು /ಒಂದು ವಿಧ ಬೆರಳು ಕುರು<br><b>व्युत्पत्तिः - </b>उपगतं नखं नखमांसम्<br><b>प्रयोगाः - </b>"नखमांसमधिष्ठाय पित्तं वातश्च वेदनाम् । करोति दाहपकौ च तं व्याधिं चिप्पमादिशेत् । तदेवाक्षतरोगाख्यं तथोपनखमित्यपि ॥"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

उपनगर
उपनगर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಖಾನಗರ /ನಗರದ ಬಡಾವಣೆ<br><b>व्युत्पत्तिः - </b>उपमितं नगरेण<br><br>

उपनत
उपनत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಬಂದ<br><b>निष्पत्तिः - </b>उप + णम (प्रह्वत्वे शब्दे) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"इदमुपनतमेवं रूपमक्लिष्टकान्तिं प्रथमपरिगृहीतं स्यान्नवेति व्यवस्यन्"<br><b>उल्लेखाः - </b>शाकु० ५-१९<br><br>उपनत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಮ್ರ /ವಿಧೇಯ /ತಲೆಬಾಗಿ ನಮಸ್ಕರಿಸಿದ<br><b>प्रयोगाः - </b>"तस्मिन् दण्डोपनतचरितं भेजिरे लोकपालाः"<br><b>उल्लेखाः - </b>रघु० १७-८१<br><br>उपनत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಟ್ಟ /ಪಡೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + णम (प्रह्वत्वे शब्दे) - कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अथ प्रभावोपनतैः कुमारं कल्पद्रुमोत्थैरवकीर्य पुष्पैः"<br><b>उल्लेखाः - </b>रघु० ५-५२<br><br>

उपनति
उपनति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಹೋಗುವಿಕೆ /ಹತ್ತಿರ ಸೇರುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + णम (प्रह्वत्वे शब्दे) - "क्तिन्" (३-३-९४)<br><br>उपनति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಬಾಗಿ ನಮಸ್ಕರಿಸುವಿಕೆ<br><br>

उपनद
उपनद<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನದಿಯ ಸಮೀಪ /ಹೊಳೆಯ ಹತ್ತಿರ<br><b>निष्पत्तिः - </b>वा "टच्" (५-४-११०)<br><b>व्युत्पत्तिः - </b>नद्याः समीपम्<br><br>

उपनदि
उपनदि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನದಿಯ ಸಮೀಪ /ಹೊಳೆಯ ಹತ್ತಿರ<br><br>

उपनदी
उपनदी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರಕ್ಕೆ ಸೇರುವ ದೊಡ್ಡ ನದಿಯ ಉಪನದಿ /ಸಣ್ಣ ನದಿ<br><b>व्युत्पत्तिः - </b>उपगता नदी<br><br>

उपनम्र
उपनम्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಸ್ಥಿತವಾದ /ಸಮೀಪಕ್ಕೆ ಬಂದಿರುವ /ಹತ್ತಿರಕ್ಕೆ ಬಂದಿರುವ<br><b>निष्पत्तिः - </b>उप + णम (प्रह्वत्वे शब्दे) - "रक्" (३-२-१६७)<br><b>प्रयोगाः - </b>"उपनम्रमयाचितं हितं परिहर्तुं न तवापि साम्प्रतम्"<br><b>उल्लेखाः - </b>नैष० २-१२<br><br>

उपनय
उपनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿರಕ್ಕೆ ತರುವುದು /ಸಮೀಪಕ್ಕೆ ಒಯ್ಯುವುದು<br><b>निष्पत्तिः - </b>उप +णीञ् (प्रापणे) - "अच्" (३-३-५६)<br><br>उपनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪನಯನ /ಮುಂಜಿ<br><b>निष्पत्तिः - </b>उप +णीञ् (प्रापणे) - कर० "अच्"<br><b>प्रयोगाः - </b>"गृह्योक्तकर्मणा येन समीपं नीयते गुरोः । बालो वेदाय तद्योगात् बालस्येपनयं विदुः ॥"<br><br>उपनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾರ್ಕಿಕ ಮತದಲ್ಲಿ ನ್ಯಾಯದ ೫ ಅವಯವಗಳಲ್ಲೊಂದು<br><br>

उपनयत्
उपनयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ತರುತ್ತಿರುವ /ಹತ್ತಿರಕ್ಕೆ ಒಯ್ಯುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उप +णीञ् (प्रापणे) - "शतृ" (३-२-१२४)<br><br>उपनयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಂಟುಮಾಡುತ್ತಿರುವ /ಹುಟ್ಟಿಸುತ್ತಿರುವ<br><b>प्रयोगाः - </b>"न व्यहन्यत कदापि मुदं यः स्वःसदामुपनयन्नभिलाषः"<br><b>उल्लेखाः - </b>नैष० ५-१२३<br><br>

उपनयन
उपनयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಒಯ್ಯುವುದು /ಹತ್ತಿರಕ್ಕೆ ತರುವುದು<br><b>निष्पत्तिः - </b>उप +णीञ् (प्रापणे) - "ल्युट्" (३-३-११५)<br><br>उपनयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೇದಾಭ್ಯಾಸಕ್ಕಾಗಿ ಬಾಲಕನನ್ನು ಗುರುವಿನಲ್ಲಿಗೆ ಕಳುಹಿಸಿಕೊಡಲು ಮಾಡುವ ಒಂದು ಸಂಸ್ಕಾರ<br><b>निष्पत्तिः - </b>उप +णीञ् (प्रापणे) - कर० "ल्युट्" (३-३-११७)<br><br>

उपनयनीय
उपनयनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿದ್ಯಾಭ್ಯಾಸಕ್ಕಾಗಿ ಗುರುವಿನಲ್ಲಿಗೆ ಕಳುಹಿಸಲ್ಪಡುವ ಶಿಷ್ಯ<br><b>निष्पत्तिः - </b>उप +णीञ् (प्रापणे) - कर्म० "अनीयर्" (३-१-९६)<br><br>

उपनहन
उपनहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಧನ /ಕಟ್ಟುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + णह (बन्धने) - "ल्युट्" (३-३-११५)<br><br>उपनहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಟು ಕಟ್ಟುವ ಬಟ್ಟೆ<br><b>निष्पत्तिः - </b>उप + णह (बन्धने) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>उपनह्यतेऽनेन<br><br>

उपनाय
उपनाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪನಯನ ಸಂಸ್ಕಾರ<br><b>निष्पत्तिः - </b>उप +णीञ् (प्रापणे) + णिच् "अच्" (३-३-५६)<br><b>व्युत्पत्तिः - </b>उपनाययति<br><br>

उपनायक
उपनायक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಟಕ ಮೊದಲಾದುವುಗಳಲ್ಲಿ ಪ್ರಧಾನ ನಾಯಕನಿಗೆ ಸಹಾಯಕನಾಗಿರುವವನು /ಪ್ರಧಾನ ನಾಯಕನ ಕೆಲಸಕ್ಕೆ ಅನುಕೂಲನಾಗಿರುವ ಸ್ನೇಹಿತ<br><b>व्युत्पत्तिः - </b>उपगतो नायकम्<br><br>उपनायक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪನಯನ ಸಂಸ್ಕಾರ ಮಾಡುವ ಗುರು<br><b>निष्पत्तिः - </b>उप +णीञ् (प्रापणे) + णिच् - "ण्वुल्" (३-१-१३३)<br><br>उपनायक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಪತಿ /ಮಿಂಡ<br><br>उपनायक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಒಯ್ಯುವ /ಹತ್ತಿರಕ್ಕೆ ತರುವ<br><br>

उपनायन
उपनायन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪನಯನ ಸಂಸ್ಕಾರ /ವಿದ್ಯಾಭ್ಯಾಸಕ್ಕಾಗಿ ಗುರುವಿನ ಬಳಿಗೆ ಕಳುಹಿಸಿಕೊಡಲು ಮಾಡುವ ಒಂದು ಸಂಸ್ಕಾರ<br><b>निष्पत्तिः - </b>उप +णीञ् (प्रापणे) + णिच् - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"गर्भाष्टमेऽब्दे कुर्वीत ब्राह्मणस्योपनायनम्"<br><b>उल्लेखाः - </b>मनु० २-३६<br><br>

उपनाह
उपनाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೀಣೆಯ ತಂತಿಯನ್ನು ಎಳೆದು ಕಟ್ಟುವ ಬಾಯಿ ಮತ್ತು ಬಿರಡೆ<br><b>निष्पत्तिः - </b>उप + णह (बन्धने) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>उपनह्यतेऽस्मिन्<br><br>उपनाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಣ್ಣು ಗಾಯ ಮೊದಲಾದುವುಗಳಿಗೆ ಕಟ್ಟುವ ಮುಲಾಮು ಹಿಟ್ಟು ಮೊದಲಾದುದು<br><br>

उपनाहन
उपनाहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹುಣ್ಣು ಗಾಯ ಮೊದಲಾದುವುಗಳಿಗೆ ಮುಲಾಮು ಹಿಟ್ಟು ಮೊದಲಾದುವನ್ನು ಕಟ್ಟುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + णह (बन्धने) + णिच् - "ल्युट्" (३-३-११५)<br><br>

उपनिक्षेप
उपनिक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆಗಾಗಿ ಮತ್ತೊಬ್ಬರ ವಶದಲ್ಲಿ ಅಮಾನತ್ತಿನಲ್ಲಿಡುವ ವಸ್ತು ಅಥವಾ ಧನ<br><b>निष्पत्तिः - </b>उप + नि + क्षिपु (निरसने) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>उपनिक्षिप्यते<br><b>विस्तारः - </b>उपनिक्षेपो नाम रूपसङ्ख्याप्रदर्शनेन रक्षणार्थं निहितं द्रव्यम् ।<br><br>उपनिक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸ್ತು ಅಥವಾ ಧನವನು ರಕ್ಷಣೆಗಾಗಿ ಮತ್ತೊಬ್ಬರ ವಶದಲ್ಲಿ ಅಮಾನತ್ತಿನಲ್ಲಿಡುವುದು<br><b>निष्पत्तिः - </b>उप + नि + क्षिपु (निरसने) - भावे "घञ्" (३-३-१८)<br><br>उपनिक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದಲ್ಲಿ ಇಡುವಿಕೆ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

उपनिक्षेपण
उपनिक्षेपण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದಲ್ಲಿ ಇಡುವಿಕೆ<br><br>

उपनिधातृ
उपनिधातृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆಗಾಗಿ ದ್ರವ್ಯವನ್ನು ಮತ್ತೊಬ್ಬನಲ್ಲಿಡುವ<br><br>उपनिधातृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದಲ್ಲಿಡುವ /ಸಮೀಪದಲ್ಲಿಡುವ<br><b>निष्पत्तिः - </b>उप + नि + डुधाञ् (धारणपोषणयोः) - "तृच्" (३-१-१३३)<br><br>

उपनिधात्री
उपनिधात्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उपनिधातृ ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उपनिधायक
उपनिधायक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>उपनिधातृ ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>उप + नि + डुधाञ् (धारणपोषणयोः) - "ण्वुल्" (३-१-१३३)<br><br>

उपनिधान
उपनिधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಸ್ತು ಅಥವಾ ಅದ್ರವ್ಯವನ್ನು ರಕ್ಷಣೆಗಾಗಿ ಮತ್ತೊಬ್ಬರಲ್ಲಿ ಅಮಾನತ್ತಿನಲ್ಲಿಡುವುದು<br><b>निष्पत्तिः - </b>उप + नि + डुधाञ् (धारणपोषणयोः) - भावे "ल्युट्" (३-३-११५)<br><br>उपनिधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದಲ್ಲಿಡುವುದು<br><br>उपनिधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಠೇವಣಿ<br><br>

उपनिधि
उपनिधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆಗಾಗಿ ಮತ್ತೊಬ್ಬರ ವಶದಲ್ಲಿ ಅಮಾನತ್ತಿನಲ್ಲಿಡುವ ವಸ್ತು ಅಥವಾ ಧನ<br><b>निष्पत्तिः - </b>उप + नि + डुधाञ् (धारणपोषणयोः) - "किः" (३-३-९२)<br><br>उपनिधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆಗಾಗಿ ಮತ್ತೊಬ್ಬರಲ್ಲಿ ದ್ರವ್ಯವನ್ನು ಇಡುವುದು<br><br>

उपनिनीषा
उपनिनीषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ತರಲು ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>उप + णीञ् (प्रापणे) + सन् - "अः" (३-३-१०२)<br><b>व्युत्पत्तिः - </b>उपनेतुमिच्छा<br><br>

उपनिनीषु
उपनिनीषु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ತರಲು ಅಪೇಕ್ಷಿಸುವ<br><b>निष्पत्तिः - </b>उप + णीञ् (प्रापणे) + सन् - "उः" (३-२-१६८)<br><b>व्युत्पत्तिः - </b>उपनेतुमिच्छुः<br><br>

उपनिपात
उपनिपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಬರುವಿಕೆ /ಹತ್ತಿರಕ್ಕೆ ಬಂದು ಸೇರುವಿಕೆ<br><br>उपनिपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಠಾತ್ತಾಗಿ ಬರುವುದು /ಆಕಸ್ಮಿಕವಾಗಿ ಬಂದು ಸೇರುವುದು /ಅನಿರೀಕ್ಷಿತವಾಗಿ ಒದಗುವುದು<br><b>निष्पत्तिः - </b>उप + नि + पत्लृ (गतौ) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"व्रजतोऽस्य बृहत्पतत्रजन्मा कृततार्क्ष्योपनिपातवेगशङ्कञ्"<br><b>उल्लेखाः - </b>किरा० १३-२१<br><br>

उपनिपातिन्
उपनिपातिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಬರುವ /ಹತ್ತಿರಕ್ಕೆ ಬಂದು ಸೇರುವ<br><br>उपनिपातिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಕಸ್ಮಾತ್ತಾಗಿ ಬಂದು ಸೇರುವ /ಅನಿರೀಕ್ಷಿತವಾಗಿ ಬಂದೊದಗುವ<br><b>निष्पत्तिः - </b>उप + नि + पत्लृ (गतौ) - "णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"रन्ध्रोपनिपातिनोऽनर्था इति यदुच्यते तदव्यभिचारिवचः"<br><b>उल्लेखाः - </b>शाकु० ६<br><br>

उपनिबद्ध
उपनिबद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಚಿಸಲ್ಪಟ್ಟ ಗ್ರಂಥ<br><br>उपनिबद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೋಡಿಸಲ್ಪಟ್ಟ ವಿಷಯ<br><b>निष्पत्तिः - </b>उप + नि + बन्ध (बन्धने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"यदिदमस्माभिरार्षेण चक्षुषा समुद्वीक्ष्य पावनं वचनामृतं करुणाद्भुतरसं च किञ्चिदुपनिबद्धम्"<br><b>उल्लेखाः - </b>उ० रा० ७<br><br>उपनिबद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಟ್ಟಲ್ಪಟ್ಟ ಪುಷ್ಪಮಾಲೆ<br><br>

उपनिबन्ध
उपनिबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಪಥ /ಪ್ರತಿಜ್ಞೆ<br><b>निष्पत्तिः - </b>उप + नि + बन्ध (बन्धने) - "घञ्" (३-३-१९)<br><br>उपनिबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಯಮ /ಕಟ್ಟಳೆ<br><br>

उपनिबन्धन
उपनिबन्धन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಂಥರಚನೆ<br><br>उपनिबन्धन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಯಗಳ ಜೋಡಣೆ<br><br>उपनिबन्धन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಷ್ಪಮಾಲೆಯ ರಚನೆ<br><b>निष्पत्तिः - </b>उप + नि + बन्ध (बन्धने) - भावे "ल्युट्" (३-३-११५)<br><br>उपनिबन्धन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪಾದನೆಯ ಸಾಧನ /ಕಾರ್ಯದಸಲಕರಣೆ<br><b>निष्पत्तिः - </b>उप + नि + बन्ध (बन्धने) - कर० "ल्युट्" (३-३-११७)<br><br>उपनिबन्धन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಯಮ /ಕಟ್ಟಳೆ<br><br>

उपनिमन्त्रण
उपनिमन्त्रण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಹ್ವಾನ /ಕರೆ<br><b>निष्पत्तिः - </b>उप + नि + मत्रि (गुप्तभाषणे) - "ल्युट्" (३-३-११५)<br><br>

उपनिविष्ट
उपनिविष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳಗೆ ಪ್ರವೇಶಿಸಿದ<br><b>निष्पत्तिः - </b>उप + नि + विश (प्रवेशने) - "क्तः" (३-४-७२)<br><br>

उपनिवेश
उपनिवेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿಡುವಿಕೆ /ಹತ್ತಿರದಲ್ಲಿರಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + नि + विश (प्रवेशने) - "घञ्" (३-३-१८)<br><b>व्युत्पत्तिः - </b>उपनिविशन्तेऽत्र<br><br>उपनिवेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪನಗರ /ಶಾಖಾನಗರ /ನಗರದ ಬಡಾವಣೆ<br><b>निष्पत्तिः - </b>उप + नि + विश (प्रवेशने) - अधि० "घञ्" (३-३-१२१)<br><br>उपनिवेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೆರೆಮನೆ /ಪಕ್ಕದ ಮನೆ<br><br>

उपनिवेशन
उपनिवेशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೆರೆಮನೆ /ಪಕ್ಕದ ಮನೆ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

उपनिवेशनीय
उपनिवेशनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿರಿಸಲು ಯೋಗ್ಯವಾದ<br><br>उपनिवेशनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ ಇಡಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उप + नि + विश (प्रवेशने) - "अनीयर्" (३-१-९६)<br><br>

उपनिवेशित
उपनिवेशित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೃಹರೂಪದಿಂದ ಇಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + नि + विश (प्रवेशने) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"स्वर्गाभिष्यन्दवमनं कृत्वेवोपनिवेशितम्"<br><b>उल्लेखाः - </b>कुमा० ६-३७<br><br>उपनिवेशित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಸ ಮಾಡಿಸಲ್ಪಟ್ಟ<br><br>उपनिवेशित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ ಇಡಲ್ಪಟ್ಟ<br><br>

उपनिषद्
उपनिषद्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮವಿದ್ಯೆ /ರಹಸ್ಯವಿದ್ಯೆ /ಬ್ರಹ್ಮಪ್ರಾಪಕ ವಿದ್ಯೆ<br><b>निष्पत्तिः - </b>उप + नि + षद्लृ (विशरणगत्यवसादनेषु) + णिच् - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>उपनिषादयति नाशयति गर्भजन्मजरात्मकं संसारम्, उपगमयति प्रापयति ब्रह्म, उपनिषण्णं वा परं श्रेयोऽस्याम्<br><br>उपनिषद्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪನಿಷತ್ತಿನಿಂದ ಉಂಟಾದ ಬ್ರಹ್ಮಾತ್ಮಕತ್ವ ಜ್ಞಾನ<br><b>प्रयोगाः - </b>"उपनिषज्जन्यं ब्रह्मात्मकत्वज्ञानम्"<br><b>उल्लेखाः - </b>छान्दोग्य०<br><br>उपनिषद्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮನ ಸಮೀಪದಲ್ಲಿಯೇ ಇರುವುದು<br><b>व्युत्पत्तिः - </b>ब्रह्मणि उपनिषण्णा<br><b>प्रयोगाः - </b>"उपनिषण्णत्वाद्वा उपनिषत्"<br><b>उल्लेखाः - </b>श्रुतप्र०<br><br>उपनिषद्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಹಸ್ಯೋಪದೇಶ<br><b>प्रयोगाः - </b>"उपनीय तमात्मानं ब्रह्मापास्तद्वयं यतः । निहन्त्यविद्यां तज्जं च तस्यादुपनिषद्भवेत् ॥"<br><br>उपनिषद्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯೋಗ /ಉಪಾಸನೆ<br><b>प्रयोगाः - </b>"यदेव विद्यया करोति श्रद्धयोपनिषदा तदेव वीर्यवत्तरम्"<br><b>उल्लेखाः - </b>छान्दोग्य०<br><br>उपनिषद्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿರ್ಜನ ಪ್ರದೇಶ<br><br>उपनिषद्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಧರ್ಮ<br><b>विस्तारः - </b>"भवेदुपनिषद्धर्मे वेदान्ते विजने स्त्रियाम्" - मेदि० ।<br><br>उपनिषद्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಹೋಗುವುದು<br><br>उपनिषद्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದ್ವಿಜರು ಗೋದಾನವೆಂಬ ಕೇಶಖಂಡನಕ್ಕೆ ಮೊದಲು ಮಾಡಬೇಕಾದ ಒಂದು ವ್ರತ<br><b>प्रयोगाः - </b>"प्रथमं स्यात् महानाम्नी द्वितीयं च महाव्रतम् । तृतीयं स्यात् उपनिषद्गोदानं च ततः परम् ॥"<br><b>उल्लेखाः - </b>आश्व० गृ० का०<br><br>

उपनिषादिन्
उपनिषादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ ಕೂಡುವ /ಹತ್ತಿರದಲ್ಲಿ ಕುಳಿತುಕೊಳ್ಳುವ<br><b>निष्पत्तिः - </b>उप + नि + षद्लृ (विशरणगत्यवसादनेषु) - "णिनिः" (३-१-१३४)<br><br>

उपनिषादिनी
उपनिषादिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ ಕೂಡುವ /ಹತ್ತಿರದಲ್ಲಿ ಕುಳಿತುಕೊಳ್ಳುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उपनिषिषत्सा
उपनिषिषत्सा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ ಕೂಡಲು ಆಸೆ /ಹತ್ತಿರದಲ್ಲಿ ಕುಳಿತುಕೊಳ್ಳಲು ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>उप + नि + षद्लृ (विशरणगत्यवसादनेषु) + सन् - "अः" (३-३-१०२)<br><br>

उपनिषिषत्सु
उपनिषिषत्सु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ ಕೂಡಲು ಆಸೆಪಡುವ /ಹತ್ತಿರದಲ್ಲಿ ಕುಳಿತುಕೊಳ್ಳಲು ಅಪೇಕ್ಷಿಸುವ<br><b>निष्पत्तिः - </b>उप + नि + षद्लृ (विशरणगत्यवसादनेषु) + सन् - "उः" (३-२-१६८)<br><b>व्युत्पत्तिः - </b>उपनिषत्तुमिच्छुः<br><br>

उपनिषीदत्
उपनिषीदत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ ಕುಳಿತುಕೊಳ್ಳುವ<br><b>निष्पत्तिः - </b>उप + नि + षद्लृ (विशरणगत्यवसादनेषु) - "शतृ" (३-२-१२४)<br><br>

उपनिषीदन्ती
उपनिषीदन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ ಕುಳಿತುಕೊಳ್ಳುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

उपनिषेदिवस्
उपनिषेदिवस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ ಕುಳಿತಿರುವ<br><b>निष्पत्तिः - </b>उप + नि + षद्लृ (विशरणगत्यवसादनेषु) - "क्वसुः" (३-२-१०८)<br><br>

उपनिषेदुषी
उपनिषेदुषी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ ಕುಳಿತಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

उपनिष्कर
उपनिष्कर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಟ್ಟಣದ ರಸ್ತೆ /ನಗರದ ಮುಖ್ಯರಸ್ತೆ<br><b>निष्पत्तिः - </b>उप + नि + कॄ (विक्षेपे) - "अप्" (३-३-५७)<br><b>व्युत्पत्तिः - </b>उपनिष्कीर्यतेऽत्र सैन्यम्<br><br>

उपनिष्क्रमु|उप + निस् + क्रमु|पादविक्षेपे
उप + निस् + क्रमु - पादविक्षेपे (भ्वा० पर० सक० से०)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೊರಗಡೆಗೆ ಹೊರಡು<br><br>

उपनिष्क्रमण
उपनिष्क्रमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಟ್ಟಣದ ರಸ್ತೆ /ನಗರದ ಮುಖ್ಯರಸ್ತೆ<br><b>निष्पत्तिः - </b>उप + निस् + क्रमु (पादविक्षेपे) - "ल्युट्" (३-३-११७)<br><br>उपनिष्क्रमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊರಗಡೆಗೆ ಹೊರಡುವುದು<br><br>उपनिष्क्रमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಗುವನ್ನು ನಾಲ್ಕನೆಯ ತಿಂಗಳಲ್ಲಿ ಮೊದಲನೆಯದಾಗಿ ಮನೆಯಿಂದ ಹೊರಗಡೆಗೆ ಕರೆತರುವುದು<br><b>निष्पत्तिः - </b>उप + निस् + क्रमु (पादविक्षेपे) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"चतुर्थे मासि कर्तव्यं शिशोर्निष्क्रमणं गृहात्"<br><b>उल्लेखाः - </b>मनु० २-३४<br><br>

उपनिष्क्रान्त
उपनिष्क्रान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊರಗಡೆಗೆ ಹೊರಟಿರುವ<br><b>निष्पत्तिः - </b>उप + निस् + क्रमु (पादविक्षेपे) - "क्तः" (३-४-७२)<br><br>

उपनिष्क्रामत्
उपनिष्क्रामत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊರಗಡೆಗೆ ಹೊರಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उप + निस् + क्रमु (पादविक्षेपे) - "शतृ" (३-२-१२४)<br><br>

उपनिष्क्राम्यत्
उपनिष्क्राम्यत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊರಗಡೆಗೆ ಹೊರಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>वा "श्यन्" (३-१-७०)<br><br>

उपनिष्क्रामन्ती
उपनिष्क्रामन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊರಗಡೆಗೆ ಹೊರಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

उपनिष्क्राम्यन्ती
उपनिष्क्राम्यन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊರಗಡೆಗೆ ಹೊರಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

उपनिहित
उपनिहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿಡಲ್ಪಟ್ಟ<br><br>उपनिहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆಗಾಗಿ ಮತ್ತೊಬ್ಬನಲ್ಲಿಡಲ್ಪಟ್ಟ ದ್ರವ್ಯ<br><b>निष्पत्तिः - </b>उप +नि + डुधाञ् (धारणपोषणयोः) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"विद्वांस्तु ब्राह्मणो दृष्ट्वा पूर्वोपनिहितं निधिम्"<br><b>उल्लेखाः - </b>मनु० ८-३७<br><br>

उपनीत
उपनीत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇದಾಭ್ಯಾಸಕ್ಕಾಗಿ ಗುರುವಿನ ಬಳಿಗೆ ಕಳುಹಿಸಲು ಉಪನಯನಸಂಸ್ಕಾರ ಮಾಡಲ್ಪಟ್ಟ ಬಾಲಕ<br><b>निष्पत्तिः - </b>उप + णीञ् (प्रापणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अथोपनीतं विधिवद्विपश्चितो विनिन्युरेनं गुरवो गुरुप्रियम्"<br><b>उल्लेखाः - </b>रघु० ३-२९<br><br>उपनीत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇದಾಬ್ಯಾಸಕ್ಕಾಗಿ ಗುರುವಿನ ಬಳಿಗೆ ಕಳುಹಿಸಲ್ಪಟ್ಟ ಬಾಲಕ<br><br>उपनीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರಕ್ಕೆ ತರಲ್ಪಟ್ಟ /ಸಮೀಪಕ್ಕೆ ಒಯ್ಯಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"तस्याः करं शैलगुरूपनीतं जग्राह ताम्राङ्गुलिमष्टमूर्तिः"<br><b>उल्लेखाः - </b>कुमा० ७-७६<br><br>उपनीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಪಟ್ಟ /ಅರಿಯಲ್ಪಟ್ಟ<br><br>

उपनीयमान
उपनीयमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ತರಲ್ಪಡುತ್ತಿರುವ /ಹತ್ತಿರಕ್ಕೆ ಒಯ್ಯಲ್ಪಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उप + णीञ् (प्रापणे) + णिच् - कर्म० "शानच्" (३-२-१२४)<br><br>

उपनुन्न
उपनुन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೇರಿಸಲ್ಪಟ್ಟ /ಮುಂದಕ್ಕೆ ತಳ್ಳಲ್ಪಟ್ಟ /ನೂಕಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + णुद (प्रेरणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"द्रुतमरुदुपनुन्नैरुन्नमद्भिः सहेलम्"<br><b>उल्लेखाः - </b>माघ० ४-६८<br><br>

उपनेतव्य
उपनेतव्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪನಯನಸಂಸ್ಕಾರ ಮಾಡಲ್ಪಟ್ಟ ಬಾಲಕ<br><br>उपनेतव्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ತರಲ್ಪಡುವ /ಹತ್ತಿರಕ್ಕೆ ಒಯ್ಯಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>उप + णीञ् (प्रापणे) - "तव्यः" (३-१-९६)<br><b>प्रयोगाः - </b>"एष स चिरदृष्टः कथं पुनरुपनेतव्यः"<br><b>उल्लेखाः - </b>माल० २-४<br><br>उपनेतव्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪನಯನಕ್ಕೆ ಅರ್ಹನಾದವನು /ವೇದಾಭ್ಯಾಸಕ್ಕೆ ಯೋಗ್ಯನಾದವನು<br><br>

उपनेतृ
उपनेतृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಚಾರ್ಯ /ಗುರು<br><b>निष्पत्तिः - </b>उप + णीञ् (प्रापणे) - "तृच्" (३-१-१३३)<br><b>प्रयोगाः - </b>"जनिता चोपनेता च यश्च विद्यां प्रयच्छति । अन्नदाता भयत्राता पञ्चैते पितरः स्मृताः ॥"<br><br>उपनेतृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ತರುವ /ಹತ್ತಿರಕ್ಕೆ ತಂದುಕೊಡುವ<br><br>

उपनेत्री
उपनेत्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उपनेतृ ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><b>प्रयोगाः - </b>"नियमविधिजलानां बर्हिषां चोपनेत्री"<br><b>उल्लेखाः - </b>कुमा० १-६०<br><br>

उपनेत्र
उपनेत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಲೋಚನ /ಸುಲೋಚನ<br><b>व्युत्पत्तिः - </b>उपगतं नेत्रम्<br><br>

उपन्यस्त
उपन्यस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿವರಿಸಿ ಹೇಳಲ್ಪಟ್ಟ /ವ್ಯಾಖ್ಯಾನ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + नि + असु (क्षेपणे) - "क्तः" (३-२-१०२)<br><br>उपन्यस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"इत्युभयलोकाविरुद्धं वचनमुपन्यस्तम्"<br><b>उल्लेखाः - </b>मालती० २<br><br>उपन्यस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದಲ್ಲಿ ಇಡಲ್ಪಟ್ಟ /ಸಮೀಪದಲ್ಲಿ ಇರಿಸಲ್ಪಟ್ಟ<br><br>उपन्यस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆಗಾಗಿ ಇಡಲ್ಪಟ್ಟ<br><br>उपन्यस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೂಚಿಸಲ್ಪಟ್ಟ /ಸಲಹೆ ಕೊಡಲ್ಪಟ್ಟ<br><br>

उपन्यास
उपन्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಚನದ ಉಪಕ್ರಮ /ಮಾತಿನ ಪ್ರಾರಂಭ<br><b>निष्पत्तिः - </b>उप + नि + असु (क्षेपणे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"निर्यातः शनकैरलीकवचनोपन्यासमालीजनः"<br><b>उल्लेखाः - </b>अमरु० २७<br><br>उपन्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಚನೆ /ಸಲಹೆ<br><b>प्रयोगाः - </b>"ममापि युष्मद्वचनात्तेन तेनोपन्यासेन भूरिवसुमन्दिरासन्नराजमार्गेण माधवः सञ्चार्यते"<br><b>उल्लेखाः - </b>मालती० १<br><br>उपन्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಖ್ಯಾನ /ಅರ್ಥವಿವರಣೆ /ಭಾಷಣ<br><br>उपन्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಚಾರ /ವಿಮರ್ಶೆ<br><b>प्रयोगाः - </b>"विश्वजन्यमिमं पुण्यमुपन्यासं निबोधत"<br><b>उल्लेखाः - </b>मनु० ९-३१<br><br>उपन्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿಡುವಿಕೆ /ಹತ್ತಿರದಲ್ಲಿರಿಸುವಿಕೆ<br><b>व्युत्पत्तिः - </b>उप समीपे न्यासः<br><br>उपन्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಂಬಿಕೆಯಿಂದ ಒಬ್ಬನಲ್ಲಿ ರಕ್ಷಣೆಗಾಗಿ ದ್ರವ್ಯವನ್ನು ಇಡುವುದು /ಉಪನಿಧಿ<br><br>उपन्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಮುಖಸಂಧಿಯ ಒಂದು ಅಂಗ<br><b>प्रयोगाः - </b>"उपन्यासस्तु कार्याणां ग्रथनम्"<br><b>उल्लेखाः - </b>सा० द० ६-११०<br><br>

उपपति
उपपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಾರಪುರುಷ /ಮಿಂಡ /ವ್ಯಭಿಚಾರಿ<br><b>निष्पत्तिः - </b>(२-२-१८)<br><b>व्युत्पत्तिः - </b>उपमितः पत्या<br><b>प्रयोगाः - </b>"द्रुततरमुपयाति स्रंसमानांशुकोसावुपपतिरिव नीचैः पश्चिमान्तेन चन्द्रः"<br><b>उल्लेखाः - </b>माघ० ११-६५<br><br>

उपपत्ति
उपपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯುಕ್ತಿ /ವಿವೇಚನಾ ಪೂರ್ವಕವಾದ ಮಾತು<br><b>निष्पत्तिः - </b>उप + पद (गतौ) - "क्तिन्" (३-३-९४)<br><b>व्युत्पत्तिः - </b>उपपद्यते<br><b>प्रयोगाः - </b>"उपपत्तिरुदाहृता बलादनुमानेन नचागमः क्षतः"<br><b>उल्लेखाः - </b>किरा० २-२८<br><br>उपपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಮಂಜಸ್ಯ /ಹೊಂದಿಕೆ/ಯುಕ್ತತೆ<br><br>उपपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರಣ<br><b>प्रयोगाः - </b>"प्रियेषु यैः पार्थ विनोपपत्तेर्विचिन्त्यमानैः क्लममेति चेतः"<br><b>उल्लेखाः - </b>किरा० ३-५२<br><br>उपपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಾಯ /ಯುಕ್ತಿ<br><b>प्रयोगाः - </b>"अथोपपत्तिं छलनापरोऽपरामवाप्य शैलूष इवैष भूमिकाम्"<br><b>उल्लेखाः - </b>माघ० १-६९<br><br>उपपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಪ್ತಿ /ಪಡೆಯುವಿಕೆ /ಲಾಭ<br><b>प्रयोगाः - </b>"असंशयं प्राक्तनयोपपत्तेः स्यन्धयप्रीतिमवाप्स्यसि त्वम्"<br><b>उल्लेखाः - </b>रघु० १४-७८<br><br>उपपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಾತ್ಪರ್ಯನಿರ್ಣಯಕ್ಕೆ ಕಾರಣವಾದ ಒಂದು ಲಿಂಗ<br><br>उपपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಿದ್ಧಿ /ಈಡೇರುವಿಕೆ /ಕೈಗೂಡುವಿಕೆ<br><b>प्रयोगाः - </b>"स्वार्थोपपत्तिं प्रति दुर्बलाशस्तमित्यवोचद्वरतन्तुशिष्यः"<br><b>उल्लेखाः - </b>रघु० ५-१२<br><br>उपपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಹಾಯ್ಯ /ಅವಲಂಬನ<br><b>प्रयोगाः - </b>"अपेक्षितान्योन्यबलोपपत्तिभिः"<br><b>उल्लेखाः - </b>किरा० १४-४४<br><br>

उपपत्तिमत्
उपपत्तिमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯುಕ್ತಿಯಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>उपपत्तिरस्यास्ति<br><b>प्रयोगाः - </b>"उपपत्तिमदूर्जिताश्रयं नृपमूचे वचनं वृकोदरः"<br><b>उल्लेखाः - </b>किरा० २-१<br><br>

उपपद
उपपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪದದ ಹಿಂದೆ ಸೇರಿಸಲ್ಪಡುವ ಪದ /ಪದದ ಹಿಂದೆ ಉಚ್ಚರಿಸಲ್ಪಡುವ ಪದ<br><b>व्युत्पत्तिः - </b>उपोच्चारितं पदम्<br><b>प्रयोगाः - </b>"धनुरुपपसमस्मै वेदमभ्यादिदेश"<br><b>उल्लेखाः - </b>किरा० १८-४४<br><br>उपपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಸರಿನ ಜೊತೆಗೆ ಸೇರಿಸಲ್ಪಡುವ ಬಿರುದು /ಗೌರವದ ಪದ<br><b>प्रयोगाः - </b>"कथं निरुपपदमेव चाणक्यमिति, न आर्यचाणक्यमिति"<br><b>उल्लेखाः - </b>मुद्रा० ३<br><br>उपपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮಣ್ಯಣ್ ಇತ್ಯಾದಿ ಸೂತ್ರಗಳಲ್ಲಿ ಸಪ್ತಮ್ಯಂತ ಪದದಿಂದ ವಾಚ್ಯವಾಗುವ ಅರ್ಥವನ್ನು ಬೋಧಿಸುವ ಉಪಪದ ಸಂಜ್ಞೆಯುಳ್ಳ ಪದ<br><br>

उपपदविभक्ति
उपपदविभक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಪದ ಯೋಗದಿಂದ ಬರುವ ವಿಭಕ್ತಿ /ಸಮೀಪದಲ್ಲಿರುವ ಪದದ ಯೋಗದಿಂದ ಬರುವ ವಿಭಕ್ತಿ<br><b>प्रयोगाः - </b>"उपपदविभक्तेर्कारकविभक्तिर्बलीयसी"<br><b>उल्लेखाः - </b>परि० २-३-१६<br><br>

उपपदसमास
उपपदसमास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಪದ ಪದದಲ್ಲಿ ೩ನೆಯ ಅರ್ಥದಲ್ಲಿ ಹೇಳಿರುವ ಉಪಪದಗಳಿಗೆ ಕೃದಂತದೊಡನೆ ಹೇಳುವ ಸಮಾಸ<br><br>

उपपन्न
उपपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಟ್ಟ /ಪಡೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + पद (गतौ) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अतीन्द्रियेष्वप्युपपन्नदर्शनो बभूव भावेषु दिलीपनन्दनः"<br><b>उल्लेखाः - </b>रघु० ३-४१<br><br>उपपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೂಡಿಕೊಂಡಿರುವ /ಒಡಗೂಡಿರುವ<br><b>प्रयोगाः - </b>"बभौ च सा तेन सतां मतेन श्रद्धेव साक्षाद्विधिनोपपन्ना"<br><b>उल्लेखाः - </b>रघु० २-१६<br><br>उपपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಭಾವಸಿದ್ಧವಾದ /ಸಹಜವಾದ<br><b>प्रयोगाः - </b>"सर्वं सखे त्यय्युपपन्नमेतदुभे ममास्त्रे कुलिशं भवांश्च । वज्रं तपोविर्यमहत्सु कुण्ठं त्वं सर्वतोगामि च साधकं च ॥"<br><b>उल्लेखाः - </b>कुमा० ३-१२<br><br>उपपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯೋಗ್ಯವಾದ /ಯುಕ್ತವಾದ /ಅರ್ಹವಾದ<br><b>प्रयोगाः - </b>"उपपन्नमिदमस्मिन् राजनि"<br><b>उल्लेखाः - </b>शाकु० २<br><br>उपपन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೂಡಿರುವ /ತುಂಬಿರುವ /ಪೂರ್ಣವಾಗಿರುವ<br><b>प्रयोगाः - </b>"उपपन्नो गुणैः सर्वैः पुत्रो यस्य तु दत्रिमः । सह तैरेव तद्रिक्थं सम्प्राप्तोऽप्यन्यगोत्रतः ॥"<br><b>उल्लेखाः - </b>मनु० ९-१४१<br><br>

उपपात
उपपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಕಸ್ಮಾತ್ತಾಗಿ ಬರುವುದು /ಅನಿರೀಕ್ಷಿತವಾಗಿ ಬರುವುದು<br><br>उपपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶ /ಪ್ರಳಯ<br><br>उपपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೊಂದರೆ /ಉಪದ್ರವ /ವಿಪತ್ತು<br><b>निष्पत्तिः - </b>उप + पत्लृ (गतौ) - "घञ्" (३-३-१८)<br><br>

उपपातक
उपपातक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾಪಾತಕಕ್ಕೆ ಸಮವಾದ ಪಾಪ /ಮಹಾಪಾತಕಕ್ಕಿಂತಲೂ ಕಡಿಮೆ ಶಿಕ್ಷೆಯುಳ್ಳ ಪಾಪ<br><b>निष्पत्तिः - </b>पत्लृ (गतौ) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>पातयति नरके<br><b>प्रयोगाः - </b>"महापातकतुल्यानि पापान्युक्तानि यानि वै । तानि पातकसञ्ज्ञानि तन्न्यूनमुपपातकम् ॥"<br><br>

उपपातकिन्
उपपातकिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಹಾಪಾತಕಕ್ಕೆ ಸಮವಾದ ಪಾಪವುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>उपपातकमस्यास्ति<br><br>

उपपातिन्
उपपातिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಕಸ್ಮಾತ್ತಾಗಿ ಬಂದ /ಅನಿರೀಕ್ಷಿತವಾಗಿ ಬಂದ<br><b>निष्पत्तिः - </b>उप + पत्लृ (गतौ) - "णिनिः" (३-१-१३४)<br><br>

उपपादक
उपपादक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯುಕ್ತಿಯಿಂದ ಸಮರ್ಥಿಸುವ /ಉಪಪತ್ತಿಯಿಂದ ಕೂಡಿದ<br><br>उपपादक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಂಟುಮಾಡುವ /ಸೃಷ್ಟಿಸುವ<br><b>निष्पत्तिः - </b>उप + पद (गतौ) + णिच् - "ण्वुल्" (३-१-१३३)<br><br>

उपपादन
उपपादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯುಕ್ತಿಯಿಂದ ಸಮರ್ಥನೆ ಮಾಡುವುದು /ಕಾರಣ ತೋರಿಸಿ ಸಾಧನೆ ಮಾಡುವುದು<br><br>उपपादन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಯವನ್ನು ವಿವರಿಸಿ ನಿರ್ಣಯಿಸುವುದು<br><b>निष्पत्तिः - </b>उप + पद (गतौ) + णिच् - "ल्युट्" (३-३-११५)<br><br>

उपपादना
उपपादना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उपपादन ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "युच्" (३-३-१०७)<br><br>

उपपादित
उपपादित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯುಕ್ತಿಯಿಂದ ಸಮರ್ಥಿಸಲ್ಪಟ್ಟ<br><br>उपपादित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿವರಿಸಿ ನಿರ್ಣಯಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + पद (गतौ) + णिच् - "क्तः" (३-२-१०२)<br><br>उपपादित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಲ್ಪಿಸಲ್ಪಟ್ಟ /ಸೃಷ್ಟಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"दिष्ट्या त्वमसि मे धात्रा भीतेनेवोपपादितः"<br><b>उल्लेखाः - </b>रघु० १५-१८<br><br>

उपपादुक
उपपादुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆಗಳು /ದೃಷ್ಟಕಾರಣಗಳಲ್ಲದೆ ಅದೃಷ್ಟಕಾರಣಳಿಂದ ಹುಟ್ಟಿದವರು<br><b>निष्पत्तिः - </b>उप + पद (गतौ) + णिच् - "उकञ्" (३-२-१५५)<br><b>व्युत्पत्तिः - </b>उपपद्यन्ते<br><b>विस्तारः - </b>"दिव्योपदादुका देवाः" - अम० ।<br><br>

उपपाद्य
उपपाद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಪಾದಿಸಲ್ಪಡುವ /ಯುಕ್ತಿಯಿಂದಸಮರ್ಥಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उप + पद (गतौ) + णिच् - "यत्" (३-१-९७)<br><br>उपपाद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿವರಿಸಿ ನಿರ್ಣಯಿಸಲ್ಪಡುವ<br><br>उपपाद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರ್ವಹಿಸಲ್ಪಡಬೇಕಾದ /ಮಾಡಲ್ಪಡಬೇಕಾದ<br><b>प्रयोगाः - </b>"कार्श्यं येन त्यजति विधिना स त्वयैवोपाद्यः"<br><b>उल्लेखाः - </b>मेघ० १-२९<br><br>उपपाद्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯುಕ್ತಿಯಿಂದ ಸಮರ್ಥಿಸಿ /ಕಾರಣ ತೋರಿಸಿ ಸಾಧನೆ ಮಾಡಿ<br><br>उपपाद्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿರ್ಣಯ ಮಾಡಿ<br><b>निष्पत्तिः - </b>उप + पद (गतौ) + णिच् - "ल्यप्" (७-१-३७)<br><br>

उपपुर
उपपुर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಖಾನಗರ /ನಗರದ ಬಡಾವಣೆ<br><b>व्युत्पत्तिः - </b>उप समीपस्थं पुरम्<br><br>

उपपुराण
उपपुराण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಸಮಹರ್ಷಿಪ್ರಣೀತವಾದ ೧೮ ಪುರಾಣಗಳಿಗೆ ಸದೃಶವಾದ ೧೮ ಉಪಪುರಾಣಗಳು<br><br>

उपपुष्पिका
उपपुष्पिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಳಿಕೆ /ಆವಳಿಕೆ<br><b>निष्पत्तिः - </b>सञ्ज्ञायां "कन्"<br><b>व्युत्पत्तिः - </b>उपगता पुष्पमिव विकासभावम् ।<br><b>विस्तारः - </b>"हाफिकाचोपपुष्पिका" - हारा० ।<br><br>

उपप्रदान
उपप्रदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಕೋಚ /ಲಂಚ<br><b>प्रयोगाः - </b>"उपप्रदानैर्माजारोऽहितकृत् प्रार्थ्यते जनैः"<br><b>उल्लेखाः - </b>पञ्चतं० १-९५<br><br>उपप्रदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪ /ಕಾಣಿಕೆ<br><br>उपप्रदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೆರಿಗೆ /ವಸ್ತುಗಳ ಮಾರಾಟ ಮೊದಲಾದುವುಗಳ ಮೇಲೆ ವಿಧಿಸುವ ಸುಂಕ<br><br>उपप्रदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ ಕೊಡುವಿಕೆ<br><br>

उपप्रलोभन
उपप्रलोभन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಸೆ ಹುಟ್ಟಿಸುವುದು /ಮರಳು ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>उप + प्र + लुभ (विमोहने) - "ल्युट्" (३-३-११५)<br><br>उपप्रलोभन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರಳು ಮಾಡಿ ಸ್ವಾಧೀನಪಡಿಸಿಕೊಳ್ಳಲು ಕೊಡುವ ಧನ /ಪುಸಲಾವಣೆಗಾಗಿ ಕೊಡುವ ಲಂಚ<br><b>निष्पत्तिः - </b>उप + प्र + लुभ (विमोहने) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>उपप्रलोभ्यतेऽनेन<br><br>

उपप्लव
उपप्लव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಹು<br><b>निष्पत्तिः - </b>उप + ल्युङ् (गतौ) - "अच्" (३-१-१३४)<br><b>प्रयोगाः - </b>"केतूपप्लवभौममन्दगतयः षष्ठे तृतीये शुभाः"<br><br>उपप्लव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯಚಂದ್ರರ ಗ್ರಹಣ<br><b>प्रयोगाः - </b>"चन्द्रमिवोपप्लवान्मुक्तम्"<br><b>उल्लेखाः - </b>विक्र० १-११<br><br>उपप्लव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೊಂದರೆ /ಹಿಂಸೆ /ಪೀಡೆ<br><b>प्रयोगाः - </b>"उपप्लवाय लोकानां धूमकेतुरिवोत्थितः"<br><b>उल्लेखाः - </b>कुमा० २-३२<br><br>उपप्लव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನಿಷ್ಟವನ್ನು ಸೂಚಿಸುವ ಬಿರುಗಾಳಿ /ಕಾಳ್ಗಿಚ್ಚು<br><b>प्रयोगाः - </b>"कच्चिन्न वाय्वादिरुपप्ल्ववो वः श्रमच्छिदामाश्रमपादपानाम्"<br><b>उल्लेखाः - </b>रघु० ५-६<br><br>उपप्लव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಡ್ಡಿ /ವಿಘ್ನ<br><b>प्रयोगाः - </b>"तौ हि तत्त्वावबोधस्य दुरुच्छेदावुपप्ल्ववौ"<br><b>उल्लेखाः - </b>किरा० ११-२०<br><br>उपप्लव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಷ್ಟ /ವಿಪತ್ತು /ತೊಂದರೆ<br><b>प्रयोगाः - </b>"जीवन् पुनः शश्वदुपप्लवेभ्यः प्रजाः प्रजानाथ पितेव पासि"<br><b>उल्लेखाः - </b>रघु० २-४८<br><b>विस्तारः - </b>"उपप्लवः सैंहिकेये विप्लवोत्पातयोरपि" - मेदि० ।<br><br>उपप्लव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಯ /ಹೆದರಿಕೆ<br><b>प्रयोगाः - </b>"नृपा इवोपप्लविनः परेभ्यो धर्मोत्तरं मध्यममाश्रयन्ते"<br><b>उल्लेखाः - </b>रघु० १३-७<br><br>उपप्लव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇತು<br><b>विस्तारः - </b>"उपप्लवः कचः केतुराश्लेषाभव आहिकः" - हारा० ।<br><br>

उपप्ल्वविन्
उपप्ल्वविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯದಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>उपप्लवोऽस्यास्ति<br><b>प्रयोगाः - </b>"नृपा इवोपप्लविनः परेभ्यो धर्मोत्तरं मध्यममाश्रयन्ते"<br><b>उल्लेखाः - </b>रघु० १३-७<br><br>

उपप्लाव्य
उपप्लाव्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಂಡವರು ಅಜ್ಞಾತವಾಸಾನಂತರ ವಾಸಮಾಡಿದ ಒಂದು ನಗರ<br><b>प्रयोगाः - </b>"राज्ञस्तु वचनं श्रुत्वा धृतराष्ट्रस्य सञ्जयः । उपप्लाव्यं ययौ द्रष्टुं पाण्डवानमितौजसः ॥"<br><b>उल्लेखाः - </b>भा० उद्योग० २३-१<br><br>उपप्लाव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಶ್ಯವಾಗಿ ತೊಂದರೆಪಡಿಸಬೇಕಾದ /ಅವಶ್ಯವಾಗಿ ಪೀಡಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उप + ल्युङ् (गतौ) - "ण्यत्" (३-१-१२५)<br><br>

उपप्लुत
उपप्लुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಂದರೆ ಪಡಿಸಲ್ಪಟ್ಟ /ಪೀಡಿಸಲ್ಪಟ್ಟ /ಹಿಂಸಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + ल्युङ् (गतौ) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"उपप्लुतं पातुमदो मदोद्धतैस्त्वमेव विश्वम्भर विश्वमीशिषे"<br><b>उल्लेखाः - </b>माघ० १-३८<br><br>

उपबन्ध
उपबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೂಡಿಸುವುದು /ಹೆಚ್ಚಿಗೆ ಸೇರಿಸುವುದು<br><b>निष्पत्तिः - </b>उप + बन्ध (बन्धने) - "घञ्" (३-३-१८)<br><br>उपबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಕ್ಕದ ಗಂಟು /ಒಂದು ಗಂಟು ಭದ್ರವಾಗಿ ನಿಲ್ಲಲು ಅದರ ಪಕ್ಕದಲ್ಲಿ ಹಾಕುವ ಮತ್ತೊಂದು ಸಣ್ಣ ಗಂಟು<br><b>व्युत्पत्तिः - </b>उप समीपे बन्धः<br><br>

उपबर्ह
उपबर्ह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆದಿಂಬು<br><b>निष्पत्तिः - </b>बृह (वृद्धौ) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>उपबर्ह्यते<br><br>उपबर्ह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಅದುಮುವುದು/ಜುಲುಮು ಮಾಡುವುದು /ಹಿಂಡುವುದು<br><b>निष्पत्तिः - </b>उप + बर्ह (हिंसायाम्) - "घञ्" (३-३-१८)<br><br>

उपबर्हण
उपबर्हण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>उपबर्ह ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><b>विस्तारः - </b>"उच्छीर्षमुपबर्हणम्" - वैज० ।<br><br>

उपबृंहण
उपबृंहण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚುವುದು /ಅಧಿಕವಾಗುವುದು<br><b>निष्पत्तिः - </b>उप + बृहि (वृद्धौ) - "ल्युट्" (३-३-११५)<br><br>

उपबृंहित
उपबृंहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾದ /ಅಧಿಕವಾದ<br><b>निष्पत्तिः - </b>उप + बृहि (वृद्धौ) - "क्तः" (३-४-७२)<br><br>

उपभुक्त
उपभुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಭವಿಸಲ್ಪಟ್ಟ /ಉಪಯೋಗಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + भुज (पालनाभ्यवहारयोः) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"साफल्यं ययुरमराङ्गनोपभुक्ताः"<br><b>उल्लेखाः - </b>किरा० ७-२८<br><br>उपभुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿನ್ನಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"अर्धोपभुक्तेन बिसेन जायां सम्भावयामास रथाङ्गनामा"<br><b>उल्लेखाः - </b>कुमा० ३-३७<br><br>

उपभुक्ति
उपभुक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಭವಿಸುವಿಕೆ /ಉಪಯೋಗಿಸುವಿಕೆ<br><br>उपभुक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಿನ್ನುವಿಕೆ /ಊಟ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>उप + भुज (पालनाभ्यवहारयोः) - "क्तिन्" (३-३-९४)<br><br>

उपभुञ्जान
उपभुञ्जान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಭವಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उप + भुज (पालनाभ्यवहारयोः) - "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"तपसामुपभुञ्जाना फलान्यपि तपस्विनः"<br><b>उल्लेखाः - </b>कुमा० ६-१०<br><br>

उपभूषण
उपभूषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಡವೆಗೆ ಸಮಾನವಾದ ಘಂಟೆ /ಚಾಮರ /ಛತ್ರಿ ಮುಂತಾದುದು<br><b>व्युत्पत्तिः - </b>उपमितं भूषणेन<br><b>प्रयोगाः - </b>"घण्टाचामरकुम्भादिपात्रोपकरणादिकम् । तद्भूषणान्तरे दद्यात् यस्मात् तत् उपभूषणम् ॥"<br><br>

उपभृत्
उपभृत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರಳೀಮರದ ಒಂದು ಯಜ್ಞಪಾತ್ರೆ /ಯಾಗದಲ್ಲಿ ಹೋಮದ ತುಪ್ಪವನ್ನು ಇಟ್ಟುಕೊಳ್ಳುವ ಪಾತ್ರೆ /ಆಜ್ಯಪಾತ್ರೆ<br><b>निष्पत्तिः - </b>उप + डुभृञ् (धारणपोषणयोः) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>उपबिभर्ति<br><br>

उपभोग
उपभोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಯಾನುಭವ /ಸುಖಪಡುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + भुज (पालनाभ्यवहारयोः) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"न जातु कामः कामानामुपभोगेन शाम्यति"<br><b>उल्लेखाः - </b>मनु० २-९४<br><br>उपभोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಯೋಗಿಸುವಿಕೆ<br><b>प्रयोगाः - </b>"निश्च्यूतश्चरणोपभोगसुलभो लाक्षारसः केनचित्"<br><b>उल्लेखाः - </b>शाकु० ४-४<br><br>उपभोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತ್ರೀಸಂಗಮ /ಸಂಭೋಗ<br><b>प्रयोगाः - </b>"उपस्थितश्चारुवपुस्तदीयं कृत्वोपभोगोत्सुकयेव लक्ष्म्या"<br><b>उल्लेखाः - </b>रघु० १४-२४<br><br>

उपभोगिन्
उपभोगिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಷಯಾನುಭವುಳ್ಳ /ಸುಖವನ್ನು ಅರಿತಿರುವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>उपभोगोऽस्यास्ति<br><br>

उपभोग्य
उपभोग्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಭವಿಸಲುಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>उप + भुज (पालनाभ्यवहारयोः) - "ण्यत्" (३-१-१२४)<br><b>प्रयोगाः - </b>"असूत सा नागवधूपभोग्यं मैनाकमम्भोनिधिवद्धसख्यम्"<br><b>उल्लेखाः - </b>कुमा० १-२०<br><br>

उपभोजिन्
उपभोजिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿನ್ನುವ /ಊಟ ಮಾಡುವ<br><b>निष्पत्तिः - </b>उप + भुज (पालनाभ्यवहारयोः) - "णिनिः" (३-२-७८)<br><b>प्रयोगाः - </b>"उच्छिन्नबलिभिक्षेषु भिन्नकांस्योपभोजिषु"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

उपभोज्य
उपभोज्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿನ್ನಲು ಯೋಗ್ಯವಾದ /ಊಟ ಮಾಡಲು ಅರ್ಹವಾದ<br><b>निष्पत्तिः - </b>उप + भुज (पालनाभ्यवहारयोः) - "ण्यत्" (३-१-१२४)<br><br>

उपमन्त्रण
उपमन्त्रण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಹ್ವಾನ /ಕರೆ<br><b>निष्पत्तिः - </b>उप + मत्रि (गुप्तभाषणे) - "ल्युट्" (३-३-११५)<br><br>उपमन्त्रण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸವಿಮಾತಿನಿಂದ ಬೇಡುವುದು /ಮೃದುವಚನದಿಂದ ಮನವೊಲಿಸುವುದು<br><b>प्रयोगाः - </b>"भासनोपसम्भाषाज्ञानविमत्युपमन्त्रणेषु वदः"<br><b>उल्लेखाः - </b>पा० सू० १-३-४७<br><br>उपमन्त्रण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ ರಹಸ್ಯವಾಗಿ ಮಾತನಾಡುವುದು<br><br>

उपमन्यु
उपमन्यु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧೌಮ್ಯಮಹರ್ಷಿಯ ಒಬ್ಬ ಶಿಷ್ಯ<br><br>

उपमर्द
उपमर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಜ್ಜುವುದು /ತಿಕ್ಕುವುದು<br><b>निष्पत्तिः - </b>उप + मृद (क्षोदे) - "घञ्" (३-३-१८)<br><br>उपमर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಡುವುದು /ಹಿಸುಕುವುದು<br><b>प्रयोगाः - </b>"अन्यासु तावदुपमर्दसहासु भृङ्ग लोलं विनोदय मनः सुमनोलतासु"<br><b>उल्लेखाः - </b>सा० द०<br><br>उपमर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯಗಳ ಹೊಟ್ಟು ಬಿಡಿಸುವುದು<br><br>

उपमर्दन
उपमर्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯಗಳ ಹೊಟ್ಟು ಬಿಡಿಸುವುದು<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

उपमा
उपमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾದೃಶ್ಯ /ಹೋಲಿಕೆ<br><b>निष्पत्तिः - </b>उप + मा (माने) - भावे "अङ्" (३-३-१०६)<br><b>व्युत्पत्तिः - </b>उपमीयते<br><b>प्रयोगाः - </b>"उपमां ययारुणदीधितिभिः परिमृष्टमूर्धनि तमालतरौ"<br><b>उल्लेखाः - </b>किरा० ६-२३<br><br>उपमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಮಾನೋಪಮೇಯಗಳ ಸಾಧಾರಣ ಧರ್ಮ<br><b>निष्पत्तिः - </b>उप + मा - कर० "अङ्" (३-३-१०६)<br><b>व्युत्पत्तिः - </b>उपमीयतेऽनया<br><br>उपमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥಾಲಂಕಾರದ ಭೇದ<br><b>प्रयोगाः - </b>"उपमा यत्र सादृश्यलक्ष्मीरुल्लसति द्वयोः । हंसीव कृष्ण ते कीर्तिः स्वर्गं गामवगाहते ॥"<br><b>उल्लेखाः - </b>चन्द्रा०<br><br>उपमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಮಾನ /ಹೋಲಿಕೆಯ ವಸ್ತು<br><b>प्रयोगाः - </b>"यथा दीपो निवातस्थो नेङ्गते सोपमा स्मृता" । "अपि लङ्घितमध्वानं बुबुधे न बुधोपमः" ॥<br><b>उल्लेखाः - </b>गीता० ६-१९, रघु० १-४७<br><br>

उपमातृ
उपमातृ<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಧಾತ್ರಿ /ದಾದಿ /ಸಾಕು ತಾಯಿ<br><b>व्युत्पत्तिः - </b>उपमिता मात्रा<br><br>उपमातृ<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಯಿಗೆಸಮಾನರಾದ ತಾಯಿಯ ಸಹೋದರಿಯರು, ತಂದೆಯ ಸಹೋದರಿಯರು, ಚಿಕ್ಕಪ್ಪ ದೊಡ್ಡಪ್ಪಂದಿರ ಹೆಂಡತಿಯರು, ಸೋದರಮಾವನ ಹೆಂಡತಿ, ಹೆಂಡತಿಯ ತಾಯಿ ಮತ್ತು ಹಿರಿಯಣ್ಣನ ಹೆಂಡತಿ<br><b>विस्तारः - </b>"मातृष्वसा मातुलानी पितृव्यस्त्री पितृष्वसा । श्वश्रूः पूर्वजपत्नी च मातृतुल्याः प्रकीर्तिताः ॥"<br><br>उपमातृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಲಿಸುವವನು /ಸಾದೃಶ್ಯ ಕೊಡುವವನು<br><b>निष्पत्तिः - </b>उप + माङ् (माने) "तृच्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>उपमाति<br><b>प्रयोगाः - </b>"अस्याधिकस्योपमयोपमाता"<br><b>उल्लेखाः - </b>नैष० ७-१६<br><br>

उपमात्री
उपमात्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೋಲಿಸುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उपमान
उपमान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾದೃಶ್ಯ /ಹೋಲಿಕೆ<br><b>निष्पत्तिः - </b>उप + माङ् (माने) - भावे "ल्युट्" (३-३-११५)<br><br>उपमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಲಿಕೆಯ ವಸ್ತು<br><b>निष्पत्तिः - </b>उप + माङ् (माने) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>उपमीयतेऽनेन<br><b>प्रयोगाः - </b>"उपमानस्यापि सखे प्रत्युपमानं वपुस्तस्याः"<br><b>उल्लेखाः - </b>विक्र० २-३<br><br>उपमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾದೃಶ್ಯಜ್ಞಾನ /ಹೋಲಿಕೆಯಿರುವುದೆಂಬ ತಿಳುವಳಿಕೆ /ಉಪಮಿತಿಗೆಸಾಧನವಾದ ಜ್ಞಾನ /ಪ್ರತ್ಯಕ್ಷಾದಿ ಪ್ರಮಾಣಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"सञ्ज्ञासञ्ज्ञिसम्बन्धिप्रतीतिरुपमानम् । उपमितिकरणमुपमानम्"<br><br>

उपमित
उपमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಲಿಸಲ್ಪಟ್ಟ /ಹೋಲಿಕೆ ಕೊಡಲ್ಪಟ್ಟ ಉಪಮೇಯ<br><b>निष्पत्तिः - </b>उप + माङ् (माने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"उपमितं व्याघ्रादिभिः सामान्याप्रयोगे"<br><b>उल्लेखाः - </b>पा० सू० २-१-५६<br><br>उपमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಮಾನ ಪ್ರಮಾಣದಿಂದ ತಿಳಿಯಲ್ಪಟ್ಟ<br><br>

उपमिति
उपमिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾದೃಶ್ಯ /ಸಾಮ್ಯ /ಹೋಲಿಕೆ<br><b>निष्पत्तिः - </b>उप + माङ् (माने) - भावे "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"कुतः परं भव्यमहो महीयसी तदाननस्योपमितौ दरिद्रता"<br><b>उल्लेखाः - </b>नैष० १-२४<br><br>उपमिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಧಾರಣ ಧರ್ಮ<br><b>निष्पत्तिः - </b>उप + माङ् (माने) - कर० "क्तिन्"<br><br>उपमिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಮಾಲಂಕಾರ<br><br>उपमिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾದೃಶ್ಯಜ್ಞಾನದ ಫಲ /ಸಾದೃಶ್ಯಜ್ಞಾನದಿಂದುಂಟಾಗುವ ಗವಯಾದಿ ಪದಾರ್ಥಜ್ಞಾನ<br><br>

उपमेय
उपमेय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕೃತ /ವರ್ಣ್ಯ /ಪ್ರಸಿದ್ಧವಾದ ಒಂದು ವಸ್ತುವಿನೊಡನೆ ಹೋಲಿಸಲ್ಪಡುವ ವಸ್ತು<br><b>निष्पत्तिः - </b>उप + माङ् (माने) - "यत्" (३-१-९७)<br><b>व्युत्पत्तिः - </b>उपमीयतेऽसौ<br><b>प्रयोगाः - </b>"भूयिष्ठमासीदुपमेयकान्तिर्मयूरप्र्ष्ठाश्रयिणा गुहेन"<br><b>उल्लेखाः - </b>रघु० ६-४<br><br>

उपमेयोपमा
उपमेयोपमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥಾಲಂಕಾರದ ಭೇದ<br><b>प्रयोगाः - </b>"पर्यायेण द्वयोस्तच्चेदुपमेयोपमा मता । धर्मोऽर्थ इव पूर्णश्रीरर्थो धर्म इव त्वयि ॥"<br><b>उल्लेखाः - </b>चन्द्रा०<br><br>

उपयत्
उपयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಬಂದು ಸೇರುವ /ಹತ್ತಿರಕ್ಕೆ ಬರುವ<br><b>निष्पत्तिः - </b>उप + इण् (गतौ) - "शतृ" (३-२-१२४)<br><br>

उपयती
उपयती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಬಂದು ಸೇರುವ /ಹತ್ತಿರಕ್ಕೆ ಬರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><b>प्रयोगाः - </b>"ललिताः सखीरिव बृहज्जघनाः सुरनिम्नगामुपयतीः सरितः"<br><b>उल्लेखाः - </b>किरा० ६-१६<br><br>

उपयन्तृ
उपयन्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿವಾಹ ಮಾಡಿಕೊಳ್ಳುವ ಪತಿ /ಮದುವಣಿಗ /ವರ<br><b>निष्पत्तिः - </b>उप + यम (उपरमे) - "तृच्" (३-१-१३३)<br><b>प्रयोगाः - </b>"अथोपयन्तारमलं समाधिना न रत्नमन्विष्यति मृग्यते हि तत्"<br><b>उल्लेखाः - </b>कुमा० ५-४५<br><br>

उपयम
उपयम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹ /ಮದುವೆ<br><b>निष्पत्तिः - </b>उप + यम (उपरमे) - "अप्" (३-३-६३)<br><b>प्रयोगाः - </b>"कन्यात्वजातोपयमा सलज्जा नवयौवना"<br><b>उल्लेखाः - </b>सा० द०<br><br>उपयम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಕೆ /ಹತೋಟಿ<br><br>उपयम<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಮನ ಸಮೀಪ<br><b>प्रयोगाः - </b>"उपयमं नयतीति मन्ये"<br><b>उल्लेखाः - </b>चं० रा०<br><br>

उपयमन
उपयमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹ /ಮದುವೆ<br><b>निष्पत्तिः - </b>उप + यम (उपरमे) - "ल्युट्" (३-३-११५)<br><br>उपयमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹತೋಟಿಗೆ ತರುವುದು /ನಿರ್ಬಂಧದಲ್ಲಿಡುವುದು<br><br>

उपयाचक
उपयाचक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರಕ್ಕೆ ಬಂದು ಬೇಡುವ /ಸಮೀಪಕ್ಕೆ ಬಂದು ಯಾಚಿಸುವ<br><b>निष्पत्तिः - </b>उप + टु याचृ (याञ्चायाम्) - "ल्युट्" (३-३-११५)<br><br>

उपयाचन
उपयाचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿರಕ್ಕೆ ಬಂದು ಯಾಚಿಸುವುದು /ಸಮೀಪಕ್ಕೆ ಬಂದು ಬೇಡುವುದು<br><br>

उपयाचित
उपयाचित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿರಕ್ಕೆ ಬಂದು ಬೇಡುವುದು<br><b>निष्पत्तिः - </b>उप + टु याचृ (याञ्चायाम्) - "क्तः" (३-३-११४)<br><br>उपयाचित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವರ ಸನ್ನಿಧಿಗೆ ಬಂದು ಪ್ರಾರ್ಥಿಸಿಕೊಳ್ಳುವುದು /ಹರಕೆ<br><br>उपयाचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರಕ್ಕೆ ಬಂದು ಯಾಚಿಸಲ್ಪಟ್ಟ /ಸಮೀಪದಲ್ಲಿ ಪ್ರಾರ್ಥಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"त्वया पुरस्तादुपयाचितो यः सोऽयं वटः श्याम इति प्रतीतः"<br><b>उल्लेखाः - </b>रघु० १३-५३<br><br>उपयाचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟಸಿದ್ಧಿಗಾಗಿ ದೇವತೆಗಳಿಗೆ ಕೊಡುವ ಬಲಿ /ದೇವತೆಗಳಿಗೆ ಅರ್ಪಿಸುವುದಾಗಿ ಹೇಳಿಕೊಂಡ ಪಶು ಮೊದಲಾದುದು<br><b>प्रयोगाः - </b>"उपयाचितदानेन यतो देवा अभीष्टदाः" । "अद्य मया भगवत्याः करालायाः प्रागुपयाचितं स्त्रीरत्नमुपहर्तव्यम्" ।<br><b>उल्लेखाः - </b>पञ्चतं०, मालती० ५<br><br>

उपयाचितक
उपयाचितक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>उपयाचित ಪದದ ಅರ್ಥ<br><b>प्रयोगाः - </b>"कृतविविधदेवतोपयाचितकानि सिद्धायतनानि" ।<br><b>उल्लेखाः - </b>कादं०<br><b>विस्तारः - </b>"यद्दीयते तु देवेभ्यो मनोराज्यस्य सिद्धये । उपयाचितकं दिव्यदोहदं तद्विदुर्बुधाः ॥" - हारा०<br><br>

उपयात
उपयात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರಕ್ಕೆ ಬಂದ<br><b>निष्पत्तिः - </b>उप + या (प्रापणे) - "क्तः" (३-४-७२)<br><br>

उपयान
उपयान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಬರುವುದು /ಹತ್ತಿರಕ್ಕೆ ಬರುವುದು<br><b>निष्पत्तिः - </b>उप + या (प्रापणे) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"हरोपयाने त्वरिता बभूव स्त्रीणां प्रियालोकफलो हि वेषः"<br><b>उल्लेखाः - </b>कुमा० ७-२२<br><br>

उपयाम
उपयाम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹ /ಮದುವೆ<br><b>निष्पत्तिः - </b>उप + यम (उपरमे) - "घञ्" (३-३-१८)<br><br>उपयाम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞದ ಒಂದು ಮರದ ಪಾತ್ರೆ<br><br>

उपयायिन्
उपयायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಿಸುವ /ಹತ್ತಿರಕ್ಕೆ ಬರುವ<br><b>निष्पत्तिः - </b>उप + या (प्रापणे) - "णिनिः" (३-१-१३४)<br><br>

उपयुक्त
उपयुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಯೋಗಿಸಲ್ಪಟ್ಟ /ಅನುಭವಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + युजिर् (येगे) - "क्तः" (३-२-१०२)<br><br>उपयुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಯೋಗಕ್ಕೆ ಬರುವ ಕೆಲಸಕ್ಕೆ ಬರಬಹುದದ<br><br>उपयुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನ್ಯಾಯವಾದ /ಯೋಗ್ಯವಾದ<br><br>

उपयुज्यमान
उपयुज्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಯೋಗಿಸಲ್ಪಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उप + युजिर् (येगे) - कर्म० "शानच्" (३-२-१२४)<br><br>

उपयोग
उपयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಕಾರ /ಕಾರ್ಯಸಿದ್ಧಿಗೆ ಅನುಕೂಲವಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + युजिर् (येगे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"व्रजन्ति विद्याधरसुन्दरीणामनङ्गलेखक्रिययोपभोगम्"<br><b>उल्लेखाः - </b>कुमा० १-७<br><br>उपयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಚರಣೆ /ಕಾರ್ಯಸಿದ್ಧಿಗೆ ಅನುಕೂಲವಾದ ಕೆಲಸ<br><br>उपयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೋಜನ<br><b>प्रयोगाः - </b>"औषधान्नविहाराणामुपयोगं सुखावहम्"<br><br>उपयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಯಮಪೂರ್ವಕವಾದ ವಿದ್ಯಾ ಸ್ವೀಕಾರ<br><b>प्रयोगाः - </b>"आख्यातोपयोगे"<br><b>उल्लेखाः - </b>पा० सू० १-४-२९<br><br>

उपयोगिन्
उपयोगिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯಸಾಧನೆಗೆ ಅನುಕೂಲವಾದ<br><b>निष्पत्तिः - </b>उप + युजिर् (येगे) - "घिनुण्" (३-२-१४२)<br><br>उपयोगिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯೋಜನಕರವಾದ /ಉಪಯುಕ್ತವಾದ /ಕೆಲಸಕ್ಕೆ ಬರುವ<br><br>उपयोगिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನ್ಯಾಯವಾದ /ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>उपयोगोऽस्यास्ति<br><br>उपयोगिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಖಸಾಧನವಾದ ವಸ್ತು<br><b>प्रयोगाः - </b>"अस्ति कन्यारत्नं मे गृह्यतामुपयोगि चेत्"<br><br>

उपरक्त
उपरक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಹುವಿನಿಂದ ಹಿಡಿಯಲ್ಪಟ್ಟ ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>उप + रञ्ज (रागे) - "क्तः" (३-२-१०२)<br><br>उपरक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಹುವಿನಿಂದ ಹಿಡಿಯಲ್ಪಟ್ಟ ಚಂದ್ರ<br><br>उपरक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಹು<br><br>उपरक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಣ್ಣದಿಂದ ಬಳಿಯಲ್ಪಟ್ಟ<br><br>उपरक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಸನದಿಂದ ಪೀಡಿತನಾದ /ದುಃಖಾಕ್ರಾಂತನಾದ<br><b>विस्तारः - </b>"उपरक्तस्तु स्वर्भानौ व्यसनातुरे । राहुग्रह्स्तार्कशशिनोः" - हेम० ।<br><br>उपरक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಪಗೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"द्विषद्द्वेषोपरक्ताङ्गसङ्गिनीः स्वेदविप्रुषः"<br><b>उल्लेखाः - </b>माघ० २-१८<br><br>उपरक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ ಹೊಂದಿದ<br><b>प्रयोगाः - </b>"स्वोपरक्तबुद्धिविषयीकरणम्"<br><br>

उपरक्ष
उपरक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗರಕ್ಷಕ /ಸಮೀಪದಲ್ಲಿದ್ದು ಕಾಪಾಡುವವನು /ಮೈಗಾವಲು<br><b>निष्पत्तिः - </b>उप + रक्ष (पालने) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उपरक्षति<br><br>

उपरक्षण
उपरक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆಗಾಗಿ ಸೈನ್ಯವನ್ನು ನೇಮಿಸುವಿಕೆ /ಪಹರೆ /ಕಾವಲು<br><b>निष्पत्तिः - </b>उप + रक्ष (पालने) - "ल्युट्" (३-३-११५)<br><br>

उपरत
उपरत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸದಿಂದ ವಿಶ್ರಾಂತಿ ಹೊಂದಿದ /ವಿರಾಮ ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>उप + रमु (क्रीडायाम्) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"भयाद्रणादुपरतं मंस्यन्ते त्वां महारथाः"<br><b>उल्लेखाः - </b>गीता० २-३५<br><br>उपरत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೃತಿ ಹೊಂದಿದ<br><br>उपरत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂತು ಹೋದ /ಬಿಡುವು ಹೊಂದಿದ<br><b>प्रयोगाः - </b>"रजस्युपरते साध्वी स्नानेन स्त्री रजस्वला"<br><b>उल्लेखाः - </b>मनु० ५-६६<br><br>उपरत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಪಂಚದಲ್ಲಿ ಬೇಸರ ಹೊಂದಿದ /ಇಹಲೋಕದಲ್ಲಿ ಅಸಹ್ಯ ಬುದ್ಧಿ ಹುಟ್ಟಿದ /ವಿರಕ್ತನಾದ ಸಂನ್ಯಾಸಿ<br><br>

उपरति
उपरति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸದಿಂದ ವಿಶ್ರಾಂತಿ ಹೊಂದುವುದು /ವಿರಾಮ ಹೊಂದುವುದು<br><b>निष्पत्तिः - </b>उप + रमु (क्रीडायाम्) - "क्तिन्" (३-३-९४)<br><br>उपरति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಯಗಳಿಂದ ಮನಸ್ಸನ್ನು ತಡೆಯುವುದು<br><br>उपरति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೃತಿ ಹೊಂದುವುದು<br><br>उपरति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಸೆಯನ್ನು ತೊರೆಯುವುದು /ವೈರಾಗ್ಯ ಹೊಂದುವುದು<br><br>

उपरत्न
उपरत्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಳದರ್ಜೆಯ ರತ್ನ /ರತ್ನಕ್ಕೆ ಸಮಾನವಾದ ರಂಗೂನ್ ವಜ್ರ ಮೊದಲಾದುದು<br><b>प्रयोगाः - </b>"उपरत्नानि काचश्च कर्पूरोऽश्मा तथैव च । मुक्ता शुक्तिस्तथा शङ्ख इत्यादीनि बहून्यपि । गुणा यथैव रत्नानामुपरत्नेषु ते तथा । किन्तु किञ्चित्ततो हीना विशेषोऽयमुदाहृतः ॥"<br><br>

उपरतथ्या
उपरतथ्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕರಸ್ತೆ /ಕಡಿದಾದ ದಾರಿ<br><br>

उपरम
उपरम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>उपरति ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>उप + रमु (क्रीडायाम्) - "घञ्" (३-३-१८)<br><br>

उपरमण
उपरमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶ್ರಾಂತಿ /ವಿರಾಮ<br><br>उपरमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂತುಹೋಗುವುದು /ಬಿಡುವು<br><br>उपरमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೈರಾಗ್ಯ ಹೊಂದುವುದು /ಪ್ರಾಪಂಚಿಕ ಸುಖದಿಂದ ನಿವೃತ್ತಿ ಹೊಂದುವುದು<br><b>निष्पत्तिः - </b>उप + रमु (क्रीडायाम्) - "ल्युट्" (३-३-११५)<br><br>

उपरस
उपरस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾದರಸದಂತಿರುವ ಗಂಧಕ ಮೊದಲಾದುದು<br><b>व्युत्पत्तिः - </b>उपमितो रसेन<br><br>

उपराग
उपराग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯಚಂದ್ರರ ಗ್ರಹಣ /ರಾಹುವು ಸೂರ್ಯ ಚಂದ್ರರನ್ನು ಆಕ್ರಮಿಸುವುದು<br><b>निष्पत्तिः - </b>उप + रञ्ज (रागे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"चन्द्रोपरागं प्रति तु केनापि विप्रलब्धासि" । "उपरागान्ते शशिनः समुपगता रोहिणी योगम्" ।<br><b>उल्लेखाः - </b>मुद्रा० १, शाकु०म्७-२२<br><br>उपराग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆರುಣ್ಯ /ಕೆಂಪು<br><b>प्रयोगाः - </b>"कोपोपरागजनितां तु मुखेन्दुबिम्बे हर्तुं क्षमो यदि परं करुणा मयि स्यात्"<br><b>उल्लेखाः - </b>रत्ना० ३-१४<br><br>उपराग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಹು<br><br>उपराग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವಿನಯ /ಅವಿಧೇಯತೆ<br><br>उपराग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ /ಬೈಗುಳು<br><br>उपराग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಸನ /ದುಃಖ<br><br>उपराग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪದ್ರವ /ತೊಂದರೆ<br><b>प्रयोगाः - </b>"बिभर्षि चाकारमनिर्वृतानां मृणालिनी हैममिवोपरागम्"<br><b>उल्लेखाः - </b>रघु० १६-७<br><b>विस्तारः - </b>"उपरागस्तु पुंसि स्यात् राहुग्रासेऽर्कचन्द्रयोः । दुर्नये ग्रहकल्लोले व्यसनेऽपि निगद्यते" - मेदि० ।<br><br>उपराग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಸ್ತುವಿನ ಗುಣವು ಅದರ ಹತ್ತಿರವಿರುವ ವಸ್ತುವಿನಲ್ಲಿ ಸೇರುವುದು<br><br>

उपराम
उपराम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶ್ರಾಂತಿ /ವಿರಾಮ<br><b>निष्पत्तिः - </b>उप + रमु (क्रीडायाम्) - "घञ्" (३-३-१८)<br><br>उपराम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಡುವು /ನಿಲುಗಡೆ<br><br>

उपराव
उपराव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದ ಶಬ್ದ /ಸಮೀಪದಲ್ಲಾದ ಶಬ್ದ<br><b>व्युत्पत्तिः - </b>उप समीपे रावः<br><br>

उपरि
उपरि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮೇಲುಗಡೆ /ಮೇಲುಭಾಗ<br><br>उपरि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮೇಲುಗಡೆಯಿಂದ /ಮೇಲುಭಾಗದಿಂದ<br><br>उपरि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮೇಲುಗಡೆಯಲ್ಲಿ /ಮೇಲುಭಾಗದಲ್ಲಿ<br><b>निष्पत्तिः - </b>ऊर्ध्व - "रिल्" उपादेशश्च (५-३-३१)<br><b>प्रयोगाः - </b>"त्वय्यासन्ने नयनमुपरिस्पन्दि शङ्के मृगाक्ष्या मीनक्षोभाच्चलकुवलयश्रीतुलामेष्यतीति" । "अवाङ्मुखस्योपरि पुष्पवृष्टिः पपात विद्याधरहस्तमुक्ता" । "उपर्युपरि पश्यन्तः सर्व एव दरिद्रति" । "रामाणामुपरि विवस्वतः स्थितानां नासेदे चरितगुणत्वमातपत्रैः" ।<br><b>उल्लेखाः - </b>मेघ० २-३२, रघु० २-६०, हितो० २-२, किरा० ७-२<br><b>विस्तारः - </b>ऊर्ध्व ಶಬ್ದದ ಪ್ರಥಮಾ, ಪಂಚಮೀ ಮತ್ತು ಸಪ್ತಮೀ ವಿಭಕ್ತಿಗಳ ಎಲ್ಲಾ ಅರ್ಥವನ್ನೂ उपरि ಪದವು ಕೊಡುವುದು. ऊर्ध्वं नगरम् । ऊर्ध्वा वसतिः । ऊर्ध्वात् पुरात् ऊर्ध्वाया वा वसतेरागतः । ऊर्ध्वे नगरे ऊर्ध्वायां वा वसतौ वसति । ಈ ಎಲ್ಲಾ ಅರ್ಥಗಳಲ್ಲೂ उपरि ಪದವು ಪ್ರಯೋಗಿಸಲ್ಪಡುವುದು.<br><br>उपरि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಇದಲ್ಲದೆ /ಇನ್ನೂ ಅಧಿಕವಾಗಿ /ಇನ್ನೂ ಮುಂದೆ<br><b>प्रयोगाः - </b>"शतान्युपरिचैवाष्टौ तथा भूयश्च सप्ततिः"<br><b>उल्लेखाः - </b>भा०<br><br>उपरि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನಂತರ /ಬಳಿಕ /ತರುವಾಯ<br><b>प्रयोगाः - </b>"सर्पिः पीत्वोपरि पयः पिबेत्" । "मुहूर्तादुपरि उपाध्यायश्चेदागच्छेत्" ।<br><b>उल्लेखाः - </b>सुश्रुत०, सि० कौ०<br><br>

उपरिचर
उपरिचर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೇದಿದೇಶದ ವಸುವೆಂಬ ಒಬ್ಬ ರಾಜ<br><br>उपरिचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲುಗಡೆ ಸಂಚರಿಸುವ<br><b>निष्पत्तिः - </b>चर (गतौ) - "टः" (३-२-१६)<br><b>व्युत्पत्तिः - </b>उपरि चरति<br><br>

उपरितन
उपरितन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲುಭಾಗದಲ್ಲಿರುವ /ಮೇಲುಗಡೆಯಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"ट्युल्" तुट् च (४-३-२३)<br><b>व्युत्पत्तिः - </b>उपरि भवः<br><br>

उपरिष्टात्
उपरिष्टात्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>ऊर्ध्वम् - "रिष्टातिल्" उपादेशश्च (५-३-३१)<br><b>प्रयोगाः - </b>"स्फुटतरमुपरिष्टादल्पमूर्तेर्ध्रुवस्य स्फुरति सुरमुनीनां मण्डलं व्यस्तमेतत्"<br><b>उल्लेखाः - </b>माघ० ११-३<br><br>

उपरीतक
उपरीतक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಭೋಗಕಾಲದ ಒಂದು ವಿಧ ಬಂಧ<br><b>प्रयोगाः - </b>"ऊरावेकपादं कृत्वा द्वितीयं स्कन्धसंस्थितम् । नारीं कामयते कामी बन्धः स्यादुपरीतकः ॥"<br><b>उल्लेखाः - </b>रतिमं०<br><br>

उपरुद्ध
उपरुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಯಲ್ಪಟ್ಟ /ಪ್ರತಿಬಂಧಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + रुधिर् (आवरणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अयमतिजठराः प्रकामगुर्वीरलघुविलम्बिपयोधरोपरुद्धाः"<br><b>उल्लेखाः - </b>माघ० ४-२९<br><br>उपरुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಿಸಲ್ಪಟ್ಟ /ಮುತ್ತಿಗೆ ಹಾಕಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"ततः समन्तादुपरुद्धं कुसुमपुरमवलोक्य"<br><b>उल्लेखाः - </b>मुद्रा० २<br><br>उपरुद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಲ್ಪಟ್ಟ /ಹೊದ್ದಿಸಲ್ಪಟ್ಟ<br><br>

उपरूपक
उपरूपक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೃಶ್ಯಕಾವ್ಯಗಳಲ್ಲಿ ಒಂದು ಭೇದ<br><b>व्युत्पत्तिः - </b>उपगतं रूपकं दृश्यकाव्यं सादृश्येन<br><br>

उपरोध
उपरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಡೆ /ಅಡ್ಡಿ<br><b>निष्पत्तिः - </b>उप + रुधिर् (आवरणे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"तपोवननिवासिनामुपरोधो माभूत् । एतावत्येव रथं स्थापय यावदवतरामि"<br><b>उल्लेखाः - </b>शाकु० १<br><br>उपरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೊಂದರೆ /ಉಪದ್ರವ /ಪೀಡೆ<br><br>उपरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಚ್ಚುವಿಕೆ /ಮರೆ ಮಾಚುವಿಕೆ<br><b>प्रयोगाः - </b>"शरत्प्रमृष्टाम्बुधरोपरोधः शशीव पर्याप्तकलो नलिन्याः"<br><b>उल्लेखाः - </b>रघु० ६-४४<br><br>उपरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕ್ರಮಿಸುವಿಕೆ /ಮುತ್ತಿಗೆ ಹಾಕುವಿಕೆ<br><br>

उपरोधक
उपरोधक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಳಗಡೆಯ ಕೋಣೆ /ಒಳಭಾಗದ ಕೊಠಡಿ<br><br>उपरोधक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಡ್ಡಿಪಡಿಸುವ /ತಡೆಯುವ /ವಿಘ್ನವುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>उप + रुधिर् (आवरणे) -"ण्वुल्" (३-१-१३३)<br><br>उपरोधक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚುವ /ಮರೆ ಮಾಡುವ<br><br>उपरोधक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಂದರೆ ಪಡಿಸುವ /ಪೀಡಿಸುವ<br><br>

उपरोधिका
उपरोधिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उपरोधक ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्" (४-१-४)<br><br>

उपरोधन
उपरोधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>उपरोध ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>उप + रुधिर् (आवरणे) - "ल्युट्" (३-३-११५)<br><br>उपरोधन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>उपरोधक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>उप + रुधिर् (आवरणे) - कर्त० "ल्युः" (३-१-१३४)<br><br>

उपरोधिन्
उपरोधिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>उपरोधक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>उप + रुधिर् (आवरणे) - "णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"सुखानि सोऽभुङ्क्त सुखोपरोधि वृत्तं हि राज्ञामुपरुद्धवृत्तम्"<br><b>उल्लेखाः - </b>रघु० १८-१८<br><br>

उपल
उपल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಲು /ಶಿಲೆ /ಬಂಡೆ<br><b>प्रयोगाः - </b>"विततशीकरराशिभिरुच्छ्रितैरुपलरोधविवर्तिभिरम्बुभिः" । "उपलशकलमेतद्भेदकं गोमयानाम्" ।<br><b>उल्लेखाः - </b>किरा० ५-१५, मुद्रा० ३-१५<br><br>उपल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಲೆಬಾಳುವ ಶಿಲೆ /ರತ್ನ /ಮಣಿ<br><b>प्रयोगाः - </b>"दन्तोज्ज्वलासु विमलोपलमेखलान्ताः सद्रत्नचित्रकटकासु बृहन्नितम्बाः"<br><b>उल्लेखाः - </b>माघ० ४-४०<br><br>उपल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರಳು<br><br>

उपला
उपला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಣಚುಕಲ್ಲು<br><br>उपला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಕ್ಕರೆ<br><b>विस्तारः - </b>"उपलो ग्रावरत्नयोः । उपला तु शर्करायाम्" - हेम० ।<br><br>

उपलक्षक
उपलक्षक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೂಚಿಸುವ /ತಿಳಿಸುವ /ತೋರಿಸುವ<br><b>निष्पत्तिः - </b>उप + लक्ष (दर्शनाङ्कनयोः) - "ण्वुल्" (३-१-१३३)<br><br>उपलक्षक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯುವ /ಲಕ್ಷ್ಯವಿಟ್ಟು ನೋಡುವ<br><b>प्रयोगाः - </b>"मेधावी वाक्पटुः प्राज्ञः परिचित्तोपलक्षकः । धीरो यथोक्तवादी च एष दूतो विधीयते ॥"<br><br>

उपलक्षण
उपलक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೋಡುವಿಕೆ /ನೋಡಿ ತಿಳಿದುಕೊಳ್ಳುವಿಕೆ /ಅರಿಯುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + लक्ष (दर्शनाङ्कनयोः) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"वेलोपलक्षणार्थमादिष्टोऽस्मि तत्रभवता प्रवासादुपावृत्तेन काश्यपेन"<br><b>उल्लेखाः - </b>शाकु० ४<br><br>उपलक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಚಿಸುವಿಕೆ /ತೋರಿಸುವಿಕೆ<br><br>उपलक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಜಹತ್ ಸ್ವಾರ್ಥಲಕ್ಷಣೆಯಿಂದ ತನ್ನ ಮತ್ತು ಬೇರೆ ಅರ್ಥಗಳನ್ನು ತಿಳಿಸುವಿಕೆ<br><b>प्रयोगाः - </b>"स्वार्थप्रतिपादकत्वेसति स्वार्थसदृशेतरार्थप्रतिपादकत्वमुपलक्षणत्वम्"<br><br>उपलक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಶೇಷ್ಯವನ್ನು ಕಂಡುಹಿಡಿಯಲು ಬೇಕಾದ ಗುರುತು /ತತ್ಕಾಲದಲ್ಲಿ ಆ ವಿಶೇಷ್ಯದಲ್ಲಿಲ್ಲದಿದ್ದರೂ ಹಿಂದೆ ಒಂದು ಕಾಲದಲ್ಲಿದ್ದ ಅದರ ಸ್ಮರಣೆಯಿಂದ ವಿಶೇಷ್ಯವನ್ನು ಕಂಡುಹಿಡಿಯಬಹುದಾದ ಗುರುತು<br><br>

उपलधिप्रिय
उपलधिप्रिय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಮರೀಮೃಗ<br><b>निष्पत्तिः - </b>पृषो०<br><b>व्युत्पत्तिः - </b>वालधिः प्रियोऽस्य<br><br>

उपलब्ध
उपलब्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಟ್ಟ /ಪಡೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + डुलभष् (प्राप्तौ) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"तस्मिन् गते द्यां सुकृतोपलब्धां तत्सम्भवं शङ्खणमर्णवान्ता"<br><b>उल्लेखाः - </b>रघु० १८-२२<br><br>उपलब्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಪಟ್ಟ /ಅರಿಯಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"प्रवृतावुपलब्धायां तस्याः सम्पातिदर्शनात्"<br><b>उल्लेखाः - </b>रघु० १२-६०<br><br>

उपलब्धवत्
उपलब्धवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿರುವ /ಪಡೆದಿರುವ<br><b>निष्पत्तिः - </b>उप + डुलभष् (प्राप्तौ) - "क्तवतुः" (३-२-१०२)<br><br>उपलब्धवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿದಿರುವ /ಅರಿತಿರುವ<br><br>

उपलब्धवती
उपलब्धवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उपलब्धवत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

उपलब्धार्थ
उपलब्धार्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಪಟ್ಟ ಅರ್ಥವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>उपलब्धोऽर्थो येन<br><br>

उपलब्धार्था
उपलब्धार्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಡೆದ ವಿಷಯವನ್ನು ತಿಳಿಸುವ ಕಥೆ<br><b>विस्तारः - </b>"आअख्यायिकोपलब्धार्था" - अम० ।<br><br>

उपलब्धि
उपलब्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಪ್ತಿ /ಪಡೆಯುವಿಕೆ<br><br>उपलब्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನ /ತಿಳುವಳಿಕೆ<br><b>निष्पत्तिः - </b>उप + डुलभष् (प्राप्तौ) - "क्तिन्" (३-३-९४)<br><br>

उपलब्धृ
उपलब्धृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮ /ಜೀವ<br><br>उपलब्धृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದುವ /ಪಡೆಯುವ<br><b>निष्पत्तिः - </b>उप + डुलभष् (प्राप्तौ) - "तृच्" (३-१-१३३)<br><br>उपलब्धृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯುವ /ಅರಿಯುವ<br><br>

उपलब्ध्री
उपलब्ध्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उपलब्धृ ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उपलभ्य
उपलभ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲು ಯೋಗ್ಯವಾದ /ಪಡೆಯಲು ಅರ್ಹವಾದ<br><b>निष्पत्तिः - </b>उप + डुलभष् (प्राप्तौ) - "ण्यत्" (३-१-१२४)<br><br>उपलभ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲು ಶಕ್ಯವಾದ /ಅರಿಯಬಹುದಾದ<br><br>उपलभ्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿ /ಪಡೆದು<br><br>उपलभ्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅರಿತು /ತಿಳಿದು<br><b>निष्पत्तिः - </b>उप + डुलभष् (प्राप्तौ) - "ल्यप्" (७-१-३७)<br><br>

उपलम्भ
उपलम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಭ /ಪ್ರಾಪ್ತಿ /ಪಡೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + डुलभष् (प्राप्तौ) - "घञ्" (३-३-१८)<br><br>उपलम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂದಿನ ಜ್ಞಾನ /ಅರಿವು /ಅನುಭವ<br><b>प्रयोगाः - </b>"मम हि सम्प्रति प्राक्तनोपलभ्यसम्भावितात्मनः संस्कारस्य"<br><b>उल्लेखाः - </b>मालती० ५<br><br>उपलम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿಳಿದುಕೊಳ್ಳುವುದು /ಅರಿತುಕೊಳ್ಳುವುದು<br><br>

उपलम्भन
उपलम्भन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"चन्द्रं विना तदुपलम्भनहेतुभूतं क्षीरोदमाश्रयति किं तृषितश्चकोरः"<br><b>उल्लेखाः - </b>चं० रा०<br><br>

उपलालन
उपलालन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುದ್ದಾಡುವುದು /ಪ್ರೀತಿಸುವುದು<br><b>निष्पत्तिः - </b>उप + लल (ईप्सायाम्) - "ल्युट्" (३-३-११५)<br><br>

उपलालित
उपलालित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿಸಲ್ಪಟ್ಟ /ಮುದ್ದಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + लल (ईप्सायाम्) - "क्तः" (३-२-१०२)<br><br>

उपलिङ्ग
उपलिङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭವಿಷ್ಯದ ಅನಿಷ್ಟದ ಸೂಚನೆ /ಭೂಕಂಪಮೊದಲಾದ ಉಪದ್ರವ<br><b>विस्तारः - </b>"उपलिङ्गं त्वरिष्टं स्यादजन्यं डिम्बविप्लवौ" - वैज० ।<br><br>

उपलेप
उपलेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಳಿಯುವುದು /ಪೂಸುವುದು<br><b>निष्पत्तिः - </b>उप + लिप (उपदेहे) - "घञ्" (३-३-१८)<br><br>उपलेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಗಣಿಯಿಂದ ಸಾರಿಸುವುದು<br><br>

उपलेपन
उपलेपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಳಿಯುವುದು /ಪೂಸುವುದು<br><b>निष्पत्तिः - </b>उप + लिप (उपदेहे) - "ल्युट्" (३-३-११५)<br><br>उपलेपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಗಣಿಯಿಂದ ಸಾರಿಸುವುದು<br><b>प्रयोगाः - </b>"तत्रैव देवायतने सम्मार्जनोपलेपनमण्डनादिकं कर्म समाज्ञापयति"<br><b>उल्लेखाः - </b>प्अञ्चतं०<br><br>

उपलेपिन्
उपलेपिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಳಿಯುವ /ಪೂಸುವ<br><b>निष्पत्तिः - </b>उप + लिप (उपदेहे) - "णिनिः" (३-२-७८)<br><br>उपलेपिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಗಣಿ ಮೊದಲಾದುವುಗಳಿಂದ ಸಾರಿಸುವ<br><br>

उपलेपिनी
उपलेपिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उपलेपिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उपवक्तृ
उपवक्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾಗದಲ್ಲಿ ಮೇಲ್ವಿಚಾರಣೆಯಲ್ಲಿರುವ ನ್ಯೂನಾತಿರೇಕಗಳನ್ನು ನೋಡಿಕೊಳ್ಳುವ ಋತ್ವಿಕ್ಕು /ಬ್ರಹ್ಮ<br><b>निष्पत्तिः - </b>उप + वच (परिभाषणे) - "तृच्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>उपवक्ति उपविशति उपपश्यति वा<br><br>उपवक्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾಗದಲ್ಲಿ ಸಭೆಯಲ್ಲಿ ಕುಳಿತು ನ್ಯೂನಾತಿಕೇಕದ ವಿಷಯದಲ್ಲಿ ಸಲಹೆ ಕೊಡುವವನು /ಸದಸ್ಯ<br><b>प्रयोगाः - </b>"उपवक्ताऽध्वर्युप्रभृतीनां सर्वेषां कर्मणामनुज्ञानार्थमित्थं प्रणयेत्यादिरूपस्य वाक्यस्य वक्ता सन् ब्रह्मासि सर्वेषां कर्मणामवैकल्यार्थमुपद्रष्टा सदस्यो वासि"<br><b>उल्लेखाः - </b>भा०<br><br>

उपवन
उपवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ಯಾನ /ಕೈತೋಟ<br><b>व्युत्पत्तिः - </b>उपमितं वनेन<br><b>प्रयोगाः - </b>"पाण्डुच्छयोपवनवृतयः केतकैः सूचिभिन्नैः"<br><b>उल्लेखाः - </b>मेघ० १-२३<br><br>उपवन<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅರಣ್ಯದ ಸಮೀಪ<br><br>

उपवर्णन
उपवर्णन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವರವಾಗಿ ಹೇಳುವುದು /ಕೂಲಂಕುಷವಾಗಿ ಸ್ವರೂಪ ಮತ್ತು ಗುಣಗಳನ್ನು ಹೇಳುವುದು<br><b>निष्पत्तिः - </b>उप + वर्ण (वर्णक्रियाविस्तारगुणवचनेषु) - "ल्युट्" (३-३-११५)<br><br>उपवर्णन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಣ್ಣ ಬಳಿಯುವುದು /ಬಣ್ಣ ಹಾಕುವುದು<br><br>

उपवर्तन
उपवर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇಶ /ಜನಪದ<br><br>उपवर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಿಲ್ಲೆ /ಗ್ರಾಮಗಳಸಮುದಾಯ<br><br>उपवर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಮಂಡಲ /ರಾಷ್ಟ್ರ /ನೂರಕ್ಕಿಂತಲೂ ಹೆಚ್ಚಾದ ಗ್ರಾಮಗಳಸಮೂಹ<br><b>विस्तारः - </b>"उपवर्तनमप्यस्मिन् मण्डलं तैः शताधिकैः" - वैज० ।<br><br>उपवर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಲ್ಲೂಕು /ತಹಶೀಲು<br><b>निष्पत्तिः - </b>वृतु (वर्तने) - "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>उपेत्य वर्तन्तेऽत्र<br><b>प्रयोगाः - </b>"तस्योपवर्तनेऽप्येको न श्रुतो गोत्रभित् क्वचित्"<br><b>उल्लेखाः - </b>काशीखं०<br><br>उपवर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯು ಹೊರಳಾಡುವ ಜಾಗ<br><b>विस्तारः - </b>"कर्तनं धूलिलुठितं वर्तनं तूपवर्तनम्" - वैज० ।<br><br>

उपवसथ
उपवसथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಾಮ /ಹಳ್ಳಿ<br><b>निष्पत्तिः - </b>वस (निवासे) - "अथः" (उ० ३-११६)<br><b>व्युत्पत्तिः - </b>उपेत्य वसत्यत्र<br><br>

उपवस्त
उपवस्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪವಾಸ /ಊಟ ಮಾಡದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + वसु (स्तम्भे) - भावे "क्तः" (३-३-११४)<br><br>

उपवस्ति
उपवस्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ /ಆಲಂಬನ<br><b>निष्पत्तिः - </b>उप + वसु (स्तम्भे) - "क्तिन्" (३-३-९४)<br><br>

उपवाक
उपवाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಸ್ಪರ ಸಂಭಾಷಣೆ<br><b>निष्पत्तिः - </b>उप + वच (परिभाषणे) - "घञ्" (३-३-१८)<br><b>व्युत्पत्तिः - </b>उपेत्य वक्ति<br><br>

उपवसत्
उपवसत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಟ ಮಾಡದಿರುವ<br><b>निष्पत्तिः - </b>उप + वस (निवासे) - "शतृ" (३-२-१२४)<br><br>उपवसत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದಲ್ಲಿ ವಾಸ ಮಾಡುತ್ತಿರುವ<br><br>

उपवसन्ती
उपवसन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उपवसत् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

उपवास
उपवास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಊಟಮಾಡದಿರುವುದು<br><b>निष्पत्तिः - </b>उप + वस (निवासे) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"समाचराचारमुपात्तशस्त्रो जपोपवासाभिषवैर्मुनीनाम्"<br><b>उल्लेखाः - </b>किरा० ३-२८<br><br>उपवास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ ವಾಸ ಮಾಡುವಿಕೆ<br><b>व्युत्पत्तिः - </b>उप समीपे वासः<br><br>

उपवासक
उपवासक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪವಾಸ ಮಾಡುವ /ಆಹಾರವನ್ನು ತೆಗೆದುಕೊಳ್ಳದಿರುವ<br><b>निष्पत्तिः - </b>उप + वस (निवासे) - "ण्वुल्" (३-१-१३३)<br><br>

उपवासिन्
उपवासिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪವಾಸ ಮಾಡುವ /ಆಹಾರವನ್ನು ತೆಗೆದುಕೊಳ್ಳದಿರುವ<br><b>निष्पत्तिः - </b>उप + वस (निवासे) - "णिनिः" (३-२-७८)<br><b>प्रयोगाः - </b>"विमानैर्हंससंयुक्तैर्यान्ति मासोपवासिनः"<br><b>उल्लेखाः - </b>भा०<br><br>

उपवाहन
उपवाहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಒಯ್ಯುವುದು /ಹತ್ತಿರಕ್ಕೆ ತರುವುದು<br><b>निष्पत्तिः - </b>उप + वह (प्रापणे)+ णिच् - "ल्युट्" (३-३-११५)<br><br>

उपवाह्य
उपवाह्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನು ಸವಾರಿ ಮಾಡುವ ಆನೆ ಕುದುರೆ ಮೊದಲಾದುದು<br><b>व्युत्पत्तिः - </b>उप उत्कर्षो वाह्यः<br><b>प्रयोगाः - </b>"चन्द्रगुप्तोपवाह्यां चन्द्रलेखाभिधानां नागवशामारुह्य"<br><b>उल्लेखाः - </b>मुद्रा० २<br><b>विस्तारः - </b>"राहवाह्यस्तूपवाह्यः" - कल्पद्रु०<br><br>

उपविद्
उपविद्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಭ /ಪ್ರಾಪ್ತಿ /ಪಡೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + विद्लृ (लाभे) - "क्विप्" (वा० ३-३-९४)<br><br>उपविद्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನ /ತಿಳುವಳಿಕೆ<br><br>उपविद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದುವ /ಪಡೆಯುವ<br><br>उपविद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯುವ /ಅರಿಯುವ<br><br>

उपविष
उपविष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಕ್ಕದ ಹಾಲು<br><br>उपविष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಳ್ಳಿ ಹಾಲು<br><br>उपविष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದತ್ತೂರಿ ಹಾಲು<br><br>उपविष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಣಿಗಿಲೆ<br><br>उपविष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಪಸಿ ಗಿಡ<br><b>विस्तारः - </b>"अर्कक्षीरं स्नुहीक्षीरं तथैव कलिहारिका । धत्तूरः करवीरश्च पञ्च चोपविषाः स्मृताः ॥"<br><br>

उपविषा
उपविषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಬಜೆ<br><br>

उपविष्ट
उपविष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಳಿತುಕೊಂಡಿರುವ<br><b>निष्पत्तिः - </b>उप + विश (प्रवेशने) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"हेतुं तदभ्यागमने परीप्सुः सुखोपविष्टं मुनिमाबभाषे"<br><b>उल्लेखाः - </b>किरा० ३-४<br><br>

उपवीणक
उपवीणक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೀಣೆಯನ್ನು ನುಡಿಸುವವನು<br><b>निष्पत्तिः - </b>उप + वीणा + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>वीणया उपगायति<br><br>

उपवीणित
उपवीणित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೀಣೆಯಿಂದ ಗಾನ ಮಾಡಲ್ಪಟ್ಟ /ವೀಣೆಯಿಂದ ಹಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + वीणा + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अथ स्मराज्ञामवधीर्य धैर्यादूचे स तद्वागुपवीणितोऽपि"<br><b>उल्लेखाः - </b>नैष० ८-५४<br><br>

उपवीत
उपवीत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಜೋಪವೀತ /ಎಡಗಡೆ ಭುಜದ ಮೇಲೂ ಬಲಗಡೆಯ ತೋಳಿನ ಕೆಳಗೂ ಇರುವಂತೆ ಧರಿಸುವ ಯಜ್ಞಸೂತ್ರ<br><b>निष्पत्तिः - </b>उप + अज (गतिक्षेपणयोः) - "क्तः" (३-२-१०२) । वी आदेशः (२-४-५६)<br><b>व्युत्पत्तिः - </b>उपवीयते स्म<br><b>प्रयोगाः - </b>"कृतोपवीतं हिमशुभ्रमुच्चकैर्घनं घनान्ते तडितां गणैरिव"<br><b>उल्लेखाः - </b>माघ० १-७<br><br>

उपवीतिन्
उपवीतिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಜ್ಞಸೂತ್ರ ಧರಿಸಿರುವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>उपवीतमस्यास्ति<br><b>प्रयोगाः - </b>"उपवीतिनमूर्ध्वपुण्ड्रवन्तं त्रिजगत्पुण्यफलं त्रिदण्डहस्तम्"<br><br>

उपवेद
उपवेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇದಕ್ಕೆ ಸಮಾನವಾದ ಆಯುರ್ವೇದ<br><b>विस्तारः - </b>"विधाताथर्वसर्वस्वमायुर्वेदं प्रकाशयन्" - भावप्र०<br><br>उपवेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧನುರ್ವೇದ<br><br>उपवेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಂಧರ್ವವೇದ<br><br>उपवेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಸ್ತ್ರಶಾಸ್ತ್ರ<br><br>

उपवेश
उपवेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಳಿತುಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>उप + विश‍ (प्रवेशने) - भावे "घञ्" (३-३-१८)<br><br>

उपवेशन
उपवेशन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಳಿತುಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"प्रायोपवेशनमतिर्नृपतिर्बभूव"<br><b>उल्लेखाः - </b>रघु० ८-९४<br><br>

उपवेशिन्
उपवेशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಳಿತಿರುವ<br><b>निष्पत्तिः - </b>उप + विश‍ (प्रवेशने) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उपविशति<br><br>

उपवैणव
उपवैणव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತ್ರಿಸಂಧ್ಯಾಕಾಲ /ಹಗಲಿನ ಮೂರು ಸಂಧ್ಯಾಕಾಲಗಳು<br><b>विस्तारः - </b>"पुण्याहमह्नि पुण्योंशस्त्रिसन्ध्यन्तूपवर्णनम्" - वैज० ।<br><br>

उपव्याघ्र
उपव्याघ्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಲಿಯಂತಿರುವ ಒಂದು ಮೃಗ /ಚಿರತೆ<br><b>व्युत्पत्तिः - </b>उपमितो व्याघ्रेण<br><br>उपव्याघ्र<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹುಲಿಯ ಹತ್ತಿರ /ಹುಲಿಯ ಸಮೀಪ<br><b>निष्पत्तिः - </b>सामीप्ये अव्ययी०<br><b>व्युत्पत्तिः - </b>व्याघ्रस्य समीपम्<br><br>

उपशम
उपशम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯ ನಿಗ್ರಹ<br><b>निष्पत्तिः - </b>उप + शमु (उपशमे) - "घञ्" (३-३-१८)<br><br>उपशम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಡಮೆಯಾಗುವಿಕೆ /ಇಳಿಮುಖವಾಗುವಿಕೆ<br><b>प्रयोगाः - </b>"मन्युर्दुःसह एव यात्युपशमं नो सान्त्ववादैः स्फुटम्"<br><b>उल्लेखाः - </b>अमरु० ६<br><br>उपशम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಹನೆ /ತಾಳ್ಮೆ /ಶಾಂತತೆ<br><br>उपशम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಸೆಯು ಕಡಮೆಯಾಗುವಿಕೆ<br><br>

उपशमन
उपशमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>उपशम ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

उपशय
उपशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡಿನಲ್ಲಿ ಮೃಗಗಳು ಬರುವ ದಾರಿಯಲ್ಲಿ ಬೇಡನು ಮರೆಯಾಗಿ ಕುಳಿತುಕೊಳ್ಳುವ ಹಳ್ಳ<br><b>निष्पत्तिः - </b>उप + शीङ् (स्वप्ने) - "अच्" (३-३-५६)<br><b>व्युत्पत्तिः - </b>उपशेतेऽस्मिन्<br><b>प्रयोगाः - </b>"हन्ति नोपशयस्थोऽपि शयालुर्मृगयुर्मृगान्"<br><b>उल्लेखाः - </b>माघ० २-८०<br><br>उपशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ ಮಲಗುವಿಕೆ<br><br>उपशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಸ್ತ /ಕೈ<br><br>उपशय<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೈಯ ಹತ್ತಿರ /ಹಸ್ತದ ಸಮೀಪ<br><br>उपशय<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಔಷಧ ಸೇವನೆಯಿಂದ ವ್ಯಾಧಿಯು ಗುಣಮುಖವಾಗಲು ಕಂಡುಬರುವ ಲಕ್ಷಣ<br><br>

उपशरद
उपशरद<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಶರತ್ಕಾಲದಲ್ಲಿ<br><b>व्युत्पत्तिः - </b>शरदि<br><br>उपशरद<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಶರತ್ಕಾಲದ ಸಮೀಪದಲ್ಲಿ<br><b>व्युत्पत्तिः - </b>शरदः समीपे<br><br>

उपशल्य
उपशल्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಾಮದಸಮೀಪದ ಪ್ರದೇಶ /ಗ್ರಾಮದ ಕೊನೆಯ ಪ್ರದೇಶ<br><b>व्युत्पत्तिः - </b>शल्यमुपगतम्<br><b>प्रयोगाः - </b>"उपशल्यनिविष्टैस्तैश्चतुर्द्वारमुखी बभौ"<br><b>उल्लेखाः - </b>रघु० १५-६०<br><b>विस्तारः - </b>"ग्रामान्तमुपशल्यं स्यात् सीमसीमे स्त्रियामुभे" - अम० ।<br><br>

उपशान्ति
उपशान्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಂತತೆ /ಸಹನೆ<br><b>निष्पत्तिः - </b>उप + शमु (उपशमे) - "क्तिन्" (३-३-९४)<br><br>

उपशाय
उपशाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರದಿಯಿಂದ ನಿದ್ದೆ ಮಾಡುವುದು /ಪಹರೆಯವನು ಸರದಿಯಂತೆ ಬಿಡುಗಡೆ ಹೊಂದಿ ನಿದ್ದೆ ಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + शीङ् (स्वप्ने) - "घञ्" (३-३-१८)<br><br>

उपशायिन्
उपशायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದಲ್ಲಿ ಮಲಗುವ<br><b>निष्पत्तिः - </b>उप + शीङ् (स्वप्ने) - "णिनिः" (३-१-१३४)<br><br>

उपशिष्य
उपशिष्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಶಿಷ್ಯ /ಶಿಷ್ಯನ ಶಿಷ್ಯ<br><b>व्युत्पत्तिः - </b>शिष्यमुपगतः<br><b>प्रयोगाः - </b>"स्वतः प्रमाणं परतः प्रमाणं शुकाङ्गना यत्र समुद्गिरन्ति । शिष्योपशिष्यैरुपगीयमानमवेहि तन्मण्डनमिश्रधाम ॥"<br><b>उल्लेखाः - </b>उद्भ०<br><br>

उपशुन
उपशुन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಯಿಯ ಹತ್ತಿರದ ಸ್ಥಳ<br><b>विस्तारः - </b>"स्याच्छुनः सविधं यत्तत्स्थलं ह्युपशुनं पुनः" - कल्पद्रु०<br><br>उपशुन<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಾಯಿಯಲ್ಲಿ<br><b>व्युत्पत्तिः - </b>शुनि<br><br>उपशुन<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಾಯಿಯ ಹತ್ತಿರದಲ್ಲಿ<br><b>व्युत्पत्तिः - </b>शुनः समीपे<br><br>

उपशुष्यत्
उपशुष्यत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಣಗುತ್ತಿರುವ /ಶುಷ್ಕವಾಗುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उप + शुष (शोषणे) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"नवीकरिष्यत्युपशुष्यदार्द्रः स त्वद्विना मे हृदयं निकारः"<br><b>उल्लेखाः - </b>किरा० ३-४४<br><br>

उपशोभा
उपशोभा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲಂಕರಣ /ಶೃಂಗಾರ<br><b>व्युत्पत्तिः - </b>उपगता शोभाम्<br><b>प्रयोगाः - </b>"विहितोपशोभमुपयाति माधवे नगरं व्यरोचत पताकयेव तत्"<br><b>उल्लेखाः - </b>माघ० १३-३६<br><br>

उपशोभन
उपशोभन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲಂಕರಣ /ಶೃಂಗಾರ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

उपशोषण
उपशोषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಣಗಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + शुष (शोषणे) + णिच् - "ल्युट्" (३-३-११५)<br><br>उपशोषण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಣಗಿಸುವ /ತೇವವನ್ನು ಹೋಗಲಾಡಿಸುವ<br><b>निष्पत्तिः - </b>उप + शुष (शोषणे) + णिच् - "ल्युः" (३-१-१३४)<br><br>उपशोषण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಣಗಿಸುವ ಸಾಧನ<br><b>निष्पत्तिः - </b>कर० "ल्युट्" (३-३-११७)<br><br>

उपशोषयत्
उपशोषयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಣಗಿಸುತ್ತಿರುವ /ತೇವವನ್ನು ಹೋಗಲಾಡಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उप + शुष (शोषणे) + णिच् - "शतृ" (३-२-१२४)<br><br>

उपश्रुत्
उपश्रुत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞ<br><b>निष्पत्तिः - </b>श्रु (श्रवणे) - "क्विप्" (वा० ३-३-९४)<br><b>व्युत्पत्तिः - </b>उपगता श्रुत् यस्मिन्<br><br>

उपश्रुत
उपश्रुत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಗ್ದಾನ /ಭರವಸೆಯ ಮಾತು<br><br>उपश्रुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಗ್ದಾನ ಮಾಡಲ್ಪಟ್ಟ /ಭರವಸೆ ಕೊಡಲ್ಪಟ್ಟ<br><br>उपश्रुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕರಿಸಲ್ಪಟ್ಟ /ಒಪ್ಪಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + श्रु (श्रवणे) - कर्म० "क्तः" (३-२-१०२)<br><b>विस्तारः - </b>"वर्णितगीर्णौ च तथा सङ्गीर्णोपश्रुतौ प्रतिज्ञाते" - वैज० ।<br><br>

उपश्रुति
उपश्रुति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ ಕೇಳುವಿಕೆ /ಹತ್ತಿರದಲ್ಲಿ ಕಿವಿಗೊಟ್ಟು ಆಲೈಸುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + श्रु (श्रवणे) - "क्तिन्" (३-३-९४)<br><br>उपश्रुति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾತ್ರಿವೇಳೆಯಲ್ಲಿ ಹೊರಕ್ಕೆ ಬಂದು ಕೇಳುವ ಶುಭಾಶುಭ ಸೂಚಕವಾದ ದೇವವಾಣಿ<br><b>प्रयोगाः - </b>"परिजनोऽपि सततमुपश्रुत्यै निर्जगाम"<br><b>उल्लेखाः - </b>कादं०<br><b>विस्तारः - </b>"नक्तं निर्गत्य यत्किञ्चिच्छुभाशुभकरं वचः । श्रूयते तद्विदुर्धीराः देवप्रश्नमुपश्रुतिम् ॥" - हारा० ।<br><br>उपश्रुति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಗ್ದಾನ /ಭರವಸೆಯ ಮಾತು<br><br>उपश्रुति<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕಿವಿಯ ಸಮೀಪದಲ್ಲಿ /ಕಿವಿಯ ಹತ್ತಿರ<br><br>

उपश्लिष्ट
उपश्लिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಲಿಂಗಿಸಲ್ಪಟ್ಟ /ಅಪ್ಪಿಕೊಳ್ಳಲ್ಪಟ್ಟ<br><br>उपश्लिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪ ಸಂಬಂಧ ಹೊಂದಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + श्लिष (आलिङ्गने) - "क्तः" (३-२-१०२)<br><br>

उपश्लेष
उपश्लेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪ ಸಂಬಂಧ /ಸಾನ್ನಿಧ್ಯ /ಅಕ್ಕಪಕ್ಕದಲ್ಲಿರುವುದು<br><b>निष्पत्तिः - </b>उप + श्लिष (आलिङ्गने) - "घञ्" (३-३-१८)<br><br>

उपश्लेषण
उपश्लेषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಲಿಂಗನ /ತೆಕ್ಕೆ /ಅಪ್ಪಿಕೊಳ್ಳುವಿಕೆ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

उपश्लोकन
उपश्लोकन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತೋತ್ರ ಮಾಡುವುದು /ಕೊಂಡಾಡುವುದು /ಹೊಗಳುವುದು<br><b>निष्पत्तिः - </b>उप + श्लोक +णिच् - उपश्लोकि (नामधातु) - "ल्युट्" (३-३-११५)<br><b>व्युत्पत्तिः - </b>श्लोकैरुपस्तौति<br><br>

उपश्लोकयत्
उपश्लोकयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಗಳುವ /ಸ್ತೋತ್ರ ಮಾಡುವ /ಕೊಂಡಾಡುವ<br><b>निष्पत्तिः - </b>उपश्लोकि (नामधातु) - "शतृ" (३-२-१२४)<br><br>

उपश्लोकयितव्य
उपश्लोकयितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಗಳಲ್ಪಡುವ /ಕೊಂಡಾಡಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उपश्लोकि (नामधातु) - "तव्यः" (३-१-९६)<br><b>प्रयोगाः - </b>"चन्द्रगुप्तः त्वया समुत्तेजनसमर्थैः श्लोकैरुअपश्लोकयितव्यः"<br><b>उल्लेखाः - </b>मुद्रा० २<br><br>

उपश्लोकित
उपश्लोकित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಗಳಲ್ಪಟ್ಟ /ಕೊಂಡಾಡಲ್ಪಟ್ಟ<br><br>

उपष्टम्भ
उपष्टम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಲಂಬನ /ಆಶ್ರಯ<br><b>निष्पत्तिः - </b>उप + स्तम्भु (रोधने) - "घञ्" (३-३-१८)<br><br>उपष्टम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಧಾರ /ಊರುಗೋಲು<br><br>उपष्टम्भ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಹಾಯ /ಒತ್ತಾಸೆ<br><br>उपष्टम्भ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೋತ್ಸಾಹ<br><br>

उपष्टम्भक
उपष्टम्भक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>उपष्टम्भ ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><br>उपष्टम्भक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಧಿಕ್ಯ /ಅತಿಶಯ<br><br>उपष्टम्भक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಧಾರ /ಆಸರೆ<br><br>उपष्टम्भक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಸರೆಯಾಗಿರುವ /ಒತ್ತಾಸೆಯಾಗಿರುವ /ಆಶ್ರಯ ಕೊಡುವ<br><b>निष्पत्तिः - </b>उप + स्तम्भु (रोधने) - "ण्वुल्" (३-१-१३३)<br><br>

उपसंयम
उपसंयम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಗತ್ತಿನ ಮಹಾಪ್ರಳಯ/ಪ್ರಪಂಚದ ಕೊನೆ<br><br>उपसंयम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಯಂತ್ರಣ /ನಿಯಮನ /ಅಂಕೆಯಲ್ಲಿಡುವಿಕೆ<br><br>उपसंयम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಧನ /ಕಟ್ಟುವಿಕೆ<br><br>उपसंयम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಸಂಹಾರ /ಹಿಂದಕ್ಕೆ ತೆಗೆದುಕೊಳ್ಳುವುದು<br><br>

उपसंव्यान
उपसंव्यान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಡುವ ಬಟ್ಟೆ /ಕೆಳಗಿನ ವಸ್ತ್ರ<br><b>निष्पत्तिः - </b>उप + सम् + व्येञ् (तन्तुसन्ताने) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>उपसंवीयते<br><b>विस्तारः - </b>"अन्तरीयोपसंव्यानपरिधानान्यधोंऽशुके" - अम० ।<br><br>

उपसंहार
उपसंहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾಪ್ತಿಗೊಳಿಸುವುದು /ಕೊನೆ ಮುಟ್ಟಿಸುವುದು<br><b>निष्पत्तिः - </b>उप + सम् + हृञ् (हरणे) - "घञ्" (३-३-१८)<br><b>व्युत्पत्तिः - </b>उपसंह्रियते<br><b>प्रयोगाः - </b>"उपक्रमोपसंहारौ हेतुस्तात्पर्यनिर्णये"<br><br>उपसंहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂದಕ್ಕೆ ಎಳೆದುಕೊಳ್ಳುವುದು /ಸಂಕೋಚ ಮಾಡಿಕೊಳ್ಳುವುದು<br><br>उपसंहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಟ್ಟ ಬಾಣವನ್ನು ಹಿಂದಕ್ಕೆ ಎಳೆದುಕೊಳ್ಳುವುದು<br><br>उपसंहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಗ್ರಹಿಸುವುದು /ಸಂಕ್ಷೇಪಗೊಳಿಸುವುದು<br><br>उपसंहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೂಹ /ಗುಂಪು<br><b>विस्तारः - </b>"समास उपसंहारस्समाहारस्समुच्चयः"- वैज० ।<br><br>उपसंहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಗತ್ತಿನ ನಾಶ /ಪ್ರಳಯ<br><br>

उपसंहारिन्
उपसंहारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಸಂಹಾರಗೊಳಿಸುವ /ಕೊನೆಗಾಣಿಸುವ<br><b>निष्पत्तिः - </b>उप + सम् + हृञ् (हरणे) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उपसंहरति<br><br>

उपसंहित
उपसंहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಟ್ಟಿಗೆ ಸೇರಿಕೊಂಡಿರುವ /ಸಂಬಂಧಿಸಿಕೊಂಡಿರುವ<br><b>निष्पत्तिः - </b>उप + सम् + डुधाञ् (धारणपोषणयोः) - "क्तः" (३-४-७२)<br><br>

उपसंहृत
उपसंहृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂದಕ್ಕೆ ಎಳೆದುಕೊಳ್ಳಲ್ಪಟ್ಟ /ಉಪಸಂಹರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + सम् + हृञ् (हरणे) - "क्तः" (३-२-१०२)<br><br>उपसंहृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾಪ್ತಿಗೊಳಿಸಲ್ಪಟ್ಟ /ಉಪಸಂಹರಿಸಲ್ಪಟ್ಟ<br><br>

उपसङ्क्रमण
उपसङ्क्रमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ ಕಲ್ಪಿಸುವಿಕೆ /ಸೇರಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + सम् + क्रमु (पादविक्षेपे) - "ल्युट्" (३-३-११५)<br><br>

उपसङ्ख्यान
उपसङ्ख्यान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಧಿಕವಾಗಿ ಸೇರಿಸುವುದು /ಹಿಂದೆ ಹೇಳಿದುದಕ್ಕಿಂತಲೂ ಹೆಚ್ಚಾಗಿ ಕೂಡಿಸುವುದು<br><b>विस्तारः - </b>ಪಾಣಿನಿ ಸೂತ್ರಗಳಲ್ಲಿ ಹೇಳಿರುವುದಕ್ಕಿಂತಲೂ ಹೆಚ್ಚಿಗೆ ಅಂಶಗಳನ್ನು ಸೇರಿಸಬೇಕೆಂದು ವಾರ್ತಿಕಾಚಾರ್ಯ ಕಾತ್ಯಾಯನರ ವಾಕ್ಯ. "आत्मन्विश्वजनभोगोत्तरपदात् खः" ಎಂಬ ಸೂತ್ರದಲ್ಲಿ ವಿಹಿತವಾದ ख ಪ್ರತ್ಯಯವು पञ्चजन ಪದಕ್ಕೂ ಬರಬೇಕೆಂದು "पञ्चजनादुपसङ्ख्यानम्" ಎಂಬ ವಾರ್ತಿಕದಿಂದ ಹೇಳಿರುವರು. ಹೀಗೆಯೇ "ग्राम्यादीनामुपसङ्ख्यानम्" "आद्यादिभ्य उपसङ्ख्यानम्" ಇತ್ಯಾದಿ.<br><br>

उपसङ्ग्रह
उपसङ्ग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲು ಹಿಡಿದುಕೊಂಡು ಮಾಡುವ ನಮಸ್ಕಾರ<br><b>निष्पत्तिः - </b>उप + सम् + ग्रह (उपादाने) - "अप्" (३-३-५८)<br><b>व्युत्पत्तिः - </b>उपसङ्गृह्येते पादावत्र<br><br>उपसङ्ग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಒಲಿಸಿಕೊಳ್ಳುವಿಕೆ /ತನ್ನ ಕಡೆ ಸೇರಿಸಿಕೊಳ್ಳುವಿಕೆ<br><br>

उपसङ्ग्रहण
उपसङ्ग्रहण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲು ಹಿಡಿದುಕೊಂಡು ಮಾಡುವ ನಮಸ್ಕಾರ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"अभिनवधनुर्विद्यादर्पक्षमाय च कर्मणे स्फुरति रभसात्पाणिः पादोपसङ्ग्रहणाय च" । "व्यत्यस्तपाणिना कार्यमुपसङ्ग्रहणं गुरोः । सव्येन सव्यः स्प्रष्टव्यो दक्षिणेन च दक्षिणः ॥"<br><b>उल्लेखाः - </b>म० वी० २-३०, मनु० २-७२<br><br>

उपसङ्ग्राह्य
उपसङ्ग्राह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಲುಹಿಡಿದು ನಮಸ್ಕರಿಸಲ್ಪಡುವ /ಗೌರವದಿಂದ ನಮಸ್ಕರಿಸಲು ಯೋಗ್ಯನಾದ<br><b>निष्पत्तिः - </b>उप + सम् + ग्रह (उपादाने) - "ण्यत्" (३-१-१२४)<br><b>व्युत्पत्तिः - </b>उपसङ्गृह्यते<br><b>प्रयोगाः - </b>"भ्रातुर्भार्योषसङ्ग्राह्या सवर्णाहन्यहन्यपि । विप्रोष्य तूपसङ्ग्राह्या ज्ञातिसम्बन्धयोषितः ॥"<br><b>उल्लेखाः - </b>मनु० २-१३२<br><br>उपसङ्ग्राह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನ ಕಡೆಗೆ ಸೇರಿಸಿಕೊಳ್ಳಲು ಯೋಗ್ಯನಾದ /ಒಲಿಸಿಕೊಳ್ಳಲು ಅರ್ಹನಾದ<br><br>

उपसत्ति
उपसत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಗ /ಸಮೀಪ ಸಂಬಂಧ<br><b>निष्पत्तिः - </b>उप + षद्लृ (विशरणदौ) - "क्तिन्" (३-३-९४)<br><br>उपसत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಾನ /ಕೊಡುಗೆ<br><br>उपसत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವೆ /ಶುಶ್ರೂಷೆ<br><b>विस्तारः - </b>"उपसत्तिः सङ्गमात्रे प्रतिपादनसेवयोः" - हेम० ।<br><br>

उपसद्
उपसद्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಯಾಗ<br><br>उपसद्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣಾಗ್ನಿ /ಗಾರ್ಹಪತ್ಯ ಆಹವನೀಯಗಳಿಗಿಂತಲೂ ಬೇರೆಯಾದ ಅಗ್ನಿ<br><b>प्रयोगाः - </b>"गार्हपत्यो दक्षिणाग्निः तथैवाहवननीयकः । एतेऽग्नयस्त्रयो मुख्याः शेषाश्चोपसदस्त्रयः ॥"<br><b>उल्लेखाः - </b>अग्निपु०<br><br>उपसद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿರುವ /ಹತ್ತಿರವಿರುವ<br><b>निष्पत्तिः - </b>उप + षद्लृ (विशरणदौ) - "क्विप्" (३-२-७६)<br><br>

उपसदन
उपसदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಹೋಗುವುದು /ಹತ್ತಿರ ಸೇರುವುದು<br><b>निष्पत्तिः - </b>उप + षद्लृ (विशरणदौ) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"तत्रोपसदनं चक्रे द्रोणस्येष्वस्त्रकर्मणि"<br><b>उल्लेखाः - </b>भा०<br><br>उपसदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಚಾರ್ಯನ ಸನ್ನಿಧಿಯಲ್ಲಿ ಶಿಷ್ಯನಾಗಿ ಹೋಗಿ ಸೇರುವಿಕೆ<br><br>उपसदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವೆ /ಶುಶ್ರೂಷೆ<br><br>उपसदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಪ್ತಿ /ಹೊಂದುವಿಕೆ<br><br>उपसदन<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಗೃಹದ ಸಮೀಪ /ಮನೆಯ ಹತ್ತಿರ<br><b>प्रयोगाः - </b>"यज्ञोपसदनं ब्रह्मन् प्राप्तोऽसि मुनिभिः सह"<br><b>उल्लेखाः - </b>रामा०<br><br>

उपसन्धान
उपसन्धान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಟ್ಟಿಗೆ ಸೇರಿಸುವಿಕೆ /ಒಟ್ಟುಗೂಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + सम् + डुधाञ् (धारणपोषणयोः) - "ल्युट्" (३-३-११५)<br><br>

उपसन्न
उपसन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಬಂದಿರುವ<br><br>उपसन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರವಿರುವ<br><b>निष्पत्तिः - </b>उप + षद्लृ (विशरणदौ) - "क्तः" (३-४-७२)<br><br>उपसन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಟ್ಟ /ಸೇವಿಸಲ್ಪಟ್ಟ<br><br>

उपसमाधान
उपसमाधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಶಿ ಹಾಕುವುದು /ಗುಪ್ಪೆ ಹಾಕುವುದು<br><b>निष्पत्तिः - </b>उप + सम् + आ + डुधाञ् (धारणपोषणयोः) - "ल्युट्" (३-३-११५)<br><b>विस्तारः - </b>"उपसमाधानं राशीकरणम्" - सि० कौ० ।<br><br>उपसमाधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ವಲಿಸುವಂತೆ ಮಾಡುವುದು /ಉರಿಯಿಸುವುದು<br><br>

उपसम्पत्ति
उपसम्पत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಸದಾಗಿ ಪ್ರವೇಶಿಸುವುದು /ಮೊದಲಾಗಿ ಕೈ ಹಾಕುವುದು<br><b>व्युत्पत्तिः - </b>प्रथमवैयाकरणः । सम्प्रति व्याकरणमध्येतुं प्रवृत्त इत्यर्थः ।<br><b>प्रयोगाः - </b>"प्रथमोऽचिरोपसम्पत्तौ"<br><b>उल्लेखाः - </b>पा० सू० ६-२-५६<br><br>

उपसम्पन्न
उपसम्पन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇರಿಕೊಂಡಿರುವ /ಕೂಡಿಕೊಂಡಿರುವ<br><br>उपसम्पन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಿಕರಗಳಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ<br><br>उपसम्पन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಕಾದಷ್ಟು ಪ್ರಮಾಣವುಳ್ಳ<br><br>उपसम्पन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾಪ್ತವಾದ /ಹೊಂದಲ್ಪಟ್ಟ<br><br>उपसम्पन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರಣ ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>उप + सम् + पद (गतौ) - कर्त० कर्म० वा "क्तः" (३-४-७२) (३-२-१०२०<br><b>विस्तारः - </b>"उपसम्पन्नं पर्याप्ते संस्कृतप्राप्तयोर्मृते" - हेम० ।<br><br>

उपसम्भाषा
उपसम्भाषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಸ್ಪರ ಮಾತಾಡುವುದು /ಕೂಡುಮಾತು /ಸಂಭಾಷಣೆ<br><b>निष्पत्तिः - </b>उप + सम् + भाष (व्यक्तायां वाचि) - "अः"(३-३-१०३)<br><b>प्रयोगाः - </b>"माधुर्यविस्रम्भविशेषभाजा कृतोपसम्भाषमिवेक्षितेन"<br><b>उल्लेखाः - </b>किरा० ३-३<br><br>उपसम्भाषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮನವೊಲಿಸುವುದು /ಸಮಾಧಾನಪಡಿಸುವಿಕೆ<br><b>प्रयोगाः - </b>"भासनोपसम्भषाज्ञानयत्नविमत्युपमन्त्रणेषु वदः"<br><b>उल्लेखाः - </b>पा० सू० १-३-४७<br><b>विस्तारः - </b>उपसम्भाषा उपसान्त्वनम्<br><br>

उपसर
उपसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಸುಗಳಿಗೆ ಹೋರಿ ಬಿಡುವುದು /ಹಸುವು ಮೊದಲನೆಯ ಬಾರಿ ಗರ್ಭ ಧರಿಸುವುದು<br><b>निष्पत्तिः - </b>उप + सृ (गतौ) - "अप्"(३-३-७१)<br><b>विस्तारः - </b>"प्रजनं प्रथमगर्भग्रहणम् । गवामुपसरः" - सि० कौ० ।<br><br>उपसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಡೆಬಿಡದೆ ಹೊರಡುವುದು /ನಿರಂತರವಾಗಿ ಹೊರಕ್ಕೆ ಬರುತ್ತಿರುವುದು<br><b>प्रयोगाः - </b>"वीनामुपसरं दृष्ट्वा तेऽन्योन्योपहवा गुहाम्"<br><b>उल्लेखाः - </b>भट्टि० ७-६०<br><br>

उपसरण
उपसरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸುಗಳಿಗೆ ಹೋರಿ ಬಿಡುವುದು /ಹಸುವು ಮೊದಲನೆಯ ಬಾರಿ ಗರ್ಭ ಧರಿಸುವುದು<br><b>निष्पत्तिः - </b>उप + सृ (गतौ) - "ल्युट्" (३-३-११५)<br><br>उपसरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಹೋಗುವುದು /ಹತ್ತಿರ ಸೇರುವುದು<br><br>

उपसर्ग
उपसर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗದ ಬದಲಾವಣೆ<br><b>निष्पत्तिः - </b>उप + सृज (विसर्गे) - "घञ्" (३-३-१८)<br><br>उपसर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪದ್ರವ /ಪೀಡೆ /ತೊಂದರೆ<br><b>प्रयोगाः - </b>"सम्यक्पालनलालिताः प्रशमिताशेषोपसर्गाः प्रजाः"<br><b>उल्लेखाः - </b>रत्ना० १-१०<br><br>उपसर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪಾತ /ಶುಭಾಶುಭಫಲಗಳನ್ನು ಸೂಚಿಸುವ ಚಿಹ್ನೆ<br><b>विस्तारः - </b>"अजन्यं क्लीबमुत्पात उपसर्गः समं त्रयम्" - अम० ।<br><br>उपसर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣ ಶಾಸ್ತ್ರದಲ್ಲಿ ಕ್ರಿಯಾಪದಗಳ ಸಂಬಂಧ ಹೊಂದಿ ದ್ಯೋತಕವಾಗುವ ಪ್ರ ಪರಾ ಮೊದಲಾದುವು<br><b>प्रयोगाः - </b>"धात्वर्थं बाधते कश्चित् कश्चित्तमनुवर्तते । तमेव विशिनष्ट्यन्यः उपसर्गगतिस्त्रिधा ॥"<br><br>

उपसर्जन
उपसर्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ರಧಾನ /ಗೌಣ<br><b>निष्पत्तिः - </b>उप + सृज (विसर्गे) - "ल्युट्" (३-३-११३)<br><b>प्रयोगाः - </b>"उपसर्जनं प्रधानस्य धर्मतो नोपपद्यते"<br><b>उल्लेखाः - </b>मनु० ९-१२१<br><b>विस्तारः - </b>"अप्राग्र्यं द्वयहीने द्वे अप्रधानोपसर्जने"- अम० ।<br><br>उपसर्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪಾತ /ಶುಭಾಶುಭಸೂಚಕವಾದ ಚಿಹ್ನೆ<br><b>प्रयोगाः - </b>"निर्घाते भूमिचलने ज्योतिषां चोपसर्जने"<br><b>उल्लेखाः - </b>मनु० ४-१०५<br><br>उपसर्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣಶಾಸ್ತ್ರದಲ್ಲಿ ಗುಣೀಭೂತವಾದ ಪದ /ವಿಶೇಷಣ ಪದ<br><br>

उपसर्जन
उपसर्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾಸವಿಧಾಯಕ ಶಾಸ್ತ್ರದಲ್ಲಿರುವ ಪ್ರಥಮಾ ವಿಭಕ್ತ್ಯಂತ ಪದದಿಂದ ಬೋಧಿಸಲ್ಪಡುವ ಅರ್ಥ<br><b>प्रयोगाः - </b>"प्रथमानिर्दिष्टं समास उपसर्जनम्"<br><b>उल्लेखाः - </b>पा० सू० १-२-४३<br><br>उपसर्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಗ್ರಹವಾಕ್ಯದಲ್ಲಿ ತೋರಿಸಲ್ಪಟ್ಟ ನಿಯತವಿಭಕ್ತಿಯುಳ್ಳ ಶಬ್ದ<br><br>

उपसर्पण
उपसर्पण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿರಕ್ಕೆ ಹೋಗುವುದು /ಸಮೀಪಕ್ಕೆ ಹೋಗುವುದು<br><b>निष्पत्तिः - </b>उप + सृप्लृ (गतौ) - "ल्युट्" (३-३-११५)<br><br>उपसर्पण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಲಿಸಿಕೊಳ್ಳಲು ಅನುಸರಿಸುವುದು<br><br>

उपसर्पिन्
उपसर्पिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರಕ್ಕೆ ಹೋಗುವ /ಸಮೀಪಿಸುವ<br><b>निष्पत्तिः - </b>उप + सृप्लृ (गतौ) - "णिनिः" (३-१-१३४)<br><br>

उपसर्या
उपसर्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ಭಗ್ರಹಣಕ್ಕೆ ಯೋಗ್ಯವಾದ ಹಸು /ಹೋರಿಯನ್ನು ಅಪೇಕ್ಷಿಸುವ ಹಸು<br><b>निष्पत्तिः - </b>उप + सृ (गतौ) - "यत्" (३-१-१०४)<br><br>

उपसार्य
उपसार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಡುವ /ಹೊಂದಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>उप + सृ (गतौ) - "ण्यत्" (३-१-१२४)<br><br>

उपसार्या
उपसार्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಡುವ /ಹೊಂದಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>स्त्रियां रूपम् ।<br><b>प्रयोगाः - </b>"उपसर्या काशी"<br><br>

उपसिक्त
उपसिक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರು ಚಿಮುಕಿಸಲ್ಪಟ್ಟ /ಸಿಂಪಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + षिच (क्षरणे) - "क्तः" (३-२-१०२)<br><br>

उपसिञ्चत्
उपसिञ्चत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಮುಕಿಸುತ್ತಿರುವ /ಸಿಂಪಡಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उप + षिच (क्षरणे) - "शतृ" (३-२-१२४)<br><br>

उपसिञ्चमान
उपसिञ्चमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಮುಕಿಸುತ್ತಿರುವ /ಸಿಂಪಡಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उप + षिच (क्षरणे) - "शानच्" (३-२-१२४)<br><br>

उपसीर
उपसीर<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನೇಗಿಲಿನ ಹತ್ತಿರದಲ್ಲಿ<br><b>व्युत्पत्तिः - </b>सीरस्य समीपे<br><br>उपसीर<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನೇಗಿಲಿನಲ್ಲಿ<br><b>व्युत्पत्तिः - </b>सीरे<br><br>

उपसुन्द
उपसुन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಂದನ ತಮ್ಮ /ನಿಕುಂಭನೆಂಬ ರಾಕ್ಷಸನ ಮಗ<br><b>प्रयोगाः - </b>"सुन्दोपसुन्दौ सहजावभीकौ सुरेष्विव क्वापि सुराङ्गनायाम् । अन्योन्यमाहत्य पुरा यमस्य मनोभवेषोरिव लक्ष्यमास्ताम् ॥"<br><b>उल्लेखाः - </b>चं० भा०<br><br>

उपसूर्यक
उपसूर्यक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ ಚಂದ್ರರ ಪರಿಧಿ /ಸೂರ್ಯಚಂದ್ರರ ಸುತ್ತಲೂ ಕಟ್ಟುವ ಮಂಡಲ<br><b>निष्पत्तिः - </b>"कन्" (५-३-९७)<br><b>व्युत्पत्तिः - </b>उपगतं सूर्यम्<br><br>

उपसृष्ट
उपसृष्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಹು ಕೇತುಗಳಿಂದ ಹಿಡಿಯಲ್ಪಟ್ಟ ಸೂರ್ಯ ಮತ್ತು ಚಂದ್ರ<br><b>निष्पत्तिः - </b>उप + सृज (विसर्गे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"नेक्षेतोद्यन्तमादित्यं नास्तं यन्तं कदाचन । नोपसृष्टं न वारिस्थं न मध्यं नभसो गतम् ॥"<br><b>उल्लेखाः - </b>मनु० ४-३७<br><br>उपसृष्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಥುನ /ಸ್ತ್ರೀಪುರುಷರ ಸಂಬಂಧ<br><b>विस्तारः - </b>"उपसृष्टं त्रिभद्रं च क्रीडारत्नं महासुखम्" - त्रिकाण्ड० ।<br><br>उपसृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮುಕ /ಸ್ತ್ರೀಲೋಲ<br><b>प्रयोगाः - </b>"उपसृष्टा इव क्षुद्राधिष्ठितभवना"<br><b>उल्लेखाः - </b>कादं०<br><br>उपसृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಪ್ತವಾದ /ಕೂಡಿರುವ /ಸಹಿತವಾದ<br><b>प्रयोगाः - </b>"रोगोपसृष्टतनुदुर्वसतिं मुमुक्षुः"<br><b>उल्लेखाः - </b>रघु० ८-९४<br><br>उपसृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೀಡಿಸಲ್ಪಟ್ಟ /ತೊಂದರೆ ಪಡಿಸಲ್ಪಟ್ಟ<br><br>उपसृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರ ಪರಾ ಮೊದಲಾದ ಉಪಸರ್ಗಗಳಿಂದ ಕೂಡಿದ<br><br>

उपसेक
उपसेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ಚಿಮುಕಿಸುವುದು /ಸಿಂಪಡಿಸುವುದು<br><b>निष्पत्तिः - </b>उप + षिच (क्षरणे) - भावे "घञ्" (३-३-१८)<br><br>

उपसेक्तृ
उपसेक्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರು ಚಿಮುಕಿಸುವ /ಸಿಂಪಡಿಸುವ<br><b>निष्पत्तिः - </b>उप + षिच (क्षरणे) - "तृच्" (३-१-१३३)<br><br>

उपसेक्त्री
उपसेक्त्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ಚಿಮುಕಿಸುವ /ಸಿಂಪಡಿಸುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उपसेचक
उपसेचक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರು ಚಿಮುಕಿಸುವ /ಸಿಂಪಡಿಸುವ<br><b>निष्पत्तिः - </b>उप + षिच (क्षरणे) - "ण्वुल्" (३-१-१३३)<br><br>

उपसेचन
उपसेचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ಚಿಮುಕಿಸುವಿಕೆ /ಸಿಂಪಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + षिच (क्षरणे) - "ल्युट्" (३-३-११५)<br><br>उपसेचन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಮುಕಿಸುವ /ಸಿಂಪಡಿಸುವ<br><b>निष्पत्तिः - </b>उप + षिच (क्षरणे) - कर्त० "ल्युः" (३-१-१३४)<br><br>उपसेचन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇಚನ ಸಾಧನ /ನೀರು ಸುರಿಯುವ ಬಿಂದಿಗೆ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>उप + षिच (क्षरणे) - कर्० "ल्युट्" (३-३-११७)<br><br>

उपसेदिवस्
उपसेदिवस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಂದಿರುವ /ಆಗಮಿಸಿರುವ<br><b>निष्पत्तिः - </b>उप + षद्लृ (विशरणादौ) - "क्वसुः" (३-२-१०८)<br><b>प्रयोगाः - </b>"अथावदातं तदहो विडम्बना तथा कथा प्रेष्यतयोपसेदुषः"<br><b>उल्लेखाः - </b>नैष० ९-१०<br><br>

उपसेदुषी
उपसेदुषी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂದಿರುವ /ಆಗಮಿಸಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

उपसेवक
उपसेवक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವೆಯಲ್ಲಿ ಆಸಕ್ತನಾದ /ಶುಶ್ರೂಷೆಯಲ್ಲಿ ನಿರತನಾದ<br><br>उपसेवक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಖಾಭಿಲಾಷೆಯುಳ್ಳ /ಸುಖಾನುಭವದಲ್ಲಿ ನಿರತನಾದ<br><b>निष्पत्तिः - </b>उप + सेवृ (सेवायाम्) - "ण्वुल्" (३-१-१३३)<br><b>प्रयोगाः - </b>"अदत्तादाननिरतः परदारोपसेवकः"<br><b>उल्लेखाः - </b>याज्ञ० ३-१३६<br><br>उपसेवक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದಲ್ಲಿ ಸೇವಿಸುವ<br><br>

उपसेवन
उपसेवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಭಿಚಾರ /ಪರಸ್ತ್ರೀ ಸಂಗಮ<br><b>निष्पत्तिः - </b>उप + सेवृ (सेवायाम्) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"नहीदृशमनायुष्यं लोके किञ्चन विद्यते । यादृशं पुरुषस्येह परदारोपसेवनम् ॥"<br><b>उल्लेखाः - </b>मनु० ४-१३४<br><br>उपसेवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದಲ್ಲಿ ಸೇವಿಸುವಿಕೆ<br><b>प्रयोगाः - </b>"निरताहं सदा सत्ये भर्तॄणामुपसेवने"<br><b>उल्लेखाः - </b>भा० वन०<br><br>उपसेवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಯಾ ಕೆಲಸಗಳಲ್ಲಿ ಹೆಚ್ಚು ಆಸಕ್ತಿ<br><b>प्रयोगाः - </b>"अजीर्णाध्ययनायासविरुद्धान्नोपसेवनात्"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

उपसेवा
उपसेवा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उपसेवन ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>उप + सेवृ (सेवायाम्) - भावे "अः" (३-३-१०३)<br><b>प्रयोगाः - </b>"गोभिरश्वैश्च यानैश्च कृष्या राजोपसेवया" । "अदत्तानामुपादानं हिंसा चैवाविधानतः । परदारोपसेवा च शारीरं त्रिविधं स्मृतम् ॥"<br><b>उल्लेखाः - </b>मनु० ३-६४, मनु० १२-७<br><br>

उपसेविन्
उपसेविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಿಸುವ /ಶುಶ್ರೂಷೆ ಮಾಡುವ<br><b>निष्पत्तिः - </b>उप + सेवृ (सेवायाम्) - "णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"अभिवादनशीलस्य नित्यं वृद्धोपसेविनः । चत्वारि सम्प्रवर्धन्ते आयुर्विद्या यशो बलम् ॥"<br><br>

उपसेविनी
उपसेविनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವಿಸುವ /ಶುಶ್ರೂಷೆ ಮಾಡುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उपस्कर
उपस्कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹೋಪಕರಣ /ಮನೆಗೆ ಬೇಕಾದ ಅಗತ್ಯ ಪದಾರ್ಥಗಳು<br><b>निष्पत्तिः - </b>उप + डुकृञ् (करणे) - "अच्" (३-१-१३४) । सुट् (६-१-१३९)<br><b>प्रयोगाः - </b>"पञ्च सूना गृहस्थस्य चुल्लीपेषण्युपस्करः । कण्डिनी चोपकुम्भश्च बध्यते यास्तु वाहयन् ॥"<br><b>उल्लेखाः - </b>मनु० ३-६८<br><br>उपस्कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಂಜನ /ಸಾಂಬಾರ್ ಪುಡಿ ಚಟ್ನಿ ಮುಂತಾದುದು<br><br>उपस्कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಷಣ /ಒಡವೆ /ಅಲಂಕಾರ<br><br>

उपस्करण
उपस्करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲಂಕರಿಸುವುದು /ಶೃಂಗರಿಸುವುದು<br><b>निष्पत्तिः - </b>उप + डुकृञ् (करणे) - "ल्युट्" (३-३-११५)<br><br>उपस्करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಕಾರ /ಬದಲಾವಣೆ<br><br>उपस्करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪದಗಳ ಅಧ್ಯಾಹಾರ /ಬಿಟ್ಟು ಹೋಗಿರುವ ಪದಗಳನ್ನು ಸೇರಿಸಿಕೊಳ್ಳುವುದು<br><br>उपस्करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೂಹ /ಗುಂಪು /ಸಮುದಾಯ<br><br>उपस्करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸುವಿಕೆ /ನೋಯಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>हिंसने "सुट्"(६-१-१४१)<br><br>उपस्करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸುವ ಸಾಧನ<br><br>उपस्करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲಂಕರಿಸುವ ಒಡವೆ<br><b>निष्पत्तिः - </b>उप + डुकृञ् (करणे) - कर० "ल्युट्" (३-३-११७)<br><br>

उपस्कार
उपस्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಷಣ /ಒಡವೆ /ಅಲಂಕಾರ<br><b>निष्पत्तिः - </b>उप + डुकृञ् (करणे) - "घञ्" (३-३-१८)<br><br>उपस्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೂಹ /ಗುಂಪು /ಸಮುದಾಯ<br><br>उपस्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಧ್ಯಾಹಾರ /ಅವಶ್ಯವಾದ ಪದಗಳನ್ನು ಅರ್ಥಪೂರ್ತಿಗಾಗಿ ಸೇರಿಸಿಕೊಳ್ಳುವುದು<br><b>प्रयोगाः - </b>"साकाङ्क्षमनुपस्कारं विष्वग्गति निराकुलम्"<br><b>उल्लेखाः - </b>किरा० ११-३८<br><br>उपस्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಕಾರ /ಬದಲಾವಣೆ<br><br>उपस्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ವಸ್ತುಗಳನ್ನು ಸೇರಿಸಿ ಗುಣವನ್ನು ಹೆಚ್ಚಿಸುವುದು<br><br>

उपस्कृत
उपस्कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲಂಕರಿಸಲ್ಪಟ್ಟ /ಶೃಂಗರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + डुकृञ् (करणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"उपस्कृता कन्या"<br><br>उपस्कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುಂಪಾಗಿ ಸೇರಿಸಲ್ಪಟ್ಟ /ಒಟ್ಟುಗೂಡಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"उपस्कृता राजानः"<br><br>उपस्कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬದಲಾವಣೆ ಹೊಂದಿದ /ವಿಕಾರ ಹೊಂದಿದ<br><b>प्रयोगाः - </b>"उपस्कृतं भुङ्क्ते"<br><br>उपस्कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧ್ಯಾಹಾರ ಮಾಡಲ್ಪಟ್ಟ /ಹೊಸದಾಗಿ ಸೇರಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"उपस्कृतं ब्रूते"<br><br>उपस्कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಗುಣ ಹೊಂದಿಸಲ್ಪಟ್ಟ<br><br>

उपस्तरण
उपस्तरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹರಡುವುದು /ಹಾಸುವುದು<br><br>उपस्तरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊದಿಸುವುದು /ಮುಚ್ಚುವುದು<br><br>उपस्तरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೆಲವನ್ನು ಸಮನಾಗಿ ಮಾಡುವುದು /ಹಳ್ಳತಿಟ್ಟನ್ನು ಸರಿಪಡಿಸುವುದು<br><b>निष्पत्तिः - </b>उप + स्तॄञ् (आच्छादने) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"पुनर्नवीकृत्य लेपनोपस्तरणैः"<br><b>उल्लेखाः - </b>आश्व० गृ०<br><br>उपस्तरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಸುವ ವಸ್ತು /ಆಧಾರಭೂತವಾದ ಹರಡುವ ಪದಾರ್ಥ<br><b>प्रयोगाः - </b>"अमृतोपस्तरणमसि"<br><br>

उपस्तुत
उपस्तुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದಲ್ಲಿ ಸ್ತೋತ್ರ ಮಾಡಲ್ಪಟ್ಟ /ಹೊಗಳಲ್ಪಟ್ಟ /ಸಮೀಪದಲ್ಲಿ ಕೊಂಡಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + ष्टुञ् (स्तुतौ) - "क्तः" (३-२-१०२)<br><br>

उपस्तुति
उपस्तुति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದಲ್ಲಿ ಮಾಡುವ ಸ್ತೋತ್ರ /ಸಮೀಪದ ಹೊಗಳಿಕೆ<br><b>व्युत्पत्तिः - </b>उप समीपे स्तुतिः<br><br>

उपस्थ
उपस्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುರುಷನ ಜನನೇಂದ್ರಿಯ<br><b>निष्पत्तिः - </b>उप + ष्ठा (गतिनिवृत्तौ) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>उप समीपे तिष्ठति<br><b>प्रयोगाः - </b>"स्नानं मौनोपवासेज्या स्वाध्यायोपस्थनिग्रहः"<br><b>उल्लेखाः - </b>याज्ञ० ३-३१३<br><br>उपस्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯೋನಿ /ಸ್ತ್ರೀಯರ ಜನನೇಂದ್ರಿಯ<br><b>प्रयोगाः - </b>"उपस्थमुदरं जिह्वा हस्तौ पादौ च पञ्चमम् । चक्षुर्नासा च कर्णौ च धनं देहस्तथैव च ॥"<br><b>उल्लेखाः - </b>मनु० ८- १२५<br><br>उपस्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಸಂಗ /ತೊಡೆ<br><br>उपस्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಾನ ದ್ವಾರ<br><b>विस्तारः - </b>"उपस्थः शेफसि क्रोडे तथा मदनमन्दिरे" - मेदि० । "उपस्थो योनिलिङ्गयोः । उत्सङ्गगुदयोश्चापि" - हेम० ।<br><br>उपस्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದಲ್ಲಿರುವ /ಸಮೀಪದಲ್ಲಿರುವ<br><br>

उपस्थातृ
उपस्थातृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಋತ್ವಿಕ್ಕು<br><br>उपस्थातृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಕ /ಆಳು<br><b>निष्पत्तिः - </b>उप + ष्ठा (गतिनिवृत्तौ) - "तृच्" (३-१-१३३)<br><br>उपस्थातृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿನೀತ /ವಿಧೇಯ<br><br>उपस्थातृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಕಾಲದಲ್ಲಿ ಹತ್ತಿರಕ್ಕೆ ಬಂದಿರುವ<br><b>प्रयोगाः - </b>"अन्यवादी क्रियाद्वेषी नोपस्थाता निरुतरः । आहूतप्रपलायी च हीनः पञ्चविधः स्मृतः ॥"<br><br>उपस्थातृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಾಸನೆ ಮಾಡುವ /ಪೂಜಿಸುವ<br><br>

उपस्थान
उपस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಬಂದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + ष्ठा (गतिनिवृत्तौ) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"किमिदं शिष्योपदेशकाले युगपदाचार्ययोरत्रोपस्थानम्"<br><b>उल्लेखाः - </b>माल० १<br><br>उपस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧ್ಯಾನ /ಸ್ಮರಣೆ /ಅನುಸಂಧಾನ<br><b>प्रयोगाः - </b>"तत्त्वस्मृतेरुपस्थानात्सत्त्वयोगात्परिक्षयात्"<br><b>उल्लेखाः - </b>याज्ञ० ३-१६०<br><br>उपस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ /ಉಪಾಸನೆ<br><b>प्रयोगाः - </b>"सूर्योपस्थानं कुर्वः"<br><br>उपस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದ ಜಾಗ /ಸಮೀಪ ಸ್ಥಳ<br><br>उपस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇರುವಿಕೆ /ಕಲೆಯುವಿಕೆ<br><b>विस्तारः - </b>"उपस्थानं तु सङ्गतिः" - वैज० ।<br><br>उपस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಪ್ತಿ /ಹೊಂದುವಿಕೆ<br><br>उपस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಲುಪುವಿಕೆ /ಸೇರುವಿಕೆ<br><br>

उपस्थानीय
उपस्थानीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಿಸಲ್ಪಡುವ /ಸೇವಿಸಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>उप + ष्ठा (गतिनिवृत्तौ) - "अनीयर्" (३-१-९६)<br><br>उपस्थानीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಿಸುವವನು /ಉಪಾಸಕ /ಪೂಜಿಸುವವನು<br><b>निष्पत्तिः - </b>उप + ष्ठा (गतिनिवृत्तौ) - कर्त० "अनीयर्" (३-४-६८)<br><br>

उपस्थापक
उपस्थापक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರಕ್ಕೆ ತರುವ /ಸಮೀಪದಲ್ಲಿಡುವ<br><b>निष्पत्तिः - </b>उप + ष्ठा (गतिनिवृत्तौ) + णिच् - "ण्वुल्" (३-१-१३३)<br><br>उपस्थापक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂದೆ ಅನುಭವಿಸಿದ ಅಥವಾ ನೋಡಿದ ವಿಷಯವನ್ನು ನೆನಪಿಗೆ ತರುವ<br><br>

उपस्थापन
उपस्थापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿರಕ್ಕೆ ತಂದಿಡುವುದು /ಸಮೀಪಕ್ಕೆ ತಲುಪಿಸುವುದು<br><b>निष्पत्तिः - </b>उप + ष्ठा (गतिनिवृत्तौ) - "ल्युट्" (३-३-११५)<br><br>उपस्थापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂದಿದನ್ನು ನೆನಪಿಗೆ ತರುವುದು<br><br>

उपस्थापनीय
उपस्थापनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರಕ್ಕೆ ತಂದಿಡಲ್ಪಡುವ<br><br>उपस्थापनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ತಂದಿಡಲು ಅರ್ಹವಾದ<br><br>उपस्थापनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಮರಣೆಗೆ ತರಲು ಅರ್ಹವಾದ<br><br>उपस्थापनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೆನಪಿಗೆ ತರಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उप + ष्ठा (गतिनिवृत्तौ) + णिच् - "अनीयर्" (३-१-९६)<br><br>

उपस्थित
उपस्थित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಸ್ಥಾನ /ಸೇವನೆ<br><b>निष्पत्तिः - </b>उप + ष्ठा (गतिनिवृत्तौ) - भावे "क्तः" (३-३-११४)<br><br>उपस्थित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸನ್ನಿಹಿತವಾದ /ಹತ್ತಿರಕ್ಕೆ ಬಂದಿರುವ /ಕೊಂಚ ಕಾಲದಲ್ಲೇ ಒದಗಬಹುದಾದ<br><b>निष्पत्तिः - </b>उप + ष्ठा (गतिनिवृत्तौ) - कर्त० "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"अथेप्सितं भर्तुरुपस्थितोदयं सखीजनोद्वीक्षणकौमुदीमुखम्"<br><b>उल्लेखाः - </b>रघु० ३-१<br><br>उपस्थित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಲುಪಿರುವ /ಸೇರಿರುವ<br><b>प्रयोगाः - </b>"अयमपरः कार्यान्तरसचिवोऽस्मानुपस्थितः"<br><b>उल्लेखाः - </b>माल० १<br><br>उपस्थित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿರಕ್ಕೆ ಬಂದಿರುವ /ಸಮೀಪದಲ್ಲಿರುವ<br><b>प्रयोगाः - </b>"हय्यङ्गवीनमादाय घोषवृद्धानुपस्थितान्"<br><b>उल्लेखाः - </b>रघु० १-४५<br><br>उपस्थित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒದಗಿರುವ /ಲಬ್ಧವಾದ /ಪ್ರಾಪ್ತವಾದ<br><b>प्रयोगाः - </b>"अयाचितोपस्थितमम्बु केवलम्"<br><b>उल्लेखाः - </b>कुमा० ५-२२<br><br>उपस्थित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾಪಿಸಿಕೊಳ್ಳಲ್ಪಟ್ಟ /ನೆನಪಿಸಿಕೊಳ್ಳಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"उपस्थितपरित्यागे मानाभावः"<br><br>उपस्थित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವಿಸಲ್ಪಟ್ಟ /ಪೂಜಿಸಲ್ಪಟ್ಟ<br><br>

उपस्थिता
उपस्थिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>೧೧ನೆಯ ಛಂದಸ್ಸಿನ ಒಂದು ವೃತ್ತ<br><b>प्रयोगाः - </b>"त्जौज्गौ गुरुणेयमुपस्थिता स्यात्"<br><b>उल्लेखाः - </b>वृ० र०<br><br>

उपस्थिति
उपस्थिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಮೃತಿ /ನೆನಪು<br><b>निष्पत्तिः - </b>उप + ष्ठा (गतिनिवृत्तौ) - "क्तिन्" (३-३-९४)<br><br>उपस्थिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಿಸುವುದು /ಹತ್ತಿರ ಸೇರುವುದು<br><br>उपस्थिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಲುಪುವುದು /ಹತ್ತಿರ ಸೇರುವುದು<br><br>उपस्थिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವೆ /ಶುಶ್ರೂಷೆ<br><br>उपस्थिति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸನ್ನಿಹಿತವಾಗಿರುವಿಕೆ /ಹತ್ತಿರದಲ್ಲೇ ಒದಗುವಿಕೆ<br><br>

उपस्थेय
उपस्थेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಿಸಲ್ಪಡುವ /ಪೂಜಿಸಲ್ಪಡುವ<br><br>उपस्थेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಿಸಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>उप + ष्ठा (गतिनिवृत्तौ) - "यत्" (३-१-९७)<br><br>

उपस्पर्श
उपस्पर्श<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಚಮನ /ಮಂತ್ರಪೂರ್ವಕ ನೀರನ್ನು ಪ್ರಾಶನಮಾಡಿ ಮುಖ ಮೂಗು ಕಣ್ಣು ಕಿವಿ ಹೊಕ್ಕಳು ಎದೆ ತಲೆ ಭುಜಗಳು ಇವುಗಳನ್ನು ಮುಟ್ಟುವುದು<br><b>प्रयोगाः - </b>"त्रिः प्राश्यापोद्विरुन्मृज्य मुखमेतानुपस्पृशेत् । आस्यनासाक्षिकर्णांश्च नाभिवक्षःशिरोंसकान् ॥"<br><br>उपस्पर्श<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಪರ್ಶ /ಮುಟ್ಟುವುದು<br><br>उपस्पर्श<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ನಾನ<br><b>निष्पत्तिः - </b>उप + स्पृश (संस्पर्शने) - "घञ्" (३-३-१८)<br><b>विस्तारः - </b>"उपस्पर्शः स्पर्शमात्रे स्नानाचमनयोरपि" - मेदि० ।<br><br>

उपस्पर्शन
उपस्पर्शन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>उपस्पर्श ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>उप + स्पृश (संस्पर्शने) - "ल्युट्" (३-३-११५)<br><br>

उपहत
उपहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + हन (हिंसागत्योः) - "क्तः" (३-२-१०२)<br><br>उपहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆದು ನಿಲ್ಲಿಸಲ್ಪಟ್ಟ /ಹೊಡೆದು ಹಿಂದಕ್ಕೆ ತಳ್ಳಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"जलदजालघनैरसिताश्मनामुपहतप्रचयेह मरीचिभिः"<br><b>उल्लेखाः - </b>किरा० ५-४८<br><br>उपहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೂಷಿಸಲ್ಪಟ್ಟ /ಕೆಡಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"किमेभिराशोपहतात्मवृत्तिभिः"<br><b>उल्लेखाः - </b>कुमा० ५-७६<br><br>उपहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಡೆಯಲ್ಪಟ್ಟ /ಪೀಡಿಸಲ್ಪಟ್ಟ /ನೋಯಿಸಲ್ಪಟ್ಟ<br><br>उपहत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾಶಪಡಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"दैवेनोपहतस्य बुद्धिरथवा पूर्वं विपर्यस्यति"<br><b>उल्लेखाः - </b>मुद्रा० ६-८<br><br>

उपहति
उपहति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಡೆತ /ಏಟು<br><b>निष्पत्तिः - </b>उप + हन (हिंसागत्योः) - "क्तिन्" (३-३-९४)<br><br>उपहति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಡ್ಡಿ /ತಡೆ /ವಿಘ್ನ<br><br>उपहति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಲ್ಲುವಿಕೆ /ನಾಶಪಡಿಸುವಿಕೆ<br><br>उपहति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಡಿಸುವಿಕೆ<br><br>

उपहरण
उपहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿರಕ್ಕೆ ತರುವುದು /ಸಮೀಪಕ್ಕೆ ಒಯ್ಯುವುದು<br><b>निष्पत्तिः - </b>उप + हृञ् (हरणे) - "ल्युट्" (३-३-११५)<br><br>उपहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಣಿಕೆಯನ್ನು ಒಪ್ಪಿಸುವುದು /ಮರ್ಯಾದೆ ಸಲ್ಲಿಸುವುದು<br><br>उपहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆಗಳಿಗೆ ಪೂಜೆ ಸಲ್ಲಿಸುವುದು<br><br>उपहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಊಟಕ್ಕೆ ಬಡಿಸುವುದು<br><br>

उपहर्तृ
उपहर्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಟಕ್ಕೆ ಬಡಿಸುವವನು<br><b>निष्पत्तिः - </b>उप + हृञ् (हरणे) - "तृच्" (३-१-१३३)<br><b>प्रयोगाः - </b>"अनुमन्ता विशसिता निहन्ता क्रयविक्रयी । संस्कर्ता चोपहर्ता च खादकश्चेति घातकाः ॥"<br><b>उल्लेखाः - </b>मनु० ५-५१<br><br>उपहर्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಣಿಕೆಯನ್ನು ಒಪ್ಪಿಸುವವನು /ಮರ್ಯಾದೆ ಸಲ್ಲಿಸುವವನು<br><br>उपहर्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರಕ್ಕೆ ತರುವವನು /ಸಮೀಪಕ್ಕೆ ಒಯ್ಯುವವನು<br><br>उपहर्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜೆಸಲ್ಲಿಸುವವನು<br><br>

उपहव
उपहव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಹ್ವಾನ /ಕರೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + ह्वेञ् (तन्तुसन्ताने) - "अप्" (३-३-७२)<br><b>प्रयोगाः - </b>"वीनामुपसरं दृष्ट्वा तेऽन्योन्योपहवा गुहाम्"<br><b>उल्लेखाः - </b>भट्टि० ७-६०<br><br>

उपहसत्
उपहसत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಾಸ್ಯಮಾಡುತ್ತಿರುವ /ನೋಡಿ ನಗುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उप + हसे (हसने) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"हंस्योप्यसौ हंसगतेः सुदत्याः पुरः पुरश्चारु चलन् बभासे । वैलक्ष्यहेतोर्गतिमेतदीयामग्रेऽनुकृत्योपहसन्निवोच्चैः ॥"<br><b>उल्लेखाः - </b>नैष० ३-१०<br><br>

उपहसित
उपहसित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಹಾಸ್ಯ /ಕಾರಣವಿಲ್ಲದೆ ನಗುವಿನಿಂದ ಮಾಡುವ ಗೇಲಿ<br><b>निष्पत्तिः - </b>उप + हसे (हसने) - भावे "क्तः" (३-३-११४)<br><br>उपहसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರಣವಿಲ್ಲದೆ ಗೇಲಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + हसे (हसने) - कर्म० "क्तः" (३-२-१०२)<br><br>

उपहस्त
उपहस्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಯಿಂದ ತೆಗೆದುಕೊಳ್ಳುವುದು<br><br>

उपहस्तिका
उपहस्तिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಂಬೂಲದ ಚೀಲ /ಎಲೆ ಅಡಿಕೆ ಸುಣ್ಣ ಮುಂತಾದುವನ್ನು ಇಟ್ಟುಕೊಳ್ಳುವ ಬಟ್ಟೆಯ ಚೀಲ /ಹಿತ್ತಾಳೆಯ ಅಥವಾ ಬೆಳ್ಳಿಯ ಕೈಪೆಟ್ಟಿಗೆ<br><b>निष्पत्तिः - </b>सञ्ज्ञायां "कन्"<br><b>व्युत्पत्तिः - </b>उपगता हस्तम्<br><b>प्रयोगाः - </b>"उपहस्तिकायाः ताम्बूलं कर्पूरसहितमुद्धृत्य मह्यं दत्वा"<br><b>उल्लेखाः - </b>दशकु०<br><br>

उपहार
उपहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಣಿಕೆಯ ಅರ್ಪಣೆ<br><b>निष्पत्तिः - </b>उप + हृञ् (हरणे) - "घञ्" (३-३-१९)<br><b>प्रयोगाः - </b>"रत्नपुष्पोपहारेण छायामानर्च पादयोः"<br><b>उल्लेखाः - </b>रघु० ४-८४<br><br>उपहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆಗಳಿಗೆ ಕೊಡುವ ಬಲಿ /ದೇವತೆಗಳ ನೈವೇದ್ಯ<br><b>प्रयोगाः - </b>"ततः सपर्यां सपशूपहाराम्"<br><b>उल्लेखाः - </b>रघु० १६-३९<br><br>उपहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೂವು ಮೊದಲಾದುವುಗಳಿಂದ ಮಾಡುವ ಪೂಜೆ<br><b>प्रयोगाः - </b>"भवति विरलभक्तिर्म्लानपुष्पोपहारम्"<br><b>उल्लेखाः - </b>रघु० ५-७४<br><br>उपहार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ ಹಾರವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>उपगतः हारो यस्य<br><b>प्रयोगाः - </b>"उरोभुवा कुम्भयुगेन नवोपहारेण वयस्कृतेन"<br><b>उल्लेखाः - </b>नैष० १-४८<br><br>

उपहास
उपहास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೇಲಿ /ನಿಂದೆಯನ್ನು ಸೂಚಿಸುವ ನಗು<br><b>निष्पत्तिः - </b>उप + हसे (हसने) - भावे "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"फलमस्योपहासस्य सद्यः प्राप्स्यसि पश्य माम्"<br><b>उल्लेखाः - </b>रघु० १२-३७<br><br>

उपहास्य
उपहास्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೇಲಿ ಮಾಡಲ್ಪಡುವ /ನಕ್ಕು ಅಣಕಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उप + हसे (हसने) - कर्म० "ण्यत्" (३-१-१२४)<br><br>

उपहित
उपहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದಲ್ಲಿಡಲ್ಪಟ್ಟ<br><br>उपहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + डुधाञ् (धारणपोषणयोः)- "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"निह्रादिन्युपहितमध्यमस्वरोत्था"<br><b>उल्लेखाः - </b>माल० १-२१<br><br>उपहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೂಡಿರುವ /ಸೇರಿಕೊಂಡಿರುವ<br><b>प्रयोगाः - </b>"विनयोपहितस्त्वया कुतः सदृशोऽन्यो गुणवानविस्मयः"<br><b>उल्लेखाः - </b>माघ० १६-७<br><br>उपहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"पुष्पं प्रवालोपहितं यदि स्यान्मुक्ताफलं वा यदि विद्रुमस्थम्"<br><b>उल्लेखाः - </b>कुमा० १-४४<br><br>

उपहूत
उपहूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + ह्वेञ् (स्पर्धायां शब्दे च) - "क्तः" (३-२-१०२)<br><br>

उपहूति
उपहूति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಹ್ವಾನ /ಕರೆಯುವುದು<br><b>निष्पत्तिः - </b>उप + ह्वेञ् (स्पर्धायां शब्दे च) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"तत्र नित्यविहितोपहूतिषु प्रोषितेषु पतिषु द्युयोषिताम्"<br><b>उल्लेखाः - </b>माघ० १४-३०<br><br>

उपहृत
उपहृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರಕ್ಕೆ ತರಲ್ಪಟ್ಟ /ಕರೆತರಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + हृञ् (हरणे) - "क्तः"(३-२-१०२)<br><b>प्रयोगाः - </b>"प्रियां विकल्पोपहृतां स यावद्दिगीशसन्देशमजल्पदल्पम्"<br><b>उल्लेखाः - </b>नैष० ६-१७<br><br>उपहृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಣಿಕೆಯಾಗಿ ಕೊಡಲ್ಪಟ್ಟ<br><br>उपहृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಪಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"तेनाभिलिख्योपहृतस्वहारा"<br><b>उल्लेखाः - </b>नैष० ६-३७<br><br>उपहृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಲಿ ಕೊಡಲ್ಪಟ್ಟ<br><br>

उपह्वर
उपह्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಹಸ್ಯ ಪ್ರದೇಶ /ಗುಪ್ತವಾದ ಸ್ಥಳ<br><b>निष्पत्तिः - </b>उप + ह्वृ (कौटिल्ये) - "घः" (३-३-११८)<br><b>प्रयोगाः - </b>"उपह्वरे पुनरित्यशिक्षयं घनमित्रम्"<br><b>उल्लेखाः - </b>दशकु०<br><br>उपह्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪ /ಹತ್ತಿರ<br><b>विस्तारः - </b>"रहोऽन्तिकमुपह्वरे" - अम० ।<br><br>

उपह्वान
उपह्वान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಹ್ವಾನ /ಕರೆಯುವುದು<br><b>निष्पत्तिः - </b>उप + ह्वेञ् (स्पर्धायां शब्दे च) - "ल्युट्" (३-३-११५)<br><br>उपह्वान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂತ್ರಪೂರ್ವಕ ದೇವತೆಗಳನ್ನು ಕರೆಯುವುದು<br><br>

उपांशु
उपांशु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೆಲ್ಲಗೆ ಮಾಡುವ ಜಪ /ಉಪಾಸ್ಯ ದೇವತೆಯನ್ನು ಮನಸ್ಸಿನಲ್ಲಿ ಧ್ಯಾನ ಮಾಡುತ್ತ ನಾಲಿಗೆ ತುಟಿಗಳನ್ನು ಮಾತ್ರ ಆಡಿಸುತ್ತಾ ತನಗೆ ಮಾತ್ರ ಕೇಳಿಸುವಂತೆ ಮಾಡುವ ಮಂತ್ರಜಪ<br><b>प्रयोगाः - </b>"जिह्वोष्ठौ चालयेत् किञ्चित् देवतागतमानसः । निजश्रवणयोग्यः स्यादुपांशुः स जपः स्मृतः ॥" "विधियज्ञाज्जपयज्ञो विशिष्टो दशभिर्गुणैः । उपांशुः स्याच्छतगुणः साहस्रो मानसः स्मृतः ॥"<br><b>उल्लेखाः - </b>२) मनु० २-८५<br><br>उपांशु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೌನ /ಮಾತಾಡದಿರುವಿಕೆ<br><br>उपांशु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ರಹಸ್ಯದಲ್ಲಿ /ಅಂತರಂಗವಾಗಿ<br><b>प्रयोगाः - </b>"मुहुरत्रसद्भिरपि यत्र गौरवात् शशलाज्छनांशव उपांशु जघ्निरे"<br><b>उल्लेखाः - </b>माघ० १३-५४<br><br>

उपाकरण
उपाकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಸ್ಕಾರಪೂರ್ವಕ ವೇದಾಧ್ಯಯನ ಮಾಡುವುದು /ಸಂಸ್ಕಾರಪೂರ್ವಕ ಮಾಡುವ ವೇದಸ್ವೀಕಾರ<br><b>निष्पत्तिः - </b>उप + आ + डुकृञ् (करणे) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"अथातोऽध्यायोपाकरणम्"<br><b>उल्लेखाः - </b>आश्व० गृ०<br><br>उपाकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗದಲ್ಲಿ ಮಂತ್ರದಿಂದ ಪಶುವನ್ನು ಪ್ರೋಕ್ಷಿಸುವುದು<br><br>

उपाकर्मन्
उपाकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ /ಉಪಕ್ರಮ<br><br>उपाकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರಾವಣಮಾಸದಲ್ಲಿ ಹೋಮಪೂರ್ವಕ ಮಾಡುವ ವೇದಸ್ವೀಕಾರ<br><b>निष्पत्तिः - </b>उप + आ + डुकृञ् (करणे) - कर० "मनिन्" (उ० ४-१८४)<br><b>प्रयोगाः - </b>"अध्यायानामुपाकर्म श्रावण्यां श्रवणेन वा । हस्तेनौषधिभावे वा पञ्चम्यां श्रावणस्य तु ॥"<br><b>उल्लेखाः - </b>याज्ञ० १-१४२<br><br>

उपाकृत
उपाकृत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗದಲ್ಲಿ ಮಂತ್ರಗಳಿಂದ ಅಭಿಮಂತ್ರಿಸಿ ಕೊಲ್ಲಲ್ಪಟ್ಟ ಪಶು<br><b>निष्पत्तिः - </b>उप + आ + डुकृञ् (करणे) - कर्म० "क्तः" (३-२-१०२)<br><br>उपाकृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗದ ಪಶುವಿನ ಸಂಸ್ಕಾರ<br><br>उपाकृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ /ಉಪಕ್ರಮ<br><br>उपाकृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೇದಾಧ್ಯಯನದ ಪ್ರಾರಂಭ<br><br>उपाकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಂದರೆಪಡಿಸಲ್ಪಟ್ಟ /ಪೀಡಿಸಲ್ಪಟ್ಟ<br><b>विस्तारः - </b>"उपाकृत उपद्रुते । मन्त्रेण प्रोक्षितपशौ" - हेम० ।<br><br>उपाकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭಿಸಲ್ಪಟ್ಟ<br><br>

उपाकृतिन्
उपाकृतिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭಿಸುವವನು /ಉಪಕ್ರಮಿಸುವವನು<br><br>उपाकृतिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇದಾಧ್ಯಯನ ಪ್ರಾರಂಭಿಸುವವನು<br><b>निष्पत्तिः - </b>उपाकृत -"इनिः" (५-२-८८)<br><br>

उपाकृतिनी
उपाकृतिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उपाकृतिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्"(४-१-५)<br><br>

उपाक्ष
उपाक्ष<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯಕ್ಷವಾಗಿ /ಕಣ್ಣಿನ ಎದುರಲ್ಲಿ<br><b>निष्पत्तिः - </b>सामीप्ये अव्ययी०<br><b>व्युत्पत्तिः - </b>अक्ष्णः समीपम्<br><b>विस्तारः - </b>"प्रत्यक्षोपाक्षमध्यक्षम्" - त्रिकाण्ड० ।<br><br>

उपाख्या
उपाख्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯಕ್ಷವಾಗಿರುವಿಕೆ /ಕಣ್ಣಿಗೆ ಗೋಚರವಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + आ +ख्या (प्रकथने) - "अङ्" (३-३-१०६)<br><b>व्युत्पत्तिः - </b>उपाख्यायते उपलभ्यते<br><b>प्रयोगाः - </b>"द्वितीयेचानुपाख्ये"<br><b>उल्लेखाः - </b>पा०सू० ६-३-८०<br><br>उपाख्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾತುಗಳಿಂದ ವಿವರಿಸುವಿಕೆ<br><br>

उपाख्यान
उपाख्यान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂದೆ ನಡೆದ ವಿಷಯವನ್ನಿ ತಿಳಿಸುವಿಕೆ /ಪೂರ್ವಕಥೆಯನ್ನು ಹೇಳುವುದು<br><b>निष्पत्तिः - </b>उप + आ +ख्या (प्रकथने) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"इदं शतसहस्रं तु श्लोकानां पुण्यकर्मणाम् । उपाख्यानैः सह ज्ञेयं श्राव्यं भारतमुत्तमम् ॥"<br><b>उल्लेखाः - </b>भा० आदि० १-७७<br><br>उपाख्यान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇತರರಿಂದ ಕೇಳಿದ ಕಥೆಯನ್ನು ಮತ್ತೆ ಹೇಳುವುದು<br><br>

उपागत
उपागत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರಕ್ಕೆ ಬಂದಿರುವ /ತಲುಪಿರುವ /ಆಗಮಿಸಿರುವ<br><b>निष्पत्तिः - </b>उप + आ + गम्लृ (गतौ) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"दातुं प्रदानोचित भूरिधाम्नीमुपागतः सिद्धिमिवास्मि विद्याम्"<br><b>उल्लेखाः - </b>किरा० ३-२३<br><br>उपागत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಭವಿಸಿದ /ಒದಗಿದ /ಉಂಟಾದ<br><br>उपागत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಪ್ಪಿದ /ಸಮ್ಮತಿಸಿದ<br><br>उपागत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿರುವ /ಪ್ರಾಪ್ತವಾದ<br><b>प्रयोगाः - </b>"संरम्भवेगोज्झितवेदनेषु गात्रेषु बाधिर्यमुपागतेषु"<br><b>उल्लेखाः - </b>किरा० १७-४९<br><br>

उपागम
उपागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಲುಪುವುದು /ಹತ್ತಿರ ಸೇರುವುದು<br><b>निष्पत्तिः - </b>उप + आ + गम्लृ (गतौ) - "अप्" (३-३-५८)<br><br>उपागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒದಗುವುದು /ಸಂಭವಿಸುವುದು<br><b>प्रयोगाः - </b>"उपागमे दुश्चरिता इवापदां गतिं न निश्चेतुमलं शिलीमुखाः"<br><b>उल्लेखाः - </b>किरा० ४-३५<br><br>उपागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಪ್ಪಿಗೆ /ಸಂಮತಿ<br><br>

उपाग्र
उपाग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ರಧಾನ /ಗೌಣ<br><b>व्युत्पत्तिः - </b>उपमितोऽग्रेण<br><br>उपाग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊನೆಯದಕ್ಕೆ ಹಿಂದಿನದಾದ<br><br>

उपाग्रहण
उपाग्रहण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಸ್ಕಾರಪೂರ್ವಕ ವೇದವನ್ನು ಸ್ವೀಕರಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + आ + ग्रह (उपादाने) - "ल्युट्" (३-३-११५)<br><br>

उपाङ्ग
उपाङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿಲಕ /ಹಣೆಯ ಬೊಟ್ಟು<br><b>व्युत्पत्तिः - </b>अङ्गं देहः । अङ्गोपयोगि ।<br><br>उपाङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯಂಗ /ದೇಹದಲ್ಲಿರುವ ಸಣ್ಣ ಸಣ್ಣ ಅವಯವಗಳು<br><br>उपाङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೇದಾಂಗಗಳಿಗೆ ಸಮಾನವಾದ ಪುರಾಣಗಳು /ನ್ಯಾಯಶಾಸ್ತ್ರ ಮೀಮಾಂಸ ಮತ್ತು ಧರ್ಮಶಾಸ್ತ್ರಗಳು<br><br>उपाङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಧಾನ ಕಾರ್ಯದ ಅಂಗಕಾರ್ಯಗಳಿಗೆ ಉಪಯುಕ್ತ ಕಾರ್ಯ<br><b>व्युत्पत्तिः - </b>उपमितमङ्गेन<br><br>

उपाजे
उपाजे<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಬಲವಿಲ್ಲದವನಿಗೆ ಬಲಗೂಡಿಸುವಿಕೆ<br><br>

उपाञ्जन
उपाञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲೇಪನ /ಸುಣ್ಣ ಮೊದಲಾದುವನ್ನು ಬಳಿಯುವುದು<br><b>निष्पत्तिः - </b>उप + अञ्जू (व्यक्त्यादौ) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"मार्जनोपाञ्जनैर्वेश्म पुनः पाकेन मृण्मयम्"<br><b>उल्लेखाः - </b>मनु० ५-१२२<br><br>उपाञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಗಣಿಯಿಂದ ನೆಲವನ್ನು ಸಾರಿಸುವುದು<br><b>प्रयोगाः - </b>"सम्मार्जनोपाञ्जनेन सेकेनोल्लेखनेन च । गवां च परिवासेन भूमिः शुद्ध्यति पञ्चभिः ॥"<br><b>उल्लेखाः - </b>मनु० ५-१२४<br><br>

उपात्त
उपात्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದವಿಲ್ಲದ ಆನೆ<br><br>उपात्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವೀಕರಿಸಲ್ಪಟ್ಟ /ತೆಗೆದುಕೊಳ್ಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + आ + डुदाञ् (दाने) - "क्तः" (३-२-१०२)<br><br>उपात्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭಿಸಲ್ಪಟ್ಟ /ಉಪಕ್ರಮಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"उपात्तवर्णे चरिते पिनाकिनः सबाष्पकण्ठस्खलनैः पदैरियम्"<br><b>उल्लेखाः - </b>कुमा० ५-५६<br><br>उपात्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಡೆಯಲ್ಪಟ್ಟ /ಹೊಂದಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"उपात्तविद्यो गुरुदक्षिणार्थी कौत्सः प्रपेदे वरतन्तुशिष्यः"<br><b>उल्लेखाः - </b>रघु० ५-१<br><br>उपात्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಯೋಗಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"न चक्षुषोः कान्तिविशेषबुद्ध्या कालाञ्जनं मङ्गलमित्युपात्तम्"<br><b>उल्लेखाः - </b>कुमा० ७-२०<br><br>उपात्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಡಿಯಲ್ಪಟ್ಟ /ತೆಗೆದುಕೊಳ್ಳಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"समाचराचारमुपात्तशस्त्रो जपोपवासाभिषवैर्मुनीनाम्"<br><b>उल्लेखाः - </b>किरा० ३-२८<br><br>

उपात्यय
उपात्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರ ಮತ್ತು ಲೋಕಮರ್ಯಾದೆಯನ್ನು ಮೀರಿ ನಡೆಯುವುದು<br><b>निष्पत्तिः - </b>उप + अति + इण् (गतौ) - "अच्" (३-३-५६)<br><b>व्युत्पत्तिः - </b>उपगतस्यात्ययः<br><br>उपात्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಮ ಬಿಟ್ಟು ನಡೆಯುವುದು<br><b>प्रयोगाः - </b>"परावनुपात्यय इणः"<br><b>उल्लेखाः - </b>पा० सू० ३-३-३८<br><b>विस्तारः - </b>"क्रमप्राप्तस्यानतिपातोऽनुपात्ययः" - सि० कौ० ।<br><br>उपात्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮಿಸುವುದು /ಉಲ್ಲಂಘಿಸುವುದು<br><b>विस्तारः - </b>"अतिक्रम उपात्ययः"- वैज० ।<br><br>उपात्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಶ /ಪ್ರಳಯ<br><br>

उपादान
उपादान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಹಣ /ಸ್ವೀಕಾರ<br><b>निष्पत्तिः - </b>उप +आ + डुदाञ् (दाने) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"विद्रब्धं ब्राह्मणः शूद्रात् द्रव्योपादानमाचरेत्"<br><b>उल्लेखाः - </b>मनु० ८-४१७<br><br>उपादान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯಾಹಾರ /ಇಂದ್ರಿಯಗಳನ್ನು ಆಯಾ ವಿಷಯಗಳಲ್ಲಿ ಬಿಡದಂತೆ ತಡೆಯುವುದು<br><br>उपादान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಲಕಾರಣ /ಕಾರ್ಯೋತ್ಪತ್ತಿಗಾಗಿ ಅವಶ್ಯವಾಗಿರಬೇಕಾದ ಕಾರಣ /ಯಾವಾಗಲೂ ಕಾರ್ಯದೊಡನೆ ಸಂಬಂಧ ಹೊಂದಿರುವ ಕಾರಣ<br><b>निष्पत्तिः - </b>उप +आ + डुदाञ् (दाने) - कर्म० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>उपादीयते<br><br>उपादान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಂಖ್ಯರು ಹೇಳುವ ೯ ವಿಧ ಆಧ್ಯಾತ್ಮಿಕ ತುಷ್ಟಿಗಳಲ್ಲೊಂದು<br><br>उपादान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಾದಾನ /ಉಂಛವೃತ್ತಿ /ಭಿಕ್ಷೆಯೆತ್ತುವುದು<br><br>

उपादानलक्षणा
उपादानलक्षणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಕ್ಯಾರ್ಥದಲ್ಲಿ ಮುಖ್ಯಾರ್ಥದ ಅನ್ವಯಸಿದ್ಧಿಗಾಗಿ ತನ್ನ ಅರ್ಥವನ್ನು ಬಿಡದೆ ಮುಖ್ಯಾರ್ಥಕ್ಕಿಂತಲೂ ಬೇರೆಯಾದ ಮತ್ತೊಂದು ಅರ್ಥದ ಪ್ರತೀತಿಯುಂಟಾಗುವಿಕೆ<br><b>निष्पत्तिः - </b>उप +आ + डुदाञ् (दाने) - "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>उपादीयते स्वार्थोऽनेनेत्युपादानम् । उपादानात् लक्षणा<br><b>प्रयोगाः - </b>"मुख्यार्थस्येतरापेक्षो वाक्यार्थेऽन्वयसिद्धये । स्यादात्मनोऽप्युपादानादेषोपादानलक्षणा ॥"<br><b>उल्लेखाः - </b>सा० द० २-६<br><br>

उपादेय
उपादेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಳ್ಳಲು ಯೋಗ್ಯವಾದ /ಸ್ವೀಕರಿಸಲು ಅರ್ಹವಾದ<br><b>निष्पत्तिः - </b>उप +आ + डुदाञ् (दाने) - "यत्" (३-१-९७)<br><b>व्युत्पत्तिः - </b>उपादातुं योग्यम्<br><b>प्रयोगाः - </b>"वयस्य मकरन्द सम्प्रत्युपादेयो माधवस्य जीवलोकः"<br><b>उल्लेखाः - </b>मालती० १०<br><br>उपादेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕರಿಸಲು ಯೋಗ್ಯವಾದ /ಒಪ್ಪಿಕೊಳ್ಳಬಹುದಾದ<br><br>उपादेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ /ಉತ್ಕೃಷ್ಟವಾದ<br><br>

उपाधि
उपाधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧರ್ಮದ ವಿಷಯವಾಗಿ ಮಾಡುವ ಚಿಂತೆ<br><b>निष्पत्तिः - </b>उप +आ + डुधाञ् (धारणपोषणयोः) - भावे "किः" (३-३-९२)<br><b>व्युत्पत्तिः - </b>उपाधीयते<br><br>उपाधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶೇಷಣ /ಗುಣ /ಧರ್ಮ<br><br>उपाधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿರುದು<br><br>उपाधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾರ /ವಿಧ<br><b>प्रयोगाः - </b>"अधीतिबोधाचरणप्रचारणैर्दशाश्चतस्रः प्रणयन्नुपाधिभिः"<br><b>उल्लेखाः - </b>नैष० १-४<br><br>उपाधि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಟುಂಬ ಪೋಷಣೆಯಲ್ಲಿ ನಿರತನಾದವನು<br><b>व्युत्पत्तिः - </b>उपगतः आधिम्<br><br>उपाधि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಧ್ಯವಿರುವೆಡೆಯಲ್ಲೆಲ್ಲಾ ಇದ್ದು ಸಾಧನವಿರುವ ಕಡೆ ಇಲ್ಲದಿರುವ ವಸ್ತು<br><b>प्रयोगाः - </b>"साध्यव्यापकत्वे सति साधनाव्यापकत्वम् उपधिः"<br><br>उपाधि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನ ಸಂಬಂಧವುಳ್ಳ ಒಂದು ವಸ್ತುವನ್ನು ತನ್ನ ಸಂಬಂಧವಿಲ್ಲದ ಅದೇ ವಸ್ತುವಿಗಿಂತಲೂ ಬೇರೆಯೆಂದು ತಿಳಿಸುವ ಒಂದು ವಸ್ತು<br><br>उपाधि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಟ /ಮೋಸ /ವಂಚನೆ<br><b>विस्तारः - </b>"उपाधिर्धर्मचिन्तायां कुटुम्बव्यापृते छले" - मेदि० ।<br><br>उपाधि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇತು /ಕಾರಣ<br><b>प्रयोगाः - </b>"व्यतिषजति पदार्थानान्तरः कोऽपिहेतुर्न खलु बहिरुपाधीन् प्रीतयः संश्रयन्ते"<br><b>उल्लेखाः - </b>उ० रा० ६-१२<br><br>

उपाधेय
उपाधेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿಡಲು ಯೋಗ್ಯವಾದ /ಹತ್ತಿರದಲ್ಲಿರಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उप +आ + डुधाञ् (धारणपोषणयोः) - "यत्" (३-१-९७)<br><br>

उपाध्याय
उपाध्याय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುರು /ಜೀವನಕ್ಕಾಗಿ ವೇದ ವೇದಾಂಗಗಳನ್ನು ಕಲಿಸುವವನು<br><b>निष्पत्तिः - </b>उप + अधि + इङ् (अध्ययने) - "घञ्"(३-३-२१)<br><b>व्युत्पत्तिः - </b>उपेत्य अधीयतेऽस्मात्<br><b>प्रयोगाः - </b>"एकदेशन्तु वेदस्य वेदाङ्गान्यपि वा पुनः । योऽध्यापयति वृत्त्यर्थमुपाध्यायः स उच्यते ॥"<br><b>उल्लेखाः - </b>मनु० २-१४१<br><br>

उपाध्याया
उपाध्याया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗುರು /ಜೀವನಕ್ಕಾಗಿ ವೇದ ವೇದಾಂಗಗಳನ್ನು ಕಲಿಸುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां वा "ङीष्" (वा० ३-३-२१)<br><br>

उपाध्यायी
उपाध्यायी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗುರು /ಜೀವನಕ್ಕಾಗಿ ವೇದ ವೇದಾಂಗಗಳನ್ನು ಕಲಿಸುವವಳು<br><br>

उपाध्यायानी
उपाध्यायानी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗುರು /ಜೀವನಕ್ಕಾಗಿ ವೇದ ವೇದಾಂಗಗಳನ್ನು ಕಲಿಸುವವಳು<br><b>निष्पत्तिः - </b>पुंयोगे वा आनुक् "ङीष्" च (वा० ४-१-४९)<br><b>व्युत्पत्तिः - </b>उपाध्यायस्य स्त्री<br><br>

उपानह्
उपानह्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚರ್ಮಸ ಚಪ್ಪಲಿ /ತೊಗಲಿನ ಪಾದರಕ್ಷೆ<br><b>निष्पत्तिः - </b>उप + णह (बन्धने) - "क्विप्" (वा० ३-३-१०८)<br><b>व्युत्पत्तिः - </b>पासमुपनह्यति<br><b>प्रयोगाः - </b>"श्वा यदि क्रियते राजा स किं नाश्नात्युपानहम्"<br><b>उल्लेखाः - </b>हितो० ३-५८<br><br>

उपान्त
उपान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನೆಯ ಭಾಗದ ಸಮೀಪ ಪ್ರದೇಶ<br><b>व्युत्पत्तिः - </b>उपमितोऽन्तेन<br><b>प्रयोगाः - </b>"स एष कैलास उपान्तसर्पिणः करोत्यकालास्तमयं विवस्वतः"<br><b>उल्लेखाः - </b>किरा० ५-३५<br><br>उपान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಪ್ರದೇಶ /ಬಹಳ ಹತ್ತಿರ<br><b>प्रयोगाः - </b>"मेरोरुपान्तेष्विव वर्तमानमन्योन्यसंसक्तमहस्त्रियामा"<br><b>उल्लेखाः - </b>रघु० ७-२४<br><br>उपान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರದ /ಸಮೀಪದ<br><br>उपान्त<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೊನೆಯದರ ಸಮೀಪ<br><b>व्युत्पत्तिः - </b>अन्तस्य समीपम्<br><br>

उपान्तिक
उपान्तिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳಸಮೀಪ /ಬಹಳ ಹತ್ತಿರ<br><b>प्रयोगाः - </b>"सरजसमपहाय केतकीनां प्रसवमुपान्तिकनीपरेणुकीर्णम्"<br><b>उल्लेखाः - </b>किरा० १०-२६<br><br>उपान्तिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಸಮೀಪದಲ್ಲಿರುವ /ಬಹಳ ಹತ್ತಿರದಲ್ಲಿರುವ<br><br>

उपान्तिम
उपान्तिम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊನೆಯದಕ್ಕೆ ಸಮೀಪದ /ಉಪಾಂತ್ಯ<br><b>व्युत्पत्तिः - </b>उपगतममन्तिमम्<br><br>उपान्तिम<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೊನೆಯದರ ಸಮೀಪ<br><br>

उपान्त्य
उपान्त्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊನೆಯದರ ಸಮೀಪದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"यत्" (४-३-५४)<br><b>व्युत्पत्तिः - </b>उपान्ते भवम्<br><b>प्रयोगाः - </b>"उत्तमग्रहणमुपान्त्यस्यापि सङ्ग्रहार्थम्"<br><b>उल्लेखाः - </b>सि० कौ० ५-४-९०<br><br>

उपाय
उपाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿರಕ್ಕೆ ಬರುವುದು<br><b>निष्पत्तिः - </b>उप + अय (गतौ) - भावे "घञ्" (३-३-१८)<br><br>उपाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಾಯ /ಯುಕ್ತಿ<br><b>प्रयोगाः - </b>"उपायेन हि यच्छक्यं न तच्छक्यं पराक्रमैः"<br><b>उल्लेखाः - </b>हितो०<br><br>उपाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದ ಯೋಜನೆ /ಕಾರ್ಯಸಾಧನೆಯ ವ್ಯಾಪಾರ<br><b>प्रयोगाः - </b>"गुणवत्युपायनिलये स्थितिहेतो साधिके त्रिवर्गस्य"<br><b>उल्लेखाः - </b>मुद्रा० १-५<br><br>उपाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನು ಸಂಪತ್ತನ್ನು ಹೆಚ್ಚಿಸಲು ಮತ್ತು ಶತ್ರುವನ್ನು ಜಯಿಸಲು ಉಪಯೋಗಿಸುವ ಸಾಧನ<br><b>प्रयोगाः - </b>"उपायमास्थितस्यापि नश्यन्त्यर्थाः प्रमाद्यतः । हन्ति नोपशयस्थोऽपि शयालुर्मृगयुर्मृगान्"<br><b>उल्लेखाः - </b>माघ० २-८०<br><br>उपाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತಮರ್ಣನು ತನ್ನ ಹಣವನ್ನು ಹಿಂದಕ್ಕೆ ಪಡೆಯಲು ಮಾಡುವ ಪ್ರಯತ್ನ<br><b>प्रयोगाः - </b>"यैर्यैरुपायैरर्थं स्वं प्राप्नुयादुत्तमर्णिकः । तैस्तैरुपायैः सङ्गृह्य दापयेदधमर्णिकम् ॥"<br><b>उल्लेखाः - </b>मनु० ८-४९<br><br>उपाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯತ್ನ<br><b>प्रयोगाः - </b>"असंयतात्मना योगो दुष्प्राप्य इति मे मतिः । वश्यात्मना तु यतता शक्योऽवाप्तुमुपायतः ॥"<br><b>उल्लेखाः - </b>गीता० ६-३६<br><br>उपाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಕ್ರಮ /ಪ್ರಾರಂಭ<br><br>उपाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಧನ /ಸಲಕರಣೆ<br><br>

उपायन
उपायन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜದರ್ಶನಕ್ಕಾಗಿ ತರುವ ಕಾಣಿಕೆ<br><b>निष्पत्तिः - </b>उप + अय (गतौ) -कर्म० "ल्युट्" (३-३-११३)<br><b>व्युत्पत्तिः - </b>उपाय्यते<br><b>प्रयोगाः - </b>"नयत्ययुग्मच्छदगन्धिरार्द्रतां भृशं नृपोपायनदन्तिनां मदः"<br><b>उल्लेखाः - </b>किरा० १-१६<br><br>उपायन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಣಿಕೆಗಾಗಿ ತರುವ ವಸ್ತು<br><b>प्रयोगाः - </b>"परस्परेण विज्ञातस्तेषूपायनपाणिषु"<br><b>उल्लेखाः - </b>रघु० ४-७९<br><br>उपायन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪವನ್ನು ಹೊಂದುವುದು /ಹತ್ತಿರಕ್ಕೆ ಹೋಗುವುದು<br><b>निष्पत्तिः - </b>उप + अय (गतौ) - भावे "ल्युट्" (३-३-११५)<br><br>

उपायिन्
उपायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಧನವುಳ್ಳ /ಸಲಕರಣೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>उपायोऽस्यास्ति<br><br>उपायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಬರುವ<br><b>निष्पत्तिः - </b>उप + अय (गतौ) - "णिनिः" (३-१-१३४)<br><br>

उपायिनी
उपायिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उपायिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उपारत
उपारत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂತಿರುಗಿದ<br><b>निष्पत्तिः - </b>उप +आ + रमु (क्रीडायाम्) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"उपारताः पश्चिमरात्रिगोचरादपारयन्त्यः पतितुं जवेन गाम्"<br><b>उल्लेखाः - </b>किरा० ४-१०<br><br>

उपारूढ
उपारूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆಳೆದಿರುವ /ಹೆಚ್ಚಿರುವ /ಅಭಿವೃದ್ಧಿ ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>उप +आ + रुह (बीजजन्मादौ) - "क्तः" (३-४-७२)<br><br>उपारूढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಂಟಾದ /ಹುಟ್ಟಿದ /ಉತ್ಪನ್ನವಾದ<br><b>प्रयोगाः - </b>"कुतोऽयमित्युपारूढकुतूहला चाहं मुकुलितलोचना तेन कुसुमगन्धेन मधुकरीवाकृष्यमाणा"<br><b>उल्लेखाः - </b>कादं०<br><br>

उपार्जन
उपार्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪಾದನೆ<br><b>निष्पत्तिः - </b>उप + अर्ज (प्रतियत्ने) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"शस्त्राणां स रथानां च कृत्वा सम्यगुपार्जनम्"<br><b>उल्लेखाः - </b>रामा०<br><br>

उपालब्ध
उपालब्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿಸಲ್ಪಟ್ಟ /ಬೈಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + आ + डुलभष् (प्राप्तौ) - "क्तः" (३-२-१०२)<br><br>

उपालम्भ
उपालम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ಬೈಗುಳು<br><b>निष्पत्तिः - </b>उप + आ + डुलभष् (प्राप्तौ) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"तवोपालम्भे पतितास्मि"<br><b>उल्लेखाः - </b>माल० १<br><br>

उपालम्भन
उपालम्भन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ಬೈಗುಳು<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

उपावर्तन
उपावर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂತಿರುಗಿ ಬರುವಿಕೆ /ಮತ್ತೆ ಬರುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + आ + वृतु (वर्तने) - "ल्युट्" (३-३-११५)<br><br>उपावर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿಯಲ್ಲಿ ಹೊರಳಾಡುವಿಕೆ<br><br>

उपावृत्त
उपावृत्त<br><br><b>पदविभागः - </b>त्रिलिङ्गः<br><b>कन्नडार्थः - </b>ದಣಿವಾರಿಸಿಕೊಳ್ಳಲು ನೆಲದ ಮೇಲೆ ಹೊರಳಾಡಿದ ಕುದುರೆ<br><b>निष्पत्तिः - </b>उप + आ + वृतु (वर्तने) - "क्तः" (३-४-७२)<br><b>विस्तारः - </b>"त्रिषूपावृत्तलुठितौ" - अम० ।<br><br>उपावृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂತಿರುಗಿ ಬಂದ /ಮತ್ತೆ ಬಂದ<br><br>उपावृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂರ್ವ ಸ್ಥಿತಿಗೆ ಬಂದಿರುವ<br><b>प्रयोगाः - </b>"उपावृत्तस्य पापेभ्यो यश्च वासो गुणैः सह"<br><b>उल्लेखाः - </b>भविष्य०<br><br>

उपाश्रय
उपाश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ /ಆಸರೆ /ಅವಲಂಬನ<br><b>निष्पत्तिः - </b>उप + आ + श्रिञ् (सेवायाम्) - भावे "अच्" (३-३-५६)<br><b>प्रयोगाः - </b>"ईप्सितस्य न भवेदुपाश्रयः कस्य निर्जितरसस्तमोगुणः"<br><b>उल्लेखाः - </b>किरा० १३-४०<br><br>उपाश्रय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯಿಸಲು ಯೋಗ್ಯವಾದ /ಆಶ್ರಯಿಸಲ್ಪಡುವ<br><b>प्रयोगाः - </b>"त्वं न नस्तात सर्वेषां दुःखितानामुपाश्रयः"<br><b>उल्लेखाः - </b>भा० वन०<br><br>

उपाश्रित
उपाश्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯಿಸಲ್ಪಟ್ಟವನು /ಆಸರೆ ಕೊಟ್ಟವನು<br><b>निष्पत्तिः - </b>उप + आ + श्रिञ् (सेवायाम्) - कर्म० "क्तः" (३-२-१०२)<br><br>उपाश्रित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ ಪಡೆದವನು /ಆಸರೆ ಹೊಂದಿದವನು<br><b>निष्पत्तिः - </b>उप + आ + श्रिञ् (सेवायाम्) - कर्त० "क्तः"(३-४-७२)<br><br>

उपासक
उपासक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಕ /ಆಳು<br><b>निष्पत्तिः - </b>उप + आस (उपवेशने) - "ण्वुल्" (३-१-१३३)<br><br>उपासक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸುವವನು /ಆರಾಧಿಸುವವನು<br><br>उपासक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೌದ್ಧಭಿಕ್ಷು<br><b>प्रयोगाः - </b>"उपासकानां साम्प्रतमेतस्मिन् मलयकेतुकटके अनुकूलेन अननुकूलेन वा अगृहीतमुद्रेण न गम्यते"<br><b>उल्लेखाः - </b>मुद्रा० ५<br><br>

उपासङ्ग
उपासङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬತ್ತಳಿಕೆ /ಬಾಣಗಳ ಚೀಲ<br><b>प्रयोगाः - </b>"कस्येमे क्षुरनाराचाः सहस्रं लोमवापिनः । प्रक्षिप्तास्तीक्ष्णतुण्डाग्रा उपासङ्गे हिरण्मये ॥"<br><b>उल्लेखाः - </b>भा० विरा० ४१-११<br><br>उपासङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಹತ್ತಿರ /ಅತ್ಯಂತ ಸಮೀಪ<br><b>निष्पत्तिः - </b>भावे "घञ्" (३-३-१८)<br><br>

उपासन
उपासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣಪ್ರಯೋಗದ ಅಭ್ಯಾಸ /ಬಾಣಬಿಡುವುದನ್ನು ಕಲಿಯುವುದು<br><b>निष्पत्तिः - </b>उप + असु (क्षेपणे) , आस (उपवेशने) - वा भावे "ल्युट्" (३-३-११५)<br><b>विस्तारः - </b>"शराभ्यास उपासनम्" - अम० ।<br><br>उपासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶುಶ್ರೂಷೆ /ಸೇವೆ<br><b>प्रयोगाः - </b>"आचार्योपासनं शौचं स्थैर्यमात्मविनिग्रहः"<br><b>उल्लेखाः - </b>गीता० १३-७<br><br>उपासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ /ಆರಾಧನೆ<br><br>उपासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧ್ಯಾನ /ಚಿಂತನೆ<br><br>उपासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಸನ /ಪೀಠ<br><b>विस्तारः - </b>"उपासनं शराभ्यासेऽप्युपास्तावासनेऽपि च" - मेदि० ।<br><br>उपासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸುವುದು /ಪೀಡಿಸುವುದು<br><b>विस्तारः - </b>"उपासनं शराभ्यासे शुश्रूषायां च हिंसने" - विश्व० ।<br><br>

उपासना
उपासना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उपासन ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>भावे "युच्" (३-३-१०७)<br><b>प्रयोगाः - </b>"स्वर्णैर्वितीर्णैः करवाम वामनेत्रे भवत्या किमुपासनासु"<br><b>उल्लेखाः - </b>नैष० ८-९८<br><br>

उपासादित
उपासादित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಪ್ತಿ /ಲಾಭ<br><b>निष्पत्तिः - </b>उप + आ + षद्लृ (विशरणादौ) - भावे "क्तः" (३-३-११४)<br><br>उपासादित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾಪ್ತವಾದ /ಪಡೆಯಲ್ಪಟ್ಟ /ಸಂಪಾದಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कर्म० "क्तः" (३-२-१०२)<br><br>

उपासित
उपासित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಟ್ಟ /ಆರಾಧಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + आस (उपवेशने) - "क्तः" (३-२-१०२)<br><br>उपासित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಿಸಲ್ಪಟ್ಟ /ಶುಶ್ರೂಷೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"नभसः कलभैरुपासितम्"<br><b>उल्लेखाः - </b>नैष० २-६७<br><br>उपासित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧ್ಯಾನಿಸಲ್ಪಟ್ಟ<br><br>

उपासितृ
उपासितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸುವವನು /ಆರಾಧಿಸುವವನು<br><b>निष्पत्तिः - </b>उप + आस (उपवेशने) - "तृच्" (३-१-१३३)<br><br>उपासितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಕ /ಶುಶ್ರೂಷೆ ಮಾಡುವವನು<br><b>प्रयोगाः - </b>"उपासिता च वृद्धानां जिततन्द्रिरलोलुपः"<br><b>उल्लेखाः - </b>भा० शान्ति० ५६-२०<br><br>उपासितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧ್ಯಾನಿಸುವವನು<br><br>

उपास्ति
उपास्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ /ಆರಾಧನೆ<br><b>निष्पत्तिः - </b>उप + आस (उपवेशने) - "क्तिन्" (३-३-९४)<br><br>उपास्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವೆ /ಶುಶ್ರೂಷೆ<br><br>उपास्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಧ್ಯಾನ /ಚಿಂತನೆ<br><br>

उपास्य
उपास्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಿಸಲ್ಪಡುವ /ಶುಶ್ರೂಷಿಸಲು ಯೋಗ್ಯನಾದ<br><br>उपास्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧ್ಯಾನಿಸಲ್ಪಡುವ<br><br>उपास्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उप + आस (उपवेशने) - कर्म० "ण्यत्" (३-१-१२४)<br><b>प्रयोगाः - </b>"पुत्रवच्चैव ते रक्ष्या उपास्या गुरुवच्च ते"<br><b>उल्लेखाः - </b>भा० अनु० १३-२५<br><br>उपास्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಿ /ಆರಾಧಿಸಿ<br><br>उपास्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಧ್ಯಾನಿಸಿ /ಚಿಂತಿಸಿ<br><br>उपास्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸೇವಿಸಿ /ಶುಶ್ರೂಷೆ ಮಾಡಿ<br><b>निष्पत्तिः - </b>उप + आस (उपवेशने) - "ल्यप्"(७-१-३७)<br><b>प्रयोगाः - </b>"उपास्या पश्चिमां सन्ध्याम्"<br><br>

उपास्यमान
उपास्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಿಸಲ್ಪಡುತ್ತಿರುವ<br><br>उपास्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಡುತ್ತಿರುವ<br><br>उपास्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧ್ಯಾನಿಸಲ್ಪಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उप + आस (उपवेशने) - कर्म० यक् "शानच्" (३-२-१२४)<br><br>

उपाहार
उपाहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಊಟವಾದ ನಂತರ ಮಧ್ಯಾಹ್ನದ ಮೇಲೆ ತೆಗೆದುಕೊಳ್ಳುವ ಲಘುವಾದ ಆಹಾರ /ತಿಂಡಿ ಹಣ್ಣು ಮುಂತಾದ ಆಹಾರ<br><b>निष्पत्तिः - </b>उप + आ + हृञ् (हरणे) - "घञ्" (३-३-१८)<br><br>

उपाहित
उपाहित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನಿಷ್ಟಸೂಚಕವಾದ ಅಗ್ನಿಯಿಂದುಂಟಾಗುವ ತೊಂದರೆ /ಬೆಂಕಿಯ ಉತ್ಪಾತ<br><b>व्युत्पत्तिः - </b>उप आसन्नं आहितं फलं यस्मात्<br><br>उपाहित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಏರಿಸಲ್ಪಟ್ಟ /ಹತ್ತಿಸಲ್ಪಟ್ಟ<br><b>विस्तारः - </b>"उपाहितोऽनलोत्पाते पुमानारोपिते त्रिषु" - मेदि० ।<br><br>उपाहित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪದಲ್ಲಿ ಇಡಲ್ಪಟ್ಟ /ಹತ್ತಿರದಲ್ಲಿ ಇರಿಸಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>उप समीपे आहितः<br><br>

उपेक्षक
उपेक्षक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪೇಕ್ಷೆ ಮಾಡುವ /ಉದಾಸೀನನಾಗಿರುವ ಯೋಗಿ<br><b>निष्पत्तिः - </b>उप + ईक्ष (दर्शने) - "ण्वुल्" (३-१-१३३)<br><br>उपेक्षक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಾದರದಿಂದ ಕಾಣುವ<br><br>

उपेक्षण
उपेक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪೇಕ್ಷೆ /ಉದಾಸೀನತೆ<br><b>निष्पत्तिः - </b>उप + ईक्ष (दर्शने) - "ल्युट्" (३-३-११५)<br><br>उपेक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನ ೭ ವಿಧ ಉಪಾಯಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"साम्ना दानेन भेदेन दण्डेनोपेक्षणेन च"<br><b>उल्लेखाः - </b>भा० वन०<br><br>उपेक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತ್ಯಾಗ /ಬಿಡುವುದು<br><br>उपेक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಾದರ /ಅವಮರ್ಯಾದೆ /ತಿರಸ್ಕಾರ<br><br>

उपेक्षणीय
उपेक्षणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪೇಕ್ಷಿಸಲು ಅರ್ಹವಾದ /ಬಿಡಲು ಯೋಗ್ಯವಾದ<br><b>प्रयोगाः - </b>"गुरोरपीदं धनमाहिताग्नेर्नश्यत्पुरस्तादनुपेक्षणीयम्"<br><b>उल्लेखाः - </b>रघु० २-४४<br><br>उपेक्षणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪೇಕ್ಷಿಸಲು ಶಕ್ಯವಾದ<br><br>उपेक्षणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪೇಕ್ಷಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उप + ईक्ष (दर्शने) - अर्हादौ "अनीयर्" (३-१-९६)<br><br>उपेक्षणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಕ್ರಿಯೆಗೂ ಅರ್ಹವಲ್ಲದ /ತ್ಯಜಿಸಲು ಯೋಗ್ಯವಾದ<br><br>

उपेक्षमाण
उपेक्षमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲಕ್ಷ್ಯ ಮಾಡುವ /ಉದಾಸೀನತೆಯಿಂದ ಕಾಣುವ<br><b>निष्पत्तिः - </b>उप + ईक्ष (दर्शने) - कर्त० "शानच्" (३-२-१२४)<br><br>उपेक्षमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಾದರದಿಂದ ಕಾಣುವ<br><br>उपेक्षमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರದಿಂದ ಕಾಣುವ<br><br>

उपेक्षा
उपेक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉದಾಸೀನತೆ /ಅಲಕ್ಷ್ಯ<br><b>प्रयोगाः - </b>"उपेक्षा सर्वकार्येषु कर्मणां करणेषु च । अनिष्टानां समुत्थेन त्रिवर्गो नश्यते यया ॥"<br><b>उल्लेखाः - </b>भा० शान्ति० ५८-४४<br><br>उपेक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಾದರ /ಪ್ರೀತಿಯಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + ईक्ष (दर्शने) -"अः" (३-३-१०३)<br><b>प्रयोगाः - </b>"किं वा तवात्यन्तवियोगमोघे कुर्यामुपेक्षां हतजीवितेऽस्मिन्"<br><b>उल्लेखाः - </b>रघु० १४-६५<br><br>उपेक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಡುವುದು /ತ್ಯಜಿಸುವುದು<br><br>उपेक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರ /ಅಗೌರವ<br><b>प्रयोगाः - </b>"यथा यथेह त्वदुपेक्षयानया निमेषमप्येष जनो विलम्बते"<br><b>उल्लेखाः - </b>नैष० ९-२०<br><br>

उपेक्षित
उपेक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲಕ್ಷ್ಯದಿಂದ ಕಾಣಲ್ಪಟ್ಟ<br><br>उपेक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಟ್ಟ<br><br>उपेक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಮಾನಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>उपेक्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತ್ಯಜಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उप + ईक्ष (दर्शने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"उपेक्षितेक्षोः करभाच्छमीरतात्"<br><b>उल्लेखाः - </b>नैष० ९-४३<br><br>

उपेक्षितव्य
उपेक्षितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>उपेक्षणीय ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>उप + ईक्ष (दर्शने) - अर्हादौ "तव्यः" (३-१-९६)<br><br>

उपेक्ष्य
उपेक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪೇಕ್ಷಿಸಲು ಯೋಗ್ಯವಾದ<br><br>उपेक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪೇಕ್ಷಿಸಲು ಶಕ್ಯವಾದ<br><br>उपेक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪೇಕ್ಷಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उप + ईक्ष (दर्शने) - अर्हादौ "ण्यत्" (३-१-१२४)<br><br>उपेक्ष्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉಪೇಕ್ಷಿಸಿ /ಉದಾಸೀನತೆಯಿಂದ ಕಂಡು<br><br>उपेक्ष्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಿ /ಅನಾದರದಿಂದ ಕಂಡು<br><br>

उपेक्ष्यमाण
उपेक्ष्यमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದಾಸೀನತೆಯಿಂದ ಕಾಣಲ್ಪಡುವ<br><br>उपेक्ष्यमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उप + ईक्ष (दर्शने) - कर्म० "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"उपेक्ष्यमाणो विज्ञातो हृदयेनापराजितः"<br><b>उल्लेखाः - </b>भा० शान्ति० १०३-१४<br><br>

उपेत
उपेत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೂಡಿರುವ /ಸೇರಿಕೊಂಡಿರುವ<br><b>निष्पत्तिः - </b>उप + इण् (गतौ) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"विपदोऽभिभवन्त्यविक्रमं रहयत्यापदुपेतमायतिः"<br><b>उल्लेखाः - </b>किरा० २-१४<br><br>उपेत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿರಕ್ಕೆ ಬಂದಿರುವ /ಸಮೀಪಕ್ಕೆ ಬಂದಿರುವ<br><br>उपेत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಗಮಿಸಿರುವ /ಬಂದಿರುವ<br><b>प्रयोगाः - </b>"उपेतपार्श्वश्चरणेन मौनिना"<br><b>उल्लेखाः - </b>नैष० १-१२४<br><br>उपेत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪನಯನ ಸಂಸ್ಕಾರ ಹೊಂದಿದವನು<br><b>प्रयोगाः - </b>"न स्त्री जुहुयान्नानुपेतः"<br><b>उल्लेखाः - </b>स्मृतिः<br><br>

उपेतृ
उपेतृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಬಂದಿರುವ<br><b>निष्पत्तिः - </b>उप + इण् (गतौ) - "तृच्" (३-१-१३३)<br><br>

उपेत्री
उपेत्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಬಂದಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><b>प्रयोगाः - </b>"उपेतारमुपेयं च सर्वोपायांश्च कृत्स्नशः"<br><b>उल्लेखाः - </b>मनु० ७-२१५<br><br>

उपेन्द्र
उपेन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>इन्द्रमुपगतोऽनुजत्वेन<br><b>प्रयोगाः - </b>"उपेन्द्रो वामनः प्रांशुः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"इन्द्रस्याप्यनुजत्वे जतश्चोपेन्द्र उच्यते" - निरुक्तिः ।<br><br>

उपेन्द्रवज्रा
उपेन्द्रवज्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>೧೧ನೆಯ ಛಂದಸ್ಸಿನ ಒಂದು ವೃತ್ತ<br><b>प्रयोगाः - </b>"उपेन्द्रवज्रा जतजास्ततो गौ"<br><b>उल्लेखाः - </b>वृ० र०<br><br>

उपेय
उपेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಾಯದಿಂದ ಸಾಧಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उप + इण् (गतौ) - "यत्" (३-१-९७)<br><br>उपेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಾಯದಿಂದ ಸಾಧಿಸಲು ಅರ್ಹವಾದ<br><br>उपेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಾಯದಿಂದ ಸಾಧಿಸಲು ಶಕ್ಯವಾದ<br><b>प्रयोगाः - </b>"भवत्युपायं प्रति हि प्रवृत्तावुपेयमाधुर्यमधैर्यसर्जि"<br><b>उल्लेखाः - </b>नैष० ६-९३<br><br>उपेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲು ಯೋಗ್ಯವಾದ<br><br>उपेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲು ಶಕ್ಯವಾದ<br><br>उपेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಡುವ<br><b>प्रयोगाः - </b>"उपेतारमुपेयं च सर्वोपायांश्च कृत्स्नशः"<br><b>उल्लेखाः - </b>मनु० ७-२१५<br><br>उपेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಹೋಗಲು ಯೋಗ್ಯವಾದ<br><br>उपेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಹೋಗಲು ಶಕ್ಯವಾದ<br><br>

उपेयिवस्
उपेयिवस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿರುವ /ಪಡೆದಿರುವ<br><b>निष्पत्तिः - </b>उप + इण् (गतौ) - "क्वसुः" (३-२-१०७)<br><b>प्रयोगाः - </b>"समत्सरेणासुर इत्युपेयुषा चिराय नाम्नः प्रथमाभिधेयताम्"<br><b>उल्लेखाः - </b>माघ० १-४३<br><br>उपेयिवस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿರುವ /ತಲುಪಿರುವ<br><b>प्रयोगाः - </b>"तत उदग्र इव द्विरदे मुनौ रणमुपेयुषि भीमभुजायुधे"<br><b>उल्लेखाः - </b>किरा० १८-१<br><br>

उपेयुषी
उपेयुषी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उपेयिवस् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><b>प्रयोगाः - </b>"उपेयुषी कल्पलताभिशङ्कया कथन्न्वितस्त्रस्यति षट्पदावलिः"<br><b>उल्लेखाः - </b>किरा० ८-७<br><br>

उपोढ
उपोढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪಕ್ಕೆ ಆಗಮಿಸಿರುವ /ಹತ್ತಿರಕ್ಕೆ ಬಂದಿರುವ<br><b>प्रयोगाः - </b>"युगपद्ददृशे विशन्वराहं तदुपोढैश्च नभश्चरैः पृषत्कः"<br><b>उल्लेखाः - </b>किरा० १३-२३<br><br>उपोढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮದುವೆಯಾಗಿರುವ /ವಿವಾಹ ಮಾಡಿಕೊಂಡಿರುವ<br><br>उपोढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಹಿಸಿರುವ /ಎತ್ತಿಕೊಂಡಿರುವ<br><b>विस्तारः - </b>"उपोढ ऊढे निकटेऽपि" - मेदि० ।<br><br>

उपोत्तम
उपोत्तम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊನೆಯದಕ್ಕೆ ಹಿಂದಿನದಾದ /ಕೊನೆಯದಕ್ಕೆ ಪೂರ್ವದಲ್ಲಿರುವ<br><b>व्युत्पत्तिः - </b>उपगतमुत्तमम्<br><b>प्रयोगाः - </b>"योपधात् गुरूपोत्तमात् वुञ्"<br><b>उल्लेखाः - </b>पा० सू० ५-१-१३२<br><br>

उपोदक
उपोदक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನ ಸಮೀಪ ಪ್ರದೇಶ<br><b>व्युत्पत्तिः - </b>उपगत उदकम्<br><br>उपोदक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರಿನ ಹತ್ತಿರದಲ್ಲಿರುವ<br><b>व्युत्पत्तिः - </b>उदकस्य समीपम्<br><br>उपोदक<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನೀರಿನ ಹತ್ತಿರದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>उदकस्योदादेशः । सञ्ज्ञायां "कन्" । अत इत्वम् ।<br><b>व्युत्पत्तिः - </b>उपाधिकमुदक यत्र ।<br><br>

उपोदिका
उपोदिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಪಸಿ ಗಿಡ<br><br>

उपोद्घात
उपोद्घात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ /ಉಪಕ್ರಮ<br><br>उपोद्घात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೀಠಿಕೆ /ಪ್ರಸ್ತಾವನೆ /ಮುಂದೆ ಪ್ರತಿಪಾದಿಸಲ್ಪಡುವ ವಿಷಯದ ಸಂಕ್ಷಿಪ್ತ ಸೂಚನೆ<br><b>व्युत्पत्तिः - </b>उप समीपे प्रकृतस्य उद्घातः उद्धननं ज्ञापनम् ।<br><br>उपोद्घात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕೃತಕಾರ್ಯ ಸಿದ್ಧಿಸಲು ಕಾರಣವಾದ ಪ್ರಯೋಜನ<br><b>प्रयोगाः - </b>"तदनेन तीर्थेन तत्प्रतिच्छन्दकमुपोद्घाताय माधवान्तिकमुपेयादित्यभिप्रायः"<br><b>उल्लेखाः - </b>मालती० १<br><br>उपोद्घात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದಾಹರಣೆ<br><b>विस्तारः - </b>"उपोद्घात उदाहारः"- अम० ।<br><br>उपोद्घात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಯ ನಿರೂಪಣೆಯ ಸಮಯದಲ್ಲಿರಬೇಕಾದ ೬ ವಿಧ ಸಂಗತಿಗಳಲ್ಲೊಂದು<br><br>

उपोद्बलक
उपोद्बलक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮರ್ಥಿಸುವ /ಸ್ಥಿರಪಡಿಸುವ<br><br>उपोद्बलक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತೇಜನ ಕೊಡುವ /ಪ್ರೋತ್ಸಾಹಿಸುವ<br><b>निष्पत्तिः - </b>उप + उद् + बल (प्राणने) - "ण्वुल्" (३-१-१३३)<br><br>

उपोद्बलन
उपोद्बलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತೇಜನ /ಪ್ರೋತ್ಸಾಹ<br><br>उपोद्बलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮರ್ಥನೆ /ಸ್ಥಿರಪಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + उद् + बल (प्राणने) - "ल्युट्" (३-३-११५)<br><br>

उपोषण
उपोषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪವಾಸ /ಊಟ ಮಾಡದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + उप (दाहे) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"प्राप्ते श्रीरामनवमीदिने मर्त्यो विमूढधीः । उपोषणं न कुरुते कुम्भीपाके महीयते ॥"<br><br>

उपोषित
उपोषित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪವಾಸ /ಊಟ ಮಾಡದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + वस (निवासे) - भावे "क्तः" (३-३-११४)<br><b>प्रयोगाः - </b>"नास्ति स्त्रीणां पृथग्यज्ञो न व्रतं नाप्युपोषितम् । पतिं शुश्रूषते येन तेन स्वर्गे महीयते ॥"<br><br>उपोषित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪವಾಸ ಮಾಡಿದ /ಊಟ ಮಾಡದಿರುವ<br><b>प्रयोगाः - </b>"उपोषितो द्वितीयेऽह्नि पूजयेत् पुनरेव ताम् ।" "पपौ निमेषालसलक्ष्मपङ्क्तिरुपोषिताभ्यामिव लोचनाभ्याम्"<br><b>उल्लेखाः - </b>२)रघु० २-१९<br><br>

उपोष्य
उपोष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪವಾಸ ಮಾಡಲ್ಪಡುವ ಕಾಲ<br><b>निष्पत्तिः - </b>उप + वस (निवासे) - कर्म० "क्यप्" बाहु० ।<br><br>उपोष्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಉಪವಾಸ ಮಾಡಿ<br><b>निष्पत्तिः - </b>उप + वस (निवासे) - "ल्यप्" (७-१-३७)<br><br>

उप्त
उप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿತ್ತಲ್ಪಟ್ಟ ಬೀಜ<br><br>उप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿತ್ತನೆ ಮಾಡಲ್ಪಟ್ಟ ಭೂಮಿ<br><b>निष्पत्तिः - </b>डुवप् (बीजसन्ताने) - "क्तः" (३-२-१०२)<br><br>उप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ಷೌರ ಮಾಡಲ್ಪಟ್ಟ<br><br>

उप्तकृष्ट
उप्तकृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೀಜ ಬಿತ್ತಿದ ನಂತರ ಉಳಲ್ಪಟ್ಟ ಭೂಮಿ<br><b>व्युत्पत्तिः - </b>उप्तं च तत् कृष्टं च<br><br>

उप्ति
उप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೀಜ ಬಿತ್ತುವಿಕೆ<br><b>निष्पत्तिः - </b>डुवप् (बीजसन्ताने) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"बीजानामुप्तिविच्च स्यात् क्षेत्रदोषगुणस्य च"<br><b>उल्लेखाः - </b>मनु० ९-३३०<br><br>उप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ಷೌರ ಮಾಡುವಿಕೆ<br><br>

उप्त्रिम
उप्त्रिम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿತ್ತನೆಯಿಂದ ಉಂಟಾದ /ಬಿತ್ತನೆಯಿಂದ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>डुवप् (बीजसन्ताने) - "क्त्रिः" (३-३-८८) । "मप्" (४-४-२०)<br><b>व्युत्पत्तिः - </b>वपनेन निर्वृत्तम्<br><br>

उप्य
उप्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿತ್ತನೆಗೆ ಯೋಗ್ಯವಾದ ಬೀಜ<br><b>निष्पत्तिः - </b>डुवप् (बीजसन्ताने) -कर्म० "क्यप्" बाहु० ।<br><br>

उभ
उभ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎರಡು<br><br>उभ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಬ್ಬರು<br><b>निष्पत्तिः - </b>उम (पूरणे) - "कः" (३-१-१३५)<br><br>उभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಬ್ಬರು<br><b>प्रयोगाः - </b>"उभौ यदि व्योम्नि पृथक्प्रवाहावाकाशगङ्गापयसः पतेयाम्"<br><b>उल्लेखाः - </b>माघ० ३-८<br><br>उभ<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಬ್ಬರು<br><br>उभ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎರಡು<br><b>प्रयोगाः - </b>"उभे एव क्षमे वोढुमुभयोर्बीजमाहितम् । सा वा शम्भोस्तदीया वा मूर्तिर्जलमयी मम ॥"<br><b>उल्लेखाः - </b>कुमा० २-६०<br><br>

उभय
उभय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎರಡು ಅವಯವಗಳಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>उभ - "अयच्" (५-२-४४)<br><br>उभय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎರಡು ಅವಯವಗಳಿಂದ ಕೂಡಿದ<br><br>उभय<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎರಡು ಅವಯವಗಳಿಂದ ಕೂಡಿದ<br><br>उभय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎರಡು ಅವಯವಗಳಿಂದ ಕೂಡಿದ<br><b>प्रयोगाः - </b>"अलङ्घनीयताहेतुरुभयं तन्मनस्विनि" । "तस्य मित्राण्यमित्रास्ते ये च ये चोभये नृपाः" । "किं कथ्यते श्रीरुभयस्य तस्य" ।<br><b>उल्लेखाः - </b>माघ० २-४८, माघ० २-१०१, कुमा० ७-७८<br><br>

उभयतस्
उभयतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎರಡು ಕಡೆಗಳಿಂದಲೂ<br><b>निष्पत्तिः - </b>उभय - "तसिल्" (५-३-७)<br><b>प्रयोगाः - </b>"उद्धतैरिव परस्परसङ्गादीरितान्युभयतः कुचकुम्भैः"<br><b>उल्लेखाः - </b>माघ० १०-३२<br><br>उभयतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎರಡು ಕಡೆಗಳಲ್ಲಿಯೂ<br><b>प्रयोगाः - </b>"तज्जः पुनात्युभयतः पुरुषानेकविंशतिम्"<br><b>उल्लेखाः - </b>याज्ञ० १-५८<br><br>उभयतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎರಡು ಕಡೆಗಳಿಗೂ<br><b>प्रयोगाः - </b>"शक्तिः चोभयतस्तीक्ष्णामायसं दण्डमेव वा"<br><b>उल्लेखाः - </b>मनु० ८-३१५<br><br>

उभयतोमुख
उभयतोमुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎರಡು ಕಡೆಯೂ ಮುಖವುಳ್ಳ<br><br>उभयतोमुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎರಡು ಕಡೆಗೂ ನೋಡುವ<br><br>

उभयतोमुखी
उभयतोमुखी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಳು /ಹಸು<br><b>प्रयोगाः - </b>"सवत्सारोमतुल्यानि युगान्युभयतोमुखीम्"<br><b>उल्लेखाः - </b>याज्ञ० १-२०६<br><br>

उभयत्र
उभयत्र<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎರಡು ಕಡೆಗಳಲ್ಲಿಯೂ<br><b>निष्पत्तिः - </b>उभ - "त्रल्" (५-३-१०)<br><br>उभयत्र<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎರಡು ವಿಷಯಗಳಲ್ಲಿಯೂ<br><b>प्रयोगाः - </b>"द्वौ दैवे पितृकार्ये त्रीनेकैकमुभयत्र वा"<br><b>उल्लेखाः - </b>मनु० ३-१२५<br><br>

उभयथा
उभयथा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎರಡು ರೀತಿಯಲ್ಲಿಯೂ /ಎರಡು ವಿಧದಲ್ಲಿಯೂ<br><b>निष्पत्तिः - </b>उभ - "अयच्" थाल्"(५-३-२३)<br><br>

उभयद्युस्
उभयद्युस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎರಡು ದಿನಗಳಲ್ಲಿಯೂ<br><b>निष्पत्तिः - </b>उभय - "द्युस्" (वा० ५-३-२२)<br><br>

उभयवेतन
उभयवेतन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎರಡು ಕಡೆಗಳಲ್ಲಿಯೂ ಸಂಬಳ ಪಡೆಯುವ ದೂತ<br><b>व्युत्पत्तिः - </b>उभयोः वेतनं यस्य<br><br>

उभयेद्युस्
उभयेद्युस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>उभयद्युस् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>उभय - "एद्युस्" (५-३-२२)<br><br>

उम्
उम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ರೋಷ /ಕೋಪ<br><br>उम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ<br><br>उम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ /ಸಂಮತಿ<br><b>विस्तारः - </b>"उम् रोषेऽङ्गीकृतावपि । प्रश्नेऽपि स्यात्"- मेदि० ।<br><br>

उमा
उमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರ್ವತಿ /ಗೌರಿ /ಶಿವನ ಪತ್ನಿ<br><b>व्युत्पत्तिः - </b>ओः शिवस्य मा लक्ष्मीरिव, उं शिवं माति इति वा । उ, मा इति मात्रा तपसे निषिद्धत्वाद्वा ।<br><b>प्रयोगाः - </b>"उमेति मात्रा तासो निषिद्धा पश्चादुमाख्यां सुमुखी जगाम" । "उमापि नीलालकमध्यशोभि विस्रंसयन्ती नवकर्णिकारम्" ।<br><b>उल्लेखाः - </b>कुमा० १-२६, कुमा० ३-६२<br><br>उमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸೆ ಗಿಡ<br><br>उमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರಿಶಿನ<br><br>उमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೀರ್ತಿ /ಯಶಸ್ಸು<br><br>उमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶ /ಬೆಳಕು<br><b>विस्तारः - </b>"उमातसीहैमवतीहरिस्राकीर्तिकान्तिषु" - मेदि० ।<br><br>

उमाकट
उमाकट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಿಶಿನ ಪುಡಿ<br><b>निष्पत्तिः - </b>"कटच्" (वा० ५-२-२९)<br><b>व्युत्पत्तिः - </b>उमाया हरिद्राया अतस्या वा रजः<br><br>उमाकट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸೆ ಹೂವಿನ ಪುಡಿ<br><br>

उमातनय
उमातनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಕಂದ /ಕುಮಾರ ಸ್ವಾಮಿ<br><br>उमातनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಣಪತಿ /ವಿನಾಯಕ<br><br>

उमासुत
उमासुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಕಂದ /ಕುಮಾರ ಸ್ವಾಮಿ<br><br>उमासुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಣಪತಿ /ವಿನಾಯಕ<br><br>

उमापति
उमापति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ /ಶಿವ<br><b>व्युत्पत्तिः - </b>उमायाः पतिः<br><b>प्रयोगाः - </b>"अभिनवौषसरागभृता बभौ जलधरेण समानमुपापतिः"<br><b>उल्लेखाः - </b>किरा० १८-४<br><br>

उमावन
उमावन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶೋಣಿತಪುರ<br><b>विस्तारः - </b>"देवीकोट उमावनम् । कोटिवर्षं बाणापुरं स्यात् शोणितपुरं च तत्"- अभि० चि०<br><br>

उमासहचर
उमासहचर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ /ಶಿವ<br><b>व्युत्पत्तिः - </b>उमायाः सहचरः<br><br>

उमासहाय
उमासहाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ /ಶಿವ<br><b>व्युत्पत्तिः - </b>उमायाः सहायः<br><br>

उम्बर
उम्बर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸಕಾಲಿನ ಕೆಳಗಿನ ಮರದ ಪಟ್ಟಿ<br><b>विस्तारः - </b>"ग्रहावग्रहणी देहल्युम्बरोदुम्बरोम्बुराः" - अभि० चि० ।<br><br>

उम्बुर
उम्बुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸಕಾಲಿನ ಕೆಳಗಿನ ಮರದ ಪಟ್ಟಿ<br><br>

उम्य
उम्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸೆ ಗಿಡ ಬೆಳೆಯಲು ಯೋಗ್ಯವಾದ ಭೂಮಿ<br><b>निष्पत्तिः - </b>उमा -"यत्" (५-२-४)<br><b>व्युत्पत्तिः - </b>उमानां भवनं क्षेत्रम्<br><b>विस्तारः - </b>"भङ्ग्यं भङ्गीनमौमीनमुम्यं यव्यं यवक्यवत्" - अभि० चि० ।<br><br>

उरःसूत्रिका
उरःसूत्रिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಕ್ತಾಹಾರ /ಮುತ್ತುಗಳಿಂದ ರಚಿತವಾದ ಸರ<br><b>व्युत्पत्तिः - </b>उरसः सूत्रमिव<br><b>विस्तारः - </b>"अथोरःसूत्रिका मौक्तिकैः कृता" - अम० ।<br><br>

उरःस्थल
उरःस्थल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎದೆ /ಗುಂಡಿಗೆ<br><b>व्युत्पत्तिः - </b>उरसः स्थलम्<br><b>प्रयोगाः - </b>"शिलाघनैर्नाकसदामुरःस्थलैर्बृहन्निवेशैश्च वधूपयोधरैः"<br><b>उल्लेखाः - </b>किरा० ८-३२<br><br>

उरग
उरग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ /ಹಾವು<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "डः" (वा० ३-२-४८)<br><b>व्युत्पत्तिः - </b>उरसा गच्छति<br><b>प्रयोगाः - </b>"तवाभिधानात् व्यथते नताननः सुदुःसहान्मन्त्रपदादिवोरगः"<br><b>उल्लेखाः - </b>किरा० १-२४<br><br>उरग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೀಸ ಲೋಹ<br><br>उरग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ಲೇಷಾ ನಕ್ಷತ್ರ<br><br>

उरगी
उरगी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಹಾವು<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

उरगभूषण
उरगभूषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ /ಶಿವ<br><b>व्युत्पत्तिः - </b>उरगो भूषणमस्य<br><br>

उरगराज
उरगराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸುಕಿ /ಆದಿಶೇಷ /ಸರ್ಪರಾಜ<br><b>निष्पत्तिः - </b>"टच्" (५-४-९१)<br><b>व्युत्पत्तिः - </b>उरगाणां सर्पाणां राजा<br><b>प्रयोगाः - </b>"प्रहर्तुरेवोरगराजरज्जवो जवेन कण्ठं सभयाः प्रपेदिरे"<br><b>उल्लेखाः - </b>माघ० १-५६<br><br>

उरगाशन
उरगाशन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರುಡ<br><br>उरगाशन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನವಿಲು /ಮಯೂರ<br><b>निष्पत्तिः - </b>अश (भोजने) - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उरगानश्नाति<br><b>प्रयोगाः - </b>"चञ्च्वग्रदष्टचटुलाहिपताकयान्ये स्वावासभागमुरगाशनकेतुयष्ट्या"<br><b>उल्लेखाः - </b>माघ० ५-१३<br><br>

उरण
उरण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಡುಕುರಿ /ಟಗರು<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "क्युन्" "उत्" च (उ० ५-१७)<br><b>व्युत्पत्तिः - </b>ऋच्छति<br><b>प्रयोगाः - </b>"वृकीवोरणमासाद्य मृत्युरादाय गच्छति"<br><b>उल्लेखाः - </b>भा०<br><br>

उरणी
उरणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಕುರಿ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

उरणाक्ष
उरणाक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಗಸಿಗೆ ಗಿಡ<br><b>विस्तारः - </b>"दद्रुघ्नश्चक्रमर्दकः । पद्माट उरणाक्षश्च"- अम० ।<br><br>

उरभ्र
उरभ्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಡುಕುರಿ /ಟಗರು<br><b>निष्पत्तिः - </b>भ्रमु (चलने) - "डः" (वा० ३-२-१०१)<br><b>व्युत्पत्तिः - </b>उरु भ्रमति<br><br>

उरभ्री
उरभ्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಕುರಿ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>उरभ्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಗಸಿಗೆ ಗಿಡ<br><br>

उररी
उररी<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ /ಸಂಮತಿ<br><br>उररी<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿಸ್ತಾರ<br><b>निष्पत्तिः - </b>ऊयी (तन्तुसन्ताने) - "ररीक्" बाहु० ।<br><br>

उररीकारः
उररीकारः<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ /ಸಂಮತಿ<br><b>निष्पत्तिः - </b>उररी +कृञ् - भावे "घञ्" (३-३-१८)<br><br>

उररीकरणम्
उररीकरणम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ /ಸಂಮತಿ<br><b>निष्पत्तिः - </b>उररी +कृञ् - भावे "ल्युट्" (३-३-११५)<br><br>

उररीकृत्य
उररीकृत्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕರಿಸಿ /ಸಂಮತಿಸಿ<br><b>निष्पत्तिः - </b>उररी +कृञ् - "ल्यप्" (७-१-३७)<br><b>प्रयोगाः - </b>"काल्पनिकं भेदमुररीकृत्य कर्मकर्तरि वा प्रयोगः"<br><b>उल्लेखाः - </b>सा० द०<br><br>

उररीकृत्
उररीकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಪ್ಪಲ್ಪಟ್ಟ /ಸಂಮತಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उररी +कृञ् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"कुण्डिनेन्द्रसुतया किल पूर्वं मां वरीतुमुररीकृतमास्ते"<br><b>उल्लेखाः - </b>नैष० ५-११४<br><br>

उरस्
उरस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಕ್ಷಃಸ್ಥಲ /ಎದೆ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "असुन्" उरादेशश्च (उ० ४-१५५)<br><b>व्युत्पत्तिः - </b>इयर्ति<br><b>प्रयोगाः - </b>"उरसि शूलभृतः प्रहिता मुहुः प्रतिहतिं ययुरर्जुनमुष्टयः"<br><b>उल्लेखाः - </b>किरा० १५-५<br><br>उरस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಖ್ಯವಾದ /ಪ್ರಧಾನವಾದ<br><b>विस्तारः - </b>"उरो वक्षसि मुख्ये च" - हेम० ।<br><br>

उरसिज
उरसिज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸರ ಮೊಲೆ /ಸ್ತನ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९७)<br><b>व्युत्पत्तिः - </b>उरसि वक्षसि जायते<br><b>प्रयोगाः - </b>"परिपस्पृशिरे चैनं पीनैरुरसिजैर्मुहुः"<br><b>उल्लेखाः - </b>रामा०<br><br>उरसिज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದೆಯಲ್ಲಿ ಹುಟ್ಟಿದ<br><br>

उरसिरुह
उरसिरुह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸರ ಮೊಲೆ /ಸ್ತನ<br><b>निष्पत्तिः - </b>रुह (बीजजन्मनि प्रादुर्भावे च) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>उरसि रोहति<br><b>प्रयोगाः - </b>"फेनानामुरसिरुहेषु हारलीला चेलश्रीर्जघनतलेषु शैवालानाम्"<br><b>उल्लेखाः - </b>माघ० ८-५९<br><br>उरसिरुह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದೆಯಲ್ಲಿ ಹುಟ್ಟಿದ<br><br>

उरसिल
उरसिल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಶಾಲವಾದ ಎದೆಯುಳ್ಳ /ಶ್ರೇಷ್ಠವಾದ ಎದೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"इलच्" (५-२-१००)<br><b>व्युत्पत्तिः - </b>प्रशस्तमुरो यस्य<br><br>

उरस्वत्
उरस्वत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಶಾಲವಾದ ಎದೆಯುಳ್ಳ /ಶ್ರೇಷ್ಠವಾದ ಎದೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>प्रशस्तमुरो यस्य<br><br>

उरस्त्र
उरस्त्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕವಚ /ಅಂಗಿ<br><b>निष्पत्तिः - </b>त्रैङ् (पालने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>उरः त्रायते<br><br>

उरस्य
उरस्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರ /ಮಗ<br><b>निष्पत्तिः - </b>"यत्" (४-४-९४)<br><b>व्युत्पत्तिः - </b>उरसा निर्मितः<br><br>उरस्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದೆಯಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"यत्" (४-३-५५)<br><b>व्युत्पत्तिः - </b>उरसि भवः<br><br>

उरी
उरी<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ /ಸಂಮತಿ<br><b>निष्पत्तिः - </b>उर (गतौ) - "रीक्" बाहु० ।<br><br>उरी<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿಸ್ತಾರ<br><br>

उरीकरण
उरीकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ /ಸಂಮತಿ<br><b>निष्पत्तिः - </b>उरी +कृञ् - "ल्युट्" (३-३-११५)<br><br>उरीकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಸ್ತರಿಸುವಿಕೆ<br><br>

उरीकार
उरीकार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಸ್ತರಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>उरी +कृञ् - भावे "घञ्" (३-३-१८)<br><br>

उरीकृत
उरीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕರಿಸಲ್ಪಟ್ಟ /ಒಪ್ಪಲ್ಪಟ್ಟ<br><br>उरीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಸ್ತರಿಸಲ್ಪಟ್ಟ<br><br>उरीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವೀಕರಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"न खलु मुष्टिरुररीकृतबन्धनः"<br><b>उल्लेखाः - </b>नैष० ४-८४<br><br>

उरु
उरु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೊಡ್ಡದಾದ<br><b>निष्पत्तिः - </b>ऊर्णुञ् (आच्छादने) - "कुः" ह्रस्वश्च (उ० १-३१)<br><b>व्युत्पत्तिः - </b>उर्णोति<br><b>प्रयोगाः - </b>"शुक्लैर्मयूखनिचयैः परिवीतमूर्तिर्वप्राभिघातपरिमण्डलितोरुदेहः"<br><b>उल्लेखाः - </b>किरा० ५-४२<br><br>उरु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಸ್ತಾರವಾದ /ಅಗಲವಾದ<br><br>उरु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಿಕವಾದ /ಹೆಚ್ಚಾದ<br><b>प्रयोगाः - </b>"स पिशङ्गजटावलिः किरन्नुरुतेजः परमेण मन्युना"<br><b>उल्लेखाः - </b>किरा० १५-४७<br><br>उरु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ<br><br>

उर्वी
उर्वी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उरु ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-४४)<br><b>प्रयोगाः - </b>"शरावृष्टिं विधूयोर्वीं स्रग्विणो रक्तवाससः"<br><b>उल्लेखाः - </b>मनु० ८-२५६<br><br>उर्वी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿ /ನೆಲ /ಪೃಥ್ವಿ<br><b>निष्पत्तिः - </b>ऊर्णुञ् (आच्छादने) - "उः" रस्वः नुलोपश्च (उ० १-३१) । "ङीष्" (४-१-४४)<br><b>व्युत्पत्तिः - </b>ऊर्णोति<br><b>प्रयोगाः - </b>"प्रश्नोदग्रप्लुतत्वात् वियति बहुतरं स्तिकमुर्व्यां प्रयाति"<br><b>उल्लेखाः - </b>शाकु० १-७<br><br>

उरुक्रम
उरुक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಮನಾತಾರವನ್ನೆತ್ತಿದ ಮಾಹವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>उरवः बहवः क्रमाः पादविक्षेपाः अस्य<br><b>प्रयोगाः - </b>"यस्योरुषु त्रिषु विक्रमणेषु । अधिक्षियन्ति भुवनानि विश्वा"<br><b>उल्लेखाः - </b>श्रुतिः<br><br>

उरुगाय
उरुगाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>गै (शब्दे) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>उरुभिः श्रेष्ठैः गीयते<br><br>उरुगाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಹೊಗಳಿಕೆ /ಅಧಿಕವಾಗಿ ಸ್ತೋತ್ರ ಮಾಡುವಿಕೆ<br><br>उरुगाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಸ್ತಾರವಾದ ಪ್ರದೇಶದಲ್ಲಿ ಸಂಚಾರ<br><b>निष्पत्तिः - </b>गाङ् (गतौ) - भावे "घञ्" (३-३-१८) । "युक्" (७-३-३३)<br><b>व्युत्पत्तिः - </b>उरुषु गानम्<br><br>

उरुबूक
उरुबूक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹರಳು ಗಿಡ<br><b>निष्पत्तिः - </b>ओ वै (शोषणे) - "ऊकः" (उ० ४-४१)<br><b>व्युत्पत्तिः - </b>उरुं महान्तं वायुं वायाति<br><b>विस्तारः - </b>"एरण्ड ऊरुबूकश्च रुचकश्चित्रकश्च सः" - अम० ।<br><br>

उरोज
उरोज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸರ ಮೊಲೆ /ಸ್ತನ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>उरसि जायते<br><b>प्रयोगाः - </b>"स्नान्तीनां बृहदमलोदबिन्दुचित्रौ रेजाते रुचिरदृशामुरोजकुम्भौ"<br><b>उल्लेखाः - </b>माघ० ८-५३<br><br>उरोज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದೆಯಲ್ಲಿ ಹುಟ್ಟಿದ<br><br>

उरोभू
उरोभू<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದೆಯಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>भू (सत्तायाम्) - "क्विप्"(३-२-१७९)<br><b>व्युत्पत्तिः - </b>उरसि भवति<br><b>प्रयोगाः - </b>"उरोभुवा कुम्भयुगेन जृम्भितम्"<br><b>उल्लेखाः - </b>नैष० १-४८<br><br>

उरोभूषण
उरोभूषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾರ /ಸರ<br><b>निष्पत्तिः - </b>भूष (अलङ्कारे) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>उरो भूष्यतेऽनेन<br><br>उरोभूषण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎದೆಯನ್ನು ಅಲಂಕರಿಸುವ<br><b>निष्पत्तिः - </b>भूष (अलङ्कारे) +णिच् - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उरो भूषयति<br><br>

उर्वट
उर्वट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂವತ್ಸರ<br><b>निष्पत्तिः - </b>अट (गतौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उरु यथातथाऽटति<br><b>विस्तारः - </b>"ऋतुवृत्तिर्मासमानः स्यात्कालग्रन्थिरुर्वटः" - त्रिकाण्ड० ।<br><br>

उर्वरा
उर्वरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಕಲ ಪೈರುಪಚ್ಚೆಗಳಿಂದ ಕೂಡಿದ ಭೂಮಿ /ಫಲವತ್ತಾದ ಜಮೀನು<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "अच्" (३-१-१३४) । उर्वी (हिंसायाम्) - "घः" (३-३-१२५) वा ।<br><b>व्युत्पत्तिः - </b>उरु प्रभूतं शस्यादिकं ऋच्छति<br><b>प्रयोगाः - </b>"तीक्ष्णविशिखमुखपीतमसृक्पततां गणैः पिबतु साधुमुर्वरा"<br><b>उल्लेखाः - </b>माघ० १५-६६<br><br>उर्वरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಮೀನು /ಭೂಮಿ<br><b>विस्तारः - </b>"उर्वरा तु भूमात्रे सर्वस्याढ्यभुव्यपि" - हेम० ।<br><br>

उर्वशी
उर्वशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವಲೋಕದ ಒಬ್ಬ ವೇಶ್ಯೆ /ಪ್ರಖ್ಯಾತಳಾದ ಒಬ್ಬ ಅಪ್ಸರಸ್ಸು<br><b>निष्पत्तिः - </b>अशू (व्याप्तौ) - "कः" (३-२-४) । गौरा० "ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>उरून् महतोऽपि अश्नुते वशिकरोति<br><b>प्रयोगाः - </b>"उर्वशी गुणवशीकृतविश्वा"<br><b>उल्लेखाः - </b>नैष० ५-५२<br><br>

उर्वारु
उर्वारु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೌತೆಗಿಡ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "उण्" (बाहु० ।<br><b>व्युत्पत्तिः - </b>उरु यथातथा ऋच्छति<br><br>

उर्वीतल
उर्वीतल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿಯ ಮೇಲುಭಾಗ /ನೆಲದ ಮೇಲು ಮೈ<br><b>व्युत्पत्तिः - </b>उर्व्यास्तलम्<br><b>प्रयोगाः - </b>"नीतो विक्रमबाहुरात्मसमतां प्राप्तेयमुर्वीतले सारं सागरिका तथा च भुवनप्राप्त्येकहेतुः प्रिया"<br><b>उल्लेखाः - </b>रत्ना० ४-२०<br><br>

उर्वीधर
उर्वीधर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತ /ಬೆಟ್ಟ<br><b>निष्पत्तिः - </b>धृञ् (धारणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>धरति । उर्व्याः धरः ।<br><b>प्रयोगाः - </b>"अलकाधिपभृत्यदर्शितं शिवमुर्वीधरवर्त्म सम्प्रयान्"<br><b>उल्लेखाः - </b>किरा० ३-५९<br><br>

उर्वीधव
उर्वीधव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ /ದೊರೆ<br><b>व्युत्पत्तिः - </b>उर्व्याः धवः<br><br>

उर्वीनाथ
उर्वीनाथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ /ದೊರೆ<br><b>व्युत्पत्तिः - </b>उर्व्याः नाथः<br><br>

उर्वीपति
उर्वीपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ /ದೊರೆ<br><b>व्युत्पत्तिः - </b>उर्व्याः पतिः<br><br>

उर्वीभुज्
उर्वीभुज्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ /ದೊರೆ<br><b>निष्पत्तिः - </b>भुज (पालनाभ्यवहारयोः) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>उर्वीं भुङ्क्ते<br><br>

उर्वीभृत्
उर्वीभृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ /ದೊರೆ<br><br>उर्वीभृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತ /ಬೆಟ್ಟ<br><b>निष्पत्तिः - </b>डुभृञ् (धारणपोषणयोः) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>उर्वीं बिभर्ति<br><br>

उर्वीरुह
उर्वीरुह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಕ್ಷ /ಮರ /ಗಿಡ<br><b>निष्पत्तिः - </b>रुह (बीजजन्मनि प्रादुर्भावे च) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>उर्व्यां रोहति<br><b>प्रयोगाः - </b>"बलाक्रान्तः क्रीडद्द्विरदमथितोर्वीरुहरवैः"<br><b>उल्लेखाः - </b>माघ० ५-६९<br><br>उर्वीरुह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೂಮಿಯಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>प्रयोगाः - </b>"विहङ्गराजाङ्गरुहैरिवायतैर्हिरण्मयोर्वीरुहवल्लितन्तुभिः"<br><b>उल्लेखाः - </b>माघ० १-७<br><br>

उलप
उलप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲತೆ /ಹಬ್ಬಿರುವ ಬಳ್ಳಿ<br><b>निष्पत्तिः - </b>वल (संवरणे) - "कपन्" सम्प्रसारणं च (उ० ३-१४५)<br><b>व्युत्पत्तिः - </b>वलति<br><br>उलप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೃದುವಾದ ಒಂದು ಜಾತಿಹುಲ್ಲು<br><b>प्रयोगाः - </b>"अविरलविततेव शक्रगोपैररुणितनीलतृणोपला धरित्री"<br><b>उल्लेखाः - </b>किरा० १०-३<br><br>

उलूक
उलूक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೂಬೆ<br><b>निष्पत्तिः - </b>वल (संवरणे) - "ऊकः" सम्प्रसारणं च निपाओ (उ० ४-४१)<br><b>प्रयोगाः - </b>"कुमुदवनमपश्रि श्रीमदम्भोजषण्डं त्यजति मुदमुलूकः प्रीतिमांश्चक्रवाकः"<br><b>उल्लेखाः - </b>माघ० ११-६४<br><br>उलूक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><br>उलूक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಯೋಧನನ ಒಬ್ಬ ದೂತ /ಮಹಾಭಾರತ ಯುದ್ಧದ ಒಬ್ಬ ದೂತ<br><b>विस्तारः - </b>"स्यादुलूकः काकशत्राविन्द्रे भारतयोधिनि" - हेम० ।<br><br>उलूक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದೇಶ ಮತ್ತು ಆ ದೇಶದ ಜನರು<br><b>प्रयोगाः - </b>"उलूकवासिनं राजन् बृहन्तमुपजग्मिवान्" । "उलूकानुत्तरांश्चैव तांश्च राज्ञः समानयत्" ।<br><b>उल्लेखाः - </b>भा० सभा० २८-५, भा० सभा० २८-११<br><br>

उलूखल
उलूखल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒರಳು /ಕುಟ್ಟಲು ಧಾನ್ಯವನ್ನು ಹಾಕುವ ಕಲ್ಲಿನ ಅಥವಾ ಮರದ ಪಾತ್ರೆ<br><b>निष्पत्तिः - </b>ला (आदाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>ऊर्ध्वं खं उलखम् ।प्र्षो० । उलूखं लाति<br><b>प्रयोगाः - </b>"वनस्पतिभ्य इत्येवं मुसलोलूखले हरेत्"<br><b>उल्लेखाः - </b>मनु० ३-८८<br><br>

उलूखलक
उलूखलक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒರಳು /ಕುಟ್ಟಲು ಧಾನ್ಯವನ್ನು ಹಾಕುವ ಕಲ್ಲಿನ ಅಥವಾ ಮರದ ಪಾತ್ರೆ<br><br>उलूखलक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಪತ್ತು<br><br>उलूखलक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಗ್ಗುಳದ ಮರ<br><b>विस्तारः - </b>"कुम्भोलूखलके क्लीबे कौशिको गुग्गुलः पुरः" - अम० ।<br><br>

उलूपिन्
उलूपिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರದ ಒಂದು ಜಾತಿಯ ಮೀನು /ತಿಮಿಂಗಿಲ ಜಾತಿಯ ಪ್ರಾಣಿ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>उ विस्मयकारकं रूपमस्यास्ति<br><br>

उलूपी
उलूपी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ನಾಗಕನ್ಯೆ /ಕೌರವ್ಯನೆಂಬ ಸರ್ಪರಾಜನ ಮಗಳು<br><br>

उल्का
उल्का<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾಶದಲ್ಲಿ ಕಾಣಿಸಿಕೊಳ್ಳುವ ಒಂದು ತೇಜಸ್ಸಿನ ರಾಶಿ /ಬಾಲಚುಕ್ಕಿ<br><b>निष्पत्तिः - </b>उष (दाहे) - "कक्" षस्य लश्च (उ० ३-४२)<br><b>प्रयोगाः - </b>"परमास्त्रपरिग्रहोरुतेजः स्फुरदुल्काकृति विक्षिपन्वनेषु"<br><b>उल्लेखाः - </b>किरा० १३-२६<br><br>उल्का<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೀವಟಿಗೆ /ಇಲಾಲು /ಪಂಜು<br><br>उल्का<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಕಿ /ಉರಿ<br><b>प्रयोगाः - </b>"बाधेतोल्काक्षपितचमरीबालभारो दवाग्निः"<br><b>उल्लेखाः - </b>मेघ० १-५३<br><br>

उल्कापात
उल्कापात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾಶದಿಂದ ಬೆಂಕಿ ಬೀಳುವುದು<br><b>व्युत्पत्तिः - </b>उल्कायाः पातः<br><br>

उल्कामुख
उल्कामुख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಳ್ಳಿದೆವ್ವ /ಬಾಯಿಂದ ಬೆಂಕಿಯನ್ನು ಉಗುಳುವ ಪಿಶಾಚಿ<br><b>व्युत्पत्तिः - </b>उल्का मुखे यस्य<br><b>प्रयोगाः - </b>"विद्युत्पुञ्जनिकाशकेशनयनभ्रूश्मश्रुजालैर्नभो लक्ष्यालक्ष्यविशुष्कदीर्घवपुषामुल्कामुखानां मुखैः"<br><b>उल्लेखाः - </b>मालती० ५-१३<br><br>

उल्ब
उल्ब<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ಭಕೋಶ /ಗರ್ಭಾಶಯ /ಗರ್ಭದ ಮೇಲಿನ ಹೊದಿಕೆಯ ಚೀಲ<br><b>निष्पत्तिः - </b>उच (समवाये) - "बन्" (उ० ४-९५)<br><b>प्रयोगाः - </b>"यथोल्बेनावृतो गर्भः तथा तेनेदमावृतम्"<br><b>उल्लेखाः - </b>गीता० ३-३८<br><br>

उल्बण
उल्बण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಕಟವಾದ /ಅಧಿಕವಾದ /ಹೆಚ್ಚಾದ /ಮಿತಿಮೀರಿದ<br><b>निष्पत्तिः - </b>बण (शब्दे) - "अच्" (३-१-१३४) । पृषो० ।<br><b>व्युत्पत्तिः - </b>उत् बणति<br><b>प्रयोगाः - </b>"केनचिन्मधुरमुल्बणरागं बाष्पतप्तमधिकं विरहेषु"<br><b>उल्लेखाः - </b>माघ० १०-५४<br><br>उल्बण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೊಡ್ಡದಾದ /ಹಿರಿಯದಾದ<br><b>प्रयोगाः - </b>"रिपुरुल्बणभीमभोगभाजां भुजगानां जननीं जजाप विद्याम्"<br><b>उल्लेखाः - </b>माघ० २०-४१<br><br>उल्बण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಂದರೆಯಿಲ್ಲದ /ಅಡ್ಡಿ ಆತಂಕಗಳಿಲ್ಲದ<br><b>प्रयोगाः - </b>"त्याजितैः फलमुत्खातैर्भग्नैश्च बहुधा नृपैः । तस्यासीदुल्बणो मार्गः पादपैरिव दन्तिनः ॥"<br><b>उल्लेखाः - </b>रघु० ४-३३<br><br>

उल्मुक
उल्मुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯದುವಂಶದ ಒಬ್ಬ ದೊರೆ<br><br>उल्मुक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಕಿಯ ಕೆಂಡ /ಅಂಗಾರ<br><b>निष्पत्तिः - </b>उष (दाहे) - "मुकः" षस्य लश्च (उ० ३-८४)<br><b>प्रयोगाः - </b>"उल्मुखेन द्रुमं प्राप्य सङ्कुचत्पत्रसम्पदम् । तेजः प्रकिरता दिक्षु सप्रतापमदीप्यत् ॥"<br><b>उल्लेखाः - </b>माघ० १९-८<br><br>उल्मुक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧಬೆಂದಿರುವ ಕಟ್ಟಿಗೆ /ಕೊಳ್ಳಿ<br><br>

उल्लङ्घन
उल्लङ्घन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೀರುವುದು /ಅತಿಕ್ರಮಿಸುವುದು<br><b>निष्पत्तिः - </b>उद् + लघि (गतौ) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"वेलोल्लङ्घनमेतेषां शोकोदन्वति तन्वति"<br><b>उल्लेखाः - </b>चं० रा०<br><br>उल्लङ्घन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರುವುದು<br><br>उल्लङ्घन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಾಟುವುದು<br><br>

उल्लङ्घनीय
उल्लङ्घनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮಿಸಲು ಯೋಗ್ಯವಾದ<br><br>उल्लङ्घनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮಿಸಲು ಶಕ್ಯವಾದ<br><br>उल्लङ्घनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮಿಸಲ್ಪಡುವ<br><br>उल्लङ्घनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾಟಲು ಯೋಗ್ಯವಾದ<br><br>उल्लङ्घनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾಟಲು ಶಕ್ಯವಾದ<br><br>उल्लङ्घनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾಟಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उद् + लघि (गतौ) - अर्हादौ "अनीयर्" (३-१-९६)<br><br>

उल्लङ्घयत्
उल्लङ्घयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮಿಸುತ್ತಿರುವ /ಮೀರುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + लघि (गतौ) +णिच् - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"उल्लङ्घयन् मम समुज्जलतः प्रतापं कोपस्य नन्दकुलकाननधूमकेतोः"<br><b>उल्लेखाः - </b>मुद्रा० १-१०<br><br>उल्लङ्घयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರುತ್ತಿರುವ /ಮೇಲಕ್ಕೆ ನೆಗೆಯುತ್ತಿರುವ<br><br>उल्लङ्घयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾಟುತ್ತಿರುವ<br><br>उल्लङ्घयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮಿಸುವಂತೆ ಮಾಡುತ್ತಿರುವ<br><br>उल्लङ्घयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರಿಸುತ್ತಿರುವ<br><br>उल्लङ्घयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾಟಿಸುತ್ತಿರುವ<br><br>

उल्लङ्घित
उल्लङ्घित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + लघि (गतौ) - "क्तः"(३-२-१०२)<br><b>प्रयोगाः - </b>"अम्भोभिरुल्लङ्घिततुङ्गरोधसः प्रतापनाम्नीः कुरुते स्म निम्नगाः"<br><b>उल्लेखाः - </b>माघ० १२-५७<br><br>उल्लङ्घित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಾರಲ್ಪಟ್ಟ /ನೆಗೆಯಲ್ಪಟ್ಟ<br><br>उल्लङ्घित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾಟಲ್ಪಟ್ಟ<br><br>

उल्लङ्घितव्य
उल्लङ्घितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>उल्लङ्घनीय ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>उद् + लघि (गतौ) - "तव्यः" (३-१-९६)<br><br>

उल्लङ्घितशासन
उल्लङ्घितशासन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಜ್ಞೆಯನ್ನು ಮೀರಿದ /ಅಪ್ಪಣೆಯನ್ನು ಮುರಿದ<br><b>व्युत्पत्तिः - </b>उल्लङ्घितं शासनं येन<br><br>

उल्लल
उल्लल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಲಿಸುವ /ಹೊರಟಿರುವ<br><b>निष्पत्तिः - </b>उद् + लल (विलासे) - "अच्" (३-१-१३४) ।<br><br>उल्लल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರಾಡುತ್ತಿರುವ /ನೆಗೆಯುತ್ತಿರುವ<br><br>

उल्ललत्
उल्ललत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>उल्ललत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>""निर्धूतवीतमपि बालकमुल्ललन्तं यन्ता क्रमेण परिसान्त्वनतर्जनाभिः"<br><b>उल्लेखाः - </b>माघ० ५-४७<br><br>

उल्ललन्ती
उल्ललन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उल्ललत् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

उल्ललित
उल्ललित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊರಟಿರುವ /ಚಲಿಸುವ<br><b>निष्पत्तिः - </b>उद् + लल (विलासे) - कर्त० "क्तः" (३-४-७२)<br><br>उल्ललित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡುವ<br><br>उल्ललित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡುವಿಕೆ /ತೂಗಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + लल (विलासे) - भावे "क्तः" (३-३-११४)<br><br>

उल्लसत्
उल्लसत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷಪಡುತ್ತಿರುವ /ಹರ್ಷಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + लस (श्लेषणक्रीडनयोः) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"ईषद्वक्त्रितकन्धरः सपुलकः प्रेमोल्लसन्मानसाम्"<br><b>उल्लेखाः - </b>अमरु० १९<br><br>उल्लसत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಪಷ್ಟವಾಗಿ ತೋರುತ್ತಿರುವ /ಮೇಲಕ್ಕೆ ಹೊರಟು ಬರುತ್ತಿರುವ<br><b>प्रयोगाः - </b>"शेषेण तेजस इवोल्लसता रराज"<br><b>उल्लेखाः - </b>माघ० ५-५५<br><br>उल्लसत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಿಸುತ್ತಿರುವ /ಹೊಳೆಯುತ್ತಿರುವ<br><b>प्रयोगाः - </b>"प्रोल्लसत्कुण्डलप्रोतपद्मरागदलत्विषा"<br><b>उल्लेखाः - </b>माघ० २-१९<br><br>उल्लसत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಫಲಿಸುತ್ತಿರುವ<br><br>

उल्लसन्ती
उल्लसन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उल्लसत् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><b>प्रयोगाः - </b>"निनाय तेषां द्रुतमुल्लसन्ती विनिद्रतां लोचनपङ्कजानि"<br><b>उल्लेखाः - </b>किरा० १६-३३<br><br>

उल्लसन
उल्लसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಲ್ಲಾಸ /ಹರ್ಷ<br><b>निष्पत्तिः - </b>उद् + लस (श्लेषणक्रीडनयोः) - "ल्युट्" (३-३-११५)<br><br>उल्लसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರೋಮಾಂಚ /ಮೈಮುಳ್ಳೇಳುವುದು /ನಿಲುಗೂದಲು<br><br>

उल्लसमान
उल्लसमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಳೆಯುತ್ತಿರುವ /ಪ್ರಕಾಶಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + लस (श्लेषणक्रीडनयोः) - "शानच्" (३-२-१२४)<br><br>

उल्लसयत्
उल्लसयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷಗೊಳಿಸುತ್ತಿರುವ /ಹರ್ಷಿಸುತ್ತಿರುವ<br><br>उल्लसयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಂತಿಗೊಳಿಸುತ್ತಿರುವ /ಪ್ರಕಾಶಗೊಳಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + लस (श्लेषणक्रीडनयोः) + णिच् - "शतृ" (३-२-१२४)<br><br>उल्लसयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಲಿಸುವಂತೆ ಮಾಡುತ್ತಿರುವ /ಅಲುಗಾಡಿಸುತ್ತಿರುವ<br><br>

उल्लसयन्ती
उल्लसयन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उल्लसयत् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

उल्लसित
उल्लसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷಗೊಂಡ /ಹರ್ಷಗೊಂಡ<br><b>निष्पत्तिः - </b>उद् + लस (श्लेषणक्रीडनयोः) - "क्तः" (३-४-७२)<br><br>उल्लसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಳೆಯುವ /ಪ್ರಕಾಶಮಾನವಾದ<br><b>प्रयोगाः - </b>"याच्यमानमुखमुल्लसितश्रि"<br><b>उल्लेखाः - </b>नैष० ५-९३<br><br>उल्लसित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊರಕ್ಕೆ ಹೊರಟಿರುವ /ಸ್ಪಷ್ಟವಾಗಿ ತೋರುವ<br><b>प्रयोगाः - </b>"नासाविरोकपवनोल्लसितं तनीयः"<br><b>उल्लेखाः - </b>माघ० ५-५४<br><br>

उल्लाघ
उल्लाघ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೋಗದಿಂದ ಬಿಡಲ್ಪಟ್ಟವನು /ರೋಗ ವಾಸಿಯಾದವನು<br><b>निष्पत्तिः - </b>उद् + लाघृ (सामार्थ्ये) - "क्तः" (८-२-५५)<br><b>व्युत्पत्तिः - </b>उल्लाघते स्म<br><b>विस्तारः - </b>"उल्लाघो निर्गतो गदात्" - अम० ।<br><br>उल्लाघ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಪುಣ /ಬುದ್ಧಿವಂತ<br><br>उल्लाघ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷಗೊಂಡವನು<br><br>उल्लाघ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶುಚಿಯಾದ /ಶುದ್ಧವಾದ<br><b>विस्तारः - </b>"उल्लाघो निपुणे हृष्टे शुचिनीरोगयोस्त्रिषु" - हेम० ।<br><br>

उल्लाघयत्
उल्लाघयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಧಿಯಿಂದ ಬಿಡಿಸುವವನು /ರೋಗ ವಾಸಿ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>उद् + लाघृ (सामार्थ्ये) +णिच् - "शतृ" (३-२-१२४)<br><br>उल्लाघयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷಪಡಿಸುವವನು<br><br>उल्लाघयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರ್ಮಲವಾಗಿ ಮಾಡುವವನು /ಶುದ್ಧಿ ಮಾಡುವವನು<br><br>

उल्लाघित
उल्लाघित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಧಿಯಿಂದ ಬಿಡಿಸಲ್ಪಟ್ಟ /ರೋಗ ವಾಸಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + लाघृ (सामार्थ्ये) +णिच् -कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"सतां पतिः सत्त्वसमृद्धिरोगात् उल्लाघितामातनुतेव पृथ्वीम्"<br><b>उल्लेखाः - </b>याद० २३-५१<br><br>

उल्लाप
उल्लाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾತು<br><b>निष्पत्तिः - </b>उद् + लप (व्यक्तायां वाचि) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"श्रुता मया आनन्दनिष्यन्दिन आर्यपुत्रस्योल्लापाः"<br><b>उल्लेखाः - </b>उ० रा० ३<br><br>उल्लाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೂಷಣೆ /ನಿಂದನೆಯ ಮಾತು<br><b>प्रयोगाः - </b>"खलोल्लापाः सोढाः कथमपि तदाराधनपरैर्निगृह्यान्तर्बाष्पं शून्येन मनसा"<br><b>उल्लेखाः - </b>भर्तृ० ३-४<br><br>उल्लाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಧಿ /ಭಯ ಮತ್ತು ದುಃಖದಿಂದ ಆಡುವ ಮಾತು<br><br>उल्लाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಚನೆ /ಸಲಹೆ<br><br>उल्लाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಚ್ಚಸ್ವರದಿಂದ ಕೂಗಿ ಕರೆಯುವುದು<br><br>

उल्लापिन्
उल्लापिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೂಚನೆ ಕೊಡುವ<br><b>निष्पत्तिः - </b>उद् + लप (व्यक्तायां वाचि) - "णिनिः" (३-१-१३४)<br><br>उल्लापिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ ಕೂಗಿ ಕರೆಯುವ<br><br>

उल्लापिनी
उल्लापिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उल्लापिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><b>प्रयोगाः - </b>"मा मा मानद माति मामलमिति क्षामाक्षरोल्लापिनी"<br><b>उल्लेखाः - </b>अमरु० ४<br><br>

उल्लाप्य
उल्लाप्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೃಶ್ಯ ಕಾವ್ಯದ ೧೮ ವಿಧ ಉಪರೂಪಕಗಳಲ್ಲೊಂದು ವಿಧ<br><br>

उल्लास
उल्लास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹರ್ಷ /ಸಂತೋಷ<br><b>निष्पत्तिः - </b>उद् + लस (श्लेषणक्रीडनयोः) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"उल्लासहेतुरभवद्यदुवीरभास्वान् वैमानिकप्रणयिनीवदनाम्बुजानाम्"<br><b>उल्लेखाः - </b>याद० १६-१४७<br><br>उल्लास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಂಥದ ಒಂದು ಭಾಗ /ಅಧ್ಯಾಯ /ಪರಿಚ್ಛೇದ<br><br>उल्लास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥಾಲಂಕಾರದ ಒಂದು ಭೇದ<br><br>उल्लास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ /ಉಪಕ್ರಮ<br><br>उल्लास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶ /ಪ್ರಭೆ /ಕಾಂತಿ<br><br>

उल्लासन
उल्लासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹರ್ಷಗೊಳಿಸುವಿಕೆ /ಸಂತೋಷಪಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + लस (श्लेषणक्रीडनयोः) +णिच् - "ल्युट्" (३-३-११५)<br><br>उल्लासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಗೊಳಿಸುವಿಕೆ /ಕಾಂತಿಯುಂಟುಮಾಡುವಿಕೆ<br><br>

उल्लासित
उल्लासित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರ್ಷಗೊಳಿಸಲ್ಪಟ್ಟ /ಸಂತೋಷಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>उल्लासित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಗೊಳಿಸಲ್ಪಟ್ಟ /ಸ್ಪಷ್ಟವಾಗಿ ತೋರ್ಪಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + लस (श्लेषणक्रीडनयोः) +णिच् - "क्तः" (३-२-१०२)<br><br>

उल्लासिन्
उल्लासिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರ್ಷದಿಂದ ಕೂಡಿದ<br><br>उल्लासिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಯುಕ್ತವಾದ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>उल्लासोऽस्यास्ति<br><br>उल्लासिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಹ್ಲಾದಗೊಳಿಸುವ /ಸಂತೋಷವುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>उद् + लस (श्लेषणक्रीडनयोः) - "णिनिः" (३-१-१३४)<br><br>

उल्लासिनी
उल्लासिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>उल्लासिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उल्लिखित
उल्लिखित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಜ್ಜಲ್ಪಟ್ಟ /ತಿಕ್ಕಲ್ಪಟ್ಟ<br><br>उल्लिखित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆತ್ತಲ್ಪಟ್ಟ /ಚಿತ್ರ ಕೊರೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + लिख (अक्षरविन्यासे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"चिन्ताजागरणप्रतान्तनयनस्तेजोगुणादात्मनः संस्कारोल्लिखितो महामणिरिव क्षीणोऽपि नालक्ष्यते"<br><b>उल्लेखाः - </b>शाकु० ६-६<br><br>उल्लिखित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಣೆ ಹಿಡಿಯಲ್ಪಟ್ಟ<br><br>उल्लिखित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲೆ ಬರೆಯಲ್ಪಟ್ಟ<br><br>उल्लिखित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರ ಬರೆಯಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"आरोप्य चक्रभ्रममुष्णतेजास्त्वष्ट्रेव यत्नोल्लिखितो विभाति"<br><b>उल्लेखाः - </b>रघु० ६-३२<br><br>उल्लिखित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೂಚಿಸಲ್ಪಟ್ಟ /ಪ್ರಸ್ತಾಪಿಸಲ್ಪಟ್ಟ<br><br>उल्लिखित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಹಿಸಿ ತಿಳಿಯಲ್ಪಟ್ಟ<br><br>उल्लिखित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೆರೆ ಎಳೆಯಲ್ಪಟ್ಟ<br><br>

उल्लिखत्
उल्लिखत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಜ್ಜುತ್ತಿರುವ /ತಿಕ್ಕುತ್ತಿರುವ<br><br>उल्लिखत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಣೆ ಹಿಡಿಯುತ್ತಿರುವ<br><br>उल्लिखत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರ ಕೊರೆಯುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + लिख (अक्षरविन्यासे) - "शतृ" (३-२-१२४)<br><br>उल्लिखत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರ ಬರೆಯುತ್ತಿರುವ<br><br>उल्लिखत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊರೆಯುತ್ತಿರುವ /ಗೀರುತ್ತಿರುವ<br><b>प्रयोगाः - </b>"रोचिष्णुकाञ्चनचयांशुपिशङ्गिताशा वंशध्वजैर्जलदसंहतिमुल्लिखन्त्यः"<br><b>उल्लेखाः - </b>माघ० ५-२०<br><br>उल्लिखत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತರ್ಕಿಸುತ್ತಿರುವ /ಊಹಿಸುತ್ತಿರುವ<br><br>उल्लिखत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲೆ ಬರೆಯುತ್ತಿರುವ<br><br>उल्लिखत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೂಚಿಸುತ್ತಿರುವ /ಪ್ರಸ್ತಾಪಿಸುತ್ತಿರುವ<br><br>

उल्लिख्यमान
उल्लिख्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಜ್ಜಲ್ಪಡುತ್ತಿರುವ /ತಿಕ್ಕಲ್ಪಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उद् + लिख (अक्षरविन्यासे) - कर्म० "शानच्" (३-२-१२४)<br><br>उल्लिख्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಣೆ ಕೊಡಲ್ಪಡುತ್ತಿರುವ<br><br>उल्लिख्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರದಲ್ಲಿ ಬರೆಯಲ್ಪಡುತ್ತಿರುವ<br><br>उल्लिख्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆತ್ತಲ್ಪಡುತ್ತಿರುವ /ಚಿತ್ರ ಕೊರೆಯಲ್ಪಡುತ್ತಿರುವ<br><br>उल्लिख्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಹಿಸಿ ತಿಳಿಯಲ್ಪಡುತ್ತಿರುವ<br><br>उल्लिख्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೆರೆ ಎಳೆಯಲ್ಪಡುತ್ತಿರುವ<br><br>उल्लिख्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೂಚಿಸಲ್ಪಡುತ್ತಿರುವ /ಪ್ರಸ್ತಾಪಿಸಲ್ಪಡುತ್ತಿರುವ<br><br>

उल्लिलङ्घिषा
उल्लिलङ्घिषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮಿಸಲು ಅಪೇಕ್ಷೆ /ಮೀರಲು ಆಸೆ<br><b>निष्पत्तिः - </b>उद् + लघि (गतौ) + सन् - "अः" (३-३-१०२)<br><b>व्युत्पत्तिः - </b>उल्लङ्घितुमिच्छा<br><br>उल्लिलङ्घिषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಾಟಲು ಅಪೇಕ್ಷೆ<br><br>उल्लिलङ्घिषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾರಲು ಅಪೇಕ್ಷೆ<br><br>

उल्लिलङ्घिषु
उल्लिलङ्घिषु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಕ್ರಮಿಸಲು ಅಪೇಕ್ಷಿಸುವ /ಮೀರಲು ಆಸೆ ಪಡುವ<br><b>निष्पत्तिः - </b>उद् + लघि (गतौ) + सन् - "उः" (३-२-१६८)<br><b>व्युत्पत्तिः - </b>उल्लङ्घितुमिच्छुः<br><br>उल्लिलङ्घिषु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾಟಲು ಅಪೇಕ್ಷೆಪಡುವ<br><br>उल्लिलङ्घिषु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹಾರಲು ಆಸೆಪಡುವ<br><br>

उल्लीढ
उल्लीढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಣೆ ಹಿಡಿಯಲ್ಪಟ್ಟ /ಹರಿತ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् +लिह (आस्वादने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"मणिः शाणोल्लीढः समरविजयी हेतुदलितः मदक्षीणो नागः शरदि सरितः श्यानपुलिनाः"<br><b>उल्लेखाः - </b>कुव०<br><br>

उल्लु
उल्लु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರಣಗೆಡ್ಡೆ<br><b>निष्पत्तिः - </b>उद् + लूञ् (छेदने) - "डुः" (वा० ३-२-१८०)<br><b>विस्तारः - </b>"कन्दं त्वस्त्री चित्रदण्ड उल्लुः कण्डूरसूरणौ" - वैज० ।<br><br>

उल्लू
उल्लू<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವ<br><b>निष्पत्तिः - </b>उद् + लूञ् (छेदने) - "क्विप्" (३-२-७६)<br><br>

उल्लुञ्चन
उल्लुञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೂದಲನ್ನು ಎಳೆದು ಬುಡಸಹಿತ ಕೀಳುವುದು<br><b>निष्पत्तिः - </b>उद् + लुञ्च (अपनयने) -भावे "ल्युट्" (३-३-११५)<br><br>उल्लुञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆಯುವುದು<br><b>प्रयोगाः - </b>"पादकेशांशुककरोल्लुञ्चनेषु पणान् दश"<br><b>उल्लेखाः - </b>याज्ञ० २-२१७<br><br>

उल्लुञ्चित
उल्लुञ्चित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೀಳಲ್ಪಟ್ಟ /ಬುಡಸಹಿತ ಕಿತ್ತುಹಾಕಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उद् + लुञ्च (अपनयने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"उल्लुञ्चितचिकुरमुक्तवसनदुर्दर्शनः"<br><b>उल्लेखाः - </b>प्रबोध० ३<br><br>उल्लुञ्चित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯಲ್ಪಟ್ಟ<br><br>

उल्लुण्ठन
उल्लुण्ठन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಕ್ರೋಕ್ತಿ /ಮನನೋಯಿಸುವ ಮಾತು /ಪ್ರಿಯವಾಗಿ ತೋರುವ ಪ್ರಿಯವಚನ<br><b>निष्पत्तिः - </b>उद् + लुठि (स्तेये) - "ल्युट्" (३-३-११५) ।<br><br>

उल्लुण्ठा
उल्लुण्ठा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಕ್ರೋಕ್ತಿ /ಮನನೋಯಿಸುವ ಮಾತು /ಪ್ರಿಯವಾಗಿ ತೋರುವ ಪ್ರಿಯವಚನ<br><b>निष्पत्तिः - </b>भावे "अः" (३-३-१०३)<br><b>प्रयोगाः - </b>"धीराधीरा तु सोल्लुण्ठभाषितैः खेदयत्यमुम्"<br><b>उल्लेखाः - </b>सा० द० ३-६३<br><br>

उल्लूक
उल्लूक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದರ್ಭೆ ಹುಲ್ಲು<br><b>विस्तारः - </b>"उल्लूकस्तूलपो दर्भः ऊर्ध्वमुखः खरच्छदः" - वैज० ।<br><br>

उल्लेख
उल्लेख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಚನೆ /ಪ್ರಸ್ತಾವ<br><b>निष्पत्तिः - </b>उद् + लिख (अक्षरविन्यासे) - "घञ्" (३-३-१८)<br><br>उल्लेख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಣನೆ /ಊಹಿಸಿ ವರ್ಣಿಸುವಿಕೆ /ಅರ್ಥಾಲಂಕಾರದ ಒಂದು ಭೇದ<br><b>प्रयोगाः - </b>"बहुभिर्बहुधोल्लेखादेकस्योल्लेख इष्यते"<br><b>उल्लेखाः - </b>चन्द्रा०<br><br>उल्लेख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಜ್ಜುವಿಕೆ /ತಿಕ್ಕುವಿಕೆ<br><b>प्रयोगाः - </b>"असकृन्निशितशस्त्रोल्लेखविषमितशिखरेण"<br><b>उल्लेखाः - </b>कादं०<br><br>उल्लेख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗೆಯುವುದು /ತೋಡುವುದು<br><br>उल्लेख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರ ಬರೆಯುವುದು<br><br>

उल्लेखक
उल्लेखक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಜ್ಜುವ /ತಿಕ್ಕುವ<br><br>उल्लेखक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಸ್ತಾಪಿಸುವ /ಸೂಚಿಸುವ<br><br>उल्लेखक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಣೆ ಹಿಡಿಯುವ<br><br>उल्लेखक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವರ್ಣಿಸುವ<br><br>उल्लेखक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರ ಬರೆಯುವ<br><br>उल्लेखक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗೆಯುವ /ತೋಡುವ<br><b>निष्पत्तिः - </b>उद् + लिख (अक्षरविन्यासे) - "ण्वुल्" (३-१-१३३)<br><br>

उल्लेखन
उल्लेखन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಜ್ಜುವಿಕೆ /ತಿಕ್ಕುವಿಕೆ<br><b>निष्पत्तिः - </b>उद् + लिख (अक्षरविन्यासे) - "ल्युट्" (३-३-११५)<br><br>उल्लेखन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗೆಯುವುದು /ತೋಡುವುದು<br><b>प्रयोगाः - </b>"सम्मार्जनोपाञ्जनेन सेकेनोल्लेखनेन च"<br><b>उल्लेखाः - </b>मनु० ५-१२४<br><br>उल्लेखन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಚನೆ /ಪ್ರಸ್ತಾವ<br><br>उल्लेखन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಂತಿ ಮಾಡುವುದು<br><br>उल्लेखन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಣನೆ /ಊಹಿಸಿ ವರ್ಣಿಸುವಿಕೆ /ಅರ್ಥಾಲಂಕಾರದ ಒಂದು ಭೇದ<br><br>उल्लेखन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರ ಬರೆಯುವುದು<br><br>उल्लेखन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುರುತು ಮಾಡುವುದು<br><br>

उल्लेखिन्
उल्लेखिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>उल्लेखक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>उद् + लिख (अक्षरविन्यासे) - "णिनिः" (३-१-१३४)<br><br>

उल्लेखनीय
उल्लेखनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವರ್ಣಿಸಲು ಅರ್ಹವಾದ /ವರ್ಣಿಸಲು ಯೋಗ್ಯವಾದ<br><br>उल्लेखनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವರ್ಣಿಸಲು ಶಕ್ಯವಾದ<br><br>उल्लेखनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವರ್ಣಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उद् + लिख (अक्षरविन्यासे) - अर्हादौ "अनीयर्" (३-१-९६)<br><br>उल्लेखनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗೆಯಲ್ಪಡುವ<br><br>उल्लेखनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗೆಯಲು ಶಕ್ಯವಾದ<br><br>उल्लेखनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗೆಯಲು ಯೋಗ್ಯವಾದ<br><br>उल्लेखनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುರುತು ಮಾಡಲ್ಪಡುವ<br><br>उल्लेखनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುರುತು ಮಾಡಲು ಶಕ್ಯವಾದ<br><br>उल्लेखनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುರುತು ಮಾಡಲು ಯೋಗ್ಯವಾದ<br><br>उल्लेखनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರ ಕೊರೆಯಲ್ಪಡುವ<br><br>उल्लेखनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರ ಕೊರೆಯಲು ಶಕ್ಯವಾದ<br><br>उल्लेखनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರ ಕೆತ್ತಲು ಯೋಗ್ಯವಾದ<br><br>

उल्लोच
उल्लोच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿತಾನ /ಗವಸಣಿಗೆ /ಬಟ್ಟೆಯ ಚಪ್ಪರ<br><b>निष्पत्तिः - </b>लोचृ (लोचने) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>उपरि लोच्यते<br><b>विस्तारः - </b>"अस्त्री वितानमुल्लोचः" - अम० ।<br><br>

उल्लोल
उल्लोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೊಡ್ಡ ಅಲೆ<br><b>निष्पत्तिः - </b>उद् +लोडृ (उन्मादे) - "अच्" (३-१-१३४) । लडयोरभेदः ।<br><b>व्युत्पत्तिः - </b>उल्लोडयति<br><br>उल्लोल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಚಂಚಲವಾದ<br><b>प्रयोगाः - </b>"दूरोद्वेलितबाडवसुअ जलधेरुल्लोलभिन्नाम्भसो रन्ध्रैरापतितेन वेगमरुता पातालमाध्मायते"<br><b>उल्लेखाः - </b>म० वी० ५-२<br><br>

उशनस्
उशनस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶುಕ್ರಾಚಾರ್ಯರು /ಅಸುರರ ಗುರು<br><b>निष्पत्तिः - </b>वश (कान्तौ) - "कनसिः" (उ० ४-२३८)<br><b>प्रयोगाः - </b>"सुराणामसुराणां च समजायत वै मिथः । ऐश्वर्यं प्रति सङ्घर्षः त्रैलोक्ये सचराचरे ॥ जिगीषया ततो देवाः वव्रिरे अङ्गिरसं मुनिम् । पौरोहित्येन याज्यत्वे काव्यं तूशनसं परे । ब्राह्मणौ तावुभौ नित्यमन्योन्यस्पर्धिनौ नृप ॥"<br><b>उल्लेखाः - </b>भा० आदि० ७<br><br>उशनस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಸ್ಮೃತಿಕಾರರು<br><br>

उशिच्
उशिच्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>विस्तारः - </b>"उशगग्नौ घृतेऽपि च" - सि० कौ०<br><br>उशिच्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಘೃತ /ತುಪ್ಪ<br><b>निष्पत्तिः - </b>वश (कान्तौ) - "इजिः" सम्प्र० (उ० २-७१)<br><b>व्युत्पत्तिः - </b>वष्टि उश्यते<br><br>

उशीनर
उशीनर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾದವವಂಶದ ಒಬ್ಬ ದೊರೆ<br><b>प्रयोगाः - </b>"उशीनरश्च विक्रान्तो वृष्णयस्ते प्रकीर्तिताः"<br><b>उल्लेखाः - </b>भा०<br><br>उशीनर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರವಂಶದ ಒಬ್ಬ ದೊರೆ<br><br>उशीनर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಶೀನರವೆಂಬ ಒಂದು ದೇಶ<br><br>उशीनर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಶೀನರ ದೇಶವಾಸಿಗಳು<br><br>

उशीर
उशीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಮಂಚದ ಬೇರು<br><b>निष्पत्तिः - </b>वश (कन्तौ) - "ईरन्" (उ० ४-३१)<br><b>व्युत्पत्तिः - </b>उश्यते<br><b>प्रयोगाः - </b>"स्तनन्यस्तोशीरं शिथिलितमृणालैकवलयम्"<br><b>उल्लेखाः - </b>शाकु० ३-६<br><br>

उशीरबीज
उशीरबीज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರ ದಿಕ್ಕಿನಲ್ಲಿರುವ ಒಂದು ಪರ್ವತ<br><b>व्युत्पत्तिः - </b>उशीरस्य वीरणमूलस्य बीजं योनिरत्र<br><b>प्रयोगाः - </b>"उशीरबीजं मैनाकं गिरिं श्वेतं च भारत । समतीतोऽसि कौन्तेय नीलशैलं च पार्थिव ॥"<br><b>उल्लेखाः - </b>भा० वन० १४१-१<br><br>

उष|दाहे|ओषति
उष - दाहे (भ्वा० पर० सक० से०) ओषति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಬಾಯಾರಿಸು<br><br>

उष
उष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮುಕ /ಕಾಮಾತುರ /ಕಾಮಾಸಕ್ತ<br><b>निष्पत्तिः - </b>उष (दाहे) - "कः" (३-१-१३५)<br><br>उष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಗ್ಗುಳ<br><br>उष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾತ್ರಿಯ ಶೇಷ /ಉಷಃಕಾಲ /ಬೆಳಗಿನ ಜಾವ<br><br>उष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾತಃಕಾಲ<br><br>उष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೌಳು ಮಣ್ಣು<br><b>विस्तारः - </b>"उषः कामिनि गुग्गुलौ । रात्रिशेषे उषायां तु केचिदाहुः तदव्ययम् । उषः क्षारमृत्तिकायां प्रभातेऽपि पुमानयम्" - मेदि० ।<br><br>उष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಿವಸ /ಹಗಲು<br><br>उष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಹಿಸುವ /ಸುಡುವ<br><br>

उषा
उषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಷಾದೇವಿ /ಬಾಣಾಸುರನ ಮಗಳು<br><br>उषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾತ್ರಿ<br><b>विस्तारः - </b>"उषा बाणसुतारात्र्योः" - मेदि० ।<br><br>उषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಷಾದೇವಿ /ಬಾಣಾಸುರನ ಮಗಳು<br><br>उषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತ್ರಿಸಂಧ್ಯಾಕಾಲ /ಹಗಲಿನ ಮೂರು ಸಂಧ್ಯಾಕಾಲಗಳು<br><br>उषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರುಣೋದಯದ ಕಾಲ /ಬೆಳಕು ಹರಿಯುವ ಕಾಲ<br><br>उषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾತ್ರಿ<br><b>विस्तारः - </b>"उषा बाणासुरारात्र्योः" - मेदि० । "उषायां तु केचिदाहुस्तदव्ययम्" - मेदि० ।<br><br>उषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಳು /ಹಸು<br><b>विस्तारः - </b>"गौः सौरभेयी माहेयी माहा सुरभिरर्जुनी । उस्राघ्न्या रोहिणी शृङ्गिण्यनड्वाह्यनडुह्युषा" - अभि० चि० ।<br><br>

उषण
उषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೆಣಸು<br><b>निष्पत्तिः - </b>उष (दाहे) - "क्युन्" (उ० २-७८)<br><br>उषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಪ್ಪಲಿ<br><br>

उषणा
उषणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶುಂಠಿ<br><br>उषणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚವ್ಯ<br><br>उषणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಪ್ಪಲಿ<br><br>

उषप
उषप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>उष (दाहे) - "कपन्" (उ० ३-१४२)<br><br>उषप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>विस्तारः - </b>"उषपो वह्निसूर्ययोः" - सि० कौ० ।<br><br>उषप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರಮೂಲದ ಗಿಡ<br><br>

उषर्बुध
उषर्बुध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><br>उषर्बुध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರಮೂಲದ ಗಿಡ<br><br>उषर्बुध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಷಃಕಾಲದಲ್ಲಿ ಎಚ್ಚರಗೊಳ್ಳುವ /ಅಗ್ನಿಹೋತ್ರ ಸಮಯದಲ್ಲಿ ಎಚ್ಚರಗೊಳ್ಳುವ<br><b>निष्पत्तिः - </b>बुध (अवगमने) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>उषसि बुध्यते<br><br>

उषस्
उषस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಳಗಿನ ಜಾವ /ಅರುಣೋದಯದ ಕಾಲ<br><b>निष्पत्तिः - </b>उष (दाहे) - "असिः" (उ० ४-२३३)<br><b>व्युत्पत्तिः - </b>ओषति अन्धकारम्<br><b>प्रयोगाः - </b>"इह सनियमयोः सुरापगायामुषसि सयावकसव्यपादरेखा"<br><b>उल्लेखाः - </b>किरा० ५-४०<br><br>उषस्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಧ್ಯಾಕಾಲ<br><b>विस्तारः - </b>"उषः सन्ध्याप्रभातयोः" - हेम० ।<br><br>उषस्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಧ್ಯಾಭಿಮಾನಿ ದೇವತೆ<br><br>

उषसी
उषसी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಯಂಕಾಲ /ಹಗಲಿನ ಕೊನೆಯ ಭಾಗ<br><b>व्युत्पत्तिः - </b>उषं दिवसं स्यति<br><b>विस्तारः - </b>"उषः प्रत्य्षसि क्लीबं पितृप्रस्वां च योषिति" - मेदि० ।<br><br>

उषाकाल
उषाकाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಕ್ಕುಟ /ಕೋಳಿ<br><b>व्युत्पत्तिः - </b>उषायां कालो यस्य<br><br>

उषापति
उषापति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನಿರುದ್ಧ /ಉಷಾದೇವಿಯ ಗಂಡ /ಶ್ರೀಕೃಷ್ಣನ ಮೊಮ್ಮಗ<br><b>व्युत्पत्तिः - </b>उषायां पतिः<br><b>विस्तारः - </b>"अनिरुद्धः उषापतिः" - अम० ।<br><br>

उषित
उषित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸಮಾಡುವುದು /ಇರುವುದು<br><b>निष्पत्तिः - </b>वस (निवासे) - भावे "क्तः" (३-३-११४)<br><br>उषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಸ ಮಾಡಲ್ಪಟ್ಟ<br><br>उषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಳೆಯದಾದ /ಪರ್ಯುಷಿತವಾದ<br><b>निष्पत्तिः - </b>वस - कर्म० "क्तः" (३-२-१०२)<br><br>उषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಗ್ಧವಾದ /ಸುಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उष (दाहे) - "क्तः" (३-२-१०२)<br><b>विस्तारः - </b>"उषितं व्युषिते दग्धे" - मेदि० ।<br><br>

उष्ट्र
उष्ट्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂಟೆ<br><b>प्रयोगाः - </b>"अन्यः पुनर्मुहुरुदप्लवतास्तभारमन्योन्यतः पथि बताबिभितामिभोष्ट्रौ"<br><b>उल्लेखाः - </b>माघ० ५-५<br><br>

उष्ट्री
उष्ट्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಒಂಟೆ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>उष्ट्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಣ್ಣಿನ ಪಾತ್ರೆ<br><b>विस्तारः - </b>"उष्ट्री मृद्भाण्डे करभस्त्रियाम्" - हेम० ।<br><br>

उष्ट्रक्रोशिन्
उष्ट्रक्रोशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂಟೆಯಂತೆ ಕೂಗಿಕೊಳ್ಳುವ /ಒಂಟೆಯಂತೆ ಶಬ್ದ ಮಾಡುವ<br><b>निष्पत्तिः - </b>क्रुश (आह्वाने रोदने च)- "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>उष्ट्र इव क्रोशति<br><br>

उष्ट्रक्रोशिनी
उष्ट्रक्रोशिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂಟೆಯಂತೆ ಕೂಗಿಕೊಳ್ಳುವ /ಒಂಟೆಯಂತೆ ಶಬ್ದ ಮಾಡುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

उष्ट्रग्रीवक
उष्ट्रग्रीवक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಿತ್ತವಿಕಾರದಿಂದ ಉಂಟಾದ ನಾಡೀವ್ರಣ /ಭಗಂದರ<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७) । स्वार्थे "कन्"<br><b>व्युत्पत्तिः - </b>उष्ट्रग्रीवा आकारत्वेनास्त्यस्याः<br><b>विस्तारः - </b>"भगन्दरः । शम्बूकावर्त एष स्यात्त्रिदोषोत्थोऽथ पित्तजः स्यादुष्ट्रग्रीवकः" - वैज० ।<br><br>

उष्ट्रासिका
उष्ट्रासिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂಟೆಯಂತೆ ಕುಳಿತುಕೊಳ್ಳುವಿಕೆ<br><b>व्युत्पत्तिः - </b>उष्ट्रस्येवासिका आसनम्<br><br>

उष्ट्रिका
उष्ट्रिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಒಂಟೆ<br><br>उष्ट्रिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂಟೆಯಂತಿರುವ ಒಂದು ಮಣ್ಣಿನ ಹೆಂಡದ ಪಾತ್ರೆ<br><b>प्रयोगाः - </b>"धूर्भङ्गसङ्क्षोभविदारितोष्ट्रिकागलन्मधुप्लावितदूरवर्मनि"<br><b>उल्लेखाः - </b>माघ० १२-२६<br><b>विस्तारः - </b>"उष्ट्रिका मृत्तिका भाण्डभेदे करभयोषिति" - विश्व० ।<br><br>

उष्ण
उष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರೀಷ್ಮ ಋತು /ಬೇಸಿಗೆಯ ಕಾಲ<br><b>निष्पत्तिः - </b>उष (दाहे) - "नक्" (उ० ३-२)<br><b>व्युत्पत्तिः - </b>ओषति<br><br>उष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><br>उष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>प्रयोगाः - </b>"उष्णे वर्षति शीते वा मारुते वाति वा भृशम्"<br><b>उल्लेखाः - </b>मनु० ११-११३<br><br>उष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಸಿ /ಕಾವು<br><b>प्रयोगाः - </b>"मानिनीजनविलोचनपातानुष्णबाष्पकलुषान् प्रतिगृह्णन्"<br><b>उल्लेखाः - </b>किरा० ९-२६<br><br>उष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಸಿಲು<br><br>उष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನುಗ್ಗೆ ಮರ<br><b>विस्तारः - </b>"उष्णो मुरङ्गी रक्तेऽस्मिन्" - वैज० ।<br><br>उष्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಾಣ /ಬುದ್ಧಿವಂತ<br><b>विस्तारः - </b>"उष्णो ग्रीष्मे पुमान् दक्षाशीतयोरन्यलिङ्गकः" - मेदि० । "उष्णं दक्षेऽपि नातपे" - त्रिकाण्ड० ।<br><br>उष्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಸಿಯಾದ<br><b>विस्तारः - </b>"उष्णस्त्वातपोष्मणोः । वह्नौ तु पुंसि चतुरतिग्मयोस्त्वेष वाच्यवत्" - नानार्थर० ।<br><br>

उष्णक
उष्णक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರೀಷ್ಮ ಋತು /ಬೇಸಿಗೆಯ ಕಾಲ<br><br>उष्णक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ವರ<br><b>निष्पत्तिः - </b>"कन्" (५-२-८१)<br><b>व्युत्पत्तिः - </b>उष्णं कार्यमस्य<br><br>उष्णक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚುರುಕಾಗಿರುವ /ಚತುರನಾದ /ಸಮರ್ಥನಾದ<br><b>निष्पत्तिः - </b>"कन्" (५-२-७२)<br><b>व्युत्पत्तिः - </b>उष्णं करोति<br><b>विस्तारः - </b>"चतुरः पेशलो दक्षः सूत्थानः पटुरुष्णकः" - वैज० ।<br><br>उष्णक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜ್ವರಪೀಡಿತನಾದ<br><b>विस्तारः - </b>"उष्णाको धर्म उद्युक्तातुरयोः" - हेम० ।<br><br>

उष्णकर
उष्णकर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>उष्णाः कराः अस्य<br><br>उष्णकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಸಿಯಾದ ಕಿರಣವುಳ್ಳ<br><br>उष्णकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಸಿಯುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उष्णस्य करः<br><br>

उष्णकिरण
उष्णकिरण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>उष्णाः किरणाः अस्य<br><br>

उष्णरश्मि
उष्णरश्मि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>उष्णा रश्मयः अस्य<br><b>प्रयोगाः - </b>"कुबेरगुप्तां दिशमुष्णरश्मौ गन्तुं प्रवृत्ते समयं विलङ्घ्य"<br><b>उल्लेखाः - </b>कुमा० ३-२५<br><br>

उष्णकाल
उष्णकाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರೀಷ್ಮ ಋತು /ಬೇಸಿಗೆಯ ಕಾಲ<br><b>व्युत्पत्तिः - </b>उष्णश्चासौ कालश्च<br><b>प्रयोगाः - </b>"तक्रं नैव क्षते दद्यात् नोष्णकाले च दुर्बले"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

उष्णग
उष्णग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರೀಷ್ಮ ಋತು /ಬೇಸಿಗೆಯ ಕಾಲ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "डः" (वा० ३-२-४८)<br><b>व्युत्पत्तिः - </b>उष्णं गच्छति<br><br>

उष्णगु
उष्णगु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>उष्णाः गावः किरणा अस्य<br><br>

उष्णवारण
उष्णवारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಡೆ /ಛತ್ರಿ<br><b>निष्पत्तिः - </b>वृञ् (वरणे) + णिच् - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>उष्णं वारयति<br><b>प्रयोगाः - </b>"यदर्थमम्भोजमिवोष्णवारणं कृतः तपःसाधनमेतया वपुः"<br><b>उल्लेखाः - </b>कुमा० ५-५२<br><br>

उष्णवीर्य
उष्णवीर्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಶುಮಾರವೆಂಬ ಒಂದು ಜಲಚರ ಪ್ರಾಣಿ<br><br>उष्णवीर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೀಕ್ಷ್ಣವಾದ ವೀರ್ಯವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>उष्णं वीर्यं यस्य<br><b>विस्तारः - </b>"शिशुमारस्त्वम्बुकूर्म उष्णवीर्यो महावसः" - अभि० चि० ।<br><br>

उष्णांशु
उष्णांशु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>उष्णाः अंशवोऽस्य<br><b>प्रयोगाः - </b>"आनिन्ये मदजनितां श्रियं वधूनामुष्णांशुद्युतिजनितः कपोलरागः"<br><b>उल्लेखाः - </b>किरा० ७-३<br><br>

उष्णागम
उष्णागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರೀಷ್ಮ ಋತು /ಬೇಸಿಗೆಯ ಕಾಲ<br><b>व्युत्पत्तिः - </b>उष्णस्यागमोऽत्र<br><br>

उष्णालु
उष्णालु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಷ್ಣವನ್ನು ಸಹಿಸದಿರುವ<br><b>निष्पत्तिः - </b>"आलुः" (वा० ५-२-१२१)<br><b>व्युत्पत्तिः - </b>उष्णं न सहते<br><b>प्रयोगाः - </b>"उष्णालुः शिशिरे निषीदति तरोर्मूलालवले शिखी"<br><b>उल्लेखाः - </b>विक्र० २-२२<br><br>

उष्णिका
उष्णिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಜಿ /ಅಂಬಲಿ<br><b>निष्पत्तिः - </b>"कन्" (५-२-७१) । अल्पान्नशब्दस्य उष्णादेशः निपा० ।<br><b>व्युत्पत्तिः - </b>अल्पमन्नं यस्यां सा<br><br>

उष्णिह्
उष्णिह्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಏಳು ಅಕ್ಷರಗಳ ಪಾದಗಳುಳ್ಳ ಒಂದು ಛಂದಸ್ಸು<br><b>प्रयोगाः - </b>"गायत्र्युष्णिगनुष्णुप्च बृहती पङ्क्तिरेव च"<br><b>उल्लेखाः - </b>वृ० र०<br><br>

उष्णीगङ्ग
उष्णीगङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೃಗುತುಂಗ ಪರ್ವತದಲ್ಲಿರುವ ಒಂದು ತೀರ್ಥ<br><b>व्युत्पत्तिः - </b>उष्णीभूता गङ्गा नदीभेदो यत्र<br><b>प्रयोगाः - </b>"अपां ह्रदं च पुण्याखं भृगुतुङ्गं च पर्वतम् । उष्णीगङ्गे च कौन्तेय सामात्यः समुपस्पृश ॥"<br><b>उल्लेखाः - </b>भा० वन० १३५<br><br>

उष्णीष
उष्णीष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರುಮಾಲು<br><br>उष्णीष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರೀಟ<br><b>निष्पत्तिः - </b>ईष (गतिहिंसदर्शनेषु) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>उष्णमीशते हिनस्ति<br><b>प्रयोगाः - </b>"त्रासार्था ऋत्विजोऽधश्चपलगणहृतोण्षीषपट्टाः पतन्ति"<br><b>उल्लेखाः - </b>रत्ना० १-३<br><br>उष्णीष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ತಲೆಯ ಅಲಂಕಾರ<br><b>विस्तारः - </b>"उष्णीषं तु शिरोवेष्टे किरीटे लक्षणान्तरे" - हेम० ।<br><br>उष्णीष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿರಸ್ಸು /ತಲೆ<br><b>विस्तारः - </b>"उष्णीषं शीर्षमक्षत्रं पुंसि मूर्धा च मस्तकः" - वैज० ।<br><br>

उष्णीषपट्ट
उष्णीषपट्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರುಮಾಲಿನ ಬಟ್ಟೆ /ತುಮಾಲು ಸುತ್ತುವ ವಸ್ತ್ರ<br><b>व्युत्पत्तिः - </b>उष्णीषार्थं पट्टः<br><b>प्रयोगाः - </b>"चपलगणहृतोष्णीषपटाः पतन्ति"<br><b>उल्लेखाः - </b>रत्ना० १-३<br><br>

उष्णीषिन्
उष्णीषिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ /ಮಹಾದೇವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>उष्णीषमस्यास्ति<br><br>उष्णीषिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರುಮಾಲು ಧರಿಸಿರುವ<br><b>व्युत्पत्तिः - </b>उष्णमुदकम्<br><br>

उष्णोदक
उष्णोदक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಸಿನೀರು /ಕಾಯಿಸಲ್ಪಟ್ಟ ನೀರು<br><b>विस्तारः - </b>"अष्टमेनांशशोषेण चतुर्थेनार्धकेन वा । अथवा क्वथनेनैव सिद्धमुष्णोदकं वदेत् ॥" - भावप्र० ।<br><br>

उष्णोपगम
उष्णोपगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರೀಷ್ಮ ಋತು /ಬೇಸಿಗೆಯ ಕಾಲ<br><b>व्युत्पत्तिः - </b>उष्णसुअ उपगमोऽत्र<br><br>

उष्म
उष्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರೀಷ್ಮ ಋತು /ಬೇಸಿಗೆಯ ಕಾಲ<br><b>निष्पत्तिः - </b>उष (दाहे) - "मक्" बाहु० ।<br><br>उष्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪ /ಸಿಟ್ಟು<br><br>उष्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಔತ್ಸುಕ್ಯ /ಕುತೂಹಲ<br><br>

उष्मक
उष्मक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರೀಷ್ಮ ಋತು /ಬೇಸಿಗೆಯ ಕಾಲ<br><b>निष्पत्तिः - </b>उष्म - स्वार्थे "कन्"<br><br>

उष्मन्
उष्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಸಿ /ಶಾಖ<br><b>निष्पत्तिः - </b>उष (दाहे) - "मनिन्" (उ० ४-१४४)<br><b>प्रयोगाः - </b>"निवेदितं विश्वसितेन सोष्मणा मनस्तु मे संशयमेव गाहते"<br><b>उल्लेखाः - </b>कुमा० ५-४६<br><br>उष्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಬೆ /ಆವಿ<br><b>प्रयोगाः - </b>"तपात्यये वारिभिरुक्षिता नवैर्भुवा सहोष्माणममुञ्चदूर्ध्वगम्"<br><b>उल्लेखाः - </b>कुमा० ५-२३<br><br>उष्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರೀಷ್ಮ ಋತು /ಬೇಸಿಗೆಯ ಕಾಲ<br><b>प्रयोगाः - </b>"उष्मा पित्तादृते नास्ति ज्वरो नास्त्युष्मणा विना । तस्यात् पित्तविरुद्धानि त्यजेत् पित्ताधिकेऽधिकम् ॥"<br><b>उल्लेखाः - </b>वाग्भ० चिकित्सा०<br><br>उष्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ ಷ ಸ ಹ ವರ್ಣಗಳು<br><b>प्रयोगाः - </b>"शषसहा ऊष्माणः"<br><b>उल्लेखाः - </b>सि० कौ०<br><br>

उष्मागम
उष्मागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರೀಷ್ಮ ಋತು /ಬೇಸಿಗೆಯ ಕಾಲ<br><b>व्युत्पत्तिः - </b>उष्मा आगमोऽत्र<br><br>

उस्र
उस्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಶ್ಮಿ /ಕಿರಣ<br><b>निष्पत्तिः - </b>वस (निवासे) - "रक्" (उ० २-१३)<br><b>प्रयोगाः - </b>"उस्राणां व्यभिचरतीव सप्तसप्तेः पर्यसन्निव निचयः सहस्रसङ्ख्याम्"<br><b>उल्लेखाः - </b>किरा० ५-३४<br><br>उस्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರವಾಹ /ನೀರು ಹರಿಯುವಿಕೆ<br><b>विस्तारः - </b>"उस्रः स्रवः प्रस्रवणम्" - अभि० चि० ।<br><br>उस्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತು /ವೃಷಭ<br><br>

उस्रा
उस्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಳು /ಹಸು<br><br>उस्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಲಿಯಾಲದ ಗಿಡ<br><b>विस्तारः - </b>"उस्रा गव्युपचित्रायामुस्रस्तु किरणे स्मृतः" - विश्व० । "उस्रो वृषे च किरणेऽप्युस्रार्जुन्युपचित्रयोः" - मेदि० ।<br><br>

उस्रिक
उस्रिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕ ಎತ್ತು<br><br>उस्रिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುದಿ ಎತ್ತು<br><br>

उस्रिका
उस्रिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಹಾಲು ಕೊಡುವ ಆಕಳು<br><b>प्रयोगाः - </b>"उस्रियाणां क्षीरमुत्सारयन्तीम्"<br><br>

उस्रिय
उस्रिय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುದಿ ಎತ್ತು<br><br>

उस्रिया
उस्रिया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಳು /ಹಸು<br><br>

उह
उह<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಬೋಧನೆ<br><br>उह<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕರೆ /ಆಹ್ವಾನ<br><br>उह<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅವಧಾರಣೆ /ನಿಶ್ವಯ<br><br>

उहू
उहू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭಯ ಮತ್ತು ದುಃಖಸೂಚಕವಾದ ಒಂದು ಶಬ್ದ<br><b>निष्पत्तिः - </b>उहिर् (अर्दने) - "कूः" बाहु० ।<br><b>प्रयोगाः - </b>"नखानि विधुशङ्कया करतलेन तद्व्यावृणोत् ततः किसलयभ्रमात् करमथाक्षिपद्दूरतः । ततो वलयशिञ्जिते भ्रमरगुञ्जिता शङ्कया उहूरिति कुहूरवध्वनिभियाऽपतन्तमूर्च्छिता ॥"<br><br>

उह्यमान
उह्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಹಿಸಲ್ಪಡುವ /ಹೊರಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>वह (प्रापणे) - कर्म० "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"यथोह्यमानः खलु भोगभोजिना प्रसह्य वैरोचनिजस्य पतनम्"<br><b>उल्लेखाः - </b>नैष० १-३२<br><br>

उह्र
उह्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಷಭ /ಎತ್ತು<br><b>निष्पत्तिः - </b>उहिर् (अर्दने) - "रक्" बाहु० ।<br><br>

ऊ
ऊ<br><br><b>कन्नडार्थः - </b>ಊಕಾರ<br><b>विस्तारः - </b>ಇದುವರ್ಣಮಾಲೆಯಲ್ಲಿ ಓಷ್ಠದಲ್ಲಿ ಹುಟ್ಟುವ ಆರನೆಯ ಸ್ವರವರ್ಣ. ಉದಾತ್ತ ಅನುದಾತ್ತ ಮತ್ತು ಸ್ವರಿತಗಳೆಂಬ ೩ ಭೇದಗಳುಳ್ಳ ಇದು ಪುನಃ ಅನುನಾಸಿಕ ಮತ್ತು ಅನನುನಾಸಿಕಗಳೆಂಬ ಭೇದದಿಂದ ಒಟ್ಟು ೬ ವಿಧವಾಗುವುದು.<br><br>ऊ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುರುಷ<br><br>ऊ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><br>ऊ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜಕುಮಾರ<br><br>ऊ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಠ /ಕುತ್ತಿಗೆ<br><br>ऊ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><br>ऊ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗಳ<br><br>ऊ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾದೃಶ್ಯ /ಉಪಮಾನ<br><br>ऊ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೂರ್ಣಕುಂಭ<br><br>ऊ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ತಕ /ವ್ಯಾಪಾರಿ<br><br>ऊ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆ /ಕಾಪಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>अव (रक्षणे) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>अवति<br><b>विस्तारः - </b>"ऊकारः पुरुषे चन्द्रे राजपुत्रे गले सुरे । प्राङ्ग्णोपमयोः पूर्णलुम्भे वणिजि रक्षणे ॥" - नानार्थ०<br><br>ऊ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷಣ<br><br>ऊ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ<br><b>विस्तारः - </b>"ऊकारश्चापि लक्षणे । रक्षणे चपि ऊकारः ऊकारो ब्रह्मणि स्मृतः ॥" - एका०<br><br>ऊ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಜಿ<br><br>ऊ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಲಿಗೆ<br><br>ऊ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಯೆ /ಕರುಣೆ<br><br>ऊ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರೆ /ಆಹ್ವಾನ<br><br>ऊ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಕ /ಕಾಪಾಡುವವನು<br><br>ऊ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಾಕ್ಯಾರಂಭ<br><b>विस्तारः - </b>"ऊ रक्षणे रक्षके च सूच्यां स्यूतावनव्ययम्" - हेम० । "ऊ वाक्यारम्भेनुकम्पारक्षाहूतिष्वनव्ययम्" - विश्व० ।<br><br>

ऊक
ऊक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಕ್ಷಿ /ಹಕ್ಕಿ<br><b>विस्तारः - </b>"ऊकः शकुन्तिःशकुनिः शकुन्तः शकुनः खगः" - वैज० ।<br><br>

ऊख
ऊख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಡು /ಪಿರ್ರೆ /ಪೃಷ್ಠ<br><b>विस्तारः - </b>"ऊखौ पुंसि कटिप्रोथौ पूलकौ च स्फिचौ स्त्रियौ" - वैज० ।<br><br>

ऊढ
ऊढ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದುವೆಯಾದವನು /ವಿವಾಹ ಮಾಡಿಕೊಂಡವನು<br><b>निष्पत्तिः - </b>वह (प्रापणे) कर्त० - "क्तः" (३-४-७२)<br><br>ऊढ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಹಿಸಲ್ಪಟ್ಟಿರುವ /ಹೊರಲ್ಪಟ್ಟಿರುವ /ಒಯ್ಯಲ್ಪಟ್ಟ<br><br>

ऊढा
ऊढा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮದುವೆಯಾದ ಹೆಂಗಸು /ಒಬ್ಬನಿಂದ ವಹಿಸಲ್ಪಟ್ಟವಳು<br><b>निष्पत्तिः - </b>वह (प्रापणे) कर्म० - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"इयं च तेऽन्या पुरतो विडम्बना यदूढया वारणराजिहर्यया" । "भार्योढ्ं तमवज्ञाय तस्थे सौमित्रयेऽसकौ"<br><b>उल्लेखाः - </b>कुमा० ५-७०, भट्टि० ४-१५<br><br>

ऊढि
ऊढि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹ /ಮದುವೆ<br><b>निष्पत्तिः - </b>वह (प्रापणे) - "क्तिन्" (३-३-९४)<br><br>ऊढि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಹಿಸುವುದು /ಹೊರುವುದು /ಒಯ್ಯುವುದು<br><br>

ऊत
ऊत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಳಕು ನೀರು /ಸ್ವಚ್ಛವಲ್ಲದ ನೀರು<br><b>विस्तारः - </b>"कचिमं स्यादतिस्वच्छमूतं कलुषमाविलम्" - वैज० ।<br><br>ऊत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೇಯಲ್ಪಟ್ಟ<br><br>ऊत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಲಿಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>ऊयी (तन्तुसन्ताने) - कर्म० "क्तः" (३-२-१०२)<br><br>ऊत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಿಸಲ್ಪಟ್ಟ /ಕಾಪಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>अव (रक्षणे) - "क्तः" (३-२-१०२) । ऊठ् (६-४-२०)<br><br>

ऊति
ऊति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆ /ಕಾಪಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>अव (रक्षणे) - "क्तिन्" (३-३-९४) । ऊठ् (६-४-२०)<br><br>ऊति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೇಯುವುದು<br><br>ऊति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಲೆಯುವುದು<br><b>निष्पत्तिः - </b>ऊयी (तन्तुसन्ताने) - कर्म० "क्तिन्" (३-३-९४)<br><b>विस्तारः - </b>"स्यादूतिः स्यूतिरक्षयोः" - हेम० ।<br><br>

ऊधस्
ऊधस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸುವಿನ ಕೆಚ್ಚಲು<br><b>निष्पत्तिः - </b>उन्दी (क्लेदने) - "असुन्" (उ० ४-१८८)<br><br>

ऊध्नी
ऊध्नी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>प्रयोगाः - </b>"भुव्ं कोष्णेन कुण्डोध्नी मेध्येनावभृथादपि"<br><b>उल्लेखाः - </b>रघु० १-८४<br><b>विस्तारः - </b>बहुव्रीहिसमासान्त्ये "अनङ्" (५-४-१३) । अस्त्रियां तु कुण्दोधो धैनुकम्" - सि। कौ० ।<br><br>

ऊधस्य
ऊधस्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಲು /ಕ್ಷೀರ<br><br>ऊधस्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಕಳಿನ ಕೆಚ್ಚಲಿನಲ್ಲಿರುವ /ಕೆಚ್ಚಲಿನಲ್ಲಿ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>"यत्" (५-१-६)<br><b>व्युत्पत्तिः - </b>ऊधसि भवम्<br><b>प्रयोगाः - </b>"ऊधस्यमिच्छामि तवोपभोक्तुं षष्ठांशमुर्व्या इव रक्षितायाः"<br><b>उल्लेखाः - </b>रघु० २-६६<br><br>

ऊन
ऊन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೀನವಾದ /ಕಡಿಮೆಯಾದ<br><b>निष्पत्तिः - </b>ऊन (परिहाणे) - "घञ्" (३-३-१९)<br><b>प्रयोगाः - </b>"किञ्चिदूनमनूनर्धेः शरदामयुतं ययौ"<br><b>उल्लेखाः - </b>रघु० १०-१<br><br>ऊन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಂಪೂರ್ಣವಾದ /ಕೊರತೆಯುಳ್ಳ<br><b>प्रयोगाः - </b>"ऊनं वाप्यधिकं वापि लिखेद्यो राजशासनम्"<br><b>उल्लेखाः - </b>याज्ञ० २-२९५<br><b>विस्तारः - </b>एकोनविंशतिः । एकोनत्रिंशत् । एकोनचत्वारिंशत् ।<br><br>

ऊम्
ऊम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ /ಕೇಳಿಕೆ<br><b>निष्पत्तिः - </b>ऊयी (तन्तुसन्ताने) - "मुक्" बाहु० ।<br><b>व्युत्पत्तिः - </b>ऊय्यते<br><br>ऊम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೋಪದ ಮಾತು<br><b>विस्तारः - </b>"ऊम् रुषोक्तौ पृच्छायाम्" - मेदि०।<br><br>

ऊम
ऊम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಿಸುವ/ಕಾಪಾಡುವ<br><b>निष्पत्तिः - </b>अव (रक्षणे) - "मन्" "उठ्" च /<br><br>

ऊररी
ऊररी<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ /ಒಪ್ಪಿಗೆ /ಸಮ್ಮತಿ<br><b>निष्पत्तिः - </b>ऊयी (तन्तुसन्ताने) - "ररीक्" बाहु० ।<br><br>ऊररी<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿಸ್ತಾರ<br><br>

ऊररीकार
ऊररीकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ /ಒಪ್ಪಿಗೆ /ಸಮ್ಮತಿ<br><b>निष्पत्तिः - </b>ऊररी + डुकृञ् (करणे) - "घञ्" (३-३-१८)<br><br>ऊररीकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಸ್ತಾರಪಡಿಸುವಿಕೆ<br><br>

ऊररीकृत
ऊररीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕರಿಸಲ್ಪಟ್ಟ /ಒಪ್ಪಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>ऊररी + डुकृञ् (करणे) - "क्तः" (३-२-१०२)<br><br>ऊररीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಸ್ತರಿಸಲ್ಪಟ್ಟ<br><br>

ऊरव्य
ऊरव्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೈಶ್ಯ /ಮೂರನೆಯ ವರ್ಣದವನು<br><b>निष्पत्तिः - </b>"यत्" (५-१-६)<br><b>व्युत्पत्तिः - </b>ऊरौ भवः<br><b>प्रयोगाः - </b>"ब्राह्मणोऽस्य मुखमासीत् । बाहू राजन्यः कृतः । ऊरू तदस्य यद्वैश्यः"<br><b>उल्लेखाः - </b>श्रुतिः<br><br>ऊरव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಡೆಯಲ್ಲಿರುವ /ತೊಡೆಯಲ್ಲುಂಟಾದ<br><br>

ऊरव्या
ऊरव्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्"<br><br>

ऊरी
ऊरी<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ /ಒಪ್ಪಿಗೆ /ಸಮ್ಮತಿ<br><b>निष्पत्तिः - </b>ऊयी (तन्तुसन्ताने) - "रीक्" बाहु० ।<br><br>

ऊरीकृत्य
ऊरीकृत्य<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ /ಒಪ್ಪಿಗೆ /ಸಮ್ಮತಿ<br><b>निष्पत्तिः - </b>ऊरी + डुकृञ् (करणे) - "ल्यप्" (७-१-३७)<br><b>प्रयोगाः - </b>"तद्वूरीकृत कृतिभिः वाचस्पत्यं प्रतायते"<br><b>उल्लेखाः - </b>माघ० २-३०<br><br>

ऊरीकृत
ऊरीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕರಿಸಲ್ಪಟ್ಟ /ಒಪ್ಪಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>ऊरी + डुकृञ् (करणे) - "क्तः" (३-२-०२)<br><b>विस्तारः - </b>"ऊरीकृतमुररीकृतमङ्गीकृतमाश्रुतं प्रतिज्ञातम्" - अम०<br><br>

ऊरु
ऊरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೊಡೆ<br><b>प्रयोगाः - </b>"शीतांशुर्मुखमुत्पले तव दृशौ पद्मानुकारौ करौ रम्भागर्भयुगं तवोरुयुगलं बाहू मृणालोपमौ"<br><b>उल्लेखाः - </b>रत्ना०<br><b>विस्तारः - </b>ಉಪಮಾನವಾಚಕ ಪೂರ್ವಪದವಿರುವಾಗಸ್ತ್ರೀಲಿಂಗದ ಸಮಾಸಾಂತ್ಯದಲ್ಲಿ "ऊङ्" (४-१-६९) ಬಂದು करभोरूः, रम्भोरूः ಎಂದಾಗುವುದು.<br><br>

ऊरुग्राह
ऊरुग्राह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಧಿವಾತ /ಮಂಡಿಯು ಚಲಿಸದಂತೆ ಮಾಡುವ ಒಂದು ವಾತರೋಗ<br><b>निष्पत्तिः - </b>ग्रह (उपादाने) - "अण्" (३--१)<br><b>व्युत्पत्तिः - </b>ऊरू गृह्णाति<br><b>प्रयोगाः - </b>"ऊरुग्राहगृहीताश्च केचित्तत्राभवन् भुवि"<br><b>उल्लेखाः - </b>भा० द्रोण० १४६<br><br>

ऊरुज
ऊरुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೈಶ್ಯ /ಮೂರನೆಯ ವರ್ಣದವನು<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः"(३-२-१०१)<br><b>व्युत्पत्तिः - </b>ऊरोर्जायते<br><br>ऊरुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೃಗುವಂಶದ ಒಬ್ಬ ಋಷಿ<br><br>ऊरुज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಡೆಯಲ್ಲಿ ಹುಟ್ಟಿದ /ತೊಡೆಯಲ್ಲುಂಟಾದ<br><br>

ऊरूची
ऊरूची<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೈಶ್ಯೆ /ಮೂರನೆಯ ವರ್ಣದವಳು<br><b>निष्पत्तिः - </b>स्त्रियां"ङीष्" (४-१-६३)<br><br>

ऊरुदघ्न
ऊरुदघ्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಡೆಯನ್ನು ಮುಟ್ಟುವಷ್ಟು ಎತ್ತರವಾದ /ತೊಡೆಯ ಪ್ರಮಾಣವುಳ್ಳ /ತೊಡೆಯ ಅಳತೆಯುಳ್ಳ /ತೊಡೆಯಷ್ಟು ಆಳವಾದ<br><b>निष्पत्तिः - </b>"दध्नच्" (५-२-३७)<br><b>व्युत्पत्तिः - </b>ऊरू प्रमाणमस्य<br><br>

ऊरुदघ्नी
ऊरुदघ्नी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಡೆಯನ್ನು ಮುಟ್ಟುವಷ್ಟು ಎತ್ತರವಾದ /ತೊಡೆಯ ಪ್ರಮಾಣವುಳ್ಳ /ತೊಡೆಯ ಅಳತೆಯುಳ್ಳ /ತೊಡೆಯಷ್ಟು ಆಳವಾದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>ऊरू प्रमाणमस्याः<br><br>

ऊरुद्वयस
ऊरुद्वयस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಡೆಯನ್ನು ಮುಟ್ಟುವಷ್ಟು ಎತ್ತರವಾದ /ತೊಡೆಯ ಪ್ರಮಾಣವುಳ್ಳ /ತೊಡೆಯ ಅಳತೆಯುಳ್ಳ /ತೊಡೆಯಷ್ಟು ಆಳವಾದ<br><b>निष्पत्तिः - </b>"द्वयसच्" (५-२-३७)<br><b>व्युत्पत्तिः - </b>ऊरू प्रमाणमस्य<br><br>

ऊरुद्वयसी
ऊरुद्वयसी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಡೆಯನ್ನು ಮುಟ್ಟುವಷ್ಟು ಎತ್ತರವಾದ /ತೊಡೆಯ ಪ್ರಮಾಣವುಳ್ಳ /ತೊಡೆಯ ಅಳತೆಯುಳ್ಳ /ತೊಡೆಯಷ್ಟು ಆಳವಾದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>ऊरू प्रमाणमस्याः<br><br>

ऊरुमात्र
ऊरुमात्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಡೆಯನ್ನು ಮುಟ್ಟುವಷ್ಟು ಎತ್ತರವಾದ /ತೊಡೆಯ ಪ್ರಮಾಣವುಳ್ಳ /ತೊಡೆಯ ಅಳತೆಯುಳ್ಳ /ತೊಡೆಯಷ್ಟು ಆಳವಾದ<br><b>निष्पत्तिः - </b>"मात्रच्" (५-२-३७)<br><b>व्युत्पत्तिः - </b>ऊरू प्रमाणमस्य<br><br>

ऊरुमात्री
ऊरुमात्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಡೆಯನ್ನು ಮುಟ್ಟುವಷ್ಟು ಎತ್ತರವಾದ /ತೊಡೆಯ ಪ್ರಮಾಣವುಳ್ಳ /ತೊಡೆಯ ಅಳತೆಯುಳ್ಳ /ತೊಡೆಯಷ್ಟು ಆಳವಾದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>ऊरू प्रमाणमस्याः<br><br>

ऊरुपर्वन्
ऊरुपर्वन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಡಿ /ತೊಡೆ ಮತ್ತುಮೊಣಕಾಲುಗಳ ಸಂಧಿ<br><b>व्युत्पत्तिः - </b>ऊरोः पर्व<br><br>

ऊरुस्तम्भ
ऊरुस्तम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಧಿವಾತ /ಮಂಡಿಯು ಚಲಿಸದಂತೆ ಮಾಡುವ ಒಂದು ವಾತರೋಗ<br><b>निष्पत्तिः - </b>"अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>ऊरू स्तभ्नाति<br><br>

ऊर्क्|ऊर्ज्
ऊर्क्(र्ज्)<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಲ /ಶಕ್ತಿ<br><b>निष्पत्तिः - </b>ऊर्ज (बलप्राणनयोः) - भावे "क्विप्" (३-२-१७७)<br><br>ऊर्क्(र्ज्)<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನ<br><br>ऊर्क्(र्ज्)<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಸ್ಯರಸ /ಅಂತಸ್ಸಾರ<br><b>निष्पत्तिः - </b>ऊर्ज (बलप्राणनयोः) - कर० "क्विप्" (३-२-१७७)<br><br>

ऊर्ज
ऊर्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ತಿಕ ಮಾಸ<br><b>निष्पत्तिः - </b>ऊर्ज (बलप्राणनयोः) + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>ऊर्जयति उत्साहयति जिगीषून्<br><b>प्रयोगाः - </b>"कृतमदं निगदन्त इवाकुलीकृतजगत्रयमूर्जमतङ्गजम्"<br><b>उल्लेखाः - </b>माघ० ६-५०<br><br>ऊर्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹ<br><br>ऊर्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲ /ಶಕ್ತಿ<br><br>ऊर्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೀವನ /ಬದುಕು<br><b>निष्पत्तिः - </b>ऊर्ज - भावे "अच्"<br><br>ऊर्ज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><b>निष्पत्तिः - </b>ऊर्ज (बलप्राणनयोः) + णिच् - "घज्" (३-३-१२१)<br><br>ऊर्ज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಕ್ತಿವಂತ /ಬಲಶಾಲಿ<br><b>निष्पत्तिः - </b>ऊर्ज - "अच्" (५-२-१२७)<br><b>विस्तारः - </b>"ऊर्जः कार्तिके बले" - हेम० । "ऊर्जस्तु कार्तिकोत्सहबलेषु प्राणनेऽपि च"- मेदि० ।<br><br>ऊर्ज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹಶಾಲಿ<br><br>

ऊर्जस्
ऊर्जस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹ<br><br>ऊर्जस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಹಾರ /ಅನ್ನ<br><br>ऊर्जस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಲ /ಶಕ್ತಿ<br><b>निष्पत्तिः - </b>ऊर्ज (बलप्राणनयोः) - "असुन्" (उ० ४-१८८)<br><br>ऊर्जस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಸ /ಧಾತು /ಸಾರ<br><br>

ऊर्जस्वत्
ऊर्जस्वत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಕ್ತಿವಂತ /ಬಲಶಾಲಿ<br><br>ऊर्जस्वत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಸವುಳ್ಳ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>अतिशयितं ऊर्जोऽस्यास्ति<br><br>

ऊर्जस्वती
ऊर्जस्वती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಸವುಳ್ಳ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

ऊर्जस्वल
ऊर्जस्वल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಲಶಾಲಿ /ಶಕ್ತಿವಂತ<br><b>निष्पत्तिः - </b>"बलच्" (५-२-११४)<br><b>व्युत्पत्तिः - </b>अतिशयितं ऊर्जोऽस्यास्ति<br><b>प्रयोगाः - </b>"तद्रक्ष कल्याणपरम्पराणां भोक्तारमूर्जस्वलमात्मदेहम्" "स्वकृतविलसितानां स्थानमूर्जस्वलानाम्"<br><b>उल्लेखाः - </b>रघु० २-५०, मालती० २-९<br><br>ऊर्जस्वल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತಮವಾದ/ಶ್ರೇಷ್ಠವಾದ<br><b>प्रयोगाः - </b>"अश्वमेध इति नाम विश्वविजयिनां क्षत्रियाणामूर्जस्वलः सर्वक्षत्रपरिभावी महानुत्कर्षनिकषः"<br><b>उल्लेखाः - </b>उ० रा० ४<br><br>

ऊर्जस्विन्
ऊर्जस्विन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಕ್ತಿವಂತ /ಬಲಶಾಲಿ<br><b>निष्पत्तिः - </b>"विनिः" (५-२-११४)<br><b>व्युत्पत्तिः - </b>अतिशयितं ऊर्जोऽस्यास्ति<br><br>

ऊर्जस्विनी
ऊर्जस्विनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಕ್ತಿವಂತೆ /ಬಲಶಾಲಿನಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

ऊर्जा
ऊर्जा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಲ /ಶಕ್ತಿ<br><br>ऊर्जा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹ<br><br>ऊर्जा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಧಿಕ್ಯ /ಅಭಿವೃದ್ಧಿ /ಬೆಳವಣಿಗೆ<br><br>ऊर्जा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಹಾರ /ಅನ್ನ<br><b>निष्पत्तिः - </b>ऊर्ज (बलप्राणनयोः) - "अः" (३-३-१०३)<br><br>

ऊर्जित
ऊर्जित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಲ /ಶಕ್ತಿ<br><b>निष्पत्तिः - </b>ऊर्ज (बलप्राणनयोः) - भावे "क्तः"(३-३-११४)<br><br>ऊर्जित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹ<br><br>ऊर्जित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಮರ್ಥ್ಯ<br><br>ऊर्जित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಲಶಾಲಿ /ಶಕ್ತಿವಂತ<br><b>निष्पत्तिः - </b>ऊर्ज (बलप्राणनयोः) - "क्तः"(३-४-७२)<br><b>प्रयोगाः - </b>"पित्र्यमंशुमुपवीतलक्षणं मातृकं च धनुरूर्जितं दधत्"<br><b>उल्लेखाः - </b>रघु० ११-६४<br><br>ऊर्जित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾರವತ್ತಾದ /ಅರ್ಥಗರ್ಭಿತವಾದ<br><b>प्रयोगाः - </b>"उपपत्तिमदूर्जिताश्रयं नृपमूचे वचनं वृकोदरः" "निशमय्य तदूर्जितं शिनेर्वचनं न्प्तुरनाप्तुरेनसाम्"<br><b>उल्लेखाः - </b>किरा० २-१, माघ० १६-३८<br><br>ऊर्जित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಶಯವಾದ /ದೊಡ್ಡದಾದ<br><br>ऊर्जित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾದ /ಅಧಿಕವಾದ<br><b>प्रयोगाः - </b>"विनिहत्य भवन्तमूर्जितश्रीर्युधि सद्यः शिशुपलतां यथार्थम्"<br><b>उल्लेखाः - </b>माघ० १६-८५<br><br>ऊर्जित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತಮವಾದ /ಶ್ರೇಷ್ಠವಾದ<br><br>ऊर्जित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಮನವಾದ /ಸುಂದರವಾದ<br><b>प्रयोगाः - </b>"कुसुमचापमतेजयदंशुभिर्हिमकरो मकरोर्जितकेतनम्"<br><b>उल्लेखाः - </b>रघु० ९-३९<br><br>ऊर्जित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಂಭೀರವಾದ /ಘನವಾದ /ಭವ್ಯವಾದ<br><b>प्रयोगाः - </b>"अलङ्घ्यत्वाज्जनैरन्यैः क्षुभितोदन्वदूर्जितम्"<br><b>उल्लेखाः - </b>किरा० ११-४०<br><br>

ऊर्ण
ऊर्ण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಣ್ಣೆ<br><br>ऊर्ण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಣ್ಣೆಬಟ್ಟೆ<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>ऊर्णास्त्यस्य कारणत्वेन<br><br>

ऊर्णा
ऊर्णा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಣ್ಣೆ<br><b>प्रयोगाः - </b>"मङ्गल्योर्णावलयिनि पुरः पावकस्योच्छिखस्य"<br><b>उल्लेखाः - </b>रघु०१६-८७<br><br>ऊर्णा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಣ್ಣೆ /ತುಪ್ಪಟ<br><br>ऊर्णा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹುಬ್ಬುಗಳ ನಡುವೆ ಇರುವ ಕೂದಲಿನ ಸುಳಿ<br><b>प्रयोगाः - </b>"ललाटपट्टे नवनलिननालभङ्गतन्वीयमूर्णा परिस्फुरति"<br><b>उल्लेखाः - </b>काद०<br><br>ऊर्णा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಾಯಂಭವ ಮನ್ವಂತರದ ಮರೀಚಿ ಮುನಿಯ ಪತ್ನಿ<br><br>

ऊर्णनाभ
ऊर्णनाभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೇಡರ ಹುಳ<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>ऊर्णेव तन्तुर्नभावस्य<br><br>

ऊर्णायु
ऊर्णायु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರಿಯ ತುಪ್ಪಟದಿಂದ ನೇಯ್ದ ಕಂಬಳಿ<br><br>ऊर्णायु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರಿ /ಟಗರು<br><br>ऊर्णायु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೇಡರ ಹುಳ<br><b>विस्तारः - </b>"ऊर्णायुरविकम्बले । ऊर्णनाभे च मेषे च" - हेम० ।<br><br>

ऊर्णासूत्र
ऊर्णासूत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಣ್ಣೆದಾರ /ಕಂಬಳಿದಾರ<br><b>व्युत्पत्तिः - </b>ऊर्णायाः सूत्रम्<br><br>

ऊर्द
ऊर्द<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಟವಾಡುವ<br><br>ऊर्द<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಳೆಯುವ<br><b>निष्पत्तिः - </b>उर्द (माने क्रीडायां च)- "अच्" (३-१-१३४)<br><br>

ऊर्दर
ऊर्दर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲಶಾಲಿ /ಶಕ್ತಿವಂತ /ಶೂರ<br><br>ऊर्दर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಕ್ಷಸ<br><b>निष्पत्तिः - </b>ऊर्क् + दृ (विदारणे) - "अच्" (उ० ५-४०)<br><b>विस्तारः - </b>"ऊर्दरः शूररक्षसोः" - सि० कौ० ।<br><br>ऊर्दर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯವನ್ನು ಅಳೆಯುವ ಒಂದು ಪಾತ್ರೆ<br><br>ऊर्दर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯವನ್ನು ಕೂಡಿಡುವ ಸ್ಥಳ /ಕಣಜ<br><br>

ऊर्ध्व
ऊर्ध्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತರ /ಔನ್ನತ್ಯ<br><br>ऊर्ध्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲುಮುಖವಾದ<br><b>प्रयोगाः - </b>"प्रबोधयत्यूर्ध्वमुखैर्मयूखैः"<br><b>उल्लेखाः - </b>कुमा० १-१६<br><br>ऊर्ध्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲ್ಪಟ್ಟ /ಮೇಲುಮುಖವಾಗಿ ನೀಡಲ್ಪಟ್ಟ<br><br>ऊर्ध्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲುಗಡೆಯಿರುವ /ಮೇಲುಭಾಗದಲ್ಲಿರುವ<br><br>ऊर्ध्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತರವಾದ /ಉನ್ನತವಾದ<br><br>ऊर्ध्व<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮೇಲುಗಡೆ /ಮೇಲುಭಾಗದಲ್ಲಿ<br><br>ऊर्ध्व<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನಂತರ /ತರುವಾಯ /ಬಳಿಕ<br><b>प्रयोगाः - </b>"साहं तपःसूर्यनिविष्टदृष्टिरूर्ध्वं प्रसूतेश्चरितुं यतिष्ये"<br><b>उल्लेखाः - </b>रघु० १४-६६<br><br>

ऊर्ध्वक
ऊर्ध्वक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಮದ್ದಳೆ /ಮೃದಂಗದ ಒಂದು ಭೇದ<br><b>निष्पत्तिः - </b>कै (शब्दे) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>ऊर्ध्वः कायति<br><br>

ऊर्ध्वकच|ऊर्ध्वकेश
ऊर्ध्वकच(केश)<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೆಟ್ಟಕೂದಲುಳ್ಳ /ಮೇಲುಮುಖವಾದ ಕೂದಲುಳ್ಳ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वाःकचाः केशा वा यस्य<br><br>

ऊर्ध्वकण्ठ
ऊर्ध्वकण्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎತ್ತರವಾದ ಕುತ್ತಿಗೆಯುಳ್ಳ /ಉದ್ದವಾದ ಕಂಠವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वः कण्ठो यस्य<br><br>ऊर्ध्वकण्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಹಾಶತಾವರೀ<br><br>

ऊर्ध्वकण्ठी
ऊर्ध्वकण्ठी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತರವಾದ ಕುತ್ತಿಗೆಯುಳ್ಳವಳು /ಉದ್ದವಾದ ಕಂಠವುವಳುಳ್ಳ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीष्" (वा० ४-१-५५)<br><br>

ऊर्ध्वकर
ऊर्ध्वकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲ್ಪಟ್ಟ ಕೈಯುಳ್ಳ<br><br>ऊर्ध्वकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲುಮುಖವಾದ ಕಿರಣವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वाः करा हस्ताःकिरणा वा यस्य<br><br>

ऊर्ध्वकर्ण
ऊर्ध्वकर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೆಟ್ಟ ಕಿವಿಯುಳ್ಳ /ಅಲುಗಾಡದೆ ಧ್ವನಿಯನ್ನು ಕೇಳುವ ಕಿವಿಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वौ कर्णौ यस्य<br><b>प्रयोगाः - </b>"मुक्तेषु रष्मिषु निरायतपूर्वकाया निष्कम्पचामरशिखा निभृतोर्ध्वकर्णाः"<br><b>उल्लेखाः - </b>शाकु० १-८<br><br>

ऊर्ध्वकर्मन्
ऊर्ध्वकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏಳುವುದು /ಮೇಲುಗಡೆಗೆ ಚಲಿಸುವುದು<br><b>व्युत्पत्तिः - </b>ऊर्ध्वं ऊर्ध्वदेशप्राप्त्यर्थं कर्म क्रिय<br><b>प्रयोगाः - </b>"उदोऽनूर्ध्वकर्मणि"<br><b>उल्लेखाः - </b>पा० सू० १-३-२४<br><br>ऊर्ध्वकर्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏಳುವ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वं कर्म यस्य<br><br>

ऊर्ध्वकाय
ऊर्ध्वकाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶರೀರದ ಮೇಲುಭಾಗ /ಮೇಲುಮೈ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वं कायः<br><br>

ऊर्ध्वकेतु
ऊर्ध्वकेतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜನಕ ಮಹಾರಾಜನ ವಂಶದ ಒಬ್ಬ ದೊರೆ<br><br>ऊर्ध्वकेतु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏರಿಸಲ್ಪಟ್ಟ ಧ್ವಜವುಳ್ಳ ದೊರೆ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वः उच्छितः केतुः ध्वजो यस्य<br><br>ऊर्ध्वकेतु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏರಿಸಲ್ಪಟ್ಟ ಧ್ವಜವುಳ್ಳ ನಗರ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वः केतुः यत्र<br><br>

ऊर्ध्वग
ऊर्ध्वग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ /ಮಹಾವಿಷ್ಣು<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "डः"(वा० ४-२-४८) ।महान् स्वभावतुङ्गो भवतीत्यर्थः ।<br><b>व्युत्पत्तिः - </b>ऊर्ध्वं उपरि गच्छति<br><b>प्रयोगाः - </b>"ऊर्ध्वगः सत्पथाचारः प्राणदःप्रणवः पणः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"योऽसौ स्वभावतस्तुङ्गः ऊर्ध्वगः परिकीर्तितः" - निरुक्तिः ।<br><br>ऊर्ध्वग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹದಲ್ಲಿ ಮೂಲುಮುಖವಾದ ವಾತದಿಂದುಂಟಾದ ಒಂದು ರೋಗ<br><b>प्रयोगाः - </b>"ऊर्ध्वगे रक्तपित्ते च शीतमम्भः प्रशस्यते"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>ऊर्ध्वग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲುಮುಖವಾಗಿ ಹೋಗುವ<br><b>प्रयोगाः - </b>"तपात्यये वारिभिरुक्षिता नवैर्भुवा सहोष्माणममुञ्चदूर्ध्वगम्"<br><b>उल्लेखाः - </b>कुमा० ५-२३<br><br>ऊर्ध्वग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸದಾಚಾರಸಂಪನ್ನ /ಧಾರ್ಮಿಕ<br><b>प्रयोगाः - </b>"धर्मेण गमनमूर्ध्वं गमनमधस्ताद्भवत्यधर्मेण"<br><b>उल्लेखाः - </b>सां० का०<br><br>ऊर्ध्वग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೇಳುವ /ಮೇಲಕ್ಕೆಚಲಿಸುವ<br><br>

ऊर्ध्वगामिन्
ऊर्ध्वगामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೇಳುವ /ಮೇಲಕ್ಕೆಚಲಿಸುವ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "णिनिः" (३-१-१३४)<br><br>

ऊर्ध्वगामिनी
ऊर्ध्वगामिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೇಳುವ /ಮೇಲಕ್ಕೆಚಲಿಸುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

ऊर्ध्वगति
ऊर्ध्वगति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏಳುವುದು /ಮೇಲುಗಡೆಗೆ ಚಲಿಸುವುದು<br><br>ऊर्ध्वगति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹೋಗುವುದು /ಮೇಲಕ್ಕೆ ಹಾರುವುದು<br><b>व्युत्पत्तिः - </b>ऊर्ध्वं गतिः<br><br>ऊर्ध्वगति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಧರ್ಮಕಾರ್ಯಗಳಿಂದ ಊರ್ಧ್ವಲೋಕಕ್ಕೆ ಹೋಗುವುದು<br><b>प्रयोगाः - </b>"ऊर्ध्वं गच्छन्ति सत्वस्थाः मध्ये तिष्ठन्ति राजसाः । जघन्यग्य्णवृत्तिस्थाः अधो गच्छन्ति तामसाः ॥"<br><b>उल्लेखाः - </b>गीता० ४-१८<br><br>ऊर्ध्वगति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲುಮುಖವಾದ ಗಮನವುಳ್ಳ /ಮೇಲಕ್ಕೆ ಹೋಗುವ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वं गतिर्यस्य<br><br>

ऊर्ध्वगपुर
ऊर्ध्वगपुर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತ್ರಿಪುರಾಸುರನ ಪಟ್ಟಣ<br><b>प्रयोगाः - </b>"समुद्धतपताकं तदसिभिश्च विराजितम् । रराज त्रिपुरं राजन् महाविद्युदिवाम्बरे ॥"<br><b>उल्लेखाः - </b>हरिवं०<br><br>

ऊर्ध्वगम
ऊर्ध्वगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹೋಗುವಿಕೆ /ಮೇಲಕ್ಕೆ ಹಾರುವಿಕೆ<br><b>निष्पत्तिः - </b>ऊर्ध्व + गम्लृ (गतौ) - भावे "अप्" (३-३-५८)<br><br>

ऊर्ध्वगमन
ऊर्ध्वगमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹೋಗುವಿಕೆ /ಮೇಲಕ್ಕೆ ಹಾರುವಿಕೆ<br><b>निष्पत्तिः - </b>ऊर्ध्व + गम्लृ (गतौ) - भावे "ल्युट्" (३-३-११५)<br><br>

ऊर्ध्वचरण|ऊर्ध्वपाद
ऊर्ध्वचरण (पाद)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶರಭಮೃಗ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वाः चरणाः पादा व अस्य<br><b>विस्तारः - </b>ಶರಭಮೃಗದ ಕಾಲುಗಳ ಪೈಕಿ ೪ ಕಾಲುಗಳು ಮೇಲುಮುಖವಾಗಿವೆ.<br><br>

ऊर्ध्वजानु
ऊर्ध्वजानु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ದವಾದ ಮೊಣಕಾಲುಳ್ಳವನು /ನೆಟ್ಟಗೆ ನಿಂತ ಮೊಣಕಾಲುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>ऊर्ध्वे जानुनी यस्य<br><br>

ऊर्ध्वजानुक
ऊर्ध्वजानुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ದವಾದ ಮೊಣಕಾಲುಳ್ಳವನು /ನೆಟ್ಟಗೆ ನಿಂತ ಮೊಣಕಾಲುಳ್ಳವನು<br><b>निष्पत्तिः - </b>वा "कप्" (५-४-१५४)<br><br><b>कन्नडार्थः - </b>ಉದ್ದವಾದ ಮೊಣಕಾಲುಳ್ಳವನು /ನೆಟ್ಟಗೆ ನಿಂತ ಮೊಣಕಾಲುಳ್ಳವನು<br><b>निष्पत्तिः - </b>जानुनो वा "ज्ञुः" (५-४-१३०)<br><b>प्रयोगाः - </b>"परिशिथिलितकर्णग्रीवमामीलिताक्षः क्षणमयमनुभूव स्वप्नमूर्ध्वज्ञुरेव"<br><b>उल्लेखाः - </b>माघ० ११-११<br><br>

ऊर्ध्वज्वलन
ऊर्ध्वज्वलन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲುಮುಖವಾದ ಜ್ವಾಲೆಯುಳ್ಳ ಅಗ್ನಿ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वं ज्वलनं यस्य<br><br>ऊर्ध्वज्वलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲುಮುಖವಾದ ಜ್ವಾಲೆ /ಉರಿ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वं ज्वलनम्<br><b>प्रयोगाः - </b>"प्रसिद्धमूर्ध्वज्वलनं हविर्भुजः"<br><b>उल्लेखाः - </b>माघ० १-२<br><br>

ऊर्ध्वतस्
ऊर्ध्वतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ /ಮೇಲಿಂದ /ಮೇಲುಗಡೆ<br><b>निष्पत्तिः - </b>ऊर्ध्व - "तसिः" (वा० ५-४-४४)<br><br>

ऊर्ध्वदिश्
ऊर्ध्वदिश्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಿನ ದಿಕ್ಕು /ತಲೆಗೆ ಮೇಲುಭಾಗದ ದಿಕ್ಕು<br><b>व्युत्पत्तिः - </b>ऊर्ध्वा दिक्<br><br>

ऊर्ध्वदृश्
ऊर्ध्वदृश्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲುದೃಷ್ಟಿಯುಳ್ಳ /ಮೇಲುಗಡೆ ನೊಡುವ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वा दृग्यस्य<br><br>

ऊर्ध्वदृष्टि
ऊर्ध्वदृष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲುನೋಟ<br><br>ऊर्ध्वदृष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯೋಗಾಭ್ಯಾಸಸಮಯದಲ್ಲಿ ಹುಬ್ಬುಗಳ ನಡುವೆ ಇಡುವ ದೃಷ್ಟಿ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वा दृष्टिः<br><br>ऊर्ध्वदृष्टि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲುನೋಟವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वा दृष्टिर्यस्य<br><br>

ऊर्ध्वधन्वन्
ऊर्ध्वधन्वन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ /ದೇವತೆಗಳ ಒಡೆಯ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वं धनुर्यस्य<br><b>विस्तारः - </b>पुलोमशत्रुर्हरिवानूर्ध्वधन्वा शचीपतिः" - वैज०<br><br>

ऊर्ध्वनापित
ऊर्ध्वनापित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂತಕಾದಿ ಸಮಯದಲ್ಲಿ ಹೊಕ್ಕಳಿಕೆ ಮೇಲುಭಾಗದ ಮೈಯ ಕ್ಷೌರ ಮಾಡುವವನು<br><b>विस्तारः - </b>"कुम्भकारो भाण्डवृत्तिरेष स्यादूर्ध्वनापितः । नाभेरूर्ध्वं वपन् पुंसां सूतकप्रेतकादिषु ॥" - वैज०<br><br>

ऊर्ध्वपुण्ड्र
ऊर्ध्वपुण्ड्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಣೆಯಲ್ಲಿ ಬರೆಯುವ ಮೇಲುಮುಕವಾದ ತಿಲಕ /ಕಬ್ಬಿನಂತೆ ನೆಟ್ಟಗಿರುವ ತಿಲಕ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वः ऊर्ध्वमुखः पुण्ड्रः इक्षुरिव<br><b>विस्तारः - </b>ಪುಂಡ್ರವು ಮತದ ಒಂದು ಚಿಹ್ನೆ. ಊರ್ಧ್ವಪುಂಡ್ರವು ವೈಷ್ಣವಮತದ ಚಿಹ್ನೆ. "द्यङ्गुलं त्र्यङ्गुलं वापि सन्तरालं प्रकल्पयेत् । पार्श्वावङ्गुलिमात्रौ तु ऊर्ध्वपुण्ड्रस्य लक्षणम् ॥" -सच्चरित्रर० ।<br><br>

ऊर्ध्वपूरम्
ऊर्ध्वपूरम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮೇಲುಮುಖವಾಗಿ ತುಂಬಿರುವ<br><b>निष्पत्तिः - </b>"णमुल्"<br><b>व्युत्पत्तिः - </b>ऊर्ध्वपूरं पूर्यते<br><b>विस्तारः - </b>ಬಿಂದಿಗೆ ಮೊದಲಾದ ಪಾತ್ರೆಗಳು ಮೇಲುಮುಖವಾಗಿದ್ದು ಮಳೆಯ ನೀರಿನಿಂದ ತುಂಬುವುವು.<br><br>

ऊर्ध्वपृश्नि
ऊर्ध्वपृश्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಜದ ಪಶು<br><br>

ऊर्ध्वबाहु
ऊर्ध्वबाहु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಲ್ಪಟ್ಟ ತೋಳುಗಳುಳ್ಳ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वः उत्तोलितो बाहुर्यस्य<br><b>प्रयोगाः - </b>"ऊर्ध्वबाहुर्विरौम्येषः न च कश्चिच्छृणोति मे । धर्मादर्थश्च कामश्च स किमर्थं न सेव्यते ॥"<br><b>उल्लेखाः - </b>भा० स्वर्गा० ५-७५<br><br>

ऊर्ध्वबुध्न
ऊर्ध्वबुध्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬುಡಮೇಲುಮಾಡಲ್ಪಟ್ಟ ಯತಲೆಕೆಳಗೆ ಮಾಡಲ್ಪಟ್ಟ /ಮೊಗಳಿ ಇರಿಸಲ್ಪಟ್ಟ<br><br>

ऊर्ध्वभाग
ऊर्ध्वभाग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲುಭಾಗ<br><br>ऊर्ध्वभाग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂದಿನ ಭಾಗ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वः उपरिस्थो भागः<br><br>

ऊर्ध्वमन्थिन्
ऊर्ध्वमन्थिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೈಷ್ಠಿಕ ಬ್ರಹ್ಮಚಾರಿ /ಗೃಹಸ್ಥಾಶ್ರಮವನ್ನು ಸ್ವೀಕರಿಸದೆ ಶಾಶ್ವತವಾಗಿ ಬ್ರಹ್ಮಚರ್ಯಾಶ್ರಮದಲ್ಲಿರುವವನು<br><b>निष्पत्तिः - </b>मन्थ (विलोडने) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>ऊर्ध्वं ब्रह्मचर्याद्युत्तरं गार्हस्थ्यादि मथ्नाति<br><br>

ऊर्ध्वमान
ऊर्ध्वमान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿನ್ನ ಬೆಳ್ಳಿ ಮೊದಲಾದುವನ್ನು ತೂಗಲು ತಕ್ಕಡಿಯಲ್ಲಿರುವ ತೊಲ .ಪವು ಸೇರು ಮುಂತಾದ ಬೊಟ್ಟು /ತೂಕ ಮಾಡುವ ಕಲ್ಲು ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>माङ् (माने) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>ऊर्ध्वमारोप्यते मीयते येन<br><br>ऊर्ध्वमान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತರವನ್ನು ಅಳೆಯುವ ಕೋಲು ಮುಂತಾದುದು<br><br>ऊर्ध्वमान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತರವನ್ನು ಕಂಡುಹಿಡಿಯುವ ಅಳತೆ<br><br>ऊर्ध्वमान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಿ ಅಳೆಯುವಿಕೆ<br><br>

ऊर्ध्वमुख
ऊर्ध्वमुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲುಮುಖವಾದ /ಮೇಲಕ್ಕೆಪಸರಿಸುತ್ತಿರುವ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वं मुखं यस्य<br><b>प्रयोगाः - </b>"पद्मानि यस्याग्रसरोरुहाणि प्रबोधयत्यूर्ध्वमुखैर्मयूखैः"<br><b>उल्लेखाः - </b>कुमा० १-१६<br><br>

ऊर्ध्वमूल
ऊर्ध्वमूल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಸಾರ ವೃಕ್ಷ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वः उत्कृष्टः पुरुषो मूलमस्य<br><b>प्रयोगाः - </b>"ऊर्ध्वमूलमधःशाखमश्वत्थं प्राहुरव्यययम् । छन्दांसि यस्य पर्णानि यस्तं वेद स वेदवित् ॥"<br><b>उल्लेखाः - </b>गीता० १५-१<br><br>

ऊर्ध्वमौहूर्तिक
ऊर्ध्वमौहूर्तिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಮುಹೂರ್ತದ ನಂತರ ಸಂಭವಿಸುವ /ಅತ್ಯಲ್ಪ ಕಾಲದ ನಂತರ ಉಂಟಾಗುವ<br><b>निष्पत्तिः - </b>"ठञ्" (४-३-११)<br><b>व्युत्पत्तिः - </b>ऊर्ध्वं मुहूर्ताद्भवः<br><b>प्रयोगाः - </b>"लिङ् चोर्ध्वमौहूर्तिके"<br><b>उल्लेखाः - </b>पा० सू० ३-३-९<br><br>

ऊर्ध्वरेतस्
ऊर्ध्वरेतस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ /ಮಹಾದೇವ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वमूर्ध्वमुखं रेतोऽस्य<br><br>ऊर्ध्वरेतस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸನಕಾದಿ ಮುನಿಗಳು<br><b>प्रयोगाः - </b>"ऊर्ध्वरेताः प्रजा हित्वा गच्छत्यक्षरसात्मताम् । एतान्येव निमित्तानि मुनीनामूर्ध्वरेतसाम् ॥"<br><b>उल्लेखाः - </b>भ० शान्ति० ६०-६<br><br>ऊर्ध्वरेतस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೀಷ್ಮಾಚಾರ್ಯರು<br><br>

ऊर्ध्वरोमन्
ऊर्ध्वरोमन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಶದ್ವೀಪದೊಳಗಿನ ಒಂದು ಪರ್ವತ<br><b>प्रयोगाः - </b>"चक्रबन्धुः चतुःशृङ्गः कपिलश्चित्रकूटो देवानिक ऊर्ध्वरोमा द्रविणः"<br><b>उल्लेखाः - </b>भाग० ५-२०-१६<br><br>ऊर्ध्वरोमन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲುಮುಖವಾದ ಕೂದಲುಳ್ಳ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वानि रोमाणि यस्य<br><b>प्रयोगाः - </b>"स पार्श्वहस्तांस्त्रीन् दृष्ट्वा पुरुषान् भृशदारुणान् । वक्रतुण्डानूर्ध्वरोम्णः आत्मानं नेतुमागतान् ॥"<br><b>उल्लेखाः - </b>भाग० ६-१-२८<br><br>

ऊर्ध्वलिङ्ग
ऊर्ध्वलिङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ /ಮಹಾದೇವ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वमुत्कृष्टं लिङ्गमस्य<br><b>प्रयोगाः - </b>"ऊर्ध्वरेता ऊर्ध्वलिङ्ग ऊर्ध्वशायी नभः स्थलः । त्रिजटश्चीरवासाश्च रुद्रः सेनापतिर्विभुः ॥"<br><b>उल्लेखाः - </b>भा० अनु० ४८-४६<br><br>

ऊर्ध्वलोक
ऊर्ध्वलोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಿನ ಲೋಕ /ಸ್ವರ್ಗ /ದೇವಲೋಕ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वो लोकः<br><br>

ऊर्ध्ववात
ऊर्ध्ववात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲುಮುಖವಾದ ವಾತ<br><b>प्रयोगाः - </b>"अधश्चोर्ध्वं च भावानां प्रवृत्तानां स्वभावतः । न वेगान् धारयेत् धीमान् वातादीनां जिजीविषुः ॥"<br><b>उल्लेखाः - </b>सुश्रुत०<br><b>विस्तारः - </b>ದೇಹದಲ್ಲಿ ಸ್ವಭಾವವಾದ ಗತಿಯನ್ನು ತಡೆದು ಮೇಲುಮುಖವಾಗಿ ಹೊರಡುವ ವಾಯು. ಮಲಮೂತ್ರಾದಿಗಳನ್ನು ತಡೆಯುವುದರಿಂದ ವಾಯುವು ಅದರ ಮಾರ್ಗವನ್ನು ಬಿಟ್ಟು ಮೇಲುಮುಖವಾಗಿ ಹೊರಡುವುದು.<br><br>ऊर्ध्ववात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಪ್ತವಾಯುಗಳಲ್ಲಿ ಪರೀವಾಹವೆಂಬ ಒಂದು ವಾಯು<br><br>

ऊर्ध्वशायिन्
ऊर्ध्वशायिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ /ಮಹಾದೇವ<br><b>प्रयोगाः - </b>"ऊर्ध्वरेता ऊर्ध्वलिङ्ग ऊर्ध्वशायी नभः स्थलः । त्रिजटश्चीरवासाश्च रुद्रः सेनापतिर्विभुः ॥"<br><b>उल्लेखाः - </b>भा० अनु० ४८-४६<br><br>ऊर्ध्वशायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲುಮುಖವಾಗಿ ಮಲಗುವ /ಅಂಗಲಾಚಿಕೊಂಡು ಮಲಗುವ ಶಿಶು<br><b>निष्पत्तिः - </b>शीङ् (स्वप्ने) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>ऊर्ध्वः शेते<br><br>

ऊर्ध्वस्रोतस्
ऊर्ध्वस्रोतस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೇತಸ್ಸಿನ ಪ್ರವಾಹವನ್ನು ಕೆಳಮುಖವಾಗಿ ಬಿಡದೆ ಮೇಲುಮುಖವಾಗಿ ತಡೆದು ನಿಲ್ಲಿಸುವ ಯೋಗಿ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वम् ऊर्ध्वगतं स्रोतः रेतःप्रवाहो यस्य<br><br>ऊर्ध्वस्रोतस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲುಮುಖವಾಗಿ ಆಹಾರವನ್ನು ಸಂಚರಿಸುವ ಗಿಡ ಮರ ಬಳ್ಳಿಗಳು<br><br>

ऊर्ध्वायन
ऊर्ध्वायन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೈಶ್ಯಜಾತಿಯ ಒಂದು ಹಕ್ಕಿ<br><b>प्रयोगाः - </b>"अरुणानृम्णाऽङ्गिरसी सावित्री सुप्रभाता ऋतम्भरा सत्यम्भरा इति महानद्यः । यासां जलोपस्पर्शनविधूत्रजस्त्मसो हंसपतङ्गोर्ध्वायनसत्याङ्गसञ्ज्ञाश्चत्वारो वर्णाः सहस्रायुषो विबुधोपमस्न्दर्शप्रजजनाः स्वर्गद्वारं त्रय्या विद्यया त्रयीमयं सूर्यमात्मानं यजन्ते ॥"<br><b>उल्लेखाः - </b>भाग० ५-२०-४<br><br>ऊर्ध्वायन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲುಗಡೆಗೆ ಹೋಗುವುದು /ಮೇಲುಮುಖವಾದ ಗಮನ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वमयनम्<br><br>ऊर्ध्वायन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲುಮುಖವಾಗಿ ಹೋಗುವ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वमयनं यस्य<br><br>

ऊर्ध्वावर्त
ऊर्ध्वावर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಬೆನ್ನು<br><br>

ऊर्ध्वासित
ऊर्ध्वासित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಗಲದ ಗಿಡ<br><br>ऊर्ध्वासित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲುಗಡೆ ಕುಳಿತುಕೊಳ್ಳುವುದು<br><br>ऊर्ध्वासित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲುಗಡೆ ಕುಳಿತಿರುವ<br><b>व्युत्पत्तिः - </b>ऊर्ध्वमासितः<br><br>

ऊर्मि
ऊर्मि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತರಂಗ /ಅಲೆ /ತೆರೆ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "मिः" उकारश्च (उ० ४-४४)<br><b>व्युत्पत्तिः - </b>ऋच्छति<br><b>प्रयोगाः - </b>"तमाधूतध्वजपटं व्योमगङ्गोर्मिवायुभिः । देवसूतभुजालम्बी जैत्रमध्यास्त राघवः ॥" "ऊर्मौ महत्यभिमुखापतितं निरीक्ष्य"<br><b>उल्लेखाः - </b>रामा०, माघ० ५-३२<br><br>ऊर्मि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇಗ /ತ್ವರೆ<br><br>ऊर्मि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಟ್ಟೆಯ ಮಡಿಕೆಯ ಗೆರೆ<br><br>ऊर्मि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೀಡೆ<br><br>ऊर्मि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶ /ಬೆಳಕು<br><br>ऊर्मि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಕಂಠೆ /ಪ್ರಿಯವಸ್ತುವನ್ನು ಹೊಂದುವ ಆಸೆ<br><b>विस्तारः - </b>"ऊर्मिः पीडाजवोत्कण्ठालेखाप्रकाशवीचिषु । वस्त्रसङ्कोचलेखायाम् ॥" - हेम० ।<br><br>ऊर्मि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮನುಷ್ಯನ ಶರೀರ /ಮನಸ್ಸು ಮತ್ತು ಪ್ರಾಣಗಳ೬ ವಿಧ ಧರ್ಮಗಳು<br><b>विस्तारः - </b>ಶೋಕಮೋಹಗಳು ಮನೋಧರ್ಮಗಳು. ಹಸಿವು ಮತ್ತು ಬಾಯಾರಿಕೆಗಳು ಪ್ರಾಣಧರ್ಮಗಳು.<br><br>ऊर्मि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಲುಸಾಲಾಗಿ ನಿಲ್ಲಿಸಲ್ಪಟ್ಟ ಕುದುರೆಗಳ ಬಹಳ ವೇಗವಾದ ನಡಿಗೆ<br><b>प्रयोगाः - </b>"अश्वाः प्यधुर्वसुमतीमतिरोचमानस्तूर्णं पयोधय इवोर्मिभिरापतन्तः"<br><b>उल्लेखाः - </b>माघ० ५-४<br><br>

ऊर्मिका
ऊर्मिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತರಂಗ /ಅಲೆ /ತೆರೆ<br><b>निष्पत्तिः - </b>ऊर्मि - स्वार्थे "कन्"<br><br>ऊर्मिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಕಂಠೆ /ಪ್ರಿಯವಸ್ತುವನ್ನು ಹೊಂದುವ ಆಸೆ<br><br>ऊर्मिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಂಜಾವರ /ದುಂಬಿಯ ಝೇಂಕಾರ<br><br>ऊर्मिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಟ್ಟೆಯ ಮಡಿಕೆಯ ಗೆರೆ<br><br>ऊर्मिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಂಗುರ<br><b>निष्पत्तिः - </b>कै (शब्दे) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>ऊर्मिरिव कायति<br><b>प्रयोगाः - </b>"यस्यामीत्युदितेतन्व्या वलयोऽभवदूर्मिका"<br><b>उल्लेखाः - </b>चन्द्रा०<br><b>विस्तारः - </b>"ऊर्मिका पुनः । उत्कण्ठायां भृङ्गनादे वस्त्रभङ्गेऽङ्गुलीयके" - हेम० ।<br><br>

ऊर्मिन्
ऊर्मिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ<br><br>ऊर्मिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲೆಗಳಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११६)<br><b>व्युत्पत्तिः - </b>ऊर्मिरस्त्यस्य<br><br>

ऊर्मिमत्
ऊर्मिमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ<br><br>ऊर्मिमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲೆಗಳಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>ऊर्मयः सन्त्यस्य<br><b>प्रयोगाः - </b>"उद्वर्तितानां महसा मणीनामूर्ध्वं प्रसर्पन्तमिवोर्मिमन्तम्"<br><b>उल्लेखाः - </b>याद० १८-१-८<br><br>ऊर्मिमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಕ್ರವಾದ /ಡೊಂಕಾದ<br><br>ऊर्मिमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಡಿಕೆಯಿಂದ ಕೂಡಿದ ಬಟ್ಟೆ<br><br>ऊर्मिमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುಂಗುರು ಗುಂಗುರಾಗಿರುವ ಕೂದಲು<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>ऊर्मिरिव वक्रतास्त्यस्य<br><br>

ऊर्मिमाला
ऊर्मिमाला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲೆಗಳ ಸಾಲು /ತರಂಗಗಳ ಪಂಕ್ತಿ<br><b>व्युत्पत्तिः - </b>ऊर्मीणां माला<br><br>

ऊर्मिमालिन्
ऊर्मिमालिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ /ಕಡಲು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११६)<br><b>व्युत्पत्तिः - </b>ऊर्मिमालाऽस्त्यस्य<br><b>प्रयोगाः - </b>"प्रत्युज्जगाम कथकैशिकेन्द्रश्चन्द्रं प्रवृद्धोर्मिरिवोर्मिमाली"<br><b>उल्लेखाः - </b>रघु० ५-६१<br><br>

ऊर्मिला
ऊर्मिला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜನಕ ಮಹಾರಾಜನ ಮಗಳು /ಲಕ್ಷ್ಮಣನ ಪತ್ನಿ<br><b>प्रयोगाः - </b>"पार्थिवीमुदवाहद्रघूद्वहो लक्षणस्तदनुजामथोर्मिलाम्"<br><b>उल्लेखाः - </b>रघु० ११-५४<br><br>ऊर्मिला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಡನನ್ನು ಬಿಟ್ಟ ಹೆಂಗಸು<br><b>विस्तारः - </b>"पुनरूढा पुनर्भूः स्यादूर्मिला त्यक्तभर्तृका" - वैज०।<br><br>

ऊर्व
ऊर्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಔರ್ವನೆಂಬ ಮಹರ್ಷಿ<br><br>ऊर्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಡಬಾಗ್ನಿ<br><br>ऊर्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><br>ऊर्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದನಗಳ ಕೊಟ್ಟಿಗೆ<br><br>ऊर्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ<br><br>ऊर्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನ ಪಾತ್ರೆ<br><br>ऊर्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೊಡ್ಡದಾದ /ಮಹತ್ತಾದ<br><br>ऊर्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಸ್ತಾರವಾದ /ಅಗಲವಾದ<br><br>

ऊर्वङ्ग
ऊर्वङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಲೀಂದ್ರ /ನಾಯಿಕೊಡೆ<br><b>व्युत्पत्तिः - </b>ऊरुरुवाङ्गमस्य<br><br>

ऊर्वशी
ऊर्वशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಊರ್ವಶಿಯೆಂಬ ದೇವಲೋಕದ ವೇಶ್ಯೆ /ಪ್ರಸಿದ್ಧಳಾದ ಒಬ್ಬ ಅಪ್ಸರಸ್ಸು<br><b>निष्पत्तिः - </b>अशू (व्याप्तौ) - "अच्" (३--१-१३४) । "ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>ऊरुं नारायणोरुं कारणत्वेनाश्नुते व्याप्नोति<br><br>

ऊष
ऊष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರಳು ಮಣ್ಣು /ಚೌಳು ಮಣ್ಣು<br><b>निष्पत्तिः - </b>ऊष (रुजायाम्) - "कः" (३-१-१३५)<br><b>प्रयोगाः - </b>"कौशेयाविकयोरूषैः कुतपानामरिष्टकैः"<br><b>उल्लेखाः - </b>मनु० ५-१२०<br><br>ऊष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯ ರಂಧ್ರ<br><br>ऊष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಲಯ ಪರ್ವತ<br><br>ऊष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾತಃಕಾಲ<br><br>ऊष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಂಧ್ರ /ಬಿಲ<br><b>विस्तारः - </b>"ऊषः क्षारमृत्तिकायां प्रभातेऽपि पुमानयम् । तत्सन्धायाञ्च रन्ध्रे च चन्द्रनाद्रौ स्रवोबिले" - मेदि० ।<br><br>

ऊषा
ऊषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಊಷರ ಭೂಮಿ /ಚೌಳುಭೂಮಿ<br><br>ऊषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಷಾದೇವಿ /ಬಾಣಾಸುರನ ಮಗಳು<br><b>प्रयोगाः - </b>"उषाप्यूषा ननन्दा च ननान्दापि च प्रकीर्तिता"<br><b>उल्लेखाः - </b>शब्दभेद० ।<br><br>

ऊषक
ऊषक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾತಃಕಾಲ<br><b>निष्पत्तिः - </b>ऊष (दाहे) - "ण्वुल्"<br><b>व्युत्पत्तिः - </b>ऊषति अन्धकारम्<br><br>

ऊषण
ऊषण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರಮೂಲದ ಗಿಡ /ಚಿತ್ರಕ ವೃಕ್ಷ<br><br>ऊषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೆಣಸು<br><br>ऊषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಪ್ಪಲಿಯ ಬೇರು<br><br>ऊषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶುಂಠಿ<br><b>निष्पत्तिः - </b>ऊष (दाहे) - "ल्युट्" (३-३-११३)<br><br>

ऊषणा
ऊषणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಪ್ಪಲಿ<br><br>ऊषणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚವ್ಯ<br><br>ऊषणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜೀರಿಗೆ<br><br>ऊषणा<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರವಾದ /ತೀಕ್ಷ್ಣವಾದ<br><b>विस्तारः - </b>"ऊषणं मरीचे क्लीबं कणायामूषणा स्मृता" - मेदि० । "स्त्री शुन्ठिरूषणं विश्वभेषजं सिंहलं कटम् ।" - वैज०<br><br>

ऊषर
ऊषर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರಳು ಮಣ್ಣು /ಚೌಳು ಮಣ್ಣು<br><br>ऊषर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೌಳುಮಣ್ಣಿನಿಂದ ಕೂಡಿದ /ಕರಳು ಮಣ್ಣಿನಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>रा (दाने) - "कः" (३-१-१३६) । "रः" (५-२-१०७)<br><b>व्युत्पत्तिः - </b>ऊषं क्षारमृत्तिकां राति, ऊषः क्षारमृत्तिकास्यास्ति।<br><b>प्रयोगाः - </b>"वर्षुकस्य किमपः कृतोन्न्तेरम्बुदस्य परिहार्यमूषरम्"<br><b>उल्लेखाः - </b>माघ० १४-४६<br><b>विस्तारः - </b>"ऊषवानूषरो द्वावप्यन्यलिङ्गौ" - अम० । ऊषरो देशः । ऊषरा भूमिः । ऊषरं क्षेत्रम् ।<br><br>

ऊषरज
ऊषरज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚೌಳು ಉಪ್ಪು /ಚೌಳು ಮಣ್ಣಿನಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ ಉಪ್ಪು<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः"(३-२-१०१)<br><b>व्युत्पत्तिः - </b>ऊषराज्जायते<br><br>

ऊषवत्
ऊषवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ऊषर ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>ऊषोऽस्यास्ति<br><br>

ऊषवती
ऊषवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ऊषर ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

ऊष्म
ऊष्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಖ /ಬಿಸಿ /ಕಾವು<br><br>ऊष्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಸಿಗೆ ಕಾಲ<br><b>निष्पत्तिः - </b>ऊष (दाहे) - "मः" बाहु० ।<br><br>ऊष्म<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಾಖವಾದ /ಬಿಸಿಯಾದ<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>ऊष्मोऽस्यास्ति<br><br>

ऊष्मक
ऊष्मक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರೀಷ್ಮಋತು /ಬೇಸಿಗೆ ಕಾಲ<br><b>निष्पत्तिः - </b>ऊष्मन् - "कन्" (५-४-२९)<br><b>विस्तारः - </b>"ग्रीष्म ऊष्मकः । निदाघ उष्णोपगमः" - अम० ।<br><br>

ऊष्मण
ऊष्मण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಾಖವಾದ /ಬಿಸಿಯಾದ<br><b>निष्पत्तिः - </b>ऊष्मन् - "नः" (५-२-१००)<br><b>व्युत्पत्तिः - </b>ऊष्मास्यास्ति<br><br>

ऊष्मन्
ऊष्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರೀಷ್ಮಋತು /ಬೇಸಿಗೆ ಕಾಲ<br><br>ऊष्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಖ /ಬಿಸಿ /ಕಾವು<br><b>निष्पत्तिः - </b>ऊष (रुजायाम्) - "मनिन्" (३-२-७५)<br><b>प्रयोगाः - </b>"रविकान्तमयेन सेतुना सकलाहं ज्वलनाहितोष्मणा"<br><b>उल्लेखाः - </b>नैष० २-९३<br><br>ऊष्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಷ್ಪ /ಆವಿ /ಹಬೆ<br><b>प्रयोगाः - </b>"तपात्यये वारिभिरुक्षिता नवैर्भुवा सहोष्माणममुञ्चदूर्ध्वगम्"<br><b>उल्लेखाः - </b>कुमा० ५-२३<br><br>ऊष्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ ಷ ಸ ಹ ವರ್ಣಗಳು /ಹಬೆಯೊಡನೆ ಕೂಡಿದ ಗಾಳಿಯಿಂದ ಉಚ್ಚರಿಸಲ್ಪಡುವ ವರ್ಣ<br><b>प्रयोगाः - </b>"स्पर्शास्तस्याभ्वज्जीव्ः स्वरो देह उदाहृतः । ऊष्माणमिन्द्रियाण्याहुः अन्तस्था बलमात्मनः । स्वराः सप्त विहारेण भवन्ति स्म प्रजापतेः ॥"<br><b>उल्लेखाः - </b>भाग० ३-१२-४६, ४७<br><b>विस्तारः - </b>शषसहा ऊष्माणः - सि० कौ०<br><br>

ऊष्मागम
ऊष्मागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರೀಷ್ಮಋತು /ಬೇಸಿಗೆ ಕಾಲ<br><b>व्युत्पत्तिः - </b>ऊष्मण आगमोऽत्र<br><br>

ऊह|वितर्के
ऊह - वितर्के (भ्वा० आत्म० सक० से०)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಊಹಿಸು /ಯುಕ್ತಿಯಿಂದ ಅರ್ಥವನ್ನು ನಿರ್ಣಯಿಸು<br><br>

अप + ऊह|अपोह|अपोहति 
अप + ऊह (अपोहति)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ತಳ್ಳಿ ಹಾಕು /ತ್ಯಜಿಸು<br><b>प्रयोगाः - </b>"सर्वान् रसानपोहेत कृतान्नं च तिलैः सह" । "अपोह्य रामं कस्माद्धि दारचौर्यं त्वया कृतम्" । "अपोहद्बाणवर्षं तद्भल्ले रामोनिराकुलः"<br><b>उल्लेखाः - </b>मनु० १०-८६, रामा०, भट्टि० १७-८३<br><br>

प्र + ऊह|प्रौह|प्रौहः
प्र + ऊह (प्रौहः)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಬೇರೆ ಕಡೆಗೆ ಒಯ್ಯು /ಸ್ಥಳಾಂತರಕ್ಕೆಸಾಗಿಸು<br><br>

प्रति + ऊह|प्रत्यूह|प्रत्यूहति
प्रति + ऊह (प्रत्यूहति)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಮೇಲುಗಡೆ ಇಡು /ಮೇಲೆ ಇರಿಸು<br><br>प्रति + ऊह (प्रत्यूहति)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಡ್ಡಿಮಾಡು /ತಡೆಹಾಕು<br><br>

वि + ऊह|व्यूह|व्यूहति
वि + ऊह (व्यूहति)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಒಟ್ಟುಗೂಡಿಸು /ಸೇರಿಸು /ಗುಂಪುಕಟ್ಟು<br><br>वि + ऊह (व्यूहति)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸೇನೆಯನ್ನು ಒಂದು ವ್ಯವಸ್ಥಿತ ರೀತಿಯಲ್ಲಿ ನಿಲ್ಲಿಸು<br><br>वि + ऊह (व्यूहति)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ವಿಭಜಿಸು /ಪ್ರತ್ಯೇಕಿಸು<br><b>व्युत्पत्तिः - </b>ऊर्ध्वं सीमन्तं व्यूहति<br><b>प्रयोगाः - </b>"संहतान् योधयेदल्पान् कामं विस्तारयेद्बहून् । सूच्या वज्रेण चैवैतान् व्यूह्य व्यूहेन योधयेत् ॥"<br><b>उल्लेखाः - </b>मनु० ८-१९१<br><b>विस्तारः - </b>"व्यूहः स्याद्बलविन्यासे बृन्देऽपि" -नानार्थर०।<br><br>

सम् + ऊह|समूह|समूहति|समूहः
स्अम् + ऊह (समूहति । समूहः)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಒಟ್ಟುಗೂಡಿಸು /ಸೇರಿಸು /ಗುಂಪುಕಟ್ಟು<br><br>

परि + सम् + ऊह|परिसमूह|परिसमूहति
परि + सम् + ऊह (परिसमूहति)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಒರಿಸು /ತಾರಿಸು /ಸುತ್ತಲೂ ಶುದ್ಧಿ ಮಾಡು<br><b>प्रयोगाः - </b>"वेदिं परिसमुह्य"<br><br>

ऊह
ऊह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಕ್ತಿಯಿಂದ ಅರ್ಥವನ್ನು ನಿರ್ಣಯಿಸುವಿಕೆ /ವಿಮರ್ಶಿಸಿ ಹೇಳುವಿಕೆ /ಊಹೆ /ಕಲ್ಪನೆ<br><b>निष्पत्तिः - </b>ऊह (वितर्के) - भावे "घञ्" (३-३-१८)<br><br>ऊह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇದು ಈ ರೀತಿಯದೇ ಅಥವಾ ಬೇರೆ ರೀತಿಯದೇ ಎಂಬ ಸಂದೇಹ /ಬುದ್ಧಿಯ ೮ ಗುಣಗಳಲ್ಲೊಂದು<br><b>विस्तारः - </b>शुश्रूषा, श्रवणम्, ग्रहणम्, धारणम्, ऊहः, अपोहः, अर्थविज्ञानम्, तत्त्वज्ञानम् इति बुद्धेः अष्टौ गुणाः ।<br><br>

ऊहन
ऊहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಊಹಿಸುವಿಕೆ /ಅನುಮಾನಪಡುವಿಕೆ<br><b>निष्पत्तिः - </b>ऊह (वितर्के) - "ल्युट्" (३-३-११५)<br><br>

ऊहनीय
ऊहनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತರ್ಕಿಸಲು ಅರ್ಹವಾದ /ಉತ್ಪ್ರೇಕ್ಷಿಸಲ್ಪಡುವ /ವಿಮರ್ಶಿಸಲ್ಪಡೂವ /ಕಲ್ಪಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>ऊह (वितर्के) - अर्हादौ "अनीयर्" (३-१-९६)<br><br>ऊहनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧ್ಯಾಹಾರ ಮಾಡಲ್ಪಡುವ /ಅರ್ಥಪೂರ್ತಿಗಾಗಿ ಹೊಸದಾಗಿ ಸೇರಿಸಲ್ಪಡುವ ಪದ<br><b>निष्पत्तिः - </b>ऊह (वितर्के) - "शानच्" (३-२-१२४)<br><br>

ऊहमान
ऊहमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಹಿಸುತ್ತಿರುವ /ತರ್ಕಿಸುತ್ತಿರುವ<br><br>

ऊहा
ऊहा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಊಹೆ /ಕಲ್ಪನೆ/ತರ್ಕ<br><br>ऊहा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಮಾನ<br><br>ऊहा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪ್ರೇಕ್ಷೆ<br><br>ऊहा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಮರ್ಶೆ<br><b>निष्पत्तिः - </b>ऊह (वितर्के) - "अः" (३-३-१०३)<br><br>

ऊहित
ऊहित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಊಹೆ /ಕಲ್ಪನೆ/ತರ್ಕ<br><b>निष्पत्तिः - </b>ऊह (वितर्के) - भावे "क्तः" (३-३-१४)<br><br>ऊहित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಊಹಿಸಲ್ಪಟ್ಟ /ಯುಕ್ತಿಯಿಂದ ನಿರ್ಣಯಿಸಲ್ಪಟ್ಟ /ಕಲ್ಪಿಸಲ್ಪಟ್ಟ /ವಿಮರ್ಶಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>ऊह (वितर्के) - कर्म० "क्तः" (३-२-१०२)<br><br>

ऊहितवत्
ऊहितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಹಿಸಿರುವ /ತರ್ಕಿಸಿರುವ /ಕಲ್ಪಿಸಿರುವ<br><b>निष्पत्तिः - </b>ऊह (वितर्के) - "क्तवतुः" (३-२-१०२)<br><br>

ऊहितव्य
ऊहितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ऊहनीय ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>ऊह (वितर्के) - "तव्यः" (३-१-९६)<br><br>

ऊहिनी
ऊहिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೊರಕೆ /ಬರಲು /ಕಸಬರಿಕೆ<br><b>निष्पत्तिः - </b>ऊह (वितर्के) - "णिनिः" (३-१-१३४) । "ङीप्" (४-१-५)<br><br>

ऊह्य
ऊह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತರ್ಕಿಸಲು ಅರ್ಹವಾದ /ವಿಮರ್ಶಿಸಲು ಯೋಗ್ಯವಾದ /ಉತ್ಪ್ರೇಕ್ಷಿಸಲ್ಪಡುವ<br><br>ऊह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧ್ಯಾಹಾರ ಮಾಡಲು ಅರ್ಹವಾದ /ಅರ್ಥಪೂರ್ತಿಗಾಗಿ ಹೊಸದಾಗಿ ಸೇರಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>ऊह (वितर्के) - "ण्यत्" (३-१-१२४)<br><br>

ऋ
ऋ<br><br><b>कन्नडार्थः - </b>ಋಕಾರ<br><b>विस्तारः - </b>ಇದುವರ್ಣಮಾಲೆಯಲ್ಲಿ ಏಳನೆಯ ಅಕ್ಷರ. ಇದು ಆಭ್ಯಂತರವಿವೃತಪ್ರಯತ್ನದಿಂದ ಮೂರ್ಧಸ್ಥಾನದಲ್ಲಿ ಹುಟ್ಟುವ ಒಂದು ಸ್ವರವರ್ಣ. ಉದಾತ್ತ ಅನುದಾತ್ತ ಮತ್ತು ಸ್ವರಿತಗಳೆಂಬ ೩ ಭೇದಗಳುಳ್ಳ ಈ ಹ್ರಸ್ವ ಋಕಾರವು ಪುನಃ ಅನುನಾಸಿಕ ಮತ್ತು ಅನನುಸಾಸಿಕಗಳೆಂಬ ಭೇದದಿಂದ ಒಟ್ಟು ೬ ವಿಧವಾಗುವುದು. "विवृतमूष्मणां स्वराणां च । ऋटुरषाणां मूर्धा" - सि० कौ० ।<br><br>ऋ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಜ /ಆನೆ<br><br>ऋ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೈಲ /ಬೆಟ್ಟ<br><br>ऋ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿಯ ಭೇದ<br><br>ऋ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಭಾವ<br><br>ऋ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಾವಮೈದುನ /ಪತಿಯ ಸಹೋದರ /ಗಂಡನ ಒಡಹುಟ್ಟಿದವನು<br><br>ऋ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಗಲೋಕ<br><br>ऋ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆಗಳ ಶತ್ರು<br><br>ऋ<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನದಿ /ಹೊಳೆ<br><br>ऋ<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅದಿತಿ /ದೇವತೆಗಳ ತಾಯಿ<br><br>ऋ<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ /ಹೆಂಡ<br><b>विस्तारः - </b>"ऋकारः कुञ्जरे शैले धीभेदे देवमातरि । भावे देवरिपौ नद्यां सुरायां देवरे दिवि" - नानार्थर० ।<br><br>ऋ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ<br><br>ऋ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಾಕ್ಯ<br><b>विस्तारः - </b>"ऋ कुत्सायां च वाक्ये च देवमातर्यनव्ययम्" - हेम० ।<br><br>ऋ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪರಿಹಾಸ್ಯ /ನೋಡಿ ನಗುವಿಕೆ<br><br>ऋ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಬೋಧನೆ<br><br>

ऋ|गतौ|अनि०)ऋच्छति
ऋ - गतौ प्रापणे च (भ्वा० पर० सक० अनि०)ऋच्छति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೋಗು /ಹೊಂದು /ತಲುಪು<br><b>प्रयोगाः - </b>"आर्छन् वामं मृगाः कृष्णाः शस्त्राणां व्यस्मरन् भटाः"<br><b>उल्लेखाः - </b>भट्टि० १७-१०<br><br>ऋ - गतौ प्रापणे च (भ्वा० पर० सक० अनि०)ऋच्छति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪಡೆ /ಹೊಂದು /ಸಂಪಾದಿಸು<br><b>प्रयोगाः - </b>"शस्त्रीश्यामैरंशुभिराशु द्रुतमम्भश्छायामच्छामृच्छति नीलीसलिलस्य"<br><b>उल्लेखाः - </b>माघ० ४-४४<br><br>

ऋ|गतौ|इयर्ति
ऋ - गतौ (जुहो०पर० सक० अनि०) इयर्ति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೋಗು /ಚಲಿಸು<br><br>ऋ - गतौ (जुहो०पर० सक० अनि०) इयर्ति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ತಲುಪು<br><br>

ऋक्थ
ऋक्थ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧನ /ಹಣ<br><b>निष्पत्तिः - </b>ऋच (स्तुतौ) - "थक्" बाहु० ।<br><b>विस्तारः - </b>"द्रव्यं वित्तं स्वापतेयं रिक्थमृक्थं धनं वसु" - अम० ।<br><br>

ऋक्थग्राह
ऋक्थग्राह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾಯಾದ /ದಾಯವನ್ನು ಹೊಂದತಕ್ಕವನು /ಭಾಗ ಪಡೆಯಲು ಹಕ್ಕುದಾರ<br><b>निष्पत्तिः - </b>ग्रह (उपादाने) - "अण्" (३--१)<br><b>व्युत्पत्तिः - </b>ऋक्थं गृह्णाति<br><br>

ऋक्थग्राहक
ऋक्थग्राहक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾಯಾದ /ದಾಯವನ್ನು ಹೊಂದತಕ್ಕವನು /ಭಾಗ ಪಡೆಯಲು ಹಕ್ಕುದಾರ<br><b>निष्पत्तिः - </b>ग्रह (उपादाने) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>ऋक्थस्य ग्राहकः<br><br>

ऋक्थग्राहिन्
ऋक्थग्राहिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾಯಾದ /ದಾಯವನ್ನು ಹೊಂದತಕ್ಕವನು /ಭಾಗ ಪಡೆಯಲು ಹಕ್ಕುದಾರ<br><b>निष्पत्तिः - </b>ग्रह (उपादाने) - "णिनिः" (३-२-७८)<br><br>

ऋक्थग्राहिणी
ऋक्थग्राहिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಾಯವನ್ನು ಹೊಂದತಕ್ಕವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

ऋक्थिन्
ऋक्थिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಣವಂತ /ಐಶ್ವರ್ಯವಂತ /ಧನಿಕ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११६)<br><b>व्युत्पत्तिः - </b>ऋक्थमस्यास्ति<br><br>

ऋक्थिनी
ऋक्थिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಣವಂತೆ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

ऋक्ष
ऋक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಲ್ಲೂಕ /ಕರಡಿ<br><b>निष्पत्तिः - </b>ऋक्षि (हिंसायाम्) - "अच्" (३-१-१३४) । ऋषी (गतौ) - "सः" (उ०३-६६) व ।<br><b>व्युत्पत्तिः - </b>ऋक्षिणोति, ऋष्यते गहनमनेन ।<br><b>प्रयोगाः - </b>"वृको मृगेभं व्याघ्रोऽश्वं फलमूलं तु मर्कटः । स्त्रीमृक्षः स्तोकको वारि यानन्युष्ट्रःपशूनजः ॥"<br><b>उल्लेखाः - </b>मनु० १२-६७<br><br>ऋक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಪರ್ವತ /ಸಪ್ತ ಕುಲಪರ್ವತಗಳಲ್ಲೊಂದು<br><b>विस्तारः - </b>"महेन्द्रि मलयः सह्यः शुक्तिमान् ऋक्षपर्वतः । विन्ध्यश्च पारियात्रश्च सप्तैते कुलपर्वताः ॥"<br><br>ऋक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೋಣಕ ವೃಕ್ಷ /ಹೆಮ್ಮರ<br><b>विस्तारः - </b>"श्योनाकशुकनासर्क्षदीर्घवृन्तकुटन्नटाः" - अम० ।<br><br>ऋक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಜಮೀಢರಾಜನ ಮಗ<br><b>प्रयोगाः - </b>"धूमिन्या स तया देव्या त्वजमीढः समीयिवान् । ऋक्षं सञ्जनयामास धूर्मवर्णं सुदर्शनम् ॥ ऋक्षात् सं वरणो जज्ञे कुरुः संवरणात्तथा ॥"<br><b>उल्लेखाः - </b>हरिव०<br><br>ऋक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರವಂಶದ ದೇವಾತಿಥಿರಾಜನ ಮಗ<br><br>ऋक्ष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಾರೆ /ಚುಕ್ಕಿ /ನಕ್ಷತ್ರ<br><b>प्रयोगाः - </b>"पूर्वां सन्ध्यां जपं तिष्ठेत् सावित्रीमार्कदर्शनात् । पश्चिमं तु समासीनः सम्यगृक्षविभावनात् ॥"<br><b>उल्लेखाः - </b>मनु० २-१०१<br><br>ऋक्ष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಶಿ<br><b>प्रयोगाः - </b>"प्रययावातिथेयेषु वसन् ऋषिकुलेषु सः । दक्षिणां दिशमृक्षेषु वार्षिकेष्विव भास्करः ॥"<br><b>उल्लेखाः - </b>रघु० १२-२५<br><br>ऋक्ष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಕ್ಷತ್ರ<br><br>

ऋक्षा
ऋक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಕರಡಿ<br><br>ऋक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರ ದಿಕ್ಕು<br><br>

ऋक्षगन्धा
ऋक्षगन्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಲುಗುಂಬಳ<br><br>ऋक्षगन्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಂತನ ಗೊಂಡೆಸೊಪ್ಪು<br><b>निष्पत्तिः - </b>गन्ध (अर्दने) - "कः" (वा० ३-२-५)<br><b>व्युत्पत्तिः - </b>ऋक्षाम् ऋक्षसदृशान् हिंस्रान् गन्धयते अर्दयति<br><br>

ऋक्षगन्धिका
ऋक्षगन्धिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ऋक्षगन्धा ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"कन्" (५-३-७५)<br><br>

ऋक्षचक्र
ऋक्षचक्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಕ್ಷತ್ರಗಳ ಗುಂಪು /ಚಕ್ರಾಕಾರವಾದ ನಕ್ಷತ್ರಗಳ ಸಮೂಹ<br><b>व्युत्पत्तिः - </b>ऋक्षाणां चक्रम्<br><br>

ऋक्षर
ऋक्षर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಋತ್ವಿಕ್ಕು<br><b>निष्पत्तिः - </b>ऋषी (गतौ) - "क्सरन्" (उ० ३-७५)<br><br>ऋक्षर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಟಕಮುಳ್ಳು<br><br>ऋक्षर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಲಾಶಯ /ನೀರು ನಿಲ್ಲುವ ಸ್ಥಳ<br><b>विस्तारः - </b>"जलस्थामेत्वृक्षर ऋत्विजि" - वैज० ।<br><br>ऋक्षर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನಧಾರೆ /ಮಳೆಯ ಹನಿ<br><b>विस्तारः - </b>"ऋक्षरं वारिधारायामृक्षरश्चर्त्विजि स्मृतः" - मेदि० ।<br><br>

ऋक्षराज्|ऋक्षराज
ऋक्षराज् (राज)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ /ನಕ್ಷತ್ರಗಳ ಒಡೆಯ<br><b>निष्पत्तिः - </b>"टच्" (५-४-९१)<br><b>व्युत्पत्तिः - </b>ऋक्षाणां राट् ।ऋक्षाणां राजा वा ।<br><br>ऋक्षराज् (राज)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಾಂಬವಂತ<br><br>

ऋक्षवत्
ऋक्षवत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನರ್ಮದಾ ನದಿಯ ತೀರದಲ್ಲಿ ಇರುವಒಂದು ಬೆಟ್ಟ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>ऋक्षाः बाहुल्येन सन्त्यत्र<br><b>प्रयोगाः - </b>"निःशेषविक्षालितधातुनापि वप्रक्रियामृक्षवतस्तटेषु"<br><b>उल्लेखाः - </b>रघु० ५-४४<br><br>

ऋक्संहिता
ऋक्संहिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಋಗ್ವೇದ ಸಂಹಿತೆ<br><b>विस्तारः - </b>द्विवचने रूपम् ।<br><br>

ऋक्साम
ऋक्साम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಋಗ್ವೇದ ಮತ್ತುಸಾಮವೇದ<br><b>निष्पत्तिः - </b>"अच्" (५-४-७७) निपा० ।<br><b>व्युत्पत्तिः - </b>ऋक् च साम च<br><br>

ऋग्विधान
ऋग्विधान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಋಗ್ವೇದ ಮಂತ್ರಗಳಿಂದ ಕರ್ಮಾಚರಣೆಯನ್ನು ವಿಧಿಸುವ ಗ್ರಂಥ<br><b>व्युत्पत्तिः - </b>ऋचा ऋग्वेदेन कर्मणो विधानं यत्र<br><br>

ऋग्वेद
ऋग्वेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಲ್ಕು ವೇದಗಳಲ್ಲೊಂದು<br><br>

ऋच्
ऋच्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಋಗ್ವೇದ ಮಂತ್ರ<br><b>निष्पत्तिः - </b>ऋच (स्तुतौ) - "क्विप्"<br><b>व्युत्पत्तिः - </b>ऋच्यन्ते स्तूयन्ते देवा अनया<br><br>ऋच्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಛಂದೋಬದ್ಧವಾದ ಮಂತ್ರ /ವೃತ್ತಿನಿಯಮಕ್ಕೊಳಪಟ್ಟು ಪಾದವ್ಯವಸ್ಥೆಯಿರುವ ಮಂತ್ರ<br><b>प्रयोगाः - </b>"तुभ्यमग्रे पर्यवहन्सूर्या वहतुना सह । पुनः पतिभ्यो जायां दा अग्ने प्रजया सह ॥"<br><br>ऋच्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತೋತ್ರ<br><br>ऋच्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂಜೆ<br><br>

ऋचीक
ऋचीक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೃಗುವಂಶದ ಜಮದಗ್ನಿಯ ತಂದೆ /ಪರಶುರಾಮನ ತಾತ<br><br>

ऋचीष
ऋचीष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಟ್ಟು ಬೇಯಿಸುವ ಪಾತ್ರೆ<br><b>निष्पत्तिः - </b>ऋष (स्तुतौ) - "ईषन्" बाहु० ।<br><b>विस्तारः - </b>"ऋषीचं पिष्टपचनम्" -वैज० ।<br><br>

ऋच्छरा
ऋच्छरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇಶ್ಯೆ /ಸೂಳೆ<br><b>निष्पत्तिः - </b>ऋच्छ (गतौ) - "अरः" (उ० ३-१३१)<br><b>व्युत्पत्तिः - </b>ऋच्छति परपुरुषं प्राप्नोति<br><b>विस्तारः - </b>"ऋच्छरा वेश्या" - सि० कौ०।<br><br>

ऋजीक
ऋजीक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ /ದೇವತೆಗಳ ಒಡೆಯ<br><br>ऋजीक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧೂಮ /ಹೊಗೆ<br><b>निष्पत्तिः - </b>ऋज (गतौ) - "ईकन्" (उ० ४-२२)<br><br>

ऋजीष
ऋजीष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನರಕ<br><b>प्रयोगाः - </b>"लोहशङ्कुमृजीषं च पन्थानं शाल्मलीं नदीम्"<br><b>उल्लेखाः - </b>मनु० ४-९०<br><br>ऋजीष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೋಮಲತೆಯ ರಸ<br><br>ऋजीष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಟ್ಟು ಬೇಯಿಸುವ ಪಾತ್ರೆ<br><b>निष्पत्तिः - </b>अर्ज (अर्जने) - "ईषन्" (उ० ३-२८)<br><b>विस्तारः - </b>"ऋषीचं पिष्टपचनम्" -वैज० ।<br><br>

ऋजु
ऋजु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸರಳವಾದ /ವಕ್ರವಲ್ಲದ /ಕುಟಿಲವಲ್ಲದ /ನೆಟ್ಟಗಿರುವ<br><b>निष्पत्तिः - </b>अर्ज (अर्जने) - "कुः" धातोः "ऋज" आदेशश्च (उ० १-२७)<br><b>व्युत्पत्तिः - </b>अर्जयति गुणान्<br><b>प्रयोगाः - </b>"ऋजवस्ते तु सर्वे स्युरव्रणाः सौम्यदर्शनाः"<br><b>उल्लेखाः - </b>मनु० २-४७<br><br>ऋजु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾಮಾಣಿಕವಾದ /ಕಪಟವಿಲ್ಲದ /ಸರಳ ಸ್ವಭಾವದ /ನೀತಿವಂತ<br><b>प्रयोगाः - </b>"ऋजूंश्च विश्वासकृतः स्वभावान् गोपाङ्गनानां मुमुदे विलोक्य" । "उमां स पश्यन् ऋजुनैव चक्षुषा" ।<br><b>उल्लेखाः - </b>भट्टि० २-१५। कुमा० ५-३<br><br>ऋजु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿಯಿಲ್ಲದ /ಹುಟ್ಟಿಲ್ಲದ<br><b>विस्तारः - </b>"आद्यमादिभवे भक्ष्येप्युत्पत्तिरहितेऽप्यृजुः" - वैज० ।<br><br>

ऋज्वी|ऋजुः
ऋज्वी (जुः)<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ऋजु ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां वा "ङीष्" (४-१-४४)<br><b>प्रयोगाः - </b>"ऋज्वीर्दधानैरवतप्य कन्धराश्चलावचूडाः कलघर्घरारवैः"<br><b>उल्लेखाः - </b>माघ० १२-१८<br><br>

ऋजुकाय
ऋजुकाय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೇರವಾದ ಮೈಯುಳ್ಳ /ವಕ್ರವಲ್ಲದ ದೇಹವುಳ್ಳ /ಬಗ್ಗಿಲ್ಲದ ಮೈಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>ऋजुः कायो यस्य<br><b>प्रयोगाः - </b>"तस्मिन् स्वस्ति समासीनः ऋजुकायः समभ्यसेत्"<br><b>उल्लेखाः - </b>भाग० ३-२८-९<br><br>

ऋजुग
ऋजुग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "डः" (वा० ३-२-४८)<br><b>व्युत्पत्तिः - </b>ऋजु यथा तथा गच्छति<br><br>ऋजुग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾಮಾಣಿಕ /ಸರಳ ಸ್ವಭಾವದ /ನೀತಿವಂತ<br><br>

ऋजुगामिन्
ऋजुगामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾಮಾಣಿಕವಾಗಿ ನಡೆಯುವ /ಸರಳತೆಯಿಂದ ವರ್ತಿಸುವ<br><br>ऋजुगामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೆಟ್ಟಗೆ ಹೋಗುವ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "णिनिः" (३-२-४८)<br><b>व्युत्पत्तिः - </b>ऋजु यथा तथा गच्छति<br><br>

ऋजुगामिनी
ऋजुगामिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೆಟ್ಟಗೆ ಹೋಗುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

ऋजुता
ऋजुता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸರಳತೆ /ಪ್ರಾಮಾಣಿಕತೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>ऋजोर्भावः<br><br>ऋजुता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೇರವಾಗಿ ಇರುವಿಕೆ /ಡೊಂಕಿಲ್ಲದಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"ऋजुता वक्रतां प्राप वक्रता च तथार्जवम्" "ऋजुताफलशुद्धियोगभाजाम्"<br><b>उल्लेखाः - </b>चं० रा० , माघ० २०-९<br><br>

ऋजुत्वम्
ऋजुत्वम्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ऋजुता ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

ऋजूकरण
ऋजूकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೆಟ್ಟಗೆ ಮಾಡುವುದು /ಡೊಂಕಾಗಿರುವುದನ್ನು ನೇರವಾಗಿ ಮಾಡುವಿಕೆ<br><br>ऋजूकरण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಡೊಂಕಾಗಿರುವುದನ್ನು ನೆಟ್ಟಗೆ ಮಾಡುವ ಒಂದು ಸಾಧನ<br><b>निष्पत्तिः - </b>ऋजु - अभूतत० "च्विः" (५-४-५०) / दीर्घः (७-४-२६)<br><b>व्युत्पत्तिः - </b>अनृजुः ऋजुः क्रियतेऽनेन<br><br>

ऋज्र
ऋज्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಯಕ /ಯಜಮಾನ<br><b>निष्पत्तिः - </b>ऋज (गतिस्थनार्जनेषु) - "रन्" (उ० २-२८)<br><br>ऋज्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾಮಾಣಿಕ /ಸರಳತೆಯಿಂದ ವರ್ತಿಸುವವನು /ಕಪಟವಿಲ್ಲದವನು<br><br>

ऋज्वी
ऋज्वी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸರಳ ಸ್ವಭಾವದ ಹೆಂಗಸು /ಕಪಟವಿಲ್ಲದ ಹೆಂಗಸು<br><br>ऋज्वी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೇರವಾದ ಗತಿ /ವಕ್ರವಲ್ಲದ ಗಮನ<br><br>

ऋण
ऋण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಡ /ಸಾಲ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "क्तः" (३-२-१०२) । नत्वम् (८-२-६०)<br><b>व्युत्पत्तिः - </b>अर्यते<br><b>प्रयोगाः - </b>"श्राद्धेन प्रजया चैव पितॄणामनृणो भवेत् । ऋषीणां बह्मचर्येण श्रुतेन तपसा तथा ॥" "जायमानो वै ब्राह्मणस्त्रिभिरृणैः ऋणी भवति ब्रह्मचर्येण ऋषिभ्यो यज्ञेन देवेभ्यः प्रजया पितृभ्यः"<br><b>उल्लेखाः - </b>वि० ध०, श्रुतिः<br><br>

ऋणग्राहिन्
ऋणग्राहिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಲ ಮಾಡುವವನು /ಸಾಲ ಕೊಳ್ಳುವವನು<br><b>निष्पत्तिः - </b>"णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>ऋणं गृह्णाति<br><br>

ऋणदातृ
ऋणदातृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಲ ಕೊಡುವವನು<br><b>व्युत्पत्तिः - </b>ऋणस्य दाता<br><br>

ऋणदात्री
ऋणदात्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಲ ಕೊಡುವವಳು<br><b>व्युत्पत्तिः - </b>ऋणस्य दात्री<br><br>

ऋणदास
ऋणदास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾನು ಮಾಡಿದ ಸಾಲ ತೀರಿಸಲು ಸಾಧ್ಯವಾಗದೆ ಸಾಲ ತೀರ್ವೆಗಾಗಿ ಸೇವೆಮಾಡುವ ಸೇವಕ<br><b>व्युत्पत्तिः - </b>ऋणात् मोचनेन कृतो दासः<br><b>प्रयोगाः - </b>"ऋणमोचनाय दास्यत्वमुपगतः"<br><br>

ऋणमत्कुण
ऋणमत्कुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಾಮೀನುದಾರ /ಮತ್ತೊಬ್ಬನ ಸಾಲಕ್ಕೆ ಹೊಣೆಯಾಗಿರುವವನು<br><b>निष्पत्तिः - </b>कुण (शब्दोपकरणयोः) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>परकृतं ऋणं ममैवेति कुणति<br><br>

ऋणमुक्त
ऋणमुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಲ ತೀರಿಸಿದವನು /ಸಾಲದಿಂದ ಬಿಡುಗಡೆ ಹೊಂದಿದವನು<br><b>व्युत्पत्तिः - </b>ऋणान्मुक्तः<br><br>

ऋणमुक्ति
ऋणमुक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಲದಿಂದ ಬಿಡುಗಡೆ ಹೊಂದುವಿಕೆ /ಸಾಲ ತೀರಿಸುವಿಕೆ<br><b>व्युत्पत्तिः - </b>ऋणान्मुक्तिः<br><br>

ऋणमोचन
ऋणमोचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಲದಿಂದ ಬಿಡುಗಡೆ ಮಾಡುವಿಕೆ<br><b>व्युत्पत्तिः - </b>ऋणान्मोचनम्<br><br>ऋणमोचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಲದಿಂದ ಬಿಡುಗಡೆ ಮಾಡುವ<br><b>निष्पत्तिः - </b>मुच्लृ (मोक्ष्णे) + णिच् - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>ऋणान्मोचयति<br><br>

ऋणलेह्य
ऋणलेह्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಲದಪತ್ರ /ಸಾಲ ತೆಗೆದುಕೊಂಡ ಬಗ್ಗೆ ಬರೆದುಕೊಡುವ ದಸ್ತೈವೇಜು<br><b>व्युत्पत्तिः - </b>ऋणसूचकं लेख्यम्<br><br>

ऋणदान
ऋणदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಲ ಕೊಟ್ಟು ಬಡ್ಡಿ ಸಮೇತ ತೆಗೆದುಕೊಳ್ಳುವಿಕೆ<br><b>व्युत्पत्तिः - </b>ऋणस्य आदानं ग्रहणम्<br><br>

ऋणान्तक
ऋणान्तक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಜ /ಅಂಗಾರಕ ಗ್ರಹ<br><b>निष्पत्तिः - </b>अन्ति (नामधातुः) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>ऋणमन्तयति नाशयति<br><br>

ऋणापकरण
ऋणापकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಲದ ತೀರ್ವೆ /ಸಾಲದ ತೀರಿಸುವಿಕೆ<br><br>

ऋणापनोदन
ऋणापनोदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಲ ತೀರಿಸುವಿಕೆ /ಕೊಂಡ ಸಾಲವನ್ನು ಹಿಂದಕ್ಕೆ ಕೊಡುವುದು<br><b>व्युत्पत्तिः - </b>ऋणस्यापनोदनम्<br><br>

ऋणिक
ऋणिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಲ ಕೊಂಡವನು /ಕಡ ಪಡೆದವನು<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५)<br><b>व्युत्पत्तिः - </b>ऋणमस्त्यस्य<br><br>

ऋणिन्
ऋणिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಲ ತೆಗೆದುಕೊಂಡವನು /ಸಾಲ ಪಡೆದವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११६)<br><b>व्युत्पत्तिः - </b>ऋणमस्यास्ति<br><b>प्रयोगाः - </b>"जायमानो वै ब्राह्मणः त्रिभिरृणैर्ऋणी भवति ब्रह्मचर्येण ऋषिभ्यो यज्ञेन देवेभ्यः प्रजया पितृभ्यः"<br><b>उल्लेखाः - </b>श्रुतिः<br><br>

ऋणिनी
ऋणिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಲ ಪಡೆದವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

ऋणोद्ग्राहण
ऋणोद्ग्राहण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಲ ಕೊಟ್ಟವನು ಸಾಲ ಕೊಂಡವನಿಂದ ಹಣವನ್ನು ಹಿಂದಕ್ಕೆ ಪಡೆಯುವುದು<br><b>व्युत्पत्तिः - </b>ऋणस्योद्ग्राहणम्<br><br>

ऋत
ऋत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>ऋत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗ /ಯಜ್ಞ<br><br>ऋत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಜ /ಸತ್ಯ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "क्तः" (३-२-१०२) ।<br><b>प्रयोगाः - </b>"आयुष्ये प्राङ्मुखो भुङ्क्ते यशस्यं दक्षिणमुखः । श्रियं प्रत्यङ्मुखो भुङ्क्ते ऋतं भुङ्क्ते ह्युदङ्मुखः ॥"<br><b>उल्लेखाः - </b>मनु० २-५२<br><br>ऋत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜೀವನಕ್ಕಾಗಿ ಗದ್ದೆಗಳಲ್ಲಿ ನೆಲದಲ್ಲಿ ಬಿದ್ದಿರುವ ಕಾಳನ್ನಾಗಲಿ ಧಾನ್ಯದ ತೆನೆಗಳನ್ನಾಗಲಿ ಆರಿಸುವುದು<br><b>प्रयोगाः - </b>"ऋतामृताभ्यां जीवेत्तु मृतेन प्रभृतेन वा । सत्यानृताभ्यामपि वा न श्ववृत्त्या कदाचन ॥" "ऋतमुच्छशिलं ज्ञेयममृतं स्यादयाचितम्"<br><b>उल्लेखाः - </b>मनु० ४-४, मनु० ४-५<br><br>ऋत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><br>ऋत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮದ ಫಲ /ಪಾಪಪುಣ್ಯಗಳ ಫಲ<br><b>प्रयोगाः - </b>"ऋतं पिबन्तौ सुकृतस्य लोके"<br><b>उल्लेखाः - </b>श्रुतिः<br><br>ऋत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>"भगवान् वासुदेवश्च कीर्त्यतेऽत्र सनातनम् । स हि सत्यमृतं चैव पवित्रं पुण्यमेव च ॥"<br><b>उल्लेखाः - </b>भाग०<br><br>ऋत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಬ್ರಹ್ಮ<br><b>प्रयोगाः - </b>"ऋतमेकाक्षरं ब्रह्म"<br><b>उल्लेखाः - </b>श्रुतिः<br><br>ऋत<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಳ್ಳೆಯ ಸ್ವಭಾವ<br><br>ऋत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಮಾನವಾದ /ಹೊಳೆಯುವ<br><br>ऋत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂಜಿಸಲ್ಪಟ್ಟ<br><br>ऋत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸತ್ಯವಾದ /ನಿಜವಾದ<br><b>प्रयोगाः - </b>"सर्वमेतदृतं मन्ये यन्मां वदसि केशव"<br><b>उल्लेखाः - </b>गीता० १०-१४<br><b>विस्तारः - </b>"ऋतं शिलोच्छे पानीये पूजितेदीप्तसत्ययोः" - नानार्थर० ।<br><br>ऋत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಿಸಲ್ಪಟ್ಟ<br><br>ऋत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಜವಾಗಿ /ಸತ್ಯವಾಗಿ<br><b>विस्तारः - </b>"प्रापिते तु भवेदृतम् । शिलोञ्छसत्यसलिलसुशीलेषु तु नद्वयोः" - नानार्थर० ।<br><br>

ऋतुधामन्
ऋतुधामन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>ऋतं धामाऽस्य<br><b>विस्तारः - </b>"नरकजिदृतधामा केशवो जन्मकीलः क्रतुपुरुषनृसिंहश्रन्थजह्नुश्च" - त्रिकाण्ड० ।<br><br>ऋतुधामन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೧೪ ಮನುಗಳಲ್ಲೊಬ್ಬ ಮನು<br><br>ऋतुधामन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹನ್ನೆರಡನೆಯ ಮನ್ವಂತರದ ಇಂದ್ರ<br><br>ऋतुधामन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯದುವಂಶದ ಒಬ್ಬ ದೊರೆ<br><b>प्रयोगाः - </b>"कङ्कश्च कर्णिकायां वै ऋतधामजयावपि"<br><b>उल्लेखाः - </b>भाग० ९-२४-४४<br><br>ऋतुधामन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸತ್ಯಕ್ಕೆ ವಾಸಸ್ತಾನವಾಗಿರುವ<br><br>

ऋतुध्वज
ऋतुध्वज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಬ್ರಹ್ಮಋಷಿ<br><b>प्रयोगाः - </b>"हिरण्यनाभः कौसल्यः ऋतदेव ऋतध्वजः । एते परे च सिद्धेशाश्चरन्ति ज्ञानहेतवः ॥"<br><b>उल्लेखाः - </b>भाग० ६-१५-१५<br><br>ऋतुध्वज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಮಹಾದೇವ<br><br>

ऋतपेय
ऋतपेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದಿವಸದಲ್ಲಿ ನಡೆಸಬಹುದಾದ ಒಂದು ಯಾಗ<br><b>व्युत्पत्तिः - </b>ऋतं स्वर्गादिफलं पेयं भोग्यं यस्मात्<br><br>

ऋतम्
ऋतम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸತ್ಯವಾಗಿ /ನಿಜವಾಗಿ<br><br>

ऋतम्भर
ऋतम्भर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಯವನ್ನು ಕಾಪಾಡುವ ಪರಮಾತ್ಮ<br><b>निष्पत्तिः - </b>डुभृञ् (धारणपोषणयोः) - "खच्" (३-२-४६)<br><b>व्युत्पत्तिः - </b>ऋतं बिभर्ति<br><b>प्रयोगाः - </b>"ततो गतो ब्रह्मगिरोपहूत ऋतम्भरध्याननिवारिताघः"<br><b>उल्लेखाः - </b>भाग० ६-१३-१७<br><br>

ऋतम्भरा
ऋतम्भरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ಲಕ್ಷದ್ವೀಪದ ಒಂದುನದಿ<br><br>ऋतम्भरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾತಂಜಲ ಯೋಗದಲ್ಲಿ ಹೇಳಿರುವ ಸಮಾಧಿಕಾಲದ ಪ್ರಜ್ಜೆ<br><b>व्युत्पत्तिः - </b>ऋतं सत्यमात्मानं बिभर्ति प्रकाशयति<br><b>विस्तारः - </b>"ऋतम्भरा तत्र प्रज्ञा" - पा० यो० सू० १-४८<br><br>

ऋति
ऋति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಯಾಣ /ಮಂಗಳ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "क्तिन्" (३-३-९४)<br><br>ऋति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾರ್ಗ /ರಸ್ತೆ /ದಾರಿ<br><br>ऋति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜುಗುಪ್ಸೆ /ಅಸಹ್ಯ<br><br>ऋति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಮನ /ಚಲನ<br><br>ऋति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ<br><br>ऋति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಪರ್ಧೆ /ಹೋರಾಟ<br><b>विस्तारः - </b>"ऋतिः कल्याणवर्त्मनोः । जुगुप्सास्पर्धयोः स्त्री स्यात्" । -मेदि० । "ऋतिर्जुगुप्साकल्याणगतिस्पर्धासु" - हेम०।<br><br>ऋति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಮೃತಿ /ನೆನಪು<br><br>ऋति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆ /ಕಾಪಾಡುವಿಕೆ<br><br>

ऋतिङ्कर
ऋतिङ्कर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶುಭಕರವಾದ /ಮಂಗಳವನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "खच्" (३-२-४३)। मुमागमः (६-३-६७)<br><b>व्युत्पत्तिः - </b>ऋतिं करोति<br><br>ऋतिङ्कर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೀಡಿಸುವ /ತೊಂದರೆ ಕೊಡುವ<br><br>

ऋतीया
ऋतीया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜುಗುಪ್ಸೆ /ಅಸಹ್ಯ<br><br>ऋतीया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರ /ತೃಣೀಕರಿಸುವಿಕೆ /ಕಡೆಗಣಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>ऋति (सौत्रधातुः) - "ईयङ्" (३-१-२९)<br><br>

ऋतु
ऋतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಷದ ಆರನೆಯ ಒಂದು ಭಾಗ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "तुः" (उ० १-७१)<br><b>व्युत्पत्तिः - </b>ऋच्छति<br><br>ऋतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಸ /ತಿಂಗಳು<br><b>विस्तारः - </b>"ऋतुर्वर्षादिषट्सु च । आर्तवे मासिच पुमान्" - मेदि० ।<br><br>ऋतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತ್ರೀಯರ ರಜಸ್ಸು /ಹೆಂಗಸರ ಮುಟ್ಟು<br><br>ऋतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸರು ಗರ್ಭ ಧರಿಸಲು ಯೋಗ್ಯವಾದ ಕಾಲ /ಹೆಂಗಸರು ಮುಟ್ಟಾದ ಬಳಿಕ ಹದಿನಾರು ದಿನಗಳ ಕಾಲ<br><b>प्रयोगाः - </b>"ऋतुः स्वाभाविकः स्त्रीणां रात्रयः षोडश स्मृताः । चतुर्भिरितरैः सार्धमहोभिः सद्विगर्हितैः ॥" "ऋतुकालाभिगामी स्यात्स्वदारनिरतः सदा"<br><b>उल्लेखाः - </b>मनु० ३-४६, मनु० ३-४५<br><br>ऋतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>सर्वोल्लासकरैर्गुणैः ऋच्छति<br><b>प्रयोगाः - </b>"ऋतुः सुदर्शनः कालः परमेष्ठी परिग्रहः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"ऋच्छतीति ऋतुः प्रोक्तः सर्वोल्लासकरैर्गुणैः" - निरुक्तिः<br><br>ऋतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಮಹಾದೇವ<br><b>प्रयोगाः - </b>"ऋतुः संवत्सरो मासः पक्षः सङ्ख्या समापनः"<br><b>उल्लेखाः - </b>भा०<br><br>

ऋतुकाल
ऋतुकाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ऋतु ಪದದ ೪ನೆಯ ಅರ್ಥ<br><br>

ऋतुगण
ऋतुगण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಟ್ಟಿಗೆಕಲೆತ ಎಲ್ಲಾ ಋತ್ಗಳು<br><b>व्युत्पत्तिः - </b>ऋतूनां गणः<br><b>प्रयोगाः - </b>"ऋतुगणेन निषेवितुमादधे भुवि पदं विपदन्तकृतं सताम्"<br><b>उल्लेखाः - </b>माघ० ६-१<br><br>

ऋतुगामिन्
ऋतुगामिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಋತುಕಾಲದಲ್ಲಿ ಮಾತ್ರ ಹೆಂಗಸಿನೊಡನೆ ಸಂಭೋಗ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>ऋतौ गच्छति<br><br>

ऋतुनाथ|ऋतुपति
ऋतुनाथ(पति)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಋತುಗಳ ರಾಜ /ವಸಂತ ಋತು<br><b>व्युत्पत्तिः - </b>ऋतूनां नाथःपतिर्वा<br><b>विस्तारः - </b>ऋतूनां कुसुमाकरः - भगवद्गीता ।<br><br>

ऋतुपर्ण
ऋतुपर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಕ್ಷ್ವಾಕುವಂಶದ ಒಬ್ಬ ದೊರೆ /ಅಯುತಾಯುವಿನಮಗ<br><br>

ऋतुपर्यय
ऋतुपर्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಋತುಗಳು ಕ್ರಮವಾಗಿಬರುವಿಕೆ /ಋತುಗಳು ಒಂದಾದ ಮೇಲೊಂದು ಬರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>ऋतूनां पर्ययः<br><b>प्रयोगाः - </b>"यथर्तुलिङ्गान्यृतवः स्वयमेवर्तुपर्यते । स्वानि स्वान्यभिपद्यन्ते तथा कर्माणि देहिनः ॥"<br><b>उल्लेखाः - </b>मनु० १-३०<br><br>

ऋतुप्राप्त
ऋतुप्राप्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಫಲಿಸಿದವೃಕ್ಷ /ಆಯಾ ಋತುಗಳಿಗೆ ಯೋಗ್ಯವಾದ ಫಲಪುಷ್ಪಗಳಿಂದ ಕೂಡಿದ ಮರ<br><b>व्युत्पत्तिः - </b>ऋतुयोग्यः पुष्पादिः प्राप्तोऽनेन<br><br>

ऋतुमती
ऋतुमती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಷ್ಪವತಿಯಾದ ಹೆಂಗಸು /ಮೈನರೆದ ಹೆಂಗಸು /ರಜಸ್ವಲೆ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>ऋतुरस्त्यस्याः<br><b>प्रयोगाः - </b>"त्रीणि वर्षाण्युदीक्षेत कुमार्यृतुमती सती । ऊर्ध्वं तु कालादेतस्माद्विन्देत सदृशं पतिम् ॥"<br><b>उल्लेखाः - </b>मनु० ९-९०<br><br>

र्तुमुख
र्तुमुख<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಋತುವಿನಪ್ರಾರಂಭದ ದಿನ /ಚಾಂದ್ರಮಾಸದ ಶುಕ್ಲ ಪ್ರಥಮಾ ತಿಥಿ<br><b>व्युत्पत्तिः - </b>ऋतुर्मुखं प्रारम्भः<br><br>

ऋतुराज
ऋतुराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಋತುಗಳಿಗೆಲ್ಲಾ ಪ್ರಧಾನವಾದ ಋತು /ವಸಂತ ಋತು<br><b>निष्पत्तिः - </b>"टच्" (५-४-९१)<br><b>व्युत्पत्तिः - </b>ऋतूनां राजा<br><br>

ऋतुलिङ्गः
ऋतुलिङ्गः<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಸಂತಾದಿ ಋತುಗಳ ಗುರುತು /ಆಯಾ ಋತುಗಳು ಹುಟ್ಟುವ ಸೂಚನೆ<br><b>व्युत्पत्तिः - </b>ऋतोः लिङ्गम्<br><b>प्रयोगाः - </b>"यथार्तृलिङ्गान्यृतवः स्वयमेवर्तृपर्यये । स्वानि स्वान्यभिपद्यन्ते तथा कर्माणि देहिनः ॥"<br><b>उल्लेखाः - </b>मनु० १-३०<br><br>ऋतुलिङ्गः<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗ್ಸರು ಋತುಮತಿಯಾಗುವ ಸೂಚನೆ /ಹೆಣ್ಣುಮಕ್ಕಳು ಪುಷ್ಪವತಿಯರಾಗುವ ಲಕ್ಷಣಗಳು<br><br>

ऋतुसंहार
ऋतुसंहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಳಿದಾಸ ಕವಿಯು ೬ ಋತುಗಳನ್ನು ವರ್ಣಿಸಿರುವ ಒಂದುಕಾವ್ಯ<br><b>व्युत्पत्तिः - </b>ऋतूनां संहारो वर्ण्यत्वेनास्त्यस्य<br><br>

ऋतुसन्धि
ऋतुसन्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎರಡು ಋತುಗಳು ಸೇರುವ ಕಾಲ /ಅಮಾವಾಸ್ಯೆ<br><b>व्युत्पत्तिः - </b>ऋत्वोः मासयोः सन्धिः<br><br>

ऋतुसेव्य
ऋतुसेव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಯಾ ಋತುಗಳಲ್ಲಿ ಸೇವಿಸಲು ಯೋಗ್ಯವಾದ ಹಿತವಾದ ಆಹಾರ<br><b>व्युत्पत्तिः - </b>ऋतुभेदे सेव्यम्<br><br>

ऋद्ध
ऋद्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>ऋधु (वृद्धौ) - कर्त० "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"ऋद्धः स्पष्टाक्षरो मन्त्रः चन्द्रांशुर्भास्करद्युतिः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"पार्वणो जलधिर्यद्वत् वृद्धिमान् ऋद्ध उच्यते" - निरुक्तिः ।<br><br>ऋद्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಕ್ಕಿದ ಧಾನ್ಯ/ಬಡಿದು ತೆನೆಯಿಂದ ಬೇರ್ಪಡಿಸಲ್ಪಟ್ಟ ಧಾನ್ಯ<br><br>ऋद्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಿದ್ಧವಾದ ಅನ್ನ<br><b>निष्पत्तिः - </b>ऋधु (वृद्धौ) - कर्म० "क्तः" (३-२-१०२)<br><br>ऋद्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ /ಬೆಳವಣಿಗೆ<br><b>निष्पत्तिः - </b>ऋधु (वृद्धौ) - भावे० "क्तः" (३-३-११४)<br><br>ऋद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೃದ್ಧಿ ಹೊಂದಿದ /ಅಧಿಕವಾದ /ಬೆಳವಣಿಗೆ ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>ऋधु (वृद्धौ) - कर्त० "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"ऋद्धसर्वऋतुर्वृक्षवाटिकाकीरकृत्तसहकारशीकरैः"<br><b>उल्लेखाः - </b>नैष० १८-१०<br><br>ऋद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಪನ್ನವಾದ /ಸಂಪೂರ್ಣವಾದ /ತುಂಬಿರುವ<br><b>प्रयोगाः - </b>"इयमृद्धधना वृथावनी स्ववनी सम्प्रवदत्पिकापि का" । "अवाप्य भूमावसपत्नमृद्धं राज्यं सुराणामपि चाधिपत्यम्"<br><b>उल्लेखाः - </b>नैष० २-४८, गीता० २-८<br><br>ऋद्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧನಿಕ /ಐಶ್ವರ್ಯವಂತ<br><br>

ऋद्धि
ऋद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೃದ್ಧಿ /ಹೇರಳ /ಅತಿಶಯ<br><b>निष्पत्तिः - </b>ऋधु (वृद्धौ) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"परिच्छिन्नप्रभावर्धिर्न मया न च विष्णुना"<br><b>उल्लेखाः - </b>कुमा० २-५८<br><br>ऋद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಳವಣಿಗೆ /ಅಭಿವೃದ್ಧಿ<br><br>ऋद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಿದ್ಧಿ /ಕೈಗೂಡುವಿಕೆ<br><br>ऋद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಮೂಲಿಕೆ<br><br>ऋद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಮಿ<br><br>ऋद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರ್ವತಿ<br><br>ऋद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪತ್ತು /ಐಶ್ವರ್ಯ<br><b>निष्पत्तिः - </b>ऋधु (वृद्धौ) - "क्तिच्" (३-३-१७४)<br><br>ऋद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅದೃಷ್ಟ<br><br>ऋद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರನ ಪತ್ನಿ<br><br>

ऋद्धिकाम
ऋद्धिकाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿಯನ್ನು ಅಪೇಕ್ಷಿಸುವ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) - "णिङ्" (३-१-३०) । "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>ऋद्धिं कामयते<br><br>ऋद्धिकाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಐಶ್ವರ್ಯವನ್ನು ಅಪೇಕ್ಷಿಸುವ<br><br>

ऋद्धिमत्
ऋद्धिमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿಯಿಂದ ಕೂಡಿದ /ಏಳಿಗೆ ಹೊಂದಿದ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>ऋद्धिरस्यास्ति<br><br>ऋद्धिमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೃದ್ಧಿಯುಳ್ಳ /ಪರಿಪೂರ್ಣವಾದ /ತುಂಬಿರುವ<br><b>प्रयोगाः - </b>"तमृद्धिमद्बन्धुजनाधिरूढैर्वृन्दैर्गजानां गिरिचक्रवर्ती"<br><b>उल्लेखाः - </b>कुमा० ७-५२<br><br>ऋद्धिमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಪತ್ತಿನಿಂದ ಕೂಡಿದ /ಐಶ್ವರ್ಯಸಂಪನ್ನನಾದ<br><b>प्रयोगाः - </b>"ऋद्धिमन्तमधिकर्द्धिरुत्तरः पूर्वमुत्सवनपोहदुत्सवः"<br><b>उल्लेखाः - </b>रघु० १९-५<br><br>

ऋधु|वृद्धौ|ऋध्यति
ऋधु - वृद्धौ (दिव० पर० अक० से०) ऋध्यति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದು<br><br>ऋधु - वृद्धौ (दिव० पर० अक० से०) ऋध्यति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಿದ್ಧಿ /ಪಡೆ<br><br>

ऋधु|वृद्धौ|ऋध्नोति
ऋधु - वृद्धौ (स्वादि पर० अक० से०) ऋध्नोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದು /ಬೆಳವಣಿಗೆ ಹೊಂದು<br><b>प्रयोगाः - </b>"नाब्रह्म क्षत्रमृध्नोति नाक्षत्रं ब्रह्म वर्धते"<br><b>उल्लेखाः - </b>मनु० ९-३२२<br><br>ऋधु - वृद्धौ (स्वादि पर० अक० से०) ऋध्नोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ತೃಪ್ತಿಪಡಿಸು /ಸಂತೋಷಪಡಿಸು<br><b>प्रयोगाः - </b>"सोऽहं प्राग्भवतैव भूतजननीमृध्नोमि खङ्गाहतिव्यस्तस्कन्धकबन्धरन्ध्ररुधिरप्राग्भारनिष्यन्दिना"<br><b>उल्लेखाः - </b>मालती० ५-२९<br><br>

सम् + ऋधु|समृधु|समृद्धिः
सम् + ऋधु = समृद्धिः<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಬೆಳವಣಿಗೆ ಹೊಂದು /ಅತಿಶಯವಾದ ಅಭಿವೃದ್ಧಿ ಹೊಂದು<br><b>प्रयोगाः - </b>"शत्रुपक्षं समुध्यन्तं यो मोहात्समुपेक्षते" । "लोकानन्यान्सृजेयुर्ये लोकपालांश्च कोपिताः । देवान् कुर्युरदेवांश्च कः क्षिण्वंस्तान् समृध्नुयात् ॥<br><b>उल्लेखाः - </b>भा० , मनु० ९-३१५<br><br>

ऋधक्
ऋधक्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸತ್ಯವಾಗಿ /ನಿಜವಾಗಿ<br><br>ऋधक्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಶಿೀಘ್ರವಾಗಿ /ಬೇಗ<br><br>ऋधक्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಬೇರೆಯಗಿ /ಪ್ರತ್ಯೇಕವಾಗಿ<br><br>ऋधक्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಾಮೀಪ್ಯ<br><br>ऋधक्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಲಾಘವ<br><b>प्रयोगाः - </b>"ऋधग्यतो अनिमिषं रक्षमाणाः" । "ऋधग्यतः सत्येन गच्छतः" ।<br><br>

ऋभु्
ऋभु्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><b>निष्पत्तिः - </b>ऋ + भू (सत्तायाम्) - "डुः" (वा० ३-२-१८०)<br><b>व्युत्पत्तिः - </b>अरि स्वर्गे अदित्यां वा भवति<br><b>विस्तारः - </b>"आदित्या ऋभवोऽस्वप्ना अमर्त्या अमृतान्धसः" - अम० ।<br><br>ऋभु्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆಗಳಿಂದಲೂ ಪೂಜಿಸಲ್ಪಡುವ ದೇವತೆ<br><b>प्रयोगाः - </b>"ऋभवो नाम तत्रान्ये देवानामै देवताः । तेषां लोकाः परतरे यान् यजन्तीह देवताः ॥"<br><b>उल्लेखाः - </b>भा० वन०<br><br>ऋभु्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಕ್ಷುಷ ಮನ್ವಂತರದ ಒಂದು ದೇವಗಣ<br><b>प्रयोगाः - </b>"चाक्षुषस्यान्तरे तात मनोर्देवानिमान् शृणु । आप्याः प्रभूता ऋभवः पृथुकाश्च दिवौकसः ॥ लेखा नाम महाराज पञ्च देवगणाः स्मृताः ॥"<br><b>उल्लेखाः - </b>हरिवं० ७-३२<br><br>

ऋभुक्ष
ऋभुक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಗ<br><b>निष्पत्तिः - </b>क्षि (निवासगत्योः) - "डः" (वा० ३-२-१०१)<br><b>व्युत्पत्तिः - </b>ऋभवो देवाः क्षियन्त्यत्र<br><b>विस्तारः - </b>"ऋभुक्षः स्वर्गवज्रयोः" - विश्व० ।<br><br>ऋभुक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಜ್ರಾಯುಧ<br><br>

ऋभुक्षिन्
ऋभुक्षिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><b>निष्पत्तिः - </b>क्षि (निवासगत्योः) - "डः" (वा० ३-२-१०१) । "इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>ऋभवो देवाः क्षियन्त्यत्र । सोऽस्यास्ति<br><b>विस्तारः - </b>"ऋभुक्षः स्वर्गवज्रयोः" - विश्व० ।<br><br>

ऋश्य|ऋष्य
ऋश्य (ष्य)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಮೇಲೆ ಬಿಳಿಚುಕ್ಕಿಗಳುಳ್ಳ ಜಿಂಕೆ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "श्यन्" बाहु० । ऋषी (गतौ) -"यक्" (उ० ४-१११) निपा० ।<br><b>व्युत्पत्तिः - </b>ऋच्छति<br><br>

ऋश्यमूक|ऋष्यमूक 
ऋश्य(ष्य)मूक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಋಶ್ಯಮೂಕಪರ್ವತ /ವಾಲಿಯ ಭಯದಿಂದ ಸುಗ್ರೀವನು ಬಂದು ಅವಿತುಕೊಂಡಿದ್ದ ಒಂದು ಪರ್ವತ<br><br>

ऋषभ
ऋषभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಷಭ /ಎತ್ತು<br><b>निष्पत्तिः - </b>ऋषी (गतौ) - "अभच्" (उ० ३-१२३)<br><b>व्युत्पत्तिः - </b>ऋषति<br><b>प्रयोगाः - </b>"ऋषभैकसहस्रा गा दद्यात् क्षत्रवधे पुमान्"<br><b>उल्लेखाः - </b>याज्ञ० ३-२६६<br><br>ऋषभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆರಿಗೆಹಾಲೆಯೆಂಬ ಒಂದು ಮೂಲಿಕೆ<br><b>विस्तारः - </b>"शृङ्गी तु ऋषभो वृषः" - अम० ।<br><br>ऋषभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆದಿ ಜಿನದೇವ<br><br>ऋषभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರಾಹ ಪುಚ್ಛ /ಹಂದಿಯ ಬಾಲ<br><br>

ऋषभ
ऋषभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಸಳೆಯ ಬಾಲ<br><br>ऋषभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯ ರಂದ್ರ /ಕರ್ಣಕುಹರ /ಕಿವಿಯೊಳಗಿನ ಪೊಳ್ಳು<br><br>ऋषभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೀಣೆ ಕಂಠ ಮೊದಲಾದುವುಗಳಲ್ಲಿ ಹೊರಡುವ ಸಪ್ತ ಸ್ವರಗಳಲ್ಲೊಂದು<br><b>निष्पत्तिः - </b>ऋषी (गतौ) - "अभच्" (उ० ३-१२३)<br><b>व्युत्पत्तिः - </b>ऋषति हृदयं प्रविशति<br><br>ऋषभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>(ಸಮಾಸಾಂತ್ಯದಲ್ಲಿ) ಶ್ರೇಷ್ಠ /ಉತ್ತಮ (पुरुषर्षभः, नरर्षभः इत्यादि)<br><b>प्रयोगाः - </b>"स कुरुष्व महोत्साहः कृपां मयि नरर्षभ"<br><b>उल्लेखाः - </b>रामा०<br><b>विस्तारः - </b>"स्युरुत्तरपदे व्याघ्रपुङ्गवर्षभकुञ्जराः । सिंहशार्दूलनागाद्याः पुंसि श्रेष्ठार्थगोचराः" ॥ - अम० ಕೆಲವೆಡೆ ವ್ಯಸ್ತವಾಗಿದ್ದರೂ ಶ್ರೇಷ್ಠಾರ್ಥವಾಚಕವಾಗುವುದು. "स्वलक्षणा प्रादुरभूत् किलास्यतः स मे ऋषीणामृषभः" - भाग० २-४-२२ । "ऋषभः स्यादादिजिने वृषभे भेषजे स्वरे । कर्णरन्ध्रे कोलपुच्छे श्रेष्ठे चाप्युत्तरस्थितः ॥ - हेम० । "ऋषभस्त्वौषधान्तरे । स्वरभिद्वृषयोः कर्णरन्ध्रकुम्भीरपुच्छयोः । उत्तरस्थः स्मृतः श्रेष्ठे" - मेदि० ।<br><br>ऋषभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾವಿಷ್ಣುವಿನ ಒಂದು ಅವತಾರ<br><br>ऋषभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಪರ್ವತ<br><br>ऋषभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದಿಸಿದ ಆನೆ<br><b>विस्तारः - </b>"ऋषभोऽद्रौ कर्णरन्ध्रे वृषे मत्तगजेश्वरे । वराहस्यापि पुच्छे" - नानार्थर० ।<br><br>

ऋषभकूट
ऋषभकूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಮಕೂಟ ಪರ್ವತ<br><br>

ऋषभगतिविलसित
ऋषभगतिविलसित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹದಿನಾರನೆಯ ಛಂದಸ್ಸಿನ ಒಂದು ವೃತ್ತ /ಭಗಣ ರಗಣ ಮೂರು ನಗಣಗಳು ಮತ್ತು ಒಂದು ಗುರುವಿರುವ ವೃತ್ತ<br><b>विस्तारः - </b>"भ्रौ त्रिनगाः स्वराः खमृषभगतिविलसितम्" - वृ० र० ।<br><br>

ऋषभध्वज
ऋषभध्वज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ /ಮಹಾದೇವ<br><b>व्युत्पत्तिः - </b>ऋषभो ध्वजोऽस्य<br><br>ऋषभध्वज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಜೈನ ಭಿಕ್ಷು<br><b>विस्तारः - </b>"ऋषभध्वज एषोऽपि शङ्करे चार्हदन्तरे" - मेदि० ।<br><br>

ऋषभी
ऋषभी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುರುಷನ ಆಕಾರವುಳ್ಳ ಹೆಂಗಸು /ಗಡ್ಡ ಮೀಸೆಗಳಿಂದ ಕೂಡಿದ ಹೆಂಗಸು<br><br>ऋषभी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಸುಗುನ್ನಿ ಗಿಡ<br><br>ऋषभी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿತಂತು<br><br>ऋषभी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಿರಾಲೆ ಗಿಡ<br><b>निष्पत्तिः - </b>ऋषभ - गौरा० "ङीष्" जाति वा "ङीष्"<br><b>विस्तारः - </b>"ऋषभी तु शूकशिम्ब्यां पुरुषाकारयोषिति । विधवायां शिरालायाम्" - हेम० ।<br><br>

ऋषि
ऋषि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಋಷಿ /ಜ್ಞಾನದಿಂದ ಸಂಸಾರದಕೊನೆಯನ್ನು ಮುಟ್ಟಿದವನು<br><b>निष्पत्तिः - </b>ऋषी (गतौ) - "इनिः" (उ० ४-११९)<br><b>व्युत्पत्तिः - </b>ऋषति ज्ञानेन संसारपारम्<br><b>प्रयोगाः - </b>"अशेषतीर्थोपहृताः कमण्डलोः निधाय पाणावृषिणाभ्युदीरिताः"<br><b>उल्लेखाः - </b>माघ० १-१८<br><b>विस्तारः - </b>"तपोनिर्धूतपाप्मानो याथातथ्याभिधायिनः । वेदवेदाङ्गतत्त्वज्ञाः ऋषयः परिकीर्तिताः ॥"<br><br>ऋषि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇದ<br><br>ऋषि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಣ<br><br>

ऋषिकुल्या
ऋषिकुल्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನದಿ<br><b>व्युत्पत्तिः - </b>ऋषीणां कुल्येव<br><b>प्रयोगाः - </b>"ऋषिकुल्यां समासाद्य नरः स्नात्वा विकल्मषः । देवान् पितॄंश्चार्चयित्वा ऋषिलोकं प्रपद्यते॥"<br><b>उल्लेखाः - </b>भा० वन० ८२-४९<br><br>ऋषिकुल्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಋಷಿಕುಲಕ್ಕೆಹಿತವಾದ<br><b>निष्पत्तिः - </b>"यत्" (५-१-५)<br><b>व्युत्पत्तिः - </b>ऋषिकुले साधुः<br><b>प्रयोगाः - </b>"अथ तस्योशतीं देवीमृषिकुल्यां सरस्वतीम् । नास्वाद्य मन्युदष्टानां तेषामात्माप्यतृप्यत ॥"<br><b>उल्लेखाः - </b>भाग० ३-१६-१३<br><br>

ऋषिजाङ्गलिकी
ऋषिजाङ्गलिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಋಕ್ಷಗಂಧೆಯೆಂಬ ಗಿಡ /ಅನಂತನ ಗೊಂಡೆಸೊಪ್ಪು<br><br>

ऋषिप्रोक्त
ऋषिप्रोक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಋಷಿಗಳಿಂದ ಹೇಳಲ್ಪಟ್ಟ<br><br>

ऋषिप्रोक्ता
ऋषिप्रोक्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶತಾವರೀ ಗಿಡ<br><br>ऋषिप्रोक्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಸುಗುನ್ನಿ ಗಿಡ<br><br>ऋषिप्रोक्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಬಲೆ /ಮಹಾಶತಾವರೀ<br><br>

ऋषियज्ञ
ऋषियज्ञ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹಸ್ಥನು ಪ್ರತಿದಿನವೂ ಮಾಡಬೇಕಾದ ಪಂಚಮಹಾಯಜ್ಞಗಳಲ್ಲೊಂದು<br><b>व्युत्पत्तिः - </b>ऋष्युद्देश्यको यज्ञः ऋषिर्देवः तदध्ययनरूपो यज्ञो वा<br><br>

ऋष्यकेतु
ऋष्यकेतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನಿರುದ್ಧ<br><br>

ऋष्यगन्धा
ऋष्यगन्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಂತನ ಗೊಂಡೆಸೊಪ್ಪು<br><b>व्युत्पत्तिः - </b>ऋष्यश्च मृगभेदस्य गन्ध इव गन्धो यस्याः<br><br>ऋष्यगन्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿ ನೆಲಗುಂಬಳ<br><br>

ऋष्यगन्धिका
ऋष्यगन्धिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ऋष्यगन्धा ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्वार्थे"कः" । "टाप्"<br><br>

ऋष्यप्रोक्ता
ऋष्यप्रोक्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶತಾವರೀ ಗಿಡ<br><br>ऋष्यप्रोक्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಬಲೆ /ಮಹಾಶತಾವರೀ<br><br>ऋष्यप्रोक्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಸುಗುನ್ನಿ ಗಿಡ<br><br>

ऋष्यमूक
ऋष्यमूक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಋಶ್ಯಮೂಕಪರ್ವತ /ವಾಲಿಯ ಭಯದಿಂದ ಸುಗ್ರೀವನು ಬಂದು ಅವಿತುಕೊಂಡಿದ್ದ ಒಂದು ಪರ್ವತ<br><b>व्युत्पत्तिः - </b>ऋष्यो मृगो मूको यत्र<br><br>

ऋष्यशृङ्ग
ऋष्यशृङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಋಷ್ಯಶೃಂಗ ಮಹರ್ಷಿ/ವಿಭಾಂಡಕ ಮಹರ್ಷಿಯ ಪುತ್ರ /ರೋಮಪಾದಮಹಾರಾಜನ ಮಗಳಾದ ಶಾಂತಾದೇವಿಯ ಪತಿ<br><b>व्युत्पत्तिः - </b>ऋष्यस्य मृगस्य शृङ्गमिव शृङ्गमस्य<br><br>ऋष्यशृङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾವರ್ಣಿಕ ಮನ್ವಂತರದಲ್ಲಿದ್ದ ಸಪ್ತರ್ಷಿಗಳಲ್ಲೊಬ ಋಷಿ<br><b>प्रयोगाः - </b>"रामो व्यासो गालवश्च दीप्तिमान् कृप एव च । ऋष्यशृङ्गस्तथा द्रौणिस्तत्र सप्तर्षयोऽभवन् ॥"<br><b>उल्लेखाः - </b>मार्क० ८०-४<br><br>

ऋक्षरजस्
ऋक्षरजस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾನರವಂಶದ ಒಬ್ಬ ಮೂಲಪುರುಷ<br><br>

ॠ
ॠ<br><br><b>कन्नडार्थः - </b>ೠಕಾರ<br><b>विस्तारः - </b>ಇದು ವರ್ಣಮಾಲೆಯಲ್ಲಿ ಮೂರ್ಧಾಸ್ಥಾನದಲ್ಲಿ ಹುಟ್ಟುವ ೮ನೆಯ ಸ್ವರವರ್ಣ. ಉದಾತ್ತ ಅನುದಾತ್ತ ಮತ್ತು ಸ್ವರಿತಗಳೆಂಬ ೩ ಭೇದಗಳುಳ್ಳ ಈ ದೀರ್ಘ ಋಕಾರವು ಪುನಃ ಅನುನಾಸಿಕ ಮತ್ತು ಅನನುಸಾಸಿಕಗಳೆಂಬ ಭೇದದಿಂದ ಒಟ್ಟು ೬ ವಿಧವಾಗುವುದು. "विवृतमूष्मणां स्वराणां च । ऋटुरषाणां मूर्धा" - सि० कौ० ।<br><br>ॠ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೈರವ<br><br>ॠ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದನುಜ /ದಾನವ<br><br>ॠ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಮೃತಿ /ನೆನಪು<br><br>ॠ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಕ್ಷಸ್ಸು /ಎದೆ<br><br>ॠ<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆಗಳ ತಾಯಿ /ಅದಿತಿ<br><br>ॠ<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಾನವರ ತಾಯಿ /ದನು<br><br>ॠ<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗತಿ /ಗಮನ<br><br>ॠ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಾಕ್ಯಾರಂಭ<br><br>ॠ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆ /ಕಾಪಾಡುವಿಕೆ<br><b>विस्तारः - </b>"ॠ वाक्यारम्भे रक्षायां वक्षः स्मृत्योरनव्ययम् । देवाम्बायां दनौ चापि भैरवे दनुजे गतौ ॥" - मेदि० ।<br><br>

ॠ|गतौ|ॠणाति 
ॠ- गतौ (क्र्या० पर० सक० से०) ॠणाति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೋಗು /ಚಲಿಸು /ನಡೆ<br><br>

लृ
लृ<br><br><b>कन्नडार्थः - </b>ಲೃಕಾರ<br><b>विस्तारः - </b>ಇದು ವರ್ಣಮಾಲೆಯಲ್ಲಿ ದಂತಸ್ಥಾನದಲ್ಲಿ ಹುಟ್ಟುವ ೯ನೆಯ ಸ್ವರವರ್ಣ. ಉದಾತ್ತ ಅನುದಾತ್ತ ಮತ್ತು ಸ್ವರಿತಗಳೆಂಬ ೩ ಭೇದಗಳುಳ್ಳ ಈ ಲೃಕಾರವು ಪುನಃ ಅನುನಾಸಿಕ ಮತ್ತು ಅನನುಸಾಸಿಕಗಳೆಂಬ ಭೇದದಿಂದ ಒಟ್ಟು ೬ ವಿಧವಾಗುವುದು.<br><br>लृ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅದಿತಿದೇವಿ /ದೇವತೆಗಳ ತಾಯಿ<br><br>लृ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಭೂಮಿ<br><br>लृ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪರ್ವತ /ಬೆಟ್ಟ<br><b>विस्तारः - </b>"लृकारो देवताम्बायां भुवि कुध्रे च कीर्तितः" - मेदि० ।<br><br>लृ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ<br><br>लृ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿಸ್ಮಯ /ಆಶ್ಚರ್ಯ<br><b>विस्तारः - </b>"लृ कुत्सायां विस्मये च" -हेम० ।<br><br>

लॄ
लॄ<br><br><b>विस्तारः - </b>ಇದೊಂದು ದಂತ್ಯ ದೀರ್ಘ ಸ್ವರವರ್ಣ. ಲೃಕಾರದಂತೆಯೇ ಇದೂ ೬ ವಿಧವಾಗುವುದು. ಇದು ಹತ್ತನೆಯ ಸ್ವರವರ್ಣ. ಪಾಣಿನಿಯ ವ್ಯಾಕರಣರೀತ್ಯಾ ಈ ವರ್ಣವಿಲ್ಲ. ಆದರೆ ಕೋಶಗಳಲ್ಲಿ ಮಾತ್ರ ಕಂಡುಬರುವುದು. ಮಂತ್ರಶಾಸ್ತ್ರದಲ್ಲಿ ಮಾತೃಕಾನ್ಯಾಸದಲ್ಲಿ ಇದರ ಪ್ರಯೋಗವುಂಟು.<br><br>लॄ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಓತಿಕೇತ<br><br>लॄ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇರುಪರ್ವತ<br><br>लॄ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><br>लॄ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆ<br><br>लॄ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೀಲೆಯಿಂದ ನಡೆಯುವಿಕೆ<br><br>लॄ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣಿನ ಎಲುಬು<br><br>लॄ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಗಮಾತೆ<br><br>लॄ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾಯಿ<br><b>विस्तारः - </b>"लॄकारः कृकलासेन्दे मेरौ हिमकरे सुरे । लीलागतौ लोचनास्थ्नि नागमातरि मातरि" - नानार्थर० ।<br><br>

ए
ए<br><br><b>कन्नडार्थः - </b>ಏಕಾರ<br><b>विस्तारः - </b>ಇದು ವರ್ಣಮಾಲೆಯಲ್ಲಿ ಕಂಠ ಮತ್ತು ತಾಲುಸ್ಥಾನಗಳಲ್ಲಿ ಹುಟ್ಟುವ ೧೧ನೆಯ ಸ್ವರವರ್ಣ.ಉದಾತ್ತ ಅನುದಾತ್ತ ಮತ್ತು ಸ್ವರಿತಗಳೆಂಬ ೩ ಭೇದಗಳುಳ್ಳ ಈ ದೀರ್ಘಸ್ವರವು ಅನುನಾಸಿಕ ಮತ್ತು ಅನನುನಾಸಿಕ ಭೇದದಿಂದ ೨ ವಿಧವಾಗಿ ಒಟ್ಟು ೬ವಿಧವಾಗುವುದು.<br><br>ए<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೇಜಸ್ಸು<br><br>ए<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><br>ए<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾತ್ರಿ<br><br>ए<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಡಿಯ ಒಳಭಾಗ<br><br>ए<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>ए<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕಾಶ<br><br>ए<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹನ್ನೊಂದುಸಂಖ್ಯೆ<br><br>ए<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾತಃಕಾಲ<br><br>ए<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರತ್ನಜಗುಲಿ<br><b>विस्तारः - </b>"एकारस्तेजसि जले रात्रौ हर्म्योदरे हरौ । व्योम्न्येकादशसङ्ख्यायां दिनादौ मणिकुट्टिमे" - नानार्थर० ।<br><br>ए<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸ್ಮೃತಿ /ನೆನಪು<br><br>ए<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಸೂಯೆ /ಹೊಟ್ಟೆಕಿಚ್ಚು<br><br>ए<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ದಯೆ /ಕನಿಕರ<br><br>ए<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಬೋಧನೆ<br><br>ए<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಹ್ವಾನ<br><b>विस्तारः - </b>"ए स्मृतावप्यसूयानुकम्पामन्त्रणहूतिषु" - मेदि० ।<br><br>

एक
एक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>इण् (गतौ) - "कन्" (उ० ३-४३)<br><b>व्युत्पत्तिः - </b>एति महिम्नि अतुल्यकक्ष्यतया सजातीयसङ्ख्येयाभावात् अद्वैतं गच्छति<br><b>प्रयोगाः - </b>"एको नैकः सवः कःकिम्"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"द्वितीयस्य सजातीयराहित्यादेक उच्यते" -निरुक्तिः ।<br><br>एक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು /ಒಬ್ಬ<br><b>प्रयोगाः - </b>"एको रागिषु राजते प्रियतमादेहार्धहारी हरो नीरागेषु जनो विमुक्तललनासङ्गो न यस्मात्परः"<br><b>उल्लेखाः - </b>भर्तृ० ३-१७<br><br>एक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂಟಿಯಾದ /ಅಸಹಾಯನಾದ<br><b>प्रयोगाः - </b>"एकः सम्प्रति नाशितप्रियतमस्तामेव रामः कथम्"<br><b>उल्लेखाः - </b>उ० रा० २-२८<br><br>एक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೇವಲ /ಒಂದು ಮಾತ್ರ /ಒಬ್ಬ ಮಾತ್ರ<br><b>प्रयोगाः - </b>"स च त्वदेकेषु निपातसाध्यो ब्रह्माङ्गभूर्ब्रह्मणि योजितात्मा"<br><b>उल्लेखाः - </b>कुमा० ३-१५<br><br>एक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಖ್ಯ /ಪ್ರಧಾನ /ಶ್ರೇಷ್ಠ<br><b>प्रयोगाः - </b>"एकैश्वर्ये स्थितोऽपि प्रणतबहुफले यः स्वयं कृत्तिवासाः"<br><b>उल्लेखाः - </b>माल० १-१<br><br>एक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಆದ /ಸಮಾನವಾದ /ಭಿನ್ನವಲ್ಲದ<br><b>प्रयोगाः - </b>"कथमेकान्वयो मम"<br><b>उल्लेखाः - </b>शाकु०<br><br>एक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎರಡರಲ್ಲಿ ಅಥವಾ ಬಹುವಸ್ತುಗಳಲ್ಲಿ ಒಂದು /ಒಂದಕ್ಕಿಂತಲೂ ಬೇರೆಯಾದ ಇನ್ನೊಂದು /ಇತರ /ಬೇರೆ<br><b>प्रयोगाः - </b>"एकः सङ्ख्यास्तव सह मया वामपादाभिलाषी काङ्क्षत्यन्यो वदनमदिरां दोहदच्छद्मनास्याः"<br><b>उल्लेखाः - </b>मेघ० २-१५<br><br>एक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಿರ್ದಿಷ್ಟ /ಯಾವುದೋ ಒಂದು<br><b>प्रयोगाः - </b>"स्त्रीसंस्थानं चाप्सरस्तीर्थमारादुत्क्षिप्यैनां ज्योतिरेकं जगाम"<br><b>उल्लेखाः - </b>शाकु ५-३०<br><br>एक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ರೀತಿಯಾದ/ಬದಲಾವಣೆ ಹೊಂದದ /ಸಮಾನವಾದ<br><b>प्रयोगाः - </b>"मनस्येकं वचस्येकं कर्मण्येकं महात्मनाम्"<br><b>उल्लेखाः - </b>हितो० १-१०१<br><br>एक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲವರು /ಇತರರು /ಬೇರೆಯವರು<br><b>प्रयोगाः - </b>"एकेसमूहुर्बलरेणुसंहतिं शिरोभिराज्ञामपरे महीभृतः"<br><b>उल्लेखाः - </b>माघ० १२-४५<br><br>

एकक
एकक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಹಾಯಕ /ಒಂಟಿಯಾಗಿರುವ<br><b>निष्पत्तिः - </b>एक - "कन्" (५-३-५२)<br><b>प्रयोगाः - </b>"विधिरेककचक्रचारिणं किमु निर्मित्सति मान्मथं रथम्"<br><b>उल्लेखाः - </b>नैष० २-३६<br><br>

एकिका
एकिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಹಾಯಕಿ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्" (४-१-४)<br><b>प्रयोगाः - </b>"निखिलान्निशि पूर्णिमा तीथीनुपतस्थेऽतिथिरेकिका तिथिः"<br><b>उल्लेखाः - </b>नैष० २-७६<br><br>

एककण्ठ
एककण्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಕಾಲದಲ್ಲಿ ಒಂದೇ ಕಂಠದಿಂದ ಹೇಳಲ್ಪಡುವ /ಏಕಕಾಲದಲ್ಲಿ ಅನೇಕರ ಒಂದೇ ಅಭಿಪ್ರಾಯ<br><br>

एककर
एककर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕಾರ್ಯವನ್ನು ಮಾಡುವ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "टः" (३-२-२१)<br><b>व्युत्पत्तिः - </b>एकं करोति<br><br>

एककरी
एककरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಕೈಯುಳ್ಳವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

एककरा
एककरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಕೈಯುಳ್ಳವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्" (४-१-४)<br><br>

एककर्तृ
एककर्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಕರ್ತೃವಿನಲ್ಲಿರುವ ಅನೇಕ ಕ್ರಿಯೆಗಳು<br><br>

एककर्तृक
एककर्तृक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಕರ್ತೃವಿನಲ್ಲಿರುವ ಅನೇಕ ಕ್ರಿಯೆಗಳು<br><b>निष्पत्तिः - </b>वा "कप्" (५-४-१५४)<br><br>

एककल्प
एककल्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಖ್ಯಕಲ್ಪ /ಪ್ರಥಮಕಲ್ಪ<br><br>एककल्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರೋಕ್ತವಾದ ಒಂದು ವಿಧಾನ /ಶಾಸ್ತ್ರವಿಹಿತವಾದ ಒಂದು ಕ್ರಮ<br><b>व्युत्पत्तिः - </b>एकः कल्पः<br><br>एककल्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಖ್ಯ ಕಲ್ಪವನ್ನು ಅನುಸರಿಸಿ ನಡೆಸಲ್ಪಡುವ ಕಾರ್ಯ<br><br>एककल्प<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಕ್ರಮವನ್ನು ಅನುಸರಿಸಿನಡೆಸಲ್ಪಡುವ /ಒಂದೇ ಕಲ್ಪದ ಅನುಸಾರವಾಗಿ ನಡೆಸಲ್ಪಡುವ ಯಾಗಾದಿಗಳು<br><b>व्युत्पत्तिः - </b>एकः कल्पो यस्य<br><br>

एककार्य
एककार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಕಾರ್ಯ<br><br>एककार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಕಾರ್ಯ /ಸಮಾನವಾದ ಕಾರ್ಯ<br><b>व्युत्पत्तिः - </b>एकं समानं कार्यम्<br><br>एककार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನೇಕ ಕಾರಣಗಳಿಂದ ನಿರ್ವಹಿಸಲ್ಪಡುವ ಒಂದು ಕಾರ್ಯ /ಅನೇಕ ಕಾರಣಗಳಿಂದ ಸಾಧಿಸಲ್ಪಡುವ ಒಂದು ಕಾರ್ಯ<br><br>एककार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಧ ಉದ್ಯೋಗವುಳ್ಳ /ಸಮಾನವಾದ ವೃತ್ತಿಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकं समानं कार्यं यस्य<br><br>

एककार्यत्व
एककार्यत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಏಕಕಾರ್ಯಾನುಕೂಲತ್ವ/೨ ಕಾರಣಗಳು ಒಂದು ಕೆಲಸಕ್ಕೆ ಅನುಕೂಲವಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><b>व्युत्पत्तिः - </b>एकं कार्यं ययोः कारणयोः<br><br>

एककाल
एककाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಕಾಲ /ಒಂದು ವೇಳೆ /ಒಂದು ಸಮಯ<br><b>व्युत्पत्तिः - </b>एकः कालः<br><br>एककाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಸಮಯ /ಸಮಾನವಾದ ಕಾಲ<br><b>व्युत्पत्तिः - </b>एकः समानः कालः<br><br>

एककालम्
एककालम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ವೇಳೆ /ಒಂದೇ ಸಲ<br><b>प्रयोगाः - </b>"एककालं चरेद्भैक्षं न प्रसज्येत विस्तरे"<br><b>उल्लेखाः - </b>मनु० ६-५५<br><br>एककालम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಸಮಯದಲ್ಲಿ /ಸಮಾನ ಕಾಲದಲ್ಲಿ<br><br>

एककालिक
एककालिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ವೇಳೆಯಲ್ಲಿ ಉಂಟಾದ /ಒಂದು ಕಾಲದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५)<br><b>व्युत्पत्तिः - </b>एककालो जनकतयाऽस्त्यस्य<br><b>प्रयोगाः - </b>"तेभ्यो लब्धेन भैक्षेण वर्तयन्नेककालिकम्"<br><b>उल्लेखाः - </b>मनु० ११-१२३<br><br>

एककुण्डल
एककुण्डल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲರಾಮ<br><br>एककुण्डल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರ<br><b>निष्पत्तिः - </b>एकं कुण्डलं यस्य<br><b>विस्तारः - </b>"एककुण्डल आख्यातो बलभद्रे धनाधिपे" - मेदि० ।<br><br>एककुण्डल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆದಿಶೇಷ<br><b>विस्तारः - </b>"अथानन्ने कुबेरे चैककुण्डलः" - वैज० ।<br><br>

एकगुरु
एकगुरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬನೇ ಗುರುವಿನ ಶಿಷ್ಯ /ಒಬ್ಬನೇ ಆಚಾರ್ಯನಲ್ಲಿ ಅಧ್ಯಯನ ಮಾಡುವ ಸಹಪಾಠಿ<br><b>व्युत्पत्तिः - </b>एकः अभिन्नो गुरुर्यस्य<br><br>

एकग्राम
एकग्राम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಗ್ರಾಮ /ಸಮಾನವಾದ ಗ್ರಾಮ<br><b>व्युत्पत्तिः - </b>एकः समानो ग्रामः<br><br>एकग्राम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಹಳ್ಳಿಯುಳ್ಳ /ಸಮಾನ ಗ್ರಾಮವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकः समानो ग्रामो यस्य<br><br>

एकग्रामीण
एकग्रामीण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಗ್ರಾಮದಲ್ಲಿ ನಿರಂತರವಗಿ ವಾಸಮಾಡುವ /ಒಂದೇ ಊರಿನಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"खञ्" (४-२-९४)<br><b>व्युत्पत्तिः - </b>एकग्रामे भवः<br><b>प्रयोगाः - </b>"नैकग्रामीणमतिथिं विप्रं साङ्गतिकं तथा । उपस्थितं गृहे विद्यात् भार्या यत्राग्नयोऽपि वा"<br><b>उल्लेखाः - </b>मनु० ३-१०३<br><br>

एकग्रामीय
एकग्रामीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಹಳ್ಳಿಗೆ ಸೇರಿದ /ಸಮಾನವಾದ ಹಳ್ಳಿಯಲ್ಲಿ ವಾಸಮಾಡುವ<br><b>निष्पत्तिः - </b>"छः"(४-२-१३८)<br><b>व्युत्पत्तिः - </b>एकग्रामे भवः<br><br>

एकग्राम्य
एकग्राम्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಹಳ್ಳಿಯಲ್ಲಿ ವಾಸಿಸುವ/ನಿರಂತರವಾಗಿ ಒಂದೇ ಊರಿನಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"यः" (४-२-९४)<br><b>व्युत्पत्तिः - </b>एकग्रामे भवः<br><br>

एकचक्र
एकचक्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ರಥ<br><b>व्युत्पत्तिः - </b>एकं चक्रं यस्य<br><b>प्रयोगाः - </b>"सप्त मुञ्चन्ति रथमेकचक्रमेकोऽश्वो वहति सप्तनामा । त्रिनाभिचक्रमजरमनर्वं यत्रेमा विश्वा भुवनाधितस्थुः ॥"<br><b>उल्लेखाः - </b>ऋ०<br><br>एकचक्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದುಚಕ್ರವುಳ್ಳ<br><b>प्रयोगाः - </b>"अध्वानं नैकचक्रः प्रभवति भुवनभ्रान्तिदीर्घं विलङ्घ्य प्राप्तः प्राप्तुं रथा मे पुनरिति मनसि न्यस्तचिन्तातिभारः"<br><b>उल्लेखाः - </b>रत्ना० ३-५<br><br>एकचक्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಜನುಳ್ಳ /ಒಬ್ಬ ರಾಜನಿಂದ ಕೂಡಿದ<br><b>प्रयोगाः - </b>"इत्थं व्रजन् भारतमेव वर्षं कालेन यावत् गतवान् प्रभासम् । तावच्छशास क्षितिमेकचक्रामेकातपत्रामजितेन पार्थः ॥"<br><b>उल्लेखाः - </b>भाग० ३-१-२०<br><br>

एकचक्रा
एकचक्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಏಕಚಕ್ರ ನಗರ /ಪಾಂಡವರು ಅರಗಿನಮನೆಯಿಂದ ಪ್ರಾಣ ರಕ್ಷಿಸಿಕೊಂಡು ಹೋಗಿ ಕೆಲವುಕಾಲ ವಾಸಮಾಡುತ್ತಿದ್ದ ಒಂದುನಗರ<br><b>प्रयोगाः - </b>"तत्र ते नियता कालं कञ्चिदूषुर्नरर्षभाः । मात्रा सहैकचक्रायां ब्राह्मणस्य निवेशने ॥"<br><b>उल्लेखाः - </b>भा० आदि० ६१<br><br>

एकचक्षुस्
एकचक्षुस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ /ವಾಯಸ<br><br>एकचक्षुस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕಣ್ಣುಳ್ಳಪ್ರಾಣಿ<br><br>एकचक्षुस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕಣ್ಣುಳ್ಳ ಸೂಜಿ<br><b>व्युत्पत्तिः - </b>एकं चक्षुर्यस्य<br><br>एकचक्षुस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಷಯದಲ್ಲಿ ಜ್ಞಾನವುಳ್ಳ /ಸ್ಥಿರಚಿತ್ತನಾದ<br><br>

एकचत्वारिंश
एकचत्वारिंश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಲವತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>"डट्" (५-२-४८)<br><b>व्युत्पत्तिः - </b>एकचत्वारिंशतः पूरणः<br><br>

एकचत्वारिंशी
एकचत्वारिंशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಲವತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

एकचत्वारिंशत्
एकचत्वारिंशत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಲವತ್ತೊಂದು<br><b>व्युत्पत्तिः - </b>एकेनाधिका चत्वारिंशत्<br><br>एकचत्वारिंशत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಲವತ್ತೊಂದು ಸಂಖ್ಯೆಯುಳ್ಳ<br><br>

एकचर
एकचर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಡಕಮೃಗ /ಖಡ್ಗಮೃಗ<br><b>निष्पत्तिः - </b>चर (गतौ) - "अच्"(३-१-१३४)<br><b>व्युत्पत्तिः - </b>एकः चरति<br><br>एकचर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂಟಿಯಾಗಿಸಂಚರಿಸುವ ಹಾವು ಮೊದಲಾದುದು<br><b>प्रयोगाः - </b>"न भक्शयेदेकचरानज्ञातांश्च मृगद्विजान्"<br><b>उल्लेखाः - </b>मनु० ५-१७<br><br>एकचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂಟಿಯಾಗಿ ಸಂಚರಿಸುವ /ಅಸಹಾಯನಾಗಿ ತಿರುಗಾಡುವ<br><b>प्रयोगाः - </b>"मार्गाश्चिरायैकचरः प्रमादं वसन्नसम्बाधशिवोऽपि देशे"<br><b>उल्लेखाः - </b>किरा० ३-५३<br><br>एकचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂಟಿಯಾದ /ಗುಂಪಿನಿಂದ ತಪ್ಪಿಸಿಕೊಂಡಿರುವ<br><b>प्रयोगाः - </b>"अयमेकचरोऽभिवर्धते मां समरायेव समाजुहूषमाणः"<br><b>उल्लेखाः - </b>किरा० १३-३<br><br>

एकचर्या
एकचर्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂಟಿಯಾಗಿ ಸಂಚರಿಸುವಿಕೆ /ಅಸಹಾಯನಾಗಿ ತಿರುಗಾಡುವಿಕೆ<br><b>व्युत्पत्तिः - </b>एकस्य चर्या<br><br>

एकचारिन्
एकचारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಹಾಯನಾಗಿ ಸಂಚರಿಸುವ /ಒಂಟಿಯಾಗಿ ತಿರುಗುವ<br><b>निष्पत्तिः - </b>चर (गतौ) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>एकः चरति<br><br>

एकचारिणी
एकचारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಹಾಯನಾಗಿ ಸಂಚರಿಸುವವಳು /ಒಂಟಿಯಾಗಿ ತಿರುಗುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

एकचित्त
एकचित्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಷಯದಲ್ಲಿರುವ ಮನಸ್ಸು<br><br>एकचित्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಅಭಿಪ್ರಾಯ /ಸಮಾನ ಅಭಿಪ್ರಾಯ<br><br>एकचित्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಮನಸ್ಸುಳ್ಳ/ಒಮ್ಮಸ್ಸುಳ್ಳ /ಸಮಾನವಾದ ಅಭಿಪ್ರಾಯವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकं समानं चित्तं यस्य । एकस्मिन् चित्तं यस्य वा ।<br><br>

एकचित्तता
एकचित्तता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಷಯದಲ್ಲಿ ಮನಸ್ಸು ಇಟ್ಟಿರುವಿಕೆ<br><br>एकचित्तता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಏಕಾಭಿಪ್ರಾಯದಿಂದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>एकचित्तस्य भावः<br><br>

एकच्छत्र
एकच्छत्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಛತ್ರಿಯುಳ್ಳ ದೇಶ /ಸಾಮ್ರಾಜ್ಯ ಸೂಚಕವಾದ ಒಂದೇ ಛತ್ರಿಯು ಹಿಡಿಯಲ್ಪಡುವ ದೇಶ /ಒಬ್ಬನೇ ಚಕ್ರವರ್ತಿಯಿಂದ ಆಳಲ್ಪಡುವ ದೇಶ<br><b>व्युत्पत्तिः - </b>एकं साम्राज्यसूचकमसाधारणं छत्रं यस्मिन्<br><br>

एकज
एकज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂಟಿಯಾಗಿ ಹುಟ್ಟಿದ /ಅಸಹಾಯನಾಗಿ ಹುಟ್ಟಿದ<br><br>एकज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಬ್ಬನಿಂದಹುಟ್ಟಿದ<br><br>

एकजा
एकजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಹೋದರಿಯರು /ಅಕ್ಕತಂಗಿಯರು<br><br>

एकजन्मन्
एकजन्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸಲ ಜನ್ಮ ಪಡೆದ ಶೂದ್ರ<br><b>विस्तारः - </b>ಶೂದ್ರನಿಗೆ ಗರ್ಭದಲ್ಲಿ ಮಾತ್ರ ಜನ್ಮ. ಬ್ರಾಹ್ಮಣನಿಗೆ ಉಪನಯನದಲ್ಲಿ ಎರಡನೆಯ ಜನ್ಮ. ಆದುದರಿಂದ ಶೂದ್ರನು ಏಕಜನ್ಮಾ ಎಂದೂ ಬ್ರಹ್ಮಣನು ದ್ವಿಜನ್ಮಾ ಎಂದು ಕರೆಸಿಕೊಳ್ಳುವರು.<br><br>एकजन्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ /ದೊರೆ<br><b>व्युत्पत्तिः - </b>एकेभ्यः प्रधानेभ्यः लोकपालांशेभ्यो जन्म यस्य<br><b>विस्तारः - </b>"अष्टानां लोकपालानां वपुर्धारयते नृपः" - मनु० ५-९६<br><br>

एकजाति
एकजाति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿ /ಒಂದು ವಿಧ<br><br>एकजाति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ /ಒಂದು ವಿಧವಾದ /ಒಂದು ತೆರವಾದ<br><br>एकजाति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಜನ್ಮವುಳ್ಳ /ಒಂದುಸಲ ಉತ್ಪತ್ತಿಯುಳ್ಳ ಶೂದ್ರ<br><b>व्युत्पत्तिः - </b>एका जातिः जन्म यस्य<br><b>प्रयोगाः - </b>"चतुर्थ एकजातिस्तु शूद्रो नास्ति तु पञ्चमः"<br><b>उल्लेखाः - </b>मनु० १०-४<br><br>एकजाति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಂಶ ಅಥವಾ ಜಾತಿಗೆ ಸೇರಿದ<br><br>

एकजातीय
एकजातीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಧವಾದ /ಒಂದೇ ತೆರವಾದ /ಒಂದೇ ರೀತಿಯಾದ<br><b>निष्पत्तिः - </b>एक - "जातीयर्" (५-३-६९)<br><b>व्युत्पत्तिः - </b>एकप्रकारः<br><b>प्रयोगाः - </b>"एवमेकजातीयानां महशरीरेभ्यः कृशशरीराः प्रधानतमाः"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

एकजीववाद
एकजीववाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬನೇ ಜೀವನು ಅವಿದ್ಯೆಯಿಂದ ಸಂಸಾರಪಾಶಬದ್ಧನಾಗಿ ಕೊನೆಗೆ ಬ್ರಹ್ಮಜ್ಞಾನದಿಂದ ಮುಕ್ತಿ ಹೊಂದುವನೆಂಬ ಅದ್ವೈತಿಗಳ ವಾದ<br><b>व्युत्पत्तिः - </b>एक एव जीव इति वादः<br><br>

एकतम
एकतम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹುಮಂದಿಗಳಲ್ಲಿ ಒಬ್ಬ /ಅನೇಕ ವಸ್ತುಗಳಲ್ಲಿ ಒಂದು<br><b>निष्पत्तिः - </b>"डतमच्" (५-३-९४)<br><b>व्युत्पत्तिः - </b>एषामेकः<br><br>

एकतर
एकतर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಬ್ಬರಲ್ಲಿ ಒಬ್ಬ /ಎರಡು ವಸ್ತುಗಳಲ್ಲಿ ಒಂದು<br><b>निष्पत्तिः - </b>"डतरच्" (५-३-९४)<br><b>व्युत्पत्तिः - </b>अनयोरेकः<br><br>

एकतस्
एकतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಂದರಿಂದ /ಒಬ್ಬನಿಂದ<br><b>निष्पत्तिः - </b>एक - "तसिः" (वा० ५-४-४४)<br><br>एकतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕಡೆಯಲ್ಲಿ<br><br>एकतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕಡೆಯಿಂದ<br><b>प्रयोगाः - </b>"यात्येकतोऽस्तशिखरं परिरोषधीनामाविष्कृतोऽरुणपुरःसर एकतोऽर्कः"<br><b>उल्लेखाः - </b>शाकु० ४-२<br><br>

एकता
एकता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಏಕತ್ವ /ಒಂದಾಗಿರುವಿಕೆ /ಅಭಿನ್ನವಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>एकस्य भावः<br><b>प्रयोगाः - </b>"एकतामिव गतस्य विवेकः कस्यचिन्न महतोऽप्युपलेभे"<br><b>उल्लेखाः - </b>किरा० ९-१२<br><br>

एकत्व
एकत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಏಕತ್ವ /ಒಂದಾಗಿರುವಿಕೆ /ಅಭಿನ್ನವಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

एकतान
एकतान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಷಯದಲ್ಲಿಟ್ಟಿರುವ ಗಮನ /ಒಂದೇ ವಿಷಯದಲ್ಲಿರುವ ಜ್ಞಾನ<br><br>एकतान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಗೀತದಲ್ಲಿ ಬೇರೊಂದು ಸ್ವರವು ಹೊರಡಲು ಕಾರಣವಾದ ವೇಣುವಾದ್ಯ ಸಾಧ್ಯವಾದ ಪ್ರಧಾನವಾದ ಒಂದು ಅಂಶಸ್ವರ<br><b>व्युत्पत्तिः - </b>एकस्तानो विस्तारो गीतिभेदो यस्य<br><br>एकतान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಷಯದಲ್ಲಿ ನೆಟ್ಟಮನಸ್ಸುಳ್ಳ /ಒಂದೇ ಕಡೆ ಗಮನವಿಟ್ಟಿರುವ /ಒಂದೇ ವಿಷಯದಲ್ಲಿ ಜ್ಞಾನವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकस्मिन् विषये तानो वृद्धिर्विस्तारो यस्य<br><b>प्रयोगाः - </b>"ब्रह्मैकतानमनसो हि वसिष्ठमिश्रास्त्वं ब्रूहि वीरचरितेषु गुरुः पुराणः"<br><b>उल्लेखाः - </b>म० वी० ३-११<br><br>

एकताल
एकताल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾನಕಾಲಕ್ರಿಯಮಾನವುಳ್ಳ ತಾಳ /ಲಯವು ಚೆನ್ನಾಗಿ ಕೂಡುವ ತಾಳ<br><b>व्युत्पत्तिः - </b>एकः समानः तालः कालक्रियमानं यस्य<br><br>एकताल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ತಾಳವೃಕ್ಷ /ಒಮ್ದು ತಾಟೀಮರ<br><br>एकताल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ತಾಳವೃಕ್ಷವುಳ್ಳ /ಒಂದು ತಾಟೀಮರವುಳ್ಳ<br><b>प्रयोगाः - </b>"एकताम इवोत्पातपवनप्रेरितो गिरिः"<br><b>उल्लेखाः - </b>रघु० १५-२३<br><br>

एकत्र
एकत्र<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಂದುಕಡೆಯಲ್ಲಿ /ಒಂದು ಸ್ಥಳದಲ್ಲಿ<br><b>प्रयोगाः - </b>"एकत्र स्पटिकतटांशुभिन्ननीरा नीलाश्मद्युतिभिदुराऽम्भसोऽपरत्र"<br><b>उल्लेखाः - </b>माघ० ४-२६<br><br>

एकत्रिंश
एकत्रिंश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂವತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>"डट्" (५-२-४८)<br><b>व्युत्पत्तिः - </b>एकत्रिंशतः पूरणः<br><br>

एकत्रिंशी
एकत्रिंशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂವತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

एकत्रिंशत्
एकत्रिंशत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂವತ್ತೊಂದು<br><b>व्युत्पत्तिः - </b>एकाधिका त्रिंशत्<br><br>एकत्रिंशत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂವತ್ತೊಂದು ಸಂಖ್ಯೆಯುಳ್ಳ<br><br>

एकदंष्ट्र
एकदंष्ट्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿನಾಯಕ /ಗಣಪತಿ<br><b>व्युत्पत्तिः - </b>एका दंष्ट्रा यस्य<br><br>

एकदण्डिन्
एकदण्डिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಖಾಯಜ್ಞೋಪವೀತಗಳನ್ನು ತ್ಯಜಿಸಿ ಒಂದು ದಂಡವನ್ನು ಮಾತ್ರಧರಿಸಿರುವ ಸಂನ್ಯಾಸಿ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११६)<br><b>व्युत्पत्तिः - </b>एकः केवलः शिखायज्ञोपवीतशून्यः दण्डोऽस्यास्ति<br><b>प्रयोगाः - </b>"यदा हृदाध्यवसितं परं ब्रह्म सनातनम् । तदैकदण्डं सङ्गृह्य सोपवीतां शिखां त्यजेत् ॥"<br><br>

एकदन्त
एकदन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿನಾಯಕ /ಗಣಪತಿ<br><b>व्युत्पत्तिः - </b>एको दन्तो यस्य<br><b>प्रयोगाः - </b>"अनेकदं तं भक्तानामेकदन्तमुपास्महे"<br><br>

एकदा
एकदा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಂದು ಸಲ /ಒಂದು ಕಾಲದಲ್ಲಿ /ಒಂದು ಸಮಯದಲ್ಲಿ<br><b>निष्पत्तिः - </b>एक - "दा" (५-३-१५)<br><b>व्युत्पत्तिः - </b>एकस्मिन् काले<br><b>प्रयोगाः - </b>"स चैकदा पिपासाकुलितः पानीयं पातुं यमुनाकच्छमगच्छत्"<br><b>उल्लेखाः - </b>हितो० २<br><br>एकदा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಕಾಲದಲ್ಲಿ /ಅದೇ ಸಮಯದಲ್ಲಿ /ಸಮಕಾಲದಲ್ಲಿ<br><b>प्रयोगाः - </b>"एकदा न विगृह्णीयाद्बहून् राजा विरोधिनः"<br><b>उल्लेखाः - </b>हितो० ४-९३<br><br>एकदा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೂಡಲೇ /ತತ್ಕ್ಷಣದಲ್ಲಿ<br><br>

एकदिश्
एकदिश्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ದಿಕ್ಕುಳ್ಳ /ಸಮಾನವಾದ ದಿಕ್ಕಿನಲ್ಲಿರುವ<br><b>व्युत्पत्तिः - </b>एका दिक् अधिकरणात्मिका यस्य<br><b>प्रयोगाः - </b>"तेनैकदिक्"<br><b>उल्लेखाः - </b>पा० सू० ४-३-११२<br><br>

एकदुःख
एकदुःख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಧ ದುಃಖವುಳ್ಳ /ಸಮಾನವಾದ ದುಃಖವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकं समानं दुखं यस्य<br><br>

एकदृश्
एकदृश्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯಸ /ಕಾಗೆ<br><b>निष्पत्तिः - </b>अभि० चि ४-२८८<br><b>व्युत्पत्तिः - </b>एका दृक् यस्य<br><br>एकदृश्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ /ಈಶ್ವರ<br><b>निष्पत्तिः - </b>दृशिर् (प्रेक्षणे) - "क्विन्" (३-२-६१) । अभि० चि० २-११०<br><b>व्युत्पत्तिः - </b>एकं सर्वमभिन्नं पश्यति<br><br>एकदृश्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕಣ್ಣುಳ್ಳವನು /ಕುರುಡ<br><b>निष्पत्तिः - </b>अभि० चि० ३-११७<br><br>

एकदृष्टि
एकदृष्टि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯಸ /ಕಾಗೆ<br><b>व्युत्पत्तिः - </b>एका दृष्टिर्यस्य<br><br>एकदृष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಷಯದಲ್ಲಿಟ್ಟಿರುವ ಗಮನ /ಒಂದೇ ವಿಷಯದಲ್ಲಿರುವ ಜ್ಞಾನ<br><b>व्युत्पत्तिः - </b>एकस्मिन् दृष्टिः<br><br>एकदृष्टि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಷಯದಲ್ಲಿ ಜ್ಞಾನವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकस्मिन् दृष्टिर्यस्य<br><br>

एकदेवत|एकदैवत
एकदेवत (एकदैवत)<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ದೇವತೆಯುಳ್ಳ ಅಗ್ನಿಹೋತ್ರ ಮುಂತಾದುದು /ಏಕದೇವತಾಕವಾದ ಹೋಮ<br><b>व्युत्पत्तिः - </b>एका देवता एकं दैवतं वा अस्य<br><br>

एकदेवत्य
एकदेवत्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ದೇವತೆಗಾಗಿರುವುದು<br><b>निष्पत्तिः - </b>"यत्"(५-४२४)<br><b>व्युत्पत्तिः - </b>एकदेवतायै इदम्<br><br>

एकदेश
एकदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವಯವ /ಅಂಗ /ಒಂದು ಭಾಗ<br><b>व्युत्पत्तिः - </b>एको देशः<br><b>प्रयोगाः - </b>"एकदेशमुपाध्यायः ऋत्विग्यज्ञकृदुच्यते"<br><b>उल्लेखाः - </b>याज्ञ० १-३५<br><br>एकदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸ್ಥಳ /ಒಂದು ಜಾಗ<br><br>एकदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೂರ್ವಪಕ್ಷ /ಕೆಲವಂಶಗಳನ್ನು ಮಾತ್ರ ತಿಳಿದು ಶಂಕಿಸುವ ಪಕ್ಷ<br><br>एकदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಪಕ್ಕ /ಒಂದು ಪಾರ್ಶ್ವ<br><b>प्रयोगाः - </b>"तान्येकदेशान्निभृतं पयोधेः सोऽम्भांसि मेघान् पिबतो ददर्श"<br><b>उल्लेखाः - </b>माघ० ३-७४<br><br>एकदेश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಜಾಗವುಳ್ಳ /ಸಮಾನವಾದ ಜಾಗವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकः समानो देसो यस्य<br><br>

एकदेशविकार
एकदेशविकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಭಾಗದ ಬದಲಾವಣೆ /ಒಂದು ಕಡೆ ವಿಕಾರ ಹೊಂದುವಿಕೆ<br><b>व्युत्पत्तिः - </b>एकदेशस्य विकारः<br><br>एकदेशविकार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಭಾಗದಲ್ಲಿ ಬದಲಾವಣೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकदेशे विकारो यस्य<br><br>

एकदेशविकृत
एकदेशविकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಭಾಗದಲ್ಲಿ ಬದಲವಣೆ ಹೊಂದಿರುವ<br><b>व्युत्पत्तिः - </b>एकदेशे विकृतम्<br><b>प्रयोगाः - </b>"एकदेशविकृतमनन्यवत्"<br><b>उल्लेखाः - </b>परि० ३७<br><br>

एकदेशविभावित
एकदेशविभावित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಭಾಗ ಮಾತ್ರ ಒಪ್ಪಿಸಲ್ಪಟ್ಟ ವ್ಯವಹಾರ /ಪ್ರತಿವಾದಿಯು ಏನೂ ಕೊಡಬೇಕಾಗಿಲ್ಲವೆನ್ನುವಾಗ ವಾದಿಯು ಕೆಲವು ಪ್ರಮಾಣಗಳಿಂದ ಕೆಲವು ಭಾಗಗಳನ್ನು ಮಾತ್ರ ಪ್ರತಿವಾದಿಯಿಂದ ಒಪ್ಪಿಸಲ್ಪಟ್ಟ ವ್ಯವಹಾರ<br><b>व्युत्पत्तिः - </b>एकदेशे विभावितः प्रमाणादिना अङ्गीकारितः<br><b>प्रयोगाः - </b>"निह्नुते लिखितं नैकमेकदेशे विभावितः । दायः सर्वं नृपेणाथ न ग्राह्यस्त्वनिवारितः ॥"<br><b>उल्लेखाः - </b>याज्ञ० २-२०<br><br>

एकदेशिन्
एकदेशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏಕದೇಶವುಳ್ಳ /ಒಂದುಪ್ರದೇಶವುಳ್ಳ<br><br>एकदेशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಭಾಗದಿಂದಕೂಡಿರುವ /ಒಂದು ಅವಯವದಿಂದ ಕೂಡಿರುವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११६)<br><b>व्युत्पत्तिः - </b>एकदेशोऽस्यास्ति<br><b>प्रयोगाः - </b>"पूर्वापराधरोत्तरमेकदेशनैकाधिकरणे"<br><b>उल्लेखाः - </b>पा० सू०२-२-१<br><br>एकदेशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂರ್ವಪಕ್ಷಿ<br><br>

एकदेह
एकदेह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಶರೀರ<br><b>व्युत्पत्तिः - </b>एको देहः<br><br>एकदेह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬುಧಗ್ರಹ<br><b>व्युत्पत्तिः - </b>एकः श्रेष्ठः देहः यस्य<br><b>विस्तारः - </b>"बुधो हेमा राजपुत्रः एकदेहः प्रहर्षणः" - त्रिकाण्ड० ।<br><br>एकदेह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶ /ಕುಲ /ಗೋತ್ರ<br><b>व्युत्पत्तिः - </b>एकस्माद्देहो यत्र<br><br>एकदेह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪತಿಪತ್ನಿಯರು /ಗಂಡಹೆಂಡಿರು<br><b>विस्तारः - </b>द्विवचने रूपम् । ವಿವಾಹವಾದ ನಂತರ ಪತಿಪತ್ನಿಯರು ಏಕದೇಹವಾಗುವುದರಿಂದ ಪತ್ನಿಯು ಅರ್ಧಾಂಗಿಯಾಗುವಳು.<br><br>एकदेह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾನವಾದ ಶರೀರವುಳ್ಳ /ಒಂದೇ ಶರೀರವುಳ್ಳ /ಒಬ್ಬನ ವಂಶದಲ್ಲೇ ಹುಟ್ಟಿದ<br><b>व्युत्पत्तिः - </b>एकस्माद्देहो यस्य<br><br>

एकधर्मन्
एकधर्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾನ ಧರ್ಮವುಳ್ಳ<br><b>निष्पत्तिः - </b>"अनिच्" (५-४-१२४)<br><b>व्युत्पत्तिः - </b>एकः समानः धर्मो यस्य<br><br>

एकधर्मा
एकधर्मा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾನ ಧರ್ಮವುಳ್ಳ<br><b>निष्पत्तिः - </b>स्त्रियां "डाप्" (४-१-१३)<br><br>

एकधा
एकधा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಂದು ರೀತಿಯಲ್ಲಿ /ಒಂದು ಪ್ರಕಾರವಾಗಿ<br><b>निष्पत्तिः - </b>एक - "धा" (५-३-४४)<br><b>प्रयोगाः - </b>"अधुनीत खगः स नैकधा तनुमुत्फुल्लतनूरुहीकृताम्"<br><b>उल्लेखाः - </b>नैष० २-२<br><br>

एकधारा
एकधारा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ಅವಿಚ್ಛಿನ್ನವಾಗಿ ಸುರಿಯುವಿಕೆ /ಎಡೆಬಿಡದೆ ಬೀಳುತ್ತಿರುವಿಕೆ /ಒಂದೇ ರೀತಿ ಪ್ರವೈಸುವಿಕೆ<br><br>

एकधुर
एकधुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಬಂಡಿ ಭಾರ ಹೊರುವ /ಒಂದು ಗಾಡಿ ಹೊರೆಯಷ್ಟು ಹೊರುವ<br><b>निष्पत्तिः - </b>"खः" लुक् च (४-४-७९)<br><b>व्युत्पत्तिः - </b>एकधुरां वहति<br><br>

एकधुरीण
एकधुरीण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಬಂಡಿ ಭಾರ ಹೊರುವ /ಒಂದು ಗಾಡಿ ಹೊರೆಯಷ್ಟು ಹೊರುವ<br><b>निष्पत्तिः - </b>लुगभावे<br><br>

एकधुरा
एकधुरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಭಾರ /ಒಂದು ಹೊರೆ<br><b>निष्पत्तिः - </b>"ञः" (५-४-७४)<br><b>व्युत्पत्तिः - </b>एका धूः<br><br>

एकधुरावह
एकधुरावह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಬಂಡಿ ಹೊರೆ ಹೊರುವ ಎತ್ತುಮೊದಲಾದುದು<br><b>व्युत्पत्तिः - </b>एकधुराया वहः<br><br>एकधुरावह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಖ್ಯವಾಗಿ ಭಾರ ಹೊತ್ತಿರುವವನು<br><br>

एकनक्षत्र
एकनक्षत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಚುಕ್ಕಿಯುಳ್ಳ ನಕ್ಷತ್ರ<br><b>व्युत्पत्तिः - </b>एकं नक्षत्रं यत्र<br><br>एकनक्षत्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ನಕ್ಷತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>व्युत्पत्तिः - </b>एकं समानं नक्षत्रं यस्य<br><br>

एकनक्षत्रविवाह
एकनक्षत्रविवाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ನಕ್ಷತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದ ಸ್ತ್ರೀಪುರುಷರ ವಿವಾಹ<br><b>व्युत्पत्तिः - </b>एकनक्षत्रे जातयोः विवाहः<br><br>

एकनट
एकनट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಧಾನ /ನಟ /ನಾಟಕದಲ್ಲಿ ಪ್ರಧಾನಪಾತ್ರ ವಹಿಸುವವನು /ಸೂತ್ರಧಾರ<br><b>व्युत्पत्तिः - </b>एको मुख्यो नटः<br><br>एकनट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಥಕ /ಕಥೆ ಹೇಳುವವನು<br><b>विस्तारः - </b>"कथकैकनटौ समौ" - त्रिकाण्ड० ।<br><br>

एकनयन|एकनेत्र
एकनयन(नेत्र)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯಸ /ಕಾಗೆ<br><b>व्युत्पत्तिः - </b>एकं नयनं नेत्रं वाऽस्य<br><br>एकनयन(नेत्र)<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕಣ್ಣುಳ್ಳವನು /ಕುರುಡ<br><br>

एकनवत
एकनवत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಂಭತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>"डट्" (५-२-४८)<br><b>व्युत्पत्तिः - </b>एकनवतेः पूरणः<br><br>

एकनवती
एकनवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಂಭತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

एकनवति
एकनवति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಂಭತ್ತೊಂದು<br><b>व्युत्पत्तिः - </b>एकाधिका नवतिः<br><br>एकनवति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಂಭತ್ತೊಂದು ಸಂಖ್ಯೆಯುಳ್ಳ<br><br>

एकनवतितम
एकनवतितम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಂಭತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>"तमट्" (५-२-५६)<br><b>व्युत्पत्तिः - </b>एकनवतेः पूरणः<br><br>

एकनिश्चय
एकनिश्चय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ನಿಶ್ಚಯ /ಒಂದೇ ನಿರ್ಧಾರ /ಅಚಲವಾದ ನಿರ್ಣಯ /ಬದಲಾಗದ ನಿರ್ಧಾರ<br><b>व्युत्पत्तिः - </b>एकः निश्चयः<br><br>एकनिश्चय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಏಕಾಭಿಪ್ರಾಯ /ಒಮ್ಮತ<br><br>एकनिश्चय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ನಿರ್ಧಾರವುಳ್ಳ /ದೃಢ ನಿರ್ಣಯವುಳ್ಳ /ಒಂದೇ ನಿಶ್ಚಯವುಳ್ಳ /ದೃಢಚಿತ್ತನಾದ<br><b>व्युत्पत्तिः - </b>एकः स्थिरो निश्चयो यस्य<br><br>एकनिश्चय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಮ್ಮತವುಳ್ಳ /ಏಕಾಭಿಪ್ರಾಯವುಳ್ಳ<br><br>

एकपक्ष
एकपक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದುಪಕ್ಷ /ಒಂದು ಕಕ್ಷಿ<br><b>व्युत्पत्तिः - </b>एकः पक्षः<br><b>प्रयोगाः - </b>"किमात्मनिर्वादकथामुपेक्षे जायामदोषामुत सन्त्यजामि । इत्येकपक्षाश्रयविक्लवत्वादासीत् स दोलाचलचित्तवृत्तिः ॥"<br><b>उल्लेखाः - </b>रघु० १४-३४<br><br>एकपक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಪಕ್ಷದ /ಒಂದು ಕಡೆಯ /ಒಂದು ಪಂಗಡದ<br><br>

एकपञ्चाश
एकपञ्चाश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಐವತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>"डट्" (५-२-४८)<br><b>व्युत्पत्तिः - </b>एकपञ्चाशतः पूरणः<br><br>

एकपञ्चाशी
एकपञ्चाशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಐವತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

एकपञ्चाशत्
एकपञ्चाशत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಐವತ್ತೊಂದು<br><b>व्युत्पत्तिः - </b>एकाधिका पञ्चाशत्<br><br>एकपञ्चाशत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಐವತ್ತೊಂದು ಸಂಖ್ಯೆಯುಳ್ಳ<br><br>

एकपञ्चाशत्तम
एकपञ्चाशत्तम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಐವತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>"तमट्" (५-२-५६)<br><b>व्युत्पत्तिः - </b>एकप्ञ्चाशतः पूरणः<br><br>

एकपञ्चाशत्तमी
एकपञ्चाशत्तमी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಐವತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

एकपतिक
एकपतिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಯಜಮಾನನುಳ್ಳವನು<br><b>निष्पत्तिः - </b>यज्ञसम्बन्धाभावात् नादेशो न ।<br><b>व्युत्पत्तिः - </b>एकः पति स्वामी यस्य<br><br>

एकपत्नी
एकपत्नी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬನೇ ಗಂಡನುಳ್ಳ ಹೆಂಗಸು /ಸಮಾನಪತಿಯುಳ್ಳ ಹೆಂಗಸು /ಸಪತ್ನಿ /ಸವತಿ<br><b>निष्पत्तिः - </b>"नः" (४-१-३४)<br><b>व्युत्पत्तिः - </b>एकः समानः पतिः यस्याः<br><b>प्रयोगाः - </b>"सर्वासामेकपत्नीनामेका चेत्पुत्रिणी भवेत् । सर्वास्तास्तेन पुत्रेण प्राह पुत्रवतीर्मनुः ॥"<br><b>उल्लेखाः - </b>मनु० ९-१८३<br><br>एकपत्नी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪತಿವ್ರತೆ /ಪತಿಗೆ ಅನುಕೂಲಳಾದ ಪತ್ನಿ /ಪತಿಯ ಸೇವೆಯಲ್ಲಿ ನಿತರಳಾದ ಪತ್ನಿ<br><b>व्युत्पत्तिः - </b>एकः पतिर्यस्याः<br><b>प्रयोगाः - </b>"तां चावश्यं दिवसगणनातत्परामेकपत्नीमव्यापन्नामविहतगतिर्द्रक्ष्यसि"<br><b>उल्लेखाः - </b>मेघ० १-१०<br><br>एकपत्नी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಏಕಮಾತ್ರ ಪತ್ನಿ /ಸವತಿಯರಿಲ್ಲದ ಹೆಂಡತಿ<br><b>व्युत्पत्तिः - </b>एका पत्नी<br><b>प्रयोगाः - </b>"यो धर्म एकपत्नीनां काङ्क्षन्ती तमनुत्तमम् "<br><b>उल्लेखाः - </b>मनु० ५-१५८<br><br>

एकपत्नीव्रत
एकपत्नीव्रत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾತಿವ್ರತ್ಯ /ಪತಿವ್ರತೆಯ ನಿಯಮ<br><b>व्युत्पत्तिः - </b>एकः पतिः यस्याः सा एकपत्नी, तस्याः व्रतम्<br><b>प्रयोगाः - </b>"कामेकपत्नीव्रतदुःखशीलां लोकं मनश्चारुतया प्रविष्टाम्"<br><b>उल्लेखाः - </b>कुमा० ३-७<br><br>

एकपद
एकपद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುರತ ಕಾಲದ ಒಂದು ಬಂಧ<br><b>विस्तारः - </b>"पादमेकं हृदि स्थाप्य द्वितीयं स्कन्धसंश्रितम् । स्तनौ धृत्वा रमेत्कामी बन्धस्त्वेकपदः स्मृतः ॥"<br><br>एकपद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಕಾಲುಳ್ಳ ಮನುಷ್ಯ<br><br>एकपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತತ್ಕಾಲ /ಒಂದುಪದವನ್ನು ಉಚ್ಚರಿಸುವಷ್ಟು ಕಾಲ<br><b>व्युत्पत्तिः - </b>एकं पदं पदोच्चारणयोग्यकालो यत्र<br><br>एकपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದುಸ್ಥಾನ /ಒಂದು ಜಾಗ<br><br>एकपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಹೆಜ್ಜೆಯಿಡುವಿಕೆ<br><br>एकपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಬಂತ ಮತ್ತು ತಿಗಂತ ರೂಪವಾದ ಪದ<br><b>व्युत्पत्तिः - </b>एकं पदं स्थानं सुप्तिङन्तरूपं वा<br><b>प्रयोगाः - </b>"तदीशितारं चेदानीं भवांस्तमवमंस्त मा । निहन्त्यरीनेकपदे य उदात्तः स्वरानिव ॥"<br><b>उल्लेखाः - </b>माघ० २-९५<br><br>एकपद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಬಂತ ಅಥವಾ ತಿಗಂತರೂಪವಾದ ಒಂದು ಪದವುಳ್ಳ<br><br>एकपद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಪದದಿಂದ ಹೇಳಲ್ಪಡುವ<br><b>प्रयोगाः - </b>"किंस्विदेकपदं धर्म्यं किंस्विदेकपदं यज्ञः । किंस्विदेकपदं स्वर्ग्यं किंस्विदेकपदं सुखम् ॥" "दाक्षमेकपदं धर्म्यं दानमेकपदं यशः । सत्यमेकपदं स्वर्ग्यं शीलमेकपदं सुखम् ॥"<br><b>उल्लेखाः - </b>भा० वन० ३१४-७१,७२<br><br>एकपद<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆ ಕೂಡಲೇ /ತತ್ ಕ್ಷಣದಲ್ಲಿ<br><b>प्रयोगाः - </b>"अयमेकपदे तया वियोगः प्रिययाचोपनतः सुदुःसहो मे"<br><b>उल्लेखाः - </b>विक्र० ४-१०<br><br>

एकपदा
एकपदा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಪಾದವುಳ್ಳ ಶ್ಲೋಕ<br><br>एकपदा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವೃತ್ತದ ನಾಲ್ಕನೆಯ ಒಂದು ಭಾಗದಿಂದ ಕೂಡಿದ ಋಕ್ಕು<br><b>प्रयोगाः - </b>"गायत्र्यस्यैकपदी द्विपदी त्रिपदी"<br><b>उल्लेखाः - </b>श्रुतिः<br><br>एकपदा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಕಾಲುಳ್ಳ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>पादस्य लोपः "ङीप्" पद्भावश्च निपा० (५-४-१३९)<br><b>व्युत्पत्तिः - </b>एकः पादो यस्याः<br><br>एकपदा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣಮಾರ್ಗ /ಕಾಲುದಾರಿ /ಕಿರುದಾರಿ<br><b>प्रयोगाः - </b>"अवायते वा किमियद्भवत्या चित्तैकपद्यामपि विद्यते यः"<br><b>उल्लेखाः - </b>नैष० ३-६३<br><b>विस्तारः - </b>"एकपदी तु वर्त्मनि" - हेम०<br><br>

एकपदि
एकपदि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕಾಲಿನಿಂದ ಒದೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>समासान्तः "इच्" (५-४-१२८)<br><b>व्युत्पत्तिः - </b>एकः पादः साधनं यस्मिन् प्रहरणे<br><br>

एकपरि
एकपरि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪಗಡೆಯಾಟದಲ್ಲಿ ಒಂದು ಗರ ವ್ಯತ್ಯಾಸವಾಗಿ ಬೀಳುವುದರಿಂದ ಉಂಟಾಗುವ ಪರಾಜಯ<br><b>निष्पत्तिः - </b>अव्ययी० (२-१-१)<br><b>व्युत्पत्तिः - </b>एकेन विपरीतं वृत्तम्<br><b>विस्तारः - </b>ಯಾವುದೊಂದು ಗರ ಬಿದ್ದರೆ ಜಯವೋ ಅದಕ್ಕೆ ಬದಲಾಗಿ ಬೇರೆ ಗರ ಬೀಳುವುದರಿಂದ ಉಂಟಾಗುವ ಸೋಲು. ಜೂಜಾಟದಲ್ಲಿ ಮಾತ್ರ ಇದರ ಪ್ರಯೋಗ.<br><br>

एकपर्णा
एकपर्णा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಮವಂತನಿಗೆ ಮೇನಕೆಯಲ್ಲಿ ಹುಟ್ಟಿದ ಮೂವರು ಕನ್ಯೆಯರಲ್ಲಿ ಒಬ್ಬಳು<br><b>व्युत्पत्तिः - </b>एकं पर्णं तपःसाधनतया आहारो यस्याः<br><b>प्रयोगाः - </b>"तिस्रः कन्यासु मेनायां जनयामास शैलराट् । अपर्णामेकार्णां च तृतीयामेकपाटलाम् ॥"<br><b>विस्तारः - </b>"आहारमेकपर्णेन एकपर्णा समाचरत्" - हरिवं० ।<br><br>एकपर्णा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೆಲಗನ ಗಿಡ<br><br>

एकपाटला
एकपाटला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಮವಂತನಿಗೆ ಮೇನಕೆಯಲ್ಲಿ ಹುಟ್ಟಿದ ಮೂವರು ಕನ್ಯೆಯರಲ್ಲಿ ಒಬ್ಬಳು<br><b>व्युत्पत्तिः - </b>एकं पाटलं पुष्पं तपः साधनतया आहारो यस्याः<br><br>

एकपात
एकपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಕಸ್ಮಾತ್ತಾಗಿ ಸಂಬವಿಸುವಿಕೆ /ಅನಿರೀಕ್ಷಿತವಾಗಿ ಒದಗುವಿಕೆ<br><br>

एकपातिन्
एकपातिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಕಸ್ಮಾತ್ತಾಗಿ ಒದಗುವ /ಅನಿರೀಕ್ಷಿತವಾಗಿ ಸಂಬವಿಸುವ<br><b>निष्पत्तिः - </b>पत्लृ (गतौ) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>एकः सन् पतति<br><br>

एकपाद्
एकपाद्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>पादस्यान्त्यलोपः समासान्तः (५-४-१४०)<br><b>व्युत्पत्तिः - </b>एकः पादः एतद्विभूतिलक्षणः तुर्योंशोऽस्य<br><b>प्रयोगाः - </b>"चतुरात्मा चतुर्भावश्चतुर्वेदविदेकपात्" । "विष्टभ्याहमिदं कृत्स्नमेकांसेन स्थितो जगत्" ।<br><b>उल्लेखाः - </b>वि० स०, गीता० १०-४२<br><b>विस्तारः - </b>"एकांशेनावतीर्णत्वादेकपादिति कथ्यते" -निरुक्तिः ।<br><br>एकपाद्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಮಹಾದೇವ<br><br>एकपाद्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ದಾನವ<br><br>एकपाद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕಾಲುಳ್ಳ<br><br>

एकपदी
एकपदी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>एकपाद् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (५-४-१३९) पद्भावश्च ।<br><br>

एकपाद
एकपाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಕಾಲು<br><b>व्युत्पत्तिः - </b>एकः पादः<br><br>एकपाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>एकः पादोऽस्य<br><b>प्रयोगाः - </b>"पादोऽस्य विश्वा भूतानि"<br><b>उल्लेखाः - </b>श्रुतिः<br><br>एकपाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಅಸುರ<br><br>एकपाद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಪಾದವುಳ್ಳ /ಒಂದು ಕಾಲುಳ್ಳ<br><br>एकपाद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕಾಲನ್ನು ಅವಲಂಬಿಸಿ ನಿಂತಿರುವ /ಒಂದು ಕಾಲಿನ ಮೇಲೆ ನಿಂತಿರುವ<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>एकपादो अवलम्बनत्वेनास्त्यस्य<br><b>प्रयोगाः - </b>"पर्वतारोहणं कृत्वा एकपादो विभावसुम् । निरीक्षेत निराहारः उर्ध्वबाहुः कृताञ्जलिः ॥"<br><b>उल्लेखाः - </b>भा०<br><br>

एकपादिका
एकपादिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಕ್ಕಿಗಳು ಒಂದು ಕಾಲಿನ ಮೇಲೆ ನಿಂತುಕೊಳ್ಳುವಿಕೆ<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५)<br><b>व्युत्पत्तिः - </b>एकः पादो अवलम्बनत्वेनास्त्यस्याः<br><b>प्रयोगाः - </b>"अथावलम्ब्य क्षणमेकपदिकां तदा निदद्रावुपपल्वलं खगः"<br><b>उल्लेखाः - </b>नैष० १-१२१<br><br>

एकपार्थिव
एकपार्थिव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇವಲರಾಜ / ದೊರೆಯು ಮಾತ್ರ<br><b>व्युत्पत्तिः - </b>एकः केवलः पार्थिवो राजा<br><b>प्रयोगाः - </b>"न केवलं तद्गुरुरेकपार्थिवः क्षितावभूदेकधनुर्धरोऽपि सः"<br><b>उल्लेखाः - </b>रघु० ३-३१<br><br>एकपार्थिव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬನೇರಾಜ /ಚಕ್ರವರ್ತಿ<br><br>एकपार्थिव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಜನುಳ್ಳ ದೇಶ<br><br>

एकपिङ्ग
एकपिङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರ /ಧನಾಧಿಪತಿ<br><b>व्युत्पत्तिः - </b>एकं पिङ्गं पिङ्गलं नेत्रमस्य<br><br>

एकपिण्ड
एकपिण्ड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜ್ಞಾತಿ /ದಾಯಾದ /ಸಪಿಂಡ<br><b>व्युत्पत्तिः - </b>एकः समानः पिण्डो देहो यस्य<br><br>

एकपुरुष
एकपुरुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠಪುರುಷ /ಪುರುಷೋತ್ತಮ /ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>एकः श्रेष्ठः पुरुषः<br><b>प्रयोगाः - </b>"यस्मात्क्षरमतीतोऽहमक्षरादपि चोत्तमः । अतोऽस्मि लोके वेदे च प्रथितः पुरुषोत्तमः ॥"<br><b>उल्लेखाः - </b>गीता० १५-१८<br><br>एकपुरुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಖ್ಯಪುರುಷ /ಪ್ರಧಾನನಾದವನು<br><br>एकपुरुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಮನುಷ್ಯ<br><br>

एकपुत्र
एकपुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಏಕಮಾತ್ರ ಪುತ್ರ /ಒಬ್ಬನೇ ಮಗ<br><b>व्युत्पत्तिः - </b>एकः पुत्रः<br><br>एकपुत्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಮಾತ್ರ ಮಗನುಳ್ಳ /ಏಕಮಾತ್ರ ಪುತ್ರನುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकः केवलः पुत्रो यस्य<br><b>प्रयोगाः - </b>"न त्वेवैकं पुत्रं दद्यात् प्रतिगृह्णीयाद्वा"<br><b>उल्लेखाः - </b>वसिष्ठः<br><br>

एकपुष्कर|एकपुष्कल
एकपुष्कर(ल)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಾದ್ಯ /ಕಹಳೆ<br><br>

एकप्रकार
एकप्रकार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ರೀತಿಯ /ಒಂದೇ ವಿಧದ<br><br>एकप्रकार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅದೇ ರೀತಿಯ /ಅದೇ ವಿಧದ<br><br>

एकप्रख्य
एकप्रख्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸದೃಶವಾದ /ಸಮಾನವಾದ<br><br>

एकप्रभु
एकप्रभु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ದೊರೆ /ಒಬ್ಬ ರಾಜ<br><b>व्युत्पत्तिः - </b>एकः प्रभुः<br><br>एकप्रभु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಬ್ಬನೇ ರಾಜನುಳ್ಳ /ಒಬ್ಬನೇ ಅಧಿಪತಿಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकः प्रभुः यत्र<br><br>

एकप्रभुत्व
एकप्रभुत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬನ ಆಳ್ವಿಕೆ /ಒಬ್ಬನ ಆಧಿಪತ್ಯ<br><br>एकप्रभुत्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಜನ ಆಳ್ವಿಕೆಯುಳ್ಳ /ಏಕಾಧಿಪತ್ಯವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकस्यैव प्रभुत्वं यत्र<br><br>

एकप्रस्थ
एकप्रस्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ತಪ್ಪಲುಳ್ಳ ಪರ್ವತ<br><b>व्युत्पत्तिः - </b>एकः प्रस्थः सानुर्यस्य<br><br>एकप्रस्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸೇರು ಧಾನ್ಯದ ಅಳತೆ<br><b>व्युत्पत्तिः - </b>एकः प्रस्थः<br><br>एकप्रस्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸೇರು ಅಳತೆಯ ಧಾನ್ಯ<br><br>

एकबुद्धि
एकबुद्धि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಮನಸ್ಸುಳ್ಳ /ಒಂದೇ ಅಭಿಪ್ರಾಯವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एका समाना बुद्धिर्यस्य<br><br>

एकभक्त
एकभक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದುದಿನದಲ್ಲಿ ಒಂದು ವೇಳೆ ಮಾತ್ರ ಊಟಮಾಡುವವನು<br><b>व्युत्पत्तिः - </b>एकम् एकवारं भक्तं भोजनं यस्य<br><br>एकभक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಬ್ಬನಿಗೇ ವಿಧೇಯನಾಗಿರುವ /ಒಬ್ಬನಿಗೇ ಭಕ್ತನಾಗಿರುವ<br><br>एकभक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಬ್ಬನನ್ನೇ ಆಶ್ರಯಿಸಿರುವ/ಬೇರಾರಲ್ಲಿಯೂ ಆಸಕ್ತಿಯಿಲ್ಲದಿರುವ<br><b>प्रयोगाः - </b>"प्रैष्यासु चैकभक्तासु रहःप्रव्रजितासु च"<br><b>उल्लेखाः - </b>मनु० ८-३६३<br><br>

एकभक्ति
एकभक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿರಂತರವಾದ ಭಕ್ತಿ /ನಿರತಿಶಯವಾದ ಭಕ್ತಿ<br><b>व्युत्पत्तिः - </b>एकस्मिन् भकिः<br><br>एकभक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನನ್ಯವಾದ ಭಕ್ತಿ /ಒಬ್ಬನಲ್ಲಿಯೇ ಇಟ್ಟಿರುವ ಭಕ್ತಿ<br><b>व्युत्पत्तिः - </b>एकस्मिन् भक्तिर्यस्य<br><br>एकभक्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಬ್ಬನಲ್ಲಿಯೇ ಭಕ್ತಿಯುಳ್ಳ<br><b>प्रयोगाः - </b>"तेषां ज्ञानी नित्ययुक्तं एकभक्तिर्विशिष्यते"<br><b>उल्लेखाः - </b>गीता० ७-१७<br><br>

एकभार्या
एकभार्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬನ ಪತ್ನಿ /ಸಾಧ್ವಿ /ಪತಿವ್ರತೆ<br><b>व्युत्पत्तिः - </b>एकस्यैव भार्या<br><b>प्रयोगाः - </b>"तामेकभार्यां परिवादभीरोः साध्वीमपि त्यक्तवतो नृपस्य"<br><b>उल्लेखाः - </b>रघु० १५-८६<br><br>

एकभाव
एकभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದಾಗಿರುವಿಕೆ /ಅಭೇದ<br><b>व्युत्पत्तिः - </b>एकस्य भावः<br><b>प्रयोगाः - </b>"स्वतेजसा सत्त्वगुणप्रवाहमात्मैकभावेन भजध्वमद्धा"<br><b>उल्लेखाः - </b>भाग० ४-३१-१८<br><br>एकभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬನಲ್ಲಿಯೇ ಇಟ್ಟಿರುವ ಪ್ರೀತಿ<br><b>व्युत्पत्तिः - </b>एकः अनन्यः भावः रागः<br><br>एकभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಸ್ವಭಾವ /ಬದಲಾವಣೆ ಹೊಂದದ ಸ್ವಭಾವ<br><br>एकभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಅಭಿಪ್ರಾಯ /ಬದಲಾವಣೆ ಹೊಂದದ ಅಭಿಪ್ರಾಯ<br><b>प्रयोगाः - </b>"स्त्रीणां शत्रोः कुमित्रस्य पण्यस्त्रीणां विशेषतः । यो भवेदेकभावेन न स जीवति मानवः ॥"<br><b>उल्लेखाः - </b>पञ्चतं०<br><br>एकभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಅಭಿಪ್ರಾಯ /ಐಕಮತ್ಯ /ಬೇರೆಬೇರೆಯಿಲ್ಲದಾಭಿಪ್ರಾಯ<br><br>एकभाव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಸ್ವಭಾವವುಳ್ಳ<br><br>एकभाव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಅಭಿಪ್ರಾಯವುಳ್ಳ /ಸಮಾನಾಭಿಪ್ರಾಯವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकः समानः भावो यस्य<br><br>

एकभूत
एकभूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದಗಿರುವ /ಅನೇಕವಾಗಿದ್ದು ಈಗ ಒಂದಾಗಿರುವ<br><b>व्युत्पत्तिः - </b>अनेकः एको भुतः<br><br>

एकभूमिक
एकभूमिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಉಪ್ಪರಿಗೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"कप्"<br><b>व्युत्पत्तिः - </b>एका भूमिर्यस्य<br><br>

एकमति
एकमति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇಬುದ್ಧಿ<br><b>व्युत्पत्तिः - </b>एका अमतिः<br><br>एकमति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾನವಾದ ಬುದ್ಧಿ /ಒಂದೇ ವಿಧವಾದಬುದ್ಧಿ<br><b>व्युत्पत्तिः - </b>एका समाना बुद्धिः मतिः<br><br>एकमति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾನ ಬುದ್ಧಿಯುಳ್ಳ /ಒಂದೇ ವಿಧ ಬುದ್ಧಿಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एका समाना मतिर्यस्य<br><br>एकमति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾನಾಭಿಪ್ರಾಯವುಳ್ಳ<br><br>

एकमनस्
एकमनस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಷಯದಲ್ಲಿ ನೆಟ್ಟ ಮನಸ್ಸುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकस्मिन् मनो यस्य<br><br>एकमनस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಮನಸ್ಸುಳ್ಳ/ಒಂದೇ ಅಭಿಪ್ರಾಯವುಳ್ಳ<br><br>एकमनस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾನವಾದ ಬುದ್ಧಿಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकं समानम्मनो यस्य<br><br>एकमनस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಮನಸ್ಸುಳ್ಳ /ಬದಲಾವಣೆ ಹೊಂದದ ಮನಸ್ಸುಳ್ಳ<br><b>प्रयोगाः - </b>"ते निर्यान्तु मया सहैकमनसो येषामभीष्टं यशः"<br><b>उल्लेखाः - </b>मुद्रा० २-१३<br><br>

एकमात्र
एकमात्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಮಾತ್ರಾ ಕಾಲವುಳ್ಳ /ಒಂದು ಹ್ರಸ್ವವರ್ಣವನ್ನು ಉಚ್ಚರಿಸುವಕಾಲವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एका मात्रा उचारणसदृशः कालो यस्य<br><b>विस्तारः - </b>"एकमात्रो भवेत् ह्रस्वः द्विमात्रो दीर्घ उच्यते । त्रिमात्रस्तु प्लुतो ज्ञेयः व्यञ्जनस्त्वर्धमात्रकम् ॥"<br><br>

एकमात्रा
एकमात्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಹ್ರಸ್ವವನ್ನು ಉಚ್ಚರಿಸುವಷ್ಟು ಕಾಲ<br><b>व्युत्पत्तिः - </b>एका मात्रा ह्रस्ववर्णोच्चारणकालः<br><br>

एकमुख
एकमुख<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಮುಖ /ಒಂದು ಬಾಯಿ<br><b>व्युत्पत्तिः - </b>एकं मुखम्<br><br>एकमुख<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಬಾಗಿಲುಳ್ಳ ಮಂಟಪ<br><br>एकमुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಮುಖವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकं मुखं यस्य<br><br>एकमुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕಡೆ ತಿರುಗಿಸಲ್ಪಟ್ಟ ಮುಖವುಳ್ಳ<br><br>एकमुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಅಧ್ಯಕ್ಷನಾಗಿರುವ ದ್ಯೂತ /ಒಬ್ಬ ಮೇಲ್ವಿಚಾರಕನುಳ್ಳ ಜೂಜು<br><b>व्युत्पत्तिः - </b>एकं मुखं प्रधानं यत्र<br><b>प्रयोगाः - </b>"द्यूतमेकमुखं कार्यं तस्करज्ञानकारणात्"<br><b>उल्लेखाः - </b>याज्ञ० २-२०३<br><br>

एकमूला
एकमूला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂರಲೆ ಹೊನ್ನೆ ಗಿಡ<br><br>एकमूला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅತಸೀ ಗಿಡ /ಅಗಸೆ ಗಿಡ<br><br>

एकयष्टिका
एकयष्टिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೆಳೆಯ ಹಾರ /ಏಕಾವಳಿಯೆಂಬ ಸರ<br><b>व्युत्पत्तिः - </b>एका यष्टिरिवावली यस्याः<br><b>विस्तारः - </b>"एकावल्येकयष्टिका" -अम०<br><br>

एकयोनि
एकयोनि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾನವಾದ ಉತ್ಪತ್ತಿಸ್ಥಾನ /ಒಂದೇ ಗರ್ಭಾಶಯ<br><b>व्युत्पत्तिः - </b>एका समाना योनिरुत्पत्तिस्थानम्<br><br>एकयोनि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾನವಾದ ಉತ್ಪತ್ತಿಸ್ಥಾನವುಳ್ಳ /ಒಂದೇ ಗರ್ಭಾಶಯವುಳ್ಳ /ಒಬ್ಬಳೇ ತಾಯಿಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एका समाना योनिरुत्पत्तिस्थानं यस्य<br><br>एकयोनि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾನ ಜಾತಿಯವನಾದ /ಒಂದೇ ಜಾತಿಗೆ ಸೇರಿದ<br><b>व्युत्पत्तिः - </b>एका समाना यनिः कारणं यस्य<br><b>प्रयोगाः - </b>"एतद्विधानं विज्ञेयं विभागस्यैकयोनिषु"<br><b>उल्लेखाः - </b>मनु० ९-१४८<br><br>

एकरस
एकरस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇವಲ ಸಂತೋಷ /ಕೇವಲ ಆನಂದ<br><b>व्युत्पत्तिः - </b>एकं केवलः रसः<br><br>एकरस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಧವಾದ ಪ್ರೀತಿ /ಬದಲಾವಣೆ ಹೊಂದದ ಪ್ರೀತಿ<br><br>एकरस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಅಭಿಪ್ರಾಯವುಳ್ಳ /ಸಮಾನಾಭಿಪ್ರಾಯವುಳ್ಳ<br><br>एकरस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಧವಾದ ಪ್ರೀತಿಯುಳ್ಳ /ಸಮಾನಾನುರಾಗವುಳ್ಳ<br><br>एकरस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಕಡೆ ಪ್ರೀತಿಯುಳ್ಳ /ಅನನ್ಯವಿಷಯವಾದ ಪ್ರೀತಿಯುಳ್ಳ<br><br>एकरस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಧವಾದ ಸ್ವಭಾವವುಳ್ಳ /ಸಮಾನ ಸ್ವಭಾವವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एक समानः रसः अभिप्रायः रागो वा यस्य । एकः अनन्यविषयो रसो रागः यस्य । एकः अभिन्नः रसः स्वभावो यस्य वा<br><br>

एकराज्
एकराज्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾರ್ವಭೌಮ /ಚಕ್ರವರ್ತಿ<br><b>निष्पत्तिः - </b>राजृ (दीप्तौ) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>एको राजते<br><b>प्रयोगाः - </b>"हिरण्यकशिपू राजन् अजेयमजरामरम् । आत्मानमप्रतिद्वन्द्वमेकराजं व्यधित्सत ॥"<br><b>उल्लेखाः - </b>भाग० ७-३-१<br><br>एकराज्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><b>निष्पत्तिः - </b>राजृ (दीप्तौ) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>एक एव राजते<br><b>प्रयोगाः - </b>"यदादित्यगतं तेजो जगद्भासयतेऽखिलम् । यच्चन्द्रमसि यच्चाग्नौ तत्तेजो विद्धि मामकम् ॥" "तमेव भान्तमनुभाति सर्वं तस्य भासा सर्वमिद्ं विभाति"<br><b>उल्लेखाः - </b>गीता० १५-१२, श्रुतिः<br><br>एकराज्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಯಂಪ್ರಕಾಶಿಸುವ /ತಾನಾಗಿಯೇ ಪ್ರಕಾಶಮಾನವಾದ<br><b>प्रयोगाः - </b>"स वा एष तदा द्रष्टा नापस्यद् दृश्यमेकराट्"<br><b>उल्लेखाः - </b>भाग० ३-४-२४<br><br>

एकराज
एकराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಜ /ಒಬ್ಬನೇ ಆದ ದೊರೆ /ಚಕ್ರವರ್ತಿ<br><br>एकराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತಮನಾದ ರಾಜ /ಶ್ರೇಷ್ಠನಾದ ದೊರೆ<br><b>निष्पत्तिः - </b>"टच्"(५-४-९१)<br><b>व्युत्पत्तिः - </b>एको राजा<br><br>

एकरात्र
एकरात्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ರಾತ್ರಿ/ಒಂದುರಾತ್ರಿಯ ಕಾಲ<br><b>निष्पत्तिः - </b>"अच्" (५-४-८७) "सङ्ख्यापूर्वं रात्रं क्लीबम्" (लिङ्गा० १३१) इति नपुंसकत्वम् ।<br><b>व्युत्पत्तिः - </b>एका रात्रिः<br><b>प्रयोगाः - </b>"एकरात्रं तु निवसन्नतिथिर्ब्राह्मणः स्मृतः"<br><b>उल्लेखाः - </b>मनु० ३-१०२<br><br>

एकरात्रिक
एकरात्रिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ರಾತ್ರಿಯಲ್ಲಿ ಮುಗಿಯಬಹುದಾದ /ಒಂದು ದಿನಕ್ಕೆ ಮಾತ್ರ ಬೇಕಾಗುವ<br><b>प्रयोगाः - </b>"नाद्याच्छूद्रस्य पक्वान्नं विद्वान्नश्राद्धिनो द्विजः । आददीताममेवास्मादवृत्तावेकरात्रिकम् ॥"<br><b>उल्लेखाः - </b>मनु० ४-२२३<br><br>

एकरात्रीण
एकरात्रीण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ರಾತ್ರಿಯಲ್ಲಿ ನಡೆದ<br><br>एकरात्रीण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ರಾತ್ರಿಯಲ್ಲಿ ಸತ್ಕರಿಸಿಕೆಲಸ ಮಾಡಿಸಲ್ಪಟ್ಟ<br><br>एकरात्रीण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ರಾತ್ರಿ ಕೂಲಿ ಕೊಟ್ಟು ಕೊಳ್ಳಲ್ಪಟ್ಟ<br><br>एकरात्रीण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ರಾತ್ರಿಯಲ್ಲಿ ಉಂಟಾಗುವ<br><b>निष्पत्तिः - </b>"खः" (५-१-८७)<br><b>व्युत्पत्तिः - </b>एकां रत्रिमधीष्टो भृतो भूतो भावी वा<br><br>

एकराशि
एकराशि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ರಾಶಿ /ಒಂದು ಗುಪ್ಪೆ<br><b>व्युत्पत्तिः - </b>एको राशिः<br><br>एकराशि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ರಾಶಿ /ಮೇಷ ವೃಷಭ ಮೊದಲಾದ ಸಮಾನವಾದ ರಾಶಿ<br><b>व्युत्पत्तिः - </b>एकः समानः राशिः<br><b>प्रयोगाः - </b>"एकराशिगतौ स्यातामेकर्क्षविषये यदा"<br><br>

एकराशिभूत
एकराशिभूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ರಾಶಿಯಾಗಿರುವ /ಒಂದೇ ಗುಪ್ಪೆಯಾಗಿರುವ<br><br>

एकरिक्थिन्
एकरिक्थिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಿತ್ರಾಜಿತವಾದ ಆಸ್ತಿಯಲ್ಲಿ ಸಮಭಾಗವುಳ್ಳ /ಒಂದು ಆಸ್ತಿಯಲ್ಲಿ ಸಮವಾದ ಹಕ್ಕುಳ್ಳ /ತಂದೆಯ ಧನದಲ್ಲಿ ಭಾಗಒಂದಲು ಅರ್ಹನಾದ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११६)<br><b>व्युत्पत्तिः - </b>एकस्य पितुः रिक्थमस्यास्ति<br><b>प्रयोगाः - </b>"यद्येकरिक्थिनौ स्यातामौरसक्षेत्रजौ सुतौ । यस्य यत्पैतृकं रिक्थं सतद् गृह्णीत नेतरः ॥"<br><b>उल्लेखाः - </b>मनु० ९-१६२<br><br>

एकरूप
एकरूप<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಆಕಾರ<br><b>व्युत्पत्तिः - </b>एकं रूपम्<br><br>एकरूप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ರೂಪವುಳ್ಳ /ಸಮಾನ ರೂಪವುಳ್ಳ /ಒಂದೇ ವಿಧವಾದ<br><b>व्युत्पत्तिः - </b>एकं समानं रूपं यस्य<br><br>

एकरूपतस्
एकरूपतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ರೂಪದಿಂದ /ಸಮಾನ ರೂಪದಿಂದ<br><br>एकरूपतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ರೂಪದಲ್ಲಿ /ಸಮಾನ ಆಕೃತಿಯಲ್ಲಿ<br><b>निष्पत्तिः - </b>एकरूप - "तसिः" (वा० ५-४-४४)<br><br>एकरूपतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ರೀತಿಯಲ್ಲಿ/ಬದಲಾವಣೆಯಿಲ್ಲದೆ<br><br>

एकरूपता
एकरूपता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ರೂಪದಲ್ಲಿರುವಿಕೆ /ಏಕರೀತಿಯಲ್ಲಿರುವಿಕೆ /ಸಮಾನ ಆಕಾರದಿಂದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>एकरूपस्य भावः<br><b>प्रयोगाः - </b>"सम्पत्तौ च विपत्तौ च महतमेकरूपता"<br><br>

एकरूप्य
एकरूप्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೇವಲ ಬಳ್ಳಿ /ಬರಿ ಬಳ್ಳಿ<br><b>व्युत्पत्तिः - </b>एकं केवलं रूप्यम्<br><br>एकरूप्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬನಿಂದ ಬಂದ /ಒಂದೇಸಂತತಿಯಲ್ಲಿ ಹುಟ್ಟಿದ /ಒಬ್ಬ ತಾಯಿ ಅಥವಾ ತಂದೆಯಿಂದ ಅನುಗತವಾಗಿ ಬೆಳೆದುಬಂದ<br><b>निष्पत्तिः - </b>"रूप्यः" (४-३-८१)<br><b>व्युत्पत्तिः - </b>एकतः एकस्मात् एकस्या वा आगतः<br><br>

एकल
एकल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಹಾಯಕ /ಏಕಾಕಿ . ಒಬ್ಬಂಟಿಗ<br><b>निष्पत्तिः - </b>ला (आदाने)- "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>एकः सन् लाति<br><b>प्रयोगाः - </b>"तस्मिन् वाव किल स एकलः"<br><b>उल्लेखाः - </b>भाग० ५-७-१२<br><br>

एकलव्य
एकलव्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿರಣ್ಯಧನುಸ್ಸೆಂಬ ಒಬ್ಬ ಬೇಡನ ಮಗ<br><br>

एकलिङ्ग
एकलिङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರ<br><b>व्युत्पत्तिः - </b>एकं लिङ्गमिन्द्रियं चक्षुरस्य<br><br>एकलिङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಯತ ಲಿಂಗವುಳ್ಳ ಶಬ್ದ<br><b>व्युत्पत्तिः - </b>एकं नियतं लिङ्गं पुंस्त्वादि यस्य<br><br>एकलिङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಿದ್ಧಿಗೆಸಾಧನವಾದ ಒಂದು ಕ್ಷೇತ್ರ /೫ ಕ್ರೋಶಗಳವರೆಗೂ ಬೇರೊಂದು ಶಿವಲಿಂಗವಿಲ್ಲದಿರುವ ಒಂದು ಪ್ರದೇಶ<br><b>प्रयोगाः - </b>"पञ्चकोशान्तरे यत्र न लिङ्गान्तरमीक्ष्यते । तदेकलिङ्गमाख्यातं तत्र सिद्धिरनुत्तमा ॥"<br><b>उल्लेखाः - </b>आगमः<br><br>एकलिङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಸಶಿವಲಿಂಗವುಳ್ಳ<br><br>एकलिङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಗುರುತುಳ್ಳ /ಒಂದು ಚಿಹ್ನೆಯುಳ್ಳ<br><br>

एकवचन
एकवचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸಂಖ್ಯೆ ಅಥವಾ ಒಂದು ವಸ್ತುವಿನ ಏಕತ್ವವನ್ನು ಹೇಳುವ ಸ್ವಾದಿ ಮತ್ತು ತಿಂಗಾದಿ ಪ್ರತ್ಯಯ<br><b>निष्पत्तिः - </b>वच (परिभाषणे) - "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>एकमेकत्वमुच्यतेऽनेन<br><b>प्रयोगाः - </b>"त्वमावेकवचने" , "द्व्येकयोर्द्विवचनैकवचने"<br><b>उल्लेखाः - </b>पा० सू० ७-२-९७, पा० सू० १-४-२२<br><br>एकवचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಸ್ತುವನ್ನು ಹೇಳುವ ಶಬ್ದ<br><b>व्युत्पत्तिः - </b>एकं वस्तु उच्यतेऽनेन<br><br>

एकवत्
एकवत्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಂದರಂತೆ<br><b>निष्पत्तिः - </b>एकस्येव - "वतिः" (५-१-११६)<br><b>प्रयोगाः - </b>"नपुंसकमपुंसकेनैकवच्चास्यान्यतरस्याम्"<br><b>उल्लेखाः - </b>पा० सू० १-२-६९<br><br>एकवत्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕ್ರಿಯೆಯು ತೋರುವಲ್ಲಿ ಒಂದರೊಡನೆಸಮಾನವಾಗಿ /ಒಂದಕ್ಕೆ ಸದೃಶವಾಗಿ<br><b>निष्पत्तिः - </b>"वतिः" (५-१-११५)<br><b>व्युत्पत्तिः - </b>एकेन तुल्यम्<br><br>

एकवद्भाव
एकवद्भाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದಾಗಿರುವಿಕೆ /ಒಂದರಂತಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>एकेन तुल्यो भावः भवनम्<br><br>

एकपर्ण
एकपर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವರ್ಣ /ಒಂದು ಬಣ್ಣ<br><b>व्युत्पत्तिः - </b>एको वर्णः<br><br>एकपर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವರ್ಣ /ಒಂದು ಅಕ್ಷರ<br><br>एकपर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಬಣ್ಣದ<br><br>एकपर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಬಣ್ಣದ /ಅದೇ ಬಣ್ಣದ /ಸಮಾನ ವರ್ಣದ<br><b>व्युत्पत्तिः - </b>एकः एक एव वा वर्णो यस्य<br><br>एकपर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ<br><br>एकपर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಜಾತಿಯ /ಸಮಾನ ಜಾತಿಯ<br><br>एकपर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ವರ್ಣದ /ಒಂದು ಅಕ್ಷರವುಳ್ಳ<br><br>

एकपर्णी
एकपर्णी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವುದೊಂದರ ಸಹಾಯವೂ ಇಲ್ಲದೆ ಕೇವಲ ಕೈಯಿಂದ ಬಾರಿಸಲ್ಪಡುವ ವಾದ್ಯ /ತಾಳ<br><b>निष्पत्तिः - </b>वर्ण (वर्णक्रियाविस्तारगुणवचनेषु) - "अच्" (३-१-१३४) । गौरा० "ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>एक एव वर्णयति<br><br>

एकवर्त्मन्
एकवर्त्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಏಕಮುಖವಾದ ಮಾರ್ಗ /ಒಂದೇ ಕಡೆಗೆ ಹೋಗುವ ಮಾರ್ಗ /ಹೋಗುವುದಕ್ಕೆ ಮಾತ್ರ ಏರ್ಪಟ್ಟ ಮಾರ್ಗ<br><br>

एकवर्षिका
एकवर्षिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವರ್ಷ ವಯಸ್ಸಿನ ಕರು<br><b>निष्पत्तिः - </b>"कप्" (५-४-१५४) । अत इवत्म् (७-३-४४)<br><b>व्युत्पत्तिः - </b>एको वर्षो वयःकालो यस्याः<br><br>

एकवाक्य
एकवाक्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಮಾತು<br><b>व्युत्पत्तिः - </b>एकं वाक्यम्<br><br>एकवाक्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾನವಾದ ವಾಕ್ಯ /ಒಂದೇ ರೀತಿಯ ವಾಕ್ಯ<br><br>एकवाक्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಅಭಿಪ್ರಾಯ /ಒಂದೇ ರೀತಿಯಾದ ಮಾತು /ಒಮ್ಮತದ ವಾಕ್ಯ /ಸರ್ವಾನುಮತದ ವಾಕ್ಯ<br><b>व्युत्पत्तिः - </b>एकमभिन्नम् अविसंवादि वाक्यम्<br><b>प्रयोगाः - </b>"इति समगुणयोगप्रीतयस्तत्र पौराः श्रवणकटु नृपाणामेकवाक्यं विवव्रुः"<br><b>उल्लेखाः - </b>रघु० ६-८५<br><br>

एकवाक्यता
एकवाक्यता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಾಕ್ಯವಾಗಿರುವಿಕೆ<br><br>एकवाक्यता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಮ್ಮತವಾಗಿರುವಿಕೆ /ಏಕಾಭಿಪ್ರಾಯವಾಗಿರುವಿಕೆ<br><br>एकवाक्यता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶಿಷ್ಟವಾದ ಒಂದು ಅರ್ಥವನ್ನು ಕೊಡುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>एकवाक्यस्य भावः<br><b>विस्तारः - </b>ಇದು ಪದೈಕವಾಕ್ಯತಾ ಮತ್ತು ವಾಕ್ಯೈಕವಾಕ್ಯತಾ ಎಂದು ೨ ವಿಧ.<br><br>

एकवाचक
एकवाचक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಷಯವನ್ನು ತಿಳಿಸುವ /ಒಂದೇ ವಸ್ತುವನ್ನು ಬೋಧಿಸುವ<br><b>निष्पत्तिः - </b>वच (परिभाषणे) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>एकस्य वाचकः<br><br>

एकवाद
एकवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಕೈಯಿಂದ ಬಾರಿಸಲ್ಪಡುವ ಡಿಂಡಿಮ ವಾದ್ಯ /ಝಾಯಿಯೆಂಬ ಒಂದು ವಾದ್ಯ<br><b>निष्पत्तिः - </b>वद (व्यक्तायां वाचि) + णिच् - कर्म० "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>एकेन हस्तेन वाद्यते<br><br>एकवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವರು ಒಬ್ಬನೇ ಎಂದು ವಾದಿಸುವವರ ಮಾತು<br><br>एकवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ ಒಂದೇ ಎಂದು ಹೇಳುವ ಅದ್ವೈತಿಗಳ ವಾದ<br><b>व्युत्पत्तिः - </b>एकस्य ब्रह्माभिन्नत्वस्य वादः कथनम्<br><br>

एकवारम्
एकवारम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಂದು ಸಲ /ಒಂದಾವೃತ್ತಿ<br><br>

एकविंश
एकविंश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಪ್ಪತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>"डट्" (५-२-४८) ।<br><b>व्युत्पत्तिः - </b>एकविंशतेः पूरणः<br><br>एकविंश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಪ್ಪತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>पक्षे<br><br>

एकविंशक
एकविंशक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಪ್ಪತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>स्वार्थे "कः"<br><b>प्रयोगाः - </b>"दश पूर्वान परान् वंश्यान् आत्मानं चैकविंशकम् । ब्राह्मीपुत्रः सुकृतकृन्मोचयत्येनसः पितॄन् ॥"<br><b>उल्लेखाः - </b>मनु० ३-३७<br><br>

एकविंशति
एकविंशति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಪ್ಪತ್ತೊಂದು<br><b>व्युत्पत्तिः - </b>एकाधिका विंशतिः<br><br>एकविंशति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಪ್ಪತ್ತೊಂದರ ಒಂದು ಗುಂಪು<br><br>

एकविंशतितम
एकविंशतितम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಪ್ಪತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>"डट्" (५-२-४८) । वा "तमट्" (५-२-५६)<br><b>व्युत्पत्तिः - </b>एकविंशतेः पूरणः<br><br>

एकविंशतिधा
एकविंशतिधा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಇಪ್ಪತ್ತೊಂದು ಭಾಗವಾಗಿ /ಇಪ್ಪತ್ತೊಂದು ರೀತಿಯಾಗಿ<br><b>निष्पत्तिः - </b>एकविंशति - "धा" (५-३-४२)<br><br>

एकविध
एकविध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಪ್ರಕಾರವಾದ /ಒಂದೇ ರೀತಿಯಾದ<br><b>व्युत्पत्तिः - </b>एका विधा प्रकारो यस्य<br><br>एकविध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ರೀತಿಯ /ಒಂದು ಪ್ರಕಾರದ<br><br>

एकविभक्ति
एकविभक्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಭಕ್ತಿಯುಳ್ಳ ಶಬ್ದ /ವಿಗ್ರಹವಾಕ್ಯದಲ್ಲಿ ಬದಲಾವಣೆ ಹೊಂದದೆ ನಿಯತವಾದ ವಿಭಕ್ತಿಯುಳ್ಳ ಪದ<br><br>

एकविलोचन
एकविलोचन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರ<br><b>व्युत्पत्तिः - </b>एकंविलोचनं नेत्रं यस्य<br><br>एकविलोचन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯಸ /ಕಾಗೆ<br><b>विस्तारः - </b>ಕಾಗೆಗೆ ೨ ಕಣ್ಣುಗಳಿದ್ದರೂ ಒಂದೇ ನೇತ್ರೇಂದ್ರಿಯವು ಗುಡ್ಡೆಗಳಲ್ಲಿಯೂ ಚಲಿಸುವುದರಿಂದ ಈ ಹೆಸರು.<br><br>एकविलोचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಕಣ್ಣು<br><b>व्युत्पत्तिः - </b>एकं विलोचनम्<br><br>एकविलोचन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕಣ್ಣುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकं विलोचनम् यस्य<br><br>

एकविषयिन्
एकविषयिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಷಯವುಳ್ಳ /ಸಮಾನವಾದ ಉದ್ದೇಶವುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११६)<br><b>व्युत्पत्तिः - </b>एकः समानः विषयोऽस्यास्ति<br><br>एकविषयिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ದೇಶದಲ್ಲಿ ವಾಸಮಾಡುವ<br><br>

एकवीर
एकवीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮರ್ಥನಾದ ಯೋಧ /ಲೋಕೋತ್ತರ ಪರಾಕ್ರಮಿ /ಅಸಹಾಯಶೂರ<br><b>व्युत्पत्तिः - </b>एकः श्रेष्ठः असहायो वा वीरः<br><br>

एकवीर्य
एकवीर्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾನವಾದ ಪರಾಕ್ರಮ /ಒಂದೇ ರೀತಿಯ ಪರಾಕ್ರಮ<br><b>व्युत्पत्तिः - </b>एकं समानं वीर्यम्<br><br>एकवीर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾನ ಬಲವುಳ್ಳ /ಒಂದೇ ವಿಧ ಪರಾಕ್ರಮವುಳ<br><b>व्युत्पत्तिः - </b>एकं समानं वीर्यं यस्य<br><br>

एकवृन्द
एकवृन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಗಂಟಲು ರೋಗ /೬೫ ವಿಧ ಮುಖರೋಗಗಳಲ್ಲೊಂದು<br><b>विस्तारः - </b>"वृत्तोन्नतो यः श्वयथुः सदाहः कण्ड्वान्वितोऽपाक्यमृदुर्गुरुश्च । नाम्नैकवृन्दः परिकीर्तितोऽसौ " - सुश्रुत० निदान० ५५<br><br>एकवृन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ರಾಶಿ /ಒಂದು ಗುಂಪು<br><br>

एकवृष
एकवृष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಎತ್ತು<br><b>व्युत्पत्तिः - </b>एको वृषः<br><b>प्रयोगाः - </b>"एको वृषस्त्रयो गावःसप्ताश्वाः नव दन्तिनः । सिंहप्रसूतिका गावः कथिताः स्वामिघातकाः ॥"<br><br>एकवृष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ ಎತ್ತು<br><br>एकवृष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಎತ್ತುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>एको वृषो यस्य<br><br>

एकव्यवसायिन्
एकव्यवसायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕಾರ್ಯವನ್ನಿಟ್ಟುಕೊಂಡಿರುವ<br><br>एकव्यवसायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಉದ್ಯೋಗವುಳ್ಳ /ಸಮಾನವಾದ ಕೆಲಸವುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११६)<br><b>व्युत्पत्तिः - </b>एकः समानः व्यवसायोळ्स्यास्ति<br><br>

एकव्रत
एकव्रत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಬ್ಬನಿಗೇ ವಿಧೇಯನಾಗಿರುವ /ಒಬ್ಬನನ್ನೇ ಆಶ್ರಯಿಸಿರುವ<br><b>व्युत्पत्तिः - </b>एकस्मिन् व्रतं यस्य<br><br>एकव्रत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ವೇಳೆ ಮಾತ್ರ ಭೋಜನ ಮಾಡುತ್ತ ವ್ರತವನ್ನಾಚರಿಸುತ್ತಿರುವ<br><br>

एकशत
एकशत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನೂರ ಒಂದು<br><b>व्युत्पत्तिः - </b>एकाधिकं शतम्<br><br>एकशत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನೂರು<br><b>व्युत्पत्तिः - </b>एकं शतम्<br><br>एकशत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ನೂರುಳ್ಳ /ಒಂದು ನೂರು ಎಣಿಕೆಯುಳ್ಳ<br><b>प्रयोगाः - </b>"विश्वामित्रस्य चैवासन् पुत्रा एकशतं नृप"<br><br>

एकशततम
एकशततम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ನೂರ ಒಂದನೆಯ<br><b>निष्पत्तिः - </b>"डट्" (५-२-४८) । तमडागमः (-२-५७)<br><b>व्युत्पत्तिः - </b>एकशतस्य पूरणः<br><br>

एकशततमी
एकशततमी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನೂರ ಒಂದನೆಯ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

एकशतधा
एकशतधा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನೂರೊಂದು ಪ್ರಕಾರವಾಗಿ<br><b>निष्पत्तिः - </b>एकशत - "धा" (५-३-४२)<br><br>

एकशफ
एकशफ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಗೊರಸುಳ್ಳ ಪ್ರಾಣಿ ಕತ್ತೆಕುದುರೆ ಮುಂತಾದುದು<br><b>व्युत्पत्तिः - </b>एकं शफं यस्य<br><b>प्रयोगाः - </b>"अजाविकं चैकशफं न जातु विषमं भजेत्"<br><b>विस्तारः - </b>"खरोऽश्वोऽश्वतरो गौरः शरभश्चमरी तथा । एते चैकशफाः क्षत्तः श्रुणु पञ्चनखान् पशून् ॥" - भा० वन० १०-२२<br><br>

एकशरीर
एकशरीर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ದೇಹದಿಂದ ಹುಟ್ಟಿದ /ಒಂದೇ ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದ /ಒಂದೇ ಗೋತ್ರದವನಾದ<br><b>व्युत्पत्तिः - </b>एकं समानं शरीरं यस्य<br><br>

एकशस्
एकशस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಂದೊಂದಾಗಿ /ಒಬ್ಬೊಬನಾಗಿ<br><b>निष्पत्तिः - </b>"शस्" (५-४-४३)<br><b>व्युत्पत्तिः - </b>एकमेकम्<br><br>

एकशाख
एकशाख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಶಾಖೆಗೆಸೇರಿದ /ಸಮಾನ ಶಾಖೆಗೆ ಸೇರಿದ<br><b>व्युत्पत्तिः - </b>एका समाना शाखा यस्य<br><br>

एकशालिक
एकशालिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಶಾಲೆಯಂತಿರುವ /ಒಂದು ಮನೆಯಂತಿರುವ<br><b>निष्पत्तिः - </b>वा "ठच्" (५-३-१०९)<br><b>व्युत्पत्तिः - </b>एकशालेव<br><br>

ऐकशालिक
ऐकशालिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಶಾಲೆಯಂತಿರುವ /ಒಂದು ಮನೆಯಂತಿರುವ<br><b>निष्पत्तिः - </b>पक्षे "ठक्"<br><br>

एकशुल्क
एकशुल्क<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಕ್ರಯದ ಮೌಲ್ಯ /ವಸ್ತುವನ್ನು ಕೊಂಡುಕೊಳ್ಳಲು ಗೊತ್ತಾದ ಒಂದೇ ಮೊತ್ತದ ಹಣ<br><b>व्युत्पत्तिः - </b>एकं समानं शुल्कं<br><b>प्रयोगाः - </b>"अन्यां चेद्दर्शयित्वान्या वोढुः कन्या प्रदीयते । उभे त एकशुल्केन वहेदित्यब्रवीन्मनुः ॥"<br><b>उल्लेखाः - </b>मनु० ८-२०४<br><br>

एकशूर
एकशूर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>एकवीर ಪದದ ಅರ್ಥ<br><b>व्युत्पत्तिः - </b>एकः श्रेष्ठः असहयो वा शूरः<br><br>

एकशृङ्ग
एकशृङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ಮತ್ಸ್ಯಾವತಾರವೆತ್ತಿದ ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>एकं शृङ्गं यस्य<br><br>एकशृङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಕೊಂಬುಳ್ಳ ಪಶು<br><br>एकशृङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಶಿಖರವುಳ್ಳಪರ್ವತ<br><br>एकशृङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಿತೃಗಳ ಒಂದು ಗಣ<br><br>

एकशृङ्गा
एकशृङ्गा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶುಕಮಹರ್ಷಿಯ ಹೆಂಡತಿ<br><br>

एकशेष
एकशेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣದಲ್ಲಿ ಹೇಳಿದ೫ ವೃತ್ತಿಗಳಲ್ಲೊಂದು<br><b>व्युत्पत्तिः - </b>एकः शिष्यते (अन्यो लुप्यते) यत्र<br><br>एकशेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎರಡಲ್ಲಿ ಯವುದಾದರೂ ಒಂದು ಮಾತ್ರ ಉಳಿಯುವಿಕೆ<br><b>व्युत्पत्तिः - </b>एकश्चासौ शेषश्च, एकस्य शेषो वा ।<br><b>प्रयोगाः - </b>"ममाद्य तत्प्राप्तिरसुव्ययो वा हस्ते तवास्ते द्वयमेकशेषः"<br><b>उल्लेखाः - </b>नैष० ३-८२<br><br>

एकश्रुतधर
एकश्रुतधर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಸಲ ಶ್ರವಣ ಮಾಡಿದುದನ್ನು ನೆನಪಿನಲ್ಲಿಡುವವನು /ಒಂದು ಸಲ ಕೇಳಿಸುದನ್ನು ಮನಸ್ಸಿನಲ್ಲಿಟ್ಟುಕೊಳ್ಳುವವನು<br><br>

एकश्रुति
एकश्रुति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉದಾತ್ತಾನುದಾತ್ತಾದಿ ಸ್ವರಗಳು ಒಂದೇ ಸ್ವರದಂತೆ ಕೇಳಿಸುವಿಕೆ<br><b>विस्तारः - </b>ಇದು ೩ಸ್ವರಗಳಿಗೂ ಅಪವಾದಭೂತವಾದುದು. ದೂರದಿಂದ ಸಂಬೋಧಿಸುವ ಸಂದರ್ಭದಲ್ಲಿ ವಾಕ್ಯವು ಏಕಶ್ರುತಿಯಾಗುವುದು. "एकश्रुति दूरात् सम्बुद्धौ"पा० सू० १-२-३३<br><br>एकश्रुति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದಾತ್ತಾನುದಾತ್ತಾದಿ ಸ್ವರಿತಗಳ ಭೇದವಿಲ್ಲದೆ ಉಚ್ಚರಿಸಲ್ಪಡುವ ಶಬ್ದ<br><b>व्युत्पत्तिः - </b>एका श्रुतिर्यस्य<br><br>

एकषष्ट
एकषष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರವತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>"डट्" (५-२-४८) ।<br><b>व्युत्पत्तिः - </b>एकषष्टेः पूरणः<br><br>

एकषष्टितम
एकषष्टितम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರವತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>तस्य वा तमडागमः (५-२-५६)<br><br>

एकषष्टितमी
एकषष्टितमी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರವತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

एकषष्टि
एकषष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರವತ್ತೊಂದು<br><b>व्युत्पत्तिः - </b>एकाधिका षष्टिः<br><br>

एकसप्तत
एकसप्तत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಪ್ಪತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>"डट्" (५-२-४८) ।<br><b>व्युत्पत्तिः - </b>एकसप्ततेः पूरणः<br><br>

एकसप्ततितम
एकसप्ततितम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಪ್ಪತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>तस्य वा तमडागमः (५-२-५६)<br><br>

एकसप्ततितमी
एकसप्ततितमी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಪ್ಪತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

एकसप्तति
एकसप्तति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಪ್ಪತ್ತೊಂದು<br><b>व्युत्पत्तिः - </b>एकाधिका सप्ततिः<br><br>

एकसर्ग
एकसर्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏಕಾಗ್ರತೆಯುಳ್ಳ /ಒಂದೇ ವಿಷಯದಲ್ಲಿ ನೆಟ್ಟ ಮನಸ್ಸುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकस्मिन्नेव सर्गो निश्चयो यस्य<br><br>

एकसहस्र
एकसहस्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸಾವಿರದ ಒಂದು<br><b>व्युत्पत्तिः - </b>एकाधिकं सहस्रम्<br><br>एकसहस्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸಾವಿರ<br><b>व्युत्पत्तिः - </b>एकं सहस्रम्<br><br>

एकसहस्रतम
एकसहस्रतम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಸಾವಿರದ ಒಂದನೆಯ<br><b>निष्पत्तिः - </b>"तमट्" (५-२-५७)<br><b>व्युत्पत्तिः - </b>एकसहस्रस्य पूरणः<br><br>

एकसाक्षिक
एकसाक्षिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಸಾಕ್ಷಿಯುಳ್ಳ /ಒಬ್ಬನಿಂದ ನೊಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"कप्" (५-४-१५४)<br><b>व्युत्पत्तिः - </b>एकः साक्षी यत्र<br><br>

एकसूत्र
एकसूत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಡಮರು /ಬುಡುಬುಡಿಕೆ<br><b>व्युत्पत्तिः - </b>एकं सूत्रं वादनसाधनं यस्य<br><br>

एकस्थ
एकस्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕಡೆಯಿರುವ /ಒಂದೇ ವಿಷಯದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>ष्ठा (गतिनिवृत्तौ) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>एकस्मिन् तिष्ठति<br><b>प्रयोगाः - </b>"सा निर्मिता विश्वसृजा प्रयत्नात् एकस्थसौन्दर्यदिदृक्षयेव" । "एकस्थहृदया नूनं राममेवानुपश्यति"<br><b>उल्लेखाः - </b>कुमा० १-४९, रामा०<br><br>

एकस्थान
एकस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾಗ<br><br>एकस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾನವಾದ ಜಾಗ/ಅದೇ ಜಾಗ<br><b>व्युत्पत्तिः - </b>एकं समानं स्थानम्<br><br>एकस्थान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಸ್ಥ್ತಾನವುಳ್ಳ /ಸಮಾನ ಸ್ಥಾನದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>व्युत्पत्तिः - </b>एकं समानं स्थानं यस्य<br><br>

एकहस्त
एकहस्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಮೊಳ<br><b>व्युत्पत्तिः - </b>एको हस्तः<br><b>विस्तारः - </b>"प्रकोष्ठे विस्तृतकरे हस्तः"- अम० ।<br><br>एकहस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಮೊಳದ ಅಳತೆಯುಳ್ಳ<br><br>एकहस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಹಸ್ತವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एको हस्तो यस्य<br><br>

एकहायन
एकहायन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವರ್ಷ /ಒಂದು ಸಂವತ್ಸರ<br><b>व्युत्पत्तिः - </b>एकं हायनम्<br><br>एकहायन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ವರ್ಷದ /ಒಂದು ವರ್ಷ ವಯಸ್ಸುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकं हायनं वयोमानं यस्य<br><b>प्रयोगाः - </b>"त्रस्तैकहायनकुरङ्गविलोलदृष्टिराश्लिष्टवत्यमृतसंविलितैरिवाङ्गैः"<br><b>उल्लेखाः - </b>मालती० ४-८<br><br>

एकहायनी
एकहायनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವರ್ಷದ ಕರು<br><b>निष्पत्तिः - </b>"ङीप्" (४-१-२७)<br><b>व्युत्पत्तिः - </b>एकं हायनं यस्याः<br><br>

एकाकिन्
एकाकिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಹಾಯಕ /ಒಬ್ಬಂಟಿಗ /ಜೊತೆಗಾರನಿಲ್ಲದ /ಸಜಾತೀಯರಹಿತವಾದ<br><b>निष्पत्तिः - </b>एक - "आकिनच्"(५-३-५२)<br><b>प्रयोगाः - </b>"एकाकिनोऽपि परितः पौरुषेयवृता इव"<br><b>उल्लेखाः - </b>माघ० २-४<br><br>

एकाक्ष
एकाक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯಸ /ಕಾಗೆ<br><br>एकाक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕಣ್ಣುಳ್ಳವನು /ಕುರುಡ<br><b>निष्पत्तिः - </b>"षच्" (५-४-११३)<br><b>व्युत्पत्तिः - </b>एकं अक्षि यस्य<br><br>एकाक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ದೂರಿಯುಳ್ಳ /ಒಂದು ಅಚ್ಚುಳ್ಳ ಗಾಡಿ<br><b>व्युत्पत्तिः - </b>एकोऽक्षो रथावयवो यस्य<br><br>

एकाक्षर
एकाक्षर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಅಕ್ಷರ /ಒದು ವರ್ಣ<br><b>व्युत्पत्तिः - </b>एकमक्षरम्<br><br>एकाक्षर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸ್ವರವರ್ಣ /ಓಂಕಾರ /ಪರಬ್ರಹ್ಮ<br><b>प्रयोगाः - </b>"एकाक्षरं परं ब्रह्म प्राणायामाःपरं तपः"<br><b>उल्लेखाः - </b>मनु०२-८३<br><br>एकाक्षर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಅಕ್ಷರದ ಪದ<br><br>एकाक्षर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಅಕ್ಷರದಿಂದ ಕೂಡಿದ<br><br>

एकाक्षरकोश
एकाक्षरकोश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಅಕ್ಷರದ ಪದಗಳಕೋಶ<br><br>

एकागार
एकागार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೇವಲಮನೆ /ಯಾರೂ ಇಲ್ಲದ ಮನೆ<br><br>एकागार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಮನೆ /ಅಕ್ಕಪಕ್ಕಗಳಲ್ಲಿ ಯಾವ ಮನೆಯೂ ಇಲ್ಲದ ಏಕಮಾತ್ರ ಗೃಹ<br><b>व्युत्पत्तिः - </b>एकमसहायमगारम्<br><br>एकागार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಖ್ಯವಾದ ಮನೆ<br><b>विस्तारः - </b>"एके मुख्यान्यकेवलाः" - अम०<br><br>

एकाग्नि
एकाग्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಅಗ್ನಿ /ಮೂರು ಅಗ್ನಿಗಳಲ್ಲೊಂದು<br><b>व्युत्पत्तिः - </b>एकोऽग्निः<br><br>एकाग्नि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂರು ಅಗ್ನಿಗಳಲ್ಲಿ ಒಂದು ಅಗ್ನಿಯನ್ನು ಹೊಂದಿರುವ<br><b>व्युत्पत्तिः - </b>एकोऽग्निर्धार्यत्वेन यस्य<br><br>

एकाग्निकाण्ड
एकाग्निकाण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಷೋಡಶಕರ್ಮ ಸಂಬಂಧವಾದ ವೇದಮಂತ್ರಗಳ ಒಂದು ಭಾಗ /ಮಂತ್ರಪ್ರಶ್ನ<br><br>

एकाग्र
एकाग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಅಗ್ರವುಳ್ಳ /ಒಂದು ತುದಿಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकमग्रमग्रभागं यस्य<br><br>एकाग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಷಯದಲ್ಲಿ ಆಸಕ್ತನಾದ<br><b>व्युत्पत्तिः - </b>एकमग्रं विषयप्रवणता यस्य<br><b>प्रयोगाः - </b>"तद्गीतश्रवणैकाग्रां संसदश्रुमुखी बभौ"<br><b>उल्लेखाः - </b>रघु० १५-६६<br><br>एकाग्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಥಿರಮನಸ್ಸುಳ್ಳ /ಬೇರೆ ಯಾವ ವಿಷಯದಲ್ಲಿಯೂ ಆಸಕ್ತವಲ್ಲದ ಮನಸ್ಸುಳ್ಳ<br><b>प्रयोगाः - </b>"मनुमेकाग्रमासीनमभिगम्य महर्षयः"<br><b>उल्लेखाः - </b>मनु० १-१<br><br>

एकाग्रचित्त
एकाग्रचित्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಷಯದಲ್ಲಿ ನೆಟ್ಟ ಮನಸ್ಸುಳ್ಳ /ಸ್ಥಿರಮನಸ್ಸುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकाग्रं चित्तं यस्य<br><br>

एकाग्रतस्
एकाग्रतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಚಿತ್ತಸ್ಥೈರ್ಯದಿಂದ /ನೆಟ್ಟ ಮನಸ್ಸಿನಿಂದ<br><b>निष्पत्तिः - </b>एकाग्र - "तसिः" (वा० ५-४-४४)<br><br>

एकाग्रता
एकाग्रता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಷಯದಲ್ಲಿ ಆಸಕ್ತವಾಗಿರುವಿಕೆ /ಒಂದೇವಿಷಯದಲ್ಲಿ ಮನಸ್ಸಿಟ್ಟಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>एकाग्रस्य भावः<br><br>

एकाग्रत्व
एकाग्रत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಷಯದಲ್ಲಿ ಆಸಕ್ತವಾಗಿರುವಿಕೆ /ಒಂದೇವಿಷಯದಲ್ಲಿ ಮನಸ್ಸಿಟ್ಟಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

एकाग्रदृष्टि
एकाग्रदृष्टि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೆಟ್ಟ ಮನಸ್ಸಿನಿಂದ ಒಂದೇ ವಿಷಯವನ್ನು ನೋಡುವ<br><b>व्युत्पत्तिः - </b>एकाग्रा दृष्टिर्यस्य<br><br>

एकाग्रधी|एकाग्रमनस्
एकाग्रधी (मनस्)<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಷಯದಲ್ಲಿ ನೆಟ್ಟಮನಸ್ಸುಳ್ಳ /ಒಂದೇ ಕಡೆ ಗಮನವಿಟ್ಟಿರುವ /ಒಂದೇ ವಿಷಯದಲ್ಲಿ ಜ್ಞಾನವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकाग्रा धीः एकाग्रं मनः वा यस्य<br><b>प्रयोगाः - </b>"स भूभृदष्टावपि लोकपालास्तैर्मे तदेकाग्रधियः प्रसेदे"<br><b>उल्लेखाः - </b>नैष० ३-८९<br><br>

एकाङ्ग
एकाङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬುಧಗ್ರಹ<br><b>व्युत्पत्तिः - </b>एकं सुन्दरत्वेन प्रधानम् अङ्गं यस्य<br><b>विस्तारः - </b>"बुधो हेमा राजपुत्र एकदेहः प्रहर्षणः । स्यात् पञ्चार्चिश्रविष्ठाजश्यामाङ्गैकाङ्गरोधनाः" - त्रिकाण्ड० ।<br><br>एकाङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಅವಯವ /ಒಂದು ಭಾಗ<br><br>एकाङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ ಅಂಗ /ಶಿರಸ್ಸು /ತಲೆ<br><b>व्युत्पत्तिः - </b>एकं श्रेष्ठमङ्गम्<br><br>एकाङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದನ ವೃಕ್ಷ /ಗಂಧದ ಮರ<br><br>

एकाङ्ग
एकाङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಂಪತಿಗಳು /ಏಕದೇಹಭಾವವನ್ನು ಹೊಂದಿರುವ ಪತಿಪತ್ನಿಯರು<br><b>विस्तारः - </b>द्विवचने इदं रूपम् ।<br><br>

एकाण्ड
एकाण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವೃಷಣವನ್ನು ಹೊಂದಿರುವ ಒಂದು ಜಾತಿಯ ಕುದುರೆ<br><b>व्युत्पत्तिः - </b>एकमण्डं वृषणमस्य<br><br>

एकातपत्र
एकातपत्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಛತ್ರಿಯುಳ್ಳ /ಸಾರ್ವಭೌಮಸೂಚಕವಾದ ಒಂದು ಛತ್ರಿಯನ್ನು ಹೊಂದಿರುವ<br><b>व्युत्पत्तिः - </b>एकम् अद्वितीयम् सार्वभौमत्वसूचकम् आतपत्रं यस्य<br><b>प्रयोगाः - </b>"एकातपत्रं जगतः प्रभुत्वं नवं वयः कान्तमिदं वपुश्च"<br><b>उल्लेखाः - </b>रघु० २-४८<br><br>एकातपत्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೇವಲ ಛತ್ರಿಮಯವಾದ /ಛತ್ರಿಪ್ರಚುರವಾದ<br><b>व्युत्पत्तिः - </b>एकानि केवलानि आतपत्राणि यस्य<br><br>

एकातपत्रा
एकातपत्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>एकातपत्र ಪದದ ಅರ್ಥ<br><b>प्रयोगाः - </b>"एकातपत्रा पृथिवीभृतां गणैरभूद्वहुच्छत्रतया पताकिनी"<br><b>उल्लेखाः - </b>माघ० १२-३३<br><br>

एकात्मन्
एकात्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಆತ್ಮ /ಒಂದು ಜೀವ<br><br>एकात्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಸ್ವರೂಪವುಳ್ಳ /ಸಮಾನ ಸ್ವರೂಪವುಳ್ಳ<br><br>एकात्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾನ ಸ್ವಭಾವವುಳ್ಳ /ಒಂದೇ ಸ್ವಭಾವವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एक आत्मा स्वरूपं स्वभावो वा यस्य<br><br>एकात्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏಕಾಕಿ /ಅಸಹಾಯಕ /ಒಬ್ಬಂಟಿಗ<br><br>

एकादश
एकादश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹನ್ನೊಂದನೆಯ<br><b>निष्पत्तिः - </b>"डट्" (५-२-४८) ।<br><b>व्युत्पत्तिः - </b>एकादशानां पुरणः<br><br>

एकादशी
एकादशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹನ್ನೊಂದನೆಯ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>एकादशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶುಕ್ಲ ಮತ್ತು ಕೃಷ್ಣಪಕ್ಷಗಳ ಹನ್ನೊಂದನೆಯ ತಿಥಿ /ಹರಿದಿನ<br><b>निष्पत्तिः - </b>"डट्" (५-२-४८) । "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>एकादशानाम्पूरणः<br><b>प्रयोगाः - </b>"एकादशी सदोपोष्या पक्षयोः शुक्लकृष्णयोः"<br><b>उल्लेखाः - </b>सनत्कु० सं०<br><br>

एकादशगुरु
एकादशगुरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹನ್ನೊಂದು ಮಂದಿ ಗುರುಗಳು<br><b>विस्तारः - </b>ಆಚಾರ್ಯ, ತಂದೆ, ಜ್ಯೇಷ್ಠ ಸಹೋದರ, ರಾಜ, ಸೋದರಮಾವ, ಶ್ವಶುರ, ರಕ್ಷಣೆ ಕೊಡುವವನು, ಮಾತಾಮಹ, ಪಿತಾಮಹ, ವರ್ಣಜ್ಯೇಷ್ಠ ಮತ್ತು ಪಿತೃವ್ಯ - ೧೧ ಜನರು ಗುರುಗಳು. ಗುರುವಿನಂತೆ ಪೂಜ್ಯರು. "आचार्यस्च पिता ज्येष्ठभ्राता महीपतिः । मातुलः श्वशुरस्त्राता मातामहपितामहौ । पितृव्यश्च पुंस्येते गुरवो मताः ॥" - देवलः ।<br><br>एकादशगुरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜನ್ಮರಾಶಿಯಿಂದ ಹನ್ನೊಂದನೆಯ ಸ್ಥಾನದಲ್ಲಿರುವ ಗುರು<br><br>

एकादशन्
एकादशन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹನ್ನೊಂದು ಸಂಖ್ಯೆ<br><br>एकादशन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹನ್ನೊಂದು ಸಂಖ್ಯೆಯಿಂದ ಕೂಡಿದ /ಹನ್ನೊಂದು ಸಂಖ್ಯೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकाधिका दश एकाधिका दश यत्र वा<br><br>

एकादशरुद्र
एकादशरुद्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹನ್ನೊಂದು ಮಂದಿ ರುದ್ರರು<br><br>

एकादि
एकादि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಮೊದಲುಗೊಂಡು ಪರದವರೆಗಿನ ಸಂಖ್ಯೆ<br><br>

एकादेश
एकादेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣದಲ್ಲಿ ಸಂಧಿ ವಿಧಿಸುವಾಗ ಎರಡು ವರ್ಣಗಳ ಸ್ಥಾನದಲ್ಲಿ ಬರುವ ಒಂದು ವರ್ಣ<br><br>

एकाद्नविंशति
एकाद्नविंशति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತೊಂಬತ್ತು /ಒಂದು ಕಡಿಮೆ ಇಪ್ಪತ್ತು<br><b>निष्पत्तिः - </b>एक + न + विंशतिः एकस्य "आदुक्" आगमः (६-३-७६)<br><b>व्युत्पत्तिः - </b>एकेन न विंशतिः<br><br>एकाद्नविंशति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತೊಂಬತ್ತು /ಒಂದು ಕಡಿಮೆ ಇಪ್ಪತ್ತು<br><b>निष्पत्तिः - </b>अनुनासिकाभावपक्षे इदं रूपम् ।<br><br>

एकानविंशति
एकानविंशति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತೊಂಬತ್ತು /ಒಂದು ಕಡಿಮೆ ಇಪ್ಪತ್ತು<br><b>निष्पत्तिः - </b>दकारस्य अनुनासिकपक्षे<br><br>

एकादधिपति
एकादधिपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಕ್ರವರ್ತಿ/ಸಾರ್ವಭೌಮ/ದೇಶಕ್ಕೆ ಒಬ್ಬನೇ ದೊರೆಯಾಗಿರುವವನು<br><b>व्युत्पत्तिः - </b>एकः केवलः अद्वितीयः अधिपतिः<br><br>एकादधिपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎರಡು ರಾಶಿಗಳಿಗೂ ಅಧಿಪತಿಯಾಗಿರುವ ಒಂದು ಗ್ರಹ<br><br>

एकानंशा
एकानंशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ<br><b>व्युत्पत्तिः - </b>एको न अंशो यस्याः<br><b>प्रयोगाः - </b>"विद्धि चैनामथोत्पन्नामंशाद्देवीं प्रजापतेः । एकानंशां योगकलां रक्षार्थं केशवस्य तु ॥"<br><b>उल्लेखाः - </b>हरिवं० ५९-१४-४७<br><br>

एकान्त
एकान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿರ್ಜನ ಪ್ರದೇಶ /ರಹಸ್ಯ ಪ್ರದೇಶ /ಯಾರೂ ಇಲ್ಲದ ಪ್ರದೇಶ<br><b>व्युत्पत्तिः - </b>एक एव अन्तो यत्र<br><b>प्रयोगाः - </b>"व्योमैकान्तविहारिणोऽपि विहगाः सम्प्राप्नुवन्त्यापदं बध्यन्ते निपुणैरगाधसलिलान्मत्स्याः समुद्रादपि ॥"<br><b>उल्लेखाः - </b>हितो० २-५२<br><br>एकान्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಶಯ /ಹೆಚ್ಚಿಗೆ /ಆಧಿಕ್ಯ<br><b>व्युत्पत्तिः - </b>एकस्मिन्नेवान्तो यस्य<br><br>एकान्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಯಮ /ಕಟ್ಟಳೆ<br><b>प्रयोगाः - </b>"तेजः क्षमा वा नैकान्तं कालज्ञस्य महीपतेः"<br><b>उल्लेखाः - </b>माघ० २-८३<br><br>एकान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಶಯವಾದ<br><b>प्रयोगाः - </b>"स्वायत्तमेकान्तहितं विधात्रा विनिर्मितं छादनमज्ञतायाः"<br><b>उल्लेखाः - </b>भर्तृ० १-७<br><br>एकान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಯತವಾದ /ಶಾಶ್ವತವಾದ /ನಿತ್ಯವಾದ<br><b>प्रयोगाः - </b>"नागेन्द्रहस्तास्त्वचि कर्कशत्वादेकान्तशैत्यात्कदलीविशेषाः"<br><b>उल्लेखाः - </b>कुमा० १-३६<br><br>

एकान्ततस्
एकान्ततस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ರಹಸ್ಯದಲ್ಲಿ<br><b>निष्पत्तिः - </b>एकान्त - "तसिः" (वा- ५-४-४४)<br><br>एकान्ततस्<br><br><b>पदविभागः - </b>अव्ययम् (क्रिया विशेषणम्)<br><b>कन्नडार्थः - </b>ಏಕಾಂತವಾಗಿ /ರಹಸ್ಯವಾಗಿ<br><br>एकान्ततस्<br><br><b>पदविभागः - </b>अव्ययम् (क्रिया विशेषणम्)<br><b>कन्नडार्थः - </b>ನಿಯತವಾಗಿ /ಕ್ಲೃಪ್ತವಾಗಿ /ಶಾಶ್ವತವಾಗಿ<br><b>प्रयोगाः - </b>"कस्यान्त्यन्तं सुखमुपनतं दुःखमेकान्ततो वा"<br><b>उल्लेखाः - </b>मेघ० २-४६<br><br>एकान्ततस्<br><br><b>पदविभागः - </b>अव्ययम् (क्रिया विशेषणम्)<br><b>कन्नडार्थः - </b>ಅತ್ಯಂತವಾಗಿ /ಅತಿಶಯವಾಗಿ<br><b>प्रयोगाः - </b>"यद्यस्मासु पराङ्मुखोऽसि वयमप्येकान्ततो निःस्पृहाः"<br><b>उल्लेखाः - </b>भर्तृ० ३-५१<br><br>

एकान्तदुःषमा
एकान्तदुःषमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜೈನಮತ ಕಲಿತವಾದ ಬಹಳ ಕಷ್ಟವಾದ ಒಂದು ಕಾಲ<br><b>व्युत्पत्तिः - </b>दुष्टा समा वर्षो दुःषमा । एकान्तं दुःषमा ।<br><br>

एकन्तर
एकन्तर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಿನ ಬಿಟ್ಟು ದಿನ ಬರುವ ಜ್ವರ /ಮೂರನೆಯ ವಾಯಿದೆ ಜ್ವರ<br><br>एकन्तर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಿನ ಬಿಟ್ಟು ದಿನ ಊಟ ಮಾಡುವ ಒಂದು ವ್ರತ /ಮಧ್ಯೆ ಮಧ್ಯೆ ಒಂದು ದಿನ ಬಿಟ್ಟು ಊಟ ಮಾಡುವಒಂದು ವ್ರತ<br><br>एकन्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಮಧ್ಯದಲ್ಲಿರುವ /ಮಧ್ಯೆ ಒಂದು ವಸ್ತುವಿನಿಂದ ವ್ಯವಹಿತವಾಗಿರುವ<br><b>व्युत्पत्तिः - </b>एकमन्तरं व्यवधानं यस्य<br><b>प्रयोगाः - </b>"आम एकान्तरमामन्त्रितमनन्तिके"<br><b>उल्लेखाः - </b>पा० सू० ८-१-५५<br><br>

एकान्तसुषमा
एकान्तसुषमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜೈನಮತ ಸಿದ್ಧವಾದ ಬಹಳ ಸುಖವಾದ ಒಂದು ಕಾಲ<br><b>व्युत्पत्तिः - </b>एकान्तं सुषमा<br><br>

एकान्तिन्
एकान्तिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏಕಾಂತವಾಸವುಳ್ಳ /ಯಾರ ಸಂಪರ್ಕವೂ ಇಲ್ಲದ ನಿರ್ಜನ ಪ್ರದೇಶದಲ್ಲಿ ವಾಸಿಸುವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११६)<br><b>व्युत्पत्तिः - </b>एकान्तमस्त्यस्य<br><br>एकान्तिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಗವದ್ಭಕ್ತ /ಪರಮಾತ್ಮನೊಬ್ಬನಲ್ಲೇ ಭಕ್ತಿಯಿಟ್ಟಿರುವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११६)<br><b>व्युत्पत्तिः - </b>एकान्तः उपास्यत्वेनास्त्यस्य<br><br>

एकान्न
एकान्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಊಟ /ಒಂದು ವೇಳೆ ಮಾಡುವ ಊಟ<br><br>एकान्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅದೇ ಊಟ /ಸಮಾನವಾದ ಊಟ<br><b>व्युत्पत्तिः - </b>एकं समानमन्नम्<br><br>एकान्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಮನೆಯ ಊಟ /ಒಂದೇ ಮನೆಯ ಅನ್ನ<br><b>व्युत्पत्तिः - </b>एकस्यान्नम्<br><b>प्रयोगाः - </b>"भैक्ष्येण वर्तयेन्नित्यं नैकान्नादी भवेद्व्रती"<br><b>उल्लेखाः - </b>मनु० २-१८८<br><br>एकान्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಿನವೂ ಒಂದು ವೇಳೆ ಮಾತ್ರ ಊಟಮಾಡುವ /ಏಕಕಾಲ ಮಾತ್ರ ಭೋಜನಮಾಡುವ<br><b>व्युत्पत्तिः - </b>एककालमेवान्नं भोजनं यस्य<br><br>एकान्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅದೇ ಆಹಾರ ಊಟ ಮಡುವ /ಸಮಾನವಾದ ಆಹಾರವನ್ನು ಊಟಮಾಡುವ<br><br>एकान्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಮನೆಯ ಅನ್ನವನ್ನೇ ಊಟಮಾಡುವ<br><b>व्युत्पत्तिः - </b>एकं समानम् अन्नं एकस्यैवान्नं वा यस्य<br><br>

एकान्नविंशति
एकान्नविंशति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತೊಂಬತ್ತು /ಒಂದು ಕಡಿಮೆ ಇಪ್ಪತ್ತು<br><b>निष्पत्तिः - </b>एक + न + विंशतिः एकस्य "आदुक्" आगमः (६-३-७६) । अनुनासिकपक्षे रूपमिदम् ।<br><b>व्युत्पत्तिः - </b>एकेन न विंशतिः<br><br>

एकान्नादिन्
एकान्नादिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಮನೆಯಲ್ಲಿ ಊಟಮಾಡುವ /ಒಂದು ಮನೆಯ ಅನ್ನವನ್ನು ತಿನ್ನುವ<br><b>निष्पत्तिः - </b>अद (भक्षणे) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>एकान्नमत्ति<br><b>प्रयोगाः - </b>"भैक्ष्येण वर्तयेन्नित्यं नैकान्नादी भवेद्व्रती"<br><b>उल्लेखाः - </b>मनु० २-१८८<br><br>

एकान्वय
एकान्वय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಂಶ /ಸಮಾನವಾದವಂಶ<br><br>एकान्वय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಂಶದ /ಒಂದೇ ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>व्युत्पत्तिः - </b>एकोऽन्वयो यस्य<br><br>

एकापचय
एकापचय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಹಾರವನ್ನು ಒಂದೊಂದು ಗ್ರಾಸವಾಗಿ ಕಡಿಮೆ ಮಾಡುವಿಕೆ /ಪೂರ್ಣಿಮೆಯ ದಿನ ಊಟಮಾಡಿ ಕೃಷ್ಣಪ್ರತಿಪತ್ ಮೊದಲುಗೊಂಡು ಪ್ರತಿದಿನವೂ ಒಂದೊಂದು ಗ್ರಾಸ ಕಡಿಮೆ ಮಾಡಿಕೊಂಡು ಕೃಷ್ಣಪಕ್ಷದಲ್ಲಿ ಊಟಮಾಡುವಿಕೆ<br><b>प्रयोगाः - </b>"पौर्णमास्यां पञ्चदश ग्रासान् भुक्त्वा एकापचयेनापरपक्षमश्नीयात्"<br><b>उल्लेखाः - </b>गौतमध० २७-१३<br><br>

एकाब्दा
एकाब्दा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವರ್ಷ ವಯಸ್ಸಿನ ಕರು /ಒಂದು ವರ್ಷ ತುಂಬಿದ ಕರು<br><b>व्युत्पत्तिः - </b>एकोऽब्दोऽस्याः<br><br>

एकाम्रनाथ
एकाम्रनाथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂಚೀಪುರದಲ್ಲಿ ನೆಲಸಿರುವ ಏಕಾಮ್ರೇಶ್ವರ<br><br>

एकाम्रवन
एकाम्रवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಏಕಾಮ್ರೇಶ್ವರನು ನೆಲಸಿರುವ ಒಂದು ವನ<br><br>

एकायन
एकायन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬನು ಮಾತ್ರ ಹೋಗಲು ಸಾಧ್ಯವಾಗುವ ದಾರಿ /ಕಿರುದಾರಿ /ಕಾಲುದಾರಿ<br><br>एकायन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಬ್ಬನು ಮಾತ್ರ ನಡೆಯಲು ಸಾಧ್ಯವಾದ<br><b>प्रयोगाः - </b>"आस्त एकायने मार्गे कदलीखण्डमण्डिते । भ्रातुर्भीमस्य रक्षार्थं तं मार्गमवरुध्य वै ॥"<br><b>उल्लेखाः - </b>भा० वन० १४८-७२<br><br>एकायन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏಕಾಗ್ರತೆಯುಳ್ಳ /ಒಂದೇ ವಿಷಯದಲ್ಲಿ ನೆಟ್ಟ ಮನಸ್ಸುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एक्मयनं ज्ञानं यस्य<br><br>

एकायनगत
एकायनगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏಕಾಗ್ರತೆಯುಳ್ಳ /ಒಂದೇ ವಿಷಯದಲ್ಲಿ ನೆಟ್ಟ ಮನಸ್ಸುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एक्स्मिन्नयने गतं ज्ञानं यस्य<br><br>

एकार्थ
एकार्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಅರ್ಥ<br><br>एकार्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಅರ್ಥ /ಸಮಾನವಾದ ಅರ್ಥ /ಅದೇ ಅರ್ಥ<br><br>एकार्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದುಕಾರ್ಯ<br><br>एकार्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಕಾರ್ಯ /ಸಮಾನವಾದ ಕಾರ್ಯ<br><br>एकार्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಪ್ರಯೋಜನ<br><br>एकार्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಪ್ರಯೋಜನ /ಸಮಾನವಾದ ಪ್ರಯೋಜನ<br><br>एकार्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಸ್ತು /ಒಂದು ಪದಾರ್ಥ<br><b>व्युत्पत्तिः - </b>एकोऽर्थः अभिधेयं उद्देशः प्रयोजनं पदार्थो वा<br><b>प्रयोगाः - </b>"वर्णाः पदं प्रयोगार्हानन्वितैकार्थबोधकाः"<br><b>उल्लेखाः - </b>सा० द० २-२<br><br>एकार्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಅರ್ಥವುಳ್ಳ ಶಬ್ದ<br><br>एकार्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾನವಾದ ಅರ್ಥವುಳ್ಳ<br><br>एकार्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಪ್ರಯೋಜನವುಳ್ಳ<br><br>एकार्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾನವಾದ ಪ್ರಯೋಜನವುಳ್ಳ<br><br>एकार्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೇ ಕಾರ್ಯವುಳ್ಳ /ಸಮಾನವಾದ ಕಾರ್ಯವುಳ್ಳ<br><br>

एकार्थता
एकार्थता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಪ್ರಯೋಜನ ಹೊಂದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>एकार्थस्य भावः<br><br>एकार्थता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಕಾರ್ಯವಿರುವಿಕೆ<br><br>

एकार्थत्व
एकार्थत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>एकार्थता ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

एकार्थीभाव
एकार्थीभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯೇಕವಾದ ಅರ್ಥವುಳ್ಳ ಶಬ್ದಗಳಿಗೆ ಸಮಾಸ ಬಂದಾಗ ಸಮುದಾಯಶಕ್ತಿಯಿಂದ ವಿಶಿಷ್ಟವಾದ ಒಂದು ಅರ್ಥವುಂಟಾಗುವಿಕೆ /ಪ್ರಕ್ರಿಯಾದಶೆಯಲ್ಲಿ ಪ್ರತ್ಯೇಕವಾದ ಅರ್ಥವುಳ್ಳ ಶಬ್ದಗಳು ಸಮಾಸದಲ್ಲಿ ವಿಶಿಷ್ತವಾದ ಒಂದು ಅರ್ಥವನ್ನು ಹೊಂದುವಿಕೆ<br><br>

एकार्थीभावसामर्थ्य
एकार्थीभावसामर्थ्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪದಗಳಿಗೆಸಮಾಸ ಬರಲು ಅವಶ್ಯವಾಗಿರುವ ಒಂದು ಸಾಮರ್ಥ್ಯ /ಪ್ರಕ್ರಿಯಾದಶೆಯಲ್ಲಿ ಪ್ರತ್ಯೇಕವಾದ ಅರ್ಥವುಳ್ಳ ಪದಗಳಿಗೆ ಸಮುದಾಯಶಕ್ತಿಯಿಂದ ವಿಶಿಷ್ಟವಾದ ಒಂದು ಅರ್ಥವನ್ನುಂಟುಮಾಡುವ ಒಂದು ಶಕ್ತಿ<br><br>

एकार्थीभूत
एकार्थीभूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕ್ರಿಯಾದಶೆಯಲ್ಲಿ ಪ್ರತ್ಯೇಕವಾಗಿದ್ದು ಸಮಾಸದಲ್ಲಿ ಸಮುದಯಶಕ್ತಿಯಿಂದ ವಿಶಿಷ್ಟವಾದ ಒಂದೇ ಅರ್ಥವಾಗಿರುವ<br><b>निष्पत्तिः - </b>एकार्थ + भू (सत्तायाम्) कर्त० - "क्तः" (३-४-७२) । अभूतत० "च्विः" (वा० ५-४-५०)<br><br>

एकावलि|एकावली 
एकावलि-ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಶ್ರೇಣಿ /ಒದು ಪಂಕ್ತಿ /ಒಂದುಸಾಲು<br><b>व्युत्पत्तिः - </b>एका आवलिः<br><br>एकावलि-ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೆಳೆಯ ಹೂವಿನ ಅಥವಾ ಮುತ್ತಿನ ಸರ<br><br>एकावलि-ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥಾಲಂಕಾರದ ಒಂದು ಭೇದ<br><b>प्रयोगाः - </b>"गृहीतमुक्तरीत्यार्थश्रेणिरेकावली मता"<br><b>उल्लेखाः - </b>चन्द्रा०<br><br>

एकाशिन्
एकाशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂಟಿಯಾಗಿ ಊಟಮಾಡುವ /ಒಬ್ಬನೇ ಕುಳಿತು ಊಟಮಾಡುವ<br><b>निष्पत्तिः - </b>अश (भोजने) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>एक एवाश्नाति<br><br>

एकाशिीत
एकाशिीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಂಬತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>"डट्" (५-२-४८)<br><b>व्युत्पत्तिः - </b>एकाशीतेः पूरणः<br><br>

एकाशीति
एकाशीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಂಬತ್ತೊಂದು<br><b>व्युत्पत्तिः - </b>एकाधिका अशीतिः<br><br>

एकाशीतितम
एकाशीतितम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಂಬತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>"डट्" (५-२-४८) । डटः वा "तमट्" (५-२-५६)<br><b>व्युत्पत्तिः - </b>एकाशीतेः पूरणः<br><br>

एकाशीतितमी
एकाशीतितमी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಂಬತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

एकाशीतिपद
एकाशीतिपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹನಿರ್ಮಾಣಕಾಲದಲ್ಲಿ ಮೊದಲು ವಾಸ್ತುಪೂಜೆಗಾಗಿ ಮಡುವ ಎಂಬತ್ತೊಂದು ಸ್ಥಾನಗಳುಳ್ಳ ಒಂದು ಮಂಡಲ<br><b>प्रयोगाः - </b>"प्रादादे च चतुःषष्टिरेकाशीतिपदं गृहे"<br><b>उल्लेखाः - </b>देवीपु०<br><br>

एकाश्रय
एकाश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಆಧಾರ /ಒಂದು ಅವಲಂಬನ /ಒಂದು ಊರುಗಂಬ<br><br>एकाश्रय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಒತ್ತಾಸೆ /ಒಂದು ಸಹಾಯತೆ /ಅವಲಂಬನ<br><b>व्युत्पत्तिः - </b>एकः आश्रयः आधारः अवलम्बनं वा<br><br>एकाश्रय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಆಧಾರವುಳ್ಳ<br><br>एकाश्रय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಬ್ಬನ ಒತ್ತಾಸೆಯುಳ್ಳ /ಒಬ್ಬನ ಸಾಹಾಯ್ಯವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एकः आधारः अवलम्बनं वा यस्य<br><br>

एकाष्टका
एकाष्टका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಘ ಬಹುಳ ಅಷ್ಟಮಿ<br><br>एकाष्टका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಘ ಬಹುಳ ಅಷ್ಟಮಿಯ ದಿನ ಮಾಡಬೇಕಾದ ಶ್ರಾದ್ಧ<br><b>व्युत्पत्तिः - </b>एका अष्टका<br><br>

एकाष्ठील
एकाष्ठील<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಕ ಪುಷ್ಫದ ಗಿಡ /ಕೊಕ್ಕರೆ ಹೂವಿನ ಗಿಡ<br><b>व्युत्पत्तिः - </b>एकोऽष्ठीलो मज्जा यस्य<br><br>

एकाष्ठीला
एकाष्ठीला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗುರು ಶುಂಠಿ<br><b>व्युत्पत्तिः - </b>एकः अष्ठीलो मज्जा यस्याः<br><br>

एकाह
एकाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದಿವಸ<br><b>व्युत्पत्तिः - </b>एकमहः<br><br>एकाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದಿವಸದಲ್ಲಿ ಮಾಡಬಹುದಾದ ಯಾಗ<br><br>

एकाहगम
एकाहगम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದಿನದಲ್ಲಿ ಹೋಗಿ ಸೇರಬಹುದಾದ ದೇಶ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - कर्म० "अप्" निपा० (५-२-१९)<br><b>व्युत्पत्तिः - </b>एकाहेन गम्यते<br><br>

एकाहार
एकाहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದಿನದಲ್ಲಿ ಮಾಡುವ ಒಂದು ಊಟ<br><b>व्युत्पत्तिः - </b>एकस्मिन् दिने एक आहारो भोजनम्<br><br>एकाहार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ದಿನದಲ್ಲಿ ಒಂದು ವೇಳೆ ಊಟಮಾಡುವ<br><b>व्युत्पत्तिः - </b>एक आहारो यस्य<br><br>

एकीकरण
एकीकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದಾಗಿ ಮಾಡುವಿಕೆ /ಚೆದುರಿರುವುದನ್ನು ಒಟ್ಟಾಗಿ ಕೂಡಿಸುವಿಕೆ /ರಾಶಿ ಹಾಕುವಿಕೆ /ಗುಪ್ಪೆ ಮಾಡುವಿಕೆ<br><br>

एकीय
एकीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಪಕ್ಷದಲ್ಲಿರುವ /ಒಂದು ಪಕ್ಷಕ್ಕೆ ಸೇರಿದ<br><b>निष्पत्तिः - </b>एक - "छः" (४-२-११४)<br><br>

एकेक्षण
एकेक्षण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯಸ /ಕಾಗೆ<br><b>व्युत्पत्तिः - </b>एकमीक्षणं यस्य<br><br>एकेक्षण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶುಕ್ರಾಚಾರ್ಯರು<br><br>एकेक्षण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕಣ್ಣುಳ್ಳವನು /ಕುರುಡ<br><br>

एकैक
एकैक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯೇಕವಾದ /ಒಂದೊಂದು<br><b>निष्पत्तिः - </b>एक - वीप्सायां द्विर्भावः (८-१-९)<br><b>प्रयोगाः - </b>"यौवनं धनसम्पत्तिः प्रभुत्वमविवेकिता । एकैकमप्यनर्थाय किमु यत्र चतुष्टयम् ॥" "एकैकमत्र दिवसे दिवसे मदीयं नामाक्षरं गणय गच्छति यावदन्तम्"<br><b>उल्लेखाः - </b>सुभा०, शाकु० ६-१२<br><br>

एकैकशस्
एकैकशस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಂದೊಂದಾಗಿ /ಒಬ್ಬೊಬನಾಗಿ<br><b>निष्पत्तिः - </b>"शस्" (५-४-४३)<br><b>व्युत्पत्तिः - </b>एकमेकमावेदयति<br><b>प्रयोगाः - </b>"एकैकशश्च प्रतिनामग्रहमावेद्यमाना बलाहकेन"<br><b>उल्लेखाः - </b>काद०<br><br>

एकोक्ति
एकोक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಪದದಿಂದ ಹೇಳುವುದು /ಒಂದೇ ಪದದಲ್ಲಿ ೨ ಅರ್ಥಗಳನ್ನು ಕೊಡತಕ್ಕ ಅಭಿಧಾಶಕ್ತಿ<br><b>व्युत्पत्तिः - </b>एका उक्तिः अभिधाशक्तिः<br><b>विस्तारः - </b>"एकयोक्त्या पुष्पवन्तौ दिवाकरनिशाकरौ" - अम० ।<br><br>

एकोच्चय
एकोच्चय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೊಂದು ಹೆಚ್ಚಿಸುವುದು /ಒಂದೊಂದು ಗ್ರಾಸವಾಗಿ ಹೆಚ್ಚಿಸುವಿಕೆ /ಅಮಾವಾಸ್ಯೆಯ ದಿನ ಉಪವಾಸವಿದ್ದು ಪ್ರತಿಪತ್ ಮೊದಲುಗೊಂಡು ಒಂದೊಂದು ಕಬಳವನ್ನು ಹೆಚ್ಚಿಸಿ ಶುಕ್ಲಪಕ್ಷದಲ್ಲಿ ಊಟಮಾಡುವಿಕೆ<br><b>प्रयोगाः - </b>"अमावास्यायामुपोष एकोच्चयेन पूर्वपक्षम्"<br><b>उल्लेखाः - </b>गौतमध० २७-१४<br><br>

एकोत्तर
एकोत्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದೊಂದು ಹೆಚ್ಚುವ /ಒಂದೊಂದು ಅಧಿಕವಾಗುವ<br><b>व्युत्पत्तिः - </b>एकैकमुत्तरं यत्र<br><br>

एकोदक
एकोदक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾಯಾದ /ಏಳನೆಯತಲೆಯಿಂದ ಮುಂದೆ ಹದಿನಾಲ್ಕನೆಯ ತಲೆಯವರೆಗಿನ ಜ್ಞಾತಿ<br><b>व्युत्पत्तिः - </b>एकं समानमुदकं यस्य<br><br>

एकोदर
एकोदर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಗರ್ಭದಲ್ಲಿ ಹುಟ್ಟಿದ ಸಹೋದರ /ಒಬ್ಬ ತಾಯಿಯ ಹೊಟ್ಟೆಯಲ್ಲಿ ಹುಟ್ಟಿದ ಅಣ್ಣತಮ್ಮಂದಿರು<br><b>व्युत्पत्तिः - </b>एकं समानमुदरं गर्भस्थानं यस्य<br><br>एकोदर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾನವಾದ ಉದರ<br><b>व्युत्पत्तिः - </b>एकं समानमुदरम्<br><br>

एकोन
एकोन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕಡಿಮೆಯಾದ<br><b>व्युत्पत्तिः - </b>एकेन ऊनः<br><br>

एकोनचत्वारिंश
एकोनचत्वारिंश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂವತ್ತೊಂದನೆಯ /ಒಂದು ಕಮ್ಮಿ ನಲವತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>"डट्" (५-२-८०)<br><b>व्युत्पत्तिः - </b>एकोनचत्वारिंशतः पूरणः<br><br>

एकोनचन्तारिंशती
एकोनचन्तारिंशती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂವತ್ತೊಂದನೆಯ /ಒಂದು ಕಮ್ಮಿ ನಲವತ್ತೊಂದನೆಯ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

एकोनचत्वारिंशत्
एकोनचत्वारिंशत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂವತ್ತೊಂದನೆಯ /ಒಂದು ಕಮ್ಮಿ ನಲವತ್ತೊಂದನೆಯ<br><b>व्युत्पत्तिः - </b>एकेन ऊना चत्वारिंशत्<br><br>

एकौघ
एकौघ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವಿಚ್ಛಿನ್ನವಾಗಿ ಹರಿಯುವ ಪ್ರವಾಹ /ಒಂದೇ ಸಮನೆ ಹರಿಯುವ ಹೊನಲು<br><b>व्युत्पत्तिः - </b>एकेन अविच्छिन्नः ओघः प्रवाहः<br><b>प्रयोगाः - </b>"एकौघेन स्वर्णपुङ्खैर्द्विषन्तः"<br><b>उल्लेखाः - </b>माघ० १८-५५<br><br>एकौघ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ರಾಶಿ /ಒಂದು ಗುಂಪು<br><b>प्रयोगाः - </b>"एकौघभूतं तदशर्म कृष्णाम्"<br><b>उल्लेखाः - </b>किरा० ३-३५<br><br>

एजक
एजक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕದಲುವ /ಅಲುಗಾಡುವ<br><b>निष्पत्तिः - </b>एजृ (कम्पने) - "ण्वुल्" (३-१-१३३)<br><br>एजक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗುವ<br><br>एजक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕದಲಿಸುವ /ಲುಗಾಡಿಸುವ<br><br>एजक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗಿಸುವ<br><b>निष्पत्तिः - </b>एजृ (कम्पने) + णिच् - "ण्वुल्" (३-१-१३३)<br><br>एजक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಿಸುವ /ಹೊಳೆಯುವ<br><b>निष्पत्तिः - </b>एजृ (दीप्तौ) - "ण्वुल्" (३-१-१३३)<br><br>एजक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸುವ<br><b>निष्पत्तिः - </b>एजृ (दीप्तौ) + णिच् - "ण्वुल्" (३-१-१३३)<br><br>

एजत्
एजत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕದಲುತ್ತಿರುವ /ಅಲುಗಾಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>एजृ (कम्पने) - "शतृ" (३-२-१२४)<br><br>एजत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗುತ್ತಿರುವ<br><br>

एजन्ती
एजन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>एजत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

एजन
एजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕದಲುವಿಕೆ /ಅಲುಗಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>एजृ (कम्पने दीप्तौ च) - "ल्युट्" (३-३-११५)<br><br>एजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಡುಗುವಿಕೆ<br><br>एजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಿಸುವಿಕೆ<br><br>एजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕದಲಿಸುವಿಕೆ /ಅಲುಗಾಡಿಸುವಿಕೆ<br><br>एजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಡುಗಿಸುವಿಕೆ<br><br>एजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>एजृ (कम्पने दीप्तौ च) + णिच् - "ल्युट्" (३-३-११५)<br><br>

एजनीय
एजनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡಿಸಲ್ಪಡುವ /ಕದಲಿಸಲ್ಪಡಬೇಕಾದ<br><br>एजनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸಲ್ಪಡಬೇಕಾದ<br><b>निष्पत्तिः - </b>एजृ (कम्पने दीप्तौ च) + णिच् - "अनीयर्" (३-१-९६)<br><br>

एजमान
एजमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಿಸುತ್ತಿರುವ/ಹೊಳೆಯುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>एजृ (दीप्तौ) - "शानच्" (३-२-१२४)<br><br>एजमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>एजृ (कम्पने) - "शानच्" (३-२-१२४)<br><br>

एजयत्
एजयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡಿಸುತ್ತಿರುವ /ಕದಲಿಸುತ್ತಿರುವ<br><br>एजयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>एजृ (कम्पने दीप्तौ च) + णिच् - "शतृ" (३-२-१२४)<br><br>एजयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಗೊಳಿಸುತ್ತಿರುವ<br><br>

एजयन्ती
एजयन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>एजयत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

एजयमान
एजयमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>एजयत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>एजृ (कम्पने दीप्तौ च) + णिच् - "शानच्" (३-२-१२४)<br><br>

एजयितव्य
एजयितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕದಲಿಸಲ್ಪಡಬೇಕಾದ<br><br>एजयितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗಿಸಲ್ಪಡಬೇಕಾದ<br><br>एजयितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸಲ್ಪಡಬೇಕಾದ<br><br>एजयितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕದಲಿಸಲ್ಪಡಬೇಕಾದ<br><br>एजयितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗಿಸಲ್ಪಡಲು ಶಕ್ಯವಾದ<br><br>एजयितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸಲ್ಪಡಬಹುದಾದ<br><b>निष्पत्तिः - </b>एजृ (कम्पने दीप्तौ च) + णिच् - अर्हादौ "तव्यः"(३-१-९६)<br><br>

एजयितृ
एजयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗಿಸುವ<br><br>एजयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕದಲಿಸುವ<br><br>एजयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಗೊಳಿಸುವ<br><b>निष्पत्तिः - </b>एजृ (कम्पने दीप्तौ च) + णिच् - "तृच्" (३-१-१२४)<br><br>

एजित
एजित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡುವಿಕೆ<br><br>एजित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಡುಗುವಿಕೆ<br><b>निष्पत्तिः - </b>एजृ (कम्पने) - भावे "क्तः" (३-३-११४)<br><br>एजित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗಿಸಲ್ಪಟ್ಟ<br><br>एजित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡಿಸಲ್ಪಟ್ಟ<br><br>एजित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಗೊಳಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>एजृ (कम्पने दीप्तौ च) + णिच् - "क्त्ः" (३-२-१०२)<br><br>

एजितवत्
एजितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗಿದವನು /ಕಂಪನವುಳ್ಳವನು<br><br>एजितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಳೆದವನು /ಪ್ರಕಾಶಿಸಿದವನು<br><b>निष्पत्तिः - </b>एजृ (कम्पने दीप्तौ च) - "क्तवतुः" (३-२-१०२)<br><br>एजितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗಿಸಿದವನು<br><br>एजितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಪಡಿಸಿದವನು<br><b>निष्पत्तिः - </b>एजृ (कम्पने दीप्तौ च) + णिच् - "क्तवतुः" (३-२-१०२)<br><br>

एजितव्य
एजितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡಬೇಕಾದ<br><br>एजितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಿಸಬೇಕಾದ<br><b>निष्पत्तिः - </b>एजृ (कम्पने दीप्तौ च) - "तव्यः" (३-१-९६)<br><br>

एजितृ
एजितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡುವ<br><br>एजितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗುವ<br><br>एजितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಿಸುವ<br><b>निष्पत्तिः - </b>एजृ (कम्पने दीप्तौ च) - "तृच्" (३-१-१३३)<br><br>

एजित्री
एजित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>एजितृ ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

एजृ|कम्पने|एजति
एजृ - कम्पने (भ्वा० पर० अक० से०) एजति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಲುಗು /ಕದಲು<br><br>एजृ - कम्पने (भ्वा० पर० अक० से०) एजति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ನಡುಗು /ಕಂಪಿಸು<br><br>

एजृ|कम्पने|एजति
एजृ - कम्पने + णिच् (भ्वा० पर० अक० से०) एजति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಲುಗಿಸು<br><br>एजृ - कम्पने + णिच् (भ्वा० पर० अक० से०) एजति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ನಡುಗಿಸು/ಕಂಪಿಸುವಂತೆ ಮಾಡು<br><br>

एजृ|दीप्तौ|एजति
एजृ - दीप्तौ (भ्वा० पर० अक० से०) एजति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಿಸು<br><br>

एड
एड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಷ /ಟಗರು<br><b>निष्पत्तिः - </b>आ + इलति + इल (स्वप्ने) - "घः" (३-३-११८)<br><br>एड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿವುಡ /ಕಿವಿ ಕೇಳಿಸದವನು /ಶ್ರವಣೇಂದ್ರಿಯ ಶಕ್ತಿಯಿಲ್ಲದವನು<br><b>निष्पत्तिः - </b>आ = ईट्टे - ईड (स्तुतौ) - "अच्" (३-१-१३४)<br><br>

एडक
एडक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಷ /ಟಗರು<br><b>निष्पत्तिः - </b>इल (स्वप्नक्षेपणयोः) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>इलति<br><br>

एडका
एडका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುರಿ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्" (४-१-४)<br><br>

एडगज
एडगज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಗಸಿಗೆ ಗಿಡ<br><br>

एडमूक
एडमूक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿವುಡ ಮತ್ತು ಮೂಗ /ಕಿವಿಯಿಂದ ಕೇಳಲೂ ಮಾತನಾಡಲೂ ಶಕ್ತಿಯಿಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>एडश्चासौ मूकश्च<br><br>एडमूक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟವನು /ದುಷ್ಟ /ದುರುಳ<br><br>

एडूक
एडूक<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಲುಬುಗಳನ್ನಿಟ್ಟು ನಿರ್ಮಿಸಲ್ಪಟ್ಟ ಗೋಡೆ<br><br>एडूक<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಲುಬುಗಳಂತೆ ಕಠಿಣವಾದ ವಸ್ತುಗಳಿಂದ ನಿರ್ಮಿತವಾದ ಕಟ್ಟಡ<br><b>निष्पत्तिः - </b>ईड (स्तुतौ) - "उकः" (उ० ४-४१)<br><b>विस्तारः - </b>"कुड्यं भित्तिस्तदेडूकमन्तर्निहितकीकसम्" - अभि० चि० ।वैज० ।<br><br>

एण
एण<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಮೃಗ /ಹುಲ್ಲೆ /ಜಿಂಕೆ /ಚಿಗರಿ<br><b>निष्पत्तिः - </b>इण् (गतौ) - "णः" बाहु० ।<br><b>व्युत्पत्तिः - </b>एति<br><b>प्रयोगाः - </b>"एणः स्मरेणाङ्कमयः सपत्राकृतो भवद्भ्रूयुगधन्वना यः" । "अष्टावेणस्य मांसेन रौरवेण नवैव तु"<br><b>उल्लेखाः - </b>नैष० २२-२४, मनु० ३-२६९<br><br>

एणी
एणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಮೃಗ /ಹುಲ್ಲೆ /ಜಿಂಕೆ /ಚಿಗರಿ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>एणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಜಿಂಕೆ<br><b>निष्पत्तिः - </b>"ङीष्" (४-१-६३)<br><b>व्युत्पत्तिः - </b>एणस्य स्त्री<br><br>

एणतिलक
एणतिलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿಲಕದಂತಿರುವ ಜಿಂಕೆಯುಳ್ಳ ಚಂದ್ರ<br><b>व्युत्पत्तिः - </b>एणस्तिलकमिव यस्य<br><b>विस्तारः - </b>"मा ग्लौरिन्दुरेणतिलकौ हरिरोहिणीशौ" - हारा० ।<br><br>

एणजङ्घ
एणजङ्घ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಂಕೆಯಂತೆ ಮೊಣಕಾಲುಳ್ಳವನು /ಓಡುವ ದೂತ /ಓಡಾಳು /ಓಲೆಕಾರ /ಸುದ್ದಿ ಒಯ್ಯುವವನು<br><b>व्युत्पत्तिः - </b>एणस्य जङ्घे इव जङ्घे यस्य<br><br>

एणभृत्
एणभृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೃಗಾಂಕ /ಚಂದ್ರ<br><b>निष्पत्तिः - </b>डुभृञ् (धारणपोषणयोः) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>एणं बिभर्ति<br><br>

एणाक्षी
एणाक्षी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಂಕೆಯಂತೆ ಕಣ್ಣುಳ್ಳ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>"षच्" (५-४-११३) ।"ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>एणस्येवाक्षिणी यस्याः<br><br>

एणाङ्क
एणाङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಂಕೆಯ ಗುರುತುಳ್ಳ ಚಂದ್ರ<br><b>व्युत्पत्तिः - </b>एणोऽङ्को यस्य<br><br>

एणाङ्कमणि
एणाङ्कमणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರಕಾಂತಮಣಿ<br><br>

एणाजिन
एणाजिन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಾಜಿನ /ಜಿಂಕೆಯ ಚರ್ಮ<br><b>व्युत्पत्तिः - </b>एणस्य जिनम्<br><b>प्रयोगाः - </b>"पिशङ्गमौञ्जीयुजमर्जुनच्छविं वसानमेणाजिनमञ्जनद्युति"<br><b>उल्लेखाः - </b>माघ० १-६<br><br>

एणीदृश्
एणीदृश्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಂಕೆಯಂತೆ ಕಣ್ಣುಳ್ಳ ಹೆಂಗಸು<br><b>व्युत्पत्तिः - </b>एण्याः दृगिव दृग् यस्याः<br><br>

एणीनयना
एणीनयना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಂಕೆಯಂತೆ ಕಣ್ಣುಳ್ಳ ಹೆಂಗಸು<br><b>व्युत्पत्तिः - </b>एण्याः नयनमिव नयनं यस्याः<br><br>

एणीनेत्रा
एणीनेत्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಂಕೆಯಂತೆ ಕಣ್ಣುಳ್ಳ ಹೆಂಗಸು<br><b>व्युत्पत्तिः - </b>एण्याः नेत्रे इव नेत्रे यस्याः<br><br>

एणीलोचना
एणीलोचना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಂಕೆಯಂತೆ ಕಣ್ಣುಳ್ಳ ಹೆಂಗಸು<br><b>व्युत्पत्तिः - </b>एण्याः लोचने इव लोचने यस्याः<br><br>

एणीपचन
एणीपचन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಂಕೆಯನ್ನು ಬೇಯಿಸುವ ಒಂದು ದೇಶದಜನರು<br><b>निष्पत्तिः - </b>डुपचष् (पाके) - "ल्युट्" (३-३-११३)<br><b>व्युत्पत्तिः - </b>एणी पच्यते एभिः<br><br>एणीपचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಂಕೆಯನ್ನು ಬೇಯಿಸುವ ದೇಶ<br><b>निष्पत्तिः - </b>डुपचष् (पाके) - अधि० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>एणी पच्यतेऽत्र<br><br>

एणीपचनीय
एणीपचनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಿಂಕೆಯನ್ನು ಬೇಯಿಸುವವರ ದೇಶ<br><b>निष्पत्तिः - </b>"छः" (४-२-७५)<br><b>व्युत्पत्तिः - </b>एणीपचनानां देशः<br><br>

एणीपद
एणीपद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಿಂಕೆಯ ಕಲಿನಂತೆ ಕಾಲುಳ್ಳ<br><b>निष्पत्तिः - </b>निपा० (५-४-१२०)<br><b>व्युत्पत्तिः - </b>एण्या इव पादौ यस्य<br><br>

एत
एत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರವರ್ಣ /ನಾನಾ ಬಣ್ಣ<br><b>निष्पत्तिः - </b>इण् (गतौ) - "तन्" (उ० ३-८६)<br><b>व्युत्पत्तिः - </b>एति वर्णान्<br><br>एत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರ ವರ್ಣಗಳಿಂದಕೂಡಿದ /ನಾನಾಬಣ್ಣಗಳಿಂದ ಕೂಡಿದ<br><br>एत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಂದಿರುವ /ಆಗಮಿಸಿರುವ<br><b>निष्पत्तिः - </b>आ + इण् (गतौ) - "क्तः" (३-४-७२)<br><b>विस्तारः - </b>"एतः कर्बुर आगते" - मेदि० ।<br><br>

एनी|एता 
एनी -एता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>एत ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां वा "ङीप्" तस्य नश्च (४-१-३९)<br><br>

एतद्
एतद्<br><br><b>पदविभागः - </b>त्रिलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳಸಮೀಪದಲ್ಲಿರುವ ಇವನು /ಇವಳು /ಇದು<br><b>निष्पत्तिः - </b>इण् (गतौ) - "अदिः" तुडागमश्च (उ० १-१३०)<br><b>विस्तारः - </b>इदं सर्वनामपदम् । "इदमस्तु सन्निकृष्टं समीपतरवर्ति च एतदो रूपम् । अदसस्तु विप्रकृष्टं तदिति परोक्षेविजानीयात् ॥"<br><br>एतद्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳಸಮೀಪದಲ್ಲಿರುವ ಇವನು<br><b>प्रयोगाः - </b>"एष दाशरथिभूयमेत्य च ध्वंसितोद्धतदशाननामपि । राक्षसीमकृत रक्षितप्रजस्तेजसाधिकविभीषणां पुरीम् ॥" "एते वयममी दाराः कन्येयं कुलजीवितम्"<br><b>उल्लेखाः - </b>माघ० १४-८१, कुमा० ६-६३<br><b>विस्तारः - </b>एषः एतौ एते ।<br><br>एतद्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳಸಮೀಪದಲ್ಲಿರುವ ಇವಳು<br><b>प्रयोगाः - </b>"हला, एषा द्वयोर्युवयोर्ननु हस्ते निक्षेपः" । "एताः सुतनु मुखं तेसख्यः पश्यन्ति हेमकूटगताः"<br><b>उल्लेखाः - </b>शाकु० ४, विक्र० १-१२<br><b>विस्तारः - </b>एषा एते एताः ।<br><br>एतद्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳಸಮೀಪದಲ್ಲಿರುವ ಇದು<br><b>प्रयोगाः - </b>"एतदुच्छ्वसितपीतमैन्दवं वोढुमक्षममिव प्रभारसम्"<br><b>उल्लेखाः - </b>कुमा० ८-७०<br><b>विस्तारः - </b>एतत् एते एतानि ।<br><br>

एतदन्त
एतदन्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಲ್ಲಿಯವರೆಗಿನ /ಇದೇ ಕೊನೆಯಾಗಿ ಉಳ್ಳ<br><b>व्युत्पत्तिः - </b>एतत् अन्तो यस्य<br><b>प्रयोगाः - </b>"एतदन्तास्तु गतयो ब्रह्माद्याः समुदाहृताः"<br><b>उल्लेखाः - </b>मनु० १-५०<br><br>

एतदर्थम्
एतदर्थम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಇದಕ್ಕಾಗಿ /ಇದಕ್ಕೋಸ್ಕರ /ಇವನಿಗಾಗಿ /ಇವಳಿಗಾಗಿ<br><b>व्युत्पत्तिः - </b>एतस्मै एतस्यै वा<br><br>

एतदवधि
एतदवधि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಇಲ್ಲಿಯವರೆಗೆ /ಇಲ್ಲಿಯತನಕ<br><br>

एतदवस्थ
एतदवस्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈ ಸ್ಥಿತಿಯಲ್ಲಿರುವ /ಈ ನೆಲೆಯಲ್ಲಿರುವ /ಈ ರೀತಿಯಲ್ಲಿರುವ<br><b>व्युत्पत्तिः - </b>एषाऽवस्था परिस्थितिर्यस्य<br><b>प्रयोगाः - </b>"सा त्वमिहैतदवस्थं कथं सहेथाश्चिरवियोगम्"<br><b>उल्लेखाः - </b>विक्र० ४-७१<br><br>

एतदादि
एतदादि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇದೇ ಮೊದಲಾದ /ಇದರಿಂದ ಪ್ರಾರಂಭವಾದ<br><b>व्युत्पत्तिः - </b>एतत् आदिर्यस्य<br><br>

एतदीय
एतदीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇವನ/ಇವಳ /ಇದರ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"छः" (४-२-१४)<br><b>व्युत्पत्तिः - </b>एतस्य एतस्या वा इदम्<br><b>प्रयोगाः - </b>"वैलक्ष्यहेतोर्गतिमेतदीयामग्रेऽनुकृत्योपहसन्निवोच्चैः"<br><b>उल्लेखाः - </b>नैष० ३-१०<br><br>

एतद्योनि
एतद्योनि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇದೇ ಮೂಲವಾಗಿ ಉಳ್ಳ /ಇದೇ ಕಾರಣವಾಗಿರುವ<br><b>व्युत्पत्तिः - </b>एषा योनिर्यस्य<br><b>प्रयोगाः - </b>"एतद्योनीति भूतानि सर्वाणीत्युपधारय"<br><b>उल्लेखाः - </b>गीता० ७-६<br><br>

एतर्हि
एतर्हि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಈಗ /ಈ ಕಾಲದಲ್ಲಿ /ಈ ಸಮಯದಲ್ಲಿ<br><b>निष्पत्तिः - </b>इदम् - "र्हिल्" (५-३-१६) । एतादेशः (५-३-४)<br><b>व्युत्पत्तिः - </b>अस्मिन् काले<br><b>प्रयोगाः - </b>"भवन्तमेतर्हि मनस्विगर्हिते विवर्तमानं नरदेव वर्त्मनि"<br><b>उल्लेखाः - </b>किरा० १-३२<br><br>

एतश
एतश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣ<br><b>निष्पत्तिः - </b>इण् (गतौ) - "तशन्" (उ० ३-१४९)<br><br>

एतशस्
एतशस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣ<br><b>निष्पत्तिः - </b>इण् (गतौ) - "तशसुन्" (उ० ३-१४९)<br><br>

एतादृक्ष
एतादृक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇವನಂತಿರುವ /ಇವಳಂತಿರುವ /ಇದರಂತಿರುವ<br><b>निष्पत्तिः - </b>एतद् + दृशिर् (प्रेक्षणे) - "क्सः" (वा० ३-२-५७) । आत्वम् (६-३-९१)<br><b>व्युत्पत्तिः - </b>एष इव एषेव एतदिव वा पश्यति<br><br>

एतादृश्
एतादृश्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇವನಂತಿರುವ /ಇವಳಂತಿರುವ /ಇದರಂತಿರುವ<br><b>निष्पत्तिः - </b>"क्विन्" (३-२-६०)<br><br>

एतादृशी
एतादृशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇವಳಂತಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

एतादृश
एतादृश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇವನಂತಿರುವ /ಇವಳಂತಿರುವ /ಇದರಂತಿರುವ<br><b>निष्पत्तिः - </b>"कञ्" (३-२-६०)<br><br>

एतावत्
एतावत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟು /ಇಷ್ಟು ದೊಡ್ಡದಾದ /ಇಷ್ಟು ಗಾತ್ರದ<br><b>निष्पत्तिः - </b>"वतुप्" (५-२-३९)<br><b>व्युत्पत्तिः - </b>एतत् परिमाणमस्य<br><b>प्रयोगाः - </b>"एतावता नन्वनुमेयशोभि कञ्चीगुणस्थानमनिन्दितायाः" । "एतावज्जन्मसाफल्यं यदनायत्तवृत्तिना"<br><b>उल्लेखाः - </b>कुमा० १-३७, हितो० २-२२<br><br>

एतावती
एतावती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಷ್ಟು /ಇಷ್ಟು ದೊಡ್ಡದಾದ /ಇಷ್ಟು ಗಾತ್ರದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

एदिधिषण
एदिधिषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದುವ ಅಪೇಕ್ಷೆ /ಅಭಿವೃದ್ಧಿ ಹೊಂದಲು ಆಸೆ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) + सन् - भावे "ल्युट्" (३-३-११५)<br><br>

एदिधिषमाण
एदिधिषमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದಲು ಅಪೇಕ್ಷಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) + सन् - "शानच्" - (३-२-१२४)<br><br>

एदिधिषा
एदिधिषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದಲು ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) + सन् - "अः" (३-३-१०३)<br><b>व्युत्पत्तिः - </b>एधितुमिच्छा<br><br>

एदिधिषित
एदिधिषित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದುವ ಅಪೇಕ್ಷೆ /ಅಭಿವೃದ್ಧಿ ಹೊಂದಲು ಆಸೆ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) + सन् - भावे "क्तः" (३-३-११४)<br><br>एदिधिषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದಲು ಅಪೇಕ್ಷಿಸುವ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) + सन् - कर्त० "क्तः" (३-४-७२)<br><br>

एदिधिषितवत्
एदिधिषितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದಲು ಅಪೇಕ್ಷಿಸಿದ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) + सन् - "क्तवतुः" (३-२-१०२)<br><br>

एदिधिषितवती
एदिधिषितवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದಲು ಅಪೇಕ್ಷಿಸಿದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

एदिधिषितृ
एदिधिषितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದಲು ಅಪೇಕ್ಷಿಸುವ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) + सन् - "तृच्" (३-१-१३३)<br><br>

एदिधिषित्री
एदिधिषित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದಲು ಅಪೇಕ್ಷಿಸುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

एदिधिषु
एदिधिषु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದಲು ಅಪೇಕ್ಷಿಸುವ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) + सन् - "उः" (३-२-१६८)<br><br>

एध|वृद्धौ|एधते
एध - वृद्धौ (भ्वा० आत्म० अक० से०) एधते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದು<br><br>

एध
एध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೌದೆ /ಕಟ್ಟಿಗೆ<br><b>निष्पत्तिः - </b>ञि इन्धी (दीप्तौ) - कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>इध्यतेऽनेन<br><b>प्रयोगाः - </b>"स्फुलिङ्गावस्थया वह्निरेधापेक्ष इव स्थितः"<br><b>उल्लेखाः - </b>शाकु० ७-१५<br><br>

एधतु
एधतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುರುಷ /ಮನುಷ್ಯ<br><br>एधतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) - "चतुः" (उ० १-७८)<br><b>विस्तारः - </b>"एधतुः पुरुषेऽग्नौ ना" - मेदि० ।<br><br>एधतु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದಿದ<br><br>

एधन
एधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೃದ್ಧಿಯಾಗುವಿಕೆ /ಬೆಳೆಯುವಿಕೆ /ಹೆಚ್ಚಾಗುವಿಕೆ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) - भावे "ल्युट्" (३-३-११५)<br><br>एधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೃದ್ಧಿಪಡಿಸುವಿಕೆ /ಹೆಚ್ಚುವಿಕೆ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) + णिच् - भावे "ल्युट्" (३-३-११५)<br><br>

एधनीय
एधनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದಬೇಕಾದ /ಹೆಚ್ಚಬೇಕಾದ /ಬೆಳೆಯಬೇಕಾದ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) -"अनीयर्" (३-१-९६)<br><br>एधनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೃದ್ಧಿಪಡಿಸಲ್ಪಡಬೇಕಾದ /ಹೆಚ್ಚಿಸಲ್ಪಡಬೇಕಾದ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) + णिच् -"अनीयर्" (३-१-९६)<br><br>

एधमान
एधमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದುತ್ತಿರುವ /ಬೆಳೆಯುತ್ತಿರುವ /ಹೆಚ್ಚುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) - "शानच्" (३-२-१२४)<br><br>

एधयत्
एधयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದಿಸುತ್ತಿರುವ /ಬೆಳೆಸುತ್ತಿರುವ /ಹೆಚ್ಚಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) + णिच् - "शतृ" (३-२-१२४)<br><br>

एधयन्ती
एधयन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದಿಸುತ್ತಿರುವ /ಬೆಳೆಸುತ್ತಿರುವ /ಹೆಚ್ಚಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

एधयमान
एधयमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದಿಸುತ್ತಿರುವ /ಬೆಳೆಸುತ್ತಿರುವ /ಹೆಚ್ಚಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) + णिच् - "शानच्" (३-२-१२४)<br><br>

एधयमाना
एधयमाना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದಿಸುತ್ತಿರುವ /ಬೆಳೆಸುತ್ತಿರುವ /ಹೆಚ್ಚಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्" (४-१-४)<br><br>

एधयितव्य
एधयितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿಪಡಿಸಲ್ಪಡಬೇಕಾದ /ಹೆಚ್ಚಿಸಲ್ಪಡಬೇಕಾದ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) + णिच् - "तव्यः" (३-१-९६)<br><br>

एधयितृ
एधयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಪಡಿಸುವ /ಹೆಚ್ಚಿಸುವ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) + णिच् - "तृच्" (३-१-१३३)<br><br>

एधयित्री
एधयित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಪಡಿಸುವ /ಹೆಚ್ಚಿಸುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

एधस्
एधस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌದೆ /ಕಟ್ಟಿಗೆ<br><b>निष्पत्तिः - </b>ञि इन्धी (दीप्तौ) - "असुन्" (उ० ४-१८८)<br><b>व्युत्पत्तिः - </b>इध्यतेऽग्निरनेन<br><b>प्रयोगाः - </b>"यथैधांसि समिद्धोऽग्निर्भस्मसात्कुरुतेऽर्जुन"<br><b>उल्लेखाः - </b>गीता० ४-३७<br><br>

एधित
एधित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದುವಿಕೆ /ಹೆಚ್ಚುವಿಕೆ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) - भावे "क्तः" (३-३-११४)<br><br>एधित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದಿದ /ಹೆಚ್ಚಾದ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) - कर्त० "क्तः" (३-४-७२)<br><br>एधित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದಿಸಲ್ಪಟ್ಟ /ಹೆಚ್ಚಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) + णिच् - कर्म० "क्तः" (३-२-१०२)<br><br>

एधितवत्
एधितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದಿದ /ಬೆಳೆದ /ಹೆಚ್ಚಾದ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) - कर्त० "क्तवतुः" (३-२-१०२)<br><br>एधितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಿಸಿದ /ಅಭಿವೃದ್ಧಿ ಹೊಂದಿಸಿದ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) + णिच्- कर्त० "क्तवतुः" (३-२-१०२)<br><br>

एधितवती
एधितवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>एधितवत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

एधितव्य
एधितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದಬೇಕಾದ /ಬೆಳೆಯಬೇಕಾದ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) - "तवुअः"(३-१-९६)<br><br>

एधितृ
एधितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದುವ /ಬೆಳೆಯುವ<br><b>निष्पत्तिः - </b>एध (वृद्धौ) - "तृच्" (३-१-१३३)<br><br>

एधित्री
एधित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿವೃದ್ಧಿ ಹೊಂದುವ /ಬೆಳೆಯುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

एनस्
एनस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><b>निष्पत्तिः - </b>इण् (गतौ) - "असुन्" (उ० ४-१८८)<br><b>व्युत्पत्तिः - </b>एति गच्छति प्रायश्चित्तेन<br><b>प्रयोगाः - </b>"प्रतिपत्तिरधःकृतैनसो जनताभिस्तव साधु वर्ण्यते"<br><b>उल्लेखाः - </b>माघ० १६-८<br><br>एनस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪರಾಧ /ತಪ್ಪು<br><br>

एनस्वत्
एनस्वत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪಾತ್ಮ /ಪಾಪದಿಂದ ಕೂಡಿದ<br><br>एनस्वत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪರಾಧಿ /ತಪ್ಪು ಮಾಡಿದವನು<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४) । मस्य वः (८-२-९)<br><b>व्युत्पत्तिः - </b>एनोऽस्यास्ति<br><br>

एनस्विन्
एनस्विन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>एनस्वत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"विनिः" (५-२-१२१)<br><br>

एनस्विनी
एनस्विनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>एनस्वत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

एरङ्ग
एरङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಮೀನು<br><b>निष्पत्तिः - </b>आ +ईर (गतौ) - "अङ्गच्" (उ० १-११७)<br><br>

एरण्ड
एरण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹರಳು ಗಿಡ<br><b>निष्पत्तिः - </b>ईर (गतौ) + णिच्- "अण्डच्" बाहु० ।<br><b>व्युत्पत्तिः - </b>ईरयति वायुं मलं वाऽधः<br><b>प्रयोगाः - </b>"निरस्तपादपे देशे एरण्डोऽपि द्रुमायते"<br><br>

एर्वारु
एर्वारु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೌತೆಗಿಡ<br><b>निष्पत्तिः - </b>आ + ईर (गतौ) - "क्विप्" (वा० ३-३-१०८) । वृञ् (वरणे) - "उण्" बाहु० ।<br><b>व्युत्पत्तिः - </b>ईरं वारयति<br><b>प्रयोगाः - </b>"एर्वारुबीजं तोयेन पिबेद्वा लवणीकृतम्"<br><br>

एलवालु|एलावालु
एल(ला)वालु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುರಸುರಕೆ ಗಿಡ<br><b>निष्पत्तिः - </b>वल (सञ्चलने) - "उण्" बाहु० ।<br><b>व्युत्पत्तिः - </b>एलेन वलते<br><br>

एलवालुक
एलवालुक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುರಸುರಕೆ ಗಿಡ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्" (५-३-७५)<br><br>

एला
एला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಲಕ್ಕಿ ಗಿಡ<br><b>निष्पत्तिः - </b>इल (प्रेरणे) + णिच् - "अच्" (३-१-१३४)<br><b>प्रयोगाः - </b>"ससञ्जुरश्वक्षुण्णानामेलानामुत्पतिष्णवः"<br><b>उल्लेखाः - </b>रघु० ४-४७<br><br>

एलापर्णी
एलापर्णी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣರಾಶ್ಮೆ<br><b>व्युत्पत्तिः - </b>एलायाः पर्णमिव पर्णमस्याः<br><b>विस्तारः - </b>"एलापर्णी तु सुवहा रास्ना युक्तरसा च सा" - अम० ।<br><br>

एव
एव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅವಧಾರಣ /ನಿಶ್ಚಯ<br><b>विस्तारः - </b>ಈ ಅವಧಾರಣವು अन्ययोगव्यवच्छेदः, अयोगव्यवच्छेदः, अत्यन्तायोगव्यवच्छेदः ಎಂದು ೩ ವಿಧ. "पार्थ एव धनुर्धरः" ಎಂಬಲ್ಲಿ एवವು ಪಾರ್ಥೇತರನಲ್ಲಿ ಪ್ರಶಸ್ತ ಧನುರ್ಧರತ್ವವವನ್ನು ವ್ಯವಚ್ಛೇದ ಮಾಡುವುದು. "शङ्खः पाण्डुर एवಎಂಬಲ್ಲಿ ವು ಶಂಖಸಾಮಾನ್ಯದಲ್ಲೂ ಪಾಂಡುರತ್ವಾಯೋಗವ್ಯವಚ್ಛೇದವನ್ನು ಮಾಡುವುದು. "नीलं सरोजं भव्त्येव" ಎಂಬಲ್ಲಿ ಕ್ರಿಯೆಯೊಡನೆ ಸೇರಿಸುವ एवವು ಸರೋಜದಲ್ಲಿ ನೀಲತ್ವಾತ್ಯಂತಾಯೋಗವ್ಯವಚ್ಛೇದವನ್ನು ತಿಳಿಸುವುದು.<br><br>एव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಾದೃಶ್ಯ /ಹೋಲಿಕೆ /ಸಾಮ್ಯ<br><br>एव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅದು ಮಾತ್ರ /ಅವನು ಮಾತ್ರ/ಅವಳು ಮಾತ್ರ<br><b>प्रयोगाः - </b>"एक एव वसु यद्ददौ नृपस्तत्समापकमतर्क्यत क्रतोः"<br><b>उल्लेखाः - </b>माघ० १४-४०<br><br>एव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆ ಕೂಡಲೆ /ಆ ಸಮಯದಲ್ಲೇ<br><b>प्रयोगाः - </b>"उपस्थितेयं कल्याणी नाम्नि कीर्तित एव यत्"<br><b>उल्लेखाः - </b>रघु० १-८७<br><br>एव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅದೇ /ನಿಜವಾಗಿಯೂ ಹಾಗೆಯೇ<br><br>एव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಸಂಭವ /ಸಾಧ್ಯವಾಗದಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"क्वेव भोक्ष्यसे"<br><br>

एवङ्गुण
एवङ्गुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈ ರೀತಿಯಾದ ಗುಣ<br><b>प्रयोगाः - </b>"पत्रमेवङ्गुणोपेतं चक्रवर्तिनमाप्नुहि"<br><b>उल्लेखाः - </b>शाकु० १-१२<br><br>एवङ्गुण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈ ರೀತಿಯಾದಗುಣವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एवं गुणाः यस्य<br><br>

एवम्प्रकार|एवम्प्राय
एवम्प्रकार -प्राय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈ ತೆರನಾದ /ಈ ರೀತಿಯಾದ /ಈ ವಿಧವಾದ<br><b>प्रयोगाः - </b>"प्रबलतमसामेवम्प्रायाः शुभेषु प्रवृत्तयः स्रजमपि शिरस्यन्धः क्षिप्तं धुनोत्यहिशङ्कया"<br><b>उल्लेखाः - </b>शाकु० ७-२४<br><br>

एवंरूप
एवंरूप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈ ರೂಪವುಳ್ಳ /ಈ ಆಕೃತಿಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>एवं रूपं यस्य<br><b>प्रयोगाः - </b>"न वेदयज्ञाध्ययनैर्न दानैर्न च क्रियाभिर्न तपोभिरुग्रैः । एवंरूप शक्य अहं नृलोके द्रष्टुं त्वदन्येन कुरुप्रवीर ॥"<br><b>उल्लेखाः - </b>गीता० ११-४८<br><br>

एवंविध
एवंविध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈ ವಿಧವಾದ /ಈ ತೆರನಾದ /ಹೀಗಿರುವ<br><b>व्युत्पत्तिः - </b>एवं विधा प्रकारो यस्य<br><b>प्रयोगाः - </b>"भक्त्यात्वदन्यया शक्य अहमेवंविधोऽर्जुन । ज्ञातुं द्रष्टुं च तत्त्वेन प्रवेष्टुं च परन्तप ॥"<br><b>उल्लेखाः - </b>गीता० ११-५४<br><br>

एवम्
एवम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಈ ರೀತಿಯಾಗಿ /ಈ ಪ್ರಕಾರವಾಗಿ<br><b>प्रयोगाः - </b>"एवं मया नियमितश्च्यवनादिवाक्यैः कोपानलश्च परशुश्च पुनर्यथैतौ "<br><b>उल्लेखाः - </b>म० वी० ३-१५<br><br>एवम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಹುದು /ಹಾಗೆಯೇ /ಅದೇ ಸರಿ<br><b>प्रयोगाः - </b>"एवं यदात्थ भगवन्नामृष्टं नः परैः पदम्"<br><b>उल्लेखाः - </b>कुमा० २-३१<br><br>एवम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯ<br><b>प्रयोगाः - </b>"एवमेतत् कः सन्देहः"<br><br>एवम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ /ಒಪ್ಪಿಗೆ /ಸಮ್ಮತಿ<br><b>प्रयोगाः - </b>"एवं कुर्मः"<br><br>एवम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಾದೃಶ್ಯ /ಹೋಲಿಕೆ /ಸಾಮ್ಯ<br><b>प्रयोगाः - </b>"अग्निरेवं विप्रः"<br><br>एवम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಾಕ್ಯಪೂರಣ<br><br>एवम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಜವಾಗಿಯೂ /ವಾಸ್ತವವಾಗಿಯೂ<br><br>

एष
एष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರಿಯುವಿಕೆ /ಚಲಿಸುವಿಕೆ<br><br>एष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಮನ /ಹೋಗುವಿಕೆ<br><br>एष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆ /ಇಚ್ಛೆ<br><b>निष्पत्तिः - </b>इष (गतौ) इषु (इच्छायाम्) वा - "घञ्" (३-३-२८)<br><br>

एषक
एषक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸರಿಯುವ /ಚಲಿಸುವ<br><br>एषक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಗುವವನು<br><b>निष्पत्तिः - </b>इष (गतौ) - "ण्वुल्" (३-१-१३३)<br><br>एषक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸುವ /ಇಚ್ಛಿಸುವ<br><b>निष्पत्तिः - </b>इषु (इच्छायाम्) - "ण्वुल्" (३-१-१३३)<br><br>

एषण
एषण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೋಹದ ಬಾಣ<br><b>व्युत्पत्तिः - </b>एषते शत्रुहृदयम्<br><b>विस्तारः - </b>"एषणश्चायसे शरे" - वैज० ।<br><br>एषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸುವಿಕೆ /ಬಯಸುವಿಕೆ<br><b>निष्पत्तिः - </b>इषु (इच्छायाम्) - "ल्युट्" (३-३-११५)<br><br>एषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೋಗುವಿಕೆ /ನಡೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>इष (गतौ) - "ल्युट्" (३-३-११५)<br><br>

एषणा
एषणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ವೇಷಣೆ /ಹುಡುಕುವಿಕೆ<br><b>निष्पत्तिः - </b>इष (गतौ) - भावे "युच्" (वा० ३-३-१०७)<br><br>एषणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊತ್ತುಂಬರಿ<br><b>विस्तारः - </b>"कुमारी मुसली वंश्या गडूची कटुकैषणा" - वैज० ।<br><br>

एषणी
एषणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ಕಸಾಲಿಗನ ತಕ್ಕಡಿ<br><br>

एषणिका
एषणिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ಕಸಾಲಿಗನ ತಕ್ಕಡಿ<br><br>

एषणीय
एषणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಡಬಹುದಾದ /ಆಸೆ ಪಡಬಹುದಾದ<br><b>निष्पत्तिः - </b>इषु (इच्छायाम्) - कर्म० "अनीयर्"(३-१-९६)<br><b>प्रयोगाः - </b>"जायापती लैकिकमेषणीयमद्राक्षतारोपणमन्वभूताम्"<br><b>उल्लेखाः - </b>कुमा० ७-८८<br><br>एषणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಗಬೇಕಾದ /ಸೇರಬೇಕಾದ /ತಲುಪಬೇಕಾದ<br><br>

एषितव्य
एषितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>एषणीय ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>इष (गतौ) - कर्म० "अनीयर्"(३-१-९६)<br><br>

एषितृ
एषितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>एषक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>इष (गतौ) इषु (इच्छायाम्) वा - "तृच्" (३-१-१३३)<br><br>

एषिन्
एषिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>एषक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>इष (गतौ) इषु (इच्छायाम्) वा - "णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"शैशवेऽभस्तविद्यानां यैवने विषयैषिणाम्"<br><b>उल्लेखाः - </b>रघु० १-६<br><br>एषिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಲುಪುವ /ಹೊಂದುವ /ಸೇರುವ<br><b>निष्पत्तिः - </b>इष (गतौ) - "णिनिः" (३-१-१३४)<br><br>

एषिषिका
एषिषिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೋಗಲು ಅಪೇಕ್ಷೆ<br><br>एषिषिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಂದಲು ಅಪೇಕ್ಷೆ /ತಲುಪಲು ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>इष (गतौ) + सन् - "अः" (३-३-१०२)<br><br>

एषिषुषु
एषिषुषु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಗಲು ಅಪೇಕ್ಷಿಸುವ<br><br>एषिषुषु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲು ಅಪೇಕ್ಷೆಯುಳ್ಳ /ತಲುಪಲು ಇಚ್ಛೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>इष (गतौ) + सन् - "उः" (३-२-१६८)<br><br>

एष्टव्य
एष्टव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಡುವ /ಅಪೇಕ್ಷಿಸಬೇಕಾದ<br><b>निष्पत्तिः - </b>इषु (इच्छायाम्) - कर्म० "तव्यः" (३-१-९६)<br><b>प्रयोगाः - </b>"एष्टव्या बहवः पुत्राः यद्येकोऽपि गयां व्रजेत्"<br><b>उल्लेखाः - </b>मत्स्यपु०<br><br>

एष्टि
एष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಚ್ಛೆ /ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>आ + इषु (इच्छायाम्) - "क्तिन्" (३-३-९४)<br><br>

एष्य
एष्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಶಸ್ತ್ರ ಚಿಕಿತ್ಸೆ<br><b>निष्पत्तिः - </b>इषु (इच्छायाम्) - "ण्यत्" (३-१-१२४)<br><br>एष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಡುವ<br><br>एष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಲುಪಲ್ಪಡುವ /ಸೇರಲ್ಪಡುವ<br><br>एष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೈದ್ಯಪರೀಕ್ಷೆ ಮಾಡಲ್ಪಡುವ<br><br>एष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದೆ ಬರಬಹುದಾದ /ಮುಂದೆ ಒದಗಬಹುದಾದ /ಭವಿಷ್ಯತ್ಕಾಲದ<br><br>

एष्यत्
एष्यत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದಿನ ಕಾಲದ /ಭವಿಷ್ಯತ್ತಿನ /ಮುಂದೆ ಒದಗಬಹುದಾದ<br><b>निष्पत्तिः - </b>इष (गतौ) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"हरत्यघं सम्प्रति हेतुरेष्यतः"<br><b>उल्लेखाः - </b>माघ० १-२६<br><br>

एष्यन्ती
एष्यन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂದಿನ ಕಾಲದ /ಭವಿಷ್ಯತ್ತಿನ /ಮುಂದೆ ಒದಗಬಹುದಾದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

ऐ
ऐ<br><br><b>कन्नडार्थः - </b>ಐಕಾರ<br><b>विस्तारः - </b>ಇದು ಕಂಠ ಮತ್ತು ತಾಲುಸ್ಥಾನಗಳಲ್ಲಿ ವಿವೃತಪ್ರಯತ್ನದಿಂದ ಹುಟ್ಟುವ ಒಂದು ಸ್ವರವರ್ಣ. ಉದಾತ್ತ ಅನುದಾತ್ತ ಮತ್ತು ಸ್ವರಿತಗಳೆಂಬ ೩ ಭೇದಗಳುಳ್ಳ ಈ ವರ್ಣವು ಅನುನಾಸಿಕ ಮತ್ತು ಅನನುಸಾಸಿಕಗಳೆಂಬ ಭೇದದಿಂದ ಒಟ್ಟು ೬ ವಿಧವಾಗುವುದು.<br><br>ऐ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಿಕ್ಕು<br><br>ऐ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಸ್ತ /ಕೈ<br><br>ऐ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><br>ऐ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತದ ಶಿಖರ /ಬೆಟ್ಟದ ತುದಿ<br><br>ऐ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚರ್ಮ /ತೊಗಲು<br><b>विस्तारः - </b>"ऐकारो दिङ्मुखे हस्ते हरेऽद्रिशिखरे त्वचि" - नानार्थर० ।<br><br>ऐ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಹ್ವಾನ /ಕರೆ<br><br>ऐ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸ್ಮೃತಿ /ನೆನಪು<br><br>ऐ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಬೋಧನೆ<br><b>विस्तारः - </b>"ऐ शब्दो दृश्यते हूतौ स्मृत्यामन्त्रणयोरपि" - मेदि० ।<br><br>

ऐककण्ठ्य
ऐककण्ठ्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾನಾಭಿಪ್ರಾಯ /ವಿರೋಧವಿಲ್ಲದ ಒಂದೇ ಅಭಿಪ್ರಾಯ<br><br>

ऐकध्यम्
ऐकध्यम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಂದುವಿಧವಾಗಿ /ಒಂದು ಪ್ರಕಾರವಾಗಿ<br><b>निष्पत्तिः - </b>एक + धा - "ध्यमुञ्" (५-३-४४)<br><br>

ऐकपत्य
ऐकपत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾರ್ವಭೌಮತ್ವ /ದೇಶಕ್ಕೆಲ್ಲಾ ಒಬ್ಬನೇ ರಾಜನಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>एकपतेर्भावः<br><b>प्रयोगाः - </b>"अप्रतिद्वन्द्वतां युद्धे ऐकपत्यं च देहिनाम्"<br><b>उल्लेखाः - </b>भाग० ७-३-३७<br><br>ऐकपत्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಯಜಮಾನನಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>एकपति - "ण्यः" (४-१-८५)<br><b>व्युत्पत्तिः - </b>एकपतौ भवम्<br><br>

ऐकपदिक
ऐकपदिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದುಪದಕ್ಕೆ ಸಂಬಂಧಿಸಿದ /ಒಂದು ಪದದಲ್ಲಿರುವ<br><b>व्युत्पत्तिः - </b>एकस्मिन् पदे भवः<br><br>ऐकपदिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಸ್ಥಾನದಲ್ಲಿರುವ<br><b>व्युत्पत्तिः - </b>एकस्मिन् पदे स्थाने भवः<br><br>ऐकपदिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಪದಕ್ಕೆ ಅಥವಾ ಸ್ಥಾನಕ್ಕೆ ಸಮಾನಾರ್ಥವಾದ<br><b>निष्पत्तिः - </b>एकपद - "ठञ्" (५-१-१०१)<br><br>

ऐकपद्य
ऐकपद्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಪದವಾಗಿರುವಿಕೆ /ಅನೇಕ ಪದಗಳು ಸಮಾಸ ಹೊಂದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>एकपदस्य भावः<br><br>

ऐकमत्य
ऐकमत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾನವಾದ ಒಪ್ಪಿಗೆ /ಏಕವಿಧವಾದ ಸಮ್ಮತಿ /ಭಿನ್ನಾಭಿಪ್ರಾಯವಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>एकं समानं मतमभिप्रायः, तस्य भावः<br><b>प्रयोगाः - </b>"ऐकमत्यं हि नो राजन् सर्वेषामेव लक्षये"<br><b>उल्लेखाः - </b>भा० वन० ७-१२<br><br>

ऐकराज्य
ऐकराज्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾರ್ವಭೌಮತ್ವ /ಏಕಚಕ್ರಾಧಿಪತ್ಯ /ದೇಶಕ್ಕೆಲ್ಲಾ ಒಬ್ಬನೇ ರಾಜನಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>एको राट्, एकराजो भावः<br><br>

ऐकरूप्य
ऐकरूप्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಧವಾಗಿರುವಿಕೆ /ಒಂದೇ ಪ್ರಕಾರವಾಗಿರುವಿಕೆ<br><br>

ऐकशतिक
ऐकशतिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಶತಮಾನವಿರುವ /ಒಂದು ನೂರನ್ನು ಹೊಂದಿರುವ<br><b>निष्पत्तिः - </b>"ठञ्" (५-२-११८)<br><b>व्युत्पत्तिः - </b>एकशतमस्यास्ति<br><br>

ऐकशफ
ऐकशफ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಗೊರಸುಳ್ಳ ಪ್ರಾಣಿಯ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>एकशफस्येदम्<br><b>प्रयोगाः - </b>"अनिर्दशाया गौःक्षीरमौष्ट्रमैकशफं तथा"<br><b>उल्लेखाः - </b>मनु० ५-८<br><br>

ऐकश्रुत्य
ऐकश्रुत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಸ್ವರ /ಉದಾತಾನುದಾತ್ತಸ್ವರಿತಗಳ ಸಮೀಪಸಂಬಂಧ /ಎಲ್ಲಾ ಸ್ವರಗಳೂ ಒಂದೇ ಶ್ರುತಿಯಂತೆ ಕೂಡಿಕೊಂಡಿರುವಿಕೆ<br><b>विस्तारः - </b>"उदात्तानुदात्तस्वरितानां परःसन्निकर्षः ऐकश्रुत्यम्" - आश्व० श्रौ० सू० १-२-९<br><br>ऐकश्रुत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೈವಿಧ್ಯವಿಲ್ಲದ ಒಂದೇ ರಾಗ /ಒಂದೇ ಧ್ವನಿ<br><b>निष्पत्तिः - </b>"ष्यञ्" (वा० ५-१-१२४)<br><b>व्युत्पत्तिः - </b>एका श्रुतिर्यत्र, तस्य भावः<br><br>

ऐकसहस्रिक
ऐकसहस्रिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಸಾವಿರವುಳ್ಳ<br><b>निष्पत्तिः - </b>"ठञ्" (५-२-११८)<br><b>व्युत्पत्तिः - </b>एकसहस्रमस्यास्ति<br><br>

ऐकागारिक
ऐकागारिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೋರ /ಕಳ್ಳ<br><b>निष्पत्तिः - </b>"इकट्" (५-१-११३)निपा० ।<br><b>व्युत्पत्तिः - </b>एकमसहायमगारं प्रयोजनमस्य<br><b>प्रयोगाः - </b>"ऐकागारिकवद्भूमौ दूराज्जग्मुरदर्शनम्"<br><b>उल्लेखाः - </b>माघ० १९-१११<br><b>विस्तारः - </b>ಕಳ್ಳನು ತನ್ನ ಕಳ್ಳತನವು ಮತ್ತಾರಿಗೂ ತಿಳಿಯದಿರಲು ಸಮೀಪದಲ್ಲಿ ಮನೆಗಳಿಲ್ಲದ ಪ್ರತ್ಯೇಕವಾದ ಮತ್ತು ಅಸಹಾಯವಾದ ಮನೆಯನ್ನು ಮಾತ್ರ ಅಪೇಕ್ಷಿಸುವುದರಿಂದ ಈ ಹೆಸರು.<br><br>

ऐकाग्र्य
ऐकाग्र्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಏಕಾಗ್ರತೆ /ಚಿತ್ತವನ್ನು ಒಂದೇ ವಿಷಯದಲ್ಲಿಟ್ಟಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>एकाग्रस्य भावः<br><br>

ऐकात्म्य
ऐकात्म्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಐಕ್ಯ /ಒಂದಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>एक एवात्मा यस्य, तस्य भावः<br><br>ऐकात्म्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜೀವಾತ್ಮನು ಪರಮಾತ್ಮನೊಡನೆ ಒಂದಾಗಿರುವಿಕೆ /ಜೀವಬ್ರಹ್ಮರು ಒಂದೇ ಆಗಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"तथैकात्म्यानुभावानां विकल्परहितः स्वयम्"<br><b>उल्लेखाः - </b>भाग० ६-८-३२<br><br>ऐकात्म्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭೇದ<br><b>प्रयोगाः - </b>"ऐकात्म्यं वासुदेवस्य प्रोक्तवानर्जुनस्य च"<br><b>उल्लेखाः - </b>भा० आदि० २-२३१<br><br>

ऐकाधिकरण्य
ऐकाधिकरण्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಅಧಿಕರಣದಲ್ಲಿರುವಿಕೆ /ಸಮಾನವಾದ ಆಧಾರವದಲ್ಲಿರುವುದು<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>एकं समानमधिकरणं यस्य, तस्य भावः<br><b>प्रयोगाः - </b>"साध्येन हेतोरैकाधिकरण्यं व्याप्तिरुच्यते"<br><b>उल्लेखाः - </b>भाषाप०<br><br>ऐकाधिकरण्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ವಿಷಯದಲ್ಲಿ ಸೇರಿಕೊಂಡಿರುವಿಕೆ<br><br>

ऐकान्तिक
ऐकान्तिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಶ್ಯವಾಗಿ ಆಗಬೇಕಾದ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-८०)<br><b>व्युत्पत्तिः - </b>अवश्यं भावी<br><br>ऐकान्तिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಿತವಾದ/ನಿರ್ದಿಷ್ಟವಾದ /ಭರವಸೆಯಾದ<br><br>

ऐकान्तिकी
ऐकान्तिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ऐकान्तिक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><b>प्रयोगाः - </b>"बहुषु अभियोगकारणेषु सत्सु सचिवच्यसनमभियुञ्जानस्य शत्रुमभियोक्तुः नैकान्तिकी सिद्धिर्भवति"<br><b>उल्लेखाः - </b>मुद्रा०<br><br>

ऐकान्त्य
ऐकान्त्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಿಪೂರ್ಣವಾಗಿರುವಿಕೆ<br><br>ऐकान्त्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಏಕಾಂತವಾಗಿರುವಿಕೆ<br><br>ऐकान्त्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯವಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>एकान्तस्य भावः<br><br>

ऐकार्थ्य
ऐकार्थ्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಪ್ರಯೋಜನವಾಗಿರುವಿಕೆ /ಒಂದು ಕಾರ್ಯವಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>एकर्थस्य भावः<br><b>प्रयोगाः - </b>"बीजवन्तो मुखाद्यर्था विप्रकीर्णा यथायथम् । ऐकार्थ्यमुपनीयन्ते यत्र निर्वहणं हि तत् ॥"<br><b>उल्लेखाः - </b>दशरू०<br><br>ऐकार्थ्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಅರ್ಥವಗಿರುವಿಕೆ<br><br>

ऐकाहिक
ऐकाहिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದಿವಸ ಸತ್ಕರಿಸಿ ಪ್ರೇರಿಸಲ್ಪಟ್ಟ ಉಪಾಧ್ಯಾಯ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-८०)<br><b>व्युत्पत्तिः - </b>एकाहमधीष्टः सत्कृत्य व्यापारितः<br><br>ऐकाहिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದಿವಸ ಸಾಕಲ್ಪಟ್ಟ ಸೇವಕ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-८०)<br><b>व्युत्पत्तिः - </b>एकाहं भृतः<br><br>ऐकाहिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದಿ ದಿವಸ ಬಂದ ಜ್ವರ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-८०)<br><b>व्युत्पत्तिः - </b>एकाहं भूतः<br><br>ऐकाहिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದಿವಸ ನಡೆಯಲಿರುವ ಉತ್ಸವ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-८०)<br><b>व्युत्पत्तिः - </b>एकाहं भावी<br><br>

ऐकाहिकी
ऐकाहिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದಿನದಲ್ಲಿ ಸಾಧ್ಯವಾದ ಯಾಗದ ದಕ್ಷಿಣೆ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-९५) । "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>एकाहसाध्ययागः एकाहः, तस्य दक्षिणा<br><br>

ऐक्य
ऐक्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಏಕತ್ವ /ಒಂದಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>एकस्य भावः<br><br>ऐक्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭೇದ /ಬೇರೆ ಬೇರೆಯಿಲ್ಲದಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"अन्यावतारपरिकल्पनकेलिलोभादैवयं निनाय निजमंशमिवान्यनिष्ठम्"<br><b>उल्लेखाः - </b>याद० २३-६०<br><br>ऐक्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಐಕಮತ್ಯ /ಸ್ನೇಹ /ಸೌಹಾರ್ದ<br><b>प्रयोगाः - </b>"तेषां द्वयोर्द्वयोरैक्यं बिभिदे न कदाचन । यथा वायुविभावस्वोर्यथा चन्द्रसमुद्रयोः"<br><b>उल्लेखाः - </b>रघु० १०-८२<br><br>

ऐक्यस्थल
ऐक्यस्थल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೀರಶೈವಮತದಲ್ಲಿ ಜೀವ ಶಿವರ ಐಕ್ಯವನ್ನು ಸಾಧಿಸುವ ಕಡೆಯ ಸ್ಥಲ /ಸಾಧನೆಯ ಷಟ್ ಸೋಪಾನಮಾರ್ಗದಲ್ಲಿ ೬ನೆಯಸೋಪಾನ<br><b>व्युत्पत्तिः - </b>ऐक्यस्य शिवजीवयोः सायुज्यस्य स्थलम्<br><br>

ऐक्षव
ऐक्षव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಕ್ಷುವಿನ ವಿಕಾರವಾದ ಬೆಲ್ಲ ಮೊದಲಾದುದು /ಕಬ್ಬಿನಿಂದ ತಯಾರಾದ ಕಾಕಂಬಿ ಬೆಲ್ಲ ಸಕ್ಕರೆ ಕಲ್ಲುಸಕ್ಕರೆ ಬೂರಾಸಕ್ಕರೆ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>"अण्" (४-३-१३३)<br><b>व्युत्पत्तिः - </b>इक्षोर्विकारः<br><br>

ऐक्षुक
ऐक्षुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಗೆ ಯೋಗ್ಯವಾದ /ಕಬ್ಬಿಗೆ ತಕ್ಕುದಾದ ಭೂಮಿ<br><b>निष्पत्तिः - </b>"ठञ्" (४-४-०३)<br><b>व्युत्पत्तिः - </b>इक्षौ साधु<br><br>

ऐक्शुभारिक
ऐक्शुभारिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿನ ಹೊರೆಯನ್ನು ಒಯ್ಯುವವನು<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-५०)<br><b>व्युत्पत्तिः - </b>इक्षुभारं वहति<br><br>ऐक्शुभारिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿನ ಹೊರೆಯನ್ನು ಹೊರುವವನು<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-५०)<br><b>व्युत्पत्तिः - </b>इक्षुभारं हरति<br><br>ऐक्शुभारिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿನ ಹೊರೆಯನ್ನು ಹೊತ್ತು ತರುವವನು<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-५०)<br><b>व्युत्पत्तिः - </b>इक्षुभारं आवहति<br><br>

ऐक्ष्वाक
ऐक्ष्वाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಕ್ಷ್ವಾಕುವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದದೊರೆ<br><b>निष्पत्तिः - </b>"अञ्" (४-१-१६६) ।बहुषु लुक् (२-४-६२)<br><b>व्युत्पत्तिः - </b>"इक्ष्वाकोर्गोत्रापत्यम्<br><b>प्रयोगाः - </b>"इक्ष्वाकूणां दुरापेऽर्थे त्वदधीना हि सिद्धयः"<br><b>उल्लेखाः - </b>रघु० १-७२<br><br>ऐक्ष्वाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಕ್ಷ್ವಾಕು ದೇಶದ ದೊರೆ<br><b>निष्पत्तिः - </b>"अञ्" (४-१-१६६)<br><b>व्युत्पत्तिः - </b>इक्ष्वाकूणां राजा<br><br>ऐक्ष्वाक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಕ್ಷ್ವಾಕುರಾಜನಿಗೆ ಸಂಬಂಧಿಸಿದ<br><br>

ऐङ्गुद
ऐङ्गुद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂಗುದೀಫಲ /ಹಿಪ್ಪೆ ಕಾಯಿ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१६४)<br><b>व्युत्पत्तिः - </b>इङ्गुद्याः फलम्<br><br>

ऐच्छिक
ऐच्छिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಚ್ಛೆಯಿಂದ ಉಂಟಾದ /ಇತರರ ನಿರ್ಬಂಧಕ್ಕೆ ಒಳಪಡದೆ ತನ್ನ ಇಷ್ಟಕ್ಕೆ ಅನುಸಾರವಾದ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-७९)<br><b>व्युत्पत्तिः - </b>इच्छया निवृत्तः<br><br>

ऐडल|विडल
ऐडल (विडल)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಡವಿಡೆಯ ಮಗ /ಕುಬೇರ<br><b>निष्पत्तिः - </b>"अण्" (४-१-११३) । डलयोरभेदः ।<br><b>व्युत्पत्तिः - </b>इड(ल)विडा(ला) या अपत्यम्<br><br>

ऐण
ऐण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಿಂಕೆಯ ಸಂಬಂಧವಾದ /ಜಿಂಕೆಯ ಮಾಂಸ ಚರ್ಮ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>"अञ्" (४-३-१५४)<br><b>व्युत्पत्तिः - </b>एणस्य अवयवो विकारो वा<br><b>प्रयोगाः - </b>"ऐणरौरववाराहशाशैर्मांसैर्यथाक्रम्"<br><b>उल्लेखाः - </b>याज्ञ० १-२५९<br><br>

ऐणेय
ऐणेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣಿ ಜಿಂಕೆಯ ಸಂಬಂಧವಾದ ಮಾಂಸಚರ್ಮ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>"ठञ्" (४-३-१५९)<br><b>व्युत्पत्तिः - </b>एण्या अवयवो विकारो वा<br><br>

ऐतरेय
ऐतरेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇತರನೆಂಬ ಒಬ್ಬ ಋಷಿಯ ಮಗ<br><b>निष्पत्तिः - </b>"ढक्" (४-१-१२३)<br><b>व्युत्पत्तिः - </b>इतरस्यर्षेरपत्यम्<br><br>

ऐतरेयब्राह्मण
ऐतरेयब्राह्मण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಋಗ್ವೇದಕ್ಕೆ ಸಂಬಂಧಿಸಿದ ೨ ಬ್ರಾಹ್ಮಣಗಳಲ್ಲಿ ಮುಖ್ಯವಾದ ಒಂದು ಬ್ರಾಹ್ಮಣ /ಐತರೇಯ ಋಷಿಯಿಂದ ಪ್ರೋಕ್ತವಾದ ಯಾಗದಲ್ಲಿ ಹೋತೃವಿನ ಕಾರ್ಯವನ್ನು ವಿವರಿಸುವ ಒಂದು ಬ್ರಾಹ್ಮಣ<br><br>

ऐतरेयारण्यक
ऐतरेयारण्यक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರಣ್ಯದಲ್ಲಿ ಅಧ್ಯಯನಮಾಡಬೇಕಾದ ಋಗ್ವೇದದ ಒಂದು ಆರಣ್ಯಕ ಭಾಗ<br><br>

ऐतरेयोपनिषत्
ऐतरेयोपनिषत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಐತರೇಯಮಹರ್ಷಿಪ್ರೋಕ್ತವಾದ ಒಂದು ಉಪನಿಷತ್ತು<br><br>

ऐतरेयभाष्य
ऐतरेयभाष्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಐತರೇಯ ಉಪನಿಷತ್ತಿಗೆ ಭಾಷ್ಯರೂಪವಾದ ವ್ಯಾಖ್ಯಾನ<br><br>

ऐतरेयिन्
ऐतरेयिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಐತರೇಯಬ್ರಾಹ್ಮಣವನ್ನು ಅಧ್ಯಯನ ಮಾಡುವವನು<br><br>

ऐतिहासिक
ऐतिहासिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇತಿಹಾಸದಿಂದ ಬಂದ /ಚಾರಿತ್ರವಾದ /ಪೂರ್ವಕಾಲದಲ್ಲಿ ನಡೆದ ಕಥೆಯ ಸಂಬಂಧವಾದ /ಮಹಾಪುರುಷರ ಜೀವನ ಚರಿತ್ರೆಯಿಂದ ಬಂದಿರುವ<br><b>निष्पत्तिः - </b>"ठक्" (५-३-७४)<br><b>व्युत्पत्तिः - </b>इतिहासः पुरावृत्तम्, तत आगतः<br><br>

ऐतिह्य
ऐतिह्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂರ್ವದಿಂದ ಪರಂಪರೆಯಾಗಿ ಬಂದಿರುವ ಉಪದೇಶ<br><b>निष्पत्तिः - </b>इति ह पारम्पर्योपदेशः । तस्य स्वार्थे "ष्यञ्" (वा० ५-१-१२४)<br><br>

ऐदम्पर्य
ऐदम्पर्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ದೇಶ /ತಾತ್ಪರ್ಯ /ಮುಖ್ಯವಿಷಯವಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>इदम्परस्य भावः<br><b>प्रयोगाः - </b>"इदं त्वैदम्पर्यं यदुत नृपतेर्नर्मसचिवः सुतादानान्मित्रं भव्तु स भवान्नन्दत इति"<br><b>उल्लेखाः - </b>मालती० २-७<br><br>

ऐदंयुगीन
ऐदंयुगीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈ ಯುಗಕ್ಕೆ ಒಳ್ಳೆಯದಾಗಿರುವ /ಈ ಯುಗಕ್ಕೆ ತಕ್ಕುದಾಗಿರುವ<br><b>निष्पत्तिः - </b>"खञ्" (४-४-९९)<br><b>व्युत्पत्तिः - </b>इदंयुगे साधु<br><br>

ऐन्दव
ऐन्दव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಂದ್ರಮಾಸ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>इन्दोरयम्<br><b>प्रयोगाः - </b>"ऐन्दवास्तिथयस्तद्वत् सङ्क्रान्त्या सौर उच्यते"<br><b>उल्लेखाः - </b>सू० सि०<br><br>ऐन्दव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರದೇವತಾಕವಾದ ಮೃಗಶೀರ್ಷನಕ್ಷತ್ರ<br><b>व्युत्पत्तिः - </b>इन्दुर्देवता अस्य<br><br>ऐन्दव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಂದ್ರಾಯಣ ವ್ರತ<br><b>प्रयोगाः - </b>"सङ्करापात्रकृत्यासु मासं शोधनमैन्दवम्"<br><b>उल्लेखाः - </b>मनु० १-१२४<br><br>ऐन्दव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದುದೇವತಾಕವಾದ ಹವಿಸ್ಸು<br><br>ऐन्दव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಂದ್ರಸಂಬಂಧವಾದ<br><b>प्रयोगाः - </b>"दलयति परिशुष्यत्प्रौढतालीविपाण्डुस्तिमिरनिकरमुद्यन्नैन्दवः प्राक्प्रकाशः"<br><b>उल्लेखाः - </b>मालती० ८-१<br><br>

ऐन्दवी
ऐन्दवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ऐन्दव ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

ऐन्द्र
ऐन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಮಗ - ಅರ್ಜುನ, ವಾಲಿ, ಜಯಂತ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>इन्द्रस्यायम्<br><br>ऐन्द्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರದೇವತಾಕವಾದ ಹವಿಸ್ಸು<br><br>ऐन्द्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ ದೇವತಾಕವಾದ ಜ್ಯೇಷ್ಠಾನಕ್ಷತ್ರ<br><b>निष्पत्तिः - </b>"अण्" (४-२-२४)<br><b>व्युत्पत्तिः - </b>इन्द्रो देवताऽस्य<br><br>ऐन्द्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಂದ್ರಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>इन्द्रस्येदम्<br><b>प्रयोगाः - </b>"महीतलस्पर्शनमात्रभिन्नमृद्धं हि राज्यं पदमैन्द्रमाहुः"<br><b>उल्लेखाः - </b>रघु० २-५०<br><br>

ऐन्द्री
ऐन्द्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಸಂಬಂಧವಾದ ದಿಕ್ಕು /ಪೂರ್ವದಿಕ್ಕು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>ऐन्द्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಚೀದೇವಿ<br><br>ऐन्द्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ<br><br>ऐन्द्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಲಕ್ಕಿ<br><br>

ऐन्द्रजालिक
ऐन्द्रजालिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಯಾವಿ /ಇಂದ್ರಜಾಲವಿದ್ಯೆಯನ್ನು ಬಲ್ಲವನು /ಯಕ್ಷಿಣಿಯಿಂದ ಜೀವಿಸುವವನು<br><b>निष्पत्तिः - </b>"ठक्" (५-३-७४)<br><b>व्युत्पत्तिः - </b>इन्द्रजालेन जीवति<br><b>प्रयोगाः - </b>"काञ्चनमाले, उज्जयिनीतः आगत इत्यस्ति मे तस्मिन्नैन्द्रजालिके पक्षपातः"<br><b>उल्लेखाः - </b>रत्ना० ४<br><br>

ऐन्द्रनील
ऐन्द्रनील<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಂದ್ರನೀಲ ಸಂಬಂಧವಾದ /ಇಂದ್ರನೀಲಮಣಿಯಿಂದ ನಿರ್ಮಿತವಾದ<br><br>

ऐन्द्रलुप्तिक
ऐन्द्रलुप्तिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಟ್ಟತಲೆ<br><br>ऐन्द्रलुप्तिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಖಲ್ವಾಟ /ಬಟ್ಟ ತಲೆಯವನು<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-७९) । "अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>इन्द्रलुप्तेन निवृत्तम्, तदस्यास्ति<br><br>

ऐन्द्राग्न
ऐन्द्राग्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಂದ್ರ ಮತ್ತು ಅಗ್ನಿದೇವತಾಕವಾದ ಹವಿಸ್ಸು ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>"अण्" (४-२-२४)<br><b>व्युत्पत्तिः - </b>इन्द्राग्नी देवतेऽस्य<br><br>

ऐन्द्रापौष्ण
ऐन्द्रापौष्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಂದ್ರ ಮತ್ತು ಪೂಷದೇವತಾಕವಾದ ಹವಿಸ್ಸು ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>"अण्" (४-२-२४) । "आनङ्" (६-३-२६)<br><b>व्युत्पत्तिः - </b>इन्द्रस्य पूषा च देवतेऽस्य<br><br>

ऐन्द्रामारुत
ऐन्द्रामारुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಂದ್ರ ಮತ್ತು ಮರುತ್ ದೇವತಾಕವಾದ ಹವಿಸ್ಸು ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>"अण्" (४-२-२४) । "आनङ्" (६-३-२६)<br><b>व्युत्पत्तिः - </b>इन्द्रश्च मरुतश्च देवता अस्य<br><br>

ऐन्द्रि
ऐन्द्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಮಗ - ಅರ್ಜುನ, ವಾಲಿ, ಜಯಂತ<br><b>निष्पत्तिः - </b>"इञ्" (४-१-९५)<br><b>व्युत्पत्तिः - </b>इन्द्रस्यापत्यम्<br><br>ऐन्द्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯಸ /ಕಾಗೆ<br><b>प्रयोगाः - </b>"ऐन्द्रिः किलनखैस्तस्या विददार स्तनौ द्विजः"<br><b>उल्लेखाः - </b>रघु० १२-२२<br><br>

ऐन्द्रियिक
ऐन्द्रियिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯಗಳಿಂದ ತಿಳಿಯಲ್ಪಡುವ /ಪ್ರತ್ಯಕ್ಷವಾದ<br><b>निष्पत्तिः - </b>"वुञ्" (४-२-८०)<br><b>व्युत्पत्तिः - </b>इन्द्रियेण निवृत्तम्<br><b>विस्तारः - </b>"प्रत्यक्षं स्यादैन्द्रियकमप्रत्यक्षमतीन्द्रियम्" - अम०<br><br>

ऐर
ऐर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೂಮಿಯಲ್ಲಿ ಉಂಟಾದ<br><br>ऐर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಲದಲ್ಲಿ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-५३)<br><b>व्युत्पत्तिः - </b>इरायां भूमौ जले वा भवः<br><br>

ऐरावण
ऐरावण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಐರಾವತ /ಇಂದ್ರನ ಆನೆ<br><b>निष्पत्तिः - </b>"अण्" (४-३-५३)<br><b>व्युत्पत्तिः - </b>इरा सुरा वनमुदकं यत्र इरावणम् । तत्र भवः । अथवा इरया वणते शब्दायते इति इरावणः । तत्र भवः ।<br><br>ऐरावण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದುಸರ್ಪ<br><br>

ऐरावत
ऐरावत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ಆನೆ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४) । "अण्" (४-३-५३)<br><b>व्युत्पत्तिः - </b>इरा जलं भूम्नाऽस्त्यत्र । इरावान् समुद्रः । तत्र भवः<br><b>प्रयोगाः - </b>"प्रावृषेण्यं पयोवाहं विद्युदैरावताविव"<br><b>उल्लेखाः - </b>रघु० १-३६<br><br>ऐरावत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದಿಗ್ಗಜ /ಪೂರ್ವದಿಕ್ಕನ್ನು ಹೊತ್ತಿರುವ ಒಂದು ಆನೆ<br><br>ऐरावत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸರ್ಪ<br><br>ऐरावत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇರಾವಂತನ ಮಗ<br><br>ऐरावत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಜನಿಂಬೆ ಗಿಡ<br><br>ऐरावत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೇರಳೆ ಗಿಡ<br><br>ऐरावत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೆಟ್ಟಗೂ ಉದ್ದಕ್ಕೂ ಇರುವ ಇಂದ್ರನ ಧನುಸ್ಸು<br><b>निष्पत्तिः - </b>"अण्" (४-३-५३)<br><b>व्युत्पत्तिः - </b>इरावति मेघे भवः<br><br>

ऐरावती
ऐरावती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿದ್ಯುತ್ತು /ಮಿಂಚು<br><br>ऐरावती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಐರಾವತದಿಗ್ಗಜನ ಪತ್ನಿ<br><br>ऐरावती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಂಜಾಬಿನಲ್ಲಿರುವ ರಾವಿಯೆಂಬ ಒಂದು ನದಿ<br><br>

ऐरेय
ऐरेय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯೆ /ಸುರೆ /ಹೆಂಡ<br><br>

ऐल
ऐल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಳೆಯ ಮಗ /ಪುರೂರವಸ್ಸು<br><b>निष्पत्तिः - </b>"अण्" (४-१-११३) ।<br><b>व्युत्पत्तिः - </b>इलया अपत्यम्<br><br>

ऐलबिल
ऐलबिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರ /ಇಲಬಿಲೆಯ ಮಗ<br><b>निष्पत्तिः - </b>"अण्" (४-१-११३) ।<br><b>व्युत्पत्तिः - </b>इलबिलया अपत्यम्<br><b>प्रयोगाः - </b>"अवलम्बितैलबिलपाणिपल्लवः श्रयति स्म मेघमिव मेघवाहनः"<br><b>उल्लेखाः - </b>माघ० १३-१८<br><br>

ऐलेय
ऐलेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಜಗ್ರಹ /ಇಳೆಯ ಮಗ /ಭೂಮಿಯ ಮಗ<br><b>निष्पत्तिः - </b>"ढक्" (४-१-१२०)<br><b>व्युत्पत्तिः - </b>इलाया अपत्यम्<br><br>

ऐश
ऐश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿವಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>ईशस्येदम्<br><b>प्रयोगाः - </b>"अथ नयनसमुत्थं ज्योतिरत्रेरिव द्यौः सुरसरिदिव तेजो वह्निनिष्ठ्यूतमैशम्"<br><b>उल्लेखाः - </b>रघु० २-७५<br><br>ऐश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಾಜನ ಸಂಬಂಧವಾದ<br><br>

ऐशी
ऐशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ऐश ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

ऐशान
ऐशान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿವಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>ईशानस्येदम्<br><br>ऐशान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈಶಾನದಿಕ್ ಸಂಬಂಧವಾದ /ಉತ್ತರಪೂರ್ವದಿಕ್ಕಿಗೆ ಸಂಬಂಧಿಸಿದ<br><br>

ऐशानि
ऐशानि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಈಶಾನದಿಕ್ ಸಂಬಂಧವಾದ /ಉತ್ತರಪೂರ್ವದಿಕ್ಕಿಗೆ ಸಂಬಂಧಿಸಿದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

ऐशि
ऐशि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರನ ಮಗ /ಷಣ್ಮುಖ<br><b>निष्पत्तिः - </b>"इञ्" (४-१-९५)<br><b>व्युत्पत्तिः - </b>ईशस्यापत्यम्<br><b>प्रयोगाः - </b>"महेशकण्ठोरगदन्तपङ्क्तिः तदङ्कगः शैशवमौग्ध्यमैशिः"<br><b>उल्लेखाः - </b>कुमा० ११-४५<br><br>ऐशि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಣಪತಿ /ವಿನಾಯಕ<br><br>

ऐश्वर
ऐश्वर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈಶ್ವರಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>ईश्वरस्येदम्<br><b>प्रयोगाः - </b>"विद्धि चात्तबलमोजसा हरेरैश्वरं धनुरभाजि यत्त्वया"<br><b>उल्लेखाः - </b>रघु० ११-७६<br><br>ऐश्वर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈಶ್ವರನಿಂದ ಬಂದ /ಈಶ್ವರನಿಂದ ಉಂಟಾದ<br><br>ऐश्वर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಜಮಾನನಿಂದ ಬಂದ /ಯಜಮಾನನಿಂದ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-७४)<br><b>व्युत्पत्तिः - </b>ईश्वरादागतः<br><br>ऐश्वर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಜಮಾನನ ಸಂಬಂಧವಾದ<br><br>

ऐश्वरी
ऐश्वरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

ऐश्वर्य
ऐश्वर्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರಮ್ಯ /ಶ್ರೇಷ್ಠತೆ<br><br>ऐश्वर्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾಧಿಕಾರ /ಪ್ರಭುತ್ವ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>ईश्वरस्य भावः<br><b>प्रयोगाः - </b>"एकैश्वर्ये स्थितोऽसि प्रणतबहुफलं यः स्वयं कृत्तिवासाः"<br><b>उल्लेखाः - </b>माल० १-१<br><br>ऐश्वर्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪತ್ತು /ಭಾಗ್ಯ /ಧನ /ಹಣ<br><b>प्रयोगाः - </b>"मूर्च्छन्त्यमी विकाराः प्रायेणैश्वर्यमत्तेषु"<br><b>उल्लेखाः - </b>शाकु० ५-१८<br><br>ऐश्वर्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಣಿಮಾದಿ ೮ ವಿಧ ಶಕ್ತಿಗಳು /ಅಮಾನುಷ ಶಕ್ತಿ<br><br>

ऐश्वर्यवत्
ऐश्वर्यवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಪದ್ಯುಕ್ತ /ಹಣವಂತ /ಧನಿಕ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४) ।<br><b>व्युत्पत्तिः - </b>ऐश्वर्यमस्यास्ति<br><br>ऐश्वर्यवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಮಾಧಿಕಾರವುಳ್ಳ<br><br>ऐश्वर्यवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಣಿಮಾದಿ ೮ ಸಿದ್ಧಿಗಳಿಂದ ಕೂಡಿದ<br><br>

ऐर्श्वर्यवती
ऐर्श्वर्यवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ऐश्वर्यवत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

ऐषमस्
ऐषमस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಈ ವರ್ಷ /ವರ್ತಮಾನ ವರ್ಷ /ಈಗ ನಡೆಯುತ್ತಿರುವ ವರ್ಷ<br><b>निष्पत्तिः - </b>इदम् - "समसण्" (५-३-२२)<br><br>

ऐषमस्तन
ऐषमस्तन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈ ವರ್ಷದಲ್ಲಿರುವ /ಈ ವರ್ಷದಲ್ಲಿ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>"ट्युः" (४-२-१०५)<br><b>व्युत्पत्तिः - </b>एषमस् भवः वा<br><br>

ऐषमस्त्य
ऐषमस्त्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈ ವರ್ಷದಲ್ಲಿರುವ /ಈ ವರ್ಷದಲ್ಲಿ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>पक्षे "त्यप्" (४-२-१०४)<br><br>

ऐषीक
ऐषीक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜೊಂಡಿನಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ ಒಂದು ಅಸ್ತ್ರ<br><br>ऐषीक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾಭಾರತದ ಸೌಪ್ತಿಕಪರ್ವದ ಒಂದು ಅವಾಂತರಪರ್ವ<br><br>

ऐषुकारि
ऐषुकारि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಷುಕಾರನ ಮಗ /ಬಾಣಗಳನ್ನು ತಯಾರಿಸುವವನ ಮಗ<br><b>निष्पत्तिः - </b>"इञ्" (४-१-९५)<br><b>व्युत्पत्तिः - </b>इषुकारस्य अपत्यम्<br><br>

ऐषुकारिभक्त
ऐषुकारिभक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಐಷುಕಾರಿಗಳು ವಾಸಮಾಡುವ ದೇಶ<br><b>निष्पत्तिः - </b>"भक्तल्" (४-२-५४)<br><b>व्युत्पत्तिः - </b>ऐषुकारिणां विषयो देशः<br><br>

ऐष्टिक
ऐष्टिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟಿ ಸಂಬಂಧವಾದ /ಯಾಗಕ್ಕೆ ಸಂಬಂಧಿಸಿದ<br><b>निष्पत्तिः - </b>"ठञ्" (४-३-६८)<br><b>व्युत्पत्तिः - </b>इष्टेर्व्याख्यानो ग्रन्थः<br><br>ऐष्टिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾಗಕ್ಕೆ ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-१०२)<br><b>व्युत्पत्तिः - </b>इष्टौ साधुः<br><br>ऐष्टिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾಗಕ್ಕೆ ಸಮರ್ಥನಾದ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-१०१)<br><b>व्युत्पत्तिः - </b>इष्ट्यै प्रभवति<br><br>

ऐहलौकिक
ऐहलौकिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಹಲೋಕದಲ್ಲಿ ಉಂಟಾದ /ಈ ಲೋಕಕ್ಕೆ ಸಂಬಂಧಿಸಿದ<br><b>निष्पत्तिः - </b>"ठञ्" (वा० ४-३-६०) । उभयपदवृद्धिः (७-३-२०)<br><b>व्युत्पत्तिः - </b>इहलोके भवः<br><br>

ऐहिक
ऐहिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಲ್ಲಿ ಉಂಟಾದ /ಈ ಸ್ಥಳದಲ್ಲಿರುವ /ಈ ಲೋಕದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"ठञ्" (वा० ४-३-६०)<br><b>व्युत्पत्तिः - </b>इह भवः<br><b>प्रयोगाः - </b>"क्वचित् द्रुमवदैहिकार्थेषु गृहेषु रंस्यन् यथा वानरः सुतदारवत्सलो व्यवायक्षणः"<br><b>उल्लेखाः - </b>भाग० ५-१४-३२<br><br>

ओ
ओ<br><br><b>कन्नडार्थः - </b>ಓಕಾರ<br><b>विस्तारः - </b>ವರ್ಣಮಾಲೆಯಲ್ಲಿ ಇದು ಕಂಠ ಮತ್ತು ಓಷ್ಠ ಸ್ಥಾನಗಳಲ್ಲಿ ಆಭ್ಯಂತರ ವಿವೃತಪ್ರಯತ್ನದಿಂದ ಹುಟ್ಟುವ ಒಂದು ದೀರ್ಘಸ್ವರವರ್ಣ. ಉದಾತ್ತಾನುದಾತ್ತಸ್ವರಿತಗಳೆಂಬ ಭೇದಗಳಿಂದ ಮುರು ವಿಧವಾದ ಇದು ಅನುನಾಸಿಕ ಮತ್ತು ಅನನುಸಾಸಿಕಗಳೆಂಬ ಭೇದಗಳಿಂದ ಒಟ್ಟು ೬ ವಿಧವಾಗುವುದು.<br><br>ओ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ<br><b>विस्तारः - </b>"ओकारस्तु भवेत् ब्रह्म"- एका०<br><br>ओ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಬೋಧನೆ<br><br>ओ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಹ್ವಾನ /ಕರೆ<br><br>ओ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಮರಣೆ /ಸ್ಮೃತಿ<br><br>ओ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಯೆ /ತೋರಿಸುವಿಕೆ<br><b>विस्तारः - </b>"ओ सम्बोधन आह्वाने स्मरणे चानुकम्पने" - मेदि० ।<br><br>

ओक
ओक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆ /ಗೃಹ<br><br>ओक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ ಸ್ಥಾನ /ರಕ್ಷಣೆಯ ಜಾಗ<br><br>ओक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಕ್ಷಿ /ಹಕ್ಕಿ<br><br>ओक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೂದ್ರ /ವೃಷಲ<br><b>निष्पत्तिः - </b>उच (समवाये) - "कः" (३-१-१३५) निपा० ।<br><b>विस्तारः - </b>"ओकः शकुन्तवृषलौ" - सि० कौ० ।<br><br>

ओकस्
ओकस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆ /ಗೃಹ<br><br>ओकस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ ಸ್ಥಾನ /ರಕ್ಷಣೆಯ ಜಾಗ<br><b>निष्पत्तिः - </b>उच (समवाये) - "असुन्" (उ० ४-१८८)<br><br>

ओकण|ओकणि
ओकण (णि)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿಗಣೆ<br><br>ओकण (णि)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೇನು /ಕೂರೆ<br><br>

ओकुल
ओकुल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧ ಹುರಿಯಲ್ಪಟ್ಟ ಗೋಧಿ<br><b>प्रयोगाः - </b>"ओकुलस्तु गुरुर्वृष्यो मधुरो बलकारकः । रक्तपित्तापहः स्निग्धो हृद्यो मदविवर्धनः ॥"<br><b>उल्लेखाः - </b>राजनि०<br><br>

ओकोदनी
ओकोदनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇನು /ಕೂರೆ<br><br>ओकोदनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಿಗಣೆ<br><b>व्युत्पत्तिः - </b>ओकः आश्रयस्थानमदनं भक्ष्यं यस्याः<br><br>

ओघ
ओघ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೂಹ /ಗುಂಪು /ರಾಶಿ<br><b>निष्पत्तिः - </b>वह (प्रापणे) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>उह्यतेऽनेन<br><b>प्रयोगाः - </b>"अघौघविध्वंसविधौ पटीयसीर्नतेन मूर्ध्ना हरिरग्रहीदपः"<br><b>उल्लेखाः - </b>माघ० १-१८<br><br>ओघ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಲಪ್ರವಾಹ /ನೀರಿನ ವೇಗ<br><b>प्रयोगाः - </b>"पुनरोधेन हि युज्यते नदी"<br><b>उल्लेखाः - </b>कुमा० ४-४४<br><br>ओघ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಂಪರೆ<br><br>ओघ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ರುತನೃತ್ಯ<br><br>ओघ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪದೇಶ /ಬೋಧನೆ<br><b>विस्तारः - </b>"ओगो वेगे जलस्य च । वृन्दे परम्परायां च द्रुतनृत्योपदेशयोः" - मेदि० ।<br><br>

ओङ्कार
ओङ्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಓಮ್ ಎಂಬ ಅಕ್ಷರ /ಪ್ರಣವ<br><b>प्रयोगाः - </b>"ओङ्कारं पूर्वमुच्चार्य पश्चाद्वेधमधीयते"<br><b>उल्लेखाः - </b>स्मृतिः<br><br>ओङ्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಬ್ರಹ್ಮ<br><br>ओङ्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ /ಉಪಕ್ರಮ<br><br>ओङ्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗೀಕಾರ /ಸಮ್ಮತಿ /ಒಪ್ಪಿಗೆ<br><b>प्रयोगाः - </b>"ओमित्युक्तवतोऽथ शार्ङ्गिण इति व्याहृत्य वाचं नभः"<br><b>उल्लेखाः - </b>माघ० १-७५<br><br>ओङ्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಾಕೃತಿ /ನಿರಾಕರಣೆ<br><br>ओङ्कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಮತಿ /ಅಪ್ಪಣೆ<br><br>

ओज
ओज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಯುಗ್ಮ /ವಿಷಮ /ಬೆಸ ೧,೩,೫,೭,೯ ಇತ್ಯಾದಿ<br><br>ओज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಷಾದಿ ೧೨ ರಾಶಿಗಳಲ್ಲಿ ೧,೩,೫,೭,೯,೧೧ನೇ ರಾಶಿಗಳು<br><br>

ओजस्
ओजस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶ /ಬೆಳಕು /ದೀಪ್ತಿ<br><b>निष्पत्तिः - </b>उब्ज (आर्जवे) - "असुन्" (उ० ४-१९२)<br><br>

ओजस्
ओजस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಕ್ತಿ /ಶರೀರ ಬಲ /ಸಾಮರ್ಥ್ಯ<br><b>प्रयोगाः - </b>"ओजसापि खलु नूनमनूनं नासहायमुपयाति जयश्रीः"<br><b>उल्लेखाः - </b>किरा० ९-३३<br><br>ओजस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚೈತನ್ಯ /ಪ್ರಾಣಬಲ /ಧಾತುವಿನ ತೇಜಸ್ಸು<br><br>ओजस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ರಯ /ಆಧಾರ /ಒತ್ತಾಸೆ<br><b>विस्तारः - </b>"ओजो दीप्ताववष्टम्भे प्रकाशबलयोरपि" - मेदि० ।<br><br>ओजस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲಂಕಾರ ಶಾಸ್ತ್ರದಲ್ಲಿ ಸಮಾಸಬಾಹುಳ್ಯ /ದೊಡ್ಡ ಸಮಾಸಗಳಿಂದಕೂಡಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"ओजः समासभूयस्त्वमेतद्गद्यस्य जीवितम्"<br><b>उल्लेखाः - </b>काव्या० १-८०<br><br>ओजस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೊತಿಃಶಾಸ್ತ್ರದಲ್ಲಿ ೧,೩,೫,೭,೯,೧ನೇರಾಶಿಗಳು<br><br>ओजस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೀರ್ಯವತ್ತಾದಪದಗಳ ಜೋಡಣೆ /ಜೋರಾದ ವಾಕ್ಸರಣಿ /ಸಂಯುಕ್ತಾಕ್ಷರಗಳಿಂದಲೂ ನಿರಂತರವಾದ ರೇಫಸಹಿತ ವರ್ಣಗಳಿಂದಲೂ ವರ್ಗಗಳ ೧,೨ ನೆಯ ೩,೪ ನೆಯ ೧,೩ ನೆಯ ಅಕ್ಷರಗಳ ನಿರಂತರವಾದ ಜೋಡಣೆಯಿಂದಲೂ ಕೂಡಿರುವಿಕೆ<br><br>ओजस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><br>

ओजसीन
ओजसीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಲಿಷ್ಠವಾದ /ಬಲಶಾಲಿಯಾದ /ಶಕ್ತಿಯಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>ओजस् - "खः" (४-४-१३०)<br><br>

ओजस्य
ओजस्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಲಿಷ್ಠವಾದ /ಬಲಶಾಲಿಯಾದ /ಶಕ್ತಿಯಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>"यत्" (४-४-१३०)<br><br>

ओजस्वत्
ओजस्वत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಲಶಾಲಿ /ಶಕ್ತಿವಂತ /ಪರಾಕ್ರಮಿ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>ओजोऽस्यास्ति<br><br>

ओजस्विन्
ओजस्विन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಲಶಾಲಿ /ಶಕ್ತಿವಂತ /ಪರಾಕ್ರಮಿ<br><b>निष्पत्तिः - </b>"विनिः" (५-२-१२१)<br><b>व्युत्पत्तिः - </b>ओजोऽस्यास्ति<br><b>प्रयोगाः - </b>"आकृष्टदेवासुरसाम्परायैरोजस्विनां शस्त्रभृतामुदन्तैः"<br><b>उल्लेखाः - </b>याद० २३-४६<br><br>ओजस्विन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಾಸಭೂಯಿಷ್ಠವಾದ/ ದೀರ್ಘಸಮಾಸಗಳಿಂದ ಕೂಡಿದ<br><b>प्रयोगाः - </b>"ओजस्विवर्णोज्ज्वलवृत्तशालिनः प्रसादिनोऽनुज्झितगोत्रसंविदः"<br><b>उल्लेखाः - </b>माघ० १२-३५<br><br>ओजस्विन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಳೆಯುವ /ಪ್ರಕಾಶವುಳ್ಳ<br><br>

ओजिष्ठ
ओजिष्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಬಲಶಾಲಿಯಾದ /ಬಹಳ ಶಕ್ತಿವಂತನಾದ<br><b>निष्पत्तिः - </b>"इष्ठन्" (५-३-५५)<br><b>व्युत्पत्तिः - </b>अतिशयेन ओजस्वी<br><br>

ओड्र
ओड्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಾಸವಾಳದ ಗಿಡ<br><br>ओड्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಕಲ ದೇಶ /ಓಗಿನ ಓರಿಸ್ಸಾ ದೇಶ<br><br>ओड्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಕಲ ದೇಶವಾಸಿಗಳು<br><b>प्रयोगाः - </b>"पौण्ड्रकाश्चौड्रद्रविडाः काम्बोजा यवनाः शकाः"<br><b>उल्लेखाः - </b>मनु० १०-४४<br><b>विस्तारः - </b>बहुवचने इदं रूपम् ।<br><br>ओड्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಪಾಕುಸುಮ /ದಾಸವಾಳದ ಹೂವು<br><b>विस्तारः - </b>"ओड्राः पुम्भूम्नि नीवृति । ओड्रस्तु तरुभेदे स्यात्" - मेदि० ।<br><br>

ओड्रदेश
ओड्रदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಓರಿಸ್ಸಾ ದೇಶ<br><br>

ओड्रपुष्प
ओड्रपुष्प<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಪಾಕುಸುಮ /ದಾಸವಾಳದ ಹೂವು<br><br>

ओणृ|अपनयने|ओणति
ओणृ - अपनयने (भ्वा० पर० सक० से०) ओणति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಾಗಿಸು /ಬೇರೆ ಸ್ಥಳಕ್ಕೆ ಒಯ್ಯು<br><br>ओणृ - अपनयने (भ्वा० पर० सक० से०) ओणति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ತೆಗೆದು ಹಾಕು /ತೆಗೆದು ಬಿಡು<br><br>ओणृ - अपनयने (भ्वा० पर० सक० से०) ओणति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೋಗಲಾಡಿಸು /ತೀರಿಸು<br><br>ओणृ - अपनयने (भ्वा० पर० सक० से०) ओणति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸರಿಸು /ದೂರ ಮಾಡು<br><br>

ओणि
ओणि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿ ಮತ್ತು ಸ್ವರ್ಗ<br><b>निष्पत्तिः - </b>ओणृ (अपनयने) - "इन्" (उ० ४-११७)<br><b>विस्तारः - </b>द्विवचनान्तं रूपम् ।<br><br>ओणि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಗಿಸುವ /ಒಯ್ಯುವ<br><br>ओणि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಗೆದುಹಾಕುವ<br><br>ओणि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿವಾರಿಸುವ /ಹೋಗಲಾಡಿಸುವ<br><br>

ओत
ओत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಸುದಾರ/ಬಟ್ಟೆ ನೇಯಲು ಹಾಕುವ ಉದ್ದದಾರ<br><br>ओत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಪೋಣಿಸಲ್ಪಟ್ಟ<br><br>ओत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ನೇಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>आ + वेञ् (तन्तुसन्ताने) - "क्तः" (३-२-०२)<br><br>ओत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಾರದಿಂದ ಹೊಲಿಯಲ್ಪಟ್ಟ<br><br>

ओतप्रोत
ओतप्रोत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಾಸುಹೊಕ್ಕು ಹಾಕಿ ನೇಯಲ್ಪಟ್ಟ /ಉದ್ದವಾಗಿ ಮತ್ತು ಅಡ್ಡಲಾಗಿ ದಾರ ಎಳೆದು ನೇಯಲ್ಪಟ್ಟ<br><br>ओतप्रोत<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹಾಸುಹೊಕ್ಕಾಗಿ /ಉದ್ದಕ್ಕೆ ಮತ್ತು ಅಡ್ಡಲಾಗಿ ಸರ್ವತ್ರ ವ್ಯಾಪಿಸಿ<br><br>

ओतु
ओतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಡಾಲ /ಮಾರ್ಜಾರ /ಬೆಕ್ಕು<br><b>निष्पत्तिः - </b>अव (रक्षणे) - "तुन्" (उ० १-६९) । ऊठ् (६-४-२०)<br><b>व्युत्पत्तिः - </b>अवति गृहमाखुभ्यः<br><br>ओतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೇಯ್ಗೆಯ ಹಾಸುದಾರ<br><b>निष्पत्तिः - </b>आ + वेञ् (तन्तुसन्ताने) - "तुन्"<br><br>

ओदन
ओदन<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನ<br><b>निष्पत्तिः - </b>उन्दी (क्लेदने) - "युच्"(उ० २-७७) दध्योदनम् ।गुडोदनम् ।<br><b>व्युत्पत्तिः - </b>उनत्ति<br><b>प्रयोगाः - </b>"गुडौदनं पायसं च हविष्यं क्षीरषाष्टिकम् । दध्योदनं हविश्चूर्णं मांसं चित्रान्नमेव च ॥"<br><b>उल्लेखाः - </b>याज्ञ० १-३०४<br><br>ओदन<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ<br><br>

ओदनी
ओदनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಳ್ಳಂಗಡಲೆ<br><br>

ओदनपाकी
ओदनपाकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೀಲಿಹೂವಿನ ಗೋರಂಟಿ ಗಿಡ<br><b>निष्पत्तिः - </b>"ङीष्" (४-१-६४)<br><b>व्युत्पत्तिः - </b>ओदनस्य पाक इवपाको यस्याः<br><br>

ओदनपाणीय
ओदनपाणीय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನಕ್ಕಾಗಿಯೇ ಪಾಣಿನಿಯ ಗ್ರಂಥಗಳನ್ನು ಅಧ್ಯಯನ ಮಾಡುವವನು /ಊಟದ ಆಸೆಯಿಂದ ವ್ಯಾಕರಣವನ್ನು ಅಭ್ಯಾಸ ಮಾಡುವವನು<br><b>व्युत्पत्तिः - </b>ओदनार्थं पाणिनीयः<br><br>

ओदनीय
ओदनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನ್ನಕ್ಕೆ ಸಂಬಂಧಿಸಿದ /ಅನ್ನಕ್ಕೆ ಹಿತವಾದ<br><b>निष्पत्तिः - </b>ओदन - वा "छः" (५-१-४)<br><br>

ओदन्य
ओदन्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನ್ನಕ್ಕೆ ಸಂಬಂಧಿಸಿದ /ಅನ್ನಕ್ಕೆ ಹಿತವಾದ<br><b>निष्पत्तिः - </b>पक्षे"यत्"<br><br>

ओद्म
ओद्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೆನೆಸುವುದು /ಒದ್ದೆ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>उन्दी (क्लेदने) "मनिन्" (उ० ४-१४४) । नलोपो गुणश्च निपा० (६-४-२९)<br><br>

ओम्
ओम्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಬ್ರಹ್ಮ /ಪರಮಾತ್ಮ<br><b>प्रयोगाः - </b>"तत्ते पदं सङ्ग्रहेण ब्रवीमि ओमित्येतत्" । "ओमित्येकक्षरं ब्रह्म व्यहरन् मामनुस्मरन् । यः प्रयाति त्यजन् देहं स याति परमां गतिम् ॥"<br><b>उल्लेखाः - </b>कठ०, गीता० ८-१३<br><br>ओम्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಣವ<br><b>निष्पत्तिः - </b>ऽ"मन्" (उ० १-१३९) । ऊठ् (६-४-२०)<br><br>ओम्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವೀಕಾರ /ಅಂಗೀಕಾರ /ಹಾಗೆಯೇ ಆಗಲಿ<br><b>प्रयोगाः - </b>"ओमित्युक्तवथोऽथ शार्ङ्गिण इति व्याहृत्य वाचं नभः"<br><b>उल्लेखाः - </b>माघ० १-७५<br><br>ओम्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಮತಿ /ಅಪ್ಪಣೆ<br><br>ओम्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ<br><b>प्रयोगाः - </b>"एष तावदोङ्कारः सकलराक्षससंहारनिगमाध्ययनस्य"<br><b>उल्लेखाः - </b>म० वी० १<br><br>ओम्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶುಭ /ಮಂಗಳ<br><br>ओम्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಾಕೃತಿ /ತಳ್ಳಿಹಾಕುವಿಕೆ /ತೆಗೆದು ಹಾಕುವಿಕೆ<br><b>विस्तारः - </b>"ओमुपक्रमे । प्रणवे चाभ्युपगमे चापाकृतौ च मङ्गले ॥" - मेदि० । "ओङ्कारः स्यादनुमतौ परमात्मन्युपक्रमे" - नानार्थर० ।<br><br>

ओमन्
ओमन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆ /ಕಾಪಾಡುವುದು /ಸಾಹಾಯ್ಯ ಮಾಡುವುದು<br><br>ओमन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಯೆ /ಕರುಣೆ<br><b>निष्पत्तिः - </b>अव (रक्षणे) - "मनिन्" (उ० ४-१८४)<br><br>ओमन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಿತ್ರ /ಸ್ನೇಹಿತ /ಗೆಳೆಯ<br><br>

ओमन्वत्
ओमन्वत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಕ್ಷಣೆಯುಳ್ಳ /ಸಾಹಾಯ್ಯವುಳ್ಳ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>ओमा विद्यतेऽस्य<br><br>

ओल
ओल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರಣಗೆಡ್ಡೆ<br><b>निष्पत्तिः - </b>आ + उन्दी (क्लेदने) - "कः" (३-१-१३५) । पृषो० ।<br><b>व्युत्पत्तिः - </b>ओनत्ति<br><br>ओल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೇವವಾದ /ಒದ್ದೆಯಾದ<br><b>विस्तारः - </b>"आद्रसूरणयोरोलः" - त्रिकाण्ड० ।<br><br>

ओलडि|उत्क्षेपे|ते
ओलडि - उत्क्षेपे (वा चुरा० उभ० सक० से०) ओलण्डयति - ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಎಸೆ /ಬಿಸಾಡು<br><br>

ओलण्डित
ओलण्डित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಸೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>ओलडि (उत्क्षेपे) +‍ णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"प्रभुस्तं दैत्यसिद्धीनां प्रसूतकिलकिञ्चितम् । ओलण्डितमिवापश्यदुग्रं समरताण्डवम् ॥"<br><b>उल्लेखाः - </b>याद० १६-६४<br><br>

ओल्ल
ओल्ल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರಣಗೆಡ್ಡೆ<br><br>ओल्ल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೇವವಾದ /ಒದ್ದೆಯಾದ<br><b>विस्तारः - </b>"ओल्लस्तु शूरणे पुंसि स्यादाद्रे वाच्यलिङ्गकः" - मेदि० ।<br><br>

ओष
ओष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಹಿಸುವುಕೆ /ಸುಡುವುದು<br><b>निष्पत्तिः - </b>उप (दाहे) - भावे "घञ्" (३-३-१८)<br><br>ओष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉರಿತ /ಉರಿಯುವುದು<br><br>ओष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಯ ಮೊದಲಾದುವುಗಳ ಉರಿತ<br><br>ओष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೀದು ಹೋಗುವಿಕೆ<br><br>

ओषण
ओषण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಟುರಸ /ಕಾರ<br><b>निष्पत्तिः - </b>उष (दाहे) - कर्त० "ल्युः" (३-१-१३४)<br><br>ओषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ओष ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>उष (दाहे) - भावे "ल्युट्" (३-३-११५)<br><br>ओषण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಹಿಸುವ /ಸುಡುವ<br><b>निष्पत्तिः - </b>उष (दाहे) - कर्त० "ल्युः" (३-१-१३४)<br><br>ओषण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉರಿಯಿಸುವ<br><br>ओषण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಹಿಸುವಂತೆಮಾಡುವ /ಸುಡಿಸುವ<br><b>निष्पत्तिः - </b>उष (दाहे) + णिच् - कर्त० "ल्युः" (३-१-१३४)<br><br>ओषण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೀಯಿಸುವ<br><br>

ओषणी
ओषणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೀರೆಸೊಪ್ಪು<br><br>

ओषणीय
ओषणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಡಲು ಅರ್ಹವಾದ<br><b>निष्पत्तिः - </b>उष (दाहे) - "अनीयर्" (३-१-९६)<br><br>ओषणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಡಲು ಶಕ್ಯವಾದ<br><br>ओषणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಶ್ಯವಾಗಿ ಸುಡಬೇಕಾದ<br><br>

ओषितव्य
ओषितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ओषणीय ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>उष (दाहे) - "तव्यः" (३-१-९६)<br><br>

ओषत्
ओषत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಹಿಸುತ್ತಿರುವ /ಸುಡುತ್ತಿರುವ<br><br>ओषत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉರಿಯುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उष (दाहे) - "शतृ" (३-२-१२४)<br><br>

ओषन्ती
ओषन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ओषत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

ओषधि|ओषधी
ओषधि (धी)<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಫಲಬಿಟ್ಟ ಮೇಲೆ ಒಣಗುವ ಗಿಡ ಬಳ್ಳಿ ಮೊದಲಾದುವು<br><b>निष्पत्तिः - </b>डुधाञ् (धारणपोषणयोः) - "किः" (३-३-९३) । वा "ङीष्" (ग० ४-१-४५)<br><b>व्युत्पत्तिः - </b>ओषः धीयतेऽत्र<br><b>प्रयोगाः - </b>"अथौषधीनामधिपस्य वृद्धौ तिथौ च जामित्रगुणान्वितायाम्"<br><b>उल्लेखाः - </b>कुमा० ७-१<br><br>

ओषधिगर्भ|ओषधिनाथ
ओषधिगर्भ (नाथ)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>व्युत्पत्तिः - </b>ओषधीनां गर्भः उत्पत्तिर्यस्मात् ओषधीनां नाथो वा ।<br><b>विस्तारः - </b>ಬಾಳೆ ಬತ್ತದಪೈರು ಮೊದಲಾದ ಓಷಧಿಗಳು ಚಂದ್ರಕಿರಣ ಸಂಪರ್ಕದಿಂದ ಹುಟ್ಟುವುವಾದುದರಿಂದ ಈ ಹೆಸರು.<br><br>ओषधिगर्भ (नाथ)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>विस्तारः - </b>ಮಳೆಯ ಮೂಲಕ ಸೂರ್ಯನ ಕಿರಣ ಪ್ರವೇಶದಿಂದ ಓಷಧಿಗಳು ಉತ್ಪತ್ತಿ ಹೊಂದುವುದರಿಂದ ಈ ಹೆಸರು.<br><br>

ओषधिज
ओषधिज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>ओषधिभ्यो जायते<br><br>ओषधिज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಓಷಧಿಗಳಿಂದ ಹುಟ್ಟಿದ<br><b>प्रयोगाः - </b>"ज्वलयतौषधिजेन कृशानुना"<br><b>उल्लेखाः - </b>किरा० ५-१४<br><br>

ओषधिपति
ओषधिपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>व्युत्पत्तिः - </b>ओषधीनां पतिः<br><b>विस्तारः - </b>ಚಂದ್ರಕಿರಣಸ್ಪರ್ಶದಿಂದ ಓಷಧಿಗಳು ಪುಷ್ಟಿ ಹೊಂದುವುದರಿಂದ ಈ ಹೆಸರು.<br><br>ओषधिपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಪೂರ<br><br>ओषधिपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೋಮಲತೆ<br><br>ओषधिपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೈದ್ಯ<br><b>प्रयोगाः - </b>"अमृतद्रवैर्विदधब्जदृशामपमार्गमोषधिपतिः स्म करैः"<br><b>उल्लेखाः - </b>माघ० ९-३६<br><br>

ओषधिप्रस्थ
ओषधिप्रस्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಮವತ್ಪರ್ವತ<br><b>व्युत्पत्तिः - </b>ओषधियुक्तं प्रस्थमत्र<br><b>प्रयोगाः - </b>"इत्योषधिप्रस्थविलासिनीनां श्रृण्वन् कथाः श्रोत्रसुखास्त्रिनेत्रः"<br><b>उल्लेखाः - </b>कुमा० ७-६९<br><br>

ओषधीश
ओषधीश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>व्युत्पत्तिः - </b>ओषधीनामीशः<br><br>

ओषयत्
ओषयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಡಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>उष (दाहे) + णिच् - "शतृ" (३-२-१२४)<br><br>ओषयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉರಿಯಿಸುತ್ತಿರುವ<br><br>

ओषयन्ती
ओषयन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ओषयत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

ओषयितव्य
ओषयितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಶ್ಯವಾಗಿ ಸುಡಿಸಲ್ಪಡಬೇಕಾದ<br><br>ओषयितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಡಲು ಅರ್ಹವಾದ<br><br>ओषयितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಡಲು ಶಕ್ಯವಾದ<br><b>निष्पत्तिः - </b>उष (दाहे) + णिच् - "तव्यः" (३-१-९६)<br><br>

ओषित
ओषित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಡಿಸುವುದು<br><br>ओषित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉರಿಯಿಸುವುದು<br><b>निष्पत्तिः - </b>उष (दाहे) + णिच् - भावे "क्तः" (३-३-११४)<br><br>ओषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಡಿಸಲ್ಪಟ್ಟ<br><br>ओषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉರಿಯಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>उष (दाहे) + णिच् - कर्म० "क्तः" (३-२-१०२)<br><br>

ओषिषिषा
ओषिषिषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಡಲು ಇಚ್ಛೆ / ದಹಿಸಲು ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>उष (दाहे) + सन् - "अः" (३-३-१०२)<br><br>

ओषिषिषु
ओषिषिषु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಹಿಸಲು ಅಪೇಕ್ಷೆಯುಳ್ಳ /ಸುಡಲು ಇಚ್ಛೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>उष (दाहे) + सन् - "उः" (३-२-१६८)<br><br>

ओष्ठ
ओष्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತುಟಿ<br><b>निष्पत्तिः - </b>उष (दाहे) - "थन्" (उ० २-४)<br><b>व्युत्पत्तिः - </b>उष्यते उष्णाहारेण<br><b>प्रयोगाः - </b>"ततोऽनुकुर्याद्विशदस्य तस्य ताम्रौष्ठपर्यस्तरुचः स्मितस्य"<br><b>उल्लेखाः - </b>कुमा० १-४४<br><br>

ओष्ठी
ओष्ठी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಂಡೆಗಿಡ<br><b>विस्तारः - </b>ತೊಂಡೆಹಣ್ಣನ್ನು ತುಟಿಗಳಿಗೆ ಉಪಮಾನವಾಗಿ ವರ್ಣಿಸುವುದು ವಾಡಿಕೆ.<br><br>

ओष्ठक
ओष्ठक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತುಟಿ<br><b>निष्पत्तिः - </b>ओष्ठ - स्वार्थे "कः"<br><br>ओष्ठक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತುಟಿಯ ರಕ್ಷಣೆ ಶೃಂಗಾರ ಮೊದಲಾದುವುಗಳಲ್ಲಿ ಆಸಕ್ತನಾದ<br><b>निष्पत्तिः - </b>ओष्ठ - "कन्" (५-२-६६)<br><br>

ओष्ठ्य
ओष्ठ्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತುಟಿಯಲ್ಲು ಹುಟ್ಟುವ ವರ್ಣ /ತುಟಿಯ ಸಾಹಾಯ್ಯದಿಂದ ಉಚ್ಚರಿಸಲ್ಪಡುವ ಅಕ್ಷರ<br><b>निष्पत्तिः - </b>"यत्" (५-१-६)<br><b>व्युत्पत्तिः - </b>ओष्ठे भवः<br><b>प्रयोगाः - </b>"उपूपध्मानीयानामोष्ठौ"<br><b>उल्लेखाः - </b>सि० कौ०<br><br>

ओष्ण
ओष्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಬಿಸಿಯಾಗಿರುವ /ಬೆಚ್ಚಗಿರುವ<br><b>व्युत्पत्तिः - </b>आ ईषदुष्णम्<br><br>

ओहार
ओहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೂರ್ಮ /ಆಮೆ<br><b>विस्तारः - </b>"कूर्मः कच्छप ओहारः पञ्चगूढश्चतुर्गतिः" - वैज० ।<br><br>

औ
औ<br><br><b>कन्नडार्थः - </b>ಔಕಾರ<br><b>विस्तारः - </b>ವರ್ಣಮಾಲೆಯಲ್ಲಿ ಇದು ಕಂಠ ಮತ್ತು ಓಷ್ಠ ಸ್ಥಾನಗಳಲ್ಲಿ ಆಭ್ಯಂತರ ವಿವೃತಪ್ರಯತ್ನದಿಂದ ಹುಟ್ಟುವ ಒಂದು ಸ್ವರವರ್ಣ. ಉದಾತ್ತಾನುದಾತ್ತಸ್ವರಿತಗಳೆಂಬ ಭೇದಗಳಿಂದ ಮುರು ವಿಧವಾದ ಇದು ಅನುನಾಸಿಕ ಮತ್ತು ಅನನುಸಾಸಿಕಗಳೆಂಬ ಭೇದಗಳಿಂದ ಒಟ್ಟು ೬ ವಿಧವಾಗುವುದು.<br><br>औ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>औ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನಂತ /ಆದಿಶೇಷ<br><br>औ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದ /ಧ್ವನಿ<br><br>औ<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿ<br><b>विस्तारः - </b>"ओऔशब्दौ तु होहौव सम्बुद्ध्याह्वानयोर्मतौ । विधातरि क्रमाद्विष्णावोऔ शब्दावनव्ययौ" - हेम० ।<br><br>औ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಹ್ವಾನ /ಕರೆ<br><br>औ<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಬೋಧನೆ<br><b>विस्तारः - </b>"ओशब्दः कथितो हूतौ तथा सम्बोधनेऽपि च । स्त्री तु विश्वम्भरायां स्यात्पुमांस्तु निस्वने स्मृतः" - मेदि० ।<br><br>

औक्थिक
औक्थिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಕ್ಥವೆಂಬ ಸಾಮದ ಭಾಗವನ್ನು ಅಧ್ಯಯನ ಮಾಡುವ ಅಥವಾ ತಿಳಿದಿರುವ<br><b>निष्पत्तिः - </b>"ठक्" (४-२-६०)<br><b>व्युत्पत्तिः - </b>उक्थमधीते वेद वा<br><br>

औक्थिक्य
औक्थिक्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಔಕ್ಥಿಕರ ಸಂಪ್ರದಾಯ /ಔಕ್ಥಿಕರ ಧರ್ಮ ಮತ್ತು ಆಮ್ನಾಯ<br><b>निष्पत्तिः - </b>"ञ्यः" (४-३-१२९)<br><b>व्युत्पत्तिः - </b>औक्थिकानां धर्मः आम्नायो वा<br><br>

औक्ष
औक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೃಷಭ ಸಂಬಂಧವಾದ /ಎತ್ತುಗಳಿಂದ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०) । अनपत्ये निपा० (६-४-१७३)<br><b>व्युत्पत्तिः - </b>उक्ष्णामिदम्<br><br>

औक्षक
औक्षक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೃಷಭಗಳಸಮೂಹ /ಎತ್ತುಗಳ ಗುಂಫು<br><b>निष्पत्तिः - </b>"वुञ्" (४-२-३९)<br><b>व्युत्पत्तिः - </b>उक्ष्णां समूहः<br><b>प्रयोगाः - </b>"रोमन्थमन्थरचलद्गुरुसास्नमासाञ्चक्रे निमीलदलसेक्षणमौक्षकेण"<br><b>उल्लेखाः - </b>माघ० ५-६२<br><br>

औक्ष्ण
औक्ष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತಿನ ಸಂತತಿ /ವೃಷಭದ ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದ ಕರು<br><b>निष्पत्तिः - </b>"अण्" (४-१-९२)<br><b>व्युत्पत्तिः - </b>उक्ष्णोऽपत्यम्<br><br>

औग्रसेनि
औग्रसेनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಗ್ರಸೇನನ ಮಗ /ಕಂಸ<br><b>निष्पत्तिः - </b>"इञ्" (४-१-९५)<br><b>व्युत्पत्तिः - </b>उग्रसेनस्यापत्यम्<br><br>

औग्र्य
औग्र्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರೂರತನ /ಕ್ರೌರ್ಯ /ದಯೆಯಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>उग्रस्य भावः<br><b>विस्तारः - </b>ಇದು ೩೨ ವಿಧ ವ್ಯಭಿಚಾರಿಭಾವಗಳಲ್ಲೊಂದು. "निर्वेदावेगदैन्यश्रममगजडता औग्र्यमोहौ विबोधः-------" - सा० द० ३-१४१<br><br>

औचित्य
औचित्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕೃತಕ್ಕೆ ಯೋಗ್ಯವಾಗಿರುವಿಕೆ /ಪ್ರಕೃತಕ್ಕೆ ಅನುರೂಪವಾಗಿರುವಿಕೆ /ಪ್ರಕೃತಕ್ಕೆ ಉಪಯೋಗಕರವಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>उचितस्य भावः<br><br>

औचिती
औचिती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕೃತಕ್ಕೆ ಯೋಗ್ಯವಾಗಿರುವಿಕೆ /ಪ್ರಕೃತಕ್ಕೆ ಅನುರೂಪವಾಗಿರುವಿಕೆ /ಪ್ರಕೃತಕ್ಕೆ ಉಪಯೋಗಕರವಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीष्" (४-१-४१) । यलोपः (६-४-१५०)<br><b>प्रयोगाः - </b>"सामर्थ्यमौचिती देशः कालो व्यक्तिः स्वरादयः"<br><b>उल्लेखाः - </b>वाक्य०<br><br>

औजसिक
औजसिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶೂರ /ಪರಾಕ್ರಮಿ /ಶಕ್ತಿವಂತ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-२७)<br><b>व्युत्पत्तिः - </b>ओजसा वर्तते<br><br>

औजस्य
औजस्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಓಜಸ್ಸು /ತೇಜಸ್ಸು<br><b>निष्पत्तिः - </b>ओजस् - स्वार्थे "ष्यञ्" (वा० ५-१-१२४)<br><br>औजस्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಕ್ತಿ /ಬಲ<br><b>प्रयोगाः - </b>"दौर्गत्यादेरनौजस्यं दैन्यं मलिनतादिकृत्"<br><b>उल्लेखाः - </b>सा० द० ३-१४५<br><br>

औज्ज्वल्य
औज्ज्वल्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಳಪು /ಪ್ರಕಾಶ /ಕಾಂತಿ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>उज्ज्वलस्य भावः<br><br>

औडव
औडव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಕ್ಷತ್ರ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>उडूनामिदम्<br><br>

औडुप
औडुप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಂದ್ರನಿಂದ ಉಂಟಾದ<br><br>औडुप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೋಣಿಯ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अञ्" (४-२-७५)<br><b>व्युत्पत्तिः - </b>उडुपेन चन्द्रेण प्लवेन वा निवृत्तम्<br><br>

औडुपिक
औडुपिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೋಣಿಯಿಂದ ನದಿಯನ್ನು ದಾಟುವ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-५)<br><b>व्युत्पत्तिः - </b>उडुपेन तरति<br><br>औडुपिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೋಣಿಯ ಮೂಲಕ ಒಯ್ಯುವ /ದೋಣಿಯಿಂದ ಸಾಗಿಸುವ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-१५)<br><b>व्युत्पत्तिः - </b>उडुपेन हरति<br><br>

औत्कण्ठ्य
औत्कण्ठ्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆ /ಅಭಿಲಾಷೆ<br><br>औत्कण्ठ्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಸುಕತೆ /ಉತ್ಸಾಹದಿಂದ ಎದುರು ನೋಡುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>उत्कण्ठस्य भावः<br><br>

औत्कर्ष्य
औत्कर्ष्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಕರ್ಷ /ಶ್ರೇಷ್ಠತೆ /ಮೇಲ್ಮೆ<br><b>निष्पत्तिः - </b>उत्कर्ष - स्वार्थे "ष्यञ्" (वा० ५-१-१२४)<br><br>

औत्कृष्ट्य
औत्कृष्ट्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಕರ್ಷವಾಗಿರುವಿಕೆ /ಶ್ರೇಷ್ಠತೆ /ಮೇಲ್ಮೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>उत्कृष्टस्य भावः<br><br>

औत्तर
औत्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರ ದಿಕ್ಕಿನಲ್ಲಿ ವಾಸಿಸುವ<br><br>औत्तर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರದಿಕ್ಕಿನಲ್ಲಿರುವ /ಉತ್ತರದಿಕ್ಕಿಗೆ ಸಂಬಂಧಿಸಿದ<br><b>निष्पत्तिः - </b>उत्तर - "अण्" (४-३-१२०)<br><br>

औत्तरपथिक
औत्तरपथिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರದಿಕ್ಕಿನ ಮಾರ್ಗದಿಂದ ತರಲ್ಪಟ್ಟ<br><br>औत्तरपथिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರ ದಿಕ್ಕಿನ ಮಾರ್ಗದಿಂದ ಹೋಗುವ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-७७)<br><b>व्युत्पत्तिः - </b>उत्तरपथेनाहृतं गच्छति वा<br><br>

औत्तराधर्य
औत्तराधर्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲು ಕೀಳುಭಾವ /ಮೇಲೆ ಮತ್ತು ಕೆಳಗೆ ಇರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>उत्तराधरयोर्भावः<br><b>प्रयोगाः - </b>"सङ्घे चानौत्तराधर्ये"<br><b>उल्लेखाः - </b>पा० सू० (३-३-४२)<br><br>

औत्तराह
औत्तराह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದಿನ ದಿವಸಕ್ಕೆ ಸಂಬಂಧಿಸಿದ /ಮುಂದಿನ ದಿವಸದ<br><b>निष्पत्तिः - </b>उत्तराह - "अण्" (४-३-१२०)<br><br>औत्तराह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರ ದಿಕ್ಕಿನಿಂದ ಬಂದ /ಉತ್ತರದಿಕ್ಕಿನಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>उत्तर - "आहञ्" (वा० ८-३-१०१)<br><br>

औत्तरेय
औत्तरेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರೆಯ ಮಗ ಪರೀಕ್ಷಿತ್ತು<br><b>निष्पत्तिः - </b>"ढक्" (४-१-१२०)<br><b>व्युत्पत्तिः - </b>उत्तराया अपत्यम्<br><br>

औत्तानपादि
औत्तानपादि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತಾನಪಾದರಾಯನ ಮಗ /ಧ್ರುವಕುಮಾರ<br><b>निष्पत्तिः - </b>"इञ्" (४-१-९५)<br><b>व्युत्पत्तिः - </b>उत्तानपादस्यापत्यम्<br><br>

औत्पत्तिक
औत्पत्तिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಟ್ಟಿನಿಂದ ಬಂದ /ಹುಟ್ಟಿನಿಂದ ಉಂಟಾದ /ಸಹಜವಾದ /ಸ್ವಾಭಾವಿಕವಾದ<br><b>निष्पत्तिः - </b>"ठक्" (४-२-८०)<br><b>व्युत्पत्तिः - </b>उत्पत्त्या निवृत्तः<br><br>

औत्पात
औत्पात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಪಾತವನ್ನು ಸೂಚಿಸುವ ಗ್ರಂಥದ ವ್ಯಾಖ್ಯಾನ ಗ್ರಂಥ<br><b>निष्पत्तिः - </b>"अण्" (४-३-६६)<br><b>व्युत्पत्तिः - </b>उत्पास्य व्याख्यानः औत्पातो ग्रन्थः<br><br>

औत्पातिक
औत्पातिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಪಾತದಿಂದ ಉಂಟಾದ /ಧೂಮಕೇತು ಕಾಳ್ಗಿಚ್ಚು ಮುಂತಾದುವುಗಳಿಂದ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>"ठक्" (४-३-६७)<br><b>व्युत्पत्तिः - </b>उत्पाते भवम्<br><br>

औत्पाद
औत्पाद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಟ್ಟು ಅಥವಾ ಉತ್ಪತ್ತಿಗೆ ಸಂಬಂಧಿಸಿದ ಗ್ರಂಥವನ್ನು ತಿಳಿದಿರುವ ಅಥವಾ ಅಧ್ಯಯನ ಮಾಡುವ<br><br>

औत्स
औत्स<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರಿನ ಚಿಲುಮೆಯಲ್ಲಿರುವ /ನೀರಿನ ಬುಗ್ಗೆಯಲ್ಲಿರುವ /ಊಟೆಯಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"अञ्" (४-२-८६)<br><b>व्युत्पत्तिः - </b>उत्से भवः<br><br>

औत्सङ्गिक
औत्सङ्गिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಡೆಯಿಂದ ಸಾಗಿಸುವ /ಮಡಿಲಿನಿಂದ ಒಯ್ಯುವ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-१५)<br><b>व्युत्पत्तिः - </b>उत्सङ्गेन हरति<br><br>

औत्सर्गिक
औत्सर्गिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಮಾನ್ಯಶಾಸ್ತ್ರಕ್ಕೆ ಸಂಬಂಧಿಸಿದ /ಸಾಮಾನ್ಯ ನಿಯಮಕ್ಕೆ ಒಳಪಟ್ಟ /ಸಾಮಾನ್ಯ ಶಾಸ್ತ್ರದಿಂದ ಸಿದ್ಧವಾದ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-६३)<br><b>व्युत्पत्तिः - </b>उत्सर्गं सामान्यविधिमर्हति<br><br>

औत्सर्गिकी
औत्सर्गिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಮಾನ್ಯಶಾಸ್ತ್ರಕ್ಕೆ ಸಂಬಂಧಿಸಿದ /ಸಾಮಾನ್ಯ ನಿಯಮಕ್ಕೆ ಒಳಪಟ್ಟ /ಸಾಮಾನ್ಯ ಶಾಸ್ತ್ರದಿಂದ ಸಿದ್ಧವಾದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

औत्सुक्य
औत्सुक्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹ /ಪ್ರಿಯವಾದುದನ್ನು ಬೇಗ ಹೊಂದುವುದರಲ್ಲಿ ಅಪೇಕ್ಷೆ /ಕುತೂಹಲ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>उत्सुकस्य भावः<br><b>प्रयोगाः - </b>"औत्सुक्येन कृतत्वरा सहभुवा व्यावर्तमाना ह्रिया तैस्तैर्बन्धुवधूजनस्य वचनैर्नीताभिमुख्यं पुनः"<br><b>उल्लेखाः - </b>रत्ना० १-२<br><b>विस्तारः - </b>ಇದೊಂದು ವ್ಯಭಿಚಾರಿಭಾವ. "औत्सुक्योन्मादशङ्काः स्मृतिमतिसहिता व्याधिसन्त्रासलज्जाः" - सा० द० ३-१४१<br><br>औत्सुक्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಚ್ಛೆ /ಅಪೇಕ್ಷೆ /ಆಸೆ<br><b>प्रयोगाः - </b>"औत्सुक्यनिवृत्त्यर्थं यथा क्रियासु प्रवर्तते लोकः । पुरुषस्य विमोक्षार्थं प्रवर्तते तद्वदव्यक्तम् ॥"<br><b>उल्लेखाः - </b>सां० का० ५८<br><br>

औदञ्चन
औदञ्चन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೀಪಾಯಿನಲ್ಲಿರುವ /ನೀರು ಸೇದಲು ಅಥವಾ ನೀರನ್ನು ಒಯ್ಯುಲು ಉಪಯೋಗಿಸುವ ಮರದ ಅಥವಾ ಲೋಹದ ಪಾತ್ರೆಯಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>उदच्यते उत्क्षिप्य ध्रियतेऽस्मिन् उदञ्चनो जलपात्रम्, तस्येदम्<br><br>

औदनिक
औदनिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನದರಾಶಿ<br><b>निष्पत्तिः - </b>"ठक्" (४-२-४७)<br><b>व्युत्पत्तिः - </b>ओदनानां समूहः<br><br>औदनिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನ್ನವನ್ನು ಮಾಡುವವನು /ಅನ್ನ ಬೇಯಿಸುವ್ವನು /ಅಡಿಗೆಯವನು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-५५)<br><b>व्युत्पत्तिः - </b>ओदनं शिल्पमस्य<br><br>औदनिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನ್ನವನ್ನು ತಿನ್ನುವ ಸ್ವಭಾವದವನು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-६१)<br><b>व्युत्पत्तिः - </b>ओदनभोजनं शीलमस्य<br><br>औदनिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನ್ನವನ್ನು ಮಾರುವವನು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-५१)<br><b>व्युत्पत्तिः - </b>ओदनं पण्यमस्य<br><br>औदनिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನ್ನವನ್ನು ತಿನ್ನಲು ಹಿತವಾದ ವ್ಯಂಜನ<br><b>निष्पत्तिः - </b>"ठञ्" (४-४-१०३)<br><b>व्युत्पत्तिः - </b>ओदनभोजने साधु<br><br>औदनिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನ್ನವನ್ನು ತಿನ್ನುವುದು ಹಿತವಾಗಿರುವ ಮನುಷ್ಯ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-६५)<br><b>व्युत्पत्तिः - </b>ओदनभोजनं हितमस्मै<br><br>

औदन्वत
औदन्वत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>उदन्वत इदम्<br><br>

औदन्वती
औदन्वती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><b>प्रयोगाः - </b>"अन्तस्तन्वदिवारविन्दगहनान्यौदन्वतीनामपाम्"<br><b>उल्लेखाः - </b>दशा०<br><br>

औदपान
औदपान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರಿನ ಬಾಲಿ ಅಥವಾ ನೀರಿನ ಊಟೆ ಮೊದಲಾದುವುಗಳಿಂದ ಬಂದ ತೆರಿಗೆ<br><b>निष्पत्तिः - </b>"अण्" (४-३-७६)<br><b>व्युत्पत्तिः - </b>उदपानादागतः<br><br>औदपान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾವಿಯಲ್ಲಿರುವ /ಜಲಾಶಯದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>उदपन - "अञ्" (४-१-८६)<br><br>

औदपानी
औदपानी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>औदपान ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

औदयिक
औदयिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದಯಕಾಲದಲ್ಲಿರುವ<br><br>औदयिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಾಶಿಗಳ ಉದಯ ಲಗ್ನಕಾಲದಲ್ಲಿ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>"ठञ्" (४-३-११)<br><b>व्युत्पत्तिः - </b>उदये लग्नकाले भवः<br><br>

औदयिकी
औदयिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>औदयिक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

औदर
औदर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದರ ಸಂಬಂಧವಾದ /ಹೊಟ್ಟೆಯಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>उदरस्यायम्<br><b>प्रयोगाः - </b>"सिलं किमनलं भवेदनलमौदरं बाधितुं पयः प्रसूतिपूरकं किमु न धारकं सारसम्"<br><b>उल्लेखाः - </b>वैराग्यप०<br><br>

औदरिक
औदरिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಟ್ಟೆಬಾಕ /ತಿಂಡಿಪೋತ /ಹೊಟ್ಟೆ ತುಂಬುವುದರಲ್ಲಿ ಮಾತ್ರ ಉದ್ಯುಕ್ತನಾದವನು<br><b>निष्पत्तिः - </b>"ठक्" (५-२-६७)<br><b>व्युत्पत्तिः - </b>उदरे प्रसितः<br><b>प्रयोगाः - </b>"सर्वत्रौदरिकस्याभ्यावहार्यमेव विषयः"<br><b>उल्लेखाः - </b>विक्र० ३<br><br>

औदर्य
औदर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಟ್ಟೆಯಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"यत्" (५-१-६) । स्वार्थे "अण्" (५-४-३८)<br><b>व्युत्पत्तिः - </b>उदरे भवः<br><br>औदर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗರ್ಭವನ್ನು ಪ್ರವೇಶಿಸಿರುವ /ಗರ್ಭದಲ್ಲಿರುವ<br><b>प्रयोगाः - </b>"स त्वयाराधितः शुक्लो वितन्वन्मामकं यशः । छेत्ता ते हृदयग्रन्थिमौदर्यो ब्रह्मभावनः ॥"<br><b>उल्लेखाः - </b>भाग० ३-२४-४<br><br>

औदश्वित
औदश्वित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಧಭಾಗ ನೀರು ಬೆರೆಸಿದ ಮೊಸರಿನಲ್ಲಿ ಸಂಸ್ಕೃತವಾದ /ಮಜ್ಜಿಗೆಯಲ್ಲಿ ತಯಾರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"अण्" (४-२-१६)<br><b>व्युत्पत्तिः - </b>उदश्विति संस्कृतः<br><br>

औदश्वित्क
औदश्वित्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಧಭಾಗ ನೀರು ಬೆರೆಸಿದ ಮೊಸರಿನಲ್ಲಿ ಸಂಸ್ಕೃತವಾದ /ಮಜ್ಜಿಗೆಯಲ್ಲಿ ತಯಾರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>वा "ठक्" (४-२-१९) । ठस्य कः (७-३-५१)<br><br>

औदात्त्य
औदात्त्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ವೋತ್ಕೃಷ್ಟನಾಗಿರುವಿಕೆ /ಎಲ್ಲರಿಗಿಂತಲೂ ಮಿಗಿಲಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>उदात्तस्य भावः<br><b>प्रयोगाः - </b>"औदात्त्यं हि सर्वोत्कर्षेण वर्तनम्"<br><b>उल्लेखाः - </b>दशरू०<br><br>औदात्त्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದಾತ್ತಸ್ವರದಿಂದ ಕೂಡಿರುವಿಕೆ<br><br>

औदार्य
औदार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದಾರತೆ /ದೊಡ್ಡ ಮನಸ್ಸು /ಧಾರಾಳವಾದ ಮನಸ್ಸು<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>उदारस्य भावः<br><br>औदार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿನಯ /ಉತ್ತಮವಾದ ಶೀಲ /ಗಂಭೀರವಾದ ರೀತಿ<br><b>विस्तारः - </b>ಇದೊಂದು ನಾಯಿಕೆಯ ಸ್ವಾಭಾವಿಕ ಗುಣ. "औदार्यं विनयः सदा" - सा० द० ३-९७<br><br>औदार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಯಕನ ಸಾತ್ತ್ವಿಕಗುಣಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"शोभा विलासो माधुर्यं गाम्भीर्यं स्थैर्यतेजसी । ललैतौदार्यमित्यष्टौ सत्त्वजाः पौरुषा गुणाः ।"<br><b>उल्लेखाः - </b>सा० द० ३-५०<br><br>औदार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಕ್ಯದಲ್ಲಿರುವ ಅರ್ಥಸಂಪತ್ತು /ಮಾತಿನಲ್ಲಿರುವ ಅರ್ಥಪುಷ್ಟಿ<br><b>प्रयोगाः - </b>"स सौष्ठवौदार्यविशेषशालिनीं विनिश्चितार्थामिति वाचमाददे"<br><b>उल्लेखाः - </b>किरा० १३<br><br>

औदासीन्य
औदासीन्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದಾಸೀನತೆ /ಉಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>उदासीनस्य भावः<br><b>प्रयोगाः - </b>"पर्याप्तोऽसि प्रजाः पातुमौदासीन्येन वर्तितुम्"<br><b>उल्लेखाः - </b>रघु० १०-२५<br><br>औदासीन्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗೌರವ /ಅವಮರ್ಯಾದೆ /ತಾತ್ಸಾರ<br><br>औदासीन्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿರುತ್ಸಾಹ /ಜಡತೆ /ನಿರಾಸಕ್ತಿ<br><br>

औदास्य
औदास्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>औदासीन्य ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>उद् + आस (उपवेशने) - "अच्" (३-१-१३४) । "ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>उदास्ते इति उदासः । तस्य भावः<br><b>प्रयोगाः - </b>"औदास्यसंविदवलम्बितशून्यमुद्रामस्मिन् दृशोर्निपतितामवगम्य भैम्याः"<br><b>उल्लेखाः - </b>नैष० ११-१०१<br><br>

औदीच्य
औदीच्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರದೇಶದಿಂದ ಬಂದ<br><br>औदीच्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರದೇಶದ ಸಂಬಂಧವಾದ<br><br>औदीच्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತರದಿಕ್ಕಿನಲ್ಲಿರುವ<br><br>

औदुम्बर
औदुम्बर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಮ<br><b>विस्तारः - </b>"औदुम्बरः श्राद्धदेवे रोगभेदे नपुंसकम्" - मेदि०।<br><br>औदुम्बर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದೇಶ<br><br>औदुम्बर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದುಂಬರ ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದವರು<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>औदुम्बर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಕುಷ್ಠರೋಗ<br><br>औदुम्बर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅತ್ತಿಮರದ ತುಂಡು<br><br>औदुम्बर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅತ್ತಿಮರದ ರೆಂಬೆ /ಎಲೆ /ಹಣ್ಣು /ಅತ್ತಿಮರದ ಸಾಮಾನು ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>वा "अण्" (४-३-१३५)<br><b>प्रयोगाः - </b>"औदुम्बराणि पुष्पाणि श्वेतवर्णं च वायसम् । मत्स्यपादं जले पश्येन्न नारीहृदयस्थितम् ॥"<br><br>

औद्धत्य
औद्धत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಿನಯ /ಉದ್ದಟತನ /ಸೊಕ್ಕು<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>उद्धतस्य भावः<br><b>प्रयोगाः - </b>"असूयान्यगुणदीनामौद्धत्यादसहिष्णुता"<br><b>उल्लेखाः - </b>सा० द० ३-१६६<br><br>

औद्वाहिक
औद्वाहिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹಕಾಲದಲ್ಲಿ ಕನ್ಯೆಗೆ ಕೊಡಲ್ಪಟ್ಟ ಉಡುಗೊರೆ<br><b>निष्पत्तिः - </b>"ठक्" (५-१-९६)<br><b>व्युत्पत्तिः - </b>उद्वाहे उद्वाहकाले दीयते<br><b>प्रयोगाः - </b>"मैत्र्यमौद्वाहिकं चैव माधुपर्किकमेव च"<br><b>उल्लेखाः - </b>मनु० ९-२०६<br><br>

औधस
औधस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಚ್ಚಲಿನ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>ऊधस इदम्<br><br>

औधस्य
औधस्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಚ್ಚಲಿನಲ್ಲಿರುವ ಹಾಲು<br><b>निष्पत्तिः - </b>"यत्" (४-३-५५)<br><b>व्युत्पत्तिः - </b>ऊधसि भवम्<br><b>प्रयोगाः - </b>"औधस्यमिच्छामि तवोपभोक्तुं षष्ठांशमुर्व्यां इव रक्षितायाः"<br><b>उल्लेखाः - </b>रघु० २-६६<br><br>

औन्नत्य
औन्नत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತರ<br><br>औन्नत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಟ್ಟದಿಂದ ಅಥವಾ ಸಮುದ್ರಮಟ್ಟದಿಂದ ಇರುವ ಎತ್ತರ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>उन्नतस्य भावः<br><br>

औन्मुख्य
औन्मुख्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎದುರು ನೋಡುವಿಕೆ /ನಿರೀಕ್ಷಿಸುವಿಕೆ /ಆಸೆಯಿಂದಿರುವಿಕೆ<br><br>औन्मुख्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತತ್ಪರನಾಗಿರುವಿಕೆ /ಆಸಕ್ತಿಯಿಂದಿರುವಿಕೆ<br><br>औन्मुख्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಖವನ್ನು ಮೇಲಕ್ಕೆ ಎತ್ತಿಕೊಂಡಿರುವಿಕೆ /ಮೇಲುಮುಖವಾಗಿರುವಿಕೆ<br><br>औन्मुख्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಕೂಲವಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>उन्मुखस्य भावः<br><br>

औपकर्णिक
औपकर्णिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾಯಃಕಿವಿಯ ಮೇಲೆ ಅಥವಾ ಕಿವಿಯ ಹತ್ತಿರದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"ठक्" (४-३-४०)<br><b>व्युत्पत्तिः - </b>कर्णस्य समीपमुपकर्णम् । सामीप्ये अव्ययी० । उपकर्णं प्रायभवः<br><b>प्रयोगाः - </b>"यः स्वामी मम कान्तावानौपकर्णिकलोचनः"<br><b>उल्लेखाः - </b>भट्टि० ४-२४<br><br>

औपगव
औपगव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೋಪಾಲಕನ ಪುತ್ರ /ಗೊಲ್ಲರ ಮಗ<br><b>निष्पत्तिः - </b>"अण्" (४-१-९२)<br><b>व्युत्पत्तिः - </b>उपगतो गौरस्य उपगुर्गोपः । तस्यापत्यम्<br><br>

औपगवी
औपगवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೋಪಾಲಕನ ಪುತ್ರಿ /ಗೊಲ್ಲರ ಮಗಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

औपगवि
औपगवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ಧವ /ಬೃಹಸ್ಪತಿಯ ಶಿಷ್ಯ<br><br>औपगवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೃಹಸ್ಪತಿಯ ಮಗ<br><b>निष्पत्तिः - </b>"इञ्" (४-१-९५)<br><b>व्युत्पत्तिः - </b>उपगतो गां गिरिमित्युपगवो गीष्पतिः, तस्यापत्यम् ।<br><b>प्रयोगाः - </b>"क्षणमिव पुलिने यमस्वसुस्तां समुषित औपगविर्निशां ततोऽगात्"<br><b>उल्लेखाः - </b>भाग०३-४-२७<br><br>

औपग्रस्तिक
औपग्रस्तिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಹಣಕ್ಕೆ ಸಿಕ್ಕಿದ ಸೂರ್ಯ ಅಥವಾ ಚಂದ್ರ /ರಾಹುಕೇತುಗಳಿಂದ ಹಿಡಿಯಲ್ಪಟ್ಟಿದ್ದ ಸೂರ್ಯಚಂದ್ರರು<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-८०)<br><b>व्युत्पत्तिः - </b>उपग्रस्तं ग्रासकालं भूतः<br><br>

औपचारिक
औपचारिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಚಾರ /ಸೇವೆ /ಶುಶ್ರೂಷೆ<br><b>निष्पत्तिः - </b>उपचार - स्वार्थे "ठक्" (५-४-३४)<br><br>औपचारिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲಾಕ್ಷಣಿಕ /ಮುಖ್ಯವಲ್ಲದ ಅರ್ಥದಲ್ಲಿ ಮುಖ್ಯಾರ್ಥದಸಾದೃಶ್ಯದಿಂದ ಪ್ರಯೋಗಿಸಲ್ಪಡುವ ಪದ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-१०९)<br><b>व्युत्पत्तिः - </b>उपचारः प्रयोजनमस्य<br><br>

औपचारिकी
औपचारिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>औपचारिक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

औपच्छन्दसिक
औपच्छन्दसिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೈತಾಳೀಯ ಪ್ರಕರಣದಲ್ಲಿ ಮಾತ್ರಾವೃತ್ತದ ಒಂದು ಭೇದ<br><b>निष्पत्तिः - </b>"ठक्" (४-३-४०)<br><b>व्युत्पत्तिः - </b>जानुनो समीपमुपजानु । सामीप्ये अव्ययी० ।उपजानु प्रायभवः<br><b>प्रयोगाः - </b>"सङ्ग्रामे सर्वकर्मीणौ पाणी यस्योपजनुकौ"<br><b>उल्लेखाः - </b>भट्टि० ४-२५<br><br>

औपजानुक
औपजानुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾಯಃ ಮಂಡಿಯಲ್ಲಿ ಅಥವಾ ಮಂಡಿಯ ಸಮೀಪದಲ್ಲಿರುವ<br><br>

औपदेशिक
औपदेशिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪದೇಶದಿಂದ ಜೀವಿಸುವ /ಉಪಾಧ್ಯಾಯವೃತ್ತಿಯಿಂದ ಜೀವಿಸುವ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-१२)<br><b>व्युत्पत्तिः - </b>उपदेशेन जीवति<br><br>औपदेशिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪದೇಶಕ್ಕೆ ಸಂಬಂಧಿಸಿದ /ಆದ್ಯೋಚ್ಚಾರಣಕ್ಕೆ ಸಂಬಂಧಪಟ್ಟ<br><br>

औपधिक
औपधिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಂಚಕ /ಮೋಸಗಾರ /ಕಪಟಿ /ವೇಷಧಾರಿ /ಠಕ್ಕ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-१२)<br><b>व्युत्पत्तिः - </b>उपधिना जीवति<br><br>

औपधेय
औपधेय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಡಿಯ ಗಾಲಿ /ಚಕ್ರ<br><b>निष्पत्तिः - </b>उपधि - "ढञ्" (५-१-१३)<br><b>व्युत्पत्तिः - </b>उपधिीयते इत्युपधिः रथाङ्गम्, तदेव औपधेयम् ।<br><br>

औपनायनिक
औपनायनिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪನಯನಕ್ಕೆ ಸಂಬಂಧಿಸಿದ /ಉಪನಯನಕ್ಕೆ ಅರ್ಹವಾದ /ಉಪನಯನವೇ ಪ್ರಯೋಜನವಾಗಿ ಉಳ್ಳ<br><b>निष्पत्तिः - </b>"ठक्" (५-१-१०९)<br><b>व्युत्पत्तिः - </b>उपनयनं प्रयोजनमस्य<br><b>प्रयोगाः - </b>"एष प्रोक्तो द्विजातीनामौपनायनिको विधिः"<br><b>उल्लेखाः - </b>मनु० २-६८<br><br>

औपनिषत्क
औपनिषत्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪನಿಷತ್ತಿನ ಪ್ರವಚನದಿಂದ ಜೀವಿಸುವ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-१२)<br><b>व्युत्पत्तिः - </b>उपनिषदा जीवति<br><br>

औपनिषद
औपनिषद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><br>औपनिषद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪನಿಷತ್ತಿನ ವ್ಯಾಖ್ಯಾನ<br><b>निष्पत्तिः - </b>"अण्" (४-३-७३)<br><b>व्युत्पत्तिः - </b>उपनिषदि भवः उपनिषदो व्याख्यानो वा<br><br>औपनिषद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪನಿಷತ್ತಿನ ಸಂಬಂಧವಾದ /ವೇದಾಂತ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>उपनिषद् ब्रह्मविद्या, तस्या इदम्<br><br>औपनिषद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪನಿಷತ್ತಿನ ಅನುಯಾಯಿ /ವೇದಾಂತಿ<br><b>निष्पत्तिः - </b>"अण्" (४-२-५९)<br><b>व्युत्पत्तिः - </b>उपनिषद्मधीते वेत्ति वा<br><br>

औपनिषदी
औपनिषदी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪನಿಷತ್ತಿನ ಸಂಬಂಧವಾದ /ವೇದಾಂತ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><b>प्रयोगाः - </b>"एताश्चान्यांश्च सेवेत दीक्षा विप्रो वने वसन् । विविधाश्चौपनिषदीरात्मसंसिद्धये श्रुतीः ॥"<br><b>उल्लेखाः - </b>मनु० ६-२९<br><br>

औपनीविक
औपनीविक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾಯಃ ನೀವಿಯ ಸಮೀಪದಲ್ಲಿರುವ /ನಡುಕಟ್ಟಿನ ಹತ್ತಿರವಿರುವ<br><b>निष्पत्तिः - </b>"ठक्" (४-३-४०)<br><b>व्युत्पत्तिः - </b>उपनीवि नीवीसमीपे प्रायभवः<br><b>प्रयोगाः - </b>"बद्धो दुर्बलरक्षार्थमसिर्येनौपनीविकः"<br><b>उल्लेखाः - </b>भट्टि० ४-२६<br><br>औपनीविक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿೀವಿಯ ಸಮೀಪದಲ್ಲಿರುವ /ಹೆಂಗಸರ ಸೊಂಟದ ಸೀರೆಯ ಗಂಟಿನ ಹತ್ತಿರವಿರುವ<br><b>प्रयोगाः - </b>"औपनीविकमरुन्ध किल स्त्री वल्लभस्य करमात्मकराभ्याम्"<br><b>उल्लेखाः - </b>माघ० १०-६०<br><br>

औपपत्तिक
औपपत्तिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯುಕ್ತಿಯಿಂದ ಕಲ್ಪಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-७९)<br><b>व्युत्पत्तिः - </b>उपपत्त्या निवृत्तम्<br><br>औपपत्तिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯುಕ್ತವಾದ /ಯೋಗ್ಯವಾದ<br><br>औपपत्तिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಿದ್ಧವಾದ<br><b>प्रयोगाः - </b>"औपपत्तिकमाहारं प्रयच्छस्वेति भारत"<br><b>उल्लेखाः - </b>भा० अनु० ८७-२७<br><br>

औपपत्य
औपपत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಪತಿಯೊಡನೆ ಸಂಭೋಗ<br><b>प्रयोगाः - </b>"जुगुप्सितं हि सर्वत्र औपपत्त्यं कुलस्त्रियाः"<br><b>उल्लेखाः - </b>भाग० १०-२९-२६<br><br>

औपम्य
औपम्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾದೃಶ್ಯ /ಹೋಲಿಕೆ /ಸಾಮ್ಯ<br><b>निष्पत्तिः - </b>उपमा - स्वार्थे "ष्यञ्" (वा० ५-१-१२४)<br><b>प्रयोगाः - </b>"प्राणा यथात्मनोऽभीष्टा भूतानामपि ते तथा । आत्मौपम्येन भूतेषु दयां कुर्वन्ति साधवः ॥" "आत्मौपम्येन सर्वत्र समं पश्यति योऽर्जुन । सुखं वा यदि वा दुःखं स योगी परमो मतः ॥"<br><b>उल्लेखाः - </b>हितो० १-१२, गीता० ६-३२<br><br>

औपयिक
औपयिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಾಯ /ಯುಕ್ತಿ<br><b>निष्पत्तिः - </b>उपाय - स्वार्थे "ठक्" (५-४-३४)<br><b>प्रयोगाः - </b>"शिवमौपयिकं गरीयसीं फलनिष्पत्तिमदूषितायतिम्"<br><b>उल्लेखाः - </b>किरा० २-३५<br><br>औपयिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯೋಗ್ಯವಾದ /ಯುಕ್ತವಾದ<br><br>औपयिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಾಯದಿಂದ ಬಂದ /ಪ್ರಯತ್ನದಿಂದ ಲಬ್ಧವಾದ<br><b>प्रयोगाः - </b>"वृत्तमौपयिकं मन्ये भीष्मेण सह भारत"<br><b>उल्लेखाः - </b>भा० आदि० २२३-१२<br><br>

औपयिकी
औपयिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>औपयिक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><b>प्रयोगाः - </b>"अचिरादुपकर्तुराचरेदथ वात्मौपयिकीमुपक्रियाम्"<br><b>उल्लेखाः - </b>नैष० २-१४<br><br>

औपयौगिक
औपयौगिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಯೋಗಕ್ಕೆ ಬರುವ /ಉಪಯೋಗಕ್ಕೆ ಸಂಬಂಧಿಸಿದ /ಉಪಯೋಗವೇ ಪ್ರಯೋಜನವಾಗಿ ಉಳ್ಳ<br><b>निष्पत्तिः - </b>"ठक्" (५-१-१०९)<br><b>व्युत्पत्तिः - </b>उपयोगः प्रयोजनं कारणमस्य<br><b>प्रयोगाः - </b>"अथातः स्नेहौपयौगिकं चिकित्सितं व्याख्यास्यामः"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

औपयौगिकी
औपयौगिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಯೋಗಕ್ಕೆ ಬರುವ /ಉಪಯೋಗಕ್ಕೆ ಸಂಬಂಧಿಸಿದ /ಉಪಯೋಗವೇ ಪ್ರಯೋಜನವಾಗಿ ಉಳ್ಳ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

औपरिष्ट
औपरिष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲುಗಡೆ ಇರುವ /ಮೇಲುಭಾಗದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"अण्" (४-३-५३)<br><b>व्युत्पत्तिः - </b>उपरिष्टाद्भवः<br><br>

औपरोधिक
औपरोधिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಡೆಗೆ ಸಂಬಂಧಿಸಿದ /ಪ್ರತಿಬಂಧಕ ಸಂಬಂಧವಾದ /ತಡೆಯೇ ಪ್ರಯೋಜವಾಗಿ ಉಳ್ಳ<br><b>निष्पत्तिः - </b>"ठक्" (५-१-१०९)<br><b>व्युत्पत्तिः - </b>उपरोधः प्रयोजनमस्य<br><br>

औपल
औपल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಲಾಮಯವಾದ /ಶಿಲೆಯಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१३४)<br><b>व्युत्पत्तिः - </b>उपलस्य विकारः<br><b>प्रयोगाः - </b>"यथा ल्पवेनौपलेन निमज्जत्युदके तरन् । तथा निमज्जतोऽधस्तादज्ञौ दातृप्रतीच्छकौ ॥"<br><b>उल्लेखाः - </b>मनु० ४-१९४<br><br>औपल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಲಾ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>उपलाया इदम्<br><br>औपल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಲ್ಲುಗಳಿಂದ ಬಂದ ತೆರಿಗೆ /ಕಲ್ಲುಗಳ ಮಾರಾಟದಿಂದ ಬಂದ ಸುಂಕ<br><b>निष्पत्तिः - </b>"अण्" (४-३-७६)<br><b>व्युत्पत्तिः - </b>उपलादागतः<br><br>

औपवस्त
औपवस्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪವಾಸ /ಊಟಮಾಡದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>उप + वसु (स्तम्भे) भावे "क्तः" (३-३-११४) । स्वार्थे "अण्" (५-४-३८) । अनेकार्थत्वादभोजने वृत्तिः ।<br><b>प्रयोगाः - </b>"औपवस्तमेव कालान्तरे भोजनम्"<br><b>उल्लेखाः - </b>आप० ध० २-१-५<br><b>विस्तारः - </b>"औपवस्तं तूपवासः" - अम० ।<br><br>

औपवस्त्र
औपवस्त्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪವಾಸ<br><b>निष्पत्तिः - </b>उप + वसु (स्तम्भे) - "तृच्" (३-१-१३३) । "अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>उपवसति । उपवस्तुरिदं कर्म<br><br>

औपवास
औपवास<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪವಾಸಕ್ಕೆಸಂಬಂಧಿಸಿದ /ಉಪವಾಸ ಕಾಲದಲ್ಲಿ ಕೊಡಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>उपवास - "अण्" (५-१-९७)<br><b>व्युत्पत्तिः - </b>उपवासे उपवासकाले दीयते<br><br>

औपवासिक
औपवासिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪವಾಸಕ್ಕೆ ಅರ್ಹವಾದ /ಉಪವಾಸಕ್ಕೆ ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>"ठञ्" (४-४-१०३)<br><b>व्युत्पत्तिः - </b>उपवासे साधुः<br><br>औपवासिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪವಾಸಕ್ಕೆ ಶಕ್ತನಾದ /ಉಪವಾಸ ಮಾಡುವುದರಲ್ಲಿ ಸಮರ್ಥನಾದ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-१०१)<br><b>व्युत्पत्तिः - </b>उपवासाय प्रभवति<br><br>

औपवास्य
औपवास्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪವಾಸ<br><b>निष्पत्तिः - </b>उपवास - स्वार्थे "ष्यञ्" (वा० ५-१-१२४)<br><br>

औपवाह्य
औपवाह्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನ ವಾಹನ ಆನೆ ಕುದುರೆ ರಥ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>उपवाह्य - स्वार्थे "अण्" (५-४-३८)<br><b>प्रयोगाः - </b>"औपवाह्यमसौ मत्कमारुरुक्षति साम्प्रतम्"<br><b>उल्लेखाः - </b>याद० १६-४२<br><br>

औपवेशिक
औपवेशिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಳಿತುಕೊಳ್ಳುವುದರಿಂದ ಜೀವನ ನಡೆಸುವವನು /ಒಬ್ಬನಿಂದ ನಿಯುಕ್ತನಾಗಿ ಅವನಿಗಾಗಿ ಕುಳಿತು ತನ್ನ ಸೇವೆಯನ್ನು ಸಲ್ಲಿಸುವುದರಿಂದ ಜೀವಿಸುವವನು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-१२)<br><b>व्युत्पत्तिः - </b>उपवेशेन जीवति<br><br>

औपश्लेषिक
औपश्लेषिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏಕದೇಶದಲ್ಲಿಸಂಬಂಧ ಹೊಂದಿರುವ /ಒಂದು ಭಾಗದಲ್ಲಿ ಮಾತ್ರ ಸಂಬಂಧ ಹೊಂದಿರುವ<br><b>निष्पत्तिः - </b>"ठक्" (४-२-८०)<br><b>व्युत्पत्तिः - </b>उपश्लेषेण निवृत्तम्<br><br>औपश्लेषिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮೀಪ ಸಂಬಂಧ ಹೊಂದಿರುವ<br><br>

औपश्लेषिकी
औपश्लेषिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಏಕದೇಶದಲ್ಲಿಸಂಬಂಧ ಹೊಂದಿರುವ /ಒಂದು ಭಾಗದಲ್ಲಿ ಮಾತ್ರ ಸಂಬಂಧ ಹೊಂದಿರುವ<br><br>

औपसर्गिक
औपसर्गिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸನ್ನಿಪಾತ ವ್ಯಾಧಿ<br><b>प्रयोगाः - </b>"कफोऽनुलोमवातेन यदि पित्तानुगो भवेत् । स्वेदशैत्यादिभिर्जुष्टस्तदा भवति मानवः ॥ प्रतिलोमः पुनस्तेन स्वास्थ्यमायाति तत्क्षणात् । औपसर्गिक एवान्यः सन्निपात उदाहृतः ॥"<br><br>औपसर्गिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಸರ್ಗಸಂಬಂಧವಾದ /ಪೂರ್ವೋತ್ಪನ್ನವ್ಯಾಧಿಯನ್ನು ಅನುಸರಿಸಿ ಬರುವ ವ್ಯಾಧಿಸಂಬಂಧವಾದ /ಉಪದ್ರವ ಸಂಬಂಧವಾದ<br><b>प्रयोगाः - </b>"प्रसङ्गात् गात्रसंस्पर्शात् निःश्वासात् सहभोजनात् । सहशय्यासनाच्चापि वस्त्रमाल्यानुलेपनात् ॥ कुष्ठं ज्वरश्च शोषश्च नेत्राभिष्यन्द एव च । औपसर्गिक रोगाश्च सङ्क्रामन्ति नरान्नरम् ॥"<br><b>उल्लेखाः - </b>सुश्रुत० निदान० ५-३३,३४<br><br>औपसर्गिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರ ಪರಾ ಮುಂತಾದ ಉಪಸರ್ಗಗಳಿಗೆ ಸಂಬಂಧಿಸಿದ<br><br>

औपस्थान
औपस्थान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಾಸಕ /ಉಪಾಸನೆಯ ಸ್ವಭಾವದವನು<br><b>निष्पत्तिः - </b>"णः" (४-४-६२)<br><b>व्युत्पत्तिः - </b>उपस्थानं शीलमस्य<br><br>

औपस्थानिक
औपस्थानिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವೆಯಿಂದ ಅಥವಾ ಪೂಜೆಯಿಂದ ಜೀವಿಸುವವನು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-१२)<br><b>व्युत्पत्तिः - </b>उपस्थानेन जीवति<br><br>

औपस्थानिकी
औपस्थानिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವೆಯಿಂದ ಅಥವಾ ಪೂಜೆಯಿಂದ ಜೀವಿಸುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

औपस्थिक
औपस्थिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಭಿಚಾರದಿಂದ ಜೀವಿಸುವ /ಲೈಂಗಿಕ ವ್ಯಾಪಾರದಿಂದ ಜೀವನ ಮಾಡುವ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-१२)<br><b>व्युत्पत्तिः - </b>उपस्थेन उपस्थव्यापारेण जीवति<br><br>

औपस्थ्य
औपस्थ्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರತಿಸುಖ /ಸ್ತ್ರೀಸಂಭೋಗದ ಸೌಖ್ಯ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>उपस्थस्य भावः<br><b>प्रयोगाः - </b>"औपस्थ्यजैह्व्यकार्पण्यात् गृहपालायते जनः"<br><b>उल्लेखाः - </b>भाग० ७-१५-१८<br><br>

औपहस्तिक
औपहस्तिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಗ್ರಹದಿಂದ ಜೀವಿಸುವ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-१२)<br><b>व्युत्पत्तिः - </b>उपहस्तेन जीवति<br><br>

औपहारिक
औपहारिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಹಾರಕ್ಕೆ ಯೋಗ್ಯವಾದ ವಸ್ತು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-१०२)<br><b>व्युत्पत्तिः - </b>उपहारे साधु<br><br>

औपाकरण
औपाकरण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಾಕರ್ಮ ಸಂಬಂಧವಾದ /ಸಂಸ್ಕಾರಪೂರ್ವಕ ವೇದಾಧ್ಯಯನದ ಪ್ರಾರಂಭಕ್ಕೆ ಸಂಬಂಧಿಸಿದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>उपाकरणस्येदम्<br><br>औपाकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಾಕರ್ಮ<br><b>निष्पत्तिः - </b>स्वार्थे "अण्" (५-४-३८)<br><b>व्युत्पत्तिः - </b>उपाकरणमेव<br><b>प्रयोगाः - </b>"वैरमणो गुरुष्वष्टाक्य औपाकरण इति त्र्यहाः"<br><b>उल्लेखाः - </b>आप० ध० १-३-१०२<br><br>

औपाधिक
औपाधिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಶೇಷಗುಣನಿಮಿತ್ತವಾದ /ವಿಶೇಷಗುಣದಿಂದುಂಟಾದ<br><b>निष्पत्तिः - </b>"ठक्" (४-२-८०)<br><b>व्युत्पत्तिः - </b>उपाधिना निवृत्तः<br><br>

औपाधिकी
औपाधिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಗತವಾದ ಉಪಾಧಿಯಿಂದ ಕೂಡಿದ ಸಂಕೇತವುಳ್ಳ ಸಂಜ್ಞೆ<br><br>

औपाध्यायक
औपाध्यायक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಾಧ್ಯಾಯನಿಂದ ಬಂದ<br><b>निष्पत्तिः - </b>"वुञ्" (४-३-७७)<br><b>व्युत्पत्तिः - </b>उपाध्यायादागतः<br><br>

औपानह्य
औपानह्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾದರಕ್ಷೆಗೆ ಬೇಕಾದ ಸಲಕರಣೆ<br><b>निष्पत्तिः - </b>"ञ्यः" (५-१-१४)<br><b>व्युत्पत्तिः - </b>उपानहे अयम्<br><b>विस्तारः - </b>औपानह्यो मुञ्जः । औपानह्यं चर्म ।<br><br>

औपासन
औपासन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹಸ್ಥನು ಪ್ರಾತಃಕಾಲ ಮತ್ತು ಸಾಯಂಕಾಲಗಳಲ್ಲಿ ಹೋಮಕ್ಕಾಗಿ ಉಪಯೋಗಿಸುವ ಅಗ್ನಿ<br><b>निष्पत्तिः - </b>स्वार्थे "अण्" (५-४-३८)<br><b>व्युत्पत्तिः - </b>उपास्यते प्रतिदिनमित्युपासनोऽग्निः<br><br>औपासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹ್ಯಾಗ್ನಿಯಲ್ಲಿ ಪ್ರಾತಃಕಾಲ ಮತ್ತು ಸಾಯಂಕಾಲಗಳಲ್ಲಿ ಮಾಡುವ ಹೋಮ /ಅಗ್ನಿಕಾರ್ಯ<br><br>औपासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹವಿಸ್ಸು /ದೇವತೆಗಳಿಗೆ ಅರ್ಪಿಸುವ ಹೋಮದ್ರವ್ಯ<br><br>औपासन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಔಪಾಸನಾಗ್ನಿಗೆ ಸಂಬಂಧಿಸಿದ<br><br>औपासन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಕಾರ್ಯಕ್ಕೆ ಸಂಬಂಧಿಸಿದ<br><b>प्रयोगाः - </b>"वैतानौपासनाः कार्याः क्रियाश्च श्रुतिचोदनात्"<br><b>उल्लेखाः - </b>याज्ञ० ३-१७<br><br>

औमक
औमक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗಸೆ ಸೊಪ್ಪಿನಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ<br><br>औमक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗಸೆಗಿಡದ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>उमा - वा "वुञ्" (४-३-१५८)<br><b>व्युत्पत्तिः - </b>उमाया विकारोऽवयवो वा<br><br>

औमम्
औमम्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>औमक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>पक्षे "अण्" (४-३-१३४)<br><br>

औमिक
औमिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗಸೆಯ ಪ್ರಾಪ್ತಿಯನ್ನು ಸೂಚಿಸುವ ಸಂಯೋಗ ಅಥವಾ ಉತ್ಪಾತ<br><b>निष्पत्तिः - </b>वा "ठक्" (५-१-३८)<br><b>व्युत्पत्तिः - </b>उमाया निमित्तं संयोगः उत्पातो वा<br><br>

औमिीन
औमिीन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸೆಗಿಡವನ್ನು ಬೆಳೆಯಲು ಯೋಗ್ಯವಾದ ಭೂಮಿ<br><b>निष्पत्तिः - </b>वा "खञ्" (५-२-१)<br><b>व्युत्पत्तिः - </b>उमानां भवनं क्षेत्रं<br><br>

उम्य
उम्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸೆಗಿಡವನ್ನು ಬೆಳೆಯಲು ಯೋಗ್ಯವಾದ ಭೂಮಿ<br><b>निष्पत्तिः - </b>पक्षे "यत्" (५-१-३८)<br><br>

औरग
औरग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪದೇವತಾಕವಾದ ಆಶ್ಲೇಷಾನಕ್ಷತ್ರ<br><b>निष्पत्तिः - </b>"अण्" (४-२-२४)<br><b>व्युत्पत्तिः - </b>उरगो देवताऽस्य<br><br>औरग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸರ್ಪಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>उरगस्येदम्<br><br>

औरभ्र
औरभ्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುರಿಯ ತುಪ್ಪಟದಿಂದ ತಯಾರಾದಕಂಬಳಿ<br><br>औरभ्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುರಿಯ ಮಾಂಸ<br><br>औरभ्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುರಿಯ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>उरभ्रस्येदम्<br><b>प्रयोगाः - </b>"औरभ्रेणाथ चतुरः शाकुनेनाथ पञ्च वै"<br><b>उल्लेखाः - </b>मनु० ३-२६८<br><br>

औरभ्रक
औरभ्रक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುರಿಗಳ ಗುಂಪು/ಕುರಿಗಳ ಮಂದೆ<br><b>निष्पत्तिः - </b>"वुञ्" (४-२-३९)<br><b>व्युत्पत्तिः - </b>उरभ्राणां समूहः<br><br>

औरभ्रिक
औरभ्रिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುರಿಯನ್ನು ಮಾರಿ ಜೀವಿಸುವವನು /ಕುರಿಯನ್ನು ಸಾಕಿ ಮಾರುವುದರಿಂದ ಜೀವನ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>"ठञ्" (४-४-५१)<br><b>व्युत्पत्तिः - </b>उरभ्रः पण्यमस्य<br><b>प्रयोगाः - </b>"औरभ्रिको माहिषिकः परपूर्वापतिस्तथा"<br><b>उल्लेखाः - </b>मनु० ३-१६६<br><br>

औरस
औरस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಟ್ಟೆಯಲ್ಲಿ ಹುಟ್ಟಿದ ಮಗ /ಮದುವೆಯಾದ ಸವರ್ಣಹೆಂಹಸಿನಲ್ಲಿ ಹುಟ್ಟಿದ ಮಗ<br><b>निष्पत्तिः - </b>"अण्" (४-४-९४)<br><b>व्युत्पत्तिः - </b>उरसा निर्मितः<br><b>प्रयोगाः - </b>"इत्थं नागस्त्रिभुवनगुरोरौरसं मैथिलेयं लब्ध्वा बन्धुं तमपि च कुशः पञ्चमं तक्षकस्य"<br><b>उल्लेखाः - </b>रघु० १६-८८<br><b>विस्तारः - </b>"स्वक्षेत्रे संस्कृतायां तु स्वयमुत्पादयेद्धि यम् । तमौरसं विजानीयात् पुत्रम् प्रथमकल्पितम् ॥" - मनु० ९-१६६ । ಅಸವರ್ಣ ಹೆಂಗಸಿನಲ್ಲಿ ಜನಿಸಿದವನಲ್ಲಿಯೂ ಈ ಪ್ರಯೋಗವುಂಟು. "अजानन्नर्जुनश्चापि निहतं पुत्रमौरसम्" - भा० भीष्म० ९०-८५ ।<br><br>औरस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನ ಎದೆಯಲ್ಲಿ ಹುಟ್ಟಿದ /ಎದೆಯಿಂದ ಉತ್ಪನ್ನವಾದ<br><br>

औरसी
औरसी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಟ್ಟೆಯಲ್ಲಿ ಹುಟ್ಟಿದ ಮಗಳು /ಮದುವೆಯಾದ ಸವರ್ಣಹೆಂಹಸಿನಲ್ಲಿ ಹುಟ್ಟಿದ ಮಗಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

औरसिक
औरसिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಕ್ಷಸ್ಸಿನಂತಿರುವ /ಎದೆಯ ಹಾಗಿರುವ<br><b>निष्पत्तिः - </b>"ठक्" (५-३-१०८)<br><b>व्युत्पत्तिः - </b>उर इव<br><br>

औरस्य
औरस्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಕ್ಷಸ್ಸಿಗೆ ಹಿತವಾದ /ಎದೆಗೆ ಹಿತವಾದ<br><b>निष्पत्तिः - </b>"यत्" (५-१-६) । स्वार्थे "अण्" (५-४-३८)<br><b>व्युत्पत्तिः - </b>उरसे हितम्<br><br>

और्ण
और्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುರಿಯ ತುಪ್ಪಟದಿಂದ ತಯಾರಾದ ಕಂಬಳಿ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>"अण्" (४-३-१३४)<br><b>व्युत्पत्तिः - </b>ऊर्णाया विकारः<br><br>

और्णक
और्णक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುರಿಯ ತುಪ್ಪಟದಿಂದ ತಯಾರಾದ ಕಂಬಳಿ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>वा "वुञ्" (४-३-१५८)<br><br>

और्णिक
और्णिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಣ್ಣೆಯ ಪ್ರಾಪ್ತಿಯನ್ನು ಸೂಚಿಸುವ ಸಂಯೋಗ ಅಥವಾ ಉತ್ಪಾತ<br><b>निष्पत्तिः - </b>"ठक्" (५-१-३८)<br><b>व्युत्पत्तिः - </b>ऊर्णाया निमित्तं संयोगः उत्पातो वा<br><br>

और्ध्वकालिक
और्ध्वकालिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದಿನ ಕಾಲದ /ಮುಂದಿನ ಕಾಲದ ಸಂಬಂಧವಾದ<br><br>

और्ध्वदेह
और्ध्वदेह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊರ್ಧ್ವದೇಹ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>ऊर्ध्वदेहस्येदम्<br><br>

और्ध्वदैहिक
और्ध्वदैहिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊರ್ಧ್ವದೇಹವನ್ನು ಹೊಂದಿಸಲು ನಡೆಸುವ ಶಾಸ್ತ್ರೋಕ್ತವಾದ ಕ್ರಿಯೆ /ಅಪರ ಕ್ರಿಯೆ<br><b>निष्पत्तिः - </b>"ठक्" (५-१-१०९)<br><b>व्युत्पत्तिः - </b>ऊर्ध्वदेहः प्रयोजनमस्य<br><br>

और्व
और्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೃಗುವಂಶದ ಒಬ್ಬ ಋಷಿ<br><b>निष्पत्तिः - </b>"अण्" (४-३-२५)<br><b>व्युत्पत्तिः - </b>ऊरौ जातः<br><b>प्रयोगाः - </b>"अनेनैव हि विख्यातो नाम्ना लोकेषु सत्तमः । स और्व इति विप्रर्षिरूरुं भित्त्वा व्यजायत ॥"<br><b>उल्लेखाः - </b>भा० आदि० १९५-८<br><br>और्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಡಬಾಗ್ನಿ<br><br>और्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೂಮಿಯ ಸಂಬಂಧವಾದ<br><br>और्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಡೆಯಿಂದ ಉತ್ಪನ್ನವಾದ<br><br>

और्वर
और्वर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೂಮಿಯ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>उर्वराया अयम्<br><b>प्रयोगाः - </b>"किमपैति रजोभिरौर्वरैरवकीर्णस्य मणेर्महार्धता"<br><b>उल्लेखाः - </b>माघ० १६-२७<br><br>

और्वशेय
और्वशेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಊರ್ವಶಿಯ ಮಗ<br><br>और्वशेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸ್ತ್ಯ ಮಹರ್ಷಿ<br><b>निष्पत्तिः - </b>"ढक्" (४-१-१२०)<br><b>व्युत्पत्तिः - </b>ऊर्वश्या अपत्यम्<br><br>

औलूक
औलूक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಲೂಕಗಳಸಮೂಹ /ಗೂಬೆಗಳ ಗುಂಪು<br><b>निष्पत्तिः - </b>"अञ्" (४-२-४५)<br><b>व्युत्पत्तिः - </b>उलूकानां समूहः<br><br>

औलूक्य
औलूक्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಲೂಕನ ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದವನು /ಕಣಾದ ಮಹರ್ಷಿ<br><b>निष्पत्तिः - </b>"यञ्" (४-१-१०५)<br><b>व्युत्पत्तिः - </b>उलूकस्य गोत्रापत्यं पुमान्<br><br>औलूक्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೈಶೇಷಿಕ ದರ್ಶನದ ಅನುಯಾಯಿ<br><br>

औलूक्यदर्शन
औलूक्यदर्शन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೈಶೇಷಿಕ ದರ್ಶನ<br><br>

औलूखल
औलूखल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒರಳಿನಿಂದ ಬಂದ /ಒರಳಿನಲ್ಲಿ ಅರೆಯಲ್ಪಟ್ಟ ಅಥವಾ ಪುಡಿ ಮಾಡಲ್ಪಟ್ಟ<br><br>

औशनस
औशनस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಶನಸ್ಸಿನ ಮಗ /ಶುಕ್ರಾಚಾರ್ಯರ ಮಗ<br><br>औशनस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಶನಸ್ಸಿನ ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><br>औशनस<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಶನಸ್ಸಿನಿಂದ ರಚಿತವಾದ ಒಂದು ಉಪಪುರಾಣ<br><br>औशनस<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಶನಸ್ಸಿನಿಂದ ರಚಿತವಾದ ಒಂದು ಸ್ಮೃತಿ<br><br>औशनस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಶನಸ್ಸಿಗೆ ಸಂಬಂಧಿಸಿದ<br><br>

औशीनर
औशीनर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಶೀನರನಿಗೆ ಯಯಾತಿಯ ಮಗಳಾದ ಮಾಧವಿಯಲ್ಲಿ ಜನಿಸಿದ ಒಬ್ಬ ಮಗ /ಶಿಬಿಚರ್ಕವರ್ತಿ<br><b>निष्पत्तिः - </b>"अञ्" (४-१-८६)<br><b>व्युत्पत्तिः - </b>उशीनरस्यापत्यम्<br><br>

औशीनरी
औशीनरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುರೂರವಸ್ಸಿನ ಪತ್ನಿ<br><br>

औशीर
औशीर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಯನ /ಹಾಸಿಗೆ<br><br>औशीर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಸನ<br><br>औशीर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಮರದಂಡ /ಚಾಮರದ ಹಿಡಿ<br><br>औशीर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಮರ<br><br>औशीर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಂಡ /ಕೋಲು<br><br>औशीर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲಾಮಂಚದ ಬೇರಿನಿಂದ ತಯಾರಾದ /ಲಾಮಂಚದ ಬೇರಿನ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>उशीर - "अण्" (४-३-१२०)<br><b>विस्तारः - </b>"औशीरं शयनासनचामरदण्डेऽप्युशीरजे प्रोक्तम्" - मेदि० । "उशीरजे चामरे च दण्डे च" -हेम० ।<br><br>

औषध
औषध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಔಷಧ /ಮೂಲಿಕೆಗಳು ಶುಂಠಿ ಮೆಣಸು ಮೊದಲಾದ ವಸ್ತುಗಳಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ ಮದ್ದು<br><b>निष्पत्तिः - </b>ओषधि - "अण्" (५-४-३७)<br><br>औषध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಔಷಧ ದ್ರವ್ಯ /ಔಷಧಕ್ಕಾಗಿ ಉಪಯೋಗಿಸುವ ಮೂಲಿಕೆಗಳು<br><b>निष्पत्तिः - </b>ओषधि - स्वार्थे "अण्" (५-४-३७)<br><b>प्रयोगाः - </b>"द्वेष्योऽपि सम्मतः शिष्टः तस्यार्तस्य यथौषधम्"<br><b>उल्लेखाः - </b>रघु० १-२८<br><br>

औषधि|औषधी
औषधि (धी)<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>औषध ಪದದ ಅರ್ಥ<br><b>प्रयोगाः - </b>"नयशालिनि श्रिय इवाधिपतौ विरमन्ति न ज्वलितुमौषधयः"<br><b>उल्लेखाः - </b>किरा० ५-२४<br><br>

औषधिीय
औषधिीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಔಷಧಿ ಸಂಬಂಧವಾದ ಮೂಲಿಕೆ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>औषध - "छः" (४-२-११४)<br><br>

औषर
औषर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚೌಳು ಭೂಮಿಯ ಮಣ್ಣಿನಿಂದ ತೆಗೆದ ಉಪ್ಪು<br><b>निष्पत्तिः - </b>"अण्" (४-३-५३)<br><b>व्युत्पत्तिः - </b>ऊषरे भवम्<br><br>

औषस
औषस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಷಃಕಾಲದಲ್ಲಿ ಉಂಟಾದ /ಉಷಃಕಾಲದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१६)<br><b>व्युत्पत्तिः - </b>उषसि भवः<br><br>औषस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಷಃಕಾಲ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>उषस इदम्<br><b>प्रयोगाः - </b>"औषसातपभयादपलीनं वानरच्छविविरामपटीयः"<br><b>उल्लेखाः - </b>किरा० ९-११<br><br>

औषसी
औषसी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>औषस ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

औषसिक
औषसिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾತಃಕಾಲದಲ್ಲಿ ಸಂಚರಿಸುವ /ಬೆಳಗ್ಗೆ ಓಡಾಡುವ<br><b>निष्पत्तिः - </b>उषस्- "ठक्" (४-४-८)<br><b>व्युत्पत्तिः - </b>उषसा चरति<br><br>औषसिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಾತಃಕಾಲದಲ್ಲಿ ಹುಟ್ಟಿದ /ಬೆಳಗ್ಗೆ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>"ठञ्" (४-३-११)<br><b>व्युत्पत्तिः - </b>उषसि भवः<br><br>

औषसिकी
औषसिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>औषसिक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

औष्ट्र
औष्ट्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಷ್ಟ್ರ ಸಂಬಂಧವಾದ /ಒಂಟೆಯಿಂದ ಉಂಟಾದ /ಒಂಟೆಯಿಂದ ಉತ್ಪನ್ನವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>उष्ट्रस्येदम्<br><b>प्रयोगाः - </b>"अनिर्दशाया गोःक्षीरमौष्ट्रमेकशफं तथा"<br><b>उल्लेखाः - </b>मनु० ५-८<br><br>

औष्ट्रक
औष्ट्रक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂಟೆಗಳ ಸಮೂಹ /ಒಂಟೆಗಳ ಗುಂಪು<br><b>निष्पत्तिः - </b>"वुञ्" (४-२-३९)<br><b>व्युत्पत्तिः - </b>उष्ट्राणां समूहः<br><br>औष्ट्रक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂಟೆಯಿಂದ ಉಂಟಾದ /ಒಂಟೆಯಿಂದ ಉತ್ಪನ್ನವಾದ<br><b>निष्पत्तिः - </b>"वुञ्" (४-३-१५७)<br><b>व्युत्पत्तिः - </b>उष्ट्रस्य विकारो अवयवो वा<br><br>

औष्ट्ररथ
औष्ट्ररथ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಷ್ಟ್ರರಥ ಸಂಬಂಧವಾದ /ಒಂಟೆಯಿಂದ ಎಳೆಯಲ್ಪಡುವ ರಥದ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>उष्ट्ररथस्येदम्<br><br>

औष्ट्रायण
औष्ट्रायण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಷ್ಟ್ರ ಶಿಶು /ಒಂಟೆಯ ಮರಿ<br><b>निष्पत्तिः - </b>"फक्" (४-१-१०१)<br><b>व्युत्पत्तिः - </b>उष्ट्रस्यापत्यम्<br><br>

औष्ट्रायणक
औष्ट्रायणक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂಟೆಮರಿಗೆ ಸಂಬಂಧಿಸಿದ<br><br>औष्ट्रायणक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂಟೆಮರಿಗೆಸಮೀಪದ ದೇಶ<br><br>औष्ट्रायणक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂಟೆಮರಿಯು ವಾಸಮಾಡುವ ದೇಶ<br><br>औष्ट्रायणक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂಟೆಮರಿಯಿಂದ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>उष्ट्रायन - चतुरर्थ्यां "वुञ्" (४-२-८०)<br><br>

औष्ट्रिक
औष्ट्रिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂಟೆಯಲ್ಲಿ ಉಂಟಾದ /ಒಂಟೆಯಲ್ಲಿರುವ /ಒಂಟೆಯಿಂದ ಉತ್ಪನ್ನವಾದ<br><b>निष्पत्तिः - </b>"ठक्" (४-२-८०)<br><b>व्युत्पत्तिः - </b>उष्ट्रेण निवृत्तम्<br><b>प्रयोगाः - </b>"विपाको कटु सक्षारं गुरु भेद्यौष्ट्रिकं दधि"<br><b>उल्लेखाः - </b>सुश्रुत० सूत्र० ४५-७०<br><br>

औष्ठ्य
औष्ठ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಓಷ್ಠ ಸ್ಥಾನದಲ್ಲಿ ಹುಟ್ಟುವ ವರ್ಣ /ತುಟಿಯಲ್ಲಿ ಹುಟ್ಟುವ ವರ್ಣ<br><b>निष्पत्तिः - </b>"यत्" (४-३-५५) । स्वार्थे "अण्" (५-४-३८)<br><b>व्युत्पत्तिः - </b>ओष्ठे भवः<br><b>प्रयोगाः - </b>"तालव्या ओष्ठजावुपू"<br><b>उल्लेखाः - </b>पा० शि०<br><br>

औष्ण्य
औष्ण्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಷ್ಣತೆ /ಶಾಖ /ಬಿಸಿ /ಸಂತಾಪ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>उष्णस्य भावः<br><br>

औष्म्य
औष्म्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಷ್ಣತೆ /ಶಾಖ /ಬಿಸಿ /ಸಂತಾಪ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>उष्मणो भावः<br><b>प्रयोगाः - </b>"पूर्वराजवियोगौष्म्यं कृत्स्नस्य जगतो हृतम्"<br><b>उल्लेखाः - </b>रघु० १७-३३<br><br>

क
क<br><br><b>कन्नडार्थः - </b>ಕಕಾರ<br><b>विस्तारः - </b>ಇದು ವ್ಯಂಜನಾಕ್ಷರಗಳಲ್ಲಿ ಮೊದಲನೆಯ ಮತ್ತು ಆಭ್ಯಂತರ ಸ್ಪೃಷ್ಟಪ್ರಯತ್ನದಿಂದ ಕಂಠದಲ್ಲಿ ಹುಟ್ಟುವ ಅಕ್ಷರ. "कादयो मावसानाः स्पर्शाः । स्पृष्टं प्रयतनं स्पर्शानाम्" - सि० कौ० ।<br><br>क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ<br><br>क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹೇಶ್ವರ<br><br>क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥ<br><br>क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ<br><br>क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯು<br><br>क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಮ<br><br>क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮ<br><br>क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷಬ್ರಹ್ಮ<br><br>क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಯೂರ /ನವಿಲು<br><br>क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ತ /ಮನಸ್ಸು<br><br>क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿ<br><br>क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಡೆತದ ಶಬ್ದ /ಏಟಿನ ಸದ್ದು<br><br>क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಡಲು /ಸಮುದ್ರ<br><br>क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿಬಣ್ಣ<br><br>क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸು<br><br>क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ಯುತಿ /ಪ್ರಕಾಶ<br><br>क<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿರಸ್ಸು /ತಲೆ<br><br>क<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು /ಜಲ<br><br>क<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಖ<br><b>निष्पत्तिः - </b>क (शब्दे) - "डः" (३-२-१०१)<br><b>विस्तारः - </b>"को ब्रह्मात्मानिलाकाग्निचित्तधीयमकेकिषु । विष्णावाहतशब्देऽब्धौ सितवर्णे वसौ द्युतौ । कं शिरोऽम्बुसुखे क्लीबं तत्रैव च कमव्ययम्" - नानार्थर० । "मारुते वेधसि ब्रध्ने पुंसि कः कं शिरोऽम्बुनोः" - अम० ।<br><br>क<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ತದ್ಧಿತ ಪ್ರತ್ಯಯ<br><b>विस्तारः - </b>पुत्रकः, वृक्षकः इत्यादि ।ಕೊನೆಯ ೩ ಅರ್ಥಗಳಲ್ಲಿ ಅವ್ಯಯವೂ ಉಂಟು.<br><br>

कंस
कंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾನಪಾತ್ರೆ /ಕುಡಿಯುವ ಪಾತ್ರೆ /ಲೋಟ ಬಟ್ಟಲು ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>कमु (कान्तौ) - "सः"(उ० ३-६२)<br><b>व्युत्पत्तिः - </b>कम्यते<br><b>विस्तारः - </b>"कंसोऽस्त्री पानभाजनम्" - अम० ।<br><br>कंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂಸ್ಯಲೋಹ /ಕಂಚು<br><br>कंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಢಕವೆಂಬ ಒಂದು ಅಳತೆ /ಒಂದು ಕೊಳಗ<br><br>कंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಗ್ರಸೇನನ ಮಗ ಕಂಸ /ದೇವಕಿಯ ದೊಡ್ಡಪ್ಪನ ಮಗ<br><br>

कंसक
कंसक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂಸ್ಯ /ಕಂಚು<br><b>निष्पत्तिः - </b>स्वार्थे - "कन्" (५-४-२९)<br><b>व्युत्पत्तिः - </b>कंसमेव<br><br>कंसक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಚಿನ ಪಾತ್ರೆ /ಲೋಟ ಬಟ್ಟಲು ಮುಂತಾದುದು<br><br>

कंसकार
कंसकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಚುಗಾರ /ಕಂಚಿನ ಪಾತ್ರೆಯನ್ನು ತಯಾರಿಸುವವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कंसं तन्मयपात्रं करोति<br><br>

कंसकृष्
कंसकृष्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣ<br><b>निष्पत्तिः - </b>कृष (विलेखने) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>कंसं कृष्टवान्<br><b>प्रयोगाः - </b>"महामहानीलशिलारुचः पुरो निषेदिवान् कंसकृषः स विष्टरे"<br><b>उल्लेखाः - </b>माघ० १-१६<br><br>

कंसजित्
कंसजित्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣ<br><b>निष्पत्तिः - </b>जि (जये) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>कंसं जितवान्<br><br>

कंसनिषूदन
कंसनिषूदन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣ<br><b>निष्पत्तिः - </b>नि + षूद (क्षरणे) + णिच् - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कंसं निषूदयति<br><br>

कंसरिपु
कंसरिपु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣ<br><b>व्युत्पत्तिः - </b>कंसस्य रिपुः<br><br>

कंसाराति
कंसाराति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣ<br><b>व्युत्पत्तिः - </b>कंसस्य आरातिः<br><br>

कंसारि
कंसारि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣ<br><b>व्युत्पत्तिः - </b>कंसस्य अरिः<br><br>

कंसवती
कंसवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಗ್ರಸೇನನ ಮಗಳು /ಕಂಸನ ತಂಗಿ /ವಸುದೇವನ ತಮ್ಮ ದೇವಶ್ರವಸ್ಸಿನ ಪತ್ನಿ<br><br>

कंसा
कंसा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಸನ ತಂಗಿ /ವಸುದೇವನ ತಮ್ಮನಾದ ದೇವಭಾಗನ ಪತ್ನಿ /ಉಗ್ರಸೇನನ ಮಗಳು<br><b>प्रयोगाः - </b>"कंसा कंसवती कङ्का शूरभू राष्ट्रपालिका । उग्रसेनदुहितरो वसुदेवानुजस्त्रियः ॥"<br><b>उल्लेखाः - </b>भाग० ९-२४<br><br>

कंसिक
कंसिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂಚಿನ ಸಂಬಂಧವಾದ /ಕಂಚಿನಿಂದ ಕ್ರಯಕ್ಕೆ ಕೊಳ್ಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"टिठञ्" (५-१-२५)<br><b>व्युत्पत्तिः - </b>कंसेन क्रीतम्<br><br>

कंसीय
कंसीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂಚಿಗೆ ಹಿತವಾದ /ಕಂಚಿಗೆ ಅನುಕೂಲವಾದ<br><b>निष्पत्तिः - </b>"छः" (५-१-५)<br><b>व्युत्पत्तिः - </b>कंसाय हितम्<br><br>

कंसोद्भवा
कंसोद्भवा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌರಾಷ್ಟ್ರದೇಶದ ಒಂದು ಸುವಾಸನೆಯ ಮೃತ್ತಿಕೆ<br><br>

ककन्द
ककन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿನ್ನ /ಸ್ವರ್ಣ<br><b>निष्पत्तिः - </b>कक (लौल्ये) - "अन्दन्"<br><br>

ककुत्स्थ
ककुत्स्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಕ್ಷ್ವಾಕುವಂಶದ ಒಬ್ಬ ದೊರೆ /ಇಕ್ಷ್ವಾಕುರಾಜನ ಮಗನಾದ ಶಶಾದನ ಮಗ /ಪುರಂಜಯ<br><b>निष्पत्तिः - </b>ष्ठा (गतिनिवृत्तौ) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>ककुदि तिष्ठति<br><br>ककुत्स्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೃಷಭದ ಹಿಣಲಿನಲ್ಲಿರುವ<br><br>

ककुद्
ककुद्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತಿನ ಹೆಗಲಿನ ಮೇಲಿರುವ ಹಿಣಲು<br><b>निष्पत्तिः - </b>कु (शब्दे) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>कं सुखं कौति<br><br>ककुद्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತದ ಶಿಖರ /ಬೆಟ್ಟದ ತುದಿ<br><br>ककुद्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನ ಛತ್ರ /ಚಾಮರ, ದ್ವಜ ಮೊದಲಾದ ಚಿಹ್ನೆ<br><br>ककुद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಧಾನ /ಮುಖ್ಯ<br><br>

ककुद
ककुद<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ककुद् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कस्य सुखस्य कुं भूमिं ददाति<br><b>विस्तारः - </b>"प्रधाने राजचिह्ने च वृषाङ्गे ककुदोऽस्त्रियाम्" - अम० ।<br><br>ककुद<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಮೇಢ್ರ /ಶಿಶ್ನ/ಜನನೇಂದ್ರಿಯ<br><b>विस्तारः - </b>"अत्यूहः ककुदः मेढ्रे" - वैज० ।<br><br>

ककुद्मत्
ककुद्मत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತು /ವೃಷಭ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>ककुदस्त्यस्य<br><b>प्रयोगाः - </b>"मदोदग्राः ककुद्मन्तः सरितां कूलमुद्रुजाः"<br><b>उल्लेखाः - </b>रघु० ४-२२<br><br>ककुद्मत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಮವತ್ಪರ್ವತದ ಒಂದು ಶಿಖರ /ನಂದಿಕೇಶ್ವರನ ಉತ್ಪತ್ತಿಸ್ಥಾನ<br><br>

ककुद्मती
ककुद्मती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಟಿಪ್ರದೇಶ /ಪಿರ್ರೆ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४) । "ङीप्" (४-१-६)<br><b>व्युत्पत्तिः - </b>ककुदिव मांसपिण्डोऽस्त्यस्याः<br><br>

ककुद्मिन्
ककुद्मिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಪ್ಪ ಹಿಣಿಲುಳ್ಳ ವೃಷಭ /ಎತ್ತು<br><b>निष्पत्तिः - </b>"मिनिः"<br><b>व्युत्पत्तिः - </b>ककुदस्यास्ति<br><br>ककुद्मिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೈವತನೆಂಬ ಒಬ್ಬ ದೊರೆ /ಬಲರಾಮನ ಪತ್ನಿ ರೇವತಿಯ ತಂದೆ<br><br>ककुद्मिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತ /ಬೆಟ್ಟ<br><br>

ककुद्मिकन्या|सुता
ककुद्मिकन्या - सुता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರೈವತನ ಮಗಳು ರೇವತಿ /ಬಲರಾಮನ ಪತ್ನಿ<br><b>व्युत्पत्तिः - </b>ककुद्मिनः कन्या सुता वा<br><b>प्रयोगाः - </b>"ककुद्मिकन्यावक्त्रान्तवसिलब्धाधिवासया"<br><b>उल्लेखाः - </b>माघ० २-२०<br><br>

ककुन्दर
ककुन्दर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಿರ್ರೆಯ ಮೇಲಿನ ಗುಣಿಗಳು<br><b>निष्पत्तिः - </b>दृ (हिंसायाम्) + णिच् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कुं भूमिं धारयति इति कुन्दरः । कुत्सितं कुन्दरम् ।(पृषो०)<br><b>प्रयोगाः - </b>"कनीनिके चाक्षिकूटे शष्कुलीकर्णपत्रकौ । कर्णौ शङ्खौ भ्रुवौ दन्तवेष्टावोष्ठौ ककुन्दरे ॥"<br><b>उल्लेखाः - </b>याज्ञ० ३-९६<br><br>

ककुभ्
ककुभ्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಿಕ್ಕು/ದಿಶೆ<br><b>निष्पत्तिः - </b>स्कुन्भु - "क्विप्" (३-२-१७८)<br><b>व्युत्पत्तिः - </b>कं वायुं स्कुभ्नाति विस्तारयति<br><b>प्रयोगाः - </b>"मध्ये समुद्रं ककुभः पिशङ्गीर्या कुर्वती काञ्चनवप्रभासा"<br><b>उल्लेखाः - </b>माघ० ३-३३<br><br>ककुभ्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂತಿ /ಶೋಭೆ<br><br>ककुभ्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇಣಿ /ಜಡೆ<br><br>ककुभ्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪಿಗೆ ಹೂವಿನ ಮಾಲೆ<br><b>विस्तारः - </b>"ककुप् स्त्रियां प्रवेणीदिक्शोभासु चम्पकस्रजि" - मेदि० ।<br><br>ककुभ्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷಬ್ರಹ್ಮನ ಒಬ್ಬ ಮಗಳು /ಧರ್ಮದೇವತೆಯ ಪತ್ನಿ<br><br>ककुभ्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರ<br><br>

ककुभ
ककुभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಜುನ ವೃಕ್ಷ /ಕೆಂಪುಮತ್ತಿ ಮರ<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>ककुभो दिशः सन्त्यस्य<br><br>ककुभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೀಣೆಯ ಗಂಭೀರನಾದಕ್ಕಾಗಿ ಕಟ್ಟುವ ಚರ್ಮದ ಚೀಲದಿಂದ ಮುಚ್ಚಲ್ಪಟ್ಟ ಸೋರೆಬುರುಡೆ<br><br>ककुभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಗೀತದಲ್ಲಿ ಒಂದು ರಾಗ<br><br>ककुभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ರೋಗ<br><br>ककुभ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಹತ್ತಾದ /ದೊಡ್ಡದಾದ<br><br>

ककुभा
ककुभा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಿಕ್ಕು /ದಿಶೆ<br><br>

कक्कोल
कक्कोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಧದ್ರವ್ಯವನ್ನು ತೆಗೆಯುವ ತಕ್ಕೋಲವೃಕ್ಷ<br><br>

कक्कोलक
कक्कोलक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಕ್ಕೋಲವೃಕ್ಷದಿಂದ ತೆಗೆದ ಒಂದು ಗಂಧದ್ರವ್ಯ<br><br>

कक्ष
कक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಡುವ ಪಂಚೆಯ ಸೆರಗು /ಉಡುವ ಪಂಚೆಯ ತುದಿಯ ಭಾಗ<br><b>निष्पत्तिः - </b>कष (हिंसायाम्) - "सः" (उ० ३-६२)<br><b>व्युत्पत्तिः - </b>कष्यते<br><br>कक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹದ ಗುಹ್ಯಸ್ಥಾನವನ್ನು ಮುಚ್ಛುವ ವಸ್ತ್ರ /ಕೌಪೀನ<br><b>विस्तारः - </b>"कक्षः कच्छो गुह्यबन्धः"- वैज० ।<br><br>कक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಚ್ಚೆ<br><b>प्रयोगाः - </b>"प्रक्षिप्योदर्चिषं कषे शेरते तेऽभिमारुतम्"<br><b>उल्लेखाः - </b>माघ० २-४२<br><br>कक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಲ್ಮ /ಪೊದರು /ಕುರುಚಲು ಗಿಡ<br><br>कक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಣಮರಗಳ ಕಾಡು /ಜೀರ್ಣವಾದ ಅರಣ್ಯ<br><b>प्रयोगाः - </b>"यथोद्धरति निर्दाता कक्ष्यं धान्यं च रक्षति"<br><b>उल्लेखाः - </b>मनु० ७-११०<br><br>कक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಣಹುಲ್ಲು<br><b>प्रयोगाः - </b>"कक्षान्तरगतो वायुर्जीमूत इव गर्जति"<br><b>उल्लेखाः - </b>रामा०<br><br>कक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಕ್ಕ /ಪಾರ್ಶ್ವಭಾಗ<br><br>कक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಳ್ಳಿ /ಅಲ್ತೆ<br><br>कक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಹುಮೂಲ /ತೋಳಿನ ಕೆಳಭಾಗ<br><br>कक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><br>

कक्षा
कक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯನ್ನು ಕಟ್ಟುವ ಹಗ್ಗ<br><br>कक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭಿತ್ತಿ /ಗೋಡೆ<br><br>कक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಡಾಬು /ಒಡ್ಯಾಣ<br><b>प्रयोगाः - </b>"युधे परैः सह दृडबद्धकक्षया कलक्वणन्मधुपकुलोपगीतया"<br><b>उल्लेखाः - </b>माघ० १७-२४<br><br>कक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಠಡಿ /ಕೋಣೆ<br><b>प्रयोगाः - </b>"अथोपकार्याममरेन्द्रकार्यात्कक्षासु रक्षाधिकृतैरदृष्टः"<br><b>उल्लेखाः - </b>नैष० ६-११<br><br>कक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೋರಾಣ /ಸ್ಪರ್ಧೆ /ಮೇಲಾಟ<br><br>कक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಮ್ಯ /ಹೋಲಿಕೆ<br><br>कक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಥದ ಒಂದು ಅವಯವ<br><br>कक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಕಳಿನ ಒಂದು ರೋಗ<br><b>प्रयोगाः - </b>"बाहुपार्श्वांसकक्षासु कृष्णस्फोटां सवेदनाम् । पित्तप्रकोपसम्भूतां कक्षामितिविनिर्दिशेत् ॥"<br><b>उल्लेखाः - </b>सुश्रुत० निदान० १३-१६<br><br>कक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಡುವ ಪಂಚೆಯ ಸೆರಗು /ಕಚ್ಚೆ<br><b>विस्तारः - </b>"कक्षो वीरुधि दोर्मूले कच्छे शुष्कवने तृणे । पापे, कक्षात्विभरज्जौ काञ्च्यां गेहप्रकोष्ठके । भित्तौ साम्ये रथभागेऽन्तरीयपश्चिमाञ्चले" - हेम०।<br><br>

कक्षक
कक्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸುಕಿಯ ವಂಶದ ಒಂದು ಸರ್ಪ<br><b>प्रयोगाः - </b>"हिरण्यबाहुः शरणः कक्षकः कालदन्तकः"<br><b>उल्लेखाः - </b>भा० आदि० ७-६<br><br>

कक्षधर
कक्षधर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎದೆ ಮತ್ತು ಕಂಕುಳುಗಳ ಮಧ್ಯಭಾಗದಲ್ಲಿರುವ ಮರ್ಮಸ್ಥಾನ<br><b>प्रयोगाः - </b>"विशेषतस्तु यानि सक्थिगुल्मजानुविटपानि तानि बाह्वोर्मणिबन्धकर्परकक्षधराणि"<br><b>उल्लेखाः - </b>सु्श्रुत०<br><br>

कक्षप
कक्षप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೂರ್ಮ /ಆಮೆ<br><b>निष्पत्तिः - </b>पा (पाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कक्षे कच्चे पिबति<br><br>

कक्षरुहा
कक्षरुहा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಕೊನ್ನಾರಿ ಗೆಡ್ಡೆ<br><b>निष्पत्तिः - </b>रुह (बीजजन्मादौ) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>कक्षे जलप्रवाहे रोहति<br><br>

कक्षलोमन्
कक्षलोमन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಕಳಿನ ಕೂದಲು<br><br>

कक्षसेन
कक्षसेन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧರ್ಮರಾಜನ ಸಭೆಯಲ್ಲಿದ್ದ ಒಬ್ಬ ಕ್ಷತ್ರಿಯ /ಅವಿಕ್ಷತನ ಮಗನಾದ ಪರಿಕ್ಷಿತ್ತಿನ ಮಗ<br><b>प्रयोगाः - </b>"कक्षसेनः क्षितिपतिः क्षेमकश्चापराजितः"<br><b>उल्लेखाः - </b>भा० सभा० ४-२८<br><br>कक्षसेन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಮನ ಸಭೆಯಲ್ಲಿದ್ದ ಒಬ್ಬ ಕ್ಷತ್ರಿಯ<br><b>प्रयोगाः - </b>"अलर्कः कक्षसेनश्च गयो गौराश्च एव च"<br><b>उल्लेखाः - </b>भा० सभा० ८-१८<br><br>कक्षसेन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಜರ್ಷಿ<br><br>

कक्षापट
कक्षापट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೌಪೀನ /ಅಂತರಾಚ್ಛಾದನ<br><b>व्युत्पत्तिः - </b>कक्षाकारः पटः<br><br>

कक्षावेक्षक|कक्ष्यावेक्षक
कक्षा(क्ष्या)वेक्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನ ಅಂತಃಪುರದ ಕಾವಲುಗಾರ<br><br>कक्षा(क्ष्या)वेक्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ಯಾನಪಾಲಕ /ಕೈತೋಟದ ಕಾವಲುಗಾರ<br><br>कक्षा(क्ष्या)वेक्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ವಾರಪಾಲಕ<br><br>कक्षा(क्ष्या)वेक्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಟ /ಕಾಮುಖ /ವಿಷಯಾಸಕ್ತ<br><br>कक्षा(क्ष्या)वेक्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಟ /ನರ್ತಕ /ಅಭಿನಯಕಾರ<br><br>कक्षा(क्ष्या)वेक्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕವಿ<br><br>कक्षा(क्ष्या)वेक्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಖಡ್ಗ /ಕತ್ತಿ<br><b>निष्पत्तिः - </b>अव +ईक्ष (दर्शने) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कक्षं वनं स्त्रीबाहुमूलं वा कक्षां साम्यं राजान्तःपुरं वा अवेक्षते<br><b>विस्तारः - </b>"कक्ष्यावेक्षक इत्येष शुद्धान्तोद्यानपालयोः । रङ्गाजीवे कवौ खङ्गे द्वाःस्थे"- मेदि० । "कक्षावेक्षकः शुद्धान्तपालकोद्यानपालयोः । द्वाःस्थे षिद्गे कवौ रङ्गाजीवे" - हेम० ।<br><br>

कक्षिन्
कक्षिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪಾತ್ಮ /ಪಾಪದಿಂದ ಕೂಡಿದವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-१३१)<br><b>व्युत्पत्तिः - </b>कक्षः पापमस्त्यस्य<br><br>

कक्षीवत्
कक्षीवत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಫೋಟಾಯನಮಹರ್ಷಿ<br><br>

कक्ष्य
कक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲತೆಯಲ್ಲಿರುವ<br><br>कक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾಹುಮೂಲದಲ್ಲಿರುವ<br><br>कक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೀರ್ಣವನದಲ್ಲಿರುವ<br><br>कक्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಲ್ಲಿನಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"यत्" (४-३-५३,५५)<br><b>व्युत्पत्तिः - </b>कक्षे भवः<br><br>

कक्ष्या
कक्ष्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರೀಯ /ಹೊದೆಯುವ ವಸ್ತ್ರ<br><br>कक्ष्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಠಡಿ /ಕೋಣೆ<br><br>कक्ष्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಡಾಬು /ಒಡ್ಯಾಣ<br><br>कक्ष्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ನಡುವಿಗೆ ಕಟ್ಟುವ ಹಗ್ಗ<br><b>विस्तारः - </b>"कक्ष्या बृहतिकायां स्यात् काञ्च्यां मध्येभबन्धने । हर्म्यादीनां प्रकोष्ठेऽपि" - मेदि० ।<br><br>कक्ष्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ಯೋಗ<br><br>कक्ष्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಡುಕಟ್ಟು<br><b>निष्पत्तिः - </b>कक्ष - स्वार्थे "यत्"<br><br>कक्ष्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಸ್ಥೆ /ಹಂತ /ಘಟ್ಟ<br><br>

कक्ष्यावत्
कक्ष्यावत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಜ /ಆನೆ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>कक्ष्यास्त्यस्य<br><br>

कक्ष्यावती
कक्ष्यावती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಜ /ಆನೆ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कक्ष्यावेक्षक
कक्ष्यावेक्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>कक्षावेक्षक ಪದದ ಅರ್ಥ<br><br>

कङ्क
कङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಹದ್ದು<br><b>निष्पत्तिः - </b>ककि (गतौ) - "अच्"(३-१-१३४)<br><b>व्युत्पत्तिः - </b>कङ्कते<br><br>कङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇಷಧಾರಿ ಬ್ರಾಹ್ಮಣ<br><br>कङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಂಡವರ ಅಜ್ಞಾತವಾಸದ ಕಾಲದಲ್ಲಿ ಧರ್ಮರಾಜನ ಹೆಸರು<br><b>प्रयोगाः - </b>"विराटं समनुप्राप्य राजानं मात्स्यनन्दनम् । सभास्तारो भविष्यामि विराटस्येति मे मतिः ॥ कङ्को नाम ब्रुवणोऽहं मताक्षः साधुदेविता ।"<br><b>उल्लेखाः - </b>भा० विरा० २-२३<br><br>कङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಮ<br><b>विस्तारः - </b>"कङ्कच्छद्विजे ख्यातो लोहपृष्ठकृतान्तयोः" -मेदि० ।<br><br>

कङ्का
कङ्का<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಗ್ರಸೇನನ ಒಬ್ಬ ಮಗಳು /ಕಂಸನ ತಂಗಿ<br><b>प्रयोगाः - </b>"तेषां स्वसारः पञ्चासन् कंसा कंसवती तथा । सुतनू राष्ट्रपाली च कङ्का चैव वराङ्गना ॥"<br><b>उल्लेखाः - </b>हरिवं०<br><br>

कङ्कट
कङ्कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕವಚ /ಅಂಗಿ<br><b>निष्पत्तिः - </b>ककि (गतौ) - "अटन्" (उ० ४-८१)<br><b>प्रयोगाः - </b>"शल्यानि व्यपनीय कङ्कवदनैरुन्मोचिते कङ्कटे बद्धेषु व्रणपट्टकेषु शनकैः कर्णे कृतापाश्रयः"<br><b>उल्लेखाः - </b>वेणी० ५-१<br><br>कङ्कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಕುಶ /ಅನೆಯನ್ನು ಶಿಕ್ಷಿಸುವ ಕಬ್ಬಿಣದ ಮುಳ್ಳುಗೋಲು<br><br>

कङ्कटक
कङ्कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಕುಶ /ಅನೆಯನ್ನು ಶಿಕ್ಷಿಸುವ ಕಬ್ಬಿಣದ ಮುಳ್ಳುಗೋಲು<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><br>

कङ्कटिक
कङ्कटिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯುದ್ಧಕವಚ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>कङ्कट - "ठच्" (४-२-८०)<br><br>

कङ्कटिल
कङ्कटिल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯುದ್ಧಕವಚವನ್ನು ತೊಟ್ಟಿರುವ<br><b>निष्पत्तिः - </b>कङ्कट - "इनिः" (४-२-८०)<br><br><b>कन्नडार्थः - </b>ಯುದ್ಧಕವಚವನ್ನು ತೊಟ್ಟಿರುವ<br><b>निष्पत्तिः - </b>कङ्कट - "इलः" (४-२-८०)<br><br>

कङ्कटीक
कङ्कटीक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ /ಶಿವ<br><b>विस्तारः - </b>"कृशानुरेता जोटिगः कङ्कटीक उमापतिः" - वैज० ।<br><br>

कङ्कण
कङ्कण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಲಕಣ /ನೀರಿನ ಬಿಂದು<br><b>व्युत्पत्तिः - </b>कमित्यव्ययम् जलार्थकम् । तस्य कणः<br><b>प्रयोगाः - </b>"नितम्बो पत्रालीनयनयुगले कङ्कणभरम्"<br><b>उल्लेखाः - </b>उद्भ०<br><br>कङ्कण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸ್ತಾಭರಣ /ಮಣಿಕಟ್ಟಿನ ಒಂದು ಆಭರಣ<br><b>निष्पत्तिः - </b>कण (शब्दे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कं शुभं कणति<br><b>प्रयोगाः - </b>"श्रोत्रं श्रुतेनैव न कुण्डलेन दानेन पाणिर्न तु कङ्कणेन"<br><b>उल्लेखाः - </b>भर्तु० १-६२<br><br>कङ्कण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹಸಮಯದಲ್ಲಿ ವಧೂವರರ ಕೈಗೆ ಕಟ್ಟುವ ಮಂಗಳಸೂತ್ರ<br><b>प्रयोगाः - </b>"अयमागृहीतकमनीयकङ्कणस्तव मूर्तिमानिव महोत्सवः करः"<br><b>उल्लेखाः - </b>उ० रा० १-१८<br><br>कङ्कण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಭರಣ /ಒಡವೆ<br><br>कङ्कण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶೇಖರ /ತಲೆಯಲ್ಲಿ ಧರಿಸುವ ಹೂವಿನ ಮಾಲೆ ಮೊದಲಾದುದು<br><b>विस्तारः - </b>"कङ्कणं करभूषायां हस्तसूत्रे च शेखरे" - हेम० ।<br><br>

कङ्कणिन्
कङ्कणिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಸ್ತಾಭರಣವನ್ನು ಧರಿಸಿರುವ /ಬಳೆಯನ್ನು ತೊಟ್ಟಿರುವ<br><br>कङ्कणिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶೇಖರ /ತಲೆಯಲ್ಲಿ ಧರಿಸುವ ಹೂವಿನ ಮಾಲೆ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>कङ्कण - "इनिः" (५-२-११५)<br><br>

कङ्कणीका
कङ्कणीका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರುಗೆಜ್ಜೆ<br><b>निष्पत्तिः - </b>कण (निमीलने) +‍ णिच् + यङ् तस्य लुक् "ईकन्" (उ० ४-१८) । धतोः कङ्कणादेशश्च ।<br><b>व्युत्पत्तिः - </b>पुनः पुनः काणयति<br><br>कङ्कणीका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಕಣ /ಹಸ್ತಸೂತ್ರ<br><b>प्रयोगाः - </b>"घण्टिकायां कङ्कणीका सैव प्रतिसरापि च"<br><br>

कङ्कत
कङ्कत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೀರೆಗಿಡ<br><b>निष्पत्तिः - </b>ककि (गतौ) - "अतच्" बाहु० ।<br><br>कङ्कत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಚಣಿಗೆ<br><b>प्रयोगाः - </b>"हासकरमघटते नितरां शिरसीव कङ्कतमपेतमूर्धजे"<br><b>उल्लेखाः - </b>माघ० १५-३३<br><br>

कङ्कतिका
कङ्कतिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಚಣಿಗೆ<br><b>निष्पत्तिः - </b>गौरा० "ङीष्" (४-१-४१) । स्वार्थे "कन्" (५-४-५)<br><br>

कङ्कती
कङ्कती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಚಣಿಗೆ<br><br>

कङ्कतीय
कङ्कतीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೇಶಸಂಸ್ಕಾರ ಮಾಡುವ /ತಲೆಗೆ ಅಲಂಕಾರ ಮಾಡುವ<br><b>निष्पत्तिः - </b>"छः" (५-१-१११)<br><b>व्युत्पत्तिः - </b>कङ्कतं तत्संस्कारः प्रयोजनमस्य<br><br>

कङ्कपत्र
कङ्कपत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹದ್ದಿನ ರೆಕ್ಕೆಗಳಿಂದ ಕೂಡಿದ ಬಾಣ /ಶರ<br><b>व्युत्पत्तिः - </b>कङ्कस्य पत्रं यस्य<br><b>प्रयोगाः - </b>"हयांश्च रजतप्रख्यान् कङ्कपत्रैः शिलाशतैः"<br><b>उल्लेखाः - </b>भा०<br><br>कङ्कपत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಣಹದ್ದಿನ ರೆಕ್ಕೆ /ಗರಿ<br><b>व्युत्पत्तिः - </b>कङ्कस्य पत्रं<br><br>कङ्कपत्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹದ್ದಿನ ಗರಿಗಳಿಂದ ಕೂಡಿದ<br><b>प्रयोगाः - </b>"वामेतरस्तस्य करः प्रहर्तुः नखप्रभारूषितकङ्कपत्रैः"<br><b>उल्लेखाः - </b>रघु० २-३१<br><br>

कङ्कपत्रिन्
कङ्कपत्रिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹದ್ದಿನ ಗರಿಗಳಿಂದ ಕೂಡಿದ ಬಾಣ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कङ्कपत्रमस्त्यस्य<br><b>प्रयोगाः - </b>"पुनरेवाहनत् पार्थ हृदये कङ्कपत्रिभिः"<br><b>उल्लेखाः - </b>भा० विरा०<br><br>

कङ्कमुख
कङ्कमुख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಸ್ತ್ರಚಿಕಿತ್ಸೆಯ ಒಂದು ಚಿಮುಟ /ಶ್ರವಣ<br><b>व्युत्पत्तिः - </b>कङ्कमुखमिव मुखमस्य<br><b>प्रयोगाः - </b>"शल्यानि व्यपनीय कङ्कवदनैरुन्मोचिते कङ्कटे"<br><b>उल्लेखाः - </b>वेणी० ५-१<br><br>

कङ्काल
कङ्काल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚರ್ಮ ಮಾಂಸಗಳಿಲ್ಲದ ಎಲುಬಿನ ಗೂಡು /ಅಸ್ಥಿಪಂಜರ<br><b>निष्पत्तिः - </b>कल (क्षेपे) + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कं सुखं कालयति<br><b>प्रयोगाः - </b>"खर्जूरद्रुमदध्वजङ्गमसितत्वङ्नद्धविष्वक्ततस्नायुग्रन्थिघनास्थिपञ्जरजरत्कङ्कालमालोक्यते"<br><b>उल्लेखाः - </b>मालती० ५-१४<br><br>

कङ्कालमालिन्
कङ्कालमालिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ /ಮಹಾದೇವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११६)<br><b>व्युत्पत्तिः - </b>कङ्कालानां मालास्त्यस्य<br><br>

कङ्कु
कङ्कु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಗ್ರಸೇನನ ಮಗ /ಕಂಸನ ಸಹೋದರ<br><b>प्रयोगाः - </b>"कंसः सुनामा न्यग्रोधः कङ्कुः शङ्कः सुहुस्तथा । राष्ट्रपालश्च सृष्टिश्च तुष्टिमानुग्रसेनजाः ॥"<br><b>उल्लेखाः - </b>भाग० ९-२४-२४<br><br>

कङ्गु
कङ्गु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನವಣೆಯೆಂಬ ಒಂದುಧಾನ್ಯ<br><b>निष्पत्तिः - </b>अगि (गतौ) - "कुः" (उ० १-३७)<br><b>व्युत्पत्तिः - </b>कं सुखं अङ्गति<br><b>विस्तारः - </b>"स्त्रियौ कङ्गुप्रियङ्गू द्वे" - अम०<br><br>

कच
कच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಶ /ಕೂದಲು<br><b>निष्पत्तिः - </b>कच (बन्धने) - "घः" (३-३-११८)<br><b>व्युत्पत्तिः - </b>कच्यते बध्यते<br><b>प्रयोगाः - </b>"दोर्मूलमालोक्य कचं रुरुत्सोस्ततः कुचौ तावनुलेपयन्त्याः"<br><b>उल्लेखाः - </b>नैष० ६-२०<br><br>कच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಣಗಿದ ಹುಣ್ಣು<br><br>कच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಧ /ಕಟ್ಟು<br><br>कच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><br>कच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂತಿ /ಪ್ರಕಾಶ /ಹೊಳಪು<br><br>कच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೃಹಸ್ಪತ್ಯಾಚಾರ್ಯರ ಮಗ<br><br>

कचग्रह
कचग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೂದಲನ್ನು ಎಳೆದು ಹಿಡಿದುಕೊಳ್ಳುವುದು<br><b>व्युत्पत्तिः - </b>कचस्य ग्रहः ग्रहणम्<br><b>प्रयोगाः - </b>"शापयन्त्रितपौलस्त्यबलात्कारकचग्रहैः"<br><b>उल्लेखाः - </b>रघु० १०-४७<br><br>

कचङ्गल
कचङ्गल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಡಲು /ಸಮುದ್ರ<br><b>निष्पत्तिः - </b>कच (शब्दे) - "अङ्गलच्" बाहु० ।<br><br>कचङ्गल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೆರಿಗೆಯಿಲ್ಲದ ಮಾರುಕಟ್ಟೆ /ಸುಂಕವಿಲ್ಲದ ವ್ಯಾಪಾರಕಟ್ಟೆ<br><br>

कचङ्गला
कचङ्गला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನೇಕ ಕ್ರಿಮಿಗಳಿಂದ ಕೂಡಿದ ಪ್ರದೇಶ /ನಾನಾ ಜಂತುಗಳಿಂದ ಕೂಡಿದ ಭೂಮಿ<br><b>विस्तारः - </b>"कचङ्गला तु नीलिङ्गी भूर्नानाजन्तुसंयुता" - वैज० ।<br><br>

कचपक्ष
कचपक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಶಪಾಶ /ಕುದಲಿನ ಸಮೂಹ<br><b>व्युत्पत्तिः - </b>कचानां पक्षः<br><br>

कचपाश
कचपाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಶಪಾಶ /ಕುದಲಿನ ಸಮೂಹ<br><b>व्युत्पत्तिः - </b>कचानां पाशः<br><br>

कचहस्त
कचहस्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಶಪಾಶ /ಕುದಲಿನ ಸಮೂಹ<br><b>व्युत्पत्तिः - </b>कचानां हस्तः<br><br>

कचा
कचा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣಾನೆ<br><b>निष्पत्तिः - </b>कच (शब्दे) - "घः" (३-३-११८)<br><b>विस्तारः - </b>"कचा करेण्वाम्"<br><br>

कचाकचि
कचाकचि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪರಸ್ಪರ ಕೂದಲನ್ನು ಹಿಡಿದುಕೊಂಡು ಮಾಡುವ ಯುದ್ಧ<br><b>निष्पत्तिः - </b>"इच" (५-४-१२७) । पूर्वपदान्तदीर्घश्च (६-३-१३७)<br><b>व्युत्पत्तिः - </b>कचेषु कचेषु गृहीत्वा प्रवृत्तं युद्धम्<br><br>

कचाकु
कचाकु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ /ಹಾವು<br><b>निष्पत्तिः - </b>अक (कुटिलायां गतौ) - "उण्" बाहु० ।<br><b>व्युत्पत्तिः - </b>कच् इव अकति वक्रं गच्छति<br><br>कचाकु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಡಿಯಲು ಸಾಧ್ಯವಿಲ್ಲದ /ತಡೆಯಲು ಅಶಕ್ಯವಾದ<br><br>कचाकु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುಃಸ್ವಭಾವದವನು /ಕೆಟ್ಟ ಶೀಲವುಳ್ಳವನು<br><b>विस्तारः - </b>"कचाकुस्त दुराधर्षे दुःशीले ना विलेशये" - मेदि० ।<br><br>

कचाग्र
कचाग्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೂದಲಿನ ತುದಿ<br><br>कचाग्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುದಲಿನ ತುದಿಯಷ್ಟಿರುವ ತ್ರಸರೇಣುವಿನ ಎಂಟನೆಯ ಭಾಗ<br><br>

कचाचित
कचाचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆದರಿದ ಕೂದಲುಳ್ಳ /ಕೆದರಿದ ಕೂದಲಿನಿಂದ ವ್ಯಾಪ್ತವಾದ<br><b>व्युत्पत्तिः - </b>कचैराचितः<br><b>प्रयोगाः - </b>"वनान्तशय्याकटिनीकृताकृती कचाचितौ विष्वगिवागजौ गजौ"<br><b>उल्लेखाः - </b>किरा० १-३६<br><br>

कचाटुर
कचाटुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರುಕೋಳಿ<br><b>निष्पत्तिः - </b>अट (गतौ) - "उरच्" (उ० १-४१)<br><b>व्युत्पत्तिः - </b>कच इवाटति<br><br>

कचाटुरी
कचाटुरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರುಕೋಳಿ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

कचेल
कचेल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬರೆದ ಕಾಗದಗಳನ್ನು ಒಟ್ಟುಗೂಡಿಸಿ ಕಟ್ಟುವ ದಾರ ಅಥವಾ ಅವನ್ನು ರಕ್ಷಿಸುವ ಚೀಲ<br><b>निष्पत्तिः - </b>कच (बन्धने) - "एलच्" बाहु० ।<br><b>व्युत्पत्तिः - </b>कच्यते बध्यतेऽनेन<br><b>विस्तारः - </b>"लेखो वाचिकहारकः । वर्णदूतः स्वस्तिमुखः कचेलं तन्निबन्धनम्" - त्रिकाण्ड० ।<br><br>

कच्चट
कच्चट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟಿರುವವಸ್ತು<br><b>निष्पत्तिः - </b>चटे (वर्षावरणयोः) - "अच्" (३-१-१३४) । कोः कत् (६-३-१०२)<br><b>व्युत्पत्तिः - </b>कुत्सितं चटति<br><br>

कच्चर
कच्चर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಳೆಯಾಗಿರುವ /ಮಲಿನವಾಗಿರುವ /ಕಶ್ಮಲದಿಂದ ಕೂಡಿದ'<br><b>निष्पत्तिः - </b>चर (गतौ) - "अच्" (३-१-१३४) । कोः कत् (६-३-१०२)<br><b>व्युत्पत्तिः - </b>कुत्सितं चरति<br><b>विस्तारः - </b>"कच्चरं मलदूषितम्" - अम० ।<br><br>कच्चर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಭ್ಯ /ದುರ್ಜನ<br><br>कच्चर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಕ್ರ /ನೀರು ಬೆರೆಸಿದ ಮೊಸರು /ಮಜ್ಜಿಗೆ<br><b>विस्तारः - </b>"कच्चरं कुत्सिते तक्रे" - हेम० ।<br><br>

कच्चित्
कच्चित्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ<br><b>प्रयोगाः - </b>"कच्चिन्न वाय्वादिरुपप्लवो वः श्रमच्छिदामाश्रमपादपानाम्"<br><b>उल्लेखाः - </b>रघु० ५-६<br><br>कच्चित्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ತನಗೆ ಇಷ್ಟವಾದುದನ್ನು ತಿಳಿಯುವುದಕ್ಕಾಗಿ ಮಾಡುವ ಪ್ರಶ್ನೆ<br><b>प्रयोगाः - </b>"कच्चित्सौम्य प्रियसहचरी विद्युदालिङ्गति त्वाम्"<br><b>उल्लेखाः - </b>मालती० ९-२५<br><br>कच्चित्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹರ್ಷ /ಸಂತೋಷ<br><br>कच्चित्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮಂಗಳ<br><b>व्युत्पत्तिः - </b>कत् चित् अनयोः समाहारः<br><br>

कच्चिदध्याय
कच्चिदध्याय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾಭಾರತದ ಸಭಾಪರ್ವದ ೫ನೆಯ ಅಧ್ಯಾಯ<br><br>

कच्छ
कच्छ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ಹೆಚ್ಚಾಗಿರುವ ನದಿ ಕೆರೆ ಕೊಳಗಳ ಸಮೀಪಪ್ರದೇಶ /ಚೌಗುಭೂಮಿ<br><b>निष्पत्तिः - </b>छो (छेदने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कं जलं छ्यति परिच्छिनत्ति<br><b>प्रयोगाः - </b>"आसेदिरे लावणसैन्धवीनां चमूचरैः कच्छभुवां प्रदेशाः"<br><b>उल्लेखाः - </b>माघ० ३-८०<br><br>कच्छ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಟ /ತೀರ /ದಡ<br><b>प्रयोगाः - </b>"दाशरथी भागीरथीकच्छङ्गच्छताम्"<br><b>उल्लेखाः - </b>चं० रामा०<br><br>कच्छ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಂದಿಮರ<br><br>कच्छ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಮೆಯ ಚಿಪ್ಪು<br><br>कच्छ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಚ್ಚೆ /ನಡುಕಟ್ಟಿಗೆ ಸಿಕ್ಕಿಸುವ ಉಡುವ ಪಂಚೆಯ ತುದಿ<br><br>कच्छ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಡಗಿನ ಒಂದು ಭಾಗ<br><br>कच्छ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಖಸಂಪುಟ<br><br>

कच्छा
कच्छा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಾರಾಹಿ ಗಿಡ /ಹಂದಿಗೆಡ್ಡೆ<br><br>कच्छा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜೀರುಂಡೆ<br><b>विस्तारः - </b>"कच्छ‍स्यादनूपे तुन्नकद्रुमे । नौकाङ्गे पुंसि वाराह्यां चीरिकायां च योषिति" - मेदि० ।<br><br>

कच्छप
कच्छप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಮೆ /ಕೂರ್ಮ<br><b>निष्पत्तिः - </b>पा (रक्षणे) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कच्छेन कर्परेण पाति इतराङ्गानि, कच्छमात्मनो मुखसम्पुटं पाति वा ।<br><b>विस्तारः - </b>ಆಮೆಯು ತನ್ನ ಮುಖವನ್ನು ಚಿಪ್ಪಿನೊಳಕ್ಕೆಸೇರಿಸಿ ರಕ್ಷಿಸಿಕೊಳ್ಳುವುದರಿಂದ ಈ ಹೆಸರು.<br><br>कच्छप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರನ ನವನಿಧಿಗಳಲ್ಲೊಂದು<br><br>कच्छप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಟ್ಟಿಯ ಬಾಹುಯುದ್ಧದ ಒಂದು ಭೇದ<br><br>

कच्छपी
कच्छपी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಆಮೆ<br><br>कच्छपी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಕೆಟ್ಟ ರೋಗ<br><br>कच्छपी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸರಸ್ವತಿಯ ವೀಣೆ<br><b>विस्तारः - </b>"कच्छपी वल्लकीभेदे दुलौ क्षुद्रगदान्तरे । पुंसि निध्यन्तरे कूर्मे मल्लबन्धान्तरेऽपि च " - मेदि० ।<br><br>

कच्छभू
कच्छभू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ಹೆಚ್ಚಾಗಿರುವ ನದಿ ಕೆರೆ ಕೊಳಗಳ ಸಮೀಪಪ್ರದೇಶ /ಚೌಗುಭೂಮಿ<br><b>प्रयोगाः - </b>"आसेदिरे लावणसैन्धवीनां चमूचरैः कच्छभुवां प्रदेशाः"<br><b>उल्लेखाः - </b>माघ० ३-८०<br><br>

कच्छरुह
कच्छरुह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಡದಲ್ಲಿ ಬೆಳೆಯುವ /ತೀರದಲ್ಲಿ ಹುಟ್ಟುವ<br><b>निष्पत्तिः - </b>रुह (बीजजन्मादौ) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>कच्छे तटे रोहति<br><br>

कच्छरुहा
कच्छरुहा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರಿಕೆ ಹುಲ್ಲು<br><b>प्रयोगाः - </b>"विष्टरं तटकुशालिभिरद्भिः पाद्यमर्घ्यमथ कच्छरुहाभिः"<br><b>उल्लेखाः - </b>नैष० ५-७<br><br>

कच्छुर
कच्छुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಜ್ಜಿ ರೋಗವುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"रः" ह्रस्वश्च (वा० ५-२-१०७)<br><b>व्युत्पत्तिः - </b>कच्छूरस्यास्ति<br><br>कच्छुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮುಖ /ಸ್ತ್ರೀಲಂಪಟ<br><br>

कच्छुरा
कच्छुरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಸುಗುನ್ನಿ ಗಿಡ<br><br>कच्छुरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಚೋರ<br><br>कच्छुरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೀಟಕಸಂಧಿ<br><br>कच्छुरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಭಿಚಾರಿಣಿ<br><b>विस्तारः - </b>"कच्छुरा शूकशिम्ब्यां च शटीदुस्पर्शयोरपि । कच्छुरः पुंश्चले कच्छुयुक्ते" - मेदि० ।<br><br>

कच्छुराक्षस
कच्छुराक्षस<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ತೈಲ<br><b>विस्तारः - </b>ಇದರ ಅಭ್ಯಂಗಸ್ನಾದಿಂದ ಕಜ್ಜಿ ನವೆಇತರ ವ್ಯಧಿಗಳು ಮತ್ತು ಕಿವುಡು ಈ ರೋಗಗಳು ವಾಸಿಯಾಗುವುದು. "दन्ती निम्बदलञ्चैभिः पृथक्कर्षमितैः पृथक् । कल्कीकृतैः पचेत्तैलं कटुप्रस्थहयोन्मितैः ॥ अर्कसीहुण्डदुग्धेन पृथक्पलमितेन च । गोमूत्रस्याढकेनापि शनैर्मृद्वग्निना पचेत् । अभ्यङ्गेन हरेदेतत् कच्छुदुःसाध्यतामपि । पामानं च तथा कण्डूं त्वग्व्याधिबधिरानपि ॥" - भावप्र० ।<br><br>

कच्छू
कच्छू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಜ್ಜಿ<br><b>निष्पत्तिः - </b>कष (हिंसायाम्) - "ऊः" छ च (उ० १-८४)<br><b>व्युत्पत्तिः - </b>कषति<br><br>

कच्छूरक
कच्छूरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಚೋರ<br><br>

कज्जल
कज्जल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಜನ /ಕಣ್ಣುಕಪ್ಪು /ಕಾಡಿಗೆ<br><b>निष्पत्तिः - </b>किः कत् (६-३-१०२) । "अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>कुत्सितं जलम् । कज्जलमस्यास्ति<br><b>प्रयोगाः - </b>"लक्षालक्ष्म ललाटपट्टमभितः केयूरमुद्रा गले वक्त्रे कज्जलकालिमा नयनयोस्ताम्बूलरागोऽपरः"<br><b>उल्लेखाः - </b>अमरु० ६०<br><br>

कज्जलकेतु
कज्जलकेतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೀಪ<br><b>व्युत्पत्तिः - </b>कज्जलं केतुरिव<br><br>

कज्जलध्वज
कज्जलध्वज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೀಪ<br><b>व्युत्पत्तिः - </b>कज्जलं ध्वज इव<br><b>विस्तारः - </b>"दीपस्तु स्नेहाशः कज्जलध्वजः" - त्रिकाण्ड० ।<br><br>

कञ्चुक
कञ्चुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕವಚ /ಅಂಗಿ<br><b>निष्पत्तिः - </b>कचि (दीप्तिबन्धनयोः) - "उकः" बाहु० ।<br><b>व्युत्पत्तिः - </b>कञ्च्यते बध्यते<br><b>प्रयोगाः - </b>"महीभृतां महिमभृतां च सम्ममुर्मुदोऽन्तरा वपुषि बहिश्च कञ्जुकाः"<br><b>उल्लेखाः - </b>माघ० १७-२२<br><br>कञ्चुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೋಹಮಯವಾದ ಯುದ್ಧಕವಚ<br><b>प्रयोगाः - </b>"पुराणि दुर्गाणि निसातमायुधं बलानि शूराणि घनाश्च कञ्चुकाः"<br><b>उल्लेखाः - </b>माघ० १-४५<br><br>कञ्चुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾವಿನ ಸೋಲೆ /ಸರ್ಪದ ಮೈಮೇಲಿನ ಪೊರೆ<br><b>निष्पत्तिः - </b>कचि (दीप्तिबन्धनयोः) - "उकः" बाहु० ।<br><b>व्युत्पत्तिः - </b>कञ्च्यते<br><br>कञ्चुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರೋತ್ಸವಾದಿ ಸಂತೋಷಕಾಲದಲ್ಲಿ ಯಜಮಾನನ ಮೈಯಿಂದ ಭೃತ್ಯರು ಬಲಾತ್ಕಾರದಿಂದ ತೆಗೆದುಕೊಳ್ಳುವ ವಸ್ತ್ರ<br><br>कञ्चुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸರ ರವಿಕೆ<br><b>विस्तारः - </b>"कञ्चुकश्चोलवर्मणोः । वर्धापकगृहीताङ्गवसने वारवाणके । निर्मोके" - हेम० ।<br><br>

कञ्चुकित
कञ्चुकित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕವಚ ತೊಟ್ಟಿರುವ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>कञ्चुकोऽस्य सञ्जातः<br><br>कञ्चुकित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಲ್ಪಟ್ಟ /ಮರೆಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"कोसलसुताकुमारभावकञ्चुकितकारणाकार"<br><b>उल्लेखाः - </b>रघु० ग०<br><br>

कञ्चुकिन्
कञ्चुकिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನ ಅಂತಃಪುರದ ಅಧಿಕಾರಿ /ಅಂತಃಪುರದ ರಕ್ಷಕ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कञ्चुकोऽस्यास्ति<br><b>प्रयोगाः - </b>"अन्तः कञ्चुकिकञ्चुकस्य विशति त्रासादयं वामनः"<br><b>उल्लेखाः - </b>रत्ना० २-३<br><b>विस्तारः - </b>"अन्तःपुरचरो वृद्धो विप्रो गुणगणान्वितः । सर्वकार्यार्थकुशलः कञ्चुत्यभिधीयते ॥"<br><br>कञ्चुकिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ವಾರಪಾಲಕ<br><br>कञ्चुकिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ /ಹಾವು<br><br>कञ्चुकिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಾರ /ವಿಟ /ವ್ಯಭಿಚಾರಿ<br><b>विस्तारः - </b>"कञ्चुकी भुजगे षिद्गे मल्ले जाङलिकद्रुमे"-विश्व० ।<br><br>कञ्चुकिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾರ್ಲಿ /ಅಕ್ಕಿ<br><br>कञ्चुकिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗುರುವೃಕ್ಷ<br><br>कञ्चुकिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಣಕ /ಕಡಲೆ<br><br>कञ्चुकिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಟ್ಟಿ<br><br>कञ्चुकिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂಚುಕವನ್ನು ಧರಿಸಿರುವವನು /ಅಂಗಿಯನ್ನು ತೊಟ್ಟಿರುವವನು<br><br>

कञ्चुकीय
कञ्चुकीय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಚುಕಿ /ರಾಜನ ಅಂತಃಪುರದ ರಕ್ಷಕ<br><br>

कञ्चुलिका
कञ्चुलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರವಿಕೆ /ಚೋಳಿ<br><b>निष्पत्तिः - </b>कचि (दीप्तिबन्धनयोः) - "उलच्" बाहु० ।<br><b>व्युत्पत्तिः - </b>कज्च्यते बध्यतेऽनया<br><b>प्रयोगाः - </b>"त्वं मुग्धाक्षि विनैव कञ्चुलिकया धत्से मनोहारिणीं लक्ष्मीमित्यभिधायिनि प्रियतमे तद्वीटिकासंस्पृशि"<br><b>उल्लेखाः - </b>अमरु० २७<br><br>

कञ्ज
कञ्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ /ಚತುರ್ಮುಖ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>कम् जले जायते<br><b>प्रयोगाः - </b>"अप एव ससर्जादौ तासु वीर्यमवासृजत्। तदण्डमभवद्धैमं सहस्रांशुसमप्रभम् ॥ तस्मिन् जज्ञे स्वयं ब्रह्म सर्वलोकपितामहः ॥"<br><b>उल्लेखाः - </b>मनु० १-९<br><br>कञ्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಶ /ಕೂದಲು<br><b>व्युत्पत्तिः - </b>कम् शिरसि जायते<br><br>कञ्ज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪದ್ಮ /ಕಮಲ /ತಾವರೆ<br><br>कञ्ज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮೃತ<br><b>विस्तारः - </b>"कञ्जः केशे विरिञ्चे च कञ्जं पीयूषपद्मयोः"- मेदि० ।<br><br>

कञ्जज
कञ्जज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ /ಚತುರ್ಮುಖ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>कञ्ञात् विष्णोर्नाभिकमलात् जायते<br><br>

कञ्जन
कञ्जन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ /ಮನ್ಮಥ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) + णिच् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कं सुखं जनयति<br><br>

कञ्जनाभ
कञ्जनाभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾರಾಯಣ /ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>कञ्जं नाभौ यस्य<br><b>प्रयोगाः - </b>"तस्या एवं जगत्स्रष्टे प्रधानपुरुषेश्वरः । व्यज्येदं स्वेन रूपेण कञ्जनाभिस्तिरोधसे ॥"<br><b>उल्लेखाः - </b>भाग० ३-९-४४<br><br>

कञ्जर|कञ्जार
कञ्जर-जार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಠರ /ಹೊಟ್ಟೆ<br><br>कञ्जर-जार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>कञ्जर-जार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ /ಚತುರ್ಮುಖ<br><br>कञ्जर-जार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಜ /ಆನೆ<br><br>कञ्जर-जार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಕ್ಕದ ಗಿಡ<br><br>कञ्जर-जार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುನಿ /ತಪಸ್ವಿ<br><b>निष्पत्तिः - </b>जॄ (वयोहानौ) - "अच्" (३-१-१३४) । "अण्" वा ।<br><b>व्युत्पत्तिः - </b>कं जलं जृणाति<br><b>विस्तारः - </b>"कञ्जरो जठरे सूर्ये विरिञ्चौ वारणे मुनौ" - मेदि० ।<br><br>कञ्जर-जार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಯೂರ /ನವಿಲು<br><b>निष्पत्तिः - </b>कञ्ज - "आरन्" कञ्जरो मयूरः (उ० ३-१३८)<br><br>

कटि|गतौ|कण्टति
कटि - गतौ (भ्वा० पर० सक० से०) कण्टति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೋಗು/ನಡೆ<br><br>

कटी|गतौ|कटति
कटी - गतौ (भ्वा० पर० सक० से०) कटति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೋಗು/ನಡೆ<br><br>

कट
कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಲ್ಲು ಬಿದಿರು ಮುಂತಾದುವುಗಳಿಂದ ತಯಾರಾಗಿರುವ ಚಾಪೆ<br><b>निष्पत्तिः - </b>कटे (वर्षावरणयोः) - "अच्" (३-१-१३४)<br><b>प्रयोगाः - </b>"वर्षासु क्लिन्नकटवत् तिष्ठन्नेवावसीदति"<br><b>उल्लेखाः - </b>भा० सभा० १९-३<br><br>कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಗಂಡಸ್ಥಳ /ಕಪೋಲ<br><b>प्रयोगाः - </b>"कण्डूयमानेन कटं कदाचिद्वन्यद्विपेनोन्मथिता त्वगस्य"<br><b>उल्लेखाः - </b>रघु० २-३७<br><br>कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಡಸ್ಥಳ /ಕಪೋಲ /ಕೆನ್ನೆ<br><br>कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶರ /ಬಾಣ<br><br>कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧನುಸ್ಸು /ಬಿಲ್ಲು<br><br>कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಯ /ಆಚಾರ<br><br>कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಟಿಪ್ರದೇಶ /ಸೊಂಟ<br><br>कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಸ್ಯ /ಪೈರು /ಓಷಧಿ ವಿಶೇಷ<br><br>कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶವ /ಮೃತಶರೀರ<br><br>कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶವರಥ /ಶವವನ್ನು ಸಾಗಿಸುವ ಗಾಡಿ<br><br>कट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಶಯವಾದ /ಹೆಚ್ಚಾದ<br><br>

कटी
कटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಪ್ಪಲಿ<br><b>विस्तारः - </b>"कटः श्रोणौ पुंसि किलिञ्जेऽतिशये शरे । समये गजगण्डे च पिप्पल्यां तु कटी मता" - मेदि०।<br><br>कटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಪ್ಪಲಿ<br><b>निष्पत्तिः - </b>वा "ङीष्" (ग० ४-१-४५)<br><b>विस्तारः - </b>"पिप्पल्यां तु कटी मता" - मेदि० ।<br><br>

कटक
कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಲಯ /ಬಳೆ /ಹಸ್ತಾಭರಣ<br><b>निष्पत्तिः - </b>कटे (वर्षावरणयोः) - "क्वुन्" (उ० २-३३)<br><b>प्रयोगाः - </b>"कटकानि भजन्ति चारुबिर्नवमुक्ताफलभूषणैर्भुजैः"<br><b>उल्लेखाः - </b>माघ० १६-७७<br><br>कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ತವದ ನಿತಂಬಪ್ರದೇಶ /ಬೆಟ್ಟದ ತಪ್ಪಲುಪ್ರದೇಶ<br><b>प्रयोगाः - </b>"दन्तोज्ज्वलासु विमलोपलमेखलान्ताः सद्रत्नचित्रकटकासु बृहन्नितम्बाः"<br><b>उल्लेखाः - </b>माघ० ४-४०<br><br>कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇನೆಯ ಶಿಬಿರ<br><b>प्रयोगाः - </b>"आकुल्यकारि कटकस्तुरगेण तूर्णमश्वेति विद्रुतमनुद्रवताऽश्वमन्यम्"<br><b>उल्लेखाः - </b>माघ० ५-५९, ६१<br><br>कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜಧಾನಿ<br><br>कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಕೊಂಬಿನ ಆಭರಣ<br><br>कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೈನ್ಯ<br><br>कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರದ ಉಪ್ಪು<br><br>कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒರಿಸ್ಸಾ ಪ್ರಾಂತದ ರಾಜಧಾನಿ /ಮುಖ್ಯಪಟ್ಟಣ<br><b>विस्तारः - </b>"कटकोऽस्त्री नितम्बोऽद्रेः दन्तिनां दन्तभूषणे । सामुद्रलवणे राजधानीवलययोरपि" - मेदि० । "कटकस्त्वद्रिनितम्बे बाहुभूषणे । सेनायां राजधान्यां च" - हेम० ।<br><br>कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇನಾಸಮೂಹ<br><b>प्रयोगाः - </b>"स च दिग्विजयव्यापारक्रमेणागत्य चन्द्रभागानदीतीरे समावेशितकटको वर्तते"<br><b>उल्लेखाः - </b>हितो०<br><br>कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತದ ಪ್ರಸ್ಥಭೂಮಿ /ಬೆಟ್ಟದಸಮಭೂಮಿ<br><b>प्रयोगाः - </b>"नवनगवनलेखाश्याममध्याभिराभिः स्फटिककटकभूमिर्नाटयत्येष शैलः"<br><b>उल्लेखाः - </b>माघ० ४-६५<br><b>विस्तारः - </b>"कटकं वलये सानौ राजधानीनितम्बयोः"- विश्व० ।<br><br>कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಪೆ<br><br>कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಟಿಬಂಧ /ನಡುಕಟ್ಟು /ಡಾಬು<br><br>कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಕ್ರ /ಗಾಲಿ<br><br>कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಧ್ಯಭಾಗ<br><b>प्रयोगाः - </b>"स्वप्राणेश्वरनर्महर्म्यकटकातिथ्यग्रहायोत्सुकं पाथोदं निजकेलिसौधशिखरादारुह्य यत्कामिनी"<br><b>उल्लेखाः - </b>नैष० २-१०४<br><br>

कटकट
कटकट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾದೇವ /ಪರಶಿವ<br><b>प्रयोगाः - </b>"नमो नाभाया नाभ्याय नमः कटकटाय च"<br><b>उल्लेखाः - </b>भा० शान्ति० २९०-९०<br><br>कटकट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರದ ಉಪ್ಪು<br><br>

कटकर|कर्मन्
कटकर - कर्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೂದ್ರ ಸ್ತ್ರೀಯಲ್ಲಿ ಜಾರವೈಶ್ಯನಿಂದ ಹುಟ್ಟಿದ ಬೆರಕೆ ಜಾತಿಯವನು<br><b>विस्तारः - </b>"वैश्याद्वैदेहकं विप्रा क्षत्रकन्या तु मागधम् । शूद्रा तु करणं सैव जारात्कटकरं ततः ॥" - वैज०<br><br>कटकर - कर्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಪೆಯನ್ನು ತಯಾರಿಸುವವನು<br><b>विस्तारः - </b>"उग्रः पारशवो दुर्गधनान्तः पुरपालनात् । अन्वर्थः स्यात् कटकरो द्वादशैतेऽनुलोमजाः" - वैज० ।<br><br>

कटकिन्
कटकिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತ /ಬೆಟ್ಟ<br><br>कटकिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬ್ಳೆಯನ್ನು ತೊಟ್ಟಿರುವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कटकोऽस्यास्ति<br><br>

कटकी
कटकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಣ್ಣೆಯ ಕಾರ್ಖಾನೆ<br><b>विस्तारः - </b>"तैलिशाला यन्त्रगृहं पोटकी कटकी च सा" - वैज० ।<br><br>

कटकीय
कटकीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಳೆಯನ್ನು ತಯಾರಿಸಲು ಉಪಯೋಗಿಸುವ ಚಿನ್ನ ಬೆಳ್ಳಿ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>वा "छः" (५-१-४)<br><b>व्युत्पत्तिः - </b>कटकाय हितम्<br><br>

कटक्य
कटक्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಳೆಯನ್ನು ತಯಾರಿಸಲು ಉಪಯೋಗಿಸುವ ಚಿನ್ನ ಬೆಳ್ಳಿ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>पक्षे "यत्" (५-१-२<br><br>

कटकृत्
कटकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಾಪೆಯನ್ನು ತಯಾರಿಸುವವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>कटं करोति<br><br>

कटकोल
कटकोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಡಿಗ /ಪೀಕದಾನಿ /ತಾಂಬೂಲ ರಸಾದಿಗಳನ್ನು ಉಗುಳುವ ಪಾತ್ರೆ<br><b>निष्पत्तिः - </b>कटे (वर्षावरणयोः) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कटति वर्षति स्रवति । कटस्य निष्ठीवनजलस्य कोलो घनीभावो यत्र<br><br>

कटखादक
कटखादक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಂಬುಕ /ನರಿ<br><br>कटखादक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯಸ /ಕಾಗೆ<br><br>कटखादक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಜಿನ ಪಾತ್ರೆ<br><br>कटखादक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸರ್ವಭಕ್ಷಕ /ಸಿಕ್ಕಿದುದೆಲ್ಲವನ್ನೂ ತಿನ್ನುವವನು<br><b>निष्पत्तिः - </b>खादृ (भक्षणे) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कटमपि खादति<br><b>विस्तारः - </b>"अथ कटखादकः । खादके काचकलशे बलिपुष्टे च जम्बुके"- मेदि० ।<br><br>

कटघोष
कटघोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪೂರ್ವದೇಶದಲ್ಲಿರುವ ಒಂದು ಗ್ರಾಮ /ಒಂದು ಗೊಲ್ಲರ ಹಳ್ಳಿ<br><b>निष्पत्तिः - </b>कटघोष - "छः" (४-२-१३९)<br><br>

कटनगर
कटनगर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಟಘೋಷಗ್ರಾಮಕ್ಕೆ ಸಂಬಂಧಿಸಿದ /ಕಟಘೋಷಗ್ರಾಮದಲ್ಲಿರುವ<br><br>

कटपल्ली
कटपल्ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಟಘೋಷಗ್ರಾಮಕ್ಕೆ ಸಂಬಂಧಿಸಿದ /ಕಟಘೋಷಗ್ರಾಮದಲ್ಲಿರುವ<br><br>

कटपल्वल
कटपल्वल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಟಘೋಷಗ್ರಾಮಕ್ಕೆ ಸಂಬಂಧಿಸಿದ /ಕಟಘೋಷಗ್ರಾಮದಲ್ಲಿರುವ<br><br>

कटङ्कट
कटङ्कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>निष्पत्तिः - </b>कटे (वर्षावरणयोः) - "कखच्" बाहु० । मुमागमः (६-३-६७)<br><b>व्युत्पत्तिः - </b>कटं कटति ज्वालया आवृणोति<br><br>कटङ्कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><br>कटङ्कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯಿಂದ ಹುಟ್ಟಿದ ಸುವರ್ಣ /ಚಿನ್ನ<br><br>कटङ्कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರ ಮೂಲದ ಗಿಡ<br><br>कटङ्कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಣಪತಿ<br><br>

कटङ्कटेरी
कटङ्कटेरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹರಿದ್ರೆ /ಅರಿಶಿನ<br><b>निष्पत्तिः - </b>ईर (गतौ) - "अण्" (३-२-१) । "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>कटङ्करं वह्निजं सुवर्णं तत्कान्तिमीरयति<br><b>विस्तारः - </b>"कटङ्कटेरी हरिद्रा" - त्रिकाण्ड० ।<br><br>कटङ्कटेरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮರದರಿಶಿನ<br><b>प्रयोगाः - </b>"नीलोत्पलोशीरकटङ्कटेरी"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

कटपूतन
कटपूतन<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಿಶಾಚಿಗಳಲ್ಲೊಂದು ಭೇದ /ತನ್ನ ಕರ್ತವ್ಯವನ್ನು ಪಾಲಿಸದ ಕ್ಷತ್ರಿಯನು ಮೃತನಾದ ಮೇಲೆ ಹೊಂದುವ ಒಂದು ಜನ್ಮ<br><b>प्रयोगाः - </b>"वान्ताश्युल्कामुखः प्रेतो विप्रो धर्मास्त्वकाच्च्युतः । अमेध्यकुणपाशी च क्षत्रियः कटपूतनः ॥"<br><b>उल्लेखाः - </b>मनु० १२-७१<br><br><b>कन्नडार्थः - </b>ಪಿಶಾಚಿಗಳಲ್ಲೊಂದು ಭೇದ /ತನ್ನ ಕರ್ತವ್ಯವನ್ನು ಪಾಲಿಸದ ಕ್ಷತ್ರಿಯ ಹೆಂಗಸು ಮೃತಳಾದ ಮೇಲೆ ಹೊಂದುವ ಒಂದು ಜನ್ಮ<br><b>प्रयोगाः - </b>"संसक्ताकुलकेलयः किलकिलाकोलाहलैः सम्मदादुत्तालाः कटपूतनाप्रभृतयः सांराविणं कुर्वते"<br><b>उल्लेखाः - </b>मालती० ५-११<br><br><br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कटु ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां वा "ङीष्" (४-१-४४)<br><br>

कटप्रू
कटप्रू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಹುಳ<br><br>कटप्रू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><br>कटप्रू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಕ್ಷಸ<br><b>निष्पत्तिः - </b>प्रुङ् (गतौ) - "क्विप्"<br><b>व्युत्पत्तिः - </b>कटे श्मशाने प्रवते<br><br>कटप्रू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿದ್ಯಾಧರ<br><br>कटप्रू<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಗಡೆಯಾಟವಾಡುವವನು<br><b>विस्तारः - </b>"कटप्रूः पुंसि राक्षसे । विद्याधरे महादेवे तथा स्यादक्षदेवके" - मेदि० ।<br><br>

कटप्रोथ|कटिप्रोथ
कट(टि) प्रोथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಿರ್ರೆಗಳ ಮೇಲೆ ಎತ್ತರವಾಗಿರುವ ಮಾಂಸಪಿಂಡ<br><b>व्युत्पत्तिः - </b>कटस्य कट्या वा प्रोथो मांसपिण्डः<br><br>

कटभङ्ग
कटभङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಯಿಂದ ಧಾನ್ಯದ ತೆನೆಗಳನ್ನು ಕೊಯ್ಯುವವನು<br><b>व्युत्पत्तिः - </b>कटानामोषधीनां भङ्गः छेदनम्<br><br>कटभङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನ ವಿನಾಶ<br><b>व्युत्पत्तिः - </b>कटानां सैन्यानां भङ्गो नाशो यस्मात्<br><br>

कटभी
कटभी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಷ್ಮತೀ ಲತೆ /ಕಂಗೊಂಗೆ ಗಿಡ<br><b>निष्पत्तिः - </b>भा (दीप्तौ) - "डः" (३-२-१०१)<br><b>व्युत्पत्तिः - </b>कट इव भाति<br><br>कटभी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಿಡಿಲೊಲ್ಲದ ಗಿಡ /ಹರಿದ್ರಾಂಜನ ವೃಕ್ಷ<br><b>विस्तारः - </b>"कटभी वृक्षभेदेऽपि ज्योतिश्मत्यामपि स्त्रियाम्" - मेदि० ।<br><br>

कटभू
कटभू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಕುಂಭಸ್ಥಳ ಅಥವಾ ಗಂಡಸ್ಥಳ<br><b>व्युत्पत्तिः - </b>कटस्य भूः<br><br>

कटम्ब
कटम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾದಿತ್ರವೆಂಬ ಒಂದು ವಾದ್ಯ<br><b>निष्पत्तिः - </b>कटे (वर्षावरणयोः) - "अम्बच्" (उ० ४-८२)<br><br>कटम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶರ /ಬಾಣ<br><br>

कटम्भर
कटम्भर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಿಡಿಲೊಲ್ಲದ ಗಿಡ /ಹರಿದ್ರಾಂಜನ ವೃಕ್ಷ<br><br>कटम्भर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಮ್ಮರ /ತಿಗಡುಮರ<br><br>

कटम्भरा
कटम्भरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾರಣಿ ಗಿಡ /ಮುಳ್ಳು ಅಗಸೆ ಗಿಡ<br><br>कटम्भरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೀರೆಗಿಡ<br><br>कटम्भरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಟುಕರೋಹಿಣಿ<br><br>कटम्भरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣಾನೆ<br><br>कटम्भरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುರಟಗೆ ಗಿಡ<br><br>कटम्भरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣಾಮೆ<br><br>कटम्भरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಗುಬ್ಬಚ್ಚಿ<br><br>

कटव्रण
कटव्रण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೀಮಸೇನ<br><b>व्युत्पत्तिः - </b>कटः उत्कृष्टः व्रणो यस्य<br><br>

कटाक्ष
कटाक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಡೆಗಣ್ಣಿನ ನೋಟ<br><b>निष्पत्तिः - </b>अक्षू (व्याप्तौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कटं गण्डस्थलं अक्षति<br><b>प्रयोगाः - </b>"निःशङ्कमन्याः सममाहितेर्ष्याः तत्रान्तरे जघ्नुरमुं कटाक्षैः"<br><b>उल्लेखाः - </b>माघ० ३-१६<br><br>

कटाक्षण
कटाक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಡೆಗಣ್ಣಿನ ನೋಟದಿಂದ ಮಾಡುವ ಸಂಜ್ಞೆ<br><b>प्रयोगाः - </b>"कटाक्षणाज्जन्यजनैर्निजप्रजाः क्वचित्परीहासमचीकरत्तमाम्"<br><b>उल्लेखाः - </b>नैष० १६-४८<br><br>

कटायन
कटायन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಮಂಚದ ಬೇರು<br><b>व्युत्पत्तिः - </b>कटस्यायनमुत्पत्तिस्थानम्<br><br>

कटार
कटार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮುಕ /ಸ್ತ್ರೀಲಂಪಟ<br><b>निष्पत्तिः - </b>कटे (वर्षावरणयोः) - "आरन्" बाहु० ।<br><br>

कटाह
कटाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುರಿಯುವ ಬಾಣಲಿ<br><b>निष्पत्तिः - </b>आ + हन (हिंसागत्योः) - "डः" (३-२-१०१)<br><b>व्युत्पत्तिः - </b>कटमाहन्ति<br><br>कटाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯೆಲುಬಿನ ಚಿಪ್ಪು<br><b>प्रयोगाः - </b>"यद्दन्तिनः कटकटाहतटान्मिमङ्क्षोर्मङ्क्षूदपाति परितः पटलैरलीनाम्"<br><b>उल्लेखाः - </b>माघ० ५-३७<br><br>कटाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಬೆನ್ನು /ಆಮೆಯ ಚಿಪ್ಪು<br><br>कटाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದ್ವೀಪ<br><br>कटाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಣ್ಣೆ ಮೊದಲಾದುವನ್ನು ಕಾಯಿಸುವ ಕೊಪ್ಪರಿಗೆ<br><br>कटाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಗತಾನೆ ಕೊಂಬು ಹುಟ್ಟುತ್ತಿರುವ ಎಮ್ಮೆಯ ಹೆಂಗರು<br><b>विस्तारः - </b>"कटाहः कूर्मकर्परे । द्वीपस्य च प्रभेदे स्यात्तैलादेः पाकभाजने । जायमानविषाणाग्रमहिषीशावकेऽपि च ।" - मेदि० । "कटाहः स्यात् कूर्मपृष्ठे कर्परे महिषीशिशौ" - हेम० ।<br><br>कटाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಡಿಗೆಯ ಪಾತ್ರೆ<br><br>कटाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಪ /ತೊವ್ವೆ<br><b>विस्तारः - </b>"सूपे च पाकपात्रे च कटाहो महिषीशिशौ" - त्रिकाण्ड० ।<br><br>

कटि
कटि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಿರ್ರೆಯ ಮೇಲುಭಾಗ /ಕುಂಡಿಯಎತ್ತರವಾದ ಭಾಗ /ಸೊಂಟ<br><b>निष्पत्तिः - </b>कटे (वर्षावरणयोः) - "इन्" (उ० ४-११७)<br><b>व्युत्पत्तिः - </b>कट्यते<br><br>

कटितल
कटितल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೊಂಟ /ನಡು<br><br>

कटित्र
कटित्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಡಾಬು /ಒಡ್ಯಾಣ<br><b>निष्पत्तिः - </b>त्रैङ् (पालने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कटिं त्रायते<br><br>कटित्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಡುವಿನ ಸುತ್ತಲೂ ಕಟ್ಟುವ ಬಟ್ಟೆ<br><br>कटित्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಡುವಿಗೆ ಕಟ್ಟುವ ಗೆಜ್ಜೆಯಸರ / ಗೆಜ್ಜೆಯ ಉಡುದಾರ<br><b>प्रयोगाः - </b>"मृणालगौरं शितिवाससं स्फुरत्किरीटकेयूरकटित्रकङ्कणम्"<br><b>उल्लेखाः - </b>भाग० ६-१६-३०<br><br>

कटिदेश
कटिदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೊಂಟ /ನಡು<br><br>

कटिन्
कटिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಶಸ್ತವಾದ ಗಂಡಪ್ರದೇಶವುಳ್ಳ ಆನೆ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>प्रशस्तः कटोऽस्त्यस्य<br><br>

कटिबन्ध
कटिबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಡಾಬು /ಒಡ್ಯಾಣ<br><b>निष्पत्तिः - </b>बन्ध (बन्धने) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>कटिर्बध्यतेऽनेन<br><br>

कटिमालिका
कटिमालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಡಾಬು /ಒಡ್ಯಾಣ<br><b>व्युत्पत्तिः - </b>कटौ मालेव<br><br>

कटिल्ल
कटिल्ल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಗಲದ ಗಿಡ<br><b>निष्पत्तिः - </b>कटे (वर्षावरणयोः) - "इल्लः" बाहु० ।<br><br>

कटिल्लक
कटिल्लक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಗಲದ ಗಿಡ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><br>

कटिशूल
कटिशूल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಫ ಮತ್ತು ವಾತಗಳಿಂದ ಉಂಟಾದ ಸೊಂಟದ ನೋವು<br><b>व्युत्पत्तिः - </b>कटिस्थं शूलम्<br><b>प्रयोगाः - </b>"कुष्ठस्य भागमेकं तु पथ्याभागद्वयं तथा । उष्णोदकेन सम्पीत्वा कटिशूलविनाशनम् ॥"<br><br>

कटिशृङ्खला
कटिशृङ्खला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೆಜ್ಜೆಯ ನಡುಕಟ್ಟು /ನಡುಪಟ್ಟಿ /ಡಾಬು /ಒಡ್ಯಾಣ<br><b>विस्तारः - </b>"चित्तिका कटिशृङ्खला" - हारा० ।<br><br>

कटिसूत्र
कटिसूत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಡುದಾರ /ನೂಲಿನ ಅಥವಾ ಚಿನ್ನ ಬೆಳ್ಳಿಯ ನಡುದಾರ<br><b>व्युत्पत्तिः - </b>कटौ धार्यं सूत्रम्<br><br>

कटीतल
कटीतल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿರುವ ಖಡ್ಗ /ಕತ್ತಿ<br><b>व्युत्पत्तिः - </b>कट्यां तलमास्पदं यस्य<br><b>विस्तारः - </b>"न्युब्जखङ्गः कटीतलः" - त्रिकाण्ड० ।<br><br>कटीतल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೊಂಟ /ನಡು<br><b>व्युत्पत्तिः - </b>कट्यास्तलम्<br><br>

कटीर
कटीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಹೆ /ಗವಿ<br><b>निष्पत्तिः - </b>कटे (वर्षावरणयोः) - "ईरन्" (उ० ४-३०)<br><br>कटीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಟಿಪ್ರದೇಶದಲ್ಲಿರುವ ಗುಣಿ<br><br>कटीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿತಂಬ /ಕಟಿಪಶ್ಚಾದ್ಭಾಗ /ಸೊಂಟದ ಹಿಂಭಾಗ<br><br>

कटीरक
कटीरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿತಂಬ /ಕಟಿಪಶ್ಚಾದ್ಭಾಗ /ಸೊಂಟದ ಹಿಂಭಾಗ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><b>प्रयोगाः - </b>"व्यचलन् विशङ्कटकटीरकस्थलीशिखरस्खलन्मुखरमेखलाकुलाः"<br><b>उल्लेखाः - </b>माघ० १३-३७<br><b>विस्तारः - </b>"नितम्बः स्यात् कटीरकः" - त्रिकाण्ड० ।<br><br>

कटु
कटु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರವೆಂಬ ಒಂದು ರಸ /೬ ವಿಧ ಭೋಜ್ಯರಸಗಳಲ್ಲೊಂದು<br><b>निष्पत्तिः - </b>कटे (वर्षावरणयोः) - "उः" (उ० १-८)<br><b>व्युत्पत्तिः - </b>कटति आवृणोति रसनां मुखं च<br><br>कटु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೀಣದ ಕರ್ಪೂರ<br><br>कटु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಳ್ಳುಳ್ಳಿ<br><br>कटु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಕಾರ್ಯ /ಮಾಡಬಾರದ ಕಾರ್ಯ<br><br>कटु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೂಷಣೆ /ನಿಂದೆ<br><b>व्युत्पत्तिः - </b>कटति सदाचारमावृणोति<br><br>कटु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತ್ರಿಕಟು /ಶುಂಠಿ ಹಿಪ್ಪಲಿ ಮತ್ತು ಮೆಣಸು<br><br>कटु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಟುಕರೋಹಿಣಿ<br><br>कटु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೆಣಸು<br><br>कटु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿಸಾಸಿವೆ<br><br>कटु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೇಂಕಣಗಿಡ<br><br>कटु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರವಾದ<br><b>प्रयोगाः - </b>"कट्वम्ललवणात्युष्णतीक्ष्णरूक्षविदाहिनः । आहारा राजसस्येष्ठाः दुःखशोकामयप्रदाः ॥"<br><b>उल्लेखाः - </b>गीता० १७-९<br><br>कटु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ರೂರವಾದ<br><b>प्रयोगाः - </b>"वियोगभाजां हृदि कण्टकैः कटुर्निधीयसे कर्णिशिरः स्मरेण यत्"<br><b>उल्लेखाः - </b>नैष० १-७९<br><br>कटु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುವಾಸನೆಯುಳ್ಳ /ಗಂಧವುಳ್ಳ<br><b>प्रयोगाः - </b>"सप्तच्छदक्षीरकटुप्रवाहमसह्यमाघ्राय मदं तदीयम्"<br><b>उल्लेखाः - </b>रघु० ५-४८<br><br>कटु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಠಿನವಾದ /ಪರುಷವಾದ<br><b>प्रयोगाः - </b>"इति समगुणयोगप्रीतयस्तत्र पौराः श्रवणकटु नृपाणामेकवाक्यं विवव्रुः"<br><b>उल्लेखाः - </b>रघु० ६-८५<br><br>कटु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾತ್ಸರ್ಯವುಳ್ಳ /ಅಸೂಯೆಯುಳ್ಳ<br><br>कटु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಿತವಾದ /ತೀಕ್ಷ್ಣ್ಣವಾದ<br><b>विस्तारः - </b>"कटुः सुगन्धे तीक्ष्णे स्यादकार्ये मत्सरे रसे । कटुः प्रियङ्गुकटुकाराजिकास्वथ दूषणे" - विश्व० ।<br><br>

कटुक
कटुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ /ಕಟುರಸ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्" (५-३-७५)<br><b>व्युत्पत्तिः - </b>कटुरेव<br><b>प्रयोगाः - </b>"यो जिह्वाग्रं बाधते उद्वेगं जनयति शिरो गृह्णीते नासिकां च स्रावयति स कटुको रसः"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>कटुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಡವಲ ಗಿಡ<br><br>कटुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಕ್ಕದ ಗಿಡ<br><br>कटुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಟ್ಟಮಲ್ಲಿಗೆ/ಕುಟಜ ವೃಕ್ಷ<br><br>कटुक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿಸಾಸಿವೆ<br><br>कटुक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತ್ರಿಕಟು /ಶುಂಠಿ ಹಿಪ್ಪಲಿ ಮತ್ತು ಮೆಣಸು<br><br>कटुक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪ್ರಿಯವಾದ ಮಾತು<br><b>प्रयोगाः - </b>"दुर्योधनश्च कर्णश्च कटुकान्यभ्यभाषताम् । इति सर्वमिदं राजन् आकुलं प्रतिभाति मे ॥"<br><b>उल्लेखाः - </b>भा० सभा० १०३-१८<br><br>

कटुका
कटुका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಟುಕರೋಹಿಣಿ<br><b>निष्पत्तिः - </b>कटु - सञ्ज्ञायां "कन्" (५-३-७५)<br><br>

कटुकत्रय
कटुकत्रय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತ್ರಿಕಟು /ಶುಂಠಿ ಹಿಪ್ಪಲಿ ಮತ್ತು ಮೆಣಸು<br><br>

कटुकन्द
कटुकन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನುಗ್ಗೆಮರ<br><b>व्युत्पत्तिः - </b>कटुः कन्दो मूलमस्य<br><br>कटुकन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಸಿಶುಂಠಿ<br><br>

कटुजालाबु|कटुजालाबू
कटुजालाबु(बू)<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಹಿ ಸೋರೆಗಿಡ<br><b>व्युत्पत्तिः - </b>कटुका अलाबुः (बूः)<br><br>

कटुकीटक
कटुकीटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೊಳ್ಳೆ<br><b>व्युत्पत्तिः - </b>कटुः तीक्ष्णः कीटकः<br><br>

कटुक्वाण
कटुक्वाण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಟಿಟ್ಟಿಭಪಕ್ಷಿ<br><b>व्युत्पत्तिः - </b>कटुः कर्कशः क्वाणः शब्दो यस्य<br><br>

कटुग्रन्थि
कटुग्रन्थि<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಪ್ಪಲಿಯ ಬೇರು<br><br>कटुग्रन्थि<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶುಂಠಿ<br><b>व्युत्पत्तिः - </b>कटुस्तीव्रो ग्रन्थिर्यस्य<br><br>

कटुचातुर्जातक
कटुचातुर्जातक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಲಕ್ಕಿ ಲವಂಗಪಟ್ಟೆ ಲವಂಗಪತ್ರೆ ಮತ್ತು ಮೆಣಸು ಈ ನಾಲ್ಕರಸಮುದಾಯ<br><br>

कटुतिक्तक
कटुतिक्तक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೂನಿಂಬ ವೃಕ್ಷ /ನೆಲಬೇವಿನ ಮರ<br><b>निष्पत्तिः - </b>अल्पार्थे "कन्" (५-३-८५)<br><b>व्युत्पत्तिः - </b>कटुश्चासौ तिक्तश्च<br><br>

कटुतिक्ता
कटुतिक्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಹಿ ಸೋರೆಗಿಡ<br><br>

कटुतुम्बी
कटुतुम्बी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಹಿ ಸೋರೆಗಿಡ<br><b>व्युत्पत्तिः - </b>कटुश्चसौ तुम्बी च<br><br>

कटुत्रय
कटुत्रय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರವಾದಶುಂಠಿ ಹಿಪ್ಪಲಿ ಮತ್ತು ಮೆಣಸು<br><b>व्युत्पत्तिः - </b>कटूनां त्रयम्<br><br>

कटुत्रिक
कटुत्रिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರವಾದಶುಂಠಿ ಹಿಪ್ಪಲಿ ಮತ್ತು ಮೆಣಸು<br><b>व्युत्पत्तिः - </b>कटूनां त्रिकम्<br><br>

कटुत्व
कटुत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ<br><br>कटुत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚುರುಕಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कटोर्भावः<br><br>

कटुता
कटुता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कटुत्व ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><br>

कटुपाक
कटुपाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರವಾಗುವಂತೆ ಇಳಿಸುವ ಪಾಕ<br><br>

कटुभङ्ग
कटुभङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶುಂಠಿ<br><b>व्युत्पत्तिः - </b>कटुः भङ्गः एकैकदेशो यस्य<br><br>

कटुभद्र
कटुभद्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶುಂಠಿ<br><b>व्युत्पत्तिः - </b>कटुरपि भद्रः हितकारी<br><br>

कटुमञ्जरिका
कटुमञ्जरिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರಣೆ ಗಿಡ<br><b>व्युत्पत्तिः - </b>कटुः मञ्जरी अस्त्यस्याः<br><br>

कटुमोद
कटुमोद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದವನ<br><b>व्युत्पत्तिः - </b>कटुः सुरभिः मोदोऽस्य<br><br>

कटुर
कटुर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಕ್ರ /ಮಜ್ಜಿಗೆ /ನೀರು ಬೆರೆಸಿದ ಮೊಸರು<br><b>निष्पत्तिः - </b>कटे (वर्षावरणयोः) - "उरच्" (उ० १-४१)<br><b>व्युत्पत्तिः - </b>कटति गुणान्तरं वर्षति<br><br>

कटुरव
कटुरव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಠಿನವಾದಶಬ್ದ /ಕರ್ಕಶ ಧ್ವನಿ<br><b>व्युत्पत्तिः - </b>कटुः परुषः रवः शब्दः<br><br>कटुरव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಡೂಕ /ಕಪ್ಪೆ<br><b>व्युत्पत्तिः - </b>कटुः परुषः रवो यस्य<br><br>

कटुरवी
कटुरवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಠಿನವಾದ ಶಬ್ದವುಳ್ಳ /ಕರ್ಕಶ ಧ್ವನಿಯುಳ್ಳ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

कटुरोहिणी
कटुरोहिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಟುಕರೋಹಿಣಿ<br><b>व्युत्पत्तिः - </b>कटुश्चासौ रोहिणी च<br><b>विस्तारः - </b>"कटुः कटम्भराऽशोका रोहिणी कटुरोहिणी" - अम० ।<br><br>

कटुवर्ग
कटुवर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಟು ರಸವುಳ್ಳ ವಸ್ತುಗಳ ಸಮುದಾಯ /ಕಟುವಸ್ತುಗಳ ಪಂಗಡ<br><br>

कटुस्नेह
कटुस्नेह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿ ಸಾಸುವೆ<br><b>व्युत्पत्तिः - </b>कटुः स्नेहोऽस्य<br><br>

कटूत्कट
कटूत्कट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸಿಶುಂಠಿ<br><b>व्युत्पत्तिः - </b>कटुषु वस्तुषु उत्कटम्<br><br>

कटोल
कटोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂಡಾಲ /ನಿಮ್ನ ಜಾತಿಯವನು<br><br>कटोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಟುರಸ<br><br>कटोल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರವಾಗಿರುವ<br><br>

कटोलवीणा
कटोलवीणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂಡಾಲನು ಬಾರಿಸುವ ವೀಣೆ<br><br>

कट्टार
कट्टार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತಿ /ಖಡ್ಗ<br><br>

कट्फल
कट्फल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವನಿಯ ಮರ ಅಥವಾ ತೇಗದ ಮರ<br><b>व्युत्पत्तिः - </b>कटूनि फलानि अस्य<br><br>

कट्वङ्ग
कट्वङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಮ್ಮರ /ತಿಗಡುಮರ<br><b>व्युत्पत्तिः - </b>कटु अङ्गमस्य<br><br>

कट्वर
कट्वर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಂಜನ<br><b>निष्पत्तिः - </b>कटे (वर्षावरणयोः) - "ष्वरच्"(उ० ३-१)<br><b>विस्तारः - </b>"कट्वरं व्यञ्जनम्" - सि० कौ० ।<br><br>कट्वर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಜ್ಜಿಗೆ /ನೀರು ಬೆರೆಸಿದ ಮೊಸರು<br><br>कट्वर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಸರಿನ ರಸ /ಮೊಸರಿನ ಸಾರ<br><br>

कठ|कृच्छ्रजीवने|कठति
कठ - कृच्छ्रजीवने (भ्वा० पर० अक० से०) कठति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕಷ್ಟದಿಂದ ಜೀವಿಸು<br><br>

कठ
कठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಋಷಿ /ವೈಶಂಪಾಯನನ ಶಿಷ್ಯ<br><br>कठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೈಶಂಪಾಯನಮಹರ್ಷಿಯ ೯ ಮಂದಿ ಶಿಷ್ಯರಲ್ಲಿ ಒಬ್ಬನಾದ ಕಠಮಹರ್ಷಿಯಿಂದ ಪ್ರೋಕ್ತವಾದ ಯಜುರ್ವೇದದ ಭಾಗವನ್ನು ಅಧ್ಯಯನ ಮಾಡುವವರು<br><b>निष्पत्तिः - </b>कठ - "णिनिः" (४-३-१०४) । "अण्" (४-२-५९) । तयोर्लुक् (४-२-६४) (४-३-१०७)<br><b>व्युत्पत्तिः - </b>कठेन प्रोक्तमधीते<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् । आलम्बिः, कलिङ्गः, कमलः, ऋचाभः, आरुणिः, ताण्ड्यः, श्यामायनः, कठः, कलापी इमे वैशम्पायनशिष्याः ।<br><br>

कठमर्द
कठमर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><b>निष्पत्तिः - </b>मृद (क्षोदे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कठं कष्टजीवनं मृद्नाति<br><br>

कठर
कठर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಠಿನವಾದ /ಗಟ್ಟಿಯಾದ<br><b>निष्पत्तिः - </b>कठ - "अरः" बाहु० ।<br><br>

कठिका
कठिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲೇಖನಿ /ಬರೆಯುವ ಕಡ್ಡಿ<br><br>

कठिञ्जर
कठिञ्जर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತುಲಸಿ<br><b>निष्पत्तिः - </b>जॄ (वयोहानौ) + णिच्- "खच्" "मुम्"च । बाहु० । पृषो० ।<br><b>व्युत्पत्तिः - </b>कठिनं जरयति<br><br>

कठिन
कठिन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರ್ಕಶವಾದ /ಗಟ್ಟಿಯಾದ<br><b>निष्पत्तिः - </b>कठ (कृच्छ्रजीवने) - "इनच्" (उ० २-५०)<br><b>प्रयोगाः - </b>"उद्धूताः कठिनकुचस्थलाभिघातात्"<br><b>उल्लेखाः - </b>माघ० ८-४०<br><br>कठिन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯೆಯಿಲ್ಲದ /ಕ್ರೂರನಾದ<br><b>प्रयोगाः - </b>"परित्यक्तं सर्वं हसितपतितं पञ्जरशुकैः तवावस्था चेयं विसृज कठिने मानमधुना"<br><b>उल्लेखाः - </b>अमरु०<br><br>कठिन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನಸ್ಸಿಗೆ ನೋವುಂಟುಮಾಡುವ<br><br>कठिन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಲನಾದ /ಸ್ತಬ್ಧನಾದ<br><br>कठिन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೀವ್ರವಾದ /ತೀಕ್ಷ್ಣವಾದ /ಸಹಿಸಲಶ್ಯಕ್ಯವಾದ<br><b>प्रयोगाः - </b>"नितान्तकठिनां रुजं मम न वेद सा मानसीं प्रभावविदितानुरागमवमन्यतेवापि माम्"<br><b>उल्लेखाः - </b>विक्र० २-११<br><br>कठिन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಾಲಿ /ಅಡುಗೆ ಮಾಡುವ ಪಾತ್ರೆ<br><br>

कठिना
कठिना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶುದ್ಧಿ ಮಾಡಲ್ಪಟ್ಟ ಗಟ್ಟಿಯಾದ ಸಕ್ಕರೆ /ಬತ್ತಾಸು<br><br>

कठिनी
कठिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲೇಖನಿ /ಬರೆಯುವ ಕಡ್ಡಿ<br><b>प्रयोगाः - </b>"गुणिगणगणनारम्भे न पतति कठिनी ससम्भ्राता यस्य"<br><b>उल्लेखाः - </b>हितो०<br><b>विस्तारः - </b>"कठिनमपि निष्ठुरे स्यात्स्तब्धेऽपि त्रिषु नपुंसकं स्थाल्याम्" - मेदि० ।<br><br>कठिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कठिन ಪದದ ಅರ್ಥ<br><br>

कठिनक
कठिनक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯ ಸಕ್ಕರೆ ಮೊದಲಾದುವನ್ನು ತೋಡಿ ಮತ್ತೊಂದಕ್ಕೆ ಹಾಕಲು ಅನುಕೂಲವಾದ ಮೋಟುಹಿಡಿಯ ತೋಡುಕೈ /ಸೌಟಿನ ಆಕಾರದ ಅದ್ದುಪಾತ್ರೆ<br><br>

कठिनचित्त|कठिनहृदय
कठिनचित्त- हृदय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಲುಮನಸ್ಸು /ಗಟ್ಟಿಮನಸ್ಸು /ದಯೆಯಿಲ್ಲದ ಮನಸ್ಸು<br><br>कठिनचित्त- हृदय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಲ್ಲುಮನಸ್ಸುಳ್ಳ /ಗಟ್ಟಿ ಮನಸ್ಸುಳ್ಳ /ದಯೆಯಿಲ್ಲದ<br><b>व्युत्पत्तिः - </b>कठिनं चित्तं हृदयं वा यस्य<br><br>

कठिनता
कठिनता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಕಶವಾಗಿರುವಿಕೆ /ಗಟ್ಟಿಯಾಗಿರುವಿಕೆ<br><br>कठिनता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿರ್ದಯನಾಗಿರುವಿಕೆ /ಕ್ರೂರನಾಗಿರುವಿಕೆ<br><br>कठिनता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಲವಾಗಿರುವಿಕೆ /ದೃಢವಾಗಿರುವಿಕೆ<br><br>कठिनता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೀಕ್ಷ್ಣ್ಣವಾಗಿರುವಿಕೆ /ತೀವ್ರವಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कठिनस्य भावः<br><br>

कठिनत्व
कठिनत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>कठिनता ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>प्रयोगाः - </b>"वक्रता न ययतुः कुचकुम्भौ सुभ्रुवः कठिनतातिशयेन"<br><b>उल्लेखाः - </b>माघ० १०-४७<br><br>

कठिनपृष्ठ
कठिनपृष्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೂರ್ಮ /ಆಮೆ<br><b>व्युत्पत्तिः - </b>कठिनं पृष्ठमस्य<br><br>

कठिनिका
कठिनिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲೇಖನಿ /ಬರೆಯುವ ಕಡ್ಡಿ<br><b>निष्पत्तिः - </b>कठिनी -स्वार्थे "कन्"<br><br>

कठिनीकृत
कठिनीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कठिन - "च्विः" (५-४-५०) । अस्य ईत् (७-४-३२)<br><b>व्युत्पत्तिः - </b>अकठिनं कठिनं सम्पद्यमानं कृतं<br><br>

कठिनीभूत
कठिनीभूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ ಆಗಿರುವ<br><br>कठिनीभूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯೆಯಿಲ್ಲದವನಾಗಿರುವ /ಕ್ರೂರನಾಗಿರುವ<br><br>

कठिल्लक
कठिल्लक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಗಲ ಗಿಡ<br><br>कठिल्लक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಗೋಲೆ ಗಿಡ<br><br>कठिल्लक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಮ್ಮೆ ಗಿಡ<br><b>निष्पत्तिः - </b>कठ (शोके) - "इल्लः" बाहु० । स्वार्थे "कन्"<br><b>विस्तारः - </b>"कठिल्लकस्तु पणीशे वर्षाभूकारवेल्लयोः" - मेदि० ।<br><br>

कठेर
कठेर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದರಿದ್ರ /ಕಷ್ಟಜೀವಿ /ಜೀವನಕ್ಕಿಲ್ಲದೆ ತೊಂದರೆಪಡುತ್ತಿರುವವನು<br><b>निष्पत्तिः - </b>कठ (कृच्छ्रजीवने) - "एरक्" (उ० १-५८)<br><br>

कठेरु
कठेरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಮರದ ಗಾಳಿ<br><b>निष्पत्तिः - </b>कठ (कृच्छ्रजीवने) - "एरङ्" उश्च बाहु० ।<br><br>

कठोर
कठोर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಠಿನವಾದ /ಗಟ್ಟಿಯಾದ<br><b>निष्पत्तिः - </b>कठ (कृच्छ्रजीवने) - "ओरन्" (उ० १-६४)<br><b>प्रयोगाः - </b>"कठोरास्थिग्रन्थिव्यतिकरघणात्कारमुखरः खरस्नायुच्छेदक्षणविहितवेगव्युपरमः"<br><b>उल्लेखाः - </b>मालती० ५-३४<br><br>कठोर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯೆಯಿಲ್ಲದವ /ಕಲ್ಲುಹೃದಯ /ಕ್ರೂರವಾದ<br><b>प्रयोगाः - </b>"अयि कठोर यशः किल ते प्रियं किमयशो ननु घोरतमः परम्"<br><b>उल्लेखाः - </b>उ० रा० ३-२७<br><br>कठोर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೂರ್ಣವಾದ /ತುಂಬಿದ /ಸಮಗ್ರವಾದ<br><b>प्रयोगाः - </b>"अआतङ्कस्फुरितकठोरगर्भगुर्वीं क्रयाद्भ्योबलमिव दारुणः क्षिपामि"<br><b>उल्लेखाः - </b>उ० रा० १-४९<br><br>कठोर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚುರುಕಾದ /ತೀಕ್ಷ್ಣವಾದ<br><b>प्रयोगाः - </b>"अखिलकलाकलापालोचनकठोरमतिभिः"<br><b>उल्लेखाः - </b>काद०<br><br>कठोर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಿಪಕ್ವವಾದ /ಚೆನ್ನಾಗಿ ಬಲಿತಿರುವ /ಪೂರ್ತಿಯಾಗಿ ಬೆಳೆದಿರುವ<br><b>प्रयोगाः - </b>"स तप्तकार्तस्वरभास्वराम्बरः कठोरताराधिपलाञ्च्छनच्छविः"<br><b>उल्लेखाः - </b>माघ० १-२०, ११<br><br>

कठोरचित्त|हृदय
कठोरचित्त - हृदय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ರೂರವಾದ ಮನಸ್ಸುಳ್ಳ<br><br>कठोरचित्त - हृदय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯೆಯಿಲ್ಲದ /ಕಲ್ಲುಮನಸ್ಸುಳ್ಳ /ಗಟ್ಟಿಮನಸ್ಸಿನ<br><b>व्युत्पत्तिः - </b>कठोरं कठिनं चित्तं हृदयं यस्य<br><b>प्रयोगाः - </b>"वत्सं कठोरहृदये नयनाभिरामं रामं विना न खलु तिष्ठति जीवितं मे"<br><b>उल्लेखाः - </b>चं० रा०<br><br>

कठोरता
कठोरता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಠಿನವಾಗಿರುವಿಕೆ /ಗಟ್ಟಿಯಾಗಿರುವಿಕೆ<br><br>कठोरता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರೂರನಾಗಿರುವಿಕೆ<br><br>कठोरता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಯೆಯಿಲ್ಲದಿರುವಿಕೆ<br><br>कठोरता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೃಢವಾಗಿರುವಿಕೆ<br><br>कठोरता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಗ್ರವಾಗಿರುವಿಕೆ /ಭಯಂಕರವಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कठोरस्य भावः<br><br>

कठोरत्व
कठोरत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>कठोरता ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><br>

कठोरित
कठोरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ರೂರವಾಗಿ ಆಗಿರುವ<br><br>कठोरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯಂಕರವಾಗಿ ಆಗಿರುವ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>कठोरोऽस्य सञ्जातः<br><b>प्रयोगाः - </b>"क्रूरमजनि कुटिलभ्रु गुर्भ्रुकुटीकठोरितललाटमाननम्"<br><b>उल्लेखाः - </b>माघ० १५-८<br><br>

कड|मदे
कड - मदे (भ्वा० पर० सक० से०)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಮದಹೊಂದು<br><br>कड - मदे (भ्वा० पर० सक० से०)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕುಲನಾಗು<br><br>

कड
कड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದ<br><b>निष्पत्तिः - </b>कड (मदे) - घञर्थे "कः" (वा० ३-३-५८)<br><br>कड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂಗ /ಮೂಕ /ಮಾತನಾಡದವನು<br><b>निष्पत्तिः - </b>कड (मदे) - "अच्" (३-१-१३४)<br><br>कड<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂರ್ಖ /ಮೂಢ /ಮಂಕ /ವಿವೇಕವಿಲ್ಲದವನು<br><br>

कडक
कडक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಉಪ್ಪು<br><b>निष्पत्तिः - </b>कड (मदे) - "अच्" (३-१-१३४) । "कन्" (५-३-७५)<br><br>

कडङ्कर|कडङ्गर
कडङ्कर-ङ्गर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯವಿಲ್ಲದ ಹೊಟ್ಟು /ಜಳ್ಳು, ಉದ್ದು ಹೆಸರು ಇವುಗಳ ಕಡ್ಡಿ<br><b>निष्पत्तिः - </b>कड (मदे) - घञर्थे "कः" (वा० ३-३-५८) । डुकृञ् (करणे)- "खच्" निपा० (५-१-६९) । मुमागमः (६-३-६७) । गॄ (निगरणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कडति मद्यति । कडं करोति । कडस्य गरः<br><br>

कडङ्गरीय
कडङ्गरीय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯದ ಹೊಟ್ಟು ಕಡ್ಡಿಗಳನ್ನು ತಿನ್ನುವ ವೃಷಭ ಮೊದಲಾದುವು<br><b>निष्पत्तिः - </b>"छः" (५-१-६९)<br><b>व्युत्पत्तिः - </b>कडङ्करमर्हति । कडस्य गरो वा तमर्हति ।<br><b>प्रयोगाः - </b>"कडङ्करीयरोधो हि कमलोत्सेधकारणम्" । "नीवारपाकादि कडङ्गरीयकैः" ।<br><b>उल्लेखाः - </b>याद० २२-९, रघु० ५-९<br><br>

कडम्ब
कडम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ರಭಾಗ /ಕೊನೆಯ ಭಾಗ<br><b>निष्पत्तिः - </b>कडि - "अम्बच्"<br><br>कडम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತರಕಾರಿಯ ಕಾವು<br><br>

कडार
कडार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವಕ /ದಾಸ<br><br>कडार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಿಂಗಳ ವರ್ಣ /ಕಂದುಹಳದಿ ಬಣ್ಣ /ಗೋರೋಚನದ ಬಣ್ಣ<br><b>निष्पत्तिः - </b>गड (सेचने) - "आरन्" कडादेशश्च (उ० ३-१३५)<br><br>कडार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಿಂಗಳ ವರ್ಣದ /ಕೆಂಪುಬೆರೆತ ಹಳದಿ ಬಣ್ಣದ /ಕಂದು ಹಳದಿ ಬಣ್ಣದ<br><b>प्रयोगाः - </b>"लीनाम्भोदतडित्कडारकुहरैर्विन्ध्याद्रिकूटैरिव" । "संविव्युरम्बरविकाशि चमूसमुत्थं पृथ्वीरजः करभकण्ठकडारमाशाः"<br><b>उल्लेखाः - </b>उ० रा० ५-१४, माघ० ५-३<br><b>विस्तारः - </b>"कडारः पिङ्गले दासे" -मेदि० ।<br><br>कडार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗರ್ವಹೊಂದಿದ /ಕೊಬ್ಬಿದ<br><b>निष्पत्तिः - </b>कड (मदे) - "आरन्" बाहु० ।<br><br>

कडि|मदे|कण्डते
कडि - मदे (भ्वा० आत्म० अक० से०) कण्डते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಮದ ಹೊಂದು /ಗರ್ವ ಹೊಂದು<br><br>

कडि|कर्षे|तुषापकरणे
कडि - कर्षे तुषापकरणे च (भ्वा० आत्म० सक० से०)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹರ್ಷಿಸು /ಸಂತೋಷಪಡಿಸು<br><br>कडि - कर्षे तुषापकरणे च (भ्वा० आत्म० सक० से०)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯದ ಹೊಟ್ಟನ್ನು ಬೇರ್ಪಡಿಸು<br><br>

कडि|भेदने|कण्डयति|कण्डयते
कडि - भेदने (चुरा० उभ० सक० से०) कण्डयति-ते<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸಿ ಪ್ರತ್ಯೇಕಿಸು / ಒಡೆದು ಬೇರ್ಪಡಿಸು<br><br>

कडु|कार्कश्ये|कड्डति
कडु - कार्कश्ये (भ्वा० पर० अक० से०) कड्डति<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕೃಶನಾಗು /ತೆಳ್ಳನಾಗು<br><br>

कण|शब्दे
कण - शब्दे (भ्वा० पर० सक० से०)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಶಬ್ದ ಮಾಡು /ಧ್ವನಿಯುಂಟುಮಾಡು<br><br>कण - शब्दे (भ्वा० पर० सक० से०)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕೂಗಿಕೊಳ್ಳು /ಆರ್ತನಾದ ಮಾಡು<br><br>

कण|गतौ
कण - गतौ (ब्वा० पर० सक० से०)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೋಗು /ಹೊಂದು /ತಲುಪು<br><br>

कण|निमीलने
कण - निमीलने (चुरा० उभ० अक० से०)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕಣ್ಣುಮುಚ್ಚು<br><br>

कण
कण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯದ ಒಂದು ಅಂಶ /ಕಾಳಿನ ಕಿರು ನುಚ್ಚು<br><b>निष्पत्तिः - </b>कण (निमीलने) - "अच्" (३-१-१३४)<br><b>प्रयोगाः - </b>"कणान्वा भक्षयेदब्दं पिण्याकं वा सकृन्निशि । सुरापानापनुत्त्यर्थं वालवासा जटी ध्वजी ।"<br><b>उल्लेखाः - </b>मनु० ११-९२<br><br>कण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಸೂಕ್ಷ್ಮಾಂಶ /ಪರಮಾಣು<br><b>प्रयोगाः - </b>"रजःकणैः खरोद्धूतैः स्पृशद्भिर्गात्रमन्तिकात्"<br><b>उल्लेखाः - </b>रघु० १-८५<br><br>कण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೇಶ /ಚೂರು<br><b>प्रयोगाः - </b>"स चन्दनाम्भःकणकोमलैस्तथा वपुर्जलार्द्रापवनैर्न निर्ववौ"<br><b>उल्लेखाः - </b>माघ० १-६५<br><br>कण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಷಾದನಿಂದ ದ್ರಾಮಿಡಿಯಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><b>विस्तारः - </b>"निषादाद्ब्राह्मणी भेकं------- घोली घर्घरं द्रमिडी कणम्" - वैज० ।<br><br>कण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ಕಿ ಒಡೆದ ನುಚ್ಚು<br><b>विस्तारः - </b>"चक्षुष्याः सक्तवः कणाः" - वैज० ।<br><br>

कणा
कणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜೀರಿಗೆ<br><br>कणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಪ್ಪಲಿ<br><b>विस्तारः - </b>"कणाजीरकपिप्पल्योः" - हेम० ।<br><br>कणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡು ನೊಣ /ಮೊಸಳೆಯಾಕಾರದ ನೊಣ<br><b>विस्तारः - </b>"कणाजीरककुम्भीरमक्षिकापिप्पलीषु च" - मेदि० ।<br><br>

कणजीर
कणजीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿ ಜೀರೆಗೆ<br><br>

कणजीरक
कणजीरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಜೀರಿಗೆ<br><b>निष्पत्तिः - </b>अल्पार्थे "कन्" (५-३-८५)<br><br>

कणप
कणप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಂದೂಕ /ನಾಳಿಕಾಸ್ತ್ರ<br><b>निष्पत्तिः - </b>पा (पाने)- "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कणान् लोहकणान् पिबति<br><b>प्रयोगाः - </b>"चापचक्रकणपकर्णप्रासपट्टिशमुसलतोमरादिप्रहरणजालम्"<br><b>उल्लेखाः - </b>दशकु०<br><br>

कणभक्ष|भक्षक
कणभक्ष - भक्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಣಾದ ಮಹರ್ಷಿ<br><br>कणभक्ष - भक्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಬ್ಬಚ್ಚಿ<br><br>

कणलाभ
कणलाभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೀಸುವ ಕಲ್ಲು /ಹಿಟ್ಟು ಮಾಡುವ ಕಲ್ಲು<br><b>व्युत्पत्तिः - </b>कणानां लाभो यस्मात्<br><br>कणलाभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆವರ್ತ /ನೀರಿನ ಸುಳಿ<br><b>विस्तारः - </b>ಬೀಸುವ ಕಲ್ಲಿನಂತೆ ಸುಳಿಯು ಸುತ್ತುವುದರಿಂದ ಈ ಹೆಸರು. "अथाम्भसां भ्रमः । तानूरो वायुगुल्मश्च कणलाभः कणङ्कुरः" - त्रिकाण्ड० ।<br><br>

कणशस्
कणशस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೊಂಚಕೊಂಚವಾಗಿ /ಒಂದೊಂದು ಕಾಳಾಗಿ /ಒಂದೊಂದು ಹನಿಯಾಗಿ /ಚೂರು ಚೂರಾಗಿ<br><b>निष्पत्तिः - </b>कण - वीप्सायां "शस्" (५-४-४२)<br><b>प्रयोगाः - </b>"क्षणशः कणश्श्चैव विद्यामर्थं च साधयेत्"<br><br>

कणाद
कणाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೈಶೇಷಿಕ ದರ್ಶನಕಾರರಾದ ಕಣಾದಮಹರ್ಷಿ /ಕಶ್ಯಪಗೋತ್ರದ ಉಲೂಕಮಹರ್ಷಿಯ ಮಗ<br><b>निष्पत्तिः - </b>अद (भक्षणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कणान् तथ्यानिपतितान् तण्डुलकणानादाय अत्ति<br><br>

कणिक
कणिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೋಧಿಹಿಟ್ಟು<br><br>कणिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೈದಾಹಿಟ್ಟು<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कणोऽस्यास्ति<br><br>कणिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾಣು<br><br>कणिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯದ ಕಾಳು<br><br>कणिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರು /ವೈರಿ<br><br>कणिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧೃತರಾಷ್ಟ್ರನ ಒಬ್ಬ ಮಗ<br><br>

कणिका
कणिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಸೂಕ್ಷ್ಮವಸ್ತು /ವಸ್ತುವಿನ ಅತಿ ಸೂಕ್ಷ್ಮಭಾಗ<br><br>कणिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಮಂಥವೃಕ್ಷ /ನೆಲ್ಲಿಮರದ ಒಂದು ಭೇದ<br><br>कणिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನ ಬಿಂದು<br><br>कणिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾಣು<br><b>विस्तारः - </b>"कणिका कथ्यतेऽत्यन्तसूक्ष्मवस्त्वग्निमन्थयोः" - मेदि० ।<br><br>

कणित
कणित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೋವಿನಿಂದ ಕೂಗಿಕೊಳ್ಳುವಿಕೆ<br><b>निष्पत्तिः - </b>कण (शब्दे) - भावे "क्तः" (३-३-११४)<br><br>कणित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋವಿನಿಂದ ಕೂಗಿಕೊಳ್ಳುವ<br><b>निष्पत्तिः - </b>कण (शब्दे) - कर्त० "क्तः" (३-४-७२)<br><br>

कणिश
कणिश<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯದ ತೆನೆ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५) । शो (तनूकरणे) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कणो विद्यतेऽस्य । तं श्यति<br><b>विस्तारः - </b>"कणिशं सस्यमञ्जरी" - अम० ।<br><br>

कणीक
कणीक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಣ್ಣದಾದ /ಚಿಕ್ಕದಾದ /ಅಲ್ಪವಾದ<br><br>

कणीका
कणीका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಕಾಳು<br><br>

कणीची
कणीची<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದ /ಇಂಪಾದ ಧ್ವನಿ<br><br>कणीची<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಷ್ಪಿಸಿರುವ ಲತೆ /ಹೂಬಿಟ್ಟಿರುವ ಲತೆ<br><br>कणीची<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಕಟ /ಗಾಡಿ /ಬಂಡಿ<br><b>निष्पत्तिः - </b>कण (शब्दे) - "ईचिः" (उ० ४-७०)<br><b>विस्तारः - </b>"कणीची पुष्पितलतागुञ्जयोः शकटे स्त्रियाम्" - मेदि० ।<br><br>

कणीयस्
कणीयस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಚಿಕ್ಕದಾದ /ಬಹಳ ಸ್ವಲ್ಪವಾದ /ಚಿಕ್ಕವನಾದ /ಕಿರಿಯನಾದ<br><b>निष्पत्तिः - </b>कण - "ईयसुन्" (५-३-५७)<br><br>

कणीयसी
कणीयसी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಚಿಕ್ಕದಾದ /ಬಹಳ ಸ್ವಲ್ಪವಾದ /ಚಿಕ್ಕವಳಾದ /ಕಿರಿಯಳಾದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कणी
कणी<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಇಚ್ಛಾಪೂರ್ತಿ /ಅಭಿಲಾಷೆಯ ನಿವೃತ್ತಿ<br><b>प्रयोगाः - </b>"कणेमनसी श्रद्धाप्रतीघाते"<br><b>उल्लेखाः - </b>पा० सू० १-४-६६<br><b>विस्तारः - </b>ಇದು ಸಪ್ತಮೀ ವಿಭಕ್ತಿಪ್ರತಿರೂಪಕಾವ್ಯಯ. कणेहत्य पयः पिबति ।<br><br>

कणीर
कणीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಟ್ಟಕಣಗಿಲೆ<br><b>निष्पत्तिः - </b>कण - "एरक्"बाहु० ।<br><br>

कणीरा
कणीरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣಾನೆ<br><br>कणीरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇಶ್ಯೆ /ಸೂಳೆ<br><br>

कणीरु
कणीरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಟ್ಟಕಣಗಿಲೆ<br><br>कणीरु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣಾನೆ<br><br>कणीरु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇಶ್ಯೆ /ಸೂಳೆ<br><b>विस्तारः - </b>"कणेरुः कर्णिकारे च करिणीवेश्ययोः स्त्रियाम्" - मेदि० ।<br><br>

कण्ट
कण्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಟಕ /ಮುಳ್ಳು<br><b>निष्पत्तिः - </b>कटि (गतौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कण्टति<br><br>

कण्टक
कण्टक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಳ್ಳು<br><b>निष्पत्तिः - </b>कटि (गतौ) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कण्टति<br><b>प्रयोगाः - </b>"वियोगभाजां हृदि कण्टकैः कटुर्निधीयसे कर्णिशरः स्मरेण यत्"<br><b>उल्लेखाः - </b>नैष० १-७९<br><br>कण्टक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಜಿಯ ತುದಿ<br><br>कण्टक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀಚನಾದ ವೈರಿ /ಪೀಡಿಸುವ ಶತ್ರು<br><b>प्रयोगाः - </b>"उत्खातलोकत्रयकण्टकेऽपि"<br><b>उल्लेखाः - </b>रघु० १४-७३<br><br>कण्टक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೀನು ಮೊದಲಾದುವುಗಳ ಎಲುಬು<br><b>प्रयोगाः - </b>"अन्धो मत्स्यानिवाश्नाति स नरः कण्टकैः सह"<br><b>उल्लेखाः - </b>मनु० ८-९५<br><br>कण्टक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಲಕ /ರೋಮಾಂಚ /ಮೈಮೇಲೆ ಮುಳ್ಳೇಳುವುದು<br><b>प्रयोगाः - </b>"पुलोमजालोचनतीक्ष्णकण्टकैस्तनुं घनामातनुतां स कण्टकैः"<br><b>उल्लेखाः - </b>नैष० ९-५३<br><br>कण्टक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಂದ್ರಸ್ಥಾನ /೧,೪,೭ ಮತ್ತು ೧೦ನೆಯ ರಾಶಿಗಳು<br><br>कण्टक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಖ /ಉಗುರು<br><b>प्रयोगाः - </b>"मरुल्ललत्पल्लवकण्टकैः क्षतं समुच्छलच्चन्दनसारसौरभम्"<br><b>उल्लेखाः - </b>नैष० १-९४<br><br>कण्टक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿದಿರು<br><br>कण्टक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾದದ ಒಂದು ದೋಷ<br><b>विस्तारः - </b>"कण्टको न स्त्रियां क्षुद्रशत्रौ मत्स्यादिकीकसे । नैयायिकादिदोषोक्तौ स्याद्रोमाञ्चद्रुमाङ्गयोः" - मेदि० । "कण्टकः क्षुद्रवैरिणि । वेणौ द्रुमाङ्गे रोमाञ्चे" - हेम० ।<br><br>कण्टक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ /ವಾಯಸ<br><b>विस्तारः - </b>"आत्मघोषो महानेमिः कण्टको मौकलिः कुणः । बलिपुष्ट उलूकारिः" - वैज० ।<br><br>

कण्टकद्रुम
कण्टकद्रुम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಳ್ಳಿನ ಗಿಡ /ಮುಳ್ಳಿನಿಂದ ಕೂಡಿದ ವೃಕ್ಷ<br><b>व्युत्पत्तिः - </b>कण्टकप्रधानो द्रुमः<br><b>प्रयोगाः - </b>"भवन्ति नितरां स्फीताः सुक्षेत्रे कण्टकद्रुमाः"<br><b>उल्लेखाः - </b>मृच्छ० ९-७<br><br>कण्टकद्रुम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಲ್ಮಲಿ ವೃಕ್ಷ /ಭೂರುಗದ ಮರ<br><br>कण्टकद्रुम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಗ್ಗುಳ್ಳದ ಗಿಡ<br><br>कण्टकद्रुम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಲಾಬಿಯ ಗಿಡ<br><br>

कण्टकफल
कण्टकफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಳ್ಳಿನಿಂದ ಕೂಡಿದ ಹಣ್ಣುಕಾಯಿಗಳ ಗಿಡ /ಪನಸ ವೃಕ್ಷ<br><br>कण्टकफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೆಗ್ಗಿಲು ಮರ<br><br>कण्टकफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದತ್ತೂರಿ ಗಿಡ<br><br>कण्टकफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಮ್ಮತ್ತಿ ಗಿಡ<br><b>व्युत्पत्तिः - </b>कण्टकाचितं फलमस्य<br><br>कण्टकफल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಲಸಿನ ಹಣ್ಣು<br><br>कण्टकफल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೆಗ್ಗಿಲು ಬೀಜ<br><br>कण्टकफल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದತ್ತೂರಿಕಾಯಿ<br><br>कण्टकफल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಮ್ಮತ್ತಿಕಾಯಿ<br><br>

कण्तकवत्
कण्तकवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಳ್ಳಿನಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४) । मस्य वः (८-२-१०)<br><b>व्युत्पत्तिः - </b>कण्टकान्यस्य सन्ति<br><br>

कण्तकवृन्ताकी
कण्तकवृन्ताकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಳ್ಳುಬದನೆ ಗಿಡ<br><br>

कण्टकाढ्य
कण्टकाढ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಳ್ಳುಗಳಿಂದ ತುಂಬಿದ<br><b>व्युत्पत्तिः - </b>कण्टकैराढ्यः<br><br>

कण्टकार
कण्टकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಲುಮಾಣಿಕ ಗಿಡ /ಹುಳಿಬೇಲದ ಮರ<br><br>कण्टकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೂರುಗದ ಮರ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कण्टकमृच्छति<br><br>

कण्टकारिका
कण्टकारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಗ್ಗುಳ್ಳದ ಗಿಡ<br><br>

कण्टकाशन
कण्टकाशन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಷ್ಟ್ರ /ಒಂಟೆ/ಮುಳ್ಳುಗಿಡಗಳನ್ನು ತಿಂದು ಜೀವಿಸುವ ಪ್ರಾಣಿ<br><b>निष्पत्तिः - </b>अश (भोजने)- "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कण्टकमश्नाति<br><b>विस्तारः - </b>"स्यादुष्ट्रः कण्टकाशनः" - त्रिकाण्ड० ।<br><br>

कण्टकाष्ठील
कण्टकाष्ठील<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೂಪಾದ ಎಲುಬುಗಳುಳ್ಳ ಮೀನು<br><b>विस्तारः - </b>"कुलिशं कण्टाष्ठील इत्यपि" - त्रिकाण्ड० ।<br><br>

कण्टकित
कण्टकित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಳ್ಳಿನಿಂದ ಕೂಡಿದ<br><br>कण्टकित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೋಮಾಂಚವೆದ್ದಿರುವ /ಮೈ ಮುಳ್ಳಿನೊಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>कण्ठकोऽस्य सञ्जातः<br><b>प्रयोगाः - </b>"इदमूचुरनूचनाः प्रीतिकण्टकितत्वचः" । "असीद्वरः कण्टकितप्रकोष्ठः स्विन्नाङ्गुलिः संववृते कुमारी" ।<br><b>उल्लेखाः - </b>कुमा० ६-१५, रघु० ७-२२<br><br>

कण्टकिन्
कण्टकिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ಸ್ಯ /ಮೀನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५) ।<br><b>व्युत्पत्तिः - </b>कण्टकान्यस्य सन्ति<br><br>

कण्टकिनी
कण्टकिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೆಗ್ಗಿಲು ಗಿಡ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>कण्टकिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿದಿರು<br><br>कण्टकिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಲಚಿ ಗಿಡ /ಬೋರೆ ಗಿಡ<br><br>कण्टकिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಗ್ಗಲಿ ಮರ<br><br>कण्टकिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೊಬ್ಬಳಿ ಮರ<br><br>कण्टकिनी<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಳ್ಳಿನಿಂದ ಕೂಡಿದ<br><br>

कण्टकिफल
कण्टकिफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪನಸ ವೃಕ್ಷ /ಹಲಸಿನ ಮರ<br><br>कण्टकिफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಳ್ಳುಬದನೆ ಗಿಡ<br><br>कण्टकिफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದತ್ತೂರಿ ಗಿಡ<br><br>कण्टकिफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೆಗ್ಗಿಲು ಗಿಡ<br><br>कण्टकिफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹರಳು ಗಿಡ ಮುಂತಾದ ಮುಳ್ಳಿನಿಂದ ಕೂಡಿದ ಫಲಬಿಡುವ ಮರಗಳು<br><b>व्युत्पत्तिः - </b>कण्टकि फलमस्य<br><br>कण्टकिफल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಲಸಿನ ಹಣ್ಣು<br><br>कण्टकिफल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಳ್ಳುಬದನೆ ಕಾಯಿ<br><br>कण्टकिफल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದತ್ತೂರಿ ಕಾಯಿ<br><br>

कण्टकिल
कण्टकिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿದಿರು ಗಿಡ<br><b>निष्पत्तिः - </b>कण्टक - "इलच्" (५-२-१००)<br><br>

कण्टदला
कण्टदला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಳೆ ಗಿಡ<br><b>व्युत्पत्तिः - </b>कण्टकं कण्टकावृतं दलमस्याः<br><br>

कण्टपत्र
कण्टपत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಳಿ ಬೇಲ<br><br>

कण्टफल
कण्टफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪನಸ ವೃಕ್ಷ /ಹಲಸಿನ ಮರ<br><br>कण्टफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೆಗ್ಗಿಲು ಗಿಡ<br><br>कण्टफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದತ್ತೂರಿ ಗಿಡ<br><br>कण्टफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹರಳು ಗಿಡ<br><br>

कण्टफला
कण्टफला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತಾಳೆ ಗಿಡ<br><b>व्युत्पत्तिः - </b>कण्टकाचितं फलमस्य<br><br>

कण्टल
कण्टल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಾರಂಗಿ ಗಿಡ<br><b>निष्पत्तिः - </b>"लच्" (५-२-९७)<br><b>व्युत्पत्तिः - </b>कण्टोऽस्त्यस्य<br><br>

कण्टालु
कण्टालु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಳ್ಳುಬದನೆ<br><br>कण्टालु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿದಿರು<br><br>कण्टालु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೆಗ್ಗಿಲು ಗಿಡ<br><br>कण्टालु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಗ್ಗುಳ್ಳದ ಗಿಡ<br><br>कण्टालु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಾರಂಗಿ ಗಿಡ<br><br>कण्टालु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರಣೆ ಗಿಡ<br><b>निष्पत्तिः - </b>अल (भूषणादौ) - "उण्" (उ० १-१)<br><b>व्युत्पत्तिः - </b>कण्टाय अलति<br><br>

कण्टिन्
कण्टिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಗ್ಗಲಿ ಮರ<br><br>कण्टिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರಣೆ ಗಿಡ<br><br>कण्टिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೆಗ್ಗಿಲು ಗಿಡ<br><br>कण्टिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಳ್ಳಿನಿಂದ ಕೂಡಿದ<br><br>

कण्ठ
कण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುತ್ತಿಗೆ /ಕತ್ತು<br><b>निष्पत्तिः - </b>कण (निमीलने) - "ठः" (उ० १-१०३)<br><b>प्रयोगाः - </b>"मेघालोके भवति सुखिनोऽप्यन्यथावृति चेतः कण्ठश्लेषणप्रणयिनि जने किं पुनर्दूरसंस्थे"<br><b>उल्लेखाः - </b>मेघ० १-३<br><br>कण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಠಧ್ವನಿ /ಕತ್ತಿನ ಒಳಭಾಗದಿಂದ ಹೊರಡುವ ಶಬ್ದ<br><b>प्रयोगाः - </b>"यास्यत्यद्य शकुन्तलेति हृदयं संस्पृष्टमुत्कण्ठया कण्ठः स्तम्भितबाष्पवृत्तिकलुषश्चिन्ताजडं दर्शनम्"<br><b>उल्लेखाः - </b>शाकु० ४-५<br><br>कण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧ್ವನಿ /ಶಬ್ದ /ಸದ್ದು<br><b>प्रयोगाः - </b>"सा मुक्तकण्ठं व्यसनातिभारात् चक्रन्द विग्ना कुररीव भूयः"<br><b>उल्लेखाः - </b>रघु० १४-६८<br><br>कण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಂದಿಗೆಯ ಅಥವಾ ತಪ್ಪಲೆಯ ಕತ್ತು<br><br>कण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ಭಾಶಯದ ಬಹಳ ಕಿರಿದಾದ ಭಾಗ<br><br>कण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪ /ಸಂನಿಧಾನ<br><br>कण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದನ ವೃಕ್ಷ /ಮುಂಗಾರೆ ಗಿಡ<br><br>कण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಠಾಲಕಾಂರ /ಕತ್ತಿನ ಆಭರಣ<br><b>विस्तारः - </b>"कण्ठो ध्वनौ सन्निधाने ग्रीवायां मदनद्रुमे" - मेदि० ।<br><br>कण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಚಕಶಬ್ದ /ಅರ್ಥವನ್ನು ಕೊಡುವ ಶಬ್ದ<br><b>विस्तारः - </b>"कण्ठो वाचकशब्दे स्यात् सन्निधाने गले ध्वनौ" - नानार्थर०<br><br>कण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದತ್ತೂರಿ ಗಿಡ<br><b>विस्तारः - </b>"कण्ठो गले सन्निधाने ध्वनौ दत्तूरपादपे" - विश्व० ।<br><br>

कण्ठकूणिका
कण्ठकूणिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೀಣೆ<br><b>निष्पत्तिः - </b>कूण (सङ्कोचे) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कण्ठ इव तद्ध्वनिरुव कूणयति<br><b>प्रयोगाः - </b>"वीणा पुनर्घोषवती विपञ्जी कण्ठकूणिका"<br><b>उल्लेखाः - </b>अभि चि०<br><br>

कण्ठकूप
कण्ठकूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಟಲಿನ ವಿವರ /ಕಂಠಕುಹರ<br><br>

कण्ठग
कण्ठग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂಠದವರೆಗೂ ವ್ಯಾಪಿಸಿರುವ /ಗಂಟಲಿನವರೆಗೂ ಹೋಗಿರುವ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "डः" (वा० ३-२-४८)<br><b>व्युत्पत्तिः - </b>कण्ठं गलं गच्छति<br><b>प्रयोगाः - </b>"हृद्गाभिः पूयते विप्रः कण्ठगाभिस्तु भूमिपः"<br><b>उल्लेखाः - </b>मनु० २-६२<br><br>

कण्ठगत
कण्ठगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂಠದವರೆಗೂ ಬಂದಿರುವ /ಕುತ್ತಿಗೆಯಲ್ಲಿರುವ<br><b>व्युत्पत्तिः - </b>कण्ठं गतः<br><b>प्रयोगाः - </b>"मम कण्ठगताः प्राणाः पाशे कण्ठस्थिते तव"<br><b>उल्लेखाः - </b>रत्ना० ३-१६<br><br>

कण्ठग्रह
कण्ठग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಲಿಂಗನ /ಕುತ್ತಿಗೆಯನ್ನು ಹಿಡಿದುಕೊಂಡು ಅಪ್ಪಿಕೊಳ್ಳುವುದು<br><b>व्युत्पत्तिः - </b>कण्ठस्य ग्रहः<br><b>प्रयोगाः - </b>"अम्भोजगर्भसुकुमारतनुस्तदासौ कण्ठग्रहे प्रथमरागधने विलीय"<br><b>उल्लेखाः - </b>रत्ना० ४-२<br><br>

कण्ठग्रहण
कण्ठग्रहण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಲಿಂಗನ /ಕುತ್ತಿಗೆಯನ್ನು ಹಿಡಿದುಕೊಂಡು ಅಪ್ಪಿಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

कण्ठतलासिका
कण्ठतलासिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಕತ್ತಿನ ಹಗ್ಗ ಅಥವಾ ಚರ್ಮದ ಬಾರು<br><br>

कण्ठतस्
कण्ठतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕತ್ತಿನಿಂದ /ಕುತ್ತಿಗೆಯಿಂದ<br><br>कण्ठतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಗಂಟಲಿನಿಂದ<br><b>निष्पत्तिः - </b>कण्ठ - "तसिः" (वा० ५-४-४४)<br><br>

कण्ठदघ्न
कण्ठदघ्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತಿನಷ್ಟು ಎತ್ತರವುಳ್ಳ /ಕತ್ತಿನವರೆಗೂ ಹೋಗಿ ನಿಲ್ಲುವ /ಕುತ್ತಿಗೆಯ ಪ್ರಮಾಣವುಳ್ಳ<br><b>निष्पत्तिः - </b>"दध्नच्" (५-२-३७)<br><b>व्युत्पत्तिः - </b>कण्ठः परिमाणमस्य<br><br>

कण्ठदघ्नी
कण्ठदघ्नी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತಿನಷ್ಟು ಎತ್ತರವುಳ್ಳ /ಕತ್ತಿನವರೆಗೂ ಹೋಗಿ ನಿಲ್ಲುವ /ಕುತ್ತಿಗೆಯ ಪ್ರಮಾಣವುಳ್ಳ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

कण्ठद्वयस
कण्ठद्वयस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>कण्ठदघ्न ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>कण्ठ - "द्वयसच्" (५-२-३७)<br><br>

कण्ठद्वयसी
कण्ठद्वयसी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कण्ठदघ्न ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

कण्ठनाल
कण्ठनाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಾವರೆಯ ದಂಟಿನಂತಿರುವ ಕತ್ತು /ತಾವರೆಯ ದಂಟಿನಂತೆ ಒಳಗೆ ಟೊಳ್ಳಾಗಿರುವ ಗಂಟಲಿನ ಕೊಳವೆ<br><b>व्युत्पत्तिः - </b>कण्ठो नाल इव<br><br>कण्ठनाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಠವೆಂಬ ಕೊಳವೆ<br><b>व्युत्पत्तिः - </b>कण्ठः एव नालः<br><b>प्रयोगाः - </b>"ज्योतिष्कणाहतश्मश्रु कण्ठनालादपातयत्"<br><b>उल्लेखाः - </b>रघु० १५-५२<br><br>कण्ठनाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತಿನ ಕೊಳವೆ /ಕತ್ತಿನ ಕಾಂಡ<br><b>प्रयोगाः - </b>"एतत्करालकरवालनिकृतकण्ठनालोच्चलद्बहुलफेनिलबुद्बुदौघैः"<br><b>उल्लेखाः - </b>प्रबोध० ३-१५<br><br>

कण्ठपाश
कण्ठपाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತಿಗೆ ಕಟ್ಟುವ ಹಗ್ಗ<br><br>कण्ठपाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಕತ್ತಿನ ಹಗ್ಗ<br><b>व्युत्पत्तिः - </b>कण्ठे पाशः<br><br>

कण्ठबन्ध
कण्ठबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಕತ್ತಿನ ಹಗ್ಗ<br><br>कण्ठबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತಿನಲ್ಲಿ ಕಟ್ಟುವಿಕೆ /ಕತ್ತಿಗೆ ಹಗ್ಗಹಾಕಿ ಕಟ್ಟುವಿಕೆ<br><b>व्युत्पत्तिः - </b>कण्ठस्य कण्ठे वा बन्धः<br><br>

कण्ठभङ्ग
कण्ठभङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಕ್ಕುತ್ತ ಮಾತಾಡುವಿಕೆ /ತಡೆದು ಮಾತಾಡುವಿಕೆ<br><br>

कण्ठभूषण
कण्ठभूषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಠಾಭರಣ / ಕುತ್ತಿಗೆಗೆ ತೊಡಿಸುವ ಒಡವೆ /ಅಡ್ಡಿಗೆ<br><b>व्युत्पत्तिः - </b>कण्ठस्य भूषणं<br><br>

कण्ठभूषणा|कण्ठभूषा
कण्ठभूषणा- भूषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಠಾಭರಣ / ಕುತ್ತಿಗೆಗೆ ತೊಡಿಸುವ ಒಡವೆ /ಅಡ್ಡಿಗೆ<br><b>व्युत्पत्तिः - </b>कण्ठस्य भूषणं भूषा वा<br><br>

कण्ठमूल
कण्ठमूल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಠದ ತಳಭಾಗ /ಗಂಟಲಿನ ಆಳವಾದ ಕೆಳಪ್ರದೇಶ<br><b>व्युत्पत्तिः - </b>कण्ठस्य मूलम्<br><br>

कण्ठलग्न
कण्ठलग्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತಿನಲ್ಲಿ ಸೇರಿಕೊಂಡಿರುವ<br><br>

कण्ठलग्न
कण्ठलग्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪ್ಪಿಕೊಂಡಿರುವ /ಆಲಂಗಿಸಿಕೊಂಡಿರುವ<br><b>व्युत्पत्तिः - </b>कण्ठे लग्नः<br><br>

कण्ठलता
कण्ठलता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗಿಯ ಕೊರಳ ಪಟ್ಟಿ /ಕತ್ತಿನ ಪಟ್ಟಿ<br><br>कण्ठलता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಕ್ತಾಹಾರ /ಮುತ್ತಿನ ಸರ /ಅಡ್ಡಿಗೆ<br><br>

कण्ठवर्तिन्
कण्ठवर्तिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಂಟಲಲ್ಲಿರುವ<br><br>कण्ठवर्तिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುತ್ತಿಗೆಯಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>वृतु (वर्तने) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>कण्ठे वर्तते<br><b>प्रयोगाः - </b>"प्राणैर्दशरथप्रीतेरनृणं कण्ठवर्तिभिः"<br><b>उल्लेखाः - </b>रघु० १२-५४<br><br>

कण्ठवर्तिनी
कण्ठवर्तिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कण्ठवर्तिन् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कण्ठशालूक
कण्ठशालूक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಟಲೊಳಗಿನ ವ್ರಣ /ಕಂಠದೊಳಗೆ ಬರುವ ಒಂದು ಹುಣ್ಣು /ಒಂದು ವಿಧ ಮುಖರೋಗ<br><b>प्रयोगाः - </b>"कोलास्थिमात्रः कफसम्भवो यो ग्रन्थिर्गले कण्ठकशूकभूतः । खरः स्थिरः शस्त्रनिपातसाध्यस्तं कण्ठशालूकमिति ब्रुवन्ति"<br><b>उल्लेखाः - </b>सुश्रुत० निदान० १६-५१<br><br>

कण्ठशुण्ठी
कण्ठशुण्ठी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದವಡೆಯೊಳಗಿನ ವ್ರಣ /ಒಂದು ವಿಧ ಮುಖರೋಗ<br><b>प्रयोगाः - </b>"श्लेष्मासृग्भ्यां तालुमूलात् प्रवृत्तो दीर्घः शोफो ध्मातबस्तिप्रकाशः । तृष्णाकासश्वासकृत् सम्प्रदिष्टो व्याधिर्वैद्यैः कण्ठशुण्ठीति नाम्ना"<br><b>उल्लेखाः - </b>सुश्रुत० निदान० १६-४१<br><br>

कण्ठशोष
कण्ठशोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಟಲು ಒಣಗುವಿಕೆ /ಗಂಟಲು ಆರಿಹೋಗುವಿಕೆ<br><br>कण्ठशोष<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಯೋಜನವಿಲ್ಲದ ಉಪದೇಶ<br><b>व्युत्पत्तिः - </b>कण्ठस्य शोषः<br><br>

कण्ठशोषण
कण्ठशोषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯೋಜನವಿಲ್ಲದ ಉಪದೇಶ<br><b>निष्पत्तिः - </b>भावे - "ल्युट्" (३-३-११५)<br><br>

कण्ठसूत्र
कण्ठसूत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುರತಕಾಲದ ಆಲಿಂಗನದ ಒಂದು ಭೇದ<br><b>प्रयोगाः - </b>"तस्य निर्दरयतिश्रमालसाः कण्ठसूत्रमपदिश्य योषितः"<br><b>उल्लेखाः - </b>रघु० १९-३२<br><b>विस्तारः - </b>"यत्कुर्वते वक्षसि वल्लभस्य स्तनाभिघातं निबिडोपगूढम् । परिश्रमार्थं शनकैर्विदग्धाः तत्कण्ठसूत्रं प्रवदन्ति योषितः ॥" - वात्स्या० सू० ।<br><br>

कण्ठस्थ
कण्ठस्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಂಟಲಲ್ಲಿರುವ<br><br>कण्ठस्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುತ್ತಿಗೆಯಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>ष्ठा (गतिनिवृत्तौ) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कण्ठे तिष्ठति<br><br>कण्ठस्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾಯಲ್ಲಿರುವ ಮತ್ತು ಉಚ್ಚರಿಸಲು ಸಿದ್ದವಾಗಿರುವ<br><br>कण्ठस्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉರುಹಾಕಿರುವ /ಬಾಯಿಪಾಠಮಾಡಿರುವ<br><br>

कण्ठाग्नि
कण्ठाग्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಕ್ಷಿ /ಹಕ್ಕಿ<br><b>व्युत्पत्तिः - </b>कण्ठे अग्निः पाकाग्निः यस्य<br><b>विस्तारः - </b>ಕತ್ತನ್ನು ಬಗ್ಗಿಸಿದ ಮಾತ್ರದಿಂದ ಹಕ್ಕಿಗಳು ತಿಂದ ಆಹಾರವು ಜೀರ್ಣವಾಗುವುದರಿಂದ ಈ ಹೆಸರು.<br><br>

कण्ठाभरण
कण्ठाभरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತಿಗೆ ತೊಡಿಸುವ ಆಭರಣ /ಹಾರ /ಸರ<br><b>व्युत्पत्तिः - </b>कण्ठस्याभरणम्<br><br>कण्ठाभरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸರಸ್ವತೀಕಂಠಾಭರಣವೆಂಬ ಒಂದುಗ್ರಂಥದ ಸಣ್ಣ ಹೆಸರು<br><br>

कण्ठाल
कण्ठाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ /ಕದನ<br><br>कण्ठाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶೂರಣ ಗೆಡ್ಡೆ<br><br>कण्ठाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗುದ್ದಲಿ<br><br>कण्ठाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೋಣೀಚೀಲ<br><br>कण्ठाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೋಣಿ<br><br>कण्ठाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಡೆಯುವ ಪಾತ್ರೆ<br><br>कण्ठाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಷ್ಟ್ರ /ಒಂಟೆ<br><b>निष्पत्तिः - </b>कठि (शोके) - "आलच्" बाहु० ।<br><b>विस्तारः - </b>"कण्ठाला तु द्वयोर्द्रोणीप्रभेदे ना क्रमेलके" - मेदि० ।<br><br>

कण्ठिका
कण्ठिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಠಾಭರಣ / ಕುತ್ತಿಗೆಗೆ ತೊಡಿಸುವ ಒಡವೆ /ಅಡ್ಡಿಗೆ<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कण्ठो भूष्यतयाऽस्त्यस्य<br><br>

कण्ठी
कण्ठी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆ ಕಟ್ಟುವ ಹಗ್ಗ<br><br>कण्ठी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತು<br><br>कण्ठी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತಿನ ಪಟ್ಟಿ<br><br>

कण्ठीरव
कण्ठीरव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಠದಿಂದ ಗರ್ಜಿಸುವ ಸಿಂಹ<br><br>कण्ठीरव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಠದಿಂದ ಗರ್ಜಿಸುವ ಮದಿಸಿದ ಆನೆ<br><b>व्युत्पत्तिः - </b>कठ्यां रवो यस्य<br><br>कण्ठीरव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಠದಿಂದ ಗರ್ಜಿಸುವ ಕಪೋತ /ಪಾರಿವಾಳದ ಹಕ್ಕಿ<br><br>

कण्ठेकाल
कण्ठेकाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಮಹಾದೇವ<br><b>निष्पत्तिः - </b>सप्तम्या अलुक् (६-३-१२)<br><b>व्युत्पत्तिः - </b>कण्ठे कालोऽस्य<br><br>

कण्ठ्य
कण्ठ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂಠದಲ್ಲಿರುವ /ಗಂಟಲಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"यत्"(४-३-५५)<br><b>व्युत्पत्तिः - </b>कण्ठे भवः<br><br>कण्ठ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂಠದಲ್ಲಿ ಹುಟ್ಟುವ<br><b>प्रयोगाः - </b>"अकुहविसर्जनीयानां कण्ठः"<br><b>उल्लेखाः - </b>सि० कौ०<br><br>कण्ठ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂಠಸ್ವರಕ್ಕೆ ಹಿತವಾದ ಶಾಕಾದಿಗಳು<br><b>प्रयोगाः - </b>"सर्वदोषहरा लघ्वी कण्ठ्या मूलकपोतिका" । "यवकोलकुलुत्थानां यूषः कण्ठ्योऽनिलापहः" ।<br><b>उल्लेखाः - </b>सुश्रुत० सूत्र० ४६-२४०,३७५<br><br>

कण्डन
कण्डन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒನಕೆಯಿಂದ ಧಾನ್ಯವನ್ನು ಕುಟ್ಟಿ ಹೊಟ್ಟನ್ನು ಬೇರ್ಪಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>कडि (भेदने) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"न हि व्रीह्यादिलवनकण्डनपेषणादौ च सविज्ञानानाम्"<br><b>उल्लेखाः - </b>छान्दोग्य०<br><br>

कण्डनी
कण्डनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಟ್ಟುವ ಸಾಧನ /ಒನಕೆ<br><b>निष्पत्तिः - </b>कडि (भेदने) - कर० "ल्युट्" (३-३-११७) । "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>कण्ड्यतेऽनेन<br><br>कण्डनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒರಳು<br><b>निष्पत्तिः - </b>कडि (भेदने) - अधि० "ल्युट्" (३-३-११७) । "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>कण्ड्यतेऽत्र<br><b>प्रयोगाः - </b>"पञ्च सूना गृहस्थस्य चुल्ली पेषण्युपस्करः । कण्डनी चोदकुम्भश्च बध्यते यासु वाहयन् ॥"<br><b>उल्लेखाः - </b>मनु० ३-६८<br><br>

कण्डरा
कण्डरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾನಾಡಿ /ಮಹಾಸ್ನಾಯು<br><br>

कण्डु
कण्डु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನವೆ /ತುರಿ<br><b>निष्पत्तिः - </b>कण्डूञ् (गात्रविघर्षणे) - "डुः" बाहु० ।<br><br>कण्डु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೈ ಕೆರೆಯುವಿಕೆ<br><br>

कण्डूञ्|गात्रविघर्षणे|ते
कण्डूञ् - गात्रविघर्षणे (कण्ड्वा० उभ० सक० से०) कण्डूयति - ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಮೈ ಕೆರೆ /ನವೆ /ಹೋಗಲಾಡಿಸು<br><br>

कण्डू
कण्डू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೈ ಕೆರೆಯುವುದು<br><br>कण्डू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತುರಿ ಗಜ್ಜಿ<br><b>निष्पत्तिः - </b>कण्डूञ् (गात्रविघर्षणे) - "क्विप्" (वा० ३-३-९४)<br><b>प्रयोगाः - </b>"कपोलकण्डूः करिभिर्विनेतुं विघट्टितानां सरलद्रुमाणाम्"<br><b>उल्लेखाः - </b>कुमा० १-९<br><br>

कण्डुकरी
कण्डुकरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಸುಗುನ್ನಿ ಗಿಡ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "टः" (३-२-२०)<br><b>व्युत्पत्तिः - </b>कण्डूं करोति<br><br>

कण्डूघ्न
कण्डूघ्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಕ್ಕೆ ಗಿಡ<br><br>कण्डूघ्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿಸಾಸುವೆ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः)- "टक्" (३-२-५३)<br><b>व्युत्पत्तिः - </b>कण्डूं हन्ति<br><br>

कण्डूति
कण्डूति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೈ ಕೆರೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>कण्डूञ् (गात्रविघर्षणे) - "क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"सुभग त्वत्कथारम्भे कर्णे कण्डूतिलालसा"<br><b>उल्लेखाः - </b>सा० द०<br><br>

कण्डूयत्
कण्डूयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೈ ಕೆರೆಯುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कण्डूञ् (गात्रविघर्षणे) + यक्- "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"कण्डूयतः कटभुवं करिणो मदेन स्कन्धं सुगन्धिमनुलीनवता नगस्य"<br><b>उल्लेखाः - </b>माघ० ५-४६<br><br>

कण्डूयन
कण्डूयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೈ ಕೆರೆಯುವುದು /ನವೆ ಹೋಗಲಾಡಿಸುವುದು<br><b>निष्पत्तिः - </b>कण्डूञ् (गात्रविघर्षणे) + यक्- "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"आस्वादयद्भिः कबलैस्तृणानां कण्डूयनैर्दशनिवारणैश्च"<br><b>उल्लेखाः - </b>रघु० २-५<br><br>कण्डूयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೈ ಕೆರೆದುಕೊಳ್ಳುವ ಸಾಧನ<br><b>निष्पत्तिः - </b>कण्डूञ् (गात्रविघर्षणे) + यक्- कर० "ल्युट्" (३-३-११७)<br><br>

कण्डूयमान
कण्डूयमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೈ ಕೆರೆದುಕೊಳ್ಳುತ್ತಿರುವ /ನವೆ ಹೋಗಲಾಡಿಸುಕೊಳ್ಳುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कण्डूञ् (गात्रविघर्षणे) - "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"कण्डूयमानेन कटं कदाचिद्वन्यद्विपेनोन्मथिता त्वगस्य"<br><b>उल्लेखाः - </b>रघु० २-३७<br><br>

कण्डूया
कण्डूया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನವೆ /ತುರಿ<br><b>निष्पत्तिः - </b>कण्डूञ् (गात्रविघर्षणे) + यक् - "अः" (३-३-१०२) । "टाप्" (४-१-४)<br><br>

कण्डूयित
कण्डूयित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆರೆಯಲ್ಪಟ್ಟ /ನವೆ ಹೋಗಲಾಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कण्डूञ् (गात्रविघर्षणे) + यक् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"स्खलनक्षण एव शिश्रिये द्रुतकण्डूयितमौलिरालयम्"<br><b>उल्लेखाः - </b>नैष० २-३<br><br>

कण्डूरा
कण्डूरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಸುಗುನ್ನಿ ಗಿಡ<br><b>निष्पत्तिः - </b>रा (दाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कण्डूं राति<br><b>विस्तारः - </b>"आत्मगुप्ताजहाव्यण्डा कण्डूरा प्रावृषायणी" - अम० ।<br><br>

कण्डूल
कण्डूल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರಣ ಗೆಡ್ಡೆ<br><b>निष्पत्तिः - </b>"लच्" (५-२-९७)<br><b>व्युत्पत्तिः - </b>कण्डूरस्त्यस्य<br><br>कण्डूल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನವೆಯಿಂದ ಕೂಡಿದ<br><b>प्रयोगाः - </b>"कण्डूलद्विपगण्डपिण्डकषणाकम्पेन सम्पातिभिः"<br><b>उल्लेखाः - </b>उ० रा० २-९<br><br>कण्डूल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನವೆಯುಂಟುಮಾಡುವ<br><br>

कण्डोल
कण्डोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿದಿರಿನ ಮಂಕರಿ /ಕುಕ್ಕೆ ಗೂಡೆ /ಬುಟ್ಟಿ<br><b>निष्पत्तिः - </b>कडि (भेदने) - "ओलच्" (उ० १-६६)<br><br>कण्डोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಗ್ರಾಣ /ಸಾಮಾನುಗಳನ್ನು ಸಾಮಾನುಗಳನ್ನು ಕೂಡಿಡುವ ಜಾಗ<br><br>कण्डोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಷ್ಟ್ರ /ಒಂಟೆ<br><br>

कण्डोली
कण्डोली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कण्डोल ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीष्" (४-१-६३)<br><br>कण्डोली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂಡಾಲನ ವೀಣೆ<br><br>

कण्डोलवीणा
कण्डोलवीणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂಡಾಲನ ವೀಣೆ<br><br>

कण्व
कण्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಶ್ಯಪಗೋತ್ರದ ಒಬ್ಬ ಮಹರ್ಷಿ<br><br>कण्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೋಷ /ಪಾಪ<br><b>निष्पत्तिः - </b>कण (निमीलने) - "क्वन्" (उ० १-१४९)<br><b>विस्तारः - </b>"कण्वं पापे मुनौ पुंसि" - मेदि०।<br><br>

कण्वसुता
कण्वसुता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ವ ಮಹರ್ಷಿಯ ಮಗಳು<br><br>

कत
कत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕತಕವೃಕ್ಷ /ಚಿಲ್ಲದ ಗಿಡ<br><b>निष्पत्तिः - </b>तनु (विस्तारे) - "डः" (३-२-१०१)<br><b>व्युत्पत्तिः - </b>कं जलं शुद्धं तनोति<br><br>कत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಋಷಿ<br><br>कत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಲ್ಲದ ಬೀಜ<br><br>

कतक
कतक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಲ್ಲದ ಗಿಡ<br><b>व्युत्पत्तिः - </b>कस्य जलस्य तको हासो यस्मात्<br><br>कतक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಲ್ಲದ ಬೀಜ<br><b>प्रयोगाः - </b>"फलं कतकवृक्षस्य यद्यप्यम्बुप्रसादनम् । न नामग्रहणादेव तस्य वारि प्रसीदति ॥"<br><b>उल्लेखाः - </b>मनु० ६-६७<br><br>

कतफल
कतफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಲ್ಲದ ಗಿಡ<br><br>कतफल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಲ್ಲದ ಬೀಜ<br><br>

कतम
कतम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹುಮಂದಿಗಳಲ್ಲಿ ಯಾವನು? ಅನೇಕ ವಸ್ತುಗಳಲ್ಲಿ ಯಾವುದು?<br><b>निष्पत्तिः - </b>किम् - "डतमच्" (५-३-९३)<br><b>प्रयोगाः - </b>"कतमो भवतां देवदत्तः? " "अपि ज्ञायते कतमेन दिग्विभागेन गतः स जाल्मः"<br><b>उल्लेखाः - </b>विक्र०<br><br>कतम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನೇಕ ವಸ್ತುಗಳಲ್ಲಿ ಯಾವುದು ತಾನೆ<br><b>प्रयोगाः - </b>"न पुष्पिताऽत्र स्थगितार्करश्मावनन्तताने कतमा लताऽलम्" । "अहं भ्रमादालपभङ्गमृष्यतां विना ममोरः कतमत्तवासनम्"<br><b>उल्लेखाः - </b>माघ० ४-३९, नैष० ९-११४<br><br>

कतमा
कतमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹುಮಂದಿಗಳಲ್ಲಿ ಯಾವನು? ಅನೇಕ ವಸ್ತುಗಳಲ್ಲಿ ಯಾವುದು?<br><br>

कतर
कतर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಬ್ಬರಲ್ಲಿ ಯಾವನು? ಎರಡು ವಸ್ತುಗಳಲ್ಲಿ ಯಾವುದು?<br><b>निष्पत्तिः - </b>किम् - "डतरच्" (५-३-९२)<br><b>प्रयोगाः - </b>"अनयोः कतरो देवदत्तः?"<br><br>

कतरत्
कतरत्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಬ್ಬರಲ್ಲಿ ಯಾವನು? ಎರಡು ವಸ್ತುಗಳಲ್ಲಿ ಯಾವುದು?<br><b>प्रयोगाः - </b>"न चैतद्विद्मः कतरन्नो गरीयो यद्वा जयेम यदि वा नो जयेयुः"<br><b>उल्लेखाः - </b>गीता० २-६<br><br>

कति
कति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಷ್ಟು? ಎಷ್ಟು ಪರಿಮಾಣವುಳ್ಳದ್ದು? ಎಷ್ಟು ಸಂಖ್ಯೆಯುಳ್ಳದ್ದು?<br><b>निष्पत्तिः - </b>किम् - "डतिः" (५-२-४१)<br><b>व्युत्पत्तिः - </b>किं परिमाणमेतेषाम्<br><b>प्रयोगाः - </b>"निजपदपरिचारकाङ्क्षिणीभिः कतिषु भवेषु समर्चिताङ्घ्रिपद्मः"<br><b>उल्लेखाः - </b>याद० २४-५४<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् । कति ಗೆ चित् चन ಅಥವಾ अपि ಸೇರಿದರೆ ಅದರ ಸ್ವಂತ ಅರ್ಥವು ಸಂಕೋಚ ಹೊಂದಿ ಕೆಲವರು, ಕೆಲವು, ಬಹಳ ಎಂಬ ಅನಿರ್ದಿಷ್ಟ ಸಂಖ್ಯೆಯ ಅರ್ಥ ಕೊಡುವುದು. "दर्भाङ्कुरेण चरणः क्षत इत्यकाण्डे तन्वी स्थिता कतिचिदेव पदानि गत्वा" - शाकु० २-१२ । "कतिभिश्चन कामचारशक्तेरुपसञ्जातमदैरुदग्रश्रृङ्गैः"- याद० १५-११०।<br><br>

कतिकृत्वस्
कतिकृत्वस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎಷ್ಟು ಸಲ? ಎಷ್ಟಾವೃತ್ತಿ?<br><b>निष्पत्तिः - </b>कति - "कृत्वसुच्" (५-४-१७)<br><br>

कतिथ
कतिथ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಷ್ಟನೆಯದು?<br><b>निष्पत्तिः - </b>कति - "डट्" (५-२-४८) । युगागमः (५-२-५१)<br><b>प्रयोगाः - </b>"तस्य कतिथ इति तत्प्रथमं मनसा लमाख्यदपराधमच्युतः"<br><b>उल्लेखाः - </b>माघ० १५-४२<br><br>

कतिधा
कतिधा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎಷ್ಟು ವಿಧ? ಎಷ್ಟು ಪ್ರಕಾರ?<br><b>निष्पत्तिः - </b>कति - "धा" (५-३-४२)<br><br>

कतिपय
कतिपय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲವು<br><b>प्रयोगाः - </b>"सम्पत्स्यन्ते कतिपयदिनस्थायिहंसा दशार्णाः"<br><b>उल्लेखाः - </b>मेघ० १-२३<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>कतिपय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಿಮಿತವಾದ<br><b>प्रयोगाः - </b>"वर्णैः कतिपयैरेव ग्रथितस्य स्वरैरिव"<br><b>उल्लेखाः - </b>माघ० २-७२<br><br>कतिपय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲವು /ಸ್ವಲ್ಪ<br><br>कतिपय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ<br><b>प्रयोगाः - </b>"परिष्कुर्वन्त्यर्थान् सहृदयधुरीणाः कतिपये"<br><b>उल्लेखाः - </b>रसगं०<br><br>

कतिविध
कतिविध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಷ್ಟು ವಿಧ ? ಎಷ್ಟು ಬಗೆ?<br><b>व्युत्पत्तिः - </b>कति विधा प्रकारो यस्य<br><br>

कत्तृण
कत्तृण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಚಿಹುಲ್ಲು<br><br>कत्तृण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಚಿಕಡ್ಡಿ<br><br>कत्तृण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಂಚಿಕಡ್ಡಿ<br><br>कत्तृण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬರಗುಕಡ್ಡಿ<br><b>व्युत्पत्तिः - </b>कुत्सितं तृणम्<br><br>

कत्रि
कत्रि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಮೂವರು /ಕೆಟ್ಟ ಮೂರು ವಸ್ತುಗಳು<br><b>निष्पत्तिः - </b>कोः कत् (वा० ६-३-१०१)<br><b>व्युत्पत्तिः - </b>कुत्सिताः त्रयः<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>

कत्थ|श्लाघायाम्|कत्थते
कत्थ - श्लाघायाम् (भ्वा० आत्म० सक० से) कत्थते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಶ್ಲಾಘಿಸು /ಪ್ರಶಂಸೆ ಮಾಶು /ಹೊಗಳು /ಜಂಬ ಹೊಡೆ<br><br>

कत्थक
कत्थक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ಲಾಘನೆ ಮಾಡುವ /ಹೊಗಳುವ /ಜಂಬ ಹೊಡೆಯುವ<br><b>निष्पत्तिः - </b>कत्थ (श्लाघायाम्) - "ण्वुल्" (३-१-१३३)<br><br>

कत्थन
कत्थन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ಲಾಘಿಸುವುದು /ಜಂಬ ಹೊಡೆಯುವುದು /ಹೊಗಳುವುದು<br><b>निष्पत्तिः - </b>कत्थ (श्लाघायाम्) - भावे "ल्युट्" (३-३-११५)<br><br>

कत्थनीय
कत्थनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಶ್ಯಕವಾಗಿ ಶ್ಲಾಘಿಸಲ್ಪಡುವ<br><br>कत्थनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ಲಾಘಿಸಲು ಯೋಗ್ಯವಾದ<br><br>कत्थनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಗಳಲು ಶಕ್ಯವಾದ<br><b>निष्पत्तिः - </b>कत्थ (श्लाघायाम्) - "अनीयर्" (३-१-९६)<br><br>

कत्थमान
कत्थमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ಲಾಘಿಸುತ್ತಿರುವ /ಹೊಗಳುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कत्थ (श्लाघायाम्) - "शानच्" (३-२-१२४)<br><br>

कत्थित
कत्थित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ಲಾಘನೆ /ಹೊಗಳಿಕೆ<br><b>निष्पत्तिः - </b>कत्थ (श्लाघायाम्) - भावे "क्तः" (३-३-११४)<br><br>कत्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ಲಾಘಿಸಲ್ಪಟ್ಟ /ಹೊಗಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कत्थ (श्लाघायाम्) - "क्तः" (३-२-१०२)<br><br>

कत्थितव्य
कत्थितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಶ್ಯವಾಗಿ ಹೊಗಳಲ್ಪಡುವ<br><br>कत्थितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಗಳಲು ಅರ್ಹವಾದ<br><br>कत्थितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಗಳಲು ಶಕ್ಯವಾದ<br><b>निष्पत्तिः - </b>कत्थ (श्लाघायाम्) - "तव्यः" (३-१-९६)<br><br>

कत्र|शैथिल्ये
कत्र - शैथिल्ये (चुरा० उभ० अक० से०)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಡಿಲವಾಗು<br><br>

कथ|वाक्यप्रबन्धे|ते
कथ - वाक्यप्रबन्धे (चुरा० उभ० सक० से) कथयति - ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೇಳು /ತಿಳಿಸು /ನಿರೂಪಿಸು /ವರ್ಣಿಸು<br><b>प्रयोगाः - </b>"कार्तवीर्यजलक्रीडां कथयन्ति स्म तापसाः" । "राममिष्वसनदर्शनोत्सुकं मैथिलाय कथयाम्बभूव सः" । "कथ्यते चिदचिदन्तरात्मनः शास्त्रशुद्धहृदयैर्मनीषिभिः" ।<br><b>उल्लेखाः - </b>याद० २२-२२०, रघु० ११-३७, याद० १७-१०८<br><br>कथ - वाक्यप्रबन्धे (चुरा० उभ० सक० से) कथयति - ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸೂಚಿಸು /ತಿಳಿಸು<br><b>प्रयोगाः - </b>"गात्रैस्ते कथयन्त्यसारभिदुरान् प्रायेण संसारिणः"<br><b>उल्लेखाः - </b>मालती० ८-१०<br><br>कथ - वाक्यप्रबन्धे (चुरा० उभ० सक० से) कथयति - ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ತೋರಿಸಿ ಹೇಳು /ನಿರ್ದೇಶಿಸು<br><b>प्रयोगाः - </b>"भक्षयन्तीं न कथयेत्पिबन्तं चैव वत्सकम्"<br><b>उल्लेखाः - </b>मनु० ११-११४<br><br>

कथक
कथक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳುವವನು /ನಿರೂಪಿಸುವವನು /ವರ್ಣಿಸುವವನು<br><b>निष्पत्तिः - </b>कथ (वाक्यप्रबन्धे) -"ण्वुल्" (३-१-१३३)<br><br>कथक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುವಾದ ಮಾಡುವವನು<br><br>कथक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುರಾಣ ಹೇಳುವವನು /ಕಥೆ ಹೇಳಿ ಜೀವಿಸುವವನು<br><br>कथक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತತ್ತ್ವನಿರ್ಣಯಕ್ಕಾಗಿ ವಾದ ಮಾಡುವವನು<br><b>प्रयोगाः - </b>"कथादर्पक्षुभ्यत्कथककुलकोलाहलभवं हरत्वन्तर्ध्वानं हृदयवदनहेषाहलहलः"<br><b>उल्लेखाः - </b>हयग्री०<br><br>

कथङ्कारम्
कथङ्कारम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೇಗೆ? ಹೇಗೆ ತಾನೆ?<br><b>निष्पत्तिः - </b>कथम् + डुकृञ् (करणे) - "णमुल्" (३-४-२७)<br><b>व्युत्पत्तिः - </b>कथं कृत्वा<br><b>प्रयोगाः - </b>"कथङ्कारमनालम्बा कीर्तिर्द्यामधिरोहति" । "धार्यं कथङ्कारमहं भवत्या वियद्विहारी वसुधैकगत्या" ।<br><b>उल्लेखाः - </b>माघ० २-५२, नैष० ३-१५<br><br>

कथञ्चन
कथञ्चन<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೇಗಾದರೂ<br><br>कथञ्चन<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕಷ್ಟದಿಂದ<br><b>विस्तारः - </b>ಇದು ಅಸಾಕಲ್ಯಾರ್ಥವನ್ನು ಕೊಡುವುದು. "असाकल्ये तु चिच्चन" ಎಂದು ಅಮರಕೋಶದಲ್ಲಿ चित् चन ಎಂದು ಪ್ರತ್ಯೇಕ ಪದಗಳಾಗಿ ಹೇಳಲ್ಪಟ್ಟಿದ್ದರೂ ಈ ಪದಗಳಿಗೆಪ್ರತ್ಯೇಕವಾಗಿ ಪ್ರಯೋಗವಿಲ್ಲದಿರುವುದರಿಂದ कतिचित् कतिचन कथञ्चित् कथञ्चन कश्चन कश्चित् ಇತ್ಯಾದಿ ಇತರ ಪದಗಳೊಡನೆ ಸೇರಿಸಿ ಪ್ರಯೋಗಿಸಲ್ಪಡುವುವು. "या कथञ्चन सखीवचनेन प्रागभिप्रियतमं प्रजगम्भे" - माघ० १०-१८ । "अथ प्रयत्नोन्नमितानमत्फणैर्धृते कथञ्चित्फणिनां गणैरधः" - माघ० १-१३<br><br>

कथन
कथन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಳುವಿಕೆ /ನಿರೂಪಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>कथ (वाक्यप्रबन्धे) + णिच् - "ल्युट्" (३-३-११५)<br><br>कथन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಚಿಸುವಿಕೆ<br><br>कथन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೋರಿಸುವಿಕೆ /ನಿರ್ದೇಶಿಸುವಿಕೆ<br><br>

कथनीय
कथनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಶ್ಯವಾಗಿ ಹೇಳಲ್ಪಡುವ<br><br>कथनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲು ಯೋಗ್ಯವಾದ /ಹೇಳಲು ಅರ್ಹವಾದ<br><br>कथनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲು ಶಕ್ಯವಾದ<br><b>निष्पत्तिः - </b>कथ (वाक्यप्रबन्धे) + णिच् - "अनीयर्" (३-१-९६)<br><br>

कथम्
कथम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೇಗೆ? ಯಾವರೀತಿಯಿಂದ ? ಯಾವ ಪ್ರಕಾರದಿಂದ?<br><b>निष्पत्तिः - </b>किमु - प्रकारे "थमुः"(-३-२५)<br><b>प्रयोगाः - </b>"अवाप्यते वा कथमन्यथा द्वयं तथाविधं प्रेम पतिश्च तादृशः"<br><b>उल्लेखाः - </b>कुमा० ५-२<br><br>कथम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ<br><b>प्रयोगाः - </b>"कथमिदानीमात्मानं निवेदयामि? कथं वा आत्मापहारं करोमि?"<br><b>उल्लेखाः - </b>शाकु० १<br><br>कथम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಭ್ರಮ /ಗಡಿಬಿಡಿ /ಆಕಸ್ಮಿಕದಿದುಂಟಾದ ಕಳವಳ<br><b>प्रयोगाः - </b>"कथमुपहारीकृतास्मि राज्ञस्तातेन? राजाराधनं पुनर्गुरूकं न पुनर्मालती"<br><b>उल्लेखाः - </b>मालती० २<br><br>कथम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ<br><br>कथम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಶ್ಚರ್ಯ /ವಿಸ್ಮಯ<br><br>कथम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಊಹೆ /ಸಂಭಾವನೆ<br><br>कथम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹರ್ಷ /ಸಂತೋಷ<br><b>विस्तारः - </b>"कथं हर्षे च गर्हायां प्रकारार्थे च सम्भ्रमे । प्रश्ने सम्भावनायां च" - मेदि० ।<br><br>

कथमपि
कथमपि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕಷ್ಟದಿಂದ /ಬಹಳ ಪ್ರಯತ್ನದಿಂದ<br><b>व्युत्पत्तिः - </b>कथं च अपि च<br><b>प्रयोगाः - </b>"मुखमंसविवर्ति पक्ष्मलाक्षाः कथमप्युन्नमितं न चुम्बितं तु"<br><b>उल्लेखाः - </b>शाकु० ३-२२<br><br>कथमपि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೇಗಾದರೂ /ಎಷ್ಟೇ ಕಷ್ಟದಿಂದಾದರೂ /ಪ್ರಯತ್ನದಿಂದಾದರೂ<br><b>प्रयोगाः - </b>"तस्य स्थित्वा कथमपि पुरः कौतुकाधानहेतोः"<br><b>उल्लेखाः - </b>मेघ० २-३<br><br>कथमपि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಾವ ರೀತಿಯಿಂದಾದರೂ/ ಯಾವ ಪ್ರಕಾರದಿಂದಾದರೂ<br><b>प्रयोगाः - </b>"शुक्लापाङ्गैः सजलनयनैः स्वागतीकृत्य केकाः प्रत्युद्यातः कथमपि भवान् गन्तुमाशु व्यवस्येत्"<br><b>उल्लेखाः - </b>मेघ० १-२२<br><br>कथमपि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಬಹಳ ವಿವರವಾಗಿ /ಅಪೂರ್ವವಾಗಿ<br><b>प्रयोगाः - </b>"कथमपि भुवनेऽस्मिंस्तादृशाः सम्भवन्ति"<br><b>उल्लेखाः - </b>मालती० २-६<br><br>

कथमिव
कथमिव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>कथङ्कारम् ಪದದ ಅರ್ಥ<br><br>

कथम्भाव
कथम्भाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಗೆ ? ಯಾವ ರೀತಿ? ಯಾವ ಪ್ರಕಾರ? ಯಾವ ಬಗೆ?<br><b>व्युत्पत्तिः - </b>कथमित्यस्य भावः स्थितिः<br><br>

कथम्भावाकाङ्क्षा
कथम्भावाकाङ्क्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವ ರೀತಿ ಮಾಡಬೇಕೆಂದು ತಿಳಿಯುವ ಇಚ್ಛೆ<br><b>विस्तारः - </b>यजेत् ಇತ್ಯಾದಿ ವಿಧಿವಾಚಕ ಶಬ್ದ ಪ್ರಯೋಗದಿಂದ ಉಂಟಾಗುವ ೩ ವಿಧ ಆಕಾಂಕ್ಷೆಗಳಲ್ಲೊಂದು. यजेत ಎಂದ ಕೂಡಲೆ किम् केन ಮತ್ತು कथम् ಎಂಬ ೩ ಆಕಾಂಕ್ಷೆಗಳು ಉಂಟಾಗುವುವು. ಅವುಗಳಲ್ಲಿ ಅಂಗಭೂತವಾದ ಕ್ರಿಯೆಗಳ ಆಕಾಂಕ್ಷೆಯುकथम्भावाकाङ्क्षा ।<br><br>

कथम्भूत
कथम्भूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಂತಹ /ಯಾವ ರೀತಿಯ<br><br>कथम्भूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವ ರೀತಿಯಾಗಿರುವ /ಯಾವ ಪ್ರಕಾರವಾಗಿರುವ<br><b>व्युत्पत्तिः - </b>कथं किं प्रकारं भूतः प्राप्तः<br><br>

कथयत्
कथयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳುತ್ತಿರುವ /ನಿರೂಪಿಸುತ್ತಿರುವ /ವರ್ಣಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कथ (वाक्यप्रबन्धे) + णिच् - "शतृ" (३-२-१२४)<br><br>कथयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೂಚಿಸುತ್ತಿರುವ /ತಿಳಿಸುತ್ತಿರುವ<br><b>प्रयोगाः - </b>"अस्तित्वं कार्यसिद्धेः स्फुटमथ कथयन् पक्षतेः कम्पभेदैः"<br><b>उल्लेखाः - </b>नैष० ६-१३२<br><br>कथयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೋರಿಸಿ ಹೇಳುತ್ತಿರುವ /ನಿರ್ದೇಶಿಸಿ ತಿಳಿಸುತ್ತಿರುವ<br><br>

कथयन्ती
कथयन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कथयत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कथञ्जातीय
कथञ्जातीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವ ವಿಧದ? ಯಾವ ಬಗೆಯ<br><b>निष्पत्तिः - </b>कथं प्रकार - "जातीयर्" (५-३-९६)<br><br>

कथञ्जातीयक
कथञ्जातीयक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವ ವಿಧದ? ಯಾವ ಬಗೆಯ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्" (५-३-७५)<br><br>

कथन्तराम्
कथन्तराम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೇಗೆ? ಯಾವ ರೀತಿ?<br><b>निष्पत्तिः - </b>कथम् - "तरप्" (५-३-५७) । "आमुः" (५-४-११)<br><br>

कथन्तमाम्
कथन्तमाम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೇಗೆ? ಯಾವ ರೀತಿ?<br><b>निष्पत्तिः - </b>कथम् - "तमप्" (५-३-५५) । "आमुः" (५-४-११)<br><br>

कथा
कथा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಳುವುದು /ನಿರೂಪಿಸುವುದು<br><b>निष्पत्तिः - </b>कथ (वाक्यप्रबन्धे) - "अङ्" (३-३-१०५)<br><b>प्रयोगाः - </b>"कथापि खलु पापानामलमश्रेयसे यतः"<br><b>उल्लेखाः - </b>माघ० २-४०<br><br>कथा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಸ್ಪರ ಮಾತಾಡುವುದು /ಸಂಭಾಷಣೆ<br><b>प्रयोगाः - </b>"कथाप्रसङ्गेषु मिथः सखीमुखात्तृणेऽपि तन्व्या नलनामनि श्रुते"<br><b>उल्लेखाः - </b>नैष० १-३५<br><br>कथा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಥೆ /ಕಲ್ಪಿತ ಕಥೆ /ಕಟ್ಟು ಕಥೆ<br><b>प्रयोगाः - </b>"कथाच्छलेन बालानां नीतिस्तदिह कथ्यते"<br><b>उल्लेखाः - </b>हितो०<br><br>कथा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತತ್ತ್ವ /ನಿರ್ಣಯ ಅಥವಾ ವಾದಿವಿಜಯಕ್ಕಾಗಿ ಅನೇಕ ಪ್ರತಿವಾದಿಗಳು ಪೂವಪಕ್ಷಸಿದ್ಧಾಂತರೂಪವಾಗಿ ಯುಕ್ತಿಗಳಿಂದ ಆಡುವ ಮಾತು<br><br>

कथानक
कथानक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಕಥೆಗಳಿಂದ ಕೂಡಿದ ದೊಡ್ಡ ಕಥೆ<br><b>निष्पत्तिः - </b>"आनकः" बाहु० ।<br><b>व्युत्पत्तिः - </b>कथयत्यत्र<br><br>

कथान्तर
कथान्तर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಥೆಯ ಮಧ್ಯ /ಮಾತಿನ ಮಧ್ಯ<br><b>व्युत्पत्तिः - </b>कथाया अन्तरम्<br><br>कथान्तर<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಬೇರೆ ಕಥೆ /ಬದಲಾಯಿಸಲ್ಪಟ್ಟ ಕಥೆ<br><b>व्युत्पत्तिः - </b>अन्या कथा<br><br>

कथाप्रसङ्ग
कथाप्रसङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾತನಾಡುವ ಪ್ರಸಂಗ /ಮಾತಿನ ಸಂದರ್ಭ<br><b>व्युत्पत्तिः - </b>कथाया प्रसङ्गः<br><b>प्रयोगाः - </b>"कथाप्रसङ्गेषु मिथः सखीमुखात्तृणेऽपि तन्व्या नलनामनि श्रुते"<br><b>उल्लेखाः - </b>नैष० १-३५<br><br>कथाप्रसङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ ವೈದ್ಯ /ಹಾವಾಡಿಗ<br><b>प्रयोगाः - </b>"कथाप्रसङ्गेषु जनैरुदाहृतात् अनुस्मृताखण्डलसूनुविक्रमः"<br><b>उल्लेखाः - </b>किरा० १-२४<br><br>

कथामुख
कथामुख<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಥೆಯ ಪ್ರಾರಂಭ /ಪೀಠಿಕಾ ಪ್ರಕರಣ /ಪ್ರಸ್ತಾವನೆ<br><b>व्युत्पत्तिः - </b>कथाया आमुखम्<br><br>

कथारम्भ
कथारम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಥೆಯ ಉಪಕ್ರಮ /ಕಥೆಯನ್ನು ಪ್ರಾರಂಭಿಸುವಿಕೆ<br><b>व्युत्पत्तिः - </b>कथाया आरम्भः<br><br>

कथालाप
कथालाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಾಷಣ /ಮಾತನಾಡುವಿಕೆ<br><br>कथालाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಭಾಷಣೆ<br><b>व्युत्पत्तिः - </b>कथाया आलापः<br><br>

कथावतार
कथावतार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪೋದ್ಘಾತ /ಪೀಠಿಕೆ<br><b>व्युत्पत्तिः - </b>कथाया अवतारः यत्र<br><br>कथावतार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ರೂಪದಿಂದ ಕಥೆಯುಹುಟ್ಟುವಿಕೆ /ಕಥೆಯ ಸೃಷ್ಟಿ<br><b>व्युत्पत्तिः - </b>कथाया अवतारः<br><br>

कथावलि
कथावलि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಥೆಗಳ ಸಂಗ್ರಹ /ಕಥೆಗಳ ಮಾಲೆ /ಅನೇಕ ಕಥೆಗಳ ಗುಂಪು<br><b>व्युत्पत्तिः - </b>कथानामावलिः<br><br>

कथासङ्ग्रह
कथासङ्ग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಥೆಗಳ ಸಂಗ್ರಹ /ಕಥೆಗಳ ಮಾಲೆ /ಅನೇಕ ಕಥೆಗಳ ಗುಂಪು<br><br>

कथित
कथित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಥನ /ಹೇಳುವಿಕೆ<br><b>निष्पत्तिः - </b>कथ (वाक्यप्रबन्धे) + णिच् - भावे "क्तः" (३-३-११४)<br><b>प्रयोगाः - </b>"पूर्ववृत्तकथितैः पुराविदः सानुजः पितृसख स्यराघवः । उह्यमान इव वाहनोचितः पादचारमपिन व्यभावयत् ॥"<br><b>उल्लेखाः - </b>रघु० ११-१०<br><br>कथित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲ್ಪಟ್ಟ ಮನುಷ್ಯ<br><b>निष्पत्तिः - </b>कथ (वाक्यप्रबन्धे) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"अथ किल कथिते सखीभिरत्र क्षणमपरेव ससम्भ्रमा भवन्ती"<br><b>उल्लेखाः - </b>माघ० ७-३६<br><br>कथित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲ್ಪಟ್ಟ ವಿಷಯ<br><b>प्रयोगाः - </b>"कथितमपि नरेन्द्रः शंसयामास हंसम्"<br><b>उल्लेखाः - </b>नैष० ३-१३५<br><br>

कथितपद
कथितपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುನಃ ಹೇಳಲ್ಪಟ್ಟ ಪದವುಳ್ಳ ವಾಕ್ಯ /ಪುನರುಕ್ತವಾದ ಪದವುಳ್ಳ ವಾಕ್ಯ<br><br>

कथितपदता
कथितपदता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುನಃ ಹೇಳಲ್ಪಟ್ಟ ಪದವುಳ್ಳ ವಾಕ್ಯ /ಪುನರುಕ್ತವಾದ ಪದವುಳ್ಳ ವಾಕ್ಯ<br><br>

कथितवत्
कथितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಿದವನು /ಮಾತನಾಡಿದವನು /ನಿರೂಪಿಸಿದವನು<br><b>निष्पत्तिः - </b>कथ (वाक्यप्रबन्धे) + णिच् - कर्त० "क्तवतुः"(३-२-१०२)<br><br>

कथितवती
कथितवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಳಿದವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कथोद्घात
कथोद्घात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಥೆಯ ಪ್ರಾರಂಭ<br><b>व्युत्पत्तिः - </b>कथाया उद्घातः<br><b>प्रयोगाः - </b>"आकुमारकथोद्घातं शालिगोप्यो जगुर्यशः"<br><b>उल्लेखाः - </b>रघु० ४-२०<br><br>कथोद्घात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಟಕದಲ್ಲಿ ಆಮುಖದ ಒಂದು ಅಂಗ /ಪ್ರಸ್ತಾವನೆಯ ೩ ವಿಧ ಅಂಗಗಳಲ್ಲೊಂದು<br><br>

कथ्य
कथ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಬಹುದಾದ<br><br>कथ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲು ಶಕ್ಯವಾದ<br><br>कथ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲು ಅರ್ಹವಾದ<br><br>कथ्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>कथ (वाक्यप्रबन्धे) + णिच् - "यत्"(३-१-९७)<br><br>

कथ्यमान
कथ्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳಲ್ಪಡುತ್ತಿರುವ /ನಿರೂಪಿಸಲ್ಪಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कथ (वाक्यप्रबन्धे) + णिच् - "शानच्" (३-२-१२४)<br><br>

कद
कद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कं वारि ददाति<br><br>कद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರನ್ನು ಕೊಡುವ<br><b>व्युत्पत्तिः - </b>कं जलं सुखं वा ददाति<br><br>कद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಖವನ್ನು ಕೊಡುವ<br><br>

कदग्नि
कदग्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂದವಾದ ಅಗ್ನಿ /ಶಕ್ತಿ ಕುಂದಿದ ಅಗ್ನಿ<br><b>निष्पत्तिः - </b>कोः कत् ( ६-३-१०१)<br><b>व्युत्पत्तिः - </b>कुत्सितश्चासावग्निश्च<br><br>

कदध्वन्
कदध्वन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ದಾರಿ /ಸರಿಯಿಲ್ಲದ ಮಾರ್ಗ<br><b>निष्पत्तिः - </b>कोः कत् ( ६-३-१०१)<br><b>व्युत्पत्तिः - </b>कुत्सितोऽध्वा<br><br>

कदन
कदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಧೆ /ಸಂಹಾರ /ಕೊಲ್ಲುವಿಕೆ<br><b>निष्पत्तिः - </b>कद (वैक्लव्ये) भावे "ल्युट्" (३-३-११५)<br><b>विस्तारः - </b>"व्यापादनं च हिंसा च कदनं सङ्कुलो वधः" - वैज० । "निर्ग्रन्थनं प्रमथनं कदनं निबर्हणम्" - अभि० चि० ।<br><br>कदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><b>निष्पत्तिः - </b>कद (वैक्लव्ये) भावे "ल्युट्" (३-३-११५)<br><br>कदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೀಡಿಸುವಿಕೆ /ಹಿಂಸಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>कद (वैक्लव्ये) कर० "ल्युट्" (३-३-११७)<br><b>विस्तारः - </b>"कदनं मर्दपापयोः" - मेदि० ।<br><br>कदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ<br><b>निष्पत्तिः - </b>कद (वैक्लव्ये) अधि० "ल्युट्" (३-३-११७)<br><b>प्रयोगाः - </b>"इति ते भर्तृनिर्देशमादाय शिरसाऽदृताः । तथा प्रजानां कदनं विदधुः कदनप्रियाः" ।<br><b>उल्लेखाः - </b>भाग० ७-२-१३<br><br>

कदन्न
कदन्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಅನ್ನ /ಕೆಟ್ಟ ಆಹಾರ<br><b>निष्पत्तिः - </b>कोः कत् ( ६-३-१०१)<br><b>व्युत्पत्तिः - </b>कुत्सितमन्नम्<br><br>कदन्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಆಹಾರ ತಿನ್ನುವ<br><b>निष्पत्तिः - </b>"अच्" (५-३-१२७)<br><b>व्युत्पत्तिः - </b>कदन्नमस्त्यस्य<br><br>

कदश्व
कदश्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಅನ್ನ /ಕೆಟ್ಟ ಆಹಾರ<br><br>

कद्रथ
कद्रथ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಅನ್ನ /ಕೆಟ್ಟ ಆಹಾರ<br><br>

कदपत्य
कदपत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಮಗ /ದುಷ್ಟನಾದ ಮಗ /ದುರಾಚಾರದ ಮಗ<br><b>निष्पत्तिः - </b>कोः कत् ( ६-३-१०१)<br><b>व्युत्पत्तिः - </b>कुत्सितमपत्यम्<br><br>

कदम्ब
कदम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀಪವೃಕ್ಷ /ಉತ್ತಮ ಜಾತಿಯ ಈಚಲು ಮರ<br><br>कदम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಸುವೆ<br><b>निष्पत्तिः - </b>कद (वैक्लव्ये) - "अम्बच्" (उ० ४-८२)<br><b>प्रयोगाः - </b>"तत्सम्पर्कात् पुलकितमिव प्रौढपुष्पैः कदम्बैः"<br><b>उल्लेखाः - </b>मेघ० १-२७<br><br>कदम्ब<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೂಹ /ಗುಂಪು<br><b>प्रयोगाः - </b>"अस्याः खलुग्रन्थिनिबद्धकेशमल्लीकदम्बप्रतिबिम्बवेषात्"<br><b>उल्लेखाः - </b>नैष० ७-८८<br><b>विस्तारः - </b>"कदम्बं नुकुरुम्बे स्यान्नीपसर्षपयोरपि" - मेदि० ।<br><br>

कदम्बक
कदम्बक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀಪವೃಕ್ಷ /ಉತ್ತಮ ಜಾತಿಯ ಈಚಲು ಮರ<br><b>निष्पत्तिः - </b>सञ्ज्ञायां स्वार्थे वा "कः"<br><br>कदम्बक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಸುವೆ<br><br>कदम्बक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೂಹ /ಗುಂಪು<br><b>प्रयोगाः - </b>"पृथुकदम्बकदम्बकराजितम्"<br><b>उल्लेखाः - </b>किरा० ५-९<br><br>

कदर
कदर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿಕಗ್ಗಲಿ ಮರ<br><br>कदर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರಗಸ<br><br>कदर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕದರುರೋಗ<br><b>निष्पत्तिः - </b>दृणाति - "अच्" (३-१-१३४) । कस्य दरः ।<br><br>कदर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸ್ತ್ರದ ಛಾವಣಿ /ಬಣ್ಣ ಬಣ್ಣದ ಬಟ್ಟೆಗಳಿಂದ ಕಟ್ಟಿದ ವಿತಾನ<br><b>विस्तारः - </b>"चन्द्रोदय उल्लोचः कदरश्चन्द्रातपो वितानोऽस्त्री" - वैज० ।<br><br>

कदर्थ
कदर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಅರ್ಥ /ದುಷ್ಟವಾದ ಅರ್ಥ<br><br>कदर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ವಸ್ತು /ಕೆಟ್ಟ ಪದಾರ್ಥ<br><br>कदर्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಪ್ರಯೋಜನ /ಕೆಟ್ಟ ಫಲ<br><b>निष्पत्तिः - </b>कोः कत् ( ६-३-१०१)<br><b>व्युत्पत्तिः - </b>कुत्सितोऽर्थः<br><br>

कदर्थन
कदर्थन<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಡಿಸುವಿಕೆ /ಪ್ರಯೋಜನವಿಲ್ಲದಂತೆ ಮಾಡುವಿಕೆ<br><br>

कदर्थना
कदर्थना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೀಡೆ /ಹಿಂಸೆ /ತೊಂದರೆ<br><b>प्रयोगाः - </b>"ददेऽपि तुभ्यं कियतीः कदर्थनाः सुरेषु रागप्रसवावकेशिनी"<br><b>उल्लेखाः - </b>नैष० ९-१३१<br><br>

कदर्थनीय
कदर्थनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೀಡಿಸಲು ಅರ್ಹವಾದ<br><br>कदर्थनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೀಡಿಸಲು ಶಕ್ಯವಾದ<br><br>कदर्थनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೀಡಿಸಲ್ಪಡುವ<br><b>प्रयोगाः - </b>"दिगीश्वरार्थं न कथञ्चन त्वया कदर्थनीयास्मि कृतोऽयमञ्जलिः"<br><b>उल्लेखाः - </b>नैष० ९-६९<br><br>कदर्थनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಡಿಸಲು ಶಕ್ಯವಾದ<br><br>कदर्थनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಡಿಸಲು ಅರ್ಹವಾದ<br><br>कदर्थनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಡಿಸಲ್ಪಡುವ<br><br>

कदर्थित
कदर्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಡಿಸಲ್ಪಟ್ಟ /ಪ್ರಯೋಜನವಿಲ್ಲದಂತೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>तत्करोति तदाचष्टे (ग० २०४) । कदर्थ + णिच् - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>कुत्सितोऽर्थः कदर्थः । कदर्थः कृतः<br><b>प्रयोगाः - </b>"मृष्टचन्दनविशेषकभक्तिभ्रष्टभूषणकदर्थितमाल्यः"<br><b>उल्लेखाः - </b>माघ० १०-८४<br><br>कदर्थित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೀಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"च्विः" (वा० ५-४-५०)। दीर्घः (७-४-३२)<br><b>व्युत्पत्तिः - </b>कुत्सितोऽर्थः कदर्थः । अकदर्थः कदर्थः कृतः<br><b>प्रयोगाः - </b>"निमीलनस्पष्टविलोकनाभ्यां कदर्थितस्तादाकलयन् कटाक्षैः"<br><b>उल्लेखाः - </b>नैष० ६-२२<br><br>

कदर्थीकृत
कदर्थीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯರ್ಥಪಡಿಸಲ್ಪಟ್ಟ /ಪ್ರಯೋಜನವಿಲ್ಲದಂತೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"केशैः कदर्थीकृतवीर्यसारः कच्चित्स एवासि धनञ्जयस्त्वम्"<br><b>उल्लेखाः - </b>किरा० ३-४७<br><br>

कदर्थ्यमान
कदर्थ्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಡಿಸಲ್ಪಡುತ್ತಿರುವ /ವ್ಯರ್ಥಪಡಿಸಲ್ಪಡುತ್ತಿರುವ<br><br>कदर्थ्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೀಡಿಸಲ್ಪಡುತ್ತಿರುವ /ಹಿಂಸಿಸಲ್ಪಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कदर्थ + णिच् - कर्म० "शानच्" (३-२-१४)<br><b>व्युत्पत्तिः - </b>कदर्थः क्रियमाणः<br><b>प्रयोगाः - </b>"शरैरजस्रं कुसुमायुधस्य कदर्थ्यमानस्तरुणि त्यदर्थे"<br><b>उल्लेखाः - </b>नैष० ८-७५<br><br>

कदर्य
कदर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಪಣ /ಜಿಪುಣ /ಲೋಭಿ<br><b>निष्पत्तिः - </b>कोः कत् ( ६-३-१०१)<br><b>व्युत्पत्तिः - </b>कुत्सितः अर्थः स्वामी<br><b>प्रयोगाः - </b>"स्तेनगायनयोश्चान्नं तक्ष्णो वार्धुषिकस्य च । दीक्षितस्य कदर्यस्य बद्धस्य निगडस्य च ॥"<br><b>उल्लेखाः - </b>मनु० ४-२१०<br><br>कदर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀಚ /ಕೀಳುತನದ /ತುಚ್ಛ /ನಿಕೃಷ್ಟ<br><br>

कदल
कदल<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಳೆಯ ಗಿಡ<br><b>निष्पत्तिः - </b>कद (वैक्लव्ये)- "कलः" (उ० १-१०६)<br><b>प्रयोगाः - </b>"ऊरुद्वयं मृगदृशो कदलस्य काण्डो"<br><b>उल्लेखाः - </b>अमरु० १३६<br><br>कदल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಳೆಯ ಹಣ್ಣು<br><br>

कदलक
कदलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಳೆಯ ಹಣ್ಣು<br><b>निष्पत्तिः - </b>स्वार्थे "कन्" (५-३-७५)<br><br>

कदली
कदली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಳೆಯ ಹಣ್ಣು<br><b>निष्पत्तिः - </b>गौरा० "ङीष्" (४-१-४१)<br><br>कदली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಜಿಂಕೆ /ಶ್ರೇಷ್ಠವಾದ ಚರ್ಮವುಳ್ಳ ಚಿಗರಿ<br><br>कदली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಳೆಯ ಗಿಡ<br><b>निष्पत्तिः - </b>दल (विदारणे) - "घः" (३-३-१२४)<br><b>व्युत्पत्तिः - </b>केन वायुना दल्यते<br><b>प्रयोगाः - </b>"इत्यस्य तेने कदलीर्मधुश्रीः प्रभावनी केतनवैजयन्तीः"<br><b>उल्लेखाः - </b>माघ० ६-६९<br><br>कदली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪತಾಕೆ /ಧ್ವಜ<br><b>विस्तारः - </b>"कदली हरिणान्तरे । रम्भायां वैजयन्त्यां च" - हेम० ।<br><br>

कदला
कदला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಲ್ಮಲಿ ವೃಕ್ಷ /ಭೂರುಗದ ಮರ<br><br>

कदलिका
कदलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪತಾಕೆ /ಧ್ವಜ<br><br>कदलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಳೆಯ ಗಿಡ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्" (५-३-७५)<br><b>व्युत्पत्तिः - </b>कदल्येव<br><b>प्रयोगाः - </b>"तं स द्विपेन्द्रतुलितातुलतुश्रृङ्गमभ्युल्लसत्कदलिकावनराजिमुच्चैः"<br><b>उल्लेखाः - </b>माघ० ५-२<br><br>

कदा
कदा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಾವಾಗ? ಯಾವ ಕಾಲದಲ್ಲಿ? ಯಾವ ಸಮಯದಲ್ಲಿ?<br><b>निष्पत्तिः - </b>किम् - "दा" (५-३-१५) । किमः "कः" (७-२-१०३)<br><b>प्रयोगाः - </b>"कदा कर्हि वा भुङ्क्ते भोक्ष्ससे भोक्ता वा" । "जातिद्रव्यगुणानां च साम्यमेषां मया सह । मत्प्रभुत्वफलं ब्रूहि कदा किं तद्भविष्यसि"<br><b>उल्लेखाः - </b>सि० कौ०, हितो० १-४७<br><br>

कदाचन
कदाचन<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಾವಾಗಲೂ /ಯಾವ ಸಮಯದಲ್ಲೂ<br><b>प्रयोगाः - </b>"ब्राह्मण विप्रस्तीर्थेन नित्यकालमुपस्पृशेत् । कायत्रैदशिकाभ्यां वा न पित्र्येण कदाचन"<br><b>उल्लेखाः - </b>मनु० २-५८<br><br>

कदाचित्
कदाचित्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಾವುದೋ ಒಂದು ಸಮಯದಲ್ಲಿ / ಯಾವುದೋಒಂದು ಕಾಲದಲ್ಲಿ<br><b>प्रयोगाः - </b>"कण्डूयमानेन कटं कदाचिद्वन्यद्विपेनोन्मथिता त्वगस्य"<br><b>उल्लेखाः - </b>रघु० २-३७<br><br>

कदुष्ण
कदुष्ण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಬಿಸಿ /ಸ್ವಲ್ಪ ಬೆಚ್ಚಗಿರುವಿಕೆ /ಉಗುರು ಬೆಚ್ಚಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>कोः कत् ( ६-३-१०१)<br><b>व्युत्पत्तिः - </b>ईषदुष्णम्<br><br>कदुष्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಬಿಸಿಯಾಗಿರುವ /ಉಗುರು ಬೆಚ್ಚಗಿರುವ<br><b>प्रयोगाः - </b>"त्वया विधेया न गिरो मदर्थाः क्रुधा कदुष्णे हृदि नैषधस्य"<br><b>उल्लेखाः - </b>नैष० ३-९४<br><br>कदुष्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿರುಸಾದ /ಚುರುಕಾದ /ಮನನೋಯಿಸುವ ಮಾತು<br><b>प्रयोगाः - </b>"निरस्य दूतः स तथा विसर्जितः प्रियोक्तिरप्याह कदुष्णमक्षरम्"<br><b>उल्लेखाः - </b>नैष० ९-३८<br><br>

कद्रु
कद्रु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಂಬಣ್ಣ /ಹಳದಿ ಬಣ್ಣ<br><b>निष्पत्तिः - </b>कदि (आह्वाने रोदने च)- "कुः" (उ० १-३७)<br><br>कद्रु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರ ವರ್ಣ<br><br>कद्रु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂಬಣ್ಣದ<br><br>कद्रु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರವರ್ಣದ<br><br>

कद्रुण
कद्रुण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂಬಣ್ಣವುಳ್ಳ /ಹಳದಿಬಣ್ಣವುಳ್ಳ<br><b>निष्पत्तिः - </b>"नः" (५-२-१००)<br><b>व्युत्पत्तिः - </b>कदुरस्त्यस्य<br><br>

कद्रू
कद्रू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷಬ್ರಹ್ಮನ ಮಗಳು /ಕಶ್ಯಪನ ಪತ್ನಿ /ನಾಗಮಾತೆ /ಸರ್ಪಗಳ ತಾಯಿ<br><b>निष्पत्तिः - </b>कद्रु - "ऊङ्" (४-१-७२)<br><b>प्रयोगाः - </b>"कद्रूश्च मनुजव्याघ्र दक्षकन्यैव भारत" । "शेषोऽनन्तो वासुकिश्च तक्षकश्च भुजङ्गमः । कूर्मश्च कुलिकश्चैव काद्रवेयाः प्रकीर्तिताः ॥"<br><b>उल्लेखाः - </b>भा० आदि० ६६-१३,४१<br><br>

कद्रूपुत्र
कद्रूपुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪಗಳು /ಕದ್ರುವಿನ ಮಕ್ಕಳು<br><br>

कद्रूसुत
कद्रूसुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪಗಳು /ಕದ್ರುವಿನ ಮಕ್ಕಳು<br><br>

कद्वद
कद्वद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದ್ಯವಾದ ಮಾತುಗಳನ್ನಾಡುವವನು /ಕೆಟ್ಟ ಮಾತುಗಳನ್ನಾಡುವವನು<br><b>निष्पत्तिः - </b>कोः कत् ( ६-३-१०१)<br><b>व्युत्पत्तिः - </b>कुत्सितं वदति<br><b>प्रयोगाः - </b>"येन जातं प्रियापाये कद्वदं हंसकोकिलम्"<br><b>उल्लेखाः - </b>भट्टि० ६-७५<br><b>विस्तारः - </b>"गर्ह्यवादी तु कद्वदः" - अम० ।<br><br>

कनक
कनक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುತ್ತುಗದ ಗಿಡ<br><b>निष्पत्तिः - </b>कनी (दीप्तिकान्तिगतिषु) - "वुन्" (उ० ५-३५)<br><b>व्युत्पत्तिः - </b>कनति<br><br>कनक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಕುಳ ವೃಕ್ಷ /ಪವಳದ ಗಿಡ<br><br>कनक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದತ್ತೂರಿ ಗಿಡ<br><br>कनक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಪಿಗೆ ಮರ<br><br>कनक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸುಗಂಧದ್ರವ್ಯ<br><br>कनक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಗಾಂಚಾಳ ಗಿಡ<br><br>कनक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುವರ್ಣ /ಚಿನ್ನ<br><b>प्रयोगाः - </b>"वरणः कनकस्य मानिनीं दिवमङ्गादमराद्रिरागताम्"<br><b>उल्लेखाः - </b>नैष० २-८६<br><b>विस्तारः - </b>"कनकं हेम्नि पुंसि स्यात् किंशुके नागकेसरे । धत्तूरे काञ्चनारे च कालीये चम्पकेऽपि च" - मेदि० ।<br><br>

कनककार
कनककार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿನ್ನದ ಕೆಲಸ ಮಾಡುವವನು /ಅಕ್ಕಸಾಲಿಗ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "अण् (३-२-१)<br><b>व्युत्पत्तिः - </b>कनकं करोति<br><br>

कनकक्षार
कनकक्षार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಟಂಕಣ /ಬಿಳಿಗಾರ<br><b>व्युत्पत्तिः - </b>कनकस्य द्रावणाय सारः<br><br>

कनकदण्ड
कनकदण्ड<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನ ಛತ್ರಿ<br><b>व्युत्पत्तिः - </b>कनकस्य दण्डोऽस्य<br><br>

कनकध्वज
कनकध्वज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧೃತರಾಷ್ಟ್ರನ ಒಬ್ಬ ಮಗ<br><b>प्रयोगाः - </b>"दीर्घबाहुर्महाबाहुर्व्यूढोराः कनकध्वजः"<br><b>उल्लेखाः - </b>भा० आदि० १३१-१४<br><br>

कनकपत्र
कनकपत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪತ್ರಾಕಾರದ ಒಂದು ಚಿನ್ನದ ಕರ್ಣಾಭರಣ /ಚಿನ್ನದ ಲೋಲಾಕು<br><b>व्युत्पत्तिः - </b>कनकनिर्मितं पत्रम्<br><br>

कनकमय
कनकमय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುವರ್ಣಮಯವದ /ಚಿನ್ನದಿಂದ ನಿರ್ಮಿತವಾದ<br><b>निष्पत्तिः - </b>"मयट्" (४-३-१४३)<br><b>व्युत्पत्तिः - </b>कनकस्य विकारः<br><b>प्रयोगाः - </b>"वात्याभिर्वियति विवर्तिनः समन्तादाधत्ते कनकमयातपत्रलक्ष्मीम्"<br><b>उल्लेखाः - </b>किरा० ५-३९<br><br>

कनकसूत्र
कनकसूत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿನ್ನದ ತಂತಿ<br><b>व्युत्पत्तिः - </b>कनकनिर्मितं सूत्रम्<br><br>कनकसूत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿನ್ನದ ಉಡುದಾರ /ಚಿನ್ನದ ಸರ<br><b>प्रयोगाः - </b>"काक्या कनकसूत्रेण कृष्णसर्पो निपातितः"<br><b>उल्लेखाः - </b>हितो० २-१२०<br><br>

कनकाचल
कनकाचल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಮೇರು ಪರ್ವತ /ಹೇಮಾದ್ರಿ /ಚಿನ್ನದ ಬೆಟ್ಟ<br><b>व्युत्पत्तिः - </b>कनकमयोऽचलः<br><br>कनकाचल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಾನವಾಗಿ ಕೊಡಲ್ಪಡುವ ಪರ್ವತಾಕಾರದ ದ್ರವ್ಯ /ದಾನವಾಗಿ ಕೊಡಲ್ಪಡುವ ೧೦ ಪರ್ವತಗಳಲ್ಲಿ ಒಂದು<br><br>

कनकाध्यक्ष
कनकाध्यक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುವರ್ಣದ ರಕ್ಷಣಾಧಿಕಾರಿ /ಖಜಾನೆಯ ಅಧಿಕಾರಿ<br><br>

कनकायु
कनकायु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧೃತರಾಷ್ಟ್ರನ ಒಬ್ಬ ಮಗ<br><b>प्रयोगाः - </b>"उग्रायुधो भीमशरः कनकायुर्दृढायुधः"<br><b>उल्लेखाः - </b>भा० आदि० ६८-९९<br><br>

कनकाकुला
कनकाकुला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿನ್ನದ ಪಾತ್ರೆ /ಚಿನ್ನದ ಗಿಂಡಿ /ಸುವರ್ಣದ ಕಲಶ<br><b>निष्पत्तिः - </b>सञ्ज्ञायां "कन्"<br><b>व्युत्पत्तिः - </b>कनकस्यालुः<br><br>

कनकाह्व
कनकाह्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದತ್ತೂರಿ ಗಿಡ<br><b>व्युत्पत्तिः - </b>कनकं आह्व यस्य<br><br>

कनकाह्वय
कनकाह्वय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದತ್ತೂರಿ ಗಿಡ<br><b>व्युत्पत्तिः - </b>कनकं आह्वयो यस्य<br><br>

कनत्
कनत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಳೆಯುತ್ತಿರುವ /ಪ್ರಕಾಶಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कनी (दीप्तिकान्तिगतिषु) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"यूथैर्द्विरदशैलानां कनत्कदलिकावनैः"<br><b>उल्लेखाः - </b>याद० २२-२२८<br><br>

कनिष्ठ
कनिष्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿರಿಯವನು /ಕೊನೆಯ ತಮ್ಮ<br><br>कनिष्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊನೆಯದು /ಕಿರಿಯದು /ಎಲ್ಲಕ್ಕಿಂತಲೂ ಚಿಕ್ಕದಾದ<br><br>कनिष्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲ್ಪವಾದ /ಬಹಳ ಕೊಂಚವಾದ<br><b>निष्पत्तिः - </b>"इष्ठन्" (५-३-५५)<br><b>व्युत्पत्तिः - </b>अयमतिशयेन युवा अल्पो वा<br><br>

कनिष्ठा
कनिष्ठा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಿಯವಳು /ತಂಗಿ<br><br>कनिष्ठा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಿಯ ಹೆಂಡತಿ<br><b>प्रयोगाः - </b>"पुत्रः कनिष्ठो ज्येष्ठायां कनिष्ठायां च पूर्वजः । कयं तत्र विभागः स्यादिति चेत् संशयो भवेत् ॥"<br><b>उल्लेखाः - </b>मनु० ९१२२<br><br>कनिष्ठा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರುಬೆರಳು<br><br>कनिष्ठा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಂಗಿ<br><br>कनिष्ठा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಿಯ ಹೆಂಡತಿ<br><br>कनिष्ठा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕನಿಷ್ಠನಾಯಿಕೆ<br><br>

कनिष्ठिका
कनिष्ठिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕನಿಷ್ಠನಾಯಿಕೆ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्" (५-३-७५)<br><b>प्रयोगाः - </b>"पुरा कवीनां गणनाप्रसङ्गे कनिष्ठिकाधिष्ठितकालिदासा"<br><br>

कनी
कनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಗಳು<br><br>कनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ಯೆ /ಹೆಣ್ಣು ಮಗಳು<br><b>निष्पत्तिः - </b>कनी (दीप्तिकान्तिगतिषु) - "अच्" (३-१-१३४)<br><b>विस्तारः - </b>"कन्या कनी कुमारी च" - अभि० चि० ।<br><br>

कनीनिका
कनीनिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣಿನ ಕಪ್ಪು ಗುಡ್ಡು<br><b>निष्पत्तिः - </b>कनी (दीप्तौ) - "ईनः" बाहु० । स्वार्थे "कन्" । "टाप्"<br><b>व्युत्पत्तिः - </b>कनति प्रकाशयति<br><br>कनीनिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರುಬೆರಳು<br><b>विस्तारः - </b>"अनामिका तु सावित्री कनिष्ठा तु कनीनिका" - वैज० । "कनीनिका तारकोऽष्णः स्यात्कनिष्ठाङ्गुलावपि" - मेदि० ।<br><br>

कनीयस्
कनीयस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಬ್ಬರಲ್ಲಿ ಕಿರಿಯವನು /ತಮ್ಮ<br><br>कनीयस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕ /ಕಿರಿಯ<br><br>कनीयस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲ್ಪವಾದ /ಕೊಂಚವಾದ<br><b>निष्पत्तिः - </b>"ईयसुन्" (५-३-५९)<br><b>व्युत्पत्तिः - </b>अयमनयोरतिशयेन युवा अल्पो वा<br><b>प्रयोगाः - </b>"वृद्धौरसां राज्यधुरां प्रवोढुं कथं कनीयानहमुत्सहेय"<br><b>उल्लेखाः - </b>भट्टि० ३-५४<br><br>

कनीयसी
कनीयसी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕವಳು /ಕಿರಿಯವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कन्त
कन्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಖವುಳ್ಳ<br><b>निष्पत्तिः - </b>कम् - "तः" (५-२-३८)<br><b>व्युत्पत्तिः - </b>कम् सुखमस्त्यस्य<br><br>

कन्ति
कन्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಖವುಳ್ಳ<br><b>निष्पत्तिः - </b>कमु - "तिः" (५-२-१३८)<br><b>व्युत्पत्तिः - </b>कम् सुखमस्त्यस्य<br><br>

कन्तु
कन्तु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂದರ್ಪ /ಕಾಮ /ಮನ್ಮಥ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) - "तुः" (उ० १-७२)<br><br>कन्तु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ತ /ಮನಸ್ಸು<br><b>विस्तारः - </b>"कन्तुः कन्दर्पचित्तयोः" - सि० कौ० ।<br><br>कन्तु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಗ್ರಾಣ /ಕಣಜ<br><b>विस्तारः - </b>"कन्तू कुसूककन्दर्पौ" - वैज० ।<br><br>कन्तु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಖವುಳ್ಳ<br><b>निष्पत्तिः - </b>कमु - "तिः" (५-२-१३८)<br><b>व्युत्पत्तिः - </b>कम् सुखमस्त्यस्य<br><br>

कन्तुजनक
कन्तुजनक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸುದೇವ /ಶ್ರೀಕೃಷ್ಣ<br><b>व्युत्पत्तिः - </b>कन्तोः कामस्य जनकः<br><br>

कन्था
कन्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಛಿಂದಿಬಟ್ಟೆ /ಹರಕು ಬಟ್ಟೆ /ತೇಪೆ ಹಾಕಿದ ಬಟ್ಟೆ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) - "थन्" बाहु० ।<br><b>प्रयोगाः - </b>"भिक्षा प्राणस्य रक्षार्थं कन्ता शीतनिवारिणी । अचला केशवे भक्तिः विभवैः किं प्रयोजनम् ॥"<br><br>कन्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಣ್ಣಿನ ಗೋಡೆ<br><b>विस्तारः - </b>"कन्था मृण्मयभित्तौ च तथा प्रावरणान्तरे" - मेदि० ।<br><br>

कन्द
कन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कं जलं ददाति<br><br>कन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರಣ ಗೆಡ್ಡೆ<br><br>कन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೆಣಸು<br><br>कन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಳ್ಳುಳ್ಳಿ<br><br>कन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೆಡ್ಡೆ /ಗಿಡಗಳ ಬುಡದ ದಪ್ಪ ಬೇರು<br><b>निष्पत्तिः - </b>कदि (आह्वाने रोदने च)- "अच्" (३-१-१३४) । "घञ्" (३-३-१९) वा ।<br><b>व्युत्पत्तिः - </b>कन्दति कन्दयति कन्द्यते वा<br><b>प्रयोगाः - </b>"दन्ताः शोभामापुरम्भोनिधीनां कन्दोद्भेदा वैद्रुमा वारिणीव"<br><b>उल्लेखाः - </b>माघ० १८-३६<br><b>विस्तारः - </b>"कन्दोऽस्त्री सूरणे सस्यमूले जलधरे पुमान्" - मेदि० ।<br><br>

कन्दगुडूची
कन्दगुडूची<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮೃತಬಳ್ಳಿ<br><b>व्युत्पत्तिः - </b>कन्दोद्भवा गुडूची<br><br>

कन्दमूल
कन्दमूल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಲಂಗಿ<br><br>कन्दमूल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೆಣಸು<br><b>व्युत्पत्तिः - </b>कन्दरूपं मूलमस्य<br><br>

कन्दर
कन्दर<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಹೆ /ಗವಿ /ಬೆಟ್ಟದ ಬಿಲ<br><b>निष्पत्तिः - </b>दृ (विदारणे)- "अप्" (३-३-५७)<br><b>व्युत्पत्तिः - </b>केन जलेन दीर्यते<br><b>प्रयोगाः - </b>"निह्रादस्ते मुरज इव चेत्कन्दरेषु ध्वनिः स्यात्"<br><b>उल्लेखाः - </b>मेघ० १-५६<br><b>विस्तारः - </b>"दरी तु कन्दरी वा स्त्री" - मेदि० ।<br><br>कन्दर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಕುಶ<br><b>निष्पत्तिः - </b>"अप्" (३-३-५७)<br><b>व्युत्पत्तिः - </b>कं गजशिरे दीर्यतेऽनेन<br><b>विस्तारः - </b>"कन्दरस्त्वङ्कुशे पुंसि गुहायां च नपुंसकम्" - मेदि० ।<br><br>कन्दर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಸಿಶುಂಠಿ<br><br>कन्दर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಳಕೆ<br><br>

कन्दराल
कन्दराल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಸುರಿ ಗಿಡ<br><b>निष्पत्तिः - </b>ला (आदाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कन्दरां लाति<br><br>कन्दराल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಟ್ಟಗೋನು ಮರ<br><br>

कन्दर्प
कन्दर्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ /ಮನ್ಮಥ<br><b>निष्पत्तिः - </b>दृप (हर्षमोहनयोः) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कम् इति मान्तमव्ययम् (कम् शिरःसुखवारिषु - विश्व०) कम् सुखं तेन दृप्यति<br><b>प्रयोगाः - </b>"तत्र निश्चित्य कन्दर्पमगमत्पाकशासनः" । "कन्दर्पप्रवणमनाः सखीसिसिक्षालक्ष्येण प्रतियुवमञ्जलिं चकार" ।<br><b>उल्लेखाः - </b>कुमा० २-६३, माघ० ८-३५<br><br>

कन्दर्पकूप
कन्दर्पकूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸರ ಗುಹ್ಯಸ್ಥಳ /ಸ್ತ್ರೀಯರ ಚಿಹ್ನೆ /ಯೋನಿ<br><b>व्युत्पत्तिः - </b>कन्दर्पस्य कूप इव<br><br>

कन्दर्पकेतु
कन्दर्पकेतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಜಕುಮಾರ<br><br>

कन्दर्पमथन
कन्दर्पमथन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾದೇವ /ಈಶ್ವರ /ಶಿವ<br><b>निष्पत्तिः - </b>मन्थ (विलोडने) - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कन्दर्पं मथ्नाति<br><br>

कन्दल
कन्दल<br><br><b>पदविभागः - </b>त्रिलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಾಲ /ತಲೆಯ ಚಿಪ್ಪಿನ ಎಲುಬು<br><br>कन्दल<br><br><b>पदविभागः - </b>त्रिलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪರಾಗ /ಉತ್ಪಾತ ಮೊದಲಾದ ಕುಲಕ್ಷಣ<br><br>कन्दल<br><br><b>पदविभागः - </b>त्रिलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಸ ಚಿಗುರು /ಆಗತಾನೆ ಹೊರಟಿರುವ ಮೊಳಕೆ<br><br>कन्दल<br><br><b>पदविभागः - </b>त्रिलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲರವ /ಇಂಪಾದ ಧ್ವನಿ<br><b>निष्पत्तिः - </b>कदि (आह्वाने) - "कलः" (उ० १-१-०६)<br><b>विस्तारः - </b>"कन्दलं त्रिषु कपालेऽप्युपरागे नवाङ्कुरे । कलध्वनौ" - मेदि० ।<br><br>कन्दल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪವಾದ /ನಿಂದೆ /ದೂಷಣೆ<br><br>कन्दल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲಾಪ /ಸಮೂಹ<br><br>कन्दल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಗಳ /ವಾಗ್ಯುದ್ಧ<br><br>

कन्दली
कन्दली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ ಚರ್ಮವುಳ್ಳ ಜಿಂಕೆ<br><b>निष्पत्तिः - </b>लीङ् (श्लेषणे) - "डः" (वा० ३-२-१०१)<br><b>व्युत्पत्तिः - </b>कन्दे सस्यमूले लीयते<br><br>कन्दली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಳೆಯ ಗಿಡ<br><b>निष्पत्तिः - </b>दल (विदारणे) - "घः" (३-३-१२४)<br><b>व्युत्पत्तिः - </b>केन वायुना दल्यते<br><b>प्रयोगाः - </b>"आरक्तराजिभिरयं कुसुमैर्नवकन्दलीगर्भैः"<br><b>उल्लेखाः - </b>विक्र० ४-१५<br><br>कन्दली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೊದರು<br><br>कन्दली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪತಾಕೆ /ಧ್ವಜ<br><br>कन्दली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಣಬೆ /ನಾಯಿಕೊಡೆ<br><br>कन्दली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಾವರೆಯ ಬೀಜ<br><br>कन्दली<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಳೆಯ ಹೂವು<br><b>प्रयोगाः - </b>"द्विदलकन्दलकम्पनलालितः"<br><b>उल्लेखाः - </b>माघ० ६-३०<br><br>

कन्दलित
कन्दलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಗುರಿದ /ಮೊಳಕೆ ಹೊರಟಿರುವ<br><br>कन्दलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೃದ್ಧಿ ಹೊಂದಿದ /ಹೆಚ್ಚಾಗಿರುವ /ಬೆಳೆದಿರುವ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>कन्दलः सञ्जातोऽस्य<br><br>

कन्दु
कन्दु<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾವಲಿ /ದೋಸೆಯ ಕಲ್ಲು /ಹೋಳಿಗೆಯ ಕಾವಲಿ<br><b>निष्पत्तिः - </b>स्कन्दिर् (गतिशोषणयोः) - "उः" सलोपश्च (उ० १-१४)<br><b>व्युत्पत्तिः - </b>स्कन्दिति<br><b>विस्तारः - </b>"कन्दुर्वा स्वेदनी स्त्रियाम्" - अम० ।<br><br>कन्दु<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುರಿಯುವ ಓಡು /ಬಾಣಲಿ<br><br>

कन्दुक
कन्दुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಬ್ಬರು ಬಟ್ಟೆ ಮೊದಲಾದುವುಗಳಿಂದನಿರ್ಮಿತವಾದ ಚೆಂಡು<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "डुः" (वा० ३-२-१८०) । स्वार्थे "कन्" (५-४-५)<br><b>व्युत्पत्तिः - </b>कम् सुखं ददाति<br><b>प्रयोगाः - </b>"मन्दाकिनीसैकतवेदिकाभिः सा कन्दुकैः कृत्रिमपुत्रिकैश्च"<br><b>उल्लेखाः - </b>कुमा० १-२९<br><br>कन्दुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾವಲಿ /ದೋಸೆಯ ಕಲ್ಲು /ಹೋಳಿಗೆಯ ಕಾವಲಿ<br><br>

कन्दोट
कन्दोट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ನೈದಿಲೆ<br><br>कन्दोट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿ ನೈದಿಲೆ<br><b>निष्पत्तिः - </b>कदि (आह्वाने) - "ओटः" बाहु० ।<br><br>

कन्ध
कन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><br>कन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನ್ನಾರಿ ಗೆಡ್ಡೆ /ಭದ್ರಮುಸ್ತೆ<br><b>निष्पत्तिः - </b>डुधाञ् (धारणपोषणयोः) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कं जलम् ददाति<br><br>

कन्धर
कन्धर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><b>निष्पत्तिः - </b>धृ (धारणे) + णिच् - "खच्" (३-२-४६) । मुमागमः (६-३-६७) । ह्रस्वः (६-४-९४)<br><b>व्युत्पत्तिः - </b>कं जलं धारयति<br><br>

कन्धरा
कन्धरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುತ್ತಿಗೆ /ಕತ್ತು<br><b>निष्पत्तिः - </b>धृ (धारणे) + णिच् - "खच्" (३-२-४६) । मुमागमः (६-३-६७) । ह्रस्वः (६-४-९४)<br><b>व्युत्पत्तिः - </b>कं शिरो धारयति<br><b>प्रयोगाः - </b>"अथोच्चकैर्जरठकपोतकन्दरातनूरुहप्रकरविपाण्डुरद्युति" । "कपाटवक्षाः परिणद्धकन्दरः" ।<br><b>उल्लेखाः - </b>माघ० १७-५२, रघु० ३-३४<br><b>विस्तारः - </b>"कन्धरो वारिवाहे स्याद्ग्रीवायां कन्धरा मता" - मेदि०।<br><br>

कन्धि
कन्धि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ /ಕಡಲು<br><br>कन्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುತ್ತಿಗೆ /ಕತ್ತು<br><b>निष्पत्तिः - </b>डुधाञ् (धारणपोषणयोः) - "किः" (३-३-९३)<br><b>व्युत्पत्तिः - </b>कं जलं शिरो वा धीयतेऽत्र<br><br>

कन्न
कन्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾತಕ /ಪಾಪ<br><br>कन्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂರ್ಚ್ಛೆ<br><br>कन्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಋಷಿ<br><br>

कन्यका
कन्यका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ಯೆ /ಕುಮಾರಿ /ಹತ್ತು ವರ್ಷ ವಯಸ್ಸಿನ ಹುಡುಗಿ /ಮದುವೆಯಾಗದಿರುವ ಬಾಲೆ<br><b>निष्पत्तिः - </b>"कः" (५-३-७३)<br><b>व्युत्पत्तिः - </b>अज्ञाता कन्या<br><b>प्रयोगाः - </b>"कन्यकातनयकौतुकक्रियां स्वप्रभावसदृशीं वितेनतुः"<br><b>उल्लेखाः - </b>रघु० ११-५३<br><b>विस्तारः - </b>"अष्टवर्षा भवेद्गौरी नववर्षा च रोहिणी । दशमे कन्यका प्रोक्ता अत ऊर्ध्वं रजस्वला ॥"<br><br>

कन्यकाजात
कन्यकाजात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾನೀನ /ಮದುವೆಯಾಗದ ಕನ್ಯೆಯಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><b>व्युत्पत्तिः - </b>कन्यकायां जातः<br><br>

कन्या
कन्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ಯೆ /ಕುಮಾರಿ /ಹತ್ತು ವರ್ಷ ವಯಸ್ಸಿನ ಹುಡುಗಿ /ಮದುವೆಯಾಗದಿರುವ ಬಾಲೆ<br><br>कन्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ಯೆ /ಮದುವೆಯಾಗದಿರುವ ಮಗಳು<br><b>निष्पत्तिः - </b>कनी (दीप्तौ) - "यक्" (उ० ४-१११)<br><b>व्युत्पत्तिः - </b>कनति<br><b>प्रयोगाः - </b>"आच्छाद्य चार्चयित्वा च श्रुतिशीलवते स्वयम् । आहूय दानं कन्याया ब्राह्मो धर्मः प्रकीर्तितः ॥" "सर्वान् कामयते यस्मात् कनोर्धातोश्च भामिनि । तस्मात् कन्येह सुश्रोणी स्वतन्त्रा वरवर्णिनि ॥"<br><b>उल्लेखाः - </b>मनु० ३-२७, भा० वन० ३०८-१३<br><b>विस्तारः - </b>अकृतोपयमा कन्या"<br><br>कन्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ಯಾರಾಶಿ<br><br>कन्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸು<br><b>प्रयोगाः - </b>"अचाकिरन् बाललताः प्रसूनैराचारलाजैरिव पौरकन्याः" । "अहल्या द्रौपदी सीता तारा मण्डोदरी तथा । पञ्चकन्याः स्मरेत् नित्यं महापातकनाशनम् ॥"<br><b>उल्लेखाः - </b>रघु० २-१०<br><br>

कन्याकुब्ज
कन्याकुब्ज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ಯಾಕುಬ್ಜ<br><br>

कन्याग्रहण
कन्याग्रहण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ಯಾಸ್ವೀಕಾರ /ವಿವಾಹದಲ್ಲಿ ಕನ್ಯೆಯನ್ನು ಸ್ವೀಕರಿಸುವುದು<br><b>व्युत्पत्तिः - </b>कन्यायाः ग्रहणम्<br><br>

कन्यातीर्थ
कन्यातीर्थ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುಕ್ಷೇತ್ರದಲ್ಲಿರುವ ಒಂದು ಪುಣ್ಯತೀರ್ಥ<br><br>कन्यातीर्थ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ ಮತ್ತು ಕಾವೇರಿ ಸಂಗಮಸ್ಥಳಕ್ಕೆ ಸಮೀಪದಲ್ಲಿರುವ ಒಂದು ತೀರ್ಥ<br><b>विस्तारः - </b>अप्सरोरूपकन्यावृतत्वेन तस्य कन्यातीर्थत्वम् ।<br><br>

कन्यादातृ
कन्यादातृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹದಲ್ಲಿ ಕನ್ಯೆಯನ್ನು ದಾನ ಮಾಡುವವನು /ತಂದೆ<br><br>

कन्यादान
कन्यादान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹದಲ್ಲಿ ಶಾಸ್ತ್ರೋಕ್ತವಾಗಿ ಧಾರೆಯೆರೆದು ಕನ್ಯೆಯನ್ನು ದಾನಮಾಡುವುದು<br><b>व्युत्पत्तिः - </b>कन्यायाः दानम्<br><b>प्रयोगाः - </b>"अद्भिरेव द्विजाग्र्याणां कन्यादानं विशिष्यते । इतरेषां तु वर्णानामितरेतरकाम्यया ॥"<br><b>उल्लेखाः - </b>मनु० ३-३५<br><br>

कन्यादूषक
कन्यादूषक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕನ್ಯೆಯನ್ನು ಕೆಡಿಸುವವನು /ವಿವಾಹವಾಗದ ಕನ್ಯೆಯಲ್ಲಿ ಅತ್ಯಾಚಾರ ನಡೆಸುವವನು<br><b>व्युत्पत्तिः - </b>कन्याया दूषकः<br><br>कन्यादूषक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕನ್ಯೆಯನ್ನು ನಿಂದಿಸುವವನು<br><b>निष्पत्तिः - </b>दूष (वैकृत्ये)+ णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कन्यां दूषयति<br><b>प्रयोगाः - </b>"श्वक्रीडी श्येनजीवी च कन्यादूषक एव च । हिंस्रो वृषलवृत्तिश्च गणानां चैव याजकः ॥"<br><b>उल्लेखाः - </b>मनु० ३-१३४<br><br>

कन्यादूषण
कन्यादूषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ಯೆಯನ್ನು ಕೆಡಿಸುವಿಕೆ /ಕನ್ಯೆಯಲ್ಲಿ ಅತ್ಯಾಚಾರ ನಡೆಸುವಿಕೆ<br><b>व्युत्पत्तिः - </b>कन्यायाः दूषणम्<br><br>कन्यादूषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ಯೆಯನ್ನು ನಿಂದಿಸುವಿಕೆ<br><br>

कन्यादूषयितृ
कन्यादूषयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>कन्यादूषक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>दूष (वैकृत्ये)+ णिच् - "तृच्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कन्यायाः दूषयिता<br><br>

कन्यादूषिन्
कन्यादूषिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>कन्यादूषक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>दूष (वैकृत्ये)+ णिच् - "णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"भर्तृकाध्यापकः क्लीबः कन्यादूष्यभिशस्तकः । मित्रध्रुक् पिशुनः सोमविक्रयी परिविन्दकः ॥"<br><b>उल्लेखाः - </b>याज्ञ० १-२२३<br><br>

कन्याधन
कन्याधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತ್ರೀಧನ /ವಿವಾಹಕ್ಕೆ ಮುಂಚೆ ಕನ್ಯೆಗೆ ಕೊಟ್ಟಿದ್ದ ಧನ<br><b>व्युत्पत्तिः - </b>कन्यया लब्धं धनम्<br><br>

कन्यानिरीक्षण
कन्यानिरीक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹಕಾಲದಲ್ಲಿ ನಿಶ್ಚಿತಾರ್ಥ ಮಧುಪರ್ಕಗಳ ನಂತರ ಶುಭಲಗ್ನದಲ್ಲಿ ವರನು ಕನ್ಯೆಯನ್ನು ನೋಡುವಿಕೆ<br><br>

कन्यापति
कन्यापति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಳಿಯ /ಮಗಳ ಗಂಡ<br><b>व्युत्पत्तिः - </b>कन्यायाः पतिः<br><br>

कन्यापुत्र
कन्यापुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹವಾಗದ ಕನ್ಯೆಯಲ್ಲಿ ಹುಟ್ಟಿದ ಮಗ<br><b>व्युत्पत्तिः - </b>कन्यायाः पुत्रः<br><br>

कन्याभर्तृ
कन्याभर्तृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಳಿಯ /ಮಗಳ ಗಂಡ<br><b>व्युत्पत्तिः - </b>कन्याया भर्ता<br><br>कन्याभर्तृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಷಣ್ಮುಖ /ಕಾರ್ತಿಕೇಯ<br><b>व्युत्पत्तिः - </b>कन्याभिः प्रार्थनीयो भर्ता<br><b>प्रयोगाः - </b>"आग्नेयश्चैव स्कन्दश्च --------- । कन्याभर्ता विभक्तश्च स्वाहेयो रेवतोसुतः ।"<br><b>उल्लेखाः - </b>भा० वन० २३३<br><br>

कन्यारत्न
कन्यारत्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತಮ ತರಗತಿಗೆ ಸೇರಿದ ಕನ್ಯೆ /ಶ್ರೇಷ್ಠಳಾದ ಕನ್ಯೆ<br><b>व्युत्पत्तिः - </b>कन्यासु रत्नम्<br><br>

कन्याराशि
कन्याराशि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಷ ಮೊದಲಾದ ೧೨ ರಾಶಿಗಳಲ್ಲಿ ೬ನೆಯದು<br><br>

कन्यार्थिन्
कन्यार्थिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮದುವೆಯಾಗಿ ಕನ್ಯೆಯನ್ನು ಅಪೇಕ್ಷಿಸುವವನು<br><b>निष्पत्तिः - </b>अर्थ (उपयाञ्चायाम्) + णिच् - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कन्यामर्थयते<br><br>

कन्यावत्
कन्यावत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಮಕ್ಕಳುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४) । मस्य वः (८-२-९)<br><b>व्युत्पत्तिः - </b>कन्या अस्य सन्ति<br><br>

कन्यावरण
कन्यावरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವರನ ಕಡೆಯ ಹಿರಿಯರು ಗೋತ್ರಪ್ರವಗಳ ಉಚ್ಚಾರಣಪೂರ್ವಕ ಕನ್ಯೆಯನ್ನುಚುನಾಯಿಸುವಿಕೆ<br><b>व्युत्पत्तिः - </b>कन्याया वरणम्<br><br>

कन्यावेदिन्
कन्यावेदिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ಯೆಯನ್ನು ಪಡೆಯುವವನು<br><b>निष्पत्तिः - </b>विद्लृ (लाभे) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कन्यां विन्दते<br><b>प्रयोगाः - </b>"कन्यां कन्यावेदिनश्च पशून् वै सत्सुतानपि"<br><b>उल्लेखाः - </b>याज्ञ० १-२६२<br><br>

कन्याशुल्क
कन्याशुल्क<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮದೆವೆಯಾಗಿ ಕನ್ಯೆಯನ್ನು ಕೊಳ್ಳಲು ಕನ್ಯೆಯ ತಂದೆಗೆ ಕೊಡುವ ಧನ /ವಿವಾಹ ಧನ<br><br>

कन्यास्वयंवर
कन्यास्वयंवर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ಯೆಯು ತನ್ನಿಚ್ಛೆಯಂತೆ ಪತಿಯನ್ನು ವರಿಸುವಿಕೆ /ಕನ್ಯೆಯು ತನಗೆ ಇಷ್ಟನಾದ ಪತಿಯನ್ನು ಆರಿಸಿಕೊಳ್ಳುವಿಕೆ<br><br>

कन्याहरण
कन्याहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ಯೆಯನ್ನು ಬಲಾತ್ಕಾರದಿಂದ ಒಯ್ಯುವಿಕೆ<br><b>व्युत्पत्तिः - </b>कन्यायाः हरणम्<br><br>

कप
कप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರುಣ<br><br>कप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>कप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರು ಕುಡಿಯುವವನು<br><b>निष्पत्तिः - </b>पा (रक्षणे पाने वा) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कं जलं पाति पिबति वा<br><br>कप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸುರರ ಒಂದು ಗುಂಪು<br><br>

कपट
कपट<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಂಚನೆ /ಮೋಸ /ಠಕ್ಕು<br><b>व्युत्पत्तिः - </b>के मूर्ध्नि पट इवाच्छादकः<br><b>प्रयोगाः - </b>"विधाय मूर्तिं कपटेन वामनीं स्वयं बलिद्वंसिविडम्बिनीमयम्"<br><b>उल्लेखाः - </b>नैष० १-१२४<br><br>कपट<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಜ /ನೆಪ<br><b>प्रयोगाः - </b>"किमस्य लोम्नां कपटेन कोटिभिर्विधिर्न लेखाभिरजीगणद्गुणान्"<br><b>उल्लेखाः - </b>नैष० १-२१<br><br>कपट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಶ್ಯಪನ ಪತ್ನಿಯಾದ ದನುವಿನ ಮಗ ಒಬ್ಬ ರಾಕ್ಷಸ<br><br>

कपटतापस
कपटतापस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇಶಷಧಾರಿ ಸಂನ್ಯಾಸಿ /ತಾಪಸನಂತೆ ವೇಷ ಹಾಕಿ ನಟಿಸುವವನು<br><b>व्युत्पत्तिः - </b>कपटेन तापसः<br><br>

कपतलेख्य
कपतलेख्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತ್ರಿಮವಾದ ಕಾಗದ /ಮೋಸದ ದಸ್ತೈವೇಜು /ಅಸಲಿನಂತೆಯೇ ಕಾಣುವ ಹಾಗೆ ತಯಾರಿಸಲ್ಪಟ್ಟ ಸುಳ್ಳುಪತ್ರ<br><br>

कपतवेष
कपतवेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಸಕ್ಕಾಗಿ ಧರಿಸಲ್ಪಟ್ಟ ವೇಷ /ವಂಚಿಸಲು ತಾಳಿದ ವೇಷ<br><br>

कपटवेषधारिन्
कपटवेषधारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೋಸದ ವೇಷವನ್ನು ಧರಿಸಿರುವ /ವಂಚಿಸಲು ಬೇರೆ ವೇಷವನ್ನು ತಾಳಿದ<br><br>

कपर्द
कपर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕವಡೆ<br><br>कपर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರನ ಜಟೆಗಳಸಮೂಹ<br><b>निष्पत्तिः - </b>पर्व (पूरणे) - "क्विप्" (वा० ३-३-१०८) । डुदाञ् (दाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>केन सुखेन परं पूर्ति ददाति<br><b>प्रयोगाः - </b>"कपर्दमुद्बद्धमहीनमूर्धरत्नांशुभिर्भासुरमुल्लसद्भिः"<br><b>उल्लेखाः - </b>कुमा० १२-९<br><b>विस्तारः - </b>"कपर्दः खण्डपरशोर्जटजूटे वराटके" - विश्व० ।<br><br>

कपर्दक
कपर्दक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರನ ಜಟೆಗಳಸಮೂಹ<br><b>निष्पत्तिः - </b>कपर्द - स्वार्थे "कः"<br><br>कपर्दक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಕವಡೆ<br><b>निष्पत्तिः - </b>"कन्" (५-३-८५)<br><b>व्युत्पत्तिः - </b>अल्पः कपर्दः<br><b>प्रयोगाः - </b>"यद्यहमिमं सक्तुशरावं विक्रीय दश कपर्दकान् प्राप्नोमि"<br><b>उल्लेखाः - </b>हितो० ४<br><b>विस्तारः - </b>"कपर्दको वराटे स्यात् जटाजूटे च धूर्जटेः" - मेदि० ।<br><br>

कपर्दिका
कपर्दिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಕವಡೆ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्"<br><br>

कपर्दिन्
कपर्दिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ /ಶಿವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५) ।<br><b>व्युत्पत्तिः - </b>कपर्दोऽस्यास्ति<br><b>प्रयोगाः - </b>"कपर्दिकण्ठान्तकपालदाम्नोऽङ्गुलिः प्रवेश्याननकोटरेषु"<br><b>उल्लेखाः - </b>कुमा० ११-४६<br><br>

कपाट
कपाट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಗಿಲು /ಬಾಗಿಲಿನ ಕದ<br><b>निष्पत्तिः - </b>पट (भोषार्थे) + णिच् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कं वातम् पाटयति<br><b>प्रयोगाः - </b>"कपाटविस्तीर्णमनोरमोरःस्थलस्थितश्रीरमणस्य तस्य"<br><b>उल्लेखाः - </b>माघ० ३-१३<br><br>

कपाटघ्न
कपाटघ्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೋರ /ಕಳ್ಳ /ಬಾಗಿಲನ್ನು ಒಡೆಯುವವನು<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) - "टक्" (३-२-५४)<br><b>व्युत्पत्तिः - </b>कपाटं हन्ति<br><br>

कपाटवक्षस्
कपाटवक्षस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾಗಿಲಿನಂತೆ ವಿಶಾಲ ವಕ್ಷಸ್ಥಳವುಳ್ಳವನು /ಅಗಾದವಾದ ಎದೆಯುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>कपाट इव विशालः वक्षः यस्य<br><b>प्रयोगाः - </b>"युवा युगब्यायतबाहुरंसलः कपाटवक्षाः परिणद्धकन्धरः"<br><b>उल्लेखाः - </b>रघु० ३-३४<br><br>

कपाटसन्धि
कपाटसन्धि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಗಿಲಿನ ಕದಗಳು ಕೂಡುವ ಸ್ಥಳ /ಕದಗಳ ಸೇರಿಕೆಯ ಜಾಗ<br><b>निष्पत्तिः - </b>सम् + धाञ् - अधि० "किः" (३-३-९२)<br><b>व्युत्पत्तिः - </b>कपाटं सन्धीयतेऽत्र<br><br>

कपाटिका
कपाटिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕ ಕದ /ಸಣ್ಣ ಬಾಗಿಲುಗಳ ಕದ<br><b>निष्पत्तिः - </b>"कन्" (५-३-८५)<br><b>व्युत्पत्तिः - </b>अल्पः कपाटः<br><br>

कपाल
कपाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯ ಎಲುಬಿನ ಚಿಪ್ಪು<br><b>निष्पत्तिः - </b>कपि (चलने) - "कालन्" (उ० १-११५)<br><b>प्रयोगाः - </b>"कपालनेत्रान्तरलब्धमार्गैर्ज्योतिःप्ररोहैरुहितैः शिरस्तः"<br><b>उल्लेखाः - </b>कुमा० ३-४९<br><br>कपाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲಶದ ಅವಯವ /ಘಟದ ಅರ್ಧಭಾಗ<br><b>प्रयोगाः - </b>"घटादीनां कपालादौ द्रव्येषु गुणकर्मणोः । तेषु जातेश्च सम्बन्धः समवायः प्रकीर्तितः ॥"<br><b>उल्लेखाः - </b>भाषापा०<br><br>कपाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭಿಕ್ಷುಕರ ಭಿಕ್ಷಾಪಾತ್ರೆ<br><b>प्रयोगाः - </b>"नग्नो मुण्डः कपालेन भिक्षार्थी क्षुत्पिपासितः"<br><b>उल्लेखाः - </b>मनु० ८-९३<br><br>कपाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೂಹ /ಗುಂಪು<br><b>विस्तारः - </b>"कपालोऽस्त्री शिरोऽस्थ्नि स्यात् घटादेः शकले व्रजे" -मेदि० ।<br><br>कपाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಟ್ಟೆಗಳ ಅವಯವ /ತತ್ತಿಗಳ ಒಂದು ಭಾಗ<br><b>प्रयोगाः - </b>"कुक्कुटाण्डकपालानि कनकं मधुकं समम्"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>कपाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುರೋಡಾಶವನ್ನು ಸಂಸ್ಕರಿಸುವ ಯಾಗದ ಒಂದು ಪಾತ್ರೆ<br><b>प्रयोगाः - </b>"कपालानि वोपदधाति पुरोडाशं चादिश्रपयति"<br><b>उल्लेखाः - </b>तै० सं०<br><br>कपाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹುರಿಯುವ ಓಡು<br><b>प्रयोगाः - </b>"कपालभ्रष्टान् सक्तून् कारयित्वा"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

कपालनालिका
कपालनालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚರಕದಲ್ಲಿ ನೂಲನ್ನು ತಿರುಚುವ ಮತ್ತು ಸುತ್ತುವ ಕದಿರು/ನೂಲುವ ಯಂತ್ರದಲ್ಲಿ ದಾರ ಸುತ್ತುವ ಕದಿರುಕಂಬಿ<br><b>विस्तारः - </b>"कपालनालिका तर्कुः" - त्रिकाण्ड० ।<br><br>

कपालभृत्
कपालभृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮಕಪಾಲವನ್ನು ಧರಿಸಿರುವ ಶಿವ /ತಲೆಬುರುಡೆಯನ್ನು ಧರಿಸಿರುವ ಪರಮೇಶ್ವರ<br><b>निष्पत्तिः - </b>डुभृञ् (धारणे) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>कपालं ब्रह्मणः शोरोऽस्थिमयं पात्रं बिभर्ति<br><br>कपालभृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಾಲವನ್ನು ಹಿಡಿದಿರುವ ಭಿಕ್ಷುಕ<br><br>

कपालमालिन्
कपालमालिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಬುರುಡೆಗಳ ಮಾಲೆಯನ್ನು ಧರಿಸಿರುವ ಪರಮೇಶ್ವರ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५) ।<br><b>व्युत्पत्तिः - </b>कपालानां मालास्त्यस्य<br><br>

कपालमालिनी
कपालमालिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ<br><br>

कपालमोचन
कपालमोचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಔಶನಸವೆಂಬ ಒಂದು ಪುಣ್ಯತೀರ್ಥ /ಸಕಲ ಪಾಪಗಳನ್ನೂ ಪರಿಅರಿಸುವ ಒಂದು ತೀರ್ಥ<br><br>

कपालशिरस्
कपालशिरस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ /ಶಿವ<br><b>व्युत्पत्तिः - </b>कपालं शिरसि यस्य<br><br>

कपालिन्
कपालिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಾಲವನ್ನು ಧರಿಸಿರುವ ಈಶ್ವರ /ಶಿವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५) ।<br><b>व्युत्पत्तिः - </b>कपालमस्यास्ति<br><b>प्रयोगाः - </b>"कपालिकोपानलभस्मनः कृते तदेव भस्म स्वकुले स्तृतं तथा"<br><b>उल्लेखाः - </b>नैष० ९-७१<br><br>कपालिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಾಲವುಳ್ಳ /ಕಪಾಲವನ್ನು ಹಿಡಿದಿರುವ<br><b>प्रयोगाः - </b>"कपालि वा स्यादथवेन्दुशेखरं न विश्वमूर्तेरवधार्यते वपुः"<br><b>उल्लेखाः - </b>कुमा० ५-७८<br><br>कपालिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಿಕ್ಷುಕ /ತಿರುಕ<br><br>

कपालिनी
कपालिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५) । "ङीप्" (४-१-५)<br><b>व्युत्पत्तिः - </b>कपालमस्यास्ति<br><br>

कपि
कपि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋತಿ /ವಾನರ<br><b>निष्पत्तिः - </b>कपि (चलने) - "इन्" (उ० ४-१४४)<br><b>व्युत्पत्तिः - </b>कम्पते<br><b>प्रयोगाः - </b>"कपयोऽबिभयुस्तस्मिन्नभञ्जंश्च महाद्रुमान् । प्रोदखायन् गिरिस्तूर्णमगृह्णंश्च महाशिलाः ।"<br><b>उल्लेखाः - </b>भट्टि० १७-५८<br><br>कपि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾರಾಯಣ /ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>पा (रक्षणे) - "इन्" (उ० ४-१४४)<br><b>व्युत्पत्तिः - </b>कम् सुखम्, तदनुभवसुखनिवृतिं पाति<br><b>प्रयोगाः - </b>"कपिलः कपिरव्ययः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>कपिरव्ययः इति सविशेषणमेकं नाम ।<br><br>कपि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಿಲ್ಹಕವೆಂಬ ಗಂಧದ್ರವ್ಯ<br><b>विस्तारः - </b>"कपिर्ना सिह्लके शाखामृगे च मधुसूदने" - मेदि० ।<br><br>कपि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>कपि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಜ /ಆನೆ<br><b>विस्तारः - </b>"कपयोऽर्केभवानराः" - वैज० ।<br><br>कपि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರಾಹ<br><b>निष्पत्तिः - </b>पा (रक्षणे) - "इन्" (उ० ४-१४४)<br><b>व्युत्पत्तिः - </b>कादुदकात् भूमिं पाति<br><br>

कपिकच्छुरा
कपिकच्छुरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಸುಗುನ್ನಿ ಗಿಡ<br><br>

कपिकच्छू
कपिकच्छू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಸುಗುನ್ನಿ ಗಿಡ /ಕಪಿಗಳಿಗೂ ನವೆಯನ್ನುಂಟುಮಾಡುವ ಗಿಡ<br><b>व्युत्पत्तिः - </b>कपीनां कच्छूं यस्याः<br><br>

कपिकेतन
कपिकेतन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಯೇ ಧ್ವಜವಾಗಿ ಉಳ್ಳ ಅರ್ಜುನ<br><b>व्युत्पत्तिः - </b>कपिः केतनं ध्वजो यस्य<br><b>प्रयोगाः - </b>"सान्त्वपूर्वमिदं वाक्यमब्रवीत् कपिकेतनः"<br><b>उल्लेखाः - </b>भा०<br><br>

कपिकेतु
कपिकेतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಯೇ ಧ್ವಜವಾಗಿ ಉಳ್ಳ ಅರ್ಜುನ<br><b>व्युत्पत्तिः - </b>कपिः केतुः ध्वजो यस्य<br><b>प्रयोगाः - </b>"अधिरुह्यतामिति महीभृतोदितः कपिकेतुनार्पितकरो रथं हरिः"<br><b>उल्लेखाः - </b>माघ० १३-१८<br><br>

कपिचूडा
कपिचूडा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮಟೆ ಮರ<br><b>व्युत्पत्तिः - </b>कपीनां चूडेव<br><br>

कपिचूत
कपिचूत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಮಟೆ ಮರ<br><b>व्युत्पत्तिः - </b>कपीनां चूत इव प्रियः<br><br>

कपिञ्जल
कपिञ्जल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಾತಕ ಪಕ್ಷಿ<br><br>कपिञ्जल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿತ್ತಿರಿ ಪಕ್ಷಿ<br><b>विस्तारः - </b>"चित्रपक्षस्तु तित्तिरिः स्यात्कपिञ्जलः" - त्रिकाण्ड०<br><br>

कपित्थ
कपित्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಲದ ಮರ<br><b>निष्पत्तिः - </b>पृषो०<br><b>व्युत्पत्तिः - </b>कपयस्तिष्ठन्त्यत्र<br><br>कपित्थ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಲದ ಹಣ್ಣು<br><b>निष्पत्तिः - </b>"अण्" (४-३-१३४) । तस्य लुक् (४-३-१६३)<br><b>व्युत्पत्तिः - </b>कपित्थस्य फलम्<br><br>

कपित्थक
कपित्थक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಲದ ಮರ<br><br>कपित्थक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಲದ ಹಣ್ಣು<br><br>

कपित्थास्य
कपित्थास्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಲದ ಹಣ್ಣಿನಂತೆ ಮುಖವುಳ್ಳ ಒಂದು ಜಾತಿಯ ಕಪಿ / ಗೋಲಾಂಗೂಲ<br><b>व्युत्पत्तिः - </b>कपित्थवदास्यमस्य<br><b>विस्तारः - </b>"गोलाङ्गूले कपित्थास्यदधिशोणनगाटनाः" - त्रिकाण्ड<br><br>

कपित्थिन्
कपित्थिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇಲದಮರಕ್ಕೆ ಸಮೀಪದಲ್ಲಿರುವ ಪ್ರದೇಶ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कपित्थोऽस्त्यत्र देशे<br><br>

कपित्थिनी
कपित्थिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿತ್ಥವೃಕ್ಷಗಳಿಂದ ಕೂಡಿದ ದೇಶ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५) । "ङीप्" (४-१-५)<br><b>व्युत्पत्तिः - </b>कपित्थोऽस्त्यत्र देशे<br><br>

कपिध्वज
कपिध्वज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಯೇ ಧ್ವಜವಾಗಿ ಉಳ್ಳ ಅರ್ಜುನ<br><b>व्युत्पत्तिः - </b>कपिः ध्वजोऽस्य<br><b>प्रयोगाः - </b>"कपिध्वजस्तस्य विभोरपश्यत्तदर्पितं चक्षुरवाप्य दिव्यम्"<br><b>उल्लेखाः - </b>याद० २३-३३<br><br>

कपिप्रभु
कपिप्रभु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀರಾಮ<br><br>कपिप्रभु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಗಳಿಗೆ ಒಡೆಯನಾದ ಸುಗ್ರೀವ<br><b>व्युत्पत्तिः - </b>कपीनां प्रभुः स्वामी<br><br>

कपिप्रिय
कपिप्रिय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಮಟೆ ಮರ<br><b>व्युत्पत्तिः - </b>कपीनां प्रियः<br><br>कपिप्रिय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿತ್ಥವೃಕ್ಷ /ಬೇಲದ ಮರ<br><br>

कपिरथ
कपिरथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀರಾಮ<br><b>व्युत्पत्तिः - </b>कपिः रथमिव वाहनं अस्य<br><br>कपिरथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಯೇ ರಥದಲ್ಲಿ ಉಳ್ಳ ಅರ್ಜುನ<br><b>व्युत्पत्तिः - </b>कपिः हनूमान् रथेऽस्य<br><br>

कपिल
कपिल<br><br><b>पदविभागः - </b>त्रिलिङ्गः<br><b>कन्नडार्थः - </b>ಗೋರೋಚನದಂತೆ ಕೆಂಪುಬೆರೆತ ಹಳದಿಬಣ್ಣ /ಕಂದುಹಳದಿ ಬಣ್ಣ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) - "इलच्" (उ० १-५५)<br><br>कपिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಯಿ<br><br>कपिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><br>कपिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸುದೇವ /ನಾರಾಯಣ<br><b>प्रयोगाः - </b>"सनात्सनातनतमः कपिलः कपिरव्ययः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>ಮಿಂಚಿನ ಮಧ್ಯದಲ್ಲಿರುವ ನೀಲಮೇಘದಂತೆ ಪ್ರಕಾಶನಮಾನವಾಗಿರುವುದರಿಂದ ಈ ಹೆಸರು. "विद्युन्मण्डलमध्यस्थनीलमेघवदुज्ज्वलः । कपिलः ससमाख्यातः सप्तवर्णो महामनुः" ॥ - निरुक्तिः<br><br>कपिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಂಖ್ಯಶಾಸ್ತ್ರಪ್ರವರ್ತಕರಾದ ಒಬ್ಬ ಋಷಿ /ಪರಮಾತ್ಮನ ೨೪ ಅವತಾರಗಳಲ್ಲಿ ೫ನೆಯ ಅವತಾರ<br><b>प्रयोगाः - </b>"पञ्चमः कपिलो नाम कालविप्लुतम् । प्रोवाचासुरये साङ्ख्यं तत्त्वग्रामविनिर्णयम् ॥"<br><b>उल्लेखाः - </b>भाग० १-३-१०<br><b>विस्तारः - </b>"कपिला रेणुकायां च शिंशपागोविशेषयोः । पुण्डरीककरिण्यां स्त्री वर्णभेदे त्रिलिङ्गकम् । नानले वासुदेवे च मुनिभेदे च कुक्कुरे" । - मेदि०<br><br>

कपिलद्युति
कपिलद्युति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>कपिला पिङ्गला द्युतिरस्य<br><br>कपिलद्युति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಂಬಣ್ಣ<br><br>कपिलद्युति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂಬಣ್ಣದ<br><br>

कपिलधारा
कपिलधारा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಗಾನದಿ<br><br>

कपिलस्मृति
कपिलस्मृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಲಮಹರ್ಷಿ ಪ್ರಣೀತವಾದ ಸ್ಮೃತಿ /ಸಾಂಖ್ಯಶಾಸ್ತ್ರ<br><br>

कपिला
कपिला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಂಡರೀಕದಿಗ್ಗಜನ ಪತ್ನಿ<br><br>कपिला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಂಬಣ್ಣದ ಅಗುರು ಗಿಡ<br><br>कपिला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರೇಣುಕವೆಂಬ ಪನಸಾರಿ ವಸ್ತು<br><br>कपिला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೋವು /ಹಸು<br><b>विस्तारः - </b>"कपिला रेणुकायां च शिंशपागोविशेषयोः । पुण्डरीककरिण्यां स्त्री वर्णभेदे त्रिलिङ्गकम् । नानले वासुदेवे च मुनिभेदे च कुक्कुरे" । - मेदि०<br><br>

कपिलाचार्य
कपिलाचार्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ಸಾಂಖ್ಯತತ್ತ್ವವನ್ನು ಉಪದೇಶಿಸಿದ ಕಪಿಲಮಹರ್ಷಿ<br><b>व्युत्पत्तिः - </b>कपिलश्चासावचार्यश्च<br><b>प्रयोगाः - </b>"महर्षिः कपिलाचार्यः कृतज्ञो मेदिनीपतिः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"तत्त्वप्रवचनादेव कपिलाचार्य उच्यते" -निरुक्तिः ।<br><br>

कपिलाश्व
कपिलाश्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><b>व्युत्पत्तिः - </b>कपिलवर्णोऽश्वोऽस्य<br><b>विस्तारः - </b>"प्राचीनबर्हिः खदिरः कपिलाश्वो वरक्रतुः" - त्रिकाण्ड० ।<br><br>

कपिलावट
कपिलावट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಗಾನದಿಯ ಸಮೀಪದಲ್ಲಿರುವ ಒಂದು ಪುಣ್ಯತೀರ್ಥ<br><b>व्युत्पत्तिः - </b>कपिलया कृतोऽवटः<br><br>

कपिलिका
कपिलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಜರಿ<br><b>निष्पत्तिः - </b>कपिला - सञ्ज्ञायां "कन्" (५-३-७५)<br><b>विस्तारः - </b>परुषा कृष्णा, चित्रा, कपिलिका, पोतिका, रक्ता, श्वेता, अग्निप्रभा ಎಂದು ಜರಿಗಳು ೮ ವಿಧ.<br><br>

कपिलेश
कपिलेश<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಲಮಹರ್ಷಿಯಿಂದ ಪ್ರತಿಷ್ಠಾಪಿಸಲ್ಪಟ್ಟ ಒಂದು ಈಶ್ವರ ಲಿಂಗ<br><b>व्युत्पत्तिः - </b>कपिलेन प्रतिष्ठापितमीशलिङ्गम्<br><b>प्रयोगाः - </b>"कपिलेशं महालिङ्गं कपिलेन प्रतिष्ठितम् । मुच्यन्ते कपयोऽप्यस्य दर्शनात् किमु मानवाः ॥"<br><b>उल्लेखाः - </b>काशीखं०<br><br>

कपिवल्ली
कपिवल्ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಜಹಿಪ್ಪಲಿ<br><b>व्युत्पत्तिः - </b>कपिरिव वल्ली<br><br>

कपिश
कपिश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೋರೋಚನದಂತೆ ಕೆಂಪುಬೆರೆತ ಹಳದಿಬಣ್ಣ /ಕಂದುಹಳದಿ ಬಣ್ಣ<br><br>कपिश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪುಬೆರೆತ ಹಳದಿಬಣ್ಣ<br><b>व्युत्पत्तिः - </b>कपिर्मर्कटः, तद्वर्णत्वात् कपिशः ।<br><br>कपिश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೋಬಾನ /ಒಂದು ವಾಸನೆಯ ದ್ರವ್ಯ<br><br>कपिश<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ /ಹೆಂಡ<br><b>प्रयोगाः - </b>"ग्राम्यानपश्यत्कपिशं पिपासतः स्वगोत्रसङ्कीर्तनभावितात्मनः"<br><b>उल्लेखाः - </b>माघ० १२-३८<br><b>विस्तारः - </b>"कश्यं मद्यं च मैरेयं कपिशं कापिशायनम्" - हला० ।<br><br>कपिश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂದುಬಣ್ಣದ /ಕೆಂಪುಬೆರೆತ ಹಳದಿಬಣ್ಣದ<br><b>प्रयोगाः - </b>"छायाश्चरन्ति बहुधा भयमादधानाः सन्ध्यापयोदकपिशाः पिशिताशनानाम्"<br><b>उल्लेखाः - </b>शाकु० ३-२४<br><br>कपिश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪ್ಪುಬೆರೆತ ಹಳದಿಬಣ್ಣದ<br><br>

कपिशा
कपिशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ /ಹೆಂಡ<br><br>कपिशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಧವೀಲತೆ<br><b>विस्तारः - </b>"कपिशो सिह्लकश्यावौ कपिशा माधवो सुरा" - हेम० ।<br><br>कपिशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಕಲದೇಶದ ಸಮೀಪದಲ್ಲಿರುವ ಒಂದು ನದಿ<br><b>प्रयोगाः - </b>"स तीर्त्वा कपिशां सैन्यैर्बद्धद्विरदसेतुभिः । उत्कलादर्शितपथः कलिङ्गानिमुखो ययौ ॥"<br><b>उल्लेखाः - </b>रघु० ४-३८<br><br>

कपिशित
कपिशित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂಬಣ್ಣದ್ದಾಗಿ ಆಗಿರುವ ಕೆಂಪು ಬೆರೆತ ಹಳದಿಬಣ್ಣದ್ದಾಗಿ ಆಗಿರುವ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>कपिशोऽस्य सञ्जातः<br><br>

कपिशीर्ष
कपिशीर्ष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಕಾರದ ಮೇಲುಭಾಗ /ಸುತ್ತುಗೋಡೆಯ ತುದಿಯ ಭಾಗ<br><br>

कपिष्ठल
कपिष्ठल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೋತ್ರಪ್ರವರ್ತಕರಾದ ಒಬ್ಬ ಋಷಿ<br><b>निष्पत्तिः - </b>"कपिष्ठलो गोत्रे" पा० सू० (८-३-९१) । निपा० । गोत्रादन्यत्र न षत्वम् । कपिस्थलम् ।<br><br>कपिष्ठल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಗಳ ಜಾಗ /ಕಪಿಗಳು ವಾಸಿಸುವ ಸ್ಥಳ<br><br>

कपीज्य
कपीज्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀರಾಮಚಂದ್ರ<br><br>कपीज्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಗ್ರೀವ<br><b>निष्पत्तिः - </b>यज (देवपूजायाम्) - "क्यप्" सप्र० ।<br><b>व्युत्पत्तिः - </b>कपिभिरिज्यते पूज्यते<br><br>

कपीतन
कपीतन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಮಟೆ ಮರ<br><br>कपीतन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಗೆ ಮರ<br><br>कपीतन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಸುರಿ ಗಿಡ<br><br>कपीतन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಳಿ ಮರ<br><b>निष्पत्तिः - </b>तनु (विस्तारे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कपीनां ई लक्ष्मीं तनोति<br><b>विस्तारः - </b>"कपीतनो गर्दभाण्डशिरीषाम्रातकेषु च । आश्वत्थे च" - मेदि० ।<br><br>

कपीन्द्र
कपीन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಗಳ ರಾಜ ಸುಗ್ರೀವ<br><b>व्युत्पत्तिः - </b>कपीनामिन्द्रः<br><br>कपीन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಶ್ರೇಷ್ಠ ಹನುಮಂತ<br><br>कपीन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>कपीन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀರಾಮ<br><b>प्रयोगाः - </b>"शरीरभूतकृत् भोक्ता कपीन्द्रो भूरिदक्षिणः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"कपिरूपं प्रपन्नानां देवनामीश्वरत्वतः । कपीन्द्र इति विख्यातः सप्तार्णो मनुनायकः ॥" - निरुक्तिः ।<br><br>

कपीवत्
कपीवत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸಿಷ್ಠಮಹರ್ಷಿಯ ೭ ಮಕ್ಕಳಲ್ಲಿ ಒಬ್ಬ<br><b>विस्तारः - </b>"और्वो वसिष्ठपुत्रश्च स्तम्बः कश्यप एव च । कपीवानकपीवांश्च दन्तोलिश्च्यवनस्तथा ॥" - हरिवं<br><br>

कपीश
कपीश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಗ್ರೀವ<br><br>कपीश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಶ್ರೇಷ್ಠ ಹನುಮಂತ<br><b>व्युत्पत्तिः - </b>कपीनामीशः<br><b>प्रयोगाः - </b>"कपीशवक्षहन्तारं वन्दे लङ्काभयङ्करम्"<br><br>

कपिच्छल
कपिच्छल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಡೆ /ವೇಣಿ /ಬಾಲದಂತೆ ತೂಗಾಡುತ್ತಿರುವ ಹೆಣೆಯಲ್ಪಟ್ಟ ತಲೆಯ ಕೂದಲು<br><b>निष्पत्तिः - </b>ला (आदाने) - "कः" (३-२-२)<br><b>व्युत्पत्तिः - </b>कस्य शिरसः पुच्छमिव लाति<br><br>कपिच्छल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗದಲ್ಲಿ ಹೋಮಕ್ಕಾಗಿ ಆಜ್ಯವನ್ನು ತೆಗೆದುಕೊಳ್ಳುವ ಸ್ರುಕ್ಕಿನ ಅಗ್ರಭಾಗ /ಹೋಮದ ಸವಟಿನ ತುದಿಯ ಭಾಗ<br><br>

कपुष्टिका
कपुष्टिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜುಟ್ಟು /ಜಡೆ ಹೆಣೆಯಲ್ಪಟ್ಟ ಕೇಶಪಾಶ<br><b>निष्पत्तिः - </b>कै (शब्दे) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कस्य शिरसः पुष्ट्यै पोषणाय कायति<br><br>

कपूय
कपूय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀಚ /ಕೆಟ್ಟ /ಕುತ್ಸಿತ /ಅಯೋಗ್ಯ<br><b>निष्पत्तिः - </b>पूयी (विशरणे दुर्गन्धे च) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुत्सितं पूयते<br><br>कपूय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ವಾಸನೆಯುಳ್ಳ<br><br>

कपोत
कपोत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರಿವಾಳದ ಹಕ್ಕಿ<br><b>व्युत्पत्तिः - </b>कस्य वायोः पोत इव को वायुः पोत इव यस्य वा<br><b>प्रयोगाः - </b>"अथोच्चकैर्जरठकपोतकन्धरातनूरुहप्रकरविपाण्डुरद्युति"<br><b>उल्लेखाः - </b>माघ० १७-५२<br><br>कपोत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರವರ್ಣದ ಕಂಠವುಳ್ಳ ಕಾಡುಪರಿವಾಳದ ಹಕ್ಕಿ<br><b>विस्तारः - </b>"कपोतः स्यात् चित्रकण्ठपारावतविहङ्गयोः" - मेदि० । ಕಪೋತವು गृहकपोतः, वनकपोतः, चित्रकपोतः ಎಂದು ೩ ವಿಧ. ಕಪೋತವು ಹಗಲಲ್ಲಿ ಮಾತ್ರ ಸಂಚರಿಸುವ ಪ್ರಾಣಿಗಳ ಗುಂಪಿಗೆ ಸೇರಿದುದು.<br><br>

कपोतक
कपोतक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌವೀರಾಂಜನ<br><b>निष्पत्तिः - </b>कै (शब्दे) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कपोत इव कायति<br><br>

कपोतनालिका
कपोतनालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿಯಿಂದ ದಾರವನ್ನು ತೆಗೆಯುವ ಚರಖ /ಕದಿರು<br><br>

कपोतपालिका
कपोतपालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರಿವಾಳದ ಮನೆ /ಪಾರಿವಾಳದ ಗೂಡು / ಪಾರಿವಾಳಹಕ್ಕಿಗಳು ಗೂಡಿಟ್ಟಿರುವ ಸ್ಥಳ<br><b>निष्पत्तिः - </b>पा (रक्षणे) + णिच् - "अण्" (३-२-१) । "ङीप्" (४-१-१५) । सञ्ज्ञायां कन् (५-३-७५) । पाल + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कपोलान् पालयति । कपोतानां पालिका ।<br><br>

कपोतपाली
कपोतपाली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪೋತಗೃಹ /ಪಾರಿವಾಳಹಕ್ಕಿಗಳ ಗೂಡು<br><b>निष्पत्तिः - </b>पा (रक्षणे) + णिच् - "अण्" (३-२-१) । "ङीप्" (४-१-१५) ।<br><b>व्युत्पत्तिः - </b>कपोतान् पालयति<br><b>प्रयोगाः - </b>"चिक्रंसया कृत्रिमपत्रिपङ्तेः कपोतपालीषु निकेतनानाम्"<br><b>उल्लेखाः - </b>माघ० ३-५१<br><br>

कपोतरोमन्
कपोतरोमन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಜ /ಕಪೋತವೇಷವನ್ನು ತಾಳಿದ ಅಗ್ನಿಯ ವರದಿಂದ ಜನಿಸಿದ ಶಿಬಿಚರ್ಕವರ್ತಿಯ ಒಬ್ಬ ಮಗ<br><b>प्रयोगाः - </b>"एतत्पार्श्वात् पुरुषो जनिष्यति कपितरोमेति च तस्य नाम"<br><b>उल्लेखाः - </b>भा० वन० २००<br><br>कपोतरोमन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯದುವಂಶದ ಕುಕುರರಾಜನ ಮೊಮ್ಮಗನಾದ ಒಬ್ಬ ರಾಜ<br><br>

कपोतलुब्धकीय
कपोतलुब्धकीय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹಸ್ಥನು ಪ್ರಾಣವನ್ನಾದರೂ ಒಪ್ಪಿಸಿ ಅತಿಥಿಸತ್ಕಾರ ಮಾಡಬೇಕೆಂದು ತಿಳಿಸುವ ಮಹಾಭಾರತದ ಒಂದು ಕಥೆ<br><b>निष्पत्तिः - </b>"छः" (४-२-६)<br><b>व्युत्पत्तिः - </b>कपोतं लुब्धकं चाधिकृत्य कृतो ग्रन्थः<br><br>

कपोतवङ्का
कपोतवङ्का<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮೀವೃಕ್ಷ/ಹೊನಗೊನೆ ಗಿಡ<br><b>निष्पत्तिः - </b>वञ्चु (प्रलम्भने) + णिच् - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>कपोतो वञ्च्यतेऽनया<br><b>प्रयोगाः - </b>"कपोतवङ्कामूलं वा पिबेदम्लैः सुरादिभिः । तत्सिद्धं वा पिबेत् क्षीरं वेदनाभिरुपद्रवः"<br><b>उल्लेखाः - </b>सुश्रुत० चिकित्सा० ७-२५<br><br>

कपोतवर्णी
कपोतवर्णी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣಯಾಲಕ್ಕಿ ಗಿಡ<br><b>निष्पत्तिः - </b>गौरा० "ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>कपोतस्य वर्ण इव वर्णो अस्याः<br><br>

कपोतवृत्ति
कपोतवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪೋತದಂತೆ ನಡೆಸುವ ಜೀವನ / ಪಾರಿವಾಳ ಪಕ್ಷಿಯಂತೆ ಆಹಾರವನ್ನು ಶೇಖರಿಸಿಡದೆ ನಡೆಸುವ ಜೀವನ<br><b>व्युत्पत्तिः - </b>कपोतस्येव वृत्तिः<br><b>विस्तारः - </b>ಪಾರಿವಾಳಹಕ್ಕಿಗಳು ಕೂಡಿಸಿಟ್ಟುಕೊಳ್ಳದೆ ಆಗತಾನೆ ದೊರಕುವ ಆಹಾರದಿಂದ ಜೀವಿಸುವುವು.<br><br>कपोतवृत्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪೋತದಂತೆ ಜೀವಿಕೆಯುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>कपोतस्येव वृत्तिः यस्य<br><br>

कपोताञ्जन
कपोताञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌವೀರಾಂಜನ<br><b>व्युत्पत्तिः - </b>कपोतवर्णमञ्जनम्<br><br>

कपोतारि
कपोतारि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ಯೇನಪಕ್ಷಿ /ಗಿಡಗದ ಹಕ್ಕಿ<br><b>व्युत्पत्तिः - </b>कपोतस्यारिः<br><br>

कपोतिन्
कपोतिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾರಿವಾಳದ ಹಕ್ಕಿಯನ್ನು ಹೊಂದಿರುವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कपोतोऽस्यास्ति<br><br>

कपोती
कपोती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಪಾರಿವಾಳದ ಹಕ್ಕಿ<br><b>निष्पत्तिः - </b>जाति० "ङीष्" (४-१-६३)<br><b>व्युत्पत्तिः - </b>कपोतस्य स्त्री<br><br>

कपोल
कपोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆನ್ನೆ /ಗಂಡಸ್ಥಳ<br><b>निष्पत्तिः - </b>कपि (चलने) - "कोलच्" (उ० १-६६)<br><b>व्युत्पत्तिः - </b>कम्पते भोजनसमये<br><b>प्रयोगाः - </b>"प्राप्यते स्म गतिचित्रकचित्रैश्चित्रमार्द्रनखलक्ष्म कपोलैः" । "कपोलकण्डूः करिभिर्विनेतुं विघट्टितानां सरलद्रुमाणाम्" ।<br><b>उल्लेखाः - </b>माघ० १०-७८, कुमा० १-९<br><br>

कपोलकाष
कपोलकाष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆನ್ನೆ ತಿಕ್ಕಲ್ಪಡುವ ಒಂದು ಜಾಗ ಅಥವಾ ಒಂದು ವಸ್ತು /ಮರ /ಬಂಡೆ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>कष (हिंसायाम्) - कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>कपोलः कष्यतेऽनेन<br><b>प्रयोगाः - </b>"एतस्मिन् मदयति कोकिलानकाले लीनाभिः सुरकरिणां कपोलकाषः"<br><b>उल्लेखाः - </b>किरा० ५-२६<br><br>

कपोलताडन
कपोलताडन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆನ್ನೆಗೆ ಹೊಡೆಯುವಿಕೆ /ಅಪರಾಧ ಮಾಡಿದುದಕ್ಕಾಗಿ ಕೆನ್ನೆಗೆ ಏಟು ಕೊಡುವಿಕೆ<br><b>व्युत्पत्तिः - </b>कपोले ताडनम्<br><br>

कपोलपत्र
कपोलपत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆನ್ನೆಯ ಮೇಲೆ ಬರೆಯುವ ಎಲೆಯ ಆಕಾರದ ಚಿತ್ರ<br><b>व्युत्पत्तिः - </b>कपोले पत्रमिव<br><b>प्रयोगाः - </b>"कपोलपत्रान्मकरात्सकेतुर्भ्रूभ्यां जिगीषुर्धनुषा जगन्ति"<br><b>उल्लेखाः - </b>नैष० ७-६०<br><br>

कपोलफलक
कपोलफलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಲಗೆಯಂತೆ ವಿಸ್ತಾರವಾದ ಕೆನ್ನೆ<br><b>व्युत्पत्तिः - </b>कपोलः फलक इव<br><b>प्रयोगाः - </b>"ईषत्वक्रितकन्धरः सपुलकः प्रेमोल्लसन्मानसामन्तहसिलसत्कपोलफलकां धूर्तोऽपरां चुम्बति"<br><b>उल्लेखाः - </b>अमरु० १९<br><br>

कपोलभित्ति
कपोलभित्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೋಡೆಯಂತೆ ಅಗಲವಾದ ಕೆನ್ನೆ<br><b>व्युत्पत्तिः - </b>कपोलो भित्तिरिव<br><b>प्रयोगाः - </b>"कोपात्ताम्रकपोलभित्तिनि मुखे दृष्ट्या गतः पादयोः"<br><b>उल्लेखाः - </b>अमरु० ८३<br><br>

कपोली
कपोली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಡಿಚಿಪ್ಪು /ಮಂಡಿಕೀಲಿನ ಹೊರಭಾಗದ ಎಲುಬು<br><br>

कफ
कफ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ಲೇಷ್ಮ /ದೇಹದೊಳಗಿನ ಮಂದವೂ ಜಿಗುಟೂ ಆದ ಲೋಳೆ /ದೇಹದೊಳಗಿನ ವಾತ ಪಿತ್ತ ಮತ್ತು ಕಫಗಳೆಂಬ ೩ ದೋಡಗಳಲ್ಲೊಂದು /ಶರೀರದೊಳಗಿನ ಸಪ್ತಧಾತುಗಳಲ್ಲೊಂದಾದ ರಸಧಾತುವಿನ ಮಲ<br><b>निष्पत्तिः - </b>फल (निष्पत्तौ) - "डः" (३-२-१०१)<br><b>व्युत्पत्तिः - </b>केन जलेन फलति<br><b>प्रयोगाः - </b>"कफः पित्तं मलं केषु स्वेदः स्यान्नखरोम च । नेत्रविट् त्वक्षु न स्नेहो धातूनां क्रमशो मलाः ।"<br><b>उल्लेखाः - </b>सुश्रुत० सूत्र० ४६-५२९<br><br>

कफकर
कफकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಫವಿಕಾರವನ್ನುಂಟುಮಾದುವ /ಶ್ಲೇಷ್ಮವನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>करोतीति करः ।कफस्य करः<br><br>

कफकूर्चिका
कफकूर्चिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಲಾಜಲ /ಜೊಲ್ಲು<br><b>व्युत्पत्तिः - </b>कफं कूर्चति विकरोति<br><b>विस्तारः - </b>"सृणिका स्यन्दिनी लालाऽस्यासवः कफकूर्चिका" - अभि० चि०<br><br>

कफघ्न
कफघ्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಫವನ್ನು ನಾಶಪಡಿಸುವ /ಶ್ಲೇಷ್ಮವನ್ನು ಕರಗಿಸುವ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) - "टक्" (३-२-५३)<br><b>व्युत्पत्तिः - </b>कफं हन्ति<br><br>

कफज्वर
कफज्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಫವು ಅಧಿಕವಾಗಿರುವುದರಿಂದ ಬರುವ ಜ್ವರ<br><b>व्युत्पत्तिः - </b>कफनिमित्तो ज्वरः<br><br>

कफणि
कफणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಳಕೈ /ತೋಳಿನ ಮಧ್ಯಭಾಗ<br><b>निष्पत्तिः - </b>पण (गतौ) - "इन्" (उ० ४-११७)<br><b>व्युत्पत्तिः - </b>केन जलेन फणति स्फुरति<br><b>विस्तारः - </b>"कफोणिस्तु भुजामध्यं कफणिः कूर्परश्च सः" - अभि० चि० ।<br><br>

कफद
कफद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಫವನ್ನು ಉಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कफं ददाति<br><br>

कफनाशक
कफनाशक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಫವನ್ನು ನಾಶಪಡಿಸುವ /ಶ್ಲೇಷ್ಮವನ್ನು ಕರಗಿಸುವ<br><b>निष्पत्तिः - </b>णश (अदर्शने) + णिच् - "ण्वुल्" (३-१-१३३), "ल्युः" वा ।<br><b>व्युत्पत्तिः - </b>कफं नाशयति<br><br>

कफनाशन
कफनाशन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಫವನ್ನು ನಾಶಪಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>णश (अदर्शने) + णिच् - भावे "ल्युट्" (३-३-११५)<br><br>

कफल
कफल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಫವನ್ನು ಉಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>ला (आदाने) - "कः" (३-२-२)<br><b>व्युत्पत्तिः - </b>कफं लाति<br><b>प्रयोगाः - </b>"वेणोः करीराः कफला मधुरा रसपाकतः"<br><b>उल्लेखाः - </b>सुश्रुत० सूत्र० ४६-२९२<br><br>कफल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಫರೋಗವುಳ್ಳ /ಶ್ಲೇಷ್ಮವ್ಯಾಧಿಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"लच्" (५-२-९७)<br><b>व्युत्पत्तिः - </b>कफोऽस्त्यस्य<br><br>

कफवर्धक
कफवर्धक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಫವನ್ನು ಹೆಚ್ಚಿಸುವ /ಶ್ಲೇಷ್ಮವನ್ನು ಅಭಿವೃದ್ಧಿಪಡಿಸುವ<br><b>निष्पत्तिः - </b>वृधु (वर्धने) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कफं वर्धयति<br><br>

कफवर्धन
कफवर्धन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಫವನ್ನು ಹೆಚ್ಚಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>वृधु (वर्धने) + णिच् - भावे "ल्युट्" (३-३-११५)<br><br>

कफविरोधिन्
कफविरोधिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಫವನ್ನು ನಾಶಪಡಿಸುವ ಮೆಣಸು,ಜೇನು, ತುಪ್ಪ, ಶುಂಠಿ<br><b>निष्पत्तिः - </b>वि + रुधिर् (आवरणे) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>कफं विरुणद्धि<br><br>कफविरोधिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಫವನ್ನು ನಾಶಪಡಿಸುವ<br><br>

कफान्तक
कफान्तक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಫವನ್ನು ನಾಶಪಡಿಸುವ<br><b>निष्पत्तिः - </b>अन्त + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कफमन्तयति अन्तं करोति<br><br>

कफारि
कफारि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಫದ ಶತ್ರು- ಶುಂಠಿ, ಜೇನುತುಪ್ಪ, ಲವಂಗ, ಮೆಣಸು<br><b>व्युत्पत्तिः - </b>कफस्यारिः<br><br>

कफिन्
कफिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಫರೋಗವುಳ್ಳವನು /ಶ್ಲೇಷ್ಮವ್ಯಾಧಿಯುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कफोऽस्त्यस्य<br><b>विस्तारः - </b>"श्लेष्मणः श्लेष्मलः कफी" - अम० ।<br><br>

कफिल
कफिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಫದಿಂದ ಅಸ್ಪಷ್ಟವಾದ ಧ್ವನಿ<br><b>विस्तारः - </b>"कफिलो घर्घरः कफात्" - वैज०<br><br>

कफेलू
कफेलू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಳ್ಳೆಮರ<br><b>निष्पत्तिः - </b>ला (आदाने) - "कुः" (उ० १-९३)निपा० ।<br><b>व्युत्पत्तिः - </b>कफं लाति<br><br>

कफोणि
कफोणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಳಕೈ /ತೋಳಿನ ಮಧ್ಯಭಾಗ<br><b>निष्पत्तिः - </b>फण (गतौ) - स्फुर (सञ्चलने) वा - "इन्" (उ० ४-११७)<br><b>व्युत्पत्तिः - </b>केन जलेन फणति । केन सुखेन स्फुरति<br><br>

कबन्ध
कबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದರ /ಹೊಟ್ಟೆ<br><b>निष्पत्तिः - </b>बन्ध (बन्धने) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कं जलं बध्नाति<br><br>कबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಕ್ಷಸ<br><b>प्रयोगाः - </b>"वधनिर्धूरशापस्य कबन्धस्योपदेशतः । मुमूर्च्छ सख्यं रामस्य समानव्यसने हरौ ॥"<br><b>उल्लेखाः - </b>रघु० १-५७<br><br>कबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಹು<br><b>विस्तारः - </b>"कबन्धस्तूदरे रक्षोविशेषेपि विधुन्तुदे" - विश्व० ।<br><br>कबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುತ್ತಿಗೆ ಕತ್ತರಿಸಲ್ಪಟ್ಟ ದೇಹ /ತಲೆಯಿಂದ ಬೇರ್ಪಡಿಸಲ್ಪಟ್ಟು ಚಲಿಸುತ್ತಿರುವ ಶರೀರ /ಮುಂಡ<br><b>निष्पत्तिः - </b>बन्ध (बन्धने) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>कं शिरो बध्यते अस्मात्<br><b>प्रयोगाः - </b>"सैन्यैः कण्ठच्छेदलीने कबन्धाद्भूयो बिभ्ये वल्गतः सासिपाणेः"<br><b>उल्लेखाः - </b>माघ० १८-५३<br><br>कबन्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><b>व्युत्पत्तिः - </b>कं प्राणवायुः बध्यतेऽनेन<br><br>

कबन्धिन्
कबन्धिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಋಷಿ<br><b>प्रयोगाः - </b>"अथ कबन्धी कात्यायनः उपेत्य पप्रच्छ"<br><b>उल्लेखाः - </b>प्रश्नो०<br><br>कबन्धिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಲವುಳ್ಳ /ನೀರಿನಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>कबन्ध - "इनिः" (५-२-११५)<br><br>

कबर
कबर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಠಕ /ಅಧ್ಯಾಪಕ /ಉಪಾಧ್ಯಾಯ<br><b>निष्पत्तिः - </b>कु (शब्दे) - "अरन्" (उ० ४-१५४) । वबयोरभेदः ।<br><br>कबर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಬುರ ವರ್ಣ /ಚಿತ್ರ ವರ್ಣ<br><b>प्रयोगाः - </b>"दृष्ट्वेव निर्जितकलापभरामधस्ताद्व्याकीर्णमाल्यकबरां कबरीं तरुण्याः"<br><b>उल्लेखाः - </b>माघ० ५-१९<br><br>कबर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪ್ಪು<br><br>कबर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹುಳಿ<br><b>निष्पत्तिः - </b>वृञ् (वरणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कं जलं वृणोति<br><b>विस्तारः - </b>"कबरं लवणाम्लयोः" - मेदि० ।<br><br>

कबरी
कबरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸರ ತುರುಬು /ಹೆರಳು<br><b>निष्पत्तिः - </b>वृञ् (वरणे) - "अच्" (३-१-१३४) । "ङीप्" (४-१-४२)<br><b>व्युत्पत्तिः - </b>कं शिरः वृणोति आच्छादयति<br><b>प्रयोगाः - </b>"व्याकीर्णमाल्यकबरां कबरीं तरुण्याः"<br><b>उल्लेखाः - </b>माघ० ५-१९<br><br>कबरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸೆ ಗಿಡ<br><b>विस्तारः - </b>"कबरी केशविन्यासशाकयोः" - हेम० ।<br><br>कबरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾರಂಬೇಳೆ ಗಿಡ<br><br>कबरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಗಿನ ಮರ<br><b>विस्तारः - </b>"कबरी पुनः । पृथ्वी तुङ्ग्योः केशवेशे कबरं लवणाम्लयोः । कबर्युमायाम्" - मेदि० ।<br><br>

कबरीभार
कबरीभार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಶಪಾಶ /ಕೂದಲಿನ ಸಮೂಹ<br><b>व्युत्पत्तिः - </b>कबर्या भारः<br><b>प्रयोगाः - </b>"अमरीकबरीभारभ्रमरीमुखरीकृतम् । दूरीकरोतु दुरितं गौरीचरणपङ्कजम्॥"<br><b>उल्लेखाः - </b>कुव०<br><br>

कबल
कबल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಾಸ /ತುತ್ತು<br><b>निष्पत्तिः - </b>वल (सञ्चलने) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>केन जलेन वलति चलति<br><b>प्रयोगाः - </b>"त्रिकटुकमजमोदा सैन्धवं जीरके द्वे समधरणधृतानामष्टमो हिङ्गुभागः । प्रथमकबलभुक्तं सर्पिषा चूर्णमेतज्जनयति जठराग्निं वातपित्तं निहन्ति ॥" "गम्भीरवेदिनि पुरः कबलं करीन्द्रे मन्दोऽपि नाम न महानवगृह्य साध्यः" ।<br><b>उल्लेखाः - </b>२) माघ० ५-४९<br><br>कबल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿ ಮೀನು<br><br>

कबलन
कबलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಿನ್ನುವುದು /ನುಂಗುವುದು<br><br>

कबलित
कबलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿನ್ನಲ್ಪಟ್ಟ /ನುಂಗಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कबल + णिच् - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>कबलः कृतः<br><br>

कबलीकृत
कबलीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಬಳವಾಗಿ ಮಾಡಲ್ಪಟ್ಟ /ತುತ್ತಾಗಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"च्विः" (५-४-५०) । "दीर्घः (७-४-३२)<br><b>व्युत्पत्तिः - </b>अकबलः कबलः कृतः<br><br>

कबित्थ
कबित्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಲದ ಮರ<br><b>निष्पत्तिः - </b>ष्ठा (गतिनिवृत्तौ) - "कः" (३-२-४) । पृषो० ।<br><b>व्युत्पत्तिः - </b>कपयस्तिष्ठन्त्यत्र<br><b>विस्तारः - </b>ಕಪಿಗಳಿಗೆ ಬೇಲದ ಹಣ್ಣು ಪ್ರಿಯವಾದುದರಿಂದ ಈ ಹೆಸರು.<br><br>कबित्थ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಲದ ಹಣ್ಣು<br><br>

कम्
कम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸುಖ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) - णिङभावे "विच्" (३-३-७५)<br><b>व्युत्पत्तिः - </b>कम्पते<br><br>कम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><br>कम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಶಿರಸ್ಸು /ತಲೆ<br><br>कम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪಾದಪೂರಣ<br><b>विस्तारः - </b>"कं पादपूरणे तोये मस्तके च सुखेऽपि च" - मेदि० ।<br><br>

कमु|कान्तौ|कामयते
कमु - कान्तौ (भ्वा० आत्म० सक० से) - कामयते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಇಚ್ಛಿಸು /ಅಪೇಕ್ಷಿಸು<br><br>कमु - कान्तौ (भ्वा० आत्म० सक० से) - कामयते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿಸು<br><b>प्रयोगाः - </b>"माधवानुचरः कलहंसो नाम विहारदासीं मन्दारिकां कामयते" । "अकम्पनस्ततो योद्धुं चकमे रावणाज्ञया" ।<br><b>उल्लेखाः - </b>मालती० १, भट्टि० १४-८२<br><br>

अनुकमु|अनु + कमु|अनुकामयते  
अनु + कमु - अनुकामयते<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅನುರೂಪವಾದ ಪ್ರೀತಿ<br><br>अनु + कमु - अनुकामयते<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅನುಗುಣವಾದ ಅಪೇಕ್ಷೆ<br><br>

अभिकमु|अभि + कमु|अभिकामयते  
अभि + कमु - अभिकामयते<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಆಭಿಮುಖ್ಯದಿಂದ ಪ್ರೀತಿಸು<br><b>प्रयोगाः - </b>"दसीं कन्यासहस्रेण शर्मिष्ठामभिकामये"<br><b>उल्लेखाः - </b>भा० आदि० ७४-२२<br><br>

निकमु|नि + कमु|निकामयते 
नि + कमु - निकामयते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಂಪೂರ್ಣವಾಗಿ ಪ್ರೀತಿಸು<br><b>प्रयोगाः - </b>"या तस्य ते पादसरोरुहार्हणं निकामयेत् साखिलकामलम्पटा"<br><b>उल्लेखाः - </b>भाग० ५-१८-२१<br><br>नि + कमु - निकामयते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅತಿಶಯವಾಗಿ<br><b>प्रयोगाः - </b>"निकामतप्ता विविधेन वह्निना नभश्चरेणेन्धनसम्भृतेन सा"<br><b>उल्लेखाः - </b>कुमा० ५-२३<br><br>

कमक
कमक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೋತ್ರಪ್ರವರ್ತಕರಾದ ಒಬ್ಬ ಋಷಿ<br><br>कमक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮುಕ<br><br>

कमठ
कमठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೂರ್ಮ /ಆಮೆ<br><b>निष्पत्तिः - </b>मठ (मदनिवासयोः) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>के जले मठति<br><br>कमठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಗಿನ ಶ್ವೇತವರಾಹಕಲ್ಪದ ಚಾಕ್ಷುಷಮನ್ವಂತರದಲ್ಲಿ ನಡೆದ ಮಹಾವಿಷ್ಣುವಿನ ಒಂದು ಅವತಾರ<br><b>प्रयोगाः - </b>"सुरासुराणामुदधिं मथ्नतां मन्दराचलम् । दध्रे कमठरूपेण पृष्ठे एकादशे विभुः ॥"<br><b>उल्लेखाः - </b>भाग० १-३-१६<br><br>कमठ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಋಷಿಗಳ ನೀರಿನ ಪಾತ್ರೆ<br><b>विस्तारः - </b>"कमठः कच्छपे पुंसि भाण्डभेदे नपुंसकम्" - मेदि०।<br><br>कमठ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭಿಕ್ಷಾಪಾತ್ರೆ<br><br>कमठ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಮನ /ಕುಳ್ಳ<br><b>विस्तारः - </b>"भिक्षापात्रे तु कमठं कमठौ खर्वकच्छपौ"- वैज० ।<br><br>

कमठी
कमठी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಆಮೆ<br><br>

कमण्डलु
कमण्डलु<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂನ್ಯಾಸಿಗಳ ಮತ್ತು ಬ್ರಹ್ಮಚಾರಿಗಳ ಮರದ ಅಥವಾ ಮೃಣ್ಮಯ ನೀರಿನ ಪಾತ್ರೆ<br><b>निष्पत्तिः - </b>ला (आदाने) - "डुः" (वा० ३-२-८१०)<br><b>व्युत्पत्तिः - </b>कस्य प्रजापतेर्जलस्य वा मण्डं सारं लाति<br><b>प्रयोगाः - </b>"अशेषतीर्थोपहृताः कमण्डलोः निधाय पाणावृषिणाभ्युदीरिताः"<br><b>उल्लेखाः - </b>माघ० १-१८<br><br>कमण्डलु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಸುರಿ ಗಿಡ<br><br>कमण्डलु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಮೃಗ<br><br>

कमण्डलू
कमण्डलू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कमण्डलु ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"ऊङ्" (४-१-७२)<br><b>विस्तारः - </b>"कमण्डलुः स्यात्करके न स्त्री ना प्लक्षपादपे" - मेदि० ।<br><br>

कमन
कमन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ /ಮನ್ಮಥ<br><br>कमन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶೋಕವೃಕ್ಷ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) - "युच्" (३-२-१४९)<br><br>कमन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ<br><br>कमन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಂದರವಾದ /ಮನೋಹರವಾದ<br><br>कमन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮುಕ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) - कर्त० "ल्युट्"<br><br>

कमना
कमना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कमन ಪದದ ಅರ್ಥ<br><br>

कमनी
कमनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮುಕೀ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><b>प्रयोगाः - </b>"अभीष्टमासाद्य चिराय काले समुद्धृताशं कमनी चकाशे"<br><b>उल्लेखाः - </b>माघ० ६-७४<br><b>विस्तारः - </b>"कमनः कामुके कामेऽभिरूपेऽशोकपादपे" - मेदि०। "कमनः कविः सात्त्विकवेदगर्भौ स्थविरः शतानन्दपितामहौ" -अभि- चि० ।<br><br>

कमनच्छद
कमनच्छद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಂದರವಾದ ರೆಕ್ಕೆಗಳುಳ್ಳ ಕಂಕಪಕ್ಷಿ /ರಣಹದ್ದು<br><b>व्युत्पत्तिः - </b>कमनः कान्तः छदोऽस्य<br><b>विस्तारः - </b>"कङ्कस्तु कमनच्छदः" - अभि० चि०<br><br>

कमनीय
कमनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಂದರವಾದ /ರಮಣೀಯವಾದ<br><b>निष्पत्तिः - </b>कमु (कान्तौ)- णिङभावे "अनीयर्" (३-१-९६)<br><b>प्रयोगाः - </b>"मध्यं तनुकृत्य यदीदमीयं वेधा न दध्यात्कमनीयमंशम्"<br><b>उल्लेखाः - </b>नैष० ७-८२<br><br>कमनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಪೃಹಣೀಯವಾದ /ಅಪೇಕ್ಷಿಸಲು ಯೋಗ್ಯವಾದ<br><b>प्रयोगाः - </b>"आरोपितं यद्गिरिशेन पश्चादनन्यनारीकमनीयमङ्कम्"<br><b>उल्लेखाः - </b>कुमा० १-३७<br><br>

कमनीयतम
कमनीयतम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ರಮಣೀಯವಾದ /ಅತಿ ಮನೋಹರವಾದ<br><b>निष्पत्तिः - </b>"तमप्" (५-३-५५)<br><b>व्युत्पत्तिः - </b>अतिशयेन कमनीयः<br><br>

कमनीयतर
कमनीयतर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ರಮಣೀಯವಾದ /ಅತಿ ಮನೋಹರವಾದ<br><b>निष्पत्तिः - </b>"तरप्"(५-३-५७)<br><b>प्रयोगाः - </b>"वपुरम्बुविहारहिमं शचिना रुधिरं कमनीयतरा गमिता"<br><b>उल्लेखाः - </b>माघ० ६-७१<br><br>

कमनीयता
कमनीयता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೊಬಗು /ಸೌಂದರ್ಯ /ರಮಣೀಯವಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>प्रयोगाः - </b>"भुवनत्रयसुभ्रुवामसौ दमयन्ती कमनीयतामदम्"<br><b>उल्लेखाः - </b>नैष० २-१८<br><br>

कमर
कमर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮುಕ<br><b>निष्पत्तिः - </b>कमु (कान्तौ)- "अरः" (उ० ३-१३२)<br><br>

कमल
कमल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪದ್ಮ /ತಾವರೆಯ ಹೂವು<br><b>निष्पत्तिः - </b>अल (भूषणादौ) - "कः" (वा० ३-२-५)<br><b>व्युत्पत्तिः - </b>कं जलमलति<br><b>प्रयोगाः - </b>"धृतनवातपमुत्सुखतामतो न कमलं कमलमभ्ययदम्भसि"<br><b>उल्लेखाः - </b>माघ० ६-४८<br><br>कमल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ತಕಮಲ /ಕೆಂದಾವರೆ<br><br>कमल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು /ಜಲ<br><b>निष्पत्तिः - </b>अल (भूषणादौ) - "कलः" (उ० १-१-०६)<br><b>प्रयोगाः - </b>"कुररीगणः कृतरवस्तरवः कुसुमानताः सकमलं कमलम्"<br><b>उल्लेखाः - </b>किरा० ५-२५<br><br>कमल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿನ್ನ ಮೊದಲಾದುವುಗಳಿಂದ ಚಿತ್ರಿಸಲ್ಪಟ್ಟ ಸಣ್ಣ ಕತ್ತಿಯ ಒರೆ<br><b>विस्तारः - </b>"कमलं छुरिकादीनां हेमाद्यैश्चित्रताजिने । रक्ताब्जेऽब्जेऽप्सु च " - वैज० ।<br><br>कमल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಮ್ರ<br><br>कमल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂತ್ರಕೋಶ<br><br>कमल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಔಷಧ<br><br>कमल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಜಿಂಕೆ<br><b>विस्तारः - </b>"कमलं सलिले ताम्रे जलजे क्लोम्नि भेषजे । मृगभेदे तु कमलः"- मेदि० ।<br><br>

कमली
कमली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कमल ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीष्" (४-१-६३)<br><br>

कमललज
कमललज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ/ ಚತುರ್ಮುಖ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे)- "डः" (३-२-१०१)<br><b>व्युत्पत्तिः - </b>विष्णोः नाभिकमलात् जायते<br><br>कमललज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೋಹಿಣೀ ನಕ್ಷತ್ರ<br><br>कमललज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಮಲದಲ್ಲಿ ಹುಟ್ಟಿದ /ಕಮಲದಲ್ಲಿ ಉಂಟಾದ /ಕಮಲದೊಂದ ಉತ್ಪನ್ನವಾದ<br><br>

कमलनयन
कमलनयन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ಕಮಲದಂತೆ ಕಣ್ಣುಗಳುಳ್ಳ ನಾರಾಯಣ<br><b>व्युत्पत्तिः - </b>कमले इव नयनेऽस्य<br><br>कमलनयन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಮಲದಂತೆ ಕಣ್ಣುಗಳುಳ್ಳ<br><br>

कमलनयना
कमलनयना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲದಂತೆ ಕಣ್ಣುಗಳುಳ್ಳವಳು<br><br>

कमलनाभ
कमलनाभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಭಿಯಲ್ಲಿ ಕಮಲವುಳ್ಳ ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>कमलं नाभौ यस्य<br><br>

कमलबन्ध
कमलबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲಬಂಧು /ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>कमलस्य बन्धुः<br><br>

कमलबान्धव
कमलबान्धव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲಬಂಧು /ಸೂರ್ಯ<br><br>

कमलभव
कमलभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲದಿಂದ ಹುಟ್ಟಿದ ಬ್ರಹ್ಮ<br><b>निष्पत्तिः - </b>भू (सत्तायाम्) - "अप्" (३-३-५७)<br><b>व्युत्पत्तिः - </b>कमलात् भवति<br><br>

कमलभू
कमलभू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲದಿಂದ ಹುಟ್ಟಿದ ಬ್ರಹ್ಮ<br><b>निष्पत्तिः - </b>भू (सत्तायाम्) - "क्विप्" (३-२-१७९)<br><br>

कमलयोनि
कमलयोनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲವೇ ಉತ್ಪತ್ತಿ ಸ್ಥಾನವಾಗಿ ಉಳ್ಳ ಬ್ರಹ್ಮ /ಚತುರ್ಮುಖ<br><b>व्युत्पत्तिः - </b>कमलं योनिरुत्पत्तिस्थानमस्य<br><br>

कमललोचन
कमललोचन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾವರೆ ಹೂವಿನಂತೆ ಕಣ್ಣುಗಳುಳ್ಳ ವಿಷ್ಣು<br><br>कमललोचन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಾವರೆ ಹೂವಿನಂತೆ ಕಣ್ಣುಗಳುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कमले इव लोचने अस्य<br><br>

कमललोचना
कमललोचना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಾವರೆ ಹೂವಿನಂತೆ ಕಣ್ಣುಗಳುಳ್ಳವಳು<br><br>

कमलवदन
कमलवदन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಮಲದಂತೆ ಮುಖವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कमलमिव वदनं यस्य<br><br>

कमलवदना
कमलवदना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲದಂತೆ ಮುಖವುಳ್ಳವಳು<br><br>

कमलवन
कमलवन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಾವರೆ ಹೂವಿನ ಕಾಡು /ತಾವರೆ ಹೂವುಗಳ ಗುಂಪು<br><b>प्रयोगाः - </b>"मधुन इव दयायाः सामरस्यं दधानैः कमलवनमनन्यां कान्तिमध्यापयद्भिः"<br><b>उल्लेखाः - </b>याद० १९-८१<br><br>

कमलसम्भव
कमलसम्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ /ಚತುರ್ಮುಖ<br><b>निष्पत्तिः - </b>सम् + भू (सत्तायाम्) - "अप्" (३-३-५७)<br><b>व्युत्पत्तिः - </b>कमलात् सम्भवति<br><br>

कमला
कमला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಮಿ<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>कमलमस्या अस्ति<br><b>प्रयोगाः - </b>"कमलोल्लसितेन दर्शनीयं दिनमाद्यन्तविवर्जितं दिदृक्षे"<br><b>उल्लेखाः - </b>याद० १४-४<br><br>कमला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠ ಹೆಂಗಸು<br><b>विस्तारः - </b>"कमला श्रीवरस्त्रियोः" - मेदि० ।<br><br>

कमलाकर
कमलाकर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾವರೆ ಹೂವುಗಳ ಉತ್ಪತ್ತಿ ಸ್ಥಾನ /ಸರೋವರ<br><br>कमलाकर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾವರೆ ಹೂವುಗಳಸಮೂಹ<br><b>व्युत्पत्तिः - </b>कमलानामाकरः उतत्तिस्थानं समूहो वा<br><b>प्रयोगाः - </b>"प्रविघाटयिता समुत्पतन् हरिदश्वः कमलाकरानिव"<br><b>उल्लेखाः - </b>किरा० २-४६<br><br>

कमलाक्ष
कमलाक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><br>कमलाक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಮಲದಂತೆ ಕಣ್ಣುಗಳುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>कमले इव अक्षिणी यस्य<br><br>

कमलाक्षी
कमलाक्षी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲದಂತೆ ಕಣ್ಣುಗಳುಳ್ಳವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीष्" (४-१-४१)<br><br>

कमलाग्रजा
कमलाग्रजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಮಿಯ ಅಕ್ಕ /ಜ್ಯೀಷ್ಠಾ ದೇವಿ /ದಾರಿದ್ರ್ಯ ದೇವತೆ<br><b>व्युत्पत्तिः - </b>कमलाया अग्रजा<br><br>

कमलाकान्त
कमलाकान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಮಹಾವಿಷ್ಣು /ನಾರಾಯಣ<br><b>व्युत्पत्तिः - </b>कमलायाः कान्तः<br><br>

कमलापति
कमलापति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಮಹಾವಿಷ್ಣು /ನಾರಾಯಣ<br><b>व्युत्पत्तिः - </b>कमलायाः पतिः<br><br>

कमलालया
कमलालया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲವೇ ವಾಸಸ್ಥಾನವಾಗಿ ಉಳ್ಳ ಲಕ್ಷ್ಮಿ<br><b>व्युत्पत्तिः - </b>कमलमालयो यस्याः<br><br>

कमलासन
कमलासन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ /ಚತುರ್ಮುಖ<br><b>व्युत्पत्तिः - </b>कमलमासनं यस्य<br><b>प्रयोगाः - </b>"क्रान्ताति पूर्वं कमलासनेन कक्ष्यान्तराण्यद्रिपतेर्विवेश"<br><b>उल्लेखाः - </b>कुमा० ७-७०<br><br>कमलासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲರೂಪವಾದ ಆಸನ<br><br>कमलासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯೋಗಶಾಸ್ತ್ರೋಕ್ತವಾದ ಪದ್ಮಾಸನ<br><br>

कमलासना
कमलासना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कमलासन ಪದದ ಅರ್ಥ<br><br>

कमलासनस्थ
कमलासनस्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲರೂಪವಾದ ಆಸನದಲ್ಲಿ ಕುಳಿತಿರುವ ಬ್ರಹ್ಮ<br><b>निष्पत्तिः - </b>ष्ठा (गतिनिवृत्तौ) - "कः" (३-२-४) ।<br><b>व्युत्पत्तिः - </b>कमलासने तिष्ठति<br><br>

कमलिनी
कमलिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲಲತೆ ಯತಾವರೆಯ ಬಳ್ಳಿ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५) । "ङीप्" (४-१-५)<br><b>व्युत्पत्तिः - </b>कमलान्यस्याः सन्ति<br><b>प्रयोगाः - </b>"विरहतप्ततदङ्गनिवेशिता कमलिनी निमिषद्दलमुष्टिभिः"<br><b>उल्लेखाः - </b>नैष० ४-३२<br><br>कमलिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲಗಳಿಂದ ಕೂಡಿದ ಸರೋವರ ಯಕೊಳ<br><br><b>कन्नडार्थः - </b>ಕಮಲಗಳಿಂದ ಕೂಡಿದ ಪ್ರದೇಶ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-१३५)<br><b>व्युत्पत्तिः - </b>कमलान्यत्र देशे सन्ति<br><br>

कमा
कमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂತಿ/ ಹೊಳಪು<br><br>कमा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌಂದರ್ಯ /ಸೊಬಗು<br><b>निष्पत्तिः - </b>कमु (कान्तौ) - "अङ्" (३-३-१०४)<br><br>

कमितृ
कमितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮುಕ /ಸ್ತ್ರೀಲೋಲ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) - णिङभावे "तृच्" (३-१-१३३))<br><b>प्रयोगाः - </b>"अन्वयुर्द्युतिपयःपितृनाथास्तं मुदाथ हरितां कमितारः"<br><b>उल्लेखाः - </b>नैष० ५-५५<br><br>कमितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸುವ /ಬಯಸುವ<br><b>प्रयोगाः - </b>"इत्यमी वसुमतीकमितारः सादरास्त्वदतिथीर्भवितुं न"<br><b>उल्लेखाः - </b>नैष० ५-३४<br><br>

कमित्री
कमित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कमितृ ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कम्प
कम्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಡುಕ /ಕಂಪನ/ತತ್ತರ /ಅದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>कपि (चलने) - "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"भ्रेमुर्वात्या इवान्याः प्रतिपदमपरा भूमिवत्कम्पमापुः"<br><b>उल्लेखाः - </b>माघ० १५-९६<br><br>कम्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಲನ /ಅಲುಗಾಡುವಿಕೆ<br><b>प्रयोगाः - </b>"अस्तित्वं कार्यसिद्धेः स्फुटमथ कथयन् पक्षतेः कम्पभेदैः" । "कम्पेन मूर्ध्नः शतपत्रयोनिं वाचा हरिं वृत्रहणं स्मितेन" ।<br><b>उल्लेखाः - </b>नैष० ३-१३२, कुमा० ७-४६<br><br>कम्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಗ್ರತಾಖ್ಯ ವ್ಯಭಿಚಾರಿಭಾವದಿಂದ ಉಂಟಾದ ಒಂದು ಅನುಭವ<br><b>प्रयोगाः - </b>"तत्र स्वेदशिरःकम्पतर्जनाताडनादयः" । "अनुभावोऽत्र वैवर्ण्यगद्गदस्वरभाषणम् । प्रलयस्वेदरोमाञ्चकम्पदिक्प्रेक्षणादयः ॥"<br><b>उल्लेखाः - </b>सा० द० ३-१४९, सा० द० ३-२३७<br><br>

कम्पन
कम्पन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಅಸ್ತ್ರ<br><b>प्रयोगाः - </b>"प्रासस्तथा गदाभिश्च परिघैः कम्पनैस्तथा"<br><b>उल्लेखाः - </b>भा०<br><br>कम्पन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಶಿರ ಋತು<br><br>कम्पन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಜ<br><b>निष्पत्तिः - </b>कपि (चलने) - कर्त० "युच्" (३-२-१४८)<br><b>प्रयोगाः - </b>कम्बोजराजः कमठः कम्पनश्च महाबलः । सततं कम्पयामास यवनानेक एव यः ॥"<br><b>उल्लेखाः - </b>भा० सभा० ४-२८<br><br>कम्पन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸನ್ನಿಪಾತಜ್ವರ /ಚಳಿಜ್ವರ<br><br>कम्पन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಡುಕ /ಕಂಪನ/ತತ್ತರ /ಅದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>कपि (चलने) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"अधरकम्पनमुन्नय मेनके किमपि जल्पति कल्पलते श्रुणु"<br><b>उल्लेखाः - </b>नैष० ४-११३<br><br>कम्पन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಡುಗಿಸುವಿಕೆ /ಅಲುಗಾಡಿಸುವಿಕೆ<br><b>प्रयोगाः - </b>"प्रवसतः सुतरामुदकम्पयत् विदलकन्दलकम्पनलालितः"<br><b>उल्लेखाः - </b>माघ० ६-३०<br><br>कम्पन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗಿಸುವ /ಅಲುಗಾಡಿಸುವ<br><b>निष्पत्तिः - </b>कपि (चलने) - "युच्" (३-२-१४८)<br><br>कम्पन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಕವುಳ್ಳ /ಅಲುಗಾಡುವ<br><br>

कम्पनीय
कम्पनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗಿಸಲ್ಪಡುವ<br><br>कम्पनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗಿಸಲ್ಪಡಲು ಅರ್ಹವಾದ<br><br>कम्पनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗಿಸಲ್ಪಡಲು ಶಕ್ಯವಾದ<br><b>निष्पत्तिः - </b>कपि (चलने) - कर्मादौ "अनीयर्" (३-१-९६)<br><br>

कम्पमान
कम्पमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗುತ್ತಿರುವ /ಅಲುಗಾಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कपि (चलने) - "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"महती मेदिनी दीनं कम्पमानान्वकम्पत"<br><b>उल्लेखाः - </b>याद० १६-१०९<br><br>

कम्पयत्
कम्पयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗಿಸುತ್ತಿರುವ<br><br>कम्पयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कपि (चलने) + णिच् - "शतृ" (३-२-१२४)<br><br>

कम्पयन्ती
कम्पयन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कम्पयत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कम्पयमान
कम्पयमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>कम्पयत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>कपि (चलने) + णिच् - "शानच्" (३-२-१२४)<br><br>

कम्पयमाना
कम्पयमाना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कम्पयत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्" (४-१-४)<br><br>

कम्पयितृ
कम्पयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗಿಸುವ /ಅದಿರಿಸುವ<br><b>निष्पत्तिः - </b>कपि (चलने) + णिच् - "तृच्" (३-१-१३३)<br><br>कम्पयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡಿಸುವ<br><br>

कम्पयित्री
कम्पयित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कम्पयितृ ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कम्पलक्ष्मन्
कम्पलक्ष्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯು /ಗಾಳಿ<br><b>व्युत्पत्तिः - </b>कम्पः लक्ष्म यस्य<br><b>विस्तारः - </b>"वातस्तु नभःप्राणो जगद्बलः । भोगिकान्तः कम्पलक्ष्मा पश्चधारावनिश्च सः" - त्रिकाण्ड०।<br><br>

कम्पा
कम्पा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಲನೆ /ನಡುಕ<br><b>निष्पत्तिः - </b>कपि (चलने) - भावे "अः" (३-३-१०३)<br><br>

कम्पित
कम्पित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಪನ /ನಡುಕ<br><b>निष्पत्तिः - </b>कपि (चलने) - भावे "क्तः" (३-३-११४)<br><br>कम्पित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>कपि (चलने) + णिच् - भावे "क्तः" (३-३-११४)<br><br>कम्पित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡಿಸಲ್ಪಟ್ಟ /ಅಲ್ಲಾಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कपि (चलने) + णिच् - कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आद्यकोलतुलितां प्रकम्पनैः कम्पितां मुहुरनीदृगात्मनि"<br><b>उल्लेखाः - </b>माघ० १४-४३<br><br>कम्पित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಕವುಳ್ಳ /ಅಲುಗಾಡುವ<br><b>प्रयोगाः - </b>"पृक्तस्तुषारैर्गिरिनिर्झराणामनेकहाकम्पितपुष्पगन्धी"<br><b>उल्लेखाः - </b>रघु० २-१३<br><br>

कम्पिन्
कम्पिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂಪವುಳ್ಳ /ನಡುಕವುಳ್ಳ<br><br>कम्पिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಲಿಸುವ /ಅಲುಗಾಡುವ<br><b>प्रयोगाः - </b>"गीती शीघ्री शिरःकम्पी तथा लिखितपाठकः । अनर्थज्ञोऽल्पकण्ठश्च षडेते पाठकागुणाः ॥"<br><b>उल्लेखाः - </b>पा० शि०<br><br>कम्पिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗಿಸುವ<br><br>कम्पिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡಿಸುವ<br><b>निष्पत्तिः - </b>कपि (चलने) + णिच् - "णिनिः" (३-१-१३४)<br><br>

कम्पिल्ल
कम्पिल्ल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಲೆ ಹಿಟ್ಟು ಎಂಬ ಒಂದು ಔಷಧ<br><br>

कम्प्य
कम्प्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡಿಸಲ್ಪಡುವ<br><br>कम्प्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡಿಸಲ್ಪಡಲು ಶಕ್ಯವಾದ<br><br>कम्प्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡಿಸಲ್ಪಡಲು ಅರ್ಹವಾದ<br><b>निष्पत्तिः - </b>कपि (चलने) + णिच् - "यत्" (३-१-९७)<br><br>

कम्प्यमान
कम्प्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡುಗಿಸಲ್ಪಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कपि (चलने) - कर्म० "शानच्" (३-२-१२४)<br><br>कम्प्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡಿಸಲ್ಪಡುತ್ತಿರುವ<br><br>

कम्प्र
कम्प्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಂಚಲವಾದ /ನಡುಕದ ಸ್ವಭಾವವುಳ್ಳ<br><b>निष्पत्तिः - </b>कपि (चलने) - "रः" (३-२-१६७)<br><b>प्रयोगाः - </b>"सुताः कमाहूय चिराय चुकृतैर्विधाय कम्प्राणि मुखानि कं प्रति"<br><b>उल्लेखाः - </b>नैष० १-१४२<br><br>

कम्बर
कम्बर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರ ವರ್ಣ<br><br>कम्बर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರ ವರ್ಣವುಳ್ಳ<br><b>निष्पत्तिः - </b>कम्ब (गतौ) - "अरः" बाहु० ।<br><br>

कम्बल
कम्बल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಲು /ಉಣ್ಣೆಯಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ ಬಟ್ಟೆ /ಕಂಬಳಿ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) - "कलः" बुक् च (उ० १-१-०६)<br><b>प्रयोगाः - </b>"न तथा सुखयत्यग्निर्न प्रावारा न कम्बलाः । शीतवातार्दितं लोकं यथा तव मरीचयः ॥"<br><b>उल्लेखाः - </b>भा० वन० ३-३२<br><br>कम्बल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರೀಯ /ಹೊದೆಯುವ ವಸ್ತ್ರ<br><br>कम्बल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಸುವಿನ ಗಂಗೆದೊಗಲು<br><br>कम्बल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಿಮಿ /ಹುಳ<br><br>कम्बल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಸರ್ಪ<br><br>कम्बल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><br>कम्बल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಂಕೆ /ಚಿಗರಿ<br><br>कम्बल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯಾಗದಲ್ಲಿರುವ ಒಂದು ತೀರ್ಥ<br><b>विस्तारः - </b>"कम्बलोऽहिः क्रिमिः सास्ना प्रावारः कम्बलं जले" - मेदि० ।<br><br>

कम्बलिका
कम्बलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣಕಂಬಳಿ<br><b>निष्पत्तिः - </b>कम्बली - स्वार्थे "कन्"<br><b>व्युत्पत्तिः - </b>क्षुद्रः कम्बलः<br><br>कम्बलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಜಿಂಕೆ<br><br>

कम्बलिन्
कम्बलिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಷಭ /ಎತ್ತು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कम्बलः गलकम्बलः अस्यास्ति<br><br>कम्बलिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂಬಳಿಯನ್ನು ಧರಿಸಿರುವವನು<br><br>

कम्बलिवाह्यक
कम्बलिवाह्यक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತುಗಳಿಂದ ಎಳೆಯಲ್ಪಡುವ ಗಾಡಿ<br><b>निष्पत्तिः - </b>वह (प्रापणे) - "ण्यत्" (३-१-१२४) । स्वार्थे "कन्"<br><b>व्युत्पत्तिः - </b>कम्बलिभिः वृषभैरुह्यते<br><br>

कम्बलीया
कम्बलीया<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂಬಳಿಗೆ ಅನುಕೂಲವಾದ ಉಣ್ಣೆ<br><b>निष्पत्तिः - </b>"छः" (५-१-५)<br><b>व्युत्पत्तिः - </b>क्म्बलाय हितम्<br><br>

कम्बल्य
कम्बल्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಶಾಲನ್ನು ತಯಾರಿಸಲು ಬೇಕಾಗುವ ನೂರು ಪಲಗಳ ಉಣ್ಣೆ<br><b>निष्पत्तिः - </b>कम्बल‍ - सञ्ज्ञायां "यत्" (५-१-३)<br><br>

कम्बि
कम्बि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌಟು /ಮಿಳ್ಳೆ<br><b>निष्पत्तिः - </b>कम्ब (गतौ) - "इन्" (उ० ४-११७)<br><br>कम्बि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿದಿರಿನ ಮೊಳಕೆ ಅಥವಾ ಗಿಣ್ಣು<br><b>विस्तारः - </b>"कम्बिरंशे च वंशस्य खजाकायामपि स्त्रियाम्" - मेदि० ।<br><br>

कम्बु
कम्बु<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಂಖ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) - "कुः" बुक् च (उ० १-३७)<br><b>प्रयोगाः - </b>"नृत्ते चक्षूःशून्यहस्तप्रयोगं काये कूजन् कम्बुरुच्चैर्जहास"<br><b>उल्लेखाः - </b>माघ० १८-५४<br><br>कम्बु<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಡಗ /ಬಳೆ<br><br>कम्बु<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಂಖದ ಬಳೆ<br><br>कम्बु<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತಿನಲ್ಲಿ ಶಂಖದಂತೆ ಇರುವ ೩ ರೇಖೆಗಳು<br><br>कम्बु<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪೆಚಿಪ್ಪು<br><br>कम्बु<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಜ /ಆನೆ<br><b>विस्तारः - </b>"मदवृन्दः कुषी कम्बुः शुण्डालः षष्टिहायनः" - वैज० ।<br><br>कम्बु<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯದ ನುಚ್ಚು /ಧಾನ್ಯದ ಒಂದು ಭಾಗ<br><br>कम्बु<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸಂಖ್ಯೆ<br><b>विस्तारः - </b>"कम्ब्वस्त्री वलये शङ्खे शम्बूके कणसङ्ख्ययोः"- वैज०।<br><br>कम्बु<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಟೊಳ್ಳಾಗಿರುವ ಮೂಳೆ /ಒಂದು ಕೊಳವೆಯಂತಿರುವ ಎಲುಬು<br><br>कम्बु<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತು /ಕುತ್ತಿಗೆ<br><br>कम्बु<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಚೋರ<br><b>विस्तारः - </b>"कम्बुर्वलयशङ्खयोः । गजे शम्बूके कर्चूरे ग्रीवायां नलकेऽपि च" - हेम० ।<br><br>

कम्बुक
कम्बुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಂಖ<br><b>निष्पत्तिः - </b>कम्बु - स्वार्थे "कन्" (५-३-७५)<br><br>

कम्बुकण्ठ
कम्बुकण्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಂಖದಂತೆ ೩ ಗೆರೆಗಳುಳ್ಳ ಕತ್ತುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>कम्बुरिव कण्ठो यस्य<br><br>

कम्बुकण्ठी
कम्बुकण्ठी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಂಖದಂತೆ ೩ ಗೆರೆಗಳುಳ್ಳ ಕತ್ತುಳ್ಳವಳು<br><b>व्युत्पत्तिः - </b>कम्बुरिव कण्ठो यस्याः<br><br>

कम्बुकन्धर
कम्बुकन्धर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಂಖದಂತೆ ಕತ್ತುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>कम्बुरिव कन्धरा यस्य<br><br>

कम्बुकन्धरा
कम्बुकन्धरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಂಖದಂತೆ ಕತ್ತುಳ್ಳವಳು<br><b>व्युत्पत्तिः - </b>कम्बुरिव कन्धरा यस्याः<br><br>

कम्बुग्रीवा
कम्बुग्रीवा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಂಖದಂತೆ ೩ ಗೆರೆಗಳುಳ್ಳ ಕತ್ತು<br><b>व्युत्पत्तिः - </b>कम्बुरिव ग्रीवा<br><br>कम्बुग्रीवा<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಂಖದಂತೆ ೩ ಗೆರೆಗಳುಳ್ಳ ಕತ್ತುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>कम्बुरिव ग्रीवा यस्य<br><br>

कम्बू
कम्बू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೋರ /ಕಳ್ಳ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) - "कूः" बुक् च (उ० १-९३)<br><br>कम्बू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಕಣ /ವಲಯ /ಬಳೆ<br><br>

कम्बोज
कम्बोज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಬೋಜ ದೇಶ<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>कम्बोज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಬೋಜ ದೇಶದ ದೊರೆ /ಕಂಬೋಜ ದೇಶದ ರಾಜ<br><b>निष्पत्तिः - </b>कम्बोजा- "अञ्" (४-१-१६६) । अञो लुक् (४-१-१७३)<br><b>व्युत्पत्तिः - </b>कम्बोजानां राजा<br><b>प्रयोगाः - </b>"कम्बोजाः समरे सोढुं तस्य वीर्यमनीश्वराः"<br><b>उल्लेखाः - </b>रघु० ४-६९<br><br>कम्बोज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಜ /ಆನೆ<br><br>कम्बोज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಂಖ<br><b>उल्लेखाः - </b>"कम्बोजो हस्तिभेदेऽपि शङ्खदेशविशेषयोः" - मेदि०।<br><br>

कम्र
कम्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ತ್ರೀಲೋಲ /ಕಾಮುಕ /ಮೈಥುನೇಚ್ಛೆಯುಳ್ಳವನು<br><b>निष्पत्तिः - </b>कमु (कान्तौ) - "रः" (३-२-१६७)<br><br>

कयाधु
कयाधु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿರಣ್ಯಕಶಿಪುವಿನ ಪತ್ನಿ /ಜಂಭಾಸುರನ ಮಗಳು /ಪ್ರಹ್ಲಾದನ ತಾಯಿ<br><br>

कर
कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಸ್ತ /ಕೈ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - कर० "अप्" ९३-३-५७)<br><b>व्युत्पत्तिः - </b>कीर्यतेऽनेन<br><b>प्रयोगाः - </b>"श्रियास्य यौग्याहमिति स्वमीक्षितुं करे तमालोक्य सुरूपया धृतः"<br><b>उल्लेखाः - </b>नैष० १-३१<br><br>कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲಿ /ಪೂಜಾದ್ರವ್ಯ<br><b>प्रयोगाः - </b>"करप्रचेयामुत्तुङ्गः प्रभुशक्तिं प्रथीयसीम् । प्रज्ञाबलबृहन्मूलः फलत्युत्साहपादपः ॥"<br><b>उल्लेखाः - </b>माघ० २-८९<br><br>कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಣ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - कर्म० "अप्" ९३-३-५७)<br><b>प्रयोगाः - </b>"जगतीरिह स्फुरितचारुचामीकराः सवितुं क्वचित् कपिशयन्ति चामीकराः"<br><b>उल्लेखाः - </b>माघ० ४-२४<br><br>कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜಾದಯ /ರಾಜನಿಗೆ ಕೊಡಬೇಕಾದ ತೆರಿಗೆ /ಕಂದಾಯ<br><b>निष्पत्तिः - </b>रा (दाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कं सुखं राति ददाति<br><b>प्रयोगाः - </b>"तव तन्वि कुचावेतौ नियतं चक्रवर्तिनौ । आसमुद्रक्षितीशोऽपि भवान् यत्र करप्रदः ॥"<br><b>उल्लेखाः - </b>उद्भ०<br><br>कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಸೊಂಡಿಲು<br><b>प्रयोगाः - </b>"सेकः शीकरिणा करेण विहितं कामं विरामे पुनः यत्स्नेहादनरालनालनलिनीपत्रातपत्रं धृतम्"<br><b>उल्लेखाः - </b>उ० रा० ३-१६<br><br>कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಷೋಪಲ /ಆಲಿಕಲ್ಲು<br><br>कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಕ್ಷೇಪ /ಇಡುವಿಕೆ<br><br>कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಸ್ತನಕ್ಷತ್ರ<br><b>प्रयोगाः - </b>"रेवत्युत्तररोहिणीकरपितृस्वातीन्दुमित्रासुरे पापानन्वितपापवेधरहिते पाणिग्रहः शोभनः"<br><b>उल्लेखाः - </b>काला० ५४<br><br>कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎರಡು ಸಂಖ್ಯೆಯಸಂಕೇತ<br><br>कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೆರೆಮನೆ /ಕಾರಾಗಾರ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - कर्म० "अप्" ९३-३-५७)<br><b>व्युत्पत्तिः - </b>किरति क्षिपति दण्ड्यानत्र<br><br>कर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಖವನ್ನು ಕೊಡುವ /ಸುಖವನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>रा (दाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कं सुखं राति<br><br>

करक
करक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಸ್ತ /ಕೈ<br><b>निष्पत्तिः - </b>कर - स्वार्थे "कन्"<br><br>करक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಪಕ್ಷಿ<br><br>करक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಾಡಿಮ ವೃಕ್ಷ /ದಾಳಿಂಬೆ ಮರ<br><br>करक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಂಡಲು /ವಿದ್ಯಾರ್ಥಿಗಳ ಮತ್ತು ಸಂನ್ಯಾಸಿಗಳ ಜಲಪಾತ್ರೆ<br><br>करक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಳಗಿನ ತಿರುಳು ತೆಗೆದು ಪಾತ್ರೆಯ ಆಕಾರದಂತೆ ಮಾಡಿದ ತೆಂಗಿನ ಕಾಯಿಯ ಚಿಪ್ಪು<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - सञ्ज्ञायां "वुन्" (उ० ५-३५)<br><b>व्युत्पत्तिः - </b>किरति जलमत्र<br><b>प्रयोगाः - </b>"उपानहौ च वासश्च धृतम्न्यैर्न धारयेत् । उपवीतमलङ्कारं स्रजं करकमेव च ॥"<br><b>उल्लेखाः - </b>मनु० ४-६६<br><br>करक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಬುರುಡೆ<br><br>करक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಷೋಪಲ /ಆಲಿಕಲ್ಲು<br><br>करक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಯಿಕೊಡೆ<br><b>विस्तारः - </b>"करकस्तु पुमान् पक्षिविशेषे दाडिमेऽपि च । द्वयोर्वर्षोपले न स्त्री करङ्के च कमण्डलौ" - मेदि० ।<br><br>

करकच
करकच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಷೋಕ್ತವಾದ ತಿಥಿವಾರಗಳ ಒಂದು ಯೋಗ<br><b>विस्तारः - </b>ಶನಿವಾರ ಷಷ್ಠಿ, ಶುಕ್ರವಾರ ಸಪ್ತಮಿ, ಗುರುವಾರ ಅಷ್ಟಮಿ, ಬುಧವಾರ ನವಮಿ, ಕುಜವಾರ ದಶಮಿ, ಸೋಮವಾರ ಏಕಾದಶಿ, ಭಾನುವಾರ ದ್ವಾದಶೀ ತಿಥಿಗಳು ಸೇರಿದರೆ ಕರಕಚ ಯೋಗವು.<br><br>

करकच्छपिका
करकच्छपिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೂರ್ಮಮುದ್ರೆ /ಪೂಜಾಕಾಲದಲ್ಲಿ ಕೂರ್ಮದಂತೆ ಅಂಗುಳಿನ್ಯಾಸದಿಂದ ಮಾಡುವ ಒಂದು ಮುದ್ರೆ<br><b>व्युत्पत्तिः - </b>करे स्थिता कच्छपिका कच्छपाकारोऽङ्गुलिविन्यासः<br><b>प्रयोगाः - </b>"करकच्छपिकां कुर्यात् कूर्ममन्त्रेण साधकः । तत्र संस्कृतपुष्पेण पूजयेदात्मनो वपुः ॥"<br><b>उल्लेखाः - </b>कालिकापु०<br><br>

करकण्टक
करकण्टक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಖ /ಉಗುರು<br><b>व्युत्पत्तिः - </b>करस्य कण्टक इव<br><b>विस्तारः - </b>"नखः पुनर्भवः कामांशुकः स्यात्करकण्टकः" - त्रिकाण्ड० ।<br><br>

करकमल
करकमल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲದಂತೆ ಕೋಮಲವಾದ ಕೈ<br><b>व्युत्पत्तिः - </b>करौ कमले इव<br><b>प्रयोगाः - </b>"करकमलनिदर्शितात्ममुद्रः परिकलितोन्नतबर्हिबर्हचूडः ।" "करकमलवितीर्णैरम्बुनीवरशष्पैः"<br><b>उल्लेखाः - </b>२) उ० रा० ३-२५<br><br>

करका
करका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಷೋಪಲ /ಆಲಿಕಲ್ಲು<br><b>उल्लेखाः - </b>"करका स्यात् घनकुको बीजादेकमिराचरम्" - त्रिकाण्ड०<br><br>

करकाम्भस्
करकाम्भस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೆಂಗಿನ ಮರ<br><b>व्युत्पत्तिः - </b>करकाया इव शीतलमम्भोऽस्य<br><br>

करकासर
करकासर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಲಿಕಲ್ಲಿನ ಮಳೆ<br><b>व्युत्पत्तिः - </b>करकायाः आसारः<br><br>

करकिसलय
करकिसलय<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಗುರಿನಂತೆ ಕೋಮಲವಾದ ಕೈ<br><b>व्युत्पत्तिः - </b>करौ किसलयाविव<br><b>प्रयोगाः - </b>"करकिसलयतालैर्मुग्धया नर्त्यमानं सुतमिव मनसा त्वां वत्सलेन स्मरामि"<br><b>उल्लेखाः - </b>उ० रा० ३-१९<br><br>

करकुड्मल
करकुड्मल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಗ್ಗಿನಂತಿರುವ ಕೈ /ಮೊಗ್ಗಿನ ಆಕಾರದಂತೆ ಜೋಡಿಸಲ್ಪಟ್ಟ ಕೈ<br><b>व्युत्पत्तिः - </b>करः कुड्मलमिव<br><b>प्रयोगाः - </b>"करकुड्मलेन निजमूरुमुरुतरनगाश्मकर्कशम्"<br><b>उल्लेखाः - </b>माघ० १५-१०<br><br>

करगत
करगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೈ ಸೇರಿದ /ಕೈಗೆ ದೊರೆತಿರುವ<br><b>व्युत्पत्तिः - </b>करं गतः<br><b>प्रयोगाः - </b>"असमये मतिरुन्मिषति ध्रुवं करगतैव गता यदियं कुहूः"<br><b>उल्लेखाः - </b>नैष० ४-५७<br><br>

करग्रह
करग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಣಿಗ್ರಹಣ /ವಿವಾಹ /ಮದುವೆ<br><b>निष्पत्तिः - </b>ग्रह (उपादाने) - अधि० "अप्" (३-३-५८)<br><b>व्युत्पत्तिः - </b>करो गृह्यतेऽत्र<br><br>करग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಹಿಡಿದುಕೊಳ್ಳುವಿಕೆ<br><br>करग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಜೆಗಳಿಂದ ಕಂದಾಯ ತೆಗೆದುಕೊಳ್ಳುವಿಕೆ<br><br>

करग्रहण
करग्रहण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>करग्रह ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>ग्रह (उपादाने) - "ल्युट्" (३-३-११५)<br><br>

करग्राह
करग्राह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪತಿ /ಗಂಡ<br><br>करग्राह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೈಹಿಡಿದುಕೊಳ್ಳುವವನು<br><br>करग्राह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂದಾಯ ತೆಗೆದುಕೊಳ್ಳುವವನು<br><b>निष्पत्तिः - </b>ग्रह (उपादाने)- "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>करं गृह्णाति<br><br>

करग्राहक
करग्राहक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>करग्रह ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>कर +ग्रह (उपादाने)- "ण्वुल्" (३-१-१३३)<br><br>

करग्राहिन्
करग्राहिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>करग्रह ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>कर + ग्रह (उपादाने)- "णिनिः" (३-१-१३४)<br><br>

करग्रहीतृ
करग्रहीतृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>करग्रह ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>कर + ग्रह (उपादाने)- "तृच्" (३-१-१३३)<br><br>

करघर्षण
करघर्षण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಡಗೋಲು /ಮೊಸರನ್ನು ಕಡೆಯುವ ಕೋಲು /ಮಂತು<br><b>निष्पत्तिः - </b>घृषु (सङ्घर्षे) - कर्म० "ल्युट्" (३-३-११३)<br><b>व्युत्पत्तिः - </b>कराभ्यां घृष्यते<br><br>करघर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಯನ್ನು ಉಜ್ಜುವಿಕೆ<br><b>व्युत्पत्तिः - </b>करयोः घर्षणम्<br><br>

करङ्क
करङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೆಂಗಿನ ಕಾಯಿಯ ಚಿಪ್ಪು<br><br>करङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಂಡಲು /ವಿದ್ಯಾರ್ಥಿಗಳ ಮತ್ತು ಸಂನ್ಯಾಸಿಗಳ ಜಲಪಾತ್ರೆ<br><br>करङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರದ ಅಥವಾ ಲೋಹದ ಪಾತ್ರೆ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "अप्" (३-३-५७) । अङ्क (पदे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कीर्यते जलमत्र । करमङ्कयति<br><br>करङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾಂಬೂಲ ಮುಂತಾದುವುಗಳ ಬುಟ್ಟಿ ಅಥವಾ ಪೆಟ್ಟಿಗೆ<br><br>करङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಬುರುಡೆ /ತಲೆಯೋಡು /ಕಪಾಲ /ತಲೆಯ ಚಿಪ್ಪು<br><b>प्रयोगाः - </b>"आत्तस्नाय्वान्त्रनेत्रः प्रकटितदशनः प्रेतरङ्कः करङ्कादङ्कस्थादस्थिसंस्थ स्थपुटगतमपि क्रव्यमव्यग्रमत्ति"<br><b>उल्लेखाः - </b>मालती० ५-१६<br><br>

करज
करज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಗುರು /ನಖ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे)- "डः" (३-२-९७)<br><b>व्युत्पत्तिः - </b>करे जायते<br><b>प्रयोगाः - </b>"करजदशनचिह्नं नैशमङ्गेऽन्यनारीजनितमिति सरोषामीर्ष्ययाशङ्कमानाम्"<br><b>उल्लेखाः - </b>माघ० ११-३७<br><br>करज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಂದೆಮರ<br><b>निष्पत्तिः - </b>रञ्ञ (रागे) + णिच् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कं शिरः जलं वा रञ्जयति<br><br>करज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಘ್ರನಖವೃಕ್ಷ /ಹುಲಿಯುಗುರು ಗಿಡ<br><b>व्युत्पत्तिः - </b>करजो नखम्, तदिव<br><b>विस्तारः - </b>"करजं स्यात् व्याघ्रनखे करञ्जनखयोः पुमान्" -मेदि० ।<br><br>करज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೈಯಲ್ಲಿ ಹುಟ್ಟಿದ<br><br>

करञ्ज
करञ्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಂಗೆಮರ<br><b>निष्पत्तिः - </b>रञ्ञ (रागे) + णिच् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कं शिरः जलं वा रञ्जयति<br><br>

करञ्जक
करञ्जक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಂಗೆಮರ<br><b>निष्पत्तिः - </b>रञ्ञ (रागे) + णिच् - "अण्" (३-२-१) । स्वार्थे "कन्" (५-३-७५)<br><br>

करट
करट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಕಪೋಲ /ಗಂಡಸ್ಥಳ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "अटन्" (उ० ४-८१)<br><b>व्युत्पत्तिः - </b>किरति मदम्<br><b>प्रयोगाः - </b>"कल्याणं वो विधत्तां करटमदधुनीलोलकल्लोलमालाखेलल्लोलम्बकोलाहलमुखरितदिक्चक्रवालान्तरालम्"<br><b>उल्लेखाः - </b>चं० भा०<br><br>करट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯಸ /ಕಾಗೆ<br><b>निष्पत्तिः - </b>रट (शब्दे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>क इति रटति<br><br>करट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಸುಬೆ ಗಿಡ<br><br>करट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಗಾರಿ<br><br>करट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನವಶ್ರಾದ್ಧ<br><br>करट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕಷ್ಟದಿಂದ ಜೀವಿಸುವ ಮನುಷ್ಯ<br><br>करट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವುದರಲ್ಲಿಯೂ ನಂಬಿಕೆಯಿಲ್ಲದವನು /ನಾಸ್ತಿಕ /ದೇವದೂಷಕ<br><br>

करटा
करटा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಷ್ಟದಿಂದ ಹಾಲು ಕರೆಯಿಸಿಕೊಳ್ಳುವ ಹಸು<br><br>

करटक
करटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ /ವಾಯಸ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><br>करटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣೀಸುತ /ಚೌರ್ಯಶಾಸ್ತ್ರ ಪ್ರವರ್ತಕ<br><b>विस्तारः - </b>"कर्णीसुतः करटकः स्तेयशास्त्रप्रवर्तकः । तस्य सखायौ द्वौ विपुलाचलसञ्ज्ञकौ ॥" - कादम्बरीव्याख्यानम् । "करटः करिगण्डे स्यात् कुसुम्भे निन्द्यजीविनि । काके वाद्ये दुर्दुरूटे नवश्राद्धे" - हेम० ।<br><br>करटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿತೋಪದೇಶದಲ್ಲಿ ಬರುವ ಒಂದು ನರಿಯ ಹೆಸರು<br><br>

करटिन्
करटिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಜ /ಆನೆ<br><b>निष्पत्तिः - </b>करट - "इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>करटोऽस्यस्ति<br><b>प्रयोगाः - </b>"दिगन्ते श्रूयन्ते मदमलिनगण्डाः करटिनः"<br><b>उल्लेखाः - </b>रसगं०<br><br>

करण
करण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಯಸ್ಥ /ಲೇಖಕ /ಗುಮಾಸ್ತೆ<br><br>करण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೂದ್ರಸ್ತ್ರೀಯಲ್ಲಿ ವೈಶ್ಯನಿಗೆ ಜನಿಸಿದ ಒಬ್ಬ ಮಿಶ್ರಜಾತಿಯವನು<br><b>प्रयोगाः - </b>"धनधान्याध्यक्षता च राजसेवा तथैव च । द्विजातेः परिचर्या च दुर्गान्तःपुररक्षणम् । एषा पारशवस्योक्ता उग्रस्य करणस्य च ॥"<br><b>उल्लेखाः - </b>परा०<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ /ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - कर० "ल्युट्" (३-३-११७)<br><b>प्रयोगाः - </b>"करणं कारणं कर्ता विकर्ता गहनो गुहः"<br><b>उल्लेखाः - </b>वि०स०<br><b>विस्तारः - </b>"स्वप्राप्तौ साधकतमं जीवानां करणं विदुः" - निरुक्तिः<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಧನ /ಸಲಕರಣೆ<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಿಯಾನಿಷ್ಪತ್ತಿಪರ್ಯಂತ ಕಾರ್ಯಸಿದ್ಧಿಗೆ ಪರಮೋಪಕಾರಕವಾಗಿರುವ ಕಾರಕ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - कर० "ल्युट्" (३-३-११७)<br><b>प्रयोगाः - </b>"करणं कर्म कर्तेति त्रिविधः कर्मसङ्ग्रहः"<br><b>उल्लेखाः - </b>गीता० १८-१८<br><b>विस्तारः - </b>दात्रेण धान्यं लुनाति ಎಂಬಲ್ಲಿ ಧಾನ್ಯವನ್ನು ಕೊಯ್ಯಲು ಹಸ್ತಗಳು ಕಾರಣವಾದರೂ ಸಾಕ್ಷಾತ್ಕಾರಣವಾದ ದಾತ್ರವೇ ಕರಣವಾಗುವುದು. "साधकतमं करणम्" (पा० सू० १-४-४२) । "क्रियायाः परिनिष्पत्तिः यद्व्यापारादन्तरम् । विवक्ष्यते यदा यत्र करणं तत् तदा स्मृतम् ॥"<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಪಾರವುಳ್ಳ ಅಸಾಧಾರಣ ಕಾರಣ /ಹೇತು<br><b>विस्तारः - </b>ಘಟಕ್ಕೆ ದಂಡವು ಅಸಾಧಾರಣಕಾರಣ.ದಂಡದಿಂದ ಉಂಟಾಗುವ ಭ್ರಮಣರೂಪವ್ಯಾಪಾರದಿಂದ ಘಟೋತ್ಪತ್ತಿಯಾಗುವುದರಿಂದ ದಂಡವು ಕರಣವಾಯಿತು.<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಳಬದ್ಧರಚನೆ /ತಾಳಬದ್ಧವಾದ ವಾದ್ಯಗಳ ತಾಡನ<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹ /ಶರೀರ<br><b>प्रयोगाः - </b>"शिखरासक्तमेघानां व्यज्यन्ते यत्र वेश्मनाम् । अनुगर्जितसन्दिग्धाः करणैर्मुरजस्वनाः ॥"<br><b>उल्लेखाः - </b>कुमा० ६-४०<br><b>विस्तारः - </b>"नृत्यवादित्रगीतानां प्रयोगवशभेदिनाम् । संस्थानं ताडनं रोधःकरणानि प्रचक्षते ॥"<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯ<br><b>प्रयोगाः - </b>"यस्मिन् दृष्टे करणविगमादूर्ध्वमुद्धूतपापाः । सङ्कल्पन्ते स्थिरगणपदप्राप्तये श्रद्दधानाः ॥"<br><b>उल्लेखाः - </b>मेघ० ५५<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲೇಖ್ಯ /ಆಧಾರಪತ್ರ /ದಸ್ತೈವೇಜು /ಪ್ರಮಾಣಪತ್ರ<br><b>प्रयोगाः - </b>"अधिष्ठानं तथा कर्ता करणं च पृथग्विधम्" । "करणकलेबरयोगं वितरसि वृषशैलनाथकरुणे त्वम्" । "नासाश्वसाधिवासेऽधरमधुनि रसज्ञा चरित्रेषु चित्तं तन्नस्तन्वङ्गि कैश्चिन्न करणहरिणैर्वागुरालङ्घितासि"<br><b>उल्लेखाः - </b>गीता० १८-१४, दयाश० १७, नैष० ८-१०६<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ಷೇತ್ರ /ಭೂಮಿ<br><b>प्रयोगाः - </b>"अर्थेऽपव्ययमानं तु करणेन विभावितम् । दापयेद्धनिकस्यार्थं दण्डलेशं च शक्तितः ॥"<br><b>उल्लेखाः - </b>मनु० ८-५१<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ತ /ಮನಸ್ಸು /ಅಂತಃಕರಣ<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಷದಲ್ಲಿ ತಿಥಿಯ ಅರ್ಧಭಾಗವನ್ನು ವ್ಯಾಪಿಸಿರುವ ಕಾಲವಿಶೇಷ<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತಿ /ಮಾಡುವಿಕೆ<br><b>प्रयोगाः - </b>"कर्तृता तदुपलम्भतोऽभवद्वृत्तिभाजि करणे यथर्त्विजि"<br><b>उल्लेखाः - </b>माघ० १४-१९<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಯಾರಿಸುವಿಕೆ /ನಿರ್ಮಾಣ<br><b>विस्तारः - </b>बवः, बालवः, कौलवः, तैतिलः,गरः, वणिक्, भद्रा, शकुनिः, चतुष्पादः, नागवान्, किंस्तुघ्नम् - इति एकादश करणानि ।<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯೋಗದ ಒಂದು ಅಂಗ /ಪದ್ಮಾಸನ ಮೊದಲಾದುದು<br><b>प्रयोगाः - </b>"कृतस्य करणं नास्ति"<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೃತ್ಯದಲ್ಲಿ ಅಭಿನಯಕ್ಕಾಗಿ ಬಳಸುವ ಅಂಗಚೇಷ್ಟೆ /ಭಾವಾಭಿನಯ<br><b>प्रयोगाः - </b>"हलस्य करणे चापि व्यादिष्टाः सर्वशिल्पिनः"<br><b>उल्लेखाः - </b>भा० वन० २५६-२६<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸ್ತಲೇಪ /ಕೈಗೆ ಬಳಿಯುವುದು /ಕೈಗೆ ಮುಲಾಮು ಮೊದಲಾದುವನ್ನು ಹಚ್ಚುವುದು<br><b>विस्तारः - </b>"आसनं करणं तस्य भेदाः पद्मासनादयः" - वैज० ।<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರಣೆಯಿಂದ ಗಾರೆ ಮೊದಲಾದುವನ್ನು ಬಳಿಯುವುದು<br><b>विस्तारः - </b>"करणान्यङ्गचेष्टाः स्युः हरणं करणं समे" - वैज० ।<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಪೃಷ್ಟ ಮೊದಲಾದ ವರ್ಣೋಚ್ಚಾರಣೆಯ ಪ್ರಯತ್ನ<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧ್ಯಾನ<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರತಿಕ್ರೀಡೆಯಲ್ಲಿ ಒಂದುವಿಧವಾದ ಬಂಧ<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಾನ /ಹಾಡುವಿಕೆ<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಪಾರ /ಕಾರ್ಯ /ಕೆಲಸ<br><br>करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಖಸಂಧಿಯ ಒಂದು ಅಂಗ<br><br>करण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡುವ<br><b>प्रयोगाः - </b>"स्वराणामूष्मणां चैव विवृतं करणं स्मृतम्"<br><b>उल्लेखाः - </b>पा० शि०<br><b>विस्तारः - </b>"करणं कारणे काये साधने बवकादिषु । स्पृष्टाद्युच्चारणा भेदध्यानपद्मासनादिषु । रतिबन्धे नाट्यभेदे गीतके कर्मणीन्द्रिये ।" - वैज० ।<br><br>करण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಯಾರಿಸುವ /ನಿರ್ಮಾಣಮಾಡುವ<br><b>विस्तारः - </b>"उद्भेदः करणं भेदः एतान्यङ्गानि वै मुखे" - सा० द० ६-८२ । "करणं पुनः । प्रकृतार्थसमारम्भः" - सा० द० ६-८६<br><br>

करणकुतूहल
करणकुतूहल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭಾಸ್ಕರಾಚಾರ್ಯರಿಂದ ರಚಿತವಾದ ಒಂದು ಜ್ಯೋತಿಷ ಗ್ರಂಥ<br><br>

करणत्राण
करणत्राण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಲ್ಲಾ ಇಂದ್ರಿಯಗಳಿಂದಲೂ ರಕ್ಷಿಸಲ್ಪಡುವ ಅಥವಾ ಎಲ್ಲಾ ಇಂದ್ರಿಯಗಳನ್ನೂ ರಕ್ಷಿಸುವ ಶಿರಸ್ಸು /ತಲೆ<br><b>निष्पत्तिः - </b>त्रैङ् (पालने) - कर्म० "ल्युट्" (३-३-११३) । त्रैङ् (पालने) - करण० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>करणैः करचरणादिभिः त्रायते । करणानि ज्ञानकर्मेन्द्रियाणि त्रायन्तेऽनेन ।<br><br>

करणव्यापार
करणव्यापार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯಗಳ ವ್ಯಾಪಾರ /ಇಂದ್ರಿಯಗಳು ಮಾಡುವ ಕೆಲಸ<br><b>व्युत्पत्तिः - </b>करणानां व्यापारः<br><br>

करणाधिप
करणाधिप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯಗಳಿಗೆ ಒಡೆಯನಾದ ಜೀವ /ಜೀವಾತ್ಮ<br><br>करणाधिप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯಗಳ ಅಧಿಷ್ಠಾತೃ ದೇವತೆ<br><br>

करणिन्
करणिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯಗಳಿಂದ ಕೂಡಿದ ಜೀವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>करणान्यस्य सन्ति<br><br>करणिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಧನಗಳನ್ನು ಹೊಂದಿರುವ /ಸಲಕರಣೆಗಳಿಂದ ಕೂಡಿದ<br><br>

करणीय
करणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಶ್ಯವಾಗಿ ಮಾಡಲ್ಪಡಬೇಕಾದ /ಅವಶ್ಯವಾಗಿ ಮಾಡಬೇಕಾದ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - कर्म० "अनीयर्" (३-१-९६)<br><b>प्रयोगाः - </b>"आत्मनैव गुणदोषकोविदः किं न वेत्सि करणीयवस्तुषु"<br><b>उल्लेखाः - </b>माघ० १४-५४<br><br>

करण्ड
करण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೇನುಗೂಡು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - कर्म० "अण्डन्" (उ० १-१२६)<br><br>करण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಖಡ್ಗ /ಕತ್ತಿ<br><br>करण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಂಸದ ಒಂದು ಭೇದ<br><br>करण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬುಟ್ಟಿ /ಪೆಟ್ಟಿಗೆ<br><b>प्रयोगाः - </b>"भग्नाशस्य करण्डपिण्डततनोः म्लानेन्द्रियस्य सुधा"<br><b>उल्लेखाः - </b>भर्तु० १-८२<br><br>करण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿದಿರು ಬೆತ್ತ ಮೊದಲಾದುವುಗಳಿಂದ ನಿರ್ಮಿತವಾದ ಬುಟ್ಟಿ /ಹೂವು ವೀಳ್ಯದೆಲೆ ಮುಂತಾದುವುಗಳನ್ನು ಇಡುವ ಬುಟ್ಟಿ<br><br>

करण्डक
करण्डक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿದಿರು ಬೆತ್ತ ಮೊದಲಾದುವುಗಳಿಂದ ನಿರ್ಮಿತವಾದ ಬುಟ್ಟಿ /ಹೂವು ವೀಳ್ಯದೆಲೆ ಮುಂತಾದುವುಗಳನ್ನು ಇಡುವ ಬುಟ್ಟಿ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><b>प्रयोगाः - </b>"शुष्कवनलतानिर्मितमहाकुसुमकरण्डकेन"<br><b>उल्लेखाः - </b>कादं०<br><br>करण्डक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭರಣಿ /ಡಬ್ಬಿ<br><b>प्रयोगाः - </b>"दीपभाजनभ्रमरकरण्डकप्रभृत्यनेकोपकरणयुक्तः"<br><b>उल्लेखाः - </b>दशकु०<br><br>

करण्डिन्
करण्डिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ಸ್ಯ /ಮೀನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>करण्डस्तदाकारोऽस्यास्ति<br><b>विस्तारः - </b>"करण्डी तु जलेशयः । आत्माशी शम्बरो मूकः" - त्रिकाण्ड० ।<br><br>

करतल
करतल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸ್ತದ ಒಳಭಾಗ /ಅಂಗೈ<br><b>व्युत्पत्तिः - </b>करस्य तलम्<br><b>प्रयोगाः - </b>"वर्म करतलयुगेन महत्तनुचूर्णपेषमपिबद्रुषापरः"<br><b>उल्लेखाः - </b>माघ० १५-७६<br><br>

करतलामलक
करतलामलक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗೈಯಲ್ಲಿರುವ ನೆಲ್ಲಿಕಾಯಿ<br><b>व्युत्पत्तिः - </b>करतले आमलकम्<br><br>करतलामलक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗೈಯಲ್ಲಿರುವ ನೆಲ್ಲಿಕಾಯಿಯಂತೆ ಸ್ಪಷ್ಟವಾಗಿ ಕಾಣುವ<br><br>

करताल
करताल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಪ್ಪಾಳೆ /ಎರಡು ಕೈಗಳನ್ನು ತಟ್ಟುವಿಕೆ<br><br>करताल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಝಲ್ಲರಿಯೆಂಬ ಒಂದು ವಾದ್ಯ<br><b>व्युत्पत्तिः - </b>करेण तालो यस्य<br><b>प्रयोगाः - </b>"शिवागारे झल्लकं च सूर्यागारे च शङ्खकम् । दुर्गागारे वशंवाद्यं मधुरीं च न वादयेत् ॥"<br><br>

करताली
करताली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಝಲ್ಲರಿಯೆಂಬ ಒಂದು ವಾದ್ಯ<br><b>निष्पत्तिः - </b>गौरा० "ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>करेण तालो यस्याः<br><b>विस्तारः - </b>"करर्थिः करताली स्यात्" - त्रिकाण्ड० ।<br><br>

करतोया
करतोया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವಾಗಲೂ ನೀರು ಹರಿಯುತ್ತಿರುವ ಒಂದು ನದಿ<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>करतोयं हरपार्वतीविवाहच्युतजलमस्त्यस्याः<br><b>प्रयोगाः - </b>"प्रथमं कर्कटे देवी त्र्यङ्गं गङ्गा रजस्वला । सर्वा रक्तवहा नद्यः करतोयाऽम्बुवाहिनी ॥" " करतोयां समासाद्य त्रिरात्रो पोषितो नरः । अश्वमेधमवाप्नोति प्रजापतिकृतो विधिः ॥"<br><b>उल्लेखाः - </b>२)भा० वन० ८३-३<br><br>

करद
करद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೈಯನ್ನು ಕೊಡುವವನು /ರಕ್ಷಣೆಗಾಗಿ ಕೈ ನೀಡುವವನು<br><br>करद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂದಾಯ ಕೊಡುವವನು /ತೆರಿಗೆಯನ್ನು ಕೊಡುವವನು<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>करं हस्तं राजस्वं वा ददाति<br><b>प्रयोगाः - </b>"य इमे पृथिवीपालाः करदास्तव पार्थिव"<br><b>उल्लेखाः - </b>भा० वन० ८३-३<br><br>

करद्रुम
करद्रुम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರೆಗಿಡ<br><b>व्युत्पत्तिः - </b>किरति समन्तात् शाखाः । करश्चासौ द्रुमश्च ।<br><br>

करधृत
करधृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೈಯಿಂದ ಹಿಡಿಯಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>करेण धृतः<br><b>प्रयोगाः - </b>"तस्याः किञ्चित्करधृतमिव प्राप्तवानीरशाखं नीत्वा नीलं सलिलवसनं मुक्तरोधोनितम्बम्"<br><b>उल्लेखाः - </b>मेघ० १-४१<br><br>

करनिहित
करनिहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೈಯಲ್ಲಿ ಇದಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>करे निहितः<br><br>

करन्धम
करन्धम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಕ್ಷ್ವಾಕುವಂಶದ ಒಬ್ಬ ದೊರೆ /ಖನೀನೇತ್ರನೆಂಬ ಒಬ್ಬ ರಾಜನ ಮಗ<br><b>प्रयोगाः - </b>"विविंशतिसुतो राजा खनीनेत्रोऽस्य धार्मिकः । करन्धमो महाराज तस्यासीदात्मजो नृपः" ॥<br><b>उल्लेखाः - </b>भाग० ९-२-२५<br><br>

करन्यास
करन्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಂತ್ರದಲ್ಲಿ ಹೇಳಿರುವಂತೆ ಆಯಾ ಮಂತ್ರಪೂರ್ವಕ ಅಂಗುಷ್ಠ ಮೊದಲಾದ ಬೆರಳನ್ನು ಸ್ಪರ್ಶಿಸುವುದು<br><b>व्युत्पत्तिः - </b>करे करावयवे न्यासः<br><br>

करपत्त्र
करपत्त्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರವನ್ನು ಕೊಯ್ಯುವ ಗರಗಸ<br><b>निष्पत्तिः - </b>पत्लृ (गतौ) - "ष्ट्रन्" (उ० ४-१५८)<br><b>व्युत्पत्तिः - </b>करात् पतति<br><b>प्रयोगाः - </b>"स्फुटं स पत्त्रैः करपत्त्रमूर्तिभिः वियोगिहृद्दारुणि दारुणायते"<br><b>उल्लेखाः - </b>नैष० १-८०<br><br>करपत्त्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲಕ್ರೀಡೆ<br><b>व्युत्पत्तिः - </b>करावेन पत्त्रं वाहनं यत्र<br><br>

करपत्त्रवत्
करपत्त्रवत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾಳೆಗಿಡ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४) । मस्य वः (८-२-९)<br><b>व्युत्पत्तिः - </b>करपत्त्रं तदाकारः पत्रवृन्तेऽस्त्यस्य<br><br>

करपत्त्रिका
करपत्त्रिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲಕ್ರೀಡೆ<br><b>निष्पत्तिः - </b>"कप्" । अत इत्वम् ।<br><b>व्युत्पत्तिः - </b>करौ पत्रमिव अस्याः<br><br>

करपल्लव
करपल्लव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆರಳು<br><b>व्युत्पत्तिः - </b>करस्य पल्लव इव<br><br>करपल्लव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಗುರಿನಂತಿರುವ ಕೈ<br><b>व्युत्पत्तिः - </b>करः पल्लव इव<br><b>प्रयोगाः - </b>"हरिवीक्षणाक्षणिकचक्षुषान्यया करपल्लवेन गलदम्बरं दधे"<br><b>उल्लेखाः - </b>माघ० १३-४४<br><br>

करपात्र
करपात्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲಕ್ರೀಡೆ<br><b>व्युत्पत्तिः - </b>करः पात्रमिव यत्र<br><b>विस्तारः - </b>"करपात्रं जलक्रीडा व्यात्कुक्षिः करपत्रिका"- हारा० ।<br><br>करपात्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸ್ತರೂಪವಾದ ಪಾತ್ರೆ /ಹಸ್ತವೆಂಬ ಪಾತ್ರೆ<br><b>प्रयोगाः - </b>"करपात्रे स्थिते तोये कृत्वा मूत्रपुरीषके । आसुरं तद्भत्तोयं पीत्वा चान्द्रायणं चरेत् ॥"<br><br>

करपाल
करपाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಯನ್ನು ರಕ್ಷಿಸುವ ಖಡ್ಗ<br><b>निष्पत्तिः - </b>पाल (रक्षणे) + णिच् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>करं पालयति<br><br>करपाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೆರಿಗೆ ಇಲಾಖೆಯ ಮುಖ್ಯಾಧಿಕಾರಿ<br><br>

करपालक
करपालक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೆರಿಗೆ ಇಲಾಖೆಯ ಮುಖ್ಯಾಧಿಕಾರಿ<br><b>निष्पत्तिः - </b>पाल (रक्षणे) + णिच् - "ण्वुल्" (३-१-१३३)<br><br>

करपालिका
करपालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಈಳಿಗೆ ಮಣೆಯ ಕತ್ತಿ /ಒಂದೇ ಕಡೆ ಅಲುಗುಳ್ಳ ಸಣ್ಣಕತ್ತಿ<br><b>निष्पत्तिः - </b>पाल (रक्षणे) + णिच् - "ण्वुल्" (३-१-१३३) । स्त्रियां "टाप्" (४-१-४)। अत इत्वम् (७-३-४४)<br><br>करपालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕ ಗದೆಯಂತಿರುವ ಮರದ ಕೊಲು ಅಥವಾ ಮರದ ಕತ್ತಿ<br><br>

करपीडन
करपीडन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹ /ಮದುವೆ<br><b>व्युत्पत्तिः - </b>करस्य वधूहस्तस्य पीडनं ग्रहणं यत्र<br><b>प्रयोगाः - </b>"सुतपरिणयात्षण्मासान्तः सुताकरपीडनं न च निजकुले तद्वद्वा मण्डनादपि मुण्डनम्"<br><b>उल्लेखाः - </b>मु० चि०<br><br>

करपुट
करपुट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಮುಗಿಯಲು ಜೋಡಿಸಲ್ಪಡುವ ಹಸ್ತಗಳು<br><br>

कराञ्जलि
कराञ्जलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಮುಗಿಯಲು ಜೋಡಿಸಲ್ಪಟ್ಟ ಎರಡು ಕೈಗಳ ಬೊಗಸೆ<br><br>

करपुटी
करपुटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೊಗಸೆ /ಜೋಡಿಸಲ್ಪಟ್ಟ ಹಸ್ತಗಳು<br><br>

करपृष्ठ
करपृष्ठ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಯ ಹಿಂಭಾಗ<br><b>व्युत्पत्तिः - </b>करस्य पृष्ठम्<br><br>

करप्रचेय
करप्रचेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೈಯಿಂದ ತೆಗೆದುಕೊಳ್ಳಲು ಅರ್ಹವಾದ<br><b>व्युत्पत्तिः - </b>करेण प्रचेया<br><b>प्रयोगाः - </b>"करप्रचेयामुत्तुङ्गः प्रभुशक्तिं प्रथीयसीम्"<br><b>उल्लेखाः - </b>माघ० २-८९<br><br>करप्रचेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆರಿಗೆಯಿಂದ ಹೆಚ್ಚಿಸಲ್ಪಡುವ /ಕಂದಾಯದಿಂದ ಅಭಿವೃದ್ಧಿಪಡಿಸಲ್ಪಡುವ<br><br>

करप्रद
करप्रद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೈಯನ್ನು ಕೊಡುವ<br><br>करप्रद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆರಿಗೆಯನ್ನು ಕೊಡುವ<br><b>निष्पत्तिः - </b>प्र + डुदाञ् (दाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>करं प्रददाति<br><br>

करबदर
करबदर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಯಲ್ಲಿರುವ ಎಲಚಿಹಣ್ಣು<br><b>व्युत्पत्तिः - </b>करे बदरम्<br><b>प्रयोगाः - </b>"करबदरसमानं प्रेक्ष्य दृष्ट्या प्रतीच्या"<br><b>उल्लेखाः - </b>चं० रा०<br><br>करबदर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೈಯಲ್ಲಿರುವ ಬೋರೆಹಣ್ಣಿನಂತೆ ಎಲ್ಲಾ ಭಾಗಗಳಲ್ಲಿಯೂ ಸ್ಪಷ್ಟವಾಗಿ ಕಾಣುವ<br><b>व्युत्पत्तिः - </b>करे बदरमिव<br><br>

करभ
करभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಣಿಕಟ್ಟಿನಿಂದ ಕಿರುಬೆರಳವರೆಗಿನ ಹಸ್ತದ ಹೊರಭಾಗ /ಮುಂಗೈ ಮೊದಲುಗೊಂಡು ಕಿರು ಬೆರಳವರೆಗಿನ ಕೈಯ ಹೊರಭಾಗ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "अभच्" (उ० ३-१२२)<br><b>व्युत्पत्तिः - </b>किरत्यनेन<br><b>प्रयोगाः - </b>"सा चूर्णगौरं रगुनन्दनस्य धात्रीकराभ्यां करभोपमोरूः"<br><b>उल्लेखाः - </b>रघु० ६-८३<br><br>करभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಮರಿ<br><br>करभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಷ್ಟ್ರ /ಒಂಟೆ<br><br>करभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂಟೆಯ ಮರಿ<br><b>प्रयोगाः - </b>"संविव्युरम्बरविकाशि चमूसमुत्थं पृथ्वीरजः करभकण्ठकडारमाशाः"<br><b>उल्लेखाः - </b>माघ० ५-३<br><br>करभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಖರ /ಗರ್ಧಭ<br><b>विस्तारः - </b>"करभोऽपि करोष्ट्रयोः" - वैज० । "करभो मणिबन्धादिकनिष्ठान्तोष्ट्रतत्सुते" - मेदि० ।<br><br>करभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಸರಕತ್ತೆ<br><br>करभ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಖಿಯೆಂಬ ಒಂದು ಗಂದಿಗರ ವಸ್ತು /ಸುಗಂಧವಸ್ತು<br><br>करभ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸ್ತನಕ್ಷತ್ರ<br><br>

करभी
करभी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂಟೆಯ ಮರಿ<br><br>करभी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಸರಕತ್ತೆ<br><b>प्रयोगाः - </b>"क्षिप्तावरोधाङ्गनमुत्पथन् गां विलङ्घ्य लघ्वीं करभौ बभञ्जतुः"<br><b>उल्लेखाः - </b>माघ० १२-२४<br><br>

करभक
करभक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>करभ ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><br>

करभिका
करभिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>करभ ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्" (४-१-४)<br><br>

करभकाण्डिका
करभकाण्डिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂಟೆಗೆ ಪ್ರಿಯವಾದ ಉಷ್ಟ್ರಕಾಂತಿಯೆಂಬ ಗಿಡ<br><br>

करभवल्लभ
करभवल्लभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೋನುಮರ<br><br>करभवल्लभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಲದ ಮರ<br><b>व्युत्पत्तिः - </b>करभस्य गजपोतस्य वल्लभः<br><br>

करभिन्
करभिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಜ /ಆನೆ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>करभः, करावयवः । तदाकारा शुण्डास्त्यस्य<br><br>

करभीर
करभीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಿಂಹ<br><b>निष्पत्तिः - </b>ईर (गतौ कम्पने च) + णिच् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>करभिणमीरयति पलायनाय प्रेरयति<br><br>

करभूषण
करभूषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸ್ತಾಭರಣ /ಕಂಕಣ /ಬಳೆ<br><b>व्युत्पत्तिः - </b>करस्य भूषणम्<br><br>

करभोरू
करभोरू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರದಂತೆ ಸುಂದರವಾದ ತೊಡೆಯುಳ್ಳ ಉತ್ತಮಜಾತಿಯ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>"ऊङ्" (४-१-६९)<br><b>व्युत्पत्तिः - </b>करभाविव ऊरू यस्याः<br><b>प्रयोगाः - </b>"उपेक्षितेक्षोः करभाच्छमीरतादुरुं वदे त्वां करभोरु भोरिति"<br><b>उल्लेखाः - </b>नैष० ९-४३<br><br>

करमट्ट
करमट्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುವಾಕವೃಕ್ಷ /ಅಡಕೆ ಮರ<br><b>निष्पत्तिः - </b>अट्ट (अनादरे) बाहु० "खच्" मुमागमः ।<br><b>व्युत्पत्तिः - </b>करं हस्तिशुण्डां अट्टति<br><b>विस्तारः - </b>"करमट्टस्तन्तुसारो गुवाकः कोट इत्यपि"- त्रिकाण्ड०<br><br>

करमरिन्
करमरिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈದಿ /ಸೆರೆಹಿಡಿಯಲ್ಪಟ್ಟ ಅಪರಾಧಿ /ಬಂದಿ /ಸೆರೆಯಾಳು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>करः कारागारः, तस्मिन् मरः मरणवत् यातनास्त्यस्य<br><b>विस्तारः - </b>"उपग्रहस्तु ग्राहः स्यात् बन्दी करमरीत्यपि"- त्रिकाण्ड० ।<br><br>

करमर्द
करमर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮರಿಕೆ ಗಿಡ<br><b>निष्पत्तिः - </b>मृद (क्षोदे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>करं मृद्नाति<br><br>

करमर्दक
करमर्दक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮರಿಕೆ ಗಿಡ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><br>

करमर्दिन्
करमर्दिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮರಿಕೆ ಗಿಡ<br><b>निष्पत्तिः - </b>मृद (क्षोदे) - "णिनिः" (३-२-७८)<br><br>

करमाल
करमाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಗೆ /ಧೂಮ<br><b>व्युत्पत्तिः - </b>करः हस्तिशुण्डादण्ड इव मालाऽस्य<br><br>

करमाला
करमाला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಪಮಾಡುವಾಗ ಎಣಿಕೆಗಾಗಿ ಉಪಯೋಗಿಸುವ ಕೈಬೆರಳ ಗಿಣ್ಣುಗಳ ಮಾಲೆ<br><b>व्युत्पत्तिः - </b>करः कराङ्गुलिपर्व मालेव<br><b>विस्तारः - </b>"आरभ्यानामिकामध्यं दक्षिणावर्तयोगतः । तर्जनीमूलपर्यन्तं करमाला प्रकीर्तिता ॥"<br><br>

करमुक्त
करमुक्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಯಲ್ಲಿ ಹಿಡಿಸು ವೇಗವಾಗಿ ಎಸೆಯಲ್ಪಡುವ ಒಂದು ಆಯುಧ<br><b>निष्पत्तिः - </b>मुच्लृ (मोक्षणे) - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>करे धृत्वा मुच्यते<br><br>

करम्ब
करम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಿಶ್ರಣ /ಬೆರಕೆ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - भावे "अम्भच्" (उ० ४-८२)<br><br>करम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಸರಿನಲ್ಲಿ ಕಲೆಸಿದ ಅನ್ನ<br><b>विस्तारः - </b>"करम्भः सेकमिश्रान्ने" - वैज० ।<br><br>करम्ब<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಿಶ್ರಿತವಾದ /ಬೆರೆಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - कर्म० "अम्भच्" (उ० ४-८२)<br><br>

करम्बित
करम्बित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಿಶ್ರವಾದ /ಬೆರಕೆಯುಂಟಾಗಿರುವ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>करम्भोऽस्य सञ्जातः<br><b>प्रयोगाः - </b>"क्रियाः प्रियाया ललितैः करम्बिता वितर्कयन्नित्थमलीकमालपत्"<br><b>उल्लेखाः - </b>नैष० ९-१०२<br><br>

करम्भ
करम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಸರಿನಲ್ಲಿ ಕಲಸಿದ ಹುರಿಹಿಟ್ಟು<br><b>निष्पत्तिः - </b>रभ (राभस्ये) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>केन जलेन रभ्यते<br><b>विस्तारः - </b>"करम्भा दधिसक्तवः" - अम० ।<br><br>करम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುರಿಯಲ್ಪಟ್ಟ ಧಾನ್ಯ<br><b>प्रयोगाः - </b>"करम्भवालुकातापान् कुम्भीपाकांश्च दारुणान्"<br><b>उल्लेखाः - </b>मनु० १२-७६<br><br>करम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆರಕೆ ವಾಸನೆ<br><b>प्रयोगाः - </b>"करम्भपूतिसौरभ्यशान्तोग्राम्लादिभिः पृथक्"<br><b>उल्लेखाः - </b>भाग० ३-२६-४५<br><br>

करम्भक
करम्भक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆರಕೆ ವಾಸನೆ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><br>

करम्भा
करम्भा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶತಾವರಿ ಗಿಡ<br><br>करम्भा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೇಂಕಣ ಗಿಡ<br><br>करम्भा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುರುವಂಶದ ಅಕ್ರೋಧನನ ಪತ್ನಿ<br><br>

करम्भि
करम्भि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯದುವಂಶದ ಒಬ್ಬ ದೊರೆ<br><b>प्रयोगाः - </b>"करम्भिः शकुनेः पुत्रः देवरातस्तदात्मजः"<br><b>उल्लेखाः - </b>भाग० ९-२४-५<br><br>

कररुह
कररुह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಖ /ಉಗುರು<br><b>निष्पत्तिः - </b>रुह (बीजजन्मादौ) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>करे रोहति<br><b>प्रयोगाः - </b>"अनाघ्रातं पुष्पं किसलयमलूनं कररुहैरनाविद्धं रत्नं मधु नवमनास्वादितरसम्"<br><b>उल्लेखाः - </b>शाकु० २-१०<br><br>कररुह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೈಯಲ್ಲಿ ಬೆಳೆದಿರುವ<br><br>

करर्द्धि
करर्द्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಚಿನ ಕೈತಾಳ /ಕೈಯಿಂದ ಕುಟ್ಟುವ ತಾಳ /ಝಲ್ಲರಿ<br><b>व्युत्पत्तिः - </b>करे ऋद्धिर्यत्र<br><br>करर्द्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸ್ತಸಂಪತ್ತು<br><b>विस्तारः - </b>"करर्द्धिः करताली स्यात्"- त्रिकाण्ड० ।<br><br>

करवाल
करवाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಖಡ್ಗ /ಕತ್ತಿ<br><b>निष्पत्तिः - </b>वल (संवरणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>करं वलति<br><b>प्रयोगाः - </b>"हसितुं परेण परितः परिस्फुरत्करवालकोमलरुचावुपेक्षितैः"<br><b>उल्लेखाः - </b>माघ० ३-६०<br><br>

करवी
करवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಗುಪತ್ರ /ಹಿಂಗಿನ ಎಲೆ<br><b>निष्पत्तिः - </b>गौरा० "ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>कस्य वायोः रवोऽत्र<br><b>विस्तारः - </b>"जतुकं हिङ्गुरामठम् । पत्रेऽस्य करवी बाष्पी" - वैज० ।<br><br>

करवीर
करवीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಖಡ್ಗ /ಕತ್ತಿ<br><b>निष्पत्तिः - </b>वीर (विक्रान्तौ) + णिच् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>करं वीरयति<br><br>करवीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗನ್ನೇರಳೆ ಗಿಡ<br><br>करवीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ದೈತ್ಯ<br><b>विस्तारः - </b>"करवीरः कृपाणे स्याद्दैत्यभेदाश्वमारयोः" - मेदि० ।<br><br>करवीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸರ್ಪ<br><b>प्रयोगाः - </b>"करवीरः पुष्पदंष्ट्रो बिल्वाको बिल्वपाण्डुरः । मूषकादः शङ्खशिराः पूर्णभद्रो हरिद्रकः ॥"<br><b>उल्लेखाः - </b>भा० आदि० २५-१२<br><br>करवीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೃಷದ್ವತೀನದಿಯ ತೀರದಲ್ಲಿರುವ ಒಂದು ಪಟ್ಟಣ /ಚಂದ್ರಶೇಖರರಾಜನ ರಾಜಧಾನಿ<br><br>करवीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇರುಪರ್ವತಕ್ಕೆ ದಕ್ಷಿಣದಲ್ಲಿರುವ ಒಂದು ಪರ್ವತ<br><b>प्रयोगाः - </b>"एवमपरेण पवनपारियात्रौ दक्षिणेन कैलासकरवीरौ प्रागायतावेवमुत्तरतः त्रिश्रृङ्गमकरावष्टभिरेतैः परिस्तृतोऽग्निरिव परितश्चकास्ति काञ्चनगिरिः"<br><b>उल्लेखाः - </b>भाग० ५-१६-२७<br><br>

करवीरक
करवीरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತಿ ಮರ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><b>व्युत्पत्तिः - </b>करवीर इव कायति<br><br>करवीरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಖಡ್ಗ /ಕತ್ತಿ<br><b>निष्पत्तिः - </b>वीर (विक्रान्तौ) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>करं वीरयति<br><br>

करवीरा
करवीरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಪುಮೆಣಶಿಲೆ<br><br>

करवीरिका
करवीरिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಗರಿ<br><b>विस्तारः - </b>"आढकी तुवरी वल्ला सौराष्ट्री करवीरिका" - वैज० ।<br><br>

करवीरपुर
करवीरपुर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾಲಕ್ಷ್ಮಿಯ ವಾಸಸ್ಥಾನವಾದ ಕೊಲ್ಲಾಪುರ<br><br>

करवीरी
करवीरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅದಿತಿ<br><br>करवीरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ ಹಸು<br><br>करवीरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರವತಿಯಾದ ಹೆಂಗಸು<br><b>व्युत्पत्तिः - </b>करः सुखप्रदः वीरः पुत्रो यस्याः<br><b>विस्तारः - </b>"करवीर्यदितिश्रेष्ठगवीपुत्रवतीषु च" - मेदि० ।<br><br>

करवीर्य
करवीर्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಯುರ್ವೇದ ಜ್ಞಾನಸಂಪಾದನೆಗಾಗಿ ಧನ್ವಂತರಿಯನ್ನು ಪ್ರಶ್ನಿಸಿದ ಒಬ್ಬ ಋಷಿ<br><b>प्रयोगाः - </b>"काशिराजं दिवोदासं धन्वन्तरिमौपधेनववैतरणौरभ्रपौष्कलावतकरवीर्यगोपुररक्षितसुश्रुतप्रभृतयः ऊचुः"<br><b>उल्लेखाः - </b>सुश्रुत० सूत्र० १-३<br><br>

करशाखा
करशाखा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆರಳು<br><b>व्युत्पत्तिः - </b>करस्य शाखेव<br><br>

करशीकर
करशीकर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಆನೆಯ ಸೊಂಡಿಲಿನಿಂದ ಹೊರಟ ನೀರಿನ ತುಂತುರು<br><b>व्युत्पत्तिः - </b>करस्य शीकरः<br><b>प्रयोगाः - </b>"उद्यन्तमग्निं शमयाम्बभूवुर्गजा विविग्नाः करशीकरेण"<br><b>उल्लेखाः - </b>रघु० ७-४८<br><br>

करशुद्धि
करशुद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಫಟ್ ಮಂತ್ರ ಮತ್ತು ಪುಷ್ಪಗಳಿಂದ ಮಾಡುವ ಹಸ್ತಶುದ್ಧಿ<br><b>व्युत्पत्तिः - </b>करस्य शुद्धिः शोधनम्<br><b>प्रयोगाः - </b>"आदावृष्यादिकन्यासः करशुद्धिस्ततःपरम्"<br><b>उल्लेखाः - </b>तन्त्रसा०<br><br>

करशूक
करशूक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಖ /ಉಗುರು<br><b>व्युत्पत्तिः - </b>करस्य शूकः सूचीव<br><b>प्रयोगाः - </b>"नखः पुनर्भवः कामांशुकः करकण्टकः । करेटुः करशूकश्च" - त्रिकाण्ड० ।<br><br>

करस्थ
करस्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೈಯಲ್ಲಿರುವ<br><br>करस्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಾಧೀನವಾಗಿರುವ<br><b>निष्पत्तिः - </b>ष्ठा (गतिनिवृत्तौ) - "कः" (३-२-४) ।<br><b>व्युत्पत्तिः - </b>करे तिष्ठति<br><br>

करसूत्र
करसूत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಕಣ /ವಿವಾಹ ಮುಂತಾದಶುಭಕಾರ್ಯಗಳಲ್ಲಿ ಕೈಗೆ ಕಟ್ಟುವ ಮಂಗಳ ಸೂತ್ರ<br><b>व्युत्पत्तिः - </b>करस्य सूत्रम्<br><br>

करहाट
करहाट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾವರೆಯ ಗೆಡ್ಡೆ<br><b>निष्पत्तिः - </b>हट (दीप्तौ) + णिच् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>करं हाटयति<br><br>करहाट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪದ್ಮ ಮೊದಲಾದ ಪುಷ್ಪ<br><b>निष्पत्तिः - </b>हट (दीप्तौ) - कर्म० "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>करैः सूर्यकिरणैः हाट्यते<br><br>करहाट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಗಾರೆ ಗಿಡ<br><br>

करहाटक
करहाटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಗಾರೆ ಗಿಡ<br><b>निष्पत्तिः - </b>हट (दीप्तौ) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>करं हाटयति<br><br>करहाटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದೇಶ<br><b>प्रयोगाः - </b>"नगरीं सञ्जयन्तीं च पाषण्डं करहाटकम्"<br><b>उल्लेखाः - </b>भा० सभा० ३२-७२<br><br>

कराङ्गण
कराङ्गण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೆರಿಗೆಯನ್ನು ತೆಗೆದುಕೊಳ್ಳುವ ಜಾಗ<br><b>व्युत्पत्तिः - </b>करस्य राजस्वादानस्याङ्गणम्<br><br>कराङ्गण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾರುಕಟ್ಟೆ /ಅನೇಕ ಜನರಿಂದ ನಿಬಿಡವಾದ ಅಂಗಡಿಬೀದಿ<br><b>विस्तारः - </b>"बहुमानुषसङ्कीर्णं निर्घटं च कराङ्गणम्" - हारा० ।<br><br>

करामर्द
करामर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮರಿಕೆ ಗಿಡ<br><b>निष्पत्तिः - </b>आ + मृद (क्षोदे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>करमामृद्नाति<br><br>

कराम्बुक
कराम्बुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮರಿಕೆ ಗಿಡ<br><b>निष्पत्तिः - </b>"कप्" (५-४-१५४)<br><b>व्युत्पत्तिः - </b>करं कीर्यमाणमम्बु यस्मात्<br><br>

करारोट
करारोट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗುಳೀಯಕ /ಉಂಗುರ<br><b>निष्पत्तिः - </b>आ + रुट (प्रतिघाते) - "अच्" (३--१३४)<br><b>व्युत्पत्तिः - </b>करे आरोटते<br><b>विस्तारः - </b>"करारोटोऽङ्गुलीटः स्यात्" - त्रिकाण्ड० ।<br><br>

कराल
कराल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಜರಸಯುಕ್ತವಾದ ತೈಲ /ಮತ್ತಿ ಹಾಲಿನೊಡನೆ ಬೆರೆತ ಎಣ್ಣೆ<br><b>निष्पत्तिः - </b>अल (भूषणादौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कराय विक्षेपाय अलति पर्याप्नोति<br><br>कराल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಣ್ಣೆ ಅಥವಾ ತುಪ್ಪದಲ್ಲಿ ಪಕ್ವವಾದ ಸಂಬಾರ<br><b>प्रयोगाः - </b>"तप्तस्नेहे पचेत् पूर्वं वेशवारकसञ्ज्ञकम् । पाकप्रापितसौरभ्यं करालं सूदकैर्मतम् ॥"<br><br>कराल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜನಕಮಹಾರಾಜನ ವಂಶದ ಒಬ್ಬ ದೊರೆ<br><br>कराल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ದೈತ್ಯ<br><b>प्रयोगाः - </b>"ससृमः कालवदनः करालः कौशिकः शरः"<br><b>उल्लेखाः - </b>हरिवं०<br><br>कराल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಸ್ತೂರಿಮೃಗ<br><b>प्रयोगाः - </b>"एणहरिणर्क्षकुरङ्गकरालकृतमालशरभश्वदंष्ट्रा पृषतचारुष्कमृगमातृकाप्रभृतयो जङ्घालाः मृगाः कषाया मधुराः लघवः वातपित्तहराः तीक्ष्णाः हृद्याः बस्तिविशोधनास्च"<br><b>उल्लेखाः - </b>सुश्रुत० सूत्र० ४६-५४<br><br>कराल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದಂತರೋಗ<br><b>प्रयोगाः - </b>"शनैः शनैर्विकुरुते वायुर्दन्तसमाश्रयः । करालान् विकृतान् दन्तान् करालो न स सिध्यति ॥"<br><br>कराल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣ ತುಲಸಿ<br><br>कराल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉನ್ನತವಾದ /ಎತ್ತರವಾದ<br><br>कराल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉನ್ನತವಾದ ಹಲ್ಲುಗಳುಳ್ಳವನು /ಎತ್ತರವಾದ ಹಲ್ಲುಗಳುಳ್ಳವನು<br><br>कराल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯಂಕರವಾದ<br><b>प्रयोगाः - </b>"वपुर्महोरगस्येव करालफणमण्डलम्"<br><b>उल्लेखाः - </b>रघु० १२-९८<br><br>

करालक
करालक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯಂಕರವಾದ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><br>

करालकर
करालकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯಂಕರವಾದ ತೋಳುಗಳುಳ್ಳವನು<br><br>करालकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯಂಕರವಾದ ಸೊಂಡುಲುಳ್ಳ ಆನೆ<br><br>

करालवैभव
करालवैभव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ತಂತ್ರದ ಹೆಸರು<br><b>प्रयोगाः - </b>"करालभैरवं चापि यामलं वाममाश्रितम् । एवंविधानि चान्यानि मोहनार्थानि यानि तु । मया सृष्टानि चान्यानि मोहायैषां भवार्णवे ॥"<br><b>उल्लेखाः - </b>कूर्मपु०<br><br>

करालम्ब
करालम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈನೀಡುವಿಕೆ /ಆಸರೆ /ಸಾಹಾಯ್ಯ /ಒತ್ತಾಸೆ<br><b>व्युत्पत्तिः - </b>करस्यालम्भः<br><b>प्रयोगाः - </b>"स्खलतो हि करालम्भः सुहृत्सचिवचेष्टितम्"<br><b>उल्लेखाः - </b>हितो० ३-१३४<br><br>करालम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈ ನೀಡಿ ಒತ್ತಾಸೆ ಕೊಡುವಿಕೆ /ಆಶ್ರಯ ಕೊಡುವಿಕೆ /ಸಾಹಾಯ್ಯ ಮಾಡುವಿಕೆ<br><br>

करालम्बन
करालम्बन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>करालम्ब ಪದದ ಅರ್ಥ<br><b>व्युत्पत्तिः - </b>करस्यालम्बनम्<br><br>

करावलम्ब
करावलम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>करालम्ब ಪದದ ಅರ್ಥ<br><b>व्युत्पत्तिः - </b>करस्वावलम्भः<br><br>

करावलम्बन
करावलम्बन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>करालम्ब ಪದದ ಅರ್ಥ<br><b>व्युत्पत्तिः - </b>करस्यावलम्बनम्<br><br>

कराला
कराला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ<br><b>प्रयोगाः - </b>"करालायतनाच्चायमुच्चरन् करुणद्वनिः । विभाव्यते ननु स्थानमनिष्टानां तदीदृशाम्"<br><b>उल्लेखाः - </b>मालती० ५-२१<br><br>कराला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೊಗದೆ ಗಿಡ<br><br>

करालास्य
करालास्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯಂಕರವಾದ ಮುಖವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>करालमास्यं यस्य<br><br>

करालिक
करालिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಕ್ಷ /ಮರ<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५) । "कप्" वा ।<br><b>व्युत्पत्तिः - </b>करालमुच्चं शिखरमस्त्यस्य । कराणां करतुल्यशाखानामालिर्यत्र<br><b>विस्तारः - </b>"नन्द्यावर्तकरालिकौ तरुवसू पर्णी पुलाक्यंह्रिपः" - अभि० चि० ।<br><br>करालिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಖಡ್ಗಧಾರಿ /ಕತ್ತಿ ಹಿಡಿದವನು<br><br>करालिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಖಡ್ಗ /ಕತ್ತಿ<br><b>विस्तारः - </b>"खड्गिखड्गौ करालिकौ" - वैज० ।<br><br>

करालिका
करालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರ್ವತಿ<br><b>विस्तारः - </b>"एकपर्णा भद्रकाली महाकाली करालिका" - वैज० ।<br><br>

करालित
करालित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯಪಡಿಸಲ್ಪಟ್ಟ /ಹೆದರಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"एकस्यास्तपनकरैः करालिताया बिभ्राणः सपदि सितोष्णवारणत्वम्"<br><b>उल्लेखाः - </b>माघ० ८-४<br><br>

कराली
कराली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ೭ ಜಿಹ್ವೆಗಳಲ್ಲೊಂದು<br><b>निष्पत्तिः - </b>कराल - "ङीप्" (४-१-१५)<br><b>प्रयोगाः - </b>"काली कराली च मनोजवा च सुलोहिता या च सुधम्रवर्णा । स्फुलिङ्गिनी विश्वरूपी च देवी लेलायमाना इति सप्त जिह्वाः ॥"<br><b>उल्लेखाः - </b>मुण्डक० १-२-४<br><br>

करास्फोट
करास्फोट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಹೊಡೆತ /ಕೈಏಟು<br><br>करास्फोट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೋಳು ತಟ್ಟುವಿಕೆ /ಒಂದು ತೋಳನ್ನು ಮಡಿಸಿಕೊಂಡು ಎದೆಯ ಮೇಲಿಟ್ಟು ಇನ್ನೊಂದು ಕೈಯಿಂದ ಹೊಡೆಯುವುದು<br><b>व्युत्पत्तिः - </b>करस्य आस्फोटः शब्दो यत्र<br><br>

करिक
करिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಂಧವುಳ್ಳ ಕಗ್ಗಲಿ ಮರ<br><br>

करिका
करिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಖಕ್ಷತ /ಉಗುರಿನ ಗಾಯ<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७) । स्वार्थे "कः" (५-४-५)<br><b>व्युत्पत्तिः - </b>करो विलेखनमस्त्ययाम्<br><b>प्रयोगाः - </b>"सततमसुमतामगम्यरूपाः परिणतदिक्करिकास्तटीर्बिभर्ति"<br><b>उल्लेखाः - </b>माघ० ४-२९<br><b>विस्तारः - </b>"दिग्दष्टे वर्तुलाकारे करिका नखरेखिका" - वैज० ।<br><br>

करिगर्जित
करिगर्जित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಗರ್ಜನೆ /ಆನೆಯ ಕೂಗು<br><b>व्युत्पत्तिः - </b>करिणो गर्जनम्<br><br>

करिणी
करिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣಾನೆ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५) । "ङीप्" (४-१-५)<br><b>व्युत्पत्तिः - </b>करोऽस्त्यस्याः<br><b>प्रयोगाः - </b>"रथवाजिपत्तिकरिणीसमाकुलं तदनीकयोः समगत द्वयं मिथः"<br><b>उल्लेखाः - </b>माघ० १३-१७<br><br>करिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>೧೮ನೆಯ ಛಂದಸ್ಸಿನ ಒಂದು ವೃತ್ತ<br><b>प्रयोगाः - </b>"सनजा अपि नभसाश्शरयतिभिर्यदि करिणी"<br><b>उल्लेखाः - </b>वृ० र०<br><br>करिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣಾನೆ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्"(४-१-५)<br><br>

करिदारक
करिदारक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯನ್ನು ಸೀಳುವ ಸಿಂಹ<br><b>निष्पत्तिः - </b>दॄ (विदारणे) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>करिणं दारयति<br><br>

करिदारिका
करिदारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯನ್ನು ಸೀಳುವ ಹೆಣ್ಣು ಸಿಂಹ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्" (४-१-४)<br><br>

करिन्
करिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಜ /ಆನೆ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>करोऽस्यास्ति<br><b>प्रयोगाः - </b>"आक्षिप्याभिदिवं नीताः पत्तयः करिभिः करैः"<br><b>उल्लेखाः - </b>कुमा० १६-३६<br><br>

करिणी
करिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಂಟು ಸಂಖ್ಯೆ<br><b>प्रयोगाः - </b>"म्सौजोजो भरसंयुतः करिबाणकैर्हरिणप्लुतम्"<br><b>उल्लेखाः - </b>वृ० र०<br><br>

करिप
करिप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾವಟಿಗ /ಆನೆಯ ರಕ್ಷಕ<br><b>निष्पत्तिः - </b>पा (रक्षणे) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>करिणं पाति<br><br>

करिपत्र
करिपत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಳೀಪತ್ರೆ<br><br>

करिपिप्पली
करिपिप्पली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಜಹಿಪ್ಪಲಿ<br><br>

करिपोत
करिपोत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಮರಿ<br><b>व्युत्पत्तिः - </b>करिणः पोतः<br><br>

करिशावक
करिशावक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಮರಿ<br><b>व्युत्पत्तिः - </b>करिणः शावकः<br><br>

करिबन्ध
करिबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯನ್ನು ಕಟ್ಟುವ ಕಂಬ<br><b>निष्पत्तिः - </b>बन्ध (बन्धने) - अधि० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>करिणं बध्नात्यत्र<br><b>विस्तारः - </b>"प्रारब्धिः करिबन्धः स्यात्" - हारा०<br><br>करिबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯನ್ನು ಕಟ್ಟುವಿಕೆ<br><b>निष्पत्तिः - </b>बन्ध (बन्धने) - भावे "घञ्" (३-३-१८)<br><br>

करिमुख
करिमुख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಜಾನನ /ಗಣಪತಿ<br><b>व्युत्पत्तिः - </b>करिणो मुखं यस्य<br><br>करिमुख<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಮುಖ<br><b>व्युत्पत्तिः - </b>करिणो मुखम्<br><br>

करिरत
करिरत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ರತಿಕ್ರೀಡೆ<br><br>करिरत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರತಿಬಂಧದ ಒಂದು ಭೇದ<br><b>विस्तारः - </b>"भूगतस्तनभुजास्यमस्तकामुन्नतां स्वयमधोमुखीं स्त्रियम् । क्रामति स्वरकरकृष्टमेहने वल्लभे करिरतं तदुच्यते ॥"<br><br>

करिष्यत्
करिष्यत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದೆ ಕೆಲಸಮಾಡುವ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - कर्त० "ल्युट्" "शतृ" (३-३-१४)<br><br>

करिष्यन्ती
करिष्यन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂದೆ ಕೆಲಸಮಾಡುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

करिष्यमाण
करिष्यमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದೆ ಕೆಲಸ ಮಾಡುವವನು<br><br>करिष्यमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಂದೆ ಮಾಡಲ್ಪಡುವ ಕೆಲಸ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - भविष्यति कर्त० कर्म० वा "शानच्" (३-२-१२४)<br><br>

करिस्कन्ध
करिस्कन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಗಳ ಗುಂಪು /ಗಜ ಸಮೂಹ<br><b>व्युत्पत्तिः - </b>करिणां स्कन्धः समूहः<br><br>करिस्कन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಹೆಗಲು<br><br>

करीर
करीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿದಿರಿನ ಮೊಳಕೆ ಅಥವಾ ಗಿಣ್ಣು<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - ईरन् (उ० ४-३०)<br><b>व्युत्पत्तिः - </b>किरति<br><b>प्रयोगाः - </b>"वेणोः करीराः गुरवः कफमारुतकोपनाः"<br><b>उल्लेखाः - </b>सुश्रुत० सूत्र० ४६-३०५<br><br>करीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಳಕೆ<br><b>प्रयोगाः - </b>"हिमांशुवंशस्य करीरमेव मां निशम्य किं नासि फलेग्रहिग्रहा"<br><b>उल्लेखाः - </b>नैष० ९-१२<br><br>करीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಘಟ /ಹೂಜಿ<br><br>करीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರಳುಭೂಮಿಯಲ್ಲಿ ಬೆಳೆಯುವ ಒಂಟೆಗೆ ಪ್ರಿಯವಾದ ಒಂದು ಮುಳ್ಳುಗಿಡ<br><br>करीर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆನೆಯನ್ನು ತಳ್ಳುವ /ಆನೆಯನ್ನು ಹೊಡೆದೋಡಿಸುವ<br><b>निष्पत्तिः - </b>ईर (गतौ) - "अण्"(३-२-१)<br><b>व्युत्पत्तिः - </b>करिणो गजानीरयति<br><b>प्रयोगाः - </b>"कोरकाकारकारकः करीरः कर्कतोऽर्करुक्"<br><b>उल्लेखाः - </b>माघ० १९-१०४<br><br>

करीरिका
करीरिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಜದಂತಮೂಲ /ಆನೆಯ ಕೊಂಬಿನ ಬುಡ<br><b>विस्तारः - </b>"नासापूर्वं स्थूलहस्तं दन्तमूले करीरिका" - त्रिकाण्ड० ।<br><br>

करीरी
करीरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಜದಂತಮೂಲ /ಆನೆಯ ಕೊಂಬಿನ ಬುಡ<br><br>करीरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜೀರುಂಡೆ ಹುಳ<br><b>विस्तारः - </b>"करीरो वंशाङ्कुरेऽस्त्री वृक्षाभिद्घटयोः पुमान् । करीरी चीरिकायां च दन्तमूले च दन्तिनाम्" - मेदि० ।<br><br>

करीष
करीष<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸುವುನ ಒಣಗಿದ ಸಗಣಿ /ಬೆರಣಿ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "ईषन्" (उ० ४-२६)<br><b>प्रयोगाः - </b>"तृणे तृणेढि ज्वलनः खलु ज्वलन् क्रमात् करीषद्रुमकाण्डमण्डलम्"<br><b>उल्लेखाः - </b>नैष० ९-१५२<br><b>विस्तारः - </b>"करीषोऽस्त्री शुष्कगोमये" - सि० कौ०<br><br>करीष<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಶುಗಳ ಮಲ / ಮೃಗಗಳ ಪುರೀಷ<br><b>प्रयोगाः - </b>"ददर्श च वने तस्मिन् महतः सञ्चयान् कृतान् । मृगाणां महिषाणां च करीषैः शीतकारणात् ॥"<br><b>उल्लेखाः - </b>रामा०<br><br>

करीषङ्कष
करीषङ्कष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಾಳಿ<br><b>निष्पत्तिः - </b>कष (हिंसायाम्) - "खच्" (३-२-४२)<br><b>व्युत्पत्तिः - </b>करीषं कषति<br><b>विस्तारः - </b>ಸಗಣಿಯನ್ನು ಒಣಗಿಸುವುದರಿಂದ ಗಾಳಿಗೆ ಈ ಹೆಸರು.<br><br>

करीषाग्नि
करीषाग्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಣಗಿದ ಸಗಣಿಯ ಬೆಂಕಿ<br><b>व्युत्पत्तिः - </b>करीषे अग्निः<br><b>विस्तारः - </b>"छगणस्तु करीषाग्निः" - त्रिकाण्ड० ।<br><br>

करीषिन्
करीषिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆರಣಿಯಿಂದ ಕೂಡಿದ ದೇಶ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>करीषोऽत्रास्ति<br><br>

करीषिणी
करीषिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆರಣಿಯಿಂದ ಕೂಡಿದ ದೇಶ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

करुण
करुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾವ್ಯದ ಒಂದು ರಸ /ಶೃಂಗಾರಾದಿ ರಸಗಳಲ್ಲೊಂದು<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "उनन्" (उ० ३-५३) । "अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>करुणास्यास्ति<br><br>करुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವೃಕ್ಷದ ಹೆಸರು<br><b>प्रयोगाः - </b>"तदार्पितैस्तां करुणस्य कुड्मलैर्जहास तस्याः कुटिला कचच्छटा"<br><b>उल्लेखाः - </b>नैष० १५-३१<br><br>करुण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುಃಖಿತ /ಖಿನ್ನ /ದೀನ<br><b>प्रयोगाः - </b>"करुणमपि समर्थं मानिनां मानभेदे रुदितमुदितमस्त्रं योषितां विग्रहेषु"<br><b>उल्लेखाः - </b>माघ० ११-३५<br><br>

करुणविप्रलम्भ
करुणविप्रलम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೃಂಗಾರರಸದ ಒಂದು ಭೇದ<br><b>विस्तारः - </b>"यूनोरेकतरस्मिन् गतवति लोकान्तरं पुनर्लभ्ये । विमनायते यदेकस्तदा भवेत्करुणविप्रलम्भाख्यः ॥" - सा० द० ३-२०९<br><br>

करुणा
करुणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಯೆ /ಕನಿಕರ /ಇತರರ ದುಃಖವನ್ನು ಪರಿಹರಿಸುವ ಇಚ್ಛೆ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "उनन्" (उ० ३-५३)<br><b>प्रयोगाः - </b>"प्रायः सर्वो भवति करुणावृत्तिरार्द्रान्तरात्मा" । "न च मेऽवगच्छति यथा लघुतां करुणां यथा च कुरुते स मयि"<br><b>उल्लेखाः - </b>माघ० २-३०, माघ० ९-५६<br><br>

करुणात्मन्
करुणात्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯೆಯಿಂದ ಕೂಡಿದ ಮನಸ್ಸುಳ್ಳ /ಮೂದು ಹೃದಯವುಳ್ಳ /ಕನಿಕರವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>करुणः अत्मा यस्य<br><br>

करुणानिधि
करुणानिधि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯೆಗೆ ಆಧಾರವಾದ /ಕನಿಕರದಿಂದ ತುಂಬಿದ<br><b>निष्पत्तिः - </b>नि + डुधाञ् (धारणपोषणयोः) - "किः" (३-३-९३)<br><b>व्युत्पत्तिः - </b>करुणा निधीयतेऽत्र<br><br>

करुणामय
करुणामय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯೆಯಿಂದ ತುಂಬಿದ /ಕನಿಕರದಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>करुणा - "मयट्" (५-४-२१)<br><b>प्रयोगाः - </b>"काकुत्स्थं करुणामयं गुणनिधिं विप्रप्रियं धार्मिकम्"<br><b>उल्लेखाः - </b>हनु० ना०<br><br>

करुणाविमुख
करुणाविमुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರ್ಘೃಣ /ಕ್ರೂರ /ಕನಿಕರವಿಲ್ಲದ<br><br>

करुणाशून्य
करुणाशून्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರ್ಘೃಣ /ಕ್ರೂರ /ಕನಿಕರವಿಲ್ಲದ<br><br>

करूष
करूष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರೂಷದೇಶ<br><b>प्रयोगाः - </b>"एष मद्रान् वशे कृत्वा कुरूंश्च सह सोमकैः । चेदिकाशिकरूषांश्च कुरुलक्ष्मीं वहिष्यति ॥"<br><b>उल्लेखाः - </b>भा० आदि०<br><b>विस्तारः - </b>बहुवचनान्तमिदं रूपम् ।<br><br>करूष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರೂಷದೇಶದರಾಜರು<br><b>निष्पत्तिः - </b>"अण्" बहुषु लुक् ।<br><b>व्युत्पत्तिः - </b>करूषाणां राजानः<br><br>

करूषक
करूषक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೈವಸ್ವತಮನುವಿನ ಒಬ್ಬ ಮಗ<br><b>प्रयोगाः - </b>"इक्ष्वाकुनृगशर्यातिदिष्टधृष्टकरूषकान्"<br><b>उल्लेखाः - </b>भाग० ९-१-१२<br><br>

करूषज
करूषज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಂತವಕ್ರ<br><b>प्रयोगाः - </b>"ताविहाथ पुनर्जातौ शिशुपालकरूषजौ"<br><b>उल्लेखाः - </b>भाग० ७-१०-३८<br><br>

करूषाधिपति
करूषाधिपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರೂಷದೇಶದ ದೊರೆ /ದಂತವಕ್ರ<br><b>प्रयोगाः - </b>"शिशुपालः सहसुतः करूषाधिपतिस्तथा"<br><b>उल्लेखाः - </b>भा० सभा० ४-३५<br><br>

करेट
करेट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಖ /ಉಗುರು<br><b>निष्पत्तिः - </b>अट (गतौ) - "अच्" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>करे अटति<br><br>

करेटु
करेटु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೊಡ್ಡ ಜಾತಿಯ ಕೊಕ್ಕರೆ<br><b>निष्पत्तिः - </b>रेटृ (परिभाषणे) - "कुः" (उ० १-३७)<br><b>व्युत्पत्तिः - </b>के जले रेटति<br><br>

करेणु
करेणु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಜ /ಆನೆ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "एणुः" (उ० २-१)<br><b>प्रयोगाः - </b>"आकुञ्चितप्रोहनिरूपितक्रमं करेणुरारोहते निषादिनम्"<br><b>उल्लेखाः - </b>माघ० १२-५<br><br>करेणु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಟ್ಟ ಗಣಗಿಲೆ<br><br>करेणु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣಾನೆ<br><b>प्रयोगाः - </b>"त्रस्तः समस्तजनहासकरः करेणोस्तावत्करः प्रखरमुल्ललयाञ्चकार"<br><b>उल्लेखाः - </b>माघ० ५-७<br><b>विस्तारः - </b>"करेणुर्गजयोषायां स्त्रियां पुंसि मतङ्गजे" - मेदि० । "करेणुर्गजहस्तिन्योः कर्णिकारेऽपि च क्वचित्" - विश्व० ।<br><br>

करेणुभू
करेणुभू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಜಶಾಸ್ತ್ರಪ್ರವರ್ತಕನಾದ ಪಾಲಕಾಪ್ಯಮುನಿ<br><b>विस्तारः - </b>"पालकाप्ये करेणुभूः" - अभि० चि०<br><br>

करेणुसुत
करेणुसुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಜಶಾಸ್ತ್ರಪ್ರವರ್ತಕನಾದ ಪಾಲಕಾಪ್ಯಮುನಿ<br><br>

करेणुमती
करेणुमती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಕುಲನ ಪತ್ನಿ /ಚೇದಿರಾಜನ ಮಗಳು<br><b>प्रयोगाः - </b>"नकुलस्तु चैद्यां करेणुमतीं भार्यामुदावहत् । तस्यां पुत्रं निरमित्रं नामाजनयत् ॥"<br><b>उल्लेखाः - </b>भा० आदि० ६३<br><br>

करोटि
करोटि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯ ಎಲುಬು<br><b>निष्पत्तिः - </b>रुट (प्रतिघाते) - "इन्" (उ० ४-११७)<br><b>व्युत्पत्तिः - </b>कं वायुं रोटते<br><br>

कर्क
कर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "कः" (उ० ३-४०)<br><br>कर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿ ಕುದುರೆ<br><b>व्युत्पत्तिः - </b>करोति आदिष्टं पालयति<br><br>कर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದರ್ಪಣ /ಕನ್ನಡಿ<br><br>कर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಘಟ /ಹೂಜಿ<br><br>कर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಕಾಟಕ ರಾಶಿ<br><br>कर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಏಡಿ /ನಳ್ಳಿ<br><br>कर्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರುನೆಲ್ಲಿ ಗಿಡ<br><br>कर्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತಮವಾದ /ಉತ್ಕೃಷ್ಟವಾದ<br><br>कर्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಳುಪಾದ<br><b>विस्तारः - </b>"कर्कः कर्केऽनिले वह्नौ शुक्लाश्वे दर्पणे घटे" - मेदि० ।<br><br>

कर्कखण्ड
कर्कखण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿ ಕುದುರೆಗಳಿಂದ ಕೂಡಿದ ದೇಶ<br><b>व्युत्पत्तिः - </b>कर्कः श्वेताश्वयुक्तः खण्डः भूमिभागो यत्र<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>कर्कखण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆ ದೇಶದ ಜನರು<br><b>प्रयोगाः - </b>"मगधान् कर्कखाण्डांश्च निवेश्य विषयेऽत्मनः"<br><b>उल्लेखाः - </b>भा० वन० २४५-८<br><br>

कर्कचिर्भटा
कर्कचिर्भटा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿ ಸೌತೆಕಾಯಿ<br><br>

कर्कट
कर्कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಕಾಟಕ ರಾಶಿ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "विच्" (३-२-७५) । कटे (वर्षावरणयोः) - "अच्" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>कटति । कर् चासौ कटश्च ।<br><b>प्रयोगाः - </b>"मेषे भद्रमवाप्नुयाद्गवि सुखं युग्मे मृतिं कर्कटे लाभम्" । "कर्कटे प्रथमं देवी त्र्यङ्गं गङ्गा रजस्वला" ।<br><b>उल्लेखाः - </b>१) काला०<br><br>कर्कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೂರುಗದ ಮರ<br><br>कर्कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಏಡಿ /ನಳ್ಳಿ<br><b>प्रयोगाः - </b>"बहुकम्बुमणिर्वराटिकागणनाटत्करकर्कटोत्करः"<br><b>उल्लेखाः - </b>नैष० २-८८<br><br>कर्कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾವರೆಯ ಗೆಡ್ಡೆ<br><br>कर्कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಿಹಿ ಸೋರೆಗಿಡ<br><br>कर्कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತ್ರಾಸಿನ ದಂಡಿಗೆ ಕೊನೆಗಳಲ್ಲಿ ಎರಡು ಕಡೆಯ ತಟ್ಟೆಗಳ ದಾರಗಳನ್ನೂ ಕಟ್ಟಲು ಇರುವ ಬಗ್ಗಿದ ಕೊಂಡಿ<br><br>कर्कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಟಕ /ಮುಳ್ಳು<br><br>

कर्कटी
कर्कटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ನಳ್ಳಿ<br><br>कर्कटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌತೆ ಗಿಡ<br><b>प्रयोगाः - </b>"यथा च कर्कटी गर्भमाधत्ते मृत्युमात्मनः"<br><b>उल्लेखाः - </b>भा० विरा०<br><br>

कर्कटक
कर्कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಯಂತ್ರ /ವೃತ್ತರೇಖೆಯನ್ನು ಎಳೆಯುವ ಒಂದು ಸಲಕರಣೆ<br><b>व्युत्पत्तिः - </b>कर्कट इव कायति<br><br>कर्कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಕ್ಕಳ<br><br>कर्कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಂಡಸ<br><br>कर्कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಮುಟ<br><b>प्रयोगाः - </b>"फणिमुख काकलिसन्दंशकपुरुषशीर्षकयोगचुर्णयोगवर्तिकामानसूत्र कर्कट करज्जुदीपभाजनभ्रमरकरण्डकप्रभृत्यनेकोपकरणयुक्तः"<br><b>उल्लेखाः - </b>दशकु०<br><br>कर्कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಕಾಟಕ ರಾಶಿ<br><br>कर्कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಏಡಿ /ನಳ್ಳಿ<br><br>कर्कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರುನೆಲ್ಲಿ ಗಿಡ<br><br>कर्कटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಕಬ್ಬು<br><br>

कर्कटि
कर्कटि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌತೆ ಗಿಡ<br><br>कर्कटि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂರುಗದ ಮರ<br><b>निष्पत्तिः - </b>अट (गतौ) - "इन्" (उ० ४-११७) शक० ।<br><b>व्युत्पत्तिः - </b>कर्कं कण्टकमटति<br><br>

कर्कन्धू
कर्कन्धू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬದರೀವೃಕ್ಷ /ಎಲಚಿಮರ<br><b>निष्पत्तिः - </b>डुधाञ् (धारणपोषणयोः) - "कूः" (उ० १-९३) निपा० ।<br><b>व्युत्पत्तिः - </b>कर्कं कण्टकं ददाति<br><br>

कर्कफल
कर्कफल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರುನೆಲ್ಲಿ ಕಾಯಿ<br><br>

कर्कर
कर्कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದರ್ಪಣ /ಕನ್ನಡಿ<br><b>निष्पत्तिः - </b>कर्क (हसने) (सौत्रः) - "घञ्" (३-३-१८) । रा (दाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कर्कं राति<br><br>कर्कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುಡಿಮಾಡುವ ಕಲ್ಲು /ಅರೆಯುವ ಕಲ್ಲು /ಗುಂಡುಕಲ್ಲು<br><br>कर्कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಡತಿ /ಸುತ್ತಿಗೆ<br><br>कर्कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಲುಬು /ಮೂಳೆ<br><b>विस्तारः - </b>"भारद्वाजं श्वदयितं सारसङ्घातकर्कराः" - वैज० ।<br><br>कर्कर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸಿ ಸುಣ್ಣಕಲ್ಲು<br><br>कर्कर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೃಢವಾದ /ಗಟ್ಟಿಯಾದ /ಕಠಿನವಾದ<br><b>प्रयोगाः - </b>"कोरकाकारकरकः करीरः कर्करोऽर्करुक्"<br><b>उल्लेखाः - </b>माघ० १९-१०४<br><br>

कर्कराक्ष
कर्कराक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡಿಗೆ ಸೊಗಸಿನ ಹಕ್ಕಿ /ಕೆಂಬೂತದ ಹಕ್ಕಿ<br><br>

कर्कराङ्ग
कर्कराङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡಿಗೆ ಸೊಗಸಿನ ಹಕ್ಕಿ /ಕೆಂಬೂತದ ಹಕ್ಕಿ<br><br>

कर्कराटु
कर्कराटु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಟಾಕ್ಷ /ಕಡೆಗಣ್ಣಿನ ನೋಟ<br><b>निष्पत्तिः - </b>रट (परिभाषणे) - "उण्" बाहु० ।<br><b>व्युत्पत्तिः - </b>कर्कं हासं रटति<br><br>

कर्करान्धुक
कर्करान्धुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಕತ್ತಲೆಯಿಂದ ಕೂಡಿದ ಬಾವಿ<br><b>निष्पत्तिः - </b>सञ्ज्ञायां "कन्" (५-३-७५)<br><b>व्युत्पत्तिः - </b>कर्करः अतिशयितान्धकारत्त्वात् कठोरः अन्धुः कूपः<br><br>

कर्कराल
कर्कराल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಂಗುರು ಕೂದಲು<br><b>निष्पत्तिः - </b>अल (भूषणादौ) - "अच्" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>कर्करः सन् अलति<br><b>विस्तारः - </b>"अलकस्तु कर्करालः खङ्खरश्चूर्णकुन्तलः" - अभि० चि० ।<br><br>

कर्करी
कर्करी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಿಂಡಿ /ಕೊಳವೆಯಿರುವ ಹೂಜಿ<br><b>निष्पत्तिः - </b>रा (दाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कर्कं हासं राति<br><b>विस्तारः - </b>"कर्करी भाण्डभेदे ना दर्पणे कठिने त्रिषु" - विश्व० ।<br><br>

कर्करीका
कर्करीका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಿಂಡಿ /ಕೊಳವೆಯಿರುವ ಹೂಜಿ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "ईकन्" धातोर्द्वित्वम्, अभ्यासस्य रुक् च निपा० (उ० ४-२०)<br><br>

कर्करेट
कर्करेट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧಚಂದ್ರ ಪ್ರಯೋಗ /ಕತ್ತು ಹಿಡಿದು ತಳ್ಳಲು ಅರ್ಧಚಂದ್ರಾಕಾರವಾಗಿ ಮಾಡುವ ಹಸ್ತ<br><b>निष्पत्तिः - </b>रेटृ (परिभाषणे) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>कर्कं कर्केति शब्दं रेटति यत्र<br><br>

कर्करेटु
कर्करेटु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೊಡ್ಡ ಜಾತಿಯ ಕೊಕ್ಕರೆ<br><b>निष्पत्तिः - </b>रेटृ (परिभाषणे) - "कुः" (उ० १-३७)<br><b>व्युत्पत्तिः - </b>कर्क इति रेटते<br><br>

कर्कश
कर्कश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಪಿಲ್ಲ ಅಥವಾ ರೋಚನಿಯೆಂಬ ಓಷಧಿ<br><br>कर्कश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಸಮರ್ದವೃಕ್ಷ<br><br>कर्कश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿನಜಲ್ಲೆ<br><br>कर्कश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಖಡ್ಗ /ಕತ್ತಿ<br><b>निष्पत्तिः - </b>कश (गतिशासनयोः) - "अच्" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>करे कशति<br><br>कर्कश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಾಹಸಿಕ /ಸಾಹಸಗಾರ<br><br>कर्कश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ರೂರ /ಭಯಂಕರ<br><br>कर्कश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೃಢವಾದ /ಗಟ್ಟಿಯಾದ /ಕಠಿನವಾದ<br><b>प्रयोगाः - </b>"ऐरावतास्फालनकर्कशेन हस्तेन पस्पर्श तदङ्गमिन्द्रः"<br><b>उल्लेखाः - </b>कुमा० ३-२२<br><br>कर्कश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯೆಯಿಲ್ಲದ /ಕರುಣೆಯಿಲ್ಲದ<br><br>कर्कश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒರಟಾದ /ನುಣುಪಿಲ್ಲದ<br><br>कर्कश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಿಪುಣ /ಕೃಪಣ<br><br>कर्कश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಠಿನವಾದ /ದುರ್ಬೋಧವಾದ /ತಿಳಿಯಲಾಗದ<br><b>प्रयोगाः - </b>"येषां कोमलकाव्यकौशलकलालीलावती भारती तेषां कर्कशतर्कवक्रभणोतोद्गारेषु किं ह्रीयते"<br><b>उल्लेखाः - </b>प्र० रा० १-१८<br><br>कर्कश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕಷ್ಟವಾದ<br><br>कर्कश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಯಾದ /ಹೆಚ್ಚಾದ<br><b>प्रयोगाः - </b>"तस्य कर्कशविहारसम्भवं स्वेदमाननविलग्नजालकम्"<br><b>उल्लेखाः - </b>रघु० ९-६८<br><b>विस्तारः - </b>"कर्कशः कासमर्देक्षुकाम्पिल्येष्वप्यसौ पुमान् । त्रिषु साहसिके क्रूरे दृढमसृणनिर्दये" -मेदि० ।<br><br>

कर्कशच्छद
कर्कशच्छद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರೆಗಿಡ<br><b>व्युत्पत्तिः - </b>कर्कशः छदः पत्रमस्य<br><br>

कर्कशता
कर्कशता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಠಿಣವಾಗಿರುವಿಕೆ /ದುರ್ಬೋಧವಾಗಿರುವಿಕೆ<br><br>कर्कशता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒರಟಾಗಿರುವಿಕೆ<br><br>कर्कशता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೃಡವಾಗಿರುವಿಕೆ<br><br>कर्कशता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭಯಂಕರವಾಗಿರುವಿಕೆ<br><br>कर्कशता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಯೆಯಿಲ್ಲದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कर्कशस्य भावः<br><br>

कर्कशत्व
कर्कशत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>कर्कशता ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कर्कशस्य भावः<br><b>प्रयोगाः - </b>"नागेन्द्रहस्तास्त्वचि कर्कशत्वादेकान्तशैत्यात्कदलीविशेषाः"<br><b>उल्लेखाः - </b>कुमा० १-३६<br><br>

कर्काटक
कर्काटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಕಾಟಕ ರಾಶಿ<br><br>

कर्कारु
कर्कारु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೂದುಕುಂಬಳದ ಗಿಡ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "उण्" बाहु० ।<br><b>व्युत्पत्तिः - </b>कर्कं हासं श्वेततामृच्छति<br><b>विस्तारः - </b>"कूष्माण्डकस्तु कर्कारुः"- अम० ।<br><br>कर्कारु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೂದುಕುಂಬಳಕಾಯಿ<br><br>

कर्कि
कर्कि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಕಾಟಕ ರಾಶಿ<br><b>निष्पत्तिः - </b>कर्क - "इन्" (उ० ४-११७)<br><b>प्रयोगाः - </b>"कर्किर्मीनधनुर्भ्यां च हरिः कीटघटेन च"<br><br>

कर्केतन
कर्केतन<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಣಿ /ರತ್ನ<br><br>

कर्कोटक
कर्कोटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಸರ್ಪರಾಜ /೮ ಸರ್ಪರಾಜರಲ್ಲೊಬ್ಬ<br><b>प्रयोगाः - </b>"प्राग्भूय कर्कोटक आचकर्षं सकम्बलं नागबलं यदुच्चैः"<br><b>उल्लेखाः - </b>नैष० १०-८<br><b>विस्तारः - </b>"अनन्तो वासुकिः पद्मो महापद्मोऽपि तक्षकः । कर्कोटः कुलिकः शङ्खः इत्यष्टौ नागनायकाः"- त्रिकाण्ड० ।<br><br>कर्कोटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಲ್ವದ ಮರ<br><b>विस्तारः - </b>"कर्कोटकः स्यान्मालूरकार्द्रवेयप्रभेदयोः" - मेदि० ।<br><br>

कर्चूर
कर्चूर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಚೋರ<br><b>निष्पत्तिः - </b>कर्ज (व्यथने) - "ऊरः" (उ० ४-९०)<br><br>कर्चूर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುವರ್ಣ /ಚಿನ್ನ<br><br>कर्चूर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹರಿದಳ<br><br>कर्चूर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರವರ್ಣ<br><b>प्रयोगाः - </b>"स इन्द्रनीलस्थलनीलमूर्ती रराज कर्चूरपिशङ्गवासाः"<br><b>उल्लेखाः - </b>माघ० ३-११<br><br>कर्चूर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರವರ್ಣವುಳ್ಳ<br><br>

कर्चूरक
कर्चूरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಶಿನ<br><br>कर्चूरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಚೋರ<br><b>निष्पत्तिः - </b>कर्चूर - "कन्" (५-३-७५)<br><br>

कर्ण|भेदने| कर्णयते
कर्ण - भेदने (चुरा० उभ० सक० से०) कर्णयति -ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಭೇದಿಸು /ಒಡೆ /ಕತ್ತರಿಸು<br><br>कर्ण - भेदने (चुरा० उभ० सक० से०) कर्णयति -ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ರಂಧ್ರ ಮಾಡು /ತೂತು ಕೊರೆ /ವಜ್ಜ ಮಾಡು<br><br>

कर्ण
कर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿ /ಶ್ರೋತ್ರ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "नः" (उ० ३-१०)<br><b>व्युत्पत्तिः - </b>कीर्यते शब्दोऽत्र<br><b>प्रयोगाः - </b>"कर्णेभ्यश्च्युतमासितोत्पलं वधूनां वीचीभिस्तटमनु यन्निरासुरापः"<br><b>उल्लेखाः - </b>माघ० ८-५४<br><br>कर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರವಣೇಂದ್ರಿಯ /ಶಬ್ದವನ್ನು ಗ್ರಹಿಸುವ ಒಂದು ಇಂದ್ರಿಯ /ಕರ್ಣಶಷ್ಕುಲಿಯೊಳಗಿನ ಕುಹರ /ಆಕಾಶರೂಪವಾದ ವಿವರ<br><b>प्रयोगाः - </b>"तद्गुणैः कर्णमागत्य चापलाय प्रचोदितः" । "मुदा तदाकर्णनसज्जकर्णया" ।<br><b>उल्लेखाः - </b>रघु० १-९, नैष० १-३५<br><br>कर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಡಗಿನ ಲಂಗರು /ಚುಕ್ಕಾಣಿ ಚಕ್ರ<br><b>प्रयोगाः - </b>"हतकर्णेन नौर्जले"<br><b>उल्लेखाः - </b>रामा०<br><br>कर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣ /ಕುಂತಿಯ ಮಗ /ರಾಧೇಯ /ಅಂಗರಾಜ<br><br>

कर्णक
कर्णक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾತ್ರೆಯ ತುದಿಯಲ್ಲಿ ಮುಂದಕ್ಕೆ ಚಾಚಿಕೊಂಡಿರುವ ಅಂಚು<br><br>कर्णक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರದ ರೆಂಬೆ ಮತ್ತು ಎಲೆ<br><b>निष्पत्तिः - </b>कर्ण (भेदने) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कर्णयति विभिद्य जायते<br><br>

कर्णकण्डू
कर्णकण्डू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯ ನವೆ /ಕಿವಿಯ ತುರಿ<br><b>विस्तारः - </b>"कफेन कण्डूः प्रचितेन कर्णयोः भृशं भवेत् स्रोतसि कर्णसञ्ज्ञिते" - सुश्रुत० उत्तर० २०-११<br><br>

कर्णकषाय
कर्णकषाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯಮಲ /ಕಿವಿಯ ಕೀವು<br><b>प्रयोगाः - </b>"आपीयतां कर्णकषायशोषाननुकमिष्ये त इमान् सुपेशान्"<br><b>उल्लेखाः - </b>भाग० २-६-४५<br><br>

कर्णकिट्ट
कर्णकिट्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯಮಲ /ಕಿವಿಯ ಗುಗ್ಗೆ<br><br>

कर्णकुप
कर्णकुप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾವಿಯಂತೆ ಆಳವಾಗಿರುವ ಕಿವಿಯ ರಂಧ್ರ /ಕಿವಿಯ ಒಳಭಾಗ<br><b>व्युत्पत्तिः - </b>कर्णस्य कूप इव<br><b>प्रयोगाः - </b>"सुधारस्योद्वेलनकेलिमक्षरस्रजासृजान्तर्मम कर्णकुपयोः"<br><b>उल्लेखाः - </b>नैष० ९-११३<br><br>

कर्णगतरोग
कर्णगतरोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯೊಳಗಿನ ರೋಗ /ಕಿವಿಯನ್ನು ಆಶ್ರಯಿಸಿ ಬರುವ ವ್ಯಾಧಿ<br><b>विस्तारः - </b>ಈ ವ್ಯಾಧಿಯು कर्णशूलम्, प्रणादः, बाधिर्यम्, क्ष्वेडः, कर्णस्रावः, कर्नकण्डूः, कर्णगूथः, कृमिकर्णकः, कर्णप्रतिनाहः, क्षतविद्रधिः, दोषविद्रधिः, कर्णपाकः, पूतिकर्णः, १४-१७ चतुर्विधम्, अर्शः (१८-२४) सप्तविधं कर्णार्बुधम्, २५-२८ चतुर्विधः शोफः ಎಂದು ೨೮ ವಿಧ.<br><br>

कर्णगूथ|कर्णगूथक
कर्णगूथ(क)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯಮಲ /ಕಿವಿಯ ಗುಗ್ಗೆ<br><br>कर्णगूथ(क)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಿತ್ತದ ತೇಜಸ್ಸಿನಿಂದ ಶ್ಲೇಷ್ಮವು ಒಣಗುವಿಕೆ<br><b>प्रयोगाः - </b>"विशोषिते श्लेष्मणि पित्ततेजसा नृणां भवेत् स्रोतसि कर्णगूथकः"<br><b>उल्लेखाः - </b>सुश्रुत० उत्तर० २०-११<br><br>

कर्णगोचर
कर्णगोचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರಾವ್ಯವಾದ /ಕಿವಿಗೆ ಕೇಳಿಸುವ /ಕೇಳಬಹುದಾದ<br><b>व्युत्पत्तिः - </b>कर्णस्य गोचरः<br><br>

कर्णगोलक
कर्णगोलक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೋಳಾಕಾರವಾದ ಕರ್ಣಕುಹರ /ಕಿವಿಯೊಳಗೆ ಶಬ್ದವು ಪ್ರವೇಶಿಸುವ ದಾರಿ<br><br>

कर्णग्राह
कर्णग्राह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾವಿಕ /ಕರ್ಣಧಾರ /ಅಂಬಿಗ<br><b>निष्पत्तिः - </b>ग्रह (उपादाने) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कर्णमरित्रं गृह्णाति<br><br>

कर्णच्छिद्र
कर्णच्छिद्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣಕುಹರ /ಕಿವಿಯ ರಂಧ್ರ<br><br>

कर्णज
कर्णज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯಮಲ /ಕಿವಿಯ ಗುಗ್ಗೆ<br><br>कर्णज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣನ ಮಗ - ಸುಷೇಣ, ಸುದಾಮ, ಸುಶರ್ಮ, ಸತ್ಯಸೇನ, ಚಿತ್ರಸೇನ ಮತ್ತು ವೃಷಸೇನ<br><br>

कर्णजप|कर्णेजप
कर्ण(र्णे)जप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಾಡಿಕೋರ /ಚಾಡಿ ಹೇಳುವವನು<br><b>निष्पत्तिः - </b>जप (व्यक्तायां वाचि) - "अच्" (३-१-१३५) । सप्तम्या अलुक् (६-३-१४)<br><b>व्युत्पत्तिः - </b>कर्णे जपति<br><b>प्रयोगाः - </b>"कर्णेजपैराहितराज्यलोभा स्त्रैणेन नीता विकृतिं लघिम्ना"<br><b>उल्लेखाः - </b>भट्टि० ३-७<br><br>

कर्णजलूका
कर्णजलूका<br><br><b>कन्नडार्थः - </b>ಜರಿ /ಲಕ್ಷ್ಮೀ ಚೇಳು<br><b>विस्तारः - </b>जलौका ಎಂದೂ जलौकस् ಎಂದೂ ಸಕಾರಾಂತ ಪ್ರಯೋಗವೂ ಉಂಟು .<br><br>

कर्णजाह
कर्णजाह<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣಮೂಲ /ಕಿವಿಯ ತಳಭಾಗ<br><b>निष्पत्तिः - </b>"जाहच्" (५-२-२४)<br><b>व्युत्पत्तिः - </b>कर्णस्य मूलम्<br><b>प्रयोगाः - </b>"दधाना वलिभं मध्यं कर्णजाहविलोचना"<br><b>उल्लेखाः - </b>भट्टि० ४-१६<br><br>

कर्णजित्
कर्णजित्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಜುನ<br><b>निष्पत्तिः - </b>जि (जये) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>कर्णं जितवान्<br><br>

कर्णताल
कर्णताल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣತಾಡನ /ಆನೆಯ ಕಿವಿಯ ಹೊಡೆತ<br><b>व्युत्पत्तिः - </b>कर्णस्य तालः<br><b>प्रयोगाः - </b>"विस्तारितः कुञ्जरकर्णतालैर्नेत्रक्रमेणोपरुरोध सूर्यम्"<br><b>उल्लेखाः - </b>रघु० ७-३९<br><br>कर्णताल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾಳದಂತೆ ವಿಸ್ತಾರವಾದ ಕರ್ಣ<br><b>प्रयोगाः - </b>"कर्णतालप्ररोहद्वातां कराजिहीर्षा"<br><b>उल्लेखाः - </b>चं० भा० १-१<br><br>

कर्णदर्पण
कर्णदर्पण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯ ಓಲೆ<br><b>व्युत्पत्तिः - </b>कर्णस्य दर्पण इव<br><b>विस्तारः - </b>"करारोटोऽङ्गुलीटः स्यात्ताडङ्कः कर्णदर्पणः" - त्रिकाण्ड० ।<br><br>

कर्णधार
कर्णधार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾವಿಕ /ಕರ್ಣಧಾರ /ಅಂಬಿಗ<br><b>निष्पत्तिः - </b>धृञ् (धारणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कर्णमरित्रं धरति<br><b>प्रयोगाः - </b>"यदि न स्यान्नरपतिः सम्यङ्नेता ततः प्रजा । अकर्णधारा जलधौ विप्लवेतेह नौरिव ॥"<br><b>उल्लेखाः - </b>हितो० ३-२<br><br>कर्णधार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಷ್ಟದಿಂದ ಪಾರು ಮಾಡುವವನು /ದುಃಖವನ್ನು ಪರಿಹರಿಸುವವನು<br><b>प्रयोगाः - </b>"अकर्णधारा पृथिवी शून्येव प्रतिभाति मे । गते दशरथे स्वर्गं रामे चारण्यमाश्रिते ॥"<br><b>उल्लेखाः - </b>रामा०<br><br>

कर्णधारक
कर्णधारक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>कर्णधार ಪದದ ಅರ್ಥ<br><br>

कर्णनाद
कर्णनाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯನ್ನು ಬೆರಳಿನಿಂದ ಮುಚ್ಚಿದಾಗ ಉಂಟಾಗುವ "ಜೊಯ್" ಎಂಬ ಶಬ್ದ<br><b>व्युत्पत्तिः - </b>कर्णे नादः<br><br>

कर्णपत्रक
कर्णपत्रक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊರಕಿವಿಯ ಮೆದುವಾದ ತಳಭಾಗ /ಕಿವಿಯ ಹಾಲೆ /ಕರ್ಣಪಲಿ<br><b>प्रयोगाः - </b>"कनीनिके चाक्षिकूटे शष्कुली कर्णपत्रकौ । कर्णौ शङ्खौ भ्रुवौ दन्तवेष्टावोष्ठौ ककुन्दरे ॥"<br><b>उल्लेखाः - </b>याज्ञ० ३-९६<br><br>

कर्णपथ
कर्णपथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯೊಳಗೆ ಶಬ್ದವು ಪ್ರವೇಶಿಸುವ ದಾರಿ /ಕಿವಿಯೊಳಗಿನ ರಂಧ್ರ<br><br>

कर्णपरम्परा
कर्णपरम्परा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರವಣಪರಂಪರೆ /ಯಾವುದಾದರೊಂದು ವಿಷಯವು ಒಂದು ಕಿವಿಯಿಂದ ಮತ್ತೊಂದು ಕಿವಿಗೆ ಹೋಗುವಿಕೆ<br><b>प्रयोगाः - </b>"तेनैव च क्रमेणैषा गतः कर्नपरम्पराम् । प्रवादो बहुलीभावं सर्वत्रापि पुरे ययौ ॥"<br><b>उल्लेखाः - </b>कथास०<br><br>

कर्णपर्वन्
कर्णपर्वन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾಭಾರತದ ೮ನೆಯ ಪರ್ವ /ಕರ್ಣನ ಪರಾಕ್ರಮವನ್ನೂ ಸಾಹಸಕೃತ್ಯಗಳನ್ನೂ ವರ್ಣಿಸುವ ಮಹಾಭಾರತದ ಒಂದು ಭಾಗ<br><br>

कर्णपाक
कर्णपाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯ ಹೊರಭಾಗದ ಉರಿಯೂತ /ಕಿವಿಯ ಹೊರಭಾಗದಲ್ಲಿ ರಕ್ತಕಟ್ಟಿಕೊಳ್ಳುವುದರಿಂದ ಉಂಟಾಗುವ ನೋವು<br><b>प्रयोगाः - </b>"भवेत् प्रपाकः खलु पित्तकोपतः विकोथविक्लेदकरश्च कर्णयोः"<br><b>उल्लेखाः - </b>सुश्रुत० उतर० २०-१५<br><br>

कर्णपालि
कर्णपालि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊರಕಿವಿಯ ಮೆದುವಾದ ತಳಭಾಗ /ಕಿವಿಯ ಹಾಲೆ /ಕರ್ಣಪಲಿ<br><b>व्युत्पत्तिः - </b>कर्णस्य पालिः<br><br>

कर्णपाली
कर्णपाली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯ ಒಂದು ಆಭರಣ<br><b>निष्पत्तिः - </b>पाल (रक्षणे) +णिच् - "अण्" (३-२-१) । गौरा० "ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>कर्णं पालयति<br><br>

कर्णपिशाची
कर्णपिशाची<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದೇವತೆ<br><b>विस्तारः - </b>ಉಪಾಸನೆಯಿಂದ ಪ್ರಸನ್ನವಾದ ಈ ದೇವತೆಯು ಅಪೇಕ್ಷಿಸಿದ ಯಾವ ವಿಷಯವನ್ನಾದರೂ ಕಿವಿಯಲ್ಲಿ ರಹಸ್ಯವಾಗಿ ಹೇಳುವಳು.<br><br>

कर्णपुर
कर्णपुर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣನ ರಾಜಧಾನಿ /ಚಂಪಾನಗರ /ಈಗಿನ ಭಾಗಲ್ಪುರ<br><br>

कर्णपुरी
कर्णपुरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣನ ರಾಜಧಾನಿ /ಚಂಪಾನಗರ /ಈಗಿನ ಭಾಗಲ್ಪುರ<br><br>

कर्णपुष्प
कर्णपुष्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರಟಗೆ ಗಿಡ<br><br>

कर्णपूर
कर्णपूर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣಾಭರಣ /ಕಿವಿಯ ಒಡವೆ<br><br>कर्णपूर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಗೆ ಅಲಂಕಾರವಾಗಿ ಧರಿಸಲ್ಪಡುವ ಪುಷ್ಪ<br><br>कर्णपूर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀಲೋತ್ಪಲ /ಕನ್ನೈದಿಲೆ<br><br>कर्णपूर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿರೀಷಪುಷ್ಪ /ಬಾಗೆ ಹೂವು<br><br>कर्णपूर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶೋಕಕುಸುಮ<br><b>निष्पत्तिः - </b>पूरी (आप्यायने) -"अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कर्णं पूरयति<br><b>प्रयोगाः - </b>"यस्याश्चोरश्चिकुरनिकरः कर्णपूरो मयूरः भासो हासः कविकुलगुरुः कालिदासो विलासः" । "त्वां पातु मञ्जरितपल्लवकर्णपूरलोभभ्रमद्भ्रमरविभ्रमभृत्कटाक्षः" ।<br><b>उल्लेखाः - </b>प्र० रा० १-२२, अमरु० ११<br><br>

कर्णपूरक
कर्णपूरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕದಂಬ ವೃಕ್ಷ /ಈಚಲು ಮರ<br><b>निष्पत्तिः - </b>पूरी (आप्यायने) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कर्णं पूरयति<br><br>कर्णपूरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣಾಭರಣ<br><br>कर्णपूरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿರೀಷಪುಷ್ಪ /ಬಾಗೆ ಹೂವು<br><br>कर्णपूरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀಲೋತ್ಪಲ /ಕನ್ನೈದಿಲೆ<br><br>कर्णपूरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶೋಕಕುಸುಮ<br><b>विस्तारः - </b>ಹೆಂಗಸರು ಈ ವೃಕ್ಷಗಳ ಪುಷ್ಪಗಳನ್ನು ಕರ್ಣಾಭರಣವನ್ನಾಗಿ ಉಪಯೋಗಿಸುವುದರಿಂದ ಈ ಹೆಸರು.<br><br>

कर्णपूरण
कर्णपूरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೈಲ ಮುಂತಾದುವನ್ನು ಕಿವಿಯಲ್ಲಿ ತುಂಬುವುದು / ಕಿವಿಯ ರಂಧ್ರವನ್ನು ತೈಲದಲ್ಲಿ ತುಂಬುವುದು<br><b>व्युत्पत्तिः - </b>कर्णयोः पूरणम्<br><b>प्रयोगाः - </b>"स्नेहसारोऽयं पुरुषः । प्राणाश्च स्नेहभयिष्ठाः स्नेहसाध्याश्च भवन्ति । स्नेहो हि पानानुवासनमस्तिष्कशिरोबस्त्युत्तरबस्तिनस्यकर्णपूरणगात्राभ्यङ्गभोजनेषूपयोज्यः"<br><b>उल्लेखाः - </b>सुश्रुत० चिकित्सा० ३१-३<br><br>

कर्णप्रणाद
कर्णप्रणाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯ ರೋಗದ ಒಂದು ಭೇದ<br><b>विस्तारः - </b>"यदा तु नाडीषु विमार्गमागतः स एव शब्दाभिवहासु तिष्ठति । श्रृणोति शब्दान् विविधान् तदा नरः प्रणादमेनं कथयन्ति चामयम्" - सुश्रुत० उत्तर० २०-७<br><br>

कर्णप्रतिनाह
कर्णप्रतिनाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯ ರೋಗದ ಒಂದು ಭೇದ<br><b>विस्तारः - </b>"स कर्णविट्को द्रवतां यदा गतो विलायितो घ्राणमुखं प्रपद्यते । तदा स कर्णप्रतिनाहसञ्ज्ञितो भवेद्विकारः शिरसोऽभितापनः ॥" - सुश्रुत० उत्तर० २०-१२<br><br>

कर्णभूषण
कर्णभूषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣಾಭರಣ /ಕಿವಿಯ ಒಡವೆ<br><b>निष्पत्तिः - </b>भूष (अलङ्कारे) - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कर्णं भूषयति<br><br>कर्णभूषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯನ್ನು ಅಲಂಕರಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>भूष (अलङ्कारे) - भावे "ल्युट्" (३-३-११५)<br><br>

कर्णभूषा
कर्णभूषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣಾಭರಣ /ಕಿವಿಯ ಒಡವೆ<br><b>व्युत्पत्तिः - </b>कर्णस्य भूषा<br><br>कर्णभूषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯನ್ನು ಅಲಂಕರಿಸುವಿಕೆ<br><b>विस्तारः - </b>"कर्णगूथं कर्णमलम्" - हारा० ।<br><br>

कर्णमल
कर्णमल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯ ಮಲ /ಗುಗ್ಗೆ<br><b>व्युत्पत्तिः - </b>कर्णस्य मलं गूथम्<br><br>

कर्णमुकुर
कर्णमुकुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾಟಂಕ /ಓಲೆ<br><b>व्युत्पत्तिः - </b>कर्णस्य मुकुर इव<br><br>

कर्णमूल
कर्णमूल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯ ತಳ ಭಾಗ /ಕಿವಿಯ ಹಾಲೆ<br><br>

कर्णमोटि|कर्णमोटी
कर्णमोटि(टी)<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಮುಂಡಾಂಬಿಕೆ /ದುರ್ಗಾದೇವಿ<br><b>निष्पत्तिः - </b>मुट (सञ्चूर्णने) - "इन्" (उ० ४-११७) ।वा "ङीष्" (ग० ४-१-४५)<br><b>व्युत्पत्तिः - </b>कर्णं मोटयति<br><br>

कर्णयोनि
कर्णयोनि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿವಿಯೇ ಮೂಲವಾಗಿ ಉಳ್ಳ /ಕಿವಿಯೇ ಆಶ್ರಯಸ್ಥಾನವಾಗಿ ಉಳ್ಳ ಶಬ್ದ /ಬಾಣ ಮೊದಲಾದುದು<br><b>व्युत्पत्तिः - </b>कर्णः योनिः स्थानमस्य<br><b>विस्तारः - </b>ಬಾಣವನ್ನು ಪ್ರಯೋಗಿಸುವಾಗ ಬಿಲ್ಲಿನ ಹೆದೆಯೊಡನೆ ಬಾಣವನ್ನು ಕಿವಿಯವರೆಗೂ ಎಳೆಯುವುದರಿಂದ ಈ ಹೆಸರು.<br><br>

कर्णरन्ध्र
कर्णरन्ध्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯೊಳಗಿನ ವಿವರ /ಕಿವಿಯೊಳಗೆ ಶಬ್ದವು ಪ್ರವೇಶಿಸುವ ದಾರಿ / ಶ್ರೋತ್ರೇಂದ್ರಿಯದ ದ್ವಾರ<br><br>

कर्णरोग
कर्णरोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯ ರೋಗ /ಕಿವಿಯಲ್ಲಿ ಉಂಟಾಗುವ ವ್ಯಾಧಿ<br><br>

कर्णरोगविज्ञान
कर्णरोगविज्ञान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯ ರೋಗಗಳ ವಿಷಯವನ್ನು ತಿಳಿಯುವಿಕೆ<br><br>कर्णरोगविज्ञान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯರೋಗಗಳ ನಿರೂಪಣೆ<br><br>

कर्णलता
कर्णलता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊರಕಿವಿಯ ಮೆದುವಾದ ತಳಭಾಗ /ಕಿವಿಯ ಹಾಲೆ /ಕರ್ಣಪಲಿ<br><b>व्युत्पत्तिः - </b>कर्णयोर्लतेव<br><b>प्रयोगाः - </b>"तच्चापयोः कर्णलते भ्रुवोर्ज्ये वंशत्वगंशौ चिपिटे किमस्याः"<br><b>उल्लेखाः - </b>नैष० ७-६५<br><br>

कर्णमय
कर्णमय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿವಿಯ ಹಾಲೆ ರೂಪವಾದ<br><b>प्रयोगाः - </b>"मन्येऽमुना कर्णलतामयेन पाशाद्वयेन च्छिदुरेतरेण"<br><b>उल्लेखाः - </b>नैष० ७-६४<br><br>

कर्णवत्
कर्णवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿವಿಯುಳ್ಳವನು /ಕಿವಿಯಿಂದ ಕೂಡಿದವನು<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>कर्णोऽस्यास्ति<br><br>कर्णवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ದವಾದ ಕಿವಿಯುಳ್ಳ /ಜೋಲು ಕಿವಿಯುಳ್ಳ<br><b>निष्पत्तिः - </b>(ग० ५-२-११७)<br><b>व्युत्पत्तिः - </b>विवृद्धौ कर्णौ यस्य<br><br>

कर्णवर्जित
कर्णवर्जित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ /ಹಾವು<br><b>व्युत्पत्तिः - </b>कर्णेन श्रोत्रेण श्रोत्रेण्द्रियेण वर्जितः<br><b>विस्तारः - </b>ಸರ್ಪಕ್ಕೆ ಕಿವಿಯಿಲ್ಲ. ಕಿವುಡನಿಗೆ ಶಬ್ದವನ್ನು ಕೇಳುವ ಶಕ್ತಿಯಿಲ್ಲ.<br><br>कर्णवर्जित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯಿಲ್ಲದವನು /ಕಿವುಡ<br><br>

कर्णविहीन
कर्णविहीन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ /ಹಾವು<br><b>व्युत्पत्तिः - </b>कर्णेन श्रोत्रेण श्रोत्रेण्द्रियेण हीनः विहीनः<br><br>

कर्णविट्|कर्णविष्
कर्णविट् (ष्)<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣಮಲ /ಕಿವಿಯ ಗುಗ್ಗೆ<br><b>व्युत्पत्तिः - </b>कर्णस्य विट्<br><b>प्रयोगाः - </b>"वसाशुक्रमसृङ्मज्जा मूत्रविट्घ्राणकर्णविट् । श्लेष्माश्रु दुषिका स्वेदो द्वादशैते नृणां मलाः ॥"<br><b>उल्लेखाः - </b>मनु० ५-१३५<br><br>

कर्णविट्क
कर्णविट्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣಮಲ /ಕಿವಿಯ ಗುಗ್ಗೆ<br><b>प्रयोगाः - </b>"शोधयेत् कर्णविट्कं तु भिषक् सम्यक् शलाकया"<br><b>उल्लेखाः - </b>सुश्रुत० उत्तर० २१-५५<br><br>

कर्णवेध
कर्णवेध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯನ್ನು ಚುಚ್ಚುವಿಕೆ /ಶಾಸ್ತ್ರದಂತೆ ಕಿವಿ ಚುಚ್ಚುವುದು<br><b>व्युत्पत्तिः - </b>कर्णयोः वेधः<br><br>

कर्णवेधन
कर्णवेधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯನ್ನು ಚುಚ್ಚುವಿಕೆ /ಶಾಸ್ತ್ರದಂತೆ ಕಿವಿ ಚುಚ್ಚುವುದು<br><b>निष्पत्तिः - </b>"ल्युट्"<br><br>

कर्णवेधनी
कर्णवेधनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿ ಚುಚ್ಚುವ ಸೂಜಿ<br><b>निष्पत्तिः - </b>व्यध (ताडने) - कर० "ल्युट्" (३-३-११७) । "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>कर्णो विध्यतेऽनया<br><b>प्रयोगाः - </b>"सौवर्णी राजपुत्रस्य राजती विप्रवैश्ययोः । शूद्रस्य चायसी सूची मध्यमाष्टाङ्गुलात्मिका ॥"<br><br>

कर्णवेष्ट
कर्णवेष्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣಕುಂಡಲ /ಹತ್ತಕಡಕು<br><b>निष्पत्तिः - </b>व्यध (ताडने) - "घः" (३-३-११८)<br><b>व्युत्पत्तिः - </b>कर्णौ वेष्ट्यते अनेन<br><br>कर्णवेष्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರೋಧವಶನ ವಂಶದ ಒಬ್ಬ ದೊರೆ<br><b>प्रयोगाः - </b>"गणः क्रोधवशो नाम यस्ते राजन् प्रकीर्तितः । ततः सञ्जज्ञिरे वीराः क्षिताविह नराधिपाः । मर्दकः कर्णवेष्टश्च सिद्धार्थः कीटकस्तथा ॥"<br><b>उल्लेखाः - </b>भा० आदि० ६७<br><br>

कर्णवेष्टक
कर्णवेष्टक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣಕುಂಡಲ /ಹತ್ತಕಡಕು<br><b>निष्पत्तिः - </b>व्यध (ताडने) - कर्त० "ण्वुल्" (३-१-१३३)<br><br>

कर्णवेष्टन
कर्णवेष्टन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣಕುಂಡಲ /ಹತ್ತಕಡಕು<br><b>निष्पत्तिः - </b>व्यध (ताडने) - कर० "ल्युट्" (३-३-११७)<br><br>कर्णवेष्टन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯನ್ನು ಅಲಂಕರಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>व्यध (ताडने) - भावे "ल्युट्" (३-३-११५)<br><br>

कर्णव्यध
कर्णव्यध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿ ಚುಚ್ಚುವಿಕೆ<br><br>

कर्णव्यधविधि
कर्णव्यधविधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಚುಚ್ಚುವ ಕ್ರಮ<br><br>

कर्णशष्कुली
कर्णशष्कुली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯೊಳಗೆ ಶಬ್ದವು ಪ್ರವೇಶಿಸುವ ದಾರಿ /ಕರ್ಣಗೋಳಕ /ಕಿವಿಯೊಳಗಿನ ರಂಧ್ರ<br><b>व्युत्पत्तिः - </b>कर्णयोः शष्कुलीव<br><b>प्रयोगाः - </b>"अवलम्बितकर्णशष्कुलीकलसीकं रचयन्नवोचत"<br><b>उल्लेखाः - </b>नैष० २-८<br><br>

कर्णशूल
कर्णशूल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಕಿವಿಯ ರೋಗ<br><b>व्युत्पत्तिः - </b>कर्नस्य शूलम्<br><b>विस्तारः - </b>"समीरणः श्रोत्रगतोऽन्यथाचरः समन्ततः शूलमतीव कर्णयोः । करोति दोषैश्च यथास्वमावृतः स कर्णशूलः कथितो दुराचरः ॥" - सुश्रुत० उत्तर० २०-६<br><br>

कर्णशोभन
कर्णशोभन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿವಿಯನ್ನು ಅಲಂಕರಿಸುವ ಒಡವೆ /ಕರ್ಣಾಭರಣ<br><b>निष्पत्तिः - </b>शुभ (दीप्तौ) + णिच् - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कर्णं शोभयति<br><br>

कर्णश्रव
कर्णश्रव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿವಿಯಿಂದ ಕೇಳಲು ಯೋಗ್ಯವಾದ ಶಬ್ದವುಳ್ಳ ವಾಯು ಮೊದಲಾದುದು<br><b>व्युत्पत्तिः - </b>श्रूयते इति श्रवः शब्दः, कर्णेन श्रवः श्रवणयोग्यः शब्दो यत्र<br><b>प्रयोगाः - </b>"कर्णश्रवेऽनिले रात्रौ दिवा पांसुसमूहने । एतौ वर्षास्वनध्यायावध्यायज्ञाः प्रचक्षते ॥"<br><b>उल्लेखाः - </b>मनु० ४-१०२<br><br>

कर्णसंस्राव
कर्णसंस्राव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯಿಂದ ಕೀವು ಸುರಿಯುವಿಕೆ<br><b>विस्तारः - </b>"शिरोऽभिघातादथवा निमज्जतो जले प्रपाकादथवाऽपि विद्रधेः । स्रवेत्तु पूयं श्रवणोऽनिला वृतः स कर्णसंस्राव इति प्रकीर्तितः ॥" - सुश्रुत० उत्तर० २०-१०<br><br>

कर्णसुभग
कर्णसुभग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿವಿಗೆ ಇಂಪಾದ /ಕೇಳಲು ಸಂತೋಷಕರವಾದ<br><br>

कर्णस्रोतोभव
कर्णस्रोतोभव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾವಿಷ್ಣುವಿನ ಕರ್ಣಮಲದಿಂದ ಹುಟ್ಟಿದ ಮಧುಕೈಟಭರೆಂಬ ರಾಕ್ಷಸರು<br><br>

कर्णस्रोतस्
कर्णस्रोतस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣಮಲ /ಕಿವಿಯ ಗುಗ್ಗೆ<br><b>व्युत्पत्तिः - </b>कर्णस्य स्रोत इव<br><br>

कर्णहीन
कर्णहीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿವಿಯಿಲ್ಲದ /ಶ್ರೋತ್ರೇಂದ್ರಿಯವಿಲ್ಲದ /ಶಬ್ದ ಕೇಳುವ ಶಕ್ತಿಯಿಲ್ಲದ /ಕಿವುಡ<br><b>व्युत्पत्तिः - </b>कर्णेन हीनः<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>

कर्णाकर्णि
कर्णाकर्णि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕರ್ಣಪರಂಪರೆಯಿಂದ ಕೇಳಿ ಹರಡಿದ ಮಾತು<br><b>निष्पत्तिः - </b>कर्मव्य० "इच्" (५-४-१२७)<br><b>व्युत्पत्तिः - </b>कर्णे कर्णे गृहीत्वा प्रवृत्तं कथनम्<br><b>प्रयोगाः - </b>"कर्णाकर्णि हि कपयः कथयन्ति च तत्कथाम्"<br><b>उल्लेखाः - </b>रामा०<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>

कर्णाट
कर्णाट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣಾಟಕ ದೇಶ /ಕನ್ನಡ ನಾಡು /ಕನ್ನಡಿಗರ ದೇಶ<br><b>निष्पत्तिः - </b>कर्ण + अट (गतौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कर्णेषु अटति - प्रथितयशसां एतद्देशस्थभूपालानां गुणकीर्तनेन सर्वेषां कर्णेषु भ्रमति<br><br>कर्णाट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣಾಟಕ ದೇಶದ ಜನರು<br><br>कर्णाट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣಾಟಕ ದೇಶದ ದೊರೆ<br><b>प्रयोगाः - </b>"रामनाथं समारभ्य श्रीरङ्गान्तं किलेश्वरि । कर्णाटदेश इत्युक्तो रज्यसाम्राज्यदायकः ॥" "कर्णाटाः कांस्यकुट्टाश्च पद्मजालाः सतीनराः । दाक्षिणात्याः पुलिन्दाश्च शेबेरास्तङ्कणाः खषाः ॥" "तेषां मूर्ध्नि ददाति वामचरणं कर्णाटराजप्रिया"<br><b>उल्लेखाः - </b>२) भा० सभा० ७८-९८, ३)उद्भ०<br><br>

कर्णाटक
कर्णाटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪದದ ಅರ್ಥ<br><b>प्रयोगाः - </b>"कोङ्कवेङ्ककुटकान् दक्षिणकर्णाटकान् देशान् यदृच्छयोपगतः"<br><b>उल्लेखाः - </b>भाग० ५-६-८<br><br>

कर्णाटकदेश
कर्णाटकदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ನಡನಾಡು<br><br>

कर्णाटकभाषा
कर्णाटकभाषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ನಡ ನುಡಿ<br><br>

कर्णानुज
कर्णानुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣನ ತಮ್ಮ / ಯುಧಿಷ್ಠಿರ /ಧರ್ಮರಾಯ<br><b>व्युत्पत्तिः - </b>कर्णस्य अनुजः<br><br>

कर्णान्तिक
कर्णान्तिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯಸಮೀಪ /ಕಿವಿಯ ಹತ್ತಿರದ ಜಾಗ<br><b>प्रयोगाः - </b>"न नीतमन्येन नतिं कदाचित्कर्णान्तिकप्राप्तगुणं क्रियासु"<br><b>उल्लेखाः - </b>माघ० ३-२०<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>

कर्णान्दु
कर्णान्दु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣಪಾಲಿ /ಹೊರಕಿವಿಯ ಮೆದುವಾದ ತಳಭಾಗ /ಕಿವಿಯ ಹಾಲೆ<br><b>व्युत्पत्तिः - </b>कर्णस्यान्दुरिव<br><br>कर्णान्दु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಲಿನ ಕಿವಿಗೆ ಹಾಕುವ ಚಂದ್ರಮುರುವೆಂಬ ಒಂದು ಆಭರಣ<br><b>विस्तारः - </b>"उत्क्षिप्तिका तु कर्णान्दुः" - अभि० चि० ।<br><br>

कर्णाभरण
कर्णाभरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯ ಒಡವೆ /ತಾಟಂಕ /ಓಲೆ /ಹತ್ತಕಡಕು<br><b>व्युत्पत्तिः - </b>कर्णस्याभरणम्<br><b>प्रयोगाः - </b>"एतत्पट्टांशुकयुगलं कर्णाभरणं च दत्तम्"<br><b>उल्लेखाः - </b>रत्ना० ४<br><br>

कर्णामृत
कर्णामृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಗೆ ಅಮೃತದಂತಿರುವ ಮಾತು /ಕಿವಿಗೆ ಇಂಪಾದ ಮಾತು<br><b>व्युत्पत्तिः - </b>कर्णस्यामृतम्<br><br>

कर्णारि
कर्णारि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣನ ವೈರಿ /ಅರ್ಜುನ<br><b>व्युत्पत्तिः - </b>कर्णस्यारिः<br><br>कर्णारि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನದೀಸರ್ಜವೃಕ್ಷ<br><br>

कर्णालङ्करण
कर्णालङ्करण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯನ್ನು ಅಲಂಕರಿಸುವಿಕೆ /ಕಿವಿಯನ್ನು ಒಡವೆಗಳಿಂದ ಶೃಂಗರಿಸುವಿಕೆ<br><b>व्युत्पत्तिः - </b>कर्णस्यालङ्करणम्<br><br>

कर्णालङ्कृति
कर्णालङ्कृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯನ್ನು ಅಲಂಕರಿಸುವಿಕೆ /ಕಿವಿಯನ್ನು ಒಡವೆಗಳಿಂದ ಶೃಂಗರಿಸುವಿಕೆ<br><b>व्युत्पत्तिः - </b>कर्णस्यालङ्कृतिः<br><br>

कर्णास्फाल
कर्णास्फाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಕಿವಿಯ ಹೊಡೆತ<br><b>व्युत्पत्तिः - </b>कर्णस्यास्फालः<br><br>

कर्णि
कर्णि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತುದಿಯಲ್ಲಿ ಕಿವಿಯ ಆಕಾರವುಳ್ಳ ಬಾಣ<br><b>निष्पत्तिः - </b>कर्ण (भेदने) - कर० "इन्" (उ० ४-११७)<br><br>कर्णि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೇದನ /ಒಡೆಯುವುದು<br><b>निष्पत्तिः - </b>कर्ण (भेदने) - भावे "इन्" (उ० ४-११७)<br><br>

कर्णिक
कर्णिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ದವಾದ ಕಿವಿಯುಳ್ಳ /ಜೋಲು ಕಿವಿಯುಳ್ಳ<br><b>निष्पत्तिः - </b>कर्ण - "इन्" (ग० ५-२-११७)<br><b>व्युत्पत्तिः - </b>विवृद्धौ कर्णौ यस्य<br><br>

कर्णिका
कर्णिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸರ ಕಿವಿಯ ಆಭರಣ<br><b>निष्पत्तिः - </b>कर्ण - "कन्" (४-३-६५) । "टाप्" (४-१-४)<br><b>विस्तारः - </b>"कर्णिका तालपत्रं स्यात्कुण्डलं कर्णवेष्टनम्" - अम० ।<br><br>कर्णिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಣಹುಲ್ಲು<br><b>विस्तारः - </b>"पलालोऽस्त्री कर्णिका स्त्री पूलोऽस्त्री तृणपञ्चिका" - वैज० ।<br><br>कर्णिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಸೊಂಡಿಲಿನ ತುದಿಯ ಭಾಗ<br><br>कर्णिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಾವರೆಯ ಬೀಜಕೋಶ<br><br>कर्णिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಮಧ್ಯದ ಬೆರಳು<br><b>विस्तारः - </b>"कर्णिका करिहस्ताग्रे करमध्याङ्गुलावपि" - मेदि० ।<br><br>कर्णिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಮಂಥವೃಕ್ಷ<br><br>कर्णिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಲಮುರಿಗಿಡ<br><br>कर्णिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಣ್ಣಿನ ಕಾವು -ತೊಟ್ಟು<br><br>कर्णिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಗ್ಗದ ಸರಿಗಂಟುಳ್ಳ ಕುಣಿಕೆ<br><b>विस्तारः - </b>"रज्जुः सा बन्धनी तन्त्री त्वल्पा पाशस्तु कर्णिका" - वैज० ।<br><br>

कर्णिकाचल
कर्णिकाचल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಮೇರುಪರ್ವತ<br><b>व्युत्पत्तिः - </b>कर्णिकायां स्थितोऽचलः<br><b>प्रयोगाः - </b>"एषां मध्ये इलावृतं नामाभ्यन्तरवर्षं यस्य नाभ्यामवस्थितः सर्वतः सौवर्णः कुलगिरिराजो मेरुःद्वीपायामसमुन्नाहः कर्णिकाभूतः कुवलयकमलस्य मूर्धनि द्वात्रिंशत्सास्रयोजनविततः मूले षोडशसाहस्रं तावतान्तर्भूम्यां प्रविष्टः"<br><b>उल्लेखाः - </b>भाग० ५-१६-७<br><br>

कर्णिकार
कर्णिकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಟ್ಟಗಣಿಗಿಲೆ ಗಿಡ<br><br>कर्णिकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಕ್ಕೆ ಗಿಡ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "अण्" (३-२-१) । ऋ (गतौ) - "अण्" वा ।<br><b>व्युत्पत्तिः - </b>कर्णि भेदनं करोति । कर्णिकामियर्ति ।<br><b>विस्तारः - </b>"कर्णिकारः पुमानारग्वधद्रौ च द्रुमोत्पले" - मेदि० ।<br><br>कर्णिकार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಣಿಗಿಲೆ ಹೂವು<br><b>प्रयोगाः - </b>"वर्णप्रकर्षे सति कर्णिकारं दुनोति निर्गन्धतया स्म चेतः"<br><b>उल्लेखाः - </b>कुमा० ३-२८<br><br>

कर्णिकिका
कर्णिकिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರುಹಾಕಿದ ಎಳೆಯ ಹಸು /ಕಡಸು<br><br>

कर्णिन्
कर्णिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಟಿಲವಾದ ಬಾಣ /ಡೊಂಕಾಗಿರುವ ಬಾಣ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११७)<br><b>व्युत्पत्तिः - </b>कर्णोऽस्यास्ति<br><br>कर्णिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಪ್ತಕುಲಪರ್ವತಗಳಲ್ಲೊಂದು<br><br>कर्णिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ದವಾದ ಕಿವಿಯುಳ್ಳ /ಜೋಲು ಕಿವಿಯುಳ್ಳ<br><b>निष्पत्तिः - </b>कर्ण - "इन्" (ग० ५-२-११७)<br><b>व्युत्पत्तिः - </b>विवृद्धौ कर्णौ यस्य<br><b>प्रयोगाः - </b>"करोति कर्णिनो यस्तु यस्तु खड्गादिकृन्नरः । प्रयातस्तौ विशसने नरके भृशदारुणे ॥"<br><b>उल्लेखाः - </b>विष्णुपु० १-६-१७<br><br>

कर्णिल
कर्णिल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ದವಾದ ಕಿವಿಯುಳ್ಳ /ಜೋಲು ಕಿವಿಯುಳ್ಳ<br><b>निष्पत्तिः - </b>कर्ण - "इलच्" (ग० ५-२-११७)<br><br>

कर्णी
कर्णी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಪ್ತಕುಲಪರ್ವತಗಳಲ್ಲೊಂದು<br><br>कर्णी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಲದೇವನತಾಯಿ<br><br>

कर्णीरथ
कर्णीरथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಲ್ಲಕ್ಕಿ /ಹೆಗಲ ಮೇಲೆ ಹೊರಬಹುದಾದ ಒಂದು ವಾಹನ /ಮೇನಾ<br><b>निष्पत्तिः - </b>दीर्घः (६-३-१३७)<br><b>व्युत्पत्तिः - </b>कर्णी स्कन्धवाह्यः, कर्णी चासौ रथश्च<br><b>प्रयोगाः - </b>"श्वश्रूजनानुष्ठितचारुवेषां कर्णीरथस्थां रघुवीरपत्नीम्"<br><b>उल्लेखाः - </b>रघु० १४-१३<br><br>

कर्णीसुत
कर्णीसुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೌರುಶಾಸ್ತ್ರಪ್ರವರ್ತಕನಾವ ಮೂಲದೇವ<br><b>प्रयोगाः - </b>"कर्णीसुतकथेव सन्निहितविपुलाचला" । "कर्णूसुतप्रहिते च पथि मतिमकरवम् ।"<br><b>उल्लेखाः - </b>काद०, दशकु०<br><b>विस्तारः - </b>कर्णीसुतः करटकः स्त्यशास्त्रप्रवर्तकः । तस्य ख्यातौ द्वौ सखायौ द्वौ विपुलाचलसञ्ज्ञकौ ॥<br><br>

कर्णेचुरुचुरा
कर्णेचुरुचुरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯಲ್ಲಿ ಮಾತಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>पात्रे समितादिः (२-१-४८)<br><br>

कर्णेजप
कर्णेजप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಡಿಕೋರ /ಚಾಡಿ ಹೇಳುವವನು<br><b>निष्पत्तिः - </b>जप (व्यक्तायां वाचि) - "अच्" (३-२-१३) । सप्तम्या अलुक् (६-३-९<br><b>व्युत्पत्तिः - </b>कर्णे जपति<br><b>प्रयोगाः - </b>"कर्णेजपैराहितराज्यलोभा"<br><b>उल्लेखाः - </b>भट्टि० ३-७<br><br>कर्णेजप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯಲ್ಲಿ ಮಾತಾಡುವವನು<br><br>

कर्णेन्दु
कर्णेन्दु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧಚಂದ್ರಾಕಾರದ ಒಂದು ಕರ್ಣಾಭರಣ /ಚಂದ್ರಮುರು ಎಂಬ ಕಿವಿಯ ಒಡವೆ<br><b>व्युत्पत्तिः - </b>कर्णे इन्दुरिव<br><br>

कर्णोपकर्णिका
कर्णोपकर्णिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯಿಂದ ಕಿವಿಗೆ ಪ್ರವಾದ ಹೋಗುವಿಕೆ /ಒಬ್ಬನ ಕಿವಿಯಿಂದ ಕೇಳಿದ ವಿಷಯವು ಮತ್ತೊಬ್ಬನ ಕಿವಿಗೆ ಹೋಗುವಿಕೆ<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५) ।<br><b>व्युत्पत्तिः - </b>कर्णादुपकर्णोऽस्त्यस्याः<br><b>प्रयोगाः - </b>"प्रागेव कर्णोपकर्णिकया श्रुतापवादक्षुभितहृदयः"<br><b>उल्लेखाः - </b>पञ्चतं०<br><br>

कर्णोर्ण
कर्णोर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯಲ್ಲಿ ಹೆಚ್ಚು ಉಣ್ಣೆಯುಳ್ಳ ಒಂದು ಮೃಗ<br><b>व्युत्पत्तिः - </b>कर्णे ऊर्णा यस्य<br><b>प्रयोगाः - </b>"कर्णोर्णैकपदश्वास्यैर्निर्जुष्टं वृकनाभिभिः"<br><b>उल्लेखाः - </b>भाग० ४-६-२१<br><br>

कर्ण्य
कर्ण्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿವಿಯಲ್ಲಿರುವ /ಕಿವಿಯಲ್ಲುಂಟಾದ<br><b>निष्पत्तिः - </b>"यत्" (४-३-५५)<br><b>व्युत्पत्तिः - </b>कर्णे भवः<br><br>

कर्त
कर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾವಿ<br><b>निष्पत्तिः - </b>कर्त (शैथिल्ये) - "अच्" (३-१-१३५)<br><br>कर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>कृती (छेदने) - भावे "घञ्" (३-३-१८)<br><br>कर्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಡಿಲಿಸುವವನು<br><br>कर्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವವನು<br><b>निष्पत्तिः - </b>कृती (छेदने) -"अच्" (३-१-१३५)<br><br>

कर्तन
कर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವಿಕೆ /ಭೇದಿಸುವಿಕೆ /ಒಡೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>कृती (छेदने) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"गुल्मगुच्छक्षुपलताप्रतानौषधिवीरुधाम् । पूर्वस्मृतादर्धदण्डः स्थानेषूक्तेषु कर्तने ॥"<br><b>उल्लेखाः - </b>याज्ञ० २-२२९<br><br>कर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಡಿಲಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>कर्त (शैथिल्ये) - भावे "ल्युट्" (३-३-११५)<br><br>कर्तन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವವನು<br><br>कर्तन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಡಿಲಿಸುವವನು<br><b>निष्पत्तिः - </b>कर्त (शैथिल्ये) , कृती (छेदने) - कर्त० "ल्युः" (३-१-१३४)<br><br>कर्तन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವ ಸಾಧನ/ಕತ್ತರಿ<br><b>निष्पत्तिः - </b>कृती (छेदने) - कर० "ल्युट्" (३-३-११७)<br><br>

कर्तनी
कर्तनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कर्तन ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

कर्तयत्
कर्तयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವಂತೆ ಮಾಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कृती (छेदने) + णिच् - "शतृ" (३-२-१२४)<br><br>

कर्तयन्ती
कर्तयन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವಂತೆ ಮಾಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कर्तरी
कर्तरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿ<br><b>निष्पत्तिः - </b>कृती (छेदने) - भावे "घञ्" (३-३-१८) । रा (दाने) - "कः" (३-२-४) । गौरा० "ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>कर्तं रति<br><br>कर्तरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತಿ<br><br>कर्तरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಕು /ಚೂರಿ<br><br>कर्तरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಷದಲ್ಲಿ ಹೇಳಿರುವ ಕರ್ತರೀಯೋಗ<br><b>विस्तारः - </b>"लग्नात्पापावृज्वनृजूव्ययार्थस्थौ यदा तदा । कर्तरी नाम सा ज्ञेया मृत्युदरिद्र्यशोकदा ॥" - मृ० चि०<br><br>

कर्तरिका
कर्तरिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಷದಲ್ಲಿ ಹೇಳಿರುವ ಕರ್ತರೀಯೋಗ<br><b>निष्पत्तिः - </b>स्वर्थे "कन्"<br><br>

कर्त्तव्य
कर्त्तव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯ /ಕೆಲಸ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) -"तव्यः" (३-१-९६)<br><b>प्रयोगाः - </b>"कर्त्तव्यं वो न पश्यामि स्यात् चेत किं नोपपद्यते"<br><b>उल्लेखाः - </b>कुमा० ६-६१<br><br>कर्त्तव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಶ್ಯವಾಗಿ ಮಾಡಲ್ಪಡಬೇಕಾದ<br><b>प्रयोगाः - </b>"आदानस्य प्रदानस्य कर्तव्यस्य च कर्मणः । क्षिप्रमक्रियमाणस्य कालः पिबति तद्रसम् ॥"<br><b>उल्लेखाः - </b>हितो० ४-९५<br><br>कर्त्तव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಲ್ಪಡಲು ಯೋಗ್ಯವಾದ<br><b>प्रयोगाः - </b>"हीनसेवा न कर्तव्या कर्तव्यो महदाश्रमः"<br><b>उल्लेखाः - </b>हितो० ३-११<br><br>कर्त्तव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಲ್ಪಡಲು ಶಕ್ಯವಾದ<br><br>कर्त्तव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - कर्मे० अर्हे शक्तौ वा "तव्यः" (३-१-९६)<br><br>

कर्त्तव्यता
कर्त्तव्यता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಶ್ಯವಾಗಿ ಮಾಡಲ್ಪಡಬೇಕಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कर्तव्यस्य भावः<br><b>प्रयोगाः - </b>"संविशेत्तूर्यघोषेण प्रतिबुध्येत् तथैव च । शास्त्राणि चिन्तयेत् बुद्ध्या सर्वकर्तव्यतास्तथा ॥"<br><b>उल्लेखाः - </b>याज्ञ० १-३३१<br><br>

कर्तव्यत्व
कर्तव्यत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಶ್ಯವಾಗಿ ಮಾಡಲ್ಪಡಬೇಕಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

कर्तित
कर्तित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವಂತೆ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>कृती (छेदने) + णिच् - भावे "क्तः" (३-३-११४)<br><br>कर्तित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವಂತೆ ಮಾಡಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>कृती (छेदने) + णिच् - कर्म० "क्तः" (३-२-१०२)<br><br>

कर्तितवत्
कर्तितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವಂತೆ ಮಾಡಿದ<br><b>निष्पत्तिः - </b>कृती (छेदने) + णिच् - "क्तवतुः" (३-२-१०२)<br><br>

कर्तितवती
कर्तितवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವಂತೆ ಮಾಡಿದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कर्तितुकाम
कर्तितुकाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸಲು ಅಪೇಕ್ಷೆಯುಳ್ಳ /ಕತ್ತರಿಸಲು ಮನಸ್ಸುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कर्तितुं कमो यस्य<br><br>

कर्तितुमनस्
कर्तितुमनस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸಲು ಅಪೇಕ್ಷೆಯುಳ್ಳ /ಕತ್ತರಿಸಲು ಮನಸ್ಸುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कर्तितुं मनो यस्य<br><br>

कर्तितृ
कर्तितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವ<br><b>निष्पत्तिः - </b>कृती (छेदने) - "तृच्"(३-१-१३३)<br><br>

कर्तित्री
कर्तित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कर्तुकाम
कर्तुकाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಲು ಅಪೇಕ್ಷೆಯುಳ್ಳ /ಮಾಡಲು ಮನಸ್ಸುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कर्तुं कामो यस्य<br><br>

कर्तुमनस्
कर्तुमनस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಲು ಅಪೇಕ್ಷೆಯುಳ್ಳ /ಮಾಡಲು ಮನಸ್ಸುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कर्तुं मनो यस्य<br><br>

कर्तृ
कर्तृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಗತ್ ಸೃಷ್ಟಿಕರ್ತನಾದ ವಿಷ್ಣು /ಪರಮಾತ್ಮ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) -"तृच्" (३-१-१३३)<br><br>कर्तृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ತವೀರ್ಯ ಮುಂತಾದವರನ್ನು ಕತ್ತರಿಸಿದ ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>कृती (छेदने) - "तृच्" (३-१-१३३)<br><b>प्रयोगाः - </b>"करणं कारणं कर्ता विकर्ता गहनो गुहः । क्रोधहा क्रोधकृत् कर्ता"<br><b>उल्लेखाः - </b>वि०स०<br><b>विस्तारः - </b>"क्रुद्धेतोः कार्तवीर्यस्य च्छेत्ता कर्तेति शब्द्यते" -निरुक्तिः ।<br><br>कर्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯ ಮಾಡುವವನು<br><b>प्रयोगाः - </b>"मुक्तसङ्गोऽनहंवादी धृत्युत्साहसमन्वितः । सिद्ध्यसिद्ध्योर्निर्विकारः कर्त्ता सात्त्विक उच्यते ॥"<br><b>उल्लेखाः - </b>गीता० १८-२६<br><br>कर्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಯಾರಿಸುವವನು<br><br>कर्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೃಷ್ಟಿಸುವವನು<br><br>कर्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಚಿಸುವವನು /ನಿರ್ಮಿಸುವವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) -तच्छीलादिषु "तृन्" (३-२-१३५)<br><br>कर्तृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣ ಶಾಸ್ತ್ರದಲ್ಲಿ ಉಕ್ತವಾದ ಕರ್ತೃಸಂಜ್ಞೆಯುಳ್ಳವನು /ಇತರ ಕಾರಕಗಳಿಗೆ ಅಧೀನನಲ್ಲದೆ ಅವುಗಳ ಮೂಲಕ ಕ್ರಿಯೆಯನ್ನು ನಡೆಸುವವನು<br><b>प्रयोगाः - </b>"कर्ता द्यूतच्छलानां जतुमयशरणोद्दीपनः सोऽभिमानी कृष्णाकेशोत्तरीयव्यपनयनमरुत् पाण्डवा यस्य दास्याः"<br><b>उल्लेखाः - </b>वेणी० ५-२६<br><b>विस्तारः - </b>"स्वतन्त्रः कर्ता" - पा० सू० ।<br><br>

कर्त्री
कर्त्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कर्तृ ಪದದ ಅರ್ಥ<br><br>

कतृग
कतृग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯ ಮಾಡುವವನ್ನು ಸೇರುವ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "डः" (वा० ३-२-४७)<br><b>व्युत्पत्तिः - </b>कर्तारं गच्छति<br><br>

कतृगामिन्
कतृगामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>कतृग ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>कर्तारं गच्छति<br><br>

कतृगामिनी
कतृगामिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कतृग ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कतृगुप्त
कतृगुप्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ತೃಪದವು ಗುಪ್ತವಾಗಿರುವ (ಸ್ಪಷ್ಟವಾಗಿ ತೋರದಿರುವ) ವಾಕ್ಯ<br><br>

कतृता
कतृता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಜಮಾನತನ /ಕಾರ್ಯ ಮಾಡುವವನ ದೆಸೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कर्तुः भावः<br><b>प्रयोगाः - </b>"कर्तृता तदुपलम्भतोऽभवद्वृत्तिभाजि करणे यथर्त्विजि"<br><b>उल्लेखाः - </b>माघ० १४-१९<br><br>

कतृत्व
कतृत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಜಮಾನತನ /ಕಾರ್ಯ ಮಾಡುವವನ ದೆಸೆ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

कत्रभिप्राय
कत्रभिप्राय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ತೃವಿನ ಆಶಯ<br><b>व्युत्पत्तिः - </b>कर्तुः अभिप्रायः<br><br>कत्रभिप्राय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯ ಮಾಡುವವನ್ನು ಸೇರುವ<br><b>निष्पत्तिः - </b>अभि + प्र + इण् (गतौ) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कर्तारमभिप्रैति गच्छति<br><b>विस्तारः - </b>"स्वरितञितः कर्त्रभिप्राये क्रियाफले"- पा० सू० १-३-७२<br><br>

कर्द|कुत्सिते|कर्दति
कर्द - कुत्सिते शब्दे (भ्वा० पर० सक० से० ) कर्दति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕರ್ಕಶ ಶಬ್ದ ಮಾಡು /ಕಾಗೆಯಂತೆ ಒರಟಾಗಿ ಕೂಗು<br><br>

कर्द
कर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಸರು /ಒದ್ದೆಯ ಮಣ್ಣು /ತೇವದ ಮಣ್ಣು<br><b>निष्पत्तिः - </b>कर्द (कुत्सिते शब्दे) - "अच्" (३-१-१३४)<br><br>

कर्दट
कर्दट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಸರು /ಒದ್ದೆಯ ಮಣ್ಣು /ತೇವದ ಮಣ್ಣು<br><br>कर्दट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾವರೆಯ ಗೆಡ್ಡೆ<br><br>कर्दट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನಲ್ಲಿ ಬೆಳೆಯುವ ಹುಲ್ಲು ಜೊಂಡು ಮುಂತಾದುದು<br><br>

कर्दन
कर्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಟ್ಟೆಯೊಳಗಿನ ಶಬ್ದ<br><b>निष्पत्तिः - </b>कर्द (कुत्सिते शब्दे) - भावे "ल्युट्" (३-३-११५)<br><br>

कर्दम
कर्दम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಸರು /ಒದ್ದೆಯ ಮಣ್ಣು /ತೇವದ ಮಣ್ಣು<br><b>निष्पत्तिः - </b>कर्द (कुत्सिते शब्दे) - "अमः" (उ० ४-८४)<br><b>प्रयोगाः - </b>"सरितः कुर्वती गाधाः पथश्चाश्यानकर्दमान्"<br><b>उल्लेखाः - </b>रघु० ४-२४<br><br>कर्दम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><b>निष्पत्तिः - </b>कर्द (कुत्सिते शब्दे) - कर० "अमः" (उ० ४-८४)<br><br>कर्दम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮನು ಪ್ರಜಾಸೃಷ್ಟಿಗಾಗಿ ಸೃಷ್ಟಿಸಿದ ಪ್ರಜಾಪತಿಗಳಲ್ಲೊಬ್ಬ /ದೇವಹೂತಿಯ ಪತಿ<br><b>प्रयोगाः - </b>"प्रजाः सृजेति भगवान् कर्दमो ब्रह्मणोदितः । सरस्वत्यां तपस्तेपे सहस्राणां सामा दश ॥" "वेदेषु कर्दमः शब्दः छायायां वर्तते स्पुटम् । बभूव कर्दमाद्वालः कर्दमस्तेन कीर्तितः ॥"<br><b>उल्लेखाः - </b>भाग० ३-२१-६, ब्रह्मवै०<br><br>कर्दम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಛಾಯೆ /ನೆರಳು<br><br>कर्दम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಂಸ<br><b>विस्तारः - </b>ಇದನ್ನು ತಿನ್ನುವುದರಿಂದ ಹೊಟ್ಟೆಯಲ್ಲಿ ಶಬ್ದವಾಗುವುದರಿಂದ ಈ ಹೆಸರು.<br><br>कर्दम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಸರಿನಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>कर्दमोऽस्यास्ति<br><br>

कर्दमक
कर्दमक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಸರಿನ ಗದ್ದೆಯಲ್ಲಿ ಬೆಳೆಯುವ ಬತ್ತ<br><b>निष्पत्तिः - </b>कै (शब्दे) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कर्दमे कायति<br><b>प्रयोगाः - </b>"लोहितशालिकलमकर्दमकपाण्डुकसुगन्धकशकुनाहृतपुष्पाण्डकपुण्डरीकमहाशालिशीतभीरुकरोध्रपुष्पकदीर्घशूक--------------प्रभृतयः शालयः"<br><b>उल्लेखाः - </b>सुश्रुत० सूत्र० ४६-४<br><br>

कर्दमाटक
कर्दमाटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಸದ ಗುಂಡಿ /ತಿಪ್ಪೆ ಗುಂಡಿ<br><b>निष्पत्तिः - </b>"कप्" (५-४-१५४)<br><b>व्युत्पत्तिः - </b>कर्दम इव आटो गतिरत्र<br><br>

कर्दमित
कर्दमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಸರಾಗಿರುವ /ತೇವದ ಮಣ್ಣಿನಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>कर्दमोऽस्य सञ्जातः<br><br>

कर्दमिनी
कर्दमिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಸರಿನ ಪ್ರದೇಶ /ತೇವದ ಮಣ್ಣಿನಿಂದ ಕೂಡಿದ ದೇಶ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-१३५) । "ङीप्" (४-१-५)<br><b>व्युत्पत्तिः - </b>कर्दमानां देशः<br><br>

कर्पट
कर्पट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಂದಿ ಬಟ್ಟೆ /ಜೂಲು ಬಟ್ಟೆ /ಹರಕಲು ಬಟ್ಟೆ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "विच्" (३-२-७५)<br><b>व्युत्पत्तिः - </b>कर् चसौ पटश्च<br><br>कर्पट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಲಿನ ವಸ್ತ್ರ /ಕೊಳೆ ಬಟ್ಟೆ<br><br>कर्पट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರವಸ್ತ್ರ /ಮುಖದ ಬೆವರು ಮುಂತಾದುವನ್ನು ಒರೆಸಿಕೊಳ್ಳುವ ಸಣ್ಣ ಚೌಕ<br><b>निष्पत्तिः - </b>पृषो०<br><b>व्युत्पत्तिः - </b>करस्य पटः<br><br>

कर्पटिक
कर्पटिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಕಲು ಬಟ್ಟೆಯನ್ನು ಉಟ್ಟಿರುವ ತಿರುಕಮೊದಲಾದವರು<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५) ।<br><b>व्युत्पत्तिः - </b>कर्पटोऽस्यास्ति<br><br>

कर्पटिन्
कर्पटिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಕಲು ಬಟ್ಟೆಯನ್ನು ಉಟ್ಟಿರುವ ತಿರುಕಮೊದಲಾದವರು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कर्पटोऽस्यास्ति<br><br>

कर्पण
कर्पण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣದ ಒಂದು ಆಯುಧ /ಉದ್ದದ ಹಿಡಿಯ ಭರ್ಜಿ /ಈಟಿ<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) - "ल्युट्" (३-३-११७)<br><b>प्रयोगाः - </b>"चापचक्रकणपकर्पणप्रासपट्टिशमुसलतोमरादिप्रहरणजालमुपयुञ्जानः"<br><b>उल्लेखाः - </b>दशकु०<br><br>

कर्पर
कर्पर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಾಲ /ತಲೆಬುರುಡೆ /ತಲೆಯೆಲುಬಿನ ಚಿಪ್ಪು<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) - "अरः" बाहु० लत्वाभावश्च ।<br><br>कर्पर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಮೆಯ ಚಿಪ್ಪು<br><b>प्रयोगाः - </b>"न्यञ्चत्कर्परकूर्मकम्पविगलद्ब्रह्माण्डखण्डस्थिति"<br><b>उल्लेखाः - </b>मालती० ५-२२<br><br>कर्पर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಾಲ /ಘಟದ ಅರ್ಧಭಾಗ<br><br>कर्पर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಆಯುಧ<br><b>विस्तारः - </b>"कर्परः स्यात्कपाले च शस्त्रभेदकटाहयोः" - मेदि० ।<br><br>कर्पर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತ್ತಿಮರ /ಉದುಂಬರ ವೃಕ್ಷ<br><br>कर्पर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೈಲವನ್ನು ಕುದಿಸುವ ಪಾತ್ರೆ<br><br>कर्पर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣಲೆ<br><br>कर्पर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುರಿಯುವ ಓಡು<br><br>कर्पर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>विस्तारः - </b>"कर्परोऽग्नौ कपालेऽपि" - वैज० ।<br><br>

कर्परांश
कर्परांश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಾಲದ ಒಂದು ಭಾಗ /ಮಡಕೆಯ ಒಂದು ಚೂರು /ಬಕ್ಕರೆ<br><br>

कर्पराल
कर्पराल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಟ್ಟಗೋಣಿಮರ<br><b>निष्पत्तिः - </b>अल (भूषणादौ) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कर्परमलति<br><br>

कर्परी
कर्परी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಲುತುತ್ತ<br><br>

कर्पास
कर्पास<br><br><b>पदविभागः - </b>त्रिलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿಯ ಗಿಡ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "पासः" (उ० ५-५५)<br><br>

कर्पूर
कर्पूर<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಪೂರ /ಒಂದು ಸುಗಂಧ ವಸ್ತು<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) - "ऊरः" (उ० ४-९०)<br><b>प्रयोगाः - </b>"सखीमुखायोत्सृजतीमपाङ्गात्कर्पूरकस्तूरिकयोः प्रवाहम्"<br><b>उल्लेखाः - </b>नैष० १०-१०२<br><br>

कर्पूरक
कर्पूरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಚೋರ<br><b>व्युत्पत्तिः - </b>कर्पूर इव कायति<br><br>

कर्पूरतैल
कर्पूरतैल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಪೂರದ ಎಣ್ಣೆ /ಹಿಮತೈಲ<br><br>

कर्पूरद्वीप
कर्पूरद्वीप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಂಬೂದ್ವೀಪಾಂತರ್ಗತವಾದ ಒಂದು ಚಿಕ್ಕ ದ್ವೀಪ<br><b>प्रयोगाः - </b>"कर्पूरद्वीपस्य राजचक्रवर्तिनो हिरण्यगर्भस्य राजहंसस्यानुचरोऽहम्"<br><b>उल्लेखाः - </b>हितो०<br><br>

कर्पूरमञ्जरी
कर्पूरमञ्जरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಪೂರಸೇನನ ಮಗಳು<br><br>कर्पूरमञ्जरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಪೂರಕೇಳಿಯೆಂಬ ಒಂದು ಹಂಸಪಕ್ಷಿಯ ಮಗಳು<br><b>प्रयोगाः - </b>"अहं पुरा शूद्रकस्य राज्ञः क्रीडासरसि कर्पूरकेलिनाम्नो राजहंसस्य पुत्र्या कर्पूरमञ्जर्या सहानुरागवानभवम्"<br><b>उल्लेखाः - </b>हितो०<br><br>कर्पूरमञ्जरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜಶೇಖರಕೃತವಾದ ಒಂದು ರೂಪಕ<br><br>

कर्ब|गतौ|कर्बति
कर्ब - गतौ (भ्वा० पर० अक० से०) कर्बति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೋಗು /ಚಲಿಸು /ನಡೆ<br><br>

कर्बु
कर्बु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರವರ್ಣ<br><b>निष्पत्तिः - </b>कर्ब (गतौ) - "उः" बाहु० ।<br><br>कर्बु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರವರ್ಣವುಳ್ಳ /ನಾನಾಬಣ್ಣಗಳುಳ್ಳ<br><b>प्रयोगाः - </b>"अनन्ता रश्मयस्तस्य दीपवद्यः स्थितो हृदि । सितासिताः कर्बुनीलाः कपिलाः पीतलोहिताः ॥"<br><b>उल्लेखाः - </b>याज्ञ० ३-१६६<br><br>

कर्बुदार
कर्बुदार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋವಿದಾರ ವೃಕ್ಷ /ಕೆಂಗಾಂಚಾಳದ ಗಿಡ<br><br>कर्बुदार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಗಸಂಪಿಗೆ ಗಿಡ<br><b>व्युत्पत्तिः - </b>कर्बुः सन् दारयति मलम्<br><b>प्रयोगाः - </b>"प्रियालकर्बुदारसुर्यवल्लीत्रपुसैर्वारुककर्कारुकूष्माण्डप्रभृतीनां तैलानि मधुराणि"<br><b>उल्लेखाः - </b>सुशुत० सूत्र० ४५-१२०<br><br>कर्बुदार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿಯ ಹೂವಿನ ಗೋರಂಟಿ<br><br>

कर्बुदारक
कर्बुदारक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ಲೇಷ್ಮಾತಕವೃಕ್ಷ /ಚಳ್ಳೆ ಮರ<br><b>निष्पत्तिः - </b>दृ (विदारणे)- "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कर्बुः सन् दारयति कफम्<br><br>

कर्बुर
कर्बुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರವರ್ಣ<br><b>निष्पत्तिः - </b>कर्ब (गतौ) - "उरच्" (उ० १-४१)<br><br>कर्बुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><br>कर्बुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಕ್ಷಸ<br><br>कर्बुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದತ್ತೂರಿ ಗಿಡ<br><br>कर्बुर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುವರ್ಣ /ಚಿನ್ನ<br><br>कर्बुर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><b>विस्तारः - </b>"कर्बुरं काञ्चने जले । कर्बुरो राक्षसे पापे शबले" - हेम० ।<br><br>कर्बुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರವರ್ಣದ /ನಾನಾಬಣ್ಣದ<br><b>प्रयोगाः - </b>"तदिदं कणशो विकीर्यते पवनैर्भस्म कपोतकर्बुरम्"<br><b>उल्लेखाः - </b>कुमा० ४-२७<br><br>

कर्बुरक
कर्बुरक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರವರ್ಣದ /ನಾನಾಬಣ್ಣದ<br><br>

कर्बुरित
कर्बुरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾನಾ ವರ್ಣವಾಗಿರುವ /ಚಿತ್ರವರ್ಣವಾಗಿರುವ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>कर्बुरोऽस्य सञ्जातः<br><br>

कर्बुरी
कर्बुरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ/ಪಾರ್ವತಿ<br><br>कर्बुरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾರಂಬೇಳೆ ಗಿಡ<br><br>

कर्मकर
कर्मकर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಮಧರ್ಮರಾಯ<br><br>कर्मकर<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಂಡೆ ಗಿಡ<br><br>कर्मकर<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುರಟಗೆ ಗಿಡ<br><b>विस्तारः - </b>"अथ कर्मकरो भृत्ये वेतनाजीविनि त्रिषु । कीनाशे पुंसि मूर्वायां बिम्बकायामपि स्त्रियाम्" - मेदि० ।<br><br>कर्मकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೂಲಿಗಾಗಿ ಕೆಲಸ ಮಾಡುವವನು /ಕೂಲಿ ಕೆಲಸದವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "टः" (३-२-२२)<br><b>व्युत्पत्तिः - </b>कर्म करोति<br><br>कर्मकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡುವ ಸ್ವಭಾವದವನು /ಸೇವಕ /ಆಳು<br><b>प्रयोगाः - </b>"यस्तवेह सवने न भूपतिः कर्म कर्मकरवत् करिष्यति"<br><b>उल्लेखाः - </b>माघ० १४-१६<br><br>

कर्मकरी
कर्मकरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಾಸಿ /ಸೇವಕಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

कर्मकतृ
कर्मकतृ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೌಕರ್ಯಾತಿಶಯ ತೋರಿಸಲು ಕರ್ತೃಭಾವಹೊಂದಿದ ಕರ್ಮ<br><b>व्युत्पत्तिः - </b>कर्मैव कर्ता<br><b>विस्तारः - </b>"क्रियमाणं तु यत्कर्म स्वयमेव प्रसिध्यति । सुकरैः स्वगुणैः कर्तुः कर्मकर्तेति तद्विदुः ॥"<br><br>

कर्मकाण्ड
कर्मकाण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞಯಾಗಾದಿಗಳನ್ನು ಅವಶ್ಯವಾಗಿ ಅನುಷ್ಠಿಸಬೇಕೆಂದು ಹೇಳುವ ವೇದದ ಒಂದು ಭಾಗ /ಕರ್ಮಗಳನ್ನು ಪ್ರತಿಪಾದಿಸುವ ವೇದಭಾಗ<br><b>व्युत्पत्तिः - </b>कर्मणां कर्तव्यता प्रतिपादकं काण्डम्<br><b>प्रयोगाः - </b>"ततः कर्मकाण्डसहचरी मीमांसा मया दृष्टा"<br><b>उल्लेखाः - </b>प्रबोध० ६<br><br>

कर्मकार
कर्मकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮ್ಮಾರ /ಕಬ್ಬಿಣದ ಕೆಲಸ ಮಾಡುವವನು /ಒಬ್ಬ ಮಿಶ್ರಜಾತಿಯವನು<br><br>कर्मकार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೂಲಿಯಿಲ್ಲದೆ ಕೆಲಸ ಮಾಡುವವನು /ಅದೇ ಕಸಬಿನವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे)- "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कर्म करोति वेतनेन विना<br><b>विस्तारः - </b>"कर्मकारस्तु तत्क्रियः" - अम० ।<br><br>

कर्मकारक
कर्मकारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೂಲಿಯಿಲ್ಲದೆ ಕೆಲಸ ಮಾಡುವವನು /ಅದೇ ಕಸಬಿನವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे)- "ण्वुल्" (३-१-१३३)<br><br>कर्मकारक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪದದ ೮ ನೆಯ ಅರ್ಥ<br><br>

कर्मकारिन्
कर्मकारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡುವ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>कर्म करोति<br><b>प्रयोगाः - </b>"तान्विदित्वा सुचरितैर्गूढैस्तत्कर्मकारिभिः"<br><b>उल्लेखाः - </b>मनु० ९-२६१<br><br>

कर्मकारिणी
कर्मकारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡುವ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कर्मकाल
कर्मकाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸದ ಸಮಯ /ಕೆಲಸ ಮಾಡಲು ಕ್ಲೃಪ್ತವಾದ ಕಾಲ<br><br>कर्मकाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗಾದಿ ಕರ್ಮಗಳನ್ನು ಆಚರಿಸಬೇಕಾದ ಕಾಲ<br><br>

कर्मकीलक
कर्मकीलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಜಕ /ಅಗಸರವನು<br><b>व्युत्पत्तिः - </b>कर्मणा कीलक इव<br><b>विस्तारः - </b>"चन्द्रिलो नखकुट्टश्च रजकः कर्मकीलकः" - त्रिकाण्ड० ।<br><br>

कर्मक्षम
कर्मक्षम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದಲ್ಲಿ ಸಮರ್ಥನಾದವನು /ಕೆಲಸದಲ್ಲಿ ಚತುರನಾದವನು /ಕೆಲಸ ಮಾಡಬಲ್ಲವನು<br><b>व्युत्पत्तिः - </b>कर्मणि क्षमः<br><b>प्रयोगाः - </b>"आत्मकर्मक्षमं देहं क्षात्रो धर्म इवाश्रितः"<br><b>उल्लेखाः - </b>रघु० १-१३<br><br>

कर्मक्षेत्र
कर्मक्षेत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯಕ್ಷೇತ್ರ /ಕೆಲಸ ಮಾಡಬೇಕಾದ ಜಾಗ<br><br>कर्मक्षेत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗಾದಿ ಕರ್ಮಾಚರಣೆಗೆ ಯೋಗ್ಯವಾದ ಭೂಮಿ /ಭಾರತ ವರ್ಷ<br><b>व्युत्पत्तिः - </b>कर्मणां क्रियानुष्ठानां क्षेत्रम्<br><b>प्रयोगाः - </b>"भारतमेव वर्षं कर्मक्षेत्रमन्यान्यष्टवर्षाणि स्वर्गिणां पुण्यशेषभोगस्थानानि भौमानि स्वर्गपदानि"<br><b>उल्लेखाः - </b>भाग० ५-१७-११<br><br>

कर्मगुप्त
कर्मगुप्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮಪದವು ಗುಪ್ತವಾಗಿರುವ ವಾಕ್ಯ<br><b>विस्तारः - </b>"एहि हे रमणि पश्य कौतुकं धूलिधूसरतनुं दिगम्बरम् । सापि तद्वनपङ्कजं पपौ भ्रातरुक्तमपि किं न बुध्यते" ಎಂಬಲ್ಲಿ कौतुकं बालकं पश्य ಎಂದು ಅನ್ವಯ. कौतुक ಪದದಲ್ಲಿ ಕರ್ಮಪದವು ಗುಪ್ತವಾಗಿರುವುದು<br><br>

कर्मग्रन्थि
कर्मग्रन्थि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಸಾರ ಬಂದನಕ್ಕೆ ಕಾರಣವಾದ ಪುಣ್ಯಪಾಪ ರೂಪವಾದ ಕರ್ಮವನ್ನುಂಟುಮಾಡುವ ಪೂರ್ವವಾಸನೆ<br><b>व्युत्पत्तिः - </b>कर्मणा ग्रन्थिः बन्धनमस्मात्<br><br>

कर्मचण्डाल
कर्मचण्डाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದಿಂದ ಚಂಡಾಲನಂತಿರುವವನು /ಚಂಡಾಲ ಜನ್ಮ ಪಡೆಯದಿದ್ದರೂ ಮಾಡುವ ಕ್ರೂರಕರ್ಮಗಳಿಂದ ಚಂಡಾಲನಂತಾಗಿರುವವನು<br><b>व्युत्पत्तिः - </b>कर्मणा चण्डाल इव<br><b>प्रयोगाः - </b>"अपूर्वकर्मचण्डालमयि मुग्धे विमुञ्च माम्"<br><b>उल्लेखाः - </b>उ० रा० १-४६<br><br>कर्मचण्डाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಹು<br><b>प्रयोगाः - </b>"उत्तिष्ठ गम्यतां राहो त्यज्यतां चन्द्रसङ्गमः । कर्मचण्डाल योगोत्थं मम पापक्षयं कुरु ॥"<br><br>

कर्मचारिन्
कर्मचारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದಲ್ಲಿ ನಿರತನಾಗಿರುವವನು /ಕೆಲಸ ಮಾಡುತ್ತಿರುವವನು<br><b>निष्पत्तिः - </b>चर (गतौ) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>कर्मणि चरति<br><br>

कर्मचारिणी
कर्मचारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದಲ್ಲಿ ನಿರತನಾಗಿರುವವಳು /ಕೆಲಸ ಮಾಡುತ್ತಿರುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्"(४-१-५)<br><br>

कर्मचेष्टा
कर्मचेष्टा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮಾನುಷ್ಠಾನಕ್ಕಾಗಿ ಮಾಡುವ ವ್ಯಾಪಾರ /ಕರ್ಮಾಚರಣೆಗಾಗಿ ಮಾಡುವ ಕೆಲಸ<br><b>व्युत्पत्तिः - </b>कर्मणि चेष्टा<br><b>प्रयोगाः - </b>"कर्मचेष्टास्वहः कृष्णः शुक्लः स्वप्नाय शर्वरी"<br><b>उल्लेखाः - </b>मनु० १-६६<br><b>विस्तारः - </b>ಒಂದು ಕಾಯವಾಗಬೇಕಾದರೆ ೧)ಆತ್ಮನಿಗೆ ಕೆಲಸ ಮಾಡಬೇಕೆಂಬ ಇಚ್ಛೆ ೨)ಇಚ್ಛೆಯಿಂದ ಕೃತಿ ೩)ಕೃತಿಯಿಂದ ಚೇಷ್ಟೆ ೪)ಚೇಷ್ಟೆಯಿಂದ ಕ್ರಿಯೆ ಎಂಬ ೪ ಹಂತಗಳುಂಟು.<br><br>

कर्मचोदना
कर्मचोदना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮಾಚರಣೆಗಾಗಿ ಪ್ರೇರಿಸುವ ವಿಧಿವಾಕ್ಯ<br><b>व्युत्पत्तिः - </b>कर्मणि कर्माचरणे चोदना विधिः प्रवर्तकं वचनम्<br><br>कर्मचोदना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮಪ್ರವೃತ್ತಿಗೆ ಕಾರಣವಾದ ಜ್ಞಾನ ಜ್ಞೇಯ ಪರಿಜ್ಞಾತೃಗಳೆಂಬ ಮೂರರಿಂದ ಕೂಡಿದ ಜ್ಯೋತಿಷ್ಟೋಮಾದಿ ಕರ್ಮವಿಧಿ /ಕರ್ತವ್ಯಕರ್ಮ ವಿಷಯಜ್ಞಾನ<br><b>प्रयोगाः - </b>"ज्ञानं ज्ञेयं परिज्ञाता त्रिविधा कर्मचोदना"<br><b>उल्लेखाः - </b>गीता० १८-१८<br><br>

कर्मज
कर्मज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಗ<br><br>कर्मज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನರಕ<br><br>कर्मज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಟವೃಕ್ಷ /ಆಲದ ಮರ'<br><br>कर्मज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲಿಯುಗ<br><br>कर्मज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಿಯೆಯಿಂದ ಉಂಟಾಗುವ ಸಂಯೋಗ ಮತ್ತು ವಿಭಾಗ<br><br>कर्मज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುಣ್ಯಪಾಪಕರ್ಮಗಳಿಂದ ಉಂಟಾದ ಜನ್ಮಾಂತರ ಪ್ರಾಪ್ತಿ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे)- "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>कर्मणो जायते<br><br>कर्मज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜನ್ಮಾಂತರದ ದುಷ್ಟಕರ್ಮಗಳಿಂದ ಉತ್ಪನ್ನವಾಗುವ ವ್ಯಾಧಿಗಳು<br><b>प्रयोगाः - </b>"कर्मजाः कथिताः केचित् दोषजाः सन्ति चापरे । कर्मदोषोद्भवाश्चान्ये व्याधयः त्रिविधाः स्मृताः ॥"<br><b>उल्लेखाः - </b>भावप्र०<br><br>कर्मज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಷಿದ್ಧಕಾರ್ಯಾಚರಣೆಯಿಂದ ಉಂಟಾದ ದೋಷ<br><b>प्रयोगाः - </b>"यथा जातफलोवह्निर्दहत्यार्द्रानपि द्रुमान् । तथा दहति वेदज्ञः कर्मजं दोषमात्मनः ॥"<br><b>उल्लेखाः - </b>मनु० १२-१०२<br><br>कर्मज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿತ್ಯ ನೈಮಿತ್ತಿಕಾದಿ ಕರ್ಮಗಳಿಂದ ಉಂಟಾದ ಯಜ್ಞಗಳು<br><b>प्रयोगाः - </b>"कर्मजान् विद्धि तान् सर्वान् एवं ज्ञात्वा विमोक्ष्यसे"<br><b>उल्लेखाः - </b>गीता० ४-३२<br><br>

कर्मजित्
कर्मजित्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜರಾಸಂಧನ ವಂಶದ ಒಬ್ಬ ದೊರೆ<br><b>प्रयोगाः - </b>"सुनक्षत्रः सुनक्षत्रात् बृहत्सेनोऽथ कर्मजित्"<br><b>उल्लेखाः - </b>भाग० ९-२२-४७<br><br>कर्मजित्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರ್ಮದ ಫಲವಾದ ಪಾಪಪುಣ್ಯಗಳನ್ನು ಜಯಿಸಿದವನು<br><b>व्युत्पत्तिः - </b>कर्मणि कर्मफलानि जितवान्<br><br>

कर्मठ
कर्मठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸದಲ್ಲಿ ನಿರತನಾದವನು /ಆರಂಭಿಸಿದ ಕಾರ್ಯವನ್ನು ಸಮಾಪ್ತಿಗೊಳಿಸುವುದರಲ್ಲಿ ಶೂರನಾದವನು<br><b>निष्पत्तिः - </b>"अठच्" (५-२-३५)<br><b>व्युत्पत्तिः - </b>कर्मणि घटते<br><br>

कर्मण्य
कर्मण्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದಲ್ಲಿ ಕುಶಲ /ಕೆಲಸದಲ್ಲಿ ಪ್ರವೀಣ<br><b>निष्पत्तिः - </b>"यत्" (४-४-९८)<br><b>व्युत्पत्तिः - </b>कर्मणि साधुः<br><br>कर्मण्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದಿಂದ ಶೋಭಿಸುವ ಶೌರ್ಯ<br><b>निष्पत्तिः - </b>"यत्" (५-१-१००)<br><b>व्युत्पत्तिः - </b>सम्पादः सम्पत्तिः शोभा - साऽस्यास्ति, कर्मणा सम्पादि<br><br>

कर्मण्या
कर्मण्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇತನ /ಕೂಲಿ /ಬಾಡಿಗೆ<br><b>विस्तारः - </b>"कर्मण्या तु विधाभृत्याभृतयो भर्म वेतनम्" - अम० ।<br><br>

कर्मण्यता
कर्मण्यता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದಲ್ಲಿ ನಿಪುಣತನ /ಕಾರ್ಯ ಮಾಡುವುದರಲ್ಲಿ ಜಾಣತನ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कर्मण्यस्य भावः<br><br>

कर्मण्यत्व
कर्मण्यत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದಲ್ಲಿ ನಿಪುಣತನ /ಕಾರ್ಯ ಮಾಡುವುದರಲ್ಲಿ ಜಾಣತನ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

कर्मण्यभुज्
कर्मण्यभुज्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೂಲಿಯಿಂದ ಜೀವಿಸುವವನು /ಕೂಲಿ ಕೆಲಸ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>भुज (पालनाभ्यवहारयोः) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>कर्मण्यां वेतनं भुङ्क्ते<br><br>

कर्मत्याग
कर्मत्याग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮಸಂನ್ಯಾಸ /ಕರ್ಮಗಳನ್ನು ಆಚರಿಸುವಿಕೆ /ಪ್ರಾಪಂಚಿಕ ವ್ಯವಹರಗಳನ್ನು ಬಿಟ್ಟಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>कर्मणां त्यागः<br><br>कर्मत्याग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಫಲಾಪೇಕ್ಷೆಯಿಲ್ಲದ ಕರ್ಮಾಚರಣೆ<br><br>

कर्मदुष्ट
कर्मदुष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡುವ ಕೆಲಸದಿಂದ ಕೆಟ್ಟಿರುವ /ನಡತೆಯಿಂದ ಕೆಟ್ಟಿರುವ /ನೀತಿಬಾಹಿರ<br><b>व्युत्पत्तिः - </b>कर्मणा दुष्टः<br><br>

कर्मदेव
कर्मदेव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮದಿಂದ ದೇವತ್ವವನ್ನು ಹೊಂದಿದ ದೇವತೆ<br><b>व्युत्पत्तिः - </b>कर्मणा देवः<br><b>प्रयोगाः - </b>"स एकः कर्मदेवनां देवानामानन्दः । ये कर्मणा देवानपियन्ति । श्रोत्रियस्य चाकामहतस्य । ते ये शतं कर्मदेवनां देवानामानन्दाः । स एको देवानामानन्दः"<br><b>उल्लेखाः - </b>तै० उ०<br><br>

कर्मदोष
कर्मदोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸಾಕೃತ್ಯರೂಪವಾದ ಪಾಪ / ಶರೀರ ಕರ್ಮದಿಂದುಂಟಾದ ದೋಷ<br><b>व्युत्पत्तिः - </b>कर्मणा दोषः<br><b>प्रयोगाः - </b>"सन्न्यस्य सर्वकर्माणि कर्मदोषानपानुदत् । नियतो वेदमभ्यस्य पुत्रैस्वर्ये सुखं वसेत् ॥"<br><b>उल्लेखाः - </b>मनु० ६-९५<br><br>कर्मदोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ತವ್ಯ ಕಾರ್ಯದಲ್ಲಿ ಉಂಟಾಗುವ ದೋಷ<br><b>व्युत्पत्तिः - </b>कर्मणि दोषः<br><b>प्रयोगाः - </b>"अवेक्षेत गतिर्नॄणां कर्मदोषसमुद्भवाः । निरये चैव पतनं यातनास्च यमक्षये ॥"<br><b>उल्लेखाः - </b>मनु० ६-६१<br><br>कर्मदोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಹಿತ ಕಾರ್ಯದ ಅನುಚರಣೆಗೆ ನಿಷಿದ್ಧ ಕಾರ್ಯಾಚರಣೆಗಳಿಂದ ಉಂಟಾದ ದೋಷ<br><br>कर्मदोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಕಲ ಕರ್ಮಗಳಿಗೂ ಕಾರಣವಾದ ಅಜ್ಞಾನರೂಪವಾದ ದೋಷ<br><b>व्युत्पत्तिः - </b>कर्महेतुः दोषः<br><br>

कर्मधारय
कर्मधारय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾನಾರ್ಥವುಳ್ಳ ಎರಡು ಪದಗಳಿಂದ ಕೂಡಿದ ತತ್ಪುರುಷ ಸಮಾಸದ ಒಂದು ಭೇದ /ಒಂದೇ ಅರ್ಥವನ್ನು ಬೋಧಿಸುವ ಎರಡು ಪದಗಳ ತತ್ಪುರುಷಸಮಾಸ<br><b>प्रयोगाः - </b>"तत्पुरुषः समानाधिकरणः कर्मधारयः"<br><b>उल्लेखाः - </b>पा० सू० १-२-४२<br><br>

कर्मन्
कर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸ /ಕಾರ್ಯ<br><br>कर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ಯೋಗ /ಕಸುಬು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - कर्म० "मनिन्" (उ० ४-१४४)<br><b>व्युत्पत्तिः - </b>क्रियते<br><b>प्रयोगाः - </b>"अप्यप्रसिद्धं यशसे हि पुंसामनन्यसाधारणमेव कर्म" । "तीक्ष्णा नारुन्तुदा बुद्धिः कर्म शान्तं प्रतापवत् । नोपतापि मनः शोष्म वागेका वाग्मिनः सतः ॥"<br><b>उल्लेखाः - </b>कुमा० ३-१९, माघ० २-१०९<br><br>कर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಡುವಿಕೆ /ಆಚರಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - भावे "मनिन्" (उ० ४-१४४)<br><br>कर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ತವ್ಯ /ಅವಶ್ಯವಾಗಿ ಮಾಡಬೇಕಾದ ಕಾರ್ಯ<br><br>कर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮನುಷ್ಯನು ಮಾಡುವ ಪುಣ್ಯಪಾಪಹೇತುವಾದ ಕಾರ್ಯ /ಸಂಸಾರಬಂಧನಕ್ಕೆ ಕಾರಣವಾದ ಕರ್ಮ<br><b>प्रयोगाः - </b>"पर्यभूत् खलु करैर्द्विजराजः कर्म कः स्वकृतमत्र न भुङ्क्ते" । "ये मे मतमिदं नित्यमनुतिष्ठन्ति मानवाः । श्रद्धावन्तोऽनसुयन्तो मुच्यन्ते तेऽपि कर्मभिः"<br><b>उल्लेखाः - </b>नैष० ५-६, गीता० ३-३१<br><br>कर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರವಿಹಿತವಾದ ಅಗ್ನಿಹೋತ್ರಾದಿ ಕರ್ಮ<br><br>कर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೈಶೇಷಿಕಮತದಲ್ಲಿ ಉಕ್ತವಾದ ಕ್ರಿಯಾರೂಪವಾದ ಪದಾರ್ಥ<br><b>प्रयोगाः - </b>"उत्क्षेपणं तथावक्षेपणमाकुञ्चनं तथा । प्रसारणं च गमनं कर्माण्येतानि पञ्च च ॥"<br><b>उल्लेखाः - </b>भाषाप०<br><br>कर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣದಲ್ಲಿ ಉಕ್ತವಾದ ೬ ವಿಧ ಕಾರಕಗಳಲ್ಲೊಂದು<br><br>कर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಣಾಶ್ರಮಾನುಗುಣವಾಗಿ ಆಯಾ ವರ್ಣದವರ ಸ್ವಭಾವಜನ್ಯಗುಣಗಳಿಂದ ಭಿನ್ನವಾದ ಅವರವರ ಕರ್ಮಗಳು<br><b>प्रयोगाः - </b>"ब्राह्मणक्षत्रियविशां शूद्राणां च परन्तप । कर्माणि प्रविभक्तानि स्वभावप्रभवैर्गुणैः ॥"<br><b>उल्लेखाः - </b>गीता० १८-४१<br><br>कर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಷದಲ್ಲಿ ಜನ್ಮಲಗ್ನದಿಂದ ೧೦ ನೆಯ ಸ್ಥಾನ<br><b>प्रयोगाः - </b>"दशमो मान आज्ञापि करस्थानमिति स्मृतः । बुद्धिः कर्माभिधानं च वज्री सङ्क्षय उच्यते ॥"<br><b>उल्लेखाः - </b>मु० दी०<br><br>कर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮನುಷ್ಯನಿಗೆ ನಡೆಯಬೇಕಾದ ೧೬ ಕರ್ಮಗಳು<br><br>

कर्मनिर्हरण
कर्मनिर्हरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮಗಳನ್ನು ನಾಶಪಡಿಸುವಿಕೆ /ಪಾಪಕರ್ಮಗಳನ್ನು ಪ್ರಾಯಶ್ಚಿತ್ತಾದಿಗಳಿಂದ ಕಡಮೆ ಮಾಡಿಕೊಳ್ಳುವಿಕೆ<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><b>व्युत्पत्तिः - </b>कर्मणा निर्हरणम्<br><br>

कर्मनिर्हार
कर्मनिर्हार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮಗಳನ್ನು ನಾಶಪಡಿಸುವಿಕೆ /ಪಾಪಕರ್ಮಗಳನ್ನು ಪ್ರಾಯಶ್ಚಿತ್ತಾದಿಗಳಿಂದ ಕಡಮೆ ಮಾಡಿಕೊಳ್ಳುವಿಕೆ<br><b>निष्पत्तिः - </b>भावे "घञ्" (३-३-१८)<br><br>

कर्मनिष्ठ
कर्मनिष्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾಗಾದಿ ಕರ್ಮಗಳಲ್ಲಿ ಆಸಕ್ತನಾದ /ಯಾಗಾದಿ ಕರ್ಮಾನುಷ್ಠಾನದಲ್ಲಿ ನಿರತನಾದ<br><b>व्युत्पत्तिः - </b>कर्मणि निष्ठा यस्य<br><b>प्रयोगाः - </b>"ज्ञाननिष्ठा द्विजाः केचितपोनिष्ठास्तथापरे । तपः स्वाध्यायनिष्ठाश्च कर्मनिष्ठास्तथापरे ॥"<br><b>उल्लेखाः - </b>मनु० ३-१३४<br><br>

कर्मनिष्ठा
कर्मनिष्ठा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮಾನುಷ್ಠಾನದಲ್ಲಿ ಆಸಕ್ತಿ /ಯಾಗಾದಿ ಕರ್ಮಗಳಲ್ಲಿ ನಿರತನಾಗಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>कर्मसु निष्ठा<br><br>

कर्मन्द
कर्मन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಿಕ್ಷುಸೂತ್ರಗಳನ್ನು ರಚಿಸಿದ ಒಬ್ಬ ಋಷಿ<br><br>

कर्मन्दिन्
कर्मन्दिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಿಕ್ಷು ಸಂನ್ಯಾಸಿ<br><b>निष्पत्तिः - </b>"इनिः" (४-३-११२)<br><b>व्युत्पत्तिः - </b>कर्मन्देन प्रोक्तमधीते<br><br>

कर्मन्यास
कर्मन्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮಗಳನ್ನು ಆಚರಿಸದೆ ಬಿಡುವಿಕೆ /ಕರ್ಮಸಂನ್ಯಾಸ<br><br>कर्मन्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮಫಲತ್ಯಾಗ /ಫಲಾಪೇಕ್ಷೆಯಿಲ್ಲದೆ ಈಶ್ವರಾರ್ಪಣಬುದ್ಧಿಯಿಂದ ಮಾಡುವ ಕರ್ಮಗಳ ಫಲತ್ಯಾಗ<br><br>

कर्मपथ
कर्मपथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುಣ್ಯ ಮತ್ತು ಪಾಪಕರ್ಮಗಳ ತ್ಯಾಗ<br><b>निष्पत्तिः - </b>"अः" (५-४-७४)<br><b>व्युत्पत्तिः - </b>कर्मणां मानसादीनां पन्थाः<br><br>कर्मपथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮಲಬ್ಧವಾದ ೧)ಅರ್ಚಿರಾದಿ ಮತ್ತು ೨) ಧೂಮಾದಿಮಾರ್ಗಗಳು<br><br>

कर्मप्रवचनीय
कर्मप्रवचनीय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣಶಾಸ್ತ್ರದಲ್ಲಿ ನಿಪಾತಗಳಿಗೆ ಹೇಳಿರುವ ಒಂದು ಸಂಜ್ಞೆ<br><br>

कर्मफल
कर्मफल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರವಿಹಿತವಾದ ಪುಣ್ಯ ಮತ್ತು ನಿಷಿದ್ಧವಾದ ಪಾಪಕರ್ಮಗಳ ಪರಿಣಾಮವಾದ ಸುಖದುಃಖಗಳು /ಜನ್ಮಾಂತರದ ಕರ್ಮಗಳ ಫಲ<br><b>व्युत्पत्तिः - </b>कर्मणां विहितानां निषिद्धानां वा फलम्<br><b>प्रयोगाः - </b>"युक्तः कर्मफलं त्यक्त्वा शान्तिमाप्नोति नैष्ठिकीम् । अयुक्तः कामकारेण फलेसक्तो निबध्यते ॥"<br><b>उल्लेखाः - </b>गीता० ५-१२<br><br>

कर्मबन्ध
कर्मबन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮದಿಂದುಂಟಾಗುವ ಶರೀರಸಂಬಂಧ /ಸಂಸಾರ ಬಂಧನ<br><b>व्युत्पत्तिः - </b>कर्मणा बन्धः<br><b>प्रयोगाः - </b>"एषा तेऽभिहिता साङ्ख्ये बुद्धिर्योगे त्विमां श्रुणु । बुद्ध्या युक्तो यया पार्थ कर्मबन्धं प्रहास्यसि ॥"<br><b>उल्लेखाः - </b>गीता० २-४०<br><br>

कर्मबन्धन
कर्मबन्धन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮದಿಂದುಂಟಾಗುವ ಶರೀರಸಂಬಂಧ /ಸಂಸಾರ ಬಂಧನ<br><br>कर्मबन्धन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರ್ಮವೆಂಬ ಬಂಧನ ಸಾಧನದಿಂದ ಕೂಡಿದ<br><b>व्युत्पत्तिः - </b>कर्मैव कर्मणा वा बन्धनं यस्य<br><b>प्रयोगाः - </b>"यज्ञार्थात्कर्मणोऽन्यत्र लोकोऽयं कर्मबन्धनः । तदर्थं कर्म कौन्तेय मुक्तसङ्गः समाचर ॥"<br><b>उल्लेखाः - </b>गीता० ३-९<br><br>

कर्मभू
कर्मभू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯವಸಾಯ ಮಾಡಲ್ಪಟ್ಟ ಭೂಮಿ<br><b>व्युत्पत्तिः - </b>कर्मणः कृषिकर्मणोः भूः<br><br>कर्मभू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭಾರತ ವರ್ಷ<br><br>

कर्मभूमि
कर्मभूमि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮಗಳು ಆಚರಿಸಲ್ಪಡುವ ಭಾರತವರ್ಷ<br><b>व्युत्पत्तिः - </b>कर्मणः यज्ञादिकर्मणः भूमिः<br><b>प्रयोगाः - </b>"उत्तरं यत्समुद्रस्य हिमाद्र्र्श्चैव दक्षिणम् । वर्षं तद्भारतं नाम भारती यत्र सन्ततिः ॥ नवयोजनसाहस्रो विस्तारोऽस्य महामुने । कर्मभूमिरियं स्वर्गमपवर्गं च गच्छताम् ॥"<br><b>उल्लेखाः - </b>वि० पु०<br><br>

कर्मभोग
कर्मभोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಡಿದ ಕರ್ಮದಿಂದ ಉಂಟಾಗುವ ಸುಖದುಃಖಗಳ ಅನುಭವ<br><br>

कर्ममीमांसा
कर्ममीमांसा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮಕಾಂಡದ ಅರ್ಥವನ್ನು ನಿರ್ಣಯಿಸುವ ಮೀಮಾಂಸಾಶಾಸ್ತ್ರ<br><b>व्युत्पत्तिः - </b>कर्मप्रतिपादकवेदभागस्य मीमांसा विचारः<br><br>

कर्मवासना
कर्मवासना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂದು ಮುಂದಿನ ಜನ್ಮಗಳಲ್ಲಿ ಪುಣ್ಯಪಾಪಕರ್ಮಗಳನ್ನು ಮಾಡಿಸುವ ಹಿಂದಿನ ಜನ್ಮಗಳಲ್ಲಿನ ಅನುಭವದ ಒಂದು ಸಂಸ್ಕಾರ<br><br>

कर्मयुग
कर्मयुग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸೆಯೇ ಪ್ರಧಾನವಾದ ಕಲಿಯುಗ<br><b>निष्पत्तिः - </b>कृञ् (हिंसायाम्) - "मनिन्" (उ० ४-१४४)<br><b>व्युत्पत्तिः - </b>कृणाति हिनस्ति परस्परं यस्मिन् । कर्म च तद्युगं च ।<br><br>

कर्मयोग
कर्मयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಫಲಾಪೇಕ್ಷೆಯಿಲ್ಲದ ಕರ್ಮಾನುಷ್ಠಾನ /ಉಪದೇಶದಿಂದ ಜೀವಾತ್ಮ ಪರಮಾತ್ಮವಿಷಯಕ ಯಥಾರ್ಥಜ್ಞಾನವುಳ್ಳವನಿಂದ ಶಕ್ತಿಗನುಗುಣವಾಗಿ ಫಲಾಭಿಸಂಧಿಯಿಲ್ಲದೆ ಆಚರಿಸಲ್ಪಡುವ ಜಪೋತಪೋತೂಪವಾದ ಕರ್ಮಗಳು /ಫಲಾಭಿಸಂಧಿಯಿಲ್ಲದ ಕರ್ಮಕೌಶಲ<br><br>

कर्मवत्
कर्मवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯವಂತ /ಯಾವುದಾದರೊಂದು ಕಾರ್ಯವುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>कर्मास्यास्ति<br><br>

कर्मवती
कर्मवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮದಂತೆ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कर्मविपर्यय
कर्मविपर्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಯದ ವ್ಯತ್ಯಾಸ /ಕಾರ್ಯವು ತಪ್ಪಾಗಿ ಆಗುವಿಕೆ /ಕಾರ್ಯವು ವಿರೋಧವಾಗಿ ಆಗುವಿಕೆ<br><b>निष्पत्तिः - </b>"वतिः" (५-१-११५)<br><b>व्युत्पत्तिः - </b>कर्मणा तुल्यम्<br><br>

कर्मविपाक
कर्मविपाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುಣ್ಯಪಾಪಕಾರ್ಯಗಳ ಪರಿಣಾಮ /ಜನ್ಮಾಂತರದ ಪುಣ್ಯಪಾಪಕಾರ್ಯಗಳ ಶುಭಾಶುಭಫಲ<br><b>व्युत्पत्तिः - </b>कर्मणो विपर्ययः<br><br>कर्मविपाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಭವಿಸುತ್ತಿರುವ ನಾನಾವಿಧ ದುಃಖಗಳಿಗೆ ಕಾರಣ ಮತ್ತು ಅದರ ನಿವೃತ್ತ್ಯುಪಾಯಗಳನ್ನು ತಿಳಿಸುವ ಒಂದು ಗ್ರಂಥ<br><b>व्युत्पत्तिः - </b>कर्मणः पुण्यापुण्यरूपस्य विपाकः फलविशेषः<br><br>

कर्मव्यतिहार|कर्मव्यतीहार
कर्मव्यति(ती)हार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಸ್ಪರ ಏಕಜಾತೀಯ ಕಾರ್ಯಗಳ ವಿನಿಮಯ /ಸಮಾನಕಾರ್ಯಗಳ ಅನ್ಯೋನ್ಯಬದಲಾವಣೆ<br><b>व्युत्पत्तिः - </b>कर्मणः व्यतिहारः अन्योन्यं क्रियाविनिमयः<br><br>

कर्मशाला
कर्मशाला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಗಾರಿಕೆಯ ಪ್ರಯೋಗಶಾಲೆ /ಕಾರಖಾನೆ<br><br>

कर्मशील
कर्मशील<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡುವ ಸ್ವಭಾವದವನು /ಸೇವಕ /ಆಳು<br><b>व्युत्पत्तिः - </b>कर्मं शीलं यस्य<br><br>

कर्मशूर
कर्मशूर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಡಿದ ಕಾರ್ಯವನ್ನು ಸಮಾಪ್ತಿಗೊಳಿಸುವವನು<br><b>व्युत्पत्तिः - </b>कर्मणि शूरः<br><br>

कर्मश्रेष्ठ
कर्मश्रेष्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುಲಹನ ಮಗ<br><br>कर्मश्रेष्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರ್ಮಾಚರಣೆಯಿಂದ ಶ್ರೇಷ್ಠನಾದವನು<br><b>व्युत्पत्तिः - </b>कर्मणा श्रेष्ठः<br><br>

कर्मसन्न्यास
कर्मसन्न्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮತ್ಯಾಗ /ಕರ್ಮಗಳನ್ನು ಆಚರಿಸದೆ ಬಿಡುವಿಕೆ<br><b>व्युत्पत्तिः - </b>कर्मणः सन्न्यासः त्यागः<br><b>प्रयोगाः - </b>"तयोस्तु कर्मसन्न्यासात्कर्मयोगो विशिष्यते"<br><b>उल्लेखाः - </b>गीता० ५-२<br><br>कर्मसन्न्यास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮಫಲತ್ಯಾಗ<br><br>

कर्मसन्न्यासिक
कर्मसन्न्यासिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮಸಂನ್ಯಾಸವುಳ್ಳವನು /ಕರ್ಮಗಳನ್ನು ತ್ಯಜಿಸಿರುವ ಯತಿ<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५) ।<br><b>व्युत्पत्तिः - </b>कर्मणां सन्न्यासोऽस्यास्ति<br><br>कर्मसन्न्यासिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮಫಲವನ್ನು ತ್ಯಾಗಮಾಡಿದವನು<br><br>

कर्मसन्न्यासिन्
कर्मसन्न्यासिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮಫಲವನ್ನು ತ್ಯಾಗಮಾಡಿದವನು<br><br>

कर्मसङ्ग
कर्मसङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮದಲ್ಲಿ ಆಸಕ್ತಿ /ಫಲಾಪೇಕ್ಷೆಯಿಂದ ಕರ್ಮಾಚರಣೆಯಲ್ಲಿ ಅಭಿನಿವೇಶ<br><b>व्युत्पत्तिः - </b>कर्मणि सङ्गः आसक्तिः<br><br>

कर्मसङ्ग्रह
कर्मसङ्ग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೧)ಕರ್ಮಸಾಧನವಾದ ದ್ರವ್ಯ ೨)ಯಾಗಾದಿ ಕರ್ಮ ೩)ಕರ್ಮವನ್ನು ಆಚರಿಸುವವನು ಎಂದು ೩ ವಿಧವಾದ ಕರ್ಮ<br><b>प्रयोगाः - </b>"करणं कर्म कर्तेति त्रिविधः कर्मसङ्ग्रहः"<br><b>उल्लेखाः - </b>गीता० १८-१८<br><br>

कर्मसचिव
कर्मसचिव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನ ಕಾರ್ಯಗಳಲ್ಲಿ ಸಹಾಯಕನಾಗಿರುವವನು<br><b>व्युत्पत्तिः - </b>कर्मसु सचिवः<br><br>

कर्मसाक्षिन्
कर्मसाक्षिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈ ಲೋಕದಲ್ಲಿ ನಡೆಯುವ ಮಾನವನ ಕರ್ಮಗಳನ್ನೆಲ್ಲಾ ನೋಡುವ ಸೂಯ ಚಂದ್ರ ಮೊದಲಾದವರು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-९१)<br><b>व्युत्पत्तिः - </b>साक्षात् पश्यति इति साक्षी । कर्मणः साक्षी<br><b>विस्तारः - </b>"कर्मसाक्षी जगच्चक्षुरंशुमाली त्रयीतनुः" - अम० । "सूर्यः सोमो यमः कालो महाभूतानि पञ्च च । एते शुभाशुभस्येह कर्मणो नव साक्षिणः ॥"<br><br>कर्मसाक्षिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಡೆಯುತ್ತಿರುವ ಕಾರ್ಯವನ್ನು ಎದುರಿಗೆ ನೋಡುವವನು<br><b>प्रयोगाः - </b>"यो यस्तत्कर्मसाक्षी चरति मयि रणे यश्च यश्च प्रतीपः क्रोधान्तस्तस्य तस्य स्वयमपि जगतामन्तकस्यान्तकोऽहम्"<br><b>उल्लेखाः - </b>वेणी० ३-३२<br><br>

कर्मसाधन
कर्मसाधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮಾಚರಣೆಗೆ ಬೇಕಾದ ದ್ರವ್ಯ<br><b>प्रयोगाः - </b>"शरीरवाङ्मनोभिर्यत् कर्म प्रारभते नरः"<br><b>उल्लेखाः - </b>गीता० १८-१५<br><br>

कर्मसिद्धि
कर्मसिद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯಸಿದ್ಧಿ /ಕಾರ್ಯವು ಕೈಗೂಡುವಿಕೆ /ಕಾರ್ಯದ ಫಲ ದೊರಕುವಿಕೆ<br><b>व्युत्पत्तिः - </b>कर्मणः सिद्धिः<br><b>प्रयोगाः - </b>"जितेन्द्रिये शूलिनि पुष्पचापः स्वकर्मसिद्धिं पुनराशशंसे"<br><b>उल्लेखाः - </b>कुमा० ३-५७<br><br>

कर्मस्थ
कर्मस्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದಲ್ಲಿರುವವನು /ಕೆಲಸದಲ್ಲಿ ನಿರತನಾದವನು<br><b>निष्पत्तिः - </b>ष्ठा (गतिनिवृत्तौ) - "कः" (३-२-४) ।<br><b>व्युत्पत्तिः - </b>कर्मणि तिष्ठति<br><br>

कर्मस्थान
कर्मस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯಾಲಯ /ಸಾರ್ವಜನಿಕ ಕಾರ್ಯಕ್ಷೇತ್ರ<br><br>कर्मस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ಯೋಗಸ್ಥಾನ /ಕಾರಖಾನೆ<br><br>कर्मस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಷೋಕ್ತವಾದ ಲಗ್ನದಿಂದ ಹತ್ತನೆಯ ಸ್ಥಾನ<br><b>विस्तारः - </b>"दशमो मान आज्ञापि करस्थानमिति स्मृतः । वृद्धिः कर्माभिधानं च वज्री सङ्क्षय उच्यते ॥" - मु० दी० ।<br><br>

कर्माङ्ग
कर्माङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದ ಒಂದು ಭಾಗ<br><br>कर्माङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗಾದಿ ಕರ್ಮದ ಒಂದು ಭಾಗ<br><b>व्युत्पत्तिः - </b>कर्मणः अङ्गम्<br><br>

कर्मजीव
कर्मजीव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸದಿಂದ ಸಂಪಾದಿಸಲ್ಪಟ್ಟ ಜೀವನೋಪಾಯ /ಕೈಗಾರಿಕೆ ಮುಂತಾದ ಕಸಬಿನಿಂದ ಸಂಪಾದಿಸಲ್ಪಟ್ಟ ಜೀವನಾಧಾರ /ಹೊಟ್ಟೆಪಾಡು<br><b>व्युत्पत्तिः - </b>कर्मणा आजीवो जीवनम्<br><br>कर्मजीव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಸಬಿನಿಂದ ಜೀವಿಸುವವನು /ಉದ್ಯೋಗದಿಂದ ಜೀವನೋಪಾಯವುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>कर्मणा आजीवो यस्य<br><br>

कर्मात्मन्
कर्मात्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಡಿದ ಪುಣ್ಯಪಾಪಕಾರ್ಯಗಳಿಂದ ಹೊಂದಲ್ಪಟ್ಟ ಶರೀರವುಳ್ಳ ಜೀವ<br><b>व्युत्पत्तिः - </b>कर्मणा आत्मा शरीरं यस्य<br><b>प्रयोगाः - </b>"तस्मिन् स्वपिति सुस्थे तु कर्मात्मानः शरीरिणः । स्वकर्मभ्यो निवर्तन्ते मनश्च ग्लानिमृच्छति ॥"<br><b>उल्लेखाः - </b>मनु० १-५३<br><br>कर्मात्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡುವ ಸ್ವಭಾವದ<br><b>प्रयोगाः - </b>"कर्मात्मनां च देवानां सोऽसृजत् प्राणिनां प्रभुः । साध्यानां च गणं सूक्ष्मं यज्ञं चैव सनातनम् ॥"<br><b>उल्लेखाः - </b>मनु० १-२२<br><br>कर्मात्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸದಲ್ಲಿ ನಿರತನಾದವನು /ಆರಂಭಿಸಿದ ಕಾರ್ಯವನ್ನು ಸಮಾಪ್ತಿಗೊಳಿಸುವುದರಲ್ಲಿ ಶೂರನಾದವನು<br><br>

कर्माधिकार
कर्माधिकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡುವ ಹಕ್ಕು /ಲೌಕಿಕ ಮತ್ತು ವೈದಿಕ ಕರ್ಮಫಲಾಪೇಕ್ಷೆ /ಕರ್ಮಾಚರಣೆಯ ಸಾಮರ್ಥ್ಯ<br><br>

कर्माधिकारिन्
कर्माधिकारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸಮಾಡುವ ಹಕ್ಕುಳ್ಳವನು<br><br>कर्माधिकारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರ್ಮಾಚರಣೆಯಲ್ಲಿ ಸಾಮರ್ಥ್ಯವುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>कर्मणि अधिकारी<br><br>

कर्माध्यक्ष
कर्माध्यक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸವನ್ನು ಪ್ರತ್ಯಕ್ಷವಾಗಿ ನೋಡುವವನು /ಕಾರ್ಯದ ಮೇಲ್ವಿಚಾರಕ<br><b>व्युत्पत्तिः - </b>कर्मणि अध्यक्षः<br><br>

कर्मान्त
कर्मान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗಾದಿ ಕೆಲಸದ ಕೊನೆ /ಕರ್ಮದ ಸಮಾಪ್ತಿ<br><b>व्युत्पत्तिः - </b>कर्मणो अन्तः<br><b>प्रयोगाः - </b>"कर्मान्ते दक्षिणां दद्यात्"<br><br>कर्मान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದ ಪೂರಯಿಕೆ /ಕಾರ್ಯದ ನೆರವೇರಿಕೆ<br><b>प्रयोगाः - </b>"अहन्यहन्यवेक्षेत कर्मान्तात् वाहनानि च"<br><b>उल्लेखाः - </b>मनु० ८-४२९<br><br>कर्मान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಉಳಲ್ಪಟ್ಟ ಭೂಮಿ<br><br>कर्मान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯವನ್ನು ಸಂಗ್ರಹಿಸಿಡುವ ಸ್ಥಾನ<br><b>प्रयोगाः - </b>"तेषामर्थे नियुञ्जीत शूरान् दक्षान् कुलोद्गतान् । शुचीनाकरकर्मान्ते भीरूनन्तर्निवेशने ॥"<br><b>उल्लेखाः - </b>मनु० ७-६२<br><br>

कर्मार
कर्मार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮ್ಮಾರ /ಕಬ್ಬಿಣದ ಕೆಲಸ ಮಾಡುವವನು /ಒಬ್ಬ ಮಿಶ್ರಜಾತಿಯವನು<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कर्म ऋच्छति<br><b>प्रयोगाः - </b>"कर्मारस्य निषादस्य रङ्गावतरकस्य च । सुवर्णकर्तुर्वेणस्य शस्त्रविक्रयिणस्तथा ॥"<br><b>उल्लेखाः - </b>मनु० ४-२१५<br><br>कर्मार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಗೆಲಸಗಾರ /ಶಿಲ್ಪಿ<br><br>

कर्मार्ह
कर्मार्ह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುರುಷ /ಮನುಷ್ಯ<br><b>निष्पत्तिः - </b>अर्ह (पूजायाम्) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कर्म अर्हति<br><br>कर्मार्ह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡಲು ಸಮರ್ಥನಾದವನು /ಕೆಲಸಕ್ಕೆ ಯೋಗ್ಯನಾದವನು<br><br>कर्मार्ह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾಗಾದಿ ಕರ್ಮಗಳಿಗೆ ಯೋಗ್ಯನಾದವನು<br><br>

कर्माशय
कर्माशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜನ್ಮಾಂತರಗಳಲ್ಲಿ ಮಾಡಿದ ಪುಣ್ಯ ಮತ್ತು ಪಾಪ ಕರ್ಮಗಳಿಗೆ ಆಶ್ರಯವಾದ ಶರೀರ ಮನಸ್ಸು ಮುಂತಾದುದು<br><br>

कर्मिक
कर्मिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸಗಾರ /ಕಾರ್ಯನಿರತ /ಉದ್ಯೋಗವುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११६) ।<br><b>व्युत्पत्तिः - </b>कर्मास्यास्ति<br><br>कर्मिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೂಲಿಯವನು /ಕೈಕೆಲಸದವನು<br><br>

कर्मिन्
कर्मिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸಗಾರ /ಉದ್ಯೋಗನಿರತ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११६)<br><b>व्युत्पत्तिः - </b>कर्मास्यास्ति<br><br>कर्मिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾಗಾದಿ ಕರ್ಮಗಳನ್ನು ಆಚರಿಸುವವನು<br><b>प्रयोगाः - </b>"तपस्विभ्यः अधिको योगी ज्ञानिभ्योऽपि मतोऽधिकः । कर्मिभ्यश्चाधिको योगी तस्माद्योगी भवार्जुन ॥"<br><b>उल्लेखाः - </b>गीता० ६-४६<br><br>कर्मिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೂಲಿಯವನು /ಕೈಕೆಲಸದವನು<br><br>

कर्मिष्ठ
कर्मिष्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ಯಮಶೀಲ /ಹೆಚಾಗಿ ಕೆಲಸದಲ್ಲಿ ಆಸಕ್ತಿಯುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"इष्ठन्" (५-३-५५)<br><b>व्युत्पत्तिः - </b>अतिशयेन कर्मी<br><br>

कर्मेन्द्रिय
कर्मेन्द्रिय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಕ್ಕು, ಪಾಣಿ, ಪಾದ, ಪಾಯು, ಉಪಸ್ಥಗಳೆಂಬ ೫ಇಂದ್ರಿಯಗಳು<br><b>व्युत्पत्तिः - </b>कर्मणां वचनादीनां निमित्तमिन्द्रियम्<br><br>

कर्मोद्युक्त
कर्मोद्युक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದಲ್ಲಿ ನಿರತನಾದವನು /ಕೆಲಸದಲ್ಲಿ ತೊಡಗಿರುವವನು<br><b>व्युत्पत्तिः - </b>कर्मणि उद्युक्तः<br><br>

कर्व|दर्पे|कर्वति
कर्व - दर्पे (भ्वा० पर० अक० से०) कर्वति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಗರ್ವಹೊಂದು /ಕೊಬ್ಬಿದವನಾಗು<br><br>

कर्व
कर्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ /ಮನ್ಮಥ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) -"वः" (उ० १-१५३)<br><b>व्युत्पत्तिः - </b>किरति विषयेषु चित्तम्<br><br>कर्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಲಿ /ಮೂಷಕ<br><b>विस्तारः - </b>"कर्वः कामः आखुश्च"- सि० कौ० ।<br><br>

कर्वट
कर्वट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಿಲ್ಲೆಯ ಮುಖ್ಯಪಟ್ಟಣ<br><br>कर्वट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇನ್ನೂರು ಹಳ್ಳಿಗಳ ಮಧ್ಯದಲ್ಲಿ ಸುಂದರವಾದ ಒಂದು ಪಟ್ಟಣ<br><b>विस्तारः - </b>कर्वटोऽस्त्री द्रोणमुखं पट्टणं पुटभेदनम्" - वैज० । "कर्वटं द्विशतग्राममध्ये ग्राममनोहरम्" - हारा० ।<br><br>कर्वट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚ್ಚು ಕಂಟಕದಿಂದ ಕೂಡಿದ ಗ್ರಾಮ<br><b>प्रयोगाः - </b>"द्वे शते कर्वटस्य स्यात् नगरस्य चतुःशतम्"<br><b>उल्लेखाः - </b>याज्ञ० २-१६७<br><br>कर्वट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೮೦೪ ಗ್ರಾಮಗಳ ಮಧ್ಯದ ಒಂದು ಮುಖ್ಯಗ್ರಾಮ<br><b>विस्तारः - </b>"चतुरष्टशतग्रामान्तः द्रोणमुखकर्वटौ" - त्रिकाण्ड० ।<br><br>

कर्वर
कर्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಘ್ರ /ಹುಲಿ<br><br>कर्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಕ್ಷಸ<br><br>कर्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "ष्वरच्" (उ० २-१२२)<br><b>विस्तारः - </b>"कर्वरो व्याघ्ररक्षसोः" - सि० कौ० ।<br><br>

कर्वरी
कर्वरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ/ಪಾರ್ವತಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीष्" (४-१-४१)<br><br>कर्वरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾತ್ರಿ<br><br>कर्वरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಕ್ಷಸಿ<br><br>कर्वरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಗುಪತ್ರ<br><br>

कर्शन
कर्शन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಶವಾಗಿರುವಿಕೆ /ತೆಳ್ಳಗೆ ಆಗುವಿಕೆ<br><b>निष्पत्तिः - </b>कृश (तनूकरणे) - भावे "ल्युट्" (३-३-११५)<br><br>कर्शन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಶವಾಗಿ ಮಾಡುವ /ತೆಳ್ಳಗೆ ಮಾಡುವ<br><b>निष्पत्तिः - </b>कृश (तनूकरणे) + णिच् - "ल्युः" (३-१-१३४)<br><br>कर्शन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಂದರೆ ಕೊಡುವ /ಹಿಂಸಿಸುವ /ಪೀಡಿಸುವ<br><br>

कर्शनीय
कर्शनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಳ್ಳಗೆ ಮಾಡಲು ಅರ್ಹವಾದ<br><br>कर्शनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಳ್ಳಗೆ ಮಾಡಲು ಶಕ್ಯವಾದ<br><br>कर्शनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಳ್ಳಗೆ ಮಾಡಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>कृश (तनूकरणे) - "अनीयर्" (३-१-९६)<br><br>

कर्शयत्
कर्शयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಳ್ಳಗೆ ಮಾಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कृश (तनूकरणे) + णिच् - "शतृ" (३-२-१२४)<br><br>

कर्शयन्ती
कर्शयन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೆಳ್ಳಗೆ ಮಾಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कर्शित
कर्शित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಳ್ಳಗೆ ಮಾಡಲ್ಪಟ್ಟ /ಕೃಶವಾಗಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कृश (तनूकरणे) + णिच् - "क्तः" (३-२-१०२)<br><br>

कर्ष
कर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿನ್ನ ಬೆಳ್ಳಿಗಳ ಒಂದು ತೂಕ /ಹದಿನಾರು ಆದ್ಯಮಾಷಗಳ ತೂಕ /೮೦ ರಿಕ್ತಗಳು, ೧/೪ ಪಲ, ೧/೪೦೦ ತುಲೆ, ೧೭೬ ಗುಲಗಂಜಿಗಳ ತೂಕ<br><br>कर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹದಿನಾರು ಆದ್ಯಮಾಷಗಳ ತೂಕದ ಚಿನ್ನ<br><br>कर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಭೀತಕವೃಕ್ಷ /ತಾರೆಗಿಡ<br><br>कर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಕರ್ಷಣ /ಎಳೆಯುವಿಕೆ<br><br>कर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬರೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>कृश (तनूकरणे) - भावे "घञ्" (३-३-१८)<br><br>कर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಳುಮೆ /ವ್ಯವಸಾಯ<br><br>कर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೇಗಿಲು<br><br>कर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಲಿಯ ಜಾಡು<br><br>कर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಳುವವನು<br><br>कर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆಯುವವನು<br><br>

कर्षक
कर्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಜ /ಅಂಗಾರಕ<br><b>विस्तारः - </b>"कर्षको रुधिरो भौमः" - वैज० ।<br><br>कर्षक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯುವವನು<br><br>कर्षक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲೇಖಕ /ಬಎರೆಯುವವನು<br><br>कर्षक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೈತ /ಬೇಸಾಯಗಾರ<br><b>निष्पत्तिः - </b>कृश (विलेखने) - "ण्वुल्" (३-१-१३३)<br><b>प्रयोगाः - </b>"कच्चिच्च बीजं भक्तं च कर्षकस्यावसीदति" । "त्वं समीरण इव प्रतीक्षितः कर्षकेण वलजान् पुपूषता" ।<br><b>उल्लेखाः - </b>भा० सभा० ५-८२, माघ० १४-७<br><br>

कर्षण
कर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆಯುವಿಕೆ<br><b>प्रयोगाः - </b>"भज्यमानमतिमात्रकर्षणात् तेन वज्रपरुषस्वनं धनुः"<br><b>उल्लेखाः - </b>रघु० ११-४६<br><br>कर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೇಗಿಲಿನಿಂದ ಉಳುವಿಕೆ<br><b>निष्पत्तिः - </b>कृश (विलेखने) - भावे "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"मृतं तु याचितं भैक्षं प्रमृतं कर्षणं स्मृतम्"<br><b>उल्लेखाः - </b>मनु० ४-५<br><br>कर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶೋಷಣ /ಒಣಗಿಸುವಿಕೆ<br><br>कर्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೀಡಿಸುವಿಕೆ /ಹಿಂಸಿಸುವಿಕೆ<br><b>प्रयोगाः - </b>"शरीरकर्षणात् प्राणाः क्षीयन्ते प्राणिनां यथा । तथा राज्ञामपि प्राणाः क्षीयन्ते राष्ट्रकर्षणात् ॥"<br><b>उल्लेखाः - </b>मनु० ७-११२<br><br>कर्षण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯುವ /ಆಕರ್ಷಿಸುವ<br><br>कर्षण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೇಗಿಲಿನಿಂದ ಉಳುವ<br><b>निष्पत्तिः - </b>कृश (विलेखने) - "ल्युः" (३-१-१३४)<br><br>

कर्षणी
कर्षणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಲೆಗಿಡ<br><b>निष्पत्तिः - </b>गौरा० "ङीष्" (४-१-४१)<br><br>

कर्षणीय
कर्षणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯಲು ಅರ್ಹವಾದ<br><br>कर्षणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯಲು ಶಕ್ಯವಾದ<br><br>कर्षणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಳಲು ಯೋಗ್ಯವಾದ<br><br>कर्षणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಳಲು ಶಕ್ಯವಾದ<br><b>निष्पत्तिः - </b>कृश (विलेखने) - "अनीयर्" (३-१-९६)<br><br>कर्षणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯಲ್ಪಡುವ<br><br>कर्षणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಳಲ್ಪಡುವ<br><br>

कर्षत्
कर्षत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಳುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कृश (विलेखने) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"धनुः स कर्षन् रहितमायासेनाऽससारताम्"<br><b>उल्लेखाः - </b>माघ० १९-१५<br><br>कर्षत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯುತ್ತಿರುವ /ಆಕರ್ಷಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कर्षन्ती
कर्षन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆಯುತ್ತಿರುವ /ಆಕರ್ಷಿಸುತ್ತಿರುವ<br><br>

कर्मफल
कर्मफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾರೆಗಿಡ<br><br>कर्मफल<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೆಲ್ಲಿಗಿಡ<br><br>कर्मफल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಾರೆಕಾಯಿ<br><br>कर्मफल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೆಲ್ಲಿಕಾಯಿ<br><br>

कर्षित
कर्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कृश (विलेखने) + णिच् - "क्तः" (३-२-१०२)<br><br>कर्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಳಿಸಲ್ಪಟ್ಟ /ಬೇಸಾಯ ಮಾಡಿಸಲ್ಪಟ್ಟ<br><br>

कर्षिन्
कर्षिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯುವ /ಆಕರ್ಷಿಸುವ<br><b>निष्पत्तिः - </b>कृश (विलेखने) - "णिनिः" (३-१-१३४)<br><b>प्रयोगाः - </b>"स्तम्बेरमा मुखरश्रृङ्खलकर्षिणस्ते"<br><b>उल्लेखाः - </b>रघु० -७२<br><br>

कर्षिणी
कर्षिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆಯುವ /ಆಕರ್ಷಿಸುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><b>प्रयोगाः - </b>"घ्राणकान्तमधुगन्धकर्षिणीः पानभूमिरचनाः प्रियासखः"<br><b>उल्लेखाः - </b>रघु० १९-११<br><br>कर्षिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಕಡಿವಾಣದಲ್ಲಿರುವ ಕಬ್ಬಿಣದ ತುಂಡು<br><br>कर्षिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಲೆಗಿಡ<br><br>

कर्षू
कर्षू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಣ ಬೆರಣಿಯಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ ಬೆಂಕಿ<br><b>निष्पत्तिः - </b>कृश (विलेखने) - "ऊः" (उ० १-८१)<br><br>कर्षू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೀವಿಕೆ /ಜೀವನೋಪಾಯ<br><br>कर्षू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕವಲು /ನದಿ /ಕಾಲುವೆ<br><b>विस्तारः - </b>"कर्षूर्वाता करीषाग्निः कर्षूः कुल्याभिधायिनी" - अम० ।<br><br>कर्षू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷಿ /ಬೇಸಾಯ<br><b>विस्तारः - </b>"कर्षूस्तु तुषाग्नौ कृषिकुल्ययोः" - हेम० ।<br><br>कर्षू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಷ್ಟಿಖಾತ /ಯಾಗಕ್ಕಾಗಿ ನೇಗಿಲಿನಿಂದ ಉತ್ತು ತೋಡಲ್ಪಟ್ಟ ಹಳ್ಳ<br><b>प्रयोगाः - </b>"चतुरङ्गुलपृथ्वीस्तावदन्तरास्तथाधःखाताः वितस्त्यायतास्तिस्रः कर्षूः कुर्यात् । कर्षूसमीपे अग्नित्रयमुपसमाधाय परिस्तीर्य तत्रैकैकस्मिन् आहुतित्रयं जुहुयात्"<br><b>उल्लेखाः - </b>विष्णुसू०<br><b>विस्तारः - </b>ನಾಲ್ಕು ಅಂಗುಲಗಳ ಅಗಲ ನಾಲ್ಕು ಅಂಗುಲಗಳ ಆಳ ಹನ್ನೆರಡು ಅಂಗುಲಗಳ ಉದ್ದವುಳ್ಳ ಒಂದು ಹಳ್ಳಕ್ಕೆ ಇಷ್ಟಿಖಾತವೆಂದು ಹೆಸರು. "कर्षूः पुमान् करीषाग्नौ स्त्रियां कुल्येष्टिखातयोः" - मेदि० ।<br><br>कर्षू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ತ /ಹಳ್ಳ<br><br>कर्षू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯದ ಹೊಟ್ಟು<br><b>विस्तारः - </b>"कर्षूः स्त्री तुषकोष्ठे कुल्यायां ना च ना करीषाग्नौ" - वैज० ।<br><br>

कर्हि
कर्हि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಾವಾಗ /ಯಾವ ಕಾಲದಲ್ಲಿ<br><b>निष्पत्तिः - </b>किम् - "र्हिल्" (५-३-२१)<br><br>

कर्हिचित्
कर्हिचित्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕಾಲದಲ್ಲಿ /ಒಂದು ಸಮಯದಲ್ಲಿ<br><br>कर्हिचित्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಾವಾಗಲೂ /ಯಾವ ಕಾಲದಲ್ಲೂ<br><b>प्रयोगाः - </b>"अकामस्य क्रिया काचित् दृश्यते नेह कर्हिचित्"<br><b>उल्लेखाः - </b>मनु० २-४<br><br>

कल|शब्दसङ्ख्यानयोः|कलते
कल - शब्दसङ्ख्यानयोः (भ्वा० आत्म० शब्दे अकर्मकः सङ्खानेसकर्मकः से०) कलते<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಶಬ್ದ ಮಾಡು /ಸದ್ದು ಮಾಡು<br><br>कल - शब्दसङ्ख्यानयोः (भ्वा० आत्म० शब्दे अकर्मकः सङ्खानेसकर्मकः से०) कलते<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಎಣಿಸು /ಲೆಕ್ಕ ಮಾಡು<br><br>

कल|गतौ|ते
कल - गतौ सङ्ख्याने च (चुरा- उभ० सक० से०) कलयति - ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೊಂದು /ಪಡೆ<br><br>कल - गतौ सङ्ख्याने च (चुरा- उभ० सक० से०) कलयति - ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಎಣಿಸು /ಲೆಕ್ಕ ಮಾಡು<br><b>प्रयोगाः - </b>"प्रह्लादश्चास्मि दैत्यानां कालः कलयतामहम्"<br><b>उल्लेखाः - </b>गीता० १०-३०<br><br>कल - गतौ सङ्ख्याने च (चुरा- उभ० सक० से०) कलयति - ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಉಚ್ಚರಿಸು /ಹೇಳು /ಮಾತಾಡು<br><b>प्रयोगाः - </b>"विहगाः कदम्बसुरभाविह गाः कलयन्त्यनुक्षणमनेकलयम्"<br><b>उल्लेखाः - </b>माघ० ४-३६<br><br>कल - गतौ सङ्ख्याने च (चुरा- उभ० सक० से०) कलयति - ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಗ್ರಹಿಸು /ಹಿಡಿದುಕೋ /ದರಿಸು<br><b>प्रयोगाः - </b>"कलवलयश्रेणीं पाणौ पदे कुरु नूपुरौ" । "कलयति हिमांशोर्निष्कलङ्कस्य लक्ष्मीम्"<br><b>उल्लेखाः - </b>२)मालती० १-२५<br><br>कल - गतौ सङ्ख्याने च (चुरा- उभ० सक० से०) कलयति - ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಗ್ರಹಿಸು /ತಿಳಿದುಕೊ<br><b>प्रयोगाः - </b>"क्रियतेऽनुवृत्तिरुचितैव ततः कलयेदमानमनसं सखि माम्"<br><b>उल्लेखाः - </b>माघ० ९-५८<br><br>कल - गतौ सङ्ख्याने च (चुरा- उभ० सक० से०) कलयति - ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ನಡೆ /ಹೋಗು /ಮುಂದೆ ಸಾಗು /ದಾರಿ ಹಿಡಿಸು ನಡೆ<br><b>प्रयोगाः - </b>"साक्षादप्सरसो विमानकलितव्योमान एवाभवत्"<br><b>उल्लेखाः - </b>नैष० २-१०४<br><br>

आ + कल|आकल|आकलितः
आ + कल = आकलितः<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕಟ್ಟಿಹಾಕು /ಬಂಧಿಸು /ಬಿಗಿ<br><b>प्रयोगाः - </b>"सुवर्णसूत्राकलिताधराम्बरां विडम्बयन्तं शितिवाससस्तनुम्"<br><b>उल्लेखाः - </b>माघ० १-६<br><br>आ + कल = आकलितः<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ತಿಳಿದುಕೊ /ಮನದಟ್ಟು ಮಾಡಿಕೊ /ಗ್ರಹಿಸು<br><b>प्रयोगाः - </b>"क्षिप्ता इवेन्दोः सरुचोऽधिवेलं मुक्तावलीराकलयाञ्चकार"<br><b>उल्लेखाः - </b>माघ० ३-७३<br><br>

उद् + कल|उत्कल|उत्कलितः
उद् + कल = उत्कलितः<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎತ್ತಿ ಹಿಡಿದುಕೊ<br><b>प्रयोगाः - </b>"स तस्य हत्सोत्कलितस्तदासुरो विक्रीडतो यद्वदहिर्गरुत्मतः"<br><b>उल्लेखाः - </b>भाग० ७-८-२६<br><br>

प्रति + आ + कल|प्रत्याकल|प्रत्याकलनम्
प्रति + आ + कल = प्रत्याकलनम्<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅರಿತುಕೊ /ತಿಳಿದುಕೊ<br><b>प्रयोगाः - </b>"प्रत्याकलितस्वदुर्नयः"<br><b>उल्लेखाः - </b>दशकु०<br><br>

वि + अव + कल|व्यवकल|व्यवकलनम्
वि + अव + कल = व्यवकलनम्<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕಳೆದು ಹಾಕು /ತೆಗೆದು ಹಾಕು<br><b>प्रयोगाः - </b>"यदि व्यक्ते युक्तिव्यवकलनमार्गेऽसि कुशला"<br><b>उल्लेखाः - </b>लीला०<br><br>

सम् + कल|सङ्कल|सङ्कलनम्
सम् + कल = सङ्कलनम्<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಂಕಿಗಳನ್ನು ಕೂಡು /ಸೇರಿಸು<br><b>प्रयोगाः - </b>"अथ सङ्कलनव्यवकलनयोः करणसूत्रम्"<br><b>उल्लेखाः - </b>लीला०<br><br>

कल|क्षेपे|कालयति|कालयते
कल - क्षेपे (चुरा० उभ० सक० से०) कालयति-ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪ್ರೇರಿಸು /ಮುಂದಕ್ಕೆ ತಳ್ಳು<br><br>कल - क्षेपे (चुरा० उभ० सक० से०) कालयति-ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಟ್ಟು /ಓಡಿಸು<br><b>प्रयोगाः - </b>"षष्टिं गवां सहस्राणि त्रिगर्ताः कालयन्ति ते"<br><b>उल्लेखाः - </b>भा० विरा० ३३-१५<br><br>कल - क्षेपे (चुरा० उभ० सक० से०) कालयति-ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಎಸೆ /ಬಿಸಾಡು<br><br>

कल
कल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ /ಮನ್ಮಥ<br><br>कल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂಪಾದ ಮತ್ತು ಅಸ್ಪಷ್ಟವಾದ ಶಬ್ದ<br><b>निष्पत्तिः - </b>कल (शब्दे) - "अच्" (३-१-१३४)<br><b>प्रयोगाः - </b>"प्रगीयते सिद्धगणैश्च योषितामुदारमन्ते कलभाविकस्वरैः"<br><b>उल्लेखाः - </b>माघ० ४-३३<br><br>कल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಲವೃಕ್ಷ /ಮತ್ತಿಮರ<br><br>कल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬದರೀವೃಕ್ಷ /ಬೋರೆಗಿಡ<br><br>कल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗುಷ್ಠದಿಂದ ವೀಣೆಯ ತಂತಿಗಳನ್ನು ಮುಟ್ಟುವಿಕೆ<br><b>विस्तारः - </b>"तन्त्रीष्वङ्गुष्ठसंस्पर्शः कलः" - वैज० ।<br><br>कल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶುಕ್ರಧಾತು /ವೀರ್ಯ<br><b>विस्तारः - </b>"कलं शुक्रे त्रिष्वजीर्णे चव्यक्तमधुरध्वनौ" - मेदि० ।<br><br>कल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೀರ್ಣವಾಗದಿರುವ<br><br>कल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂಗ /ಮಾತಾಡುವ ಶಕ್ತಿಯಿಲ್ಲದವನು<br><br>कल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಲಾನ್ವಿತ /ಕುಶಲವಿದ್ಯೆಯಿಂದ ಕೂಡಿದವನು<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>कलाऽस्त्यस्य<br><br>कल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನೋಹರವಾದ<br><br>कल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಧುರವಾದ /ಇಂಪಾದ<br><b>प्रयोगाः - </b>"कलमन्यभृतासु भाषितं कलहंसीषु मदालसं गतम्"<br><b>उल्लेखाः - </b>रघु० ८-५९<br><br>कल<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಗಂಭೀರವಾಗಿ<br><b>प्रयोगाः - </b>"कलं चलद्भिः सुरसैन्यसिन्धुरैः"<br><b>उल्लेखाः - </b>कुमा० १४-२४<br><br>

कलक
कलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ಸ್ಯ /ಮೀನು<br><b>निष्पत्तिः - </b>कल (गतौ) - "ण्वुल्" (३-१-१३३)<br><br>कलक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಣಿಸುವ /ಲೆಕ್ಕ ಮಾಡುವ<br><br>

कलकण्ठ
कलकण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><br>कलकण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಂಸಪಕ್ಷಿ<br><br>कलकण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪೋತ /ಪಾರಿವಾಳದ ಹಕ್ಕಿ<br><b>व्युत्पत्तिः - </b>कलः अव्यक्तमधुरः कण्ठोऽस्य<br><br>कलकण्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವ್ಯಕ್ತವೂ ಮಧುರವೂ ಆದ ಧ್ವನಿಯುಳ್ಳ<br><br>

कलकण्ठी
कलकण्ठी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪೋತ /ಪಾರಿವಾಳದ ಹಕ್ಕಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५५)<br><br>

कलकल
कलकल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಲಾಹಲದ ದ್ವನಿ /ಗಡಿಬಿಡಿಯ ಶಬ್ದ /ಗುಂಪಿನ ಗಲಭೆ<br><b>निष्पत्तिः - </b>प्रकारे द्वित्वम् (८-१-१२)<br><b>व्युत्पत्तिः - </b>कलप्रकारः<br><b>प्रयोगाः - </b>"रणसम्मदोदयविकासिबलकलकलाकुलीकृते"<br><b>उल्लेखाः - </b>माघ० १५-७७<br><br>कलकल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತಿಮರದ ರಸ<br><b>विस्तारः - </b>"कलकल उक्तः कोलाहले तथा सालनिर्यासे" - मेदि० ।<br><br>

कलघोष
कलघोष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><b>व्युत्पत्तिः - </b>कलो घोषोऽस्य<br><br>

कलङ्क
कलङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಹ್ನೆ /ಗುರುತು<br><br>कलङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಲಿನ್ಯ /ಕೊಳೆ<br><b>निष्पत्तिः - </b>लकि (गतौ) + णिच् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कं ब्रह्माणं लङ्कयति हीनतां गमयति<br><b>प्रयोगाः - </b>"बहुरूपकसालभञ्जिका मुखचन्द्रेषु कलङ्करङ्कवः" । "आभाति वेला लवणाम्बुराशेः धारानिबद्धेव कलङ्करेखा"<br><b>उल्लेखाः - </b>नैष० २-८३, रघु० १३-१५<br><br>कलङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪವಾದ /ಅಪಯಶಸ್ಸು /ಅಕೀರ್ತಿ<br><b>प्रयोगाः - </b>"त्वादृशस्य सकलः स कलङ्कः शीतभासि शशकः परमङ्कः"<br><b>उल्लेखाः - </b>नैष० ५-१२०<br><br>कलङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾಮ್ರ ಮೊದಲಾದ ಧಾತುಗಳ ಮಲ<br><b>प्रयोगाः - </b>"शशिकृपाणकवचेषु कलङ्काः"<br><b>उल्लेखाः - </b>कादं०<br><br>कलङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ /ಪಾತಕ<br><br>

कलङ्कित
कलङ्कित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುರುತು ಮಾಡಲ್ಪಟ್ಟಿರುವ /ಚಿಹ್ನೆಯಿಂದ ಕೂಡಿದ<br><br>कलङ्कित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪಕೀರ್ತಿಯುಳ್ಳ /ಅಪಯಶಸ್ಸನ್ನು ಸಂಪಾದಿಸಿರುವ /ಅಪವಾದವುಳ್ಳ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>कलङ्कोऽस्य सञ्जातः<br><b>प्रयोगाः - </b>"कुङ्कुमपङ्ककलङ्कितदेहा गौरपयोधरकम्पितहारा"<br><b>उल्लेखाः - </b>भर्तृ० २-९<br><br>कलङ्कित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಳೆಯಾಗಿರುವ<br><br>कलङ्कित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪವುಳ್ಳ<br><br>

कलङ्कुर
कलङ्कुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಲಾವರ್ತ /ನೀರಿನ ಸುಳಿ<br><b>निष्पत्तिः - </b>लकि (गतौ) + णिच् - "उरच्" बाहु० ।<br><b>व्युत्पत्तिः - </b>कं जलं लङ्कयति<br><b>विस्तारः - </b>"अथाम्भसां भ्रमः । तानूरो वायुगुल्मश्च कणलाभः कलङ्कुरः" - त्रिकाण्ड० ।<br><br>

कलञ्ज
कलञ्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಬಳಿದ ಬಾಣದಿಂದ ಕೊಲ್ಲಲ್ಪಟ್ಟ ಮೃಗ<br><br>कलञ्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಬಳಿದ ಬಾಣದಿಂದ ಕೊಲ್ಲಲ್ಪಟ್ಟ ಪಕ್ಷಿ<br><br>कलञ्ज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂತಹ ಮೃಗಪಕ್ಷಿಗಳ ಮಾಂಸ<br><b>प्रयोगाः - </b>"न कलञ्जं भक्षयेत्"<br><b>उल्लेखाः - </b>श्रुतिः<br><br>कलञ्ज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಗೆಸೊಪ್ಪು<br><b>प्रयोगाः - </b>"कलञ्जसंवेष्टनधूमपानात्स्याद्दन्तशुद्धिर्मुखरोगहानिः"<br><br>

कलट
कलट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆಗೆ ಹೊದಿಸುವ ಹುಲ್ಲು ಮೊದಲಾದುದು /ಮನೆಯ ಹುಲ್ಲಿನ ಮೇಲ್ಛಾವಣಿ<br><b>निष्पत्तिः - </b>लट (बाल्ये) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कं जलं लटति<br><br>

कलतूलिका
कलतूलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮುಕ ಹೆಂಗಸು /ವ್ಯಭಿಚಾರಿಣಿ<br><b>निष्पत्तिः - </b>ला (आदाने) - "कः" (३-२-४) । तूल (निकर्षे) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कं सुखं लाति कलः । कलः कामः तं तूलयति निष्कर्षयति पूरयति वा<br><b>विस्तारः - </b>"वाञ्छिनी तु स्यात् लञ्जिका कलतूलिका" - त्रिकाण्ड० ।<br><br>

कलत्र
कलत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪತ್ನಿ /ಹೆಂಡತಿ<br><b>निष्पत्तिः - </b>गड (सेचने) - "अत्रन्" आदेः कश्च (उ० ३-१०६) । डलयोरभेदः ।<br><b>व्युत्पत्तिः - </b>गड्यते<br><b>प्रयोगाः - </b>"यः प्रीणयेत् सुचरितैः पितरं स पुत्रो यद्भर्तुरेव हितमिच्छति तत्कलत्रम्"<br><b>उल्लेखाः - </b>भर्तृ० १-५९<br><br>कलत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿತಂಬಪ್ರದೇಶ /ಹೆಂಗಸರ ಪಿರ್ರೆ<br><b>प्रयोगाः - </b>"कलत्रभारेण विलोलनीविना गकद्दुकूलस्तनशालिनोरसा"<br><b>उल्लेखाः - </b>किरा० ७-१७<br><br>कलत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಳತ್ರಸ್ಥಾನ /ಲಗ್ನದಿಂದ ಏಳನೆಯ ಸ್ಥಾನ<br><b>प्रयोगाः - </b>"कलत्रसौख्यवैवाहं भोगस्थानं मनोहरम् । अलङ्कृतिश्च सर्वेषां भावोऽयं सप्तमः स्मृतः ॥"<br><b>उल्लेखाः - </b>मु० दी०<br><br>कलत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗ /ಕೋಟೆ<br><br>

कलत्रता
कलत्रता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪತ್ನೀತ್ವ /ಹೆಂಡತಿಯಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कलत्रस्य भावः<br><br>

कलत्रवत्
कलत्रवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಪತ್ನೀಕ /ಪತ್ನಿಯನ್ನು ಹೊಂದಿರುವ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४) । मस्य वः (७-२-९)<br><b>व्युत्पत्तिः - </b>कलत्रमस्यास्ति<br><b>प्रयोगाः - </b>"कलत्रवन्तमात्मानमवरोधे महत्यपि"<br><b>उल्लेखाः - </b>रघु० १-३२<br><br>कलत्रवत्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪತ್ನಿಯಂತೆ /ಹೆಂಡತಿಯಂತೆ<br><b>निष्पत्तिः - </b>"वतिः" (५-१-११५)<br><b>व्युत्पत्तिः - </b>कलत्रेण तुल्यम्<br><br>

कलत्रिन्
कलत्रिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಳತ್ರವುಳ್ಳವನು /ಪತ್ನೀಸಮೇತನಾದವನು /ಪತ್ನಿಯನ್ನು ಹೊಂದಿರುವವನು<br><b>निष्पत्तिः - </b>कलत्र - "इनिः" (५-२-११५)<br><b>प्रयोगाः - </b>"वसुधेयमवेक्ष्यतां त्वया वसुमत्या हि नृपाः कलत्रिणः"<br><b>उल्लेखाः - </b>रघु० ८-८३<br><br>

कलधूत
कलधूत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಜತ /ಬೆಳ್ಳಿ<br><br>

कलधौत
कलधौत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುವರ್ಣ /ಚಿನ್ನ<br><br>कलधौत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಳ್ಳಿ /ರಜತ<br><b>व्युत्पत्तिः - </b>कलः मलो धौतोऽस्य<br><b>प्रयोगाः - </b>"यस्यां कपोलैः कलधौतधामस्तम्भेषु भेजे मणिदर्पणश्रीः" । "अधिरात्रि यत्र निपतन्नभोलिहां कलधौतधौतशिलिवेश्मनां रुचौ" ।<br><b>उल्लेखाः - </b>माघ० ३-४७, माघ० १३-५१<br><br>कलधौत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲಧ್ವನಿ /ಇಂಪಾದ ಕಂಠ<br><b>विस्तारः - </b>"कलधौतं रूप्यहेम्नोः कलधौतं कलध्वनौ" - विश्व० ।<br><br>

कलध्वनि
कलध्वनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಸ್ಪಷ್ಟ ಮತ್ತು ಮಧುರವಾದ ಶಬ್ದ /ಇಂಪಾದ ತಗ್ಗು ದನಿ<br><b>व्युत्पत्तिः - </b>कलो ध्वनिः<br><br>कलध्वनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪೋತ /ಪಾರಿವಾಳದ ಹಕ್ಕಿ<br><b>व्युत्पत्तिः - </b>कलो ध्वनिरस्य<br><br>कलध्वनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><br>कलध्वनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಯೂರ /ನವಿಲು<br><br>कलध्वनि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಧುರವಾದ ಮತ್ತು ಅಸ್ಪಷ್ಟವಾದ ಶಬ್ದವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कलो ध्वनिरस्य<br><b>विस्तारः - </b>"कलध्वनिः परभृते पारावतकलापिनोः" - हेम० ।<br><br>

कलन
कलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಹ್ನೆ /ಗುರುತು<br><br>कलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪರಾಧ /ತಪ್ಪು<br><br>कलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಹಣ /ಸ್ವೀಕಾರ /ತೆಗೆದುಕೊಳ್ಳುವಿಕೆ<br><b>निष्पत्तिः - </b>कल (गतौ) - "ल्युट्" (३-३-११५)<br><br>कलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಾಸ /ನುಂಗುವಿಕೆ<br><b>प्रयोगाः - </b>"कलनात्सर्वभूतानां स कालः परिकीर्तितः"<br><br>कलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನ /ಅರಿವು /ತಿಳುವಳಿಕೆ<br><b>निष्पत्तिः - </b>कल (गतौ) - कर० "ल्युट्" (३-३-११७)<br><b>प्रयोगाः - </b>"लोकानामन्तकृत्कालः कालोऽन्यः कलनात्मकः"<br><br>कलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸದ್ದು ಮಾಡುವಿಕೆ /ಶಬ್ದ ಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>कल (गतौ शब्दे च) - भावे "ल्युट्" (३-३-११५)<br><br>

कलना
कलना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನ /ಅರಿವು /ತಿಳುವಳಿಕೆ<br><b>निष्पत्तिः - </b>कल (गतौ) + णिच् - भावे "युच्" (३-३-१०७)<br><br>कलना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಹಣ /ಹಿಡಿದುಕೊಳ್ಳುವಿಕೆ<br><br>कलना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವೀಕಾರ /ತೆಗೆದುಕೊಳ್ಳುವಿಕೆ<br><br>कलना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಧರಿಸುವಿಕೆ /ತೊಡುವಿಕೆ<br><br>कलना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೆಗೆದು ಹಾಕುವಿಕೆ<br><b>प्रयोगाः - </b>"अवाप बाल्योचितनीलकण्ठपिच्छावचूडाकलनामिवोरः"<br><b>उल्लेखाः - </b>माघ० ३-५<br><br>

कलनाद
कलनाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಧುರ ಮತ್ತು ತಗ್ಗು ದನಿ<br><b>व्युत्पत्तिः - </b>कलो नादः<br><b>प्रयोगाः - </b>"पयोधिलक्ष्मीमुषि केलिपल्वले रिरंसुहंसीकलनादसादरम्"<br><b>उल्लेखाः - </b>नैष० १-११७<br><br>कलनाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಂಸ<br><b>व्युत्पत्तिः - </b>कलो नादोऽस्य<br><br>कलनाद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸ್ಫುಟ ಮತ್ತು ಮಧುರವಾದ ಧ್ವನಿಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कलो नादो यस्य<br><br>

कलभ
कलभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂವತ್ತು ವರ್ಷ ವಯಸ್ಸಿನ ಆನೆ<br><b>निष्पत्तिः - </b>कल (शब्दे) - "अभच्" (उ० ३-१२२)<br><b>प्रयोगाः - </b>"कुशेशयैरत्र जलाशयोषिता मुदा रमन्ते कलभा विकस्वरैः"<br><b>उल्लेखाः - </b>माघ० ४-३३<br><br>कलभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಮರಿ<br><b>प्रयोगाः - </b>"इह मुहुर्मुदितैः कलभैरवः प्रतिदिशं क्रियते कलभैरवः" । "नन्नु कलभेन यूथपतेरनुकृतम्" ।<br><b>उल्लेखाः - </b>माघ० ४-६०, माल० ५<br><br>कलभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದತ್ತೂರಿ ಗಿಡ<br><b>निष्पत्तिः - </b>डुलभष् (प्राप्तौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कं वातं लभते<br><br>

कलम
कलम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬತ್ತ<br><b>निष्पत्तिः - </b>कल (सङ्ख्याने) - "अमः" (उ० ४-८४)<br><b>व्युत्पत्तिः - </b>कलते<br><b>प्रयोगाः - </b>"अपादपद्मप्रणताः कलमा इव ते रघुम्" । "गीतानि गोप्याः कलमं मृगव्रजो न नूनमत्तीति हरिर्व्यलोकयत्" ।<br><b>उल्लेखाः - </b>रघु० ४-३७, माघ० १२-४३<br><br>कलम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೇಖನಿ<br><br>कलम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೋರ /ಕಳ್ಳ<br><b>विस्तारः - </b>"कलमः पुंसि लेखन्यां शालौ पाटच्चरेऽपि च" - मेदि० ।<br><br>कलम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಕುರ /ಮೊಳಕೆ<br><b>विस्तारः - </b>"कलमोऽङ्कुरलेखन्योः" - वैज० ।<br><br>

कलम्ब
कलम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶರ /ಬಾಣ<br><b>निष्पत्तिः - </b>कल (क्षेपे) - "अम्बच्" (उ० ४-८२)<br><b>विस्तारः - </b>ಶತ್ರುಗಳ ಮೇಲೆ ಎಸೆದು ಪ್ರಯೋಗಿಸುವುದರಿಂದ ಈ ಹೆಸರು.<br><br>कलम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕದಂಬ ವೃಕ್ಷ<br><b>निष्पत्तिः - </b>कड (मदे) - "अम्बच्" (उ० ४-८२) । डलयोरभेदः ।<br><b>विस्तारः - </b>ವಿರಹಿಗಳಿಗೆ ಮದವನ್ನುಂಟುಮಾಡುವುದರಿಂದ ಈ ಹೆಸರು.<br><br>कलम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಕುರ /ಮೊಳಕೆ<br><b>प्रयोगाः - </b>"त्वद्भ्रूयुगं यस्य खलु द्विपत्री तवाधरो रज्यति यत्कलम्बः"<br><b>उल्लेखाः - </b>नैष० ३-१२०<br><br>

कलम्बी
कलम्बी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಂಬುಬಳಸೆ<br><b>विस्तारः - </b>"कलम्बी शाकभेदे स्यात् कदम्बशरयोः पुमान्" - मेदि० ।<br><br>

कलम्बुट
कलम्बुट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನವನೀತ /ಹೊಸದಾದ ಬೆಣ್ಣೆ<br><b>निष्पत्तिः - </b>लबि (अवस्रंसने)- "उटः"बाहु० ।<br><b>व्युत्पत्तिः - </b>के जले लम्बते<br><b>विस्तारः - </b>"हैयङ्गवीनं सरजं मन्थजं च कलम्बुटम्" - हारा० ।<br><br>

कलयत्
कलयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯುವ /ಅರಿತುಕೊಳ್ಳುವ<br><b>निष्पत्तिः - </b>कल (गतौ) = णिच् - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"कलयन्नपि सव्यथोऽवतस्थेऽशकुनेन स्खलितः किलेतरोऽपि"<br><b>उल्लेखाः - </b>माघ० ९-८३<br><br>कलयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋಡುತ್ತಿರುವ /ವೀಕ್ಷಿಸುತ್ತಿರುವ<br><b>प्रयोगाः - </b>"निमीलनस्पष्टविलोकनाभ्यां कदर्थितस्ताः कलयन् कटाक्षैः"<br><b>उल्लेखाः - </b>नैष० ६-२२<br><br>कलयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಸೆಯುತ್ತಿರುವ<br><br>कलयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಸಾಡುತ್ತಿರುವ<br><br>कलयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಣಿಸುತ್ತಿರುವ<br><b>प्रयोगाः - </b>"प्रह्लादश्चास्मि दैत्यानां कालः कलयतामहम्"<br><b>उल्लेखाः - </b>गीता० १०-३०<br><br>कलयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧರಿಸುತ್ತಿರುವ /ಹಿಡಿಯುತ್ತಿರುವ<br><b>प्रयोगाः - </b>"राज्ञामस्य शतेन किं कलयतो हेतिं शतघ्नीं कृतं लक्षैर्लक्षभिदो दृशैव जयतः पद्मानि पद्मैरलम्"<br><b>उल्लेखाः - </b>नैष० १२-५८<br><br>कलयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವೀಕರಿಸುತ್ತಿರುವ /ಅಂಗೀಕರಿಸುತ್ತಿರುವ<br><b>प्रयोगाः - </b>"अस्य क्षोणिपतेः परार्धपरया लक्षीकृताः सङ्ख्यया प्रज्ञाचक्षुरवेक्ष्यमाणतिमिरप्रख्याः किलाकीर्तयः । गीयन्ते स्वरमष्टमं कलयता जातेन वन्ध्योदरान्मूकानां प्रकरेण कूर्मरमणीदुग्धोदधे रोधसि"<br><b>उल्लेखाः - </b>नैष० १२-१०६<br><br>

कलयन्ती
कलयन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कलयत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><b>प्रयोगाः - </b>"कोपित्ं विरहखेदितचित्ता कान्तमेव कलयन्त्यनुनिन्ये"<br><b>उल्लेखाः - </b>माघ० १०-२९<br><br>

कलरव
कलरव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪೋತ /ಪಾರಿವಾಳದ ಹಕ್ಕಿ<br><br>कलरव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><b>व्युत्पत्तिः - </b>कलो रवोऽस्य<br><br>कलरव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಸ್ಪಷ್ಟ ಮಧುರ ಧ್ವನಿ /ಇಂಪಾದ ತಗ್ಗುದನಿ<br><b>व्युत्पत्तिः - </b>कलो रवः<br><br>कलरव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸ್ಪಷ್ಟವಾದ ಮಧುರ ಧ್ವನಿಯುಳ್ಳ<br><b>प्रयोगाः - </b>"कलरवमुपगीते षट्पदौघेन धत्तः कुमुदकमलखण्डे तुल्यरूपामवस्थाम्"<br><b>उल्लेखाः - </b>माघ० ११-१५<br><br>

कलरवी
कलरवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कलरव ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

कलल
कलल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ಭದ ಮೊದಲನೆಯ ಅವಸ್ಥೆ /ಸ್ತ್ರೀಯರ ಗರ್ಭಕೋಶವನ್ನು ಪ್ರವೇಶಿಸಿದ ಮೊದಲನೆಯ ರಾತ್ರಿಯಲ್ಲಿ ಉಂಟಾಗುವ ರೇತಸ್ಸಿನ ವಿಕಾರ<br><b>प्रयोगाः - </b>"कर्मणा देवनेत्रेण जन्तुर्देहोपपत्तये । स्त्रियां प्रविष्ट उदरं पुंसो रेतःकणाश्रयः । कललं त्वेकरात्रेण पञ्चरात्रेण बुद्बुद्धम् ॥"<br><b>उल्लेखाः - </b>भाग० ३-३१-१, २<br><br>कलल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚರ್ಮದ ಚೀಲ<br><b>विस्तारः - </b>"चर्मकोशं तु कललम्" - वैज०<br><br>कलल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಲುಬು /ಮೂಳೆ<br><b>विस्तारः - </b>"अथास्थि कीकसं विड्डं कललं क्रूरमाढिकम्" - वैज० ।<br><br>

कलविङ्क
कलविङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಬ್ಬಚ್ಚಿ<br><b>निष्पत्तिः - </b>वकि (गतौ) - "अच्" (३-१-१३४) पृषो० ।<br><b>व्युत्पत्तिः - </b>कलं वङ्कते<br><b>प्रयोगाः - </b>"कलविङ्कप्लवं हंसं चक्राह्वं ग्रामकुक्कुटम्"<br><b>उल्लेखाः - </b>मनु० ५-१२<br><br>कलविङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಳದಿ ತಲೆಯ ಗುಬ್ಬಚ್ಚಿ<br><b>प्रयोगाः - </b>"मार्जारभक्षिते दुःखं यादृशं गृहकुक्कुटे । न तादृङ्ममताशून्ये कलविङ्केऽथ मूषके ॥"<br><b>उल्लेखाः - </b>प्रबोध० ५-२०<br><b>विस्तारः - </b>"कलविङ्कस्त्वसौ पीतमुण्डः" - वैज० ।<br><br>

कलश
कलश<br><br><b>पदविभागः - </b>त्रिलिङ्गः<br><b>कन्नडार्थः - </b>ಘಟ /ಕೊಡ /ಬಿಂದಿಗೆ /ಹರವೆ<br><b>निष्पत्तिः - </b>लस (श्लेषणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>केन जलेन लसति<br><b>प्रयोगाः - </b>"कलश इव गरीयान् दिग्भिराकृष्यमाणः"<br><b>उल्लेखाः - </b>माघ० ११-४४<br><br>कलश<br><br><b>पदविभागः - </b>त्रिलिङ्गः<br><b>कन्नडार्थः - </b>ಹದಿನಾರು ಆದ್ಯಮಾಷಗಳ ತೂಕ /೮೦ ರಿತ್ತಿಗಳು ೧/೪ ಪಲ ೧/೪೦೦ ತುಲೆ ೧೭೬ ಗುಲಗಂಜಿ ತೂಕ<br><br>

कलशी
कलशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कलश ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>कलशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कलशि ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां वा "ङीष्" (ग० ४-१-४५)<br><br>

कलशजन्मन्
कलशजन्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಭದಿಂದ ಹುಟ್ಟಿದ ಅಗಸ್ತ್ಯ ಮಹರ್ಷಿ<br><br>कलशजन्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಭದಿಂದ ಹುಟ್ಟಿದ ವಸಿಷ್ಠ ಮಹರ್ಷಿ<br><br>

कलशभू
कलशभू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>कलशजन्मन् ಪದದ ಅರ್ಥ<br><br>

कलशयोनि
कलशयोनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸ್ತ್ಯ ಮಹರ್ಷಿ<br><br>कलशयोनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸಿಷ್ಠ ಮಹರ್ಷಿ<br><b>व्युत्पत्तिः - </b>कलशं योनिरस्य<br><br>

कलशि
कलशि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಭ /ಕೊಡ /ಬಿಂದಿಗೆ /ಘಟ<br><br>कलशि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಡೆಯುವ ದೊಡ್ಡ ಮೊಸರಿನ ಪಾತ್ರೆ<br><br>कलशि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನರಿಬಾಲದ ಹುಲ್ಲು<br><b>निष्पत्तिः - </b>शो (तनूकरणे) - "इन्" (उ० ४-११७) बाहु० । अकारलोपः ।<br><b>व्युत्पत्तिः - </b>कलं श्यति अजीर्णं नाशयति<br><b>प्रयोगाः - </b>"शसिनमिव सुरौघाः सारमुद्धर्तुमेते कलशिमुदधिगुर्वीं वल्लवा लोडयन्ति"<br><b>उल्लेखाः - </b>माघ० ११-८<br><br>

कलशीपदी
कलशीपदी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಂದಿಗೆಯಂತೆ ಕಾಲುಗಳುಳ್ಳ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>पादस्य पदादेशः (६-४-१३०)<br><b>व्युत्पत्तिः - </b>कलशी इव पादौ यस्याः<br><br>

कलशीसुत
कलशीसुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸ್ತ್ಯ ಮಹರ್ಷಿ<br><br>कलशीसुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸಿಷ್ಠ ಮಹರ್ಷಿ<br><b>व्युत्पत्तिः - </b>कलश्याः सुत इव<br><br>

कलशोदधि
कलशोदधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ಷೀರ ಸಮುದ್ರ<br><br>

कलस
कलस<br><br><b>पदविभागः - </b>त्रिलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಭ /ಕೊಡ /ಬಿಂದಿಗೆ /ಘಟ<br><b>निष्पत्तिः - </b>लस (श्लेषणक्रीडनयोः) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>केन जलेन लसति<br><b>प्रयोगाः - </b>"कलसे निजहेतुदण्डजः किमु चक्रभ्रम कारितागुणः"<br><b>उल्लेखाः - </b>नैष० २-३२<br><b>विस्तारः - </b>"सागरे मथ्यमाने तु पीयूषार्थं सुरासुरैः । पीयूषधारणार्थाय निर्मितो विश्वकर्मणा । कलाः कलास्तु देवानामपि तास्ताः पृथक् पृथक् । यतः कृतास्तु कलसाः ततस्ते परिकीर्तिताः ॥" - कालिकापु०<br><br>

कलसी
कलसी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಭ /ಕೊಡ /ಬಿಂದಿಗೆ /ಘಟ<br><b>निष्पत्तिः - </b>लस (श्लेषणे) - "इन्" (उ० ४-११७) । जाति० "ङीष्" (४-१-६३)<br><b>प्रयोगाः - </b>"अवलम्बितकर्णशष्कुलीकलसीकं रचयन्नवोचत"<br><b>उल्लेखाः - </b>नैष० २-८<br><br>

कलह
कलह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಗಳ /ವಾಗ್ವಿವಾದ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः)- "डः" (वा० ३-२-४८)<br><b>व्युत्पत्तिः - </b>कलो मधुरध्वनिः तं हन्ति<br><b>प्रयोगाः - </b>"कलहान्न घनाद्यदुत्थितादधुनाप्युज्झति घर्घरस्वरः"<br><b>उल्लेखाः - </b>नैष० २-८५<br><br>कलह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ /ಕದನ<br><b>प्रयोगाः - </b>"विलम्बितं न खलु सहा मनस्विनो विधित्सतः कलहमवेक्ष्य विद्विषः"<br><b>उल्लेखाः - </b>माघ० १७-५०<br><b>विस्तारः - </b>ಮೇದಿನೀಕೋಶದಲ್ಲಿ ಈ ಶಬ್ದವುನಪುಂಸಕಲಿಂಗವಾಗಿ ಉಕ್ತವಾಗಿದೆ.<br><br>कलह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತಿಯ ಒರೆ<br><br>कलह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾರ್ಗ /ದಾರಿ /ರಸ್ತೆ<br><br>कलह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾಡನ /ಹೊಡೆತ<br><b>विस्तारः - </b>"कलहं युधि वाटे ना खड्गकोशे च भण्डने" - मेदि० ।<br><br>

कलहंस
कलहंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೊಡ್ಡ ಜಾತಿಯ ಹಂಸಪಕ್ಷಿ<br><b>व्युत्पत्तिः - </b>कलो मधुरवचनो हंसः<br><b>प्रयोगाः - </b>"अविशद्वनवेश्म विस्मितः स्मृतिलग्नैः कलहंसशंसितैः"<br><b>उल्लेखाः - </b>नैष० २-६३<br><br>कलहंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜಹಂಸ /ಕೆಂಪು ಕಾಲು ಮತ್ತು ಕೊಕ್ಕುಳ್ಳ ಹಂಸಪಕ್ಷಿ<br><b>प्रयोगाः - </b>"वधूदुकूलं कलहंसलक्षणं गजाजिनं शोणितबिन्दुवर्षि च"<br><b>उल्लेखाः - </b>कुमा० ५-६७<br><br>कलहंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠನಾದ ದೊರೆ /ಉತ್ತಮನಾದ ರಾಜ<br><br>कलहंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ /ಪರಬ್ರಹ್ಮ<br><b>विस्तारः - </b>"कलहंसस्तु कादम्बे रजहंसे नृपोत्तमे" - मेदि० ।<br><br>

कलहंसी
कलहंसी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कलहंस ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><b>प्रयोगाः - </b>"कलमन्यभृतासु भाषितं कलहंसीषु मदालसं गतम्"<br><b>उल्लेखाः - </b>रघु० ८-५९<br><br>

कलहकार
कलहकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾರದ ಮಹರ್ಷಿ<br><br>कलहकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಗಳವಾಡುವವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कलहं करोति<br><b>प्रयोगाः - </b>"हन्तुं कलहकारोऽसौ शब्दकारः पपात खम्"<br><b>उल्लेखाः - </b>भट्टि० ५-१००<br><br>

कलहप्रिय
कलहप्रिय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾರದ ಮಹರ್ಷಿ<br><b>व्युत्पत्तिः - </b>कलहः प्रियोऽस्य<br><br>कलहप्रिय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಗಳವೇ ಪ್ರಿಯವಾಗಿ ಉಳ್ಳವನು<br><br>

कलहप्रिया
कलहप्रिया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾರಸ ಪಕ್ಷಿ<br><br>

कलहान्तरिता
कलहान्तरिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>೮ ವಿಧ ಅವಸ್ಥೆಗಳುಳ್ಳ ನಾಯಿಕೆಯರಲ್ಲಿ ಒಂದು ಭೇದ /ಪ್ರಿಯವಾದ ಮಾತುಗಳನ್ನಾಡುತ್ತಿರುವ ಪತಿಯನ್ನು ಕೋಪದಿಂದ ನಿರಾಕರಸಿ ಬಳಿಕ ಪಶ್ಚಾತ್ತಾಪ ಪಡುವ ಒಬ್ಬ ನಾಯಿಕೆ<br><b>विस्तारः - </b>"चाटुकारमपि प्राणनाथं दोषादपास्य या । पश्चात्तापमवाप्नोति कलाहान्तरिता तु सा ॥" - सा० द० ३-८२<br><br>

कला
कला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರಬಿಂಬದ ಹದಿನಾರನೆಯ ಒಂದು ಭಾಗ<br><b>निष्पत्तिः - </b>कल (सङ्ख्याने) + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कलयति<br><b>प्रयोगाः - </b>"आननेन शशिनः कलां दधद्दर्शनक्षयितकामविग्रहः" । "व्यवधावपि वा विधोः कलां मृडचूडानिलयां न वेद कः" ।<br><b>उल्लेखाः - </b>माघ० १४-१८, नैष० २-१९<br><b>विस्तारः - </b>ಚಂದ್ರನ ಹದಿನಾರು ಕಲೆಗಳು - अमृता, मानदा, पूषा, तुष्टिः, पुष्टिः, रतिः, धृतिः, शशिनी, चन्द्रिका, कान्तिः, ज्योत्स्ना, श्रीः, प्रीतिः, अङ्गदा, पूर्ना, पूर्णामृता ।<br><br>कला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರ್ಯಮಂಡಲದ ಹನ್ನೆರಡನೆಯ ಒಂದು ಭಾಗ<br><b>विस्तारः - </b>ಸೂರ್ಯನ ೧೨ ಕಲೆಗಳು - तपिनी, तापिनी, धूम्रा, मरीचिः, ज्वालिनी, रुचिः, सुषुम्णा, भोगदा, विश्वा, बोधिनी, धारिणी, क्षमा ।<br><br>कला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಮಂಡಲದ ಹತ್ತನೆಯ ಒಂದು ಭಾಗ<br><b>विस्तारः - </b>ಅಗ್ನಿಮಂಡಲದ ೧೦ ಕಲೆಗಳು - धूम्रार्चिः, ऊष्मा, ज्वलिनी, ज्वालिनी, विस्फुलिङ्गिनी, सुश्रीः, सुरूपा, कपिला, हव्यम्, कव्यम् ।<br><br>कला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಡ್ಡಿ /ಮೂಲಧನ /ವೃದ್ಧ್ಯಂಶ<br><br>कला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಲ್ಪ /ಕುಶಲವಿದ್ಯೆ<br><b>प्रयोगाः - </b>"कलाः चतुःषष्टिरुपैतु वासं तस्यां कथं सुभ्रुवि नाम नास्याम्" । "कलासु तस्याः सकलासु पण्डिताः" ।<br><b>उल्लेखाः - </b>नैष० ७-१०७, नैष० १५-२६<br><b>विस्तारः - </b>೬೪ ವಿದ್ಯೆಗಳು - गीतम्, वाद्यम्, नृत्यम्, आलेख्यम्, विशेषकच्छेद्यम्, तण्डुलकुसुमबलिविकाराः, पुष्पास्तरणम्, दशनवसनाङ्गरागः, मणिभूमिकाकर्म, शयनरचनम्, उदकवाद्यम्, उदकाघातः, चित्राश्च योगाः, माल्यग्रथनविकल्पाः, शेखरकापीडयोजनम्, नेपथ्यप्रयोगः, कर्णपत्रभङ्गाः, गन्धयुक्तिः, भूषणयोजनम्, ऐन्द्रजालाः कौचुमाराश्च योगाः, हस्तलाघवम्, विचित्रशाकयूषभक्ष्यविकारक्रिया, पानकरसरागासवयोजनम्, सूचीवानकर्माणि, सूत्रक्रीडा, वीणाडमरुकवाद्यानि, प्रहेलिका, प्रतिमाला, दुर्वाचकयोगाः, पुस्तकवाचनम्, नाटकाख्यायिकादर्शनम्, काव्यसमस्यापूरणम्, पट्टिकावेत्रवानविकल्पाः, तक्षकर्माणि, तक्षणम्, वास्तुविद्या, रूप्यरत्नपरीक्षा, धातुवादः, मणिरागाकारज्ञानम्, वृक्षायुर्वेदयोगः, मेषकुक्कुटलावकयुद्धविधिः, शुकशारिकाप्रलापनम्, उत्सादने संवाहने केशमर्दने च कौशलम्, अक्षरमुष्टिकाकथनम्, म्लेच्छितविकल्पाः, देशभाषाविज्ञानम्, पुष्पशकटिका, निमित्तज्ञानम्, यन्त्रमातृका, धारणमातृका, सम्पाठ्यम्, मानसी, काव्यक्रिया, अभिधानकोशः, छन्दोज्ञानम्, क्रियाकल्पः, छलितकयोगाः, वस्त्रगोपनानि, द्यूतविशेषाः, आकर्षक्रीडा, बालक्रीडनकानि, वैनयिकीनाम्, वैजयिकीनाम्, व्यायामिकीनां च विद्यानां ज्ञानम् ॥<br><br>कला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಸ್ತುವಿನ ಒಂದು ಸಣ್ಣ ಭಾಗ /ಅಂಶ<br><b>प्रयोगाः - </b>"सर्वे ते जपयज्ञस्य कलां नार्हन्ति षोडशीम्"<br><b>उल्लेखाः - </b>मनु० २-७६<br><br>कला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲದ ಒಂದು ಭಾಗ /೩೦ ಕಾಷ್ಠೆಗಳ ಒಂದು ಕಾಲ<br><br>कला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮನುಷ್ಯನ ಶರೀರದ ಒಂದು ಭಾಗ<br><b>प्रयोगाः - </b>"कलाः खल्वपि सप्त भवन्ति धात्वाशयान्तरमर्यादाः"<br><b>उल्लेखाः - </b>सुश्रुत० शारीर० ४-५<br><b>विस्तारः - </b>ಮನುಷ್ಯನ ಶರೀರದಲ್ಲಿ मांसधरा, रक्तधरा, मेधोधरा, श्लेष्मधरा, मलधरा, पित्तधरा, रेतोधरा ಎಂದು ೭ ಕಲೆಗಳಿರುವುವು.<br><br>कला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಷದಲ್ಲಿ ಅಂಶದ ಅರವತ್ತನೆಯ ಒಂದು ಭಾಗ<br><b>प्रयोगाः - </b>"विकलानां कला षष्ट्या तत्षष्ट्या भाग उच्यते । तत्रिंशता भवेद्राशिः भगणो द्वादशैव ते ॥"<br><b>उल्लेखाः - </b>सू ०सि० १-७<br><br>कला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಟ್ಟು ಸೇರಿಸುವುದು /ಕೂಡುವುದು /ಲೆಕ್ಕ ಹಾಕುವುದು<br><br>कला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಸೂಕ್ಷ್ಮಾಂಶ /ಪರಮಾಣು<br><br>कला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಞಾನ /ಅರಿವು /ತಿಳುವಳಿಕೆ<br><br>कला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸರ ರಜಸ್ಸು<br><br>कला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೌಕೆ /ಹಡಗು /ನಾವೆ<br><br>कला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಾಣತನ /ಕೌಶಲ<br><b>विस्तारः - </b>"कलांशमात्रे शिल्पादौ कलना कालभेदयोः । इन्दोश्च षोडशे भागे स्यान्मूलधनवर्धने" - नानार्थर०<br><br>कला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಂಚಮಹಾಭೂತಗಳು<br><br>कला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗ /ಅವಯವ<br><br>कला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯ<br><b>प्रयोगाः - </b>"कालशिल्पे वित्तवृद्धौ चन्द्रांशे कलने कला । महाभूतेष्विन्द्रियेषु ज्ञानावयवयोरपि ॥" - वैज०<br><b>विस्तारः - </b>"कालशिल्पे वित्तवृद्धौ चन्द्रांशे कलने कला । महाभूतेष्विन्द्रियेषु ज्ञानावयवयोरपि" - वैज० ।<br><br>कला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮನುಷ್ಯನ ಶರೀರರಚನೆಗೆ ಬೇಕಾದ ೧೬ ಉಪಾಧಿಗಳು<br><b>प्रयोगाः - </b>"तस्मै स होवाच इहैवान्तःशरीरे सोम्य । स पुरुषो यस्मिन्नेताः षोडश कलाः प्रभवन्ति इति"<br><b>उल्लेखाः - </b>प्रश्नोप०<br><b>विस्तारः - </b>೧೬ ಉಪಧಿಗಳು - प्राणः, श्रद्धा, आकाशः, वायुः, तेजः, जलम्, पृथ्वी, इन्द्रियम्, मनः, अन्नम्, वीर्यम्, तपः, मन्त्रः, कर्म, लोकः, नाम ।<br><br>

कलाकुल
कलाकुल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಲಾಹಲವಿಷ<br><b>निष्पत्तिः - </b>आकुलि - नामधा० "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कलया मात्रयापि आकुलयति<br><br>

कलाकुशल
कलाकुशल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಶಲವಿದ್ಯೆಯಲ್ಲಿ ನಿಪುಣನಾದವನು<br><b>व्युत्पत्तिः - </b>कलायां कुशलः<br><br>

कलाकेलि
कलाकेलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥ /ಕಾಮ<br><b>व्युत्पत्तिः - </b>कलया केलिरस्य<br><b>विस्तारः - </b>"रागरज्जुः कलाकेलिमधुदीपरवीषुरः" - त्रिकाण्ड० ।<br><br>

कलाक्षय
कलाक्षय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರನ ಕಲೆಗಳು ಕಡಿಮೆಯಾಗುವಿಕೆ<br><b>व्युत्पत्तिः - </b>कलानां षोडशकलानां क्षयो नाशः<br><b>प्रयोगाः - </b>"पर्यायपीतस्य सुरैर्हिमांशोः कलाक्षयः श्लाघ्यतरो हि वृद्धेः"<br><b>उल्लेखाः - </b>रघु० ५-१६<br><br>

कलाङ्कुर
कलाङ्कुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾರಸ ಪಕ್ಷಿ<br><b>व्युत्पत्तिः - </b>कलस्याङ्कुरो यत्र<br><br>कलाङ्कुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೌರ್ಯಶಾಸ್ತ್ರಪ್ರವರ್ತಕನಾದ ಮೂಲದೇವ<br><b>व्युत्पत्तिः - </b>कलानामङ्कुरो यत्र<br><b>विस्तारः - </b>"कर्णीसुतो मूलदेवो मूलभद्रः कलाङ्कुरः" - त्रिकाण्ड० ।<br><br>

कलाची
कलाची<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಳಕೈ ಮತ್ತು ಮಣಿಕಟ್ಟುಗಳ ಮಧ್ಯಭಾಗ /ಮುಂಗೈ<br><b>निष्पत्तिः - </b>अञ्चु (गतौ) - "अण्" (३-२-१) । गौरा० "ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>कलामञ्चति<br><br>

कलाचिका
कलाचिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಳಕೈ ಮತ್ತು ಮಣಿಕಟ್ಟುಗಳ ಮಧ್ಯಭಾಗ /ಮುಂಗೈ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><br>

कलाद
कलाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಕ್ಕಸಾಲೆ /ಚಿನ್ನ ಬೆಳ್ಳಿ ಕೆಲಸಗಾರ<br><b>निष्पत्तिः - </b>आ + डुदाञ् (दाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कलामंशमादत्ते<br><b>प्रयोगाः - </b>"वयं कलादा इव दुर्विदग्धं त्वद्गौरिमस्पर्धि दहेम हेम"<br><b>उल्लेखाः - </b>नैष० ८-९९<br><br>

कलादक
कलादक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಣಕಾರ /ಅಕ್ಕಸಾಲೆ /ಚಿನ್ನ ಬೆಳ್ಳಿಕೆಲಸಗಾರ<br><b>निष्पत्तिः - </b>अद (भक्षणे) - "ण्वुल्" (३-१-३३)<br><b>व्युत्पत्तिः - </b>कलामंशमत्ति<br><br>

कलाधर
कलाधर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>निष्पत्तिः - </b>धृञ् (धारणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>धरति इति धरः । कलानां धरः ।<br><br>कलाधर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಪರಮೇಶ್ವರ<br><br>कलाधर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರವತ್ತನಾಲ್ಕು ಕಲೆಗಳನ್ನು ಬಲ್ಲವನು<br><br>

कलानिधि
कलानिधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>निष्पत्तिः - </b>नि + डुधाञ् (धारणपोषणयोः) - "किः" (३-३-९३)<br><b>व्युत्पत्तिः - </b>कल निधीयन्तेऽस्मिन्<br><b>प्रयोगाः - </b>"अहो महत्त्वं महतामपूर्वं विपत्तिकालेऽपि परोपकारः । यथाऽस्यमध्ये पतितोऽपि राहोः कलानिधिः पुण्यचयं ददाति ॥"<br><b>उल्लेखाः - </b>उद्भ०<br><br>

कलान्तर
कलान्तर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಡ್ಡಿ /ಮೂಲಧನ /ವೃದ್ಧ್ಯಂಶ<br><b>व्युत्पत्तिः - </b>अन्या कला अंशः<br><br>कलान्तर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರನ ಮತ್ತೊಂದು ಕಲೆ<br><b>प्रयोगाः - </b>"पुपोष लावण्यमयान् विशेषान् ज्योत्स्नान्तराणीव कलान्तराणि" । "मासे शतस्य यदि पञ्च कलान्तरं स्यात्"<br><b>उल्लेखाः - </b>कुमा० १-२५। लीला०<br><br>

कलाप
कलाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೂಹ /ಗುಂಪು /ರಾಶಿ<br><b>निष्पत्तिः - </b>आल्पृ (व्याप्तौ) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कला मात्रामाप्नोति<br><b>प्रयोगाः - </b>"क्रियाकलापैरिदमेव योगिनः श्रद्धान्विताः साधु यजन्ति सिद्धये"<br><b>उल्लेखाः - </b>भाग० ४-२४-६२<br><br>कलाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನವಿಲಿನ ಪುಕ್ಕ<br><b>प्रयोगाः - </b>"पक्षस्थतावद्बहुचन्द्रकोऽपि कलापिनां येन जितः कलापः"<br><b>उल्लेखाः - </b>नैष० ७-२०<br><br>कलाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಷಣ /ಒಡವೆ<br><b>प्रयोगाः - </b>"कण्ठस्य तस्याः स्तनबन्धुरस्य मुक्ताकलापस्य च निस्तलस्य"<br><b>उल्लेखाः - </b>कुमा० १-४२<br><br>कलाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಡಾಬು /ಒಡ್ಯಾಣ<br><br>कलाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><br>कलाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಾಣ /ಬುದ್ಧಿವಂತ<br><br>कलाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾತಂತ್ರವೆಂಬ ಒಂದು ವ್ಯಾಕರಣ<br><br>कलाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬತ್ತಳಿಕೆ /ಬಾಣವನ್ನಿಡುವ ಚರ್ಮದ ಚೀಲ<br><b>विस्तारः - </b>"कलापः संहतौ बर्हे काञ्च्यां भूषणतूणयोः । चन्द्रे विदग्धे व्याकरणभेदेऽपि कथ्यते बुधैः" - मेदि० ।<br><br>कलाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಗ್ರಾಮ /ಒಂದು ಹಳ್ಳಿ<br><b>प्रयोगाः - </b>"देवापिर्योगमास्थाय कलापग्राममास्थितः । सोमवंशे कलौ नष्टे कृतादौ स्थापयिष्यति ॥"<br><b>उल्लेखाः - </b>भाग० ९-१२-१३<br><br>कलाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧನಸ್ಸು /ಬಿಲ್ಲು /ಅಂಬು<br><br>कलाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣ /ಶರ<br><br>कलाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಕತ್ತಿನ ಹಗ್ಗ<br><br>

कलापक
कलापक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>कलाप ಪದದ ಅರ್ಥ<br><br>कलापक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಏಕಕರ್ತೃಕ್ರಿಯಾತ್ಮಕವಾಗಿ ಒಂದೇ ಅನ್ವಯವುಳ್ಳ ವಾಕ್ಯವಾಗಿರುವ ೪ ಶ್ಲೋಕಗಳು<br><b>प्रयोगाः - </b>"द्वाभ्यां युग्ममिति प्रोक्तं त्रिभिः श्लोकैर्विशेषकम् । कलापकं चतुर्भिः स्यात् तदूर्ध्वं कुलकं मतम् ॥"<br><br>कलापक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನವಿಲುಗಳು ಪುಕ್ಕವನ್ನು ಬಿಚ್ಚುವ ಕಾಲದಲ್ಲಿ ಕೊಡಬೇಕಾದ ಸಾಲ<br><b>निष्पत्तिः - </b>"वुन्" (४-३-४८)<br><b>व्युत्पत्तिः - </b>यस्मिन् काले मयूराः कलापिनो भवन्ति स कलापी तत्र देयं ऋणम्<br><br>

कलापद्वीप
कलापद्वीप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲಾಪವೆಂಬ ಒಂದು ಗ್ರಾಮ<br><b>प्रयोगाः - </b>"सत्यभामा तथैवान्या देव्यः कृष्णस्य सम्मताः । वनं प्रविविशू राजन् तपसे कृतनिश्चयाः ॥ फलमूलादिभोजिन्यो हरिध्यानैकतत्पराः । हिमवन्तमतिक्रम्य कलापग्राममाविशन् ॥"<br><b>उल्लेखाः - </b>भा० मौसल० ७<br><br>

कलापिन्
कलापिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಯೂರ /ನವಿಲು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कलापोऽस्यास्ति<br><b>प्रयोगाः - </b>"ननृतुश्च वारिधरधीरवारणध्वनिहृष्टकूजितकलाः कलापिनः"<br><b>उल्लेखाः - </b>माघ०१३-५<br><br>कलापिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಲದ ಮರ<br><br>कलापिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><b>निष्पत्तिः - </b>आल्पृ (व्याप्तौ) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कलस्यापी<br><br>कलापिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನವಿಲುಗಳು ಪುಕ್ಕವನ್ನು ಬಿಚ್ಚುವ ಕಾಲ<br><br>कलापिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣಗಳಿಂದ ತುಂಬಿದ ಬತ್ತಳಿಕೆಯನ್ನು ಧರಿಸಿರುವ<br><br>

कलापिनी
कलापिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कलापिन् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>कलापिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾತ್ರಿ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५) । "ङीप्" (४-१-५)<br><b>व्युत्पत्तिः - </b>कलापः चन्द्रोऽस्त्यस्याम्<br><br>कलापिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಗರಮುಸ್ತೆ<br><br>कलापिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ನವಿಲು<br><br>

कलापूर्ण
कलापूर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಣ್ಣಿಮೆಯ ಚಂದ್ರ<br><b>व्युत्पत्तिः - </b>कलाभिः षोडशकालभिः पूर्णः<br><br>कलापूर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಶಲವಿದ್ಯೆಯಿಂದ ತುಂಬಿದ /ಸಕಲ ಕಲೆಗಳಲ್ಲಿಯೂ ನಿಪುಣನಾದ<br><b>प्रयोगाः - </b>"सद भवान् फाल्गुनस्य गुणानस्मासु कत्थसे । न चार्जुनः कलापूर्णः मम दुर्योधनस्य वा ॥"<br><b>उल्लेखाः - </b>भा० विरा० ४०-२९<br><br>

कलाभृत्
कलाभृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><br>कलाभृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲೆಗಾರ /ಶಿಲ್ಪಿ /ಕಲಾವಿದ /ಕಲಾಭಿಜ್ಞ<br><b>निष्पत्तिः - </b>डुभृञ् (धारणपोषणयोः) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>कलां बिभर्ति<br><b>प्रयोगाः - </b>"दशाब्दारूपं पौरसरूपं पञ्चाब्दाख्यं कलाभृताम्"<br><b>उल्लेखाः - </b>मनु० २-१३४<br><br>

कलाय
कलाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೆಲಗಡಲೆ ಗಿಡ<br><b>निष्पत्तिः - </b>अय (गतौ) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कलामयते<br><b>प्रयोगाः - </b>"विकसत्कलायकुसुमासितद्युतेरलघूडुपाण्डु जगतामधीशितुः"<br><b>उल्लेखाः - </b>माघ० १३-२१<br><br>

कलालाप
कलालाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭ್ರಮರ /ದುಂಬಿ<br><b>निष्पत्तिः - </b>आ + लप (व्यक्तायां वाचि) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कलमालपति<br><br>

कलावत्
कलावत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४) । मस्य वः (७-२-९)<br><b>व्युत्पत्तिः - </b>कलाः सन्त्यस्मिन्<br><b>प्रयोगाः - </b>"कला च सा कान्तिमती कलावतः त्वमस्य लोकस्य च नेत्रकौमुदी"<br><b>उल्लेखाः - </b>कुमा० ५-७१<br><br>कलावत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಲಾವಿದ /ಗೀತ ನೃತ್ಯ ಮುಂತಾದ ಕಲೆಗಳನ್ನು ಬಲ್ಲವನು<br><br>

कलावती
कलावती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कलावत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>कलावती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತುಂಬುರುವಿನ ವೀಣೆ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४) । मस्य वः (७-२-९) । "ङीप्" (४-१-६)<br><b>व्युत्पत्तिः - </b>कलाः गीतरागादयः सन्त्यस्याम्<br><b>प्रयोगाः - </b>"विश्वावयोस्तु बृहती तुम्बुरोस्तु कलावती । महती नारदस्य स्यात् सरस्वत्यास्तु कच्छपी ॥"<br><br>कलावती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದ್ರುಮಿಲರಾಜನ ಮಗಳು<br><br>कलावती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಧೆಯ ತಾಯಿ /ವೃಷಭಾನುವಿನ ಪತ್ನಿ<br><br>कलावती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಗೆ<br><br>

कलाविक
कलाविक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಕ್ಕುಟ /ಕೋಳಿ<br><b>निष्पत्तिः - </b>आ + वि + कै (शब्दे) - "कः" (३-१-१३६)<br><b>व्युत्पत्तिः - </b>कलेन सम्यक् विकायति<br><b>विस्तारः - </b>"कुक्कुटस्तु विवृत्ताक्षी रात्रिवेदी कलाविकः" - त्रिकाण्ड० ।<br><br>

कलाविकी
कलाविकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಕ್ಕುಟ /ಕೋಳಿ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

कलाविद्
कलाविद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಲೆಗಳನ್ನು ಅರಿತವನು /ಶಿಲ್ಪವಿದ್ಯೆಗಳನ್ನು ಬಲ್ಲವನು<br><b>निष्पत्तिः - </b>विद (ज्ञाने) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>कलाः वेत्ति<br><br>

कलाहक
कलाहक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಹಳೆಯೆಂಬ ಒಂದು ವಾದ್ಯ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः)- "क्विप्" । सञ्ज्ञायां "कन्"<br><b>व्युत्पत्तिः - </b>कलामाहन्ति<br><br>

कलि
कलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲಿಯುಗ /ಚತುರ್ಯುಗಗಳಲ್ಲಿ ನಾಲ್ಕನೆಯ ಯುಗ<br><b>निष्पत्तिः - </b>कल (गतौ सङ्ख्याने च) - "डः" (उ० ४-१३८)<br><b>व्युत्पत्तिः - </b>कलयति पापेन जडयति कलुषितं करोति<br><b>प्रयोगाः - </b>"भक्तिमुक्तिफलप्रेप्सुरल्पोपायेन चेन्नरः । तीर्थान्येवाश्रयेद्विद्वान् कलौ गङ्गां विशेषतः ॥"<br><b>उल्लेखाः - </b>स्कान्द०<br><br>कलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲಿಯುಗದ ಅಭಿಮನಿ ದೇವತೆ<br><br>कलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಭೀತಕ ವೃಕ್ಷ /ತಾರೆಗಿಡ<br><b>प्रयोगाः - </b>"विभीतकमधिष्ठाय तथाभूतेन तिष्ठता । तेन भुवोऽभीकः स राजर्षिरधर्षि न । तमालम्बनमासाद्य वैदर्भीनिषधेशयोः । कलुषं कलिरन्विष्यन् अवासीद्वत्सरान् बहून् ॥"<br><b>उल्लेखाः - </b>नैष० १७-२१६,१७<br><br>कलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲಹ /ಜಗಳ<br><b>प्रयोगाः - </b>"वसतिमुपगतेन धाम्नि तस्याः शठ कलिरेष महांस्त्वयाद्य दत्तः"<br><b>उल्लेखाः - </b>माघ० ७-५५<br><br>कलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಾಕ್ರಮಿ /ಶೂರ<br><br>कलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ<br><br>कलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶರ /ಬಾಣ<br><br>कलि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಗ್ಗು /ಅರಳಿದ ಹೂವು<br><b>विस्तारः - </b>"कलिः स्त्री कलिकायां ना शराजिकलहे युगे" - मेदि० । "कलिर्विभीतके शूरे विवादेऽन्त्ययुगे युधि" - हेम० ।<br><br>

कलिका
कलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋರಕ /ಮೊಗ್ಗು /ಅರಳಿದ ಹೂವು<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><b>व्युत्पत्तिः - </b>कलिरेव<br><b>प्रयोगाः - </b>"मुहुरुपहसितामिवालिनादैर्वितरसि नः कलिकां किमर्थमेनाम्" । "चूतानां नवनिर्गतापि कलिका बध्नाति न स्वं रजः"<br><b>उल्लेखाः - </b>माघ० ७-५५, शाकु० ६-४<br><br>कलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇಣೆಯ ಮೂಲಭಾಗ<br><br>

कलिकार
कलिकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾರದಮಹರ್ಷಿ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कलिं कलहं करोति<br><br>कलिकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನದಿಯಲ್ಲಾಡುವ ಕುಕ್ಕುಟವೆಂಬ ಒಂದು ಹಕ್ಕಿ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कलिकामृच्छति<br><br>कलिकार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಲಹವನ್ನುಂಟುಮಾಡುವ<br><br>कलिकार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊಗ್ಗನ್ನು ಪಡೆಯುವ<br><b>निष्पत्तिः - </b>"ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कलिं करोति कलिकां ऋच्छति वा<br><br>

कलिकारी
कलिकारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಪಸಿಗಿಡ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

कलिकारक
कलिकारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>कलिकार ಪದದ ಅರ್ಥ<br><br>

कलिकाल
कलिकाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲಿಪುರುಷನ ಕಾಲ /ಕಲಿಯುಗದ ಕಾಲ<br><br>

कलिकुञ्चिका
कलिकुञ्चिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಡನ ಕಿರಿಯ ಸಹೋದರಿ /ಗಂಡನ ತಂಗಿ /ನಾದಿನಿ<br><br>

कलिङ्ग
कलिङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಳಿಂಗ ದೇಶ<br><b>विस्तारः - </b>बहुचवनान्तं रूपम् ।<br><br>कलिङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಳಿಂಗದೇಶದ ಜನರು<br><b>प्रयोगाः - </b>"जगन्नाथात् समारभ्य कृष्णातीरान्तगं प्रिये । कलिङ्गदेशःसम्प्रोक्तो वाममार्गपरायणः ॥ " "उत्कलादर्शितपथः कलिङ्गाभिमुखो ययौ"<br><b>उल्लेखाः - </b>२)रघु० ४-३८<br><br>कलिङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆರೆ ನದಿಗಳ ನೀರೊಳಗೆ ಆಟವಾಡುವ ಕುಕ್ಕುಟವೆಂಬ ಒಂದು ಹಕ್ಕಿ<br><b>व्युत्पत्तिः - </b>के मूर्ध्नि लिङ्गमस्य<br><b>विस्तारः - </b>ಈ ಹಕ್ಕಿಯ ತಲೆಯ ಮೇಲೆ ಮೊಗ್ಗಿನ ಆಕಾರದ ಹಳದಿಯ ಗುರುತೊಂದಿರುವುದರಿಂದ ಈ ಹೆಸರಾಯಿತು.<br><br>कलिङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಪಸಿಗಿಡ<br><br>कलिङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಡಶಿಗೆಯ ಹಣ್ಣು<br><br>

कलिङ्गा
कलिङ्गा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತಮ ಹೆಂಗಸು<br><b>विस्तारः - </b>"कलिङ्गः पुतिकरजे धूम्याटे नीवृति । न द्वयोः कौटजफले महिलायां तु योषिति" - मेदि० ।<br><br>

कलित
कलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कल (गतौ) - "क्तः" (३-२-१०२)<br><br>कलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗೀಕರಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"स्वरभेदमुपैतु या कथं कलितानल्पमुखारवा न वा"<br><b>उल्लेखाः - </b>नैष० २-९८<br><br>कलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆೇಳಲ್ಪಟ್ಟ<br><br>कलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"लवङ्गमालाकलितावतंसास्ते नारिकेलान्तरपः पिबन्तः"<br><b>उल्लेखाः - </b>माघ० ३-८१<br><br>कलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಣಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कल (सङ्ख्याने) - "क्तः" (३-२-१०२)<br><br>कलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಂದಲ್ಪಟ್ಟ /ಪಡೆಯಲ್ಪಟ್ಟ<br><br>कलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಡೆಯಲ್ಪಟ್ಟ /ಬೇರ್ಪಡಿಸಲ್ಪಟ್ಟ<br><br>कलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಟ್ಟಲ್ಪಟ್ಟ<br><br>

कलिद्रुम
कलिद्रुम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಭೀತಕ ವೃಕ್ಷ /ತಾರೆಗಿಡ<br><b>प्रयोगाः - </b>"कलिद्रुमः परं नासीदासीत्कल्पद्रुमोऽपि सः"<br><b>उल्लेखाः - </b>नैष० १७-२१३<br><b>विस्तारः - </b>ನಳಚರ್ಕವರ್ತಿಯ ಶರೀರವನ್ನು ಪ್ರವೇಶಿಸಲು ಸಮಯ ಕಾಯುತ್ತ ಈ ಮರದಲ್ಲಿ ಕಲಿಯು ಕುಳಿತಿದ್ದರಿಂದ ಈ ಹೆಸರು.<br><br>

कलिन्द
कलिन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಬೆಟ್ಟ<br><b>निष्पत्तिः - </b>दो (अवखण्डने) - "खच्" । मुमागमः ।<br><b>व्युत्पत्तिः - </b>कलिं द्यति<br><b>प्रयोगाः - </b>"कलिन्दगिरिनन्दिनीतटसुरद्रुमालम्बिनी मदीयमतिचुम्बिनी भवतु कापि कादम्बिनी"<br><b>उल्लेखाः - </b>रसगं०<br><br>कलिन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾರೆಗಿಡ<br><br>

कलिन्दकन्या
कलिन्दकन्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಳಿಂದಗಿರಿಯ ಮಗಳು /ಯಮುನಾ ನದಿ<br><b>व्युत्पत्तिः - </b>कलिन्दस्य कन्या<br><b>प्रयोगाः - </b>"कलिन्दकन्या मधुरां गतापि गङ्गोर्मिसंसक्तजलेव भाति"<br><b>उल्लेखाः - </b>रघु० ६-४८<br><br>

कलिन्दजा
कलिन्दजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಳಿಂದಗಿರಿಯ ಮಗಳು /ಯಮುನಾ ನದಿ<br><br>

कलिन्दतनय
कलिन्दतनय<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಳಿಂದಗಿರಿಯ ಮಗಳು /ಯಮುನಾ ನದಿ<br><br>

कलिन्दनन्दिनी
कलिन्दनन्दिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಳಿಂದಗಿರಿಯ ಮಗಳು /ಯಮುನಾ ನದಿ<br><br>

कलिन्दसुता
कलिन्दसुता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಳಿಂದಗಿರಿಯ ಮಗಳು /ಯಮುನಾ ನದಿ<br><br>

कलिप्रिय
कलिप्रिय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲಹವೇ ಪ್ರಿಯವಾಗುಳ್ಳ ನಾರದಮಹರ್ಷಿ<br><b>व्युत्पत्तिः - </b>कलिः कलहः प्रियोऽस्य<br><br>

कलिमारक
कलिमारक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಪಸಿಗಿಡ<br><b>निष्पत्तिः - </b>मृङ् (प्राणत्यागे) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कलिं मारयति<br><br>

कलियुग
कलियुग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲಿರೂಪವಾದ ಒಂದು ಯುಗ /ಕಲಿಪುರುಷನ ಕಾಲ<br><b>व्युत्पत्तिः - </b>कलेर्युगम्<br><b>प्रयोगाः - </b>"अन्ये कृतयुगे धर्मास्त्रेतायां द्वापरेऽपरे । अन्ये कलियुगे नृणां युगह्रासानुसारतः ॥"<br><b>उल्लेखाः - </b>मनु० १-८५<br><br>

कलिल
कलिल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲುಷ್ಯ<br><b>निष्पत्तिः - </b>कल (गतौ सङ्ख्याने च) - "इलच्" (उ० १-५४)<br><b>प्रयोगाः - </b>"यदा ते मोहकलिलं बुद्धिर्व्यतितरिष्यति"<br><b>उल्लेखाः - </b>गीता० २-५२<br><br>कलिल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೊಡ್ಡ ರಾಶಿ<br><br>कलिल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಿಶ್ರವಾದ /ಬೆರೆತಿರುವ<br><b>प्रयोगाः - </b>"लोकालोकी कलोऽकल्ककलिलौऽलिकुलालकः"<br><b>उल्लेखाः - </b>माघ० १९-९८<br><br>

कलिहारी
कलिहारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರುಹಿಪ್ಪಲಿ<br><b>निष्पत्तिः - </b>हृञ् (हरणे) - "अण्" (३-२-१) । "ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>कलिं हरति<br><br>

कलुष
कलुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः / स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಿಷ /ಎಮ್ಮೆ<br><b>निष्पत्तिः - </b>लुष (हिंसायाम्) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>कस्य जलस्य लुषः घातकः<br><br>कलुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः / स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ವಪಾಕಿಯಲ್ಲಿ ಕ್ಷತ್ರಿಯನಿಗೆ ಜನಿಸಿದ ಮಗ<br><b>प्रयोगाः - </b>"जरन्तः कलुषः पोत्री वीरस्कन्धो रजस्वलः"<br><b>विस्तारः - </b>"श्वपाकी कलुषं सूता कीलुषं घर्घरी मिषम्" - वैज० ।<br><br>कलुष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><br>कलुष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಳೆ /ಮಲ<br><br>कलुष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಸರು<br><br>कलुष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಗ್ಗಡ /ಕಶ್ಮಲದ ನೀರು<br><b>निष्पत्तिः - </b>कल (गतौ सङ्ख्याने च) - "उषच्" (उ० ४-७५)<br><br>कलुष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪ<br><br>कलुष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪವುಳ್ಳ<br><br>कलुष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಚ್ಛವಲ್ಲದ /ಬಗ್ಗಡವಾದ<br><b>प्रयोगाः - </b>"लोलत्वादपहरतां तदङ्गरागं सञ्जज्ञे स कलुष आशयो जलानाम्"<br><b>उल्लेखाः - </b>माघ० ८-४७<br><br>कलुष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಳೆಯಿಂದ ಕೂಡಿದ<br><br>कलुष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಮಾಧಾನದಿಂದ ಕೂಡಿದ<br><br>कलुष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಮರ್ಥವಾದ<br><b>प्रयोगाः - </b>"भावावबोधकलुषा दयितेव रात्रौ निद्रा चिरेण नयनाभिमुखी बभूव"<br><b>उल्लेखाः - </b>रघु० ५-६४<br><br>कलुष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿತವಾದ /ದುಷ್ಟವಾದ<br><b>प्रयोगाः - </b>"त्वां प्रत्यकस्मात्कलुषप्रवृत्तावस्त्येव मन्युर्भरताग्रजे मे"<br><b>उल्लेखाः - </b>रघु० १४-७३<br><br>

कलुषी
कलुषी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಿಷ /ಎಮ್ಮೆ<br><br>

कलुषता
कलुषता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪದಿಂದ ಕೂಡಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कलुषस्य भावः<br><br>कलुषता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಸರಾಗಿರುವಿಕೆ<br><br>कलुषता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಚ್ಛವಾಗಿಲ್ಲದಿರುವಿಕೆ<br><br>

कलुषत्व
कलुषत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>कलुषता ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

कलुषमति
कलुषमति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಮನಸ್ಸುಳ್ಳ /ನೀಚ ಬುದ್ಧಿಯುಳ್ಳ<br><br>कलुषमति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಮಾಧಾನಗೊಂಡ ಮನಸ್ಸುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कलुषा मतुर्यस्य<br><br>

कलुषात्मन्
कलुषात्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಹೃದಯವುಳ್ಳ /ನೀಚ ಮನಸ್ಸುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कलुष आत्मा यस्य<br><br>कलुषात्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಮಾಧಾನ ಹೊಂದಿದ /ಕಲಕಿದ ಹೃದಯವುಳ್ಳ<br><br>

कलुषित
कलुषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಮಾಧಾನಗೊಂಡಿರುವ<br><br>कलुषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಚ್ಛವಾಗಿಲ್ಲದ /ಬಗ್ಗಡವಾಗಿರುವ<br><br>कलुषित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿತ /ದೂಷಿತ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>कलुषोऽस्य सञ्जातः<br><br>

कलुषीकृत
कलुषीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಲಕಲ್ಪಟ್ಟ /ಕೆರಳಿಸಲ್ಪಟ್ಟ<br><br>कलुषीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಮಾಧಾನಗೊಳಿಸಲ್ಪಟ್ಟ /ಸಿಟ್ಟುಗೊಳಿಸಲ್ಪಟ್ಟ<br><br>कलुषीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಡವಾಗಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"च्विः" (५-४-५०) । "दीर्घः (७-४-२६)<br><b>व्युत्पत्तिः - </b>अलकुषः कलुषः कृतः<br><b>प्रयोगाः - </b>"विवर्तयन् मदकलुषीकृते दृशौ कराहतक्षितिकृतभैरवारवः"<br><b>उल्लेखाः - </b>माघ० १७-१३<br><br>

कलेबर
कलेबर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹ /ಶರೀರ /ಮೈ<br><b>निष्पत्तिः - </b>सप्तम्या "अलुक्" (६-३-९)<br><b>व्युत्पत्तिः - </b>कले शुक्रधातौ वरं श्रेष्ठम् ।<br><b>प्रयोगाः - </b>"यं यं वापि स्मरन् भावं त्यजत्यन्ते कलेबरम्" । "शरीरे जर्जरीभूते व्याधिग्रस्ते कलेवरे । औषधं जाह्नवीतोयं वैद्यो नारायणो हरिः ॥"<br><b>उल्लेखाः - </b>१)गीता०<br><br>कलेबर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಗ್ಗುಳ /ಲೋಬಾನ /ಧೂಪದ ವಾಸನೆಯ ಪುಡಿ<br><br>

कल्क
कल्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಟ /ಛಲ /ಠಕ್ಕು /ಬೂಟಾಟಿಕೆ<br><br>कल्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಾರೆಗಿಡ<br><br>कल्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಣ್ಣೆ ತುಪ್ಪ ಇವುಗಳ ಗಷ್ಟು<br><br>कल्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವಿಯ ಮಲ /ಗುಗ್ಗೆ<br><br>कल्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><b>निष्पत्तिः - </b>कल (शब्दसङ्ख्यानयोः) - "कः" (उ० ३-४०)<br><br>कल्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಠೆ /ಮಲ /ಪುರೀಷ<br><br>कल्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚೂರ್ಣ /ಪುಡಿ<br><b>प्रयोगाः - </b>"तां लोध्रकल्पेन हृताङ्गतैलामाश्यानकालेयकृताङ्गरागाम्"<br><b>उल्लेखाः - </b>कुमा० ७-९<br><br>कल्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪಾತ್ಮ /ಪಾಪಿಷ್ಠ<br><b>विस्तारः - </b>"कल्कोऽस्त्री धृततैलादिशेषे दम्भे विभीतके । विट्किट्तयोश्च पापे च त्रिषु पापाशये पुनः" -मेदि० ।<br><br>

कल्कन
कल्कन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಂಚನೆ /ಮೋಸ<br><b>निष्पत्तिः - </b>कल्क + णिच् - भावे "ल्युट्" (३-३-११५)<br><br>

कल्कफल
कल्कफल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಾಳಿಂಬೆ ಹಣ್ಣು<br><b>व्युत्पत्तिः - </b>कल्कस्य विभीतकस्य फलमिव फलमस्य<br><br>

कल्किन्
कल्किन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾವಿಷ್ಣುವಿನ ಹತ್ತನೆಯ ಅವತಾರ /ಕಲ್ಕ್ಯವತಾರ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कल्कोऽस्त्यस्य हार्यतया<br><br>

कल्किपुराण
कल्किपुराण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಉಪಪುರಾಣ<br><br>

कल्प
कल्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಗತ್ತಿನ ಸೃಷ್ಟಿಕಾಲ /ಬ್ರಹ್ಮನು ಜಗತ್ತನ್ನು ಸೃಷ್ಟಿಸುವ ಕಾಲ /ಬ್ರಹ್ಮನ ಹಗಲು /ಬ್ರಹ್ಮನ ಹಗಲು<br><br>कल्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮನ ರಾತ್ರಿ /ಜಗತ್ತಿನ ವ್ಯಾಪಾರವಿಲ್ಲದ ಪೆಅಳಯಕಾಲ<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) - अधि० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>कल्पते स्वक्रियायै समर्थः असमर्थश्च भवति<br><b>प्रयोगाः - </b>"यदा स देवो जागर्ति तदेदं चेष्टते जगत् । यदा स्वपिति शान्तात्मा तदा सर्वं निमीलति ॥" "कल्पस्यान्ते मारुतेनोपनुन्नाश्चेलुश्चण्डं गण्डशैला इवेभाः"<br><b>उल्लेखाः - </b>मनु० १-५२ । माघ० १८-६<br><br>कल्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೈದಿಕಕರ್ಮಾನುಷ್ಠಾನದ ವಿಧಿ /ನಿಯಮ /ಕಟ್ಟಳೆ<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) - कर्म० "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>कल्पते विधीयतेऽसौ<br><b>प्रयोगाः - </b>"एष वै प्रथमः कल्पः प्रदाने हव्यकव्ययोः । अनुकल्पस्त्वयं ज्ञेयः सदा सद्भिरनुष्ठितः ॥"<br><b>उल्लेखाः - </b>मनु० ३-१४७<br><br>कल्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರ<br><b>प्रयोगाः - </b>"कल्पवित् कल्पयामास वन्यामेवास्य संविधाम्"<br><b>उल्लेखाः - </b>रघु० १-९४<br><br>कल्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನ್ಯಾಯ<br><b>विस्तारः - </b>"कल्पः शास्त्रे विधौ न्याये संवर्ते ब्रह्मणो दिने" - मेदि० ।<br><br>कल्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಕಲ್ಪ /ಎರಡು ವಿಷಯಗಳಲ್ಲಿ ಯಾವುದಾದರೊಂದಕ್ಕೆ ಅವಕಾಶ /ಪಕ್ಷಾಂತರ<br><br>कल्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಪವೃಕ್ಷ<br><b>विस्तारः - </b>"कल्पो विकल्पे कल्पद्रौ संवर्ते ब्रह्मवासरे । शास्त्रे न्याये विधौ" - हेम० ।<br><br>कल्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣದಲ್ಲಿ ಸಮಾನಾರ್ಥಕವಾದ ಒಂದು ಪ್ರತ್ಯಯ<br><b>प्रयोगाः - </b>"छन्दः पादौ तु वेदस्य हस्तौ कल्पोऽथ पठ्यते । ज्योतिषामयनं चक्षुः निरुक्तं श्रोत्रमुच्यते ॥ शिक्षा घ्राणं तु वेदस्य मुखं व्याकरणं स्मृतम् । तस्मात् साङ्गमधीत्यैव ब्रह्मलोके महीयते ॥"<br><b>उल्लेखाः - </b>पा० शि०<br><br>कल्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆರು ವೇದಾಂಗಗಳಲ್ಲೊಂದು<br><br>

कल्पक
कल्पक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>कल्प ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>कल्प - स्वार्थे "कन्"<br><br>कल्पक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಪಿತ /ಕ್ಷೌರಿಕ<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कल्पयति क्षौरादिना वेशं रचयति<br><br>कल्पक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಚಿಸುವವನು /ನಿರ್ಮಿಸುವವನು /ತಯಾರಿಸುವವನು<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कल्पयति रचयति<br><br>कल्पक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರ್ಚೂರ /ಕಚೊರ<br><br>

कल्पकार
कल्पकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಪಸೂತ್ರಕಾರರು /ಮತಧರ್ಮಾಚರಣೆಯ ಸಂಬಂಧವಾದ ವಿಧಿಸೂತ್ರಕಾರರು /ಆಶ್ವಲಾಯನ ಆಪಸ್ತಂಬ ಮೊದಲಾದವರು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कल्पं कल्पसूत्रं करोति<br><br>कल्पकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಪಿತ /ಕ್ಷೌರಿಕ<br><br>कल्पकार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇಷಗಳನ್ನು ಹಾಕುವವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कल्पं वेषं करोति<br><br>

कल्पकारक
कल्पकारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>कल्पकार ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "ण्वुल्" (३-१-१३३)<br><br>

कल्पक्षय
कल्पक्षय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಪಕಾಲದ ಕೊನೆ /ಜಗತ್ತಿನ ಪ್ರಳಯಕಾಲ<br><b>व्युत्पत्तिः - </b>कल्पस्य सृष्टिविशेषस्य क्षयो यत्र<br><b>प्रयोगाः - </b>"कल्पक्षये पुनस्ते तु प्रविशन्ति परं पदम्"<br><b>उल्लेखाः - </b>विष्णुपु०<br><br>

कल्पतरु
कल्पतरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಕಲ ಇಷ್ಟಾರ್ಥಪ್ರದವಾದ ೫ ದೇವವೃಕ್ಷಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"आसीत्कल्पतरुच्छायामाश्रिता सुरभिः पथि"<br><b>उल्लेखाः - </b>रघु० १-७५<br><br>कल्पतरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದಾರ/ ಕೊಡುಗೈಯುಳ್ಳವನು<br><b>विस्तारः - </b>ಇಷ್ಟಾರ್ಥವನ್ನು ಕೊಡುವುದರಿಂದ ದಾತೃವೂ ಕಲ್ಪತರು.<br><br>

कल्पद्रु
कल्पद्रु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಕಲ ಇಷ್ಟಾರ್ಥಪ್ರದವಾದ ಕಲ್ಪವೃಕ್ಷ /೫ ದೇವತರುಗಳಲ್ಲೊಂದು<br><br>कल्पद्रु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಶವಕವಿವಿರಚಿತವಾದ ಒಂದು ನಿಘಂಟು /ಒಂದು ಶಬ್ದಕೋಶ<br><br>

कल्पद्रुम
कल्पद्रुम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಕಲ ಇಷ್ಟಾರ್ಥಪ್ರದವಾದ ಕಲ್ಪವೃಕ್ಷ /೫ ದೇವತರುಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"अनुकूलयतीन्द्रोऽपि कल्पद्रुमविभीषणैः"<br><b>उल्लेखाः - </b>कुमा० २-३९<br><br>

कल्पपादप
कल्पपादप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಕಲ ಇಷ್ಟಾರ್ಥಪ್ರದವಾದ ಕಲ್ಪವೃಕ್ಷ /೫ ದೇವತರುಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"मृषा न चक्रेऽल्पितकल्पपादपः"<br><b>उल्लेखाः - </b>नैष० १-१५<br><br>

कल्पवृक्ष
कल्पवृक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಕಲ ಇಷ್ಟಾರ್ಥಪ್ರದವಾದ ಕಲ್ಪವೃಕ್ಷ /೫ ದೇವತರುಗಳಲ್ಲೊಂದು<br><br>

कल्पशाखी
कल्पशाखी<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಕಲ ಇಷ್ಟಾರ್ಥಪ್ರದವಾದ ಕಲ್ಪವೃಕ್ಷ /೫ ದೇವತರುಗಳಲ್ಲೊಂದು<br><br>

कल्पन
कल्पन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಚನೆ /ನಿರ್ಮಾಣ<br><br>कल्पन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಡುವಿಕೆ /ಸಿದ್ಧಪಡಿಸುವಿಕೆ /ಏರ್ಪಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) + णिच् - भावे "ल्युट्" (३-१-११५)<br><br>कल्पन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಛೇದನ /ಕತ್ತರಿಸುವಿಕೆ<br><br>कल्पन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಊಹಿಸುವಿಕೆ /ಶಂಕಿಸುವಿಕೆ<br><br>कल्पन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಪಿಸಿ ಹೇಳುವಿಕೆ /ಇಲ್ಲದುದನ್ನು ಸೃಷ್ಟಿಸಿ ಹೇಳುವಿಕೆ /ಆರೋಪಣೆ<br><br>कल्पन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಪಿತಕಥೆ /ಕಟ್ಟುಕಥೆ<br><br>कल्पन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಮಾನ ಅಥವಾ ಅರ್ಥಾಪತ್ತಿಪ್ರಮಾಣದಿಂದ ಊಹಿಸಿ ವಿಷಯವನ್ನು ತೀರ್ಮಾನಿಸುವಿಕೆ<br><br>

कल्पना
कल्पना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಚನೆ /ನಿರ್ಮಾಣ<br><br>कल्पना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಡುವಿಕೆ /ಸಿದ್ಧಪಡಿಸುವಿಕೆ /ಏರ್ಪಡಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) + णिच् - भावे "युच्" (३-३-१०७)<br><b>प्रयोगाः - </b>"प्रस्थानकालक्षमवेषकल्पनाकृतक्षणक्षेपमुदैक्षताच्युतम्"<br><b>उल्लेखाः - </b>माघ० १२-१<br><br>कल्पना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಊಹಿಸುವಿಕೆ /ಶಂಕಿಸುವಿಕೆ<br><b>प्रयोगाः - </b>"मदन्यदानं प्रति कल्पना या वेदस्त्वदीये हृदि तावदेषा"<br><b>उल्लेखाः - </b>नैष० ३-७५<br><br>कल्पना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯನ್ನು ಅಲಂಕರಿಸುವಿಕೆ /ಆನೆಯ ಬೆನ್ನಿನ ಮೇಲೆ ಗವುಸನ್ನು ಹೊದ್ದಿಸಿ ಶೃಂಗರಿಸುವಿಕೆ<br><b>प्रयोगाः - </b>"सकल्पनं द्विरदगणं वरूथिनस्तुरङ्गिणो जयनयुजश्च वाजिनः"<br><b>उल्लेखाः - </b>माघ० १७-२३<br><br>कल्पना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಷಯದ ನಿಜಾಂಶವು ಹೀಗಿರಬಹುದೆಂದು ಮಾಡುವ ಊಹೆ<br><br>कल्पना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಿದ್ಧಿ /ಕೈಗೂಡುವಿಕೆ<br><b>प्रयोगाः - </b>"श्रद्धलुसङ्कल्पितकल्पनायां कल्पद्रुमस्याथ रथाङ्गपाणेः"<br><b>उल्लेखाः - </b>नैष० १०-६९<br><br>

कल्पनी
कल्पनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿ<br><br>

कल्पनीय
कल्पनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಚಿಸಲ್ಪಡಬೇಕಾದ<br><br>कल्पनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಚಿಸಲು ಶಕ್ಯವಾದ<br><br>कल्पनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಚಿಸಲು ಅರ್ಹವಾದ<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) + णिच् - "अनीयर्" (३-१-९६)<br><br>कल्पनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಜಾಂಶವು ಹೀಗಿರಬಹುದೆಂದು ಊಹಿಸಲ್ಪಡುವ<br><br>कल्पनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಹಿಸಲು ಶಕ್ಯವಾದ<br><br>कल्पनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಹಿಸಲು ಅರ್ಹವಾದ<br><br>

कल्पितव्य
कल्पितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>कल्पनीय ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) - "तव्यः" (३-१-९६)<br><br>

कल्पमान
कल्पमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಚನೆಯಾಗುತ್ತಿರುವ /ನಿರ್ಮಾಣವಾಗುತ್ತಿರುವ<br><br>कल्पमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮರ್ಥವಾಗುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) - "शानच्" (३-२-१२४)<br><br>कल्पमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಿದ್ಧವಾಗುತ್ತಿರುವ<br><b>प्रयोगाः - </b>"कालपाशनिगृहीतमरातिं कल्पमानमभवाय विवेद"<br><b>उल्लेखाः - </b>याद० २१-५५<br><br>

कल्पयत्
कल्पयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೃಷ್ಟಿಸುತ್ತಿರುವ /ನಿರ್ಮಿಸುತ್ತಿರುವ<br><br>कल्पयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಚಿಸುತ್ತಿರುವ /ಮಾಡುತ್ತಿರುವ<br><br>कल्पयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಂತಿಸುತ್ತಿರುವ /ಊಹಿಸುತ್ತಿರುವ /ಶಂಕಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) + णिच् - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"क्षणशयितविबुद्धाः कल्पयन्तः प्रयोगानुदधिमहति राज्ये काव्यवद्दुर्विगाहे"<br><b>उल्लेखाः - </b>माघ० ११-६<br><br>कल्पयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏರ್ಪಡಿಸುತ್ತಿರುವ /ಸಿದ್ಧಗೊಳಿಸುತ್ತಿರುವ<br><br>

कल्पयन्ती
कल्पयन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कल्पयत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कल्पयमान
कल्पयमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>कल्पयत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) + णिच् - "शानच्" (३-२-१२४)<br><br>

कल्पयितव्य
कल्पयितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>कल्पनीय ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) + णिच् - "तव्यः" (३-१-९६)<br><br>

कल्पलता
कल्पलता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कल्पतरु ಪದದ ಅರ್ಥ<br><b>व्युत्पत्तिः - </b>कल्पस्य सङ्कल्पविषयस्य साधनं लता<br><b>प्रयोगाः - </b>"क्व याचतां कल्पलतासि मां प्रति क्व दृष्टिदाने तव बद्धमुष्टिता"<br><b>उल्लेखाः - </b>नैष० ९-१०९<br><br>

कल्पवल्ली
कल्पवल्ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कल्पतरु ಪದದ ಅರ್ಥ<br><br>

कल्पविद्
कल्पविद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಜ್ಞಸಂಬಂಧವಾದ ವಿಧಿಗಳನ್ನು ಅರಿತಿರುವ /ವ್ರತಪ್ರಯೋಗಳನ್ನು ತಿಳಿದಿರುವ /ಶಾಸ್ತ್ರನಿಯಮಗಳನ್ನು ಅರಿತಿರುವ<br><b>निष्पत्तिः - </b>विद (ज्ञाने) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>कल्पं वेत्ति<br><b>प्रयोगाः - </b>"कल्पवित् कल्पयामास नियमापेक्षया मुनिः"<br><b>उल्लेखाः - </b>रघु० १-९४<br><br>

कल्पसूत्र
कल्पसूत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೈದಿಕ ಕರ್ಮಾಚರಣೆಯನ್ನು ಹೇಳುವ ಸೂತ್ರ<br><b>व्युत्पत्तिः - </b>कल्पस्य वैदिककर्मानुष्ठानस्य प्रतिपादकं सूत्रम्<br><br>

कल्पात्यय
कल्पात्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಪಕಾಲದ ಕೊನೆ /ಜಗತ್ತಿನ ಪ್ರಳಯಕಾಲ<br><b>व्युत्पत्तिः - </b>कल्पस्यत्ययः<br><b>प्रयोगाः - </b>"रथादिघोषैरथ शार्ङ्गपाणेः कल्पात्ययैकार्णवनादकल्पैः"<br><b>उल्लेखाः - </b>याद० २०-९<br><br>

कल्पान्त
कल्पान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಪಕಾಲದ ಕೊನೆ /ಜಗತ್ತಿನ ಪ್ರಳಯಕಾಲ /ಬ್ರಹ್ಮನ ಹಗಲಿನ ಕೊನೆ<br><b>व्युत्पत्तिः - </b>कल्पस्यान्तः<br><br>

कल्पित
कल्पित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಚಿಸಲ್ಪಟ್ಟ /ನಿರ್ಮಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) + णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"भैमीविनोदाय मुदा सखीभिस्तदाकृतीनां भुवि कल्पितानाम्"<br><b>उल्लेखाः - </b>नैष० ६-७४<br><br>कल्पित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏರ್ಪಡಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"मुदितयुवमनस्कास्तुल्यमेव प्रदोषे रुचमदधुरुभय्यः कल्पिता भूषिताश्च"<br><b>उल्लेखाः - </b>माघ० ११-२७<br><br>कल्पित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"आक्रीडपर्वतास्तेन कल्पिताः स्वेषु वेश्मसु"<br><b>उल्लेखाः - </b>कुमा० २-४३<br><br>कल्पित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಿದ್ಧಪಡಿಸಲ್ಪಟ್ಟ /ಸಜ್ಜುಗೊಳಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"प्रजापतिः कल्पितयज्ञभागं शैलाधिपत्यं स्वयमन्वतिष्ठत्" । "स्पर्शभाजि विशदच्छविचारौ कल्पिते मृगदृशां सुरताय" ।<br><b>उल्लेखाः - </b>कुमा० १-१७, माघ० १०-३९<br><br>कल्पित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಹಿಸಲ್ಪಟ್ಟ /ತರ್ಕಿಸಲ್ಪಟ್ಟ<br><br>कल्पित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಚರಿಸಲ್ಪಟ್ಟ /ಅನುಷ್ಠಿಸಲ್ಪಟ್ಟ<br><br>कल्पित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಿಗಣಿಸಲ್ಪಟ್ಟ /ಭಾವಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"स्वक्षेत्रे संस्कृतायां तु स्वयमुत्पादयेद्धि यम् । तमौरसं विजानीयात्पुत्रं प्रथमकल्पितम् ॥"<br><b>उल्लेखाः - </b>मनु० ९-१६६<br><br>

कल्पित
कल्पित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃತ್ರಿಮವಾದ /ಸ್ಪಷ್ಟವಾದ /ವಾಸ್ತವವಲ್ಲದ<br><br>

कल्पिन्
कल्पिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಪಿತ /ಕ್ಷೌರಿಕ /ನಾಯಿಂದ<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) + णिच् - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कल्पयति<br><br>कल्पिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿರ್ಮಿಸುವ<br><br>कल्पिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡುವ<br><br>कल्पिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಹತ್ತಿಸುವ /ಏರಿಸುವ<br><br>कल्पिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವೇಷ ಹಾಕುವ<br><br>

कल्प्य
कल्प्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಚಿಸಲ್ಪಡುವ /ನಿರ್ಮಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) + णिच् - "यत्" (३-१-९७)<br><br>कल्प्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಏರಿಸಲ್ಪಡುವ /ಹತ್ತಿಸಲ್ಪಡುವ<br><br>कल्प्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೃಷ್ಟಿಸಲ್ಪಡುವ /ಹೊಸದಾಗಿ ಮಾಡಲ್ಪಡುವ<br><br>कल्प्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏರ್ಪಡಿಸಲ್ಪಡುವ<br><br>कल्प्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಿದ್ಧಪಡಿಸಲ್ಪಡುವ /ಸಜ್ಜುಗೊಳಿಸಲ್ಪಡುವ<br><b>प्रयोगाः - </b>"आनन्दबाष्पैरपि कल्प्यमम्भः पृच्छा विधेया मधुभिर्वचोभिः" । "कालोपपन्नातिथिकल्प्यभागं वन्यं शरीरस्थितिसाधनं वः" ।<br><b>उल्लेखाः - </b>नैष० ७-२१, रघु० ५-९<br><br>कल्प्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಷ್ಠಿಸಲ್ಪಡುವ /ಆಚರಿಸಲ್ಪಡುವ<br><br>कल्प्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಹಿಸಲ್ಪಡುವ /ಶಂಕಿಸಲ್ಪಡುವ<br><br>कल्प्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರಿಗಣಿಸಲ್ಪಡುವ /ಭಾವಿಸಲ್ಪಡುವ<br><br>

कल्प्यमान
कल्प्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಚಿಸಲ್ಪಡುತ್ತಿರುವ /ನಿರ್ಮಿಸಲ್ಪಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) + कर्म० "यक्" (३-१-६७) । "शानच्" (३-२-१२४)<br><br>कल्प्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಲ್ಪಡುತ್ತಿರುವ<br><br>कल्प्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏರ್ಪಡಿಸಲ್ಪಡುತ್ತಿರುವ<br><br>कल्प्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಊಹಿಸಲ್ಪಡುತ್ತಿರುವ<br><br>कल्प्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಜ್ಜುಗೊಳಿಸಲ್ಪಡುತ್ತಿರುವ<br><b>प्रयोगाः - </b>"कल्प्यमानममुनाचमनार्थं गाङ्गमम्बु चुलकोदरचुम्बि"<br><b>उल्लेखाः - </b>नैष० २१-१०<br><br>

कल्मष
कल्मष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನರಕ<br><b>निष्पत्तिः - </b>षो (अन्तकर्मणि) - "कः" (३-२-३० । पृषो० । लत्वषत्वे ।<br><b>व्युत्पत्तिः - </b>कर्म शुभकर्म स्यति<br><br>कल्मष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><b>प्रयोगाः - </b>"स हि गगनविहारी कल्मषध्वंसकारी दशशतकरधारी ज्योतिषां मध्यचारी"<br><b>उल्लेखाः - </b>हितो० २-२१<br><b>विस्तारः - </b>"कल्प्मषं किल्बिषे क्लीबं पुंसि स्यान्नरकान्तरे" - मेदि० ।<br><br>कल्मष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಶ್ಮಲ /ಕೊಳೆ<br><br>कल्मष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಸಿ /ಗಷ್ಟು /ಮಲ<br><br>कल्मष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧೂಳು<br><br>कल्मष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪವಾದ /ಅಪಕೀರ್ತಿ<br><br>कल्मष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಮಷಮಾಸ /ಮಲಮಾಸ<br><br>कल्मष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೊಳೆಯಿಂದ ಕೂಡಿದ /ಮಲಿನವಾದ<br><br>कल्मष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪಿಷ್ಠ<br><br>कल्मष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪವಾದದಿಂದ ಕೂಡಿದವನು<br><br>

कल्माष
कल्माष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರವರ್ಣ<br><b>निष्पत्तिः - </b>कल (सङ्ख्याने) - "क्विप्" (३-२-१७२) । मष (हिंसायाम्) + णिच् - "अच्" (३-१-३४)<br><b>व्युत्पत्तिः - </b>कलयति कलः । माषयति हिंसयति वर्णान् । कल् चसौ माषश्च ।<br><br>कल्माष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣವರ್ಣ<br><br>कल्माष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಬಿಳುಪು ಬೆರೆತ ಬಣ್ಣ<br><br>कल्माष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಕ್ಷಸ<br><b>विस्तारः - </b>"कल्माषो राक्षसे कृष्णे शबलेऽपि" - हेम० ।<br><br>कल्माष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಒಂದು ರೂಪ<br><b>प्रयोगाः - </b>"अग्नीनां वासुदेवेन संसक्तानां महामृधे । ते जातवेदसः सर्वे कल्माषः कुसुमस्तथा । दहनः शोषणश्चैव पतनश्च महाबलः ।"<br><b>उल्लेखाः - </b>हरिवं०<br><br>कल्माष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರವರ್ಣದ<br><br>कल्माष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಬಿಳುಪು ಬೆರೆತ ಬಣ್ಣದಿಂದ ಕೂಡಿದ<br><br>

कल्माषी
कल्माषी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಮದಗ್ನಿಯ ಹಸು<br><br>कल्माषी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರವರ್ಣದ ಹಸು<br><br>कल्माषी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಮುನಾ ನದಿ<br><b>निष्पत्तिः - </b>कल्माष - "ङीष्" (४-१-४०)<br><b>प्रयोगाः - </b>"प्रतिकर्तुं नृपश्रेष्ठो यतमानोऽपि भारत । अभितः सोऽथ कल्माषीं गङाकूले परिभ्रमन् ॥"<br><b>उल्लेखाः - </b>भा० आदि०<br><br>

कल्माषकण्ठ
कल्माषकण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ /ನೀಲಕಂಠ<br><b>व्युत्पत्तिः - </b>कल्माषः कृष्णः कण्ठो यस्य<br><br>

कल्माषग्रीव
कल्माषग्रीव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ /ನೀಲಕಂಠ<br><br>

कल्माषपाद
कल्माषपाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯವಂಶದ ಒಬ್ಬ ದೊರೆ<br><br>

कल्य
कल्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾತಃಕಾಲ<br><b>निष्पत्तिः - </b>कल (गतौ सङ्ख्याने च) - "यक्" (उ० ४-१११)<br><b>व्युत्पत्तिः - </b>कलयति चेष्टामत्र<br><b>प्रयोगाः - </b>"अनुनयमगृहीत्वा व्याजसुप्ता पराची रुतमथ कृकवाकोस्तारमाकर्ण्य कल्पे"<br><b>उल्लेखाः - </b>माघ० ११-९<br><br>कल्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜೇನುತುಪ್ಪ<br><br>कल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿವುಡ ಮತ್ತು ಮೂಗ /ಶ್ರೋತ್ರೇಂದ್ರಿಯ ಮತ್ತು ವಾಗಿಂದ್ರಿಯಗಳಿಲ್ಲದವನು /ಕೇಳುವ ಮತ್ತು ಮಾತಾಡುವ ಶಕ್ತಿಯಿಲ್ಲದವನು<br><br>कल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮರ್ಥನಾದ /ದಕ್ಷನಾದ<br><b>प्रयोगाः - </b>"कल्याणि कल्यानि तवाङ्गकानि कच्चित्तमां चित्तमनाविलं ते"<br><b>उल्लेखाः - </b>नैष० ८-५७<br><br>कल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಿದ್ಧವಾಗಿರುವ<br><b>प्रयोगाः - </b>"कथयस्व कथामेतां कल्याः स्म श्रवणे तव"<br><b>उल्लेखाः - </b>भा० आदि० ५-३<br><br>कल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೋಗವಿಲ್ಲದವನು /ಆರೋಗ್ಯದಿಂದಿರುವವನು<br><br>कल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಂಗಳವಚನವನ್ನಾಡುವ /ಒಳ್ಳೆಯ ಮಾತನ್ನಾಡುವ<br><br>कल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಾಯದ ಮಾಟನ್ನಾಡುವ<br><br>

कल्या
कल्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ /ಹೆಂಡ<br><br>कल्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶುಭವಚನ /ಮಂಗಳವಚನ<br><b>विस्तारः - </b>"कल्यं प्रभाते मधुनि सज्जे दक्षे निरामये । कल्या कल्याणवाचि स्यात्" - हेम० । "कल्पं प्रभाते क्लीबं स्यात् कल्यो वाक्श्रुतिवर्जिते । सज्जनीरोगदक्षेषु कल्याणवचनेऽपि च । उपायवचनेऽपि स्यात् त्रिषु मद्ये तु योषिति" - मेदि० । स्यात् कल्या तु शुभात्मिका" - अम० ।<br><br>

कल्यजग्धि
कल्यजग्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾತಃಕಾಲದ ಊಟ<br><br>

कल्यता
कल्यता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆರೋಗ್ಯಪಡೆಯುವಿಕೆ /ರೋಗದಿಂದ ಚೇತರಿಸಿಕೊಳ್ಳುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कल्यस्य भावः<br><br>

कल्यत्व
कल्यत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆರೋಗ್ಯಪಡೆಯುವಿಕೆ /ರೋಗದಿಂದ ಚೇತರಿಸಿಕೊಳ್ಳುವಿಕೆ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

कल्यवर्त
कल्यवर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾತಃಕಾಲದ ಊಟ<br><b>निष्पत्तिः - </b>वृतु (वर्तने) + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कल्ये प्रातर्वर्त्यते<br><br>

कल्याण
कल्याण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶುಭ /ಮಂಗಳ<br><b>निष्पत्तिः - </b>अण (शब्दे) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>कल्येप्रातः काले अण्यते<br><b>प्रयोगाः - </b>"कल्याणानां त्वमसि महसां भाजनं विश्वमूर्ते धुर्यां ल्ष्मीमिह मयि भृशं धेहि तव प्रसीद" । "सन्तुष्टो भार्यया भर्ता भर्त्रा भार्या तथैव च । यस्मिन्नेव कुले नित्यं कल्याणं तत्र वै ध्रुवम्"<br><b>उल्लेखाः - </b>मालती० १-५, मनु० ३-६०<br><br>कल्याण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುವರ್ಣ /ಚಿನ್ನ<br><br>कल्याण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಬ್ಬ /ಉತ್ಸವ<br><br>कल्याण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂತೋಷ<br><br>कल्याण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಗ<br><br>कल्याण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಳ್ಳೆಯ ಅದೃಷ್ಟ<br><br>कल्याण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಂಗಳಕರವಾದ /ಶುಭವಾದ<br><br>कल्याण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳ್ಳೆಯ ಅದೃಷ್ಟಶಾಲಿಯಾದ<br><br>कल्याण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷವುಳ್ಳ<br><br>कल्याण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುಣಶಾಲಿಯಾದ<br><br>

कल्याणी
कल्याणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कल्याण ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीष्" (४-१-४५)<br><b>प्रयोगाः - </b>"कल्याणी बत गाधेयं लौकिकी प्रतिभाति मे । एति जीवन्तमानन्दो नरं वर्षशतादपि ॥" "त्वमेव कल्याणि तयोस्तृतीया" । "उपोपविष्टः कल्याणीः कथाश्चक्रे मनोरमाः" ।<br><b>उल्लेखाः - </b>रामा०, रघु० ६-२९, भा० वन० १२५-३<br><br>कल्याणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಷಪರ್ಣಿ /ಕಾಡುದ್ದಿನ ಗಿಡ<br><br>कल्याणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೋವು /ಹಸು<br><br>कल्याणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪದದ ಅರ್ಥ<br><br>

कल्याणकर
कल्याणकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶುಭಕರವಾದ /ಮಂಗಳವನ್ನುಂಟುಮಾಡುವ<br><br>कल्याणकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶುಭಕಾರ್ಯವನ್ನು ಮಾಡುವ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>करोतीति करः । कल्याणस्य करः ।<br><br>

कल्याणकार
कल्याणकार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>कल्याणकर ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कल्याणं करोति<br><br>

कल्याणकारक
कल्याणकारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>कल्याणकर ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "ण्वुल्" (३-१-१३३)<br><b>प्रयोगाः - </b>"न निषेध्योऽल्पबाधस्तु सेतुः कल्याणकारकः"<br><b>उल्लेखाः - </b>याज्ञ० २-१५६<br><br>

कल्याणकृत्
कल्याणकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳ್ಳೆಯ ಕಾರ್ಯವನ್ನು ಮಾಡುವ /ಶುಭಕಾರ್ಯವನ್ನು ನಡೆಸುವ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "क्विप्" (३-२-६१)<br><b>प्रयोगाः - </b>"न हि कल्याणकृत् कश्चित् दुर्गतिं तात गच्छति"<br><b>उल्लेखाः - </b>गीता० ६-४०<br><br>

कल्याणधर्मन्
कल्याणधर्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳ್ಳೆಯ ಗುಣಶಾಲಿಯಾದ /ಧರ್ಮಶೀಲನಾದ<br><b>निष्पत्तिः - </b>"अनिच्" (५-४-१२४)<br><b>व्युत्पत्तिः - </b>कल्याणो धर्मोऽस्यास्ति<br><br>

कल्याणनगर
कल्याणनगर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಗಳೂರು ನಗರ<br><br>

कल्याणमय
कल्याणमय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಂಗಳಪ್ರಚುರವಾದ /ಶುಭವಿಷಯಗಳಿಂದ ತುಂಬಿದ<br><br>

कल्याणमित्र
कल्याणमित्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಳ್ಳೆಯ ಸ್ನೇಹಿತ /ಗುಣಶಾಲಿಯಾದ ಗೆಳೆಯ<br><br>

कल्याणयोग
कल्याणयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಷದಲ್ಲಿ ಯಾತ್ರಾಲಗ್ನದಿಂದ ಶುಭಸ್ಥಾನದಲ್ಲಿ ಗ್ರಹಗಳು ಸೇರುವ ಒಂದು ಯೋಗ<br><b>प्रयोगाः - </b>"गुरौ केन्द्रे त्रिकोणे वा रविर्लाभे च कर्मणि । कल्याणयोगो भूपस्य यातुः कल्याणकृद्भवेत् ॥"<br><br>

कल्याणवत्
कल्याणवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶುಭವುಳ್ಳ /ಮಂಗಳವುಳ್ಳ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>कल्याणमस्यास्ति<br><br>कल्याणवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಾಗ್ಯಶಾಲಿ<br><br>कल्याणवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷವುಳ್ಳವನು<br><br>

कल्याणवती
कल्याणवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कल्याणवत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कल्याणवचन
कल्याणवचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶುಭವಾಕ್ಯ /ಮಂಗಳಕರವಾದ ಮಾತು<br><br>कल्याणवचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣರಿಂದ ಮಂಗಳಕರವಾದ ಮಂತ್ರಗಳನ್ನು ಹೇಳಿಸುವುದು /ಶುಭಕಾರ್ಯವನ್ನು ಪ್ರಾರಂಭಿಸುವ ಮೊದಲು ಬ್ರಾಹ್ಮಣರ ಮೂಲಕ ಮಾಡಿಸುವ ಸ್ವಸ್ತಿವಾಚನ<br><br>

कल्याणिका
कल्याणिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೆಣಶಿಲೆ<br><b>निष्पत्तिः - </b>कल्याण - सञ्ज्ञायां "कन्" । अत इत्वम् ।<br><br>

कल्याणिन्
कल्याणिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂತೋಷವುಳ್ಳ<br><br>कल्याणिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶುಭವುಳ್ಳ /ಮಂಗಳವುಳ್ಳ<br><br>कल्याणिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಾಗ್ಯವುಳ್ಳವನು /ಅದೃಷ್ಟಶಾಲಿ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कल्याणमस्यास्ति<br><br>

कल्याणिनी
कल्याणिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कल्याणिन् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कल्यापाल
कल्यापाल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮದ್ಯವನ್ನು ತಯಾರಿಸುವವನು /ಭಟ್ಟಿ ಇಳಿಸುವವನು<br><b>निष्पत्तिः - </b>पाल (रक्षणे)- "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कल्यां सुरां पालयति<br><br>

कल्यापालक
कल्यापालक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮದ್ಯವನ್ನು ತಯಾರಿಸುವವನು /ಭಟ್ಟಿ ಇಳಿಸುವವನು<br><b>निष्पत्तिः - </b>"ण्वुल्" (३-१-१३३)<br><br>

कल्ल
कल्ल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಧಿರ /ಕಿವುಡ<br><b>निष्पत्तिः - </b>कल्ल (अव्यक्ते शब्दे) - "अच्" (३-१-१३४)<br><b>विस्तारः - </b>"कल्लो बधिरः खोरखञ्जकौ" - त्रिकाण्ड० ।<br><br>

कल्लता
कल्लता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವುಡು /ಕಿವಿಯು ಕೇಳಿಸದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कल्लस्य भावः<br><br>

कल्लत्व
कल्लत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿವುಡು /ಕಿವಿಯು ಕೇಳಿಸದಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

कल्लमूक
कल्लमूक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿವುಡ ಮತ್ತು ಮೂಗ /ಶ್ರೋತ್ರೇಂದ್ರಿಯ ಮತ್ತು ವಾಗಿಂದ್ರಿಯಗಳಿಲ್ಲದವನು /ಕೇಳುವ ಮತ್ತು ಮಾತಾಡುವ ಶಕ್ತಿಯಿಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>कल्लसश्चासौ मूकश्च<br><br>

कल्लोल
कल्लोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಲೆ /ತರಂಗ /ತೆರೆ<br><b>निष्पत्तिः - </b>कल्ल (अव्यक्ते शब्दे) - बाहु० "कोलच्"<br><b>व्युत्पत्तिः - </b>कल्लन्तेऽनेन नद्यः<br><b>प्रयोगाः - </b>"आयुः कल्लोललोलं कतिपयदिवसस्थायिनी यौवनश्रीः"<br><b>उल्लेखाः - </b>भर्तृ० ३-३६<br><br>कल्लोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹರ್ಷ /ಸಂತೋಷ<br><br>कल्लोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರು /ವೈರಿ /ಹಗೆ<br><b>विस्तारः - </b>"कल्लोलः पुंसि हर्षे स्यात् उल्लोलवैरिणोरपि" - मेदि० ।<br><br>

कल्लोलित
कल्लोलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲೆಯುಂಟಾಗಿರುವ /ತೆರೆಯೆದ್ದಿರುವ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>कल्लोलोऽस्य सञ्जातः<br><br>

कल्लोलिनी
कल्लोलिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲೆಗಳಿಂದ ಕೂಡಿದ ಪ್ರದೇಶ /ನದಿ /ಹೊಳೆ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कल्लोलाः सन्त्यस्याम्<br><br>

कव
कव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದ /ಧ್ವನಿ<br><b>निष्पत्तिः - </b>कु (शब्दे) - भावे "अप्" (३-३-५७)<br><br>

कवक
कवक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಾಸ /ಕಬಳ /ತುತ್ತು<br><br>कवक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಯಿಕೊಡೆ<br><b>प्रयोगाः - </b>"लशुनं गृञ्जनं चैव पलाण्डुं कवकानि च । अभक्ष्याणि द्विजतीनाममेध्यप्रभवाणि च ॥"<br><b>उल्लेखाः - </b>मनु० ५-५<br><br>

कवच
कवच<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕವಚ /ಅಂಗಿ<br><b>निष्पत्तिः - </b>वञ्चु (प्रलम्भने) - "कः" (वा० ३-२-५)<br><b>व्युत्पत्तिः - </b>कं वातं वञ्चति<br><b>प्रयोगाः - </b>"निर्दयं खड्गभिन्नेभ्यः कवचेभ्यः समुत्थितः । आसन् व्योम दिशस्तूलैः पलितैरिव पाण्डुराः ॥"<br><b>उल्लेखाः - </b>कुमा० १६-६<br><br>कवच<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಟಹ /ತಮಟೆ<br><br>कवच<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಸುರಿ ಮರ<br><b>विस्तारः - </b>"कवचो गर्दभाण्डे च सन्नाहे पटहेऽपि च" - मेदि० ।<br><br>

कवचहर
कवचहर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕವಚವನ್ನು ಧರಿಸುವ ಮತ್ತು ಒಯ್ಯುವ ವಯಸ್ಸುಳ್ಳ ಹುಡುಗ<br><b>निष्पत्तिः - </b>हृञ् (हरणे) - "अच्" (३-२-१०)<br><b>व्युत्पत्तिः - </b>कवचं हरति<br><b>विस्तारः - </b>"कवचहरः कुमारः" - सि० कौ०<br><br>

कवचित
कवचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂಗಿಯಿಂದ ಆವೃತವಾದ /ಅಂಗಿ ತೊಟ್ಟಿರುವ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>कवचोऽस्य सञ्जातः<br><br>कवचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಲ್ಪಟ್ಟ<br><br>

कवचिन्
कवचिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕವಚವನ್ನು ಧರಿಸಿರುವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कवचमस्यास्ति<br><br>

कवचिनी
कवचिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕವಚವನ್ನು ಧರಿಸಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कवटी
कवटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕವಾಟ /ಕದ /ಬಾಗಿಲು<br><b>निष्पत्तिः - </b>कु (शब्दे) - "अटन्" (उ० ४-७१) । गौरा० "ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>कौति शब्दायते<br><br>

कवयितृ
कवयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕವಿ /ಕಾವ್ಯ ರಚಿಸುವವನು<br><b>निष्पत्तिः - </b>कवृ (वर्णने) + णिच् - 'तृच्" (३-१-१३३)<br><br>कवयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕವಿಯಂತೆ ನಟಿಸುವವನು<br><b>निष्पत्तिः - </b>कवृ (वर्णने) + णिच् - "क्विप्" 'तृच्" (३-१-१३३)<br><br>

कवयित्री
कवयित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कवयितृ ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कवर
कवर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಾಧ್ಯಾಯ /ಪಾಠ ಹೇಳುವವನು<br><b>निष्पत्तिः - </b>कु (शब्दे) - "अरन्" (उ० ४-१५४)<br><br>कवर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲವಣ /ಉಪ್ಪು<br><br>कवर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹುಳಿ<br><br>कवर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರವರ್ಣದ /ನಾನಾ ಬಣ್ಣದ<br><br>

कबरा
कबरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कवर ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>वबयोरभेदः ।<br><b>प्रयोगाः - </b>"व्याकीर्णमाल्यकबरां कबरीं तरुण्याः"<br><b>उल्लेखाः - </b>माघ० ५-१९<br><br>

कवरी
कवरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಶಪಾಶ /ಹೆಂಗಸರ ಜಡೆ<br><b>प्रयोगाः - </b>"व्याकीर्णमाल्यकबरां कबरीं तरुण्याः"<br><b>उल्लेखाः - </b>माघ० ५-१९<br><b>विस्तारः - </b>"कबरी केशानां सन्निवेशश्चेत् । कबराऽन्या" - सि० कौ०<br><br>

कवभार
कवभार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತಮವಾದ ಜಡೆ /ಚೆನ್ನಾಗಿ ಬೆಳೆದು ಉದ್ದವಾಗಿರುವ ಹೆಂಗಸರ ವೇಣಿ<br><b>प्रयोगाः - </b>"अमरीकबरीभारभ्रमरीमुखरीकृतम् । दूरीकरोतु दुरितं गौरीचरणपङ्कजम्"<br><b>उल्लेखाः - </b>कुव०<br><br>

कवर्ग
कवर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ ಖ ಗ ಘ ಙ ವರ್ಣಗಳ ಗುಂಪು<br><b>प्रयोगाः - </b>"अकुहविसर्जनीयानां कण्ठः"<br><b>उल्लेखाः - </b>सि० कौ०<br><br>

कवल
कवल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಾಸ /ತುತ್ತು /ಬಾಯಿ ತುಂಬುವಷ್ಟು ಆಹಾರ<br><b>निष्पत्तिः - </b>वल (सञ्चलने) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>केन जलेन वलते<br><b>प्रयोगाः - </b>"आस्वादयद्भिः कवलैस्तृणानां कण्डूयनैर्दंशनिवारणैश्च"<br><b>उल्लेखाः - </b>रघु० २-५<br><br>कवल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ಸ್ಯ /ಮೀನು<br><b>निष्पत्तिः - </b>वल - "अच्"<br><b>व्युत्पत्तिः - </b>के जले वलति<br><br>कवल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಲಿಗೆ ಮತ್ತು ಹಲ್ಲುಗಳ ಮಲನಿವಾರಣೆಗಾಗಿ ಬಾಯಿ ಶುದ್ಧವಾಗಲು ಮಾಡುವ ಗಂಡೂಷ /ಬಾಯಿ ಮುಕ್ಕಳಿಸುವ ದ್ರವ್ಯವಸ್ತು<br><b>प्रयोगाः - </b>"दोषप्रच्यवनार्थाय रुजादाहक्षयाय च । जिह्वादन्तसमुत्थस्य हरणार्थं मलस्य च । शोधनो रोपणश्चैव व्रणस्य मुखजनस्य वै । उष्णो वा यदि वा शीतः कवलग्राह इष्यते"<br><b>उल्लेखाः - </b>सुश्रुत० चिकित्सा० १-१२७, १२८<br><br>

कवलन
कवलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನುಂಗುವಿಕೆ /ಕಬಳಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>"णिच्" (ग० ७-४-९७) । भावे "ल्युट्" (३-३-११५)<br><b>व्युत्पत्तिः - </b>कवल तत्करोति<br><br>

कवलिता
कवलिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ರಣಚಿಕಿತ್ಸೆಗಾಗಿ ಹಾಕುವ ಬಟ್ಟೆಯ ಕಟ್ಟು /ಪಕ್ಕೆಗಳ ಎಲುಬು ಮುರಿದರೆ ಕಟ್ಟುವ ಬಟ್ಟೆಯ ಕಟ್ಟು<br><b>प्रयोगाः - </b>"पर्शुकास्वथ भग्नासु घृताभ्यक्तस्य तिष्ठतः । दक्षिणास्वथवा वामास्वनुमृज्य निबन्धनीः । ततः कवलिकां दत्त्वा वेष्टयेत्सुसमाहितः । तैलपूर्णे कटाहे वा द्रोण्यां वा शाययेन्नरम् ॥"<br><b>उल्लेखाः - </b>सुश्रुत० चिकित्सा० ३-२९, ३०<br><br>

कवलित
कवलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿನ್ನಲ್ಪಟ್ಟ /ನುಂಗಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कवल + तत्करोति + णिच् - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>कवलं करोति<br><br>

कवाट
कवाट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಗಿಲಿನ ಕದ /ದ್ವಾರದ ಗರಿ<br><b>निष्पत्तिः - </b>कु (शब्दे) - भावे "अप्" (३-३-५७) । "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कवं शब्दमटति<br><b>प्रयोगाः - </b>"उरःश्रिया तत्र च गोपुरस्फुरत्कवाटदुर्धर्षतिरःप्रसारिता"<br><b>उल्लेखाः - </b>नैष० १-२२<br><br>

कवाटघ्न
कवाटघ्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೋರ /ತಸ್ಕರ /ಕಳ್ಳ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः)- "टक्" (३-२-५४)<br><b>व्युत्पत्तिः - </b>कवाटं हन्ति<br><b>विस्तारः - </b>"कवाटघ्नश्चोरः" - सि० कौ० ।<br><br>

कवार
कवार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪದ್ಮ /ಕಮಲ<br><b>निष्पत्तिः - </b>वृञ् (वरणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कं जलं वृणोति<br><b>विस्तारः - </b>"पद्मे कवारं पङ्केजम्" - त्रिकाण्ड० ।<br><br>

कवि
कवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮ /ಕ್ರಾಂತಿದರ್ಶಿ /ಅತೀಂದ್ರಿಯ ವಸ್ತುವನ್ನು ನೋಡುವ ಶಕ್ತಿಯುಳ್ಳ ಪರಮಾತ್ಮ<br><b>प्रयोगाः - </b>"कविं पुराणमनुशासितारमणोरणीयांसमनुस्मरेद्यः । सर्वस्य धातारमचिन्त्यरूपमादित्यवर्णं तमसः परस्तात्"<br><b>उल्लेखाः - </b>गीता० ८-९<br><br>कवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮನ ಹೃದಯದಿಂದ ಜನಿಸಿದ ಭೃಗುಋಷಿಯ ಮಗ /ಶುಕ್ರಾಚಾರ್ಯರ ತಂದೆ<br><br>कवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕವಿಯ ಮಗನಾದ ಶುಕ್ರಾಚಾರ್ಯ /ಅಸುರರ ಗುರು<br><b>निष्पत्तिः - </b>कु (शब्दे) - "इः" (उ० ४-१३८)<br><b>प्रयोगाः - </b>"ब्रह्मणो हृदयं भित्वा निःसृतोभगवान् भृगुः । भृगोः पुत्रः कविर्विद्वान् शुक्रः कविसुतो ग्रहः ॥"<br><b>उल्लेखाः - </b>भा० आदि० ६७<br><br>कवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾವ್ಯವನ್ನು ರಚಿಸುವವನು /ಕವಿತೆ ಮಾಡುವವನು /ವರ್ಣಿಸುವವನು<br><b>निष्पत्तिः - </b>कवृ (वर्णने) - "इः" (उ० ४-१३८)<br><b>प्रयोगाः - </b>"तेजः क्षमा वा नैकान्तं कालज्ञस्य महीपतेः । नैकमोजः प्रसादो वा रसभावविदः कवेः ॥" "मन्दः कवियशःप्रार्थी गमिष्याम्युपहास्यताम्"<br><b>उल्लेखाः - </b>माघ० २-८३, रघु० १-३<br><br>कवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಂಡಿತ /ವಿದ್ವಾಂಸ/ಬುದ್ಧಿವಂತ<br><b>प्रयोगाः - </b>"अध्यापयामास पितॄन् शिशुराङ्गिरसः कविः"<br><b>उल्लेखाः - </b>मनु० २-१५१<br><br>कवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಲ್ಮೀಕಿ ಮಹರ್ಷಿ<br><b>विस्तारः - </b>"कविर्वाल्मीकिशुक्रयोः । सूरौ काव्यकरे पुंसि स्यात्खलीने तु योषिति" - मेदि० ।<br><br>कवि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ತೋತ್ರ ಮಾಡುವವನು<br><br>कवि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ತುತಿಸಲ್ಪಡುವವನು<br><br>

कवि|कवी
कवि - वी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಗಾಮು /ಕಡಿವಾಣ<br><b>निष्पत्तिः - </b>वा "ङीष्" (ग० ४-१-४५)<br><br>

कविक
कविक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಗಾಮು /ಕಡಿವಾಣ<br><b>निष्पत्तिः - </b>कवि- स्वार्थे "कन्"<br><br>

कविका
कविका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಗಾಮು /ಕಡಿವಾಣ<br><b>निष्पत्तिः - </b>कु (शब्दे) - "इः" (उ० ४-१३८) । स्वार्थे "कन्"<br><b>व्युत्पत्तिः - </b>कवते<br><b>प्रयोगाः - </b>"सोत्सेधैः स्कन्धदेशैः खरतरकविकाकर्षणात्यर्थभुग्नैः"<br><b>उल्लेखाः - </b>मुद्रा० ४-७<br><br>

कविज्येष्ठ
कविज्येष्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಲ್ಮೀಕಿ<br><b>विस्तारः - </b>"प्राचेतसस्तु वाल्मीकिः कविज्येष्ठः कुशीवशः" -त्रिकाण्ड० ।<br><br>

कवितर
कवितर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಬ್ಬರು ಕವಿಗಳಲ್ಲಿ ಶ್ರೇಷ್ಠನಾದ ಒಬ್ಬ ಕವಿ<br><b>निष्पत्तिः - </b>"तरप्" (५-३-५७)<br><b>व्युत्पत्तिः - </b>अनयोः अतिशयेन कविः<br><br>

कवितम
कवितम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನೇಕ ಕವಿಗಳಲ್ಲಿ ಶ್ರೇಷ್ಠನಾದ ಒಬ್ಬ ಕವಿ<br><b>निष्पत्तिः - </b>"तम्प्" (५-३-५५)<br><b>व्युत्पत्तिः - </b>एतेषामतिशयेन कविः<br><br>

कविता
कविता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕವಿಯ ವ್ಯಾಪಾರ /ಗದ್ಯ ಅಥವಾ ಪದ್ಯರೂಪವಾದ ಕಾವ್ಯ ರಚಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कवेभावः कर्म वा<br><b>प्रयोगाः - </b>"व्रीडा चेत किमु भूषणैः सुकविता यद्यस्ति राज्येन किम्"<br><b>उल्लेखाः - </b>भर्तृ० १-१७<br><br>

कवित्व
कवित्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕವಿಯ ವ್ಯಾಪಾರ /ಗದ್ಯ ಅಥವಾ ಪದ್ಯರೂಪವಾದ ಕಾವ್ಯ ರಚಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><b>प्रयोगाः - </b>"कवित्वगानप्रियवादसत्यान्यस्या विधाता व्याधिताधिकण्ठम्"<br><b>उल्लेखाः - </b>नैष० ७-६७<br><br>

कवितार्किकसिंह
कवितार्किकसिंह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕವಿ ಮತ್ತು ತಾರ್ಕಿಕರಲ್ಲಿ ಶ್ರೇಷ್ಠನಾದ ಶ್ರೀನಿಗಮಾಂತದೇಶಿಕರು /ಶ್ರೇವೆಂಕಟನಾಥರು<br><b>व्युत्पत्तिः - </b>कविषु तार्किकेषु च सिंहः<br><br>

कविनन्दन
कविनन्दन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೃಗುಪುತ್ರನಾದ ಕವಿಯ ಮಗ /ಶುಕ್ರಾಚಾರ್ಯ<br><b>व्युत्पत्तिः - </b>कवेः नन्दनः<br><br>

कविपुत्र
कविपुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೃಗುಪುತ್ರನಾದ ಕವಿಯ ಮಗ /ಶುಕ್ರಾಚಾರ್ಯ<br><b>व्युत्पत्तिः - </b>कवेः पुत्रः<br><br>

कविसुत
कविसुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೃಗುಪುತ್ರನಾದ ಕವಿಯ ಮಗ /ಶುಕ್ರಾಚಾರ್ಯ<br><b>व्युत्पत्तिः - </b>कवेः सुतः<br><b>प्रयोगाः - </b>"भृगोः पुत्रः कविर्विद्वान् शुक्रः कविसुतो ग्रहः"<br><b>उल्लेखाः - </b>भा० आदि० ६७<br><br>

कविय
कविय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಗಾಮು /ಕಡಿವಾಣ<br><b>निष्पत्तिः - </b>कुङ् (शब्दे) - बाहु० "इयः" ।<br><b>विस्तारः - </b>"कवियं कविकोच्यते" - त्रिकाण्ड० ।<br><br>

कविराज
कविराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕವಿಶ್ರೇಷ್ಠ /ಉತ್ತಮನಾದ ಕವಿ<br><b>निष्पत्तिः - </b>"टच्" (५-४-९१)<br><b>व्युत्पत्तिः - </b>कवीनां राजा<br><b>प्रयोगाः - </b>"श्रीहर्षं कविराजराजिमुकुटालङ्कारहीनः सुतम्"<br><b>उल्लेखाः - </b>नैष० १-१४५<br><br>

कवोष्ण
कवोष्ण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಚ್ಚಗಿರುವಿಕೆ /ಸ್ವಲ್ಪ ಬಿಸಿ<br><b>निष्पत्तिः - </b>कोः वा कवादेशः (६-३-१०७)<br><b>व्युत्पत्तिः - </b>ईषदुष्णम्<br><br>कवोष्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಬಿಸಿಯಾಗಿರುವ /ಬೆಚ್ಚಗಿರುವ<br><b>प्रयोगाः - </b>"पयः पूर्वैः स्वनिःश्वासैः कवोष्णमुपभुज्यते"<br><b>उल्लेखाः - </b>रघु० १-६७<br><br>

कवकोष्ण
कवकोष्ण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಚ್ಚಗಿರುವಿಕೆ /ಸ್ವಲ್ಪ ಬಿಸಿ<br><b>निष्पत्तिः - </b>पक्षे "कादेशः (६-३-१०४)<br><br>

कदुष्ण
कदुष्ण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಚ್ಚಗಿರುವಿಕೆ /ಸ್ವಲ್ಪ ಬಿಸಿ<br><b>निष्पत्तिः - </b>उभयाभावे "कत्" (६-३-१०१)<br><br>

कव्य
कव्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಿತೃದೇವತೆಗಳಿಗೆ ಯೋಗ್ಯವಾದ ಅನ್ನ /ಪಿತೃಗಳನ್ನು ಉದ್ದೇಶಿಸಿ ಕೊಡುವ ಅನ್ನ<br><b>निष्पत्तिः - </b>कु (शब्दे) - "यत्" (३-१-९७)<br><b>व्युत्पत्तिः - </b>कूयते पितृभ्यः<br><b>प्रयोगाः - </b>"श्रोत्रियायैव देयानि हव्यकव्यानि दातृभिः । अर्हत्तामाय विप्राय तस्मै दत्तं महाफलम् ॥"<br><b>उल्लेखाः - </b>मनु० ३-१२७<br><br>

कव्यभुज्
कव्यभुज्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಿತೃಗಳು ಅಥವಾ ಪಿತೃದೇವತೆಗಳ ಗಣ<br><b>निष्पत्तिः - </b>भुज (पालनाभ्यवहारयोः) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>कव्यं भुङ्क्ते<br><br>

कव्यवाह
कव्यवाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆಗಳಿಗೆ ಹವಿಸ್ಸನ್ನು ತಲುಪಿಸುವ ಅಗ್ನಿದೇವತೆ<br><b>निष्पत्तिः - </b>वह (प्रापणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कव्यं वहति<br><br>

कव्यवाहन
कव्यवाहन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆಗಳಿಗೆ ಹವಿಸ್ಸನ್ನು ತಲುಪಿಸುವ ಅಗ್ನಿದೇವತೆ<br><b>निष्पत्तिः - </b>"ञ्युट्" (३-२-६५)<br><br>

कशा
कशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತು ಕುದುರೆ ಮೊದಲಾದುವುಗಳನ್ನು ಹೊಡೆಯುವ ಚಾವಟಿ /ಬಾರುಗೋಲು<br><b>निष्पत्तिः - </b>कश (गतिशासनयोः)- "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कशति<br><b>प्रयोगाः - </b>"तेजोनिरोधसमताऽवहितेन यन्त्रा सम्यक्कशात्रयविचारवता नियुक्तः"<br><b>उल्लेखाः - </b>माघ० ५-१०<br><br>

कशार्ह
कशार्ह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಾವಟಿಯಿಂದ ಹೊಡೆಯಿಸಿಕೊಳ್ಳಲ್ಪಡುವ ದುಷ್ಟಕುದುರೆ /ಚಾವಟಿಯ ಏಟಿಗೆ ಅರ್ಹವಾದ ಕುದುರೆ<br><b>निष्पत्तिः - </b>अर्ह (पूजायाम्) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कशामर्हति<br><br>

कशिक
कशिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಕುಲ /ಮುಂಗುಸಿ<br><b>निष्पत्तिः - </b>बाहु० "इकः"<br><b>व्युत्पत्तिः - </b>कशति हिनस्ति सर्पम्<br><br>

कशिपु
कशिपु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನ<br><br>कशिपु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸ್ತ್ರ /ಬಟ್ಟೆ<br><b>निष्पत्तिः - </b>कश (गतिशासनयोः)- "कुः" (उ० १-३७)<br><b>व्युत्पत्तिः - </b>कशति दुःखम्<br><br>कशिपु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನ ಮತ್ತುವಸ್ತ್ರ<br><b>विस्तारः - </b>"कशिपुर्भक्ताच्छादनयोरेकोक्त्या पृथक् तयोः पुंसि"- मेदि० ।<br><br>कशिपु<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಯ್ಯೆ /ಹಾಸಿಗೆ<br><b>प्रयोगाः - </b>"क्लृप्तैः कशिपुभिः कान्तं पर्यङ्कव्यजनासनैः"<br><b>उल्लेखाः - </b>भाग० ३-२३-१६<br><b>विस्तारः - </b>"अस्त्री कशिपुशय्यायां वस्त्रेऽन्ने तद्द्वयेऽपि च" - नानार्थर०<br><br>

कशेरुक
कशेरुक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆನ್ನಿನ ಎಲುಬು /ಬೆನ್ನುಮೂಳೆ<br><br>

कशेरु|कशेरू
कशेरु (रू)<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆನ್ನಿನ ಎಲುಬು /ಬೆನ್ನುಮೂಳೆ<br><b>निष्पत्तिः - </b>शृ (हिंसायाम्) - "ऊः" एरङादेशश्च (उ० १-८८)<br><b>व्युत्पत्तिः - </b>कं वायुं शृणाति<br><br>

कशरु
कशरु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆನ್ನಿನ ಎಲುಬು /ಬೆನ್ನುಮೂಳೆ<br><b>निष्पत्तिः - </b>बाहु० वा"उः"<br><br>

कशेरुका
कशेरुका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆನ್ನಿನ ಎಲುಬು /ಬೆನ್ನುಮೂಳೆ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><br>

कश्चन
कश्चन<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಾವನೋ ಒಬ್ಬ /ಒಬ್ಬ ಅನಿರ್ದಿಷ್ಟ ವ್ಯಕ್ತಿ<br><b>प्रयोगाः - </b>"धमघोषसुतेन कश्चन प्रतिशिष्टः प्रतिभानवानथ"<br><b>उल्लेखाः - </b>माघ० १६-१<br><br>

कश्मल
कश्मल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಳೆ<br><br>कश्मल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><br>कश्मल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಮೋಹ /ಬುದ್ಧಿಭ್ರಂಶ<br><b>निष्पत्तिः - </b>कश (गतिशासनयोः)- "कलः" मुट् च (उ० १-१०६)<br><b>प्रयोगाः - </b>"कुतस्त्वा कश्मलमिदं विषयेसमुपस्थितम्"<br><b>उल्लेखाः - </b>गीता० २-२<br><br>कश्मल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಲಿನವಾದ /ಕೊಳೆಯಾದ<br><br>

कश्मीर
कश्मीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶ್ಮೀರ ದೇಶ<br><b>निष्पत्तिः - </b>कश (गतिशासनयोः)- "ईरन्"मुट् च (उ० ४-३२)<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>कश्मीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶ್ಮೀರದೇಶ ನಿವಾಸಿಗಳು<br><br>कश्मीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶ್ಮೀರದೇಶದ ದೊರೆಗಳು<br><b>निष्पत्तिः - </b>"अञ्" (वा० ४-१-१६६) । अञो लुक् (२-४-६२)<br><b>व्युत्पत्तिः - </b>कश्मीराणां राजा<br><b>प्रयोगाः - </b>"शारदमठमारभ्य कुङ्कुमाद्रितटान्तकः । तावद् कश्मीरदेशः स्यात् पञ्चाशद्योजनात्मकः ॥"<br><br>

कश्मीरज
कश्मीरज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಸರಿ<br><br>कश्मीरज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಶ್ಮೀರದೇಶದಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><b>व्युत्पत्तिः - </b>कश्मीरे जायते<br><br>

कश्मीरजन्मा
कश्मीरजन्मा<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಕುಮಕೇಸರಿ<br><b>व्युत्पत्तिः - </b>कश्मीरे जन्म यस्य<br><br>

कश्य
कश्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ /ಹೆಂಡ<br><b>निष्पत्तिः - </b>कश (गतिशासनयोः)- बाहु० "यः" ।<br><b>व्युत्पत्तिः - </b>कशत्यनेन<br><br>कश्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವದ ಮಧ್ಯಭಾಗ /ಕುದುರೆಯ ಬೆನ್ನು<br><b>निष्पत्तिः - </b>"यः" (५-१-६६)<br><b>व्युत्पत्तिः - </b>कशामर्हति<br><br>कश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಾವಟಿಯ ಏಟಿಗೆ ಅರ್ಹವಾದ /ಚಾವಟಿಯಿಂದ ಹೊಡೆಯಲು ಅರ್ಹವಾದ<br><b>विस्तारः - </b>"कश्यं त्रिषु कशार्हे स्यात् क्लीबं मद्याश्वमध्ययोः"- मेदि० ।<br><br>

कश्यप
कश्यप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮನ ಮಾನಸಪುತ್ರನಾದ ಮರೀಚಿಮಹರ್ಷಿಯ ಮಗ<br><b>निष्पत्तिः - </b>पा (पाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कश्यं पिबति<br><b>प्रयोगाः - </b>"ब्रह्मणस्तनयो योऽभूत् मरीचिरिति विश्रुतः । कश्यपस्तस्य पुत्रोऽभूत् कश्यपानात्स कश्यपः ॥"<br><b>उल्लेखाः - </b>मार्क०<br><br>कश्यप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಮೃಗ<br><br>कश्यप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ಸ್ಯ /ಮೀನು<br><br>कश्यप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಠ /ಆಮೆ<br><br>

कष|हिंसायाम्|कषति
कष - हिंसायाम् (भ्वा० पर० सक० से०) कषति<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸು /ಪೀಡಿಸು<br><br>

कष
कष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಣೆಕಲ್ಲು<br><br>कष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿನ್ನದ ಬಣ್ಣವನ್ನು ಪರೀಕ್ಷಿಸಲು ಉಪಯೋಗಿಸುವ ಒಂದು ಜಾತಿಯ ಕಲ್ಲು<br><b>निष्पत्तिः - </b>कष (हिंसायाम्) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कषति<br><br>कष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಜ್ಜುವ<br><br>कष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒರೆಹಚ್ಚುವ<br><br>कष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಳಿಸುವ<br><b>प्रयोगाः - </b>"छदहेम कषन्निवालसत् कषपाषाणनिभे नभस्तले"<br><b>उल्लेखाः - </b>नैष० २-६९<br><br>

कषण
कषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒರೆಹಚ್ಚುವುದು<br><br>कषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಜ್ಜುವುದು /ತಿಕ್ಕುವುದು<br><b>निष्पत्तिः - </b>कष (हिंसायाम्) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"कषणकम्पनिरस्तमहाहिभिः क्षणविमत्तमतङ्गजवर्जितैः"<br><b>उल्लेखाः - </b>किरा० ५-४७<br><br>

कषत्
कषत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಜ್ಜುತ್ತಿರುವ /ತಿಕ್ಕುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कष (हिंसायाम्) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"छदहेम कषन्निवालसत् कषपाषाणनिभे नभस्तले"<br><b>उल्लेखाः - </b>नैष० २-६९<br><br>

कषा
कषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಾವಟಿ /ಎತ್ತು ಕುದುರೆ ಮುಂತಾದುವನ್ನು ಹೊಡೆಯುವ ಬಾರುಗೋಲು<br><b>निष्पत्तिः - </b>कष (हिंसायाम्) - कर० "अच्" बाहु० ।<br><b>व्युत्पत्तिः - </b>कष्यतेऽनया<br><br>

कषाकु
कषाकु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ<br><br>कषाकु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>कष (हिंसायाम्) - "काकुः" (उ० ३-७७)<br><br>

कषाय
कषाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಷಾಯರಸ /ಒಗರು ರಸ /ಆರು ಭೋಜ್ಯರಸಗಳಲ್ಲೊಂದು<br><b>निष्पत्तिः - </b>कष (हिंसायाम्) - "आयः" बाहु० ।<br><b>व्युत्पत्तिः - </b>कषति कण्ठम्<br><b>प्रयोगाः - </b>"यो वक्त्रं परिशोषयति जिह्वां स्तम्भयति कण्ठं बध्नाति हृदयं कर्षति पीडयति च स कषायः"<br><b>उल्लेखाः - </b>सुश्रुत० सूत्र० ४२-९<br><b>विस्तारः - </b>"तुवरस्तु कषायोऽस्त्री" - अम०<br><br>कषाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿರ್ಯಾಸ /ಮರದ ರಸ<br><b>प्रयोगाः - </b>"धृष्टो वटकषायेण अनुलिप्तः प्रियङ्गुणा । क्षीरेण षष्टिकान् भुक्त्वा सर्वपापैः प्रमुच्यते ॥"<br><b>उल्लेखाः - </b>भा० अनु०<br><br>कषाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಲೇಪನ<br><b>प्रयोगाः - </b>"कर्णार्पितो लोध्रकषायरूक्षे गोरोचनाक्षेपनितान्तगौरे"<br><b>उल्लेखाः - </b>कुमा० ७-१७<br><br>कषाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗರಾಗ /ಮೈಗೆ ಸುವಾಸನೆಯ ಪುಡಿಯನ್ನು ಹಾಕುವಿಕೆ<br><br>कषाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಿಮಳ /ಸುವಾಸನೆ<br><br>कषाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುರಾಗ /ಪ್ರೇಮ<br><br>कषाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ವಾಥ /ಕಷಾಯ /ಔಷಧ ವಸ್ತುವಿನೊಡನೆ ಕುದಿಯಿಸಿ ಇಂಗಿಸಿದರಸ<br><br>कषाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ತ ವಿಕ್ಷೋಭ /ಮನಸ್ಸಿನ ಅಶಾಂತಿ<br><b>विस्तारः - </b>"रागे क्वाथे कषायोऽस्त्री निर्यासे सौरभे रसे" - वैज० ।<br><br>कषाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಪು<br><br>कषाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಗ ದ್ವೇಷ ಮೊದಲಾದ ದೋಷ<br><b>प्रयोगाः - </b>"आहारशुद्धौ सत्त्वशुद्धिः सत्त्वशुद्धौ ध्रुवा स्मृतिः । स्मृतिलम्भे सर्वग्रन्थीनां विप्रमोक्षस्तस्मै मृदितकषायाय तमसः पारं दर्शयति"<br><b>उल्लेखाः - </b>छान्दोग्य०<br><br>कषाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ಯೋನಾಕವೃಕ್ಷ /ಹೆಮ್ಮರ<br><br>कषाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲಿಯುಗ<br><br>कषाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಳದಿ ಮತ್ತು ಕೆಂಪು ಮಿಶ್ರಿತವಾದ ಬಣ್ಣ<br><br>कषाय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುವಾಸನೆಯಾಗಿರುವ /ಪರಿಮಳದಿಂದ ಕೂಡಿದ<br><b>प्रयोगाः - </b>"प्रत्यूषेषु स्फुटितकमलामोदमैत्रीकषायः"<br><b>उल्लेखाः - </b>मेघ० १-३१<br><br>कषाय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಂಪಾಗಿರುವ<br><b>प्रयोगाः - </b>"चूताङ्कुरास्वादकषायकण्ठं पुंस्कोकिलो यन्मधुरं चुकूज"<br><b>उल्लेखाः - </b>कुमा० ३-३२<br><br>कषाय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಟುವಾಗಿಲ್ಲದ /ಚುರುಕಾಗಿಲ್ಲದ<br><br>कषाय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಷಾಯರಸದಿಂದ ಕೂಡಿದ<br><br>कषाय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ತವಿಕ್ಷೋಭವುಳ್ಳ /ಅಶಾಂತಿಯುಳ್ಳ<br><br>कषाय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುರಾಗದಿಂದ ಕೂಡಿದ<br><br>

कषायवर्ग
कषायवर्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಷಾಯರಸವುಳ್ಳ ವಸ್ತುಗಳ ಗುಂಪು<br><br>

कषायित
कषायित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಣ್ಣ ಹಾಕಿರುವ<br><br>कषायित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಂಪಾಗಿರುವ /ಕೆಂಪಗೆ ಮಾಡಲ್ಪಟ್ಟಿರುವ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>कषायोऽस्य सञ्जातः<br><b>प्रयोगाः - </b>"प्रियमिति वनिता नितान्तमागःस्मरणसरोषकषायितायताक्षी"<br><b>उल्लेखाः - </b>माघ० ७-११<br><br>कषायित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಶಾಂತವಾದ /ಕ್ಷೋಭೆ ಹೊಂದಿದ<br><b>प्रयोगाः - </b>"घुसृणैर्यत्र कषायिताशया"<br><b>उल्लेखाः - </b>नैष० २-७७<br><br>

कषायिन्
कषायिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತಿಮರ /ಶಾಲವೃಕ್ಷ<br><br>कषायिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಖರ್ಜೂರದ ಮರ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कषायो निर्यासोऽस्त्यस्य<br><br>कषायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಂಪು ಬಣ್ಣದಿಂದ ಕೂಡಿದ<br><br>

कषि
कषि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸುವ /ಪೀಡಿಸುವ<br><b>निष्पत्तिः - </b>कष (हिंसायाम्) - "इन्" (उ० ४-११७)<br><br>

कषीका
कषीका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಪಕ್ಷಿ<br><b>निष्पत्तिः - </b>कष (हिंसायाम्) - "ईकन्" (उ० ४-१६)<br><br>

कष्ट
कष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸೆ /ಪೀಡೆ<br><br>कष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಥೆ /ದುಃಖ<br><b>निष्पत्तिः - </b>कष (हिंसायाम्) -"क्तः" (३-३-१७४)<br><b>प्रयोगाः - </b>"इन्दुरादिरजनिष्ट कलङ्की कष्टमत्र स भवानपि मा भूत्"<br><b>उल्लेखाः - </b>नैष० ५-११९<br><br>कष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುಃಖಕರವಾದ /ವ್ಯಥೆಯನ್ನು ಉಂಟುಮಾಡುವ<br><b>व्युत्पत्तिः - </b>कष्टो मोहः<br><br>कष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಸೆಯನ್ನು ಕೊಡುವ /ಪೀಡಿಸುವ<br><b>प्रयोगाः - </b>"बन्धनानि च कष्टानि परप्रत्यष्वमेव च"<br><b>उल्लेखाः - </b>मनु० १२-७८<br><br>कष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಷ್ಟಸಾಧ್ಯವಾದ<br><br>कष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಿಳಿಯಲು ಕಷ್ಟವಾದ<br><b>व्युत्पत्तिः - </b>कष्टं शास्त्रम्<br><br>

कष्टकर
कष्टकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೀಡಾಕರವಾದ /ಹಿಂಸೆಯನ್ನು ಉಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>कष्ट + डुकृञ् (करणे) - "टः" (३-२-२०)<br><br>कष्टकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಥೆಯನ್ನು ಉಂಟುಮಾಡುವ /ದುಃಖಕರವಾದ<br><br>

कष्टकार
कष्टकार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>कष्टकर ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>कष्ट + डुकृञ् (करणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कष्टं करोति<br><br>

कष्टतर
कष्टतर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎರಡರಲ್ಲಿ ಹೆಚ್ಚು ಕಷ್ಟವಾದ<br><b>निष्पत्तिः - </b>"तरप्" (५-३-५७)<br><b>व्युत्पत्तिः - </b>अतिशयेन कष्टम्<br><br>

कष्टतम
कष्टतम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನೇಕದರಲ್ಲಿ ಹೆಚ್ಚು ಕಷ್ಟವಾದ<br><b>निष्पत्तिः - </b>"तमप्" (५-३-५५)<br><br>

कष्टरिपु
कष्टरिपु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಷ್ಟಸಾಧ್ಯನಾದ ಶತ್ರು /ಜಯಿಸಲು ಕಷ್ಟವಾದ ಶತ್ರು<br><b>व्युत्पत्तिः - </b>कष्टो रिपुः<br><b>प्रयोगाः - </b>"प्राज्ञं कुलीनं शूरं च दक्षं दातारमेव च । कृतज्ञं धृतिमन्दं च कष्टमाहुररिं बुधाः ॥"<br><b>उल्लेखाः - </b>मनु० ७-२१०<br><br>

कस|गतौ|कसति
कस - गतौ (भ्वा० पर० सक० से०) कसति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೋಗು /ಚಲಿಸು /ನಡೆ<br><br>

निस् + कस|निष्कस|निष्कासः
निस् + कस = निष्कासः<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೊರಕ್ಕೆ ಅಟ್ಟು<br><br>

वि + कस|विकस|विकसति
वि + कस = विकसति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಿಸು<br><br>वि + कस = विकसति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅರಳು<br><b>प्रयोगाः - </b>"विकसति हि पतङ्गस्योदये पुण्डरीकं द्रवति व हिमरश्मावुद्गते चन्द्रकान्तः"<br><b>उल्लेखाः - </b>मालती० १-२७<br><br>

प्र + वि + कस|प्रविकस|प्रविकासः
प्र + वि + कस = प्रविकासः<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಪ್ರಕಾಶಿಸು<br><b>प्रयोगाः - </b>"प्रविकसति चिराय द्योतिताशेषलोके दशशतकरमूर्तावक्षिणीव द्वितीये"<br><b>उल्लेखाः - </b>माघ० ११-६३<br><br>

कस|शातने|कस्ते|कसाते
कस - शातने (अदा० आत्म० सक० से०) कस्ते-कसाते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಉಜ್ಜು /ತಿಕ್ಕು<br><br>

कस
कस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಣೆಕಲ್ಲು<br><b>निष्पत्तिः - </b>कस (शातने) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कस्ते<br><br>

कसन
कसन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಸರೋಗ<br><br>

कसना
कसना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜೇಡರಹುಳ<br><b>निष्पत्तिः - </b>कस (शातने) - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कस्ते हिनस्ति<br><b>प्रयोगाः - </b>"पिच्छिला कसनादंशात् रुधिरं शीतलं भवेत्"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

कस्तूरिका
कस्तूरिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಸ್ತೂರಿ /ಒಂದು ಮೃಗದ ಮದ /ಕಸ್ತೂರಿಮೃಗದ ಹೊಕ್ಕುಳಿನಲ್ಲಿ ಸಿಗುವ ಒಂದು ಸುಗಂಧದ್ರವ್ಯ<br><b>प्रयोगाः - </b>"सखीमुखायोत्सृजतीमपाङ्गात् कर्पूरकस्तूरिकयोः प्रवाहम्"<br><b>उल्लेखाः - </b>नैष० १०-१०२<br><br>

कस्तूरिकामृग
कस्तूरिकामृग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಸ್ತೂರಿ ಮೃಗ<br><b>प्रयोगाः - </b>"कस्तूरिकमृगविमर्दसुगन्धिरेति रागीव सक्तिमधिकां विषयेषु वायुः"<br><b>उल्लेखाः - </b>माघ० ४-६१<br><br>

कस्तूरी
कस्तूरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಸ್ತೂರಿ /ಒಂದು ಮೃಗದ ಮದ /ಕಸ್ತೂರಿಮೃಗದ ಹೊಕ್ಕುಳಿನಲ್ಲಿ ಸಿಗುವ ಒಂದು ಸುಗಂಧದ್ರವ್ಯ<br><b>निष्पत्तिः - </b>कस (गतौ) - "ऊरः" (उ० ४-९०)<br><b>व्युत्पत्तिः - </b>कसति गन्धोऽस्याः दूरतः<br><br>

कस्तूरिमृग
कस्तूरिमृग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಸ್ತೂರಿಯನ್ನು ಕೊಡುವ ಒಂದು ಮೃಗ<br><br>

कस्मल
कस्मल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಶ್ಮಲ /ಕೊಳೆ<br><br>कस्मल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><br>कस्मल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಮೋಹ /ಬುದ್ಧಿಭ್ರಂಶ<br><b>निष्पत्तिः - </b>कस (गतौ) - "कलः" मुट् च (उ० १-१०६)<br><br>

कस्वर
कस्वर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೋಗುವವನು /ನಡೆಯುವವನು<br><br>कस्वर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪೀಡಿಸುವವನು<br><b>निष्पत्तिः - </b>कस (गतौ शातने च) - "वरच्" (३-२-१७५)<br><br>

कहय
कहय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯನ ಕುದುರೆ<br><b>व्युत्पत्तिः - </b>कस्य सूर्यस्य हयः<br><br>

कहोड
कहोड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಋಷಿ /ಉದ್ದಾಲಕ ಋಷಿಯ ಶಿಷ್ಯ /ಅಷ್ಟಾವಕ್ರನ ತಂದೆ<br><b>प्रयोगाः - </b>"उद्दालकस्य नियतः शिष्य एको नाम्ना कहोडेति बभूव राजन्"<br><b>उल्लेखाः - </b>भा० वन० १३४-८<br><b>विस्तारः - </b>"डस्य वा लः" कहोलः ಎಂದೂ ಪ್ರಯೋಗವುಂಟು.<br><br>

कह्लार
कह्लार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆಗೆಂಪಿನ ಬಿಳಿನೈದಿಲೆ<br><b>निष्पत्तिः - </b>ह्लादी (सुखे च) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>के जले ह्लादते<br><b>प्रयोगाः - </b>"आह्लादिकह्लारसमीरणाहते पुरः पपाताम्भसि यामुने रजः"<br><b>उल्लेखाः - </b>माघ० १२-६६<br><br>

कह्व
कह्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः / स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಕಪಕ್ಷಿ<br><b>निष्पत्तिः - </b>ह्वेञ् (स्पर्धायां शब्दे च) - "कः" (वा० ३-२-५)<br><b>व्युत्पत्तिः - </b>के जले ह्वयति<br><br>

कांस
कांस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂಸದೇಶದ ಜನರು /ಕಂಸದೇಶದಲ್ಲಿರುವ /ಕಂಸದೇಶದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>"अञ्" (४-३-९३)<br><b>व्युत्पत्तिः - </b>कंसो देशः अभिजनोऽस्य<br><br>

कांसीकृत
कांसीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂಚಿನ ಪಾತ್ರೆಯಾಗಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"छः" (५-१-५) । "यञ्" । छस्य लुक् (४-३-१६८) । "च्विः" (५-४-५०) । यलोपः (६-४-१५२) । दीर्घः (७-४-२६)<br><b>व्युत्पत्तिः - </b>कंसाय हितम् । तस्य विकारः । अकांस्यं कांस्यं कृतम्<br><br>

कांस्य
कांस्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಚು /ತಾಮ್ರತವರಗಳಿಂದ ತಯಾರಾದ ಲೋಹ<br><b>निष्पत्तिः - </b>"छः" (५-१-५) । "यञ्" छलोपश्च (४-३-१६८) ।<br><b>व्युत्पत्तिः - </b>कंसाय पानपात्राय हितम् । तस्य विकारः ।<br><b>प्रयोगाः - </b>"ताम्रायःकांस्यरैत्यानां त्रपुणः सीसकस्य च । शौचं यथार्हं कर्तव्यं क्षाराम्लोदकवारिभिः ॥"<br><b>उल्लेखाः - </b>मनु० ५-११४<br><br>कांस्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಚಿನ ಜಾಗಟೆ<br><br>कांस्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಚಿನ ಕುಡಿಯುವ ಪಾತ್ರೆ<br><b>प्रयोगाः - </b>"कांस्यमुपहितसरोजपतद्भ्रमरौधभारगुरु राजयोषितः" । "न पादौ धावयेत् कांस्ये कदाचिदपि भाजने" ।<br><b>उल्लेखाः - </b>माघ० १५-८१, मनु० ४-६५<br><br>

कांस्यकार
कांस्यकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಚುಗಾರ /ಕಂಚಿನ ಪಾತ್ರೆ ತಯಾರಿಸುವವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कांस्यं तत्पात्रं करोति<br><br>

कांस्यताल
कांस्यताल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಚಿನ ಕೈತಾಳ /ಝಲ್ಲರಿ<br><br>

कांस्यभाजन
कांस्यभाजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಚಿನ ಪಾತ್ರೆ<br><br>

कांस्यमल
कांस्यमल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿಲುಬು /ಕಂಚಿನ ಮೇಲಿನ ಕೊಳೆ<br><br>

काक
काक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯಸ /ಕಾಗೆ<br><b>निष्पत्तिः - </b>कै (शब्दे) - "कन्" (उ० ३-४३)<br><b>व्युत्पत्तिः - </b>कायति<br><b>प्रयोगाः - </b>"वसन्तसमये प्राप्ते काकः काकः पिकः पिकः" । "यदेषसौधाग्रनटे पटाञ्चले चलेऽपि काकस्य पदार्पणग्रहः" । "ककोऽपि जीवति चिराय बलिं च भुङ्क्ते" ।<br><b>उल्लेखाः - </b>२)नैष० १२-२१, पञ्चतं०<br><br>काक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಕದ್ವೀಪ /ಕಾಕಗಳೇ ಪ್ರಧಾನವಾಗಿರುವ ಒಂದು ಭೂಭಾಗ<br><br>काक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಕಸ್ನಾನ /ತಲೆಯನ್ನು ಮಾತ್ರ ತೊಳೆದುಕೊಳ್ಳುವುದು<br><b>विस्तारः - </b>ನೀರಿನಲ್ಲಿ ಮುಳುಗಿ ಸ್ನಾನ ಮಾಡಲು ಹೆದರಿ ತಲೆಯನ್ನು ಮಾತ್ರ ನೀರಿನಲ್ಲಿ ಅದ್ದಿ ಮಾಡುವ ಸ್ನಾನವನ್ನು ಕಾಕಸ್ನಾನ ಎಂದು ಕರೆಯುವರು.<br><br>काक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆಗಳಸಮೂಹ<br><b>निष्पत्तिः - </b>"अण्" (४-२-३७)<br><b>व्युत्पत्तिः - </b>काकानां समूहः<br><br>काक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಸುರತಬಂಧ<br><br>काक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ನೀರು<br><b>निष्पत्तिः - </b>"कादेशः" (६-३-१०५)<br><b>व्युत्पत्तिः - </b>ईषत् कम् ईषज्जलम्<br><br>

काकगङ्गु
काकगङ्गु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆಗೆ ಪ್ರಿಯವಾದ ನವಣೆ<br><b>व्युत्पत्तिः - </b>काकप्रियः कङ्गुः<br><br>

काकगवेषण
काकगवेषण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯರ್ಥವಾದ ಮತ್ತು ಅಪ್ರಯೋಜಕವಾದ ಕೆಲಸ<br><br>

काकचिञ्चा
काकचिञ्चा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಲಗಂಜಿಯ ಬಳ್ಳಿ<br><b>व्युत्पत्तिः - </b>काकवर्णा चिञ्चा<br><br>

काकच्छद
काकच्छद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡಿಗೆ ಸೊಗಸಿನ ಹಕ್ಕಿ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><br>

काकण
काकण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಮಹಾಕುಷ್ಠರೋಗ<br><br>

काकतालीय
काकतालीय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನಿರೀಕ್ಷಿತವಾಗಿ ಸಂಭವಿಸಬಹುದಾದ ಕಾರ್ಯದ ಒಂದು ನ್ಯಾಯ /ಎದುರು ನೋಡದೆ ಅಕಸ್ಮಾತ್ತಾಗಿ ನಡೆಯುವ ಕಾರ್ಯದ ಬಗ್ಗೆ ಒಂದು ನ್ಯಾಯ<br><b>व्युत्पत्तिः - </b>काकागमनमिव तालपतनमिव काकतालम्<br><b>प्रयोगाः - </b>"यत्तया मेलनं तत्र लाभो मे यश्च तद्रतेः । तदेतत्काकतालीयमवितर्कितसम्भवम् ॥"<br><b>उल्लेखाः - </b>चन्द्रा०<br><br>काकतालीय<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಕಸ್ಮಾತ್ತಾಗಿ /ಅನಿರೀಕ್ಷಿತವಾಗಿ<br><b>प्रयोगाः - </b>"काकतालीयवत्प्राप्तं दृष्ट्वापि निधिमग्रतः । न स्वयं दैवमादत्ते पुरुषार्थमपेक्षते ॥"<br><b>उल्लेखाः - </b>हितो०<br><br>

काकतालुकिन्
काकतालुकिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧಮ /ನೀಚ<br><br>

काकतिन्दुक
काकतिन्दुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ ತೊಬರೆ ಗಿಡ<br><b>व्युत्पत्तिः - </b>काकप्रियः तिन्दुकः<br><br>

काकतुण्ड
काकतुण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲಾಗುರು /ಕೃಷ್ಣಾಗುರು<br><br>

काकध्वज
काकध्वज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಡಬಾಗ್ನಿ<br><b>व्युत्पत्तिः - </b>काकमीषज्जलं बाष्पं ध्वज इवास्य<br><br>

काकनासिका
काकनासिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ ತೊಂಡೆ ಗಿಡ<br><b>व्युत्पत्तिः - </b>काकस्य नासिकेव फलमस्याः<br><br>

काकनिद्रा
काकनिद्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲ್ಪನಿದ್ರೆ /ತೂಕಡಿಕೆ<br><br>

काकपक्ष
काकपक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜುಲ್ಪಿ ಕೂದಲು<br><b>व्युत्पत्तिः - </b>काकस्य पक्षः तदाकारोऽस्त्यस्य<br><br>काकपक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಲಕರ ಕಿವಿಯ ಪಕ್ಕದ ಗುಟ್ಟು /ತಲೆಯ ಪಕ್ಕದ ಕೂದಲು<br><b>प्रयोगाः - </b>"काकपक्षधरमेत्य याचितस्तेजसां हि न वयः समीक्ष्यते"<br><b>उल्लेखाः - </b>रघु० ११-१<br><br>

काकपद
काकपद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಸುರತಬಂಧ /ರತಿಕ್ರೀಡೆಯ ಬಂಧದ ಒಂದು ಭೇದ<br><b>प्रयोगाः - </b>"पादौ द्वौ स्कन्धमूलस्थौ क्षिप्त्वा लिङ्गं भगे लघु । कामयेत्कामुकीं कामी बन्धः काकपदो मतः ॥"<br><b>उल्लेखाः - </b>रतिम०<br><br>काकपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆಯ ಕಾಲಿನ ಹೆಜ್ಜೆಗೆ ಸಮಾನವಾದ ಅಳತೆ /ಕಾಗೆಯ ಕಾಲಿನಷ್ಟು ವಿಸ್ತಾರ<br><br>

काकपीलुक
काकपीलुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ ತೂಬರೆ ಗಿಡ<br><br>

काकपुष्ट
काकपुष्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ /ಕಾಗೆಯಿಂದ ಸಾಕಲ್ಪಟ್ಟ ಒಂದು ಹಕ್ಕಿ<br><b>व्युत्पत्तिः - </b>काकेन पुष्टः<br><br>

काकपेय
काकपेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಗೆಯು ಕುಡಿಯಬಹುದಾದಷ್ಟು ನೀರುಳ್ಳ /ಸ್ವಲ್ಪ ಅಥವಾ ತುಂಬಿದ ನೀರುಳ್ಳ<br><b>निष्पत्तिः - </b>पा (पाने) - "यत्" (३-१-९७)<br><b>व्युत्पत्तिः - </b>काकेन पीयते<br><b>प्रयोगाः - </b>"ककपेया नदी"<br><b>उल्लेखाः - </b>सि० कौ०<br><b>विस्तारः - </b>ಕಾಗೆಯು ಕುಡಿಯಬೇಕಾದರೆ ನೀರು ತುಂಬಿರಬೇಕು. ಇದರಿಂದ ಸ್ತುತಿಯೂ ಕೇವಲ ಕಾಗೆಯು ಕುಡಿಯುವಷ್ಟು ನೀರು ಎಂದು ನಿಂದೆಯೂ ತೋರುವುದು.<br><br>

काकफल
काकफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇವಿನ ಮರ<br><b>व्युत्पत्तिः - </b>काकप्रियं फलमस्य<br><b>विस्तारः - </b>ಬೇವಿನಹಣ್ಣು ಕಹಿಯಾಗಿದ್ದರೂ ಕಾಗೆಗೆ ಪ್ರಿಯವಾದುದು.<br><br>काकफल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇವಿನ ಹಣ್ಣು<br><b>व्युत्पत्तिः - </b>काकप्रियं फलम्<br><br>

काकभीरु
काकभीरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆಗೆ ಹೆದರುವ ಒಂದು ಹಕ್ಕಿ /ಗೂಬೆ<br><br>

काकमाची
काकमाची<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಚಿಗಿಡ /ಗಣಿಕೆ ಗಿಡ<br><b>निष्पत्तिः - </b>मचि (धारणोच्छ्रायपूजनेषु) - "अण्" (३-२-१) । पृषो० । गौरा० "ङीष्" ।<br><b>व्युत्पत्तिः - </b>काकान् मञ्चते<br><br>

काकमुख
काकमुख<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಕ್ಕಳ<br><b>व्युत्पत्तिः - </b>काकस्य मुखमिव मुखं यस्य<br><br>काकमुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಗೆಯಂತೆ ಮುಖವುಳ್ಳವನು<br><br>

काकमुद्गा
काकमुद्गा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಹೆಸರು ಗಿಡ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "डः" (३-२-४८)<br><b>व्युत्पत्तिः - </b>काकेन ईषज्जलेन मुदं गच्छति<br><br>

काकरुत
काकरुत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆಯ ಶಬ್ದ /ಕಾಗೆಯ ಕೂಗು<br><b>व्युत्पत्तिः - </b>काकस्य रुतम्<br><b>प्रयोगाः - </b>"दिवा काकरुताद्भीता रात्रौ तरति नर्मदाम्"<br><br>

काकल
काकल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಠದ ಉಬ್ಬಿದ ಪ್ರದೇಶ<br><br>काकल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಠಮಣಿ<br><b>व्युत्पत्तिः - </b>ईषत् कलो यस्मात्<br><b>विस्तारः - </b>"स्यात् काकलं कण्ठमणिः" - त्रिकाण्ड० ।<br><br>काकल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದ್ರೋಣಕಾಕ /ದೊಡ್ಡ ಜಾತಿಯ ಕಾಗೆ<br><br>

काकली
काकली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಕ್ಷ್ಮವಾದ ಮತ್ತು ಅಸ್ಫುಟವಾದ ಮಧುರದ್ವನಿ<br><b>निष्पत्तिः - </b>गौरा० "ङीष्"<br><b>व्युत्पत्तिः - </b>ईषत्कलः<br><b>प्रयोगाः - </b>"सहकारकिसलयमकरन्दास्वादनरक्तकण्ठानां मधुकरकलकण्ठानां काकलीकलकलेन"<br><b>उल्लेखाः - </b>दशकु०<br><b>विस्तारः - </b>"काकली तु कले सूक्ष्मे" - अम०<br><br>

काकस्वर
काकस्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಕಶಧ್ವನಿ<br><br>काकस्वर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರ್ಕಶಧ್ವನಿಯುಳ್ಳ<br><br>

काका
काका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ ತೊಂಡೆ ಗಿಡ<br><br>काका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಕೋಲಿಯೆಂಬ ಒಂದು ಔಷಧಿ ಗಿಡ<br><br>काका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಚಿಗಿಡ /ಗಣಿಕೆ ಗಿಡ<br><br>काका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಹತ್ತಿಗಿಡ /ಬ್ರಹ್ಮಮೇಡಿ<br><br>काका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಲಗಂಜಿ ಗಿಡ<br><b>विस्तारः - </b>"काका स्यात् काकजङ्घायां काकोलीकाकनासयोः । रक्तिकायां मलप्वां व काकमाच्यां च योषिति" - मेदि० ।<br><br>

काकाक्षिगोलकन्याय
काकाक्षिगोलकन्याय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆಯ ಕಣ್ಣುಗುಡ್ಡೆಯಂತಿರುವ ಒಂದು ನ್ಯಾಯ<br><b>व्युत्पत्तिः - </b>काकस्य अक्षिगोलकमिव न्यायः<br><b>विस्तारः - </b>ಕಾಗೆಗೆ ಇರುವುದು ಒಂದೇ ಕಣ್ಣು. ಈ ಒಂದೇ ನೇತ್ರೇಂದ್ರಿಯವು ಸಮಯ ಬಂದಂತೆಲ್ಲಾ ಎರಡು ಕಣ್ಣುಗುಡ್ಡೆಗಳಲ್ಲಿಯೂ ಚಲಿಸುತ್ತ ಎರಡು ಕಣ್ಣುಗಳಿಗೂ ಉಪಕಾರವಾಗಿರುವಂತೆ ಒಂದು ವಾಕ್ಯದಲ್ಲಿ ಪ್ರಯುಕ್ತವಾದ ಒಂದೇ ಪದವು ವಾಕ್ಯದ ಎರಡು ಭಾಗಗಳಿಗೂ ಅನ್ವಯಿಸಿ ಪ್ರಕೃತಾರ್ಥವನ್ನು ಪೂರೈಸುವುದು ಎಂಬಲ್ಲಿ ಇದರ ಅನ್ವಯ.<br><br>

काकाङ्गी
काकाङ्गी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಕಜಂಘಾವೃಕ್ಷ /ಕಾಗೆ ತೊಂಡೆಗಿಡ<br><b>व्युत्पत्तिः - </b>काकस्याङ्गं जङ्घेवाकारोऽस्याः<br><br>

काकादनी
काकादनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಲಗಂಜಿಗಿಡ<br><br>काकादनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿ ಗುಲಗಂಜಿ ಗಿಡ<br><b>निष्पत्तिः - </b>अद (भक्षणे) - "ल्युट्" बाहु० ।<br><b>व्युत्पत्तिः - </b>काकैरद्यते<br><br>

काकार
काकार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀರನ್ನು ಎರಚುವ /ನೀರನ್ನು ಚೆಲ್ಲುವ<br><b>निष्पत्तिः - </b>आ + कॄ -"अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कं आकिरति<br><br>

काकाराति
काकाराति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆಯ ಶತ್ರು /ಗೂಬೆ<br><b>व्युत्पत्तिः - </b>काकस्यारातिः<br><br>

काकारि
काकारि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆಯ ಶತ್ರು /ಗೂಬೆ<br><b>व्युत्पत्तिः - </b>काकस्यारिः<br><br>

काकि
काकि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆಯ ಮರಿ<br><b>निष्पत्तिः - </b>"इञ्" (४-१-९५)<br><b>व्युत्पत्तिः - </b>काकस्यापत्यम्<br><br>

काकिणी
काकिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕವಡೆ /ಕವಡೆಯ ನಾಣ್ಯ<br><br>काकिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಪ್ಪತ್ತು ಕವಡೆಗಳ ಬೆಲೆ ಬಾಳುವ ನಾಣ್ಯ<br><br>काकिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಪಣದ ನಾಲ್ಕನೆಯ ಒಂದು ಭಾಗ<br><br>काकिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಮೊಳ /೧೮ ಅಂಗುಲಗಳ ಅಳತೆಯ ಕೋಲು<br><br>काकिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಲಗಂಜಿ<br><b>निष्पत्तिः - </b>अण (शब्दे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>काकम् अणति<br><b>विस्तारः - </b>"काकिणी पण्तुर्यांशे मानदण्डे च दृश्यते । कृष्णलैकवराट्योः स्यादुन्मानस्यांशकेऽपि च " - मेदि० ।<br><br>

काकिनी
काकिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಣದ ನಾಲ್ಕನೆಯ ಒಂದು ಭಾಗ<br><br>काकिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಷಗಳ ನಾಲ್ಕನೆಯ ಒಂದು ಭಾಗ<br><br>काकिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕವಡೆ /ಕವಡೆಯ ನಾಣ್ಯ<br><br>काकिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಲಗಂಜಿ<br><b>निष्पत्तिः - </b>अन (प्राणने) - "अण्" (३-२-१) । पृषो० ।<br><b>व्युत्पत्तिः - </b>काकम् अनति<br><b>प्रयोगाः - </b>"यः काकिनीमप्यपथप्रपन्नां समुद्धरेन्निष्कसहस्रतुल्यम्"<br><b>उल्लेखाः - </b>हितो० ३-१२३<br><b>विस्तारः - </b>"काकिनी पणपादेऽपि माषपादे वराटके" - मेदि० ।<br><br>

काकिल
काकिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಠದ ಉನ್ನತ ಪ್ರದೇಶ<br><br>

काकी
काकी<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಠದ ದೋಷ /ಕಂಠದಲ್ಲಿ ಹೊರಡುವ ಒಂದು ಕೆಟ್ಟ ಸ್ವರ /ಬಹಳ ತಗ್ಗಿದ ಸ್ವರ<br><b>विस्तारः - </b>"काकीत्याद्याः कण्ठदोषास्तत्र नृलिङ्गकः । अगम्भीरस्वरः" - वैज० ।<br><br>काकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಕಾಗೆ<br><b>निष्पत्तिः - </b>काक - जाति० "ङीष्" (४-१-६३)<br><b>प्रयोगाः - </b>"काक्या कनकसूत्रेण कृष्णसर्पो निपातितः"<br><b>उल्लेखाः - </b>हितो० २-१२०<br><br>काकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಶ್ಯಪನ ಪತ್ನಿಯಾದ ತಾಮ್ರೆಯ ಮಗಳು /ಗೂಬೆಗಳ ತಾಯಿ<br><b>प्रयोगाः - </b>"काकीं श्येनीं तथा भासीं धृतराष्ट्रीं तथा शुकीम् । ताम्रा तु सुषुवे देवी पञ्चैता लोकविश्रुताः । उलूकान् सुषुवे काकी"<br><b>उल्लेखाः - </b>भा० आदि० ६६-५६, ५७<br><br>काकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಣಿಕೆ ಗಿಡ<br><br>

काकु
काकु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪ ದುಃಖ ಭಯ ಇವುಗಳಿಂದ ವಿಕಾರ ಹೊಂದಿದ ದ್ವನಿ<br><b>निष्पत्तिः - </b>कक (लौल्योपतापयोः) - "उण्" बाहु० ।<br><b>प्रयोगाः - </b>"जातप्रीतिर्या मधुरेणानुवनान्तं कामे कान्ते सारसिकाकाकुरुतेन"<br><b>उल्लेखाः - </b>माघ० ६-७६<br><b>विस्तारः - </b>"भिन्नकण्ठध्वनिर्धीरैः काकुरित्यभिधीयते" - सा० द० । "काकुः स्त्रियां विकारो यः शोकभीत्यादिभिर्ध्वनेः" - अम० ।<br><br>काकु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿರುದ್ಧಾರ್ಥವನ್ನುಂಟುಮಾಡುವ ನಞ್ ಮೊದಲಾದುದು<br><br>काकु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶೋಕಧ್ವನಿ /ವಿಲಾಪ<br><br>

काकुत्स्थ
काकुत्स्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಕುತ್ಸ್ಥವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದವನು /ಕಕುತ್ಸ್ಥರಾಜನ ವಂಶದವನು<br><b>निष्पत्तिः - </b>"अण्" (४-१-११२)<br><b>व्युत्पत्तिः - </b>ककुत्स्थस्य अपत्यम्<br><b>प्रयोगाः - </b>"इक्ष्वाकुवंश्यः ककुदः नृपाणां ककुत्स्थ इत्याहितलक्षणोऽभूत् । काकुत्स्थशब्दं यत उन्नतेच्छाः श्लाघ्यं दधत्युत्तरकोसलेन्द्राः ॥"<br><b>उल्लेखाः - </b>रघु० ६-७१<br><br>काकुत्स्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಜ /ದಶರಥ /ಶ್ರೀರಾಮ /ಲಕ್ಷ್ಮಣ ಮುಂತಾದವರು<br><b>प्रयोगाः - </b>"काकुत्स्थमालोकयतां नृपाणां मनो बभूवेन्दुमतीनिराशम्" । "असज्जनेन काकुत्स्थः प्रयुक्तमथ दूषणम् । न चक्षमे शुभाचारः स दूषमिवात्मनः ।"<br><b>उल्लेखाः - </b>रघु० ६-२, रघु० १२-४६<br><br>काकुत्स्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀರಾಮ ಮತ್ತು ಲಕ್ಷ್ಮಣ<br><b>प्रयोगाः - </b>"तं विनिष्पिष्य काकुत्स्थौ पुरा दूषयति स्थलीम् । गन्धेनाशुचिना चेति वसुधायां निचख्नतुः"<br><b>उल्लेखाः - </b>रघु० १२-३०<br><b>विस्तारः - </b>द्विवचनान्तं रूपम् ।<br><br>

काकुद
काकुद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಲುಪ್ರದೇಶ /ದವಡೆ<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>काकुं ददाति<br><br>

काकोदम्बर
काकोदम्बर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಹತ್ತಿಗಿಡ /ಬ್ರಹ್ಮಮೇಡಿ<br><b>व्युत्पत्तिः - </b>काकप्रियः उदुम्बरः<br><br>

काकोदुम्बरिका
काकोदुम्बरिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಹತ್ತಿಗಿಡ /ಬ್ರಹ್ಮಮೇಡಿ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><br>

काकोदर
काकोदर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ /ಹಾವು<br><b>निष्पत्तिः - </b>अक (कुटिलायां गतौ) - "अच्" (३-१-१३४) कोः कादेशः ।<br><b>व्युत्पत्तिः - </b>कुत्सितं कुटिलं अकति । काकमुदरं यस्य<br><br>

काकोदरी
काकोदरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ /ಹಾವು<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

काकोल
काकोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೊಡ್ಡ ಜಾತಿಯ ಕಾಗೆ /ಮಂಡಕಾಗೆ<br><b>निष्पत्तिः - </b>कक (लौल्ये) + णिच् - "ओलच्" बाहु० ।<br><br>काकोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಬಾರ<br><b>निष्पत्तिः - </b>आ + कुल (संस्त्याने) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कं जलमाकोलति<br><br>काकोल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನರಕ<br><br>काकोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः /नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ<br><b>विस्तारः - </b>"काकोलं नरकान्तरे । ना कुलाले द्रोणकाके विषभेदे तु न स्त्रियाम्" - मेदि० ।<br><br>

काकोलूक
काकोलूक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ ಮತ್ತು ಗೂಬೆ<br><b>निष्पत्तिः - </b>"येषां च विरोधः शाश्वतिकः" (२-४-९)<br><b>व्युत्पत्तिः - </b>काकश्च उलूकश्च अनयोः समाहारः<br><br>

काकोलूकिका
काकोलूकिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ ಗೂಬೆಗಳ ವೈರ<br><b>निष्पत्तिः - </b>काकोलूका - "वुन्" (४-३-१२५)<br><br>

काकोलूकीया
काकोलूकीया<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ ಮತ್ತು ಗೂಬೆ ಇವುಗಳನ್ನು ಕುರಿತ ಗ್ರಂಥ<br><b>निष्पत्तिः - </b>"छः" (४-२-११४)<br><b>व्युत्पत्तिः - </b>काकोलूकमधिकृत्य कृतो ग्रन्थः<br><br>

काक्ष
काक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಟಾಕ್ಷ /ಕಡೆಗಣ್ಣಿನ ನೋಟ<br><b>निष्पत्तिः - </b>"षच्" (५-४-११३) । कोः कादेशः (६-३-१०४)<br><b>व्युत्पत्तिः - </b>कुत्सितं अक्षि यस्य<br><b>प्रयोगाः - </b>"आज्ञालाभोन्मुखो दूरात् काक्षेणानादरेक्षितः"<br><b>उल्लेखाः - </b>भट्टि० ५-२४<br><br>

काक्षि|काङ्क्षायाम्|काङ्क्षति
काक्षि - काङ्क्षायाम् (भ्वा० पर० सक० से०) काङ्क्षति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸು /ಬಯಸು<br><b>प्रयोगाः - </b>"वृक्षान्तरं काङ्क्षति षट्पदाली" । "यो न हृष्यति न द्वेष्टि न शोचति न काङ्क्षति" ।<br><b>उल्लेखाः - </b>रघु० ६-६९, गीता० १२-१७<br><br>

अभि + काक्षि|अभिकाक्षि|अभिकाङ्क्षति
अभि + काक्षि = अभिकाङ्क्षति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ನಿಂತು ಅಪೇಕ್ಷಿಸು<br><b>प्रयोगाः - </b>"अत्यर्थमभिकाङ्क्षामि मृगयां सरयूवने"<br><b>उल्लेखाः - </b>रामा०<br><br>

अआ + काक्षि|आकाक्षि|आकाङ्क्षति
अआ + काक्षि = आकाङ्क्षति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಅಪೇಕ್ಷಿಸು<br><b>प्रयोगाः - </b>"श्रीः साभिलाषामि गुरोरनुज्ञां धीरेव कन्या पितुराचकांङ्क्ष ।"<br><b>उल्लेखाः - </b>रघु० ५-३८<br><br>

प्रति + काक्षि|प्रतिकाक्षि|प्रतिकाङ्क्षति
प्रति + काक्षि = प्रतिकाङ्क्षति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಎದುರು ನೋಡು<br><b>प्रयोगाः - </b>"त्वामेव प्रतिकाङ्क्षन्ति पर्ज्यन्यमिव कर्षकाः"<br><b>उल्लेखाः - </b>रामा०<br><br>

काक्षी
काक्षी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೊಗರಿ ಗಿಡ<br><b>निष्पत्तिः - </b>"अण्" (४-३-५३)<br><b>व्युत्पत्तिः - </b>कक्षे भवा<br><b>विस्तारः - </b>"काक्षी मृत्स्ना तुवरिका" - अम०<br><br>काक्षी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌರಾಷ್ಟ್ರದೇಶದ ಹಣ್ಣು<br><b>विस्तारः - </b>"काक्षी तुवरिकायां च सौराष्ट्रमृद्यपि स्त्रियाम्" - मेदि० ।<br><br>

काक्षीव
काक्षीव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನುಗ್ಗೆ ಗಿಡ<br><b>निष्पत्तिः - </b>क्षीबृ (मदे) + णिच् - "अच्"(३-१-१३४)<br><b>व्युत्पत्तिः - </b>ईषत् क्षीबयति<br><br>काक्षीव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೌತಮನಿಂದ ಔಶೀನರಿಯಲ್ಲಿ ಜನಿಸಿದ ಮಗ<br><b>प्रयोगाः - </b>"शूद्रायां गौतमो यत्र महात्मा संशितव्रतः । औशीनर्यामजनयत् काक्षीवाद्यान् सुतन् मुनिः ॥"<br><b>उल्लेखाः - </b>भा० सभा० २१-५<br><br>

काक्षीवत्
काक्षीवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೀರ್ಘತಮಸ್ಸೆಂಬ ಋಷಿಯಿಂದ ಶೂದ್ರಸ್ತ್ರೀಯಲ್ಲಿ ಜನಿಸಿದ ಒನ್ನ ಮಗ<br><br>काक्षीवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಂಡಕೌಶಿಕನ ತಂದೆಯಾದ ಗೌತಮ ಋಷಿ<br><b>प्रयोगाः - </b>"अथ कक्षीवतः पुत्रं गौतमस्य महात्मनः । शुश्राव तपसि श्रेष्ठमुदारं चण्डकौशिकम् ॥"<br><b>उल्लेखाः - </b>भा० सभा० १७<br><br>

काग
काग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ /ವಾಯಸ<br><b>निष्पत्तिः - </b>गै (शब्दे) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>केति शब्दं गायति<br><br>

कागद
कागद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗದ /ಲೇಖನದ ಆಧಾರ /ಬರವಣಿಗೆಯ ಪತ್ರ<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "कः" (वा० ३-३-५८)<br><b>व्युत्पत्तिः - </b>कागः कागवर्णो मस्यादिर्दीयतेऽत्र<br><b>प्रयोगाः - </b>"भूर्जे वा वसने रक्ते क्षौमे वा तालपत्रके । कागदे वाष्टगन्धेन पञ्चगन्धेन वा पुनः । त्रिगन्धेनौकगन्धेन विलिख्य धारयेन्नरः ॥"<br><b>उल्लेखाः - </b>मन्त्रकल्पद्रुमः<br><br>

काग्नि
काग्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪವಾದ ಅಗ್ನಿ<br><b>निष्पत्तिः - </b>कोः कादेशः (६-३-१०५)<br><b>व्युत्पत्तिः - </b>ईषदग्निः<br><br>

काङ्क्षण
काङ्क्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>काक्षि (काङ्क्षायाम्) - भावे "ल्युट्" (३-३-११५)<br><br>

काङ्क्षणीय
काङ्क्षणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಡುವ<br><br>काङ्क्षणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲು ಯೋಗ್ಯವಾದ<br><br>काङ्क्षणीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲು ಶಕ್ಯವಾದ<br><b>निष्पत्तिः - </b>काक्षि (काङ्क्षायाम्) - कर्म० अर्हादौ च "अनीयर्" (३-१-९६)<br><br>

काङ्क्षत्
काङ्क्षत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>काक्षि (काङ्क्षायाम्) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"काङ्क्षन्तः कर्मणां सिद्धिं यजन्त इह देवताः"<br><b>उल्लेखाः - </b>गीता० ४-१२<br><br>

काङ्क्षन्ती
काङ्क्षन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><b>प्रयोगाः - </b>"यो धर्म एकपत्नीनां काङ्क्षन्ती तमनुत्तमम्"<br><b>उल्लेखाः - </b>मनु० ५-१५८<br><br>

काङ्क्षा
काङ्क्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆ /ಅಭಿಲಾಷೆ /ಬಯಕೆ<br><b>निष्पत्तिः - </b>काक्षि (काङ्क्षायाम्) - "अः" (३-३-१०३)<br><b>प्रयोगाः - </b>"उद्गारशुद्धावपि भक्तकाङ्क्षा न जायते हृद्गुरुता च यस्य"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

काङ्क्षित
काङ्क्षित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆ /ಅಭಿಲಾಷೆ /ಬಯಕೆ<br><b>निष्पत्तिः - </b>काक्षि (काङ्क्षायाम्) - भावे "क्तः" (३-३-११४)<br><b>प्रयोगाः - </b>"सद्य एव सुकृतां हि पच्यते कल्पवृक्षफलधर्मि काङ्क्षितम्" । "न तावता लभ्यममंस्त काङ्क्षितम्"<br><b>उल्लेखाः - </b>रघु० ११-५०, कुमा० ५-१८<br><br>काङ्क्षित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>काक्षि (काङ्क्षायाम्) - कर्म० "क्तः" (३-२-१०२)<br><br>

काङ्क्षितवत्
काङ्क्षितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಿದವನು/ಬಯಸಿದವನು<br><b>निष्पत्तिः - </b>काक्षि (काङ्क्षायाम्) - कर्त० "क्तवतुः" (३-२-१०२)<br><br>

काङ्क्षितव्य
काङ्क्षितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಶ್ಯವಾಗಿ ಅಪೇಕ್ಷಿಸಲ್ಪಡುವ /ಅಪೇಕ್ಷಿಸಬೇಕಾದ<br><b>निष्पत्तिः - </b>काक्षि (काङ्क्षायाम्) - "तव्यः" (३-१-९६)<br><br>

काङ्क्षिन्
काङ्क्षिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿಲಾಷೆಯುಳ್ಳ /ಅಪೇಕ್ಷಿಸುವ<br><b>निष्पत्तिः - </b>काक्षि (काङ्क्षायाम्) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>काङ्क्षते<br><b>प्रयोगाः - </b>"देवा अप्यस्य रूपस्य नित्यं दर्शनकाङ्क्षिणः"<br><b>उल्लेखाः - </b>गीता० ११-५२<br><br>

काङ्क्ष्य
काङ्क्ष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>काक्षि (काङ्क्षायाम्) - "ण्यत्" (३-१-१२४)<br><br>

काङ्क्ष्यमाण
काङ्क्ष्यमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>काक्षि (काङ्क्षायाम्) - कर्म० "शानच्" (३-२-१२४)<br><br>

काङ्गा
काङ्गा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕವಡೆ /ಕವಡೆಯ ನಾಣ್ಯ<br><b>व्युत्पत्तिः - </b>कुत्सितमङ्गमस्याः<br><br>

काच
काच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಜು<br><b>निष्पत्तिः - </b>कच (बन्धने) + णिच् - "अच्" (३-१-१३४)<br><b>प्रयोगाः - </b>"काचः काञ्चनसंसर्गात् धत्ते मारकतीं द्युतिम्"<br><b>उल्लेखाः - </b>हितो० ४२<br><br>काच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಕ್ಯ /ಕಾವಡಿಯ ನಿಲುವು<br><b>निष्पत्तिः - </b>कच (बन्धने) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>कच्यतेऽत्र<br><br>काच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ನೇತ್ರರೊಗ<br><b>प्रयोगाः - </b>"चन्द्रादित्यौ सनक्षत्रौ अन्तरिक्षे च विद्युतः । निर्मलानि च तेजांसि भ्राजिष्णूनि च पश्यति । स एव लिङ्गनाशस्तु नीलिका काचसञ्ज्ञितः ॥"<br><b>उल्लेखाः - </b>सुश्रुत० उत्तरतं० ७<br><br>काच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಜಿನ ಮಣಿ<br><br>काच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪ್ಪುಮಣ್ಣು /ಚೌಳುಮಣ್ಣು<br><b>विस्तारः - </b>"काचोऽक्षिरोगे मणौ मृदि" - मेदि० ।<br><br>

काचक
काचक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>काच ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><br>

काचन
काचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಸ್ತಕ ಹಸ್ತಲಿಖಿತಪತ್ರಗಳು ಮುಂತಾದುವನ್ನು ಕಟ್ಟುವ ದಾರ /ಕಿರಿಯಗಲದ ಬಟ್ಟೆಯ ಪಟ್ಟಿ<br><b>निष्पत्तिः - </b>कच (बन्धने) + णिच् - कर० "ल्युट्" (३-३-११७)<br><br>काचन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಸ್ತಕಗಳನ್ನು ಸೇರಿಸಿ ಕಟ್ಟುವಿಕೆ<br><b>निष्पत्तिः - </b>कच (बन्धने) + णिच् - भावे "ल्युट्" (३-३-११५)<br><br>काचन<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಾವಳೋ ಒಬ್ಬ ಹೆಂಗಸು /ಒಬ್ಬ ನಿರ್ದಿಷ್ಟ ಮಹಿಳೆ<br><b>प्रयोगाः - </b>"पुनः पुनः काचन कुर्वती कचच्छटाधिया धूपजधूपसंयमम्"<br><b>उल्लेखाः - </b>नैष० १५-३०<br><br>

काचननक
काचननक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವಳೋ ಒಬ್ಬ ಹೆಂಗಸು /ಒಬ್ಬ ನಿರ್ದಿಷ್ಟ ಮಹಿಳೆ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><b>प्रयोगाः - </b>"लेखो निबध्यते येन तत्र काचनकाभिधा"<br><b>उल्लेखाः - </b>हारा०<br><br>

काचनकिन्
काचनकिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬರೆಯುವ ಕಾಗದ /ಲೇಖನ ಪತ್ರ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>काचनकमस्त्यस्य<br><br>

काचभाजन
काचभाजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಜಿನ ಪಾತ್ರೆ<br><b>व्युत्पत्तिः - </b>काचमयं भाजनम्<br><br>

काचमणि
काचमणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಜಿನ ಮಣಿ<br><b>व्युत्पत्तिः - </b>काचस्य मणिः<br><b>प्रयोगाः - </b>"आकारे पद्मरागाणां जन्म काचमणेः कुतः"<br><b>उल्लेखाः - </b>हितो० ४५<br><br>

काचमल
काचमल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌವರ್ಚಲ ಲವಣ /ಚೌಳುಮಣ್ಣಿನಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ ಉಪ್ಪು<br><b>व्युत्पत्तिः - </b>काचस्य क्षारमृत्तिकाया मल इव<br><br>

काचलवण
काचलवण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌವರ್ಚಲ ಲವಣ /ಚೌಳುಮಣ್ಣಿನಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ ಉಪ್ಪು<br><br>

काचस्थाली
काचस्थाली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಜಿನ ಪಾತ್ರೆ<br><b>व्युत्पत्तिः - </b>काचस्य स्थाली<br><br>काचस्थाली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸುರುಪಾದರಿ ಗಿಡ<br><b>विस्तारः - </b>"पाटलिः पाटलामोघा काचस्थाली फलेरुहा" - अम०<br><br>

काचाक्ष
काचाक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಬಕಪಕ್ಷಿ<br><b>निष्पत्तिः - </b>"षच्" (५-४-११३)<br><b>व्युत्पत्तिः - </b>काच इवाक्षि यस्य<br><br>

काचाक्षी
काचाक्षी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಬಕಪಕ್ಷಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-४१)<br><br>

काचि|दीप्तौ|काञ्चते
काचि - दीप्तौ (भ्वा० आत्म० अक० से०) काञ्चते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಿಸು/ಹೊಳೆ<br><br>

काचिघ
काचिघ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿನ್ನ /ಸುವರ್ಣ<br><br>काचिघ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಷಕ /ಇಲಿ<br><br>काचिघ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ವಿದಳಧಾನ್ಯದ ಕಾಯಿ /ಬೀಜಕೋಶ /ಅವರೆ/ತೊಗರಿ ಬಟಾಣಿ ಮೊದಲಾದುವುಗಳ ಕಾಯಿ<br><b>विस्तारः - </b>"काचिघः काञ्चनेऽपि स्यात् छेमण्डे मूषकेऽपि च" - मेदि० ।<br><br>

काचित्
काचित्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಾವಳೋ ಒಬ್ಬ ಹೆಂಗಸು /ಒಬ್ಬ ನಿರ್ದಿಷ್ಟ ಮಹಿಳೆ<br><b>निष्पत्तिः - </b>का + चित्<br><b>प्रयोगाः - </b>"अधिविढपि सलीलमग्रपुष्पग्रहणपदेन चिरं विलम्ब्य काचित्"<br><b>उल्लेखाः - </b>माघ० ७-३५<br><br>

काचित
काचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಕ್ಯದಲ್ಲಿ ಏರಿಸಲ್ಪಟ್ಟ /ಕಾವಡಿಯ ನಿಲುವಿನಲ್ಲಿ ಇಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कच (बन्धने) - अधि० "घञ्" (३-३-१२१) + णिच् - चुरा० ग० २०३ - "क्तः" (३-२-१०२)<br><br>

काचिम
काचिम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವಾಲಯದ ಸಮೀಪದಲ್ಲಿ ಹುಟ್ಟುವ ಮರ<br><br>

काचूक
काचूक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಕ್ಕುಟ /ಕೋಳಿ<br><br>काचूक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಕ್ರವಾಕ ಪಕ್ಷಿ<br><b>निष्पत्तिः - </b>कच (बन्धने) - "ऊकः" (उ० ४-४१) निपा० ।<br><br>

काचूकी
काचूकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>काचूक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

काञ्चन
काञ्चन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂಪಕವೃಕ್ಷ /ಸಂಪಿಗೆ ಮರ<br><br>काञ्चन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದತ್ತೂರಿಗಿಡ<br><br>काञ्चन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದುಂಬರವೃಕ್ಷ /ಅತ್ತಿಮರ<br><b>निष्पत्तिः - </b>काचि (दीप्तौ) - "ल्युः" (३-१-१३४)<br><br>काञ्चन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋವಿದಾರವೃಕ್ಷ /ಕೆಂಗಾಂಚಾಳದ ಗಿಡ<br><br>काञ्चन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಗಕೇಸರ ವೃಕ್ಷ<br><br>काञ्चन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುನ್ನಾಗವೃಕ್ಷ /ಸುರಗಿ ಗಿಡ<br><br>काञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿನ್ನ /ಸುವರ್ಣ<br><b>प्रयोगाः - </b>"तस्योल्लसत्काञ्चनकुण्डलाग्रप्रत्युप्तगारुत्मतरत्नभासा"<br><b>उल्लेखाः - </b>माघ० ३-५<br><br>काञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೀಪ್ತಿ /ಕಾಂತಿ<br><b>निष्पत्तिः - </b>काचि (दीप्तौ) - भावे "ल्युट्" (३-३-११५)<br><br>काञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧನ /ಸಂಪತ್ತು<br><br>काञ्चन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿನ್ನದಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ /ಸುವರ್ಣದಿಂದ ಮಾಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"स काञ्चने यत्र मुनेरनुज्ञया नवाम्बुदश्यामवपुर्न्यविक्षत"<br><b>उल्लेखाः - </b>माघ० १-१९<br><br>काञ्चन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಮಲದ ಕೇಸರ<br><br>

काञ्चनी
काञ्चनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹರಿದ್ರೆ /ಅರಿಶಿನ<br><br>काञ्चनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೋರೋಚನ<br><br>काञ्चनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರಿದಳ<br><b>विस्तारः - </b>"काञ्चनं हेम्नि किञ्जल्के काञ्चनो नागकेसरे । उदुम्बरे काञ्चनारे पुन्नागो चम्पकेऽपि च । काञ्चनी तु हरिद्रायाम्" - हेम० । "काञ्चनः काञ्चनारे स्यात् चम्पके नागकेसरे । उदुम्बरे च धत्तूरे हरिद्रायां च काञ्चनी । क्लीबेऽब्जकेसरे हेम्नि" - मेदि० ।<br><br>काञ्चनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರಿಶಿನ<br><br>काञ्चनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರಿದಳ<br><br>काञ्चनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೋರೋಚನ<br><b>निष्पत्तिः - </b>काचि (दीप्तौ) - कर० "ल्युट्" (३-३-११७) । "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>काञ्चते अनया<br><br>

काञ्चनक
काञ्चनक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>काञ्चन ಪದದ ಅರ್ಥ<br><br>

काञ्चनकवली
काञ्चनकवली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಬಾಳೆಗಿಡ<br><br>

काञ्चनकन्दर
काञ्चनकन्दर<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿನ್ನದ ಗಣಿ<br><b>व्युत्पत्तिः - </b>काञ्चनस्य कन्दरः<br><br>

काञ्चनकारिणी
काञ्चनकारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶತಮೂಲೀ ಗಿಡ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>काञ्चनं दीप्तिं करोति<br><br>

काञ्चनगिरि
काञ्चनगिरि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಮೇರು ಪರ್ವತ<br><b>व्युत्पत्तिः - </b>काञ्चनप्रधानो गिरिः<br><br>

काञ्चनप्रभ
काञ्चनप्रभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಐಲಾರಾಜನ ವಂಶದ ಒಬ್ಬ ದೊರೆ<br><br>काञ्चनप्रभ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿನ್ನದಂತೆ ಪ್ರಕಾಶವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>काञ्चनस्येव प्रभा यस्य<br><br>

काङ्चनाक्ष
काङ्चनाक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ದಾನವ<br><b>प्रयोगाः - </b>"काञ्चनाक्षः कपिस्कन्धो व्याघ्राक्षः क्षितिकल्पनः"<br><b>उल्लेखाः - </b>हरिवं०<br><br>

काञ्चनार
काञ्चनार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಗಾಂಚಾಳದ ಗಿಡ<br><br>

काञ्चिक
काञ्चिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಬಲಿ /ಗಂಜಿ<br><br>काञ्चिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಬಲಿ /ಗಂಜಿ<br><b>निष्पत्तिः - </b>अञ्चू (व्यक्त्यादौ) - "ण्वुल्" (वा० ३-३-१०८)<br><b>व्युत्पत्तिः - </b>के अञ्जिकास्य<br><br>काञ्चिक<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೀಹಾಲೆ ಗಿಡ<br><br>

काञ्चिधामन्
काञ्चिधामन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಘನ /ಹೆಂಗಸರ ಸೊಂಟದ ಭಾಗ<br><b>व्युत्पत्तिः - </b>काञ्च्याः धाम<br><b>प्रयोगाः - </b>"काञ्चिधाम्नि पिहितैकतरोरु"<br><b>उल्लेखाः - </b>माघ० १०-८३<br><br>

काञ्ची
काञ्ची<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಡಾಬು /ಒಡ್ಯಾಣ<br><b>निष्पत्तिः - </b>काचि (दीप्तिबन्धनयोः) - "इन्" (उ० ४-११७) । वा "ङीष्" (ग० ४-१-४५)<br><br>काञ्ची<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂಚೀನಗರ /ಮೋಕ್ಷಪ್ರದವಾದ ೭ ನಗರಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"अयोध्या मधुरा माया काशी काञ्चिरवन्तिका । पुरी द्वारावती चैव सप्तैता मोक्षदायकाः ॥"<br><br>

काञ्चि
काञ्चि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಡಾಬು /ಒಡ್ಯಾಣ<br><b>निष्पत्तिः - </b>पक्षे<br><b>प्रयोगाः - </b>"विधायिका शब्दपरम्पराणां किं चारचि व्याकरणेन काञ्ची"<br><b>उल्लेखाः - </b>नैष० १०-७८<br><br>

काञ्चीनगर
काञ्चीनगर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂಚಿಯೆಂಬ ಒಂದು ಪಟ್ಟಣ<br><b>प्रयोगाः - </b>"प्रसह्य काञ्चीपुरभूपुरन्दरः"<br><b>उल्लेखाः - </b>नैष० १२-३३<br><br>

काञ्चीपुर
काञ्चीपुर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂಚಿಯೆಂಬ ಒಂದು ಪಟ್ಟಣ<br><br>

काञ्चीपद
काञ्चीपद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಡಾಬಿನ ಜಾಗ /ಒಡ್ಯಾಣ ಹಾಕುವ ಸ್ಥಳ /ಸ್ತ್ರೀಯರ ಸೊಂಟದ ಮುಂಭಾಗ<br><b>व्युत्पत्तिः - </b>काञ्च्याः पदम्<br><br>

काट
काट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾವಿ /ಕೂಪ<br><b>निष्पत्तिः - </b>अट (गतौ) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>कं जलमट्यतेऽत्र प्राप्यतेऽत्र।<br><br>काट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಕ್ಕಟ್ಟಾದದಾರಿ<br><br>

काटव
काटव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೀಕ್ಷ್ಣತೆ<br><b>निष्पत्तिः - </b>"अण्" (५-१-१२२)<br><b>व्युत्पत्तिः - </b>कटोर्भावः<br><br>

काट्य
काट्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾವಿಯಲ್ಲಿರುವ<br><br>काट्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಕ್ಕಟ್ಟಾದ ದಾರಿಯಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"यत्"<br><b>व्युत्पत्तिः - </b>काटे भवः<br><br>

काठ
काठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಡೆ /ದೊಡ್ಡ ಕಲ್ಲು<br><br>काठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಠಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>कठस्येदम्<br><br>

काठक
काठक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಠಶಾಖಾಧ್ಯಾಯಿಯ ವೇದಾಭ್ಯಾಸ<br><br>काठक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಠಶಾಖಾಧ್ಯಾಯಿಯ ಧರ್ಮ<br><b>निष्पत्तिः - </b>"वुञ्" (वा० ४-३-१२६)<br><b>व्युत्पत्तिः - </b>कठानां धर्मः आम्नायो वा<br><br>काठक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣದ ಒಂದು ಭಾಗ<br><br>

काठिन्य
काठिन्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಠಿನವಾಗಿರುವಿಕೆ /ಗಟ್ಟಿಯಾಗಿರುವಿಕೆ<br><br>काठिन्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೃಢವಾಗಿರುವಿಕೆ<br><br>काठिन्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಷ್ಟವಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>कठिनस्य भावः<br><br>

काठिन्यफल
काठिन्यफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಲದ ಮರ<br><b>व्युत्पत्तिः - </b>काठिन्यं फलेऽस्य<br><br>

काण
काण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ /ವಾಯಸ<br><b>निष्पत्तिः - </b>कण (निमीलने) - "घञ्" (३-३-१२१) । "अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>काणमस्यास्ति<br><br>काण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುಡನಾದ ಒಂದು ಕಣ್ಣು<br><br>काण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದುನೇತ್ರವುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>अक्ष्णा काणः<br><b>प्रयोगाः - </b>"खञ्जो वा यदि वा काणो दातुः प्रेष्योऽपि वा भवेत् । हीनातिरिक्तगात्रो वा तमप्यपनयेत्पुनः ॥"<br><b>उल्लेखाः - </b>मनु० ३-२४२<br><br>

काणी
काणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ /ವಾಯಸ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

काणा
काणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದುನೇತ್ರವುಳ್ಳವಳು<br><b>विस्तारः - </b>"काणः काकैकचक्षुषोः" - मेदि०<br><br>

काणभूति
काणभूति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರನ ಶಾಪದಿಂದ ಪಿಶಾಚತ್ವವನ್ನು ಹೊಂದಿದ ಒಬ್ಬ ಯಕ್ಷ<br><b>प्रयोगाः - </b>"विन्ध्याटव्यां कुबेरस्य शापात् प्रप्तः पिशाचताम् । सुप्रतीकाभिधो यक्षः काणभूत्याख्यया स्थितः ॥"<br><b>उल्लेखाः - </b>बृहत्०<br><br>

काणाद
काणाद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಣಾದ ಮಹರ್ಷಿಗೆ ಸಂಬಂಧಿಸಿದ/ಕಣಾದ ಮಹರ್ಷಿಯಿಂದ ಪ್ರೋಕ್ತವಾದ<br><br>काणाद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಣಾದ ಮಹರ್ಷಿಯಿಂದ ಪ್ರೋಕ್ತವಾದುದನ್ನು ಅಧ್ಯಯಯನ ಮಾಡುವವನು<br><b>व्युत्पत्तिः - </b>कणादेन प्रोक्तं तदधीते वा<br><br>

काणूक
काणूक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ /ವಾಯಸ<br><br>काणूक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೀಜಗದ ಹಕ್ಕಿ<br><b>निष्पत्तिः - </b>कण (निमीलने) - "ऊकण्" (उ० ४-३९)<br><br>

काणेय
काणेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುಡಿಯ ಮಗ /ಒಂದು ಕಣ್ಣುಳ್ಳವನ ಮಗ<br><b>निष्पत्तिः - </b>"ढक्" (४-१-१२०)<br><b>व्युत्पत्तिः - </b>काणाया अपत्यम्<br><br>

काणेर
काणेर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುಡಿಯ ಮಗ /ಒಂದು ಕಣ್ಣುಳ್ಳವನ ಮಗ<br><b>निष्पत्तिः - </b>वा "ढ्रक्" (४-१-१३१)<br><br>

काणेली
काणेली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮದುವೆಯಾಗದ ಕನ್ಯೆ /ವಿವಾಹವಿಲ್ಲದ ಹೆಂಗಸು<br><br>काणेली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಾರಸ್ತ್ರೀ<br><br>

काण्ड
काण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾನದಂಡ /ಅಳತೆಗೋಲು<br><b>निष्पत्तिः - </b>कमु (कान्तौ) -"डः" (उ० १-१११) । दीर्घः (६-४-११५)<br><br>काण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಬು /ಶರ /ಬಾಣ<br><br>काण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರದ ದೂಲ /ಮರದ ರೆಂಬೆಯಿಲ್ಲದ ಕೆಳಭಾಗ<br><br>काण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಂಥದ ಒಂದು ಭಾಗ /ಅಧ್ಯಾಯ /ರಾಮಾಯಣದ ಬಾಲಕಾಂಡ ಅಯೋಧ್ಯಾಕಾಂಡ ಮೊದಲಾದುದು<br><br>काण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರದ ಶಾಖೆ /ರೆಂಬೆ<br><b>प्रयोगाः - </b>"उद्भिज्जाः स्थावराः सर्वे बीजकाण्डप्ररोहिणः"<br><b>उल्लेखाः - </b>मनु० १-४६<br><br>काण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಸರ /ಸಮಯ<br><b>प्रयोगाः - </b>"अकाण्डे प्रथनं छेदस्य रसदोषौ"<br><b>उल्लेखाः - </b>सा० द०<br><br>काण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><br>काण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದಾಯ /ಗುಂಪು /ರಾಶಿ<br><b>प्रयोगाः - </b>"ऋते रवेः क्षालयितुं क्षमेत कः क्षपातमस्काण्डमलीमसं नभः"<br><b>उल्लेखाः - </b>माघ० १-३८<br><br>काण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬು ಬಿದಿರು ಮೊದಲಾದುವುಗಳ ಗೆಣ್ಣು /ಪರ್ವ<br><br>काण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುತ್ಸಿತ ವರ್ಗ /ನೀಚ ಸಮೂಹ<br><br>काण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹುಲ್ಲು ಗಿಡ ಮೊದಲಾದುವುಗಳ ಪೊದರು<br><br>काण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಡಿಗಳಸಮೂಹ<br><br>काण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಂಠದ ಬೇರೆ ಬೇರೆ ಭಾಗ /ಬೇರೆ ಬೇರೆ ಪ್ರಕರಣ /ವಿಷಯಗಳ ಭಾಗ<br><br>काण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಹಸ್ಯ ಸ್ಥಾನ /ಗುಟ್ಟಾದ ಜಾಗ<br><b>विस्तारः - </b>"काण्डः स्तम्भे तरुस्कन्धे बाणेऽवसरनीरयोः । कुत्सिते वृक्षभिन्नाडीवृन्दे रहसि न स्त्रियाम्" - मेदि० ।<br><br>काण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತಂಭ /ಕಂಬ<br><br>काण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವ /ಕುದುರೆ<br><br>काण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ವ /ಅಹಂಕಾರ<br><br>

काण्ड
काण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಲ /ಶಕ್ತಿ<br><b>विस्तारः - </b>"बाणावसरग्रन्थिस्तम्भरहोवाजिवारिवर्गेषु । स्कन्धे च भूरुहाणां गर्वे नाले बले च काण्डोऽस्त्री" - नानार्थर० ।<br><br>काण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ಲಾಘನೆ /ಪ್ರಶಂಸೆ<br><b>विस्तारः - </b>"काण्डो नालेऽधमे वर्गे द्रुस्कन्धेऽवसरे शरे । रहः श्लाघाम्बुषु स्तम्बे" - हेम० ।<br><br>

काण्डकटुक
काण्डकटुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಗಲ ಗಿಡ<br><b>व्युत्पत्तिः - </b>काण्डे स्तम्बेऽपि कटुकः<br><br>

काण्डकार
काण्डकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಡಕೆ ಮರ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>काण्डं किरति<br><br>काण्डकार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾಣವನ್ನು ತಯಾರಿಸುವವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>काण्डं करोति<br><br>

काण्दपट
काण्दपट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಡೇರೆಯ ಸುತ್ತಲೂ ಇರುವ ಪರದೆ /ವಸ್ತ್ರಗೃಹದ ತಳಭಾಗದಲ್ಲಿರುವ ತೆರೆ<br><b>व्युत्पत्तिः - </b>काण्ड इव पटः<br><br>

काण्दपटक
काण्दपटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಡೇರೆಯ ಸುತ್ತಲೂ ಇರುವ ಪರದೆ /ವಸ್ತ್ರಗೃಹದ ತಳಭಾಗದಲ್ಲಿರುವ ತೆರೆ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><b>प्रयोगाः - </b>"उत्क्षिप्तकाण्डपटकान्तरलीयमानमन्दानिलप्रशमितश्रमधर्मतोयैः"<br><b>उल्लेखाः - </b>माघ० ५-२२<br><br>

काण्डपृष्ठ
काण्डपृष्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಸ್ತ್ರಾಸ್ತ್ರಗಳನ್ನು ತಯಾರಿಸಿ ಜೀವಿಸುವವನು<br><br>काण्डपृष्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯೋಧ /ಸೈನಿಕ /ಭಟ<br><b>व्युत्पत्तिः - </b>काण्डः पृष्ठेऽस्य<br><br>काण्डपृष्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಔರಸಪುತ್ರನಿಗಿಂತ ಬೇರೆಯವನಾದ ಒಬ್ಬ ಪುತ್ರ /ಕೀತಪುತ್ರ /ಕ್ರಯಕ್ಕೆ ಕೊಳ್ಳಲ್ಪಟ್ಟ ಪುತ್ರ<br><br>काण्डपृष्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವೀಕೃತಪುತ್ರ /ದತ್ತು ಮಗ<br><br>काण्डपृष्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><br>काण्डपृष्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನ ಮನೆಯನ್ನು ಬಿಟ್ಟು ಬೇರೆಯವರ ಮನೆಯನ್ನು ಸೇರಿರುವವನು<br><br>काण्डपृष्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೂದ್ರಹೆಂಗಸಿನ ಮಗ<br><b>विस्तारः - </b>"काण्डपृष्ठः क्रीतसुते दत्ते शूद्रासुताम्भसोः । शस्त्राजीवे च यश्चान्यकुलं याति स्वकं विना" - वैज० ।<br><br>काण्डपृष्ठ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧನುಸ್ಸು /ಬಿಲ್ಲು<br><b>व्युत्पत्तिः - </b>काण्डं तरुस्कन्ध इव स्थूलं पृष्ठमस्य<br><br>काण्डपृष्ठ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣನ ಧನುಸ್ಸು<br><br>काण्डपृष्ठ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮನ ಬಿಲ್ಲು<br><br>

काण्डर्षि
काण्डर्षि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇದಭಾಗದ ವಿಚಾರ ಮಾಡುವ ಋಷಿ /ಕರ್ಮಕಾಂಡದ ವಿಚಾರ ಮಾಡುವ ಜೈಮಿನಿ ಮೊದಲಾದ ಋಷಿಗಳು<br><b>व्युत्पत्तिः - </b>काण्डस्य वेदभागस्य ऋषिः तदधिकारेण विचारकः<br><br>

काण्डवत्
काण्डवत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಕ್ಷ /ಮರ<br><br>काण्डवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾಣಗಳೇ ಆಯುಧವಾಗಿ ಉಳ್ಳವನು<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४) । मस्य वः (८-२-११)<br><b>व्युत्पत्तिः - </b>काण्डोऽस्यास्ति<br><br>

काण्डवीणा
काण्डवीणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂಡಾಲನ ವೀಣೆ<br><b>व्युत्पत्तिः - </b>काण्ड इव स्थूला वीणा<br><br>

काण्डसन्धि
काण्डसन्धि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬು ಬಿದಿರು ಮೊದಲಾದುವುಗಳ ಗೆಣ್ಣು /ಪರ್ವ<br><br>काण्डसन्धि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಿಡಮರಗಳ ರೆಂಬೆ ಹೊರಡುವ ಜಾಗ<br><br>

काण्डस्पृष्ट
काण्डस्पृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಸ್ತ್ರಾಸ್ತ್ರಗಳಿಂದ ಜೀವಿಸುವವನು<br><b>निष्पत्तिः - </b>परनिपातः (वा० २-२-३६)<br><b>व्युत्पत्तिः - </b>स्पृष्टं गृहीतं काण्डं येन<br><br>

काण्डहीन
काण्डहीन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನ್ನಾರಿ ಗೆಡ್ಡೆ<br><b>व्युत्पत्तिः - </b>काण्डेन हीनम्<br><br>

काण्डीर
काण्डीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣಗಳೇ ಆಯುಧವಾಗಿ ಉಳ್ಳವನು<br><b>निष्पत्तिः - </b>"ईरन्" (५-२-१११)<br><b>व्युत्पत्तिः - </b>काण्डो बाणोऽस्यास्ति<br><b>प्रयोगाः - </b>"काण्डीरः खाड्गिकः शार्ङ्गी रक्षन् विप्रास्तनुत्रवान्"<br><b>उल्लेखाः - </b>भट्टि० ४-१०<br><b>विस्तारः - </b>"स्यात् काण्डवांस्तु काण्डीरः" - अम० ।<br><br>

काण्डेक्षु
काण्डेक्षु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಳವಳಿಕೆ ಗಿಡ<br><b>व्युत्पत्तिः - </b>काण्डे इक्षुरिव<br><br>

काण्व
काण्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ವಮಹರ್ಷಿಯ ಗೋತ್ರದವರ ಶಿಷ್ಯ<br><b>निष्पत्तिः - </b>"अण्" (४-२-१११)<br><b>व्युत्पत्तिः - </b>काण्व्यस्य कण्वगोत्रापत्यस्य छात्रः<br><br>काण्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ವಮಹರ್ಷಿಯ ಮಗ<br><b>निष्पत्तिः - </b>"अण्" (४-१-११२)<br><b>व्युत्पत्तिः - </b>कण्व्यस्यापत्यम्<br><br>काण्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಣ್ವಮಹರ್ಷಿಯ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>काण्वस्येदम्<br><br>

काण्वी
काण्वी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ವಮಹರ್ಷಿಯ ಮಗಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>काण्वी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ವಮಹರ್ಷಿಯ ಶಿಷ್ಯರು ಅಧ್ಯಯನ ಮಾಡಿದ ಶಾಖೆ<br><br>काण्वी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ವಮಹರ್ಷಿಯ ಗೋತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१६) । यलोपः (६-४-१५०)<br><br>

काण्वशाखा
काण्वशाखा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶುಕ್ಲಯಜುರ್ವೇದದ ಕಣ್ವಶಾಖೆ<br><br>

काण्व्य
काण्व्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ವಮಹರ್ಷಿಯ ಗೋತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><b>निष्पत्तिः - </b>"यञ्" (४-१-१०५)<br><b>व्युत्पत्तिः - </b>कण्वस्य गोत्रापत्यम्<br><br>

काण्व्यायन
काण्व्यायन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ವಮಹರ್ಷಿಯ ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><b>निष्पत्तिः - </b>"यञ्" (४-१-१०५) । "फक्" (४-१-१०१)<br><b>व्युत्पत्तिः - </b>कण्व्स्य गोत्रापत्यम् । काण्व्यस्य युवापत्यम् ।<br><br>

कात्
कात्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಮಸ್ತಪದದಲ್ಲಿ ತಿರಸ್ಕಾರ<br><b>निष्पत्तिः - </b>अत (सातत्यगमने) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>कुत्सितमतत्यनेन<br><b>प्रयोगाः - </b>"यन्मयैश्वर्यमतेन गुरुः सदसि कात्कृतः"<br><b>उल्लेखाः - </b>भाग० ६-७-९<br><br>

कातन्त्र
कातन्त्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲಾಪಕ ವ್ಯಾಕರಣ<br><b>निष्पत्तिः - </b>कोः कादेशः ।<br><b>व्युत्पत्तिः - </b>ईषत्तन्त्रमस्य<br><br>

कातर
कातर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಧೀರ /ಧೈರ್ಯವಿಲ್ಲದವನು<br><br>कातर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯದ ಸ್ವಭಾವದವನು /ಅಂಜುಬುರುಕ<br><b>निष्पत्तिः - </b>तॄ (प्लवनतरणयोः) - "अच्" (३-१-१३४) । कोः कादेशः ।<br><b>व्युत्पत्तिः - </b>ईषत्तरति<br><br>कातर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆದರದ<br><b>प्रयोगाः - </b>"मद्गेहिन्याः प्रिय इति सखे चेतसा कातरेण"<br><b>उल्लेखाः - </b>मेघ० २-१४<br><br>कातर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಂಚಲವದ<br><b>प्रयोगाः - </b>"धेन्वा तदध्यासितकातराक्ष्या"<br><b>उल्लेखाः - </b>रघु० २-५२<br><br>कातर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೋಣಿ<br><b>निष्पत्तिः - </b>आ + तॄ - "अच्"<br><b>व्युत्पत्तिः - </b>के जले आतरति प्लवते<br><br>कातर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ದೊಡ್ಡ ಮೀನು<br><br>

कातरी
कातरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कातर ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

कातरता
कातरता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಡಿತನ /ಅಂಜುಬುರುಕತನ /ಪುಕ್ಕಲು<br><br>कातरता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭಯ /ಹೆದರಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कातरस्य भावः<br><br>

कातरत्व
कातरत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>कातरता ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><b>प्रयोगाः - </b>"इति चेतो मा स्म गाः कातरत्वम्"<br><b>उल्लेखाः - </b>मु० मा०<br><br>

कातराक्ष
कातराक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯದಿಂದ ಚಂಚಲವಾದ ನೇತ್ರವುಳ್ಳ<br><b>निष्पत्तिः - </b>"षच्" (५-४-११३)<br><b>व्युत्पत्तिः - </b>कातरे अक्षिणी यस्य<br><br>

कातराक्षी
कातराक्षी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭಯದಿಂದ ಚಂಚಲವಾದ ನೇತ್ರವುಳ್ಳವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीष्" (४-१-४१)<br><b>प्रयोगाः - </b>"यां यां प्रियः प्रैक्षत कातराक्षी सा सा ह्रिया नम्रमुखी बभूव"<br><b>उल्लेखाः - </b>माघ० ३-१६<br><br>

कातर्य
कातर्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಡಿತನ /ಅಂಜುಬುರುಕತನ /ಪುಕ್ಕಲು<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>कातरस्य भावः कर्म वा<br><b>प्रयोगाः - </b>"कातर्यं केवला नीतिः शौर्यं श्वापदचेष्टितम्"<br><b>उल्लेखाः - </b>रघु० १७-४७<br><br>कातर्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭಯ /ಹೆದರಿಕೆ<br><br>

कातल
कातल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ದೊಡ್ಡ ಮೀನು<br><br>कातल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಋಷಿ<br><b>निष्पत्तिः - </b>"फक्" (४-१-९९)<br><b>व्युत्पत्तिः - </b>तस्य गोत्रापत्यम्<br><br>

कातली
कातली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ದೊಡ್ಡ ಮೀನು<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

कातलायन
कातलायन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಋಷಿ<br><br>

कातलायनी
कातलायनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಋಷಿಣಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीष्" (४-१-६३)<br><br>

कातीय
कातीय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾತ್ಯಾಯನ ಋಷಿಯ ಶಿಷ್ಯ<br><b>निष्पत्तिः - </b>"छः" (४-२-११४) । फको वा लुक् (४-१-९१)<br><b>व्युत्पत्तिः - </b>कात्याययनस्य छात्रः<br><br>कातीय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾತ್ಯಾಯನ ಸಂಬಂಧವಾದ<br><br>

कात्यायनीय
कात्यायनीय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾತ್ಯಾಯನ ಋಷಿಯ ಶಿಷ್ಯ<br><b>निष्पत्तिः - </b>पक्षे<br><br>

कात्य
कात्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕತ ಗೋತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><b>निष्पत्तिः - </b>"यञ्" (४-१-१०५)<br><b>व्युत्पत्तिः - </b>कतस्य गोत्रापत्यं पुमान्<br><br>

कात्यायन
कात्यायन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕತ ಗೋತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದ ಒಬ್ಬ ಋಷಿ<br><b>निष्पत्तिः - </b>"यञ्" (४-१-१०५) । "फक्" (४-१-१०१)<br><b>व्युत्पत्तिः - </b>कतस्य गोत्रापत्यम् । कात्यस्यापत्यं युवा ।<br><b>प्रयोगाः - </b>"विश्वामित्रस्य च सुता देवरातादयः स्मृताः । विख्यातास्त्रिषु लोकेषु तेश्षां शीलानि मे शृणु । देवश्रवाः कातश्चैव यतः कात्यायनः स्मृताः ॥"<br><b>उल्लेखाः - </b>हरिवं०<br><br>

कात्यायनी
कात्यायनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ ಗೋತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>"यञ्" (४-१-१०५) । "ष्फः" (४-१-१८) । "ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>कतस्य गोत्रापत्यं स्त्री<br><br>कात्यायनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾತ್ಯಾಯನ ಋಷಿಯ ಪತ್ನಿ<br><br>कात्यायनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಜ್ಞವಲ್ಕ್ಯ ಋಷಿಯ ಒಬ್ಬ ಪತ್ನಿ<br><b>प्रयोगाः - </b>"याज्ञवल्क्यस्य द्वे भार्ये बभूवतुः मैत्रेयी कत्यायनी च तयोर्हं मैत्रेयी ब्रह्मवादिनी बभूव स्त्रीप्रज्ञैव तर्हि कात्यायनी ॥"<br><br>कात्यायनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ /ಪಾರ್ವತಿ<br><br>

कात्यायनीतन्त्र
कात्यायनीतन्त्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾತ್ಯಾಯನಿಯ ಪೂಜಾಕ್ರಮವನ್ನು ಹೇಳುವ ಒಂದು ತಂತ್ರಗ್ರಂಥ<br><br>

कात्यायनीतनय
कात्यायनीतनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ತಿಕೇಯ /ಷಣ್ಮುಖ<br><br>

कात्यायनीपुत्र
कात्यायनीपुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ತಿಕೇಯ /ಷಣ್ಮುಖ<br><br>

कात्यायनीसुत
कात्यायनीसुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ತಿಕೇಯ /ಷಣ್ಮುಖ<br><br>

काथक्य
काथक्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಥಕಋಷಿಯ ಗೋತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><b>निष्पत्तिः - </b>"यञ्" (४-१-१०५)<br><b>व्युत्पत्तिः - </b>कथकस्य गोत्रापत्यं पुमान्<br><br>

काथक्यायन
काथक्यायन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಥಕಋಷಿಯ ಗೋತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><b>निष्पत्तिः - </b>ततः "फक्" (४-१-१०१)<br><br>

काथञ्चित्क
काथञ्चित्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಕಷ್ಟದಿಂದ ಉಂಟಾದ /ಹೆಚ್ಚು ಶ್ರಮದಿಂದ ನೆರವೇರಿದ<br><b>निष्पत्तिः - </b>कथञ्चित् - "ठक्" (५-४-३४)<br><br>

काथिक
काथिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಥೆಯನ್ನು ಬರೆಯುವುದರಲ್ಲಿ ಸಮರ್ಥ /ಕಥೆಯನ್ನು ರಚಿಸುವುದರಲ್ಲಿ ನಿಪುಣ /ಕಥೆಯನ್ನು ಹೇಳುವುದರಲ್ಲಿ ಶಕ್ತ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-१०२)<br><b>व्युत्पत्तिः - </b>कथायां साधुः<br><br>

कादम्ब
कादम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲಹಂಸ /ಒಂದು ಜಾತಿಯ ಹಂಸಪಕ್ಷಿ<br><b>निष्पत्तिः - </b>कदि (आह्वाने) + णिच् - "अम्बच्" (उ० ४-८३)<br><b>प्रयोगाः - </b>"क्वचित् खगानां प्रियमानसानां कादम्बसंसर्गवतीव पङ्क्तिः"<br><b>उल्लेखाः - </b>रघु० १३-५५<br><br>कादम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬು<br><br>कादम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣ<br><b>प्रयोगाः - </b>"तावत् पूगैरन्यनागाधिरूढः कादम्बानामेकपातैरसीव्यत्"<br><b>उल्लेखाः - </b>माघ० १८-२९<br><b>विस्तारः - </b>"कासम्बः स्यात् पुमान् पक्षिविशेषे सायकेऽपि च" - मेदि० ।<br><br>कादम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕದಂಬ ವೃಕ್ಷ /ಈಚಲು ಮರ<br><b>निष्पत्तिः - </b>कदम्ब - स्वार्थे "अण्" (५-४-३८)<br><br>कादम्ब<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುಂಪಿನಲ್ಲಿ ಉಂಟಾದ /ಸಮೂಹದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"अण्" (४-३-५३)<br><b>व्युत्पत्तिः - </b>कदम्बे भवः<br><br>कादम्ब<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಈಚಲು ಮರದ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>कदम्बस्येदम्<br><br>कादम्ब<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಈಚಲು ಹೂವು<br><b>प्रयोगाः - </b>"गन्धश्च धाराहतपल्वलानां कादम्बमर्धोद्गतकेसरं च"<br><b>उल्लेखाः - </b>रघु० १३-२७<br><br>

कादम्बा
कादम्बा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲಹಂಸ /ಒಂದು ಜಾತಿಯ ಹಂಸಪಕ್ಷಿ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्" (४-१-४)<br><br>

कादम्बक
कादम्बक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣ<br><b>निष्पत्तिः - </b>कदम्ब - स्वार्थे "कन्"<br><b>प्रयोगाः - </b>"विपाठकादम्बकपत्रवाहाः पत्री खगो वीरतरोऽस्त्रकण्टकः"<br><b>उल्लेखाः - </b>हारा०<br><br>

कादम्बर
कादम्बर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಸರಿನ ಕೆನೆ<br><br>कादम्बर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಲ್ಲ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>ला (आदाने) - "कः" (३-२-३) । लस्य रः ।<br><b>व्युत्पत्तिः - </b>कादम्बं लाति प्रकृतित्वेन<br><br>कादम्बर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಲ್ಲದಿಂದ ತಯಾರಾದ ಮದ್ಯ<br><br>कादम्बर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಈಚಲು ಮರದ ಮದ್ಯ<br><b>प्रयोगाः - </b>"निषेव्य मधु माधवाः सरसमत्र कादम्बरं हरन्ति रतये रहः प्रियतमाङ्गकादम्बरम्"<br><b>उल्लेखाः - </b>माघ० ४-६६<br><b>विस्तारः - </b>"कादम्बरस्तु दध्यग्रे मद्यभेदे नपुंसकम्" - मेदि० ।<br><br>

कादम्बरी
कादम्बरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ /ಹೆಂಡ<br><b>निष्पत्तिः - </b>कोः कादेशः । "अच्" (५-२-१२७) । "अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>कु कृष्णवर्णमम्बरं कदम्बरम् । तदस्यास्ति । बलभद्रः तस्येदम् ।<br><b>प्रयोगाः - </b>"कादम्बरीसाक्षिकमस्माकं प्रथमशोऽभिमतमिष्यते"<br><b>उल्लेखाः - </b>शाकु० ६<br><br>कादम्बरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸರಸ್ವತಿ<br><br>कादम्बरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><br>कादम्बरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾರಿಕಾಪಕ್ಷಿ<br><br>कादम्बरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣಕವಿ ರಚಿತವಾದ ಕಾದಂಬರೀ ಕಥೆ<br><b>विस्तारः - </b>"कादम्बरस्तु दध्यग्रे मद्यभेदे नपुंसकम् । स्त्री वारुणीपरभृताभारतीशारिकासु च " - मेदि० ।<br><br>

कादम्बिनी
कादम्बिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘಗಳ ಪಂಕ್ತಿ /ಮೋಡಗಳ ಸಾಲು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कादम्बाः कलहंसाः अनुधावकत्वेन अस्त्यस्याः<br><b>प्रयोगाः - </b>"मदीयमतिचुम्बिनी भवतु कापि कादम्बिनी"<br><b>उल्लेखाः - </b>रसगं०<br><b>विस्तारः - </b>"कादम्बिनी मेघमाला"- अम० ।<br><br>

कादाचित्क
कादाचित्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವಾಗಲದರೂ ಒಂದು ಸಲ ಉಂಟಾಗುವ / ಆಕಸ್ಮಿಕವಾದ /ಆಗಾಗ್ಗೆ ಸಂಭವಿಸುವ<br><b>निष्पत्तिः - </b>"ठञ्" (४-३-११)<br><b>व्युत्पत्तिः - </b>कदाचित् भवः<br><br>

कादाचित्कता
कादाचित्कता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವಾಗಲಾದರೂ ಒಂದು ಸಲ ಸಂಭವಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>कादाचित्क - "तल्" (५-१-११९)<br><br>

कादाचित्कत्व
कादाचित्कत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವಾಗಲಾದರೂ ಒಂದು ಸಲ ಸಂಭವಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

काद्रवेय
काद्रवेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕದ್ರುವಿನ ಮಗ /ಹೆಡೆ ಮತ್ತು ಬಾಲವುಳ್ಳ ನರಾಕಾರದ ಸರ್ಪ<br><b>निष्पत्तिः - </b>"ढक्" (४-१-१२०)<br><b>व्युत्पत्तिः - </b>कद्व्रा अपत्यम् पुमान्<br><b>प्रयोगाः - </b>"काद्रवेयाश्च बलिनः सहस्रममितौजसः । सुवर्णवशगा नागाः जज्ञिरे नैकमस्तकाः ॥" "अमृताग्रभुवः पुरेव पुच्छं बडवाभर्तुरवारि काद्रवेयाः"<br><b>उल्लेखाः - </b>हरिवं०, माघ० २०-४३<br><br>

कानक
कानक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕನಕ ಸಂಬಂಧವಾದ /ಚಿನ್ನದ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>कनकस्येदम्<br><br>

कानन
कानन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಡವಿ /ಕಾಡು /ಅರಣ್ಯ<br><b>निष्पत्तिः - </b>कनी (दीप्तिकान्तिगतिषु) + णिच् - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कानयति दीपयति स्मरादि<br><b>प्रयोगाः - </b>"शीतो वायुः परिणमयिता काननौदुम्बराणाम्"<br><b>उल्लेखाः - </b>मेघ० १-४२<br><br>कानन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹ /ಮನೆ<br><br>कानन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮನ ಮುಖ<br><b>व्युत्पत्तिः - </b>कस्य ब्रह्मणः आननम्<br><b>विस्तारः - </b>"काननं विपिने गेहे परमेष्ठिमुखेऽपि च" - मेदि०<br><br>

काननारि
काननारि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಮೀವೃಕ್ಷ /ಬನ್ನಿ ಮರ<br><br>काननारि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿದಿರು<br><br>काननारि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಾವಾಗ್ನಿ /ಕಾಡುಕಿಚ್ಚು<br><br>

काननौकस्
काननौकस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡಿನಲ್ಲಿ ವಾಸಿಸುವ ಋಷಿ /ತಪಸ್ವಿ<br><br>काननौकस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾನರ /ಕಪಿ<br><br>काननौकस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಣ್ಯದಲ್ಲಿ ವಾಸಮಾಡುತ್ತಿರುವ<br><b>व्युत्पत्तिः - </b>काननमोको यस्य<br><br>

कानिष्ठिक
कानिष्ठिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರುಬೆರಳು<br><b>निष्पत्तिः - </b>स्वार्थे "अण्" (५-४-३८)<br><b>व्युत्पत्तिः - </b>कनिष्ठिकैव<br><br>

कानिष्ठिनेय
कानिष्ठिनेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಿಯ ಹೆಂಡತಿಯ ಮಗ<br><b>निष्पत्तिः - </b>"ढक्" (४-१-१२०)<br><b>व्युत्पत्तिः - </b>कनिष्ठाया अपत्यम्<br><b>प्रयोगाः - </b>"कृते कानिष्ठिनेयस्य ज्यैष्ठिनेयं विवासितम्"<br><b>उल्लेखाः - </b>भट्टि० ५-८४<br><br>

कानीन
कानीन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತ್ರೀಯರ ವಿವಾಹಕ್ಕೆ ಮುಂಚೆ ಕನ್ಯಾವಸ್ಥೆಯಲ್ಲಿ ಹುಟ್ಟಿದವನು ವ್ಯಾಸ, ಕರ್ಣ<br><b>निष्पत्तिः - </b>"अण्" कनीनादेशश्च (४-१-११६)<br><b>व्युत्पत्तिः - </b>कन्याया अनूढाया अपत्यम्<br><b>प्रयोगाः - </b>"कानीनः कन्यकाजातो मातामहसुतो मतः"<br><b>उल्लेखाः - </b>याज्ञ० २-१२९<br><b>विस्तारः - </b>"कानीनः कन्यकाजातः" - अम० । "कानिनो व्यासः कर्णश्च" - सि० कौ०<br><br>

कान्त
कान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪತಿ /ಗಂಡ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>कम्पते<br><b>प्रयोगाः - </b>"नात्र कन्तमुपगीतया तया स्वानमा नमति कालिमालया" । "लभेत कान्तं कथमात्मतुल्यम्" ।<br><b>उल्लेखाः - </b>माघ० ४-५७, रघु० ७-१३<br><br>कान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಲೆ /ಕಲ್ಲು<br><br>कान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><br>कान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸಂತ ಋತು<br><br>कान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>"कामका कामकृत् कान्ता"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"सौन्दर्यादिगुणैः कान्तः मनोहरतया भृशम्" - निरुक्तिः<br><br>कान्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಕುಮ<br><br>कान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಮ್ಯವಾದ /ಸುಂದರವಾದ /ಮನೋಹರವಾದ<br><b>प्रयोगाः - </b>"देवानामिदमामनन्ति मुनयः कान्तं क्रतुं चाक्षुषं रुद्रेणेदमुमाकृतव्यतिकरे स्वाङ्गे विभक्तं द्विधा" । "कान्तेन्दुकान्तोपलकुट्टिमेषु" ।<br><b>उल्लेखाः - </b>माल० १-४, माघ० ३-४४<br><br>कान्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟವಾದ /ಅಪೇಕ್ಷಿಸಲ್ಪಡುವ<br><b>प्रयोगाः - </b>"भीमकान्तैर्नृपगुणैः स बभूवोपजीविनाम्"<br><b>उल्लेखाः - </b>रघु० १-१६<br><br>

कान्तपक्षिन्
कान्तपक्षिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಯೂರ /ನವಿಲು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कान्तो रम्यः पक्षोऽस्यास्ति<br><br>

कान्तपाषाण
कान्तपाषाण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಯಸ್ಕಾಂತ ಶಿಲೆ /ಸೂಜಿಗಲ್ಲು<br><br>

कान्तलोह
कान्तलोह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಯಸ್ಕಾಂತ ಶಿಲೆ /ಸೂಜಿಗಲ್ಲು<br><br>

कान्ता
कान्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>कमु (कान्तौ) - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>कम्यते<br><b>प्रयोगाः - </b>"कान्तानां कुवलयमप्यपास्तमक्ष्णोः शोभाभिर्न मुखरुचाऽहमेकमेव"<br><b>उल्लेखाः - </b>माघ० ८-२३<br><br>कान्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪತ್ನಿ /ಹೆಂಡತಿ<br><b>प्रयोगाः - </b>"कान्तया सपदि कोऽप्युपगूढः प्रौढपाणिरपनेतुमियेष"<br><b>उल्लेखाः - </b>माघ० १०-७३<br><br>कान्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಿಯಂಗುವೃಕ್ಷ /ಪ್ರೇಂಖಣ ಗಿದ<br><b>विस्तारः - </b>"कान्तो रम्ये प्रिये ग्राव्णि कान्ता प्रियङ्गुयोषितोः" - हेम० ।<br><br>

कान्ताङ्घ्रि|कान्ताचरण
कान्ताङ्घ्रि(चरण)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶೋಕವೃಕ್ಷ<br><br>

कान्तार
कान्तार<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಡವಿ /ಕಾಡು /ಅರಣ್ಯ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कस्य सुखस्य अन्तं ऋच्छति गच्छति<br><b>प्रयोगाः - </b>"कान्तारकन्दकननं रचयेति नूनमाबद्धवान् प्रतिसरं भगवान् वसिष्ठः"<br><b>उल्लेखाः - </b>चं० रा०<br><br>कान्तार<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾವನ /ದೊಡ್ಡ ಕಾಡು<br><b>प्रयोगाः - </b>"घर्मे निदाघकिरणस्य करैः कठोरैः कान्तारमध्यपदवीषु नखम्पचासु"<br><b>उल्लेखाः - </b>चं० रा०<br><br>कान्तार<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಮವಾದ ದಾರಿ /ಕಷ್ಟವಾದ ಮಾರ್ಗ<br><b>प्रयोगाः - </b>"कान्तारे निर्गतासि प्रियसखि पदवी विस्मृता किं नु मुग्धे"<br><b>उल्लेखाः - </b>नैष० ३-१३२<br><br>कान्तार<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಲ<br><br>कान्तार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋವಿದಾರ ವೃಕ್ಷ /ಕೆಂಗಾಂಚಾಳದ ಗಿಡ<br><br>कान्तार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಪುಜಾತಿಯ ಕಬ್ಬು<br><b>प्रयोगाः - </b>"कान्तारस्तापसेक्षुश्च काष्ठक्षुः सूचिपत्रकः"<br><b>उल्लेखाः - </b>सुश्रुत० सूत्र० ४५-१४९<br><b>विस्तारः - </b>"कान्तारोऽस्त्री महारण्ये बिले दुर्गमवर्त्मनि । पुंसि स्यादिक्षुभेदे" - मेदि० ।<br><br>

कान्तारक
कान्तारक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಪು ಕಬ್ಬು<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><br>

कान्तारग
कान्तारग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಣ್ಯದಲ್ಲಿ ಸಂಚರಿಸುವ /ಕಾಡಿನಲ್ಲಿ ನಡೆಯುವ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "डः" (३-२-४८)<br><b>व्युत्पत्तिः - </b>कान्तारे गच्छति<br><br>

कान्तारगामिन्
कान्तारगामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಣ್ಯದಲ್ಲಿ ಸಂಚರಿಸುವ /ಕಾಡಿನಲ್ಲಿ ನಡೆಯುವ<br><b>निष्पत्तिः - </b>"णिनिः" (३-१-१३४)<br><br>

कान्तारपथ
कान्तारपथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಣ್ಯದ ಮಾರ್ಗ /ಕಾಡುದಾರಿ<br><br>

कान्तारपथिक
कान्तारपथिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಣ್ಯಮಾರ್ಗದಿಂದ ತರಲ್ಪಟ್ಟ<br><br>कान्तारपथिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರಣ್ಯ ಮಾರ್ಗದಿಂದ ಹೋಗುವ<br><b>निष्पत्तिः - </b>"ठञ्" (वा० ५-१-७७)<br><b>व्युत्पत्तिः - </b>कान्तारपथेनाहृतं गच्छति<br><br>

कान्ति
कान्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆ /ಅಭಿಲಾಷೆ /ಬಯಕೆ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) - भावे "क्तुन्" (३-३-९४)<br><br>कान्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶ /ಬೆಳಕು<br><br>कान्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಭೆ /ತೇಜಸ್ಸು<br><b>प्रयोगाः - </b>"स्फुटमिवोज्ज्वलकाञ्चनकान्तिभिर्युतमशोकमशोभत चम्पकैः"<br><b>उल्लेखाः - </b>माघ० ६-५<br><br>कान्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸರ ಸೌಂದರ್ಯ /ಲಾವಣ್ಯ<br><b>प्रयोगाः - </b>"तस्याः शलाकाञ्जननिर्मितेव कान्तिर्भुवोरायतलेखयोर्या" । "स्वकान्तिकीर्तिव्रजमौक्तिकस्रजः श्रयन्तमन्तर्घटनागुणश्रियम्" ।<br><b>उल्लेखाः - </b>कुमा० १-४७, नैष० १-४२<br><br>कान्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶೋಭೆ /ಹೊಳಪು<br><br>कान्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರನ ಪತ್ನಿ<br><b>प्रयोगाः - </b>"मदिरा रूपिणी भूत्वा कान्तिश्च शशिनः प्रिया"<br><br>कान्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ /ಪಾರ್ವತಿ<br><b>प्रयोगाः - </b>"स्तुतिः सिद्धिरिति ख्याता श्रिया संश्रयणाच्च या । लक्ष्मीर्वा ललना वापि कामात् सा कान्तिरुच्यते ॥"<br><b>उल्लेखाः - </b>देवीपु० ४५<br><br>कान्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಗಾನದಿ<br><br>कान्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರನ ಕಲೆ<br><b>विस्तारः - </b>"शशिनी चन्द्रिका कान्तिर्ज्योत्स्ना"<br><br>

कान्तिकर
कान्तिकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶವನ್ನುಂಟುಮಾಡುವ<br><br>कान्तिकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೌಂದರ್ಯವನ್ನುಂಟುಮಾಡುವ<br><br>

कान्तिद
कान्तिद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಿತ್ತಧಾತು<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कान्तिं ददाति<br><br>कान्तिद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಘೃತ /ತುಪ್ಪ<br><br>कान्तिद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೌಂದರ್ಯವನ್ನುಂಟುಮಾಡುವ<br><br>

कान्तिदा
कान्तिदा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಹುಜಿಗೆ ಗಿಡ<br><br>

कान्तिदायक
कान्तिदायक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸುಗಂಧ ದ್ರವ್ಯ್<br><br>कान्तिदायक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರದರಿಶಿನ<br><br>कान्तिदायक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಂತಿಯನ್ನುಂಟುಮಾಡುವ /ಸೌಂದರ್ಯವನ್ನು ಕೊಡುವ<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कान्तिं ददाति<br><br>

कान्तिदायिका
कान्तिदायिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂತಿಯನ್ನುಂಟುಮಾಡುವ /ಸೌಂದರ್ಯವನ್ನು ಕೊಡುವ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्" (४-१-४)<br><br>

कान्तिनगरी
कान्तिनगरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂಚಿೀಪುರ<br><br>

कान्तिभृत्
कान्तिभृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>निष्पत्तिः - </b>डुभृञ् (धारणपोषणयोः) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>कान्तिं बिभर्ति<br><br>

कान्तिमत्
कान्तिमत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><br>कान्तिमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಂತಿಯಿಂದ ಕೂಡಿದ /ಪ್ರಕಾಶಮಾನವಾದ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>कान्तिरस्यास्ति<br><br>

कान्तिमती
कान्तिमती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂತಿಯಿಂದ ಕೂಡಿದ /ಪ್ರಕಾಶಮಾನವಾದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><b>प्रयोगाः - </b>"कला च सा कान्तिमती कलावतस्त्वमस्य लोकस्य च नेत्रकौमिदी"<br><b>उल्लेखाः - </b>कुमा० ५-७१<br><br>

कान्तिमत्ता
कान्तिमत्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂತಿಯಿಂದ ಕೂಡಿರುವಿಕೆ /ಸೌಂದರ್ಯ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कान्तिमतो भावः<br><b>प्रयोगाः - </b>"उपमानमभूद्विलासिनां करणं यत्तव कान्तिमत्तया"<br><b>उल्लेखाः - </b>कुमा० ४-५<br><br>

कान्तिहर
कान्तिहर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಂತಿಯನ್ನು ಹೋಗಲಾಡಿಸುವ /ಸೌಂದರ್ಯವನ್ನು ಕೆಡಿಸುವ<br><b>निष्पत्तिः - </b>हृञ् (हरणे) - "अच्" (३-२-९)<br><b>व्युत्पत्तिः - </b>कान्तिं हरति<br><br>

कान्थिक
कान्थिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂಥಾದೇಶದಿಂದ ಬಂದಿರುವ<br><br>कान्थिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂಥಾದೇಶದಲ್ಲಿರುವ<br><br>कान्थिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂಥಾದೇಶದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>"ठक्" (४-२-१०२)<br><b>व्युत्पत्तिः - </b>कन्थाया आगतः भवः जातो वा<br><br>

कान्दर्प
कान्दर्प<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನ್ಮಥನ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>कन्दर्पस्येदम्<br><br>

कान्दव
कान्दव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾವಲಿಯಲ್ಲಿ ತಯಾರಿಸಲ್ಪಟ್ಟ ತಿಂಡಿ<br><b>निष्पत्तिः - </b>"अण्" (४-२-१६)<br><b>व्युत्पत्तिः - </b>कन्दौ संस्कृतम्<br><br>

कान्दविक
कान्दविक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣಲೆಯಲ್ಲಿ ಕರಿದ ತಿಂಡಿಗಳನ್ನು ಮಾರುವವನು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-५१)<br><b>व्युत्पत्तिः - </b>कान्दवं पण्यमस्य<br><br>

कान्दिग्भूत
कान्दिग्भूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯದಿಂದ ಓಡಿ ಹೋಗುತ್ತಿರುವವನು<br><b>निष्पत्तिः - </b>भू (प्राप्तौ) - "क्तः" (३-४-७२)<br><b>व्युत्पत्तिः - </b>कां दिशं गच्छामीति आकुलीभूतः<br><b>प्रयोगाः - </b>"स कथञ्चित् भयात् तस्मात् विमुक्तो ब्रह्मणस्तथा । कान्दिग्भूतो जीवितार्थी प्रदुद्रावोत्तरां दिशम् ॥"<br><b>उल्लेखाः - </b>भा० शान्ति० १६९-४<br><br>

कान्दिशीक
कान्दिशीक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಯದಿಂದ ಓಡಿ ಹೋದವನು<br><b>निष्पत्तिः - </b>"ठक्" (वा० ४-४-१)<br><b>व्युत्पत्तिः - </b>कां दिशम् गच्छामीत्याह<br><b>प्रयोगाः - </b>"कान्दिशीकजितकाशिनोरिमां व्यापृतिं विबुधवृष्णिवीरयोः"<br><b>उल्लेखाः - </b>याद० १७-७८<br><br>

कान्यकुब्ज
कान्यकुब्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ಯಾಕುಬ್ಜ ದೇಶ<br><b>प्रयोगाः - </b>"कान्यकुब्जे महानासीत् पार्थिवो भरतर्षभ । गाधीति विश्रुतो लोके कुशिकस्यात्मसम्भवः ॥"<br><b>उल्लेखाः - </b>भा० वन० १८४<br><br>

कापटक
कापटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜನ ೫ ವಿಧ ಗೂಢಾಚಾರರಲ್ಲೊಬ್ಬ<br><br>कापटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಷ್ಯ /ವಿದ್ಯಾರ್ಥಿ<br><b>विस्तारः - </b>"कापटिकोऽन्यमर्मज्ञे छात्रे पुंसि शठे त्रिषु" - मेदि० ।<br><br>कापटक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಂಚಕ /ಮೋಸಗಾರ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-८)<br><b>व्युत्पत्तिः - </b>कपटेन चरति<br><br>

कापट्य
कापट्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಟ /ವಂಚನೆ /ಮೋಸ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>कपटिनो भावः<br><br>

कापथ
कापथ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಮಾರ್ಗ /ಕೆಟ್ಟದಾರಿ /ಕಲ್ಲು ಮುಳ್ಳುಗಳಿಂದ ಕೂಡಿದದಾರಿ<br><b>निष्पत्तिः - </b>"अः" (५-४-७४) । नपुंसकत्वम् (वा० २-४-१७)<br><b>व्युत्पत्तिः - </b>कुत्सितः पन्थाः<br><b>विस्तारः - </b>"वाटः पथश्च मार्गश्च" ಎಂಬ ತ್ರಿಕಾಂಡ ಶೆಷದ ಪಾಠದಂತೆ ಪಥ ಶಬ್ದದೊಡನೆ ಸಮಾಸ ಮಾಡಿ ಪುಲ್ಲಿಂಗ ಹೇಳಬೇಕೆಂದು ಅಮರ ಸುಧಾವ್ಯಾಖ್ಯಾನ. ಆದರೆ कु ವಿಗೆ का ಆದೇಶವು "का पथ्यक्षयोः" (पा० सू० ६-३-१०४) ಸೂತ್ರದಿಂದ पथिन् ಶಬ್ದವು ಪರವಾದರೆ ಮಾತ್ರ ಬರುವುದೇ ಹೊರತು पथ ಶಬ್ದವು ಪರವಾದರೆ ಬರಲು ಅವಕಾಶವಿಲ್ಲ. ನಿಘಂಟುಕಾರರೂ ಪುಲ್ಲಿಂಗದಲ್ಲಿಯೇ ಹೇಳಿರುತ್ತಾರೆ. "कदध्वा कापथः पुमान्" - अम० । "कापथः कुत्सितपथे उशीरे क्लीबमिष्यते" - मेदि० । "विपथः कापथो व्यध्वो दुरध्वश्च कदध्वनि" - वैज० । "सत्पथस्तु सुपन्थाः स्यात् व्यध्वो विपथकापथौ" - रभसः ।<br><br>कापथ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಶೀರ /ಲಾಮಂಚದ ಬೇರು<br><br>

कापा
कापा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾತಃಕಾಲದಲ್ಲಿ ಎಚ್ಚರಗೊಳಿಸುವ ಹೊಗಳುಭಟನ ಮಾತು /ಸ್ತುತಿಪಾಠಕನ ಮಾತು<br><b>निष्पत्तिः - </b>आल्पृ (व्याप्तौ) - कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>कं सुखमाप्यते अनया<br><br>

कापाटिक
कापाटिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕ ಕದ /ಚಿಕ್ಕ ಬಾಗಿಲು<br><b>निष्पत्तिः - </b>स्वार्थे "अण्" (५-३-१०७)<br><b>व्युत्पत्तिः - </b>कपाटिकेव<br><br>

कापाल
कापाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೌತೆ ಗಿಡ<br><br>कापाल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಏಳು ಮಹಾವಿಧ ಕುಷ್ಠರೋಗಗಳಲ್ಲೊಂದು<br><b>निष्पत्तिः - </b>स्वाथे "अण्" (५-४-३८)<br><b>व्युत्पत्तिः - </b>कपालमेव<br><b>प्रयोगाः - </b>"अरुणोदुम्बरर्ष्यजिह्वकपालकाकणकपुण्दरीकदद्रुकुष्ठानीति महाकुष्ठानि"<br><b>उल्लेखाः - </b>सुश्रुत० निदान० ५-५<br><br>कापाल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಾಲ ಸಂಬಂಧವಾದ /ಕಪಾಲದಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ ಆಭರಣ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>कपालस्येदम्<br><b>प्रयोगाः - </b>"त्रिशूलमस्त्रं घोरं च कापालमथ कङ्कणम्"<br><b>उल्लेखाः - </b>विक्र०<br><br>

कापालिक
कापालिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೈವಮತಾನುಯಾಯಿಯಾದ ಸಂನ್ಯಾಸಿ/ ಭಿಕ್ಷೆಗಾಗಿ ಕಪಾಲವನ್ನು ಹಿಡಿಸು ಸಂಚರಿಸುವ ಮತ್ತು ಅದರಲ್ಲಿ ಊಟಮಾಡುವ ಶೈವಭಿಕ್ಷು<br><b>निष्पत्तिः - </b>कपाल - 'ठक्" (४-४-८)<br><b>व्युत्पत्तिः - </b>कपालेन नरकपालेन चरति अभ्यवहारादिकं करोति<br><b>प्रयोगाः - </b>"केचित् पञ्चशिखीकृताश्च जटिलाः कापालिकाश्चापरे"<br><b>उल्लेखाः - </b>भर्तृ० १-७९<br><br>कापालिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಮಿಶ್ರಜಾತಿಯವನು<br><br>

कापालिकी
कापालिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कापालिक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीष्" (४-१-६३)<br><br>

कापालिन्
कापालिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ರತಕ್ಕಾಗಿ ಬ್ರಹ್ಮಕಪಾಲವನ್ನು ಹಿಡಿದಿರುವ ಶಿವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कपालं ब्रह्मकपालं व्रते धार्यत्वेनास्त्यस्य<br><b>प्रयोगाः - </b>"अजैकपाच्च कापाली त्रिशङ्कुरजितः शिवः"<br><b>उल्लेखाः - </b>भा० अनु० १७<br><br>कापालिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಮಿಶ್ರಜಾತಿಯವನು<br><br>

कापिक
कापिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಿಯಂತಿರುವ /ಕಪಿಯಂತೆ ಆಕಾರ ಅಥವಾ ಚೇಷ್ಟೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"ठक्" (५-३-१०८)<br><b>व्युत्पत्तिः - </b>कपिरिव<br><br>

कापिञ्जल
कापिञ्जल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಂಜಲನ ಮಗ<br><b>निष्पत्तिः - </b>कपिञ्जल - "अण्" (४-१-११२)<br><b>व्युत्पत्तिः - </b>कपिञ्जलस्यापत्यम्<br><br>

कापित्थ
कापित्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಿತ್ಥ ಸಂಬಂಧವಾದ /ಬೇಲದ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अञ्" (४-३-१४०)<br><b>व्युत्पत्तिः - </b>कपित्थस्यावयवो विकारो वा<br><br>

कापिल
कापिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಲ ವರ್ಣ /ಕಂದು ಹೊಂಬಣ್ಣ<br><b>निष्पत्तिः - </b>कपिल - स्वार्थे "अण्" (५-४-३८)<br><br>कापिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಲಮತಾನುಯಾಯಿ /ಸಾಂಖ್ಯಮತಾನುಯಾಯಿ<br><br>कापिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಲ ಮಹರ್ಷಿಪ್ರೋಕ್ತವಾದ ಶಾಸ್ತ್ರವನ್ನು ತಿಳಿದವನು ಮತ್ತು ಅಧ್ಯಯನ ಮಾಡಿದವನು<br><b>निष्पत्तिः - </b>"अण्" (४-२-५९)<br><b>व्युत्पत्तिः - </b>कापिलं कपिलोक्तं शास्त्रं वेत्त्यधीते वा<br><br>कापिल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಲ ಮಹರ್ಷಿ ಪ್ರೋಕ್ತವಾದ ಸಾಂಖ್ಯಶಾಸ್ತ್ರ<br><br>कापिल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಲ ಮಹರ್ಷಿಯು ತಪಸ್ಸು ಮಾಡುತ್ತಿದ್ದ ಒಂದು ತೀರ್ಥ<br><br>कापिल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಿಲಮಹರ್ಷಿರಚಿತವಾದ ಒಂದು ಉಪಪುರಾಣ<br><br>कापिल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಿಲ ಮಹರ್ಷಿ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><br>कापिल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂದು ಹೊಂಬಣ್ಣದ<br><br>

कापिलिक
कापिलिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಲ ವರ್ಣದ ಹೆಂಗಸಿನ ಮಗ<br><b>निष्पत्तिः - </b>"अण्" (४-१-११२)<br><b>व्युत्पत्तिः - </b>कपिलिकाया अप्त्यम्<br><br>

कापिल्य
कापिल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಿಲ ಮಾರ್ಷಿಯು ವಾಸಮಾಡುವ ದೇಶ<br><b>व्युत्पत्तिः - </b>कपिलः अस्त्यस्मिन् देशे<br><br>कापिल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಿಲಮಹರ್ಷಿಯಿಂದ ಉಂಟಾದ<br><b>व्युत्पत्तिः - </b>कपिलेन निवृत्तम्<br><br>कापिल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಿಲಮಹರ್ಷಿಯು ವಾಸಮಾಡುವ ಜಾಗ<br><b>व्युत्पत्तिः - </b>कपिलस्य निवासः<br><br>कापिल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಿಲಮಹರ್ಷಿಗೆ ಸಮೀಪದಲ್ಲಿರುವ ದೇಶ ಅಥವಾ ಗ್ರಾಮ<br><b>निष्पत्तिः - </b>सर्वत्र सङ्काशादित्वात् "ण्यः" (४-२-७०)<br><b>व्युत्पत्तिः - </b>कपिलस्य अदूरभवः<br><br>

कापिश
कापिश<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುರೆ /ಒಂದು ವಿಧ ಮದ್ಯ<br><b>निष्पत्तिः - </b>"अण्" (५-२-१०३)<br><b>व्युत्पत्तिः - </b>कपिशा माधवीलता तत्पुष्पं साधनत्वेनास्त्यस्य<br><br>

कापिशायन
कापिशायन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಧು /ಜೇನುತುಪ್ಪ<br><b>निष्पत्तिः - </b>कापिशी- "ष्फक्" (४-२-९९)<br><b>व्युत्पत्तिः - </b>कापिश्यां देशविशेषे जातम्<br><br>कापिशायन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ /ಹೆಂಡ<br><b>प्रयोगाः - </b>"कापिशायनसुगन्धि विघूर्णन्नुन्मदोऽधिशयितुं समशेत"<br><b>उल्लेखाः - </b>माघ० १०-४<br><br>

कापिशायनी
कापिशायनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದ್ರಾಕ್ಷಿ<br><b>निष्पत्तिः - </b>"ङीष्" (४-१-४१)<br><b>विस्तारः - </b>"कापिशायनी द्राक्षा" - सि० कौ० ।<br><br>कापिशायनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದೇವತೆ<br><br>

कापिशी
कापिशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದೇಶ<br><br>

कापिशेय
कापिशेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಿಶಾಚ /ಭೂತ /ದೆವ್ವ<br><b>निष्पत्तिः - </b>"ढक्" (४-१-१२०)<br><b>व्युत्पत्तिः - </b>कपिशाया अपत्यम्<br><br>

कापुरुष
कापुरुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀಚಮನುಷ್ಯ /ತುಚ್ಛ /ನಿಕೃಷ್ಟನಾದವನು<br><br>कापुरुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಡಿ /ಅಂಜುಬುರುಕ<br><b>निष्पत्तिः - </b>कोः वा कादेशः (६-३-१०६)<br><b>व्युत्पत्तिः - </b>कुत्सितः पुरुषः<br><b>प्रयोगाः - </b>"शत्रोर्विख्यातवीर्यस्य व्यञ्जनीयस्य विक्रमैः । पश्यतो युद्दलुब्धोऽहं क्ट्यः कापुरुषस्त्वया"<br><b>उल्लेखाः - </b>रामा०<br><br>कापुरुष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಡಿಯ ಸಂಬಂಧವಾದ /ಅಂಜುಕುಳಿಯ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>कापुरुषस्येदम्<br><b>प्रयोगाः - </b>"स्त्रीषु शौर्यमनाथासु परदारप्रधर्षक । कृत्वा कापुरुषं कर्म शूरोऽर्हामति लभ्यते ॥"<br><b>उल्लेखाः - </b>रामा०<br><br>

कुपुरुष
कुपुरुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಡಿ /ಅಂಜುಬುರುಕ<br><b>निष्पत्तिः - </b>पक्षे<br><br>

कापुरुषी
कापुरुषी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಡಿಯ ಸಂಬಂಧವಾದ /ಅಂಜುಕುಳಿಯ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

कापुरुष्य
कापुरुष्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಜುಬುರುಕತನ /ಹೇಡಿತನ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>कापुरुषस्य भावः कर्म वा<br><br>कापुरुष्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀಚತನ /ತುಚ್ಛತನ<br><br>

कापेय
कापेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಯ ಗೋತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><b>निष्पत्तिः - </b>"ढक्" (४-१-१२२)<br><b>व्युत्पत्तिः - </b>कपेर्गोत्रापत्यं पुमान्<br><br>कापेय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಯ ಭಾವ ಮತ್ತು ಕರ್ಮ /ಕಪಿತ್ವ /ಕಪಿಯ ಚೇಷ್ಟೆ<br><b>निष्पत्तिः - </b>ढक्" (५-१-१२७)<br><b>व्युत्पत्तिः - </b>कपेर्भावः कर्म वा<br><br>

कापेयी
कापेयी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಯ ಗೋತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><b>प्रयोगाः - </b>"कच्चिन्नु खलु कापेयी सैव ते चलचित्तता"<br><b>उल्लेखाः - </b>रामा०<br><br>

कापोत
कापोत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪೋತ ವರ್ಣ /ಪಾರಿವಾಳಹಕ್ಕಿಯ ಬಣ್ಣ /ನರೆಬಣ್ಣ /ಬೂದು ಬಣ್ಣ<br><br>कापोत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪೋತಗಳ ಸಮೂಹ /ಪಾರಿವಾಳ ಹಕ್ಕಿಗಳ ಗುಂಪು<br><b>निष्पत्तिः - </b>"अण्" (४-२-३७)<br><b>व्युत्पत्तिः - </b>कपोतनां समूहः<br><br>कापोत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌವೀರಾಂಜನ<br><br>कापोत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸದ್ಯಕ್ಷಾರ<br><br>कापोत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪೋತ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>कपोतस्येदम्<br><b>विस्तारः - </b>"कापोतो रुचके क्लीबे कपोतौघेऽञ्जनान्तरे" - मेदि० ।<br><br>

कापोती
कापोती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪೋತದ ವೃತ್ತಿ /ಉಂಛದ ವೃತ್ತಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><b>प्रयोगाः - </b>"दुर्मना भगवान् काव्यः पौरोहित्यं विगर्हयन् । स्तुवन् वृत्तिं च कापौतीं दुहित्रा च ययौ पुरात् ॥"<br><b>उल्लेखाः - </b>भाग० ९-१८-२५<br><b>विस्तारः - </b>ಕಪೋತಗಳು ಹೊಲಗದ್ದೆಗಳಲ್ಲಿ ಬಿದ್ದಿರುವ ಕಾಳುಗಳನ್ನು ಆರಿಸಿ ತಿನ್ನುವುವು ಮತ್ತು ಸ್ವಲ್ಪ ಮಾತ್ರ ಕೂಡಿಸಿ ಇಟ್ಟುಕೊಳ್ಳುವುವು. ಇದರಂತೆ ಮನುಷ್ಯರೂ ನಡೆದರೆ ಅದು ಕಾಪೋತವೃತ್ತಿಯೆನಿಸುವುದು.<br><br>

कापोतपाक्य
कापोतपाक्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರಿವಾಳಮರಿಗಳ ಗುಂಪು<br><b>निष्पत्तिः - </b>"ञ्यः" (५-३-११३)<br><b>व्युत्पत्तिः - </b>कपोतानां पाकाः डिम्भाः तेषां व्रातः<br><br>

कापोताञ्जन
कापोताञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌವೀರಾಂಜನ /ಕಪೋತವರ್ಣದ ಒಂದು ಅಂಜನ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>कपोतस्येदम् । कापोतं च तत् अञ्जनं च ।<br><br>

काप्य
काप्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಗೋತ್ರೋತ್ಪನ್ನನಾದ ಆಂಗಿರಸ<br><b>निष्पत्तिः - </b>"यञ्" (४-१-१०७)<br><b>व्युत्पत्तिः - </b>कपेर्गोत्रापत्यम्<br><br>

काप्यकर
काप्यकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಾನು ಮಾಡಿದ ಪಾಪಕೃತ್ಯವನ್ನು ಇತರರಿಗೆ ತಿಳಿಸುವವನು /ಪಶ್ಚಾತ್ತಾಪ ಪಡುವ ಸ್ವಭಾವದವನು<br><b>निष्पत्तिः - </b>(धातूनामनेकार्थत्वात्) डुकृञ् (करणे) - "टः" (३-२-२०)<br><b>व्युत्पत्तिः - </b>कुत्सितमाप्यं कप्यं पापं करोति कथयति<br><br>

काप्यकार
काप्यकार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನ ಪಾಪಕೃತ್ಯವನ್ನು ಇಅತರರಿಗೆ ತಿಳಿಸುವವನು /ಪಶ್ಚಾತ್ತಾಪಪಡುವವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>काप्यं करोति<br><br>

काफल
काफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೇಗದ ಮರ<br><b>व्युत्पत्तिः - </b>कुत्सितं फलमस्य<br><br>

काम
काम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) - "घः" (३-३-११८)<br><b>व्युत्पत्तिः - </b>काम्यतेऽनेन<br><b>प्रयोगाः - </b>"कामः कौसुमचापदुर्जयममुं जेतुं नृपं त्वां धनुर्वल्लीमव्रणवंशजामधिगुणामासाद्य माद्यत्यसौ" । "श्रीमाञ्जगन्ति मदयन्नयनाभिरामः कामोऽयमेति मदघूर्नीतनेत्रपद्मः" ।<br><b>उल्लेखाः - </b>नैष० ३-१२६, प्रबोध० १-१०<br><br>काम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆ /ಅಭಿಲಾಷೆ /ಬಯಕೆ<br><b>प्रयोगाः - </b>"प्रासादजालैर्जलवेणिरम्यां रेवां यदि प्रेक्षितुमस्ति कामः"<br><b>उल्लेखाः - </b>रघु० ६-४३<br><b>विस्तारः - </b>"कामो मे भुञ्जीत भवान्" - सि० कौ ।<br><br>काम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಫಲಾಪೇಕ್ಷೆ<br><b>प्रयोगाः - </b>"स्वयं विधाता तपसः फलनां केनापि कामेन तपश्चचार"<br><b>उल्लेखाः - </b>कुमा० १-५७<br><br>काम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಭೀಷ್ಟ /ಮನೋರಥ /ಕೋರಿಕೆ<br><b>प्रयोगाः - </b>"सम्पत्स्यते वः कामोऽयं कालः कश्चित् प्रतिक्ष्यताम्"<br><b>उल्लेखाः - </b>कुमा० २-५४<br><br>काम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವೇಚ್ಛಚಾರ /ಇಷ್ಟಬಂದಂತೆ ನಡೆಯುವಿಕೆ /ಮನಸ್ಸಿಗೆ ತೋರಿದಂತೆ ವರ್ತಿಸುವಿಕೆ<br><b>प्रयोगाः - </b>"दिगीशवृन्दांशविभूतिरीशिता दिशा स कामप्रसरावरोधिनीम्"<br><b>उल्लेखाः - </b>नैष० १-६<br><br>काम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿ /ಸ್ತ್ರೀಪುರುಷರ ಪರಸ್ಪರ ಅಲಿಂಗನಾದಿಗಳಿಗೆ ಕಾರಣವಾದ ಅನುರಾಗ<br><br>काम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಯಾಭಿಲಾಷೆ /ವಿಷಯಾಸಕ್ತಿ<br><b>प्रयोगाः - </b>"काम एष क्रोध एषः रजोगुणसमुद्भवः"<br><b>उल्लेखाः - </b>गीता० ३-३७<br><br>काम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರ /ದೇವತಾನುಗ್ರಹದಿಂದ ದೊರೆತ ಇಷ್ಟಾರ್ಥ<br><b>निष्पत्तिः - </b>कमु - कर्म० "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>काम्यते<br><br>काम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ಪರಮಾತ್ಮ<br><b>प्रयोगाः - </b>"कामहा कामकृत् कान्तः कामः कामप्रदः प्रभुः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"कामः स काम्यते मोक्षकाङ्क्षिभिः प्रार्थ्यते यतः"- निरुक्तिः ।<br><br>काम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲರಾಮ<br><br>काम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುರತಾಭಿಲಾಷೆ /ಸಂಭೋಗದ ಅಪೇಕ್ಷೆ<br><br>काम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶಯ /ಅಭಿಪ್ರಾಯ<br><b>प्रयोगाः - </b>"ऐव विद्वन् पितुः कामान् पान्तावल्पम्पचान् मुनीन्"<br><b>उल्लेखाः - </b>भट्टि० ६-९६<br><br>काम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಲ್ಕು ವಿಧ ಪುರುಷಾರ್ಥಗಳಲ್ಲೊಂದು /ಸುಖಾನುಭವ /ಇಂದ್ರಿಯ ಸುಖ<br><br>काम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುರಾಗದ ಅಧಿಷ್ಠಾತೃದೇವತೆ<br><br>काम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮನಾವಿಷಯ /ಇಚ್ಛೆಗೆ ವಿಷಯವಾದ ಸ್ರಕ್ಚಂದನಾದಿಗಳು<br><b>प्रयोगाः - </b>"न जातु कामः कामानामुपभोगेन शाम्यति । हविषा कृष्णवर्त्मेव भूय एवाभिवर्धते ॥" "तद्वत् कामा यं प्रविशन्ति सर्वे स शान्तिमाप्नोति न कामकामी"<br><b>उल्लेखाः - </b>मनु० २-९४, गीता० २-७०<br><br>काम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಮಾವಿನಮರ<br><br>काम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ್ಯ /ಇಚ್ಛೆಗೆ ವಿಷಯವಾದ ಫಲ<br><br>काम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರೇತಸ್ಸು /ವೀರ್ಯ<br><br>

कामम्
कामम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನುಮತಿ<br><b>प्रयोगाः - </b>"काममामरणात् तिष्ठेत् गेहे कन्यर्तुमत्यपि"<br><b>उल्लेखाः - </b>मनु० ९-८९<br><br>कामम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟಾನುಸಾರವಾಗಿ /ಅಡ್ಡಿ ಆತಂಕಗಳಿಲ್ಲದೆ<br><b>प्रयोगाः - </b>"भूयस्ततो रघुपतिर्विलसत्पताकमध्यास्त कामगति सावरजो विमानम्"<br><b>उल्लेखाः - </b>रघु० १३-७६<br><br>कामम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅತ್ಯಂತವಾಗಿ /ಹೆಚಾಗಿ /ಬಹಳವಾಗಿ<br><b>प्रयोगाः - </b>"कामं प्रिया न सुलभा मनस्तु तद्भावदर्शनायासि"<br><b>उल्लेखाः - </b>शाकु० २-१<br><br>कामम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅತ್ಯಂತವಾಗಿ /ಸಂಪೂರ್ಣವಾಗಿ /ಅತಿಶಯವಾಗಿ<br><b>प्रयोगाः - </b>"कामं प्रत्यादिष्टां स्मरापि न परिग्रहं मुनेस्तनयाम्"<br><b>उल्लेखाः - </b>शाकु० ५-३१<br><br>कामम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟವಿಲ್ಲದೆ ಅಂಗೀಕಾರ /ಅರ್ಧಾಂಗೀಕಾರ<br><b>प्रयोगाः - </b>"मनागमभ्यावृत्त्या वा कामं क्षाम्यतु यः क्षमी"<br><b>उल्लेखाः - </b>माघ० २-४३<br><br>कामम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಜವಾಗಿಯೂ /ಸತ್ಯವಾಗಿಯೂ<br><b>प्रयोगाः - </b>"संरुद्धचेष्टस्य मृगेन्द्र कामं हास्यं वचस्तद्यदहं विवक्षुः"<br><b>उल्लेखाः - </b>रघु० २-४२<br><br>कामम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನುಮತಿ /ಅನುಜ್ಞೆ<br><br>

कामकला
कामकला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರತಿ /ಮನ್ಮಥನ ಪತ್ನಿ<br><b>व्युत्पत्तिः - </b>कामस्य कला<br><br>

कामकाम
कामकाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟವಾದುದನ್ನು ಅಪೇಕ್ಷಿಸುವ /ಬೇಕಾದುದನ್ನು ಬಯಸುವ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) + णिङ् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कामं काम्यं कामयते<br><b>प्रयोगाः - </b>"एवं त्रयीधर्ममनुप्रपन्ना गतागतं कामकामा लभन्ते"<br><b>उल्लेखाः - </b>गीता० ९-२१<br><br>

कामकामी
कामकामी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ರಕ್ ಚಂದನಾದಿ ವಿಷಯಗಳನ್ನು ಅಪೇಕ್ಷಿಸುವವನು /ವಿಷಯಾಸಕ್ತ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) + णिङ् - "णिनिः" (३-२-७८)<br><b>प्रयोगाः - </b>"आपूर्यमाणमचलप्रतिष्ठं समुद्रमापः प्रविशन्ति यद्वत् । तद्वत् कामा यं प्रविशन्ति सर्वे स शान्तिमाप्नोति न कामकामी"<br><b>उल्लेखाः - </b>गीता० २-७०<br><br>

कामकामिनी
कामकामिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कामकामी ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कामकार
कामकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಫಲಾಭಿಸಂಧಿಯಿಂದ ಕೆಲಸ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - भावे "घञ्" (३-३-१८)<br><b>व्युत्पत्तिः - </b>कामेन फलकामनया कारः करणम्<br><b>प्रयोगाः - </b>"अयुक्तः कामकारेण फले सक्तो निबध्यते"<br><b>उल्लेखाः - </b>गीता० ५-१२<br><br>कामकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವೇಚ್ಛೆಯಿಂದ ಕೆಲಸ ಮಾಡುವುದು /ಇಷ್ಟಬಂದಂತೆ ಕೆಲಸ ಮಾಡುವಿಕೆ /ಬುದ್ಧಿಪೂರ್ವಕ ಮಾಡುವಿಕೆ<br><b>प्रयोगाः - </b>"कामकारकृतेऽप्यहुरेके श्रुतिनिदर्शनात्"<br><b>उल्लेखाः - </b>मनु० ११-४५<br><br>कामकार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮ್ಯಕರ್ಮವನ್ನು ಆಚರಿಸುವವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कामं काम्यं करोति<br><br>

कामकूट
कामकूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇಶ್ಯಾಪತಿ /ವಿಟಪುರುಷ /ಜಾರ<br><b>व्युत्पत्तिः - </b>कामः कूटं शृङ्गं प्रधानमस्य<br><br>कामकूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇಶ್ಯೆಯ ವಿಲಾಸ /ಸೂಳೆಯಹಾವಭಾವಾದಿಗಳು<br><b>विस्तारः - </b>"कामकूटस्तु वेश्यायाः प्रियविभ्रमयोः पुमान्" - मेदि० ।<br><br>

कामकृत्
कामकृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>कामं मोक्षादिकाम्यं करोति<br><b>प्रयोगाः - </b>"कामहा कामकृत् कान्तः कामः कामप्रदः प्रभुः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"स्वपादपद्मे रागादिकरणात् कामकृत् स्मृतः" - निरुक्तिः ।<br><br>कामकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟಾರ್ಥವನ್ನು ಕೊಡುವವನು<br><br>कामकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟಬಂದಂತೆ ಕೆಲಸ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>कामेन कष्टानुसारेण करोति<br><br>

कामकृत
कामकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟಬಂದಂತೆ ಮಾಡಲ್ಪಟ್ಟ /ಇಚ್ಛನುಸಾರ ಮಾಡಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>कामेन कृतः<br><br>कामकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಫಲೋದ್ದೇಶದಿಂದ ಮಾಡಲ್ಪಟ್ಟ /ಫಲಾಭಿಸಂಧಿಯಿಂದ ಮಾಡಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>कामेन कामनया कृतः<br><br>

कामकेलि
कामकेलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮಕ್ರೀಡೆ /ಸಂಭೋಗ /ಸ್ತ್ರೀಪುರುಷರ ಸಂಗಮ<br><b>व्युत्पत्तिः - </b>कामनिमित्ता केलिः<br><br>कामकेलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಾರ /ವಿಟಪುರುಷ /ವ್ಯಭಿಚಾರಿ<br><b>व्युत्पत्तिः - </b>कामे केलिर्यस्य<br><br>

कामक्रीडा
कामक्रीडा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸುರತಕ್ರೀಡೆ /ಸಂಭೋಗ /ರತಿಕ್ರೀಡೆ<br><b>व्युत्पत्तिः - </b>कामनिमित्ता क्रीडा<br><br>

कामग
कामग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿಯಿಂದ ಅಥವಾ ಸ್ವೇಚ್ಛೆಯಿಂದ ಸ್ತ್ರೀಸಂಭೋಗ ಮಾಡುವ ಪುರುಷ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "डः" (३-२-४८)<br><b>व्युत्पत्तिः - </b>कामेन अनुरागेन इच्छया वा गच्छति<br><br>कामग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟಬಂದಂತೆ ನಡೆಯುವ /ಸ್ವೇಚ್ಛೆಯಿಂದ ಹೋಗುವ<br><b>प्रयोगाः - </b>"विमानं पुष्पकं नाम कामगं च ददौ प्रभुः"<br><b>उल्लेखाः - </b>भा० वन० २७५-१७<br><br>

कामगा
कामगा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿಯಿಂದ ಪುರುಷನೊಡನೆ ಸಂಗಮಿಸುವ ಹೆಂಗಸು<br><br>कामगा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವೈರಿಣಿ /ವ್ಯಭಿಚಾರಿಣಿ<br><b>प्रयोगाः - </b>"पाषण्डानाश्रिताः स्तेना भतृघ्नः कामगादिकाः"<br><b>उल्लेखाः - </b>याज्ञ० ३-६<br><br>

कामगति
कामगति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಷ್ಟಾನುಸಾರ ನಡೆಯುವುದು /ಸ್ವೇಚ್ಛೆಯಿಂದ ಹೋಗುವಿಕೆ<br><b>व्युत्पत्तिः - </b>कामेन गतिः<br><br>कामगति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟಾನುಸಾರವಾಗಿ ನಡೆಯುವ /ತನ್ನ ಇಚ್ಛೆಯಂತೆ ಗಮನವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कामेन इच्छानुसारेण गतिः गमनं यस्य<br><b>प्रयोगाः - </b>"भयस्ततो रघुपतिर्विलसत्पताकमध्यास्त कामगतिसावरुजो विमानम्"<br><b>उल्लेखाः - </b>रघु० १३-७६<br><br>

कामगवी
कामगवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮಧೇನು<br><b>निष्पत्तिः - </b>"टच्" (५-४-९२)<br><b>व्युत्पत्तिः - </b>कामप्रदा गौः<br><b>प्रयोगाः - </b>"अनेन सर्वार्थिकृतार्थताकृताहृतार्थिनौ कामगवीसुरद्रुमौ"<br><b>उल्लेखाः - </b>नैष० १२-७९<br><br>

कामगामिन्
कामगामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವೇಚ್ಛೆಯಿಂದ ನಡೆಯುವ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>कामेन गच्छति<br><br>कामगामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟ ಬಂದಂತೆ ಸ್ತ್ರೀಗಮನ ಮಾಡುವವನು<br><b>विस्तारः - </b>ಇಲ್ಲಿ कामग ಎಂದು ಮಾಂತವಾದ ಅವ್ಯಯ. कामङ्गामी ಎಂದಗುವುದೂ. ಮತ್ತು स्त्रियाम् कामङ्गामिनी<br><br>

कामगिरि
कामगिरि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮರೂಪದೇಶದಲ್ಲಿರುವ ಒಂದು ಪರ್ವತ<br><b>प्रयोगाः - </b>"इन्द्रकीलः कामगिरिरिति चान्ये च शतसहस्रशः शैलाः"<br><b>उल्लेखाः - </b>भाग० ५-१९-१७<br><br>

कामगुण
कामगुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿ /ಅನುರಾಗ<br><b>व्युत्पत्तिः - </b>कामस्य कामकृतो वा गुणः<br><br>कामगुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ರಕ್ ಚಂದನಾದಿ ವಿಷಯಗಳು<br><br>कामगुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಿಪೂರ್ಣತೆ /ತುಂಬಿರುವಿಕೆ<br><b>विस्तारः - </b>"अथ कामगुणो रागे विषयाभोगयोरपि" - मेदि० ।<br><br>

कामचर
कामचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವೇಚ್ಛೆಯಿಂದಸಂಚರಿಸುವ<br><b>निष्पत्तिः - </b>चर (गतौ) - "टः" (३-२-१६)<br><b>व्युत्पत्तिः - </b>कामेन चरति<br><b>प्रयोगाः - </b>"तां नारदः कामचरः कदाचित् कन्यां किल प्रेक्ष्य पितुः समीपे"<br><b>उल्लेखाः - </b>कुमा० १-५०<br><br>

कामचरी
कामचरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವೇಚ್ಛೆಯಿಂದಸಂಚರಿಸುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

कामचार
कामचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವೇಚ್ಛೆಯಿಂದ ಸಂಚರಿಸುವುದು<br><b>व्युत्पत्तिः - </b>कामेन चारः<br><br>कामचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಟ್ಟಳೆಗಳಿಗೆ ಒಳಪಡದೆ ಸ್ವೇಚ್ಛೆಯಿಂದ ನಿಷಿದ್ಧ ಕಾರ್ಯ ಮಾಡುವಿಕೆ /ಇಷ್ಟಬಂದಂತೆ ನಡೆಯುವುದು<br><b>प्रयोगाः - </b>"कल्याणबुद्धेरतवा तवायं न कामचारो मयि शङ्कनीयः"<br><b>उल्लेखाः - </b>रघु० १४-६२<br><br>कामचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಷ್ಟಬಂದಂತೆ ಗೋವುಗಳನ್ನು ಮೇಯಿಸುವುದು<br><b>प्रयोगाः - </b>"पथि ग्रामविवीतान्ते क्षेत्रे दोषो न विद्यते । अकामतः कामचारे चौरवद्दण्दमर्हति ॥"<br><b>उल्लेखाः - </b>याज्ञ० २-१६२<br><br>

कामचारिन्
कामचारिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರುಡ<br><br>कामचारिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಬ್ಬಚ್ಚಿ<br><b>निष्पत्तिः - </b>चर (गतौ) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>कामेन चरति<br><br>कामचारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವೇಚ್ಛೆಯಾಗಿ ಸಂಚರಿಸುವ /ಇಷ್ಟಬಂದಂತೆ ಹೋಗುವ<br><b>प्रयोगाः - </b>"तस्योत्सङ्गे प्रणयिन इव स्रस्तगङ्गादुकूलां न त्वं दृष्ट्वा न पुनरलकां ज्ञास्यसे कामचारिन्"<br><b>उल्लेखाः - </b>मेघ० १-६३<br><br>

कामज
कामज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮನ ಮಗ /ಅನಿರುದ್ಧ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>कामात् जायते<br><b>विस्तारः - </b>ಜ್ಯೇಷ್ಠಪುತ್ರನು ಜನಿಸಿ ಪಿತೃ ಋಣವನ್ನು ತೀರಿಸುವುದರಿಂದ ಅನಂತರ ಹುಟ್ಟುವ ಮಕ್ಕಳೆಲ್ಲರೂ ಕಾಮಜರು.<br><br>कामज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮತೃಪ್ತಿಗಾಗಿ ನಡೆಯುವ ಸಂಭೋಗದಿಂದ ಹುಟ್ಟುವ ಮಗ<br><b>प्रयोगाः - </b>"ज्येष्ठेन जातमात्रेण पुत्री भवति मानवः । पितॄणामनृणश्चैव स तस्मात्सर्वमर्हति । यस्मिन् ऋणं सन्नयति येन चानन्त्यमश्नुते । स एव धर्मजः पुत्रः कामजानितरान् विदुः ॥"<br><b>उल्लेखाः - </b>मनु० ९-१०६, १०७<br><br>कामज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಖಾಪೇಕ್ಷೆಯಿಂದ ಉಂಟಾಗುವ ೧೦ ವ್ಯಸನಗಳು<br><b>प्रयोगाः - </b>"कामजेषु प्रसक्तो हि व्यसनेषु महीपतिः । वियुज्यतेऽर्थधर्माभ्यां क्रोधजेष्वात्मनैव च ॥"<br><b>उल्लेखाः - </b>मनु० ७-४६<br><b>विस्तारः - </b>"मृगयाक्षी दिवास्वापः परिवादः स्त्रियो मदः । तौर्यत्रिकं वृथाटाट्या कामजो दशको गणः ॥" ಬೇಟೆ, ಜೂಜಾಟ, ಹಗಲು ನಿದ್ರೆ, ಇತರರ ದೂಷಣೆ, ಹೆಂಗಸರೊಡನೆ ವಿಹಾರ, ಮದ್ಯಪಾನದಿಂದುಂಟಾಗುವ ಅಮಲು, ನೃತ್ಯ ಗೀತ ವಾದ್ಯಗಳು, ವ್ಯರ್ಥವಾದ ಸಂಚಾರ - ಇವು ೧೦ ವ್ಯಸನಗಳು.<br><br>

कामजनि
कामजनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><b>व्युत्पत्तिः - </b>कामस्य जनिरस्मात्<br><br>

कामजित्
कामजित्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾದೇವ /ಪರಮೇಶ್ವರ<br><b>निष्पत्तिः - </b>जि (जये) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>कामं जयति<br><br>कामजित्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ತಿಕೇಯ /ಷಣ್ಮುಖ<br><b>व्युत्पत्तिः - </b>कामं रूपेण जयति<br><br>कामजित्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಿನದೇವ<br><b>व्युत्पत्तिः - </b>कामं कामव्यापारं जयति<br><br>

कामण्डलेय
कामण्डलेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಂಡಲುವಿನ ಮಗ<br><b>निष्पत्तिः - </b>"ढञ्" (४-१-१३५)<br><b>व्युत्पत्तिः - </b>कमण्दलोरपत्यम्<br><b>विस्तारः - </b>ಇದು ಒಂದು ಚತುಷ್ಪಾದ ಜಂತು.<br><br>

कामतस्
कामतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸ್ವೇಚ್ಛೆಯಾಗಿ /ಇಷ್ಟ ಬಂದಂತೆ<br><b>प्रयोगाः - </b>"कृत्यवस्तुषु नियुङ्क्ष्व कामतः"<br><b>उल्लेखाः - </b>माघ० १४-१५<br><br>

कामताल
कामताल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><b>निष्पत्तिः - </b>ताल (प्रतिष्ठायाम्) + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कामं तालयति<br><b>विस्तारः - </b>"मधुकण्ठो घोषयित्नुः कामतालः सुतर्दनः" - त्रिकाण्ड० ।<br><br>

कामतिथि
कामतिथि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮನ ಪೂಜೆಗೆ ಯೋಗ್ಯವಾದ ತಿಥಿ<br><br>कामतिथि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮದೇವತಾಕವಾದ ತಿಥಿ /ತ್ರಯೋದಶಿ ತಿಥಿ<br><b>व्युत्पत्तिः - </b>कामपूजार्हा तिथिः कामदेवताकः तिथिर्वा<br><br>

कामद
कामद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರ /ಪರಮಾತ್ಮ<br><br>कामद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟಾರ್ಥವನ್ನು ಕೊಡತಕ್ಕವನು<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>काममभीष्टं ददाति<br><br>

कामदा
कामदा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮಧೇನು<br><b>विस्तारः - </b>"कामदा कामधेनौ स्त्री कामदातरि वाच्यवत्" - मेदि० ।<br><br>

कामदुघ
कामदुघ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಷ್ಟಾರ್ಥವನ್ನು ಕೊಡುವ /ಬೇಡಿದುದನ್ನು ನೀಡುವ<br><b>निष्पत्तिः - </b>दुह (प्रपूरणे) - "कप्" घादेशश्च (३-२-७०)<br><b>व्युत्पत्तिः - </b>कामान् दोग्धि<br><br>

कामदुघा
कामदुघा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಷ್ಟಾರ್ಥವನ್ನು ಕೊಡುವ /ಬೇಡಿದುದನ್ನು ನೀಡುವ<br><b>प्रयोगाः - </b>"आराधय सपत्नीकः प्रीता कामदुघा हि सा"<br><b>उल्लेखाः - </b>रघु० १-८१<br><br>कामदुघा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮಧೇನು<br><br>

कामदुह्
कामदुह्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟಾರ್ಥವನ್ನು ಕೊಡುವ /ಬೇಡಿದುದನ್ನು ನೀಡುವ<br><b>निष्पत्तिः - </b>दुह (प्रपूरणे) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>कामान् दोग्धि<br><b>प्रयोगाः - </b>"एकः शब्दः सुष्ठु प्रयुक्तः सम्यक् ज्ञातः स्वर्गे लोके कामघुक् भवति" । "सह यज्ञैः प्रजाः सृष्ट्वा पुरोवाच प्रजापतिः । अनेन प्रसविष्यद्वमेष वोऽस्त्विष्टकामघुक् ॥"<br><b>उल्लेखाः - </b>श्रुतिः, गीता० ३-१०<br><br>

कामदूती
कामदूती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಕೋಗಿಲೆ<br><br>

कामदेव
कामदेव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ಪರಮಾತ್ಮ<br><b>निष्पत्तिः - </b>दिवु (क्रीडादौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>काम्यते मोक्षकाङ्क्षिभिः इति कामः । तथाभूतः सन् दीव्यति<br><b>प्रयोगाः - </b>"कामदेवः कामपालः कामी कान्तः कृतागमः"<br><b>उल्लेखाः - </b>वि० स०<br><br>कामदेव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥ<br><br>

कामधर
कामधर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮರೂಪದೇಶದಲ್ಲಿರುವ ಒಂದು ಸರೋವರ<br><br>

कामधेनु
कामधेनु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಕಲ ಇಷ್ಟಾರ್ಥಗಳನ್ನೂ ಕೊಡುವ ಸ್ವರ್ಗಲೋಕದ ಧೇನು /ಇಂದ್ರನ ಆಕಳು<br><b>व्युत्पत्तिः - </b>कामस्य धेनुः<br><b>प्रयोगाः - </b>"रोहणः किमपि यः कठिनानां कामधेनुरपि या पशुरेव"<br><b>उल्लेखाः - </b>नैष० ५-१२५<br><br>कामधेनु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷನ ಪುತ್ರಿಯಾದ ಸುರಭಿಯ ಮಗಳು ರೋಹಿಣಿಯಲ್ಲಿ ಜನಿಸಿದ ಒಂದು ಧೇನು<br><b>प्रयोगाः - </b>"कामधेनुरिति ख्याता सर्वलक्षणसंयुता । सा सिताभ्रप्रतीकाशा चतुर्वेदचतुष्पदा । स्तनैश्चतुर्भिः धर्मार्थकामप्रसवकारिणी ॥"<br><b>उल्लेखाः - </b>कालिकापु०<br><br>कामधेनु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮಧೇನುವಿನ ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದ ವಸಿಷ್ಠ ಮಹರ್ಷಿಯ ಹೋಮಧೇನುವಾದ ನಂದಿನೀಧೇನು<br><br>

कामध्वंसिन्
कामध्वंसिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾದೇವ /ಪರಮೇಶ್ವರ<br><b>निष्पत्तिः - </b>ध्वंसु (अवस्रंसने) + णिच् - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कामं ध्वंसयति<br><br>

कामन
कामन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮುಕ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) + णिङ् - "युच्" (उ० २-७९)<br><b>व्युत्पत्तिः - </b>कामयते<br><br>कामन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಲಾಷೆ /ಬಯಕೆ /ಇಚ್ಛೆ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) + णिङ् - भावे "ल्युट्" (३-३-११५)<br><br>

कामना
कामना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಭಿಲಾಷೆ /ಬಯಕೆ /ಇಚ್ಛೆ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) + णिङ् - "युच्" (३-३-१०७)<br><b>प्रयोगाः - </b>"शिखी विधाय त्वदवाप्तिकामनां स्वयंहुतस्वांशहविः स्वमूर्तिषु"<br><b>उल्लेखाः - </b>नैष० ९-७५<br><br>

कामनीयक
कामनीयक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಮಣೀಯತೆ /ಮನೋಹರವಾಗಿರುವಿಕೆ /ಸೌಂದರ್ಯ<br><b>निष्पत्तिः - </b>"वुञ्" (५-१-१३२)<br><b>व्युत्पत्तिः - </b>कमनीयस्य भावः<br><b>प्रयोगाः - </b>"निवेद्यमानं वनपालपाणिना व्यलोकयत् काननकामनीयकम्"<br><b>उल्लेखाः - </b>नैष० १-७६<br><br>

कामन्दकि
कामन्दकि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಂದಕ ಋಷಿಯ ಮಗ<br><b>निष्पत्तिः - </b>"इञ्" (४-१-९५)<br><b>व्युत्पत्तिः - </b>कमन्दकस्यापत्यम्<br><b>विस्तारः - </b>ಕಾಮಂದಕೀಯ ನೀತಿಶಾಸ್ತ್ರವು ಈತನಿಂದ ರಚಿತವಾಯಿತು.<br><br>

कामन्दकी
कामन्दकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಲತೀಮಾಧವದಲ್ಲಿ ಬರುವ ಒಬ್ಬ ಪರಿವ್ರಾಜಿಕೆ<br><br>

कामन्दकीय
कामन्दकीय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮಂದಕೀ ನೀತಿಶಾಸ್ತ್ರ /ಕಾಮಂದಕಿಯಿಂದ ರಚಿತವಾದ ಒಂದು ನೀತಿಶಾಸ್ತ್ರ<br><b>निष्पत्तिः - </b>"छः" (४-२-११४)<br><b>व्युत्पत्तिः - </b>कमन्दकेः इदम्<br><br>

कामपत्नी
कामपत्नी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥನ ಪತ್ನಿ /ರತಿ<br><b>व्युत्पत्तिः - </b>कामस्य पत्नी<br><br>

कामपाल
कामपाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲರಾಮ<br><b>निष्पत्तिः - </b>पाल (रक्षणे) + णिच् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कामान् पालयति<br><b>प्रयोगाः - </b>"तौ परस्परगवेषितरन्ध्रौ कामपालकपिसैनिकपालौ"<br><b>उल्लेखाः - </b>याद० २१-५४<br><br>कामपाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀವಾಸುದೇವ /ಶ್ರೀಕೃಷ್ಣ<br><b>प्रयोगाः - </b>"कामदेवः कामपालः कामी कान्तः कृतागमः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"दत्वा तु पालनकरः कामपालः प्रकीर्तितः" - निरुक्तिः ।<br><br>कामपाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾದೇವ /ಪರಮೇಶ್ವರ<br><br>कामपाल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟಾರ್ಥಗಳನ್ನು ಕೊಟ್ಟು ಸಂತೋಷಪಡಿಸುವ<br><br>

कामपूर
कामपूर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ /ಪರಮೇಶ್ವರ<br><b>निष्पत्तिः - </b>पूरी (आप्यायने) + णिच् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कामान् पूरयति<br><br>कामपूर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟಾರ್ಥಗಳನ್ನು ಪೂರೈಸುವವನು<br><br>

कामप्रद
कामप्रद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ಪರಮಾತ್ಮ<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "कः" (३-२-६)<br><b>व्युत्पत्तिः - </b>कामान् प्रकर्षेण ददाति<br><b>प्रयोगाः - </b>"कामहा कामकृत् कान्तः कामः कामप्रदः प्रभुः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"कामप्रदः प्रकर्षेण भक्तानां कामदायकः" - निरुक्तिः ।<br><br>कामप्रद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುರತಬಂಧದ ಒಂದು ಭೇದ<br><b>प्रयोगाः - </b>"द्वौ पादौ स्कन्धसंलग्नौ क्षिप्ता लिङ्गं भगे तथा । कामयेत् कामुकः प्रीत्या बन्धः कामप्रदो हि सः ॥"<br><b>उल्लेखाः - </b>स्मरदी०<br><br>कामप्रद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟಾರ್ಥವನ್ನು ಕೊಡುವ<br><br>

कामप्रवेदन
कामप्रवेदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆಯನ್ನು ತಿಳಿಸುವಿಕೆ /ಅಭಿಪ್ರಾಯವನ್ನು ತಿಳಿಸುವಿಕೆ /ತನಗೆ ಬೇಕಾದುದನ್ನು ತಿಳಿಸುವುದು<br><b>व्युत्पत्तिः - </b>कामस्य अभिलाषस्य प्रवेदनम्<br><b>प्रयोगाः - </b>"कामप्रवेदनेऽकच्चिति"<br><b>उल्लेखाः - </b>पा० सू० ३-३-१५३<br><br>

कामप्रश्न
कामप्रश्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಕಾದ ಹಾಗೆ ಪ್ರಶ್ನಿಸುವುದು /ಇಷ್ಟಬಂದಂತೆ ಕೇಳುವುದು<br><b>व्युत्पत्तिः - </b>कामं यथेष्टं प्रश्नः<br><br>

कामबाधा
कामबाधा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥನ ಪೀಡೆ<br><br>

काममह
काममह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೈತ್ರ ಮಾಸದಲ್ಲಿ ನಡೆಸುವ ವಸಂತೋತ್ಸವ /ಮದನೋತ್ಸವ<br><b>व्युत्पत्तिः - </b>कामस्य महः<br><b>विस्तारः - </b>"चैत्रावल्यां मधूत्सवः । सुवसन्तः काममहः वासन्ती कार्दमी स्त्रियौ" - त्रिकाण्ड० ।<br><br>

काममुद्रा
काममुद्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಂತ್ರೋಕ್ತವಾದ ಒಂದು ಮುದ್ರೆ<br><b>विस्तारः - </b>"हस्तौ तु सम्पुटौ कृत्वा प्रसृताङ्गुलिकौ तथा । तर्जन्यौ मध्यमापृष्ठे अङ्गुष्ठौ मध्यमाश्रितौ । काममुद्रेयमुदिता सर्वदेवप्रियङ्करी ॥"<br><br>

कामयमान
कामयमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮಿಸುತ್ತಿರುವವನು /ಪ್ರೀತಿಸುತ್ತಿರುವವನು<br><b>निष्पत्तिः - </b>कमु (कान्तौ) + णिङ् - "शानच्" (३-२-१२४) । मुमागमः (७-२-८२)<br><b>व्युत्पत्तिः - </b>कामयते<br><br>कामयमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮುಕ<br><br>

कामयान
कामयान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸುವವನು /ಬಯಸುವವನು<br><b>निष्पत्तिः - </b>कमु (कान्तौ) + णिङ् - "शानच्" (३-२-१२४)<br><br>कामयान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮುಕ<br><b>प्रयोगाः - </b>"राजयक्ष्मपरिहानिराययौ कामयानसमवस्थया तुलाम्"<br><b>उल्लेखाः - </b>रघु० १९-५०<br><br>

कामयितृ
कामयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮುಕ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) + णिङ् - "तृच्" (३-१-१३३)<br><br>कामयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸುವ /ಬಯಸುವ /ಇಚ್ಛಿಸುವ<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>

कामयित्री
कामयित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कामयितृ ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कामरूप
कामरूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮರೂಪದೇಶ<br><b>प्रयोगाः - </b>"कालेश्वरं श्वेतगिरिं त्रैपुरं नीलपर्वतम् । यावत् कामरूपाभिधो देशः गणेशगिरिमूर्धनि ॥" "तमीशः कामरूपाणामत्याखण्डलविक्रमम्"<br><b>उल्लेखाः - </b>२) रघु० ४-८३<br><br>कामरूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮರೂಪ ದೇಶದ ಜನರು<br><br>कामरूप<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥನ ಆಕಾರ<br><br>कामरूप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಂದರವಾದ ರೂಪವುಳ್ಳ<br><br>कामरूप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟಬಂದಂತೆ ರೂಪವನ್ನು ತಾಳುವ<br><b>व्युत्पत्तिः - </b>कामं काम्यं सुन्दरं रूपं यस्य<br><b>प्रयोगाः - </b>"जानामि त्वां प्रकृतिपुरुषं कामरूपं मघोनः"<br><b>उल्लेखाः - </b>मेघ० १-६<br><br>

कामरूपिन्
कामरूपिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿದ್ಯಾಧರ<br><br>कामरूपिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟಬಂದಂತೆ ರೂಪವನ್ನು ತಾಳುವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कामेन इष्टानुसारेण रूपमस्त्यस्य<br><b>प्रयोगाः - </b>"सर्वमाशु निचेतव्यं हरिभिः कामरूपिभिः"<br><b>उल्लेखाः - </b>रामा०<br><br>कामरूपिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಂದರವಾದ ರೂಪವುಳ್ಳ<br><br>

कामरेखा
कामरेखा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇಶ್ಯೆ /ಸೂಳೆ<br><b>व्युत्पत्तिः - </b>कामानां कामव्यापाराणां रेखा पङ्क्तिर्यत्र<br><br>

कामल
कामल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸಂತಕಾಲ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) + णिङ् - "कलः" (उ० १-१०६)<br><br>कामल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರುದೇಶ /ನಿರ್ಜಲ ಪ್ರದೇಶ<br><br>कामल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮುಕ /ವಿಷಯಲಂಪಟ<br><br>

कामल|कामला
कामल - कामला<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮಾಲೆ ರೋಗ<br><br>

कामलता
कामलता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುರುಷನ ಚಿಹ್ನೆ /ಲಿಂಗ /ಶಿಶ್ನ<br><b>व्युत्पत्तिः - </b>कामस्य लता<br><br>

कामलिन्
कामलिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮಾಲೆ ರೋಗವುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कामलाऽस्त्यस्य<br><br>

कामवत्
कामवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭಿಲಾಷೆಯುಳ್ಳವನು /ಅಪೇಕ್ಷೆಯುಳ್ಳವನು /ಬಯಕೆಯುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>कामोऽस्त्यस्य<br><br>कामवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ತ್ರೀ ಸಂಭೋಗದಲ್ಲಿ ಪ್ರೀತಿಯುಳ್ಳವನು<br><br>

कामवती
कामवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कामवत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कामवल्लभ
कामवल्लभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸಂತಕಾಲ<br><br>कामवल्लभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾವಿನ ಮರ<br><b>व्युत्पत्तिः - </b>कामस्य वल्लभः प्रियः<br><br>

कामवल्लभा
कामवल्लभा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರಿಕೆ /ಬೆಳದಿಂಗಳು<br><br>

कामवृत्त
कामवृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮವ್ಯಾಪಾರವುಳ್ಳ /ಹೆಂಗಸರಲ್ಲಿ ಅನುರಾಗವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कामस्य वृत्तं यस्य<br><b>प्रयोगाः - </b>"विशीलः कामवृत्तो वा गुणैर्वा परिवर्जितः । उपचर्यः स्त्रिया साध्व्या सततं देववत्पतिः ॥"<br><b>उल्लेखाः - </b>मनु० ५-१५४<br><br>कामवृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವೇಚ್ಛಾಚಾರವುಳ್ಳ /ಇಷ್ಟಬಂದಂತೆ ನಡೆಯುವ /ತೋರಿದಂತೆ ಕೆಲಸ ಮಾಡುವ<br><b>व्युत्पत्तिः - </b>कामं यथेष्टं वृत्तं व्यापारो यस्य<br><b>प्रयोगाः - </b>"यस्तु स्यात् क्षत्रियः पार्थ कामवृत्तः परन्तप"<br><b>उल्लेखाः - </b>भा० आदि० १५९-६२<br><br>

कामवृत्ति
कामवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮಚೇಷ್ಟೆ /ಮನ್ಮಥನ ವ್ಯಾಪಾರ<br><b>व्युत्पत्तिः - </b>कामस्य वृत्तिः<br><br>कामवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವೇಚ್ಛಾವ್ಯಾಪಾರ /ಇಷ್ಟಬಂದಂತೆ ಕೆಲಸ ಮಾಡುವುದು<br><b>व्युत्पत्तिः - </b>कामेन इच्छानुसारेण वृत्तिः<br><br>कामवृत्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವೇಚ್ಛಾವ್ಯಾಪಾರವುಳ್ಳ /ತನ್ನ ಇಷ್ಟದಂತೆ ವ್ಯವಹರಿಸುವ<br><b>व्युत्पत्तिः - </b>कामेन स्वेच्छया वृत्तिर्यस्य<br><b>प्रयोगाः - </b>"ममात्र भावैकरसं मनः स्थितं न कामवृत्तिर्वचनीयमीक्षते"<br><b>उल्लेखाः - </b>कुमा० ५-८२<br><br>

कामशर
कामशर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥನ ಬಾಣ<br><br>कामशर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾವಿನ ಮರ<br><b>व्युत्पत्तिः - </b>कामस्य शर इव<br><br>

कामशासन
कामशासन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ /ಶಿವ<br><b>निष्पत्तिः - </b>शासु (अनुशिष्टौ) - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कामं शास्ति<br><br>

कामशास्त्र
कामशास्त्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತ್ರೀಪುರುಷರ ಅನುರಾಗವನ್ನು ತಿಳಿಸುವ ಒಂದು ಶಾಸ್ತ್ರ<br><b>व्युत्पत्तिः - </b>कामस्य कामव्यापारस्य प्रतिपादकं शास्त्रम्<br><br>कामशास्त्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ್ಯ ವಿಷಯಗಳನ್ನು ಪ್ರತಿಪಾದಿಸುವ ಶಾಸ್ತ್ರ<br><b>व्युत्पत्तिः - </b>कामस्य काम्यस्य स्वर्गादेः प्रतिपादकं शास्त्रम्<br><b>प्रयोगाः - </b>"अर्थशास्त्रमिदं प्रोक्तं धर्मशास्त्रमिदं महत् । कामशास्त्रमिदं प्रोक्तं व्यासेनामितबुद्धिना ॥"<br><b>उल्लेखाः - </b>भा० आदि० २-३८३<br><br>

कामसख
कामसख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸಂತ ಕಾಲ<br><br>कामसख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾವಿನ ಮರ<br><br>कामसख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೈತ್ರ ಮಾಸ<br><b>निष्पत्तिः - </b>"टच्" (५-४-९१)<br><b>व्युत्पत्तिः - </b>कामस्य सखा<br><br>

कामसुत
कामसुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥನ ಮಗ /ಅನಿರುದ್ಧ<br><b>व्युत्पत्तिः - </b>कामस्य सुतः<br><br>

कामसू
कामसू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣ /ವಾಸುದೇವ<br><br>कामसू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರುಕ್ಮಿಣಿ<br><br>कामसू<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭೀಷ್ಟವಾದುದನ್ನು ಕೊಡುವ /ಇಷ್ಟಾರ್ಥವನ್ನು ಉಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>षूङ् (प्राणिगर्भविमोचने) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>कामं सूते<br><br>

कामसूत्र
कामसूत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮವ್ಯಾಪಾರಗಳನ್ನು ಹೇಳುವ ಸೂತ್ರ /ಸ್ತ್ರೀಪುರುಷರ ಶೃಂಗಾರ ಚೇಷ್ಟೆಗಳನ್ನು ತಿಳಿಸುವ ವಾತ್ಸ್ಯಾಯನ ಕೃತವಾದ ಒಂದು ಗ್ರಂಥ<br><b>व्युत्पत्तिः - </b>कामस्य मन्मथव्यापारस्य प्रतिपादकं शास्त्रम्<br><b>प्रयोगाः - </b>"हासभूषणरवाश्च रमण्याः कामसूत्रपदतामुपजग्मुः"<br><b>उल्लेखाः - </b>माघ० १०-७५<br><br>

कामस्तुति
कामस्तुति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮವನ್ನು ಸ್ತೋತ್ರ ಮಾಡುವ ಒಂದು ಮಂತ್ರ /ದಾನಿಯು ಕೊಟ್ಟ ದಾನವನ್ನು ಪ್ರತಿಗ್ರಹಿಸುವ ದೋಷಪರಿಹಾರಕ್ಕಾಗಿ ಹೇಳುವ ಯಜುರ್ವೇದದ ಒಂದು ಮಂತ್ರ<br><b>व्युत्पत्तिः - </b>कामस्य स्तुतिः<br><br>

कामहन्
कामहन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ಪರಮಾತ್ಮ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) - "क्विप्" (३-२-८७)<br><b>व्युत्पत्तिः - </b>कामं हतवान्<br><b>प्रयोगाः - </b>"कामहा कामकृत् कान्तः कामः कामप्रदः प्रभुः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"पुंसां स्वदर्शिन्यां योऽसौ स्पृहां च विषयान्तरे । हतवान् कामहा प्रोक्तः सर्वाशापूरको मनुः ॥" - निरुक्तिः ।<br><br>कामहन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ /ಶಿವ<br><br>

कामाक्षी
कामाक्षी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿಯ ಒಂದು ಮುರ್ತಿ<br><b>निष्पत्तिः - </b>"षच्" (५-४-११३)<br><b>व्युत्पत्तिः - </b>कामं सुन्दरमक्षि यस्याः<br><br>

कामाग्नि
कामाग्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮಾತುರತೆ /ಕಾಮೋದ್ರೇಕ /ಮನೋವಿಕಾರ /ಸಂಭೋಗದ ಆಸೆ<br><br>

कामाङ्कुश
कामाङ्कुश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಖ /ಉಗುರು<br><b>व्युत्पत्तिः - </b>कामे अङ्कुश इव उद्दिपकत्वात्<br><br>कामाङ्कुश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುರುಷನ ಚಿಹ್ನೆ /ಲಿಂಗ /ಶಿಶ್ನ<br><b>व्युत्पत्तिः - </b>कामस्याङ्कुश इव<br><br>

कामातुर
कामातुर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನ್ಮಥನಿಂದ ಪೀಡಿತನಾದ /ಕಾಮೋದ್ರೇಕವುಳ್ಳ /ಕಾಮರೋಗದಿಂದ ಕೂಡಿದ<br><b>व्युत्पत्तिः - </b>कामेन आतुरः<br><b>प्रयोगाः - </b>"कामातुराणां न भयं न लज्जा"<br><br>

कामात्मज
कामात्मज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮನ ಮಗ /ಅನಿರುದ್ಧ<br><b>व्युत्पत्तिः - </b>कामस्यात्मजः<br><br>

कामात्मता
कामात्मता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಫಲಾಪೇಕ್ಷೆಯಿಂದ ಕೂಡಿದ ಸ್ವಭಾವ<br><b>व्युत्पत्तिः - </b>कामप्रधानः इच्छाप्रधानः आत्मा यस्य । तस्य भावः<br><br>कामात्मता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುರಾಗದಿಂದ ಕೂಡಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कामप्रधानः अनुरागप्रधानः आत्मा यस्य तस्य भावः<br><b>प्रयोगाः - </b>"कामात्मता न प्रशस्ता न चैवेहास्त्यकामता"<br><b>उल्लेखाः - </b>मनु० २-२<br><br>

कामात्मन्
कामात्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುರಾಗಪ್ರಧಾನವಾದ ಆತ್ಮವುಳ್ಳ<br><br>कामात्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಷಯಾಸಕ್ತಿಯಿಂದ ತುಂಬಿದ ಚಿತ್ತವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कामप्रधानः आत्मा यस्य<br><br>कामात्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಫಲಾಪೇಕ್ಷೆಯಿಂದ ಕೂಡಿದ ಮನಸ್ಸುಳ್ಳ /ಫಲವನ್ನು ಅಪೇಕ್ಷಿಸಿ ಕರ್ಮ ಮಾಡುವ ಸ್ವಭಾವವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>काम्येषु कामेषु कर्मसु आत्मा यस्य<br><b>प्रयोगाः - </b>"कामात्मानः स्वर्गपराः जन्मकर्मफलप्रदाम्"<br><b>उल्लेखाः - </b>गीता० २-४३<br><br>

कामाधिष्ठान
कामाधिष्ठान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯ /ಮನಸ್ಸು ಮತ್ತು ಬುದ್ಧಿ<br><b>व्युत्पत्तिः - </b>काम्स्याधिष्ठानम्<br><b>प्रयोगाः - </b>"इन्द्रियाणि मनोबुद्धिरस्याधिष्ठानमुच्यते"<br><b>उल्लेखाः - </b>गीता० ३-४०<br><br>

कामन्ध
कामन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><b>निष्पत्तिः - </b>अन्ध + णिच् नामधा० - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कामेन कामोद्दीपनेन अन्धयति<br><br>कामन्ध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮೋದ್ರೇಕದಿಂದ ಜ್ಞಾನಶೂನ್ಯನಾದ<br><b>व्युत्पत्तिः - </b>कामेन रागेण अन्धः विवेकशून्यः<br><br>

कामान्धा
कामान्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮೋದ್ರೇಕದಿಂದ ಜ್ಞಾನಶೂನ್ಯಳಾದ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्" (४-१-४)<br><b>प्रयोगाः - </b>"कामान्धा राक्षसी सा पतिमतिमतनोत् मैथिलीप्राणनाथे"<br><b>उल्लेखाः - </b>चं० रा०<br><br>कामान्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಸ್ತೂರಿ /ಮೃಗಮದ<br><b>निष्पत्तिः - </b>अन्ध + णिच् नामधा० - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कामं यथेष्टं अन्धयति<br><br>कामान्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ಯೇನ /ಗಿಡಗ ಹಕ್ಕಿ<br><br>

कामायुध
कामायुध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾವಿನ ಮರ<br><b>व्युत्पत्तिः - </b>कामस्यायुधमिव मुकुले आकारोऽस्त्यस्य<br><br>कामायुध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥನ ಆಯುಧ<br><br>

कामायुस्
कामायुस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಥೇಷ್ಟವಾದ ಆಯಸ್ಸುಳ್ಳ ಗರುಡ<br><b>व्युत्पत्तिः - </b>कामं यथेष्टमायुर्यस्य<br><br>

कामारि
कामारि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><b>व्युत्पत्तिः - </b>कामस्यारिः<br><br>

कामार्त
कामार्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮಪೀಡಿತನಾದ /ಕಾಮಬಾಧೆಯನ್ನು ಅನುಭವಿಸುತ್ತಿರುವ /ಕಾಮರೋಗವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कामेनार्तः<br><b>प्रयोगाः - </b>"कामार्ता हि प्रकृतिकृपणाश्चेतनाचेतनेषु"<br><b>उल्लेखाः - </b>मेघ० १-५<br><br>

कामालिका
कामालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸುರೆ /ಮದ್ಯ<br><b>निष्पत्तिः - </b>अल (भूषणादौ) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>काममलति<br><br>

कामावशाय
कामावशाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವೇಚ್ಛೆಯಿಂದ ವಿಷಯಗಳನ್ನು ಅಥವಾ ಅಪೇಕ್ಷೆಗಳನ್ನು ಮನಸ್ಸಿನಲ್ಲೇ ಅಡಗಿಸಿಕೊಳ್ಳುವುದು /ಅನುರಾಗವನ್ನು ನಿಗ್ರಹಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>अव + शीङ् (स्वप्ने) - "घञ्" (३-३-१८)<br><b>व्युत्पत्तिः - </b>कामेन अवशय्यते<br><br>

कामावशायिता
कामावशायिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವೇಚ್ಛೆಯಿಂದ ವಿಷಯಗಳನ್ನು ಅಥವಾ ಅಪೇಕ್ಷೆಗಳನ್ನು ಮನಸ್ಸಿನಲ್ಲೇ ಅಡಗಿಸಿಕೊಳ್ಳುವುದು /ಸತ್ಯಸಂಕಲ್ಪತ್ವರೂಪವಾದ ಯೋಗಿಗಳ ಒಂದು ಐಶ್ವರ್ಯ<br><b>निष्पत्तिः - </b>अव + शीङ् (स्वप्ने) + णिच् - "णिनिः" (३-१-१३४) । "तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कामेन इच्छया अवशाययति । तस्य भावः ।<br><br>

कामावशायित्व
कामावशायित्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವೇಚ್ಛೆಯಿಂದ ವಿಷಯಗಳನ್ನು ಅಥವಾ ಅಪೇಕ್ಷೆಗಳನ್ನು ಮನಸ್ಸಿನಲ್ಲೇ ಅಡಗಿಸಿಕೊಳ್ಳುವುದು /ಸತ್ಯಸಂಕಲ್ಪತ್ವರೂಪವಾದ ಯೋಗಿಗಳ ಒಂದು ಐಶ್ವರ್ಯ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

कामावशायिन्
कामावशायिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವೇಚ್ಛೆಯಿಂದ ಎಲ್ಲಾ ವಿಧ ಕಾಮಗಳನ್ನೂ ನಿಗ್ರಹಿಸಿಕೊಳ್ಳುವ ಯೋಗಿ<br><b>निष्पत्तिः - </b>अव + शीङ् (स्वप्ने) + णिच् - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कामेन इच्छया अवशाययति<br><br>

कामावसायिता
कामावसायिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कामावशायिता ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अव + षो (अन्तकर्मणि) - "णिनिः" (३-१-१३४) । "तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कामेन स्वेच्छया अवस्यति सर्वाणि वस्तूनि । तस्य भावः<br><br>

कामावसायित्व
कामावसायित्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>कामावशायिता ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

कामावसायिन्
कामावसायिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>कामावशायिन् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>अव + षो (अन्तकर्मणि) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कामान् अवस्यति<br><br>

कामासक्त
कामासक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷೆಗಳನ್ನು ಪೂರಯಿಸುವ ಆಶಯವುಳ್ಳ<br><br>कामासक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮದಲ್ಲಿ ಆಸಕ್ತಿಯುಳ್ಳವನು /ಸ್ರಕ್ ಚಂದನಾದಿ ವಿಷಯಗಳಲ್ಲಿ ಅಭಿರುಚಿಯುಳ್ಳವನು<br><br>कामासक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮುಕ<br><b>व्युत्पत्तिः - </b>कामेषु आसक्तः<br><br>

कामि
कामि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮುಕ /ಕಾಮವುಳ್ಳವನು /ಸಂಭೋಗದಲ್ಲಿ ಆಸೆಯುಳ್ಳವನು<br><br>कामि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರತಿ /ಮನ್ಮಥನ ಪತ್ನಿ<br><b>विस्तारः - </b>"कामिर्ना कामुके रत्यां स्त्री" - मेदि० ।<br><br>

कामिका
कामिका<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಕೋಳಿ /ಬಾತುಕೋಳಿ<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कामोऽस्त्यस्य<br><br>कामिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶೈವಾಗಮದ ೨೮ ಗ್ರಂಥಗಳಲ್ಲಿ ಒಂದು ಆಗಮಗ್ರಂಥ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>कामिका<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮ್ಯ /ಅಪೇಕ್ಷಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"देवतास्तस्य तुष्यन्ति कामिकं तस्य सिध्यति"<br><b>उल्लेखाः - </b>भा० अनु०<br><br>कामिका<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮದಿಂದ ನಡೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"ठञ्" (४-२-६८)<br><b>व्युत्पत्तिः - </b>कामेन निवृत्तम्<br><br>

कामित
कामित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಚ್ಛೆ /ಅಪೇಕ್ಷೆ /ಬಯಕೆ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) + णिङ् - भावे "क्तः" (३-३-११४)<br><br>कामित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುರಾಗ /ಪ್ರೀತಿ<br><b>प्रयोगाः - </b>"स्फुटमभिलषितं बभूव वध्वा वदति हि संवृतिरेव कामितानि"<br><b>उल्लेखाः - </b>किरा० १०-४४<br><br>कामित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಟ್ಟ /ಬಯಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) + णिङ् - "क्तः" (३-२-१०२)<br><br>

कामिन्
कामिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪತಿ /ಗಂಡ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कामोऽस्यास्ति<br><b>प्रयोगाः - </b>"हूतायाः प्रतिसखि कामिनान्यनाम्ना ह्रीमत्याः सरसि गलन्मुखेन्दुकान्तेः"<br><b>उल्लेखाः - </b>माघ० ८-४२<br><br>कामिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ಪರಮಾತ್ಮ<br><b>प्रयोगाः - </b>"कामदेवः कामपालः कामी कान्तः कृतागमः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"प्रदेयातिशयात् कामी" - निरुक्तिः<br><br>कामिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಕ್ರವಾಕ ಪಕ್ಷಿ<br><br>कामिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರಿವಾಳದ ಹಕ್ಕಿ<br><b>विस्तारः - </b>"कामी तु कामुके चक्रवाके पारावतेऽपि च" - मेदि० ।<br><br>कामिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><br>कामिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಬ್ಬಚ್ಚಿ<br><br>कामिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾರಸ ಪಕ್ಷಿ /ಒಂದುಜಾತಿಯ ಹಂಸ ಪಕ್ಷಿ<br><br>कामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುರಾಗವುಳ್ಳವನು /ಪ್ರೀತಿಯುಳ್ಳವನು<br><b>प्रयोगाः - </b>"त्वग्रसूचीसचिवेन कामिनोर्मनोभवः सीव्यति दुर्यशःपटौ"<br><b>उल्लेखाः - </b>नैष० १-८०<br><br>कामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮುಕ /ಕಾಮಪೀಡಿತ /ಸಂಭೋಗಾಪೇಕ್ಷೆಯುಳ್ಳವನು<br><b>प्रयोगाः - </b>"कामिनो कृतरतोत्सवकालक्षेपमाकुलवधूकरसङ्गि"<br><b>उल्लेखाः - </b>माघ० १०-६१<br><br>कामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸುವ /ಬಯಸುವ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) + णिङ् - "णिनिः" (३-२-७८)<br><br>

कामिनी
कामिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कामिन् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>कामिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿಸುವ ಹೆಂಗಸು /ಅನುರಕ್ತಳಾದ ಹೆಂಗಸು /ಕಾಮಾತುರವುಳ್ಳ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५) । "ङीप्" (४-१-५)<br><b>व्युत्पत्तिः - </b>कामोऽस्त्यस्याः<br><b>प्रयोगाः - </b>"परिमलितमपि प्रियैः प्रकामं कुचयुगमुज्ज्वलमेव कामिनीनाम्" । "कामिनीषे विवाहेषु गवां भक्ष्ये तथेन्धने । ब्राह्मणाभ्युपपत्तौ च शपथे नास्ति पातकम् ॥"<br><b>उल्लेखाः - </b>माघ० ७-७०, मनु० ८-११२<br><br>कामिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸು<br><b>प्रयोगाः - </b>"परिवृद्धरागमनुबन्धसेवया मृगया जहार चतुरेव कामिनी"<br><b>उल्लेखाः - </b>रघु० ९-६९<br><br>कामिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಂದರಿ /ರೂಪವತಿಯಾದ ಹೆಂಗಸು<br><b>प्रयोगाः - </b>"मधूनि वक्त्राणि च कामिनीनामामोदकर्मव्यतिहारमीयुः"<br><b>उल्लेखाः - </b>माघ० ३-५४<br><br>कामिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೀರು /ಭಯವುಳ್ಳವನು<br><br>कामिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬದನಿಕೆ ಗಿಡ<br><br>कामिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮರದರಿಶಿನ<br><br>कामिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಮದ್ಯ<br><br>

कामुक
कामुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಡಕೆ ಮರ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) - "उकञ्" (३-२-१५४)<br><br>कामुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶೋಕವೃಕ್ಷ<br><br>कामुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡಿರುವಂತಿಗೆ<br><b>विस्तारः - </b>"कामुकास्तु काम्यशोकातिमुक्तकाः" - हेम० ।<br><br>कामुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮಪೀಡಿತನಾದ /ಕಾಮಬಾಧೆಯನ್ನು ಅನುಭವಿಸುತ್ತಿರುವ /ಕಾಮರೋಗವುಳ್ಳ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) - "उकञ्" (३-२-१५४)<br><b>व्युत्पत्तिः - </b>कामयितुं शीलमस्य<br><b>प्रयोगाः - </b>"वञ्चयिष्यसि कतुस्तमोवृतः कामुकेति चकृषुस्तमङ्गनाः"<br><b>उल्लेखाः - </b>रघु० १९-३३<br><br>कामुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತಿಶಯಾಗಿ ಅಪೇಕ್ಷಿಸುವ /ಹೆಚ್ಚು ಆಸೆಪಡುವ<br><b>प्रयोगाः - </b>"इत्याकर्ण्य क्षित्तिशस्त्रिदशपरिषदस्ता गिरश्चाटुगर्भाः वैदर्भीकामुकोऽपि प्रसभविनिहितं दूत्यभारं बभार"<br><b>उल्लेखाः - </b>नैष० ५-१३७<br><br>

कामुका
कामुका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಧನ ಮೊದಲಾದುವನ್ನು ಅಪೇಕ್ಷಿಸುವ ಹೆಂಗಸು<br><br>

कामुकी
कामुकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಭೋಗದ ಅಪೇಕ್ಷೆಯುಳ್ಳ ಹೆಂಗಸು<br><b>विस्तारः - </b>"कामुकी मैथुनेच्छा चेत् कामाकाऽन्या" - सि० कौ०<br><br>

कामुकत्व
कामुकत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮುಕತನ /ವಿಲಾಸದಿಂದ ಕೂಡಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><b>प्रयोगाः - </b>"तेषां दिक्षु प्रथितविदिशालक्षणां राजधानीं गत्वा सद्यः फलमविकलं कामुकत्वस्य लब्धा"<br><b>उल्लेखाः - </b>मेघ० १-२४<br><br>

कामुकता
कामुकता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮುಕತನ /ವಿಲಾಸದಿಂದ ಕೂಡಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><br>

कामुकायन
कामुकायन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮುಕನ ಮಗ<br><b>निष्पत्तिः - </b>"फक्" (४-१-९९)<br><b>व्युत्पत्तिः - </b>कामुकस्यापत्यम्<br><br>

कामेप्सु
कामेप्सु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇಷ್ಟಾರ್ಥವನ್ನು ಹೊಂದಲು ಅಪೇಕ್ಷಿಸುವ<br><b>निष्पत्तिः - </b>आप्लृ (व्याप्तौ) + सन् - "उः" (३-२-१६७)<br><b>व्युत्पत्तिः - </b>काममाप्तुमिच्छुः<br><br>कामेप्सु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಭೋಗವನ್ನು ಅಪೇಕ್ಷಿಸುವ<br><br>

कामेश्वर
कामेश्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ<br><b>व्युत्पत्तिः - </b>कामानामीश्वरः<br><br>

कामेश्वरी
कामेश्वरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವಿಯ ಒಂದು ಮೂರ್ತಿ<br><b>प्रयोगाः - </b>"कामाख्या त्रिपुर चैव तथा कामेश्वरी शिवा । सारदाऽथ महोत्साहा कामरूपगुणैर्युता ॥"<br><b>उल्लेखाः - </b>कालिकापु०<br><br>

कामोपहत
कामोपहत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥನಿಂದ ಪೀಡಿತನಾದ<br><br>कामोपहत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಸೆಯಿಂದ ಪೀಡಿತನಾದ<br><b>व्युत्पत्तिः - </b>कामेन उपहतः<br><br>

काम्पिल्य
काम्पिल्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂಪಿಲ್ಯ ದೇಶ<br><br>काम्पिल्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂಪಿಲ್ಯಪುರ /ದ್ರುಪದರಾಜನ ರಾಜಧಾನಿ<br><b>प्रयोगाः - </b>"माकन्दीमथ गङ्गायास्तीरे जनपदायुताम् । सोऽध्यवात्सीत् दीनमनाः काम्पिल्यं च पुरोत्तमम् । दक्षिणांश्चापि पाञ्चालान् यावत् चर्मण्वतीं नदीम् । द्रोणेन चैवं द्रुपदः परिभूयाथ पालितः ॥"<br><b>उल्लेखाः - </b>भा०<br><br>काम्पिल्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಲೆಹಿಟ್ಟು ಎಂಬ ಔಷಧಿ<br><b>विस्तारः - </b>"काम्पिल्यः कर्कशश्चन्द्रो रक्ताङ्गो रोचनीत्यपि" - अम० ।<br><br>

काम्पिल्यक
काम्पिल्यक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಂಪಿಲ್ಯದೇಶದಲ್ಲಿ ಹುಟ್ಟಿದ /ಕಾಂಪಿಲ್ಯದೇಶದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>काम्पिल्य - "वुञ्" (४-२-१२१)<br><br>

काम्बल
काम्बल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಬಳಿಯಿಂದ ಹೊದ್ದಿಸಲ್ಪಟ್ಟ ರಥ<br><b>निष्पत्तिः - </b>"अण्" (४-२-१०)<br><b>व्युत्पत्तिः - </b>कम्बलेन परिवृतो रथः<br><b>विस्तारः - </b>"रथे काम्बलवास्त्राद्याः कम्बलादिभिरावृते" - अम० ।<br><br>

काम्बविक
काम्बविक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಂಖದಿಂದ ಒಡವೆಗಳನ್ನು ತಯಾರಿಸುವವನು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-५५)<br><b>व्युत्पत्तिः - </b>कम्बुः शङ्खभूषणं शीलमस्य<br><br>

काम्बविकी
काम्बविकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಂಖದಿಂದ ಒಡವೆಗಳನ್ನು ತಯಾರಿಸುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

काम्बोज
काम्बोज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಬೋಜ ದೇಶ<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>काम्बोज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಬೋಜ ದೇಶದ ದೊರೆಗಳು<br><b>निष्पत्तिः - </b>"अञ्" (४-१-१६६)<br><b>व्युत्पत्तिः - </b>कम्बोजानां राजानः<br><b>प्रयोगाः - </b>"काम्बोजाः समरे सोढुं तस्य वीर्यमनीश्वराः"<br><b>उल्लेखाः - </b>रघु० ४-६९<br><b>विस्तारः - </b>ಆದರೆ "कम्बोजाल्लुक्" (४-१-१७३) ಸೂತ್ರದಿಂದ "अञ्" ಪ್ರತ್ಯಯಕ್ಕೆ ಲೋಪ ಬಂದು कम्बोजाः ಎಂದಾಗುವುದು. "कम्बोजाः समरे सोढुम्" इति पाठः सुगमः ಎಂದು ಸಿದ್ಧಾಂತ ಕೌಮುದಿಯಲ್ಲಿ ಉಕ್ತವಾಗಿದೆ. "शका यवनकम्बोजास्तास्ताः क्षत्रियजातयः" - भा० अनु० ३३-२१ ಎಂದು अञ् ಪ್ರತ್ಯಯಕ್ಕೆ ಲೋಪವಿಲ್ಲದ ಪ್ರಯೋಗವೂ ಇರುವುದು.<br><br>काम्बोज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಬೋಜದೇಶದ ನಿವಾಸಿಗಳು<br><b>निष्पत्तिः - </b>"अण्" (४-३-९३)<br><b>व्युत्पत्तिः - </b>कम्बोजोऽभिजनो येषाम्<br><br>काम्बोज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುನ್ನಾಗವೃಕ್ಷ /ಸುರಗಿ ಗಿಡ<br><br>काम्बोज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಬೋಜದೇಶದ ಕುದುರೆ<br><b>निष्पत्तिः - </b>"अण्" (४-२-१३३)<br><b>व्युत्पत्तिः - </b>कम्बोजदेशे भवः<br><br>काम्बोज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿಕಗ್ಗಲಿ ಮರ<br><br>

काम्बोजी
काम्बोजी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುದ್ದಿನ ಗಿಡ<br><br>काम्बोजी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿಕಗ್ಗಲಿ ಮರ<br><b>विस्तारः - </b>"काम्बोजः पुनरश्वानां भेदे पुनापादपे । वलक्षखदिरे चापि काम्बोजी माषपर्णिका" - हेम० ।<br><br>काम्बोजी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಷಪರ್ಣೀ ಗಿಡ /ಕಾಡುದ್ದಿನ ಗಿಡ<br><br>काम्बोजी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿಕಗ್ಗಲಿ ಮರ<br><b>विस्तारः - </b>"काम्बोजी माष पर्णाच्च वलक्षक्जदिरे स्त्रियाम्" - मेदि० ।<br><br>

काम्बोजक
काम्बोजक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂಬೋಜದೇಶದಲ್ಲಿರುವ ಮನುಷ್ಯ<br><br>काम्बोजक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಂಬೋಜದೇಶದಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><b>निष्पत्तिः - </b>कम्बोज - "वुञ्" (४-२-१३३)<br><br>

काम्भोज
काम्भोज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂಬೋಜ ದೇಶ<br><b>प्रयोगाः - </b>"काम्बोजवाजिनियुतानि च सत्रिसप्तानि"<br><b>उल्लेखाः - </b>याद० १६-१४६<br><br>

काम्य
काम्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಚ್ಛೆ /ಅಪೇಕ್ಷೆ /ಬಯಕೆ<br><br>काम्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಂದರವಾದ /ಸುಂದರನಾದ /ಮನೋಹರವಾದ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) + णिङ् - कर्म० "यत्" (३-१-९७)<br><b>व्युत्पत्तिः - </b>काम्यते<br><b>प्रयोगाः - </b>"नासौ न काम्यौ न च वेद सम्यक् द्रष्टुं न सा भिन्नरुचिर्हि लोकः"<br><b>उल्लेखाः - </b>रघु० ६-३०<br><br>काम्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಡುವ ವಿಷಯ /ಕಾಮನಾವಿಷಯ<br><br>काम्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಫಲಾಭಿಲಾಷೆಯಿಂದ ಮಾಡುವ ಕರ್ಮ<br><b>प्रयोगाः - </b>"काम्यो हि वेदाधिगमः कर्मयोगश्च वैदिकः" । "अथ तस्य विशां पत्युरन्ते काम्यस्य कर्मणः" ।<br><b>उल्लेखाः - </b>मनु० २-२, रघु० १०-५०<br><b>विस्तारः - </b>"यत्किञ्चित्फलमुद्दिश्य यज्ञदानजपादिकम् । क्रियते कायिकं यच्च तत् काम्यं परिकीर्तितम् ॥"<br><br>

काम्यक
काम्यक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಪ್ರಸ್ಥಕ್ಕೆ ಪಶ್ಚಿಮದಲ್ಲಿರುವ ಒಂದು ವನ /ಪಾಂಡವರು ವನವಾಸಕ್ಕೆ ಹೊರಟಾಗ ಕೆಲವು ಕಾಲ ತಂಗಿದ್ದ ವನ<br><b>प्रयोगाः - </b>"सरस्वतीदृषद्वत्यौ यमुनां च निषेव्य ते । ययुर्वनेनैव वनं सततं दक्षिणां दिशम् । ततः सरस्वतीकूले समेषु मरुधन्वसु । कम्यकं नाम ददृशुर्वनं मुनिजनप्रियम् ॥"<br><b>उल्लेखाः - </b>भा० वन० ५-२, ३<br><br>

काम्यकर्मन्
काम्यकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಫಲಾಪೇಕ್ಷೆಯಿಂದ ಮಾಡುವ ಕರ್ಮ /ಜ್ಯೋತಿಷ್ಟೋಮಾದಿ ಯಾಗ<br><b>प्रयोगाः - </b>"काम्यानां कर्मणां न्यासं सन्न्यासं कवयो विदुः । सर्वकर्मफलत्यागं प्राहुस्त्यागं विचक्षणाः ॥"<br><b>उल्लेखाः - </b>गीता० १८-२<br><br>काम्यकर्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಮ್ಯಕರ್ಮವನ್ನು ಆಚರಿಸುವವನು<br><b>व्युत्पत्तिः - </b>काम्यं कर्म यस्य<br><br>

काम्यदान
काम्यदान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಫಲಾಪೇಕ್ಷೆಯಿಂದ ಮಾಡುವ ದಾನ /ಫಲವನ್ನು ಅಪೇಕ್ಷಿಸಿ ಕೊಡುವ ಕೊಡುಗೆ<br><br>

काम्यफल
काम्यफल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಮದಿಂದ ಅಪೇಕ್ಷಿಸಲ್ಪಡುವ ಫಲ /ಕಾಮ್ಯಕರ್ಮದ ಫಲ<br><br>

काम्यमान
काम्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೇಕ್ಷಿಸಲ್ಪಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) + णिङ् - कर्म० "यक्" "शानच्" (३-२-१२४)<br><br>

काम्ल
काम्ल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಹುಳಿ<br><b>निष्पत्तिः - </b>कोः कादेशः (६-३-१०५)<br><b>व्युत्पत्तिः - </b>कु ईषदल्पम्<br><br>काम्ल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಹುಳಿಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>काम्लमस्त्यस्य<br><br>

काय
काय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹ /ಶರೀರ /ಮೈ<br><b>निष्पत्तिः - </b>चिञ् (चयने) - "घञ्" कश्च (३-३-४१)<br><b>व्युत्पत्तिः - </b>चीयते अस्थ्यादिकमत्र<br><b>प्रयोगाः - </b>"कैष्यं मषीणां स्मितभा कठिन्यां काये यदीये निरमायि सारैः"<br><b>उल्लेखाः - </b>नैष० १०-८७<br><br>काय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಘ /ಸಮೂಹ /ರಾಶಿ /ಗುಂಪು<br><b>निष्पत्तिः - </b>चिञ् (चयने) - भावे "घञ्" कश्च (३-३-४१)<br><br>काय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಭಾವ<br><br>काय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಂಟು ವಿಧ ವಿವಾಹಗಳಲ್ಲಿ ಪ್ರಜಾಪತಿ ದೇವತಾಕವಾದ ಒಂದು ವಿವಾಹ<br><b>प्रयोगाः - </b>"देवोढाजः सुतश्चैव सप्त सप्त परावरान् । आर्षोढाजः सुतस्त्रींस्त्रीन् षट्षट् कायोढजः सुतः ॥"<br><b>उल्लेखाः - </b>मनु० ३-३८<br><br>काय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಲಧನ /ಬಂಡವಾಳ<br><br>काय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲಕ್ಷ್ಯ /ಗುರಿ /ಉದ್ದೇಶ<br><br>काय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಜಾಪತಿದೇವತಾಕವಾದ ಒಂದು ತೀರ್ಥ<br><br>काय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮನುಷ್ಯ ತೀರ್ಥ<br><b>प्रयोगाः - </b>"ब्राह्मेण विप्रस्तीर्थेन नित्यकालमुपस्पृशेत् । कायत्रैदशिकाभ्यां वा न पित्र्येण कदाचन । अङ्गुष्ठमूलस्य तले ब्राह्मं तीर्थं प्रचक्षते । कायमङ्ङुष्ठमूलेऽग्रे दैवं पित्र्यं तयोरधः ॥"<br><b>उल्लेखाः - </b>मनु० २-५८,,५९<br><b>विस्तारः - </b>"कायः कदैवते मूर्तौ सङ्घे लक्ष्यस्वभावयोः । कायं मनुष्यतीर्थे च "- हेम० ।<br><br>काय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಜಾಪತಿದೇವತಾಕವಾದ ಹವಿಸ್ಸು ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>"अण्" (४-२-२४) । कस्य इत् (४-२-२५)<br><b>व्युत्पत्तिः - </b>कं प्रजापतिर्देवताऽस्य<br><b>विस्तारः - </b>"को ब्रह्मा देवता अस्य कायं हविः" - सि० कौ० ।<br><br>

कायक्लेश
कायक्लेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶರೀರದ ಶ್ರಮ /ದುಡಿತದಿಂದ ಉಂಟಾದ ನೋವು<br><b>व्युत्पत्तिः - </b>कायस्य क्लेशः<br><b>प्रयोगाः - </b>"दुःखमित्येव यत्कर्म कायक्लेशभयात् त्यजेत् । स कृत्वा राजसं त्यागं नैव त्यागफलं लभेत् ॥"<br><b>उल्लेखाः - </b>गीता० १८-८<br><br>

कायचिकित्सा
कायचिकित्सा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೈದ್ಯದಲ್ಲಿ ಹೇಳಿರುವ ೮ ವಿಧ ಆಯುರ್ವೇದಾಂಗಗಳಲ್ಲಿ ಒಂದು /ದೇಹದಲ್ಲಿ ಸಂಭವಿಸುವ ರೋಗಗಳ ನಿವಾರಣೆಗಾಗಿ ಮಾಡುವ ಉಪಚಾರ<br><br>

कायदण्ड
कायदण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಯ ನಿಗ್ರಹ /ಶರೀರವನ್ನು ಹತೋಟಿಯಲ್ಲಿಟ್ಟುಕೊಳ್ಳಲು ದಂಡಿಸುವುದು<br><br>

कायबन्धन
कायबन्धन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚೇತನವನ್ನು ಶರೀರದೊಳಗೆ ಸೇರಿಸುವುದು<br><br>

कायवत्
कायवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶರೀರವುಳ್ಳ /ದೇಹವನ್ನು ಹೊಂದಿರುವ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>कायोऽस्यास्ति<br><br>कायवत्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಶರೀರದಂತೆ /ದೇಹದಂತೆ<br><b>निष्पत्तिः - </b>"वतिः" (५-१-११५)<br><b>व्युत्पत्तिः - </b>कायेन तुल्यम्<br><br>

कायवती
कायवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶರೀರವುಳ್ಳ /ದೇಹವನ್ನು ಹೊಂದಿರುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कायवलन
कायवलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕವಚ /ಅಂಗಿ<br><br>

कायमान
कायमान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಟೀರ /ಹುಲ್ಲಿನ ಗುಡಿಸಲು<br><b>विस्तारः - </b>"कायमानं तृणकुटी" - त्रिकाण्ड० ।<br><br>कायमान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೇಶ್ಯಾಗೃಹ<br><br>कायमान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಟದ ಮನೆ /ನರ್ತನ ಶಾಲೆ<br><b>विस्तारः - </b>"वेश्यागृहे कायमानं तथेदं केलिमण्डपे" - वैज० ।<br><br>

कायव्य
कायव्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಳ್ಳರ ಗುಂಪಿಗೆ ಒಡೆಯನಾದ ಒಬ್ಬ ಬೇಡ<br><br>

कायसम्पद्
कायसम्पद्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರೂಪ/ಲಾವಣ್ಯ /ಶರೀರ ಸೌಂದರ್ಯ<br><b>व्युत्पत्तिः - </b>कायस्य सम्पत्<br><b>प्रयोगाः - </b>"रूपलावण्यबलवज्रसंहननत्वानि कायसम्पदः"<br><b>उल्लेखाः - </b>पा० यो० सू०<br><br>

कायस्थ
कायस्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ /ಪರಮೇಶ್ವರ<br><b>निष्पत्तिः - </b>काय + ष्ठा (गतिनिवृत्तौ) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कायेषु सर्वभूतानां देहेषु अन्तर्यामितया तिष्ठति<br><b>प्रयोगाः - </b>"कायस्थोऽपि न कायस्थः कायस्थोऽपि न जायते । कायस्थोऽपि न भुञ्जानः कायस्थोऽपि न बध्यते ॥"<br><b>उल्लेखाः - </b>उत्तरगी०<br><br>कायस्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಮಿಶ್ರ ಜಾತಿಯವನು /ಕ್ಷತ್ರಿಯನಿಂದ ಶೂದ್ರಸ್ತ್ರೀಯಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><b>प्रयोगाः - </b>"दृग्गोच्चरोऽभूदथ चित्रगुप्तः कायस्थ उच्चैर्गुण एतदीयः"<br><b>उल्लेखाः - </b>नैष० १४-६६<br><br>

कायस्था
कायस्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಳಲೆ ಗಿಡ<br><b>निष्पत्तिः - </b>घञर्थे "कः" (वा० ३-३-५८)<br><b>व्युत्पत्तिः - </b>कायस्तिष्ठत्यनया<br><br>कायस्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೆಲ್ಲಿ ಗಿಡ<br><br>कायस्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಲಕ್ಕಿ ಗಿಡ<br><b>उल्लेखाः - </b>"कायस्थोऽपि नृजातेः स्यात् प्रभेदे परमात्मनि । कायस्था तु हरीतक्यामामलक्यां च दर्शिता" - विश्व० । "कायस्थोऽक्षरजीवकः । परमात्मा च कायस्था हरीतक्यामलक्यपि" - हेम० ।<br><br>कायस्था<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಯಸ್ಥ ಜಾತಿಯ ಹೆಂಗಸು<br><br>

कायस्थी
कायस्थी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಯಸ್ಥನ ಹೆಂಡತಿ<br><br>

कायिक
कायिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಯದಿಂದ ನಡೆಸಲ್ಪಟ್ಟ /ದೇಹದಿಂದ ಮಾಡಲ್ಪಟ್ಟ /ಶರೀರ ವ್ಯಾಪಾರದಿಂದ ಉಂಟಾದ ಪುಣ್ಯಪಾಪ ಕರ್ಮಗಳು<br><b>निष्पत्तिः - </b>"ठक्" (५-१-७९)<br><b>व्युत्पत्तिः - </b>कायेन निवृत्तम्<br><b>उल्लेखाः - </b>"अदत्तानामुपादानं हिंसा चेवाविधानतः । परदारोपसेवा च कायिकं त्रिविधं स्मृतम् । वाचा वाचा कृतं कर्म कायेनैव च कायिकम् ॥"<br><b>विस्तारः - </b>मनु० १२-७, ८<br><br>

कायिका
कायिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಡ್ಡಿ /ಮೂಲಧನದ ವೃದ್ಧ್ಯಂಶ<br><b>उल्लेखाः - </b>"नातिसांवत्सरीं वृद्धिं न चादष्टां पुनर्हरेत् । चक्रवृद्धिः कालवृद्धिः कारिता कायिका च सा ॥"<br><b>विस्तारः - </b>मनु० ८-१५३<br><br>कायिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸು ಎತ್ತು ಮೊದಲಾದುವುಗಳ ವ್ಯಾಪಾರದಿಂದ ಕೊಡುವ ಬಡ್ಡಿ<br><b>विस्तारः - </b>"दोयवाह्यकर्मयुता कायिका समुदाहृता"<br><br>

कार
कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯ /ಕೆಲಸ<br><br>कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯತ್ನ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - भावे "घञ्" (३-३-१८)<br><b>प्रयोगाः - </b>"सकारनानारकासकायसाददसायका"<br><b>उल्लेखाः - </b>माघ० १९-२७<br><br>कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅ ಆ ಇ ಈ ಮುಂತಾದ ವರ್ಣಗಳನ್ನು ನಿರ್ದೇಶಿಸಲು ಅವುಗಳ ಮುಂದೆ ಹಚ್ಚುವ ಒಂದು ಪ್ರತ್ಯಯ<br><br>कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - कर० "घञ्" (३-३-१२१)<br><br>कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರತಿ /ಸುರತ<br><b>व्युत्पत्तिः - </b>कस्य सुखस्यारः प्राप्तिर्यत्र<br><br>कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪತಿ /ಗಂಡ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कं सुखं ऋच्छति<br><br>कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಧೆ<br><br>कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯ<br><b>निष्पत्तिः - </b>कॄ (हिंसायाम्) - भावे "घञ्"<br><b>व्युत्पत्तिः - </b>कं निष्यन्दजलं ऋच्छति<br><br>कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲಿ /ಪೋಜಾದ್ರವ್ಯ<br><br>कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಮಾಚಲ<br><br>कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯತಿ /ಸಂನ್ಯಾಸಿ<br><br>कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಸ್ತ /ಕೈ<br><b>विस्तारः - </b>"कारो बले वधे यत्ने हिमाद्रौ निश्चये यतौ" - हेम० । "कारो बन्धनगेहे स्त्री करे ना" - वैज० ।<br><br>कार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ /ರಾಜನಿಗೆ ಕೊಡಬೇಕಾದ ತೆರಿಗೆ<br><b>प्रयोगाः - </b>"कारनाम्नि च प्राचां हलादेः"<br><b>उल्लेखाः - </b>पा० सू० ६-३-१०<br><b>विस्तारः - </b>कृञ् ಧಾತುವಿಗೆ ಕರ್ಮಪದವು ಉಪಪದವಾದಾಗ अण् ಪ್ರತ್ಯಯ ಬಂದು कार ಎಂದು ರೂಪವಾಗುವುದು. ಆಯಾ ಕಾರ್ಯ ಮಾಡುವವನು ಎಂಬ ಅರ್ಥ ಕೊಡುವುದು. कुम्भकारः, ग्रन्थकारः, सूपकारः इत्यादि ।<br><br>

कारक
कारक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ತೃತ್ವಾದಿ ಸಂಜ್ಞಾಪ್ರಯೋಜಕವಾದ ಒಂದು ಕಾರ್ಯ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>करोति कर्तृत्वादिव्यपदेशम्<br><br>कारक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಿಯಾ ನಿಷ್ಪಾದಕವಾದ ಕರ್ತೃಕರ್ಮಾದಿಗಳು<br><b>व्युत्पत्तिः - </b>करोति क्रियां निर्वर्तयति<br><b>प्रयोगाः - </b>"निष्पत्तिमात्रे कर्तृत्वं सर्वत्रैवास्ति कारके । व्यापारभेदापेक्षायां करणत्वादिसम्भवः ॥"<br><br>कारक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಮದ ಗಡ್ಡೆಯಿಂದ ಹೊರಟ ನೀರು<br><br>कारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರಕ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>करकस्येदम्<br><br>कारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡುವವನು /ಕೆಲಸ ಮಾಡುವವನು /ರಚಿಸುವವನು /ನಿರ್ಮಾಣ ಮಾಡುವವನು<br><b>प्रयोगाः - </b>"दोषैरेतैः कुलघ्नानां वर्णसङ्करकारकैः"<br><b>उल्लेखाः - </b>गीता० १-४३<br><br>

कारिका
कारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कारक ಪದದ ಅರ್ಥ<br><b>प्रयोगाः - </b>"यत्र पुष्पशरशास्त्रकारिकाध्युषितनागदन्तिका"<br><b>उल्लेखाः - </b>नैष० १८-१५<br><br>कारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸ /ಕಾರ್ಯ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "ण्वुल्" (३-१-१३३)<br><b>प्रयोगाः - </b>"क्रियायोगे अस्य गतित्वम् तत्र कारिका क्रिया कारिकाकृत्य"<br><b>उल्लेखाः - </b>सि० कौ०<br><br>कारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಟಿ /ನರ್ತಕಿ<br><br>कारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿವರಣ ಶ್ಲೋಕ /ಸ್ವಲ್ಪ ಪದಗಳಿಂದ ಬಹಳ ಅರ್ಥಗಳನ್ನು ತಿಳಿಸುವ ಶ್ಲೋಕ<br><br>कारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೀವ್ರವಾದ ವೇದನೆ /ಕ್ರೂರವಾದ ಯಾತನೆ /ಅತಿಯಾದ ನೋವು<br><br>कारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಲ್ಪ<br><b>प्रयोगाः - </b>"क्रूरारिकारी कोरेककारकः कारिकाकरः"<br><b>उल्लेखाः - </b>माघ० १९-१०४<br><b>विस्तारः - </b>"कारिका नटयोषिति । कृतौ विवरणश्लोके शिल्पयातनयोरपि । नपुंसकं तु कर्मादौ कारकं कर्तरि त्रिषु" - मेदि० ।<br><br>कारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಡ್ಡಿ /ಮೂಲಧನದ ವೃದ್ಧ್ಯಂಶ<br><br>

कारकदीपक
कारकदीपक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥಾಲಂಕಾರದ ಒಂದು ಭೇದ<br><b>प्रयोगाः - </b>"क्रमिकैकगतानां तु गुम्भः कारकदीपकम् । गच्छत्यागच्छति पुनः पान्थः पश्यति पृच्छति ॥"<br><b>उल्लेखाः - </b>चन्द्रा०<br><br>

कारकविभक्ति
कारकविभक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರಕಗಳನ್ನು ತಿಳಿಸುವ ವಿಭಕ್ತಿ<br><b>प्रयोगाः - </b>"उपपदविभक्तेः कारकविभक्तिर्बलीयसी"<br><b>उल्लेखाः - </b>परि० २-३-१६<br><br>

कारकर
कारकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "टः" (३-२-२१)<br><b>व्युत्पत्तिः - </b>कारं कार्यं करोति<br><br>

कारज
कारज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದಿಂದ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>कारात् जायते<br><br>कारज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಖ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>करजस्येदम्<br><br>कारज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಖದಲ್ಲಿ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-५३)<br><b>व्युत्पत्तिः - </b>करजे भवम्<br><br>

कारञ्ज
कारञ्ज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರಂಜವೃಕ್ಷದ ಕಾಯಿ ಅದರ ತೈಲ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>करञ्जस्य तत्फलस्येदम्<br><br>

कारण
कारण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಯಸ್ಥ<br><b>निष्पत्तिः - </b>स्वार्थे "अण्" (५-३-१०७)<br><b>व्युत्पत्तिः - </b>करण एव<br><br>कारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯವನ್ನುಂಟುಮಾಡುವ ಹೇತು /ಯಾವುದೊಂದು ಇಲ್ಲದಿದ್ದರೆ ಕಾರ್ಯವು ಆಗುವುದಿಲ್ಲವೋ ಅದು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) + णिच् - "ल्युट्" (३-३-११७)<br><b>प्रयोगाः - </b>"तच्च कारणमभूद्धिरष्मयं ब्रह्मणोऽसृजदसाविदं जगत्"<br><b>उल्लेखाः - </b>माघ० १४-६७<br><br>कारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದೇಶ<br><b>प्रयोगाः - </b>"हित्वा तनुं कारणमानुषीं तां यथा गुरुस्ते परमात्ममूर्तिम्"<br><b>उल्लेखाः - </b>रघु० १६-२२<br><br>कारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶರೀರ /ಮೈ /ದೇಹ<br><br>कारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>प्रयोगाः - </b>"करणं कारणं कर्ता"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"जीवानां चक्षुरादीन् यो हेतून् कारयतीति सः । प्रोच्यते कारणम्" - निरुक्तिः ।<br><br>कारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಿಯ<br><b>प्रयोगाः - </b>"कार्यकारणकर्तृत्वे हेतुः प्रकृतिरुच्यते"<br><b>उल्लेखाः - </b>गीता० १३-२०<br><br>कारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><b>प्रयोगाः - </b>"अजं शाश्वतं कारणं कारणानां शिवं केवलं भासकं भासकानाम्"<br><br>कारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಮಾಣವಚನ /ಆಧಾರ /ಅಧಿಕಾರಯುತವಾದ ಮಾತು<br><b>प्रयोगाः - </b>"सम्भोगो दृश्यते यत्र न दृश्येतागमः क्वचित् । आगमः कारणं तत्र न सम्भोग इति स्थितिः"<br><b>उल्लेखाः - </b>मनु० ८-२००<br><br>कारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಧನೆ /ಸಲಕರಣೆ<br><br>कारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯ /ಕೆಲಸ<br><b>प्रयोगाः - </b>"न कश्चित् कस्यचित् मित्रं न कश्चित् कस्यचित् रिपुः । कारणेन न जानाति मित्राणि च रिपून् तथा ॥"<br><br>कारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಧೆ /ಸಂಹಾರ<br><b>निष्पत्तिः - </b>कॄ (हिंसायाम्) + णिच् - भावे "ल्युट्" (३-३-११५)<br><br>कारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಲ /ಆದಿಕಾರಣ<br><b>प्रयोगाः - </b>"ब्राह्मणः सम्भवेनैव देवानामपि दैवतम् । प्रमाणं चैव लोकस्य ब्रह्मात्रैव हि कारणम् ॥"<br><b>उल्लेखाः - </b>मनु० ११-८४<br><br>कारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜನಕ /ತಂದೆ /ಉತ್ಪಾದಕ<br><b>प्रयोगाः - </b>"यमामनन्त्यात्मभुवोऽपि कारणं कथं स लक्ष्यप्रभवो भविष्यति"<br><b>उल्लेखाः - </b>कुमा० ५-८१<br><br>

कारणा
कारणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾತನೆ /ನೋವು<br><b>विस्तारः - </b>"कारणं करणे हेतुवधयोश्च नपुंसकम् । स्त्री यातनायाम्" - मेदि० ।<br><br>कारणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾತನೆ /ಅತಿಯಾದ ನೋವು<br><b>निष्पत्तिः - </b>कॄ (हिंसायाम्) + णिच् - "युच्" (३-३-१०७)<br><br>कारणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೇರಣೆ /ಒತ್ತಾಯ<br><br>

कारणकारण
कारणकारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರಣದ ಕಾರಣ<br><b>व्युत्पत्तिः - </b>कारणस्य कारणम्<br><br>

कारणगत
कारणगत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರಣದಲ್ಲಿರುವ /ಉಪಾದಾನ ಕಾರಣದಲ್ಲಿರುವ<br><br>

कारणगुण
कारणगुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಾದಾನ ಕಾರಣದ ಗುಣ<br><b>प्रयोगाः - </b>"कारणगुणाः कार्ये सङ्क्रामन्ति"<br><br>

कारणगुणोद्भव
कारणगुणोद्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಾದಾನ ಕಾರಣದ ಗುಣದಿಂದ ಉಂಟಾದ ಗುಣ<br><b>व्युत्पत्तिः - </b>कारणगुणात् उद्भवति<br><br>

कारणता
कारणता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರಣವಾಗಿರುವಿಕೆ /ಹೇತುವಾಗಿರುವುದು<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कारणस्य भावः<br><b>प्रयोगाः - </b>"प्रलयस्थितिसर्गाणामेकः कारणतां गतः"<br><b>उल्लेखाः - </b>कुमा० २-६<br><br>

कारणत्व
कारणत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರಣವಾಗಿರುವಿಕೆ /ಹೇತುವಾಗಿರುವುದು<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

कारणध्वंस
कारणध्वंस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರಣದ ನಾಶ<br><b>निष्पत्तिः - </b>ध्वंसु (अवस्रंसने) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कारणं ध्वंसयति<br><br>

कारणध्वंसक
कारणध्वंसक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರಣವನ್ನು ನಾಶಪಡಿಸುವ<br><b>निष्पत्तिः - </b>ध्वंसु (अवस्रंसने) + णिच् - "णिनिः" (३-१-१३४)<br><br>

कारणध्वंसिन्
कारणध्वंसिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರಣವನ್ನು ನಾಶಪಡಿಸುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कारणध्वंसिनी
कारणध्वंसिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರಣವನ್ನು ನಾಶಪಡಿಸುವ<br><br>

कारणमाला
कारणमाला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥಾಲಂಕಾರದ ಒಂದು ಭೇದ<br><br>

कारणिक
कारणिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರೀಕ್ಷೆ ಮಾಡುವವನು /ಕಾರಣಗಳಿಂದ ವಿಚಾರ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-८)<br><b>व्युत्पत्तिः - </b>कारणैः चरति<br><b>विस्तारः - </b>"परीक्षकः कारणिकः" - अम० ।<br><br>

कारणोत्तर
कारणोत्तर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರಣವನ್ನು ಹೇಳಿದ ನಂತರ ಕೊಡುವ ಉತ್ತರ /ವಾದಿಯು ತನ್ನ ವ್ಯವಹಾರವನ್ನು ಸ್ಥಿರಪಡಿಸಲು ಹೇಳಿದ ಕಾರಣವನ್ನು ಅಂಗೀಕರಿಸಿ ಅದನ್ನು ತಳ್ಳಿಹಾಕಲು ಕೊಡುವ ಉತ್ತರ<br><b>व्युत्पत्तिः - </b>कारणेन उत्तरम्<br><br>

कारण्डव
कारण्डव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಪಕ್ಷಿ /ಹಂಸದ ಒಂದು ಭೇದ<br><b>निष्पत्तिः - </b>रमु (क्रीडायाम्) - "डः" (उ० १-१११) । वा (गतिगन्धनयोः) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>रमते । ईषत् रण्डः कारण्डः कारण्डं वाति ।<br><br>

कारण्डवी
कारण्डवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಪಕ್ಷಿ /ಹಂಸದ ಒಂದು ಭೇದ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

कारन्धम
कारन्धम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರಂಧಮ ರಾಜನ ಮಗ /ಅವಿಕ್ಷತನೆಂಬ ದೊರೆ<br><b>निष्पत्तिः - </b>"अण्" (४-१-११२)<br><b>व्युत्पत्तिः - </b>करन्धमस्यापत्यम्<br><br>

कारन्धमिन्
कारन्धमिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಚುಗಾರ /ಮಿಶ್ರಲೋಹದ ಕೆಲಸ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>ध्मा (शब्दाग्निसंयोगयोः) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>कर एव कारः । कारं धमति<br><br>कारन्धमिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೋಹಮಿಶ್ರಣದಲ್ಲಿರುವ ಒಂದು ಲೋಹದ ಮೊತ್ತವನ್ನು ನಿರ್ಣಯಿಸುವವನು<br><b>विस्तारः - </b>"कारन्धमी कांस्यकारे धातुवादरतेऽपि च" - मेदि० ।<br><br>

कारन्धमिनी
कारन्धमिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಿಶ್ರಲೋಹದ ಕೆಲಸ ಮಾಡುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कारभ
कारभ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರಭಸಂಬಂಧವಾದ /ಒಂಟೆಯ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>करभस्येदम्<br><b>प्रयोगाः - </b>"अर्शोघ्नं कारणं मूत्रं मानुषं तु विषापहम्"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

कारभू
कारभू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೆರಿಗೆಯನ್ನು ವಸೂಲು ಮಾಡುವ ಜಾಗ<br><b>व्युत्पत्तिः - </b>कर एव कारः । तस्य भूः ।<br><br>

कारभूमि
कारभूमि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೆರಿಗೆಯನ್ನು ವಸೂಲು ಮಾಡುವ ಜಾಗ<br><br>

कारम्भा
कारम्भा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಿಯಂಗುವೃಕ್ಷ /ಪ್ರೇಂಖಣ ಗಿದ<br><br>

कारयत्
कारयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡಿಸುತ್ತಿರುವವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) + णिच् - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"प्रकाशमुन्माद्य यदद्य कारयन्मयात्मनस्त्वामनु कम्पते स्म सः"<br><b>उल्लेखाः - </b>नैष० ९-१३३<br><br>

कारयन्ती
कारयन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡಿಸುತ್ತಿರುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कारयितृ
कारयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡಿಸುವವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) + णिच् - "तृच्" (३-१-१३३)<br><br>

कारयित्री
कारयित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡಿಸುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कारयिष्णु
कारयिष्णु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡಿಸುವ ಸ್ವಭಾವದವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) + णिच् - "इष्णुच्" (३-२-१३८)<br><br>

कारव
कारव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ /ವಾಯಸ<br><b>व्युत्पत्तिः - </b>केति रवोऽस्य<br><br>

कारवी
कारवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ /ವಾಯಸ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६३)<br><br>कारवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಸಬ್ಬಸಿಗೆ<br><br>कारवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿಜೀರಿಗೆ<br><br>कारवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಓಮ /ವಾದಕ್ಕಿ<br><br>कारवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಗಿನ ಮರ<br><br>कारवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಕಾಗೆ<br><b>विस्तारः - </b>"कारवी मधुरादीप्यत्वक्पत्री कृष्णजीरके" - मेदि० ।<br><br>

कारवेल्ल
कारवेल्ल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಗಲದ ಗಿಡ<br><br>कारवेल्ल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಗಲದ ಕಾಯಿ<br><br>कारवेल्ल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಗಲದ ಹೂವು<br><b>निष्पत्तिः - </b>वेल्ल (चलने) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कारं वेल्लति<br><br>

कारवेल्लक
कारवेल्लक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಗಲದ ಹೂವು<br><b>निष्पत्तिः - </b>स्वार्थे "कः"<br><br>

कारस्कर
कारस्कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷವೃಕ್ಷ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "टः" (३-२-२०)<br><b>व्युत्पत्तिः - </b>कारं वधं करोति<br><b>प्रयोगाः - </b>"कारस्करो वृक्षः"<br><b>उल्लेखाः - </b>पा० सू० ६-१-१५६<br><br>

कारा
कारा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಧನ /ಸೆರೆ /ಬೇಡಿ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "अङ्" दीर्घश्च (३-३-१०४)<br><b>व्युत्पत्तिः - </b>कीर्यतेऽत्र<br><br>कारा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಧನಾಗಾರ /ಸೆರೆಮನೆ<br><br>कारा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿನ್ನದ ಕೆಲದ ಮಾಡುವ ಹೆಂಗಸು<br><br>कारा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೂತಿ<br><br>कारा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೀಣೆಯ ಬುರುಡೆ /ವೀಣೆಯ ಹೆರಳು<br><b>विस्तारः - </b>"कारा बन्धनशालायां बन्धे दूत्यायां प्रसेवके । स्यात् हेमकारिकायां च" - हेम० ।<br><br>कारा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೀಡೆ /ಹಿಂಸೆ<br><b>विस्तारः - </b>"कारा पीडा बन्धशाले" - त्रिकाण्ड० ।<br><br>

कारागार
कारागार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೆರೆಮನೆ<br><b>व्युत्पत्तिः - </b>काराया आगरम्<br><b>प्रयोगाः - </b>"किं न मुक्ताः कुतः सन्ति कारागारे मनोभुवः"<br><b>उल्लेखाः - </b>नैष० १७-७६<br><br>

कारागुप्त
कारागुप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೆರೆ ಹಿಡಿಯಲ್ಪಟ್ಟ /ಸೆರೆಮನೆಯಲ್ಲಿ ಇಡಲ್ಪಟ್ಟ<br><br>

कारागृह
कारागृह<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೆರೆಮನೆ<br><b>व्युत्पत्तिः - </b>काराया गृहम्<br><b>प्रयोगाः - </b>"कारागृहे निर्जितवासवेन लङ्केश्वरेणोषितमाप्रसादात्"<br><b>उल्लेखाः - </b>रघु० ६-४०<br><br>

कारावस
कारावस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೆರೆಮನೆ<br><br>कारावस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೆರೆಮನೆಯ ವಾಸ<br><br>

कारापथ
कारापथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದೇಶ<br><b>प्रयोगाः - </b>"शासनाद्रघुनाथस्य चक्रे कारापथेश्वरौ"<br><b>उल्लेखाः - </b>रघु० १५-९०<br><br>

कारायिका
कारायिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಬಾತು /ಬೆಳ್ಳಕ್ಕಿ<br><br>

कारावर
कारावर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಶಷಾದನಿಂದ ವೈದೇಹಿಯಲ್ಲಿ ಹುಟ್ಟಿದ ಒಬ್ಬ ಮಿಶ್ರಜಾತಿಯವನು /ಚರ್ಮದ ಕೆಲಸ ಮಾಡುವವನು<br><b>प्रयोगाः - </b>"कारावरो निषादात्तु चर्मकारः प्रसूयते"<br><b>उल्लेखाः - </b>मनु० १०-३६<br><br>

कारि
कारि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸ /ಪ್ರಶ್ನೆ ಮತ್ತು ಉತ್ತರ ಕಥನರೂಪವಾದ ಕಾರ್ಯ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "इञ्" (३-३-१०)<br><b>प्रयोगाः - </b>"कां त्वं कारिमकार्षीः सर्वां कारिमहमकार्षम्"<br><br>कारि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಲ್ಪಿ<br><b>विस्तारः - </b>"कारिः स्त्रियां क्रियायां स्यात् वाच्यलिङ्गस्तु शिल्पिनि" - मेदि० ।<br><br>

कारित
कारित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) + णिच् - "क्तः" (३-२-१०२)<br><br>कारित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) + स्वार्थे णिच् - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"कारितारिवधा सेनाऽनासेधा वरितारिका"<br><b>उल्लेखाः - </b>माघ० १९-४४<br><br>

कारिता
कारिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನ್ಯಾಯವಾದುದಕ್ಕಿಂತ ಹೆಚ್ಚಾದ ಬಡ್ಡಿ /ಉತ್ತಮರ್ಣನು ಬಲಾತ್ಕಾರವಾಗಿ ಹೇರಿದ ಬಡ್ಡಿ<br><b>प्रयोगाः - </b>"चक्रवृद्धिः कालवृद्धिः कारिता कायिका च या"<br><b>उल्लेखाः - </b>मनु० ८-१५३<br><br>

कारी
कारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಗ್ಗುಳ್ಳದ ಗಿಡ<br><b>निष्पत्तिः - </b>कॄ (हिंसायाम्) - "इञ्" (३-३-११०) । "ङीष्" (ग० ४-१-४५)<br><br>

कारीर
कारीर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿದಿರಿನ ಕಾಂಡ /ಬಿದಿರಿನ ಜಲ್ಲೆ<br><b>निष्पत्तिः - </b>"अञ्" (४-३-१४१)<br><b>व्युत्पत्तिः - </b>करीरस्यावयवः काण्डम्<br><br>

कारीरी
कारीरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಳೆಗೋಸ್ಕರ ಮಾಡುವ ಒಂದುಯಾಗ<br><br>

कारीष
कारीष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಣಗಿದ ಸಗಣಿಯ ರಾಶಿ<br><b>निष्पत्तिः - </b>"अण्" (४-२-३८)<br><b>व्युत्पत्तिः - </b>करीषाणां समूहः<br><br>कारीष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಣಗಿದ ಸಗಣಿಯಿಂದ ಉಂಟಾದ<br><br>

कारु
कारु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವಶಿಲ್ಪಿ /ವಿಶ್ವಕರ್ಮ<br><br>कारु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಲ್ಪಿ /ವಾಸ್ತುಶಿಲ್ಪಿ /ಶಿಲ್ಪಶಾಸ್ತ್ರಜ್ಞ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "उण्" (उ० १-१)<br><b>व्युत्पत्तिः - </b>करोति<br><b>प्रयोगाः - </b>"इति स्म सा कारुवरेण लेखितं नलस्य च स्वस्य च सख्यमीक्षते"<br><b>उल्लेखाः - </b>नैष० १-३८<br><br>कारु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕವಿ /ಹೊಗಳುವವನು /ಸ್ತೋತ್ರ ಮಾಡುವವನು<br><br>कारु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><b>विस्तारः - </b>"कारुर्जम्भरिपुर्जिष्णुः" - वैज० ।<br><br>कारु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ರಾತ್ಯನಾದ ವೈಶ್ಯನಿಂದ ಅವಿವಾಹಿತ ವೈಶ್ಯ ಹೆಂಗಸಿನಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><br>कारु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಡಗಿ /ಮರಗೆಲಸದವನು<br><br>कारु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯ /ಕೆಲಸ<br><br>कारु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಲ್ಪ /ಕೈಗಾರಿಕೆ<br><br>कारु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೈಕೆಲಸದವನು /ಚಿತ್ರಕಾರ್ಯ ಮಾಲಾರಚನೆ ಮುಂತಾದುವನ್ನು ಮಾಡುವವನು<br><b>प्रयोगाः - </b>"नित्यं शुद्धः कारुहस्तः पण्यं यच्च प्रसारितम्"<br><b>उल्लेखाः - </b>मनु० ५-१२९<br><br>कारु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೂಪಕಾರ /ಅಡುಗೆಯವನು<br><b>प्रयोगाः - </b>"कर्मोपकरणाः शूद्राः कारवः शिल्पिनस्तथा"<br><b>उल्लेखाः - </b>मनु० १०-१२०<br><br>कारु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡುವವನು /ಕೆಲಸ ಮಾಡುವವನು /ರಚಿಸುವವನು /ನಿರ್ಮಾಣ ಮಾಡುವವನು<br><b>प्रयोगाः - </b>"राघवस्ततः कार्यं कारुर्वानरपुङ्गवः"<br><b>उल्लेखाः - </b>भट्टि० ७-२८<br><b>विस्तारः - </b>"कारुस्तु कारके शिल्पे विश्वकर्मणि शिल्पिनि" - हेम० ।<br><br>

कारुक
कारुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಲ್ಪಿ /ಶಿಲ್ಪಶಾಸ್ತ್ರವನ್ನು ತಿಳಿದವನು<br><b>निष्पत्तिः - </b>कारु - स्वार्थे "कः"<br><br>कारुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಡಗಿ /ಮರಗೆಲಸದವನು<br><br>कारुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಕೆಲಸದವನು /ಚಿತ್ರಕಾರ<br><br>कारुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕವಿ /ಹೊಗಳುವವನು /ಸ್ತೋತ್ರ ಮಾಡುವವನು<br><br>कारुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಪಕಾರ /ಅಡುಗೆಯವನು<br><b>प्रयोगाः - </b>"न साक्षी नृपतिः कार्यो न कारुककुशीलवौ"<br><b>उल्लेखाः - </b>मनु० ८-६५<br><br>

कारुचौर
कारुचौर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೋಡೆಯಲ್ಲಿ ಕನ್ನ ಕೊರೆದು ಕದಿಯುವವನು<br><b>व्युत्पत्तिः - </b>कारुणा शिल्पेन चौरः<br><br>

कारुज
कारुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಜ ಶಿಶು /ಆನೆಯ ಮರಿ<br><br>कारुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಗ<br><b>विस्तारः - </b>"कारुजः कलभे नाके" - वैज० ।<br><br>कारुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಲ್ಮೀಕ /ಹುತ್ತ<br><br>कारुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಫೇನ /ನೊರೆ<br><br>कारुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಗಕೇಸರ ವೃಕ್ಷ /ನಾಗಸಂಪಿಗೆ ಮರ<br><br>कारुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಯಲ್ಲಿ ತಾನಾಗಿ ಹುಟ್ಟುವ ಎಳ್ಳಿನ ಆಕಾರದ ಕಪ್ಪು ಮಚ್ಚೆ /ಸಂಗಾತಿ<br><br>कारुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೈರಿಕ ಧಾತು<br><br>कारुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಲ್ಪಿಯ ಕುಶಲಕಾರ್ಯ /ಶಿಲ್ಪಿಯು ತಯಾರಿಸಿದ ಯಾವುದಾದರೊಂದು ವಸ್ತು<br><b>विस्तारः - </b>"कारुजः कलभे फेने वल्मीके नागकेसरे । गैरिके शिल्पिनां चित्रे स्वयञ्जाततिलेऽपि च" - हेम० ।<br><br>

कारुण
कारुण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕಂಪಾರ್ಹ /ದಯೆತೋರಿಸಲು ಯೋಗ್ಯನಾದವನು<br><b>विस्तारः - </b>"दयालुः स्यात् कारुणिकोऽनुकम्प्यः कारुणः सामौ" - वैज० ।<br><br>कारुण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ಕೆಂಪಾದ<br><br>

कारुणिक
कारुणिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯಾಳು /ದಯೆ ತೋರಿಸುವವನು /ಕನಿಕರವುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-६१)<br><b>व्युत्पत्तिः - </b>करुणा शीलमस्य<br><b>प्रयोगाः - </b>"सम्यक् कारुणिकस्येदं वत्स ते विचिकित्सितम्"<br><b>उल्लेखाः - </b>भाग० २-५-९<br><br>

कारुण्डिका
कारुण्डिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲೌಕೆ /ಜಿಗಣೆ<br><br>

कारुण्य
कारुण्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರುಣೆ /ದಯೆ /ಕನಿಕರ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>करुणस्य दयालोः भावः<br><b>प्रयोगाः - </b>"कारुण्यं निरवधि यत्तव प्रसिद्धं शीतांशोः सहजमिवार्तिहारि शैत्यम्" । "कारुण्यं संविभागश्च यस्य भृत्येषु सर्वदा । सम्भवेत् स महीपालस्त्र्यैलोक्यस्यापि रक्षणे"<br><b>उल्लेखाः - </b>१) चं रा०<br><br>

कारुविन्द
कारुविन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣನಿಂದ ವೈದೇಹಕಿಯಲ್ಲಿ ಹುಟ್ಟಿದ ಮಗ<br><b>विस्तारः - </b>"वैश्यात् वैदेहकं विप्रा क्षत्रकन्या तु मागधम्" - वैज० । "वैदेहकी कारुविन्दम्" - वैज० ।<br><br>

कारूष
कारूष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರೂಷ ದೇಶದ ರಾಜನಾದ ದಂತವಕ್ತ್ರ<br><b>निष्पत्तिः - </b>"अञ्" (४-१-१६६)<br><b>व्युत्पत्तिः - </b>करूषाणां राजा<br><br>कारूष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರೂಷ ದೇಶದ ಜನರು<br><br>

कारेणव
कारेणव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆನೆಯ ಸಂಬಂಧವಾದ /ಆನೆಯಿಂದ ಕರೆಯಲ್ಪಟ್ಟ ಹಾಲು ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>करेणोरेदिम्<br><br>

कारोत्तर
कारोत्तर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಡದ ಮೇಲಿನ ಕೆನೆ<br><b>निष्पत्तिः - </b>उद् + तॄ (प्लवनतरणयोः) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>करेण गलनक्रियया उत्तरति<br><b>विस्तारः - </b>"कारोत्तरः सुरामण्डः" - अम० ।<br><br>कारोत्तर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೂಪ /ಬಾವಿ<br><b>निष्पत्तिः - </b>उद् + तॄ (प्लवनतरणयोः) - "अप्" (३-३-५८)<br><b>व्युत्पत्तिः - </b>कारेन उत्तीर्यते<br><br>कारोत्तर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಡವನ್ನು ಶುದ್ಧಿ ಮಾಡುವ ಜಲ್ಲಡಿ /ಒಂದರಿ<br><br>

कार्कन्धव
कार्कन्धव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲಚಿ ಮರದ ಸಂಬಂಧವಾದ /ಬೋರೆ ಗಿಡದಿಂದ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>कर्कन्धोरिदम्<br><br>

कार्कलासेय
कार्कलासेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಕಲಾಸದ ಅಪತ್ಯ /ಓತಿಕೇತದ ಮರಿ<br><b>निष्पत्तिः - </b>"ढक्" (४-१-१२३)<br><b>व्युत्पत्तिः - </b>कृकलासस्यापत्यम्<br><br>

कार्कवाकव
कार्कवाकव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಕವಾಕು ಸಂಬಂಧವಾದ /ಕೋಳಿಯ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>कृकवाकोरिदम्<br><br>

कार्कश्य
कार्कश्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಠೋರವಾಗಿರುವಿಕೆ /ಕಠಿಣವಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>कर्कशस्य भावः<br><b>प्रयोगाः - </b>"कान्तारभाजि मयि केकयराजपुत्र्याः कार्कश्यकन्दलितया दलितस्य वाचा"<br><b>उल्लेखाः - </b>चं० रा०<br><br>कार्कश्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒರಟಾಗಿರುವಿಕೆ<br><br>कार्कश्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೃಢವಾಗಿರುವಿಕೆ /ಗಟ್ಟಿಯಾಗಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"आश्लेषलोलुपवधूस्तनकार्कश्यसाक्षिणीम्"<br><b>उल्लेखाः - </b>माघ० २-१७<br><br>

कार्कीय
कार्कीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಳಿಯ ಕುದುರೆಯಂತಿರುವ /ಬಿಳಿಯ ಕುದುರೆಯನ್ನು ಹೋಲುವ<br><b>निष्पत्तिः - </b>"ईकक्" (५-३-११०)<br><b>व्युत्पत्तिः - </b>कर्कः शुक्लोऽश्वः स एव<br><br>

कार्ण
कार्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣನ ಮಗ ವೃಷಕೇತು<br><b>निष्पत्तिः - </b>"अण्" (४-१-११२)<br><b>व्युत्पत्तिः - </b>कर्णस्यापत्यम्<br><br>कार्ण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಕಡಕು /ಓಲೆ /ತಾಟಂಕ<br><br>कार्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿವಿಯ ಸಂಬಂಧವಾದ ಗುಗ್ಗೆ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>कर्णस्येदम्<br><br>

कार्त
कार्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತ್ಪ್ರತ್ಯಯಗಳ ವ್ಯಾಖ್ಯಾನ ಗ್ರಂಥ / ಕೃತ್ ಪ್ರತ್ಯಯಗಳ ಅರ್ಥ ವಿವರಿಸುವ ಗ್ರಂಥ<br><b>निष्पत्तिः - </b>"अण्" (४-३-६६)<br><b>व्युत्पत्तिः - </b>कृतां कृत्प्रत्ययानां व्याख्यानो ग्रन्थः<br><br>कार्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತಯುಗ<br><b>निष्पत्तिः - </b>स्वार्थे "अण्" (५-४-३८)<br><b>व्युत्पत्तिः - </b>कृतमेव<br><br>कार्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃತಯುಗ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>कृतस्येदम्<br><b>प्रयोगाः - </b>"त्रेतायुगप्रवर्तितकार्तयुगवृत्तान्तम्"<br><b>उल्लेखाः - </b>रघु०<br><br>

कार्तयुग
कार्तयुग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃತಯುಗ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>कृतयुगस्येदम्<br><br>

कार्तवीर्य
कार्तवीर्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತವೀರ್ಯನ ಮಗ /ಕಾರ್ತವೀರ್ಯಾರ್ಜುನ /ಹೈಹಯದೇಶದ ದೊರೆ<br><b>निष्पत्तिः - </b>"अण्" (४-१-११२)<br><b>व्युत्पत्तिः - </b>कृतवीर्यस्यापत्यम्<br><b>प्रयोगाः - </b>"अर्जुनः कृतवीर्यस्य सप्तद्वीपेश्वरोऽभवत् । दत्तात्रेयाद्धरेरंशान् प्राप्तयोगमहागुणः । न नूनं कार्तवीर्यस्य गतिं यास्यन्ति पार्थिवाः । यज्ञदानतपोयोगश्रुतवीर्यजयादिभिः ॥" "अनन्यसाधारणराजशब्दो बभूव योगी किल कार्तवीर्यः" ।<br><b>उल्लेखाः - </b>भाग० ९-२३, रघु० ६-३८<br><br>

कार्तस्वर
कार्तस्वर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುವರ್ಣ /ಚಿನ್ನ<br><b>निष्पत्तिः - </b>"अण्" (४-३-५३)<br><b>व्युत्पत्तिः - </b>कृतस्वरे आकारविषये भवम्<br><b>प्रयोगाः - </b>"न तप्तकार्तस्वरभास्वराम्बरः कठोरताराधिपलाञ्छनच्छविः" । "जलदास्तटित्तुलितकान्तकार्तस्वराः" ।<br><b>उल्लेखाः - </b>माघ० १-२०, माघ० ४-२४<br><br>कार्तस्वर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದತ್ತೂರಿ ಕಾಯಿ<br><br>

कार्तस्वरभूधर
कार्तस्वरभूधर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇರು ಪರ್ವತ<br><b>प्रयोगाः - </b>"अशोभि कार्तस्वरभूदरस्य"<br><b>उल्लेखाः - </b>नैष० १०-६७<br><br>

कार्तान्तिक
कार्तान्तिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೌಹೂರ್ತಿಕ /ಜೋಯಿಸ /ಭವಿಷ್ಯವನ್ನು ತಿಳಿದು ಹೇಳುವವನು<br><b>निष्पत्तिः - </b>"ठक्" (४-२-६०)<br><b>व्युत्पत्तिः - </b>कृतान्तं वेत्ति<br><br>

कार्तिक
कार्तिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ತಿಕ ಮಾಸ /ಕೃತ್ತಿಕಾ ನಕ್ಷತ್ರದಿಂದ ಕೂಡಿದ ಹುಣ್ಣಿಮೆಯ ಮಾಸ<br><b>निष्पत्तिः - </b>कृत्तिका - "अण्" (४-२-३) । "ङीप्" (४-१-१५) "अण्" (४-२-२१)<br><b>व्युत्पत्तिः - </b>कृत्तिका नक्षत्रेण युक्ता पौर्णमासी कार्तिकी । सास्मिन् मासे ।<br><b>प्रयोगाः - </b>"नक्षत्रनाम्ना मासास्तु ज्ञेयाः पर्वान्तयोगतः"<br><b>उल्लेखाः - </b>सू० सि० १४-१५<br><br>कार्तिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತುಲಾರಾಶಿಯಲ್ಲಿ ಸೂರ್ಯನಿರುವ ಒಂದು ಸೌರಮಾಸ<br><br>कार्तिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತ್ತಿಕಾನಕ್ಷತ್ರದಿಂದ ಕೂಡಿದ ಪೌರ್ಣಮಾಸಿಯುಳ್ಳ ಅರ್ಧಮಾಸ /ಒಂದು ಪಕ್ಷ<br><br>कार्तिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಕಂಧ /ಷಣ್ಮುಖ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>कृत्तिकाणामयं पोष्यत्वेन<br><br>

कार्तिकी
कार्तिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ತಿಕ ಮಾಸದ ಹುಣ್ಣಿಮೆ /ಕೃತ್ತಿಕಾ ನಕ್ಷತ್ರದಿಂದ ಕೂಡಿದ ಹುಣ್ಣಿಮೆ<br><b>निष्पत्तिः - </b>"अण्" (४-२-३)<br><b>व्युत्पत्तिः - </b>कृत्तिकानक्षत्रेण युक्ता पौर्णमासी<br><br>कार्तिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ತಿಕ ಮಾಸದ ಹುಣ್ಣಿಮೆ /ಕೃತ್ತಿಕಾ ನಕ್ಷತ್ರದಿಂದ ಕೂಡಿದ ಹುಣ್ಣಿಮೆ<br><b>निष्पत्तिः - </b>"अण्" (४-२-३) । "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>कृत्तिकानक्षत्रेण युक्ता पौर्णमासी<br><br>

कार्तिकिक
कार्तिकिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ತಿಕ ಮಾಸ /ಕೃತ್ತಿಕಾ ನಕ್ಷತ್ರದಿಂದ ಕೂಡಿದ ಹುಣ್ಣಿಮೆಯುಳ್ಳ ತಿಂಗಳು<br><b>निष्पत्तिः - </b>"ठक्" (४-२-२३)<br><b>व्युत्पत्तिः - </b>कार्तिकी पौर्णमासी अस्मिन् मासे<br><br>कार्तिकिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೃಹಸ್ಪತಿಯ ಒಂದು ವರ್ಷ<br><br>

कार्तिकेय
कार्तिकेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಷಣ್ಮುಖ /ಸ್ಕಂಧ<br><b>निष्पत्तिः - </b>"ढक्" (४-१-१२०)<br><b>व्युत्पत्तिः - </b>कृत्तिकानामपत्यम्<br><br>

कार्त्स्न
कार्त्स्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಕಲ್ಯ /ಸಂಪೂರ್ಣತೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>कृत्स्नस्य भावः<br><b>प्रयोगाः - </b>"कार्त्स्नेन निर्वर्तयितुं च रूपमिच्छन्ति तत्पूर्वसमागतानाम्"<br><br>

कार्पट
कार्पट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಛಿಂದಿಬಟ್ಟೆ /ಹರಕು ಬಟ್ಟೆ<br><b>निष्पत्तिः - </b>स्वार्थे "अण्"<br><b>व्युत्पत्तिः - </b>कर्पट एव<br><br>कार्पट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜತು /ಅರಗು<br><br>कार्पट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಛಿಂದಿಬಟ್ಟೆಯನ್ನು ಉಟ್ಟಿರುವ ಭಿಕ್ಷುಕ<br><br>कार्पट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯಾರ್ಥಿ /ಅರ್ಜಿದಾರ /ಉಮೇದುದಾರ<br><b>विस्तारः - </b>"कर्पटो जतुकार्यिणोः" - मेदि० ।<br><br>

कार्पटिक
कार्पटिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾರ್ತಾರ್ಥಿ /ತೀರ್ಥಯಾತ್ರೆ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>"ठक्" (४-४-८)<br><b>व्युत्पत्तिः - </b>कर्पटेन चरति<br><b>प्रयोगाः - </b>"विश्रान्तकार्पटिकप्रस्फुटितचरणधूलिधूसरकिसलयलाञ्छितोपकण्ठैः"<br><b>उल्लेखाः - </b>काद०<br><br>कार्पटिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರ್ಮವನ್ನು ಅರಿತವನು<br><b>विस्तारः - </b>"कार्पटिकः स मर्मवित्" - त्रिकाण्ड० ।<br><br>कार्पटिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಂಚಕ /ಮೋಸಗಾರ<br><br>कार्पटिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾರ್ಥಾರ್ಥಿಗಳ ಗುಂಪು<br><br>

कार्पण्य
कार्पण्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಾರಿದ್ರ್ಯ /ಬಡತನ<br><br>कार्पण्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಪುಣತನ /ಲೋಭಿತನ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>कृपणस्य भावः<br><br>कार्पण्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತ್ಯಾಗಬುದ್ಧಿಯಿಲ್ಲದಿರುವಿಕೆ<br><br>कार्पण्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ತವ್ಯಜ್ಞಾನವಿಲ್ಲದೆ ಕಷ್ಟದ ನಿವೃತ್ತ್ಯುಪಾಯವನ್ನು ಅರಿಯದಿರುವಿಕೆ /ದೀನತೆ<br><b>प्रयोगाः - </b>"कार्पण्यदोषोपहतस्वभावः पृच्छामि त्वां धर्मसम्मूढचेताः"<br><b>उल्लेखाः - </b>गीता० २-७<br><br>

कार्पास
कार्पास<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿ<br><br>कार्पास<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿಯಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ ಬಟ್ಟೆ<br><br>कार्पास<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗದ<br><b>निष्पत्तिः - </b>"अण् (४-३-१३६)<br><b>व्युत्पत्तिः - </b>कार्पास्याः अवयवः विकारो वा<br><b>प्रयोगाः - </b>"कार्पासकृतकूर्पासशतैरपि न शाम्यति । शीतं शातोदरीपीनवक्षोजालिङ्गनं विना"<br><br>कार्पास<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿಯ ಸಂಬಂಧವಾದ /ಹತ್ತಿಯ ದಾರದಿಂದ ತಯಾರಾದ<br><br>

कार्पासक
कार्पासक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿಯ ಬಟ್ಟೆ<br><b>निष्पत्तिः - </b>स्वार्थे "कः"<br><b>व्युत्पत्तिः - </b>कार्पास एव<br><br>

कार्पासतन्तु
कार्पासतन्तु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿಯ ದಾರ /ಹತ್ತಿಯ ನೂಲು<br><b>व्युत्पत्तिः - </b>कार्पासस्य तन्तुः<br><br>

कार्पासतान्तव
कार्पासतान्तव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿಯ ದಾರದಿಂದ ನಿರ್ಮಿತವಾದ /ಹತ್ತಿಯ ನೂಲಿನ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>कार्पास्तन्तोरिदम्<br><b>प्रयोगाः - </b>"कार्पासतान्तवं क्रौञ्चो गोधा गां वाग्गुदो गुडम्"<br><b>उल्लेखाः - </b>मनु० १२-६४<br><br>

कार्पाससौत्रिक
कार्पाससौत्रिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿಯ ದಾರದಿಂದ ನಿರ್ಮಿತವಾದ ಬಟ್ಟೆ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>"ठक्"(५-३-२०)<br><b>व्युत्पत्तिः - </b>कार्पाससूत्रेण निवृत्तः<br><b>प्रयोगाः - </b>"शते दशपला वृद्धिरौर्णे कार्पाससौत्रिके"<br><b>उल्लेखाः - </b>याज्ञ० २-१७९<br><br>

कार्यासिक
कार्यासिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹತ್ತಿಯ ದಾರದಿಂದ ನಿರ್ಮಿತವಾದ ಬಟ್ಟೆ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-७९)<br><b>व्युत्पत्तिः - </b>कार्पासेन निवृत्तः<br><b>प्रयोगाः - </b>"शतं दासीसहस्राणां कार्पासिकनिवासिनाम्"<br><b>उल्लेखाः - </b>भा० वन० ५१-८<br><br>

कार्पासिका
कार्पासिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿಯ ಗಿಡ<br><b>निष्पत्तिः - </b>कार्पासी- स्वार्थे "कः"<br><b>व्युत्पत्तिः - </b>कार्पास्येव<br><br>

कार्पासी
कार्पासी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತಿಯ ಗಿಡ<br><br>

कार्म
कार्म<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಫಲವನ್ನು ಅಪೇಕ್ಷಿಸದೆ ಕರ್ಮವನ್ನು ಮಾಡುವ ಸ್ವಭಾವದವನು<br><b>निष्पत्तिः - </b>"णः" (६-४-१७२) निपा० ।<br><b>व्युत्पत्तिः - </b>कर्म शीलमस्य<br><br>

कार्मण
कार्मण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಕ್ಷಿಣಿ /ಗಾರುಡಿ<br><br>कार्मण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂತ್ರ ಓಷಧಿ ಮೊದಲಾದುವುಗಳಿಂದ ಮಾಡುವ ವಶೀಕರಣಕಾರ್ಯ /ಮೂಲಿಕೆ ಮೊದಲಾದುವುಗಳಿಂದ ಮಾಡುವ ಸ್ತಂಭನಕಾರ್ಯ /ಮಾತ /ಶೂನ್ಯ<br><b>निष्पत्तिः - </b>"अण्" (५-४-३६)<br><b>व्युत्पत्तिः - </b>कर्मैव<br><b>प्रयोगाः - </b>"चाटु चाकृतकसम्भ्रममासां कार्मणत्वमगमन् रमणेषु"<br><b>उल्लेखाः - </b>माघ० १०-३७<br><br>कार्मण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಯಿಮಾತನ್ನು ಕೇಳಿ ಅದರಂತೆ ಮಾಡುವ ಕಾರ್ಯ<br><b>विस्तारः - </b>"वाचिकं श्रृत्वा क्रियमाणं कर्मेत्यर्थः"- सि० कौ० ।<br><br>कार्मण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯವನ್ನು ಚೆನ್ನಾಗಿ ಮಾಡುವವನು /ಕಾರ್ಯವನ್ನು ಪೂರ್ಣವಾಗಿ ಮಡುವವನು /ಕೆಲಸದಲ್ಲಿ ಚತುರನಾದವನು<br><b>विस्तारः - </b>"कार्मणं मन्त्रतन्त्रादियोजने कर्मठेऽपि च" -मेदि० ।<br><br>

कार्मार
कार्मार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮ್ಮಾರ /ಕಬ್ಬಿಣದ ಕೆಲಸ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>स्वार्थे "अण्" (५-४-३८)<br><b>व्युत्पत्तिः - </b>कर्मार एव<br><br>कार्मार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮ್ಮಾರನ ಮಗ<br><b>निष्पत्तिः - </b>"अण्" (४-१-११२)<br><b>व्युत्पत्तिः - </b>कर्मारस्य अपत्यम्<br><br>

कार्मारी
कार्मारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कार्मार ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्"(४-१-१५)<br><br>

कार्मारक
कार्मारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಮ್ಮಾರನಿಂದ ಮಾಡಲ್ಪಟ್ಟ /ಕಬ್ಬಿಣದ ಕೆಲಸದವನಿಂದ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"वुञ्" (४-३-११८)<br><b>व्युत्पत्तिः - </b>कर्मारेण कृतम्<br><br>

कार्मिक
कार्मिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರಕಾರನ ಕುಶಲತೆಯಿಂದ ನಿರ್ಮಿತವಾದ /ಕಸೂತಿ ಮೊದಲಾದ ಚಿತ್ರಕಾರ್ಯದಿಂದ ನಿರ್ಮಿತವಾದ<br><b>निष्पत्तिः - </b>"ठञ्" (४-४-१९)<br><b>व्युत्पत्तिः - </b>कर्मणा चित्रकर्मणा निवृत्तम्<br><b>प्रयोगाः - </b>"कार्मिके रोमबद्धे च त्रिंशद्भागः क्षयो मतः"<br><b>उल्लेखाः - </b>याज्ञ० २-१८०<br><br>

कार्मिक्य
कार्मिक्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಶಲ ಕಾರ್ಯ ಮಾಡುವಿಕೆ /ಉದ್ಯೋಗಶೀಲತೆ /ಕೈಗಾರಿಕೆ<br><b>निष्पत्तिः - </b>"यक्" (५-१-१२८)<br><b>व्युत्पत्तिः - </b>कार्मिकस्य भावः<br><br>

कार्मुक
कार्मुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶ /ವೇಣು /ಬಿದಿರು<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>कार्मुकं साध्यत्वेनास्त्यस्य<br><br>कार्मुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ಹಲಸಿನ ಗಿಡ<br><br>कार्मुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿಯ ಕಗ್ಗಲಿ ಮರ<br><br>कार्मुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶೋಕ ವೃಕ್ಷ<br><br>कार्मुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡಿರುವಂತಿಗೆ ಗಿಡ<br><br>कार्मुक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧನಸ್ಸು ಬಿಲ್ಲು<br><b>निष्पत्तिः - </b>कर्मन् - "उकञ्" (५-१-१०३)<br><b>व्युत्पत्तिः - </b>कर्मणे प्रभवति<br><b>प्रयोगाः - </b>"कार्मुकेणेव गुणिना बाणः सन्धानमेष्यति"<br><b>उल्लेखाः - </b>माघ० २-९७<br><br>कार्मुक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧನೂರಾಶಿ ಮೇಷದಿಂದ ೯ನೆಯ ರಾಶಿ<br><b>प्रयोगाः - </b>"कार्मुकं तु परित्यज्य झषं सङ्क्रमते रविः"<br><br>कार्मुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರ್ಮಕ್ಷಮನಾದ /ಕಾರ್ಯದಲ್ಲಿ ಸಮರ್ಥನಾದ<br><b>विस्तारः - </b>"कार्मुकं वंशधनुषोः कर्मशक्ते तु वाच्यवत्"- मेदि० । "अथ कार्मुकः । वंशेकार्मुकमिष्वासे कर्मठे" - हेम० ।<br><br>

कार्मुकिन्
कार्मुकिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧನಸ್ಸುನ್ನುಹೊಂದಿರುವ /ಬಿಲ್ಲನ್ನು ಹಿಡಿದಿರುವ<br><b>निष्पत्तिः - </b>कार्मुक - "इनिः" (५-१-११५)<br><br>

कार्य
कार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - कर्म० "ण्यत्" (३-१-१२४)<br><b>व्युत्पत्तिः - </b>क्रियते<br><b>प्रयोगाः - </b>"गुरुद्वयाय गुरुणोरुभयोरथ कार्ययोः"<br><b>उल्लेखाः - </b>माघ० २-६<br><br>कार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಚರಣೆ /ಅನುಷ್ಠಾನ /ನಡೆಸುವಿಕೆ /ಮಾಡುವಿಕೆ<br><br>कार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯೋಜನ /ಫಲ<br><b>प्रयोगाः - </b>"उपसर्पति कार्यार्थी कृतार्थो नोपसर्पति"<br><b>उल्लेखाः - </b>हितो०<br><br>कार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ದೇಶ /ಗುರಿ<br><br>कार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ಯೋಗ /ವೃತ್ತಿ<br><br>कार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆರೋಗ್ಯ<br><b>प्रयोगाः - </b>"भिषक् कर्ताऽथ करणं रसाः दोषास्तु कारणम् । कार्यमारोग्यमेवैकम्"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>कार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇತು /ಕಾರಣ<br><b>विस्तारः - </b>"कार्यं हेतौ प्रयोजने" - मेदि० ।<br><br>कार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ಯಮ /ವ್ಯವಸಾಯ<br><br>कार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>(ವ್ಯಾಕರಣಶಾಸ್ತ್ರದಲ್ಲಿ) ವಿಧಿಸಲ್ಪಡುವ ವರ್ಣ ಪ್ರತ್ಯಯ ಮೊದಲಾದುವು<br><b>प्रयोगाः - </b>"कार्यमनुभवन् हि कार्यी निमित्ततया नाश्रीयते"<br><b>उल्लेखाः - </b>परि०<br><br>कार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯವನ್ನು ವಿಧಿಸುವ ಶಾಸ್ತ್ರ<br><br>कार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜನ್ಮಲಗ್ನದಿಂದ ಹತ್ತನೆಯ ಸ್ಥಾನ<br><b>प्रयोगाः - </b>"कार्याधीषः स्वगेहे बुधगुरुकविभिः संयुतो वेक्षितो वा"<br><br>कार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನ್ಯಾಯಸ್ಥಾನದಲ್ಲಿ ಹೂಡುವ ಮೊಕದ್ದಮೆ /ಋಣಾದಿ ವಿವಾದ /ವ್ಯಾಜ್ಯ<br><b>प्रयोगाः - </b>"नोत्पादयेत्स्वयं कार्यं राजा नाप्यस्य पूरुषः"<br><b>उल्लेखाः - </b>मनु० ८-४३<br><br>कार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ಯವ್ಯ /ಅವಶ್ಯವಾಗಿ ಮಾಡಬೇಕಾದ<br><b>प्रयोगाः - </b>"कार्यमित्येव यत्कर्म नियतं क्रियतेऽर्जुन । सङ्गं त्यक्त्वा फलं चैव स त्यागः सात्त्विको मतः ॥" "तस्माच्छास्त्रं प्रमाणं ते कार्याकार्यव्यवस्थितौ"<br><b>उल्लेखाः - </b>गीता० १८-९, गीता० १६-२४<br><br>कार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿ ಹೊಂದಲು ಯೋಗ್ಯವಾದ /ಉತ್ಪಾದನೆಗೆ ವಿಷಯವಾದ /ಜನ್ಯ<br><br>कार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಲು ಯೋಗ್ಯವಾದ /ಆಚರಿಸಲು ಅರ್ಹವಾದ<br><br>कार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಚರಿಸಲ್ಪಡುವ /ಮಾಡಲ್ಪಡುವ<br><br>

कार्यकर
कार्यकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯವನ್ನು ಮಾಡುವ ಸ್ವಭಾವದವನು /ಕೆಲಸದಲ್ಲಿ ಸಮರ್ಥನಾದವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "टः" (३-२-२०)<br><b>व्युत्पत्तिः - </b>कार्यं करोति<br><br>

कार्यकारण
कार्यकारण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಕಾರ್ಯಕ್ಕೆ ನಿರ್ದಿಷ್ಟವಾದ ಕಾರಣ<br><b>व्युत्पत्तिः - </b>कार्यस्य कारणम्<br><br>

कार्यकारणभाव
कार्यकारणभाव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಕಾರ್ಯ ಮತ್ತೊಂದು ಕಾರಣವಾಗಿರುವಾಗ ಅವುಗಳಿಗಿರುವ ಪರಸ್ಪರ ಸಂಬಂಧ /ಹೇತುಹೇತುಮದ್ಭಾವ<br><b>व्युत्पत्तिः - </b>कार्यकारणयोर्भावः<br><br>

कार्यकारिन्
कार्यकारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸವನ್ನು ಮಾಡುವ ಸ್ವಭಾವದವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>कार्यं करोति<br><br>

कार्यकारिणी
कार्यकारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸವನ್ನು ಮಾಡುವ ಸ್ವಭಾವದವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्"(४-१-५)<br><br>

कार्यकाल
कार्यकाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯಕಾಲಪಕ್ಷ /ವ್ಯಾಕರಣದಲಿ ಉಕ್ತವಾಗಿರುವ ಒಂದು ಪಕ್ಷ<br><br>कार्यकाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸಕ್ಕೆ ಗೊತ್ತಾದ ಕಾಲ<br><b>प्रयोगाः - </b>"याचते कार्यकाले यः स किं भृत्यः स किं सुहृत्"<br><b>उल्लेखाः - </b>हितो० २-३२<br><br>

कार्यकालात्यय
कार्यकालात्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದ ವೇಳೆಯ ಅತಿಕ್ರಮ /ಕೆಲಸದ ಸಮಯವು ಮೀರಿ ಹೋಗುವಿಕೆ<br><b>व्युत्पत्तिः - </b>कार्यकालस्य अत्ययोऽतिक्रमः<br><b>प्रयोगाः - </b>"आयद्युन्मार्गगमने कार्यकालात्ययेषु च । कल्याणवचनं ब्रूयादपृष्टोऽपि हितो नरः ॥"<br><b>उल्लेखाः - </b>हितो० २-१२४<br><br>

कार्यकुशल
कार्यकुशल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸದಲ್ಲಿ ಸಮರ್ಥನಾದವನು /ಕಾರ್ಯದಲ್ಲಿ ಚತುರನಾದವನು<br><b>व्युत्पत्तिः - </b>कार्येषु कुशलः<br><br>

कार्यकौशल
कार्यकौशल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡುವುದರಲ್ಲಿ ಜಾಣತನ /ಕಾರ್ಯದಲ್ಲಿ ನಿಪುಣತೆ /ಸಾಮರ್ಥ್ಯ<br><br>

कार्यक्षम
कार्यक्षम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸದಲ್ಲಿ ಸಮರ್ಥನಾದ /ಕಾರ್ಯ ಮಾಡುವುದರಲ್ಲಿ ಶಕ್ತನಾದ<br><b>व्युत्पत्तिः - </b>कार्येषु दक्षः<br><br>

कार्यगौरव
कार्यगौरव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದ ಗುರುತ್ವ /ಕೆಲಸದ ಮಹತ್ತ್ವ /ಕೆಲಸಕ್ಕಿರುವ ಪ್ರಾಮುಖ್ಯ<br><b>व्युत्पत्तिः - </b>कार्यस्य गौरवम्<br><br>कार्यगौरव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು ಕಾರ್ಯವಿರುವಿಕೆ /ಕೆಲಸಗಳು ಬಹಳವಾಗಿರುವುದು<br><br>

कार्यचिन्तक
कार्यचिन्तक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸವನ್ನು ಯೋಚಿಸಿ ಮಾಡುವ /ಮಾಡಿದ ಮತ್ತು ಮಾಡಬೇಕಾದ ಕಾರ್ಯವನ್ನು ಕುರಿತು ಯೋಚಿಸುವ /ವಿವೇಕದಿಂದ ಕಾರ್ಯಮಾಡುವ<br><b>निष्पत्तिः - </b>चिती (सञ्ज्ञाने) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कार्यं चिन्तयति<br><b>प्रयोगाः - </b>"धर्मज्ञाः शुचयोऽलुब्धाः भवेयुः कार्यचिन्तकाः । कर्तव्यं वचनं तेषां समूहहितवादिनाम् ॥"<br><b>उल्लेखाः - </b>याज्ञ० २-१९१<br><br>

कार्यचिन्ता
कार्यचिन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡುವುದರಲ್ಲಿ ವಿವೇಚನೆ /ಕಾರ್ಯದಲ್ಲಿ ಎಚ್ಚರಿಕೆಯಿಂದ ವಿಚಾರ ಮಾಡುವುದು /ಕಾರ್ಯದಲ್ಲಿ ಯುಕ್ತಾಯುಕ್ತಪರಿಜ್ಞಾನ<br><b>व्युत्पत्तिः - </b>कार्येषु चिन्ता<br><br>

कार्यच्युत
कार्यच्युत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸದಿಂದ ತಳ್ಳಲ್ಪಟ್ಟವನು /ಕೆಲಸದಿಂದ ತೆಗೆದುಹಾಕಲ್ಪಟ್ಟವನು<br><b>व्युत्पत्तिः - </b>कार्यात् च्युतः<br><br>

कार्यतस्
कार्यतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದಿಂದ /ಕೆಲಸದ ಮೂಲಕ<br><b>निष्पत्तिः - </b>कार्य - "तसिः" (५-४-४४)<br><b>प्रयोगाः - </b>"सखा गरीयान् शत्रुश्च कृत्रिमस्तौ हि कार्यतः"<br><b>उल्लेखाः - </b>माघ० २-३६<br><br>

कार्यता
कार्यता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದ ಭಾವ /ಕಾರ್ಯವಾಗಿ ಇರುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कार्यस्य भावः<br><br>

कार्यत्व
कार्यत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದ ಭಾವ /ಕಾರ್ಯವಾಗಿ ಇರುವಿಕೆ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

कार्यदर्शन
कार्यदर्शन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯವನ್ನು ನೋಡಿಕೊಳ್ಳುವುದು /ಕೆಲಸದ ಮೇಲ್ವಿಚಾರಣೆ<br><b>व्युत्पत्तिः - </b>कार्यस्य दर्शनम्<br><b>प्रयोगाः - </b>"यदा स्वयं न कुर्यात्तु नृपतिः कार्यदर्शनम् । तदा नियुञ्ज्यात् विद्वांसं ब्राह्मणं कार्यदर्शने ॥"<br><b>उल्लेखाः - </b>मनु० ८-९<br><br>

कार्यदर्शिन्
कार्यदर्शिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದರ್ಶಿ /ಕೆಲಸವನ್ನು ನೋಡಿಕೊಳ್ಳುವವನು /ಕಾರ್ಯದ ಮೇಲ್ವಿಚಾರಣೆ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>दृशिर् (प्रेक्षणे) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>कार्यं पश्यति<br><br>

कार्यदर्शिनी
कार्यदर्शिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದರ್ಶಿನಿ /ಕೆಲಸವನ್ನು ನೋಡಿಕೊಳ್ಳುವವಳು /ಕಾರ್ಯದ ಮೇಲ್ವಿಚಾರಣೆ ಮಾಡುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कार्यनिर्णय
कार्यनिर्णय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸದ ನಿರ್ಧಾರ /ಕಾರ್ಯದ ತೀರ್ಮಾನ<br><br>कार्यनिर्णय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದ ಫಲ /ನಿರ್ಣಯದ ಫಲ<br><b>निष्पत्तिः - </b>पूर्वनिपातः (३-२-३७)<br><b>व्युत्पत्तिः - </b>निर्णयस्य कार्यम्<br><b>प्रयोगाः - </b>"उभयस्य प्रतिभूर्ग्राह्यः समर्थः कार्यनिर्णये"<br><b>उल्लेखाः - </b>याज्ञ० २-१०<br><br>

कार्यपुट
कार्यपुट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಯೋಜನವಿಲ್ಲದ ಕೆಲಸವನ್ನು ಮಾಡುವ<br><br>कार्यपुट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಪಣ /ಜಿಪುಣ<br><br>कार्यपुट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉನ್ಮತ್ತ /ಹುಚ್ಚ<br><b>विस्तारः - </b>"कार्यपुटोऽनर्थकरे कृपणोन्मत्तयोरपि" - हेम० ।<br><br>

कार्यप्रद्वेष
कार्यप्रद्वेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಲಸ್ಯ /ಸೋಮಾರಿತನ<br><b>निष्पत्तिः - </b>प्र + द्विष (अप्रीतौ) - कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>कार्यं प्रद्विषत्यनेन<br><br>कार्यप्रद्वेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದಲ್ಲಿ ದ್ವೇಷ /ಕೆಲಸದಲ್ಲಿ ಆದರವಿಲ್ಲದಿರುವುದು<br><br>

कार्यप्रेष्य
कार्यप्रेष्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೂತ /ಯಾವುದಾದರೊಂದು ಕಾರ್ಯಕ್ಕಾಗಿ ಕಳುಹಿಸಲ್ಪಟ್ಟವನು<br><br>

कार्यवत्
कार्यवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದಿಂದ ಕೂಡಿದ /ಕೆಲಸವುಳ್ಳ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>कार्यमस्यास्ति<br><b>प्रयोगाः - </b>"विधाय वृत्तिं भार्यायाः प्रवसेत् कार्यवान्नरः"<br><b>उल्लेखाः - </b>मनु० ९-७४<br><br>कार्यवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವುದಾದರೊಂದು ಉದ್ದೇಶವುಳ್ಳ /ಒಂದು ಗುರಿಯುಳ್ಳ<br><br>कार्यवत्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೆಲಸದಂತೆ /ಅವಶ್ಯವಾಗಿ ಮಾಡಬೇಕಾದ ಕೆಲಸದ ಹಾಗೆ<br><b>प्रयोगाः - </b>"योऽकार्यं कार्यवच्छास्ति न किम्मन्त्री नृपेच्छया । वरं स्वामिमनो दुःखं तन्नाशो नत्वकार्यतः ॥"<br><b>उल्लेखाः - </b>हितो० ३-१०३<br><br>

कार्यवत्ता
कार्यवत्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದಿಂದ ಕೂಡಿರುವುದು /ಕೆಲಸದಿಂದ ಕೂಡಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कार्यवतो भावः<br><br>

कार्यवश
कार्यवश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸಕ್ಕೆ ಅಧೀನವಾದ /ಯಾವುದಾದರೊಂದು ಕಾರ್ಯದ ನಿರ್ಬಂಧಕ್ಕೆ ಒಳಪಟ್ಟ<br><br>

कार्यवस्तु
कार्यवस्तु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಡಲ್ಪಡಬೇಕಾದ ವಿಷಯ /ಯಾವುದು ಮಾಡಲ್ಪಡುವುದೋ ಅದು<br><br>

कार्यविद्
कार्यविद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯವನ್ನು ತಿಳಿದಿರುವ /ವಿಷಯವನ್ನು ಅರಿತಿರುವ<br><b>निष्पत्तिः - </b>विद (ज्ञाने) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>कार्यं वेत्ति<br><b>प्रयोगाः - </b>"जोषं जनः कार्यविसस्तु वस्तु"<br><b>उल्लेखाः - </b>नैष० ७-१०७<br><br>

कार्यविनिमय
कार्यविनिमय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸದ ಬದಲಾವಣೆ /ಪರಸ್ಪರ ಕಾರ್ಯದ ಬದಲಾವಣೆ /ಒಪ್ಪಂದದಂತೆ ಒಬ್ಬನ ಕೆಲಸವನ್ನು ಇನ್ನೊಬ್ಬನು ಮಾಡುವಂತೆ ಬದಲಾಯಿಸಿಕೊಳ್ಳುವುದು<br><b>व्युत्पत्तिः - </b>कार्यस्य विनिमयः<br><b>प्रयोगाः - </b>"कथं कार्यविनिमयेन मयि व्यवहरत्यनात्मजः"<br><b>उल्लेखाः - </b>माल०<br><br>

कार्यविनिर्णय
कार्यविनिर्णय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದ ನಿಶ್ಚಯ /ಕೆಲಸದ ತೀರ್ಮಾನ<br><b>व्युत्पत्तिः - </b>कार्यस्य विनिर्ययः<br><b>प्रयोगाः - </b>"धर्मं शाश्वतमाश्रित्य कुर्यात्कार्यविनिर्णयम्"<br><b>उल्लेखाः - </b>मनु० ८-८<br><br>

कार्यविपत्ति
कार्यविपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯನಾಶ /ಕೆಲಸವು ಕೆಟ್ಟು ಹೋಗುವುದು<br><b>व्युत्पत्तिः - </b>कार्यस्य विपत्तिः<br><b>प्रयोगाः - </b>"न गणस्याग्रतो गच्छेत् सिद्धे कार्ये समं फलम् । यदि कार्यविपत्तिः स्यात् मुखरस्तत्र हन्यते ॥"<br><b>उल्लेखाः - </b>हितो० १-२९<br><br>

कार्यशेष
कार्यशेष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದ ಉಳಿಕೆ /ಕೆಲಸವು ಬಾಕಿಯಾಗಿರುವುದು<br><b>व्युत्पत्तिः - </b>कार्यस्य शेषः<br><br>

कार्यसंसिद्धि
कार्यसंसिद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯವು ಕೈಗೂಡುವಿಕೆ /ಕೆಲಸವು ಸಫಲವಾಗುವುದು<br><b>व्युत्पत्तिः - </b>कार्यस्य संसिद्धिः<br><b>प्रयोगाः - </b>"मनसा कार्यसंसिद्धौ त्वराद्विगुणरंहसा"<br><b>उल्लेखाः - </b>कुमा० २-६३<br><br>

कार्यसाधक
कार्यसाधक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸವನ್ನು ಸಾಧಿಸುವ /ಕಾರ್ಯವನ್ನು ಕೈಗೂಡಿಸುವ<br><b>व्युत्पत्तिः - </b>कार्यस्य साधकः<br><br>

कार्यसाधिका
कार्यसाधिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸವನ್ನು ಸಾಧಿಸುವ /ಕಾರ್ಯವನ್ನು ಕೈಗೂಡಿಸುವ<br><b>व्युत्पत्तिः - </b>कार्यस्य साधिका<br><b>प्रयोगाः - </b>"अल्पानामपि वस्तूनां संहतिः कार्यसाधिका । तृणैर्गुणत्वमापन्नैः बध्यते मत्तदन्तिनः ॥"<br><b>उल्लेखाः - </b>हितो० १-३५<br><br>

कार्यसिद्धि
कार्यसिद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯವು ಕೈಗೂಡುವಿಕೆ /ಕೆಲಸವು ಸಫಲವಾಗುವುದು<br><b>व्युत्पत्तिः - </b>कार्यस्य सिद्धिः<br><b>प्रयोगाः - </b>"अस्तित्वं कार्यसिद्धेः स्फुटमथ कथयन् पक्षतेः कम्पभेदैः"<br><b>उल्लेखाः - </b>नैष० ३-१३२<br><br>

कार्यस्थान
कार्यस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸ ನಡೆಸುವ ಜಾಗ /ಕಾರ್ಯಾಲಯ<br><br>कार्यस्थान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಷದಲ್ಲಿ ಲಗ್ನದಿಂದ ಹತ್ತನೆಯ ಸ್ಥಾನ<br><br>

कार्याधिप
कार्याधिप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸದ ಯಜಮಾನ /ಅಧ್ಯಕ್ಷ<br><br>कार्याधिप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಷದಲ್ಲಿ ಕಾರ್ಯಸ್ಥಾನಾಧಿಪತಿ /ಲಗ್ನದಿಂದ ಹತ್ತನೆಯ ಸ್ಥಾನದ ಗ್ರಹ<br><b>व्युत्पत्तिः - </b>कार्यस्याधिपः<br><br>

कार्यानुमेय
कार्यानुमेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸದಿಂದ ಊಹಿಸಲ್ಪಡುವ<br><br>कार्यानुमेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸದಿಂದ ಊಹಿಸಲು ಯೋಗ್ಯವಾದ<br><br>कार्यानुमेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸದಿಂದ ಊಹಿಸಲು ಶಕ್ಯವಾದ<br><b>व्युत्पत्तिः - </b>कार्येण अनुमेयः<br><b>प्रयोगाः - </b>"कार्यानुमेयाः सर्वत्र परोक्षगुणवृत्तयः । तस्मात् परोक्षवृत्तीनां फलैः कर्मानुभाव्यते ॥"<br><b>उल्लेखाः - </b>हितो० ४-१०१<br><br>

कार्यान्तर
कार्यान्तर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರೆ ಕೆಲಸ /ಅಮ್ತ್ತೊಂದು ಕೆಲಸ<br><b>व्युत्पत्तिः - </b>अन्यत् कार्यम्<br><br>कार्यान्तर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದ ಮಧ್ಯಕಾಲ /ಕೆಲಸದ ಮಧ್ಯೆ ವಿರಾಮಕಾಲ<br><b>व्युत्पत्तिः - </b>कार्यस्य अन्तरम्<br><br>

कार्यान्तरसचिव
कार्यान्तरसचिव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರೆ ಕೆಲಸದ ಸಹಾಯಕ /ರಾಜಕೀಯಕ್ಕಿಂತಲೂ ಭಿನ್ನವಾದ ಕೆಲಸಕ್ಕೆ ಸಹಾಯವಾಗಿರುವವನು<br><b>व्युत्पत्तिः - </b>कार्यान्तरे सचिवः सहायः<br><b>प्रयोगाः - </b>"अयमपरः कार्यान्तरसचिवोऽस्मानुपस्थितः"<br><b>उल्लेखाः - </b>माल० १<br><b>विस्तारः - </b>"सचिवो मन्त्रिचेटयोः" - मेदि० ।<br><br>

कार्याब्धि
कार्याब्धि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದ ಸಮುದ್ರ /ಸಮುದ್ರದಂತಿರುವ ಅನೇಕ ಕೆಲಸಗಳು /ಸಮುದ್ರದಂತಿರುವ ದೊಡ್ಡ ಕೆಲಸ<br><b>प्रयोगाः - </b>"धूर्तः स्त्री वा शिशुर्यस्य मन्त्रिणः स्युर्महीपतेः । अनीतिपवनक्षिप्तः कार्याब्धौ स निमज्जति ॥"<br><b>उल्लेखाः - </b>हितो० ३-१३१<br><br>

कार्यार्थम्
कार्यार्थम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೆಲಸಕ್ಕಾಗಿ /ಯಾವುದಾದರೊಂದು ಕಾರ್ಯಕ್ಕೋಸ್ಕರ<br><b>व्युत्पत्तिः - </b>कार्याय । कार्यार्थम् ।<br><b>प्रयोगाः - </b>"दिवा चरेयुः कार्यार्थं चिह्निता राजशासनैः"<br><b>उल्लेखाः - </b>मनु० १०-५५<br><br>

कार्यार्थिन्
कार्यार्थिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸವನ್ನು ಅಪೇಕ್ಷಿಸುವವನು /ಕೆಲಸವನ್ನು ಬೇಡುವವನು<br><b>निष्पत्तिः - </b>अर्थ (उपयाचने) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>कार्यमर्थयते<br><br>कार्यार्थिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ಯೋಗವನ್ನು ಬೇಡುವವನು<br><br>कार्यार्थिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನ್ಯಾಯಾಲಯದಲ್ಲಿ ಕಾರಣವನ್ನು ಹಿಡಿದು ವಾದಿಸುವವನು<br><br>

कार्यार्थिनी
कार्यार्थिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कार्यार्थिन् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कार्यिक
कार्यिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸವುಳ್ಳವನು<br><br>कार्यिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ಯೋಗವುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कार्यमस्यास्ति<br><br>कार्यिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನ್ಯಾಯವಾದಿ /ನ್ಯಾಯಾಲಯದಲ್ಲಿ ವ್ಯಾಜ್ಯದ ಕಾರಣವನ್ನು ಹಿಡಿದು ವಾದಿಸುವವನು<br><b>प्रयोगाः - </b>"ये कार्यिकेभ्योऽर्थमेव गृह्णीयुः पापचेतसः । तेषां सर्वस्वमादाय राजा कुर्यात् प्रवासनम् ॥"<br><b>उल्लेखाः - </b>मनु० ७-१२४<br><br>

कार्यिका
कार्यिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कार्यिक ಪದದ ಅರ್ಥ<br><br>

कार्यिन्
कार्यिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯವುಳ್ಳವನು /ಯಾವುದಾದರೊಂದು ಕೆಲಸ ಹೊಂದಿರುವವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कार्यमस्यास्ति<br><br>कार्यिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲ್ಸವನ್ನು ಅಪೇಕ್ಷಿಸುವವನು<br><br>कार्यिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ಯೋಗವನ್ನು ಬೇಡುವವನು<br><br>कार्यिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣಶಾಸ್ತ್ರದಲ್ಲಿ ಆದೇಶ ಮೊದಲಾದ ಕಾರ್ಯಕ್ಕೆ ವಿಷಯವಾದ ಸ್ಥಾನಿ<br><b>प्रयोगाः - </b>"कार्यमनुभवन् हि कार्यी निमित्ततया नाश्रीयते"<br><b>उल्लेखाः - </b>परि०<br><br>कार्यिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ಯೋಗವುಳ್ಳವನು /ಯಾವುದಾದರೊಂದು ವ್ಯವಹಾರವುಳ್ಳವನು<br><br>कार्यिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯಾಜ್ಯದಲ್ಲಿ ವಾದಿ ಅಥವಾ ಪ್ರತಿವಾದಿ<br><br>

कार्शानव
कार्शानव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಶಾನುಸಂಬಂಧವಾದ /ಬೆಂಕಿಯ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>कृशानोरिदम्<br><b>प्रयोगाः - </b>"फलद्भिरुष्णांशुकराभिर्मशात्कार्शानवं धाम पतङ्गकान्तैः"<br><b>उल्लेखाः - </b>माघ० ४-१६<br><br>

कार्श्य
कार्श्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಶವಾಗಿರುವಿಕೆ /ತೆಳ್ಳಗಿರುವಿಕೆ /ಬಡಕಲಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>कृशस्य भावः<br><b>प्रयोगाः - </b>"तदद्य ते वन्यफलाशिनः परं परैति कार्श्यं यशसा समं वपुः"<br><b>उल्लेखाः - </b>किरा० १-३९<br><br>कार्श्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕದಾಗಿರುವಿಕೆ /ಕಡಿಮೆಯಾಗಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"निर्बन्धसञ्जातरुषार्थकार्श्यमचिन्तयित्वा गुरुणाहमुक्तः"<br><b>उल्लेखाः - </b>रघु० ५-२१<br><br>

कार्ष
कार्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಸಾಯ ಮನೋಧರ್ಮವುಳ್ಳ ಕೃಷೀವಲ /ರೈತ<br><b>निष्पत्तिः - </b>"अण्" (४-४-६२)<br><b>व्युत्पत्तिः - </b>कृषिः शीलमस्य<br><br>

कार्षक
कार्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷೀವಲ /ರೈತ<br><b>निष्पत्तिः - </b>कर्षक - स्वार्थे "अण्" (५-४-३८)<br><br>

कार्षापण
कार्षापण<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಬಗೆಯ ನಾಣ್ಯ /ಕರ್ಷತೂಕದ ಬೆಳ್ಳಿಯ ನಾಣ್ಯ /ಹದಿನಾರು ಆದ್ಯ ಮಾಷಗಳ ತೂಕದ ನಾಣ್ಯ<br><b>निष्पत्तिः - </b>पण (व्यवहारे) - "अप्" (३-३-६६)<br><b>व्युत्पत्तिः - </b>कर्षस्येदम् कार्षम् । तेन आपण्यते ।<br><b>प्रयोगाः - </b>"ते षोडश स्यात् हरणं पुराणश्चैव राजतः । कार्षापणस्तु विज्ञेयः ताम्रिकः कार्षिकः पणः ॥"<br><b>उल्लेखाः - </b>मनु० ८-१३६<br><br>कार्षापण<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹದಿನಾರು ಪಣಗಳು<br><b>विस्तारः - </b>"कार्षापणोऽस्त्री कार्षिके पणषोडशकेऽपि च" - मेदि० ।<br><br>

कार्षापणिक
कार्षापणिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಷಾಪಣ ನಾಣ್ಯದಿಂದ ಕ್ರಯಕ್ಕೆ ಕೊಳ್ಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"टिठन्" (वा० ५-१-२५)<br><b>व्युत्पत्तिः - </b>कार्षापणेन क्रीतः<br><br>

कार्षि
कार्षि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>निष्पत्तिः - </b>कृष (विलेखने) - "इञ्" (उ० ४-१२६)<br><br>कार्षि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆಯುವಿಕೆ<br><br>कार्षि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಳುಮೆ /ಬೇಸಾಯ<br><br>कार्षि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯುವ<br><br>कार्षि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಳುವ /ಬೇಸಾಯ ಮಾಡುವ<br><br>

कार्षिक
कार्षिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಷತೂಕದ ಬೆಳ್ಳಿಯ ನಾಣ್ಯ<br><b>निष्पत्तिः - </b>"ठञ्" (वा० ४-३-६०)<br><b>व्युत्पत्तिः - </b>कर्षे भवम्<br><br>कार्षिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕರ್ಷದ ಬೆಲೆಬಾಳುವ<br><b>निष्पत्तिः - </b>"ठञ्"(५-१-६४)<br><b>व्युत्पत्तिः - </b>कर्षं नित्यमर्हति<br><br>कार्षिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ಕರ್ಷದಿಂದ ಕೊಳ್ಳಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"ठञ्" (५-१-३७)<br><b>व्युत्पत्तिः - </b>कर्षेण क्रीतम्<br><br>कार्षिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೇಸಾಯಗಾರ /ರೈತ<br><b>निष्पत्तिः - </b>"ठक्"(४-४-६१)<br><b>व्युत्पत्तिः - </b>कर्षः कर्षणं शीलमस्य<br><br>

कार्ष्ण
कार्ष्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣನ ಸಂಬಂಧವಾದ<br><br>कार्ष्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣದ್ವೈಪಾಯನರ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>कृष्णस्येदम्<br><br>कार्ष्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಮೃಗದ ಸಂಬಂಧವಾದ /ಕೃಷ್ಣಮೃಗದ ಚರ್ಮದಿಂದ ನಿರ್ಮಿತವಾದ<br><b>प्रयोगाः - </b>"कार्ष्णरौरवबास्तानि चर्माणि ब्रह्मचारिणः । वसीरन्नानुपूर्व्येण शाणक्षौमाविकानि च ॥"<br><b>उल्लेखाः - </b>मनु० २-४१<br><br>कार्ष्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಪಕ್ಷಕ್ಕೆ ಸಂಬಂಧಪಟ್ಟ<br><br>

कार्ष्णायन
कार्ष्णायन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಸಮಹರ್ಷಿಯ ಗೋತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದ<br><br>कार्ष्णायन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣ ಗೋತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>"फक्" (४-१-९९)<br><b>व्युत्पत्तिः - </b>कृष्णस्य गोत्रापत्यम्<br><br>

कार्ष्यायस
कार्ष्यायस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಲೋಹ /ಕಬ್ಬಿಣ<br><br>कार्ष्यायस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಲೋಹಸಂಬಂಧವಾದ<br><br>कार्ष्यायस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಲೋಹದಿಂದ ನಿರ್ಮಿತವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०) । "अण्" (४-३-१३४)<br><b>व्युत्पत्तिः - </b>कृष्णायसः इदम् । कृष्णायसो विकारः ।<br><b>प्रयोगाः - </b>"कार्ष्नायसमलङ्कारः परिव्रज्या च नित्यशः"<br><b>उल्लेखाः - </b>मनु० १०-५२<br><br>

कार्ष्यायसी
कार्ष्यायसी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कार्ष्यायस ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><b>प्रयोगाः - </b>"अभ्रिं कार्ष्णायसीं दद्यात् सर्पं हत्वा द्विजोत्तमः"<br><b>उल्लेखाः - </b>मनु० ११-१३३<br><br>

कार्ष्णि
कार्ष्णि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣದ್ವೈಪಾಯನರ ಮಗ /ಶುಕಮಹರ್ಷಿ<br><br>कार्ष्णि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣನ ಮಗ /ಕಾಮ /ಮನ್ಮಥ /ಪ್ರದ್ಯುಮ್ನ<br><b>निष्पत्तिः - </b>"इञ्" (४-१-९६)<br><b>व्युत्पत्तिः - </b>कृष्णस्यापत्यम्<br><b>प्रयोगाः - </b>"कार्ष्णिं प्रत्यग्रहीदेकः सरस्वानिव निम्नगाः"<br><b>उल्लेखाः - </b>माघ० १९-१०<br><br>

कार्ष्ण्य
कार्ष्ण्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣನ ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><b>निष्पत्तिः - </b>"यञ्" (४-१-१०५)<br><b>व्युत्पत्तिः - </b>कृष्णस्य गोत्रापत्यम्<br><br>कार्ष्ण्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣತ್ವ /ಕಪ್ಪು<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>कृष्णस्य भावः<br><br>

कार्ष्मन्
कार्ष्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧ /ಕಾಳಗ<br><b>निष्पत्तिः - </b>कृष (विलेखने) + स्वार्थे णिच् - अधि० "मनिन्" (उ० ४-१४४)<br><br>कार्ष्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆಯುವಿಕೆ<br><b>निष्पत्तिः - </b>कृष - भावे "मनिन्"<br><br>

कार्ष्मरी
कार्ष्मरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶೀವನೆಯ ಮರ<br><b>निष्पत्तिः - </b>रा (दाने) - "कः" (३-१-३) ।गौरा० "ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>कार्ष्म कर्षणं राति<br><br>

कार्ष्य
कार्ष्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತಿಮರ<br><b>निष्पत्तिः - </b>कृष (विलेखने) - "कः" (३-१-१३५) । "ष्यञ्" (वा० ५-१-१२४)<br><b>व्युत्पत्तिः - </b>कृषति<br><b>विस्तारः - </b>"साले तु सर्जकार्ष्याश्वकर्णकाः सस्यसंवराः" - अम०<br><br>

कार्ष्यवण
कार्ष्यवण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತಿಮರದ ಕಾಡು<br><b>निष्पत्तिः - </b>"णत्वम्" (८-४-५)<br><b>व्युत्पत्तिः - </b>कार्ष्यस्य वनम्<br><br>

काल
काल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ಪರಮಾತ್ಮ<br><b>निष्पत्तिः - </b>कल (शब्दसङ्ख्यानयोः) - अधि० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>कलते सङ्कलितं भवत्यस्मिन् चराचरं जगत्<br><b>प्रयोगाः - </b>"ऋतुः सुदर्शनः कालः परमेष्ठी परिग्रहः" । "कालोऽस्मि लोकक्षकृत् प्रवृद्धो लोकान् समाहर्तुमिह प्रवृत्तः" ।<br><b>उल्लेखाः - </b>वि० स०, गीता० ११-३२<br><b>विस्तारः - </b>"चिदचित्कालनात्कालः गुणैरात्मनि चेदृशैः" - निरुक्तिः ।<br><br>काल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಯ /ವೇಳೆ /ಹೊತ್ತು<br><b>निष्पत्तिः - </b>कल (क्षेपे) + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कलयति सर्वाणि भूतानि<br><b>प्रयोगाः - </b>"कालः सृजति भूतानि कालः संहरति प्रजाः"<br><b>विस्तारः - </b>"कलनात् सर्वभूतानां स कालः परिकीर्तितः"<br><br>काल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಯಾ ಕಾರ್ಯಗಳಿಗೆ ಯೋಗ್ಯವಾದ ಸಮಯ<br><b>प्रयोगाः - </b>"वरमेकाहुतिः काले नाकाले लक्षकोटयः"<br><br>काल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಷದಲ್ಲಿ ಉಕ್ತವಾಗಿರುವ ಒಂದು ಯೋಗ<br><br>काल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವಕಾಶ /ಪುರುಸೊತ್ತು /ವಿರಾಮ<br><br>काल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವಧಿ /ಗಡು /ಒಂದು ಗೊತ್ತಾದ ಸಮಯ<br><br>काल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಬಣ್ಣ<br><b>प्रयोगाः - </b>"कालोऽकलो कलिः काले कोलिकेलिकिलः किल"<br><b>उल्लेखाः - </b>माघ० १९-९८<br><br>काल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶನಿಗ್ರಹ<br><br>काल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಮ<br><b>प्रयोगाः - </b>"आभीलानि प्राणिनः प्रत्यवस्यन् कालो नूनं व्याददावाननानि"<br><b>उल्लेखाः - </b>माघ० १८-७८<br><br>काल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾಕಾಲ /ಪರಮೇಶ್ವರ /ಶಿವ<br><br>काल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೃತಿ /ಮರಣ<br><br>काल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><br>काल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಂಖ್ಯಮತದಲ್ಲಿ ಉಕ್ತವಾದ ೯ ವಿಧ ತುಷ್ಟಿಗಳಲ್ಲೊಂದು<br><b>विस्तारः - </b>प्रकृतिः, उपादानम्, कालः, भागः - ಇವು ೪ ಆಧ್ಯಾತ್ಮಿಕ ತುಷ್ಟಿಗಳು. अर्जनदोषदर्शनजन्यविषयोपरमजन्या, रक्षणदोषदर्शनविषयोपरमजन्या, क्षयदोषदर्शनजन्यविषयोपरमजन्या, भोगदोषदर्शनजन्यविषयोपरमजन्या, हिंसादोषदर्शनजन्यविषयोपरमजन्या- ಇವು ೫ ಬಾಹ್ಯ ತುಷ್ಟಿಗಳು. "आध्यात्मिक्यश्चतस्रः प्रकृत्युपादानकालभागाख्याः । बाह्याः विषयोपरमात्पञ्च च नव तुष्टयोऽभिमताः ॥" - सां० का० ५०<br><br>काल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಬಣ್ಣದ<br><br>काल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸುವ /ಪೀಡಿಸುವ<br><br>

काला|काली
काला - ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ<br><b>विस्तारः - </b>ವರ್ಣವಿಶಿಷ್ಟವಾದರೆ काली ಎಂದೂ ಸಂಜ್ಞಾವಾಚಕವಾದರೆ काला ಎಂದೂ ಆಗುವುದು.<br><br>काला - ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿಯ ತಿಗಡೆ ಮರ<br><br>काला - ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿಯ ಜೀರಿಗೆ<br><br>काला - ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೀಲಿ ಗಿಡ<br><br>काला - ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಜಿಷ್ಠೆ<br><b>विस्तारः - </b>"कालोऽनेहा यमो मृत्युः श्यामो ना तद्वति त्रिषु । काला तु कृष्णत्रिवृते नीलिन्यां कृष्णजीरके ॥" - नानार्थर० ।<br><br>

काली
काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲಿಕಾದೇವಿ /ದುರ್ಗಾದೇವಿಯ ಒಂದು ರೂಪ<br><b>प्रयोगाः - </b>"प्रीतेन तेन प्रभुणा नियुक्ता काली कलत्रस्य मुदे प्रियस्य"<br><b>उल्लेखाः - </b>कुमा० ९-४९<br><br>काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ಷೀರಕೀಟ /ಹುಳಿ ಬಂದ ಹಾಲಿನಲ್ಲಿ ಹುಟ್ಟುವ ಒಂದು ಜಾತಿಯ ಹುಳು<br><br>काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಸ ಮೇಘಗಳ ಸಮೂಹ<br><br>काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪವಾದ<br><br>काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಪ್ತ ಮಾತೃಗಳಲ್ಲಿ ಒಬ್ಬಳು<br><b>प्रयोगाः - </b>"तासां च पश्चात्कनकप्रभाणां काली कपालाभरणा चकाशे"<br><b>उल्लेखाः - </b>कुमा०७-३९<br><br>काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೀಮಸೇನನ ಒಬ್ಬ ಹೆಂಡತಿ<br><b>प्रयोगाः - </b>"अथ घटोत्कचः । भीमसेनाद्धिडिम्बायां काल्यां सर्वगतस्ततः"<br><b>उल्लेखाः - </b>भाग० ९-२-२४<br><br>काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಬಣ್ಣದ ಹೆಂಗಸು<br><br>काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾತ್ರಿ<br><br>काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ೭ ಜಿಹ್ವೆಗಳಲ್ಲೊಂದು<br><br>काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಯವತಿ /ಶಂತನು ಚಕ್ರವರ್ತಿಯ ಪತ್ನಿ /ವೇದವ್ಯಾಸರ ತಾಯಿ<br><br>काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಶಿವನ ೯ ಶಕ್ತಿಗಳಲ್ಲೊಂದು<br><b>विस्तारः - </b>"काली कलेबरा भूतदमनी चेशशक्तयः ।" - वैज० । "कादम्बिनी मेघमाला काली कृष्णनवाम्बुदः" - वैज० ।<br><br>काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಜ್ಜಿ ಬದನೆಕಾಯಿ<br><b>विस्तारः - </b>"बृहत्यां प्रहसा काली वार्ताकी हिङ्गुदी कुली" - वैज० ।<br><br>काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಪ್ಪಲಿ<br><br>काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತು ವಿಧ ಮಹಾವಿದ್ಯೆಗಳಲ್ಲಿ ಒಂದು<br><b>प्रयोगाः - </b>"काली तारा महाविद्या षोडशी भुवनेश्वरी । भैरवी छिन्नमस्ता च विद्या धूमावती तथा । वगला सिद्धविद्या च मातङ्गी कमलात्मिका । एता दश महाविद्याः सिद्धविद्याः प्रकीर्तिताः ॥"<br><b>उल्लेखाः - </b>तन्त्रसा०<br><b>विस्तारः - </b>"कालो मृत्यौ महाकाले समये यमकृष्णयोः । कृष्णत्रिवृत्तौ काला तु नीलीमञ्जिष्ठयोरपि । काली गौर्यां क्षीरकीटे कालिकामातृभेदयोः । नवाम्बुवाहवृन्देऽपि परिवादेऽपि च क्वचित्" - विश्व० ।<br><br>

कालक
कालक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಗಾತಿ /ಮೈಮೇಲೆ ಹುಟ್ಟುವ ಕಪ್ಪು ಚುಕ್ಕಿ / ಮಚ್ಚೆ<br><b>निष्पत्तिः - </b>कल (क्षेपे) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कालयति<br><br>कालक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರುಹಾವು<br><br>कालक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಕೃತ್ತು /ಹೊಟ್ಟೆಯ ಬಲಭಾಗದ ದೊಡ್ಡ ಮಾಂಸಗ್ರಂಥಿ<br><br>कालक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀಲಿಬಣ್ಣದಲ್ಲಿ ಅದ್ದಲ್ಪಟ್ಟ ಬಟ್ಟೆ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>काल - "कन्" (५-४-३३)<br><br>कालक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪ ಮೊದಲಾದ ಕಾರಣಗಳಿಂದ ತತ್ಕಾಲದಲ್ಲಿ ಬಣ್ಣ ಬದಲಾಯಿಸಿದ ಮುಖ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>काल - "कन्" (५-४-३३)<br><b>विस्तारः - </b>कालस्य पटः । कालिका शाटी । कालकं मुखम् ।<br><br>

कालकञ्ज
कालकञ्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಾನವರ ಒಂದು ಗುಂಪು<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>कालकञ्ज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀಲೋತ್ಪಲ /ನೀಲಿ ಕಮಲ /ಕನ್ನೈದಿಲೆ<br><b>प्रयोगाः - </b>"पौलोमैः कालकञ्जैश्च नित्यहृष्टैरधिष्ठितम्"<br><b>उल्लेखाः - </b>भा० वन० १७३-२<br><br>

कालकटङ्कट
कालकटङ्कट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><b>व्युत्पत्तिः - </b>कालस्य कटङ्कटः<br><b>प्रयोगाः - </b>"वैणवी पणवी ताली खली कालकटङ्करः"<br><br>

कालकण्ठ
कालकण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><b>व्युत्पत्तिः - </b>कालः कण्ठोऽस्य विषपानात्<br><b>प्रयोगाः - </b>"ततः करतलीकृत्य व्यापि हालाहलं विषम् । अभक्षयन्महादेवः कृपया भूतभावनः । तस्यापि दर्शयामास स्ववीर्यजलकल्मषः । यच्चकार गले नीलं तच्च साधोर्विभूषणम् ॥"<br><b>उल्लेखाः - </b>भाग० ८-७<br><br>कालकण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಯೂರ /ನವಿಲು<br><br>कालकण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರುಕೋಳಿ<br><br>कालकण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಬ್ಬಚ್ಚಿ<br><br>कालकण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡಿಗೆ ಸೊಗಸಿನ ಹಕ್ಕಿ<br><br>कालकण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ತಿಮರ<br><b>विस्तारः - </b>"कालकण्ठस्य दात्यूहे कलविङ्के च खञ्जने । मयूरे पीतसारे च स्यात् खण्डपरशौ पुमान्" - मेदि० ।<br><br>

कालकण्ठक
कालकण्ठक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರುಕೋಳಿ<br><b>निष्पत्तिः - </b>वा "कप्" (५-४-१५४)<br><br>कालकण्ठक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಬ್ಬಚ್ಚಿ<br><br>

कालकलि
कालकलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೀರೋಚನನ ಮಗ /ಒಬ್ಬ ರಾಕ್ಷಸ /ಬಲಿಚಕ್ರವರ್ತಿಯ ಸಹೋದರ<br><br>

कालका
कालका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಕ್ಷಸಿ /ಕಾಲಕೇಯ ರಾಕ್ಷಸರ ತಾಯಿ /ಮಾರೀಚನ ಹೆಂಡತಿ<br><br>

कालकूट
कालकूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ /ನಂಜು /ಸಮುದ್ರಮಥನದ ಸಮಯದಲ್ಲಿ ಉತ್ಪನ್ನವಾಗಿ ಮಹಾದೇವನಿಂದ ನುಂಗಲ್ಪಟ್ಟ ಒಂದು ವಿಷ<br><b>व्युत्पत्तिः - </b>कालस्य मृत्योः कूटो राशिरिव<br><br>

कालकूटक
कालकूटक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ /ನಂಜು /ಸಮುದ್ರಮಥನದ ಸಮಯದಲ್ಲಿ ಉತ್ಪನ್ನವಾಗಿ ಮಹಾದೇವನಿಂದ ನುಂಗಲ್ಪಟ್ಟ ಒಂದು ವಿಷ<br><b>निष्पत्तिः - </b>स्वार्थे "कन्"<br><b>प्रयोगाः - </b>"ततो दुर्योधनः पापः तद्भक्ष्ये कालकूटकम् । विप्रं प्रक्षेपयामास भीमसेनजिघांसया ॥"<br><b>उल्लेखाः - </b>भा० आदि० १२७<br><br>

कालकृत्
कालकृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>कालं करोति<br><b>विस्तारः - </b>ಸೂರ್ಯನು ತನ್ನ ಗತಿಯಿಂದ ಕ್ಷಣ ಮುಹೂರ್ತ ಯಾಮ ದಿವಸ ಮುಂತಾದ ಕಾಲವನ್ನು ಗೊತ್ತುಮಾಡುವುದರಿಂದ ಈ ಹೆಸರು.<br><br>कालकृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ /ಪರಮೇಶ್ವರ<br><b>प्रयोगाः - </b>"त्रयीमयोऽयं भगवान् कालात्मा कालकृद्विभुः"<br><b>उल्लेखाः - </b>सू० सि० १२-२८<br><br>

कालकृत
कालकृत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>कालः कृतो येन<br><b>विस्तारः - </b>ಕಾಲಕ್ಕೆ ಸೂರ್ಯನು ಕಾರಣನಾದುದರಿಂದ ಈ ಹೆಸರು.<br><br>कालकृत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಗದಿಯಾದ ಅವದಿಯುಳ್ಳ ಗಿರವಿ /ಗೊತ್ತಾದ ಗಡುವುಳ್ಳ ಅಡಮಾನ /<br><b>प्रयोगाः - </b>"आधिः प्रणश्येत् द्विगुणे धने यदि न मोक्ष्यते । काले कालकृतो नश्येत् फलभोग्यो न नश्यति ॥"<br><b>उल्लेखाः - </b>याज्ञ० २-५८<br><br>

कालकेय
कालकेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಾನವರ ಒಂದು ಗುಂಪು<br><b>निष्पत्तिः - </b>"ढक्" (४-१-१२०)<br><b>व्युत्पत्तिः - </b>कालकाया अप्त्यम्<br><b>प्रयोगाः - </b>"हिरण्यपुरमित्येवं ख्यायते नगरं महत् । रक्षितं कालकेयैश्च पौलोमैश्च महासुरैः ॥"<br><b>उल्लेखाः - </b>भा० वन० १७३-१३<br><br>

कालक्षेप
कालक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಲಸವಿಲ್ಲದೆ ಕಾಲ ಕಳೆಯುವುದು<br><br>कालक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲವು ವ್ಯರ್ಥವಾಗುವಿಕೆ<br><b>व्युत्पत्तिः - </b>कालस्य क्षेपः<br><br>कालक्षेप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾವಕಾಶ /ಸಮಯ ಮೀರುವಿಕೆ /ಗೊತ್ತಾದ ಕಾಲವನ್ನು ಮೀರುವುದು<br><br>

कालखण्ड
कालखण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಕೃತ್ತು /ಹೊಟ್ಟೆಯ ಬಲಭಾಗದ ದೊಡ್ಡ ಮಾಂಸಗ್ರಂಥಿ<br><b>व्युत्पत्तिः - </b>कालं च खण्डं च<br><b>प्रयोगाः - </b>"स्वादुङ्कारं कालखण्डोपदंशं क्रोष्टा डिम्बं व्यष्वणद्व्यस्वनच्च"<br><b>उल्लेखाः - </b>माघ० १८-७७<br><br>

कालग्रन्थि
कालग्रन्थि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಷ /ಸಂವತ್ಸರ<br><b>व्युत्पत्तिः - </b>कालस्य ग्रन्थिरिव<br><b>विस्तारः - </b>"कालग्रन्थिः समा संवन्मासमानो युगांसकः" - हारा०<br><br>

कालघातिन्
कालघातिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲಕ್ರಮದಲ್ಲಿ ಸಾವಕಾಶವಾಗಿ ಕೊಲ್ಲುವ ವಿಷ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>कालेन हन्ति<br><br>

कालचक्र
कालचक्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಕ್ರದಂತೆ ಉರುಳುತ್ತಿರುವ ಕಾಲ<br><b>व्युत्पत्तिः - </b>कालस्य चक्रमिव<br><b>प्रयोगाः - </b>"यथा कुलालचक्रेण भ्रमता सह भ्रमतां तदाश्रयाणां पिपीलिकादीनां गतिरन्यैव प्रदेशान्तरेष्वप्युपलम्भमानत्वात् एवं नक्षत्रराशिभिरुपलक्षितेन कालचक्रेण ध्रुवं मेरुं च प्रदक्षिणेन परिधावता सह परिधावमानानां तदाश्रयाणां सूर्यादीनां ग्रहाणां गतिरन्यैव नक्षत्रान्तरे राश्यन्तरेचोपलभ्यमानत्वात्"<br><b>उल्लेखाः - </b>भाग० ५-२२-२<br><br>कालचक्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲರೂಪವಾದ ಚಕ್ರ<br><b>व्युत्पत्तिः - </b>कालस्य कालगतेः चक्रमिव<br><b>प्रयोगाः - </b>"एवमेष चरन् पार्थ कालचक्रमतन्द्रितः । प्रकर्षन् सर्वभूतानि सविता परिवर्तते ॥"<br><b>उल्लेखाः - </b>भा० वन० १६३-४०<br><br>

कालचिन्तक
कालचिन्तक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲಗತಿಯನ್ನು ವಿಚಾರಮಾಡುವ ದೈವಜ್ಞ /ಗ್ರಹಗಳ ಚಾರವನ್ನು ತಿಳಿದಿರುವ ಜೋಯಿಸ<br><b>निष्पत्तिः - </b>चिति (स्मृत्याम्) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कालं चिन्तयति<br><br>

कालचिह्न
कालचिह्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರಣಲಕ್ಷಣ /ಮೃತ್ಯುವನ್ನು ಸೂಚಿಸುವ ಲಕ್ಷಣ<br><b>व्युत्पत्तिः - </b>कालस्य मृत्योः ज्ञापकं चिह्नम्<br><br>

कालज्ञ
कालज्ञ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೈವಜ್ಞ /ಜ್ಯೋತಿಷದಲ್ಲಿ ಉಕ್ತವಾದ ಕಾಲವಿಚಾರವನ್ನು ತಿಳಿದಿರುವ ಜೋಯಿಸ<br><b>निष्पत्तिः - </b>ज्ञा (अवबोधने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कालं कालावयवं जानाति<br><br>कालज्ञ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಕ್ಕುಟ /ಕೋಳಿ<br><br>कालज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕರ್ತವ್ಯಕ್ಕೆ ಯೋಗ್ಯವಾದ ಕಾಲವನ್ನು ತಿಳಿದವನು<br><b>प्रयोगाः - </b>"तेजः क्षमा वा नैकान्तं कालज्ञस्य महीपतेः"<br><b>उल्लेखाः - </b>माघ० २-८३<br><br>कालज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೂತಭವಿಷಯ್ದ್ವರ್ತಮಾನಕಾಲಗಳನ್ನು ತಿಳಿದಿರುವ ಜ್ಞಾನಿ<br><br>

कालज्ञान
कालज्ञान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಃಶಾಸ್ತ್ರ<br><b>निष्पत्तिः - </b>ज्ञा (अवबोधने) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>कालो ज्ञायतेऽनेन<br><b>प्रयोगाः - </b>"विदितस्ते मया भावस्तोषितस्तपसाह्ययम् । दद्यां कालाश्रयं ज्ञानं ग्रहाणां चरितं महत् ॥"<br><b>उल्लेखाः - </b>सू० सि० ५<br><br>कालज्ञान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರಣಸೂಚಕವಾದ ಚಿಹ್ನೆ<br><b>निष्पत्तिः - </b>ज्ञा (अवबोधने) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>कालो मृत्युर्ज्ञायतेऽनेन<br><br>

कालज्ञानिन्
कालज्ञानिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಲದ ಅರಿವುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कालज्ञानमस्यास्ति<br><br>

कालत्रय|कालत्रितय
कालत्रय -त्रितय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂರು ಕಾಲಗಳು /ಭೂತ ಭವಿಷ್ಯತ್ ಮತ್ತು ವರ್ತಮಾನರೂಪವಾದ ೩ ಕಾಲಗಳು<br><b>व्युत्पत्तिः - </b>कालस्य त्रयं त्रितयं वा<br><b>प्रयोगाः - </b>"शरीरभाजां भवदीयदर्शनं व्यनक्ति कालत्रितयेऽपि योग्यताम्"<br><b>उल्लेखाः - </b>माघ० १-२३<br><br>

कालदण्ड
कालदण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಷೋಕ್ತವಾದ ಆನಂದ ಮೊದಲಾದ ೨೮ ಯೋಗಗಳಲ್ಲೊಂದು<br><br>

कालधर्म
कालधर्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೃತ್ಯು /ಮರಣ<br><b>व्युत्पत्तिः - </b>कालस्य धर्मः<br><b>प्रयोगाः - </b>"अप्राप्तवति तस्मिंस्तु यौवनं पुरुषर्षभे । स राजा शन्तनुर्धीमान् कालधर्ममुपेयिवान् ॥"<br><b>उल्लेखाः - </b>भा० आदि० १०१-१<br><br>कालधर्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಋತುಧರ್ಮ /ವಸಂತಾದಿ ಋತುಗಳ ಸ್ವಭಾವ<br><br>

कालधर्मन्
कालधर्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೃತ್ಯು /ಮರಣ<br><b>निष्पत्तिः - </b>"अनिच्" (५-४-१२४)<br><b>व्युत्पत्तिः - </b>कालस्येव धर्मोऽस्य<br><b>प्रयोगाः - </b>"स तया सह सङ्गम्य भर्यया कुरुनन्दनः । पाण्डुः परमधर्मात्मा युयुजे कालधर्मणा ॥"<br><b>उल्लेखाः - </b>भा० आदि० १२४-१२<br><br>

कालनर
कालनर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಷ ಮೊದಲದ ೧೨ ರಾಶಿರೂಪವಾದ ಶಿರಸ್ಸು ಮೊದಲಾದ ೧೨ ಅಂಗಗಳುಳ್ಳ ಕಾಲಪುರುಷ<br><b>प्रयोगाः - </b>"इति कालनरस्याङ्गे सदसद्ग्रहयोगतः"<br><b>उल्लेखाः - </b>बृहज्जा०<br><br>कालनर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಭಾನರರಾಜನ ಮಗ<br><br>

कालनाथ
कालनाथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><b>व्युत्पत्तिः - </b>कालस्य भैरवस्य नाथः<br><b>प्रयोगाः - </b>"कालनाथाय कल्याय क्षयायोपक्षयाय च"<br><b>उल्लेखाः - </b>भा० शान्ति० २८६-८९<br><br>

कालनाभ
कालनाभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿರಣ್ಯಾಕ್ಷನ ಒಬ್ಬ ಮಗ<br><b>निष्पत्तिः - </b>"अच्" (५-४-७५)<br><b>व्युत्पत्तिः - </b>कालः कृष्णः नाभिरस्य<br><b>प्रयोगाः - </b>"हिरण्याक्षसुताः पञ्च विद्वांसः सुमहाबलाः । झर्झरः शकुनिश्चैव भूतसन्तापनस्तथा । महानाभश्च विक्रान्तः कालनाभस्तथैव च ॥"<br><br>

कालनियोग
कालनियोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲದ ಆಜ್ಞೆ /ಕಾಲದ ನಿಯಮ /ಅದೃಷ್ಟ<br><b>व्युत्पत्तिः - </b>कालस्य नियोगः<br><br>

कालनेमि
कालनेमि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಕ್ಷಸ /ರಾವಣನ ಸೋದರಮಾವ<br><b>व्युत्पत्तिः - </b>कालस्य मृत्योर्नेमिरिव<br><br>कालनेमि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿರಣ್ಯಕಶಿಪುವಿನ ಒಬ್ಬ ಮಗ<br><br>

कालनेमिरिपु
कालनेमिरिपु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ಪರಮಾತ್ಮ<br><br>कालनेमिरिपु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹನುಮಂತ<br><br>

कालनेमिहन्
कालनेमिहन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲನೇಮಿಯನ್ನು ಸಂಹರಿಸಿದ ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) - "क्विप्" (३-२-८७)<br><b>व्युत्पत्तिः - </b>कालनेमिं हतवान्<br><br>कालनेमिहन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹನುಮಂತ<br><br>

कालनेमिनिहन्
कालनेमिनिहन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲನೇಮಿಯನ್ನು ಸಂಹರಿಸಿದ ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>नि + हन (हिंसागत्योः) - "क्विप्" (३-२-८७)<br><b>प्रयोगाः - </b>"कालनेमिनिहाशौरिः शूरः शूरजनेश्वरः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"कालचक्रस्य या नेमिरविद्याख्या च दुर्धरा । तां नाशयति यश्चासौ कालनेमिनिहा स्मृतः ॥" - निरुक्तिः ।<br><br>

कालपथ
कालपथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶ್ವಾಮಿತ್ರಮಹರ್ಷಿಯ ಒಬ್ಬ ಮಗ<br><b>प्रयोगाः - </b>"मधुच्छन्दश्च भगवान् देवरातश्च वीर्यवान् । अक्षीणश्च शकुन्तश्च बभ्रुः कालपथस्तथा ॥"<br><b>उल्लेखाः - </b>भा० अनु० ४-५०<br><br>

कालपर्णी
कालपर्णी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣ ತುಲಸಿ<br><br>

कालपर्यय
कालपर्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲಪರಿಭ್ರಮಣ /ಕಾಲವು ತಿರುಗುವುದು /ಕಾಲಗತಿ /ಕಾಲಕ್ರಮ<br><b>व्युत्पत्तिः - </b>कालस्य पर्ययः वैपरीत्येन गमनम्<br><br>कालपर्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲವು ಕಳೆದು ಹೋಗುವಿಕೆ /ಸಾವಕಾಶ /ಕಾಲವು ಮೀರುವುದು<br><b>प्रयोगाः - </b>"सा भूत् कालस्य पर्ययः"<br><b>उल्लेखाः - </b>रामा०<br><br>

कालपर्वत
कालपर्वत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತ್ರಿಕೂಟಪರ್ವತದ ಹತ್ತಿರದ ಒಂದು ಬೆಟ್ಟ<br><b>प्रयोगाः - </b>"स निश्चित्य ततः कृत्यं स्वसारमुपसान्त्व्य च । ऊर्ध्वमाचक्रमे राजन् विधाय नगरे विधिम् । त्रिकूटं समतिक्रम्य कालपर्वतमेव च । ददर्श मकरावासं गम्भीरेदं महोदधिम् ॥"<br><b>उल्लेखाः - </b>भा० वन० २७७<br><br>

कालपालक
कालपालक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಲವನ್ನು ಪ್ರತೀಕ್ಷಿಸುವ /ಸಮಯವನ್ನು ಎದುರುನೋಡುವ<br><b>निष्पत्तिः - </b>पाल (रक्षणे) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कालं पालयति<br><br>

कालपुरुष
कालपुरुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲವ್ಯ್ವಹಾರಕ್ಕೆ ಕಾರಣವಾದ ಮೇಷಾದಿ ೧೨ ರಾಶಿರೂಪವಾದ ಪುರುಷಾಕಾರದ ಒಂದು ಚಕ್ರ<br><br>कालपुरुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಬಣ್ಣದ ಮನುಷ್ಯ<br><br>

कालपृष्ठ
कालपृष्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಣಹದ್ದು<br><b>विस्तारः - </b>"कालपृष्ठं तु कोदण्डमात्रके कर्णधन्वनि । कालपृष्ठो कङ्के" - हेम० ।<br><br>कालपृष्ठ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧನುಸ್ಸು /ಬಿಲ್ಲು<br><br>कालपृष्ठ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣನ ಬಿಲ್ಲು<br><b>व्युत्पत्तिः - </b>कालं पृष्ठं यस्य<br><br>

कालप्रबोध
कालप्रबोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರಿಯಾದ ಕಾಲದಲ್ಲಿ ಎಚ್ಚರಿಕೆ<br><b>व्युत्पत्तिः - </b>काले यथाकालं प्रबोधः<br><br>

कालप्रबोधिन्
कालप्रबोधिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸರಿಯಾದ ಕಾಲದಲ್ಲಿ ಎಚ್ಚರಿಕೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>काले प्रबोधोऽस्यास्ति<br><br>कालप्रबोधिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸರಿಯಾದ ಕಾಲದಲ್ಲಿ ಎಚ್ಚರಗೊಳಿಸುವ /ಸಕಾಲದಲ್ಲಿ ತಿಳುವಳಿಕೆ ಕೊಡುವ<br><b>निष्पत्तिः - </b>प्र + बुध (अवगमने) + णिच् - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>काले प्रबोधयति<br><br>

कालप्रभात
कालप्रभात<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶರದೃತು<br><b>व्युत्पत्तिः - </b>कालं कृष्णं प्रभातं यत्र<br><br>

कालभक्ष
कालभक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರುದ್ರ /ಈಶ್ವರ<br><br>

कालभृत्
कालभृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>

कालभैरव
कालभैरव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶಿಯಲ್ಲಿ ಈಶ್ವರನ ಅಂಶದಿಂದ ಹುಟ್ಟಿದ ಭೈರವ<br><b>व्युत्पत्तिः - </b>भीरोर्भावः भैरवं भीरुत्वम्, कालस्य भरवं भयं यस्मात्<br><b>प्रयोगाः - </b>"त्वत्तो भेष्यति कालोऽपि ततस्तु कालभैरवः"<br><b>उल्लेखाः - </b>काशीखं०<br><br>

कालमयूख
कालमयूख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸ್ಮೃತಿ ಗ್ರಂಥ<br><br>

कालमाधवीय
कालमाधवीय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಧವಾಚಾರ್ಯರಿಂದ ರಚಿತವಾದ ಒಂದು ಸ್ಮೃತಿಗ್ರಂಥ<br><br>

कालमान
कालमान<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣ ತುಲಸಿ<br><b>निष्पत्तिः - </b>मन (ज्ञाने) - कर्म० "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>कालो मन्यतेऽसौ<br><br>कालमान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲದ ಪರಿಮಾಣ /ಕಾಲದ ಅಳತೆ<br><b>व्युत्पत्तिः - </b>कालस्य मानं परिमाणम्<br><br>

कालमुख
कालमुख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಮುಖವುಳ್ಳ ಒಂದು ಜಾತಿಯ ಕಪಿ<br><b>व्युत्पत्तिः - </b>कालं मुखं यस्य<br><b>प्रयोगाः - </b>"यस्य शाखामृगा मित्राण्यृक्षाः कालमुखास्तथा"<br><b>उल्लेखाः - </b>भा० वन० २९४-१२<br><br>कालमुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಮುಖವುಳ್ಳವನು<br><br>

कालमुखी
कालमुखी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कालमुख ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीष्" (४-१-५४)<br><br>

कालमेषिका
कालमेषिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಜಿಷ್ಠೆ<br><br>कालमेषिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿಯ ತಿಗಡೆ<br><b>निष्पत्तिः - </b>मिष (स्पर्धायाम्) - "अण्" (३-२-१) । स्वार्थे "कन्" (५-३-७५)<br><b>व्युत्पत्तिः - </b>कालं वर्णं मिषति<br><b>प्रयोगाः - </b>"मञ्जिष्ठा विकसा जिङ्गी समङ्गा कालमेषिका"<br><b>विस्तारः - </b>"काला मसूरविदलार्धचन्द्रा कालमेषिका" - अम० ।<br><br>

कालमेषी
कालमेषी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಜಿಷ್ಠೆ<br><br>कालमेषी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಹುಜಿಗೆ ಗಿಡ<br><b>विस्तारः - </b>"कालमेषी कृष्णफला वागुजी पूतिफल्यपि" - अम० ।<br><br>

कालयवन
कालयवन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯವನರಿಗೆ ಒಡೆಯನಾದ ಒಬ್ಬ ದೊರೆ /ಯಾದವರಿಗೆ ಅಜೇಯನಾದ ಒಬ್ಬ ಶತ್ರು /ಯಾದವರ ಪುರೋಹಿತರಾದ ಗರ್ಗಋಷಿಯ ಮಗ<br><b>प्रयोगाः - </b>"ये चान्ये कालयवनसाल्वरुक्मिद्रुमादयः"<br><b>उल्लेखाः - </b>माघ० २-९८<br><br>

कालयापन
कालयापन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲಹರಣ /ಕಾಲ ಕಳೆಯುವಿಕೆ /ಕಾಲವಿಳಂಬ<br><b>व्युत्पत्तिः - </b>कालस्य यापनम्<br><br>

कालयुक्त
कालयुक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಭವ ಮೊದಲಾದ ೬೦ ಸಂವತ್ಸರಗಳಲ್ಲಿ ೫೨ ನೆಯ ಸಂವತ್ಸರ<br><br>कालयुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೃತ್ಯುವಿನೊಡನೆ ಕೂಡಿದ<br><b>व्युत्पत्तिः - </b>कालेन युक्तः<br><br>

कालयुक्ति
कालयुक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲದೊಡನೆ ಸೇರುವುದು<br><br>

कालयोग
कालयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲದ ಸಂಬಂಧ<br><b>प्रयोगाः - </b>"महता कालयोगेन प्रकृतिंयास्यतेऽर्णवः"<br><b>उल्लेखाः - </b>भा० वन०<br><br>कालयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಷೋಕ್ತವಾದ ಒಂದು ಯೋಗ<br><br>

कालयोगिन्
कालयोगिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>काल एव योगोऽस्त्यस्य<br><b>प्रयोगाः - </b>"कालयोगी महानादः सर्वकामश्चतुष्पथः"<br><b>उल्लेखाः - </b>भा०<br><br>कालयोगिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲದ ಸಂಬಂಧವುಳ್ಳ<br><br>

कालरात्रि
कालरात्रि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮನ ಹಗಲಲ್ಲಿ ಪ್ರಪಂಚದ ಸೃಷ್ಟ್ಯಾದಿ ವ್ಯಾಪಾರವೆಲ್ಲ ಕೊನೆಗೊಂಡಮೇಲೆ ಎಲ್ಲವೂ ನಾಶವಾಗಿ ಬ್ರಹ್ಮನು ನಿದ್ರಿಸುವ ಕಾಲ /ಬ್ರಹ್ಮನ ರಾತ್ರಿಕಾಲ /ಪ್ರಳಯಕಾಲದ ರಾತ್ರಿ /೧೪ ಮಂದಿ ಮನುಗಳ ಅಧಿಕಾರದ ಕೊನೆಯ ಕಾಲ<br><b>व्युत्पत्तिः - </b>कालो रात्रिरिव अप्रकाशकत्वात्<br><b>प्रयोगाः - </b>"कालरात्रिकरालास्यदन्तान्तर्गतया मया । दृष्टासि सखि सैव त्वं पुनरत्रैव जन्मनि ॥"<br><b>उल्लेखाः - </b>प्रबोध० ४-२<br><br>कालरात्रि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿಯ ಒಂದು ರೂಪ<br><b>प्रयोगाः - </b>"कालरात्रिर्महारात्रिर्मोहरात्रिश्च दारुणा"<br><b>उल्लेखाः - </b>देवीमा०<br><br>कालरात्रि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮನುಷ್ಯನ ಜೀವಮಾನದಲ್ಲಿ ೭೭ ನೆಯ ವರ್ಷದ ೭ನೆಯ ತಿಂಗಳಿನ ೭ನೆಯ ರಾತ್ರಿ<br><br>कालरात्रि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಗ್ಗತ್ತಲೆಯ ರಾತ್ರಿ<br><br>कालरात्रि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೀಪಾವಳಿಯ ಅಮಾವಾಸ್ಯೆ<br><b>विस्तारः - </b>"दीपावली तु या प्रोक्ता कालरात्रिश्च सा मता"<br><br>कालरात्रि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯಕ್ಕೆ ಅನರ್ಹವಾದ ಕಾಲ<br><b>प्रयोगाः - </b>"रवौ षष्ठं विधौ वेदं कुजवारे द्वितीयकम् । बुधे सप्त गुरौ पञ्च भृगुवारे तृतीयकम् । शनावाद्यं तथाचान्त्यं रातौ कालं विवर्जयेत् ॥"<br><br>

काललौह
काललौह<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣ /ಉಕ್ಕು<br><br>

कालविद्
कालविद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಲವನ್ನು ತಿಳಿದಿರುವ /ಸಮಯವನ್ನು ಅರಿತಿರುವ<br><b>निष्पत्तिः - </b>विद (ज्ञाने) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>कालं वेत्ति<br><b>प्रयोगाः - </b>"यूपवत्यवसिते क्रियाविधौ कालवित् कुशिकवंशवर्धनः"<br><b>उल्लेखाः - </b>रघु० ११-३७<br><br>

कालविप्रकर्ष
कालविप्रकर्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೂರದ ಕಾಲ /ಹತ್ತಿರವಲ್ಲದ ಕಾಲ<br><b>व्युत्पत्तिः - </b>कालस्य विप्रकर्षः<br><br>

कालविभक्ति
कालविभक्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲವಿಭಾಗ /ಪಕ್ಷ ಮಾಸ ಋತು ಅಯನ ಮುಂತಾದ ಕಾಲದ ಭಾಗ<br><b>व्युत्पत्तिः - </b>कालस्य विभक्तिः<br><b>प्रयोगाः - </b>"कालं कालविभक्तीश्च नक्षत्राणि ग्रहान् तथा । सरितः सागरान् शेलान् समानि विषमाणि च ॥"<br><b>उल्लेखाः - </b>मनु० १-२४<br><br>

कालविभाग
कालविभाग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲವಿಭಾಗ /ಪಕ್ಷ ಮಾಸ ಋತು ಅಯನ ಮುಂತಾದ ಕಾಲದ ಭಾಗ<br><b>प्रयोगाः - </b>"कालविभागे चानहोरात्राणाम्"<br><b>उल्लेखाः - </b>पा० सू० ३-३-१३७<br><br>

कालवृद्धि
कालवृद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಗದಿಯಾದ ಆಯಾಕಾಲಗಳಲ್ಲಿ ಕೊಡುವ ವೃದ್ಧ್ಯಂಶ /ತಿಂಗಳು ಕಾಲುವರ್ಷ ಅರ್ಧವರ್ಷ ಮತ್ತು ವರ್ಷಗಳಲ್ಲಿ ಕೊಡಬೇಕಾದ ಬಡ್ಡಿ<br><b>प्रयोगाः - </b>"नाति सांवत्सरीं वृद्धिं नचादृष्टां पुनर्हरेत् । चक्रवृद्धिः कालवृद्धिः कारिता कायिका च या ॥"<br><b>उल्लेखाः - </b>मनु० ८-१५३<br><br>

कालवृन्त
कालवृन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುರುಳಿ ಗಿಡ<br><b>व्युत्पत्तिः - </b>कालं कृष्णं वृन्तमस्य<br><br>

कालवृन्ती
कालवृन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸುರು ಪಾದರೀ ಗಿಡ<br><br>

कालवेग
कालवेग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸುಕಿಯ ಮಗ<br><br>

कालवेला
कालवेला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವ ಶುಭಕಾರ್ಯಕ್ಕೂ ಯೋಗ್ಯವಲ್ಲದ ವೇಳೆ /ಭಾನು ಮೊದಲಾದ ವಾರಗಳಲ್ಲಿ ಶನಿಯ ವೇಳೆ<br><b>व्युत्पत्तिः - </b>कालस्य वेला<br><br>

कालशाख
कालशाख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿಬೇವಿನ ಗಿಡ<br><b>प्रयोगाः - </b>"कालशाकं महाशल्काः खड्गलोहामिषं मधु । आनन्त्यायैव कल्प्यन्ते मन्यन्नानि च सर्वशः ॥"<br><b>उल्लेखाः - </b>मनु० ३-२७२<br><br>

कालशालि
कालशालि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಧಾನ್ಯ /ಕೃಷ್ಣವ್ರೀಹಿ<br><br>

कालशेय|कालसेय
कालशे(से)य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಡೆದ ಮೊಸರು<br><b>निष्पत्तिः - </b>"ढक्" (४-३-५६)<br><b>व्युत्पत्तिः - </b>कलश्यां भवम्<br><b>विस्तारः - </b>"दण्डाहतं कालशेयम्" - अम० ।<br><br>

कालशैल
कालशैल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಪರ್ವತ<br><b>प्रयोगाः - </b>"उशीरबीजं मैनाकं गिरिं श्वेतं च भारत । समतीतोऽसि कौन्तेय कालशैलं च पार्थिव ॥"<br><b>उल्लेखाः - </b>भा० वन० १३९-१<br><br>

कालसंरोध
कालसंरोध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಹಳ ಕಾಲದವರೆಗೂ ಇರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>कालस्य संरोधः<br><b>प्रयोगाः - </b>"न चाधेः कालसरोधान्निसर्गोऽस्ति न विक्रियः"<br><b>उल्लेखाः - </b>मनु० ८-१४३<br><br>

कालसर्प
कालसर्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಸರ್ಪ /ಮಹಾವಿಷವುಳ್ಳ ಒಂದು ಸರ್ಪ<br><b>व्युत्पत्तिः - </b>कालः कृष्णः सर्पः<br><br>कालसर्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಹು ಕೇತುಗಳ ಮಧ್ಯೆ ಎಲ್ಲಾ ಗ್ರಹಗಳೂ ಸಂಚರಿಸುವುದರಿಂದ ಉಂಟಾದ ಒಂದು ಕೆಟ್ಟ ಯೋಗ<br><br>

कालसार
कालसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಸಾರ /ಕಪ್ಪು ಚುಕ್ಕಿಯುಳ್ಳ ಒಂದು ಜಾತಿಯ ಜಿಂಕೆ<br><b>व्युत्पत्तिः - </b>कालः कृष्णवर्णः सारः प्रधानमस्य<br><br>कालसार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಳದಿ ಚಂದನ<br><br>

कालसाह्वय
कालसाह्वय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲಸೂತ್ರವೆಂಬ ಒಂದು ನರಕ<br><b>व्युत्पत्तिः - </b>कालेन समानः आह्वयो यस्य<br><br>

कालसूत्र
कालसूत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನರಕ<br><b>व्युत्पत्तिः - </b>कालस्य यमस्य सूत्रमिव बन्धनहेतुत्वात्<br><br>

कालसूर्य
कालसूर्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಳಯಕಾಲದ ಸೂರ್ಯ<br><br>

कालस्कन्ध
कालस्कन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಮಾಲವೃಕ್ಷ /ಹೊಂಗೆಮರ<br><b>व्युत्पत्तिः - </b>कालः कृष्णः स्कन्धोऽस्य<br><br>कालस्कन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೂಬರೆ‍ಗಿಡ<br><br>

कालहर
कालहर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ /ಮೃತ್ಯುಂಜಯ<br><b>निष्पत्तिः - </b>हृञ् (हरणे) - "अच्" (३-२-९)<br><b>व्युत्पत्तिः - </b>कालं मृत्युं हरति<br><br>कालहर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಶಿವಲಿಂಗ<br><b>प्रयोगाः - </b>"तस्मात् पूर्वं भद्रकामः पर्वतस्तु त्रिकोणकः । यत्र कालहरो नाम शिवलिङ्गं व्यवस्थितम् ॥"<br><br>कालहर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲವನ್ನು ತಿಂದುಹಾಕುವ /ಕಾಲವನ್ನು ಅಪಹರಿಸುವ<br><b>व्युत्पत्तिः - </b>कालं वेलां हरति<br><br>

कालहरण
कालहरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲ ಕಳೆಯುವಿಕೆ<br><b>व्युत्पत्तिः - </b>कालस्य हानिः<br><br>

कालहानि
कालहानि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾವಕಾಶ /ವಿಲಂಬ /ತಡ<br><br>

कालहोरा
कालहोरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲಗ್ನದ ಅರ್ಧಕಾಲ /ಹಗಲು ಮತ್ತು ರಾತ್ರಿ ಕಾಲಗಳಲ್ಲಿ ಮೇಷಾದಿ ೧೨ ಲಗ್ನಾಧಿಪತಿಗಳ ಕಾಲ<br><br>

काला
काला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷಬ್ರಹ್ಮನ ಮಗಳು /ಕಶ್ಯಪನ ಪತ್ನಿ<br><b>प्रयोगाः - </b>"प्रजज्ञिरे महाभाग दक्षकन्यास्त्रयोदश । अदितिर्दितिर्दनुः काला दनायुः सिंहिका तथा ॥"<br><b>उल्लेखाः - </b>भा० आदि० ६६-१२<br><br>काला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಜಿಷ್ಠೆ<br><br>काला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಗಂಧಿಯ ಗಿಡ<br><br>काला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸುರು ಪಾದರೀ ಗಿಡ<br><br>काला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿ ಜೀರಿಗೆ<br><br>काला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ<br><br>काला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿತಿಗಡೆ<br><br>काला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೀಲಿ ಗಿಡ<br><b>विस्तारः - </b>"काला तु कृष्णा त्रिवृता मञ्जिष्ठानीलिनीषु च" - मेदि० ।<br><br>

कालाक्षरिक
कालाक्षरिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸರಿಯಾದ ಕಾಲದಲ್ಲಿ ಅಕ್ಷರಗಳನ್ನು ಕಲಿತವನು /ವಿದ್ಯೆ ಕಲಿತವನು<br><b>निष्पत्तिः - </b>विद (ज्ञाने) - "ठक्" (४-२-६०)<br><b>व्युत्पत्तिः - </b>काले अक्षरं वेत्ति<br><br>

कालागुरु
कालागुरु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಾಗುರು<br><br>

कालाग्नि
कालाग्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಳಯಕಾಲದ ಅಗ್ನಿ<br><b>व्युत्पत्तिः - </b>कालः सकलहिंसकोऽग्निः<br><br>कालाग्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರುದ್ರ<br><br>कालाग्नि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಂಚಮುಖರುದ್ರಾಕ್ಷ<br><b>प्रयोगाः - </b>"पञ्चवक्त्रः स्वयं रुद्रः कालाग्निर्नाम नामतः । अगम्यागमनाच्चव अभक्ष्यस्य च भक्षणात् । मुच्यतेसर्वपापेभ्यः पञ्चवक्त्रस्य धारणात् ॥"<br><b>उल्लेखाः - </b>स्कान्द०<br><br>

कालाग्निरुद्र
कालाग्निरुद्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಳಯಕಾಲದ ಅಗ್ನಿಯಂತಿರುವ ರುದ್ರ<br><b>व्युत्पत्तिः - </b>कालाग्निरिव रुद्रः<br><br>

कालाजिन
कालाजिन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಾಜಿನ /ಕೃಷ್ಣಮೃಗದ ಚರ್ಮ<br><b>व्युत्पत्तिः - </b>कालस्य कृष्णमृगस्य अजिनम्<br><br>

कालाञ्जन
कालाञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಣ್ಣು ಕಪ್ಪು<br><b>व्युत्पत्तिः - </b>कालमञ्जनम्<br><b>प्रयोगाः - </b>"न चक्षुषोः कान्तिविशेषबुद्ध्या कालाञ्जनं मङ्गलमित्युपात्तम्"<br><b>उल्लेखाः - </b>कुमा० ७-२०<br><br>

कालाण्डज
कालाण्डज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><br>

कालातिक्रम
कालातिक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲ ಮೀರುವುದು<br><br>

कालातिक्रमण
कालातिक्रमण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲ ಮೀರುವುದು<br><b>व्युत्पत्तिः - </b>कालस्यातिक्रमणम्<br><br>

कालातिपत्ति
कालातिपत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲ ಮೀರುವುದು /ಕಾಲ ಕಳೆದು ಹೋಗುವುದು<br><b>व्युत्पत्तिः - </b>कालस्यातिपतिः<br><br>

कालातिपात
कालातिपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲಾತಿಕ್ರಮ /ಕಾಲವು ಮೀರುವುದು /ಕಾಲವು ಕಳೆದು ಹೋಗುವುದು<br><b>व्युत्पत्तिः - </b>कालस्यातिपातः<br><br>

कालातिरेक
कालातिरेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲದ ಆಧಿಕ್ಯ /ಹೆಚ್ಚು ಕಾಲ<br><b>व्युत्पत्तिः - </b>कालस्यातिरेकः<br><b>प्रयोगाः - </b>"कालातिरेके द्विगुणं प्रायश्चित्तं समाचरेत्"<br><br>

कालातीत
कालातीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಲಾತಿಕ್ರಮ /ಕಾಲವು ಮೀರುವುದು /ಕಾಲವು ಕಳೆದು ಹೋಗುವುದು<br><br>कालातीत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಲವು ಮೀರಿರುವ /ಕಾಲವು ಅತಿಕ್ರಮಿಸಿರುವ<br><b>निष्पत्तिः - </b>परनिपातः<br><b>व्युत्पत्तिः - </b>अतीतः कालोऽस्य<br><br>

कालात्मन्
कालात्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ /ಪರಮೇಶ್ವರ<br><b>व्युत्पत्तिः - </b>कालः आत्माऽस्य<br><b>प्रयोगाः - </b>"कालात्मा कालकृद्विभुः"<br><b>उल्लेखाः - </b>सू० सि०<br><br>

कालात्यय
कालात्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>कालातीत ಪದದ ೧ನೆಯ ಅರ್ಥ<br><b>प्रयोगाः - </b>"आधिश्चोपनिधिश्चोभौ न कालात्ययमर्हतः"<br><b>उल्लेखाः - </b>मनु० ८-१४५<br><br>

कालात्ययापदिष्ट
कालात्ययापदिष्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೫ ವಿಧ ಹೇತ್ವಾಭಾಸಗಳಲ್ಲೊಂದಾದ ಹೇತುದೋಷ<br><b>व्युत्पत्तिः - </b>कालात्ययेनापदिष्टः<br><br>

कालाध्यक्ष
कालाध्यक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ<br><br>कालाध्यक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>कालस्याध्यक्षः<br><b>प्रयोगाः - </b>"कालाध्यक्षः प्रजाध्यक्षो विश्वकर्मा तमोनुदः"<br><b>उल्लेखाः - </b>भा० वन०<br><br>

कालानल
कालानल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲಾಗ್ನಿ /ಪ್ರಳಯಕಾಲದ ಬೆಂಕಿ<br><b>व्युत्पत्तिः - </b>कालः सर्वसंहारकारकः अनलः<br><b>प्रयोगाः - </b>"दंष्ट्रा करालानि च ते मुखानि दृष्ट्वैव कालानलसन्निभानि"<br><b>उल्लेखाः - </b>गीता० ११-२५<br><br>कालानल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಜ<br><b>प्रयोगाः - </b>"सभानरस्य पुत्रस्तु विद्वान् कालानलो नृपः"<br><br>

कालानुनादिन्
कालानुनादिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭ್ರಮರ /ದುಂಬಿ<br><br>कालानुनादिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಬ್ಬಚ್ಚಿ<br><br>कालानुनादिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಂಜಲ ಪಕ್ಷಿ<br><b>निष्पत्तिः - </b>अनु + णद (अव्यक्ते शब्दे) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>काले वर्षाकाले अनुनदति<br><br>

कालानुनादिनी
कालानुनादिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿಂಜಲ ಪಕ್ಷಿ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><b>विस्तारः - </b>"कालानुनादी रोलम्बे कलविङ्के कपिञ्जले" -मेदि० ।<br><br>

कालानुसारक
कालानुसारक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೀತಗಂಧ /ಹಳದಿ ಚಂದನ<br><b>निष्पत्तिः - </b>अनु + सृ (गतौ) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कालं कृष्णवर्णं मृगमदमनुसरति<br><br>कालानुसारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಲವನ್ನು ಅನುಸರಿಸುವ<br><br>

कालान्ुसारिन्
कालान्ुसारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಲವನ್ನು ಅನುಸರಿಸುವ<br><b>निष्पत्तिः - </b>अनु + सृ (गतौ) - "णिनिः" (३-२-७८)<br><br>

कालानुसार्य
कालानुसार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಲು ಹೂವು<br><b>व्युत्पत्तिः - </b>कालो मृगमदो गन्धेनानुसार्यो यस्य<br><b>प्रयोगाः - </b>"कालानुसार्यवृद्धाश्मपुष्पशीतशिवानि च"<br><br>कालानुसार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಸುಗಂಧದ್ರವ್ಯ<br><b>विस्तारः - </b>"कालेयकं च कालानुसार्यम्" - अम० ।<br><br>कालानुसार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗುರು ಗಿಡ<br><b>विस्तारः - </b>"कालानुसार्यं शैलेये कालीये शिंशुपाद्रुमे" - मेदि० ।<br><br>

कालानुसार्यक
कालानुसार्यक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>कालानुसार्य ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>वा "कप्" (५-४-१५४)<br><br>

कालान्तर
कालान्तर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇರೆ ಸಮಯ /ಮತ್ತೊಂದು ಕಾಲ<br><b>व्युत्पत्तिः - </b>अन्यः कालः<br><br>

कालापक
कालापक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲಾಪಿಯಿಂದ ಪ್ರೋಕ್ತವಾದ ಶಾಖೆಯ ಧರ್ಮ<br><br>

कालाभ्र
कालाभ्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನಿಂದ ತುಂಬಿದ ಕಪ್ಪು ಮೋಡ /ನೀಲಮೇಘ<br><br>

कालाम्र
कालाम्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದ್ವೀಪ<br><b>प्रयोगाः - </b>"कुरून यात्युत्तरान् वीर कालाम्रद्वीपमेव च"<br><br>

कालायस
कालायस<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಲೋಹ /ಕಬ್ಬಿಣ<br><b>निष्पत्तिः - </b>"टच्" (५-४-९४)<br><b>व्युत्पत्तिः - </b>कालमयः जातौ<br><br>

कालाशुद्धि
कालाशुद्धि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇಳೆಯ ಅಶುದ್ಧಿ /ಮಾಡುವ ಕಾರ್ಯಕ್ಕೆ ಅನರ್ಹತೆಯನ್ನು ಕೊಡುವ ಒಂದು ಧರ್ಮ /ಗುರುಶುಕ್ರರ ವಕ್ರತೆ<br><b>प्रयोगाः - </b>"वक्रातिचारवृद्धास्तबालत्वे गुरुशुक्रयोः । गुरौ मकरसिंहस्थे क्षयमासद्विमासयोः । त्रयोदशदिने पक्षे गुर्वादित्ये तथैव च । लुप्ताब्दे त्रिविधोत्पाते कालाशुद्धिरुदाहृतः ॥"<br><br>

कालिक
कालिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಕಪಕ್ಷಿ<br><b>निष्पत्तिः - </b>"ठक्"<br><b>व्युत्पत्तिः - </b>काले वर्षाकाले चरति<br><br>कालिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಂಕದ ಕಟ್ಟೆಯ ಅಧಿಕಾರಿ /ತೆರಿಗೆಯನ್ನು ವಸೂಲು ಮಾಡುವ ಅಧಿಕಾರಿ<br><b>विस्तारः - </b>"कालिकोऽधिकृतः शुल्के" - वैज० ।<br><br>कालिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೀರ್ಘಕಾಲವುಳ್ಳ ವೈರ /ಹೆಚ್ಚು ಕಾಲವುಳ್ಳ ಶತ್ರುತ್ವ<br><b>निष्पत्तिः - </b>काल - "ठञ्" (५-१-१०८)<br><br>

कालिका
कालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಬಿಕೆ /ಪಾರ್ವತಿಯ ಒಂದು ಅವತಾರ /ಶಿವಶಕ್ತಿ<br><br>कालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಬಣ್ಣ<br><b>प्रयोगाः - </b>"बहुविधेन वियोगिवधैनसा शशमिषादथ कालिकयाङ्कितः"<br><b>उल्लेखाः - </b>नैष० ४-७३<br><br>कालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಮವಾಗಿ ಕೊಡತಕ್ಕ ಪದಾರ್ಥಗಳ ಬೆಲೆ /ಕಂತುಗಳಲ್ಲಿ ಕೊಡುವ ವಸ್ತುಗಳ ಮೌಲ್ಯ<br><br>कालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಸ ಮೋಡ<br><br>कालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಡಗಳ ಸಾಲು<br><br>कालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಕಾಗೆ<br><br>कालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣುನರಿ<br><br>कालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ<br><br>कालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೃಶ್ಚಿಕಪತ್ರೆ ಗಿಡ<br><br>कालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ಲೃಪ್ತಕಾಲದಲ್ಲಿ ಪಾವತಿ ಮಾಡಿದ ಬಡ್ಡಿ<br><br>कालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಟಾಮಾಂಸಿ<br><br>कालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರೋಮಪಂಕ್ತಿ /ಕೂದಲಿನ ಸಾಲು<br><b>विस्तारः - </b>"कालिका चण्डिकाभेदे कार्ष्ण्यवृश्चिकपत्रयोः । क्रमदेयवस्तुमूल्ये धूसरीनवमेघयोः । पटोलशाखारोमालीमांसीकाकीशिवासु च । मेघावलौ च" - मेदि० ।<br><br>कालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಸುವಾಸನೆಯ ಮಣ್ಣು<br><br>कालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಿಡ್ಡ ಹೆಂಗಸು /ಮದುವೆಗೆ ಯೋಗ್ಯವಲ್ಲದ ಕುಳ್ಳ ಹೆಂಗಸು<br><b>विस्तारः - </b>"कुब्जा तु दुर्दर्शा कालिकाऽपि च" - वैज० ।<br><br>कालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಹಲ್ಲುಗಳಸಾಲು<br><b>विस्तारः - </b>"कश्यमश्वस्य मध्यं स्याद्दन्तवेष्टस्तु नालिका । कालिका दन्तरेखा स्यात्" - वैज० ।<br><br>कालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣಜೀರಿಗೆ<br><b>विस्तारः - </b>"अथ सूक्ष्मोसौ कणजीरण ओसरः । अग्निमन्थो हृद्यगन्धस्सुगन्धिः कालिका कणा" - वैज० ।<br><br>कालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೈವರ್ಣ್ಯ ಹೊಂದುವುದು /ಬಣ್ಣ ಬದಲಾಯಿಸುವುದು<br><b>विस्तारः - </b>"कालिका तु विवर्णता" - वैज० ।<br><br>कालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಸಿ /ಶಾಯಿ<br><br>कालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಕಿಯಲ್ಲಿ ಕಾಯಿಸುವಾಗ ಚಿನ್ನದಲ್ಲಿ ಕಾಣುವ ಕೊಳೆ<br><br>कालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವರುಣನ ಪತ್ನಿ<br><br>

कालिङ्ग
कालिङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಳಿಂಗ ದೇಶದ ರಾಜನ ಮಗ<br><b>निष्पत्तिः - </b>"अण्" (४-१-१६८)<br><b>व्युत्पत्तिः - </b>कलिङ्गस्यापत्यम्<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>कालिङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಳಿಂಗ ದೇಶದ ದೊರೆ<br><b>प्रयोगाः - </b>"प्रतिजग्राह कालिङ्गः तमस्त्रैर्गजसाधनः"<br><b>उल्लेखाः - </b>रघु० ४-४०<br><br>कालिङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಳಿಂಗ ದೇಶದ ಜನರು<br><br>कालिङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಳಿಂಗ ದೇಶದ ರಜರಿಗೆ ಸಂಬಂಧಿಸಿದ<br><b>प्रयोगाः - </b>"चक्रलिङ्गधरांश्चक्रे कालिङ्गान् किङ्किरीकृतान्"<br><b>उल्लेखाः - </b>याद० २२-१५३<br><br>

कालिदास
कालिदास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶ್ವವಿಖ್ಯಾತನಾದ ಕಾಳಿದಾಸ ಕವಿ /ರಘುವಂಶ ಕುಮಾರಸಂಭವ ಮುಂತಾದ ಕಾವ್ಯಗಳನ್ನೂ ಶಾಕುಂತಲ ಮೊದಲಾದ ನಾಟಕಗಳನ್ನೂ ಬರೆದ ಮಹಾಕವಿ<br><b>निष्पत्तिः - </b>सञ्ज्ञायां ह्रस्वः ।<br><b>व्युत्पत्तिः - </b>काल्याः दासः<br><b>प्रयोगाः - </b>"उपमा कालिदासस्य भारवेरर्थगौरवम् । दण्डिनः पदलालित्यं माघे सन्ति त्रयो गुणाः ॥"<br><br>

कालिनी
कालिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆರಿದ್ರಾ ನಕ್ಷತ್ರ<br><br>कालिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಕ್ಕುಳ ಬಳ್ಳಿ<br><b>प्रयोगाः - </b>"निष्ठ्या स्वातीविशाखे तु राधे आर्द्रा तु कालिनी"<br><b>विस्तारः - </b>"बालस्य नाभिनालायाममरा कालिनीति च" - वैज० ।<br><br>

कालिन्द
कालिन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಲಂಗಡಿ ಗಿಡ<br><br>कालिन्द<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಲಂಗಡಿ ಹಣ್ಣು<br><br>

कालिन्दक
कालिन्दक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಲಂಗಡಿ ಹಣ್ಣು<br><b>निष्पत्तिः - </b>स्वार्थे "कः"<br><br>

कालिन्दी
कालिन्दी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಮುನಾ ನದಿ<br><b>निष्पत्तिः - </b>"अण्" (४-३-५३) । वा "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>कलिन्दे भवा<br><b>प्रयोगाः - </b>"कालिन्दीजलजनितश्रियः श्रयन्ते वैदग्धीमिह सरितः सुरापगायाः"<br><b>उल्लेखाः - </b>माघ० ४-२६<br><br>

कालिन्दीकर्षण
कालिन्दीकर्षण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲರಾಮ<br><b>निष्पत्तिः - </b>कृष (विलेखने) - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कर्षति । कालिन्द्याः कर्षणः ।<br><br>

कालिन्दीभेदन
कालिन्दीभेदन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲರಾಮ<br><b>व्युत्पत्तिः - </b>कालिन्द्याः भेदनः<br><br>

कालिन्दीसू
कालिन्दीसू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಳಿಂದಿಯ ತಾಯಿ /ಸೂರ್ಯನ ಪತ್ನಿ<br><b>निष्पत्तिः - </b>षूङ् (प्राणिगर्भविमोचने) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>कालिन्दीं यमुनां सूते<br><br>

कालिमन्
कालिमन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣ ವರ್ಣ /ಕಪ್ಪು ಬಣ್ಣ<br><b>निष्पत्तिः - </b>"इमनिच्" (५-१-१२२)<br><b>व्युत्पत्तिः - </b>कालस्य भावः<br><b>प्रयोगाः - </b>"या बिभर्ति कलवल्लकीगुणस्वानमानमतिकालिमाऽलया"<br><b>उल्लेखाः - </b>माघ० ४-५७<br><br>

कालिय
कालिय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸರ್ಪ<br><b>निष्पत्तिः - </b>आ + लीङ् (संश्लेषणे) - "कः" (वा० ३-२-५)<br><b>व्युत्पत्तिः - </b>के जले आलीयते<br><b>प्रयोगाः - </b>"काले कालियकायकालवपुषः पांसून् गजाम्भोमुचः"<br><b>उल्लेखाः - </b>माघ० १७-६९<br><br>

कालियदमन
कालियदमन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಳಿಯ ಸರ್ಪವನ್ನು ದಂಡಿಸಿದ ಶ್ರೀಕೃಷ್ಣ<br><b>निष्पत्तिः - </b>दमु (उपशमे) + णिच् - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कालियं दमयति<br><br>कालियदमन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಳಿಯ ಸರ್ಪವನ್ನು ದಂಡಿಸುವುದು<br><b>निष्पत्तिः - </b>भावे "ल्युट्" (३-३-११५)<br><br>

कालियह्रद
कालियह्रद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಳಿಂದೀ ನದಿಯಲ್ಲಿ ಕಾಳಿಯ ಸರ್ಪವು ವಾಸಿಸುತ್ತಿದ್ದ ಒಂದು ಮಡು<br><b>व्युत्पत्तिः - </b>कालियस्य ह्रदः<br><br>

काली
काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಶಿವನ ಪತ್ನಿ<br><b>निष्पत्तिः - </b>"ङीष्" (४-१-४८)<br><b>व्युत्पत्तिः - </b>कालस्य शिवस्य पत्नी<br><br>काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಬಣ್ಣದ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>काल - "ङीष्" (४-१-४२)<br><br>काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಮವಂತನ ಮಗಳಾದ ಪಾರ್ವತಿ<br><b>प्रयोगाः - </b>"सुतामनुजगामाशु गतां कालीं हराश्रयम्"<br><br>काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ<br><b>प्रयोगाः - </b>"काली करालवदना विनिषक्रान्तासिपाशिनी"<br><br>काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೀಮಸೇನನ ಒಬ್ಬ ಪತ್ನಿ<br><b>प्रयोगाः - </b>"युधिष्ठिरात्तु पौरव्यां देवकोऽथ घटोत्कचः । भीमसेनाद्धिडिम्बायां काल्यां सर्वगतस्ततः ॥"<br><b>उल्लेखाः - </b>भाग० ९-२२-३०<br><br>काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾತ್ರಿ<br><br>काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಸಪ್ತ ಜ್ವಾಲೆಗಳಲ್ಲೊಂದು<br><br>काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಳರಾತ್ರಿ<br><br>काली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಂತ್ರೋಕ್ತವಾದ ೧೦ ಮಹಾವಿದ್ಯೆಗಳಲ್ಲೊಂದು<br><br>

कालीक
कालीक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಕಪಕ್ಷಿ<br><br>

कालीकी
कालीकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಕಪಕ್ಷಿ<br><br>

कालीय
कालीय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಚಂದನ<br><br>

कालीयक
कालीयक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲಾನುಸಾರ್ಯವೆಂಬ ಒಂದು ಸುಗಂಧವಸ್ತು<br><br>

कालेय
कालेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಕ್ಷಸ<br><br>कालेय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಚಂದನ<br><b>प्रयोगाः - </b>"आश्यानकालेयकृताङ्गरागाम्"<br><b>उल्लेखाः - </b>कुमा० ७-९<br><br>

कालेयक
कालेयक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಯಿ /ಕುಕ್ಕುರ<br><br>कालेयक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರದರಿಶಿನ<br><b>निष्पत्तिः - </b>"ढक्" (वा० ४-२-८) । स्वार्थे "कन्"<br><b>व्युत्पत्तिः - </b>कलेरयम्<br><br>कालेयक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಚಂದನ<br><br>

कालेश
कालेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲಕ್ಕೆ ಅಧಿಪತಿಯಾದ ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>कालस्य ईशः<br><br>

काल्पनिक
काल्पनिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಲ್ಪಿತವಾದ /ಸೃಷ್ಟಿಸಲ್ಪಟ್ಟ<br><br>काल्पनिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆರೋಪಿಸಲ್ಪಟ್ಟ /ಇಲ್ಲದುದನ್ನು ಹೊರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"ठञ्" (४-४-१९)<br><b>व्युत्पत्तिः - </b>कल्पनया निवृत्तम्<br><br>

काल्पसूत्र
काल्पसूत्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಲ್ಪಸೂತ್ರಗಳನ್ನು ತಿಳಿದವನು ಮತ್ತು ಅಧ್ಯಯನ ಮಾಡಿದವನು<br><b>निष्पत्तिः - </b>"अण्" (४-२-५९)<br><b>व्युत्पत्तिः - </b>कल्पसूत्रं वेत्ति अधीते वा<br><br>

काल्पसूत्री
काल्पसूत्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಪಸೂತ್ರಗಳನ್ನು ತಿಳಿದವಳು ಮತ್ತು ಅಧ್ಯಯನ ಮಾಡಿದವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

काल्य
काल्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾತಃಕಾಲ<br><b>निष्पत्तिः - </b>कल्प - स्वार्थे "अण्" (५-४-३८)<br><br>काल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಲದಲ್ಲಿ ಉಂಟಾದ /ಆಯಾ ಋತುಗಳಲ್ಲಿ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>"यत्" (४-३-५४)<br><b>व्युत्पत्तिः - </b>काले भवम्<br><br>काल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಯವು ಒದಗಿಬಂದಿರುವ /ಅದಕ್ಕೆ ತಕ್ಕ ಕಾಲವು ಒದಗಿರುವ<br><b>निष्पत्तिः - </b>"यत्" (५-१-१०७)<br><b>व्युत्पत्तिः - </b>काल्ः प्राप्तोऽस्य<br><br>

काल्या
काल्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ಭಗ್ರಹಣಕ್ಕೆ ಯೋಗ್ಯವಾದ ಕಾಲವುಳ್ಳ ಹಸು<br><b>निष्पत्तिः - </b>"यत्" (५-१-१०७)<br><b>व्युत्पत्तिः - </b>कालः गर्भग्रहणयोग्यः कालः प्राप्तोऽस्य<br><b>प्रयोगाः - </b>"उपसर्या काल्या प्रजने"<br><b>उल्लेखाः - </b>पा० सू० ३-१-१०४<br><b>विस्तारः - </b>"काल्योपसर्या प्रजने" - अम० ।<br><br>

काल्याणक
काल्याणक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಯಾಣದ ಭಾವ /ಮಂಗಳವಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"वुञ्" (५-१-१३३)<br><b>व्युत्पत्तिः - </b>कल्याणस्य भावः<br><br>

काल्याणिनेय
काल्याणिनेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಯಾಣಿಯ ಮಗ /ಅದೃಷ್ಟಶಾಲಿ ಹೆಂಗಸಿನ ಮಗ<br><b>निष्पत्तिः - </b>कल्याणी - "ढक्" इनङादेशश्च (४-१-१२६)<br><br>

काव
काव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕವಿದೇವತಾಕವಾದ ಒಂದು ಸಾಮ<br><b>निष्पत्तिः - </b>"अण्" (४-२-२४)<br><b>व्युत्पत्तिः - </b>कविर्देवताऽस्य<br><br>

कावचिक
कावचिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕವಚಧಾರಿಗಳ ಸಮೂಹ /ಕವಚಗಳನ್ನು ತೊಟ್ಟಿರುವವರ ಗುಂಪು<br><b>निष्पत्तिः - </b>कवच - "ठञ्" (४-२-४१)<br><br>

कावाद
कावाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲಹ /ಜಗಳ<br><b>निष्पत्तिः - </b>कादेशः (६-३-१०५)<br><b>व्युत्पत्तिः - </b>कुत्सितः ईषद्वा वादः<br><b>प्रयोगाः - </b>"देवाकानिनि कावादे वाहिकास्वस्वका हि वा"<br><b>उल्लेखाः - </b>किरा० १५-२५<br><br>कावाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೈವಾಲ /ಪಾಚಿ<br><b>निष्पत्तिः - </b>आ+ वृञ् (वरणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कं जलमावृणोति<br><br>

कावृक
कावृक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಳಿ /ಹುಂಜ<br><br>कावृक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಕ್ರವಾಕ ಪಕ್ಷಿ<br><br>कावृक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಳದಿ ತಲೆಯ ಒಂದು ಹಕ್ಕಿ<br><b>व्युत्पत्तिः - </b>ईषत् वृक इव<br><b>विस्तारः - </b>"कावुकः कृकवाकौ स्यात् पीतमस्तककोकयोः" - मेदि० ।<br><br>

कावेरी
कावेरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಡಗು ಜಿಲ್ಲೆಯ ತಲಕಾವೇರಿಯಲ್ಲಿ ಹುಟ್ಟಿ ಮೈಸೂರು ಮತ್ತು ಮದರಾಸು ಪ್ರಾಂತಗಳಲ್ಲಿ ಹರಿಯುತ್ತಿರುವ ಒಂದು ಮಹಾನದಿ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०) । "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>कं जलमेव बेरं शरीरम्, तस्य इदम्<br><b>प्रयोगाः - </b>"कावेरीं सरितां पत्युः शङ्कनीयामिवाकरोत" । "ततो गच्छेत कावेरीं वृतामप्सरसां गणैः । तत्र स्नात्वा नरो राजन् गोसहस्रफलं लभेत् ॥"<br><b>उल्लेखाः - </b>रघु० ४-४५, भा० वन० ८५<br><br>कावेरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇಶ್ಯೆ /ಸೂಳೆ<br><br>कावेरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹರಿದ್ರೆ /ಅರಿಶಿನ<br><b>विस्तारः - </b>"कावेरी तु हरिद्रायां वेश्यायां सरिदन्तरे" - हेम० ।<br><br>

काव्य
काव्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೃಗುಋಷಿಯ ಮಗನಾದ ಕವಿಯ ಮಗ ಶುಕ್ರಾಚಾರ್ಯರು<br><b>निष्पत्तिः - </b>"ण्यः" (४-१-१५१)<br><b>व्युत्पत्तिः - </b>कवेः भृगुपुत्रस्यापत्यम्<br><b>प्रयोगाः - </b>"दैतेयनीतेः पथि सार्थवाहः काव्यः स काव्येन सभामभाणीत्"<br><b>उल्लेखाः - </b>नैष० १०-५९<br><br>काव्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾವ್ಯ /ಗ್ರಂಥ /ಗದ್ಯ ಅಥವಾ ಪದ್ಯರೂಪವಾದ ಕವಿಯ ಕವಿತೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>कवेः कर्म<br><b>प्रयोगाः - </b>"तैः शरीरं च काव्यानामलङ्काराश्च दर्शिताः । शरीरं तावदिष्टार्थव्यच्छिन्ना पदावली ॥"<br><b>उल्लेखाः - </b>काव्या० १-१०<br><br>

काव्यचन्द्रिका
काव्यचन्द्रिका<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾವ್ಯಲಕ್ಷಣ ಮೊದಲಾದುವನ್ನು ಪ್ರತಿಪಾದಿಸುವ ಒಂದು ಅಲಂಕಾರ ಗ್ರಂಥ<br><br>

काव्यचौर
काव्यचौर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇತರರು ಬರೆದ ಕಾವ್ಯಭಾಗಗಳನ್ನು ಕದ್ದು ಕಾವ್ಯ ಬರೆಯುವವನು /ಬೇರೆಯವರ ಕಾವ್ಯಗಳಿಂದ ವಿಷಯಗಳನ್ನು ತೆಗೆದು ತನ್ನ ಕಾವ್ಯಕ್ಕೆ ಸೇರಿಸಿ ಬರೆಯುವವನು<br><b>व्युत्पत्तिः - </b>काव्यस्य चौर इव<br><br>

काव्यप्रकाश
काव्यप्रकाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಮ್ಮಟ ಕವಿ ವಿರಚಿತವಾದ ಕಾವ್ಯಾದಿ ಲಕ್ಷಣಗಳನ್ನು ಪ್ರತಿಪಾದಿಸುವ ಒಂದು ಅಲಂಕಾರ ಗ್ರಂಥ<br><b>व्युत्पत्तिः - </b>काव्यस्य स्वरूपादिप्रकाशो यत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾವ್ಯಸ್ವರೂಪಾದಿಗಳನ್ನು ತಿಳಿಸುವ ಒಂದು ಅಲಂಕಾರಗ್ರಂಥ /ಕಾವ್ಯಪ್ರಕಾಶದ ಒಂದು ವ್ಯಾಖ್ಯಾನಗ್ರಂಥ<br><br><br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಶಿಯಲ್ಲಿ ಹುಟ್ಟಿದ /ಕಾಶಿಯಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"ढक्"<br><b>व्युत्पत्तिः - </b>काश्यां भवः<br><br>

काव्यरसिक
काव्यरसिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾವ್ಯಗಳಲ್ಲಿ ನಿರೂಪಿಸಲ್ಪಡುವ ರಸಗಳನ್ನು ಚೆನ್ನಾಗಿ ಆಸ್ವಾದಿಸಲು ಬಲ್ಲವನು<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५)<br><b>व्युत्पत्तिः - </b>काव्यरसः आस्वाद्यत्वेनास्त्यस्य<br><br>

काव्यलक्षण
काव्यलक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾವ್ಯಗಳ ಸ್ವರೂಪವನ್ನು ತಿಳಿಸುವುದು /ಕಾವ್ಯಗಳ ರಚನಾಕ್ರಮ ಮೊದಲಾದುವನ್ನು ವಿವರಿಸುವುದು<br><br>

काव्यलिङ्ग
काव्यलिङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥಾಲಂಕಾರದ ಒಂದು ಭೇದ<br><b>प्रयोगाः - </b>"समर्थनीयस्यार्थस्य काव्यलिङ्गं समर्थनम्"<br><b>उल्लेखाः - </b>चन्द्रा०<br><br>

काव्यशास्त्र
काव्यशास्त्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರದಂತಿರುವ ಕಾವ್ಯ<br><b>व्युत्पत्तिः - </b>काव्यं शास्त्रमिव<br><br>

काव्या
काव्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿ<br><b>निष्पत्तिः - </b>कवृ (वर्णने) - "ण्यत्" (३-१-१२४)<br><br>काव्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂತನೆಯೆಂಬ ಒಬ್ಬ ರಾಕ್ಷಸಿ<br><b>विस्तारः - </b>"काव्यं ग्रन्थे पुमान् शुक्रे काव्या स्यात् पूतनाधियोः" - मेदि० ।<br><br>

काव्यादर्श
काव्यादर्श<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಂಡಿಕವಿವಿರಚಿತವಾದ ಒಂದು ಲಕ್ಷಣಗ್ರಂಥ<br><br>

काव्यार्थापत्ति
काव्यार्थापत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಥಾಲಂಕಾರದ ಒಂದು ಭೇದ<br><b>व्युत्पत्तिः - </b>अर्थस्य कस्यचित् कार्यस्य आपत्तिः सिद्धिः<br><br>

काश
काश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಂಬುಹುಲ್ಲು /ಜೊಂಡುಹುಲ್ಲು<br><b>निष्पत्तिः - </b>काशृ (दीप्तौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>काशते<br><br>काश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಸರೋಗ /ಕೆಮ್ಮಲು<br><b>निष्पत्तिः - </b>अशू (व्याप्तौ) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>केन कफात्मकेन जलेन अश्यते<br><br>काश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೀನು<br><br>काश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಷಿಕ /ಇಲಿ<br><b>निष्पत्तिः - </b>अश (भोजने) - "अच्" (३-१-१३४) । कोः कादेशः (६-३-१०५)<br><b>व्युत्पत्तिः - </b>ईषदश्नाति<br><br>काश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಂತಿ /ಪ್ರಕಾಶ<br><br>काश<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಂಬುಹುಲ್ಲಿನ ಹೂವು<br><b>प्रयोगाः - </b>"आकर्णमुल्लसितमम्बुविकासिकाशनीकाशमाप समतां सितचामरस्य" । "पुण्डरीकातपत्रस्तं विकसत्काशचामरः" ।<br><b>उल्लेखाः - </b>माघ० ५-३५, रघु० ४-१७<br><br>

काशक
काशक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಂಬುಹುಲ್ಲು /ಜೊಂಡುಹುಲ್ಲು<br><b>निष्पत्तिः - </b>काशृ (दीप्तौ) - "ण्वुल्"(३-१-१३३)<br><br>काशक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಳೆಯುವ /ಪ್ರಕಾಶಿಸುವ<br><br>

काशकृत्स्न
काशकृत्स्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೮ ಮಂದಿ ಆದಿಶಾಬ್ದಿಕರಲ್ಲೊಬ್ಬ ಋಷಿ<br><b>प्रयोगाः - </b>"इन्द्रश्चन्द्रः काशकृत्स्नापिशलिः शाकटायनः । पाणिन्यमरजैनेन्द्राः जयन्त्यष्टाब्दिशाब्दिकाः ॥"<br><br>

काशकृत्स्नक
काशकृत्स्नक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಶಕೃತ್ಸ್ನ ಋಷಿಯಿಂದ ನಿರ್ಮಿತವಾದ<br><b>निष्पत्तिः - </b>"वुञ्" (४-२-८०)<br><b>व्युत्पत्तिः - </b>काशकृत्स्नेन निवृत्तम्<br><br>

काशमय
काशमय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಂಬುಹುಲ್ಲಿನಿಂದ ತುಂಬಿದ /ಜೊಂದುಹುಲ್ಲಿನಿಂದ ನೆರೆದಿರುವ<br><br>काशमय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೊಂಡು ಹುಲ್ಲಿನಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ /ಜಂಬುಹುಲ್ಲಿನಿಂದ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"मयट्" (५-४-२१)<br><b>व्युत्पत्तिः - </b>काशेन प्रचुरः काशविकारो वा<br><br>

काशि
काशि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>काशृ (दीप्तौ) - कर्त० "इन्" (उ० ४-११७)<br><b>व्युत्पत्तिः - </b>काशते<br><br>काशि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಳಕು /ಪ್ರಕಾಶ<br><b>निष्पत्तिः - </b>भावे "इन्"<br><br>काशि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಷ್ಟಿ /ಹಿಡಿ<br><br>काशि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶೀಜನಪದ /ಕಾಶೀ ನಗರದಿಂದ ಕೂಡಿದ ಒಂದು ದೇಶ<br><b>प्रयोगाः - </b>"काशिष्वपि नृपो राजन् दिवोदासपितामहः । हर्यश्च इति विख्यातो बभूव जयतां वरः ॥"<br><b>उल्लेखाः - </b>भा० अनु० ८-११<br><br>काशि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶಿ /ವಾರಾಣಸಿ<br><br>काशि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶದಿಂದ ಕೂಡಿದ<br><br>

काशिक
काशिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಶಿ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>काशेरिदम्<br><br>काशिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಶಿಯಲ್ಲಿ ಹುಟ್ಟಿದ /ಕಾಶಿಯಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"ठञ्" ठिञ्" वा (४-२-११६)<br><b>व्युत्पत्तिः - </b>काश्यां भवः<br><br>काशिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಶಿಯಿಂದ ಬಂದಿರುವ<br><b>निष्पत्तिः - </b>"ठञ्" ठिञ्" वा (४-२-११६)<br><b>व्युत्पत्तिः - </b>काश्या आगतः<br><br>

काशिकी
काशिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>काशिक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां ठञि "ङीप्" (४-१-१५)<br><br>

काशिका
काशिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>काशिक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>ठिञि "टाप्" (४-१-४)<br><br>काशिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶಿಕಾವೃತ್ತಿ /ಪಾಣಿನಿ ಸೂತ್ರಗಳಿಗೆ ಒಂದು ವ್ಯಾಖ್ಯಾನಗ್ರಂಥ<br><br>काशिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶೀಪಟ್ಟಣ<br><br>

काशिन्
काशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಿಸುವ /ಹೊಳೆಯುವ<br><b>निष्पत्तिः - </b>काशृ (दीप्तौ) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>काशते<br><br>काशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಸರೋಗವುಳ್ಳವನು /ಕೆಮ್ಮಲುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>काशोऽस्यास्ति<br><br>

काशिनी
काशिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>काशिन् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

काशिप
काशिप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾದೇವ /ಪರಮೇಶ್ವರ<br><br>काशिप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶೀದೇಶದ ದೊರೆ /ದಿವೋದಾಸ ಮೊದಲಾದವರು<br><b>निष्पत्तिः - </b>पा (रक्षणे) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>काशिं वाराणसीं काशीन् देशान् वा पाति<br><br>

काशिनाथ
काशिनाथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶೀದೇಶದ ದೊರೆ /ದಿವೋದಾಸ ಮೊದಲಾದವರು<br><br>

काशिनृपति
काशिनृपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶೀದೇಶದ ದೊರೆ /ದಿವೋದಾಸ ಮೊದಲಾದವರು<br><b>प्रयोगाः - </b>"एतस्य काशिनृपतेः त्वमवेक्ष्य लक्ष्मीमक्ष्णोः सुखं जनय खञ्जनमञ्जुनेत्रे"<br><b>उल्लेखाः - </b>नैष० ११-११३<br><br>

काशिराज
काशिराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶೀದೇಶದ ದೊರೆ /ದಿವೋದಾಸ ಮೊದಲಾದವರು<br><b>निष्पत्तिः - </b>"टच्" (५-४-९१)<br><b>व्युत्पत्तिः - </b>काशीनां जनपदानां राजा<br><b>प्रयोगाः - </b>"हर्यश्वस्य च दायादः काशिराजोऽभ्यषिच्यत"<br><b>उल्लेखाः - </b>भा० अनु० ८-१४<br><br>

काशिल
काशिल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೊಂಡುಹುಲ್ಲಿನಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ<br><br>काशिल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜೊಂಡುಹುಲ್ಲಿನಿಂದ ಕೂಡಿದ ಕಾಶಿಲವೆಂಬ ಒಂದು ದೇಶ<br><b>निष्पत्तिः - </b>काश - "इलः" (४-२-८०)<br><br>

काशिष्णु
काशिष्णु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಳೆಯುವ ಸ್ವಭಾವದ /ಪ್ರಕಾಶಮಾನವಾದ<br><b>निष्पत्तिः - </b>काशृ (दीप्तौ) - बाहु० "इष्णुच्"<br><b>प्रयोगाः - </b>"काशिष्णुना कनकवर्णविभूषणेन लसत्कपोलवदनो विलसत्किरीटः"<br><b>उल्लेखाः - </b>भाग० ४-३०-६<br><br>

काशी
काशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶಿ /ವಾರಾಣಸಿ<br><b>निष्पत्तिः - </b>काशृ (दीप्तौ) - "इन्" (उ० ४-११७) । "ङीष्" (ग० ४-१-४५)<br><b>व्युत्पत्तिः - </b>काशते<br><b>प्रयोगाः - </b>"काशी भवेत् तरणधर्मतरिः स्मरारेः"<br><b>उल्लेखाः - </b>नैष० ११-११४<br><br>

काशीखण्ड
काशीखण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಕಾಂದಪುರಾಣದಲ್ಲಿ ಕಾಶೀಕ್ಷೇತ್ರದ ಮಹಿಮೆಯನ್ನು ವರ್ಣಿಸುವ ಒಂದು ಭಾಗ<br><br>

काशीनाथ
काशीनाथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮೇಶ್ವರ /ಶಿವ<br><b>व्युत्पत्तिः - </b>काश्याः नाथः<br><b>प्रयोगाः - </b>"कालं निकटतो ज्ञात्वा काशीनाथं समाचरेत् । काशीनाथं समाश्रित्य कुतः कालभयं नृणाम् ॥"<br><b>उल्लेखाः - </b>काशीखं०<br><br>

काशीयात्रा
काशीयात्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶೀನಗರದ ಯಾತ್ರೆ /ಕಾಶೀಕ್ಷೇತ್ರದಲ್ಲಿರುವ ಪುಣ್ಯತೀರ್ಥಗಳನ್ನು ಕುರಿತ ಪ್ರಯಾಣ<br><br>

काशीरहस्य
काशीरहस्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶೀಕ್ಷೇತ್ರದ ಮಹಿಮೆಯ ಗುಟ್ಟು<br><b>व्युत्पत्तिः - </b>काश्याः रहस्यम्<br><br>

काशीश|काशीश्वर
काशीश - ईश्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಶ್ವೇಶ್ವರ<br><b>व्युत्पत्तिः - </b>काश्याः ईशः ईश्वरो वा<br><br>काशीश - ईश्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶಿಯ ಒಡೆಯ /ದಿವೋದಾಸ<br><br>

काशेय
काशेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶಿರಾಜನ ಮಗ<br><b>निष्पत्तिः - </b>"ढक्"(४-१-१२२)<br><b>व्युत्पत्तिः - </b>काशेरपत्यम्<br><br>

काशेयी
काशेयी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>काशेय ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><b>प्रयोगाः - </b>"भरतः खलु काशेयीमुपयेमे सार्वसेनीं सुनन्दां नाम तस्यां जज्ञे भुमन्युर्नाम"<br><b>उल्लेखाः - </b>भा० आदि० ९५-३२<br><br>

काश्मरी
काश्मरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶೀವನೆಯ ಮರ<br><b>निष्पत्तिः - </b>काशृ (दीप्तौ) - "वनिप्" (३-२-७५) । "ङीप्" रश्च (४-१-७) पृषो० ।<br><b>व्युत्पत्तिः - </b>काशते<br><b>प्रयोगाः - </b>"बिल्वान् कपित्थान् जम्बूंश्च काश्मरीबदरीस्तथा"<br><b>उल्लेखाः - </b>भा० वन० १५८-४६<br><br>

काश्मर्य
काश्मर्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೀವನೆಯ ಮರ<br><b>निष्पत्तिः - </b>काश्मरी - स्वार्थे "ष्यञ्" (वा० ५-१-१२४) । "यप्" (५-२-१२०) वा ।<br><b>व्युत्पत्तिः - </b>काश्मीरी शब्देऽस्यास्ति<br><br>

काश्मीर
काश्मीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶ್ಮೀರ ದೇಶ<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>काश्मीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶ್ಮೀರ ದೇಶದ ನಿವಾಸಿಗಳು<br><br>काश्मीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶ್ಮೀರ ದೇಶದ ದೊರೆ<br><br>काश्मीर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಷ್ಕರ ಮೂಲ /ತಾವರೆಯ ಗೆಡ್ಡೆ<br><b>निष्पत्तिः - </b>"अण्" (४-२-१३३)<br><b>व्युत्पत्तिः - </b>काश्मीरेषु भवम्<br><br>काश्मीर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಟಂಕ<br><br>काश्मीर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಕುಮ ಕೇಸರಿ<br><b>विस्तारः - </b>"काश्मीरं कुङ्कुमेऽपि स्यात् टङ्कपुष्करमूलयोः" - मेदि० ।<br><br>

काश्मीरक
काश्मीरक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಶ್ಮೀರ ದೇಶದಲ್ಲಿ ಹುಟ್ಟಿದ<br><br>काश्मीरक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಶ್ಮೀರ ದೇಶದಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"वुञ्" (४-२-१३४)<br><b>व्युत्पत्तिः - </b>काश्मीरे जातो भवा वा<br><b>प्रयोगाः - </b>"ततः काश्मीरकान् वीरान् क्षत्रियान् क्षत्रियर्षभः"<br><b>उल्लेखाः - </b>भा० सभा० २७-१७<br><br>

काश्मीरज
काश्मीरज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂಗಲುಕೋಷ್ಠ<br><br>काश्मीरज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಕುಮ ಕೇಸರಿ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९७)<br><b>व्युत्पत्तिः - </b>काश्मीरे जायते<br><b>प्रयोगाः - </b>"काश्मीरजै रश्मिभिरौपसन्ध्यैर्मृष्टं धृतध्वान्तकुरङ्गनाभिः"<br><b>उल्लेखाः - </b>नैष० २२-५४<br><br>काश्मीरज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಬಜೆ<br><br>काश्मीरज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಷ್ಕರ ಮೂಲ /ತಾವರೆಯ ಗೆಡ್ಡೆ<br><b>विस्तारः - </b>"काश्मीरजाख्याऽतिविषा कुष्ठकुङ्कुमपौष्करे" - विश्व० ।<br><br>

काश्मीरजन्मन्
काश्मीरजन्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಕುಮ ಕೇಸರಿ<br><b>व्युत्पत्तिः - </b>काश्मीरे जन्म यस्य<br><b>विस्तारः - </b>"काश्मीरजन्माग्निशिखम्" - अम० ।<br><br>

काश्मीर्य
काश्मीर्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಕುಮ ಕೇಸರಿ<br><b>निष्पत्तिः - </b>"ण्यः" (४-२-८०)<br><b>व्युत्पत्तिः - </b>काश्मीरे जातम्<br><br>काश्मीर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಶ್ಮೀರ ದೇಶದಲ್ಲಿ ಹುಟ್ಟಿದ<br><br>काश्मीर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಶ್ಮೀರ ದೇಶದಲ್ಲಿರುವ<br><br>

काश्य
काश्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶಿರಾಜ<br><br>काश्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ /ಹೆಂಡ<br><b>निष्पत्तिः - </b>कश्य - स्वार्थे "अण्" (५-४-३८)<br><br>

काश्यप
काश्यप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಶ್ಯಮಗೋತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದ ಒಬ್ಬ ಋಷಿ<br><b>निष्पत्तिः - </b>"अञ्" (४-१-१०४)<br><b>व्युत्पत्तिः - </b>कश्यपस्य गोत्रापत्यं पुमान्<br><br>काश्यप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶ್ಯರಾಜನ ಮಗ<br><b>व्युत्पत्तिः - </b>काश्यं पाति नरकात्<br><br>काश्यप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಶಷ್ಯಪಗೋತ್ರದಲ್ಲಿ ಹುಟ್ಟಿ ವಿಷಹರ ವಿದ್ಯೆಯನ್ನು ಕಲಿತ ಒಬ್ಬ ಬ್ರಾಹ್ಮಣ<br><br>काश्यप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಣಾದ ಮುನಿ<br><br>काश्यप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಜಿಂಕೆ<br><br>काश्यप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ಸ್ಯ /ಮೀನು<br><br>

काश्यपी
काश्यपी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಶ್ಯಪಗೋತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದ ಹೆಂಗಸು<br><br>काश्यपी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೃಥ್ವಿ /ಭೂಮಿ<br><b>विस्तारः - </b>"क्षोणिर्ज्या काश्यपी क्षितिः" - अम० ।<br><br>काश्यपी<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಶ್ಯಪ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)। "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>कश्यपस्येदम्<br><br>काश्यपी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>काश्यपी ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><br>

काश्यपनन्दन
काश्यपनन्दन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರುಡ<br><br>काश्यपनन्दन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರುಣ<br><br>काश्यपनन्दन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆಗಳು /ಅಸುರರು ಮುಂತಾದ ಕಶ್ಯಪನ ಸಂತಾನಗಳು<br><br>

काश्यपायन
काश्यपायन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಶ್ಯಪ ಗೋತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><b>निष्पत्तिः - </b>"फक्" (४-१-९९)<br><b>व्युत्पत्तिः - </b>काश्यपस्य गोत्रापत्यं पुमान्<br><br>

काश्यपि
काश्यपि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರುಡ<br><b>प्रयोगाः - </b>"देवेन तेनैष च काश्यपिश्च साम्यं समीक्ष्योभयपक्षभाजौ"<br><b>उल्लेखाः - </b>नैष० २२-८९<br><br>काश्यपि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರುಣ<br><b>निष्पत्तिः - </b>"इञ्" (४-१-९६)<br><b>व्युत्पत्तिः - </b>"कश्यपस्यापत्यम्<br><br>

काश्यपिन्
काश्यपिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶ್ಯಪಋಷಿಯಿಂದ ಪ್ರೋಕ್ತವಾದುದನ್ನು ಅಧ್ಯಯನ ಮಾಡುವವರು<br><b>निष्पत्तिः - </b>"णिनिः" (४-३-१०३)<br><b>व्युत्पत्तिः - </b>काश्यपेन प्रोक्तमधीयते<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>

काश्यपेय
काश्यपेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಶ್ಯಪಪತ್ನಿಯರಲ್ಲಿ ಹುಟ್ಟಿದ ದೇವತೆಗಳು /ಅಸುರರು, ಅರುಣ ಗರುಡ ಮೊದಲಾದವರು<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०) । "ङीप्" (४-१-१५) । "ढक्" (४-१-१२०)<br><b>व्युत्पत्तिः - </b>कश्यपस्येयम् काश्यपी कश्यपभार्या । तस्या अपत्यानि ।<br><b>प्रयोगाः - </b>"इत्येते द्वादशादित्याः काश्यपेयाः प्रकीर्तिताः" । "नागक्षयकरश्चव काश्यपेयो महाबलः" ।<br><b>उल्लेखाः - </b>भा० अनु० २५५-१६, भा० आदि० २३-१३<br><br>

काश्यायन
काश्यायन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶಿರಾಜನ ಗೋತ್ರದಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><b>निष्पत्तिः - </b>"फक्" (४-१-९९)<br><b>व्युत्पत्तिः - </b>काश्यस्य काशिराजस्य गोत्रापत्यं पुमान्<br><br>

काष
काष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಜ್ಜುವ ಕಲ್ಲು /ಸಾಣೆ ಕಲ್ಲು<br><b>निष्पत्तिः - </b>कष (हिंसायाम्) - कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>कष्यतेऽनेन<br><br>काष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಜ್ಜುವ ಸಾಧನ /ನವೆಯನ್ನು ಹೋಗಲಾಡಿಸಿಕೊಳ್ಳಲು ಮೈಯನ್ನು ಉಜ್ಜಿಕೊಳ್ಳುವ ಜಾಗ<br><b>प्रयोगाः - </b>"एतस्मिन्मदयति कोकिलानकाले लीनालिः सुरकरिणां कपोलकाषः"<br><b>उल्लेखाः - </b>किरा० ५-२६<br><br>

काषाय
काषाय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಷಾಯ ಬಣ್ಣದಲ್ಲಿ ಅದ್ದಲ್ಪಟ್ಟ /ಕಾವಿಬಣ್ಣದಲ್ಲಿ ಅದ್ದಲ್ಪಟ್ಟ ಬಟ್ಟೆ ಮೊದಲಾದುದು /ಕಾವಿಬಟ್ಟೆ<br><b>निष्पत्तिः - </b>"अण्" (४-२-१)<br><b>व्युत्पत्तिः - </b>कषायेण रक्तं<br><b>प्रयोगाः - </b>"यसि वासांसि वसीरन् रक्तानि वसीरन्, काषायं ब्राह्मणो माञ्जिष्ठं क्षत्रियो हारिद्रं वैश्यः" । "काषायपरिवीतेन स्वपदार्पितचक्षुषा" ।<br><b>उल्लेखाः - </b>आश्व० गृ०, रघु० १५-७७<br><br>

काषायिन्
काषायिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾವಿಬಟ್ಟೆಯನ್ನು ಉಟ್ಟಿರುವ ಸಂನ್ಯಾಸಿ<br><br>

काष्ठ
काष्ठ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂಧನ /ಸೌದೆ /ಕಟ್ಟಿಗೆ<br><b>निष्पत्तिः - </b>काशृ (दीप्तौ) - "क्थन्" (उ० २-२)<br><br>काष्ठ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರ /ಚೌಬೀನೆ<br><br>

काष्ठक
काष्ठक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗುರು ಚಂದನ<br><br>काष्ठक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರದ ತುಂಡು /ಕಟ್ಟಿಗೆಯ ಚೂರು<br><br>

काष्ठकीट
काष्ठकीट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರವನ್ನು ಕೊರೆಯುವ ಒಂದು ಹುಳು /ಘುಣವೆಂಬ ಒಂದು ಕ್ರಿಮಿ<br><br>

काष्ठकुट्ट
काष्ठकुट्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರಕುಟಿಗ ಹಕ್ಕಿ<br><b>निष्पत्तिः - </b>कुट्ट (छेदनभर्त्सनयोः) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>काष्ठं कुट्ट्यति<br><b>विस्तारः - </b>"काष्ठकुट्टः शतच्छदे । दीर्घपादस्तु कङ्कः स्यात्" - त्रिकाण्ड० ।<br><br>

काष्ठकुट्टक
काष्ठकुट्टक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರಕುಟಿಗ ಹಕ್ಕಿ<br><b>निष्पत्तिः - </b>"ण्वुल्" (३-१-१३३)<br><br>

काष्ठकुद्दाल
काष्ठकुद्दाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಡಗಿನೊಳಗೆ ಸೇರಿರುವ ನೀರನ್ನೂ ಕಸವನ್ನೂ ಹೊರಕ್ಕೆ ತೆಗೆದುಹಾಕುವ ಒಂದು ಮರದ ಮೊರಗುದ್ದಲಿ /ಎಲೆಗುದ್ದಲಿ<br><b>व्युत्पत्तिः - </b>काष्ठमयः कुद्दालः<br><b>विस्तारः - </b>"अभ्रिः स्त्री काष्ठकुद्दालः"- अम० ।<br><br>

काष्ठतट्
काष्ठतट्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಡಗಿ /ಮರಗೆಲಸದವನು /ಮರವನ್ನು ಕೆತ್ತುವವನು<br><b>निष्पत्तिः - </b>तक्ष (त्वचने) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>काष्ठं तक्षति<br><br>

काष्ठतक्षक
काष्ठतक्षक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಡಗಿ /ಮರಗೆಲಸದವನು /ಮರವನ್ನು ಕೆತ್ತುವವನು<br><b>निष्पत्तिः - </b>"ण्वुल्" (३-१-१३३)<br><br>

काष्ठतक्षण
काष्ठतक्षण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರವನ್ನು ಕೆತ್ತುವಿಕೆ<br><b>व्युत्पत्तिः - </b>काष्ठस्य तक्षणम्<br><br>

काष्ठतन्तु
काष्ठतन्तु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರದ ಒಳಗೆ ದಾರದಂತೆ ಉದ್ದವಾಗಿರುವ ಒಂದು ಜಾತಿಯ ಹುಳು<br><b>व्युत्पत्तिः - </b>काष्ठे तन्तुरिव<br><br>काष्ठतन्तु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೇಷ್ಮೆಹುಳು<br><b>विस्तारः - </b>"कोशकारः काष्ठतन्तुः" - हारा० ।<br><br>

काष्ठदारु
काष्ठदारु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವದಾರು ಮರ<br><b>व्युत्पत्तिः - </b>काष्ठप्रधानो दारुः<br><br>

काष्ठद्रु
काष्ठद्रु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಲಾಶವೃಕ್ಷ /ಮುತ್ತುಗದ ಮರ<br><b>व्युत्पत्तिः - </b>काष्ठप्रधानो द्रुः<br><br>

काष्ठपट्ट
काष्ठपट्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರದ ಹಲಗೆ /ದಾರುಫಲಕ<br><br>

काष्ठभारिक
काष्ठभारिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೌದೆ ಹೊರುವವನು<br><br>

काष्ठभेद
काष्ठभेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೌದೆ ಒಡೆಯುವುದು /ಸೌದೆ ಸೀಳುವುದು<br><b>व्युत्पत्तिः - </b>काष्ठस्य भेदः<br><br>

काष्ठभेदन
काष्ठभेदन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌದೆ ಒಡೆಯುವುದು /ಸೌದೆ ಸೀಳುವುದು<br><b>व्युत्पत्तिः - </b>काष्ठस्य भेदनम्<br><br>

काष्ठभेदक|काष्ठभेदन
काष्ठभेदक - भेदन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೌದೆ ಒಡೆಯುವವನು<br><b>निष्पत्तिः - </b>भिदिर् (विदारणे) - "ण्वुल्" (३-१-१३३) । "ल्युः" (३-१-१३४) वा ।<br><b>व्युत्पत्तिः - </b>काष्ठं भिनत्ति<br><br>

काष्ठमय
काष्ठमय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರದಿಂದ ಮಾಡಲ್ಪಟ್ಟ /ಮರದಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"मयट्" (५-४-२१)<br><b>व्युत्पत्तिः - </b>काष्ठस्य विकारः<br><b>प्रयोगाः - </b>"यथा काष्ठमयो हस्ती यथा चर्ममयो मृगः । यश्च विप्रोऽनधीयानः त्रयस्ते नाम बिभ्रति ॥"<br><b>उल्लेखाः - </b>मनु०२-१५७<br><br>काष्ठमय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರದಂತೆ ಕಠಿನವಾದ ಹೃದಯವುಳ್ಳ<br><br>

काष्ठमौन
काष्ठमौन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂಗಿತದಿಂದಲೂ ತನ್ನ ಅಭಿಪ್ರಾಯವನ್ನು ತಿಳಿಯಪಡಿಸದಿರುವಿಕೆ<br><b>व्युत्पत्तिः - </b>काष्ठमिव मौनम्<br><br>

काष्ठलेखक
काष्ठलेखक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರವನ್ನು ಕೊರೆಯುವ ಒಂದು ಹುಳು /ಘುಣವೆಂಬ ಒಂದು ಕ್ರಿಮಿ<br><b>निष्पत्तिः - </b>लिख (अक्षरविन्यासे) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>काष्ठं लिखति<br><br>

काष्ठलोहिन्
काष्ठलोहिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣದ ಹಿಡಿ ಹಾಕಿರುವ ಮರದ ಗದೆ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>काष्ठं च लोहं च स्तोऽस्य<br><b>विस्तारः - </b>"काष्ठलोही तु वातर्धिः" - त्रिकाण्ड० ।<br><br>

काष्ठवत्
काष्ठवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರದಿಂದ ಕೂಡಿದ /ಸೌದೆಯನ್ನು ಹೊಂದಿರುವ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>काष्ठमस्यास्ति<br><br>काष्ठवत्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮರದಂತೆ /ಮರದ ಹಾಗೆ /ಮರಕ್ಕೆಸಮಾನವಾಗಿ<br><b>निष्पत्तिः - </b>"वतिः" (५-१-११५)<br><b>व्युत्पत्तिः - </b>काष्ठेन तुल्यम्<br><br>

काष्ठवल्लिका
काष्ठवल्लिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಟುಕರೋಹಿಣಿ<br><b>व्युत्पत्तिः - </b>काष्ठमिव शुष्का वल्लिका<br><br>

काष्ठा
काष्ठा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಿಶೆ /ದಿಕ್ಕು<br><b>निष्पत्तिः - </b>काशृ (दीप्तौ) - "क्थन्" (उ० २-२)<br><b>व्युत्पत्तिः - </b>काशते<br><b>प्रयोगाः - </b>"आसाद्य वाचं स भृशं दिदीपे काष्ठामुदीचीमिव तिग्मरश्मिः"<br><b>उल्लेखाः - </b>किरा० ३-५५<br><br>काष्ठा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹದಿನೆಂಟು ನಿಮೇಷಗಳ ಕಾಲ /೧೮ ಸಲ ರೆಪ್ಪೆಯಾಡಿಸುವಷ್ಟು ಕಾಲ /ಕಲೆಯ ೩೦ನೆಯ ಒಂದು ಭಾಗ<br><b>विस्तारः - </b>"अष्टादशनिमेषास्तु काष्ठा त्रिंशत्तु ताः कलाः" - अम० ।<br><br>काष्ठा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೀಮೆ /ಎಲ್ಲೆ /ಗಡಿ /ಅವಧಿ<br><b>प्रयोगाः - </b>"स्वयं विशीर्णद्रुमपर्णवृत्तिता परा हि काष्ठा तपसस्तया पुनः"<br><b>उल्लेखाः - </b>कुमा० ५-२८<br><br>काष्ठा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಕರ್ಷ /ಹೆಚ್ಚಿಗೆ /ಆಧಿಕ್ಯ<br><b>प्रयोगाः - </b>"काष्ठागतस्नेहरसानुविद्धं द्वन्द्वानि भावं क्रियया विवव्रुः"<br><b>उल्लेखाः - </b>कुमा० ३-३५<br><br>काष्ठा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮರದರಿಶಿನ<br><br>काष्ठा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಶ್ಯಪನ ಒಬ್ಬ ಪತ್ನಿ<br><br>काष्ठा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಾನ /ಜಾಗ<br><b>विस्तारः - </b>"काष्ठा दारुहरिद्रायां कालमानप्रकर्षयोः । स्याद्दिशि स्थानमात्रे च काष्ठमाख्यातमिन्धने" - विश्व० ।<br><br>

काष्ठागार
काष्ठागार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರದಿಂದ ನಿರ್ಮಿಸಲ್ಪಟ್ಟ ಮನೆ<br><b>व्युत्पत्तिः - </b>काष्ठमयमगारम्<br><br>

काष्ठाम्बुवाहिनी
काष्ठाम्बुवाहिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೋಣಿಯ ಆಕಾರದ ಮರದ ತೊಟ್ಟಿ /ಹಡಗಿನಿಂದ ನೀರನ್ನು ಎತ್ತಿ ಸುರಿಯುವ ಒಂದುಮರದ ಪಾತ್ರೆ<br><br>

काष्ठीला
काष्ठीला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಬಾಳೆಗಿಡ<br><br>काष्ठीला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಕ್ಕದ ಗಿಡ<br><br>

काष्ठोदुम्बरिका
काष्ठोदुम्बरिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಹತ್ತಿಗಿಡ /ಬ್ರಹ್ಮಮೇಡಿ<br><b>व्युत्पत्तिः - </b>काष्ठप्रधाना उदुम्बरिका<br><br>

कास
कास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಸರೋಗ /ಕೆಮ್ಮಲು<br><b>निष्पत्तिः - </b>कासृ (शन्दकुत्सायाम्) - कर० "घञ्" (३-३-१२१)<br><b>प्रयोगाः - </b>"प्राणोह्युदानानुगतः प्रदुष्टः सम्भिन्नकांस्यस्वनतुल्यघोषः । निरेति वक्त्रात् सहसा सदोषः कासः स विद्वद्भिरुदाहृतस्तु ॥"<br><b>उल्लेखाः - </b>सुश्रुत० उत्तर०<br><br>

कासकर
कासकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಮ್ಮಲನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "टः" (३-२-२०)<br><b>व्युत्पत्तिः - </b>कासस्य करः<br><br>

कासकृत्
कासकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಮ್ಮಲನ್ನುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>"क्विप्" (३-२-७६)<br><br>

कासघ्न
कासघ्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಮ್ಮಲನ್ನು ಹೋಗಲಾಡಿಸುವ /ಕಾಸರೋಗವನ್ನು ವಾಸಿಮಾಡುವ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) - "टक्"(३-२-५३)<br><b>व्युत्पत्तिः - </b>कासं हन्ति<br><br>

कासजित्
कासजित्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಸರೋಗವನ್ನು ಗುಣಪಡಿಸುವ /ಕೆಮ್ಮಲನ್ನು ಹೋಗಲಾಡಿಸುವ<br><b>निष्पत्तिः - </b>जि (जये) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>कासं जयति<br><br>कासजित्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭಾರಂಗಿ ವೃಕ್ಷ<br><br>

कासमर्द
कासमर्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವೃಕ್ಷ<br><br>

कासर
कासर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಿಷ /ಎಮ್ಮೆ<br><b>निष्पत्तिः - </b>आ + सृ (गतौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>के जले आसरति<br><b>प्रयोगाः - </b>"अधिष्ठितः कासरमुद्धरं मुदा वैवस्वतो दण्डधरस्तमन्वगात्"<br><b>उल्लेखाः - </b>कुमा० १४-७<br><br>

कासवत्
कासवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಸರೋಗವುಳ್ಳವನು /ಕೆಮ್ಮಲುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>कासोऽस्यास्ति<br><b>प्रयोगाः - </b>"वैरेचनं मुखेनैव कासवान् धूममापिबेत्"<br><b>उल्लेखाः - </b>चरक० चिकित्सा० १८-६५<br><br>

कासहन्
कासहन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಟಕಾರಿಯ ಕಷಾಯ<br><b>प्रयोगाः - </b>"कण्टकारीकृतः क्वाथः सकृष्णः सर्वकासहा"<br><br>कासहन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಸರೋಗವನ್ನು ವಾಸಪಡಿಸುವ /ಕೆಮ್ಮಲನ್ನು ಗುಣಪಡಿಸುವ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>कासं हन्ति<br><br>

कासार
कासार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರಸ್ಸು /ಕೊಳ /ಸರೋವರ<br><b>निष्पत्तिः - </b>कासृ (शन्दकुत्सायाम्) - "आरन्" (उ० ३-१३९)<br><b>व्युत्पत्तिः - </b>कस्य जलस्य आसारोऽत्र वा<br><b>प्रयोगाः - </b>"मांसोचितेभ्यः कासिभ्यो लावादीनां रसा हिताः"<br><b>उल्लेखाः - </b>चरक० चिकित्सा० १८-१३९<br><br>

कासारि
कासारि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಸಮರ್ದವೃಕ್ಷ<br><br>

कासिन्
कासिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಸರೋಗವುಳ್ಳವನು /ಕೆಮ್ಮಲುಳ್ಳವನು<br><br>

कासू
कासू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಕ್ತ್ಯಾಯುಧ<br><br>कासू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗ /ವ್ಯಾಧಿ<br><br>कासू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿ<br><br>कासू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸ್ಪಷ್ಟವಾದ ಮಾತು<br><b>निष्पत्तिः - </b>कस (गतौ) - "ऊः" (उ० १-८५)<br><b>विस्तारः - </b>"कासूः शक्त्यायुधे रुजि । बुद्धौ विकलवाचि स्यात्" - हेम० ।<br><br>

कासृ|शब्दकुत्सायाम्|कासते
कासृ - शब्दकुत्सायाम् (भ्वा० आत्म० अक० से०) कासते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಶಬ್ದ ಮಾಡು /ಕೆಮ್ಮು<br><br>

काहल
काहल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಕ್ಕುಟ /ಕೋಳಿ<br><b>निष्पत्तिः - </b>हल (विलेखने) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुत्सितं हलति<br><br>काहल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದ /ಧ್ವನಿ<br><br>काहल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಕ್ಕು /ಮಾರ್ಜಾರ<br><br>काहल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೊಡ್ಡ ನಗಾರಿ<br><br>काहल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಭ್ಯವಾದ ಮಾತು<br><br>काहल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಾದ್ಯ<br><br>काहल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶುಷ್ಕವಾದ /ಒಣಗಿರುವ<br><br>काहल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದೊಡ್ಡದಾದ /ಅತಿಶಯವಾದ<br><br>काहल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀಚ /ದುರ್ಜನ<br><br>काहल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಭ್ಯವಾಗಿ ಮಾತನಾಡುವವನು<br><br>काहल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸ್ಫುಟವಾಗಿ ಮಾತನಾಡುವವನು<br><br>काहल<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಾಗಿ /ಅಧಿಕವಾಗಿ<br><b>प्रयोगाः - </b>"तूर्यारावैराहितोत्तालतालैर्गायन्तीभिः काहलं काहलाभिः"<br><b>उल्लेखाः - </b>माघ० १८-५४<br><br>

काहला
काहला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ದವಾದ ನಗಾರಿ<br><br>काहला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿನ್ನಂಗಾಳೆ<br><br>काहला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಅಪ್ಸರಸ್ಸು<br><br>काहला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದತ್ತೂರಿ ಹೂವಿನಂತಿರುವ ಒಂದು ವಾದ್ಯ /ತುತ್ತೂರಿ<br><b>प्रयोगाः - </b>"आत्तया युधि विजित्य रतीशं राजितः कुसुमकाहलयेव"<br><b>उल्लेखाः - </b>नैष० २१-३४<br><br>

काहली
काहली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತರುಣಿ /ಪ್ರಾಯದ ಹೆಂಗಸು<br><b>विस्तारः - </b>"काहला वाद्यभाण्डस्य भेदे चाप्सरसां भिदि । काहली तु तरुण्यां स्यात् काहलश्चरणायुधे । शब्दमात्रेऽपि पुल्लिङ्गस्त्रिषु शुष्के भृशे खले" - मेदि० ।<br><br>काहली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತರುಣಿ /ಪ್ರಾಯದ ಹೆಂಗಸು<br><br>

काहलि
काहलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಪರಮೇಶ್ವರ<br><b>निष्पत्तिः - </b>आ + हल (विलेखने) - "इन्" (उ० ४-११७)<br><b>व्युत्पत्तिः - </b>कं सुखं आहलयति<br><b>प्रयोगाः - </b>"मुख्योऽमुखश्च देहश्च काहलिः सर्वकामदः"<br><b>उल्लेखाः - </b>भा० अनु०<br><br>

कि । ज्ञाने । चिकेति ।
कि -ज्ञाने (जुहो० पर० सक० से०) चिकेति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ತಿಳಿ /ಅರಿ<br><br>

किन्नर
किन्नर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನುಷ್ಯನ ಮುಖ ಕುದುರೆಯ ಮೈಯುಳ್ಳ ಒಂದು ವಿಚಿತ್ರ ಪ್ರಾಣಿ /ಕುದುರೆಯ ಮುಖ ಮತ್ತು ಮನುಷ್ಯನ ದೇಹವುಳ್ಳ ಒಂದು ವಿಚಿತ್ರ ಪ್ರಾಣಿ /ದೇವಯೋನಿವಿಶೇಷ<br><b>व्युत्पत्तिः - </b>किं कुत्सितो नरः<br><b>प्रयोगाः - </b>"राक्षसश्च पुलस्त्यश्च वानराः किन्नरास्तथा । यक्षाश्च मनुजव्याघ्र पुत्रास्तस्य च धीमतः ॥" "बिम्बोष्ठं बहु मनुते तुरङ्गवक्त्रश्चुम्बन्तं मुखमिह किन्नरं प्रियायाः" ।<br><b>उल्लेखाः - </b>भा० आदि० ६७-७। माघ० ४-३८<br><br>

किम्पुरुष
किम्पुरुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನುಷ್ಯನ ಮುಖ ಕುದುರೆಯ ಮೈಯುಳ್ಳ ಒಂದು ವಿಚಿತ್ರ ಪ್ರಾಣಿ /ಕುದುರೆಯ ಮುಖ ಮತ್ತು ಮನುಷ್ಯನ ದೇಹವುಳ್ಳ ಒಂದು ವಿಚಿತ್ರ ಪ್ರಾಣಿ /ದೇವಯೋನಿವಿಶೇಷ<br><b>प्रयोगाः - </b>"यक्षाः किम्पुरुषाः पौराः योषितो वनदेवताः"<br><b>उल्लेखाः - </b>कुमा० ६-३९<br><br>

किम्प्रभु
किम्प्रभु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಭ್ಯನಾದ ರಾಜ /ಕೆಟ್ಟ ದೊರೆ<br><b>निष्पत्तिः - </b>अस्वपदविग्रहः<br><b>व्युत्पत्तिः - </b>कुत्सितः प्रभुः<br><b>प्रयोगाः - </b>"स किंसखा साधु न शास्ति योऽधिपं हितान्न यः संशृणुते स किम्प्रभुः"<br><b>उल्लेखाः - </b>किरा० १-५<br><br>

किंयु
किंयु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏನನ್ನು ಅಪೇಕ್ಷಿಸುವವನು?<br><b>निष्पत्तिः - </b>किम् - "क्यच्" "उः" बाहु०।<br><b>व्युत्पत्तिः - </b>किमिच्छति<br><br>

किंराज
किंराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವ ರಾಜ? ಯಾವ ದೊರೆ?<br><br>किंराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾರಿಗೆ ಅಥವಾ ಯಾವ ದೇಶಕ್ಕೆ ದೊರೆ?<br><b>निष्पत्तिः - </b>"टच्" (५-४-९१)<br><b>व्युत्पत्तिः - </b>कः कस्य वा राजा (किमिति प्रश्नार्थकं मान्तमव्ययम्)<br><br>

किंराजन्
किंराजन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ದೊರೆ<br><b>निष्पत्तिः - </b>क्षेपार्थत्वात् न "टच्" (५-४-७०)<br><b>व्युत्पत्तिः - </b>कुत्सितो राजा<br><br>किंराजन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ದೊರೆಯನ್ನು ಹೊಂದಿರುವ ದೇಶ<br><br>

किंरूप
किंरूप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವ ಆಕಾರವುಳ್ಳ<br><br>

किंवत्
किंवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವುದನ್ನು ಹೊಂದಿರುವ? / ಯಾವುದರೊಡನೆ ಕೂಡಿರುವ?<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४) । मस्य वः ।<br><b>व्युत्पत्तिः - </b>किं विद्यतेऽस्य<br><br>किंवत्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಾವುದರಂತೆ? /ಯಾವುದಕ್ಕೆ ಸಮಾನವಾಗಿ<br><br>किंवत्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಾವುದರಲ್ಲಿರುವಂತೆ?<br><b>निष्पत्तिः - </b>"वतिः" (५-१-११६)<br><b>व्युत्पत्तिः - </b>कस्येव कस्मिन्निव वा<br><br>

किंवदन्ती
किंवदन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲೋಕಪ್ರವಾದ /ಜನರು ಆಡಿಕೊಳ್ಳುವ ಮಾತು<br><b>निष्पत्तिः - </b>किं + वद (व्यक्तायां वाचि) - "झच्" (उ० ३-१२८) । गौरा० "ङीष्" (४-१-४१)<br><br>

किंविषयक
किंविषयक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವ ವಿಷಯಕ್ಕೆ ಸಂಬಂಧಪಟ್ಟಿರುವುದು?<br><br>

किंवीर्य
किंवीर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಷ್ಟು ಶಕ್ತಿಯುಳ್ಳ ?<br><br>

किंव्यापार
किंव्यापार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವ ಕೆಲಸವುಳ್ಳವನು ? /ಯಾವ ವೃತ್ತಿಯುಳ್ಳವನು?<br><br>

किंशारु
किंशारु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯದ ಮುಳ್ಳು /ಧಾನ್ಯದ ತುದಿಯ ಭಾಗ<br><b>निष्पत्तिः - </b>शृ (हिंसायाम्) - "उण्" (उ० १-४)<br><b>व्युत्पत्तिः - </b>किञ्चित् कुत्सितं वा शृणाति<br><b>विस्तारः - </b>"किंशारुः सस्यशूकं स्यात्"- अम० ।<br><br>किंशारु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಕಪಕ್ಷಿ /ಹದ್ದು<br><br>किंशारु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣ<br><b>विस्तारः - </b>"किंशारुर्ना सस्यशूके विशिखे कङ्कपक्षिणि" - मेदि० ।<br><br>

किंशील
किंशील<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವ ಸ್ವಭಾವದವನು?<br><br>किंशील<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವ ನಡತೆಯುಳ್ಳವನು?<br><b>व्युत्पत्तिः - </b>किं शीलमस्य<br><b>विस्तारः - </b>"शीलं स्वभावे सद्वृत्ते" - अम० ।<br><br>

किंशुक
किंशुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಲಾಶ ವೃಕ್ಷ /ಮುತ್ತುಗದ ಮರ<br><b>व्युत्पत्तिः - </b>किञ्चित् शुक इव<br><br>किंशुक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಪಾಶ ಕುಸುಮ /ಮುತ್ತುಗದ ಹೂವು<br><b>प्रयोगाः - </b>"फलस्तनस्थानविशीर्णरागिहृद्विशच्छुकास्यस्मरकिंशुकाशुगम्" । "महावनानीव च किंशुकानाम्" ।<br><b>उल्लेखाः - </b>नैष० १-८३, किरा० १६-५२<br><br>

किंशुलुक
किंशुलुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಲಾಶವೃಕ್ಷ /ಮುತ್ತುಗದ ಮರ<br><b>विस्तारः - </b>किंशुक ಪದವು लु ಮಧ್ಯಮವಾಗಿ ನಿಪಾತ ಹೊಂದಿರುವುದು. (६-३-११७) ಇದಕ್ಕೆ गिरि ಶಬ್ದವು ಪರವಾದಾಗ ದೀರ್ಘ ಬರುವುದು. किंशुलुकागिरिः ।<br><br>

किंसख
किंसख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವ ಸ್ನೇಹಿತ?<br><b>निष्पत्तिः - </b>"टच्" (५-४-९१)<br><b>व्युत्पत्तिः - </b>कः कस्य वा सखा<br><br>किंसख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾರ ಸ್ನೇಹಿತ?<br><br>

किंसखि | किंसखा
किंसखि- खा<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಸ್ನೇಹಿತ /ಅಯೋಗ್ಯನಾದ ಗೆಳೆಯ<br><b>निष्पत्तिः - </b>क्षेपार्थत्वात् न "टच्" (५-४-७०)<br><b>व्युत्पत्तिः - </b>कित्सुतः सखा<br><b>प्रयोगाः - </b>"स किंसखा साधु न शास्ति योऽधिपं हितान्न यः संशृणुते स किम्प्रभुः"<br><b>उल्लेखाः - </b>किरा० १-५<br><br>

किंस्तुघ्न
किंस्तुघ्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೧೧ ಕರಣಗಳಲ್ಲೊಂದು<br><br>

किंस्वित्
किंस्वित्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಊಹೆ /ವಿತರ್ಕ<br><br>किंस्वित्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಂಶಯ<br><b>प्रयोगाः - </b>"किमयं स्थाणुः किंस्वित् पुरुषः" । "अद्रेः शृङ्गं हरति पवनः किंस्विदित्युन्मुखीभिः" ।<br><b>उल्लेखाः - </b>२)मेघ० १-१४<br><br>

किकि
किकि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾರಿಕೇಳ ವೃಕ್ಷ /ತೆಂಗಿನ ಮರ<br><br>किकि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಂಗನ ಹಕ್ಕಿ<br><b>व्युत्पत्तिः - </b>किकीत्यस्फुटशब्दं करोति<br><br>

किकीदिवि
किकीदिवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಷಪಕ್ಷಿ /ಹಂಗನ ಹಕ್ಕಿ<br><b>निष्पत्तिः - </b>दिवृ (क्रीडादौ) - "क्विन्" (उ० ४-५६) निपा० । बाहुलकत्वात् ह्रस्वदीर्घयोर्विनिमयः ।<br><b>व्युत्पत्तिः - </b>किकीत्यव्यक्तं दीव्यति वाशते<br><b>विस्तारः - </b>किकिदीविः ಎಂಬ ರೂಪವೂ ಉಂಟು. "अथ चाषः किकीदिविः" - अम० ।<br><br>

किक्किश
किक्किश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹದಲ್ಲಿರುವ ಕ್ರಿಮಿ /ತಲೆಯ ಕೂದಲು ಮೈಗೂದಲು ದಂತನಖಗಳನ್ನು ತಿನ್ನುವ ಒಂದು ಬಗೆಯ ಹುಳು<br><b>प्रयोगाः - </b>"केशरोमनखादाश्च दन्तादाः किक्किशास्तथा"<br><b>उल्लेखाः - </b>सुश्रुत० उत्तरतं० ५४-१५<br><br>

किखि
किखि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ನರಿ<br><b>विस्तारः - </b>"किखिरुल्कामुखी च सा" - त्रिकाण्ड० ।<br><br>

किङ्ङर
किङ्ङर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವಕ /ಆಳು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "अच्" (वा० ३-२-२१)<br><b>व्युत्पत्तिः - </b>किञ्चित् कुत्सितं वा करोति<br><b>प्रयोगाः - </b>"अवेहि मां किङ्ङरमष्टमूर्तेः कुम्भोदरं नाम निकुम्भमित्रम्"<br><b>उल्लेखाः - </b>रघु० २-३५<br><br>

किङ्करा
किङ्करा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವಕಿ /ಹೆಣ್ಣಾಳು<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्" (४-१-४)<br><br>

किङ्करी
किङ्करी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವಕನ ಹೆಂಡತಿ<br><b>निष्पत्तिः - </b>"ङीष्" (४-१-४८)<br><br>

किङ्किणिका|किङ्किणीका
किङ्किणि (णी)का<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಿಗೆಜ್ಜೆ<br><b>निष्पत्तिः - </b>किण + तत्करोति (वा० ३-१-२६) णिच् - "अच्" (३-१-१३४) । गौरा० "ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>किञ्चित् किणं करोति<br><b>प्रयोगाः - </b>"ग्रीवाग्रलोककलकिङ्ङिणिकानिनादमिश्रं दधद्दर्शनचर्चुरशब्दमश्वः"<br><b>उल्लेखाः - </b>माघ० ५-५८<br><br>

किङ्किणी
किङ्किणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಿಗೆಜ್ಜೆ<br><b>निष्पत्तिः - </b>किण + तत्करोति (वा० ३-१-२६) णिच् - "अच्" (३-१-१३४) । गौरा० "ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>किञ्चित् किणं करोति<br><b>प्रयोगाः - </b>"दयितेन तत्क्षणचलद्रशनाकलकिङ्किणीरवमुदासि वधूः"<br><b>उल्लेखाः - </b>माघ० ९-७४<br><br>

किङ्ङिणीकिन्
किङ्ङिणीकिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿರುಗೆಜ್ಜೆಯಿಂದ ಕೂಡಿದ /ಕಿರುಗೆಜ್ಜೆಯಿಂದ ಅಲಂಕರಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>किङ्किणीकास्यास्ति<br><br>

किङ्ङिर
किङ्ङिर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭ್ರಮರ /ದುಂಬಿ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>किञ्चित् किरति<br><br>किङ्ङिर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><br>किङ्ङिर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವ /ಕುದುರೆ<br><br>किङ्ङिर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ /ಮನ್ಮಥ<br><br>किङ्ङिर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ತವರ್ಣ /ಕೆಂಪುಬಣ್ಣ<br><br>किङ्ङिर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಕುಂಭಸ್ಥಳ<br><br>किङ्ङिर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಂಪುಬಣ್ಣದ<br><br>

किङ्किरात
किङ्किरात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಕುಳ ವೃಕ್ಷ /ಅಶೋಕವೃಕ್ಷ<br><b>निष्पत्तिः - </b>अत (सातत्यगमने) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>किङ्ङिरं रक्तवर्णमतति<br><br>किङ्किरात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಳದಿಗೋರಂಟೆ<br><br>किङ्किरात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮ /ಮನ್ಮಥ<br><br>किङ्किरात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><br>किङ्किरात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಿಣಿ<br><br>

किञ्च
किञ्च<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ<br><br>किञ्च<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಾಕಲ್ಯ /ಸಮಗ್ರತೆ /ಸಂಪೂರ್ಣತೆ<br><b>विस्तारः - </b>"किञ्चारम्भे च साकल्ये" -मेदि० ।<br><br>किञ्च<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮತ್ತು /ಅದಲ್ಲದೆ<br><b>प्रयोगाः - </b>"प्रपित्सोः किञ्च ते मुक्तिं निःस्पृहस्य कलेबरे"<br><b>उल्लेखाः - </b>किरा० ११-१६<br><br>किञ्च<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಊಹೆ /ಸಂಭಾವನೆ<br><br>

किञ्चन
किञ्चन<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಸಾಕಲ್ಯ /ಅಸಂಪೂರ್ಣವಾಗಿರುವಿಕೆ<br><br>किञ्चन<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ /ಅಲ್ಪ<br><b>विस्तारः - </b>किम् + चन ಎಂದು ೨ ಪದಗಳೆಂದು ಕೆಲವರ ಅಭಿಮತ.<br><br>किञ्चन<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನಿರ್ದಿಷ್ಟವಾದ ಯಾವುದೋ ಒಂದು<br><br>किञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವುದೋ ಒಂದು /ಅನಿರ್ದಿಷ್ಟವಾದುದೊಂದು<br><br>किञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ /ಕೊಂಚ<br><b>प्रयोगाः - </b>"परासि यः किञ्चकुञ्जितभ्रुवा"<br><b>उल्लेखाः - </b>नैष० १६-८८<br><br>किञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವುದೊ/ ಯಾವುದೊಂದೊ<br><b>प्रयोगाः - </b>"न तव विदितं न किञ्चन"<br><b>उल्लेखाः - </b>किरा० १२-३१<br><br>

किञ्चित्
किञ्चित्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ /ಅಲ್ಪ<br><b>प्रयोगाः - </b>"तयोः समापत्तिषु कातराणि किञ्चिद्व्यवस्थापितसंहृतानि"<br><b>उल्लेखाः - </b>कुमा० ७-७५<br><br>किञ्चित्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಸಾಕಲ್ಯ /ಅಸಂಪೂರ್ಣವಾಗಿರುವಿಕೆ<br><br>किञ्चित्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಾವುದೋ ಒಂದು /ಅನಿರ್ದಿಷ್ಟವಾದುದೊಂದು<br><b>प्रयोगाः - </b>"प्रस्थं हिमाद्रेर्मृगनाभिगन्धि किञ्चित् क्वणत्किन्नरमध्युवास"<br><b>उल्लेखाः - </b>कुमा० १-५४<br><br>किञ्चित्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವುದೋ ಒಂದು /ಅನಿರ್ದಿಷ್ಟವಾದುದೊಂದು<br><b>प्रयोगाः - </b>"किञ्चित् क्वणत्किन्नरमध्युवास"<br><b>उल्लेखाः - </b>कुमा० १-५४<br><br>

किञ्चिज्ञ्ज
किञ्चिज्ञ्ज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ತಿಳಿದವನು /ಸ್ವಲ್ಪ ವಿಷಯ ಬಲ್ಲವನು<br><b>निष्पत्तिः - </b>ज्ञा (अवबोधने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>किञ्चिज्जानाति<br><b>प्रयोगाः - </b>"यदा किञ्चिज्ञ्ज्ञोऽहं द्विप इव मदान्धः समभवम्"<br><b>उल्लेखाः - </b>भर्तृ० १-८<br><br>

किञ्चुलुक
किञ्चुलुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಸರಿನಲ್ಲಿರುವ ಎರುಬು ಹುಳ<br><b>निष्पत्तिः - </b>चुलुम्प - "डः" (३-२-१०१) । "कन्" (५-३-७५)<br><b>व्युत्पत्तिः - </b>किञ्चित् चुलुम्पति<br><b>विस्तारः - </b>"गण्डूपदः किञ्चुलुकः" - अम० ।<br><br>

किञ्ज
किञ्ज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾರಿಂದಲೋ ಹುಟ್ಟಿದ /ಯಾವುದರಿಂದಲೋ ಹುಟ್ಟಿದ<br><b>प्रयोगाः - </b>"मन्ये किञ्जमहं ध्यन्तं त्वामक्षत्रियजे रणे"<br><b>उल्लेखाः - </b>भट्टि० ६-१३३<br><br>

किञ्जप्य
किञ्जप्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇದರಲ್ಲಿ ಸ್ನಾನ ಮಾಡಿ ಸ್ವಲ್ಪವಾದರೂ ಜಪ ಮಾಡಲೇಬೇಕಾದ ಒಂದು ತೀರ್ಥ<br><br>

किञ्जल्क
किञ्जल्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲ ಮೊದಲಾದ ಹೂವುಗಳ ಕೇಸರ /ಹೂವುಗಳ ಕುಸುರು<br><b>निष्पत्तिः - </b>जल (अपवारणे) - "कः" बाहु० ।<br><b>व्युत्पत्तिः - </b>किञ्चित् जलति<br><b>प्रयोगाः - </b>"किञ्जल्कव्यतिकरपिञ्जरान्तराभिश्चित्रश्रीरलमलकाग्रवल्लरीभिः"<br><b>उल्लेखाः - </b>माघ० ८-५६<br><br>किञ्जल्क<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಗನ /ಆಕಾಶ<br><b>विस्तारः - </b>"किञ्ञल्कः केसरे खे क्ली" - वैज० ।<br><br>

किट|गतौ
किट - गतौ (भ्वा० पर० सक० से०)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೋಗು /ಹೊಂದು /ತಲುಪು<br><br>

किट|त्रासे
किट - त्रासे (भ्वा० पर० अक० से०)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೋಗು /ಹೊಂದು /ತಲುಪು<br><br>

किटि
किटि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರಾಹ /ಹಂದಿ<br><b>निष्पत्तिः - </b>किट (गतौ) - "इन्" (उ० ४-११९)<br><b>व्युत्पत्तिः - </b>केटति<br><br>

किटिम
किटिम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಕುಷ್ಠರೋಗ<br><br>

किटिभ
किटिभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೇನು<br><b>निष्पत्तिः - </b>भा (दीप्तौ) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>किटिरिव भाति<br><br>किटिभ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾವು ಕಚ್ಚಿದ ನೋವು<br><b>प्रयोगाः - </b>"दद्रवः कर्णिकाश्चैव विसर्पाः किटिभानि च । तैर्भवन्तीह दष्टानां यथास्वं चाप्युपद्रवाः ॥"<br><b>उल्लेखाः - </b>सुश्रुत० कल्प० ८-२१<br><br>

किट्ट
किट्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧಾತುಗಳ ಮಲ<br><br>किट्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣದ ತುಕ್ಕು /ಕಬ್ಬಿಣದ ಮೇಲಿನ ಮಲ<br><b>निष्पत्तिः - </b>किट (गतौ) - "क्तः" (३-४-७२)<br><br>किट्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮನುಷ್ಯನ ಶರೀರದೊಳಗಿನ ಮಲ<br><br>किट्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಣ್ಣೆ ತುಪ್ಪ ಮೊದಲಾದುವುಗಳ ಗಷ್ಟು<br><br>

किट्टवर्जित
किट्टवर्जित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೀರ್ಯ /ರೇತಸ್ಸು<br><b>व्युत्पत्तिः - </b>किट्टेन मलेन वर्जितम्<br><br>

किट्टाल
किट्टाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧಾತುವಿನ ಮಲ<br><b>निष्पत्तिः - </b>आ + ला (आदाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>किट्टमालति<br><br>किट्टाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾಮ್ರದ ಪಾತ್ರೆ<br><b>विस्तारः - </b>"किट्टालः पुंसि ताम्रस्य कलशे लोहगूथके" - मेदि० ।<br><br>

किट्टिम
किट्टिम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪ್ಪುಪ್ಪಾದ ನೀರು<br><b>विस्तारः - </b>"वल्लूरं तु सितं तोयमतिक्षारं तु किट्टिमम्" - वैज० ।<br><br>

किण
किण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಣಗಿದ ಹುಣ್ಣು<br><b>निष्पत्तिः - </b>कण (गतौ) - "अच्" (३-१-१३४) । पृषो० ।<br><br>किण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಯದ ಗುರುತು /ಉಜ್ಜಾಟದಿಂದ ಉಮ್ತಾದ ಮೈಮೇಲಿನ ಗುರುತು /ಜಡ್ಡು<br><b>प्रयोगाः - </b>"ज्ञास्यसि कियद्भुजो मे रक्षति मौर्वीकिणाङ्क इति"<br><b>उल्लेखाः - </b>शाकु० १-१२<br><br>किण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಂಸಗ್ರಂಥಿ<br><br>किण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಂಡಿಲಿ /ನರೋಲಿ<br><br>

किणिही
किणिही<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರಣೆ ಗಿಡ<br><b>निष्पत्तिः - </b>ओ हाङ् (गतौ) + णिच् - "कः" (३-२-३) । "ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>किणिनो व्रणान् हापयति<br><br>

किण्व
किण्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುರಾಬೀಜ /ಮದ್ಯವನ್ನು ತಯಾರಿಸಲು ಉಪಯೋಗಿಸುವ ಒಂದು ಮಾದಕ ದ್ರವ್ಯ<br><b>प्रयोगाः - </b>"सूत्रकार्पासकिण्वानां गोमयस्य गुडस्य च"<br><b>उल्लेखाः - </b>मनु० ८-२३६<br><br>किण्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><br>

कितव
कितव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೂಜಾಡುವವನು /ಜೂಜುಗಾರ<br><br>कितव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದತ್ತೂರಿ ಗಿಡ<br><br>कितव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಂಚಕ /ಮೋಸಗಾರ<br><b>निष्पत्तिः - </b>कि (ज्ञाने) - "क्तः" (३-३-११४) । ओवै (शोषणे) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कितं वायति<br><b>प्रयोगाः - </b>"मुग्धे दुष्करमेतदित्यतितमामुद्दामहासं बलादाश्लिष्य च्छलितास्मि तेन कितवेनाद्य प्रदोषगमे"<br><b>उल्लेखाः - </b>अमरु० ४६<br><br>

कितवा
कितवा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಂಚಕಿ<br><b>विस्तारः - </b>"अष्टपादस्तु किन्तनुः" - त्रिकाण्ड० ।<br><br>

किन्तनु
किन्तनु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೇಡರ ಹುಳು<br><b>व्युत्पत्तिः - </b>कुत्सिता तनुरस्य<br><br>

किन्तमाम्
किन्तमाम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನೇಕರಲ್ಲಿ ಯಾರು? /ಅನೇಕ ವಸ್ತುಗಳಲ್ಲಿ ಯಾವುದು?<br><b>निष्पत्तिः - </b>किम् - स्वार्थिकः "तमप्" (५-३-५५) । "आमुः" (५-४-११)<br><br>

किन्तराम्
किन्तराम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಇಬ್ಬರಲ್ಲಿ ಯಾರು? ಎರಡರಲ್ಲಿ ಯಾವುದು?<br><b>निष्पत्तिः - </b>किम् - "तरप्" (५-३-५७) । "आमुः" (५-४-११)<br><br>

किन्तु
किन्तु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹಿಂದೆ ಹೇಳಿದ ವಿಷಯಕ್ಕೆ ವಿರುದ್ಧವಾದ ಅರ್ಥ /ಆದರೆ<br><b>व्युत्पत्तिः - </b>किञ्च तु वा<br><b>प्रयोगाः - </b>"नृणां पश्यत्यस्य क्वचन विशिखान् किन्तु पतितद्विषद्वक्षःश्वभ्रैरनुमितिरमून् गोचरयति"<br><b>उल्लेखाः - </b>नैष० १२-४९<br><br>किन्तु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮತ್ತೂ /ಮತ್ತೇನೆಂದರೆ<br><b>प्रयोगाः - </b>"अर्थिने न तृणवद्धनमात्रं किन्तु जीवनमपि प्रतिपाद्यम्"<br><b>उल्लेखाः - </b>नैष० ५-८६<br><br>

किन्दम
किन्दम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಋಷಿ<br><b>प्रयोगाः - </b>"अस्यां मृग्यां च राजेन्द्र हर्षान्मैथुनमाचरम् । पुरुषार्थफलं कर्तुं तत् त्वया विफलीकृतम् ॥ अहं हि किन्दमो नाम तपसा भावितो मुनिः ।<br><b>उल्लेखाः - </b>भा० आदि० ११७<br><br>

किन्दान
किन्दान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಪುಣ್ಯತೀರ್ಥ<br><b>व्युत्पत्तिः - </b>किञ्चिदपि दानमावश्यकं यत्र<br><b>प्रयोगाः - </b>"किन्दाने च नरः स्नात्वा किं जप्ये च महीपते । अप्रमेयमवाप्नोति दानं जप्यं च भारत ॥"<br><b>उल्लेखाः - </b>भा० वन०<br><br>

किन्दास
किन्दास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಸೇವಕ /ಅಯೋಗ್ಯನಾದ ಆಳು<br><b>व्युत्पत्तिः - </b>कुत्सितो दासः<br><br>

किन्देवत
किन्देवत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವ ದೇವತೆಯುಳ್ಳ?<br><br>

किन्नामक
किन्नामक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವ ಹೆಸರುಳ್ಳವನು?<br><br>

किन्नामन्
किन्नामन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವ ಹೆಸರುಳ್ಳವನು?<br><br>

किन्नामधेय
किन्नामधेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವ ಹೆಸರುಳ್ಳವನು?<br><br>

किन्निमित्त
किन्निमित्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವ ಕಾರಣವುಳ್ಳ?<br><br>किन्निमित्त<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಾವ ಕಾರಣದಿಂದ?<br><b>प्रयोगाः - </b>"किन्निमित्तमिहागतः"<br><b>उल्लेखाः - </b>रामा०<br><br>

किन्नु
किन्नु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ<br><br>किन्नु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿತರ್ಕ /ಊಹೆ<br><b>व्युत्पत्तिः - </b>किञ्च नु च<br><b>प्रयोगाः - </b>"किन्नु स्याच्चित्तमोहोऽयं भवेद्वातगतिस्त्वियम्" । "किन्नु मे स्यादिदं कृत्वा किन्नु मे स्यादकुर्वतः । इति सञ्चिन्त्य मनसाः प्राज्ञः कुर्वीत वा न वा ॥"<br><b>उल्लेखाः - </b>१)रामा०<br><br>

किप्य
किप्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುರೀಷದಲ್ಲಿ ಜನಿಸುವ ಒಂದು ಕೀಟ /ಮಲದಲ್ಲಿ ಹುಟ್ಟುವ ಒಂದು ಹುಳು<br><b>प्रयोगाः - </b>"अयवा वियवाः किप्याश्चिप्या गण्डूपदास्तथा । चुरवो द्विमुखाश्चैव सप्तैवेते पुरीषजाः ॥"<br><b>उल्लेखाः - </b>सुश्रुत० उत्तर० ५४-८<br><br>

किम्
किम्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ಪರಮಾತ್ಮ<br><b>निष्पत्तिः - </b>प्रच्छ (ज्ञीप्सायाम्) - "इम्" कादेशश्च । कै (शब्दे) - "डिमिः" (उ० ४-१५८)<br><b>प्रयोगाः - </b>"एकि नैकः स वः कः किम्"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"य ईप्सितार्थप्राप्त्यर्थं प्रष्टव्यः किमिति स्मृतः" - निरुक्तिः ।<br><br>किम्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾದ /ವಿಷಯ<br><br>किम्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುತ್ಸಿತ /ನಿಕರ್ಷ /ತುಚ್ಚ<br><b>निष्पत्तिः - </b>कै (शब्दे) - "डिमिः" (उ० ४-१५८)<br><b>प्रयोगाः - </b>"कुर्यां हरस्यापि पिनाकपाणेः धैर्यच्युतिं के मम धन्विनोऽन्ये"<br><b>उल्लेखाः - </b>कुमा० ३-१०<br><br>किम्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ /ಜಿಜ್ಞಾಸಾಪೂರ್ವಕ ಕೇಳಿಕೆ<br><br>किम्<br><br><b>पदविभागः - </b>त्रिलिङ्गः (पुल्लिङ्गः)<br><b>कन्नडार्थः - </b>(ಪ್ರಶ್ನಾರ್ಥಕವಾದಾಗ ಕಿಮ್ ಶಬ್ದವು ತ್ರಿಲಿಂಗವಾಗುವುದು. ತ್ರಿಲಿಂಗವಾದಾಗ ಇದು ಸರ್ವನಾಮ ಸಂಜ್ಞೆಯನ್ನು ಹೊಂದುವುದು.) ಯಾವನು /ಯಾವುದು<br><b>प्रयोगाः - </b>"क इत्थं भाषते पाकशासने मयि शासति" । "कस्त्वं कुतो वेति न जातु शेकुस्तं प्रष्टुमप्यप्रतिभातिभारात्" । "अलं नलः कर्तुमनग्निसाक्षिकं विधिं विवाहे तव सारसाक्षि कम्?" । "सुराः स वः केन पपे कृपार्णवः ।"<br><b>उल्लेखाः - </b>नैष० १७-८५, नैष० ८-७, नैष० ९-८०, नैष० ९-९५<br><br>किम्<br><br><b>पदविभागः - </b>त्रिलिङ्गः (स्त्रीलिङ्गः)<br><b>कन्नडार्थः - </b>ಯಾವಳು /ಯಾವುದು<br><b>प्रयोगाः - </b>"का त्वमेकाकिनी भीरु निरन्वयजने वने" । "वेदोऽपि देवकीयाज्ञा तत्रज्ञाः काधिकार्हणाः" । "कामेकपत्नीव्रतदुःखशीलम्" । "कया न वाचा मुदमुद्गिरन्ति" ।<br><b>उल्लेखाः - </b>भट्टि० ५-६६, नैष० १७-५९, कुमा० ३-७, नैष० ९-२६<br><br>किम्<br><br><b>पदविभागः - </b>त्रिलिङ्गः (नपुंसकलिङ्गः)<br><b>कन्नडार्थः - </b>ಯಾವುದು<br><b>प्रयोगाः - </b>"किमपेक्ष्य फलं पयोधरान् ध्वनतः प्रार्थयते मृगाधिपः" । "किमात्थ ते किमत्थेदमस्मदग्रे निरर्गलम्" ।<br><b>उल्लेखाः - </b>किरा० २-२१, नैष० १७-९२<br><br>किम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ(ಏತಕ್ಕಾಗಿ)<br><b>प्रयोगाः - </b>"किमुपेक्षसे कथय नाथ"<br><b>उल्लेखाः - </b>किरा० १२-३१<br><br>किम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ(ಯಾವ ಕಾರಣದಿಂದ)<br><b>प्रयोगाः - </b>"किं स्वमिव मामपि तापितवानसि"<br><b>उल्लेखाः - </b>नैष० ४-५८<br><br>किम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿತರ್ಕ /ಊಹೆ<br><b>प्रयोगाः - </b>"नावा स्मरः किं हरभीतिगुप्ते पयोधरे खेलति कुम्भ एव"<br><b>उल्लेखाः - </b>नैष० ६-६६<br><br>किम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಕ್ಷೇಪಣೆ<br><br>किम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ<br><b>प्रयोगाः - </b>"स किंसखा साधु न शास्ति योऽधिपं हितान्न यः संशृणुते स किम्प्रभुः"<br><b>उल्लेखाः - </b>किरा० १-५<br><br>किम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಾದೃಶ್ಯ<br><br>किम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಷೇಧ /ತಡೆ<br><br>किम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೊಂಚ /ಸ್ವಲ್ಪ<br><b>विस्तारः - </b>"किं कुत्सायां वितर्के च निषेधप्रश्नयोरपि" - मेदि० । ಮತ್ತು ಒಂದು ವಿಷಯದಲ್ಲಿ ಪ್ರಶ್ನೆಮಾಡಿ ಅದನ್ನು ಸ್ಥಿರಪಡಿಸುವ ಅರ್ಥದಲ್ಲಿ किम् ಶಬ್ದವು ಉಪಯೋಗಿಸಲ್ಪಡುವುದು. "किं पद्मस्य रुचिं न हन्ति नयनानन्दं विधत्ते न किम् वृद्धिं वा खषकेतनस्य कुरुते नालोकमात्रेण किम्" - रत्ना० ३-१३<br><br>

कोऽपि
कोऽपि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>(किम् ಶಬ್ದಕ್ಕೆ अपि चित् चन ಸೇರಿದಾಗ ಅನಿರ್ದಿಷ್ಟವಾದ ಒಂದು ಅರ್ಥವನ್ನು ಕೊಡುವುದು) ಯಾವನೋ ಒಬ್ಬನು<br><b>प्रयोगाः - </b>"स्वस्ति यथास्थाने कुतोऽपि कोऽपि कमपि पुरुषविशेषमवगमयति"<br><b>उल्लेखाः - </b>मुद्रा० ५<br><br>

काऽपि
काऽपि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವಳೋ ಒಬ್ಬಳು<br><b>प्रयोगाः - </b>"कापि कामपि बभाण बुभुत्सुम्" । "अबन्धि तन्मूर्धजपाशमञ्जरी कयापि धूपग्रहधूमकोमला"<br><b>उल्लेखाः - </b>नैष०५-५३, नैष० १५-२९<br><br>

किमपि
किमपि<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವುದೋ ಒಂದು /ಅನಿರ್ದಿಷ್ಟವಾದುದೊಂದು<br><b>प्रयोगाः - </b>"ध्रुवं विनीतः स्मितपूर्ववाग्युवा किमप्यपृच्छन्न विलोकयन्मुखम्"<br><b>उल्लेखाः - </b>नैष० १६-६७<br><br>किमपि<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲ್ಪ /ಸ್ವಲ್ಪ<br><b>प्रयोगाः - </b>"किमपि मनसः सम्मोहो मे तदा बलवानभूत्"<br><b>उल्लेखाः - </b>शाकु० ७-२४<br><br>

कश्चित्
कश्चित्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವನೋ ಒಬ್ಬನು<br><b>प्रयोगाः - </b>"मूर्धबद्धञ्जलिर्देवानथैवं कश्चिदूचिवान्" । "केनचिन्मधुरमुल्बणरागं बाष्पतप्तमधिकं विरहेषु" ।<br><b>उल्लेखाः - </b>नैष० १७-१०७, माघ० १०-५४<br><br>

काचित्
काचित्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವಳೋ ಒಬ್ಬಳು<br><b>प्रयोगाः - </b>"काचित् समालम्ब्य सहैव कान्त्या" । "स्वयं वरार्हे स्वयमेव तस्मिन् कयाचिदाधायि कटाक्षमाला" ।<br><b>उल्लेखाः - </b>याद० १३-४६, याद० १३-५५<br><br>

कश्चन
कश्चन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವನೋ ಒಬ್ಬನು /ಯಾವುದೋ ಒಂದು<br><b>प्रयोगाः - </b>"रभसोत्थितामुपगतः सहसा परिरभ्य कश्चन वधूमरुधत्" ।<br><b>उल्लेखाः - </b>माघ० ९-७२<br><br>कश्चन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವನೊಬ್ಬನೋ/ಯಾವುದೊಂದೊ<br><b>प्रयोगाः - </b>"परितोषयिता न कश्चन स्वगतो यस्य गुणोऽस्ति देहिनः"<br><b>उल्लेखाः - </b>माघ० १६-२८<br><br>

काचन
काचन<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವಳೋ ಒಬ್ಬಳು<br><b>प्रयोगाः - </b>"भूमिनभसि तभसेन यती विरराज काचन समं महोल्कया"<br><b>उल्लेखाः - </b>माघ० १५-९२<br><br>

किमर्थ
किमर्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವ ಪ್ರಯೋಜನವುಳ್ಳ?<br><br>किमर्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವ ಉದ್ದೇಶವುಳ್ಳ? ಯಾವ ಕಾರ್ಯವುಳ್ಳ?<br><b>प्रयोगाः - </b>"किमर्थोऽयं यत्नः? किमर्थोऽयं प्रयासः?"<br><br>

किमर्थम्
किमर्थम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಏತಕ್ಕಾಗಿ?ಯಾವ ಕಾರಣದಿಂದ?<br><b>प्रयोगाः - </b>"किमर्थं तव नेत्राभ्यां वारि स्रवति शोकजम्" । "किमर्थं प्रतिषिद्धाः स्मः"<br><b>उल्लेखाः - </b>रामा० शाकु० ७<br><br>

किमाख्य
किमाख्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವ ಹೆಸರುಳ್ಳವನು? ಯಾವ ಹೆಸರಿನವನು?<br><b>प्रयोगाः - </b>"अथ सा तत्रभवती किमाख्यस्य राजर्षेः पत्नी"<br><b>उल्लेखाः - </b>शाकु० ७<br><br>

किमिच्छक
किमिच्छक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಏನು ಅಪೇಕ್ಷಿಸುವಿರಿ? /ಏನು ಬೇಕಾದರೂ ಕೊಡುವೆನು ಎನ್ನುವ ಒಂದು ವ್ರತ<br><b>व्युत्पत्तिः - </b>किमिच्छति इति प्रश्नेन दानार्थं कायति शब्दायते अत्र<br><br>

किमिति
किमिति<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಾವ ಕಾರಣದಿಂದ?<br><b>प्रयोगाः - </b>"किमित्यपास्याभरणानि यौवने धृतं त्वया वार्धकशोभि वल्कलम्"<br><b>उल्लेखाः - </b>कुमा० ५-४४<br><br>

किमिव
किमिव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಏತಕ್ಕಾಗಿ /ಯಾವ ಕಾರಣದಿಂದ<br><b>प्रयोगाः - </b>"किमिवाखिललोककीर्तितं कथयत्यात्मगुणं महामनाः"<br><b>उल्लेखाः - </b>माघ० १६-३१<br><br>किमिव<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಾವುದು ತಾನೆ /ಏನು ತಾನೆ<br><b>प्रयोगाः - </b>"पदमपि चलितुं युवा न सेहे किमिव न शक्तिहरं ससाध्वसानाम्"<br><b>उल्लेखाः - </b>माघ० ७-५२<br><br>

किमु
किमु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ /ಕೇಳಿಕೆ<br><b>व्युत्पत्तिः - </b>किञ्च उ च<br><b>प्रयोगाः - </b>"नोभविलाभूः किमु दर्पकश्च भवन्ति नासत्ययुतौ भवन्तः"<br><b>उल्लेखाः - </b>नैष० १०-४५<br><br>किमु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಊಹೆ /ಸಂಭಾವನೆ /ಉತ್ಪ್ರೇಕ್ಷೆ<br><b>प्रयोगाः - </b>"किमु तदन्तरुभौ भिषजौ दिवः स्मरनलौ विशतः स्म विगाहितुम्"<br><b>उल्लेखाः - </b>नैष० ४-५<br><br>किमु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಏನು /ಯಾವುದು<br><b>प्रयोगाः - </b>"निरास्पदं प्रश्नकुतूहलित्वमस्मास्वधीनं किमु निःस्पृहाणाम्"<br><b>उल्लेखाः - </b>किरा० ३-९<br><br>किमु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎಷ್ಟು ಹೆಚ್ಚು/ ಎಷ್ಟು ಕಡಮೆ<br><b>प्रयोगाः - </b>"यौवनं धनसम्पत्तिः प्रभृत्वमविवेकिता । एकैकमप्यनर्थाय किमु यत्र चतुष्टयम् ॥"<br><br>किमु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿತರ್ಕ /ಸಂಶಯ<br><b>प्रयोगाः - </b>विनिश्चेतुं शक्यो न सुखमिति वा दुःखमिति वा प्रमोहो निद्रा वा किमु विषविसर्पः किमु मदः"<br><b>उल्लेखाः - </b>उ० रा० १-३५<br><br>किमु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೇಗೆ /ಯಾವರೀತಿ<br><b>प्रयोगाः - </b>"किमु दिवं पुनरेति यदीदृशः पतित एष निषेव्य हि वारुणीम्"<br><b>उल्लेखाः - </b>नैष० ४-७०<br><br>किमु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಏತಕ್ಕಾಗಿ /ಯಾವ ಕಾರಣದಿಂದ<br><b>प्रयोगाः - </b>"मार्गणैरथ तव प्रयोजनं नाथसे किमु पतिं न भूभृतः"<br><b>उल्लेखाः - </b>किरा० १३-५९<br><br>

किमुत
किमुत<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ /ಕೇಳಿಕೆ<br><b>व्युत्पत्तिः - </b>किम् च उत च<br><br>किमुत<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಿಕಲ್ಪ /ಪಕ್ಷಾಂತರ<br><br>किमुत<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ತರ್ಕ /ಸಂಶಯ<br><br>किमुत<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅತಿಶಯ /ಆಧಿಕ್ಯ /ಹೆಚ್ಚಿಗೆ<br><b>प्रयोगाः - </b>"सर्वाविनयानां एकेकमप्यायतनं किमुत समवायः"<br><b>उल्लेखाः - </b>काद०<br><br>

किम्पच
किम्पच<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಪಣ /ಜಿಪುಣ<br><b>निष्पत्तिः - </b>डुपचष् (पाके) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>किं पचति<br><b>विस्तारः - </b>ಅತಿಥಿ ಅಭ್ಯಾಗತರಿಗಿಲ್ಲದೆ ತನಗೋಸ್ಕರ ಮಾತ್ರ ಅಡಿಗೆ ಮಾಡಿಕೊಳ್ಳುವವನು ಕಿಂಪಚನು.<br><br>

किम्पचान
किम्पचान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಪಣ /ಜಿಪುಣ<br><b>निष्पत्तिः - </b>"शानच्" (३-२-१२४)<br><br>

किम्पाक
किम्पाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತನ್ನೊಬ್ಬನ ಊಟಕ್ಕಾಗಿ ಮಾಡುವ ಅಡಿಗೆ<br><b>व्युत्पत्तिः - </b>कुत्सितः पाकः<br><br>

किम्पुरुष
किम्पुरुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿನ್ನರ<br><b>व्युत्पत्तिः - </b>किञ्चित् कुत्सितो वा पुरुषः<br><b>प्रयोगाः - </b>"यक्षाः किम्पुरुषाः पौरा योषितो वनदेवताः"<br><b>उल्लेखाः - </b>कुमा० ६-३९<br><br>

कियत्
कियत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಶ್ನೆ<br><b>निष्पत्तिः - </b>किम् - "वतुप्" घश्च (५-२-४०)<br><br>कियत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>(ಪ್ರಶ್ನಾರ್ಥಕವಾದಾಗ ಸರ್ವನಾಮ ಸಂಜ್ಞೆ ಹೊಂದುವುದು) ಎಷ್ಟು ಹೆಚ್ಚಿನವನು? /ಎಷ್ಟು ದೊಡ್ಡವನು?/ಎಷ್ಟು ದೊಡ್ಡದು /ಎಷ್ಟು ಪರಿಮಾಣನವುಳ್ಳದ್ದು<br><b>निष्पत्तिः - </b>किम् - "वतुप्" घश्च (५-२-४०)<br><b>व्युत्पत्तिः - </b>किं परिमाणमस्य<br><b>प्रयोगाः - </b>"कियान् कालस्तवैनं स्थितस्य सञ्जातः"<br><b>उल्लेखाः - </b>पञ्चतं०<br><br>कियत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಷ್ಟು ಮಾತ್ರದ್ದು /ಎಷ್ಟು ಹೆಚ್ಚಿನದು /ಎಷ್ಟು ದೊಡ್ಡವಳು /ಎಷ್ಟು ದೊಡ್ಡದು<br><b>प्रयोगाः - </b>"ददेऽपि तुभ्यं कियतीः कदर्थनाः सुरेषु रागप्रसवावकेशिनीः" । "कियती पञ्चसहस्री कियती लक्षापि कोटिरपि कियती । औदार्योन्नतमनसां रत्नावती वसुमती कियती ॥"<br><b>उल्लेखाः - </b>१)नैष० ९-१३१<br><br>कियत्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಷ್ಟು /ಎಷ್ಟು ಮಾತ್ರ /ಎಷ್ಟು ದೊಡ್ಡದು /ಎಷ್ಟು ಪರಿಮಾಣವುಳ್ಳದ್ದು<br><b>प्रयोगाः - </b>"ज्ञास्यसि कियद्भुजो मे रक्षति मौर्वीकिणाङ्क इति " । "निजः कटाक्षः खलु विप्रलम्भः कियन्ति यावद्भण वासराणि" ।<br><b>उल्लेखाः - </b>शाकु० १-१२, नैष० ८-९१<br><br>कियत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲ್ಪ /ಸ್ವಲ್ಪ /ಕೊಂಚ<br><b>प्रयोगाः - </b>"कियान्यथानेन वियद्विभागः तमोनिरासात् विशदीकृतोऽयम्"<br><b>उल्लेखाः - </b>नैष० २२-७१<br><br>कियत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚು /ಅಧಿಕ /ಬಹಳ<br><b>प्रयोगाः - </b>"कियतापि च कालेन कालः कलिरुपेयिवान्"<br><b>उल्लेखाः - </b>नैष० १७-१६२<br><br>कियत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲವು ಮಾತ್ರ<br><b>प्रयोगाः - </b>"वारितोऽप्यनुजगाम सयत्नं तं कियन्त्यपि पदान्यपराणि"<br><b>उल्लेखाः - </b>नैष० ५-४३<br><br>

कियत्कालम्
कियत्कालम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎಷ್ಟು ಕಾಲದಲ್ಲಿ /ಎಷ್ಟು ಸಮಯದಲ್ಲಿ /ಎಷ್ಟು ಕಾಲದವರೆಗೆ<br><br>कियत्कालम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೆಲವು ಕಾಲ /ಕೆಲವು ಕಾಲದವರೆಗೆ<br><br>

कियच्चिरम्
कियच्चिरम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎಷ್ಟು ಕಾಲ /ಎಷ್ಟು ಕಾಲದವರೆಗೆ /ಎಲ್ಲಿವರೆಗೆ<br><b>प्रयोगाः - </b>"कियच्चिरं श्राम्यसि गौरि विद्यते ममापि पूर्वाश्रमसञ्चितं तपः"<br><b>उल्लेखाः - </b>कुमा० ५-५०<br><br>

कियद्दूरम्
कियद्दूरम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎಷ್ಟು ದೂರ /ಎಷ್ಟು ದೂರದವರೆಗೆ<br><b>प्रयोगाः - </b>"पादौ कियद्दूरमिमौ प्रयासे निधित्ससे तुच्छदयं मनस्ते"<br><b>उल्लेखाः - </b>नैष० ८-२४<br><br>कियद्दूरम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ ದೂರ<br><b>व्युत्पत्तिः - </b>कियत् दूरं यस्य<br><b>प्रयोगाः - </b>"मदर्थसन्देशमृणालमन्तरः प्रियः कियद्दूर इति त्वयोदिते"<br><b>उल्लेखाः - </b>नैष० १-१३७<br><br>कियद्दूरम्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಷ್ಟು ದೂರದಲ್ಲಿರುವ<br><br>

किर
किर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರಾಹ /ಹಂದಿ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>किरति<br><br>किर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಸದಗುಂಡಿ /ತಿಪ್ಪೆ /ಹಳ್ಳ<br><br>किर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಊರಿನ ಸಮೀಪಪ್ರದೇಶ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - अधि० "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>कीर्यतेऽत्र<br><br>किर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎರಚುವ /ಬಿಸಾಡುವ /ಚೆಲ್ಲಾಪಿಲ್ಲಿಯಾಗಿ ಹಾಕುವ<br><br>

किरक
किरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಂದಿಯ ಮರಿ<br><b>व्युत्पत्तिः - </b>अल्पः किरः<br><br>किरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೇಖಕ /ಬರಹಗಾರ /ಬರೆಯುವವನು<br><br>

किरण
किरण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯಚಂದ್ರರ ರಶ್ಮಿ /ಕದಿರು<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "क्युः" (उ० २-८२)<br><b>व्युत्पत्तिः - </b>कीर्यते<br><b>प्रयोगाः - </b>"एको हि दोषो गुणसन्निपाते निमज्जतीन्दोः किरणेष्विवाङ्कः"<br><b>उल्लेखाः - </b>कुमा० १-३<br><br>किरण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - कर्म० "क्युः" (उ० २-८२)<br><b>व्युत्पत्तिः - </b>कीर्यन्ते रश्मयोऽस्मान्<br><br>

किरणमालिन्
किरणमालिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>किरणानां मालाऽस्त्यस्य<br><br>

किरत्
किरत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎರಚುತ್ತಿರುವ /ಚೆಲ್ಲುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"स पिशङ्गजटावलिः किरन्नुरुतेजः परमेण मन्युना"<br><b>उल्लेखाः - </b>किरा० १५-४७<br><br>

किरन्ती
किरन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎರಚುತ್ತಿರುವ /ಚೆಲ್ಲುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

किरात
किरात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಧ /ಬೇಡರವನು<br><b>निष्पत्तिः - </b>अत (सातत्यगमने) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>किरमवस्करदेशमतति<br><b>प्रयोगाः - </b>"विदन्ति मार्गं नखरन्ध्रमुक्तैर्मुक्ताफलैः केसरिणां किराताः"<br><b>उल्लेखाः - </b>कुमा० १-६<br><br>किरात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಿಡ್ಡ /ಕುಳ್ಳ /ವಾಮನ<br><b>प्रयोगाः - </b>"पर्यन्ताश्रयिभिर्निजस्य सदृशं नाम्नः किरातैः कृतम्"<br><b>उल्लेखाः - </b>रन्ता० २-३<br><br>किरात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಮನುಷ್ಯ /ಅರಣ್ಯನಿವಾಸಿ<br><br>किरात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಪರಿಚಾರಕ /ಕುದುರೆಯ ಯೋಗಕ್ಷೇಮ ನೋಡಿಕೊಳ್ಳುವ ಆಳು<br><br>किरात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೆಲಬೇವು<br><br>किरात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮ್ಲೇಚ್ಛಜಾತಿಯವನು<br><b>विस्तारः - </b>"किरातः स्यादल्पतनौ भूनिम्बम्ल्र्च्छयोरपि" - मेदि० ।<br><br>किरात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಾತವೇಷಧಾರಿಯಾದ ಪರಮೇಶ್ವರ<br><br>किरात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಾತ ದೇಶ<br><b>प्रयोगाः - </b>"तप्तकुण्डं समारभ्य रामक्षेत्रान्तिकं शिवे । किरातदेशो विज्ञेयो विन्द्यशैलेऽवतिष्ठते ॥"<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>

किराती
किराती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>किरात ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><br>किराती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರ್ವತಿ /ದುರ್ಗಾದೇವಿ<br><br>किराती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಡರವನ ಹೆಂಡತಿ<br><b>निष्पत्तिः - </b>किरात - "ङीष्" (४-१-४८)<br><br>किराती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಗಾನದಿ<br><br>किराती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಮರವನ್ನು ಹಿಡಿಯುವ ಹೆಂಗಸು<br><b>प्रयोगाः - </b>"नीसंश्रयः पार्श्वगतां किरातीमुपात्तबालव्यजनां बभाषे"<br><b>उल्लेखाः - </b>रघु० १६-५७<br><br>किराती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಟ್ಟಿನಿ /ತಲೆಹಿಡಕಿ<br><b>विस्तारः - </b>"किराती कुट्टिनी गङ्गा" - हेम० । "स्त्रियां चामरधारिण्यां कुट्टिनीदुर्गयोरपि" - मेदि० ।<br><br>

किराततिक्त
किराततिक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೆಲಬೇವು<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>किरातदेशो जन्मस्थानमस्य । किरातश्चासौ तिक्तश्च<br><br>

किरतार्जुनीय
किरतार्जुनीय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಾತ ಮತ್ತು ಅರ್ಜುನ ಇವರ ಯುದ್ಧವನ್ನು ವರ್ಣಿಸುವ ಒಂದು ಕಾವ್ಯ<br><b>निष्पत्तिः - </b>"छः" (४-३-८८)<br><b>व्युत्पत्तिः - </b>किरातं च अर्जुनं च अधिकृत्य कृतो ग्रन्थः<br><br>

किराताशिन्
किराताशिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರುಡ<br><b>निष्पत्तिः - </b>अश (भोजने)- "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>किरातान् अश्नाति<br><br>

किरि
किरि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರಾಹ /ಹಂದಿ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "इः" (उ० ४-१४२)<br><b>व्युत्पत्तिः - </b>किरति भूमिम्<br><br>किरि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><br>

किरीट
किरीट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಿೀಟ /ಉಮುಕುಟ /ಮುಡಿ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "कीटन्" (उ० ४-१८४)<br><b>व्युत्पत्तिः - </b>किरत्यनेन<br><b>प्रयोगाः - </b>"देवास्तदन्ते हरमूढभार्यं किरीटबद्धञ्जलयो निपत्य । शपावसाने प्रतिपन्नमूर्तेर्ययाचिरे पञ्चशरस्य सेवाम् ॥"<br><b>उल्लेखाः - </b>कुमा० ७-९२<br><br>किरीट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರುಮಾಲು /ಪೇಟ /ಮುಂಡಾಸು<br><br>

किरीटिन्
किरीटिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಜುನ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>किरीटोऽस्त्यस्य<br><b>प्रयोगाः - </b>"पुरा शक्रेण मे दत्तं युध्यतो दानवर्षभैः । किरीटं मूर्ध्नि सुर्याभं तेनाहुर्मां किरीटिनम् ॥" "त्रिचतुरेषु पदेषु किरीटीना लुलितदृष्टि मदादिव चस्खले"<br><b>उल्लेखाः - </b>भा० विरा० ४०-१७, किरा० १८-६<br><br>किरीटिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿರೀಟವನ್ನು ಧರಿಸಿರುವ<br><b>प्रयोगाः - </b>"किरीटिनं गदिनं चक्रिणं च तेजोराशिं सर्वतो दीप्तिमन्तम्"<br><b>उल्लेखाः - </b>गीता० ११-१७<br><br>

किर्मीर
किर्मीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆರಿಳೆ ಗಿಡ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "ईरन्" (उ० ४-३०)<br><br>किर्मीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಕ್ಷಸ<br><br>किर्मीर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿತ್ರವರ್ಣಗಳಿಂದ ಕೂಡಿದ /ನಾನಾ ಬಣ್ಣಗಳುಳ್ಳ<br><b>प्रयोगाः - </b>"नभोऽपि किर्मीरमकारि तेषाम्"<br><b>उल्लेखाः - </b>नैष० १०-३१<br><b>विस्तारः - </b>"किर्मीरो नागरङ्गे च कर्बुरे राक्षसान्तरे" - मेदि० ।<br><br>

किर्मीरजित्
किर्मीरजित्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೀಮಸೇನ<br><b>निष्पत्तिः - </b>जि (जये) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>किर्मीरं जयति<br><br>

किर्मीरित
किर्मीरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೆರಸಲ್ಪಟ್ಟ /ಮಿಶ್ರ ಮಾಡಲ್ಪಟ್ಟ<br><br>किर्मीरित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಾನಾ ಬಣ್ಣವಾಗಿರುವ /ಚಿತ್ರವಿಚಿತ್ರವಾಗಿರುವ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>किर्मीरोऽस्य सञ्जातः<br><b>प्रयोगाः - </b>"तत्रास्मि पत्युर्वरिवस्ययेह शर्मोर्मिकिर्मीरितधर्मलिप्सुः"<br><b>उल्लेखाः - </b>नैष० ६-९७<br><br>

किल
किल<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಜವಾಗಿಯೂ /ವಾಸ್ತವವಾಗಿಯೂ<br><b>प्रयोगाः - </b>"अलं नलं रोद्धुममी किलाभवन्गुणा विवेकप्रमुखा न चापलम्"<br><b>उल्लेखाः - </b>नैष० १-५४<br><br>किल<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪ್ರಸಿದ್ಧಿ /ಎಲ್ಲರಿಗೂ ತಿಳಿದಿರುವ<br><b>प्रयोगाः - </b>"देवः स्वयं वसति तत्र किल स्वयम्भूः"<br><b>उल्लेखाः - </b>नैष० ११-२९<br><br>किल<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಸತ್ಯ /ಅಲೀಕ /ನಟನೆ<br><b>प्रयोगाः - </b>"अरमयन् भवनादचिरद्युतेः किल भयादपपातुमनिच्छवः"<br><b>उल्लेखाः - </b>माघ० ६-४०<br><br>किल<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಾಕ್ಯಾಲಂಕಾರ<br><b>प्रयोगाः - </b>"अलक्तकं पादसरोरुहाग्रे सरोरुहाक्ष्याः किल सन्निवेश्य"<br><b>उल्लेखाः - </b>कुमा० ९-२७<br><br>किल<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಆಗಮಪ್ರಸಿದ್ಧಿ<br><b>प्रयोगाः - </b>"कंसं जघान किल वासुदेवः" । "सान्निध्ययोगात्किल तत्र शच्याः स्यंवरक्षोभकृतामभावः"<br><b>उल्लेखाः - </b>रघु० ७-३<br><br>किल<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರ /ನ್ಯಕ್ಕಾರ<br><b>प्रयोगाः - </b>"लघूकरिष्यन्नतिभारभङ्गुराममूं किल त्वं त्रिदिवादवातरः"<br><b>उल्लेखाः - </b>माघ० १-३६<br><br>किल<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಊಹೆ /ಸಂಭಾವನೆ /ಹೀಗಿರಬಹುದೆಂಬ ಬುದ್ಧಿ<br><b>प्रयोगाः - </b>"दोषापि नूनमहिमांशुरसौ किलेति व्याकोशकोकनदतां दधते नलिभ्यः"<br><b>उल्लेखाः - </b>माघ० ४-४६<br><br>किल<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅಸಮಾಧಾನ /ಅರುಚಿ<br><b>प्रयोगाः - </b>"एवं किल केचिद्वदन्ति" । "इदं किलाव्याजमनोहरं वपुस्तपःक्षमं साधयितुं य इच्छति"<br><b>उल्लेखाः - </b>शाकु० १-१६<br><br>किल<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಐತಿಹ್ಯ<br><b>प्रयोगाः - </b>"प्रवर्तयामास किलानसूया त्रिस्रोतसं त्र्यम्बकमौलिमालाम्"<br><b>उल्लेखाः - </b>रघु० १३-५१<br><br>किल<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹೇತು /ಕಾರಣ<br><b>प्रयोगाः - </b>"स किल एवमुक्तवान्"<br><br>किल<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ವಾರ್ತೆ<br><br>किल<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನುನಯ<br><b>विस्तारः - </b>"किलशब्दस्तु वार्तायां सम्भाव्यानुनयार्थयोः" - मेदि० ।<br><br>

किलकिञ्चित
किलकिञ्चित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸರ ಸ್ವಭಾವಜನ್ಯವಾದ ೧೮ ವಿಧ ಅಲಂಕಾರಗಳಲ್ಲೊಂದು /ಒಂದು ವಿಧ ಶೃಂಗಾರಚೇಷ್ಟೆ<br><b>व्युत्पत्तिः - </b>किल लीकेन ईषत् चितम् रचितम्<br><b>प्रयोगाः - </b>"स्मितशुष्करुदितहसितत्रासक्रोधश्रमादीनाम् । साङ्कर्यं किलकिञ्चितमभीष्टतमसङ्गमादिजाद्धर्षात्" । "आवासः किलकिञ्चितस्य दयिताः पार्श्वे विलासालसाः"<br><b>उल्लेखाः - </b>सा० द० ३-१०१, भर्तृ० २-८३<br><br>

किलकिला
किलकिला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹರ್ಷಧ್ವನಿ<br><b>प्रयोगाः - </b>"आसीत् किलकिलाशब्दस्तस्मिन् गच्छति पार्थिवे"<br><b>उल्लेखाः - </b>भा० आदि० ६९-८<br><br>किलकिला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೀರಪುರುಷರ ಸಿಂಹನಾದ<br><b>प्रयोगाः - </b>"जितशात्रवदर्पस्य प्रतिज्ञापूरणीकृतः । वीरस्य गर्जितं सिंहनादः किलकिला तथा ॥"<br><br>

किलाट
किलाट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಪ್ಪುಗಟ್ಟಿ ಗಟ್ಟಿಯಾದ ಹಾಲು /ಚೆನ್ನಾಗಿ ಕುದಿಯಿಸಿ ಮುದ್ದೆಯಾದ ಹಾಲು /ಖೋವ<br><b>विस्तारः - </b>"किलाटः शोषितक्षीरपिण्डस्सूरिभिरिष्यते" - हारा०<br><br>

किलाटक
किलाटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಪ್ಪುಗಟ್ಟಿ ಗಟ್ಟಿಯಾದ ಹಾಲು /ಚೆನ್ನಾಗಿ ಕುದಿಯಿಸಿ ಮುದ್ದೆಯಾದ ಹಾಲು /ಖೋವ<br><b>निष्पत्तिः - </b>स्वार्थे "कः"<br><b>विस्तारः - </b>"नष्टदुग्धस्य पक्वस्य पिण्डः प्रोक्तः किलाटकः" - भावप्र० ।<br><br>

किलाटिन्
किलाटिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿದಿರು ಮೆಳೆ /ವಂಶವೃಕ್ಷ<br><b>निष्पत्तिः - </b>किल (श्वैत्यक्रीडनयोः) - "कः" (३-१-१३५) । अट (गतौ) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>किलति । किलश्चासौ अटी च ।<br><b>विस्तारः - </b>"रेणुः सतीलस्तृणकेतुमृत्युबीजौ किलाटी च ततः सुपर्वा" - हारा० ।<br><br>

किलास
किलास<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಬ್ಬು /ಚರ್ಮದ ಮೇಲಿನ ಬೊಬ್ಬೆ<br><br>किलास<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತುರಿಗಜ್ಜಿ<br><b>निष्पत्तिः - </b>किल (श्वैत्यक्रीडनयोः) - "कः" (३-१-१३५) । असु (क्षेपणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>किलं च तदसं च<br><br>किलास<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಷ್ಠರೋಗ<br><b>निष्पत्तिः - </b>अस (दिप्तौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>किलेन शैत्येन असति<br><br>किलास<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೈ ಚಿಬ್ಬುಗಳಿಂದ ಕೂಡಿದ<br><br>किलास<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಷ್ಠರೋಗವುಳ್ಳ<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>किलासमस्यास्ति<br><br>

किलसिन्
किलसिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತುರಿಗಜ್ಜಿಯುಳ್ಳವನು<br><br>किलसिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಷ್ಠರೋಗವುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>किलासमस्यास्ति<br><br>किलसिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಬ್ಬುಗಳಿಂದ ಕೂಡಿದವನು<br><br>

किलिञ्ज
किलिञ्ज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹುಲ್ಲಿನ ಚಾಪೆ<br><b>निष्पत्तिः - </b>किल (श्वैत्यक्रीडनयोः) - "इन्" (उ० ४-११९) । जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>किल्यतेऽनेन । किलेर्जातः ।<br><br>किलिञ्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೆಳುವಾದ ಹಲಗೆ<br><b>विस्तारः - </b>"किलिञ्ञस्तु सूक्ष्मदारु" - त्रिकाण्ड० ।<br><br>

किलिञ्जक
किलिञ्जक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಲ್ಲಿನ ಚಾಪೆ<br><b>निष्पत्तिः - </b>किलिञ्ञ - स्वार्थे "कन्" (५-४-५)<br><b>विस्तारः - </b>"कटकिलिञ्ञकौ" - अम० ।<br><br>किलिञ्जक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಲ್ಲಿನ ಹಗ್ಗ /ಹುಲ್ಲಿನಿಂದ ಮಾಡಿದ ಹುರಿ<br><br>

किलिम
किलिम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇವದಾರು ಮರ<br><b>प्रयोगाः - </b>"मरिचं पिप्पलीमूलं मगधागजपिप्पली । सरलः किलिमं हिङ्गु भार्गितेजोवती त्वचौ ॥"<br><b>उल्लेखाः - </b>चरक० कल्प० ७-१२<br><br>

किल्कि
किल्कि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವ /ಕುದುರೆ<br><b>विस्तारः - </b>"अश्वकिल्की हरिक्रान्तः शालिहोत्रश्च मुद्गभुक्" - त्रिकाण्ड० ।<br><br>

किल्बिष
किल्बिष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><b>निष्पत्तिः - </b>किल (क्षेपे) - "टिषच्" बुक् च (उ० १-५०)<br><b>व्युत्पत्तिः - </b>किल्यते<br><b>प्रयोगाः - </b>"स्वयं वपुः स किल किल्बिषच्छिदां रामपादरजसामनुग्रहः"<br><b>उल्लेखाः - </b>रघु० ११-३४<br><br>किल्बिष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗ /ವ್ಯಾಧಿ<br><br>किल्बिष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪರಾಧ /ತಪ್ಪು<br><b>प्रयोगाः - </b>"को मे लुब्धक दोषोऽत्र विद्यते यदि बालिष । अस्वतन्त्रं च मां मृत्युर्विवशं यदचूचुदत् । तस्यैव वचनादृष्टो न कोपेन न काम्यया । तस्य तत्किल्बिषं लुब्ध विद्यते यदि किल्बिषम् ॥"<br><b>उल्लेखाः - </b>भा० अनु० ३५-३६<br><b>विस्तारः - </b>"अथ किल्बिषम् । पापे रागे पराधे च" - हेम०<br><br>

किल्बिषिन्
किल्बिषिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪಮಾಡಿರುವ /ಪಾಪಾತ್ಮನಾದ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>किल्बिषमस्यास्ति<br><br>किल्बिषिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪರಾಧವುಳ್ಳ /ತಪ್ಪು ಮಾಡಿದವನು<br><b>प्रयोगाः - </b>"किल्बिषी चापि मे वध्य किल्बिषी चापि पन्नग । आत्मानं कारणं ह्यत्र"<br><br>किल्बिषिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೋಗವುಳ್ಳವನು<br><br>

किशर|किसर
किश(स)र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾರಾಟಕ್ಕಿರುವ ಒಂದು ಸುಗಂಧದ್ರವ್ಯ<br><b>निष्पत्तिः - </b>"ष्ठन्" (४-४-५३)<br><b>व्युत्पत्तिः - </b>किशरः पण्यं यस्य<br><br>

किसरिक
किसरिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಗಂಧದ್ರವ್ಯವನ್ನು ಮಾರುವವನು<br><br>

किसरिकी
किसरिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಗಂಧದ್ರವ್ಯವನ್ನು ಮಾರುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीष्" (४-१-४१)<br><br>

किशोर
किशोर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಮರಿ<br><b>निष्पत्तिः - </b>शॄ (हिंसायाम्) - "ओरन्" टिलोपश्च (उ० १-६५) किमः अन्त्यलोपश्च ।<br><b>व्युत्पत्तिः - </b>किञ्चित् शृणाति<br><br>किशोर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>किशोर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೧೫ ವರ್ಷದೊಳಗಿನ ಬಾಲಕ<br><b>विस्तारः - </b>"किशोरो हयशावके । सूर्ये यूनि" - हेम० ।<br><br>किशोर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಂಕೆ /ನರಿ /ಹುಲಿ ಮೊದಲಾದ ಮೃಗಗಳ ಮರಿ<br><br>

किशोरी
किशोरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಮಾರಿ /ಕನ್ಯೆ /ಬಾಲಿಕೆ<br><b>निष्पत्तिः - </b>किशोर - "ङीप्" (४-१-२०)<br><br>

किष्किन्ध
किष्किन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣಭಾರತದಲ್ಲಿ ಒಂದು ದೇಶ<br><br>किष्किन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆ ದೇಶದಲ್ಲಿರುವ ಒಂದುಪರ್ವತ<br><b>निष्पत्तिः - </b>डुधाञ् (धारनपोषणयोः) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>किं किं ददाति<br><br>

किष्किन्धा
किष्किन्धा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಲಿಯ ರಾಜಧಾನಿಯಾದ ಒಂದು ಪಟ್ಟಣ<br><b>प्रयोगाः - </b>"गच्छ लक्ष्मण जानीहि किष्किन्धायां कपीश्वरम् । " "किष्किन्धां समुपागम्य वाली युधि निपातितः"<br><b>उल्लेखाः - </b>रामा०<br><br><b>कन्नडार्थः - </b>ವಾಲ್ಮೀಕಿರಾಮಾಯಣದಲ್ಲಿ ವಾಲಿ ಸುಗ್ರೀವರ ವಿಷಯವನ್ನು ವರ್ಣಿಸುವ ಒಂದು ಕಾಂಡ / ರಾಮಾಯಣದ ೪ ನೆಯ ಕಾಂಡ<br><br><br><br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ವ್ಯಾಪಾರ /ನೀಚ ಕೆಲಸ<br><br>

किष्किन्धानगरी
किष्किन्धानगरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಲಿಯ ರಾಜಧಾನಿಯಾದ ಕಿಷ್ಕಿಂಧಾಪಟ್ಟಣ<br><br>

किष्किन्ध्य
किष्किन्ध्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಓಢ್ರದೇಶ<br><br>किष्किन्ध्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆ ದೇಶದ ಒಂದು ಪರ್ವತ<br><br>

किष्किन्ध्या
किष्किन्ध्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆ ಪರ್ವತದ ಒಂದು ಗುಹೆ<br><br>किष्किन्ध्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಲಿಯ ರಾಜಧಾನಿ<br><br>

किष्कु
किष्कु<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>೧೨ ಅಂಗುಲಗಳ ಅಳತೆ<br><br>किष्कु<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>೧೮ ಅಂಗುಲಗಳ ಅಳತೆ /ಒಂದು ಮೊಳ<br><b>विस्तारः - </b>"किष्कुर्हस्ते वितस्तौ च" - अम० ।<br><br>

किष्कुपर्वन्
किष्कुपर्वन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿನ ಜಲ್ಲೆ<br><br>किष्कुपर्वन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿದಿರು ಮೆಳೆ /ವಂಶವೃಕ್ಷ<br><br>किष्कुपर्वन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಂಬುಹುಲ್ಲು /ಜೊಂಡುಹುಲ್ಲು<br><b>व्युत्पत्तिः - </b>किष्कुमितं पर्व यस्य<br><b>विस्तारः - </b>"किष्कुपर्वा पुमानिक्षौ वेणौ पोटगलेऽपि च" - मेदि० ।<br><br>

किसलय
किसलय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಸ ಚಿಗುರು<br><b>निष्पत्तिः - </b>षल (गतौ) - "कयन्" बाहु० । पृषो० ।<br><b>व्युत्पत्तिः - </b>किम् किञ्चित् सलति<br><b>प्रयोगाः - </b>"परिपाटलाब्जदलचारुणा सकृच्चलिताङ्गुलीकिसलयेन पाणिना"<br><b>उल्लेखाः - </b>माघ० १३-४२<br><br>

किसलयित
किसलयित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಗುರಿರುವ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>किसलयोऽस्य सञ्जातः<br><br>

कीकट
कीकट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಗಧ ದೇಶ<br><b>प्रयोगाः - </b>"ततः कलौ सम्प्रवृत्ते सम्मोहाय सुरद्विषाम् । बुद्धो नाम्ना जिनसुतः कीकटेषु भविष्यति ॥"<br><b>उल्लेखाः - </b>भाग० १-३-२४<br><b>विस्तारः - </b>"मागधाः कीकटाः मताः" - त्रिकाण्ड० ।<br><br>कीकट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೀಕಟ ದೇಶದ ಜನರು<br><b>प्रयोगाः - </b>"साधवः समुदाचारास्ते पूर्यन्तेऽपि कीकटाः"<br><b>उल्लेखाः - </b>भाग० ७-१०-१९<br><br>कीकट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವ /ಕುದುರೆ<br><br>कीकट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲೋಭಿ /ಕೃಪಣ<br><br>कीकट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದರಿದ್ರ /ಬಡವ<br><br>कीकट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀಚ<br><b>विस्तारः - </b>"कीकटः कृपणे निःस्वे त्रिषु पुम्भूम्नि नीवृति"- मेदि० । "कीकटस्तुरगे निःस्वे देशभ्दे मितम्पचे" - विश्व० ।<br><br>

कीकटाधिप
कीकटाधिप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಗಧದೇಶದ ದೊರೆ<br><b>प्रयोगाः - </b>"अपाङ्गरङ्गस्थलनाट्यलम्पटाः कताक्षधारास्तव कीकटाधिपः"<br><b>उल्लेखाः - </b>नैष० १२-८८<br><br>

कीकस
कीकस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಮಿ /ಹುಳು<br><b>निष्पत्तिः - </b>कस (गतौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>की इति कसति<br><br>कीकस<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಲುಬು /ಮೂಳೆ<br><b>विस्तारः - </b>"कीकसस्तु कृमौ कीकसमस्थनि" - हेम० ।<br><br>कीकस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾದ /ದೃಢವಾದ<br><br>

कीकसास्य
कीकसास्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಕ್ಷಿ /ಹಕ್ಕಿ<br><b>व्युत्पत्तिः - </b>कीकसमास्ये यस्य<br><br>

कीकि
कीकि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಷಪಕ್ಷಿ /ಹಂಗನ ಹಕ್ಕಿ<br><b>निष्पत्तिः - </b>कै (शब्दे) - "डिः" बाहु० ।<br><b>व्युत्पत्तिः - </b>की इति शब्दं कायति<br><br>

कीचक
कीचक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಳಗೆ ಟೊಳ್ಳಾಗಿರುವ ಬಿದಿರು<br><b>निष्पत्तिः - </b>चीक (आमर्षणे) - "वुन्" (उ० ५-३६)<br><b>व्युत्पत्तिः - </b>चीकयते<br><b>प्रयोगाः - </b>"स कीचकैर्मारुतपूर्णरन्ध्रैः कूजद्भिरापादितवंशकृत्यम्"<br><b>उल्लेखाः - </b>रघु० २-१२<br><b>विस्तारः - </b>"वेणवः कीचकास्ते स्युर्ये स्वनन्त्यनिलोद्धताः" - अम० ।<br><br>कीचक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಕ್ಷಸ<br><br>कीचक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿರಾಟರಾಜನ ಸೇನಾಪತಿ<br><br>

कीचकजित्
कीचकजित्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೀಚಕನನ್ನು ಸಂಹರಿಸಿದ ಭೀಮಸೇನ<br><b>निष्पत्तिः - </b>जि (जये) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>कीचकं जयति<br><br>

कीचकनिषूदन
कीचकनिषूदन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೀಚಕನನ್ನು ಸಂಹರಿಸಿದ ಭೀಮಸೇನ<br><b>निष्पत्तिः - </b>षूद (क्षरणे) - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कीचकं निषूदयति<br><br>

कीचकसूदन
कीचकसूदन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೀಚಕನನ್ನು ಸಂಹರಿಸಿದ ಭೀಮಸೇನ<br><b>व्युत्पत्तिः - </b>कीचकं सूदयति<br><br>

कीट
कीट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಮಿಗಿಂತಲೂ ಸ್ವಲ್ಪ ದೊಡ್ಡ ಜಾತಿಯ ಹುಳು<br><b>निष्पत्तिः - </b>कीट (बन्धे) - "अच्" (३-१-१३४)<br><b>प्रयोगाः - </b>"कीटोऽपि सुमनःसङ्गादारोहति सतां शिरः"<br><b>उल्लेखाः - </b>हितो०<br><br>कीट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಶ್ಚಿಕ ರಾಶಿ<br><b>प्रयोगाः - </b>"अलिः सरीसृपः कौर्पिः कीटो वृश्चिकवाचकः"<br><b>उल्लेखाः - </b>मुहू० दी०<br><br>

कीटक
कीटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಮಿ /ಹುಳು<br><b>निष्पत्तिः - </b>कीट - स्वार्थे "कः"<br><br>कीटक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಠಿನವಾದ /ಗಟ್ಟಿಯಾದ<br><b>विस्तारः - </b>"कीटकः कृमिजातौ ना निष्ठुरे पुनरन्यवत्" - मेदि० ।<br><br>कीटक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಗಧ ಕುಲ /ಸ್ತುತಿಪಾಠಕರ ವಂಶ /ಹೊಗಳು ಭಟರ ಬುಡಕಟ್ಟು<br><br>

कीटघ्न
कीटघ्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಮಿಗಳನ್ನು ನಾಶಪಡಿಸುವ ಗಂಧಕ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) - "टक्"(३-२-५३)<br><b>व्युत्पत्तिः - </b>कीटं हन्ति<br><br>

कीटज
कीटज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಗುಟ /ರೇಶ್ಮೆ ವಸ್ತ್ರ<br><b>प्रयोगाः - </b>"कार्पासकीटजोर्णानां द्विशफैकशफस्य च"<br><b>उल्लेखाः - </b>मनु० ११-१६८<br><br>कीटज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಮಿಗಳಿಂದ ಉಂಟಾದ<br><br>

कीटजा
कीटजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कीटज ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>कीटेभ्यो जायते<br><br>

कीटमणि
कीटमणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಖದ್ಯೋತ /ಮಿಂಚುಹುಳು<br><b>व्युत्पत्तिः - </b>कीटेषु मणिरिव<br><br>

कीटसञ्ज्ञ
कीटसञ्ज्ञ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಶ್ಚಿಕ ರಾಶಿ<br><b>व्युत्पत्तिः - </b>कीटः सञ्ज्ञा यस्य<br><br>

कीदृक्ष
कीदृक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವ ವಿಧವಾದ /ಯಾವ ತೆರನಾದ /ಎಂತಹ<br><b>निष्पत्तिः - </b>किम् + दृशिर् (प्रेक्षणे) - "क्सः" (वा० ३-२-५७) । किमः की आदेशः(६-३-९०) । "क्विन्" (३-२-६०)<br><b>व्युत्पत्तिः - </b>किमिव पश्यति<br><br>

कीदृक्
कीदृक्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವ ವಿಧವಾದ /ಯಾವ ತೆರನಾದ /ಎಂತಹ<br><b>प्रयोगाः - </b>"तद्भोः कीदृगसौ विवेकविभवः कीदृक् प्रबोधोदयः"<br><b>उल्लेखाः - </b>प्रबोध० १-१२<br><br>कीदृक्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವ ವಿಧವಾದ /ಯಾವ ತೆರನಾದ /ಎಂತಹ<br><b>निष्पत्तिः - </b>क्विनि<br><br>

कीदृश
कीदृश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವ ವಿಧವಾದ /ಯಾವ ತೆರನಾದ /ಎಂತಹ<br><br>

कीदृक्षा
कीदृक्षा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವ ವಿಧವಾದ /ಯಾವ ತೆರನಾದ /ಎಂತಹ<br><b>निष्पत्तिः - </b>स्त्रियां क्से "टाप्" (४-१-४)<br><br>

कीदृशी
कीदृशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವ ವಿಧವಾದ /ಯಾವ ತೆರನಾದ /ಎಂತಹ<br><b>निष्पत्तिः - </b>कञि "ङीप्" (४-१-१५)<br><br>

कीनाश
कीनाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಸಾಯಗಾರ /ರೈತ<br><b>निष्पत्तिः - </b>क्लिशू (विबाधने) - "कन्" उपधाया ईत्त्वम् लस्य लोपः नाम् आगमश्च (उ० ५-५६)<br><b>व्युत्पत्तिः - </b>क्लिश्नाति<br><b>प्रयोगाः - </b>"कीनाशो गोवृशो यानमलङ्कारश्च वेश्म च । विप्रस्यौद्धारिकं देयमेकांशश्च प्रधानतः ॥"<br><b>उल्लेखाः - </b>मनु० ९-१५०<br><br>कीनाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಮಧರ್ಮರಾಯ<br><b>निष्पत्तिः - </b>णश (अदर्शने) + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>की कुत्सितं नाशयति<br><b>प्रयोगाः - </b>"हुताशकीनाशजलेशदूतीर्निराकरिष्णोः कृतकाकुयाञ्चाः" । "येषां चित्ते वसेद्भक्तिः सर्वदा पेमरूपिणी । न ते पश्यन्ति कीनाशं स्वप्नेऽप्यमलमूर्तयः ॥"<br><b>उल्लेखाः - </b>नैष० ६-७५, भाग० मा० २-१६<br><br>कीनाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಪಣ /ಜಿಪುಣ<br><br>कीनाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಹಸ್ಯದಲ್ಲಿ ಕೊಲ್ಲುವವನು<br><b>विस्तारः - </b>"कीनाशः शुद्रयमयोः कर्षकोपांशुघातिनोः" - हेम० ।<br><br>

कीर
कीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶುಕ /ಗಿಣಿ<br><b>निष्पत्तिः - </b>ईर (गतौ) + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कीति ईरयति<br><b>प्रयोगाः - </b>"खगवागियमित्यतोऽपि किं न मुदं धास्यति कीरवागिव"<br><b>उल्लेखाः - </b>नैष० २-१५<br><br>कीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶ್ಮೀರ ದೇಶ<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>कीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶ್ಮೀರ ದೇಶದ ಜನರು<br><b>विस्तारः - </b>"कीरः शुके पुम्भूम्नि नीवृति" - मेदि० ।<br><br>

कीरक
कीरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಿಣಿಯ ಮರಿ<br><b>निष्पत्तिः - </b>अल्पे "कन्" (५-३-८५)<br><br>

कीरेष्ट
कीरेष्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾವಿನ ಮರ<br><br>कीरेष्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ಹಿಪ್ಪೆ ಮರ<br><b>व्युत्पत्तिः - </b>कीरस्य इष्टः<br><br>

कीर्ण
कीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಡಲ್ಪಟ್ಟ /ವ್ಯಾಪ್ತವಾದ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"दर्भैर्धावलीढैः श्रमविवृतमुखभ्रंशिभिः कीर्णवर्त्मा"<br><b>उल्लेखाः - </b>शाकु० १-७<br><br>कीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಸೆಯಲ್ಪಟ್ಟ /ಎರಚಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"कीर्णं शनैरनुकपोलमनेकपानाम्"<br><b>उल्लेखाः - </b>माघ० ५-३५<br><br>कीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಲ್ಪಟ್ಟ<br><br>कीर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸಲ್ಪಟ್ಟ /ಗಾಯಗೊಳಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कॄ (हिंसायाम्) - "क्तः" (३-२-१०२)<br><br>

कीर्णि
कीर्णि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಸೆಯುವುದು<br><br>कीर्णि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಚ್ಚುವುದು<br><br>कीर्णि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹರಡುವುದು<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "क्तिन्" (३-३-९४)<br><br>कीर्णि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸುವುದು<br><b>निष्पत्तिः - </b>कॄ (हिंसायाम्) - "क्तिन्" (३-३-९४)<br><br>

कीर्तन
कीर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಳುವುದು<br><br>कीर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತುತಿಸುವುದು /ಸೋತ್ರಮಾಡುವುದು /ಹೊಗಳುವುದು<br><b>निष्पत्तिः - </b>कॄत (संशब्दने) - भावे "ल्युट्" (३-३-११५)<br><br>कीर्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಣಿಸುವುದು<br><b>प्रयोगाः - </b>"श्रीशब्दरम्यकृतसर्गसमाप्तिलक्ष्म लक्ष्मीपतेश्चरितकीर्तनमात्रचारु"<br><b>उल्लेखाः - </b>माघकविवंशवर्णनम्<br><br>

कीर्तना
कीर्तना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಳುವುದು<br><b>निष्पत्तिः - </b>कॄत (संशब्दने) + णिच् - "युच्" (३-३-१०७)<br><br>कीर्तना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಶಸ್ಸು /ಕೀರ್ತಿ<br><b>निष्पत्तिः - </b>कॄत (संशब्दने) + णिच् - कर्म० "युच्" (३-३-१०७)<br><br>

कीर्तनीय
कीर्तनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ತುತಿಸಲ್ಪಡತಕ್ಕವನು /ಹೊಗಳಲ್ಪಡತಕ್ಕವನು<br><br>कीर्तनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವರ್ಣಿಸಲ್ಪಡತಕ್ಕವನು<br><br>कीर्तनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಗಳಲ್ಪಡುವ<br><br>कीर्तनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವರ್ಣಿಸಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>कॄत (संशब्दने) + णिच् - "अनीयर्" (३-१-९६)<br><br>कीर्तनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಗಳಲು ಯೋಗ್ಯವಾದ<br><br>

कीर्तनीया
कीर्तनीया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कीर्तनीय ಪದದ ಅರ್ಥ<br><b>प्रयोगाः - </b>"तस्याः खुरन्यासपवित्रपांसुमपांसुलानां धुरि कीर्तनीया"<br><b>उल्लेखाः - </b>रघु० २-२<br><br>

कीर्तयत्
कीर्तयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೇಳುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कॄत (संशब्दने) + णिच् - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"द्यामियाय दहनस्य केतनः कीर्तयन्निव दिवौकसां प्रियम्"<br><b>उल्लेखाः - </b>माघ० १४-२८<br><br>कीर्तयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವರ್ಣಿಸುತ್ತಿರುವ<br><br>कीर्तयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಗಳುತ್ತಿರುವ<br><br>

कीर्तयन्ती
कीर्तयन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कीर्तयत् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कीर्ति
कीर्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಶಸ್ಸು /ಖ್ಯಾತಿ /ಹೆಸರುವಾಸಿ<br><b>निष्पत्तिः - </b>कॄत (संशब्दने) + णिच् - "क्तिन्" (३-३-९४) । निपा० ।<br><b>व्युत्पत्तिः - </b>कीर्त्यते<br><b>प्रयोगाः - </b>"कीर्तिरेव भवतां प्रियदाराः दाननीरझरमौक्तिकहारा"<br><b>उल्लेखाः - </b>नैष० ५-१२८<br><br>कीर्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆ /ಪ್ರಾಸಾದ /ಸೌಧ<br><br>कीर्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಥನ /ಹೇಳುವುದು<br><br>कीर्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಸಾದ /ಅನುಗ್ರಹ<br><br>कीर्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಸ್ತಾರ<br><br>कीर्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ದಮ /ಕೆಸರು<br><b>विस्तारः - </b>"कीर्तिर्यशसि विस्तारे प्रासादे कर्दमेऽपि च" - हेम० । "कीर्तिः प्रसादयशसोः" - मेदि० ।<br><br>कीर्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷನ ಪುತ್ರಿ /ಧರ್ಮಪುರುಷನ ಪತ್ನಿ<br><b>विस्तारः - </b>कीर्तिः लक्ष्मीः धृतिः मेधा पुष्टिः श्रद्धा क्रिया वृद्धिः लज्जा मतिः - एते धर्मपुरुषस्य पत्नयः ।<br><br>

कीर्तित
कीर्तित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಳುವುದು<br><br>कीर्तित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಗಳುವುದು<br><br>कीर्तित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಣಿಸುವುದು<br><b>निष्पत्तिः - </b>कॄत (संशब्दने) - "क्तः" (३-३-११४)<br><br>कीर्तित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇಳಲ್ಪಟ್ಟ<br><br>कीर्तित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಗಳಲ್ಪಟ್ಟ<br><br>कीर्तित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವರ್ಣಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कॄत (संशब्दने) - कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"किमिवाखिललोककीर्तितं कथयत्यात्मगुणं महामनाः" । "जितेन्द्रियाणां धुरि कीर्तितस्थितिः" ।<br><b>उल्लेखाः - </b>माघ० १६-३१, नैष० १-५३<br><br>

कीर्तितव्य
कीर्तितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ತುತಿಸಲ್ಪಡತಕ್ಕವನು /ಹೊಗಳಲ್ಪಡತಕ್ಕವನು<br><br>कीर्तितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವರ್ಣಿಸಲ್ಪಡತಕ್ಕವನು<br><b>निष्पत्तिः - </b>कॄत (संशब्दने) + णिच् - "तव्यः" (३-१-९६)<br><br>कीर्तितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ತುತಿಸಲ್ಪಡುವ /ಹೊಗಳಲ್ಪಡುವ<br><br>कीर्तितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವರ್ಣಿಸಲ್ಪಡುವ<br><br>

कीर्तिपूर
कीर्तिपूर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಶಸ್ಸಿನ ಪ್ರವಾಹ /ಕೀರ್ತಿಯ ಹೊನಲು<br><b>व्युत्पत्तिः - </b>कीर्तेः पूरः प्रवाहः<br><b>प्रयोगाः - </b>"काव्यव्यूहः क्व जगति न जगत्यर्दः कीर्तिपूरः"<br><b>उल्लेखाः - </b>नैष० १२-५७<br><br>

कीर्तिभाज्
कीर्तिभाज्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಖ್ಯಾತಿವಂತ /ಕೀರ್ತಿಯನ್ನು ಪಡೆದವನು /ಹೆಸರುವಾಸಿ ಪಡೆದವನು<br><b>निष्पत्तिः - </b>भज (सेवायाम्) - "ण्विः" (३-२-६२)<br><b>व्युत्पत्तिः - </b>कीर्तिं भजते<br><br>

कीर्तिमत्
कीर्तिमत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತಾನಪಾದರಾಯನ ಹಿರಿಯ ಹೆಂಡತಿಯಾದ ಸುನೀತಿಯ ಮಗ /ಧ್ರುವ ಕುಮಾರನ ತಮ್ಮ<br><br>कीर्तिमत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸುದೇವನ ಹಿರಿಯ ಮಗ /ದೇವಕಿಯ ಮೊದಲನೆಯ ಮಗ<br><b>प्रयोगाः - </b>"वसुदेवस्तु देवक्यामष्टपुत्रानजीजनत् । कीर्तिमन्तं सुषेणं च भद्रसेनमुदारधीः । ऋजुं सम्मर्दनं भद्रं सङ्कर्षणमहीश्वरम् ॥"<br><br>कीर्तिमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೀರ್ತಿಶಾಲಿಯಾದ /ಖ್ಯಾತಿಪಡೆದ /ಹೆಸರುವಾಸಿಯಾದ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>कीर्तिरस्यास्ति<br><br>

कीर्तिमती
कीर्तिमती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷಕನ್ಯೆ /ದಾಕ್ಷಾಯಣಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कीर्तियुत
कीर्तियुत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೀರ್ತಿಯಿಂದ ಕೂಡಿದ /ಕೀರ್ತಿಶಾಲಿಯಾದ /ಹೆಸರುವಾಸಿಯಾದ<br><br>

कीर्तियुक्त
कीर्तियुक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೀರ್ತಿಯಿಂದ ಕೂಡಿದ /ಕೀರ್ತಿಶಾಲಿಯಾದ /ಹೆಸರುವಾಸಿಯಾದ<br><br>

कीर्तिरथ
कीर्तिरथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿದೇಹದ ರಾಜಕುಮಾರ /ಪ್ರತಿಂಧಕ ರಾಜನ ಮಗ<br><br>

कीर्तिशेष
कीर्तिशेष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೀರ್ತಿಯು ಮಾತ್ರ ಉಳಿದಿರುವ /ಹೆಸರಿನಿಂದ ಮಾತ್ರ ಉಳಿದಿರುವ /ಮೃತ<br><b>व्युत्पत्तिः - </b>कीर्तेः शेषो यस्य<br><br>

कीर्यमाण
कीर्यमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಡಲ್ಪಡುವ<br><br>कीर्यमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎರಚಲ್ಪಡುವ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "शानच्" (३-२-१२४)<br><br>कीर्यमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಲ್ಪಡುವ<br><br>

कील|बन्धने
कील - बन्धने (भ्वा० पर० सक० से०)<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಣಿ,ಬೆಣೆ ಮೊದಲಾದುವುಗಳಿಂದ ಬಂಧಿಸು /ಕಚ್ಚಿಸು /ಭದ್ರಪಡಿಸು /ಬೀಗಹಾಕಿ ಭದ್ರಪಡಿಸು<br><br>

कील
कील<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ಜ್ವಾಲೆ /ಬೆಂಕಿಯ ಉರಿ<br><b>प्रयोगाः - </b>"धूमाविला कीलपरम्परेव"<br><b>उल्लेखाः - </b>नैष० ८-७६<br><br>कील<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೀಲು /ಬೆಣೆ<br><br>कील<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಈಟಿ /ಭಲ್ಲೆ<br><b>निष्पत्तिः - </b>कील (बन्धने) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>कीलति<br><br>कील<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಬ<br><br>कील<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಂಕು /ಗೂಟ /ಹಸು ಮೊದಲಾದುವುಗಳನ್ನು ಕಟ್ಟುವ ಮೋಟುಗಂಬ<br><b>प्रयोगाः - </b>"उत्खाय दर्पचलितेन सहैव रज्ज्वा कीलं प्रयत्नपरमानवदुर्ग्रहेण"<br><b>उल्लेखाः - </b>माघ० ५-५९<br><br>कील<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಣಕೈ /ಮೊಳಕೈ<br><br>कील<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾವು /ಒಂದು ವಸ್ತುವನ್ನು ಹಿಡಿದುಕೊಳ್ಳಲು ಮಾಡಿರುವ ಅದರ ಹಿಡಿ<br><br>कील<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಗಿಪಟ್ಟಿ /ಒಂದು ವಸ್ತುವು ಭದ್ರವಾಗಿ ನಿಲ್ಲಲು ಹಿಡಿದು ಕಟ್ಟುವ ಪಟ್ಟಿ<br><br>कील<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೇಶ /ಚೂರು /ಸೂಕ್ಷ್ಮಾಂಶ<br><b>विस्तारः - </b>"कीलो लेशे द्वयोः स्तम्भज्वालाकफोणिशङ्कुशु" - मेदि० ।<br><br>कील<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಸವವು ಸಮೀಪಿಸಿ ಜನನದ್ವಾರವನ್ನು ಮೇಲುಮುಖವಾದ ತೋಳು ತಲೆ ಕಾಲುಗಳಿಂದ ಮುಚ್ಚಿರುವ ಗರ್ಭದೊಳಗಿನ ಶಿಶು /ಗರ್ಭದಲ್ಲಿ ಪೂರ್ಣವಾಗಿ ಬೆಳೆದಿರುವ ಶಿಶು<br><b>प्रयोगाः - </b>"तत्र ऊर्ध्वबाहुशिरःपादो यो योनिमुखं निरुणद्धि कील इव स कीलः"<br><b>उल्लेखाः - </b>सुश्रुत० निदान० ८-४<br><br>कील<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗುಳಿ /ತಾಪಾಳು<br><br>कील<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೀಗ<br><br>कील<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೋಳು<br><br>कील<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರುದ್ರ /ಈಶ್ವರ<br><b>विस्तारः - </b>"कीलोऽक्ली कफणौ ज्वाले बाहौ ना शङ्कुशर्वयोः" - वैज० ।<br><br>कील<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಟ್ಟೆಯೊಳಗಿನ ಊತ /ಬಾವು /ಗೆಡ್ಡೆ<br><br>कील<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಡಿಯ ಕಡಾಣಿ<br><b>विस्तारः - </b>"अक्षकीले त्वणिर्न क्ली ध्रुवः कीलोऽप्यनि र्न षण्" - वैज० ।<br><br>कील<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಟ್ಟು /ಬಂಧನ<br><b>निष्पत्तिः - </b>कील (बन्धने) - भावे करणादौ "घञ्"<br><br>कील<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><br>

कीला
कीला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಣಕೈ ಏಟು /ಮೊಳಕೈಯಿಂದ ಹೊಡೆತ<br><b>प्रयोगाः - </b>"कीला उरसि, कर्तरी शिरसि, विद्धा कपोलयोः" - वात्स्या० सू० ।<br><br>

कीलक
कीलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಭವ ಮೊದಲಾದ ೬೦ ಸಂವತ್ಸರಗಳಲ್ಲಿ ೪೨ ನೆಯದು<br><br>कीलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಣಿ /ಮೊಳೆ<br><br>कीलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೂಟ /ಹಸುಗಳನ್ನು ಕರೆಯುವಾಗ ತಡೆಗಟ್ಟುವ ಗೂಟ<br><b>प्रयोगाः - </b>"जायन्ते सर्वशस्यानि सुभिक्षं निरुपद्रवम् । सौम्यवृष्टिर्भवेद्राजन् कीलके च शुभं भवेत् ॥"<br><br>कीलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಟ್ಟೆಯಲ್ಲಿ ಊತ /ಗೆಡ್ಡೆ /ಬಾವು<br><br>कीलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಂಕು /ಕೀಲು /ಅಗುಳಿ<br><br>कीलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಬ<br><b>निष्पत्तिः - </b>कील (बन्धने) - कर० "घञ्" (३-३-११७) । स्वार्थे "कः"<br><b>व्युत्पत्तिः - </b>कीलति बध्नात्यनेन<br><br>कीलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರು /ಸ್ಫೋಟ<br><b>विस्तारः - </b>"स्फोटकः कीलको गण्डो विस्फोटः पिटका त्रयी" - वैज० ।<br><br>

कीलत्
कीलत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೀಗಹಾಕುತ್ತಿರುವ<br><br>कीलत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗುಳಿ ಹಾಕುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कील (बन्धने) - "शतृ" (३-२-१२४)<br><br>

कीलन
कीलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಧಿಸುವುದು /ಕಟ್ಟುವುದು<br><b>निष्पत्तिः - </b>कील (बन्धने) - भावे "ल्युट्" (३-३-११५)<br><br>कीलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೀಗ ಹಾಕುವುದು<br><br>कीलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗುಳಿ ಹಾಕಿ ಭದ್ರಪಡಿಸುವುದು<br><br>

कीलनीय
कीलनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೀಗ ಹಾಕಿ ಭದ್ರಪಡಿಸಬೇಕಾದ<br><br>कीलनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಾಪಾಳು ಹಾಕಲು ಯೋಗ್ಯವಾದ<br><b>निष्पत्तिः - </b>कील (बन्धने) - "अनीयर्" (३-१-९६)<br><br>कीलनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೂಟ ಹೊಡೆಯಲು ಶಕ್ಯವಾದ<br><br>

कीलयत्
कीलयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೀಗ ಹಾಕಿಸುತ್ತಿರುವ<br><br>कीलयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಾಪಾಳು ಹಾಕಿಸುತ್ತಿರುವ<br><br>कीलयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೂಟ ಹೊಡೆಯಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कील (बन्धने) + णिच् - "शतृ" (३-२-१२४)<br><br>

कीलयन्ती
कीलयन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कीलयत् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कीलयितृ
कीलयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೀಗ ಹಾಕಿಸುತ್ತಿರುವವನು<br><br>कीलयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಾಪಾಳು ಹಾಕಿಸುತ್ತಿರುವವನು<br><br>कीलयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೂಟ ಹೊಡೆಯಿಸುತ್ತಿರುವವನು<br><b>निष्पत्तिः - </b>कील (बन्धने) + णिच् - "तृच्" (३-१-१३३)<br><br>

कीलयित्री
कीलयित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कीलयितृ ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कीलाल
कीलाल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><b>निष्पत्तिः - </b>अल (भूषणादौ) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कीलां ज्वालामलति वारयति<br><br>कीलाल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ತ<br><br>कीलाल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮೃತ<br><b>विस्तारः - </b>"कीलालं रुधिरे नीरे" - हेम० ।<br><br>कीलाल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾವಿನ ಹೆಡೆಯ ಒಂದು ಭಾಗ<br><b>विस्तारः - </b>"कीलालमसृगम्भसोः । फणभागे" - नानार्थर० ।<br><br>

कीलालज
कीलालज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಂಸ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>कीलाज्जायते<br><b>प्रयोगाः - </b>"रसाद्रक्तं ततो मांसं मांसोन्मेदः प्रजायते । मेदसोऽस्थि ततो मज्जा मज्ज्ञः शुक्रं तु जायते ॥"<br><b>उल्लेखाः - </b>सुश्रुत ०सूत्र० १४-१०<br><br>

कीलालधि
कीलालधि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ /ಕಡಲು<br><b>निष्पत्तिः - </b>डुधाञ् (धारनपोषणयोः) - "किः" (३-३-९३)<br><b>व्युत्पत्तिः - </b>कीलालं धीयतेऽत्र<br><br>

कीलालप
कीलालप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಕ್ಷಸ<br><b>निष्पत्तिः - </b>पा (पाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कीलालं रक्तं पिबति<br><br>कीलालप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಕ್ತವನ್ನು ಕುಡಿಯುವವನು<br><b>प्रयोगाः - </b>"स तु कीलालपो यस्तु परान्नं भोक्तुमिच्छति"<br><b>उल्लेखाः - </b>भा० वन०<br><br>

कीलित
कीलित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಧನ /ಕಟ್ಟು<br><b>निष्पत्तिः - </b>कील (बन्धने) - भावे "क्तः" (३-३-११४)<br><br>कीलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಟ್ಟಿಯಿಂದ ಕಟ್ಟಲ್ಪಟ್ಟ<br><br>कीलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೀಗ ಹಾಕಲ್ಪಟ್ಟ /ಬೀಗ ಹಾಕಿ ಭದ್ರಪಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कील (बन्धने) - "क्तः" (३-२-१०२)<br><br>कीलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಣಿಯಿಂದ ಹೊಡೆಯಲ್ಪಟ್ಟ /ಮೊಳೆ ಹೊಡೆದು ಭದ್ರವಾಗಿ ನಿಲ್ಲಿಸಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"सा नश्चेतसि कीलितेव विशिखैश्चेतोभुवः पञ्चभिश्चिन्तासन्ततितन्तुजालनिबिडस्यूतेव लग्ना प्रिया"<br><b>उल्लेखाः - </b>मालती० ५-१०<br><br>कीलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಂಧನದಲ್ಲಿಡಲ್ಪಟ್ಟ /ಒಂದು ಮಿತಿಯಲ್ಲಿಡಲ್ಪಟ್ಟ<br><br>

कीलितृ
कीलितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬೀಗ ಹಾಕುವ<br><b>निष्पत्तिः - </b>कील (बन्धने) - "तृच्" (३-१-१३३)<br><br>कीलितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಣಿ ಹೊಡೆಯುವ<br><br>कीलितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಂಧನದಲ್ಲಿಡುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कीलित्री
कीलित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कीलितृ ಪದದ ಅರ್ಥ<br><br>

कीश
कीश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಿ /ವಾನರ /ಕೋತಿ<br><b>निष्पत्तिः - </b>"इञ्" (४-१-९५) । ईष (ऐश्वर्ये) - "कः" (वा० ३-२-५)<br><b>व्युत्पत्तिः - </b>कस्य वायोरपत्यम् । किः वायुपुत्रः हनूमान् । सः ईशो यस्य । कीः इति शब्दमाचष्टे<br><br>कीश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><br>कीश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಕ್ಷಿ /ಹಕ್ಕಿ<br><br>कीश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಿಗಂಬರ /ಬಟ್ಟೆ ಹೊದೆಯದಿರದವನು /ಬೆತ್ತಲೆಯವನು<br><b>विस्तारः - </b>"कीशो दिगम्बरे कपौ" - मेदि० ।<br><br>

कीशपर्ण
कीशपर्ण<br><br><b>कन्नडार्थः - </b>ಅಪಾಮಾರ್ಗ /ಉತ್ತರಣೆ ಗಿಡ<br><br>

कीशपर्णी
कीशपर्णी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಾಮಾರ್ಗ /ಉತ್ತರಣೆ ಗಿಡ<br><b>निष्पत्तिः - </b>"ङीष्" (४-१-६४)<br><b>व्युत्पत्तिः - </b>कीशलोमसदृशानि पर्णान्यस्याः<br><br>

कु|शब्दे|कौति
कु - शब्दे (अदा० पर० अक० अनि०) कौति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಶಬ್ದ ಮಾಡುವುದು<br><br>

कु
कु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ ಖ ಗ ಘ ಙ ಈ ೫ ವರ್ಣಗಳ ವರ್ಗ<br><b>प्रयोगाः - </b>"अकुहविसर्जनीयानां कण्ठः"<br><b>उल्लेखाः - </b>सि० कौ०<br><br>कु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದ /ಧ್ವನಿ /ಸದ್ದು<br><br>कु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿ<br><b>निष्पत्तिः - </b>कुङ् (शब्दे)- "डुः" (वा० ३-२-१८०)<br><b>व्युत्पत्तिः - </b>कुवते<br><br>कु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪಾಪ<br><br>कु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ<br><br>कु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸ್ವಲ್ಪ /ಅಲ್ಪ<br><br>कु<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ತಡೆ /ಅಡ್ಡಿ<br><b>विस्तारः - </b>"पृथिव्यां कुः समाख्यातः कुः शब्देऽपि प्रकीर्तितः" - एका० । "कुः स्त्री भुवि कु पापेऽल्पे कुत्सायां वारणेऽव्ययम्" - नानार्थर० । कु ಶಬ್ದಕ್ಕೆ ಅಜಾದಿ ಪದವೂ तृण रथ वद ಪದಗಳೂ ಪರವಾದರೆ कन् ಆದೇಶವು ಬರುವುದು. कदन्न्म् । कदश्वः । कत्तृअणम् । कद्रथः । कद्वदः । पथिन् ಮತ್ತು अक्ष ಪದಗಳು ಪರವಾದರೂ ಅಲ್ಪಾರ್ಥದಲ್ಲಿಯೂ का ಆದೇಶವು ನಿತ್ಯವಾಗಿ ಬರುವುದು. कापथम् । काक्षः । पुरुष ಪದವು ಪರವಾದರೆ ವಿಕಲ್ಪವಾಗಿ का ಆದೇಶವು ಬರುವುದು. कापुरुषः । कुपुरुषः । उष्ण ಪದವು ಪರವಾದರೆ कव का ಮತ್ತು कत् ಆದೇಶಗಳು ಬರುವುವು. कवोष्णम् । कोष्णम् । कदुष्णम् ।<br><br>

कुक|आदाने|कोकते
कुक - आदाने (भ्वा० आत्म० सक० से०) कोकते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೋ /ಸ್ವೀಕರಿಸು<br><br>

कुक
कुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊಳ್ಳುವವನು /ಸ್ವೀಕರಿಸುವವನು<br><b>निष्पत्तिः - </b>कुक (आदाने) - "कः" (३-१-१३५)<br><br>कुक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮರ್ಥ<br><br>

कुकथा
कुकथा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಕಥೆ /ದುಃಖದಕಥೆ<br><b>व्युत्पत्तिः - </b>कुत्सिता कथा<br><b>प्रयोगाः - </b>"शृण्वन्ति ये अन्यविषयाः कुकथा मतिघ्नीः"<br><b>उल्लेखाः - </b>भाग० ३-१५-२३<br><br>

कुकन्या
कुकन्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯ ಹುಡುಗಿ /ಕೆಟ್ಟ ಹುಡುಗಿ<br><b>व्युत्पत्तिः - </b>कुत्सिता कन्या<br><br>

कुकभ
कुकभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ /ಹೆಂಡ<br><br>

कुकर
कुकर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಂಡುಕೈ<br><b>व्युत्पत्तिः - </b>कुत्सितः करः<br><br>कुकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊಂಡುಕೈಯುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>कुत्सितो करो यस्य<br><br>कुकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಕೆಲಸ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "टः" (३-२-२०)<br><b>व्युत्पत्तिः - </b>कुत्सितं करोति<br><br>

कुकर्मन्
कुकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಕೆಲಸ /ಅಕಾರ್ಯ<br><b>व्युत्पत्तिः - </b>कुत्सितं कर्म<br><br>कुकर्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಕೆಲಸ ಮಾಡುವವನು<br><b>व्युत्पत्तिः - </b>कुत्सितं कर्म यस्य<br><br>

कुकलत्र
कुकलत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಹೆಂಡತಿ /ಅಸಭ್ಯ ಹೆಂಡತಿ<br><b>व्युत्पत्तिः - </b>कुत्सितं कलत्रम्<br><br>

कुकार्य
कुकार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀಚವಾದ ಕಾರ್ಯ /ಕೆಟ್ಟ ಕೆಲಸ<br><b>व्युत्पत्तिः - </b>कुत्सितं कार्यम्<br><br>

कुकाव्य
कुकाव्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದುಷ್ಟಕಾವ್ಯ /ದೋಷಗಳಿಂದ ಕೂಡಿದ ಕಾವ್ಯ<br><br>कुकाव्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀಚ ವಿಷಯವನ್ನು ಕುರಿತ ಕಾವ್ಯ<br><b>व्युत्पत्तिः - </b>कुत्सितं काव्यम्<br><br>

कुकील
कुकील<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತ /ಬೆಟ್ಟ<br><b>व्युत्पत्तिः - </b>कों कील इव<br><br>

कुकुण्ड
कुकुण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಯಿಕೊಡೆ<br><br>

कुकुन्दर
कुकुन्दर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸರ ಪಿರ್ರೆಗಳ ಮೇಲಿರುವ ಗುಳಿಗಳು<br><b>निष्पत्तिः - </b>दृ (विदारणे) + णिच् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कुं भूमिं दारयति । कुत्सितं कन्दरम् ।<br><br>

कुकुर
कुकुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯದುವಂಶದ ಒಬ್ಬ ದೊರೆ /ಅಂಧಕ ರಾಜನ ಮಗ<br><br>कुकुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಶಾರ್ಹ ದೇಶ<br><br>कुकुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಶಾರ್ಹದೇಶದ ಜನರು<br><b>प्रयोगाः - </b>"सति मधावभवन्मदनव्यथाविधुरिता धुरि ताः कुकुरस्त्रियः"<br><b>उल्लेखाः - </b>माघ० ६-१५<br><br>कुकुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಯಿ<br><b>निष्पत्तिः - </b>कुक (आदाने) - "क्विप्" (३-२-१७८) । कुक् । कुर (शब्दे) - "कः" (३-१-१३५) । कुरः<br><b>व्युत्पत्तिः - </b>कुक् चासौ कुरश्च<br><br>कुकुर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಚಿಪತ್ರೆ<br><b>विस्तारः - </b>"कुक्कुरः सारमेये ना ग्रन्थिपर्णे नपुंसकम्" - मेदि० ।<br><br>

कुकूल
कुकूल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತುಷಾನಲ /ಹೊಟ್ಟೆಯೊಳಗಿನ ಬೆಂಕಿ<br><b>निष्पत्तिः - </b>कु (शब्दे) - "ऊलच्" कुगागमश्च (उ० ४-९०) निपा० ।<br><b>व्युत्पत्तिः - </b>कोः भूमेः कूलम्<br><br>कुकूल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಲಾಕಿಗಳಿಂದ ತುಂಬಿದ ಹಳ್ಳ /ಗೂಟಗಳಿಂದ ತುಂಬಿದ ಗುಳಿ<br><b>विस्तारः - </b>"कुकूलं शङ्कुसङ्कीर्णश्वभ्रे ना तु तुषानले" - मेदि० ।<br><br>कुकूल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕವಚ<br><br>कुकूल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆರಣಿ<br><b>प्रयोगाः - </b>"येभ्योऽमी शतशः कुकूलहुतभुग्दाहं दहन्तः शनैः"<br><b>उल्लेखाः - </b>प्रबोध० ५-१६<br><br>

कुकृत्य
कुकृत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಕೆಲಸ /ಅಕಾರ್ಯ<br><b>व्युत्पत्तिः - </b>कुत्सितं कृत्यम्<br><br>कुकृत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುತಾಪ /ಪಶ್ಚಾತ್ತಾಪ<br><b>विस्तारः - </b>"कुकृत्यमनुतापे स्यादयुक्तकरणेऽपि च" - हेम० ।<br><br>

कुक्कुट
कुक्कुट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಂಜ /ಗಂಡುಕೋಳಿ<br><b>निष्पत्तिः - </b>कुट (कौटिल्ये) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>कुका आदानेन कुटति<br><br>कुक्कुट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಕೋಳಿ<br><br>कुक्कुट<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಡಂಭಾಚಾರ /ಕಪಟ /ಮೋಸ<br><b>निष्पत्तिः - </b>कुक्कुट - आचारार्थे "क्विप्" (वा० ३-१-११) । "इन्" (उ० ४-११७)<br><b>व्युत्पत्तिः - </b>कुक्कुट इवाचरति<br><b>विस्तारः - </b>"अथ कुक्कुटिः । कुहना दम्भचर्या च" - अभि० चि० ।<br><br>

कुक्कुटी
कुक्कुटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಕಣ /ಬೆಂಕಿಯ ಕಿಡಿ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>कुक्कुटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಷಾದನಿಂದ ಶೂದ್ರಸ್ತ್ರೀಯಲ್ಲಿ ಹುಟ್ಟಿದ ಬೆರಕೆ ಜಾತಿಯವನು<br><b>विस्तारः - </b>"कुक्कुटः कुक्कुभे ताम्रचूडे वनिकणेऽपि च । निषादशूद्रयोः पुत्रे" - हेम० ।<br><br>

कुक्कुटमण्डप
कुक्कुटमण्डप<br><br><b>कन्नडार्थः - </b>ಕಾಶಿಯಲ್ಲಿರುವ ಒಂದು ಪವಿತ್ರ ಸ್ಥಳ<br><br>

कुक्कुटव्रत
कुक्कुटव्रत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭಾದ್ರಪದ ಶುಕ್ಲ ಸಪ್ತಮಿಯ ದಿನ ಮಾಡಬೇಕಾದ ಒಂದು ವ್ರತ<br><b>प्रयोगाः - </b>"भाद्रे मासि सिते पक्षे सप्तम्यां नियमेन च । स्नात्वा शिवं लेखयित्वा मण्डलेन सहाम्बिकम् । पूजयेच्च तदा तस्या दुष्प्रापं नैव विद्यते ॥"<br><br>

कुक्कुटशिख
कुक्कुटशिख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಸುಂಬೆ ಗಿಡ<br><b>व्युत्पत्तिः - </b>कुक्कुटस्य शिखेव शिखाऽस्य<br><br>

कुक्कुटाण्ड
कुक्कुटाण्ड<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಳಿಯ ಮೊಟ್ಟೆ<br><b>निष्पत्तिः - </b>कुक्कुट्याः पुंवद्भावः (६-३-३५)<br><b>व्युत्पत्तिः - </b>कुक्कुट्या अण्डम्<br><br>

कुक्कुटासन
कुक्कुटासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯೋಗಾಸನಗಳಲ್ಲೊಂದು ಭೇದ<br><b>विस्तारः - </b>"निजहस्तद्वयं भूमौ पातयित्वा जितेन्द्रियः । पद्भ्यां बद्धं यत्करोति कूर्परद्वयमध्यगम् । सव्यापसव्ययुगलं कुक्कुटासनमुच्यते ॥"<br><br>

कुक्कुभ
कुक्कुभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಕೋಳಿ<br><b>निष्पत्तिः - </b>कु (शब्दे) - "भक्" बाहु० । भाष (व्यक्तायां वाचि) - "डः" (३-२-१०१) इति वा ।<br><b>व्युत्पत्तिः - </b>कुक् इति कौति अव्यक्तशब्दं करोति । कुक्कु शब्दं भाषते ।<br><br>

कुक्कुरी
कुक्कुरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ನಾಯಿ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

कुक्ष
कुक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದರ /ಜಠರ /ಹೊಟ್ಟೆ<br><b>निष्पत्तिः - </b>कुष (निष्कर्षे) - "सः" (उ० ३-६८) । षस्य कः (८-२-४१)<br><b>विस्तारः - </b>"कुक्षो जठरम्" - सि० कौ० ।<br><br>

कुक्षि
कुक्षि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದರ /ಜಠರ /ಹೊಟ್ಟೆ<br><b>निष्पत्तिः - </b>कुष (निष्कर्षे) - "क्सिः" (उ० ३-११५)<br><b>व्युत्पत्तिः - </b>कुष्यते निष्कास्यते मलोऽस्मात्<br><b>प्रयोगाः - </b>"विपुलेन सागरशयस्य कुक्षिणा भुवनानि यस्य पपिरे युगक्षये"<br><b>उल्लेखाः - </b>माघ० १३-४०<br><br>कुक्षि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ಭಾಶಯ<br><b>प्रयोगाः - </b>"विभक्तात्मा विभुस्तासामेकः कुक्षिष्वनेकधा"<br><b>उल्लेखाः - </b>रघु० १०-६५<br><br>कुक्षि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಹೆ /ಗವಿ<br><b>प्रयोगाः - </b>"तदा प्रभृत्येव वनद्विपानां त्रासार्थमस्मिन्नहमद्रिकुक्षौ"<br><b>उल्लेखाः - </b>रघु० २-३८<br><br>कुक्षि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಸ್ತುವಿನ ಅಥವಾ ಪ್ರದೇಶದ ಮಧ್ಯಭಾಗ<br><b>प्रयोगाः - </b>"ततः सागरमासाद्य कुक्षौ तस्य महोर्मिणः"<br><b>उल्लेखाः - </b>भा० वन०<br><br>कुक्षि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಕ್ಷ್ವಾಕುರಾಜನ ಮಗ /ವಿಕುಕ್ಷಿಯ ತಂದೆ<br><br>कुक्षि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲಿ ಚಕ್ರವರ್ತಿ<br><br>

कुक्षिज
कुक्षिज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಔರಸ ಪುತ್ರ /ಹೊಟ್ಟೆಯಲ್ಲಿ ಹುಟ್ಟಿದ ಮಗ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९७)<br><b>व्युत्पत्तिः - </b>कुक्षौ जातः<br><br>कुक्षिज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೊಟ್ಟೆಯಲ್ಲಿ ಹುಟ್ಟಿದ /ಹೊಟ್ಟೆಯಲ್ಲಿ ಉಂಟಾದ<br><b>प्रयोगाः - </b>"स च प्राप मधूपघ्नं कुम्भीनस्याश्च कुक्षिजः"<br><b>उल्लेखाः - </b>रघु० १५-१५<br><br>

कुक्षिम्भरि
कुक्षिम्भरि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನ ಹೊಟ್ಟೆಯನ್ನು ಮಾತ್ರ ತುಂಬಿಕೊಳ್ಳುವವನು /ಲೋಭಿ /ಜಿಪುಣ<br><b>निष्पत्तिः - </b>डुभृञ् (धारणपोषणयोः) - "इन्" मुम् च (३-२-२६) निपा० ।<br><b>व्युत्पत्तिः - </b>कुक्षिं बिभर्ति<br><br>

कुक्षिशूल
कुक्षिशूल<br><br><b>कन्नडार्थः - </b>ಉದರ ಶೂಲೆ /ಹೊಟ್ಟೆನೋವು /ವಾತದಿಂದ ಆಮಶೂಲೆಯುಂಟಾಗಿ ಬರುವ ಹೊಟ್ಟೆನೋವು<br><b>प्रयोगाः - </b>"प्रकुप्यति यदा कुक्षौ वह्निमाक्रम्य मारुतः । तदास्य भोजनं भुक्तं सोपष्टम्भं न पच्यते । उच्छ्वसित्यामशकृता शूलेनाहन्यते मुहुः । नैवासने न शयने तिष्ठन्न लभते सुखम् । कुक्षिशूल इति ख्यातो वातादामसमुद्भवः ॥"<br><b>उल्लेखाः - </b>सुश्रुत० उत्तर० ४२-१२३, १२<br><br>

कुखनख
कुखनख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಷಕ /ಇಲಿ<br><b>व्युत्पत्तिः - </b>कोः भूमेः खनकः<br><br>कुखनख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರಾಹ /ಹಂದಿ<br><br>

कुग्रह
कुग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಗ್ರಹ /ಪಾಪ ಗ್ರಹ /ರವಿ, ಕುಜ,ಶನಿ,ರಾಹು ಮತ್ತು ಕೇತು<br><br>

कुग्राम
कुग्राम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಗ್ರಾಮ /ವಾಸ ಮಾಡಲು ಸೌಕರ್ಯವಿಲ್ಲದ ಗ್ರಾಮ<br><b>विस्तारः - </b>ರಾಜ, ಅಗ್ನಿಹೋತ್ರಿ, ವೈದ್ಯ, ಧನಿಕ ಮತ್ತು ನದಿ ಇವುಗಳ ಸೌಕರ್ಯವಿಲ್ಲದಿದ್ದಲ್ಲಿ ಆ ಗ್ರಾಮವು ವಾಸಾನರ್ಹವಾಗುವುದು.<br><br>

कुङ्|शब्दे|कुवते
कुङ् - शब्दे (तुदा० आत्म० अक० अनि०) कुवते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಶಬ್ದ ಮಾಡುವುದು<br><br>

कुङ्कुम
कुङ्कुम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶ್ಮೀರದೇಶದಲ್ಲಿ ಹುಟ್ಟಿದ ಕುಂಕುಮಕೇಸರಿ<br><b>निष्पत्तिः - </b>कुक (आदाने)- "उमच्" बाहु० ।<br><b>व्युत्पत्तिः - </b>कुक्यते<br><b>प्रयोगाः - </b>"कुङ्कुमपङ्ककलङ्कितदेहा गौरपयोधरकम्पितहारा । नूपुरहंसरणत्पदपद्मा कं न वशीकुरुते भुवि रामा ॥"<br><b>उल्लेखाः - </b>भर्तृ० २-९<br><br>कुङ्कुम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಕುಮ /ಹೆಂಗಸರು ಹಣೆಗೆ ಇಟ್ಟುಕೊಳ್ಳುವ ಒಂದು ಮಂಗಳ ವಸ್ತು<br><br>

कुङ्कुमाद्रि
कुङ्कुमाद्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶ್ಮೀರದಲ್ಲಿ ಕುಂಕುಮಕೇಸರಿಗೆ ಸ್ಥಾನವಾದ ಒಂದು ಪರ್ವತ<br><br>

कुच|शब्दे|कोचति
कुच - शब्दे तारे (भ्वा० पर० अक० से०) कोचति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಗಟ್ಟಿಯಾಗಿ ಶಬ್ದ ಮಾಡು<br><br>

कुच|सम्पर्चन|कोचति
कुच - सम्पर्चन प्रतिष्टम्भ-विलेखनेषु (भ्वा०पर० सक० से०) कोचति<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಂಪರ್ಕ ಹೊಂದು /ಬೆರೆ /ಜೊತೆಯಲ್ಲಿ ಸೇರು<br><br>कुच - सम्पर्चन प्रतिष्टम्भ-विलेखनेषु (भ्वा०पर० सक० से०) कोचति<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ವಕ್ರವಾಗು /ಬಗ್ಗು<br><br>कुच - सम्पर्चन प्रतिष्टम्भ-विलेखनेषु (भ्वा०पर० सक० से०) कोचति<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ತಡೆ /ಅಡ್ಡಿ ಪಡಿಸು<br><br>कुच - सम्पर्चन प्रतिष्टम्भ-विलेखनेषु (भ्वा०पर० सक० से०) कोचति<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಗೆರೆ ಹಾಕು /ಬರೆ<br><br>

कुच|सङ्कोचने|कुचति
कुच - सङ्कोचने (तुदा० पर० अक० से) कुचति<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಂಕೋಚ ಹೊಂದು /ಹಿಂದಕ್ಕೆ ಎಳೆದುಕೋ<br><br>

कुच
कुच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತನ /ಮೊಲೆ<br><b>निष्पत्तिः - </b>कुच (सङ्कोचने) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>कुचति<br><b>प्रयोगाः - </b>"पुंसां रोमराजिश्मश्रुप्रभृतयः नारीणां रोमराजीस्तनार्तवादयः" । "उपनेतुमुन्नतिमतेव दिवं कुचयोर्युगेन तरसाऽकलिताम्"<br><b>उल्लेखाः - </b>२)माघ० ९-७२<br><b>विस्तारः - </b>"पुरुषाणां मुकुले गन्धो यथा सन्नपि नाप्यथ । तेषां तदेव तारुण्ये पुष्टत्वात् व्यक्तिमेति च ॥ रोमराज्यादयः पुंसां नारीणामपि यौवने" - भावप्र०<br><br>

कुचतट
कुचतट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತನ ಪ್ರದೇಶ /ಮೊಲೆಯ ಮೇಲುಭಾಗ<br><b>व्युत्पत्तिः - </b>कुचयोस्तटम्<br><b>प्रयोगाः - </b>"आहतं कुचतटेन तरुण्याः साधु सोढममुनेति पपात । त्रुट्यतः प्रियतमोरसि हारात् पुष्पवृष्टिरिव मौक्तिकवृष्टिः ॥"<br><b>उल्लेखाः - </b>माघ० १०-७४<br><br>कुचतट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಲೆಯ ಒಂದು ಭಾಗ<br><br>

कुचन्दन
कुचन्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಪು ಚಂದನ<br><b>व्युत्पत्तिः - </b>गन्धरहितत्वात् कुत्सितं चन्दनम्<br><br>कुचन्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಕುಮಕೇಸರಿ<br><br>

कुचफल
कुचफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಾಳಿಂಬೆ ಗಿಡ<br><b>व्युत्पत्तिः - </b>कुच इव फलमस्य<br><br>कुचफल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಾಳಿಂಬೆ ಹಣ್ಣು<br><b>व्युत्पत्तिः - </b>कुच इव फलम्<br><br>

कुचर
कुचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರದೂಷಕ /ಇತರರನ್ನು ದೂಷಿಸುವವನು /ಇತರರ ದೋಷವನ್ನು ಎತ್ತಿ ಹೇಳುವವನು /ನೀಚ ಸ್ವಭಾವದವನು<br><b>निष्पत्तिः - </b>चर (गतिभक्षणयोः) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुत्सितं चरति<br><br>कुचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಷ್ಟದ ದಾರಿಯಲ್ಲಿ ನಡೆಯುವ<br><b>निष्पत्तिः - </b>चर - "टः" (३-२-१६)<br><b>व्युत्पत्तिः - </b>कुत्सिते मार्गे चरति<br><br>कुचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೂಮಿಯಲ್ಲಿ ನಡೆಯುವ<br><b>निष्पत्तिः - </b>चर - "टः" (३-२-१६)<br><b>व्युत्पत्तिः - </b>कौ भूमौ चरति<br><br>

कुचरी
कुचरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कुचर ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

कुचरित
कुचरित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ನಡತೆ /ಕೆಟ್ಟ ಸ್ವಭಾವ<br><b>व्युत्पत्तिः - </b>कुत्सितं चरितम्<br><br>

कुचर्या
कुचर्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ನಡತೆ /ಕೆಟ್ಟ ಸ್ವಭಾವ<br><b>व्युत्पत्तिः - </b>कुत्सिता चर्या<br><b>प्रयोगाः - </b>"द्रोहभावं कुचर्यां च स्त्रीभ्यो मनुरकल्पयत्"<br><b>उल्लेखाः - </b>मनु० ९-१७<br><br>

कुचाग्र
कुचाग्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚೂಚಕ /ಮೊಲೆಯ ತೊಟ್ಟು<br><b>व्युत्पत्तिः - </b>कुचस्याग्रम्<br><br>

कुचाङ्गेरी
कुचाङ्गेरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹುಳಿಹಬ್ಬೆ ಗಿಡ<br><b>व्युत्पत्तिः - </b>कुत्सिता चाङ्गेरी<br><br>

कुचिक
कुचिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಮೀನು<br><b>निष्पत्तिः - </b>कुच (सम्पर्चनादौ) - "इकन्" बाहु० ।<br><br>कुचिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶಾನ್ಯ ದಿಕ್ಕಿನಲ್ಲಿಉವ ಒಂದು ದೇಶ<br><b>प्रयोगाः - </b>"भल्लापलोलजटासुरकुनठखसघोषकुचिकाख्याः"<br><br>

कुचित
कुचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕದಾದ /ಪರಿಮಿತವಾದ /ಕೊಂಚವಾದ<br><b>निष्पत्तिः - </b>कुच (सङ्कोचने) - "कितच्" (उ० ४-१८५)<br><br>कुचित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಿಶ್ರವಾದ /ಬೆರೆಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कुच (सम्पर्चनादौ) - "क्तः" (३-२-१०२)<br><br>

कुचेल
कुचेल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಬ್ರಾಹ್ಮಣ /ಸುಧಾಮನೆಂಬ ಹೆಸರುಳ್ಳ ಶ್ರೀಕೃಷ್ಣನ ಒಬ್ಬ ಮಿತ್ರ<br><b>व्युत्पत्तिः - </b>कुत्सितं चेलं वस्त्रमस्य<br><br>कुचेल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹರಕು ಬಟ್ಟೆ /ಜೂಲು ಬಟ್ಟೆ /ಛಿಂದಿ ಬಟ್ಟೆ<br><br>कुचेल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹರಕು ಬಟ್ಟೆಯನ್ನು ಉಟ್ಟಿರುವ<br><br>

कुचेला
कुचेला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗುರು ಶುಂಠಿ<br><br>

कुचोद्य
कुचोद्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಂಗತವಾದ ಪ್ರಶ್ನೆ /ಯುಕ್ತವಲ್ಲದ ಕೇಳಿಕೆ<br><b>व्युत्पत्तिः - </b>कुत्सितं चोद्यम्<br><br>

कुज
कुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿಯ ಪುತ್ರನಾದ ಅಂಗಾರಕ /ಕುಜಗ್ರಹ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>कोः पृथिव्यां जायते<br><br>कुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನರಕಾಸುರ<br><br>कुज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರ /ವೃಕ್ಷ<br><br>

कुजा
कुजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೀತಾದೇವಿ<br><br>कुजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾತ್ಯಾಯನಿ /ದುರ್ಗಾದೇವಿ<br><b>विस्तारः - </b>"कुजा कात्यायनीदेव्यां कुजो नरकभौमयोः" - मेदि० ।<br><br>

कुजदिन
कुजदिन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಜಗ್ರಹದ ದಿನ /ಮಂಗಳವಾರ<br><b>व्युत्पत्तिः - </b>कुजस्य दिनम्<br><br>

कुजजनी
कुजजनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ತಾಯಿ<br><b>व्युत्पत्तिः - </b>कुत्सिता जननी<br><br>

कुजन्मन्
कुजन्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿಯ ಪುತ್ರನಾದ ಅಂಗಾರಕ ಗ್ರಹ<br><b>व्युत्पत्तिः - </b>कोः जन्म यस्य<br><br>कुजन्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೀಳು ಜನ್ಮ /ಕಡಿಮೆ ಗುಣದ ಹುಟ್ಟು<br><b>व्युत्पत्तिः - </b>कुत्सितं जन्म<br><br>कुजन्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೀಳು ಜನ್ಮದ<br><b>व्युत्पत्तिः - </b>कुत्सितं जन्म यस्य<br><br>

कुजप
कुजप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಜಪ /ಕೆಟ್ಟ ಉದ್ದೇಶದಿಂದ ಮಾಡುವ ಜಪ<br><br>कुजप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಮಾತು /ಅಯೋಗ್ಯವಾದ ಮಾತು<br><br>कुजप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಜಪವನ್ನು ಮಾಡುವ<br><br>कुजप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಮಾತನಾಡುವ<br><br>

कुजम्भ
कुजम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಹ್ಲಾದನ ಒಬ್ಬ ಮಗ<br><b>प्रयोगाः - </b>"प्रह्लादस्य त्रयः पुत्राः विक्रान्ताश्च महाबलाः । विरोचनश्च जम्भश्च कुजम्भश्चेति विश्रुताः ॥"<br><b>उल्लेखाः - </b>हरिवं०<br><br>कुजम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂದವಿಲ್ಲದ ಹಲ್ಲು<br><br>कुजम्भ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಂದವಿಲ್ಲದ ಹಲ್ಲುಗಳುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कुत्सिता जम्भा दन्ता यस्य<br><b>विस्तारः - </b>"जम्भो दत्यविशेषे ना दन्ते" - मेदि० ।<br><br>

कुजम्भल
कुजम्भल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆಗೆ ಕನ್ನ ಕೊರೆಯುವ ಕಳ್ಳ<br><br>

कुजाष्टम
कुजाष्टम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಹೂರ್ತಲಗ್ನದಿಂದ ೮ ನೆಯ ಸ್ಥಾನದಲ್ಲಿ ಕುಜನಿರುವುದರಿಂದ ಉಂಟಾಗುವ ಒಂದು ದೋಷ<br><b>प्रयोगाः - </b>"अस्तगे नीचगे भौमे शत्रुक्षेत्रगतेऽपि च । कुजाष्टमोद्भवो दोषो न किञ्चिदपि विद्यते ॥"<br><br>

कुज्जिश
कुज्जिश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಮೀನು<br><b>प्रयोगाः - </b>"कुज्जिशो मधुरो हृद्यः कषायो दीपनस्तथा । बल्यः स्निग्धो गुरुग्राही वातकृत् रोचनो मतः ॥"<br><b>उल्लेखाः - </b>राजनि०<br><br>

कुज्झटि
कुज्झटि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಬ್ಬನಿ /ಮಂಜು<br><b>निष्पत्तिः - </b>वा "ङीष्" (ग० ४-१-४५)<br><b>विस्तारः - </b>"कुज्झटिर्धूममहिषी रतान्ध्री च कुहेलिका" - त्रिकाण्ड० ।<br><br>

कुज्झटी
कुज्झटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಬ್ಬನಿ /ಮಂಜು<br><b>निष्पत्तिः - </b>स्वार्थे "कः"<br><br>

कुज्झटिका
कुज्झटिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಬ್ಬನಿ /ಮಂಜು<br><b>विस्तारः - </b>"ज्ञेया कुज्झटिका रूक्षा तमःप्राया च सा तथा । कफपित्तकरी लोके भिषग्भिः परिकीर्तिता ॥"<br><br>

कुञ्च|कौटिल्याल्पीभावयोः|कुञ्चति
कुञ्च - कौटिल्याल्पीभावयोः (भ्वा० पर० सक० से०) कुञ्चति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿಸು /ವಕ್ರವಾಗಿ ಮಾಡು<br><br>कुञ्च - कौटिल्याल्पीभावयोः (भ्वा० पर० सक० से०) कुञ्चति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಗುಂಗುರು ಗುಂಗುರಾಗಿ ಮಾಡು /ಸುರುಳಿ ಸುತ್ತು /ತಿರುಚಿ ಚಿಕ್ಕದಾಗಿ ಮಾಡು<br><br>

कुञ्चत्
कुञ्चत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗುತ್ತಿರುವ /ಡೊಂಕಾಗುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कुञ्ज (कौटिल्ये) - "शतृ" (३-२-१२४)<br><br>कुञ्चत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಡಮೆಯಾಗುತ್ತಿರುವ /ಚಿಕ್ಕದಾಗುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कुञ्ज (अल्पीभावे) - "शतृ" (३-२-१२४)<br><br>

कुञ्चन्ती
कुञ्चन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कुञ्चत् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कुञ्चन
कुञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಗ್ಗುವುದು /ಡೊಂಕಾಗುವುದು<br><b>निष्पत्तिः - </b>कुञ्ज (कौटिल्ये) - "ल्युट्" (३-३-११५)<br><br>कुञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕದಾಗುವುದು /ಕಡಮೆಯಾಗುವುದು /ಸಣ್ಣದಾಗುವುದು<br><b>निष्पत्तिः - </b>कुञ्ज (अल्पीभावे) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"कुर्यात् सिरागतः शूलं सिराकुञ्जनपूरणम्"<br><b>उल्लेखाः - </b>सुश्रुत० निदान० १-२७<br><br>कुञ्चन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧವಾದ ನೇತ್ರರೋಗ<br><b>विस्तारः - </b>"वाताद्य वर्त्म सङ्कोच्य जनयन्ति यदा मलम् । तदा द्रष्टुं न शक्नोति कुञ्चनं नाम तद्विदुः ॥"<br><br>

कुञ्चयत्
कुञ्चयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿಸುತ್ತಿರುವ /ಡೊಂಕುಮಾಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कुञ्ज (कौटिल्ये) + णिच् - "शतृ" (३-२-१२४)<br><br>कुञ्चयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಡಮೆ ಮಾಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कुञ्ज (अल्पीभावे) + णिच् - "शतृ" (३-२-१२४)<br><br>

कुञ्चयन्ती
कुञ्चयन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कुञ्चयत् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कुञ्चा
कुञ्चा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೀಗದ ಕೈ<br><b>निष्पत्तिः - </b>कुञ्च (कौटिल्याल्पीभावयोः) - "अः" (३-३-१०३)<br><br>

कुञ्चि
कुञ्चि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಷ್ಟಮುಷ್ಟಿ /೮ ಹಿಡಿ ಅಳತೆ<br><b>निष्पत्तिः - </b>कुञ्च (कौटिल्याल्पीभावयोः) - "इन्" (उ० ४-११७)<br><b>विस्तारः - </b>"अष्टमुष्टिर्भवेत् कुञ्चिः कुञ्चयोष्टौ च पुष्कलम्"<br><br>

कुञ्चिका
कुञ्चिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೀಗದ ಕೈ<br><br>कुञ्चिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಮೀನು<br><br>कुञ्चिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಲಗಂಜಿ<br><br>कुञ्चिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿದಿರಿನ ಚಿಗುರು<br><br>कुञ्चिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಸರಿನಲ್ಲಿರುವ ಎರುಬು ಹುಳು<br><b>निष्पत्तिः - </b>कुञ्च (कौटिल्याल्पीभावयोः) - "ण्वुल्" (३-१-१३३)<br><b>प्रयोगाः - </b>"कुञ्चिकयैनं भाययति"<br><br>

कुञ्चित
कुञ्चित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಗರಪುಷ್ಪ<br><br>कुञ्चित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿಸಲ್ಪಟ್ಟ /ವಕ್ರವಾಗಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कुञ्च (कौटिल्ये) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"कृतार्थनश्चाटुभिरिङ्गितैः पुरा परासि यः किञ्चनकुञ्चितभ्रुवा"<br><b>उल्लेखाः - </b>नैष० १६-८८<br><br>कुञ्चित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕದಾಗಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कुञ्च (अल्पीभावे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"भ्रूचातुर्यात्कुञ्चिताक्षाः कटाक्षाः स्निग्धा वाचो लज्जितन्ताश्च हासाः"<br><b>उल्लेखाः - </b>भर्तृ० २-३<br><br>

कुञ्च्यमान
कुञ्च्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿಸಲ್ಪಡುತ್ತಿರುವ /ಡೊಂಕಾಗಿ ಮಾದಲ್ಪಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कुञ्च (कौटिल्ये) - कर्म० "शानच्" (३-२-१२४)<br><br>कुञ्च्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕದಾಗಿ ಮಾದಲ್ಪಡುತ್ತಿರುವ /ಕಡಮೆಯಾಗಿ ಮಾಡಲ್ಪಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कुञ्च (अल्पीभावे) - कर्म० "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"कुञ्च्यमानं रुजार्थं वा गात्रं स्तब्धमथापि वा"<br><b>उल्लेखाः - </b>सुश्रुत० चिकित्सा० ४-१६<br><br>

कुञ्ज
कुञ्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲತೆಗಳ ಪೊದರು /ಬಳ್ಳಿಗಳಿಂದ ಆವೃತವಾದ ಸ್ಥಳ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९७)<br><b>व्युत्पत्तिः - </b>कौ जायते<br><b>प्रयोगाः - </b>"निर्घातोग्रैः कुञ्चलीनाञ्जिघांसुः ज्यानिर्घोषैः क्षोभयामास सिंहान्"<br><b>उल्लेखाः - </b>रघु० ९-६४<br><br>कुञ्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ದವಡೆ<br><br>कुञ्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ದಂತ<br><b>विस्तारः - </b>"कुञ्जोऽस्त्रियां निकुञ्जेऽपि हनौ दन्तेऽपि हस्तिनाम्" - मेदि० ।<br><br>कुञ्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗವಿ /ಗುಹೆ<br><b>प्रयोगाः - </b>"वृत्तं युद्धे शूलमाश्लिष्य काचित् रन्तुं तूर्णं मेरुकुञ्जं जगाम"<br><b>उल्लेखाः - </b>माघ० १९-६०<br><br>

कुञ्जकुटीर
कुञ्जकुटीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲತಾಗೃಹ /ಲತೆಗಳಿಂದ ನಿರ್ಮಿತವಾದ ಮನೆ<br><b>प्रयोगाः - </b>"गुञ्जत्कुञ्जकुटीरकौशिकघटाघूत्कारसंवेल्लितम्"<br><b>उल्लेखाः - </b>मालती० ५-१९<br><br>

कुञ्जर
कुञ्जर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಜ /ಆನೆ<br><b>निष्पत्तिः - </b>कुञ्ज - "रः" (५-२-१०७)<br><b>व्युत्पत्तिः - </b>कुञ्ञः प्रशस्तो हनुः दन्तो वाऽस्य<br><b>प्रयोगाः - </b>"अद्रीन्द्रकुञ्जचरकुञ्जरगण्डकाषसङ्क्रान्तदानपयसो वनपादपस्य"<br><b>उल्लेखाः - </b>माघ० ५-४३<br><br>कुञ्जर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಶ /ಕೂದಲು<br><br>कुञ्जर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೮ ಸಂಖ್ಯೆ<br><b>विस्तारः - </b>"कुञ्ञरोऽनेकपे केशे" - मेदि० ।<br><br>कुञ्जर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>(ಸಮಾಸದಲ್ಲಿ ಉತ್ತರಪದವಾದರೆ) ಶ್ರೇಷ್ಠವಾದ<br><b>विस्तारः - </b>राजकुञ्जरः, कपिकुञ्जरः ।<br><br>

कुञ्जरा
कुञ्जरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮರಾಟಿಮೊಗ್ಗು<br><br>कुञ्जरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸುರು ಪಾದರಿ ಗಿಡ<br><br>कुञ्जरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮರಾಟಿಮೊಗ್ಗು<br><br>कुञ्जरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸುರು ಪಾದರಿ ಗಿಡ<br><br>कुञ्जरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಆನೆ<br><b>निष्पत्तिः - </b>अजादि - "टाप्" (४-१-४) ।<br><br>

कुञ्जरत्व
कुञ्जरत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯಾಗಿರುವಿಕೆ /ಗಜರೂಪವನ್ನು ತಾಳುವಿಕೆ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कुञ्जरस्य भावः<br><br>

कुञ्जरपिप्पली
कुञ्जरपिप्पली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಜ ಹಿಪ್ಪಲಿ<br><br>

कुञ्जरी
कुञ्जरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಆನೆ<br><b>निष्पत्तिः - </b>जाति० "ङीष्" (४-१-६३)<br><br>

कुञ्जराराति
कुञ्जराराति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶರಭಮೃಗ<br><br>कुञ्जराराति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಿಂಹ<br><b>व्युत्पत्तिः - </b>कुञ्जरस्यारातिः<br><br>

कुञ्जराशन
कुञ्जराशन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವತ್ಥವೃಕ್ಷ /ಅರಳಿ ಮರ<br><b>निष्पत्तिः - </b>अश (भोजने) - "ल्युट्" (३-३-११३)<br><b>व्युत्पत्तिः - </b>कुञ्जरैरश्यते<br><b>विस्तारः - </b>"बोधिद्रुमश्चलदलः पिप्पलः कुञ्जराशनः" - अम० ।<br><br>

कुञ्जरासन
कुञ्जरासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯಂತೆ ನಿಂತು ಹಾಕುವ ಒಂದು ಆಸನ<br><b>व्युत्पत्तिः - </b>कुञ्जरस्येवासनमत्र<br><b>प्रयोगाः - </b>"अथ वक्ष्ये महाकाल कुञ्जरासनमुत्तमम् । करद्वयेन पादाभ्यां भूमौ तिष्ठेत् शिरःकरः ॥"<br><br>

कुञ्जल
कुञ्जल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಜಿ /ಅಂಬಲಿ<br><b>निष्पत्तिः - </b>पृषो० ।<br><b>व्युत्पत्तिः - </b>कुत्सितं जलं यत्र<br><br>

कुट|कौटिल्ये|कुटति
कुट - कौटिल्ये (तुदा० पर० अक० से०) कुटति<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ವಕ್ರವಾಗು /ಬಗ್ಗು<br><br>

कुट
कुट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಟೆ /ದುರ್ಗ<br><br>कुट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಡ /ಬಿಂದಿಗೆ<br><br>कुट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹ /ಮನೆ<br><b>निष्पत्तिः - </b>कुट (कौटिल्ये) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>कुटति<br><br>कुट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತ /ಬೆಟ್ಟ<br><br>कुट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೃಕ್ಷ /ಮರ<br><b>विस्तारः - </b>"अनोकहः कुटः सालः पलाशी द्रुद्रुमागमाः" - अम० ।<br><br>कुट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಕಲ್ಲುಗಳನ್ನು ಚೂರು ಮಾಡುವ ಸುತ್ತಿಗೆ /ಚಮ್ಮಟಿಗೆ<br><b>विस्तारः - </b>"कुटः कोटे पुमानस्त्री घटे स्त्रीपुंसयोर्गृहे" - मेदि० । "कुटः कोटे शिलाकुट्टे घटे गेहे"- हेम० ।<br><br>

कुटक
कुटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣದಲ್ಲಿರುವ ಒಂದು ದೇಶ<br><b>प्रयोगाः - </b>"चङ्क्रममाणः कोङ्कवेङ्कटकुटकान् दक्षिणकर्णाटकान् देशान् यदृच्छयोपगतः कुटकाचलोवने"<br><b>उल्लेखाः - </b>भाग० ५-३-७<br><br>कुटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಟಕದೇಶದ ಜನರು<br><br>कुटक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಈಚು ಇಲ್ಲದ ನೇಗಿಲು /ದಂದರಹಿತವಾದ ಲಾಂಗಲ<br><br>

कुटकाचल
कुटकाचल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಟಕ ದೇಶದ ಒಂದು ಪರ್ವತ<br><br>

कुण्टक
कुण्टक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆಯ ಛಾವಣಿ<br><b>निष्पत्तिः - </b>टकि (आच्छादने) - कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>कुः गृहभूमिः टङ्क्यते आच्छाद्यतेऽनेन<br><br>कुण्टक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಂಡಾದ ಚೂಪಿಲ್ಲದ ಉಳಿ<br><b>व्युत्पत्तिः - </b>कुत्सितः टङ्कः<br><br>

कुटङ्गक
कुटङ्गक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಲ್ಲು ಸೊಪ್ಪು ಹೊದಿಸಿರುವ ಮನೆ<br><b>निष्पत्तिः - </b>इवार्थे "कन्" (५-३-९६)<br><b>व्युत्पत्तिः - </b>कुटस्याङ्गमिव<br><br>

कुटज
कुटज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಟ್ಟಮಲ್ಲಿಗೆ ಗಿಡ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९७)<br><b>व्युत्पत्तिः - </b>कुटे पर्वते जायते<br><br>कुटज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಭದಲ್ಲಿ ಹುಟ್ಟಿದ ೧)ದ್ರೋಣಾಚಾರ್ಯರು ೨)ಅಗಸ್ತ್ಯ ಮಹರ್ಷಿ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९७)<br><b>व्युत्पत्तिः - </b>कुटे घटे जायते<br><br>कुटज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಟ್ಟಮಲ್ಲಿಗೆ ಹೂವು<br><b>प्रयोगाः - </b>"कुटजानि वीक्ष्य शिखिभिः शिखरीन्द्रं समयावनौ घनमदभ्रमराणि"<br><b>उल्लेखाः - </b>माघ० ६-७३<br><br>

कुटजपुटपाक
कुटजपुटपाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಸಾರ ರೋಗವನ್ನು ವಾಸಿಮಾಡುವ ಒಂದು ಔಷಧ<br><br>

कुटजरस
कुटजरस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಲವ್ಯಾಧಿಯನ್ನು ಗುಣಪಡಿಸುವ ಒಂದು ಕಷಾಯ<br><br>

कुटजलेह
कुटजलेह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಸಾರವನ್ನು ಹೋಗಲಾಡಿಸುವ ಒಂದು ಲೇಹ್ಯ<br><br>

कुटत्
कुटत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಗ್ಗುತ್ತಿರುವ /ಡೊಂಕಾಗುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कुट (कौटिल्ये) - "शतृ" (३-२-१२४)<br><br>

कुटन्ती
कुटन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಗ್ಗುತ್ತಿರುವ /ಡೊಂಕಾಗುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कुटन
कुटन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಗ್ಗುವುದು /ಡೊಂಕಾಗುವುದು /ವಕ್ರವಾಗುವುದು<br><b>निष्पत्तिः - </b>कुट (कौटिल्ये) - भावे "ल्युट्" (३-३-११५)<br><br>

कुटन्नट
कुटन्नट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಮ್ಮರ /ತಿಗಡೆ ಮರ<br><br>कुटन्नट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಕೊನ್ನಾರಿಗೆಡ್ಡೆ /ತುಂಗಮುಸ್ತೆ<br><b>व्युत्पत्तिः - </b>कुटन् सन् नटति<br><br>

कुटप
कुटप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುನಿ /ಋಷಿ<br><b>निष्पत्तिः - </b>कुट (कौटिल्ये) - "कपन्" (उ० ३-१४२)<br><br>कुटप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಅಳತೆಯ ಪಾತ್ರೆ /ಇಕ್ಕೊಳದ ಒಂದು ಅಳತೆ<br><br>कुटप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದ್ಯಾನವನ<br><b>विस्तारः - </b>"अथ कुटपो मुनौ । निष्कुटे मानभेदे च" - हेम० ।<br><br>

कुटर
कुटर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಡಗೋಲಿನ ಹಗ್ಗವನ್ನು ಕಟ್ಟುವ ಕಂಬ /ಮೊಸರು ಕಡೆಯುವ ಕಂಬ<br><b>निष्पत्तिः - </b>कुट (कौटिल्ये) - "करन्" बाहु० ।<br><br>

कुटरु
कुटरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಟ್ಟೆಯ ಮನೆ /ಡೇರೆ<br><b>निष्पत्तिः - </b>कुट (कौटिल्ये) - "अरुः" (उ० ४-८०)<br><br>

कुटहारिका
कुटहारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೇವಕಿ /ದಾಸಿ /ಹೆಣ್ಣಾಳು<br><b>निष्पत्तिः - </b>हृञ् (हरणे) - "ण्वुल्" (३-१-१३३) । "टाप्" (४-१-४)<br><b>व्युत्पत्तिः - </b>कुटं घटं हरति जलाहरणार्थं गृह्णाति<br><br>

कुटि
कुटि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹ /ಮನೆ<br><b>निष्पत्तिः - </b>कुट (कौटिल्ये) - "इन्" (उ० ४-११७)<br><b>व्युत्पत्तिः - </b>कुटति कुटलीभवति<br><br>कुटि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಕ್ರವಾಗಿರುವಿಕೆ /ಬಗ್ಗಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"बभ्रुकुटीकुटिलात् तस्याः"<br><br>कुटि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಗ್ಗಿರುವ /ಡೊಂಕಾಗಿರುವ<br><br>

कुटी
कुटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹ /ಮನೆ<br><b>निष्पत्तिः - </b>वा "ङीष्" (ग० ४-१-४५)<br><b>प्रयोगाः - </b>"ब्रह्महा द्वादशसमाः कुटी कृत्वा वने वसेत्"<br><b>उल्लेखाः - </b>मनु० ११-७२<br><br>

कुटिका
कुटिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಮನೆ /ಗುಡಿಸಲು /ಕ್ಷುದ್ರಗೃಹ<br><b>निष्पत्तिः - </b>कुट - अल्पार्थे "कन्" (५-३-८५)<br><br>

कुटिचर
कुटिचर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ಹಂದಿ<br><br>कुटिचर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಸಳೆ<br><b>निष्पत्तिः - </b>चर (गतुभक्षणयोः) - "टः" (३-२-१६)<br><b>व्युत्पत्तिः - </b>कुटि कुटिलं चरति<br><br>

कुटित
कुटित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಕ್ರವಾಗಿರುವಿಕೆ /ಬಗ್ಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>कुट (कौटिल्ये) - भावे "क्तः" (३-३-११४)<br><br>कुटित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಕ್ರವಾಗಿರುವ /ಡೊಂಕಾಗಿರುವ<br><b>निष्पत्तिः - </b>कुट (कौटिल्ये) - कर्म० "क्तः" (३-२-१०२)<br><br>

कुटिर
कुटिर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಮನೆ /ಗುಡಿಸಲು /ಕ್ಷುದ್ರಗೃಹ<br><br>

कुटिल
कुटिल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಗರ ಪುಷ್ಪ<br><br>कुटिल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಕ್ರವಾಗಿರುವ /ಡೊಂಕಾಗಿರುವ<br><b>निष्पत्तिः - </b>कुट (कौटिल्ये) - "इलच्" (उ० १-५७)<br><br>कुटिल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಂಚಕ /ಮೋಸಗಾರ<br><b>प्रयोगाः - </b>"अवमन्यत एवमध्वरस्थः कुटिलो हन्त कुमार एव कुन्त्याः"<br><b>उल्लेखाः - </b>याद० १५-४२<br><br>कुटिल<br><br><b>पदविभागः - </b>क्रियाविशेषणम्<br><b>कन्नडार्थः - </b>ಸೊಟ್ಟೆಯಾಗಿ /ವಕ್ರವಾಗಿ<br><b>प्रयोगाः - </b>"आर्ये व्रजामोऽन्यत इत्यथैनां वधूरसूयाकुटिलं ददर्श"<br><b>उल्लेखाः - </b>रघु० ६-८२<br><br>

कुटिला
कुटिला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸರಸ್ವತೀ ನದಿ<br><br>कुटिला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಪೃಕ್ಕಾ ಎಂಬ ಒಂದು ಸುಗಂಧದ್ರವ್ಯ<br><br>

कुटिलकीटक
कुटिलकीटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೇಡರ ಹುಳು<br><br>

कुटिलग
कुटिलग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಕ್ರವಾಗಿ ನಡೆಯುವ /ಸೊಟ್ಟೆಯಾಗಿ ಹೋಗುವ<br><b>निष्पत्तिः - </b>गम्लृ (गतौ) - "डः" (वा० ३-२-४८)<br><b>व्युत्पत्तिः - </b>कुटिलं गच्छति<br><br>

कुटिलगा
कुटिलगा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನದಿ /ಹೊಳೆ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्" (४-१-४)<br><br>

कुटिलगामिन्
कुटिलगामिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>कुटिलग ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"णिनिः" (३-२-७८)<br><br>

कुटिलगामिनी
कुटिलगामिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कुटिलग ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियं "ङीप्" (४-१-५)<br><br>

कुटिलगति
कुटिलगति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಕ್ರವಾದ ಗಮನ /ಸೊಟ್ಟೆಯಾಗಿ ನಡೆಯುವುದು<br><b>व्युत्पत्तिः - </b>कुटिला गतिः<br><br>कुटिलगति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಕ್ರವಾದ ಗಮನವುಳ್ಳ /ವಕ್ರವಾಗಿ ನಡೆಯುವ<br><b>व्युत्पत्तिः - </b>कुटिला गतिर्यस्य<br><br>

कुटिलता
कुटिलता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಕ್ರವಾಗಿರುವಿಕೆ /ಡೊಂಕಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कुटिलस्य भावः<br><br>कुटिलता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಂಚನೆ /ಮೋಸ /ಠಕ್ಕು<br><br>

कुटिलपक्ष्मन्
कुटिलपक्ष्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಕ್ರವಾದ ಕಣ್ಣಿನ ರೆಪ್ಪೆ ಕೂದಲು<br><b>व्युत्पत्तिः - </b>कुटिलं च तत् पक्ष्म च<br><br>

कुटिलमति
कुटिलमति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಕ್ರವಾದ ಬುದ್ಧಿ /ಋಜುವಲ್ಲದ ಬುದ್ಧಿ<br><b>व्युत्पत्तिः - </b>कुटिला मतिः<br><br>कुटिलमति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಕ್ರವಾದ ಬುದ್ಧಿಯುಳ್ಳ /ಅಪ್ರಾಮಾಣಿಕವಾದ ಬುದ್ಧಿಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कुटिला मतिर्यस्य<br><b>प्रयोगाः - </b>"कौटिल्यः कुटिलमतिः स एष येन क्रोधाग्नी प्रसभमदाहि नन्दवंशः"<br><b>उल्लेखाः - </b>मुद्रा० १-७<br><br>

कुटिलाशय
कुटिलाशय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಮನಸ್ಸುಳ್ಳ /ಮೋಸದ ಬುದ್ಧಿಯುಳ್ಳ<br><br>

कुटिलिका
कुटिलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಟೆಗಾರನ ಒಂದು ವಿಧವಾದ ನಡಗೆ /ವ್ಯಾಧನು ಬೇಟೆಯ ಸಮಯದಲ್ಲಿ ಬಗ್ಗಿಕೊಂಡು ನಡೆಯುವುದು<br><br>कुटिलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮ್ಮಾರನ ಕಬ್ಬಿಣದ ಇಕ್ಕಳ<br><b>विस्तारः - </b>"कुटिलिका व्याधानां गतिविशेषः कर्मारोपकरणभूतं लोहं च । कुटिलिकया हरति मृगानङ्गारान् वा कौटिलिको व्याधः कर्मारश्च" - सि० कौ० ।<br><br>

कुटी
कुटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಮನೆ /ಗುಡಿಸಲು /ಕ್ಷುದ್ರಗೃಹ /ಕುಟೀರ<br><b>निष्पत्तिः - </b>कुट (कौटिल्ये)- "इन्" (उ० ४-११७) । "ङीष्" (ग० ४-१-४५)<br><br>कुटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಟ್ಟಿನಿ /ತಲೆಹಿಡಕಿ<br><br>कुटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ /ಹೆಂಡ<br><br>कुटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಷ್ಪಗುಚ್ಛ /ಹೂವಿನ ಗೊಂಚಲು<br><br>कुटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆವಿಯು ಮೇಲಕ್ಕೆ ಬರಲು ಅವಕಾಶವುಳ್ಳ ರಂಧ್ರವಿರುವ ಮುಚ್ಚಳ<br><br>कुटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುರೆಯೆಂಬ ಸುಗಂಧದ್ರವ್ಯ<br><b>विस्तारः - </b>"कुटी स्यात् कुम्भदास्यां च सुरायां चित्रगुच्छके" - मेदि० । "कुटी सुरा । चित्रगुच्छा कुम्भदासी" - हेम० ।<br><br>

कुटीकुट
कुटीकुट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಡಿಸಲು ಮತ್ತು ಮನೆ<br><b>निष्पत्तिः - </b>निपा० (२-४-११)<br><b>व्युत्पत्तिः - </b>कुटी च कुटश्च अनयोः समाहारः<br><br>

कुटीकृत
कुटीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಕ್ರವಾಗಿ ಮಾಡಲ್ಪಟ್ಟ /ಬಗ್ಗಿಸಿ ಮನೆಯಾಗಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कुटी - डुकृञ् (करणे) - "च्विः" "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"और्णं च राङ्कवं चैव कुटिजं पट्टजं तथा । कुटीकृतं तथैवात्र कमलाभं सहस्रशः ॥"<br><b>उल्लेखाः - </b>भा० सभा०<br><br>

कुटीचक
कुटीचक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಲ್ಕು ವಿಧ ಸಂನ್ಯಾಸಿಗಳಲ್ಲಿ ಒಂದು ಭೇದ<br><b>निष्पत्तिः - </b>चक (तृप्तौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुट्यां चकते<br><b>प्रयोगाः - </b>"चतुर्विधा भिक्षवस्ते कुटीचकबहूदकौ । हंसः परमहंसश्च योऽत्र पश्चात् स उत्तमः ॥"<br><b>उल्लेखाः - </b>भा० अनु०<br><br>

कुटीचर
कुटीचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>कुटीचक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>चर (गतुभक्षणयोः) - "टः" (३-२-१६)<br><b>व्युत्पत्तिः - </b>कुट्यां चरति<br><br>कुटीचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಳ್ಳಿ<br><b>विस्तारः - </b>"वहिः कुटीचरः" - त्रिकाण्ड० ।<br><br>

कुटीर
कुटीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಡಿಸಲು /ಸಣ್ಣ ಜೋಪಡಿ<br><b>निष्पत्तिः - </b>"रः" (५-३-८८)<br><b>व्युत्पत्तिः - </b>ह्रस्वा कुटी<br><br>

कुटुङ्गक
कुटुङ्गक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲತಾಗೃಹ /ಲತೆಗಳಿಂದ ನಿರ್ಮಿತವಾದ ಮನೆ<br><br>कुटुङ्गक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯಗಳನ್ನಿಡುವ ಬಿದಿರಿನ ತೊಂಬೆ /ಕಣಜ<br><br>कुटुङ्गक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಡಿಸಲು /ಜೋಪಡಿ<br><br>

कुटुम्ब|धारणे|कुटुम्बयते
कुटुम्ब - धारणे (चुरा० आत्म० सक० से०) कुटुम्बयते ।<br><br><b>पदविभागः - </b>धातुः<br><br>

कुटुम्ब
कुटुम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಸಾರ /ಮನೆಯ ಜನರು<br><b>निष्पत्तिः - </b>कुटुम्ब (धारणे) - कर्म० "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>कुटुम्ब्यते<br><b>प्रयोगाः - </b>"तस्य भृत्यजनं ज्ञात्वा स्वकुटुम्बान्महीपतिः । श्रुतिशीले च विज्ञाय वृत्तिं धर्म्यां प्रकल्पयेत् ॥" "तदुपहितकुटुम्बः शान्तिमार्गोत्सुकोऽभूत्" ।<br><b>उल्लेखाः - </b>मनु० ११-२२, रघु० ७-७१<br><br>कुटुम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಂಧು /ನೆಂಟ<br><br>कुटुम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶ /ಸಂತತಿ<br><br>कुटुम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಸರು<br><br>कुटुम्ब<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಷದಲ್ಲಿ ಲಗ್ನದಿಂದ ೨ನೆಯ ಸ್ಥಾನ<br><br>

कुटुम्बक
कुटुम्बक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>कुटुम्ब ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्वार्थे "कः"<br><b>प्रयोगाः - </b>"अयं निजः परो वेति गणना लघुचेतसाम् । उदारचरितानां तु वसुधैव कुटुम्बकम् ॥"<br><b>उल्लेखाः - </b>हितो०<br><br>

कुटुम्बव्यापृत
कुटुम्बव्यापृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಸಾರ ಪೋಷಣೆಯಲ್ಲಿ ನಿರತನಾದವನು /ಗೃಹಕೃತ್ಯಕ್ಕೆ ಗಮನಕೊಡುವವನು<br><b>व्युत्पत्तिः - </b>कुटुम्बे तत्पोषणे व्यापृतः<br><br>

कुटुम्बिक
कुटुम्बिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೃಹಸ್ಥ /ಮನೆಯ ಯಜಮಾನ<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कुटुम्बोऽस्त्यस्य<br><br>

कुटुम्बिन्
कुटुम्बिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೃಹಸ್ಥ /ಮನೆಯ ಯಜಮಾನ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><br>

कुटुम्बिनी
कुटुम्बिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಡತಿ /ಪತ್ನಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><b>प्रयोगाः - </b>"प्रायेण गृहिणीनेत्राः कन्यार्थेषु कुटुम्बिनः" । "भवतु, कुटुम्बिनीमाहूय पृच्छामि" ।<br><b>उल्लेखाः - </b>कुमा० ६-८५, मुद्रा० १<br><br>कुटुम्बिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಟುಂಬಗಳ ಸಮೂಹ<br><b>निष्पत्तिः - </b>"इनिः" (वा० ४-३-५१)<br><b>व्युत्पत्तिः - </b>कुटुम्बानां समूहः<br><br>

कुटुम्बिता
कुटुम्बिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಸಾರಿಯಾಗಿರುವಿಕೆ /ಗೃಹಸ್ಥನಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कुटुम्बिनो भावः<br><br>

कुटुम्बित्व
कुटुम्बित्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಸಾರಿಯಾಗಿರುವಿಕೆ /ಗೃಹಸ್ಥನಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

कुटॆरक
कुटॆरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮ್ಮಗಗ್ಗರ ಗಿಡ<br><b>विस्तारः - </b>"अथ पर्णासे कठिञ्जरकुटेरकौ" - अम० ।<br><br>

कुट्ट|च्छेदनभर्त्सनयोः|कुट्टयति | कुट्टयते 
कुट्ट - च्छेदनभर्त्सनयोः (चुरा० उभ० सक० से०) कुट्टयति-ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸು<br><br>कुट्ट - च्छेदनभर्त्सनयोः (चुरा० उभ० सक० से०) कुट्टयति-ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅರೆ /ಪುಡಿ ಮಾಡು<br><br>कुट्ट - च्छेदनभर्त्सनयोः (चुरा० उभ० सक० से०) कुट्टयति-ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ನಿಂದಿಸು /ಆಕ್ಷೇಪಿಸು<br><br>

कुट्ट|प्रतापने|कुट्टयते
कुट्ट - प्रतापने (चुरा० आत्म० सक० से०) कुट्टयते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕುಟ್ಟು /ಜಜ್ಜು /ಅದುಮಿ ಇಡು<br><br>कुट्ट - प्रतापने (चुरा० आत्म० सक० से०) कुट्टयते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಿಸು /ಅಧಿಕಪಡಿಸು<br><br>

कुट्टक
कुट्टक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವವನು /ಒಡೆಯುವವನು /ತುಂಡು ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>कुट्ट (छेदने) - "ण्वुल्"(३-१-१३३)<br><br>कुट्टक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರೆಯುವವನು /ಪುಡಿ ಮಾಡುವವನು<br><br>कुट्टक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿಸುವವನು /ಆಕ್ಷೇಪಿಸುವವನು<br><br>कुट्टक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಿಸುವವನು /ಅಧಿಕಪಡಿಸುವವನು<br><br>कुट्टक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಟ್ಟುವವನು /ಜಜ್ಜುವವನು<br><br>

कुट्टन
कुट्टन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವಿಕೆ /ಒಡೆಯುವುದು /ತುಂಡುಮಾಡುವುದು<br><b>निष्पत्तिः - </b>कुट्ट (छेदनभर्त्सनयोः) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"नुनुदे तनुकण्डु पण्डितः पटुचञ्चूपुटकोटिकुट्टनैः"<br><b>उल्लेखाः - </b>नैष० २-४<br><br>कुट्टन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರೆಯುವುದು /ಪುಡಿ ಮಾಡುವುದು<br><b>प्रयोगाः - </b>"अजस्रभूमीतटकुट्टनोत्थितैरुपास्यमानं चरणेषु रेणुभिः"<br><b>उल्लेखाः - </b>नैष० १-५९<br><br>कुट्टन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಜ್ಜುವುದು /ಕುಟ್ಟುವುದು<br><br>कुट्टन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದಿಸುವುದು<br><br>

कुट्टिनी
कुट्टिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಪುರುಷನೊಡನೆ ಪರಸ್ತ್ರೀಯನ್ನು ಸೇರಿಸುವ ಹೆಂಗಸು /ತಲೆಹಿಡಕಿ<br><b>निष्पत्तिः - </b>कुट्ट (छेदने) - "ल्युट्" (३-३-११५) । "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>कुट्टयति<br><br>

कुट्टमित
कुट्टमित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತ್ರೀಯರ ಸ್ವಭಾವಜನ್ಯವಾದ ವಿಲಾಸಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"मोट्टायितं कुट्टमितं विभ्रमो ललितं मदः" । "केशस्तनाधरादीनां ग्रहे हर्षेऽपि सम्भ्रमात् । आहुः कुट्टमितं नाम शिरःकरविधूननम् ॥"<br><b>उल्लेखाः - </b>सा० द० ३-९१, सा० द० ३-१०३<br><br>

कुट्टाक
कुट्टाक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವ /ಒಡೆಯುವ /ಬೇರ್ಪಡಿಸುವ<br><br>कुट्टाक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಟ್ಟುವ /ಜಜ್ಜುವ<br><b>निष्पत्तिः - </b>कुट्ट (छेदने) - "षाकन्" (३-२-१५५)<br><b>प्रयोगाः - </b>"पट्टाभिषेकमभिलष्यति फलादेशे कुट्टाकभावकुतुकं कुरुते स्म भीमः"<br><b>उल्लेखाः - </b>चं० भा० १<br><br>

कुट्टाकी
कुट्टाकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कुट्टाक ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीष्" (४-१-४१)<br><br>

कुट्टार
कुट्टार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತ /ಬೆಟ್ಟ<br><b>निष्पत्तिः - </b>कुट्ट (छेदने) - "आरन्" बाहु० ।<br><br>कुट्टार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುರತ /ಸಂಭೋಗ<br><br>कुट्टार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಬಳಿ<br><br>कुट्टार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೇವಲ /ಪ್ರತ್ಯೇಕವಾಗಿರುವಿಕೆ /ಇನ್ನೊಂದರೊಡನೆ ಬೆರೆಯದಿರುವಿಕೆ<br><b>विस्तारः - </b>"जीमूतकुटकुट्टीरकुट्टाराः कन्दराकरः" - हारा० । "कुट्टारं केवले रते" - मेदि० ।<br><br>

कुट्टित
कुट्टित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವುದು /ಒಡೆಯುವುದು<br><br>कुट्टित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಟ್ಟುವುದು /ಜಜ್ಜುವುದು<br><br>कुट्टित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರೆಯುವುದು /ಪುಡಿ ಮಾಡುವುದು<br><br>कुट्टित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ಆಕ್ಷೇಪಣೆ<br><b>निष्पत्तिः - </b>कुट्ट (छेदने) - भावे "क्तः" (३-३-११४)<br><br>कुट्टित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸಲ್ಪಟ್ಟ /ಒಡೆಯಲ್ಪಟ್ಟ<br><br>कुट्टित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರೆಯಲ್ಪಟ್ಟ /ಪುಡಿಮಾಡಲ್ಪಟ್ಟ<br><br>कुट्टित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿಸಲ್ಪಟ್ಟ /ಆಕ್ಷೇಪಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कुट्ट (छेदने) - कर्म० "क्तः"(३-२-१०२)<br><br>कुट्टित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಟ್ಟಲ್ಪಟ್ಟ /ಜಜ್ಜಲ್ಪಟ್ಟ<br><br>

कुट्टिम
कुट्टिम<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಚಪ್ಪಡಿಗಳನ್ನು ಹಾಸಿ ನಿರ್ಮಿಸಲ್ಪಟ್ಟ ಭೂಮಿ<br><br>कुट्टिम<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರತ್ನಖಚಿತವಾದ ಭೂಮಿ<br><b>निष्पत्तिः - </b>कुट्ट (छेदने) - भावे "घञ्" (३-३-१८) । "इमप्" (वा० ४-२-२०)<br><b>व्युत्पत्तिः - </b>कुट्टेन निवृत्तम्<br><br>कुट्टिम<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಾರೆ ಹಾಕಿದ ನೆಲ /ಜಗುಲಿ<br><b>प्रयोगाः - </b>"कान्तेन्दुकान्तोपलकुट्टिमेषु प्रतिक्षपं हर्म्यतलेषु यत्र" । "यदगारघटाट्टकुट्टिमस्रवदिन्दूपलतुन्दिलापया" ।<br><b>उल्लेखाः - </b>माघ० ३-४४, नैष० २-८९<br><br>

कुट्टीर
कुट्टीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತ /ಬೆಟ್ಟ<br><b>निष्पत्तिः - </b>कुट्ट (छेदने) - "ईरन्" बाहु० ।<br><b>विस्तारः - </b>"जीमूतकुटकुट्टीरकुट्टाराः कन्दराकरः" - हारा० ।<br><br>कुट्टीर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವ /ಒಡೆಯುವ<br><br>

कुट्मल|कुड्मल
कुट्म(ड्म)ल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಗ್ಗು<br><b>निष्पत्तिः - </b>कुट (कौटिल्ये) - "कलः" मुट् च ( उ० ग० १-१०६) । कुडि (दाहे) - "क्मलन्" (उ० ४-१८६) वा ।<br><b>प्रयोगाः - </b>"द्योतितान्तःसभैः कुन्दकुड्मलाग्रदतः स्मितैः" ।<br><b>उल्लेखाः - </b>माघ० २-७<br><br>कुट्म(ड्म)ल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನರಕ<br><b>प्रयोगाः - </b>"सङ्घातं च सकाकोलं कुड्मलं प्रतिमूर्तिकम्"<br><b>उल्लेखाः - </b>मनु० ४-८९<br><br>कुट्म(ड्म)ल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಗ್ಗಿನಂತಿರುವ ಬಾಣದ ತುದಿ<br><b>प्रयोगाः - </b>"कुड्मलश्चाभवद्विष्णुस्तस्मिन्निषुवरं तदा"<br><b>उल्लेखाः - </b>भा० कर्ण० ३४-१९<br><br>

कुठ|छेदने|कोठति
कुठ - छेदने (सौत्रः पर० सक० से०) कोठति<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವುದು /ಒಡೆಯುವುದು<br><br>

कुठ
कुठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಕ್ಷ /ಮರ<br><b>निष्पत्तिः - </b>कुट्ट (छेदने) - कर्म० घञर्थे "कः" (वा० ३-३-५८)<br><br>

कुठर
कुठर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಸರು ಕಡೆಯುವ ಕಂಬ /ಮೊಸರು ಕಡೆಯುವ ಹಗ್ಗ ಕಟ್ಟುವ ಕಂಬ<br><b>निष्पत्तिः - </b>कुठ (छेदने) - "करन्" बाहु० ।<br><br>

कुठाकु
कुठाकु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮರಕುಟಿಗನ ಹಕ್ಕಿ<br><b>निष्पत्तिः - </b>कुठ (छेदने) - "काकुः" बाहु० ।<br><br>

कुठाण्टक
कुठाण्टक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಠಾರ /ಕೊಡಲಿ<br><b>निष्पत्तिः - </b>पृषो० ।<br><b>व्युत्पत्तिः - </b>कुठाररूपः टङ्कः<br><br>

कुठार
कुठार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಶು /ಕೊಡಲಿ<br><b>निष्पत्तिः - </b>ऋ (गतौ) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कुठं वृक्षं ऋच्छति<br><b>प्रयोगाः - </b>"राजन्योच्चांसकूटक्रथनपटुरट्द्घोरधारः कुठारः"<br><b>उल्लेखाः - </b>प्रबोध० १-७<br><br>कुठार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುದ್ದಲಿ /ಮಣ್ಣನ್ನು ಅಗೆಯುವ ಒಂದು ಆಯುಧ<br><br>कुठार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಕ್ಷ /ಮರ<br><b>निष्पत्तिः - </b>कुठ - कर्म० "आरन्"<br><b>व्युत्पत्तिः - </b>कुठ्यते छिद्यते<br><br>

कुठारक
कुठारक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಕೊಡಲಿ /ಕೈ ಕೊಡಲಿ<br><b>निष्पत्तिः - </b>कुठार - अल्पार्थे "कन्"<br><br>

कुठारिका
कुठारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಕೊಡಲಿ /ಕೈ ಕೊಡಲಿ<br><b>प्रयोगाः - </b>"विपुलविलसल्लज्जावल्लीवितानकुठारिका जठरपिटरी दुष्पूरेयं करोति विडम्बनम्"<br><b>उल्लेखाः - </b>भर्तृ० ३-२२<br><br>

कुठारु
कुठारु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಕ್ಷ /ಮರ<br><b>निष्पत्तिः - </b>कुठ (छेदने) - "आरुः" बाहु० ।<br><br>कुठारु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾನರ /ಕಪಿ /ಕೋತಿ<br><b>विस्तारः - </b>"कुठारुर्ना द्रुमे कीशे" - मेदि० ।<br><br>

कुठि|प्रतिघाते
कुठि - प्रतिघाते (भ्वा० पर० अक० से०)<br><br><b>पदविभागः - </b>धातुः<br><br>

कुठि
कुठि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತ /ಬೆಟ್ಟ<br><br>कुठि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಕ್ಷ /ಮರ<br><b>निष्पत्तिः - </b>कुठि (प्रतिघाते) - "इन्" (उ० ४-११७)<br><br>

कुठिक
कुठिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಷ್ಠರೋಗ<br><b>निष्पत्तिः - </b>कुठ (छेदने) - "इकन्" बाहु० ।<br><b>विस्तारः - </b>"मृत्फली कुठिकः प्रोक्तः" - हारा० ।<br><br>

कुठेर
कुठेर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮ್ಮಗಗ್ಗರ ಗಿಡ<br><br>कुठेर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಹ್ನಿ /ಬೆಂಕಿ<br><b>निष्पत्तिः - </b>कुठि (प्रतिघाते) - "एरक्" (उ०१-५८)<br><br>कुठेर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಷ್ಟಜೀವಿ<br><br>कुठेर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲೆಗಳನ್ನು ತಿನ್ನುವವನು<br><br>

कुठेरु
कुठेरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಮರದ ಗಾಳಿ<br><b>निष्पत्तिः - </b>कुठि (प्रतिघाते) - "एरुः" बाहु० ।<br><br>

कुड|बाल्ये|कुडति
कुड - बाल्ये (तुदा० पर० अक० से०) कुडति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹುಡುಗನಂತೆ ಆಡು /ಹುಡಿಗಾಟವಾಡು<br><br>

कुडि|दाहे|कुण्डते
कुडि - दाहे (भ्वा० आत्म० सक० से०) कुण्डते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ದಹಿಸು /ಸುಡು<br><br>

कुडि|रक्षणे|कुण्डयति | कुण्डयते
कुडि - रक्षणे (चुरा० उभ० सक० से०) कुण्डयति-ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ರಕ್ಷಿಸು /ಕಾಪಾಡು<br><br>

कुडप|कुडव
कुडप(व)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಸ್ಥದ ನಾಲ್ಕನೆಯ ಒಂದು ಭಾಗದ ಅಳತೆ<br><b>निष्पत्तिः - </b>कुडि (दाहे) - "कपन्" कवच्" वा बाहु० ।<br><b>विस्तारः - </b>"द्रोणस्तु खार्यां खलु षोडशांशः स्यादाढको द्रोणचतुर्थभागः । प्रस्थश्चतुर्थांश इहाढकस्य प्रस्थाङ्घ्रिराद्यैः कुडवः प्रदिष्टः ॥"<br><br>

कुडि
कुडि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹ /ಶರೀರ /ಮೈ<br><b>निष्पत्तिः - </b>कुडि (दाहे) - "इन्" नलोपश्च (उ० ४-१४३)<br><b>व्युत्पत्तिः - </b>कुण्ड्यते<br><br>

कुड्मल
कुड्मल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>कुट्मल ಪದದ ಅರ್ಥ<br><br>

कुड्मलन
कुड्मलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಕೋಚ ಹೊಂದಿರುವಿಕೆ /ಮೊಗ್ಗಾಗಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"जगदतुर्निहिते हॆदि नीरजे दवथुकुड्मलनेन पृथुस्तनीम्"<br><b>उल्लेखाः - </b>नैष० ४-३०<br><br>

कुड्मलित
कुड्मलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊಗ್ಗು ಬಿಟ್ಟಿರುವ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>कुड्मलोऽस्य सञ्जातः<br><br>

कुड्य
कुड्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೋಡೆ<br><b>निष्पत्तिः - </b>"यत्"(४-४-९८) । पृषो० ।<br><b>व्युत्पत्तिः - </b>कुट्यां साधु<br><b>प्रयोगाः - </b>"तदलक्ष्यरत्नमयकुड्यमादरादभिधातरीत इत इत्यथो नृपे"<br><b>उल्लेखाः - </b>माघ० १३-६२<br><br>

कुड्यच्छेदक
कुड्यच्छेदक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೋಡೆಯಲ್ಲಿ ಕನ್ನ ಕೊರೆಯುವ ಕಳ್ಳ<br><b>निष्पत्तिः - </b>छिदिर् (द्वैधीकरणे) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कुड्यं छिनत्ति<br><br>

कुड्यच्छेदिन्
कुड्यच्छेदिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೋಡೆಯಲ್ಲಿ ಕನ್ನ ಕೊರೆಯುವ ಕಳ್ಳ<br><b>निष्पत्तिः - </b>"णिनिः" (३-२-७८)<br><br>

कुड्यच्छेदन
कुड्यच्छेदन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೋಡೆಯಲ್ಲಿ ಕನ್ನ ಕೊರೆಯುವುದು<br><b>व्युत्पत्तिः - </b>कुड्यस्य छेदनम्<br><br>

कुड्यच्छेद्य
कुड्यच्छेद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕನ್ನಗತ್ತರಿ /ಕನ್ನ ಕೊರೆಯತಕ್ಕ ಕತ್ತರಿ<br><b>व्युत्पत्तिः - </b>कुड्यं छेद्यं यस्य<br><b>विस्तारः - </b>"कुड्यच्छेद्यं तु खानिकम्" - त्रिकाण्ड० ।<br><br>कुड्यच्छेद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೋಡೆಯ ಅಡಿಪಾಯಕ್ಕಾಗಿ ತೋಡುವ ಹಳ್ಳ<br><b>व्युत्पत्तिः - </b>कुड्यस्य छेद्यम्<br><br>

कुड्यमत्स्य
कुड्यमत्स्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಲ್ಲಿ /ಗೌಳಿ<br><b>व्युत्पत्तिः - </b>कुड्ये मत्स्य इव<br><br>

कुड्यमत्सी
कुड्यमत्सी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಲ್ಲಿ /ಗೌಳಿ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

कुण|आमन्त्रणे|कुणयति|कुणयते 
कुण -आमन्त्रणे (चुरा० उभ० अक० से०) कुणयति-ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಂಭೋಧಿಸು /ಕರೆ<br><br>कुण -आमन्त्रणे (चुरा० उभ० अक० से०) कुणयति-ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಮಾತಾಡು /ಸಂಭಾಷಿಸು<br><br>

कुण|शब्दोपकरणयोः|कुणति
कुण - शब्दोपकरणयोः (तुदा० पर० सक० से०) कुणति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸದ್ದು ಮಾಡು<br><br>कुण - शब्दोपकरणयोः (तुदा० पर० सक० से०) कुणति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಾಹಾಯ್ಯ ಮಾಡು /ಒತ್ತಾಸೆ ಮಾಡು /ಉಪಕರಿಸು<br><br>

कुण
कुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯಸ /ಕಾಗೆ<br><b>विस्तारः - </b>"आत्मघोषु महानेमिः कण्टको मौकलिः कुणः" - वैज० ।<br><br>कुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೂರೆ /ಹೇನು /ಬಟ್ಟೆಯ ಮೇಲೆ ಬರುವ ಒಂದು ಜಾತಿಯ ಕೃಮಿ<br><b>विस्तारः - </b>ಇದು ಉತ್ತರಪದವಾದಾಗ ವೃಕ್ಷವು ಪುಷ್ಪಿಸುವ ಮತ್ತು ಫಲಬಿಡುವ ಕಾಲವನ್ನು ಹೇಳುವುದು. पीलूनां पाकः "कुणप्" (५-२-२४) । पीलुकुणः ।<br><br>

कुणक
कुणक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಗತಾನೆ ಹುಟ್ಟಿದ ಮರಿ /ಸದ್ಯ ಜನಿಸಿದ ಶಿಶು<br><b>निष्पत्तिः - </b>कुण (शब्दोपकरणयोः) - कर्म० घञर्थे "कः" (वा० ३-३-५८)<br><b>व्युत्पत्तिः - </b>कुण्यते उपक्रियते<br><b>प्रयोगाः - </b>"अहो बतायं हरिणकुणकः कृपणः ईश्वररथचरणपरिभ्रमणरयेण"<br><b>उल्लेखाः - </b>भाग० ५-८-९<br><br>

कुणञ्ञ
कुणञ्ञ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಕ್ಕೋತದ ಸೊಪ್ಪು<br><b>निष्पत्तिः - </b>जॄ (वयोहनौ) - "डः" बाहु० । पृषो० ।<br><b>व्युत्पत्तिः - </b>कुणं जरयति<br><br>

कुणप
कुणप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೃತದೇಹ /ಜೀವವಿಲ್ಲದ ದೇಹ<br><b>निष्पत्तिः - </b>क्वण (शब्दे) - "कपन्" सम्प्रसारणं च (उ० ३-१४३)<br><b>व्युत्पत्तिः - </b>क्वणति<br><br>कुणप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಂಧ /ಕೆಟ್ಟವಾಸನೆ<br><br>कुणप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಟಿ /ಭರ್ಜಿ<br><br>

कुणपी
कुणपी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಹಕ್ಕಿ<br><b>विस्तारः - </b>"कुणपी पुनः । विट्शारिकायां कुणपः पूतिगन्धे शवेऽपि च" - मेदि० ।<br><br>

कुणाल
कुणाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶೋಕ ಚಕ್ರವರ್ತಿಯ ಒಬ್ಬ ಮಗ<br><br>कुणाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದೇಶ<br><b>निष्पत्तिः - </b>क्वण (शब्दे) - "कालन्" (उ० ३-७६)<br><b>विस्तारः - </b>"कुणालो देशभेदः" - सि० कौ०<br><br>

कुणि
कुणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಂದಿಮರ<br><br>कुणि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಕಲವಾದ ಕೈಯುಳ್ಳವನು /ಮೊಂಡುಕೈಯುಳ್ಳವನು<br><b>निष्पत्तिः - </b>कुण (शब्दोपकरणयोः) - "इन्" (उ०४-११९)<br><b>व्युत्पत्तिः - </b>कुण्यते<br><b>प्रयोगाः - </b>"दौहृदविमाननात् कुब्जं कुणिं खञ्जं जडं वामनं विकृताक्षमनक्षं वा नारी सुतं जनयति"<br><b>उल्लेखाः - </b>सुश्रुत० शारीर० ३-१८<br><b>विस्तारः - </b>"कुणिस्तुन्नकवृक्षो ना कुकरेत्वभिधेयवत्" - मेदि० ।<br><br>

कुणिता
कुणिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಯಿಂದ ತೆಗೆದುಕೊಳ್ಳುವ ಮತ್ತು ಕೊಡುವ ಶಕ್ತಿಯಿಲ್ಲದಿರುವಿಕೆ /ಮೊಂಡುಕೈಯಿಂದ ಕೂಡಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कुणेर्भावः<br><br>

कुणित्व
कुणित्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಯಿಂದ ತೆಗೆದುಕೊಳ್ಳುವ ಮತ್ತು ಕೊಡುವ ಶಕ್ತಿಯಿಲ್ಲದಿರುವಿಕೆ /ಮೊಂಡುಕೈಯಿಂದ ಕೂಡಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

कुणिन्द
कुणिन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದ /ಸದ್ದು<br><b>निष्पत्तिः - </b>कुण (शब्दोपकरणयोः) - भावे "किन्दच्" (उ० ४-८६)<br><br>

कुणपदी
कुणपदी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಟು ಹೆಂಗಸು /ನಡೆಯಲು ಶಕ್ತಿಯಿಲ್ಲದ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>पादस्य पद्भावः "ङीष्" च (५-४-१३९) निपा०।<br><b>व्युत्पत्तिः - </b>कुणिरिव कुण्ठितशक्तिः पादोऽस्याः<br><br>

कुण्ठ
कुण्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಕ್ತಿಕುಂದಿದ /ಕೆಲಸದಲ್ಲಿ ಅಸಮರ್ಥನಾದ<br><b>निष्पत्तिः - </b>कुठि (प्रतिघाते) - "अच्" (३-१-१३४)<br><b>प्रयोगाः - </b>"वज्रं तपोवीर्यमहत्सु कुण्ठं त्वं सर्वतोगामि च साधकं च"<br><b>उल्लेखाः - </b>कुमा० ३-१२<br><br>कुण्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊಂಡಾಗಿರುವ /ಹರಿತವಾಗಿಲ್ಲದ<br><b>प्रयोगाः - </b>"मूर्धानमूर्ध्वायतदन्तमण्डलं ध्रुवन्नरोधि द्विरदो निषादिना"<br><b>उल्लेखाः - </b>माघ० १२-१२<br><br>कुण्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂರ್ಖ /ದಡ್ಡ<br><b>विस्तारः - </b>"कुण्ठोऽकर्मण्यमूर्खयोः" - मेदि० ।<br><br>

कुण्ठक
कुण्ठक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂರ್ಖ /ದಡ್ಡ /ಅವಿವೇಕಿ<br><br>कुण्ठक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೋಮಾರಿ /ಪಾಲುಮಾರಿಕೆಯುಳ್ಳವನು ಮೈಗಳ್ಳ<br><br>कुण्ठक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಕ್ತಿಕುಂದಿದ<br><br>कुण्ठक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂರ್ಖರಿಂದ ತುಂಬಿದ ದೇಶ<br><br>

कुण्ठित
कुण्ठित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಕ್ತಿಕುಂದಿದ /ಕೆಲಸದಲ್ಲಿ ಅಸಮರ್ಥನಾದ<br><b>निष्पत्तिः - </b>कुठि (प्रतिघाते) - कर्त० "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"तदङ्गभोगावलिगायनीनां मध्ये निरुक्तिक्रमकुण्ठितानाम्"<br><b>उल्लेखाः - </b>नैष० १०-१०६<br><br>कुण्ठित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಡ್ದನಾದ /ವಿವೇಕ ಶೂನ್ಯನಾದ<br><br>कुण्ठित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊಂಡಾದ /ಹರಿತವಾಗಿಲ್ಲದ<br><b>प्रयोगाः - </b>"वृत्रस्य हन्तुः कुलिशं कुण्ठिताश्रीव दृश्यते" । "बिभ्रतोऽस्त्रमचलेऽप्यकुण्ठितम्" ।<br><b>उल्लेखाः - </b>कुमा० २-२०, रघु० ११-७४<br><br>

कुण्ठितता
कुण्ठितता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಕ್ತಿಕುಂದಿರುವಿಕೆ /ಕೆಲಸಕ್ಕು ಅಸಮರ್ಥವಾಗಿರುವಿಕೆ<br><br>कुण्ठितता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಡ್ದನಾಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कुण्ठितस्य भावः<br><br>

कुण्ठित्व
कुण्ठित्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>कुण्ठितता ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

कुण्ड
कुण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪತಿಯು ಜೀವಿಸಿರುವಾಗ ಪರಪುರುಷನಿಗೆ ಹುಟ್ಟಿದವನು<br><b>निष्पत्तिः - </b>कुडि (दाहे) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>कुण्ड्यते कुलमनेन<br><b>प्रयोगाः - </b>"परदारेषु जायेते द्वौ सुतौ कुण्डगोलकौ । पत्यौ जीवति कुण्डः स्यान्मृते भर्तरि गोलकः ॥"<br><b>उल्लेखाः - </b>मनु० ३-१७४<br><br>कुण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಕುಂಡ /ಭೂಮಿಯಲ್ಲಿ ಅಗ್ನಿಯನ್ನಿಟ್ಟು ರಕ್ಷಿಸುವ ಒಂದು ಗುಳಿ<br><b>प्रयोगाः - </b>"चण्डीशचण्डाक्षिहुताशकुण्डे जुहाव यन्मन्दिरमिन्द्रियाणाम्"<br><b>उल्लेखाः - </b>नैष० ८-३३<br><br>कुण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರನ್ನು ತುಂಬಿಡುವ ಪಾತ್ರೆ /ಕೊಡ /ಬಿಂದಿಗೆ /ಗಡಿಗೆ<br><b>प्रयोगाः - </b>"भुवं कोष्णेन कुण्डोघ्नी मेध्येनावभृथादपि"<br><b>उल्लेखाः - </b>रघु० १-८४<br><br>कुण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇವತೆಗಳಿಂದ ನಿರ್ಮಿತವಾದ ಜಲಾಶಯ<br><br>

कुण्डी
कुण्डी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಂಡಲು<br><b>निष्पत्तिः - </b>कुण (शब्दोपकरणयोः) - "डः" (उ० १-१११) । "ङीष्" (४-१-४२)<br><b>विस्तारः - </b>"कुण्डं देवजलाधारे पिठरेऽथ कमण्डलौ । कुण्डी कुण्डः स्मृतो जारात् पतिवत्नी सुतेऽपि च" - विश्व० ।<br><br>

कुण्डक
कुण्डक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧೃತರಾಷ್ಟ್ರನ ಒಬ್ಬ ಮಗ<br><b>प्रयोगाः - </b>"कुण्डकश्चित्रसेनश्च सुवर्चाः कनकध्वजः"<br><b>उल्लेखाः - </b>भा० आदि० २०१-३<br><br>कुण्डक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>कुण्ड ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>कुण्ड - स्वार्थे "कः"<br><br>

कुण्डकीट
कुण्डकीट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪತಿತಳಾದ ಬ್ರಾಹ್ಮಣ ಹೆಂಗಸಿನ ಮಗ<br><b>व्युत्पत्तिः - </b>कुण्डे योनिकुण्डे कीट इव<br><br>कुण्डकीट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಾಸಿಯಲ್ಲಿ ಅನುರಾಗ ಹೊಂದಿದವನು /ಉಪಪತ್ನಿಯನ್ನು ಹೊಂದಿರುವವನು<br><br>कुण्डकीट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಾರ್ವಾಕವಾದದಲ್ಲಿ ಅಭಿಜ್ಞನಾದವನು<br><b>विस्तारः - </b>"कुण्डकीटस्तु चार्वाकवचनाभिज्ञपूरुषे" - मेदि० ।<br><br>

कुण्डगोलक
कुण्डगोलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಡ ಮತ್ತು ಗೋಳಕ<br><b>व्युत्पत्तिः - </b>कुण्डश्च गोलकश्च<br><b>प्रयोगाः - </b>"शूद्रशिष्यो गुरुश्चैव वाग्दुष्टः कुण्डगोलकौ"<br><b>उल्लेखाः - </b>मनु० ३-१५६<br><b>विस्तारः - </b>द्विवचनान्तं रूपम् ।<br><br>कुण्डगोलक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಬಲಿ /ಗಂಜಿ<br><b>व्युत्पत्तिः - </b>कुण्डे गोलं गोलाकारं कं जलमत्र<br><br>

कुण्डज
कुण्डज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧೃತರಾಷ್ಟ್ರನ ಒಬ್ಬ ಮಗ<br><b>प्रयोगाः - </b>"कुण्डकश्चित्रकश्चैव दुःशला च शताधिका"<br><b>उल्लेखाः - </b>भा० आदि० ६७-१०५<br><br>

कुण्डपाय्य
कुण्डपाय्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೃತ್ಪಾತ್ರೆಯಲ್ಲಿ ಸೋಪಪಾನ ಮಾಡುವ ಒಂದು ಯಾಗ<br><b>निष्पत्तिः - </b>"ण्यत्" (३-१-१३०) निपा०।<br><b>व्युत्पत्तिः - </b>कुण्डेन पीयतेऽस्मिन् सोमः<br><b>प्रयोगाः - </b>"कुण्डपाय्यवतां कच्चिदग्निचित्यावतां तथा"<br><b>उल्लेखाः - </b>भट्टि० ६-६७<br><br>

कुण्डभेदिन्
कुण्डभेदिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧೃತರಾಷ್ಟ್ರನ ಒಬ್ಬ ಮಗ<br><b>प्रयोगाः - </b>"अनाधृष्यः कुण्डभेदी विरावी दीर्घलोचनः"<br><b>उल्लेखाः - </b>भा० आदि० ६७-१०५<br><br>

कुण्डल
कुण्डल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣಾಭರಣ /ಕಿವಯ ಒಡವೆ /ಹತ್ತಕಡಕು<br><b>निष्पत्तिः - </b>कुडि (रक्षायाम्) - "कलः" (उ० १-१०६)<br><b>व्युत्पत्तिः - </b>कुण्ड्यते<br><b>प्रयोगाः - </b>"महार्हवैडूर्यकिरीटकुण्डलत्विषा परिष्वक्तसहस्रकुन्तलम् । उद्दामकञ्च्यङ्गदकङ्कणादिभिर्विरोचमानं वसुदेव ऐक्षत"<br><b>उल्लेखाः - </b>भाग० १०-३-१०<br><br>कुण्डल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಲಯ /ಬಳೆ /ಕಡಗ<br><b>प्रयोगाः - </b>"अनुययौ विविदोपलकुण्डलद्युतिवितानकसंवलितांशुकम्"<br><b>उल्लेखाः - </b>माघ० ६-२७<br><br>कुण्डल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಗ್ಗ /ರಜ್ಜು<br><br>कुण्डल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುರುಳಿ<br><b>विस्तारः - </b>"कुण्डलं वलये पाशे ताटङ्के" - मेदि० ।<br><br>

कुण्डलन
कुण्डलन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುರುಳಿ ಸುತ್ತುವಿಕೆ /ಗುಂಡಾಗಿ ಸುತ್ತುವಿಕೆ<br><b>निष्पत्तिः - </b>तत्करोति० "णिच्"(ग० ७-४-९७) । भावे "ल्युट्" (३-३-११५)<br><b>व्युत्पत्तिः - </b>कुण्डलं करोति<br><b>प्रयोगाः - </b>"युक्तं ह्रिया कण्डलच्छलेन गोपयति स्वं मुखपुष्करं सः"<br><b>उल्लेखाः - </b>नैष० ७-९५<br><br>

कुण्डलना
कुण्डलना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸುರುಳಿ ಸುತ್ತುವುದು /ಗುಂಡಾಗಿ ಸೊನ್ನೆ ಸುತ್ತುವುದು<br><b>निष्पत्तिः - </b>कुण्डल + तत्करोति० "णिच्"(ग० ७-४-९७) । "युच्" (३-३-१०७)<br><b>व्युत्पत्तिः - </b>कुण्डलं वेष्टनं करोति<br><b>प्रयोगाः - </b>"फणिभाषितभाश्यफक्किकाविषमा कुण्डलनामवापिता" । "तनोति भानोः परिवेषकैतवात्तदा विधिः कुण्डलनां विधोरपि" ।<br><b>उल्लेखाः - </b>नैष० २-९५, नैष० १-१४<br><br>

कुण्डलिका
कुण्डलिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಕೃತದ ಒಂದು ಛಂದಸ್ಸು<br><br>

कुण्डलित
कुण्डलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುಂಡಾಗಿ ಸುತ್ತಲ್ಪಟ್ಟ /ಸುರುಳಿಯಾಗಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कुण्डल + तत्करोति० "णिच्"(ग० ७-४-९७) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"आवर्तशैलीमभिनेतुमिच्छन्त्यङ्गैरमी कुण्डलितैर्भुजङ्गाः"<br><b>उल्लेखाः - </b>याद० १८-९६<br><br>

कुण्डलिन्
कुण्डलिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಪ /ಹಾವು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कुण्डलं वेष्टनमस्त्यस्य<br><br>कुण्डलिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರುಣ<br><br>कुण्डलिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಯೂರ /ನವಿಲು<br><br>कुण्डलिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಂಡಲವನ್ನು ಧರಿಸಿರುವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कुण्डलं कर्णाभरणं अस्त्यय<br><b>विस्तारः - </b>"कुण्डली वरुणे केकिभोगिनोश्च सकुण्डले" - मेदि० ।<br><br>कुण्डलिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೊನ್ನೆ ಸುತ್ತಿರುವ /ಸುರುಳಿ ಸುತ್ತಿರುವ<br><br>

कुण्डलिनी
कुण्डलिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कुण्डलिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>कुण्डलिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯೋಗಶಾಸ್ತ್ರದಲ್ಲಿ ಸರ್ಪವಾಗಿ ರೂಪಿಸಲ್ಪಟ್ಟಿರುವ ಪ್ರಕೃತ ಶಕ್ತಿ<br><b>प्रयोगाः - </b>"अष्टप्रकृतिरूपा कुण्दलिनी"<br><br>कुण्डलिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಕ್ಕುಲಿ ಮುಚ್ಚೋರೆ ಜಿಲೇಬಿ ಮುಂತಾದುವುದು<br><br>

कुण्डशायिन्
कुण्डशायिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧೃತರಾಷ್ಟ್ರನ ಒಬ್ಬ ಮಗ<br><b>प्रयोगाः - </b>"अपराजितः कुण्डशायी विशालाक्षो दुराधरः"<br><b>उल्लेखाः - </b>भा० आदि० १३१-१०<br><br>

कुण्डाशिन्
कुण्डाशिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧೃತರಾಷ್ಟ್ರನ ಒಬ್ಬ ಮಗ<br><b>प्रयोगाः - </b>"कुण्डाशी विरजाश्चैव दुःशला च शताधिका"<br><b>उल्लेखाः - </b>भा०आदि० १३१-१४<br><br>

कुण्डिका
कुण्डिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಂಡಲು<br><br>कुण्डिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಡಕೆ /ಗಡಿಗೆ<br><b>निष्पत्तिः - </b>कुडि (रक्षणे) - "ण्वुल्" (३-१-१३३)<br><br>

कुण्डिन्
कुण्डिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವ /ಈಶ್ವರ<br><b>प्रयोगाः - </b>"दण्डी छत्री च कुण्डी च द्विजानां धारणस्तथा"<br><b>उल्लेखाः - </b>भा० वन०<br><br>कुण्डिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯತಿ /ಸಂನ್ಯಾಸಿ<br><br>कुण्डिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಡಿಗೆಗಳಿಂದ ತುಂಬಿರುವ /ಬಿಂದಿಗೆಗಳಿಂದ ತುಂಬಿರುವ<br><br>

कुण्डिनी
कुण्डिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कुण्डिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>कुण्ड - "इनिः" (५-२-११५) । स्त्रियां "ङीप्" (४-१-५)<br><br>कुण्डिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರತ್ನ ಖಚಿತ ಪಾತ್ರೆ<br><br>

कुण्डिन
कुण्डिन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಋಷಿ<br><br>कुण्डिन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿದರ್ಭದೇಶದ ರಾಜಧಾನಿ /ಕುಂಡಿನನಗರ<br><b>प्रयोगाः - </b>"विलासिनः कुण्डिनमण्डनायितम्"<br><b>उल्लेखाः - </b>नैष० १२-१<br><br>

कुण्डिननगर
कुण्डिननगर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೀಮರಾಜನ ರಾಜಧಾನಿ<br><br>

कुण्डिननगरी
कुण्डिननगरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೀಮರಾಜನ ರಾಜಧಾನಿ<br><br>

कुण्डिनपुर
कुण्डिनपुर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೀಮರಾಜನ ರಾಜಧಾನಿ<br><b>प्रयोगाः - </b>"तस्य कुण्डिनपुरं प्रतिसर्पन् भूपतेर्व्यवसितानि शशसुः"<br><b>उल्लेखाः - </b>नैष० ५-६७<br><br>

कुण्डिनपुरी
कुण्डिनपुरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೀಮರಾಜನ ರಾಜಧಾನಿ<br><br>

कुण्डिनेन्द्र
कुण्डिनेन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿದರ್ಭದೇಶಾಧಿಪತಿ /ಕುಂಡಿನನಗರದ ದೊರೆ /ಭೀಮಸೇನ<br><b>प्रयोगाः - </b>"कुण्डिनेन्द्रसुतया किल पूर्वं मां वरीतुमुररीकृतमास्ते"<br><b>उल्लेखाः - </b>नैष० ५-११४<br><br>

कुण्डीर
कुण्डीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನುಷ್ಯ<br><b>निष्पत्तिः - </b>कुडि (रक्षणे) - "ईरन्" बाहु० ।<br><br>कुण्डीर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಲಶಾಲಿ<br><br>

कुण्डोद
कुण्डोद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಪರ್ವತ<br><b>प्रयोगाः - </b>"कुण्डोदः पर्वतो रम्यो बहुमूलफलोदकः । नैषधस्तृषितो यत्र जलं शर्मं च लब्धवान् ॥"<br><b>उल्लेखाः - </b>भा० वन० ८७-२५<br><br>

कुण्डोदर
कुण्डोदर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸರ್ಪ<br><b>व्युत्पत्तिः - </b>कुण्ड इव उदरमस्य<br><b>प्रयोगाः - </b>"कर्कराकर्करौ नागौ कुण्डोदरमहोदरौ"<br><b>उल्लेखाः - </b>भा० आदि० ३५-१६<br><br>कुण्डोदर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಡಿಗೆಯಂತೆ ದಪ್ಪ ಹೊಟ್ಟೆಯುಳ್ಳವನು<br><br>

कुतनय
कुतनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಸಭ್ಯನಾದ ಪುತ್ರ /ಕೆಟ್ಟ ಮಗ<br><b>व्युत्पत्तिः - </b>कुत्सितं तनयः<br><b>प्रयोगाः - </b>"विप्रोऽनध्ययनात् कुलं कुतनयात् शीलं खलोपासनात्"<br><b>उल्लेखाः - </b>भर्तृ० १-३३<br><br>

कुतनु
कुतनु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರ<br><b>व्युत्पत्तिः - </b>कुत्सिता तनुरस्य<br><b>विस्तारः - </b>"कुतनुकुहेच्छावसवः पिशाचकी सत्यसङ्गरस्त्रिशिराः" - त्रिकाण्ड० ।<br><br>कुतनु<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಶರೀರ /ವಿಕಾರವಾದ ದೇಹ<br><b>व्युत्पत्तिः - </b>कुत्सिता तनुः<br><br>कुतनु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಕಾರವಾದ ಮೈಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कुत्सिता तनुरस्य<br><br>

कुतन्त्री
कुतन्त्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟು ಹೋಗಿರುವ ವೀಣೆ /ಸರಿಯಾದನಾದವಿಲ್ಲದ ವೀಣೆ<br><b>व्युत्पत्तिः - </b>कुत्सित तन्त्री यस्य<br><br>कुतन्त्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕ ದೊಣ್ಣೆ /ಸಣ್ಣ ಕೋಲು<br><b>प्रयोगाः - </b>"स ददर्श श्वमांसस्य कुतन्त्रीं विततां मुनिः"<br><b>उल्लेखाः - </b>भा० शान्ति०<br><br>

कुतप
कुतप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>तप (सन्तापे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुं भूमिं तपति<br><br>कुतप<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಗಳ ಮಗ /ದೌಹಿತ್ರ<br><br>कुतप<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾದ್ಯ<br><br>कुतप<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಡಿನ ಕೂದಲಿನಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ ನೇಪಾಳದ ಶಾಲು<br><br>कुतप<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಶ /ದರ್ಭೆ<br><br>कुतप<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುತಪಕಾಲ /ಹಗಲಿನ ಎಂಟನೆಯ ಭಾಗ<br><b>विस्तारः - </b>"दिवसस्याष्टमे भागे मन्दीभवति भास्करः । स कालः कुतपो ज्ञेयः पितॄणां दत्तमक्षयम्" - मत्स्यपु० । "कुअतपोऽस्त्रियां दौहित्रे वाद्ये छागलकम्बले । कुशे दिनस्याष्टमांशे ना सूर्ये" - मेदि० । "अह्नो मुहूर्ता विख्याता दश पञ्च च सर्वदा । तत्राष्टमो मुहुर्तो यः स कालः कुतपः स्मृतः" -<br><br>कुतप<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧಾನ್ಯ<br><b>विस्तारः - </b>"धान्ये कुशेष्टमांशोऽह्नः कुतपश्छागकम्बले" - त्रिकाण्ड०<br><br>कुतप<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><br>कुतप<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣ<br><br>कुतप<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅತಿಥಿ<br><br>कुतप<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೃಷಭ /ಎತ್ತು<br><br>कुतप<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭಾಗಿನೇಯ /ಸಹೋದರಿಯ ಮಗ /ಸೋದರಳಿಯ<br><b>विस्तारः - </b>"कुतपस्तु छागकम्बलदर्भयोः । वैश्वानरेदिनकरे द्विजन्मन्यतिथौ गवि । भागिनेयेष्टमांशोऽह्नौ वाद्ये" -हेम० ।<br><br>

कुतस्
कुतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲಿಂದ /ಯಾವ ಕಡೆಯಿಂದ<br><b>निष्पत्तिः - </b>किम् - "तसिल्" (५-३-७) । किमः कुभावः ९७-२-१०४)<br><b>प्रयोगाः - </b>"कस्त्वम्। कुतः समागतोऽसि?"<br><b>उल्लेखाः - </b>हितो०<br><br>कुतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಾವನಿಂದ /ಯಾವುದರಿಂದ<br><br>कुतस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಯಾವ ಕಾರಣದಿಂದ<br><b>प्रयोगाः - </b>"कुतस्त्वा कश्मलमिदं विषमेसमुपस्थितम्"<br><b>उल्लेखाः - </b>गीता० २-२<br><br>

कुतस्त्य
कुतस्त्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲಿಂದ ಬಂದಿರುವ<br><br>कुतस्त्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾರಿಂದ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>कुतस् - "त्यप्" (४-२-१०४)<br><br>

कुतुक
कुतुक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುತೂಹಲ /ತಿಳಿದುಕೊಳ್ಳಬೇಕೆಂಬ ಆಸೆ<br><b>निष्पत्तिः - </b>कै (शब्दे) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कुतूं कायति<br><b>प्रयोगाः - </b>"नृपमानसमिष्टमानसः स निमज्जत्कुतुकामृतोर्मिषु"<br><b>उल्लेखाः - </b>नैष० २-८<br><br>कुतुक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹ<br><br>कुतुक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆನಂದ<br><br>

कुतुकिन्
कुतुकिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುತೂಹಲವುಳ್ಳ /ತಿಳಿದುಕೊಳ್ಳಲು ಆಸೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कुतुकमस्यास्ति<br><b>प्रयोगाः - </b>"उदरं परिमाति मुष्टिना कुतुकी कोऽपि दमस्वसुः किमु"<br><b>उल्लेखाः - </b>नैष० २-३५<br><br>कुतुकिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹವುಳ್ಳ<br><br>कुतुकिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆನಂದವುಳ್ಳ<br><br>

कुतुप
कुतुप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೊಗಲಿನಿಂದ ಮಾಡಿದ ಎಣ್ಣೆಯ ಅಥವಾ ತುಪ್ಪದ ಚೀಲ /ಚಿಕ್ಕಪಾತ್ರೆ<br><b>निष्पत्तिः - </b>"डुपच्" (५-३-८९)<br><b>व्युत्पत्तिः - </b>अल्पा कुतूः<br><b>विस्तारः - </b>"कुतूः कुत्तेः स्नेहपात्रं सैवाल्पा कुतुपः पुमान्" - अम० ।<br><br>कुतुप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೧೫ ಮುಹೂರ್ತಗಳಿಂದ ಕೂಡಿದ ಹಗಲಿನ ೮ನೆಯ ಮುಹೂರ್ತ /ಹದಿನೈದು ಭಾಗಗಳುಳ್ಳ ಹಗಲಿನ ಎಂಟನೆಯ ಭಾಗ<br><br>

कुतू
कुतू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚರ್ಮದಿಂದ ಮಾಡಿದ ಎಣ್ಣೆಯ ಅಥವಾ ತುಪ್ಪದ ಪಾತ್ರೆ<br><b>निष्पत्तिः - </b>तनु (विस्तारे) - "कूः" बाहु० ।<br><b>व्युत्पत्तिः - </b>कुत्सितं तन्यते<br><b>विस्तारः - </b>"कुतूः कृत्तेः स्नेहपात्रम्" - अम० ।<br><br>

कुतूहल
कुतूहल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಸೆ /ಇಚ್ಛೆ /ಅಪೇಕ್ಷೆ<br><b>निष्पत्तिः - </b>हल (विलेखने) - "कः" (वा० ३-२-५)<br><b>व्युत्पत्तिः - </b>कुतूमिव हलति हृदयम्<br><b>प्रयोगाः - </b>"अतुलं विदधे कुतूहलं भुजमेतस्य भजन् महीभुजः"<br><b>उल्लेखाः - </b>नैष० २-७<br><br>कुतूहल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತ್ರೀಯರ ಸ್ವಭಾವಜನ್ಯವಾದ ವಿಲಾಸಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"विहृतं तपनं मौग्ध्यं विक्षेपश्च कुतूहलम्" । "रम्यवस्तुसमालोके लोलता स्यात्कुतूहलम्" ।<br><b>उल्लेखाः - </b>सा० द० ३-९२, सा० द० ३-१०९<br><br>कुतूहल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹ<br><br>कुतूहल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಶಸ್ತವಾದ /ಶ್ರೇಷ್ಠವಾದ<br><br>कुतूहल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅದ್ಭುತವಾದ /ಆಶ್ಚರ್ಯಕರವಾದ<br><br>

कुतूहलित
कुतूहलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುತೂಹಲ ಹೊಂದಿರುವ /ಆಸೆಯುಂಟಾಗಿರುವ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>कुतूहलमस्य सञ्जातम्<br><br>कुतूहलित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹ ಹೊಂದಿದ<br><br>

कुतूहलिन्
कुतूहलिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಸೆಯುಳ್ಳ /ಅಪೇಕ್ಷೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कुतूहलमस्यास्ति<br><b>प्रयोगाः - </b>"ददर्श सानुजो रामः शुश्राव च कुतूहली"<br><b>उल्लेखाः - </b>रघु० १५-६५<br><br>कुतूहलिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ಸಾಹವುಳ್ಳ<br><br>

कुतूहलिनी
कुतूहलिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कुतूहलिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><b>प्रयोगाः - </b>"करेण वातायनलम्बितेन स्पृष्टस्त्वया चण्डि कुतूहलिन्या"<br><b>उल्लेखाः - </b>रघु० १३-२१<br><br>

कुत्र
कुत्र<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲಿ /ಯಾವ ಸ್ಥಳದಲ್ಲಿ /ಯಾವುದರಲ್ಲಿ /ಯಾರಲ್ಲಿ<br><b>निष्पत्तिः - </b>किम् - "त्रल्" (५-३-१०)<br><b>प्रयोगाः - </b>"हा सीता केन नीता मम हृदयगता केन वाकुत्र दृष्टा"<br><b>उल्लेखाः - </b>हनु० ना०<br><br>

कुत्रापि
कुत्रापि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನಿರ್ದಿಷ್ಟಾರ್ಥ<br><br>

कुत्रचन
कुत्रचन<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನಿರ್ದಿಷ್ಟಾರ್ಥ<br><br>

कुत्रचित्
कुत्रचित्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅನಿರ್ದಿಷ್ಟಾರ್ಥ<br><b>प्रयोगाः - </b>"कुत्रचित्कनकनिर्मिताखिलः क्वापि यो विमलरत्नजः किल"<br><b>उल्लेखाः - </b>नैष० १८-११<br><br>

कुत्रत्य
कुत्रत्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲಿರುವ /ಎಲ್ಲಿ ವಾಸವಿರುವ<br><b>निष्पत्तिः - </b>कुत्र - "त्यप्" (४-२-१०४)<br><br>

कुत्स|अवक्षेपणे|कुत्सयते
कुत्स - अवक्षेपणे (चुरा० आत्म० सक० से०) कुत्सयते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ನಿಂದಿಸು /ಅವಹೇಳನ ಮಾಡು<br><br>

कुत्स
कुत्स<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಋಷಿ<br><b>निष्पत्तिः - </b>कु्त्स (अवक्षेपणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुत्सयते संसारम्<br><br>कुत्स<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುತ್ಸ ಋಷಿಯ ಮಕ್ಕಳು /ಕುತ್ಸ ಋಷಿಯ ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದವರು<br><b>निष्पत्तिः - </b>"अण्" (४-१-११४) । लुक् (२-४-६५)<br><b>व्युत्पत्तिः - </b>कुत्सस्य गोत्रापत्यानि पुमांसः<br><br>कुत्स<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿತವಾದ /ಅಂದವಿಲ್ಲದ /ಚೆನ್ನಾಗಿಲ್ಲದ<br><b>प्रयोगाः - </b>"स्वच्छस्वशैलेक्षितकुत्सबेरस्तां प्रत्यगान्नस्त्रितमं कुबेरः"<br><b>उल्लेखाः - </b>नैष० १०-१३<br><br>

कुत्सकुशिकिका
कुत्सकुशिकिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುತ್ಸವಂಶದವರಿಗೂ ಕುಶಿಕವಂಶದವರಿಗೂ ನಡೆಯುವ ಮದುವೆ<br><b>निष्पत्तिः - </b>"वुन्" (४-३-१२५)<br><b>व्युत्पत्तिः - </b>कुत्सानां कुशिकानां च मैथुनम्<br><br>

कुत्सन
कुत्सन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ<br><b>निष्पत्तिः - </b>कु्त्स (अवक्षेपणे) - "ल्युट्" (३-३-११५)<br><b>प्रयोगाः - </b>"नास्तिक्यं वेदनिन्दां च देवतानां च कुत्सनम् । द्वेषं दम्भं च मानं च क्रोधं तैक्ष्ण्यं च वर्जयेत् ॥"<br><b>उल्लेखाः - </b>मनु० ४-१६३<br><br>कुत्सन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕ್ಷೇಪಣೆ /ಖಂಡನೆ<br><br>कुत्सन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆಗೆ ಅವಕಾಶ ಕೊಡುವ ಒಂದು ಧರ್ಮ /ನಿಂದಾಸಾಧನವಾದ ಒಂದು ಧರ್ಮ<br><b>निष्पत्तिः - </b>कुत्स - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>कुत्स्यतेऽनेन<br><b>प्रयोगाः - </b>"कुत्सितानि कुत्सनैः"<br><b>उल्लेखाः - </b>पा० सू० २-१-५३<br><br>

कुत्सा
कुत्सा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ<br><b>निष्पत्तिः - </b>कु्त्स (अवक्षेपणे) - भावे "अः" (३-३-१०३)<br><br>कुत्सा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕ್ಷೇಪಣೆ /ಖಂಡನೆ<br><br>

कुत्सित
कुत्सित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಂದೆ /ದೂಷಣೆ<br><b>निष्पत्तिः - </b>कु्त्स (अवक्षेपणे) - भावे "क्तः" (३-३-११४)<br><br>कुत्सित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कु्त्स (अवक्षेपणे) - वर्तमाने कर्म० "क्तः" (३-२-१८८)<br><br>

कुत्स्य
कुत्स्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದ್ಯವಾದ /ದೂಷಣೆಗೆ ಅರ್ಹವಾದ /ಕೆಳಮಟ್ಟದ<br><b>निष्पत्तिः - </b>कु्त्स (अवक्षेपणे) - "ण्यत्" (३-१-१२४)<br><b>प्रयोगाः - </b>"कुत्स्याः स्युः कुपरीक्षकैर्न मणयो यैरर्धतः पातिताः"<br><b>उल्लेखाः - </b>भर्तृ० १-११<br><br>

कुत्स्यमान
कुत्स्यमान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿಸಲ್ಪಡುತ್ತಿರುವ /ದೂಷಿಸಲ್ಪಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कु्त्स (अवक्षेपणे) + यक्- "शानच्" (३-२-१२४)<br><br>

कुथ
कुथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದರ್ಭೆಹುಲ್ಲು<br><b>निष्पत्तिः - </b>कुथ (पूतीभावे) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>कुथ्यति<br><b>प्रयोगाः - </b>"शाद्वलेषु यदा शिश्ये वनान्ते वनगोचरा । कुथास्तरणतल्पेषु किंस्यात् सुखतरं ततः ॥"<br><b>उल्लेखाः - </b>रामा०<br><br>कुथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः / स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಣ್ಣದ ಕಂಬಳಿ /ಆನೆಯ ಬೆನ್ನಿನ ಮೇಲೆ ಹೊದಿಸುವ ಚಿತ್ರಗಂಬಳಿ<br><b>प्रयोगाः - </b>"चकासतं चारुचमूरुचर्मणा कुथेन नागेन्द्रमिवेन्द्रवाहनम्"<br><b>उल्लेखाः - </b>माघ० १-८<br><br>

कुथोदरी
कुथोदरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಭಕರ್ಣನ ಮಗನಾದ ನಿಕುಂಭನ ಮಗಳು /ಕೀಲಕಂಜನೆಂಬ ರಾಕ್ಷಸನ ಹೆಂಡತಿ<br><br>

कुदर्शन
कुदर्शन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೇದವಿರುದ್ಧವಾದ ದರ್ಶನ<br><b>व्युत्पत्तिः - </b>कुत्सितं दर्शनम्<br><br>कुदर्शन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ದೃಷ್ಟಿ /ಕೆಟ್ಟ ನೋಟ<br><br>

कुदिन
कुदिन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸಾವನ ದಿನ /ಸೂರ್ಯನ ಉದಯದಿಂದ ಮರುದಿನದ ಉದಯದವರೆಗಿನ ಕಾಲ<br><b>व्युत्पत्तिः - </b>कोः पृथिव्याः भ्रमणेन दिनम्<br><b>प्रयोगाः - </b>"उदयादुदयं भानोः सावनं तत् प्रकीर्तितम् । सावनानि स्युरेतेन यज्ञकालविधिस्तुतैः ॥"<br><b>उल्लेखाः - </b>सू० सि० १४-१८<br><br>कुदिन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಷದಲ್ಲಿ ನಿಷಿದ್ಧವಾದ ದಿವಸ /ತಿಥಿವಾರಾದಿ ಶುದ್ಧಿಯಿಲ್ಲದ ದಿವಸ<br><br>

कुदृष्टि
कुदृष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇದವಿರುದ್ಧವಾದ ಚಾರ್ವಾಕಾದಿ ದರ್ಶನ /ಅವೈದಿಕ ಮತ<br><b>प्रयोगाः - </b>"याः वेदबाह्याः स्मृतयः याश्च काश्च कुदृष्टयः । सर्वास्ता निष्फलाः प्रेत्य तमोनिष्ठा हि ताः स्मृताः ॥"<br><b>उल्लेखाः - </b>मनु० १२-९५<br><br>कुदृष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ದೃಷ್ಟಿ /ಅಸಭ್ಯವಾದ ನೋಟ<br><br>कुदृष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೋಡಲು ಶಕ್ತಿಯಿಲ್ಲದ ಕಣ್ಣು<br><b>व्युत्पत्तिः - </b>कुत्सिता दृष्टिः<br><br>कुदृष्टि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ದೃಷ್ಟಿಯುಳ್ಳ /ಅಸಭ್ಯವಾದ ನೋಟವುಳ್ಳ<br><br>कुदृष्टि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಕ್ತಿಕುಂದಿದ ಕಣ್ಣುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कुत्सिता दृष्टिः यस्य<br><br>

कुदेश
कुदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ದೇಶ /ವಾಸಕ್ಕೆ ಯೋಗ್ಯವಲ್ಲದ ದೇಶ<br><br>कुदेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನೇಕ ಉಪದ್ರವಗಳಿಂದ ಕೂಡಿದ ದೇಶ<br><b>व्युत्पत्तिः - </b>कुत्सितो देशः<br><br>

कुदेह
कुदेह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರ<br><b>व्युत्पत्तिः - </b>कुत्सितो देहोऽस्य<br><br>कुदेह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನಾರೋಗ್ಯದಿಂದ ಕೂಡಿದ ದೇಹ<br><br>कुदेह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಕಾರವಾದ ಶರೀರ<br><b>व्युत्पत्तिः - </b>कुत्सितो देहः<br><br>कुदेह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಕಾರವಾದ ಶರೀರವುಳ್ಳ<br><br>कुदेह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನಾರೋಗ್ಯದಿಂದ ಕೂಡಿದ ಮೈಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कुत्सितो देहः यस्य<br><br>

कुद्दाल
कुद्दाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋವಿದಾರ ವೃಕ್ಷ /ಕೆಂಗಾಂಚಾಳದ ಗಿಡ<br><b>निष्पत्तिः - </b>दल (विशरणे) +णिच् - "अण्" (३-२-१)शक० ।<br><b>व्युत्पत्तिः - </b>कुमुद्दालयति<br><br>कुद्दाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೆಲವನ್ನು ಅಗೆಯುವ ಗುದ್ದಲಿ /ಪಿಕಾಶಿ<br><b>प्रयोगाः - </b>"समासाद्य बिलं तच्चाप्यखनन् सगरात्मजाः । कुद्दालैर्ह्र्षुकैश्चैव समुद्रं यत्नमास्थिताः ॥"<br><b>उल्लेखाः - </b>भा० वन० १-७<br><b>विस्तारः - </b>कुद्दाल ಪೂರ್ವಪದವುಳ್ಳ ಬಹುವ್ರೀಹಿಯಲ್ಲಿ ಪಾದಶಬ್ದಕ್ಕೆ ಅಂತ್ಯಲೋಪವು ಬರುವುದಿಲ್ಲ. कुद्दालपादः ।<br><br>

कुद्दालक
कुद्दालक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೆಲವನ್ನು ಅಗೆಯುವ ಗುದ್ದಲಿ /ಪಿಕಾಶಿ<br><b>निष्पत्तिः - </b>स्वार्थे "कः"<br><br>

कुद्रङ्ग
कुद्रङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾದ್ವಾರದ ದಿಣ್ಣೆಯ ಮೇಲೆ ನಿರ್ಮಿಸಿರುವ ಕಾವಲುಗಾರನ ಮನೆ<br><b>निष्पत्तिः - </b>पृषो० ।<br><b>व्युत्पत्तिः - </b>कुत्सितो रङ्गः<br><br>

कुद्रव
कुद्रव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾರಕವೆಂಬ ಒಂದು ಧಾನ್ಯ<br><b>निष्पत्तिः - </b>द्रु (गतौ) - अन्तर्भावितण्यर्थः "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुं भूमिं द्रवति द्रावयति<br><br>

कुधान्य
कुधान्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾರಕ /ಶಾಮೆ /ನವಣೆ ಮುಂತಾದ ಧಾನ್ಯ<br><b>व्युत्पत्तिः - </b>कुत्सितं धान्यम्<br><b>प्रयोगाः - </b>"कोरदूषकश्यामाकनीवारशान्तनुवरकोद्दालकप्रियङ्गुमधूलिकानन्दीमुखीकुरुविन्दगवेधुकसरबरुकतोदपर्णीमुकुन्दकवेणुयवप्रभृतयः कुधान्यविशेषाः"<br><b>उल्लेखाः - </b>सुश्रुत० सूत्र० ४६-२१<br><br>

कुधी
कुधी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಬುದ್ಧಿ<br><b>व्युत्पत्तिः - </b>कुत्सिता धीः<br><br>कुधी<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಬುದ್ಧಿಯುಳ್ಳ /ಅವಿವೇಕಿ /ತಿಳುವಳಿಕೆಯಿಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>कुत्सिता धीः यस्य<br><b>प्रयोगाः - </b>"ये मूढाः प्रविहाय यान्ति कुधियो मिथ्याफलान्वेषिणः"<br><b>उल्लेखाः - </b>भर्तृ० २-७९<br><br>

कुध्र
कुध्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತ /ಬೆಟ್ಟ<br><b>निष्पत्तिः - </b>धृञ् (धारणे) - "कः" (३-२-५)<br><b>व्युत्पत्तिः - </b>कुं भूमिं धरति<br><br>

कुनख
कुनख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಖಗಳು ಕೆಟ್ಟು ಹೋಗುವ ಒಂದು ರೋಗ /ಉಗುರಿಗೆ ಏಟು ಬಿದ್ದು ಕೆಟ್ಟು ಹೋಗಿ ಅವನ್ನು ಒರಟಾಗಿಯೂ ಕಪ್ಪಗೂ ಮಾಡುವ ಒಂದು ರೋಗ<br><b>प्रयोगाः - </b>"अभिघातात् प्रदुष्टो यो नखो रूक्षोऽसितः खरः । भवेत्तु कुनखं विद्यात् कुलीनमिति सञ्ज्ञितम् ॥"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>कुनख<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರೋಗಗ್ರಸ್ತವಾದ ಉಗುರು<br><br>

कुनखिन्
कुनखिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುನಖವೆಂಬ ರೋಗವುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कुनखोऽस्त्यस्य<br><br>

कुनट
कुनट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಮ್ಮರ /ತಿಗಡು ಮರ<br><br>कुनट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯನಾದ ನಟ /ಅನರ್ಹವಾದ ಅಭಿನಯಕಾರ<br><b>व्युत्पत्तिः - </b>कुत्सितो नटः<br><br>

कुनटी
कुनटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯಳಾದ ನಟಿ<br><br>

कुनाथ
कुनाथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಯಜಮನ /ಅಯೋಗ್ಯನಾದ ಯಜಮಾನ<br><b>व्युत्पत्तिः - </b>कुत्सितो नाथः<br><br>कुनाथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜ /ದೊರೆ /ಭೂಪತಿ<br><b>व्युत्पत्तिः - </b>कोः भूमेः नाथः<br><br>कुनाथ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಯಜಮಾನನುಳ್ಳ<br><br>कुनाथ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ದೊರೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कुत्सितो नाथो यस्य<br><br>

कुनामन्
कुनामन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಹೆಸರುಳ್ಳವನು /ಬಹಳ ಕೃಪನ /ಜಿಪುಣ<br><b>व्युत्पत्तिः - </b>कुत्सितं नाम यस्य<br><br>

कुनाशक
कुनाशक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೀಟಕ ಸಂಧಿ<br><b>निष्पत्तिः - </b>णश (अदर्शने) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कुन्नाशयति<br><br>

कुनिषञ्ज
कुनिषञ्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತನೆಯ ಮನುವಿನ ಮಗ /ಬ್ರಹ್ಮಸಾವರ್ಣಿಯ ಮಗ<br><br>

कुनीति
कुनीति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ನೀತಿ /ಕೆಟ್ಟ ನಡವಳಿಕೆ<br><b>व्युत्पत्तिः - </b>कुत्सिता नीतिः<br><br>कुनीति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ನಡವಳಿಕೆಯುಳ್ಳ /ಕೆಟ್ಟ ಸ್ವಭಾವವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कुत्सिता नीतिः यस्य<br><br>

कुनृप
कुनृप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ದೊರೆ /ಅಯೋಗ್ಯನಾದ ರಾಜ<br><b>व्युत्पत्तिः - </b>कुत्सितो नृपः<br><br>

कुनृपति
कुनृपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ದೊರೆ /ಅಯೋಗ್ಯನಾದ ರಾಜ<br><b>व्युत्पत्तिः - </b>कुत्सितो नृपतिः<br><br>

कुपति
कुपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಗಂಡ<br><b>व्युत्पत्तिः - </b>कुत्सितः पतिः<br><br>

कुन्त
कुन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಸಾಯುಧ /ಕೊಂತವೆಂಬ ಒಂದು ಆಯುಧ<br><b>निष्पत्तिः - </b>उन्दी (क्लेदने) - "तः" बाहु० । शक० ।<br><b>व्युत्पत्तिः - </b>कुं भूमिमुनत्ति<br><b>प्रयोगाः - </b>"कुन्तेनोच्चैः सादिना हन्तुमिष्टान्नाजानेयो दन्तिनस्त्रस्यति स्म"<br><b>उल्लेखाः - </b>माघ० १८-२३<br><br>कुन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಗೋಧಿ<br><br>कुन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ಷುದ್ರಜಂತು<br><br>कुन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪ /ಉಗ್ರತೆ<br><b>विस्तारः - </b>"कुन्तः प्रासे चण्डभावे क्षुद्रजन्तौ गवेधुके" - मेदि० ।<br><br>

कुन्तल
कुन्तल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಶ /ಕೂದಲು<br><b>निष्पत्तिः - </b>ला (आदाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कुन्तं क्षुद्रजन्तुं लाति<br><b>प्रयोगाः - </b>"कापि कुन्तलसंव्यानसंयमव्यपदेशतः । बाहुमूलं कुचौ नाभिपङ्कजं दर्शयेत् स्फुटम् ॥"<br><b>उल्लेखाः - </b>सा० द०<br><br>कुन्तल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಷಕ /ಕುಡಿಯುವ ಪಾತ್ರೆ<br><br>कुन्तल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಡಿವಾಳ<br><br>कुन्तल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯವಧಾನ್ಯ<br><br>कुन्तल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಗೀತದಲ್ಲಿ ಒಂದು ಧ್ರುವಕ<br><br>कुन्तल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂತಲ ದೇಶ<br><b>प्रयोगाः - </b>"स्नाता तिष्ठति कुन्तलेश्वरसुता वारोऽङ्गराजस्वसुः द्यूते रात्रिरियं जिता कमलया देवी प्रसाद्याद्य च"<br><b>उल्लेखाः - </b>सा० द० ३<br><br>कुन्तल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೇಗಿಲು<br><b>विस्तारः - </b>"कुन्तलः स्याद्यवे देशे केशलाङ्गलयोरपि" - विश्व० । "कुन्तलश्चषके वाले यवे पुम्भूम्नि नीवृति" - मेदि० ।<br><br>

कुन्ति
कुन्ति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದೇಶ<br><b>प्रयोगाः - </b>"कुन्तयोवन्तयश्चैव तथैवापरकुन्तयः"<br><b>उल्लेखाः - </b>भा० भीष्म०<br><br>कुन्ति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂತಿ ದೇಶದ ರಾಜರು<br><b>प्रयोगाः - </b>"सुस्थलाश्च मुकुट्टाश्च कुलिन्दाः कुन्तिभिः सह । साल्वायनाश्च राजानः"<br><b>उल्लेखाः - </b>भा० सभा०<br><br>कुन्ति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿದರ್ಭದೇಶದ ಕ್ರಥವೆಂಬ ಒಬ್ಬ ರಾಜನ ಮಗ<br><b>प्रयोगाः - </b>"क्रथस्य कुन्तिः पुत्रोऽभूत् रुचिस्तस्य निर्वृतिः"<br><b>उल्लेखाः - </b>भाग० ९-३-२<br><br>

कुन्तिभोज
कुन्तिभोज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಂಡುರಾಜನ ಪತ್ನಿಯಾದ ಕುಂತಿಯ ಸಾಕುತಂದೆ<br><b>प्रयोगाः - </b>"सशूरो नाम यदुश्रेष्ठो वसुदेवपिताऽभवत् । तस्य कन्या पृथा नाम रूपेणासदृशी भुवि । पितुः स्वस्रीयपुत्राय सोऽनपत्याय वीर्यवान् । अग्र्यमग्रे प्रतिज्ञाय स्वस्यापत्यस्य वै तदा । अग्रजातेति तां कन्यां शूरोऽनुग्रहकाङ्क्षया । अददत् कुन्तिभोजाय स तां दुहितरं तदा ॥"<br><b>उल्लेखाः - </b>भा० आदि० ६८<br><br>

कुन्तिसुता
कुन्तिसुता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂತಿಭೋಜರಾಜನ ಮಗಳು /ವಸುದೇವನ ತಂಗಿ /ಪೃಥಾದೇವಿ /ಪಾಂಡವರ ತಾಯಿ<br><br>

कुन्ती
कुन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶೂರರಾಜನ ಮಗಳು /ಕುಂತಿಭೋಜನ ಸಾಕುಮಗಳು /ವಸುದೇವನ ತಂಗಿ /ಪಾಂಡುರಾಜನ ಪತ್ನಿ /ಪೃಥಾದೇವಿ<br><b>प्रयोगाः - </b>"शूरः पूज्याय वृद्धाय कुन्तिभोजाय तां ददौ । तस्मात् कुन्तीति विख्याता कुन्तिभोजात्मजा पृथा ॥"<br><b>उल्लेखाः - </b>हरिवं०<br><br>

कुन्तीतनय
कुन्तीतनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂತಿಯ ಮಕ್ಕಳು ೧)ಧರ್ಮರಾಜ ೨)ಭೀಮಸೇನ ೩)ಅರ್ಜುನ ೪)ಕರ್ಣ<br><b>व्युत्पत्तिः - </b>कुन्त्याः तनयः<br><br>

कुन्तीसुत
कुन्तीसुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂತಿಯ ಮಕ್ಕಳು ೧)ಧರ್ಮರಾಜ ೨)ಭೀಮಸೇನ ೩)ಅರ್ಜುನ ೪)ಕರ್ಣ<br><b>व्युत्पत्तिः - </b>कुन्त्याः सुतः<br><br>

कुन्तीपुत्र
कुन्तीपुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂತಿಯ ಮಕ್ಕಳು ೧)ಧರ್ಮರಾಜ ೨)ಭೀಮಸೇನ ೩)ಅರ್ಜುನ ೪)ಕರ್ಣ<br><b>व्युत्पत्तिः - </b>कुन्त्याः पुत्रः<br><br>

कुन्थु
कुन्थु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಥುಸಾಗರಸ್ವಾಮಿಗಳು /ಆರನೆಯ ಜೈನ ಚಕ್ರವರ್ತಿಗಳು<br><br>

कुन्द
कुन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कुमिति मान्तमव्ययम् । कुम् परभक्तिपरज्ञानादिभुवं ददाति<br><b>प्रयोगाः - </b>"कुमुदः कुन्दरः कुन्दः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"भक्तेभ्यः परभक्तिप्रदानात् कुन्द उच्यते" - निरुक्तिः ।<br><br>कुन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರನ ನವ ನಿಧಿಗಳಲ್ಲೊಂದು<br><br>कुन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚರಕಿ ಯಂತ್ರ /ಕಡೆತ ಹಿಡಿಯುವ ಯಂತ್ರ /ನಿಡುಸುರುಳೆಯ ಬೈರಿಗೆ<br><br>कुन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಲ್ಲೆ ಗಿಡ /ಕೋಲುಮಲ್ಲಿಗೆ<br><b>निष्पत्तिः - </b>कु (शब्दे) - "दन्" नुमागमश्च (उ० ४-९८)<br><b>विस्तारः - </b>"कुन्दो माध्येऽस्त्री मुकुन्दभ्रमिनिध्यन्तरेषु ना" - मेदि० ।<br><br>कुन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಗ್ಗುಳ /ಲೋಬಾನ /ಧೂಪಕ್ಕೆ ಉಪಯೋಗಿಸುವ ಒಂದು ಗೋಂದು<br><br>कुन्द<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಲ್ಲೆ ಹೂವು<br><b>प्रयोगाः - </b>"प्राथः कुन्दप्रसवशिथिलं जीवितं धारयेथाः"<br><b>उल्लेखाः - </b>मेघ० २-५०<br><br>कुन्द<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲ<br><br>कुन्द<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರತತ್ತ್ವ ಜ್ಞಾನ<br><br>

कुन्दक
कुन्दक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>कुन्द ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>कुन्द - स्वार्थे "कः"<br><br>

कुन्दचतुर्थी
कुन्दचतुर्थी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಘ ಮಾಸದ ಶುಕ್ಲಚತುರ್ಥಿ<br><br>

कुन्दम
कुन्दम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಡಾಲ /ಬೆಕ್ಕು /ಮಾರ್ಜಾರ<br><b>निष्पत्तिः - </b>माङ् (माने) - "डः" (वा० ३-२-४८)<br><b>व्युत्पत्तिः - </b>कुन्देन मीयते<br><b>विस्तारः - </b>"बिडालः कुन्दमो रक्तचारी दीप्ताक्षजाहकौ"- त्रिकाण्ड० ।<br><br>

कुन्दमी
कुन्दमी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಡಾಲ /ಬೆಕ್ಕು /ಮಾರ್ಜಾರ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

कुन्दर
कुन्दर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>रा (दाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कुन्दं परतत्त्वज्ञानं राति ददाति । कुं पापं दारयति वा ।<br><b>प्रयोगाः - </b>"कुमुदः कुन्दरः कुन्दः"<br><b>उल्लेखाः - </b>वि० स०<br><br>

कुन्दाल
कुन्दाल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುದ್ದಲಿ /ಅಗೆಯುವ ಸಾಧನ<br><br>

कुन्दिनी
कुन्दिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲಗಳಸಮೂಹ<br><b>निष्पत्तिः - </b>"इनिः" (वा० ४-२-५१)<br><b>व्युत्पत्तिः - </b>कुन्दानां समूहः<br><br>कुन्दिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲಗಳಿಂದ ಕೂಡಿದ ಪ್ರದೇಶ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-१३५)<br><b>व्युत्पत्तिः - </b>कुन्दान्यत्र सन्ति<br><br>

कुन्दिल
कुन्दिल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರಣ್ಯ /ಕಾಡು<br><br>

कुन्दु
कुन्दु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಷಿಕ /ಇಲಿ<br><b>निष्पत्तिः - </b>दृ (विदारणे) - "डुः" बाहु० ।<br><b>व्युत्पत्तिः - </b>कुं भूमिं दृणाति<br><br>

कुप|क्रोधे|कुप्यति
कुप - क्रोधे (दिवा० पर० अक० से०) कुप्यति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕೋಪಗೊಳ್ಳು /ಸಿಟ್ಟು ಮಾಡಿಕೋ<br><br>

कुपित
कुपित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪ /ಸಿಟ್ಟು<br><b>निष्पत्तिः - </b>कुप (क्रोधे) - भावे "क्तः" (३-३-११४)<br><b>प्रयोगाः - </b>"वासानां शिथिलतामुपनाभिह्रीनिरासमपदे कुपितानि"<br><b>उल्लेखाः - </b>किरा० ९-६५<br><br>कुपित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪಗೊಂಡ /ಸಿಟ್ಟು ಮಾಡಿಕೊಂಡ<br><b>प्रयोगाः - </b>"भजते कुपितोऽप्युदारधीरनुनीतिं नातिमात्रक्रमेण" । "जहौ न धैर्यं कुपितोऽपि पाण्डवः" ।<br><b>उल्लेखाः - </b>माघ० १६-५५, किरा० १४-१<br><br>

कुपिन्द
कुपिन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀಯಿಗೆಯವನು /ಮಗ್ಗದವನು<br><b>निष्पत्तिः - </b>कुप (क्रोधे) - "किन्दच्" (उ० ४-८६)<br><br>

कुपिनिन्
कुपिनिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಸ್ತ /ಮೀನು ಹಿಡಿಯುವವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११६)<br><b>व्युत्पत्तिः - </b>कुपिनी अस्त्यस्य<br><br>

कुपिनी
कुपिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೀನಿನ ಬುಟ್ಟಿ /ಮೀನುಗಳು ತುಂಬುವ ಬುಟ್ಟಿ<br><b>निष्पत्तिः - </b>गुपू (रक्षणे) - "इनिः" बाहु० । "ङीप्" पृषो० ।<br><b>व्युत्पत्तिः - </b>गुप्यते मत्स्या अत्र<br><br>

कुपुत्र
कुपुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಯೋಗ್ಯನಾದ ಮಗ /ಕೆಟ್ಟ ಮಗ<br><b>व्युत्पत्तिः - </b>कुत्स्तः पुत्रः<br><br>कुपुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿಯ ಮಗ ೧)ಅಂಗಾರಕಗ್ರಹ ೨)ನರಕಾಸುರ<br><b>व्युत्पत्तिः - </b>कोः पुत्रः<br><br>

कुपूय
कुपूय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀಚ /ನಿಕೃಷ್ಟ /ತುಚ್ಛ<br><b>निष्पत्तिः - </b>पूयी (विशरणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुत्सितं पूयते<br><b>विस्तारः - </b>"कुपूयकुत्सितावद्यखेटगर्ह्याणकाः" - अम० ।<br><br>

कुप्य
कुप्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿನ್ನ ಬೆಳ್ಳಿ ಬಿಟ್ಟು ಉಳಿದ ಲೋಹ /ಹಿತ್ತಾಳೆ ತಾಮ್ರ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>गुपू (रक्षणे) - "क्यप्" (३-१-११४) कुत्वं च ।<br><br>

कुप्यत्
कुप्यत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪಗೊಳ್ಳುತ್ತಿರುವ /ಸಿಟ್ಟುಗೊಳ್ಳಿತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कुप (क्रोधे) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"सोमाय कुप्यन्निव विप्रयुक्तः स सोममाचामति हूयमानम्"<br><b>उल्लेखाः - </b>नैष० ८-७४<br><br>

कुप्यन्ती
कुप्यन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪಗೊಳ್ಳುತ್ತಿರುವ /ಸಿಟ್ಟುಗೊಳ್ಳಿತ್ತಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कुप्यशाला
कुप्यशाला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಮ್ರ ಹಿತ್ತಾಳೆ ಮುಂತಾದ ಲೋಹಪಾತ್ರೆಗಳನ್ನು ತಯಾರಿಸುವ ಮನೆ<br><b>व्युत्पत्तिः - </b>कुप्यस्य तत्पात्रनिर्माणस्य शाला<br><br>

कुबेर
कुबेर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಕ್ಷರಾಜ /ಧನಾಧಿಪ /ಉತ್ತರದಿಕ್ಕಿನ ಅಧಿಪತಿ<br><b>व्युत्पत्तिः - </b>कुत्सितं बेरं शरीरं यस्य<br><b>प्रयोगाः - </b>"कुबेरस्य मनःशल्यं शंसतीव पराभवम्"<br><b>उल्लेखाः - </b>कुमा० २-२२<br><br>कुबेर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಂದಿಮರ<br><b>विस्तारः - </b>"कुबेरस्तु धनदे नन्दिपादपे"- हेम० ।<br><br>कुबेर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಕಾರವಾದದೇಹ /ಅಂದವಿಲ್ಲದ ಮೈ<br><b>व्युत्पत्तिः - </b>कुत्सितं बेरम्<br><br>

कुबेरक
कुबेरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಕ್ಷರಾಜ /ಧನಾಧಿಪ /ಉತ್ತರದಿಕ್ಕಿನ ಅಧಿಪತಿ<br><b>निष्पत्तिः - </b>वा "कप्" (५-४-१५४)<br><br>

कुबेरदिश्
कुबेरदिश्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರನು ಒಡೆಯನಾಗಿರುವ ಉತ್ತರದಿಕ್ಕು<br><br>

कुबेराक्षी
कुबेराक्षी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸುರುಪಾದರಿ ಗಿಡ<br><b>निष्पत्तिः - </b>"षच्" (५-४-११३)<br><b>व्युत्पत्तिः - </b>कुबेरस्य अक्षीव पिङ्गलं पुष्पमस्याः<br><br>

कुबेराचल
कुबेराचल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಲಾದ ಪರ್ವತ<br><b>व्युत्पत्तिः - </b>कुबेरस्य अचलः<br><br>

कुबेरार्द्रि
कुबेरार्द्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಲಾದ ಪರ್ವತ<br><b>व्युत्पत्तिः - </b>कुबेरस्य अद्रिः<br><br>

कुब्ज
कुब्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತರಣೆ ಗಿಡ<br><br>कुब्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಖಡ್ಗ /ಕತ್ತಿ<br><br>कुब्ज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೂನು /ಬೆನ್ನುಮೂಳೆ ಬಗ್ಗಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"हृदयं यदि वा पृष्ठमुन्नतं क्रमशः सरुक् । क्रुद्धो वायुर्यदा कुर्यात्तदा तं कुब्जमादिशेत् ॥"<br><br>कुब्ज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಾಮನ /ಕುಳ್ಳ<br><br>कुब्ज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಿಡ್ದ /ಗೂನ<br><b>निष्पत्तिः - </b>उब्ज (आर्जवे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कौ उब्जति<br><b>प्रयोगाः - </b>"कुब्जा नीचतयैव यान्ति शनकैरात्मेक्षणाशङ्किनः"<br><b>उल्लेखाः - </b>रत्ना० २-३<br><br>

कुब्जा
कुब्जा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೂನು ಮೈಯುಳ್ಳ ಹೆಂಗಸು<br><br>कुब्जा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಸನ ಮನೆಯಲ್ಲಿದ್ದ ಒಬ್ಬ ದಾಸಿ<br><br>कुब्जा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಶರಥನ ಕಿರಿಯ ಹೆಂಡತಿಯಾದ ಕೈಕಯಿಯ ದಾಸಿ<br><br>

कुब्र
कुब्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರಣ್ಯ /ಕಾಡು<br><b>निष्पत्तिः - </b>कुबि (आच्छादने) - "रन्" (उ० २-२९) निपा० ।<br><b>विस्तारः - </b>"कुब्रमरण्यम्" - सि० कौ० ।<br><br>कुब्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞಕುಂಡ<br><br>कुब्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಣಾಭರಣ /ಕಿವಯ ಒಡವೆ /ಹತ್ತಕಡಕು<br><br>कुब्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಕಟ /ಗಾಡಿ<br><br>कुब्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಾರ<br><br>

कुभार्य
कुभार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಹೆಂಡತಿಯುಳ್ಳವನು /ಅಯೋಗ್ಯಳಾದ ಪತ್ನಿಯುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>कुत्सिता भार्या यस्य<br><br>

कुभार्या
कुभार्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಹೆಂಡತಿ<br><br>

कुभृत्
कुभृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತ /ಬೆಟ್ಟ<br><b>निष्पत्तिः - </b>डुभृञ् (धारणपोषयोः) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>कुं पृथिवीं बिभर्ति<br><br>कुभृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೭ ಸಂಖ್ಯೆ<br><br>

कुमार
कुमार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಮಾರಸ್ವಾಮಿ /ಕಾರ್ತಿಕೇಯ /ಷಣ್ಮುಖ<br><b>निष्पत्तिः - </b>मृङ् (प्राणित्यागे) + णिच् - "अच्" (३-१-१३४) । कुमार (क्रीडायाम्) + णिच् - "अच्" वा ।<br><b>व्युत्पत्तिः - </b>कौ मारयति दुष्टान् । कुमारयति क्रीडति ।<br><b>प्रयोगाः - </b>"रराज तेषां व्रजतां सुराणां मध्ये कुमारोऽधिककान्तियुक्तः"<br><b>उल्लेखाः - </b>कुमा० १३-८<br><br>कुमार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರ /ಮಗ<br><b>प्रयोगाः - </b>"नीराजमाने स्फटिकाचलेन सानन्दनिर्दिष्टदृशं कुमारे"<br><b>उल्लेखाः - </b>कुमा० १२-२१<br><br>कुमार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುವರಾಜ /ರಾಜಕುಮಾರ<br><br>कुमार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶುಕ /ಗಿಣಿ<br><br>कुमार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವಪಾಲಕ /ಕುದುರೆಯ ಯೋಗಕ್ಷೇಮ ನೋಡಿಕೊಳ್ಳುವವನು<br><br>कुमार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರುಣ ವೃಕ್ಷ /ವಲಸೆ ಗಿಡ<br><br>कुमार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಲಕ /೫ ವರ್ಷ ವಯಸ್ಸಿನ ಹುಡುಗ<br><b>प्रयोगाः - </b>"कौमारं पञ्चवर्षान्तं पौगण्डं दशमावधि"<br><b>उल्लेखाः - </b>भाग० १०<br><b>विस्तारः - </b>"कुमारः स्यात् शुके स्कन्दे युवराजेऽश्वचारके । बालके वरुणाद्रौ ना न द्वयोर्जात्यकाञ्चने" -मेदि० ।<br><br>कुमार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶುದ್ಧವಾದ ಚಿನ್ನ<br><br>

कुमारी
कुमारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ರಿ /ಮಗಳು<br><br>कुमारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮದುವೆಯಾಗದಿರುವ ಕನ್ಯೆ /೧೨ ವರ್ಷ ವಯಸ್ಸಿನ ಕನ್ಯೆ<br><b>प्रयोगाः - </b>"त्रीणि वर्षाण्युदीक्षेत कुमार्यृतुमती सती"<br><b>उल्लेखाः - </b>मनु० ९-९०<br><b>विस्तारः - </b>"सम्प्राप्ते द्वादशे वर्षे कुमारीत्यभिधीयते" - स्मृतिः ।<br><br>कुमारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಗೋರಂಟಿ<br><br>कुमारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನವಮಾಲಿಕೆ /ಹೆಜ್ಜಾಜಿ<br><br>कुमारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರ್ವತಿ /ಗೌರಿ<br><br>कुमारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನದಿ<br><br>कुमारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣುಕ್ರಾಂತಿ ಗಿಡ<br><br>कुमारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಂಬೂದ್ವೀಪ<br><b>विस्तारः - </b>"कुमारी शैलतनयानवमाल्योर्नदीभिदि । सहापराजिताकन्याजम्बुद्वीपेषु च स्त्रियाम्" - मेदि० ।<br><br>कुमारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮದುವೆಯಾಗದಿರುವ ಕನ್ಯೆ /೧೨ ವರ್ಷ ವಯಸ್ಸಿನ ಕನ್ಯೆ<br><b>निष्पत्तिः - </b>कुमार - "ङीप्" (४-१-२०)<br><b>प्रयोगाः - </b>"त्रीणि वर्षाण्युदीक्षेत कुमार्यृतुमती सती । ऊर्ध्वं तु कालोदेतस्माद्विन्देत सदृशं पतिम् ॥"<br><b>उल्लेखाः - </b>मनु० ९-९०<br><br>कुमारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನದಿ<br><br>कुमारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರ್ವತಿ /ಗೌರಿ<br><br>कुमारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನವಮಲ್ಲಿಕೆ<br><br>कुमारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಂಬೂದ್ವೀಪ<br><br>कुमारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣುಕ್ರಾಂತಿ ಗಿಡ<br><br>कुमारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣಗೋರಂಟಿ ಗಿಡ<br><br>कुमारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಜ್ಜಾಜಿ /ವೀರಜಾಜಿ<br><br>कुमारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೊಡ್ಡ ಜಾತಿಯ ಯಾಲಕ್ಕಿ<br><b>विस्तारः - </b>"कुमारः शैलतनयानवमाल्योर्नदीभिदि । सहापराजिताकन्याजम्बुद्वीपेषु च स्त्रियाम्" - मेदि० ।<br><br>

कुमारधारा
कुमारधारा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾಭಾರತದಲ್ಲಿ ಉಕ್ತವಾಗಿರುವ ಒಂದು ತೀರ್ಥ<br><b>प्रयोगाः - </b>"पितामहस्य सरसः प्रस्रुता लोकपावनी । कुमारधारा तत्रैव त्रिषु लोकेषु विश्रुता । यत्र स्नात्वा कृतार्थोस्मीत्यात्माममवगच्छति ॥"<br><b>उल्लेखाः - </b>भा० वन० ८१<br><br>

कुमारपालन
कुमारपालन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಲಿವಾಹನ ರಾಜ<br><br>कुमारपालन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಲಕರನ್ನು ಕಾಪಾಡುವುದು<br><br>कुमारपालन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾಲಕರ ಯೋಗಕ್ಷೇಮವನ್ನು ನೋಡಿಕೊಳ್ಳುವವನು<br><b>निष्पत्तिः - </b>पाल (रक्षणे) + णिच् - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुमारं पालयति<br><br>

कुमारभृत्या
कुमारभृत्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಲಗಿತ್ತಿತನ /ಧಾತ್ರಿಯ ಕಾರ್ಯ /ಆಯುರ್ವೇದದ ೮ ಅಂಗಗಳಲ್ಲೊಂದು<br><b>व्युत्पत्तिः - </b>कुमारस्य भृत्या भरणम्<br><br>

कुमारयु
कुमारयु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುವರಾಜ /ರಾಜಕುಮಾರ<br><b>निष्पत्तिः - </b>या (प्रापणे) - "कुः" (उ० १-३७)<br><b>व्युत्पत्तिः - </b>कुमारं कौमारं याति<br><br>

कुमारललिता
कुमारललिता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮವೃತ್ತದ ೭ನೆಯ ಛಂದಸ್ಸಿನ ಒಂದು ವೃತ್ತ<br><b>प्रयोगाः - </b>"कुमारललिता ज्स्गाः"<br><b>उल्लेखाः - </b>वृ० र०<br><br>

कुमारवाहिन्
कुमारवाहिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಯೂರ /ನವಿಲು<br><b>निष्पत्तिः - </b>वह (प्रापणे) - "णिनिः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुमारं स्कन्दं वहति<br><br>

कुमारश्रमणा
कुमारश्रमणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಲ್ಯದಲ್ಲಿ ಸಂನ್ಯಾಸವನ್ನು ಪಡೆದ ಜೈನ ಹೆಂಗಸು /ಬಾಲಸಂನ್ಯಾಸಿನಿ<br><b>निष्पत्तिः - </b>पुंवद्भावः (२-१-७०)<br><b>व्युत्पत्तिः - </b>कुमारी श्रमणा<br><br>

कुमारसम्भव
कुमारसम्भव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಷಣ್ಮುಖನ ಉತ್ಪತ್ತಿಯನ್ನು ವರ್ಣಿಸುವ ಕಾಳಿದಾಸ ಕವಿಯ ಒಂದು ಕಾವ್ಯ<br><b>निष्पत्तिः - </b>"अण्" (४-३-८७) । अणो "लुप्" (४-२-६०)<br><b>व्युत्पत्तिः - </b>कुमारस्य सम्भवमधिकृत्य कृतो ग्रन्थः<br><br>

कुमारसू
कुमारसू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಂಗಾನದಿ<br><br>कुमारसू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾರ್ವತಿ /ಗೌರಿ<br><b>निष्पत्तिः - </b>षूङ् (प्राणिगर्भवोमोचने) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>कुमारं स्कन्दे सूते<br><br>

कुमारिका
कुमारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮದುವೆಯಾಗದಿರುವ ಕನ್ಯೆ /೧೨ ವರ್ಷ ವಯಸ್ಸಿನ ಕನ್ಯೆ<br><b>निष्पत्तिः - </b>कुमारी - स्वार्थे "कन्" (५-४-५)<br><br>कुमारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಲಿಕೆ /ಕನ್ಯೆ<br><br>कुमारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೊಡ್ಡ ಜಾತಿಯ ಯಾಲಕ್ಕಿ<br><br>कुमारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನವಮಲ್ಲಿಕೆ<br><br>कुमारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭಾರತವರ್ಷದ ೯ ಖಂಡಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"ऐन्द्रं कशेरुशकलं किल ताम्रपर्णमन्यद्गभस्ति मदनश्च कुमारिकाख्यम् । नागं च सौम्यमिह वारुणमन्त्यखण्डं गन्धर्वसञ्ज्ञमिति भारतवर्षमध्ये । वर्णव्यवस्थितिरिहैव कुमारिकाख्ये शेषेषु चान्त्यजजना निवसन्ति सर्वे ॥"<br><br>

कुमारिन्
कुमारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಮಾರರುಳ್ಳವನು /ಮಕ್ಕಳುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कुमारा अस्य सन्ति<br><br>

कुमारिल
कुमारिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಮಾರಿಲ ಭಟ್ಟಾಚಾರ್ಯರು /ಒಬ್ಬ ಮೀಮಾಂಸಕರು<br><b>प्रयोगाः - </b>"साधु कुमारिल साधुप्रज्ञोस्यायुष्मन्"<br><b>उल्लेखाः - </b>प्रबोध० ६<br><br>

कुमारीक्रीडनक
कुमारीक्रीडनक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಮಕ್ಕಳ ಆಟದ ಸಾಮಾನು<br><b>निष्पत्तिः - </b>क्रीडृ (विहारे) - "ल्युट्" (३-३-११७) । स्वार्थे "कः"<br><b>व्युत्पत्तिः - </b>कुमारीभिः क्रीड्यतेऽनया<br><br>

कुमारीतनय
कुमारीतनय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದುವೆಯಾಗದಿರುವ ಕನ್ಯೆಯಲ್ಲಿ ಹುಟ್ಟಿದ ಮಗ ೧)ವ್ಯಾಸಮಹರ್ಷಿ ೨)ಕರ್ಣ<br><b>विस्तारः - </b>"पितृवेश्मनि कन्या तु यं पुत्रं जनयेद्रहः । तं कानीनं वदेन्नाम्ना वोढुः कन्यासमुद्भवम् ॥" - मनु० ९-१७२<br><br>

कुमारीपुत्र
कुमारीपुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದುವೆಯಾಗದಿರುವ ಕನ್ಯೆಯಲ್ಲಿ ಹುಟ್ಟಿದ ಮಗ ೧)ವ್ಯಾಸಮಹರ್ಷಿ ೨)ಕರ್ಣ<br><br>

कुमारीसुत
कुमारीसुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದುವೆಯಾಗದಿರುವ ಕನ್ಯೆಯಲ್ಲಿ ಹುಟ್ಟಿದ ಮಗ ೧)ವ್ಯಾಸಮಹರ್ಷಿ ೨)ಕರ್ಣ<br><br>

कुमित्र
कुमित्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಸ್ನೇಹಿತ<br><b>व्युत्पत्तिः - </b>कुत्सितं मित्रम्<br><br>

कुमुद्
कुमुद्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ತೋತ್ಪಲ /ಕೆಂದಾವರೆ<br><b>निष्पत्तिः - </b>मुद (हर्षे) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>कौ मोदते<br><b>विस्तारः - </b>"रक्तोत्पलमलिप्रियम् । लक्ष्मीगृहं कुमुच्चाय" - त्रिकाण्ड० ।<br><br>कुमुद्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿನೈದಿಲೆ<br><br>कुमुद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಲೋಭಿ /ಕೃಪಣ<br><b>व्युत्पत्तिः - </b>कुत्सिता मुदस्य<br><b>विस्तारः - </b>"कुमुद् त्रिषु स्यात् कृपणे कैरवे तु नपुंसकम्" - मेदि० ।<br><br>कुमुद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೃಪ್ತಿಯಿಲ್ಲದವನು /ಸಂತೋಷವಿಲ್ಲದವನು<br><br>

कुमुद
कुमुद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>मुद (हर्षे) - "कः" (वा० ३-२-५)<br><b>व्युत्पत्तिः - </b>कौ प्रकृतिमण्डल एव तैः सह मोदते<br><b>प्रयोगाः - </b>"कुमुदः कुन्दरः कुन्दः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"प्राकृते मण्डले भूमौ मोदनाच्च महात्मभिः । मुक्तिभूमिप्रदानाद्वा कुमुदः परिकीर्तितः ॥" - निरुक्तिः ।<br><br>कुमुद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ನಾಗರಾಜ /ಕುಶಮಹಾರಾಜನ ಪತ್ನಿಯಾದ ಕುಮುದ್ವತಿಯ ಸಹೋದರ<br><b>प्रयोगाः - </b>"नागेन लौल्यात् कुमुदेन नुनमुपात्तमन्तर्ह्रदवासिना तत्"<br><b>उल्लेखाः - </b>रघु० १६-७६<br><br>कुमुद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣ ದಿಗ್ಗಜ<br><br>कुमुद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ವಾನರ<br><br>कुमुद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಪೂರ<br><br>कुमुद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಲ್ಮಲಿದ್ವೀಪದ ಒಂದು ಅಪರ್ವತ<br><br>कुमुद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ದೈತ್ಯ<br><br>कुमुद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿನೈದಿಲೆ<br><b>निष्पत्तिः - </b>मुद (हर्षे) - "कः" (३-१-१३५) । (वा० ३-२-५)<br><b>व्युत्पत्तिः - </b>कौ मोदते<br><b>प्रयोगाः - </b>"कलरवमुपगीते षट्पदौघेन धत्तः कुमुदकमलखण्डे तुल्यरूपामवस्थाम्"<br><b>उल्लेखाः - </b>माघ० ११-१५<br><br>कुमुद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಕ್ತೋತ್ಪಲ /ಕೆಂದಾವರೆ<br><br>

कुमुदा
कुमुदा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶೀವನೆಯ ಮರ<br><br>कुमुदा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಿಯ ಶಿವನಿ ಮರ<br><b>विस्तारः - </b>"कुमुदः कपौ । दिङ्नागनागयोर्दैत्यभेदे च सितोत्पले । कुमुदा कुम्भीगम्भार्योः" - हेम० ।<br><br>कुमुदा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कुमुद ಪದದ ಅರ್ಥ<br><br>

कुमुदानाथ
कुमुदानाथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>व्युत्पत्तिः - </b>कुमुदस्य नाथः<br><br>

कुमुदापति
कुमुदापति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>व्युत्पत्तिः - </b>कुमुदस्य पतिः<br><br>

कुमुदबन्धु
कुमुदबन्धु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>व्युत्पत्तिः - </b>कुमुदस्य बन्धुः<br><br>

कुमुदबान्धव
कुमुदबान्धव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>व्युत्पत्तिः - </b>कुमुदस्य बान्धवः<br><br>

कुमुदवती
कुमुदवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಮುದಲತೆ /ಬಿಳಿನೈದಿಲೆ ಬಳ್ಳಿ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४) । मस्य वः (८-२-९)<br><b>व्युत्पत्तिः - </b>कुमुदानि सन्त्यस्याम्<br><br>

कुमुदाकर
कुमुदाकर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿನೈದಿಲೆಗೆ ಸ್ಥಾನವಾದ ಸರೋವರ<br><b>व्युत्पत्तिः - </b>कुमुदानामाकरः<br><b>प्रयोगाः - </b>"शुक्लैः सतारैर्मुकुलीकृतैः स्थुलैः कुमुद्वतीनां कुमुदाकरैरिव"<br><b>उल्लेखाः - </b>माघ० १२-४<br><br>

कुमुदिका
कुमुदिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಿಯ ಶಿವನಿ ಮರ<br><b>निष्पत्तिः - </b>मुद (हर्षे) - "कः" (३-१-१३५) । (वा० ३-२-५) । स्वार्थे "कन्" (५-३-७५)<br><b>व्युत्पत्तिः - </b>कौ मोदते<br><br>

कुमुदिनी
कुमुदिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಮುದಗಳಿಂದ ಕೂಡಿದದೇಶ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-१३५)<br><b>व्युत्पत्तिः - </b>कुमुदान्यत्र सन्ति<br><b>प्रयोगाः - </b>"सपदि कुमुदिनीभिर्मीलितं हा क्षपापि क्षयमगमदपेतास्तारकास्ताः समस्ताः"<br><b>उल्लेखाः - </b>माघ० ११-२४<br><br>कुमुदिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಮುದ ಲತೆ /ಬಿಳಿನೈದಿಲೆಯ ಬಳ್ಳಿ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-१३५)<br><b>व्युत्पत्तिः - </b>कुमुदानि सन्त्यस्याम्<br><br>कुमुदिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಮುದಗಳಸಮೂಹ<br><b>निष्पत्तिः - </b>"इनिः" (वा० ४-२-५१)<br><b>व्युत्पत्तिः - </b>कुमुदानां समूहः<br><br>

कुमुद्वत्
कुमुद्वत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಿಳಿನೈದಿಲೆ ಹೂವು ಹೆಚ್ಚಾಗಿರುವ ಪ್ರದೇಶ<br><b>निष्पत्तिः - </b>"ड्मतुप्" (४-२-८७) । मस्य वः (८-२-१०)<br><b>व्युत्पत्तिः - </b>कुमुदानि सन्त्यत्र<br><b>प्रयोगाः - </b>"हंसश्रेणीषु तारासु कुमुद्वत्सु च वारिषु" - रघु० ४-१९<br><br>कुमुद्वत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅತೃಪ್ತಿಯುಳ್ಳ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४) । मस्य वः (८-२-९)<br><b>व्युत्पत्तिः - </b>कुमुदस्यास्ति<br><br>

कुमुद्वती
कुमुद्वती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कुमुद्वत् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>कुमुद्वती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿನೈದಿಲೆ ಲತೆ<br><b>निष्पत्तिः - </b>कुमुद्वत् - "ङीप्" (४-१-६)<br><b>प्रयोगाः - </b>"ग्लपयति यथा शशङ्कं न तथा हि कुमुद्वतीं दिवसः"<br><b>उल्लेखाः - </b>शाकु० ३-१४<br><br>कुमुद्वती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿನೈದಿಲೆ ಹೂವು ಹೆಚ್ಚಾಗಿರುವ ಪ್ರದೇಶ<br><b>निष्पत्तिः - </b>"ड्मतुप्" (४-२-८७) ।"ङीप्" (४-१-६)<br><b>व्युत्पत्तिः - </b>कुमुदानि अत्र सन्ति<br><b>प्रयोगाः - </b>"शुक्लैः सतारैर्मुकुलीकृतैः स्थुलैः कुमुद्वतीनां कुमुदाकरैरिव"<br><b>उल्लेखाः - </b>माघ० १२-४<br><br>कुमुद्वती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಶಮಹಾರಾಜನ ಪತ್ನಿ /ಕುಮುದನೆಂಬ ಸರ್ಪರಾಜನ ಸಹೋದರಿ<br><b>प्रयोगाः - </b>"अतिथिं नाम काकुत्स्थात् पुत्रमाप कुमुद्वती"<br><b>उल्लेखाः - </b>रघु० १७-१<br><br>

कुम्बा
कुम्बा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞಶಾಲೆಯ ಸುತ್ತಲೂ ಕಟ್ಟಿದ ಬೇಲಿ<br><b>निष्पत्तिः - </b>कुबि (आच्छादने) - "अङ्" (३-३-१०५)<br><b>व्युत्पत्तिः - </b>कुम्ब्यतेऽनया<br><br>कुम्बा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಪ್ಪಬಟ್ಟೆ /ದುಪ್ಪಟಿ<br><b>विस्तारः - </b>"कुम्बा उ स्थूलशाटकः" - त्रिकाण्ड० ।<br><br>

कुम्भ
कुम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೋಹದ ಕೊಡ /ಬಿಂದಿಗೆ<br><b>निष्पत्तिः - </b>उम्भ (पूरणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कु उम्भति<br><b>प्रयोगाः - </b>"तदग्रजाग्रत्पृथुशातकुम्भकुम्भौ न सम्भावयति स्तनौ कः"<br><b>उल्लेखाः - </b>नैष० १०-१२२<br><br>कुम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ತಲೆಯ ಮುಂಭಾಗದ ಮಾಂಸಪಿಂಡ<br><b>प्रयोगाः - </b>"मतः किमैरावतकुम्भकैतवप्रगल्भपीनस्तनदिग्धवस्तव"<br><b>उल्लेखाः - </b>नैष० ९-५२<br><br>कुम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಭಕರ್ಣನ ಒಬ್ಬ ಮಗ<br><br>कुम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಹ್ಲಾದನ ಒಬ್ಬ ಮಗ<br><b>प्रयोगाः - </b>"प्रह्लादस्य त्रयः पुत्राः ख्याताः सर्वत्र भारत । विशेषतश्च कुम्भश्च निकुम्भ इति नामतः ॥"<br><b>उल्लेखाः - </b>भा० आदि०<br><br>कुम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜ್ಯೋತಿಷದಲ್ಲಿ ಕುಂಭ ರಾಶಿ<br><br>कुम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಣಾಯಾಮದ ಅಂಗವಾದ ಶ್ವಾಸನಿರೋಧ /ಪ್ರಾಣಾಯಾಮದಲ್ಲಿ ಬಾಯಿ ಮತ್ತು ಮೂಗುಗಳನ್ನು ಮುಚ್ಚಿಕೊಂಡು ಶ್ವಾಸವನ್ನು ತಡೆಯುವುದು<br><br>कुम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇಶ್ಯೆಯ ಪತಿ /ವಿಟಪುರುಷ /ಕಾಮುಕ<br><br>कुम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೀವ್ರವಾಗಿ ಬಲಿತಿರುವ ಕಾಮಾಲೆರೋಗ<br><b>विस्तारः - </b>"नेत्ररुक्कामला क्लीबं कुम्भः स्यात्मा महत्तरा" - वैज० ।<br><br>कुम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೨ ಖಂಡಗಳ ಅಳತೆ /೨೦ ಕೊಳಗದ ಅಳತೆ<br><b>विस्तारः - </b>"दशद्रोणा भवेत्खारी कुम्भस्तु द्रोणविंशतिः"<br><br>कुम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಗಿನ ಅವಸರ್ಪಿಣಿಯಲ್ಲಿ ೧೯ನೆಯ ಅರ್ಹಂತರ ತಂದೆ<br><br>कुम्भ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಪು ತಿಗಡೆ ಮರ<br><br>कुम्भ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಗ್ಗುಳ<br><br>

कुम्भा
कुम्भा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇಶ್ಯೆ /ಸೂಳೆ<br><br>

कुम्भी
कुम्भी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸುರು ಪಾದರಿ<br><br>कुम्भी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರುಕಾಗೆ<br><br>कुम्भी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಮಡಕೆ<br><br>

कुम्भी
कुम्भी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಿಯ ಶಿವನಿ ಮರ<br><b>विस्तारः - </b>"कुम्भो वेश्यापतौ घटे । द्विपाङ्गे राक्षसे राशौ कुम्भं त्रिवृति गुग्गुलौ । कुम्भ्युखायां पाटलायां वारिपर्ण्यां च कट्फले" - हेम० ।<br><br>कुम्भी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಡಕೆ<br><br>कुम्भी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸುರು ಪಾದರಿ ಗಿಡ<br><br>कुम्भी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೀರುಕಾಗೆ<br><br>कुम्भी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಿಯ ಶಿವನಿ ಮರ<br><b>विस्तारः - </b>"कुम्भ्युखायां पाटलायां वारिपर्ण्यां च कट्फले" - हेम० ।<br><br>

कुम्भक
कुम्भक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಣಾಯಾಮದ ಅಂಗವಾದ ಶ್ವಾಸನಿರೋಧ<br><b>निष्पत्तिः - </b>कुम्भ - स्वार्थे "कः"<br><b>विस्तारः - </b>पूरकः, कुम्भकः, रेचकः - ಇವು ಪ್ರಾಣಾಯಾಮದ ಅಂಗಗಳು<br><br>

कुम्भकर्ण
कुम्भकर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಕ್ಷಸ /ವಿಶ್ರವಸ್ಸಿನ ಮಗ /ರಾವಣನ ತಮ್ಮ<br><b>व्युत्पत्तिः - </b>कुम्भाविव कर्णावस्य<br><br>

कुम्भकामला
कुम्भकामला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಮಾಲೆ ರೋಗದ ಒಂದು ಭೇದ<br><br>

कुम्भकार
कुम्भकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಡಕೆಯನ್ನು ತಯಾರಿಸುವ ಕುಂಬಾರ /ವೈಶ್ಯ ಹೆಂಗಸಿನಲ್ಲಿ ಬ್ರಾಹ್ಮಣನಿಗೆ ಹುಟ್ಟಿದ ಒಬ್ಬ ಬೆರಕೆ ಜಾತಿಯವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कुम्भं करोति<br><b>विस्तारः - </b>"वैश्यायां विप्रतश्चौरात् कुम्भकारः स उच्यते"<br><br>

कुम्भकारी
कुम्भकारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಡಕೆಯನ್ನು ತಯಾರಿಸುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

कुम्भकारक
कुम्भकारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಡಕೆಯನ್ನು ತಯಾರಿಸುವವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "ण्वुल्" (३-१-१३३)<br><br>

कुम्भकारिका
कुम्भकारिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಡಕೆಯನ್ನು ತಯಾರಿಸುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्" (४-१-४)<br><br>

कुम्भज
कुम्भज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸ್ತ್ಯ ಮಹರ್ಷಿ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>कुम्भाज्जायते<br><br>कुम्भज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸಿಷ್ಠ ಮಹರ್ಷಿ<br><br>कुम्भज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ರೋಣಾಚಾರ್ಯ<br><br>कुम्भज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಂಭದಿಂದ ಹುಟ್ಟಿದ<br><br>

कुम्भजन्मन्
कुम्भजन्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸ್ತ್ಯ ಮಹರ್ಷಿ<br><b>प्रयोगाः - </b>"पञ्चवट्यां ततो रामः शासनात् कुम्भजन्मनः"<br><b>उल्लेखाः - </b>रघु० १२-३१<br><b>विस्तारः - </b>"अगस्त्यश्च वसिष्ठश्च मित्रावरुणयोरृषी । रेतः सिषिचतुः कुम्भे उर्वश्याः सन्निधौ द्रुतम् ॥" - भाग० ६-१८-५<br><br>कुम्भजन्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸಿಷ್ಠ ಮಹರ್ಷಿ<br><br>कुम्भजन्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ರೋಣಾಚಾರ್ಯ<br><b>व्युत्पत्तिः - </b>कुम्भाज्जन्म यस्य<br><br>

कुम्भदासी
कुम्भदासी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇಶ್ಯೆ /ಸೂಳೆ<br><br>कुम्भदासी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಹಿಡಕಿ /ಕುಂಟಿನಿ<br><br>

कुम्भनाभ
कुम्भनाभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲಿಚಕ್ರವರ್ತಿಯ ಒಬ್ಬ ಮಗ<br><b>प्रयोगाः - </b>"बलेः पुत्रशतं त्वासीत् बाणज्येष्ठं नराधिप । धृतराष्ट्रश्च सूर्यश्च चन्द्रमाश्चेन्द्रतापनः । कुम्भनाभो गर्दभाक्षः कुक्षिरित्येवमादयः ॥"<br><b>उल्लेखाः - </b>हरिवं०<br><br>

कुम्भपदी
कुम्भपदी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಭದಂತೆ ಕಾಲುಗಳುಳ್ಳ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>"ङीप्" (५-४-१३९)<br><b>व्युत्पत्तिः - </b>कुम्भस्येव पादावस्याः<br><br>

कुम्भपाद
कुम्भपाद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಂಭದಂತೆ ಕಾಲುಗಳುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>कुम्भस्येव पादावस्य<br><br>

कुम्भमण्डूक
कुम्भमण्डूक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಭದೊಳಗೆ ವಾಸಿಸುವ ಮಂಡೂಕದಂತೆಅಲ್ಪವಾದ ತಿಳುವಳಿಕೆಯುಳ್ಳವನು /ಕೇವಲಪರಿಮಿತಪ್ರದೇಶದಲ್ಲಿ ಮಾತ್ರ ಸಂಚರಿಸುವವನು<br><b>व्युत्पत्तिः - </b>कुम्भे मण्डूक इव<br><br>

कुम्भयोनि
कुम्भयोनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸ್ತ್ಯ ಮಹರ್ಷಿ<br><br>कुम्भयोनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸಿಷ್ಠ ಮಹರ್ಷಿ<br><br>कुम्भयोनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ರೋಣಾಚಾರ್ಯ<br><b>व्युत्पत्तिः - </b>कुम्भः योनिरुत्पत्तिस्थानमस्य<br><b>प्रयोगाः - </b>"प्रससादोदयादम्भः कुम्भयोनेर्महौजसः" । "कुम्भयोनिरलङ्कारं तस्मै दिव्यपरिग्रहम् ।"<br><b>उल्लेखाः - </b>रघु० ४-२१, रघु० १५-५५<br><br>

कुम्भशाला
कुम्भशाला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಭಗಳನ್ನು ತಯಾರಿಸುವ ಮನೆ /ಕುಂಬಾರನು ಮಡಕೆಗಳನ್ನು ತಯಾರಿಸುವ ಕಾರಖಾನೆ<br><b>व्युत्पत्तिः - </b>कुम्भाय कुम्भनिर्माणार्थं शाला<br><br>

कुम्भसन्धि
कुम्भसन्धि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ತಲೆಯ ಮೇಲೆ ಎರಡು ದುಬ್ಬುಗಳ ಮಧ್ಯಭಾಗ<br><b>व्युत्पत्तिः - </b>कुम्भयोः सन्धिः<br><br>

कुम्भसम्भव
कुम्भसम्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸ್ತ್ಯ ಮಹರ್ಷಿ<br><br>कुम्भसम्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸಿಷ್ಠ ಮಹರ್ಷಿ<br><br>कुम्भसम्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ರೋಣಾಚಾರ್ಯ<br><b>व्युत्पत्तिः - </b>कुम्भः सम्भवः उत्पत्तिस्थानमस्य<br><br>

कुम्भा
कुम्भा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇಶ್ಯೆ /ಸೂಳೆ<br><b>निष्पत्तिः - </b>उम्भ (पूरणे) - "अङ्" (३-३-१०३)<br><b>व्युत्पत्तिः - </b>कु निन्दितव्यापारेण उम्भति पूरयति उदरम्<br><br>

कुम्भाण्ड
कुम्भाण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣಾಸುರನ ಒಬ್ಬ ಮಂತ್ರಿ<br><b>व्युत्पत्तिः - </b>कुम्भ इव अण्डमस्य<br><b>प्रयोगाः - </b>"कुम्भाण्डवचनैरेवं दानवेन्द्रः प्रचोदितः । वाचं रूक्षमतिक्रुद्धः प्रोवाच वदतां वरः ॥"<br><b>उल्लेखाः - </b>हरिवं०<br><br>

कुम्भाधिप
कुम्भाधिप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಭರಾಶಿಯ ಅಧಿಪತಿಯಾದ ಶನಿಗ್ರಹ<br><b>व्युत्पत्तिः - </b>कुम्भस्याधिपः<br><br>

कुम्भाधिपति
कुम्भाधिपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಭರಾಶಿಯ ಅಧಿಪತಿಯಾದ ಶನಿಗ್ರಹ<br><b>व्युत्पत्तिः - </b>कुम्भस्याधिपतिः<br><br>

कुम्भिका
कुम्भिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇಶ್ಯೆ /ಸೂಳೆ<br><b>निष्पत्तिः - </b>कुम्भा - स्वार्थे "कः"<br><br>कुम्भिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರಿಯ ಶಿವನಿ ಮರ<br><br>

कुम्भिन्
कुम्भिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯ ಮೇಲೆ ಕುಂಭಗಳಿರುವ ಗಜ /ಆನೆ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कुम्भावस्य स्तः<br><br>कुम्भिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಸಳೆ<br><br>कुम्भिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಗ್ಗುಳ<br><br>कुम्भिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಘಟವನ್ನು ಹಿಡಿಸಿರುವ /ಬಿದಿಗೆಯನ್ನು ಹೊತ್ತಿರುವ<br><br>

कुम्भिल
कुम्भिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆಗೆ ಕನ್ನ ಕೊರೆಯುವ ಕಳ್ಳ<br><br>कुम्भिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ಸ್ಯ /ಮೀನು<br><br>कुम्भिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಯಾಲ /ಮೈದುನ /ಪತ್ನಿಯ ಸಹೋದರ<br><br>कुम्भिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗ್ರಂಥಚೋರ /ಇತರರ ಗ್ರಂಥಭಾಗವನ್ನು ತನ್ನದನ್ನಾಗಿ ಹೇಳಿ ಬಳಸಿಕೊಳ್ಳುವವನು /ಮತ್ತೊಬ್ಬನ ಕಾವ್ಯದಿಂದ ವಿಷಯವನ್ನು ಅಪಹರಿಸಿ ಬರೆಯುವವನು<br><br>कुम्भिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ಸ್ಯ /ಮೀನು<br><b>विस्तारः - </b>"कुम्भिलो झषचौरयोः । श्लोकच्छायाहरे श्याले" - हेम० ।<br><br>

कुम्भीक
कुम्भीक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಗ ವೃಕ್ಷ /ಸುರಗಿ ಮರ<br><b>निष्पत्तिः - </b>कै (शब्दे) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कुम्भीव कायति<br><br>कुम्भीक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರುಕಾಗೆ<br><br>

कुम्भीधान्य
कुम्भीधान्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಭದಲ್ಲಿ ತುಂಬುವಷ್ಟು ಧಾನ್ಯ<br><b>व्युत्पत्तिः - </b>कुम्भीमितं धान्यम्<br><br>

कुम्भीधान्यक
कुम्भीधान्यक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಂದು ವರ್ಷಕ್ಕೆ ಬೇಕಾಗುವಷ್ಟುಧಾನ್ಯವನ್ನು ಕೂಡಿಸಿಟ್ಟಿರುವವನು<br><b>निष्पत्तिः - </b>"कप्" (५-२-१५४)<br><b>व्युत्पत्तिः - </b>कुम्भीमितं धान्यमस्य वा<br><b>प्रयोगाः - </b>"कुसुलधान्यको वा स्यात् कुम्भीधान्यक एव वा"<br><b>उल्लेखाः - </b>मनु० ४-७<br><br>

कुम्भीनस
कुम्भीनस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರೂರವಾದ ಸರ್ಪ /ಹಾವು<br><b>व्युत्पत्तिः - </b>कुम्भीव नसा नासाऽस्य<br><br>

कुम्भीनसी
कुम्भीनसी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಲವಣಾಸುರನ ತಾಯಿ<br><br>कुम्भीनसी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರರಥನ ಹೆಂಡತಿ<br><br>

कुम्भीनसि
कुम्भीनसि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಕ್ಷಸ<br><br>

कुम्भीपाक
कुम्भीपाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪಾತ್ಮರನ್ನು ಆವಿಯಲ್ಲಿ ಮಡಕೆಯಂತೆ ಬೇಯಿಸುವ ಒಂದು ನರಕ<br><b>प्रयोगाः - </b>"यस्त्विह वा उग्रः पशून् पक्षिणो वा प्राणत उपरन्धयति तमपकरुणं पुरुषादैरपि विगर्हितं अमुत्र यमानुचराः कुम्भीपाके तप्ततैले उपरन्धयन्ति"<br><b>उल्लेखाः - </b>भाग० ५-२६-१३<br><br>

कुम्भीर
कुम्भीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಕ್ರ /ಮೊಸಳೆ<br><b>निष्पत्तिः - </b>ईर (गतौ) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कुम्भिनं गजमीरयति<br><b>प्रयोगाः - </b>"गर्दभत्वं तु सम्प्राप्य दश वर्षाणि जीवति । संवत्सरं तु कुम्भीरः ततो जायेत भारत ॥"<br><b>उल्लेखाः - </b>भा० अनु० १११-५९<br><br>

कुम्भीरी
कुम्भीरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಕ್ರ /ಮೊಸಳೆ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

कुम्भीरासन
कुम्भीरासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯೋಗಾಸನದಲ್ಲಿ ಒಂದು ಭೇದ<br><b>विस्तारः - </b>"पादोपरि पदं दत्वा शीर्षोपरि करद्वयम् । तिष्ठेत् दण्डाकृतिर्भूमौ कुम्भीरासनमुच्यते ॥"<br><br>

कुम्भील
कुम्भील<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಕ್ರ /ಮೊಸಳೆ<br><b>निष्पत्तिः - </b>कुम्भीर - रस्य लत्वम्<br><br>

कुम्भोदर
कुम्भोदर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರನ ಒಬ್ಬ ಅನುಚರ<br><b>प्रयोगाः - </b>"अवेहि मां किङ्करमष्टमूर्तेः कुम्भोदरं नाम निकुम्भमित्रम्"<br><b>उल्लेखाः - </b>रघु० २-३५<br><br>कुम्भोदर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಂಭದಂತೆ ಹೊಟ್ಟೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कुम्भ इव उदरं यस्य<br><br>

कुम्भोदरी
कुम्भोदरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कुम्भोदर ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीष्" (४-१-५५)<br><br>

कुम्भोदरा
कुम्भोदरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कुम्भोदर ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><br>

कुम्भोद्भव
कुम्भोद्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಭದಲ್ಲಿ ಜನಿಸಿದ ಅಗಸ್ತ್ಯ ಮಹರ್ಷಿ<br><br>कुम्भोद्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಸಿಷ್ಠ ಮಹರ್ಷಿ<br><br>कुम्भोद्भव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದ್ರೋಣಾಚಾರ್ಯ<br><b>व्युत्पत्तिः - </b>कुम्भादुद्भवो यस्य<br><br>

कुयोग
कुयोग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿಥಿ ವಾರ ನಕ್ಷತ್ರಗಳಸಂಬಂಧದಿಂದ ಉಂಟಾಗುವ ಕೆಟ್ಟ ಯೋಗ<br><br>

कुरङ्कर
कुरङ्कर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ಹಕ್ಕಿ /ಸಾರಸ ಪಕ್ಷಿ /ತಾವರೆ ಹಕ್ಕಿ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "अच्" (३-१-१३४) । पृषो० । मुम् ।<br><b>व्युत्पत्तिः - </b>करोति इति करः । कुरस्य शब्दस्य करः ।<br><br>

कुरङ्ग
कुरङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಲ್ಲೆ /ಜಿಂಕೆ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "अङ्गच्" (उ० १-११८) । बाहु० उत्वम् ।<br><b>प्रयोगाः - </b>"मुक्तातङ्ककुरङ्गकाननभुवः शैलाः स्खलद्वारयः"<br><b>उल्लेखाः - </b>प्रबोध० ३-१<br><br>कुरङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಪುಣ್ಯ ತೀರ್ಥ<br><b>प्रयोगाः - </b>"करतोयां कुरङ्गे च त्रिरात्रोपोषितो नरः । अश्वमेधमवाप्नोति विगाह्य प्रयतः शुचिः ॥"<br><b>उल्लेखाः - </b>भा० अनु० २५-१२<br><br>

कुरङ्गी
कुरङ्गी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹುಲ್ಲೆ /ಜಿಂಕೆ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><b>प्रयोगाः - </b>"यद्येतदीयेत ततः कृतार्था स्वचक्षुषी किङ्कुरुते कुरङ्गी"<br><b>उल्लेखाः - </b>नैष० ७-३०<br><br>

कुरङ्गक
कुरङ्गक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಪುಣ್ಯ ತೀರ್ಥ<br><b>निष्पत्तिः - </b>स्वार्थे "कः"<br><br>

कुरङ्गनयना
कुरङ्गनयना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಂಕೆಯಂತೆ ಕಣ್ಣುಗಳುಳ್ಳ ಹೆಂಗಸು<br><b>व्युत्पत्तिः - </b>कुरङ्गस्येव नयने यस्याः<br><b>प्रयोगाः - </b>"किन्त्वेका यमुना कुरङ्गनयना नेत्राम्बुभिर्वर्धते"<br><b>उल्लेखाः - </b>उद्भ०<br><br>

कुरङ्गम
कुरङ्गम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಂಕೆ /ಹುಲ್ಲೆ /ಚಿಗರಿ<br><b>निष्पत्तिः - </b>माङ् (माने) - "डः" (वा० ३-२-४८)<br><b>व्युत्पत्तिः - </b>कौ रङ्गं मीयते<br><b>विस्तारः - </b>"एणः कुरङ्गमो रिश्यः सादृश्यश्चारुलोचनः" - त्रिकाण्ड० ।<br><br>

कुरचिल्ल
कुरचिल्ल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಏಡಿ /ನಳ್ಳಿ<br><b>निष्पत्तिः - </b>चिल्ल (शैथिल्ये) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुरे शब्दे चिल्लति<br><br>

कुरट
कुरट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಪ್ಪಲಿಯನ್ನು ತಯಾರಿಸುವವನು /ಚರ್ಮದ ಕೆಲಸ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>रट (परिभाषणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुत्सितं रटति<br><b>विस्तारः - </b>"चर्मरुः कुरटः पादकृत्" - त्रिकाण्ड० ।<br><br>

कुरण्टक
कुरण्टक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಳದಿ ಹೂವಿನ ಗೋರಂಟಿ ಗಿಡ<br><b>निष्पत्तिः - </b>रुटि (स्तेये) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कुत्सितः रुण्टकः<br><b>विस्तारः - </b>"तत्र पीतो कुरण्टकः" - अम० ।<br><br>

कुरण्टी
कुरण्टी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮರದ ಬೊಂಬೆ<br><b>विस्तारः - </b>"कुरण्टो झिण्टिकाभेदे कुरण्टी दारुपुत्रिका" - हेम० ।<br><br>

कुरण्ड
कुरण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಡರೋಗ /ವೃಷಣವು ಊದಿಕೊಳ್ಳುವ ಒಂದು ರೋಗ<br><b>निष्पत्तिः - </b>कुर (शब्दे) - "अण्डन्" बाहु० ।<br><br>

कुरर
कुरर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರವ ಹಕ್ಕಿ /ಮೀನು ತಿನ್ನುವ ಒಂದು ದೊಡ್ಡ ಜಾತಿಯ ಪಕ್ಷಿ /ಕಡಲಹದ್ದು<br><b>निष्पत्तिः - </b>कु (शब्दे) - "क्ररन्" (उ० ३-१३३)<br><br>

कुररी
कुररी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುರವ ಹಕ್ಕಿ /ಮೀನು ತಿನ್ನುವ ಒಂದು ದೊಡ್ಡ ಜಾತಿಯ ಪಕ್ಷಿ /ಕಡಲಹದ್ದು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीष्" (४-१-६३)<br><b>प्रयोगाः - </b>"तत्र मामनयद्रक्षः क्रोशन्ती कुररीमिव"<br><b>उल्लेखाः - </b>भा० आदि० ६-१२<br><br>

कुरल
कुरल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚೂರ್ಣಕುಂತಲ /ಮುಂಗುರುಳು<br><br>कुरल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರವ ಹಕ್ಕಿ /ಮೀನು ತಿನ್ನುವ ಒಂದು ದೊಡ್ಡ ಜಾತಿಯ ಪಕ್ಷಿ /ಕಡಲಹದ್ದು<br><b>निष्पत्तिः - </b>कुरर - रस्य लः<br><br>

कुरली
कुरली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कुरल ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

कुरव
कुरव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಪು ಹೂವಿನ ದೊಡ್ಡ ಗೋರಂಟಿ<br><b>व्युत्पत्तिः - </b>कु ईषत् अलीनां रवो यत्र<br><br>कुरव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಪು ಹೂವಿನ ಮುಳ್ಳು ಗೋರಂಟಿ<br><br>कुरव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿ ಗೋರಂಟಿ<br><br>कुरव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಶಬ್ದ<br><b>व्युत्पत्तिः - </b>कुत्सितो रवः<br><br>कुरव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೋರಂಟಿ ಹೂವು<br><br>कुरव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಶಬ್ದವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कुत्सितो रवो यत्र<br><br>

कुरवक
कुरवक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಶಬ್ದವುಳ್ಳ<br><b>निष्पत्तिः - </b>वा "कप्" (५-४-१५४)<br><b>प्रयोगाः - </b>"मधुलिहां मधुदानविशारदाः कुरवका रवकारणतां ययुः"<br><b>उल्लेखाः - </b>रघु० ९-२९<br><br>कुरवक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಶಬ್ದವುಳ್ಳ<br><b>प्रयोगाः - </b>"चूडापाशे नवकुरवकं चारु कर्णे शिरीषं सीमन्ते च तवदुपगमजं यत्र नीषं वधूनाम्"<br><b>उल्लेखाः - </b>मेघ० २-२<br><br>

कुरस
कुरस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದ್ಯ<br><b>व्युत्पत्तिः - </b>कुत्सितो रसोऽत्र<br><b>विस्तारः - </b>"स्यदासवोऽपि कुरसः" - हारा० ।<br><br>कुरस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ರಸ<br><br>कुरस<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ರಸವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कुत्सितो रसोऽस्य<br><br>

कुरसा
कुरसा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಂಡೆ ಗಿಡ<br><br>

कुराल
कुराल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಕಾಲಿನ ಬೂದು ಬಣ್ಣದ ಕುದುರೆ<br><br>

कुरी
कुरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ತೃಣಧಾನ್ಯ<br><br>

कुरीर
कुरीर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಥುನ /ಸಂಭೋಗ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "ईरन्" (उ० ४-३३) । उत्वं च ।<br><b>विस्तारः - </b>"कुरीरं मैथुनम्" - सि० कौ० ।<br><br>कुरीर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸರ ತಲೆಯುಡಿಗೆ /ಅಲಂಕಾರದ ತೊಡಿಗೆ<br><br>

कुरु
कुरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರವಂಶದ ಒಬ್ಬ ದೊರೆ /ಅಜಮೀಢರಾಜನ ಮೊಮ್ಮಗನಾದ ಸಂವರಣನ ಮಗ /ಧೃತರಾಷ್ಟ್ರ ಮತ್ತು ಪಾಂಡು ಇವರ ಮೂಲಪುರುಷ<br><b>प्रयोगाः - </b>"योऽजमीडसुतस्त्वन्यः ऋक्षः संवरणस्ततः । तपत्यां सूर्यकन्यायां कुरुक्षेत्रपतिः कुरुः ॥"<br><b>उल्लेखाः - </b>भाग० ९-२२-३<br><br>कुरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುದೇಶ<br><b>निष्पत्तिः - </b>कुरु - "अण्" (४-२-६९) । अणो लुक् (४-२-८१)<br><b>व्युत्पत्तिः - </b>कुरूणां निवासो जनपदः कुरवः<br><b>प्रयोगाः - </b>"वितन्वति क्षेममदेवमातृकाश्चिराय तस्मिन् कुरश्चकासति"<br><b>उल्लेखाः - </b>किरा० १-१७<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>कुरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುದೇಶದ ದೊರೆಗಳು<br><b>प्रयोगाः - </b>"उवाच पार्थ पश्यैतान् समवेतान् कुरूनिति"<br><b>उल्लेखाः - </b>गीता० १-२५<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>कुरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುದೇಶದ ಜನರು<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>कुरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಓದನ /ಅನ್ನ<br><b>विस्तारः - </b>"कुरुर्नृपान्तरे भक्ते पुमान् पुम्भूम्नि नीवृति" - मेदि० ।<br><br>कुरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಗ್ನೀಧ್ರರಾಜನ ಒಬ್ಬ ಮಗ<br><b>प्रयोगाः - </b>"जम्बुद्वीपेश्वरो यस्तु आग्नीध्रो मुनिसत्तम । तस्य पुत्रो बभूवुस्ते प्रजापतिसमा नव । नाभिः किं पुरुषश्चैव हरिवर्ष इलावृतः । रम्यो हिरण्वान् षष्ठश्च कुरुर्भद्राश्व एव च । केतुमालस्तथैवान्यः साधुचेष्टो नृपोऽभवत् ॥"<br><b>उल्लेखाः - </b>विष्णुपु०<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>कुरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಗ್ನೀಧ್ರರಾಜನ ಮಗ ಕುರುರಾಜನು ಆಳುತ್ತಿದ್ದ ಒಂದು ದೇಶ<br><b>प्रयोगाः - </b>"विजित्य यः प्राज्यमयच्छदुत्तरान् कुरूनकुप्यं वसुवासवोपमः"<br><b>उल्लेखाः - </b>किरा० १-३५<br><br>

कुरू
कुरू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುರಾಜನ ಮಗಳು<br><b>निष्पत्तिः - </b>"ण्यः" (४-१-१७) । तस्य लुक् (४-१-१७४)स्त्रियां "ऊङ्" (४-१-६६)<br><b>व्युत्पत्तिः - </b>कुरोरपत्यं स्त्री<br><br>

कुरुक्षेत्र
कुरुक्षेत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭಾರತವರ್ಷದೊಳಗಣ ಒಂದು ಪುಣ್ಯಕ್ಷೇತ್ರ<br><br>कुरुक्षेत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೌರವ ಪಾಂಡವರು ಯುದ್ಧಮಾಡಿದ ಒಂದು ಭೂಪ್ರದೇಶ<br><b>प्रयोगाः - </b>"धर्मक्षेत्रे कुरुक्षेत्रे समवेता युयुत्सवः । मामकाः पाण्डवाश्चैव किमकुर्वत सञ्जय ॥"<br><b>उल्लेखाः - </b>गीता० १-१<br><br>

कुरुजाङ्गल
कुरुजाङ्गल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುದೇಶ ಮತ್ತು ಜಾಂಗಲ ದೇಶ<br><b>व्युत्पत्तिः - </b>कुरवश्च जाङ्गलाश्च<br><br>कुरुजाङ्गल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುದೇಶ ಮತ್ತು ಜಾಂಗಲ ದೇಶ<br><b>निष्पत्तिः - </b>"विशिष्टलिङ्गो नदीदेशोऽग्रामाः" (पा० सू० २-४-७) इति एकवद्भावः ।<br><b>व्युत्पत्तिः - </b>कुरवश्च जाङ्गली च तेषां समाहारः<br><br>कुरुजाङ्गल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುಕ್ಷೇತ್ರ<br><b>व्युत्पत्तिः - </b>कुरुषु जाङ्गलम्<br><b>प्रयोगाः - </b>"तस्य नाम्नाऽभिविख्यातं पृथिव्यां कुरुजाङ्गलम् । कुरुक्षेत्रं तु तपसा पुण्यं चक्रे महातपाः ॥"<br><b>उल्लेखाः - </b>भा० आदि० १०१-३८<br><br>

कुरुण्ट
कुरुण्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಳದಿ ಗೋರಂಟಿ ಗಿಡ<br><b>निष्पत्तिः - </b>रुटि (स्तेये) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुत्सितं रुण्टति<br><br>

कुरुण्टी
कुरुण्टी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮರದ ಬೊಂಬೆ<br><b>निष्पत्तिः - </b>कुरुण्ट - "ङीष्" (४-१-४१)<br><b>विस्तारः - </b>"कुरुण्टी दारुपुत्र्यां च कुरुण्टो झिण्टिकान्तरे" - विश्व० ।<br><br>

कुरुत
कुरुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿದಿರಿನಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ ಗೆರಸಿ<br><b>निष्पत्तिः - </b>कुर (शब्दे) - "उतक्" बाहु० ।<br><br>

कुरुपाण्डव
कुरुपाण्डव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೌರವರು ಮತ್ತು ಪಾಂಡವರು<br><br>

कुरुपुङ्गव
कुरुपुङ्गव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುಶ್ರೇಷ್ಠ /ಕುರುವಂಶದಲ್ಲಿ ಮುಖ್ಯನಾದವನು<br><b>व्युत्पत्तिः - </b>कुरुषु पुङ्गवः<br><br>

कुरुबिल्व
कुरुबिल्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪದ್ಮರಾಗ /ಕೆಂಪು<br><br>

कुरुबिस्त
कुरुबिस्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿನ್ನದ ಒಂದು ಪಲಲತೂಕ<br><b>व्युत्पत्तिः - </b>कुरुषु बिस्तः<br><br>

कुरुराज्
कुरुराज्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುದೇಶದದೊರೆ /ದುರ್ಯೋಧನ<br><b>व्युत्पत्तिः - </b>कुरूणां राट्<br><br>

कुरुराज
कुरुराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುರುದೇಶದದೊರೆ /ದುರ್ಯೋಧನ<br><b>निष्पत्तिः - </b>राजा - "टच्" (५-४-९१)<br><b>व्युत्पत्तिः - </b>कुरूणां राजा<br><b>प्रयोगाः - </b>"त्वयि भक्तिमता न सत्कृतः कुरुराजा गुरुरेव चेदिपः । प्रियमांसमृगाधिपोज्झितः किमवद्यः करिकुम्भजो मणिः" । "कुरुराजनिर्दयनिपीडनाभयान्मुखमध्यरोहि मुरविद्विषः श्रिया" ।<br><b>उल्लेखाः - </b>माघ० १६-४५, माघ० १३-११<br><br>कुरुराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುಧಿಷ್ಠಿರ /ಧರ್ಮರಾಜ<br><br>

कुरुल
कुरुल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಣೆಯ ಮೇಲಿನ ಚೂರ್ಣಕುಂತಲ /ಮುಂಗುರುಳು<br><b>निष्पत्तिः - </b>लड (विलासे) - "अच्" (३-१-१३४) । पृषो० ।<br><b>व्युत्पत्तिः - </b>कु ईषल्लडति<br><b>विस्तारः - </b>"स तु भाले भ्रमरकः कुरुलो भ्रमरालकः" - अभि० चि० ।<br><br>

कुरुवक
कुरुवक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಳದಿ ಗೋರಂಟಿ ಗಿಡ<br><br>कुरुवक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಪು ಗೋರಂಟಿ ಗಿಡ<br><br>कुरुवक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದರಿದ್ರ /ಬಡವ<br><b>विस्तारः - </b>"निःस्वे कुरुवकः शोणाम्लानझिण्टीप्रभेदयोः" - मेदि० ।<br><br>

कुरुविन्द
कुरुविन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭದ್ರಮುಸ್ತೆ /ಕೊನ್ನಾರಿ ಗೆಡ್ಡೆ<br><b>निष्पत्तिः - </b>विद्लृ (लाभे) -"शः" (३-१-१३८) । मुम् (७-१-५९)<br><b>व्युत्पत्तिः - </b>कुरून् विन्दति<br><br>कुरुविन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪದ್ಮರಾಗ<br><b>प्रयोगाः - </b>"बहलानुरागकुरुविन्ददलप्रतिबद्धमध्यमिव दिग्वलयम्"<br><b>उल्लेखाः - </b>माघ० ९-८<br><br>कुरुविन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಕುರ /ಕನ್ನಡಿ<br><br>कुरुविन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಷ /ಉದ್ದು<br><br>कुरुविन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಲಸಂದೆ /ಕಾರಾಮಣಿ<br><br>कुरुविन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ನ /ಗಂಧ /ಮೈಗೆ ಪೂಸುವ ಒಂದು ಸುಗಂಧದ್ರವ್ಯ<br><b>विस्तारः - </b>"कुरुविन्दः पद्मरागे मुकुरव्रीहिभेदयोः । कुल्माषे हिङ्गुले मुस्ते" - हेम० ।<br><br>

कुरूप
कुरूप<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂದವಿಲ್ಲದ ರೂಪ /ವಿಕಾರವಾದ ಆಕಾರ<br><b>व्युत्पत्तिः - </b>कुत्सितं रूपम्<br><br>कुरूप<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಕಾರವಾದ ರೂಪವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कुत्सितं रूपं यस्य<br><b>प्रयोगाः - </b>"सुरूपं वा कुरूपं वा पुमानित्येव भुञ्जते"<br><b>उल्लेखाः - </b>मनु० ९-१४<br><br>

कुर्कुट
कुर्कुट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಕ್ಕುಟ /ಕೋಳಿ<br><b>निष्पत्तिः - </b>कुट (कौटिल्ये) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>कुरिति शब्दं कुटति<br><br>

कुर्कुटी
कुर्कुटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಕ್ಕುಟ /ಕೋಳಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीष्" (४-१-६३)<br><br>

कुर्कुर
कुर्कुर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಕ್ಕುಟ /ಕೋಳಿ<br><b>निष्पत्तिः - </b>कुर - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>कुरिति अव्यक्तशब्दं करोति<br><b>प्रयोगाः - </b>"उपकर्तुमपि प्राप्तं निःस्वं मन्वन्ति कुर्कुरम्"<br><b>उल्लेखाः - </b>पञ्चतं०<br><br>

कुर्द|क्रीडायाम्|कूर्दते
कुर्द - क्रीडायाम् (भ्वा० आत्म० अक० से०) कूर्दते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಆಟವಾಡು /ನೆಗೆ /ಹಾರು<br><br>

कुर्वत्
कुर्वत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಮ್ಮಾರ /ಮೋಚಿ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "शतृ" (३-२-१२४)<br><br>कुर्वत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡುತ್ತಿರುವ<br><b>प्रयोगाः - </b>"कुर्वन्तमित्यभरेण नगानवाचः पुष्पैर्विराम मलिनां च नगानवाचः"<br><b>उल्लेखाः - </b>माघ० ६-७९, १०-३०<br><br>कुर्वत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಕ /ಆಳು<br><br>कुर्वत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸಗಾರ<br><br>

कुर्वती
कुर्वती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कुर्वत् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><b>प्रयोगाः - </b>"मध्येसमुद्रं कुकुभः पिशङ्गीर्या कुर्वती काञ्चनवप्रभासा"<br><b>उल्लेखाः - </b>माघ० ३-३३<br><br>

कुर्वद्रूप
कुर्वद्रूप<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೌದ್ಧಮತದಲ್ಲಿ ಫಲೋತ್ಪತ್ತಿಗೆ ಅವ್ಯವಹಿತಪೂರ್ವದಲ್ಲಿರುವ ಒಂದು ಕಾರಣ<br><br>

कुर्वाण
कुर्वाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೇವಕ /ಆಳು<br><br>कुर्वाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "शानच्" (३-२-१२४)<br><b>प्रयोगाः - </b>"कुर्वाणानां साम्परायान्तरायं भूरेणूनां मृत्युना मार्जनाय"<br><b>उल्लेखाः - </b>माघ० १८-८<br><br>

कुल|संस्त्याने|कोलति
कुल - संस्त्याने बन्धुषु च (भ्वा० पर० अक० से०) कोलति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಒಟ್ಟುಗೂಡಿಸು<br><br>कुल - संस्त्याने बन्धुषु च (भ्वा० पर० अक० से०) कोलति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ ಬೆಳೆಸು<br><br>

कुल
कुल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶ /ಪೀಳಿಗೆ<br><b>निष्पत्तिः - </b>कुल (संस्त्याने) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>कोलति<br><b>प्रयोगाः - </b>"यः कुलेऽजनि जगन्मुकुटे वः पार्थकेप्सितमपूरि न येन"<br><b>उल्लेखाः - </b>नैष० ५-११९<br><br>कुल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮಾನ ಜಾತಿಯ ಪಶುಗಳ ಸಮೂಹ<br><b>प्रयोगाः - </b>"सेनागजेन मथितस्य निजप्रसूनैर्मम्ले यथागतमगामि कुलैरलीनाम्"<br><b>उल्लेखाः - </b>माघ० ५-४३<br><b>विस्तारः - </b>ಕೋಶಗಳಲ್ಲಿ ಕುಲ ಪದಕ್ಕೆ ತಿರ್ಯಕ್ಪ್ರಾಣಿಗಳ ಗುಂಪು ಎಂಬ ಅರ್ಥವಿದ್ದರೂ ಮನುಷ್ಯರ ಗುಂಪು ಎಂಬ ಅರ್ಥದಲ್ಲೂ ಮಹಾಕವಿಯ ಪ್ರಯೋಗವಿದೆ. "एतं नलं तं दमयन्ति पश्य त्यजार्तिमित्यालिकुलप्रबोधान्" - नैष० ६-६०<br><br>कुल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹ /ಮನೆ<br><br>कुल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತನು /ಶರೀರ /ಮೈ<br><br>कुल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜನಪದ /ದೇಶ<br><br>कुल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎರಡು ನೇಗಿಲುಗಳಿಂದ ಉಳಲ್ಪಡುವಷ್ಟು ಜಮೀನು<br><b>प्रयोगाः - </b>"दशी कुलं तु भुञ्जीत विंशी पञ्च कुलानि च । ग्रामं ग्रामशताध्यक्षः सहस्राधिपतिः परम् ॥"<br><b>उल्लेखाः - </b>मनु० ७-११९<br><b>विस्तारः - </b>೬ ಎತ್ತುಗಳನ್ನು ಕಟ್ಟಿ ಉಳುವ ನೀಗಿಲು ಒಂದು ಹಲ. ಅಂತಹ ೨ ಹಲಗಳಿಂದ ಉಳಬಹುದಾದ ಭೂಮಿಯು ಕುಲವು.<br><br>कुल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಋಷಿಗಳಿಗೆ ಸಂತೋಷವುಂಟುಮಾಡುವ ಕಾರ್ಯ /ಋಷಿತರ್ಪಣ<br><b>विस्तारः - </b>"ऋषीणां तर्पणं यत्तत् कौलकुल्यं कुलं च तत्" - वैज० ।<br><br>

कुली
कुली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಗ್ಗುಳ್ಳದ ಗಿಡ<br><b>विस्तारः - </b>"कष्टकार्यौषधौ कुली" - मेदि० ।<br><br>कुली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಗ್ಗುಳ್ಳದ ಗಿಡ<br><b>निष्पत्तिः - </b>कुल (संस्त्याने) - "कः" (३-१-१३५) ।गौरा० "ङीष्" (४-१-४१)<br><b>व्युत्पत्तिः - </b>कोलति<br><b>विस्तारः - </b>"प्रचोदनी कुली क्षुद्रा दुःस्पर्शा राष्ट्रिकेत्यपि" - अम० ।<br><br>कुली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಡತಿಯ ಅಕ್ಕ /ಹೆಂಡತಿಯ ಹಿರಿಯ ಸಹೋದರಿ /ನಾದಿನಿ<br><b>विस्तारः - </b>"प्त्न्यास्तु भगिनी ज्येष्ठा ज्येष्ठश्वश्रूः कुली च सा" - अभि० चि० ।<br><br>

कुलक
कुलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆತೂಬರೆ ಗಿಡ<br><b>निष्पत्तिः - </b>"कन्" (५-३-९६)<br><b>व्युत्पत्तिः - </b>कुलस्य गृहस्य प्रतिकृतिरिव<br><b>विस्तारः - </b>"काकेन्दुः कुलकः काकपीलुकः काकतिन्दुके" - अम० ।<br><br>कुलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಗ /ದೇವಲೋಕ<br><b>विस्तारः - </b>"कुलको नाककाकेन्दू" - त्रिकाण्ड० ।<br><br>कुलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಲ್ಮೀಕ /ಹುತ್ತ<br><br>कुलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಂಶದ ಯಜಮಾನ<br><br>कुलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಗುಂಪಿನ ಯಜಮಾನ<br><br>कुलक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಲಿಗೆಯ ಮೇಲಿನ ಕೊಳೆ<br><b>विस्तारः - </b>"कुलकं रसनामलम्" -हारा० ।<br><br>कुलक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದೇ ಕರ್ತೃ ಮತ್ತು ಕ್ರಿಯಾಪದಗಳ ಸಂಬಂದಗಳುಳ್ಳ ೪ ಶ್ಲೋಕಗಳಿಗಿಂತಲೂ ಹೆಚ್ಚು ಶ್ಲೋಕಗಳಸಮುದಾಯ<br><b>विस्तारः - </b>"द्वाभ्यां युग्ममिति प्रोक्तं त्रिभिः श्लोकैर्विशेषकम् । कालापकं चतुर्भिः स्यात् तदूर्ध्वं कुलकं स्मृतम् ॥"<br><br>कुलक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಡವಲ ಗಿಡ<br><b>निष्पत्तिः - </b>कुल (संस्त्याने) - "कः" (३-१-१३५)<br><b>विस्तारः - </b>"कुलकं पञ्चादिश्लोकसमवाये पटोलके । कुलकः कुलप्रधाने वल्मीके काकतिन्दुके"<br><br>

कुलकण्टक
कुलकण्टक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಂಶಕ್ಕೆ ಮುಳ್ಳಿನಂತಿರುವವನು /ಕುಲಕ್ಕೆ ಅಪಕೀರ್ತಿ ತರುವ ನೀಚಮನುಷ್ಯ<br><b>व्युत्पत्तिः - </b>कुले कण्टक इव<br><br>

कुलकन्यका
कुलकन्यका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಕುಲದಲ್ಲಿ ಹುಟ್ಟಿದ ಕನ್ಯೆ /ಒಳ್ಳೆಯ ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದ ಹುಡುಗಿ<br><b>प्रयोगाः - </b>"गृहे गृहे पुरुषाः कुलकन्यका उद्वहन्ति । न च कोऽपि लज्जाप्रसाधनमनपराधमुग्धस्वभावं कुलकुमारीजनं प्रभवामीति वागनलेन प्रज्वलयति"<br><b>उल्लेखाः - </b>मालती० ७<br><br>

कुलकन्या
कुलकन्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಕುಲದಲ್ಲಿ ಹುಟ್ಟಿದ ಕನ್ಯೆ /ಒಳ್ಳೆಯ ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದ ಹುಡುಗಿ<br><br>

कुलकलङ्क
कुलकलङ्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಂಶಕ್ಕೆ ಕೆಟ್ಟ ಹೆಸರು ತರುವವನು /ಮನೆತನಕ್ಕೆ ಅಪಕೀರ್ತಿ ತರುವವನು<br><b>व्युत्पत्तिः - </b>कुलस्य कलङ्क इव<br><br>

कुलकुणि
कुलकुणि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೇಶ್ಯೆ /ಸೂಳೆ<br><br>

कुलक्षय
कुलक्षय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶಕ್ಷಯ /ವಂಶವು ನಾಶವಾಗುವುದು /ವಂಶವು ಅಳಿದು ಹೋಗುವುದು<br><b>व्युत्पत्तिः - </b>कुलस्य क्षयः<br><b>प्रयोगाः - </b>"कुलक्षये प्रणश्यन्ति कुलधर्माः सनातनाः"<br><b>उल्लेखाः - </b>गीता० १-४०<br><br>

कुलगुरु
कुलगुरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶಪರಂಪರೆಯಾಗಿ ಬಂದ ಆಚಾರ್ಯರು<br><b>व्युत्पत्तिः - </b>कुलस्य गुरुः<br><br>

कुलघ्न
कुलघ्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಂಶವನ್ನು ಹಾಳುಮಾಡುವವನು<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) -"कः" (३-२-५)<br><b>व्युत्पत्तिः - </b>कुलं हन्ति<br><b>प्रयोगाः - </b>"स्त्रीषु दुष्टासु वार्ष्णेय जायते वर्णसङ्करः । सङ्करो नरकायैव कुलघ्नानां कुलस्य च ॥"<br><b>उल्लेखाः - </b>गीता०<br><br>

कुलज
कुलज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಲದಲ್ಲಿ ಜನಿಸಿದ /ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९७)<br><b>व्युत्पत्तिः - </b>कुले वंशे जायते<br><b>प्रयोगाः - </b>"पतिंवरायाः कुलजं वरस्य वा यमः कमप्याचरितातिथिं यदि"<br><b>उल्लेखाः - </b>नैष० ९-८१<br><br>कुलज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸತ್ಕುಲದಲ್ಲಿ ಜನಿಸಿದ /ಒಳ್ಳೆಯ ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>प्रयोगाः - </b>"कुलजे वृत्तसम्पन्ने धर्मज्ञे सत्यवादिनि । महापक्षे धनिन्यार्थे निक्षेपं निक्षिपेत् बुधः ॥"<br><b>उल्लेखाः - </b>मनु० ८-१७९<br><br>

कुलजा
कुलजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कुलज ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>प्रयोगाः - </b>"कुलाभिमानी कुलजां नराधिपः"<br><b>उल्लेखाः - </b>किरा० १-३१<br><br>

कुलजन
कुलजन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಕುಲದಲ್ಲಿ ಜನಿಸಿದವನು /ಒಳ್ಳೆಯ ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><br>

कुलटा
कुलटा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆಮನೆಗೂ ತಿರುಗಾಡುತ್ತಿರುವ ಹೆಂಗಸು /ಅಸಭ್ಯ ಹೆಂಗಸು /ಸ್ವೈರಿಣಿ /ವ್ಯಭಿಚಾರಿಣಿ<br><b>निष्पत्तिः - </b>अट् (गतौ) - "आञ्" (३-१-१३४) शक० ।<br><b>व्युत्पत्तिः - </b>अटति । कुलस्य अटा ।<br><b>प्रयोगाः - </b>"मूढ दुर्योधन, कुलटाविप्रलभ्यमानमात्मानं बहुमन्यमानः अधुना किं वक्ष्यसि"<br><b>उल्लेखाः - </b>वेणी० २<br><br>

कुलतन्तु
कुलतन्तु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿ ಇರುವವರಲ್ಲಿ ಕೊನೆಯ ಪ್ರಜೆ<br><b>व्युत्पत्तिः - </b>कुलस्य तन्तुरिव<br><b>विस्तारः - </b>ತಂತುವಿನಂತೆ ಮುಂದಕ್ಕೆ ಅವಿಚ್ಛಿನ್ನವಾಗಿ ಸಂತತಿಯು ಬೆಳೆಯಲು ಕಾರಣವಾದುದರಿಂದ ಈ ಹೆಸರು.<br><br>

कुलतिथि
कुलतिथि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿದಿಗೆ ಷಷ್ಠಿ ಮತ್ತು ದಶಮಿ ಹೊರತಾದ ಸಮತಿಥಿಗಳು /ಚೌತಿ ಅಷ್ಟಮಿ ದ್ವಾದಶಿ ಮತ್ತು ಚತುರ್ದಶೀ ತಿಥಿಗಳು<br><b>प्रयोगाः - </b>"द्वितीया दशमी षष्ठी कुलाकुलमुदाहृतम् । विषमाश्चाकुलाः सर्वाः शेषाश्च तिथयः कुलाः ॥"<br><b>उल्लेखाः - </b>तन्त्रसा०<br><br>

कुलतिलक
कुलतिलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶಕ್ಕೆ ತಿಲಕದಂತಿರುವವನು /ವಂಶಕ್ಕೆ ಅಲಂಕಾರಪ್ರಾಯನಾದವನು<br><b>व्युत्पत्तिः - </b>कुलस्य तिलकमिव<br><br>

कुलत्थ
कुलत्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುರುಳಿ ಗಿಡ<br><b>विस्तारः - </b>"ताम्रवृन्तः कुलत्थः स्यात्'" - त्रिकण्ड० ।<br><br>कुलत्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುರುಳಿ<br><br>

कुलदीप
कुलदीप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶವನ್ನು ಪ್ರಕಾಶಗೊಳಿಸುವವನು /ವಂಶಕ್ಕೆ ಕೀರ್ತಿಗೌರವಗಳನ್ನು ತರುವವನು<br><b>व्युत्पत्तिः - </b>कुलस्य दीप इव<br><br>

कुलप्रदीप
कुलप्रदीप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶವನ್ನು ಪ್ರಕಾಶಗೊಳಿಸುವವನು /ವಂಶಕ್ಕೆ ಕೀರ್ತಿಗೌರವಗಳನ್ನು ತರುವವನು<br><b>व्युत्पत्तिः - </b>कुलस्य प्रदीप इव<br><b>प्रयोगाः - </b>"जातः कुले तस्य किलोरुकीर्तिः कुलप्रदीपो नृपतिर्दिलीपः"<br><b>उल्लेखाः - </b>रघु०६-७४<br><br>

कुलदेवता
कुलदेवता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಂಶದಲ್ಲಿ ಆರಾಧಿಸಲ್ಪಡುವ ದೇವತೆ /ವಂಶಪರಂಪರೆಯಾಗಿ ಪೂಜಿಸಲ್ಪಡುವ ದೇವತೆ<br><b>व्युत्पत्तिः - </b>कुलस्य देवता<br><b>प्रयोगाः - </b>"तामर्चिताभ्यः कुलदेवताभ्यः कुलप्रतिष्ठां प्रणमय्य माता"<br><b>उल्लेखाः - </b>किरा० ७-२७<br><br>

कुलद्रुम
कुलद्रुम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಳ್ಳೆ ಹೊಂಗೆ ಬಿಲ್ವ ಅರಳಿ ಕದಂಬ ಬೇವು ಆಲ ಅತ್ತಿ ನೆಲ್ಲಿ ಮತ್ತು ಹುಣಸೆ ಮರಗಳು<br><b>विस्तारः - </b>"श्लेष्मातकः करञ्जश्च बिल्वाश्वत्थकदम्बकाः । निम्बो वटोदुम्बरौ च धात्री चिञ्चा दश स्मृताः ॥"<br><br>

कुलधर्म
कुलधर्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಲಾಚಾರ /ಮನೆತನದಲ್ಲಿ ಆಚರಿಸಲ್ಪಡುವ ಧರ್ಮ<br><b>प्रयोगाः - </b>"उत्सन्नकुलधर्माणां मनुष्याणां जनार्दन । नरके नियतं वासो भवतीत्यनुशुश्रुम ॥"<br><b>उल्लेखाः - </b>गीता० १-४४<br><br>

कुलधारक
कुलधारक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಗ /ವಂಶವನ್ನು ಮುಂದೆ ಸ್ಥಿರವಾಗಿ ಬೆಳೆಸುವವನು /ವಂಶವನ್ನು ಕಾಪಾಡುವವನು<br><b>निष्पत्तिः - </b>धृञ् (धारणे) + णिच् - "ण्वुल्"(३-१-१३३)<br><b>व्युत्पत्तिः - </b>कुलं धारयति<br><b>विस्तारः - </b>"पुत्रो द्वितीयः कुलधारकः" - त्रिकाण्ड० ।<br><br>

कुलधुर्य
कुलधुर्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನೆಯಲ್ಲಿ ಮುಖ್ಯನಾದವನು /ಮನೆಯ ಯಜಮಾನ /ಸಂಸಾರದ ಭಾರವನ್ನು ಹೊತ್ತಿರುವವನು /ಪ್ರಾಯದ ಮಗ<br><b>निष्पत्तिः - </b>"यत्" (४-४-७७)<br><b>व्युत्पत्तिः - </b>धुरां वहति । कुलस्य धुर्यः ।<br><b>प्रयोगाः - </b>"तदुपहितकुटुम्बः शान्तिमार्गोत्सुकोऽभूत् । न हि सति कुलधुर्ये सूर्यवंश्या गृहाय ॥"<br><b>उल्लेखाः - </b>रघु० ७-७१<br><br>

कुलनक्षत्र
कुलनक्षत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆರ್ದ್ರಾನಕ್ಷತ್ರದ ಹೊರತಾದ ಸಮನಕ್ಷತ್ರಗಳು /ಭರಣಿ ರೋಹಿಣಿ ಪುಷ್ಪ ಮಖೆ ಉತ್ತರಫಲ್ಗುನಿ ಚಿತ್ರೆ ಮುಂತಾದ ಸಮಸಂಖ್ಯಾಕನಕ್ಷತ್ರಗಳು<br><b>विस्तारः - </b>"वारुणार्द्राभिजिन्मूलं कुलाकुलमुदाहृतम् । कुलानि समधिष्ण्यानि शेषाणि चाकुलानि वै ॥" - तन्त्रसा०<br><br>

कुलनारी
कुलनारी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಕುಲದಲ್ಲಿ ಜನಿಸಿದ ಹೆಂಗಸು /ಒಳ್ಳೆಯ ಮನೆತನದಲ್ಲಿ ಹುಟ್ಟಿದ ಹೆಂಗಸು<br><br>

कुलनाश
कुलनाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶದ ನಾಶ /ವಂಶವು ಅಳಿದುಹೋಗುವುದು<br><b>व्युत्पत्तिः - </b>कुलस्य नाशः<br><b>प्रयोगाः - </b>"यावच्च वेदधर्माः स्युः यावत् स्यात् शङ्करार्चनम् । यावत् स्यात् शुचि कृत्यं च तावन्न कुलनाशनम् ॥"<br><br>कुलनाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಷ್ಟ್ರ /ಒಂಟೆ<br><b>निष्पत्तिः - </b>न + अश (भोजने) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुलं भूलग्नं नाशयति<br><b>विस्तारः - </b>ಒಂಟೆಯ ಕತ್ತು ಎತ್ತರವಾಗಿದ್ದು ಭೂಮಿಯಲ್ಲಿರುವ ಪದಾರ್ಥಗಳನ್ನು ತಿನ್ನಲು ಸಾಧ್ಯವಿಲ್ಲದಿರುವುದರಿಂದ ಈ ಹೆಸರು.<br><br>कुलनाश<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶವು ಅಳಿದುಹೋಗುವಿಕೆ<br><b>निष्पत्तिः - </b>णश (अदर्शने) - भावे "ल्युट्" (३-३-११५)<br><br>कुलनाश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಂಶವನ್ನು ನಾಶಪಡಿಸುವ<br><b>निष्पत्तिः - </b>णश (अदर्शने) - कर्त० "ल्युः" (३-१-१३४)<br><br>कुलनाश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾದವವಂಶವನ್ನು ನಾಶಪಡಿಸಿದ ಮುಸಲ /ಒನಕೆ<br><br>

कुलनाशिनी
कुलनाशिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಷ್ಟ್ರ /ಒಂಟೆ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>कुलनाशिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶವನ್ನು ನಾಶಪಡಿಸುವ<br><br>

कुलपति
कुलपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಮನೆಯ ಯಜಮಾನ<br><br>कुलपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಂಶದ ಯಜಮಾನ<br><b>व्युत्पत्तिः - </b>कुलस्य पतिः<br><br>कुलपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹತ್ತು ಸಹಸ್ರ ಮಂದಿ ವಿದ್ಯಾರ್ಥಿಗಳನ್ನು ಅಶನ ವಸನಗಳಿಂದ ಪೋಷಿಸಿ ವಿದ್ಯಾಭ್ಯಾಸ ಮಾಡಿಸುವ ಮುನಿ<br><b>विस्तारः - </b>मुनीनां दशसाहस्रं योऽन्नदानादिपोषणात् । अध्यापयति विप्रर्षिरसौ कुलपतिः स्मृतः ॥"<br><br>

कुलपरम्परा
कुलपरम्परा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶಪರಂಪರೆ /ವಂಶದಲ್ಲಿ ಹುಟ್ಟುವವರ ಶ್ರೇಣಿ ಪಂಕ್ತಿ<br><br>

कुलपर्वत
कुलपर्वत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದ್ವೀಪದ ಒಂದು ಭೂಭಾಗದ ಮೇರೆಯನ್ನು ತಿಳಿಸುವ ಪರ್ವತಗಳು<br><b>प्रयोगाः - </b>"रुणध्मि सवितुर्मार्गं भिदद्मि कुलपर्वतान्"<br><b>उल्लेखाः - </b>भट्टि० ६-३५<br><br>

कुलपांसन
कुलपांसन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಂಶಕ್ಕೆ ಕಳಂಕ ತರುವವನು /ವಂಶದ ಹೆಸರನ್ನು ಕೆಡಿಸುವವನು<br><b>निष्पत्तिः - </b>पसि (नाशने) + णिच् - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुलं पांसयति<br><br>

कुलपांसुल
कुलपांसुल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಂಶದಲ್ಲಿ ಪಾಪ ಕಾರ್ಯವನ್ನು ಮಾಡುವವನು<br><b>प्रयोगाः - </b>"आः दुरात्मन् कुरुकुलपांसुल, एवमतिक्रान्तमर्यादे त्वयि निमित्तमात्रेण पाण्डवक्रोधेन भवितव्यम्"<br><b>उल्लेखाः - </b>वेणी० १<br><br>

कुलपालक
कुलपालक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಲವನ್ನು ಕಾಪಾಡುವವನು /ಮನೆಯ ಯೋಗಕ್ಷೇಮವನ್ನು ಚೆನ್ನಾಗಿ ನೋಡಿಕೊಳ್ಳುವವನು<br><br>कुलपालक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಂಶದ ಹೆಸರನ್ನು ಕಾಪಾಡುವವನು /ವಂಶದಗೌರವವನ್ನು ಕಾಪಾಡುವವನು /ಸತ್ಪುತ್ರ<br><b>निष्पत्तिः - </b>पाल (रक्षणे) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कुलं पालयति<br><br>

कुलपालिका
कुलपालिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶಕ್ಕೆ ಗೌರವ ತರುವ ಸತ್ಕುಲದಲ್ಲಿ ಹುಟ್ಟಿದ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्" (४-१-४)<br><b>विस्तारः - </b>"कुलस्त्री कुलपालिका" - अम० ।<br><br>

कुलपालि|कुलपाली
कुलपालि (ली)<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶಕ್ಕೆ ಗೌರವ ತರುವ ಸತ್ಕುಲದಲ್ಲಿ ಹುಟ್ಟಿದ ಹೆಂಗಸು /ವಂಶದ ಖ್ಯಾತಿ ಗೌರವಗಳನ್ನು ಕಾಪಾಡುವ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>पाल (रक्षणे) + णिच् - "इन्" (उ० ४-११७) । वा "ङीप्" (ग० ४-१-४५)<br><b>व्युत्पत्तिः - </b>कुलं पालयति<br><br>

कुलपुत्र
कुलपुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಕುಲದಲ್ಲಿ ಜನಿಸಿದ ಸತ್ಪುತ್ರ /ಒಳ್ಳೆಯ ಮನೆತನದಲ್ಲಿ ಹುಟ್ಟಿ ಕುಲಕ್ಕೆ ಗೌರವ ತರುವ ಮಗ<br><br>

कुलपुत्री
कुलपुत्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಕುಲದಲ್ಲಿ ಜನಿಸಿದ ಸತ್ಪುತ್ರಿ /ಒಳ್ಳೆಯ ಮನೆತನದಲ್ಲಿ ಹುಟ್ಟಿ ಕುಲಕ್ಕೆ ಗೌರವ ತರುವ ಮಗಳು<br><br>

कुलपुरुष
कुलपुरुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಂಶದ ದೊಡ್ಡ ಮನುಷ್ಯ<br><br>कुलपुरुष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಂಶದ ಮೂಲಪುರುಷ<br><br>

कुलप्रसूत
कुलप्रसूत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸತ್ಕುಲದಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><b>व्युत्पत्तिः - </b>कुले सत्कुले प्रसूतः<br><br>

कुलभूभृत्
कुलभूभृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಲಪರ್ವತ<br><br>

कुलभूषण
कुलभूषण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಂಶಕ್ಕೆ ಅಲಂಕಾರಪ್ರಾಯನಾದ<br><b>निष्पत्तिः - </b>भूष (अलङ्कारे) + णिच् - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुलं भूषयति<br><br>

कुलभृत्या
कुलभृत्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ಭಿಣಿ ಹೆಂಗಸಿಗೆ ಬೇಕಾದುದನ್ನು ಕೊಟ್ಟು ಪೋಷಿಸುವುದು /ಬಸಿರು ಹೆಂಗಸಿನ ಬಯಕೆಯನ್ನು ಈಡೇರಿಸಿ ಉಪಚರಿಸುವುದು<br><b>व्युत्पत्तिः - </b>कुलैः वंशजनैः भृत्या भरणम्<br><br>कुलभृत्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಲಗಿತ್ತಿ /ಹೆರಿಗೆಯಲ್ಲಿ ಸಹಾಯಕಳಾದ ಹೆಂಗಸು<br><br>कुलभृत्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶವನ್ನು ಕಾಪಾಡುವುದು<br><b>व्युत्पत्तिः - </b>कुलस्य भृत्या भरणम्<br><br>

कुलमित्र
कुलमित्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶದ ಸುಹೃತ್ತು /ಮನೆತನಕ್ಕೇ ಬಂದ ಗೆಳೆಯ /ಒಂದು ಕುಲದಲ್ಲಿ ಅಭಿಮಾನವಿರುವ ಗೆಳೆಯ<br><b>व्युत्पत्तिः - </b>कुलस्य मित्रम्<br><br>

कुलयोषित्
कुलयोषित्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದೊಡ್ಡ ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದ ಯೋಗ್ಯ ಹೆಂಗಸು<br><br>

कुलवधू
कुलवधू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಕುಲದಲ್ಲಿ ಹುಟ್ಟಿದ ಹೆಂಗಸು /ಗೌರವದಿಂದ ವಂಶದ ಹೆಸರನ್ನು ಕಾಪಾಡುವ ಹೆಂಗಸು /ಮಾನದಿಂದ ಮನೆಯಲ್ಲಿರುವ ಹೆಂಗಸು<br><b>व्युत्पत्तिः - </b>कुले स्थिता वधूः<br><br>

कुलवर्धन
कुलवर्धन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಲವನ್ನು ಬೆಳೆಸುವವನು /ವಂಶವನ್ನು ಮುಂದಕ್ಕೆ ವೃದ್ಧಿಪಡಿಸುವವನು<br><b>निष्पत्तिः - </b>वृधु (वृद्धौ) - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुलं वर्धयति<br><br>

कुलवार
कुलवार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಗಳ ಮತ್ತು ಶುಕ್ರವಾರಗಳು<br><b>विस्तारः - </b>"रविश्चन्द्रो गुरुः सौरिः चत्वारश्चाकुला इमे । भौमशुक्रौ कुलाख्यौ तु बुधवारः कुलाकुलः ॥" - तन्त्रसार०<br><br>

कुलवृद्ध
कुलवृद्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶದಲ್ಲಿ ಹಿರಿಯನಾದವನು /ಒಂದು ಸಂಸಾರದ ಯಜಮಾನ<br><b>व्युत्पत्तिः - </b>कुले वृद्धः<br><br>

कुलव्रत
कुलव्रत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆಯಲ್ಲಿ ಆಚರಿಸಲ್ಪಡುವ ವ್ರತ /ಕುಲಕ್ರಮಾಗತವಾದ ನಿಯಮಾಚರಣೆ<br><b>व्युत्पत्तिः - </b>कुले आचरणीयम् व्रतम्<br><b>प्रयोगाः - </b>"गलितवयसामिक्ष्वाकूणामिदं हि कुलव्रतम्"<br><b>उल्लेखाः - </b>रघु० ३-७०<br><br>

कुलशिखरिन्
कुलशिखरिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಲಪರ್ವತಗಳು<br><b>प्रयोगाः - </b>"कुलशिखरिणः क्षुद्रा नैते न वा जलराशयः"<br><b>उल्लेखाः - </b>भर्तृ० १-९०<br><br>

कुलशेखर
कुलशेखर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಕುಂದಮಾಲಾ ಸ್ತೋತ್ರವನ್ನು ರಚಿಸಿದ ಒಬ್ಬ ವಿಷ್ಣುಭಕ್ತರು<br><br>

कुलश्रेष्ठ
कुलश्रेष्ठ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಲ್ಪಿಗಳ ವಂಶದಲ್ಲಿ ಶ್ರೇಷ್ಠನಾದವನು /ಶಿಲ್ಪಿಗಳ ವಂಶದ ಪ್ರಧಾನಪುರುಷ<br><b>विस्तारः - </b>"कुलिकह् स्यात् कुलश्रेष्ठः" - अम० ।<br><br>

कुलश्रेष्ठिन्
कुलश्रेष्ठिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಲ್ಪಿಕುಲದ ಯಜಮಾನ<br><br>

कुलसम्भव
कुलसम्भव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾವುದಾದರೊಂದು ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>व्युत्पत्तिः - </b>कुले सम्भवोऽस्य<br><b>विस्तारः - </b>"बीज्यस्तु कुलसम्भवः" - अम० ।<br><br>

कुलस्त्री
कुलस्त्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಕುಲದಲ್ಲಿ ಹುಟ್ಟಿದ ಹೆಂಗಸು /ಮನೆತನದ ಗೌರವವನ್ನು ಕಾಪಾಡುವ ಹೆಂಗಸು<br><b>व्युत्पत्तिः - </b>कुले स्थिता स्त्री<br><b>विस्तारः - </b>"कुलस्त्री कुलपालिका" - अम० ।<br><br>

कुलस्थक
कुलस्थक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುರುಳಿ ಗಿಡ<br><br>कुलस्थक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹುರುಳಿ<br><b>विस्तारः - </b>"ताम्रवृन्तः कुलस्थकः" - वैज० ।<br><br>कुलस्थक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣ ಸರ್ಪ<br><b>विस्तारः - </b>"कृष्णसर्पः कुलस्थकः"- वैज० ।<br><br>

कुलहीन
कुलहीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಚ ವಂಶದವನಾದ /ನೀಚ ಕುಲದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>व्युत्पत्तिः - </b>कुलेन हीनः<br><br>

कुलहुण्डक
कुलहुण्डक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆವರ್ತ /ನೀರಿನ ಸುಳಿ<br><b>विस्तारः - </b>"अथाम्भसां भ्रमः । पुरोटिः पत्रझङ्कारो वदारः कुलहुण्डकः" - त्रिकाण्ड० ।<br><br>

कुलाकुल
कुलाकुल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬುಧವಾರ<br><b>विस्तारः - </b>"रविश्चन्द्रो गुरुः सौरिः चत्वारश्चाकुला इमे । भौमशुक्रौ कुलाख्यौ तु बुधवारः कुलाकुलः ॥" - तन्त्रसार०<br><br>कुलाकुल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿದಿಗೆ ಷಷ್ಠಿ ಮತ್ತು ದ್ವಾದಶೀತಿಥಿಗಳು<br><b>विस्तारः - </b>"द्वितीया द्वदशी षष्ठी कुलाकुलमुदाहृतम्" - तन्त्रसा०<br><br>कुलाकुल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆರ್ದ್ರಾ ಮೂಲ ಅಭಿಜಿತ್ ಮತ್ತು ಶತಭಿಷಕ್ ನಕ್ಷತ್ರಗಳು<br><b>विस्तारः - </b>"वारुणार्द्राभिजिन्मूलं कुलाकुलमुदाहृतम्" - तन्त्रसा०<br><br>

कुलाङ्गना
कुलाङ्गना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಕುಲದಲ್ಲಿ ಹುಟ್ಟಿದ ಹೆಂಗಸು /ಒಳ್ಳೆಯ ಮನೆತನದ ಹೆಂಗಸು<br><b>व्युत्पत्तिः - </b>कुलस्य सत्कुलस्याङ्गना<br><b>प्रयोगाः - </b>"असन्तुष्टा द्विजा नष्टाः सन्तुष्टश्च महीपतिः । सलज्जा गणिका नष्टा निर्लज्जा च कुलाङ्गना ॥"<br><br>

कुलाङ्गार
कुलाङ्गार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಲದೂಷಕ /ನಡತೆಯಿಂದ ತನ್ನ ವಂಶವನ್ನು ಕೆಡಿಸುವವನು /ವಂಶಕ್ಕೆ ಅಪಕೀರ್ತಿ ತರುವವನು<br><b>व्युत्पत्तिः - </b>कुलस्याङ्गार इव<br><br>

कुलाचल
कुलाचल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಲಪರ್ವತಗಳು<br><br>

कुलाचार
कुलाचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಲಧರ್ಮ /ಮನೆತನದಲ್ಲಿ ಆಚರಿಸಲ್ಪಡುವ ಧರ್ಮ<br><b>व्युत्पत्तिः - </b>कुलस्याचारः<br><br>कुलाचार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೀವ ಪ್ರಕೃತಿತತ್ತ್ವ ದಿಕ್ಕು ಕಾಲ ಆಕಾಶ ಕ್ಷಿತಿ ಅಪ್ಪು ತೇಜಸ್ಸು ವಾಯು ಇವುಗಳಲ್ಲಿ ಬ್ರಹ್ಮಬುದ್ಧಿಯಿಂದ ಮಾಡುವ ಧ್ಯಾನ<br><b>प्रयोगाः - </b>"जीवः प्रकृतितत्त्वं च दिक्कालाकाशमेव च । क्षित्यप्तेजोवायवश्च कुलमित्यभिधीयते । ब्रह्मबुद्ध्या निर्विकल्पमेतेष्वाचरणं च यत् । कुलाचारः स एवोक्तो धर्मकामार्थमोक्षदः ॥"<br><br>

कुलाचार्य
कुलाचार्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆತನದ ಗುರು /ಕುಲಗುರು /ವಂಶಪರಂಪರೆಯಿಂದ ಬಂದ ಗುರು<br><b>व्युत्पत्तिः - </b>कुलस्याचार्यः<br><br>

कुलाद्रि
कुलाद्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಲಪರ್ವತಗಳು<br><br>

कुलाधारक
कुलाधारक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶವನ್ನು ಎತ್ತಿ ಹಿಡಿಯುವವನು /ಕುಲವನ್ನು ಉದ್ಧಾರಮಾಡುವ ಪುತ್ರ<br><br>

कुलाय
कुलाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಕ್ಕಿಗಳ ಗೂಡು /ಹಕ್ಕಿಗಳು ವಾಸಮಾಡುವ ಸ್ಥಳ<br><b>निष्पत्तिः - </b>अय (गतौ) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>कुलं पक्षिसमूहोऽयतेऽत्र<br><b>प्रयोगाः - </b>"ददतमन्तरिताऽहिमदीधितिं खगकुलाय कुलायनिलायिताम् । जलदकालमबोधकृतं दिशामपरथाय रथावयवायुधः ॥"<br><b>उल्लेखाः - </b>माघ० ६-४१<br><br>कुलाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಾನ /ಜಾಗ /ಸ್ಥಳ /ಮನೆ<br><b>विस्तारः - </b>"कुलायस्तु पुमान् स्थानमात्रे स्यात् पक्षिवासके ।" - मेदि० । "गेहे कुलायो नीडोऽस्त्री" - वैज० ।<br><br>

कुलायिका
कुलायिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಕ್ಷಿಗಳ ವಾಸಸ್ಥಾನ /ಹಕ್ಕಿಗಳ ಗೂಡು<br><b>विस्तारः - </b>"कुलायिका पक्षिशाला" - त्रिकाण्ड० ।<br><br>

कुलाल
कुलाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಬಾರ /ಮಣ್ಣಿನ ಪಾತ್ರೆ ಹೆಂಚು ಮುಂತಾದುವನ್ನು ತಯಾರಿಸುವವನು<br><b>निष्पत्तिः - </b>अल (भूषणादौ) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कुलमलति<br><b>प्रयोगाः - </b>"अनलसङ्गतितापमुपैतु नो कुसुमचापकुलालविलासजम्"<br><b>उल्लेखाः - </b>नैष० ४-७<br><br>कुलाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಕ್ಕುಭಪಕ್ಷಿ /ಕಾಡುಕೋಳಿ<br><br>कुलाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಘೂಕ /ಗೂಬೆ<br><b>विस्तारः - </b>"कुलालः कुम्भकारे स्यात् कुक्कुभे कौशिकेऽपि च" - विश्व० ।<br><br>

कुलाली
कुलाली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಬಾರನ ಹೆಂಡತಿ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>कुलाली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಬಾರನ ಹೆಂಡತಿ<br><br>कुलाली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೀಲಕಮಲದ ಒಂದು ಭೇದ<br><br>कुलाली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಳುತ್ಥಾಂಜನ<br><br>

कुलालकुक्कुट
कुलालकुक्कुट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಕೋಳಿ /ನೀರುಕೋಳಿ<br><br>

कुलाह
कुलाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂದು ಬಣ್ಣದ ಕಪ್ಪು ಮಂಡಿಯ ಕುದುರೆ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) -"डः"<br><b>व्युत्पत्तिः - </b>कुलमाहन्ति<br><br>

कुलि
कुलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಸ್ತ /ಕೈ<br><b>निष्पत्तिः - </b>कुल (संस्त्याने बन्धुषु च) - "इन्" (उ० ४-११७)<br><b>विस्तारः - </b>"कुलिर्हस्तो भुजादलः" - त्रिकाण्ड० ।<br><br>

कुलि|कुली
कुलि-ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಗ್ಗುಳ್ಳದ ಗಿಡ<br><b>निष्पत्तिः - </b>वा "ङीष्" (ग० ४-१-४५)<br><br>

कुलिक
कुलिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಐವತ್ತು ಅಂಗುಲ ಉದ್ದದ ಬಾಣ<br><b>विस्तारः - </b>"अयः शलाका कूटोऽस्त्री पत्रकूटस्सपत्रणः । द्विद्वाविशन्त्यङ्गुली स्यान्निचोटे द्यङ्गुलोत्तरः । स्युश्चोटलिङ्गकस्तालः कुलिको बिम्बसारकः" - वैज० ।<br><br>कुलिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಲ್ಪಿಗಳ ಕುಲದ ಯಜಮಾನ /ಶಿಲ್ಪಿಗಳ ಕುಲದಲ್ಲಿ ಶ್ರೇಷ್ಠನಾದವನು<br><b>विस्तारः - </b>"कारवः शिल्पिनः सर्वे कुलिकास्ते कुलोत्तमाः" - वैज० ।<br><br>कुलिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೮ ಸರ್ಪನಾಯಕರಲ್ಲೊಬ್ಬ<br><b>विस्तारः - </b>"अनन्तो वासुकिः पद्मो महापद्मोऽपि तक्षकः । कर्कोटः कुलिकः शङ्ख इत्यष्टौ नागनायकाः" - त्रिकाण्ड० ।<br><br>कुलिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಮುಳ್ಳುಗಿಡ<br><br>कुलिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಂಶದ ಯಜಮಾನ<br><br>कुलिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಾನುವಾರ ಮೊದಲಾದ ದಿನಗಳಲ್ಲಿ ಶುಭಕಾರ್ಯಗಳಿಗೆ ನಿಷಿದ್ಧವಾದ ವೇಳೆ /ಗುಳಿಕ ಕಾಲ<br><b>प्रयोगाः - </b>"वारेशे सबले चापि बलाढ्ये लग्नगे शुभे । कुलिकोद्भवदोषस्तु विनश्यति न संशयः ॥"<br><br>

कुलिङ्ग
कुलिङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರಿನೊಳಗಾಡುವ ಕುಕ್ಕುಟಿಯೆಂಬ ಹಕ್ಕಿ<br><b>निष्पत्तिः - </b>लिगि (गतौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कौ भूमौ लिङ्गति<br><br>कुलिङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಬ್ಬಚ್ಚಿ<br><br>कुलिङ्ग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಗುರುತು<br><b>व्युत्पत्तिः - </b>कुत्सितं लिङ्गम्<br><br>कुलिङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಗುರುತುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कुत्सितं लिङ्गं यस्य<br><br>कुलिङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮರಸೇಬಿನ ಗಿಡ<br><br>

कुलिङ्गी
कुलिङ्गी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಬ್ಬಚ್ಚಿ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

कुलिङ्गा
कुलिङ्गा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಗುರುತುಳ್ಳ<br><br>

कुलिङ्गक
कुलिङ्गक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಬ್ಬಚ್ಚಿ<br><b>निष्पत्तिः - </b>कुलिङ्गः - सञ्ज्ञायां "कन्" (५-३-८७)<br><br>

कुलिज
कुलिज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೈಯಲ್ಲಿ ಹುಟ್ಟಿದ /ಕೈಯಲ್ಲಿ ಉಂಟಾದ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९७)<br><b>व्युत्पत्तिः - </b>कुलौ हस्ते जायते<br><br>

कुलिन्
कुलिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತ /ಬೆಟ್ಟ<br><br>कुलिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಳ್ಳೆಯ ಕುಲದಲ್ಲಿ ಹುಟ್ಟಿದ /ಸತ್ಕುಲದಲ್ಲಿ ಜನಿಸಿದ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-१३६)<br><b>व्युत्पत्तिः - </b>प्रशस्तं कुलमस्यास्ति<br><br>

कुलिनी
कुलिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಳ್ಳೆಯ ಕುಲದಲ್ಲಿ ಹುಟ್ಟಿದ /ಸತ್ಕುಲದಲ್ಲಿ ಜನಿಸಿದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कुलिन्द
कुलिन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದುದೇಶ<br><b>प्रयोगाः - </b>"कालिन्दाः कालवाश्चैव कुण्ठकाः करटास्तथा"<br><b>उल्लेखाः - </b>भा० भीष्म०<br><br>कुलिन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಳಿಂದ ದೇಶದಜನರು<br><br>कुलिन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಳಿಂದ ದೇಶದ ದೊರೆಗಳು<br><b>निष्पत्तिः - </b>"अञ्" (४-१-११६) । अञो लुक् (२-४-६२)<br><b>व्युत्पत्तिः - </b>कुलिन्दानां राजानः<br><br>

कुलिश
कुलिश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಮೀನು<br><b>निष्पत्तिः - </b>कु + लिश (गतौ) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>कुत्सितं ईषद्वा लिशति<br><br>कुलिश<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನ ವಜ್ರಾಯುಧ<br><b>निष्पत्तिः - </b>शीङ् (स्वप्ने) - "डः" (३-२-१०१) । शो (तनूकरणे) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कुलौ हस्ते शेते । कुलिनः पर्वतात् श्यति<br><b>प्रयोगाः - </b>"वृत्रस्य हन्तुः कुलिशः कुण्ठिताश्रीव लक्ष्यते"<br><b>उल्लेखाः - </b>कुमा० २-२०<br><b>विस्तारः - </b>"कुलिशो न स्त्री दम्भोलौ ना झषान्तरे" - मेदि० ।<br><br>

कुलिशद्रुम
कुलिशद्रुम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಂಡುಕಳ್ಳಿ ಗಿಡ<br><b>व्युत्पत्तिः - </b>कुलिशाख्यो द्रुमः । कुलिश इव द्रुमो वा ।<br><br>

कुलिशदधर
कुलिशदधर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಜ್ರಾಯುಧವನ್ನು ಧರಿಸಿರುವ ಇಂದ್ರ<br><b>निष्पत्तिः - </b>धृञ् (धारणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुलिशं धरति । कुलिशस्य धरः ।<br><br>

कुलिशपाणि
कुलिशपाणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><b>व्युत्पत्तिः - </b>कुलिशं पाणौ यस्य<br><b>प्रयोगाः - </b>"नवकनकपिशङ्गं वासराणां विधातुः ककुभि कुलिशपाणेर्भाति भासां वितानम्"<br><br>

कुलिशाङ्कुला
कुलिशाङ्कुला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೌದ್ಧರ ೧೬ ವಿದ್ಯಾದೇವತೆಗಳಲ್ಲಿ ಒಬ್ಬ ದೇವತೆ<br><b>विस्तारः - </b>"विद्या देव्यस्तु षोडश । रोहिणीप्रज्ञप्तिर्वज्रशृङ्खला कुलिशाङ्कुशा" - अभि० चि० ।<br><br>

कुलिशासन
कुलिशासन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಕ್ಯಮುನಿ<br><b>व्युत्पत्तिः - </b>कुलिशवत् दृढमासनं यस्य<br><b>विस्तारः - </b>"सर्वार्थसिद्धिस्तु महाश्रमणः कुलिशासनः" - त्रिकाण्ड० ।<br><br>

कुलीक
कुलीक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಕ್ಷಿ /ಹಕ್ಕಿ<br><b>निष्पत्तिः - </b>कुल (संस्त्याने) - "ईकन्" बाहु० ।<br><br>

कुलीन
कुलीन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ತಮ ಕುಲದಲ್ಲಿ ಹುಟ್ಟಿದ ಕುದುರೆ /ಒಳ್ಳೆಯ ಜಾತಿಯ ಕುದುರೆ<br><b>निष्पत्तिः - </b>"खः" (४-१-१३९)<br><b>व्युत्पत्तिः - </b>कुलस्यापत्यम्<br><b>विस्तारः - </b>"अजानेयाः कुलीनाः स्युः" - अम० ।<br><br>कुलीन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಗುರುಸುತ್ತು /ಉಗುರಿನ ಒಂದು ವಿಧ ರೋಗ<br><br>कुलीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸತ್ಕುಲಪ್ರಸೂತ /ಒಳ್ಳೆಯ ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><b>प्रयोगाः - </b>"यस्यास्ति वित्तं स नरः कुलीनः स पण्डितः स श्रुतवान् गुणज्ञः"<br><b>उल्लेखाः - </b>भर्तृ० १-३२<br><b>विस्तारः - </b>"महाकुलकुलीनार्यसभ्यसज्जनसाधवः" - अम०<br><br>कुलीन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭೂಮಿಯಲ್ಲಿ ಅಡಗಿಕೊಂಡಿರುವ<br><b>व्युत्पत्तिः - </b>कौ भूमौ लीनः<br><br>

कुलीनक
कुलीनक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಹೆಸರು<br><b>विस्तारः - </b>"वनमुद्गे तुरवकनिगूढककुलीनकाः" - अभि० चि० ।<br><br>

कुलीनस
कुलीनस<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><b>निष्पत्तिः - </b>षो (अन्तकर्मणि) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कुलीनं भूलग्नं स्यति<br><b>विस्तारः - </b>"कुलीनसं कबन्धं स प्राणदं सर्वतोमुखम्" - अभि० चि० ।<br><br>

कुलीर
कुलीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಏಡಿ /ನಳ್ಳಿ<br><b>निष्पत्तिः - </b>कुल (संस्त्याने) - "ईरन्" बाहु० ।<br><br>कुलीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ಕಾಟಕ ರಾಶಿ /ಮೇಷ ಮೊದಲಾಗಿ ೪ನೆಯ ರಾಶಿ<br><br>

कुलुक
कुलुक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಲಗೆಯ ಕೊಳೆ<br><b>निष्पत्तिः - </b>कुल (संस्त्याने) - "उलच्" बाहु० ।<br><b>विस्तारः - </b>"मलं विट्टं तदक्षिजम् । दूषीका दूषिका जैह्वं कुलुकम्" - अभि० चि०<br><br>

कुलुक्कगुञ्जा
कुलुक्कगुञ्जा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಳ್ಳಿಯ ಬೆಂಕಿ<br><b>विस्तारः - </b>"उक्ला कुलुक्कगुञ्जा स्यात्" - हारा० ।<br><br>

कुलूत
कुलूत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದೇಶ<br><br>कुलूत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಲೂತ ದೇಶದಜನರು<br><br>कुलूत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಲೂತ ದೇಶದ ರಾಜರು<br><br>

कुलोद्वह
कुलोद्वह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಂಶದ ರಕ್ಷಣೆಯ ಭಾರವನ್ನು ಹೊತ್ತಿರುವವನು<br><b>निष्पत्तिः - </b>उद् + वह (प्रापणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुलं वंशभारं रक्षणादिकम् उद्वहति<br><b>प्रयोगाः - </b>"पुत्रो ममानुरूपश्च शूरश्चेति कुलोद्वहः"<br><b>उल्लेखाः - </b>भा० विरा०<br><br>

कुल्माष
कुल्माष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಲಸಂದೆ /ಕಾರಾಮಣಿ<br><br>कुल्माष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಧಬೆಂದ ಗೋಧಿ ಮುಂತಾದ ಧಾನ್ಯ<br><br>कुल्माष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಡಲೆ<br><br>कुल्माष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಬಲಿ /ಗಂಜಿ<br><b>विस्तारः - </b>"कुल्माषं स्यात्तु काञ्जिके । कुल्माषोऽर्धस्विन्नधान्ये यावके चणकेऽपि च" - हेम० ।<br><br>

कुल्य
कुल्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾನ್ಯನಾದ ಪುರುಷ /ಗೌರವಿಸಲು ಯೋಗ್ಯನಾದವನು<br><b>व्युत्पत्तिः - </b>कुले सत्कुले भवः<br><br>कुल्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಲುಬು /ಮೂಳೆ<br><b>निष्पत्तिः - </b>कुल (संस्त्याने) - "यक्" (उ० ४-१११)<br><br>कुल्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಂಸ<br><br>कुल्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶೂರ್ಪ /ಮೊರ /ಧಾನ್ಯವನ್ನು ಕೇರುವ ಒಂದು ಸಾಧನ<br><br>कुल्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>೮ ಕೊಳಗದ ಅಳತೆ<br><br>कुल्य<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತ್ರಿಮವಾದ ಸಣ್ಣ ಹೊಳೆ /ಅಗೆದು ತೋಡಿ ನಿರ್ಮಿತವಾದ ನದಿ<br><br>कुल्य<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬದನಿಕೆ ಗಿಡ<br><br>कुल्य<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನದಿ /ಹೊಳೆ<br><b>प्रयोगाः - </b>"सेनास्वानाद्दन्तिनामात्मनैव स्थूलास्तावत् प्रावहन् दानकुल्याः"<br><b>उल्लेखाः - </b>माघ० १८-२६<br><br>कुल्य<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಕುಲದಲ್ಲಿ ಹುಟ್ಟಿದ ಹೆಂಗಸು<br><b>प्रयोगाः - </b>"केनापि दौष्कुलेयेन कुल्यां महाकुलीं प्रियाम् । हृतां माहाकुलीनस्य तस्य लिप्सामहे वयम् ॥"<br><b>उल्लेखाः - </b>भट्टि० ७-८८<br><br>कुल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಲಕ್ಕೆ ಹಿತವಾದ /ವಂಶಕ್ಕೆ ಅನುಕೂಲವಾದ<br><b>निष्पत्तिः - </b>"यत्" (५-१-५)<br><b>व्युत्पत्तिः - </b>कुलाय हितम्<br><br>कुल्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದ /ಕುಲದಲ್ಲಿ ಜನಿಸಿದ<br><b>विस्तारः - </b>"कुल्यं स्यात् कीकसेऽप्यष्टद्रोणीशूर्पामिमेषु च । कुल्या पयःप्रणाल्यां च नद्यां जीवन्तिकोषधौ । कुलोद्भवे कुलहिते त्रिषु मान्ये पुनः पुमान्" - मेदि० ।<br><br>

कुल्लूक
कुल्लूक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಲ್ಲೂಕಭಟ್ಟಾಚಾರ್ಯರು /ಮನುಸ್ಮೃತಿಯ ವ್ಯಾಖ್ಯಾಕಾರರಾದ ಒಬ್ಬ ವಿದ್ವಾಂಸರು<br><br>

कुव
कुव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೈದಿಲೆ /ಉತ್ಪಲ<br><b>निष्पत्तिः - </b>वा (गतिगन्धनयोः) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कुं भूमिं वाति गच्छति<br><b>विस्तारः - </b>"कुवलं तूत्पलं कुवम्" - त्रिकाण्ड० ।<br><br>

कुवचस्
कुवचस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಮಾತು /ಅಪವಾದ /ದೂಷಣೆ<br><b>व्युत्पत्तिः - </b>कुत्सितं वचः<br><br>कुवचस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಮಾತುಳ್ಳ /ಅಸಭ್ಯವಾದ ಮಾತುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कुत्सितं वचो यस्य<br><br>

कुवत्
कुवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೂಗುತ್ತಿರುವ /ಶಬ್ದ ಮಾಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कु (शब्दे) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"द्रुभङ्गध्वनिसंविघ्नाः कुवत्पक्षिकुलाकुलाः"<br><b>उल्लेखाः - </b>भट्टि० ९-१<br><br>

कुवल
कुवल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಲಚಿ ಗಿಡ /ಬೋರೆ ಗಿಡ<br><br>कुवल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪಲ<br><b>निष्पत्तिः - </b>वल (सञ्चलने) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कौ वलति<br><br>कुवल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಕ್ತಾಫಲ /ಮುತ್ತು<br><br>कुवल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೋರೆಹಣ್ಣು /ಎಲಚಿ ಹಣ್ಣು<br><br>कुवल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><b>विस्तारः - </b>"कुवलं चोत्पले मुक्ताफले च बदरीफले" - मेदि० ।<br><br>कुवल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜೀವ<br><b>निष्पत्तिः - </b>कु + वल (सञ्चलने) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कौलन्ते आसंसारं भ्राम्यन्तीति (कुवलाः जीवाः)<br><br>

कुवलकुण
कुवलकुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೋರೆಗಿಡವು ಹಣ್ಣು ಬಿಡುವುದು /ಎಲಚಿಯು ಹಣ್ಣಾಗುವಿಕೆ<br><b>निष्पत्तिः - </b>"कुणप्" (५-२-२४)<br><b>व्युत्पत्तिः - </b>कुवलयस्य पाकः<br><br>

कुवलय
कुवलय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪಲ /ನೈದಿಲೆ<br><b>व्युत्पत्तिः - </b>कोः वलयमिव<br><b>प्रयोगाः - </b>"पुत्रप्रेम्णा कुवलयदलप्रापि कर्णे करोति"<br><b>उल्लेखाः - </b>मेघ० १-४४<br><br>कुवलय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಂಡಲ<br><b>व्युत्पत्तिः - </b>कोर्वलयम्<br><br>

कुवलयदृश्
कुवलयदृश्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುವಲಯದಂತೆ ಕಪ್ಪಾದ ಕಣ್ಣುಗಳುಳ್ಳ ಹೆಂಗಸು<br><b>व्युत्पत्तिः - </b>कुवलये इव दृशौ यस्याः<br><br>

कुवलयानन्द
कुवलयानन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಅಲಂಕಾರಗ್ರಂಥ /ಜಯದೇವವಿರಚಿತವಾದ ಚಂದ್ರಾಲೋಕದ ಒಂದು ವ್ಯಾಖ್ಯಾನ<br><br>

कुवलयापीड
कुवलयापीड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಸನ ಒಂದು ಆನೆ<br><br>

कुवलयाश्व
कुवलयाश्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯವಂಶದ ಒಬ್ಬ ದೊರೆ<br><br>

कुवलाश्व
कुवलाश्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಋತಧ್ವಜನೆಂಬ ಒಬ್ಬ ದೊರೆ<br><br>

कुवलेशय
कुवलेशय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ನಾರಾಯಣ<br><b>निष्पत्तिः - </b>शीङ् (स्वप्ने) - "अच्" (३-२-१५) । या (प्रापणे) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कुवले जले शेते । कौ भूमौ वलन्ते आसंसारं भ्राम्यन्तीति कुवलाः जीवाः, ते च ते ईशाः कुवलेशाः, तान्नियच्छन् याति<br><b>प्रयोगाः - </b>"शुभाङ्गः शान्तिदः स्रष्टा कुमुदः कुवलेशयः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"कुत्सितं बलमेषां ते कुवला जीवसञ्ज्ञकाः । देहेन्द्रियादेरीशास्ते कुवलेशा इति स्मृताः ॥" - निरुक्तिः ।<br><br>

कुवाद
कुवाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಮಾತು /ಅಪವಾದ /ದೂಷಣೆ<br><b>व्युत्पत्तिः - </b>कुत्सितो वादः<br><br>कुवाद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಮಾತಾಡುವ<br><b>व्युत्पत्तिः - </b>कुत्सितो वादोऽस्य<br><b>विस्तारः - </b>"समौ कुवादकुचरौ" - अम० ।<br><br>

कुविद्या
कुविद्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ವಿದ್ಯೆ<br><b>व्युत्पत्तिः - </b>कुत्सिता विद्या<br><br>

कुविन्द
कुविन्द<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೇಯ್ಗೆಯವನು /ಬಟ್ಟೆಯನ್ನು ನೇಯುವವನು<br><b>निष्पत्तिः - </b>विद्लृ (लाभे) -"शः" (३-१-१३८) । मुम् (७-१-५९)<br><b>व्युत्पत्तिः - </b>कुं भूमिं विन्दति<br><br>

कुविवाह
कुविवाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಯಾ ವರ್ಣದವರಿಗೆ ವಿಹಿತವಾದುದಕ್ಕಿಂತಲೂ ಭಿನ್ನವಾದ ರೀತಿಯ ವಿವಾಹ /ನಿಷಿದ್ಧವಾದ ವಿವಾಹ /ಅಶಾಸ್ತ್ರೀಯವಾದ ವಿವಾಹ<br><b>व्युत्पत्तिः - </b>कुत्सितो विवाहः<br><br>

कुवृत्ति
कुवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ವ್ಯಾಪಾರ /ಕೆಟ್ಟ ನದತೆ<br><b>व्युत्पत्तिः - </b>कुत्सिता वृत्तिः<br><br>कुवृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಜೀವನ /ನಿಂದಿತವಾದ ಜೀವನ<br><br>कुवृत्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ವ್ಯಾಪಾರವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कुत्सिता वृत्तिः यस्य<br><br>कुवृत्ति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಂದಿತವಾದ ಜೀವನವುಳ್ಳ<br><br>

कुवेणि|कुवेणी
कुवेणि(णी)<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೀನುಗಳನ್ನು ಹಿಡಿದು ತುಂಬುವ ಬುಟ್ಟಿ<br><b>निष्पत्तिः - </b>वेणृ (गतौ) - "इन्" (उ० ४-११७) । वा "ङीष्" (ग० ४-१-४५)<br><b>व्युत्पत्तिः - </b>ईषत् वेणन्ते मत्स्या अस्याम्<br><br>कुवेणि(णी)<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಡ್ಡಾದಿಡ್ಡಿಯಾಗಿ ಹೆಣೆದಿರುವ ಜಡೆ<br><b>व्युत्पत्तिः - </b>कुत्सिता वेणी<br><br>

कुवेर
कुवेर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರ /ಧನಾಧಿಪತಿ /ಯಕ್ಷರಾಜ<br><br>

कुवेरक
कुवेरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಂದಿಮರ<br><br>

कुवेरार्द्रि
कुवेरार्द्रि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಲಾಸ ಪರ್ವತ<br><br>

कुश
कुश<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದರ್ಭೆ ಹುಲ್ಲು<br><b>निष्पत्तिः - </b>शीङ् (स्वप्ने) - "डः" (३-२-१०१) । शो (तनूकरणे) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कौ शेते । कुं पापं श्यति<br><b>प्रयोगाः - </b>"दिश वनहरिणीभ्यो वंशकाण्डच्छवीनां कबलमुपलकोटिच्छिन्नमूलं कुशनाम्"<br><b>उल्लेखाः - </b>भर्तृ० २-३४<br><br>कुश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಶಮಹಾರಾಜ<br><b>प्रयोगाः - </b>"स तौ कुशलवोन्मृष्टगर्भक्लेदौ तदाख्यया । कविः कुशवावेव चकार किल नामतः ॥"<br><b>उल्लेखाः - </b>रघु०१५-३२<br><br>कुश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತಿನ ಕುತ್ತಿಗೆಯ ಮೇಲೆ ನೊಗವನ್ನಿಟ್ಟು ಕಟ್ಟುವ ದರ್ಭೆಯ ಹಗ್ಗ<br><br>कुश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಪ್ತದ್ವೀಪಗಳಲ್ಲೊಂದಾದ ಕುಶದ್ವೀಪ<br><br>कुश<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><br>कुश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಾಪಾತ್ಮ<br><br>कुश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮದಿಸಿದವನು<br><br>

कुशा
कुशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆಯ ಕಡಿವಾಣ /ಲಗಾಮು<br><br>कुशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಜ್ಜು /ಹಗ್ಗ<br><br>कुशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗದಲ್ಲಿ ಸಾಮಗಾನ ಮಾಡುವಾಗ ಸ್ತೋತ್ರಗಳ ಎಣಿಕೆಗಾಗಿ ಇಡುವ ಮರದ ಗೂಟ<br><br>कुशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಜ್ಜು /ಹಗ್ಗ<br><b>विस्तारः - </b>"कुशी फाले कुशा रज्वाम्" - मेदि० ।<br><br>कुशा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಗದಲ್ಲಿ ಸಾಮಗಾನ ಮಾಡುವಾಗ ಸ್ತೋತ್ರಗಳ ಎಣಿಕೆಗಾಗಿ ಇಡುವ ಮರದ ಗೂಟ<br><br>

कुशी
कुशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಫಾಲ /ನೇಗಿಲಗುಳ<br><b>विस्तारः - </b>"कुशो रामसुते द्वीपे योक्त्रे दर्भे कुशं जले । कुशी फालेऽपि वल्गायां कुशा पापिष्ठमत्तयोः । कुशो वाचवदाख्यातः" - विश्व० । "कुशी फाले कुशा रज्वां त्रिषु पापिष्ठमत्तयोः" - मेदि० ।<br><br>कुशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣದ ನೇಗಿಲ ಗುಳ<br><b>निष्पत्तिः - </b>शो (तनूकरणे) - "डः" (३-२-१०१) । "ङीष्" (४-१-४२)<br><b>व्युत्पत्तिः - </b>कुं भूमिं श्यति<br><br>कुशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುರಿದ ಮೂಳೆಗೆ ಕಟ್ಟುವ ದಬ್ಬೆ<br><b>विस्तारः - </b>"कुशी भग्नास्थिबन्धः स्यात्" - वैज० ।<br><br>

कुशकाश
कुशकाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಶ ಮತ್ತು ಜೊಂಡುಹುಲ್ಲು<br><b>निष्पत्तिः - </b>वा एकवद्भावः (२-४-१२)<br><b>व्युत्पत्तिः - </b>कुशाश्च काशाश्च<br><br>

कुशद्वीप
कुशद्वीप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಪ್ತದ್ವೀಪಗಳಲ್ಲೊಂದು /ಪ್ರಪಂಚದಒಂದು ಭೂಭಾಗ<br><br>

कुशधारा
कुशधारा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನದಿ<br><br>

कुशध्वज
कुशध्वज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜನಕ ಮಹಾರಾಜನ ತಮ್ಮ /ಭರತ ಶತ್ರುಘ್ನರ ಮಾವ<br><b>प्रयोगाः - </b>"तस्य पुत्रद्वयं जज्ञे धर्मज्ञस्य महात्मनः । ज्येष्ठोऽहं मनुजो वीरो मम भ्राता कुशध्वजः ॥"<br><b>उल्लेखाः - </b>रामा०<br><br>

कुशनाभ
कुशनाभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರವಂಶದ ಕುಶಮಹಾರಾಜನ ೪ ಮಂದಿ ಮಕ್ಕಳರಲ್ಲೊಬ್ಬ<br><b>निष्पत्तिः - </b>"अच्" (५-४-७५)<br><b>व्युत्पत्तिः - </b>कुश इव नाभिरस्य<br><br>

कुशपुष्प
कुशपुष्प<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದರ್ಭೆ ಮತ್ತು ಹೂವು<br><b>व्युत्पत्तिः - </b>कुशाश्च पुष्पाणि च<br><br>

कुशल
कुशल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಯಾಣ /ಶುಭ /ಮಂಗಳ<br><b>निष्पत्तिः - </b>शल (चलने संवरणे च) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुत्सितं शलते संवृणोति<br><b>प्रयोगाः - </b>"कल्यणं वो विधत्तां करटमदधुनीलोलकल्लोलमालाखेलल्लोलम्बकोलाहलमुखरितदिक्चक्रवालान्तरालम्"<br><b>उल्लेखाः - </b>चं० रा०<br><br>कुशल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆರೋಗ್ಯ /ಕ್ಷೇಮ /ಸೌಖ್ಯ /ನೆಮ್ಮದಿ<br><b>प्रयोगाः - </b>"अपि कुशलममर्त्याः स्वागतं साम्प्रतं वः"<br><b>उल्लेखाः - </b>चं० रा०<br><br>कुशल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಾಣತನ /ಕಾರ್ಯಚತುರತೆ<br><br>कुशल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾಮರ್ಥ್ಯ /ದಕ್ಷತೆ<br><br>कुशल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಣ್ಯ /ಸುಕೃತ<br><br>कुशल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೃಪ್ತಿ<br><br>कुशल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಕ್ಷನಾದ /ಸಮರ್ಥನಾದ<br><b>प्रयोगाः - </b>"ह्रीप्रत्यूहप्रशमकुशलाः शीधवश्चक्रुरासाम्"<br><b>उल्लेखाः - </b>माघ० ९-८७<br><br>कुशल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿಕ್ಷಿತನಾದ /ಚೆನ್ನಾಗಿ ಪಳಗಿದ<br><br>कुशल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚೆನ್ನಗಿರುವ /ಒಳ್ಳೆಯ ಸ್ಥಿತಿಯಲ್ಲಿರುವ<br><br>कुशल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅರ್ಹನಾದ /ಯೋಗ್ಯನಾದ<br><b>विस्तारः - </b>"कुशलं निपुणे पुण्ये पर्याप्तौ मङ्गले क्षमे" - वैज० ।<br><br>कुशल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಪುಣ /ಅಭಿಜ್ಞ<br><b>प्रयोगाः - </b>"ये चैवं पुरुषाः कलासु कुशलास्तेष्वेव लोकस्थितिः"<br><b>उल्लेखाः - </b>भर्तृ० १-१८<br><br>कुशल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಾಣನಾದ /ಕಾರ್ಯದಲ್ಲಿ ಚತುರನಾದ<br><b>प्रयोगाः - </b>"भजते विदेशमधिकेन जितस्तदनुप्रवेशमथवा कुशलः"<br><b>उल्लेखाः - </b>माघ० ९-४८<br><br>कुशल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದರ್ಭೆಯನ್ನು ತೆಗೆದುಕೊಳ್ಳುವ<br><b>निष्पत्तिः - </b>ला (आदाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कुसान् लाति<br><br>

कुशलकाम
कुशलकाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಂಗಳವನ್ನು ಅಪೇಕ್ಷಿಸುವ /ಶುಭವನ್ನು ಬಯಸುವ<br><b>निष्पत्तिः - </b>कमु (कान्तौ) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कुशलं कामयते<br><br>

कुशलता
कुशलता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷತೆ /ಸಾಮರ್ಥ್ಯ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कुशलस्य भावः<br><br>कुशलता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಪುಣತೆ /ಅಭಿಜ್ಞತೆ /ಜಾಣತನ<br><b>प्रयोगाः - </b>"यथा यथा निषेवन्ते विषयान् विषयात्मकाः । तथा तथा कुशलता तेषां तेषूपजायते ॥"<br><b>उल्लेखाः - </b>मनु० १२-७३<br><br>

कुशलप्रश्न
कुशलप्रश्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿಯಿಂದ ಆರೋಗ್ಯ ಕ್ಷೇಮಗಳನ್ನು ಕೇಳುವುದು<br><b>व्युत्पत्तिः - </b>कुशलस्य प्रश्नः<br><br>

कुशलव
कुशलव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀರಾಮನ ಮಕ್ಕಳಾದ ಕುಶಲವರು<br><b>व्युत्पत्तिः - </b>कुशश्च लवश्च<br><b>प्रयोगाः - </b>"मैथिलेयौ कुशलवौ जगतुर्गुरुचोदितौ"<br><b>उल्लेखाः - </b>रघु० १५-६३<br><b>विस्तारः - </b>द्विवचनान्तं रूपम् ।<br><br>

कुशलवत्
कुशलवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ಷೇಮದಿಂದಿರುವ /ಆರೋಗ್ಯವಂತ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४) । मस्य वः (८-२-९)<br><b>व्युत्पत्तिः - </b>कुशलमस्यास्ति<br><b>प्रयोगाः - </b>"सर्वतः कुशलवानसि कच्चित्त्वं स नैषध इति प्रतिभा नः"<br><b>उल्लेखाः - </b>नैष० ५-७४<br><br>

कुशलिन्
कुशलिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಂಗಳವುಳ್ಳ /ಶುಭವುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-१३५)<br><b>व्युत्पत्तिः - </b>कुशलमस्यास्ति<br><br>कुशलिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕ್ಷೇಮವುಳ್ಳ<br><b>प्रयोगाः - </b>"सम्प्रत्युपेयाः कुशली पुनर्युधः सस्नेहमाशीरिति भर्तृरीरिता"<br><b>उल्लेखाः - </b>माघ० १५-९५<br><br>कुशलिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಾಣನಾದ /ಕಾರ್ಯಚತುರನಾದ<br><br>

कुशलिनी
कुशलिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कुशलिन् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><b>प्रयोगाः - </b>"कुशलिनी क्षेमस्य वार्तापि न"<br><b>उल्लेखाः - </b>सा० द०<br><br>

कुशस्थलनपु
कुशस्थलनपु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕನ್ಯಾಕುಬ್ಜ ದೇಶ<br><br>

कुशस्थली
कुशस्थली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಂತಿನಗರದ ಒಂದು ಹೆಸರು<br><br>

कुशाकर
कुशाकर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞದ ಅಗ್ನಿ<br><b>निष्पत्तिः - </b>आ + कॄ (विक्षेपे) - "अप्" (३-३-५७)<br><b>व्युत्पत्तिः - </b>कुशैराकीर्यते<br><br>

कुशाक्ष
कुशाक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದರ್ಭೆಯಂತೆ ತೀಕ್ಷ್ಣವಾದ ದೃಷ್ಟಿಯುಳ್ಳ ವಾನರ /ಕಪಿ<br><b>व्युत्पत्तिः - </b>कुश इव तीक्ष्णमक्षि यस्य<br><br>

कुशाग्र
कुशाग्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದರ್ಭೆಯ ತುದಿ<br><b>व्युत्पत्तिः - </b>कुशस्याग्रम्<br><br>

कुशाग्रधी
कुशाग्रधी<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದರ್ಭೆಯ ತುದಿಯಂತೆ ಸೂಕ್ಷ್ಮವಾದ ಬುದ್ಧಿಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कुशाग्रवत् सूक्ष्मा धीः यस्य<br><br>

कुसाग्रबुद्धि
कुसाग्रबुद्धि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದರ್ಭೆಯ ತುದಿಯಂತೆ ಸೂಕ್ಷ್ಮವಾದ ಬುದ್ಧಿಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कुशाग्रवत् सूक्ष्मा बुद्धिः यस्य<br><b>प्रयोगाः - </b>"अप्यग्रणीर्मन्त्रकृतामृषीणां कुशाग्रबुद्धे कुशली गुरुस्ते"<br><b>उल्लेखाः - </b>रघु० ५-४<br><br>

कुशाग्रीय
कुशाग्रीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದರ್ಭೆಯ ತುದಿಗೆ ಸಮಾನವಾದ /ದರ್ಭೆಯ ಅಗ್ರದಂತಿರುವ<br><b>निष्पत्तिः - </b>"छः"(५-३-१०५)<br><b>व्युत्पत्तिः - </b>कुशाग्रमिव<br><b>प्रयोगाः - </b>"कुरु बुद्धिं कुशाग्रीयामनुकामीनतां त्यज"<br><b>उल्लेखाः - </b>भट्टि० ५-१५<br><br>

कुशारणि
कुशारणि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ವಾಸ ಮಹರ್ಷಿ<br><b>विस्तारः - </b>"दुर्वासास्तु कुशारणिः" - त्रिकाण्ड० ।<br><br>

कुशावती
कुशावती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಶಮಹಾರಾಜನ ರಾಜಧಾನಿ<br><b>प्रयोगाः - </b>"स निवेश्य कुशावत्यां रिपुनागाङ्कुशं कुशम्"<br><b>उल्लेखाः - </b>रघु० १५-९७<br><br>

कुशाश्व
कुशाश्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯವಂಶದ ಒಬ್ಬ ದೊರೆ<br><b>प्रयोगाः - </b>"सृञ्जयस्य सुतः श्रीमान् सहदेवः प्रतापवान् । कुशाश्वः सहदेवस्य पुत्रः परमधार्मिकः ॥"<br><b>उल्लेखाः - </b>रामा०<br><br>कुशाश्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರವಂಶದ ಕುಶರಾಜನ ಒಬ್ಬ ಮಗ<br><br>

कुशासन
कुशासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದರ್ಭೆಯ ಆಸನ<br><b>व्युत्पत्तिः - </b>कुशस्यासनम्<br><br>कुशासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿಯನ್ನು ಆಳುವುದು<br><b>व्युत्पत्तिः - </b>कोः शासनम्<br><br>कुशासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಆಳ್ವಿಕೆ<br><b>व्युत्पत्तिः - </b>कुत्सितं शासनम्<br><br>कुशासन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದರ್ಭೆಯ ಆಸನವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कुशस्य आसनं यस्य<br><br>

कुशि
कुशि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಘೂಕ /ಗೂಬೆ<br><br>

कुशिक
कुशिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಶಮಹಾರಾಜನ ಮಗ /ಚಂದ್ರವಂಶದ ಒಬ್ಬ ದೊರೆ /ವಿಶ್ವಾಮಿತ್ರನ ತಾತ /ಗಾಧಿಯ ತಂದೆ<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कुशः जनकत्वेनास्त्यस्य<br><b>प्रयोगाः - </b>"कुशपुत्र बभूवुर्हि चत्वारो देववर्चसः । कुशिकः कुशनाभश्च कुशाश्वो मूर्तिमान् तथा ॥"<br><br>कुशिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೇಗಿಲ ಗುಳ<br><br>कुशिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸರ್ಜವೃಕ್ಷ /ಮತ್ತಿಮರ<br><br>कुशिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾರೆ ಗಿಡ<br><b>विस्तारः - </b>"कुशिको मुनिभेदे स्यात्फले सर्जे बिभीतके" - हेम० ।<br><br>

कुशिन्
कुशिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಲ್ಮೀಕಿ ಮಹರ್ಷಿ<br><b>विस्तारः - </b>"प्राचेतसस्तु वाल्मीकिर्वाल्मीकश्च कुशी कविः" - वैज० ।<br><br>कुशिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದರ್ಭೆ ಹಿಡಿದಿರುವ /ದರ್ಭೆಯನ್ನು ಧರಿಸಿರುವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कुशोऽस्त्यस्य<br><b>प्रयोगाः - </b>"दिने अष्टमे तु दीक्षितोऽहं यथाविधि । दण्डी मुण्डी कुशी चीरी घृताक्तो मेखलीकृतः ॥"<br><b>उल्लेखाः - </b>भा० अनु०<br><br>

कुशील
कुशील<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಸ್ವಭಾವವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कुत्सितं शीलं यस्य<br><br>

कुशीलव
कुशीलव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಲ್ಮೀಕಿ ಮಹರ್ಷಿ<br><br>कुशीलव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಯಕ /ಹಾಡುಗಾರ<br><b>प्रयोगाः - </b>"कुशीलवौ कुशलवनामधारिणौ"<br><b>उल्लेखाः - </b>चं० रा०<br><br>कुशीलव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಟ /ಅಭಿನಯಕಾರ<br><b>निष्पत्तिः - </b>वा (गतिगन्धनयोः) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कुत्सितं शीलं वाति<br><br>कुशीलव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತುತಿಪಾಠಕ /ಹೊಗಳುಭಟ<br><br>कुशीलव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾಚಕ /ಭಿಕ್ಷುಕ<br><b>विस्तारः - </b>"कुशीलवस्तु वाल्मीकौ नटयाचकयोरपि" - मेदि० ।<br><br>

कुशीवश
कुशीवश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಲ್ಮೀಕಿ ಮಹರ್ಷಿ<br><b>विस्तारः - </b>"प्राचेतसस्तु वाल्मीकिर्वाल्मीकश्च कुशी कविः" - वैज० ।<br><br>

कुशूल
कुशूल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಣಜ /ಧಾನ್ಯವನ್ನು ಕೂಡಿಡುವ ಜಾಗ /ಉಗ್ರಾಣ<br><br>कुशूल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುರಿಯುವ ಬಾಣಲೆ<br><br>कुशूल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತುಷಾಗ್ನಿ /ಹೊಟ್ಟೆಯೊಳಗಿನ ಬೆಂಕಿ<br><br>

कुशूलधान्य
कुशूलधान्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೂರು ವರ್ಷಗಳಿಗಾಗುವಷ್ಟು ಕೂಡಿಸಿಟ್ಟಿರುವ ಧಾನ್ಯ<br><br>कुशूलधान्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂರು ವರ್ಷಗಳಿಗಾಗುವಷ್ಟು ಧಾನ್ಯವನ್ನು ಕೂಡಿಸಿಟ್ಟಿರುವವನು<br><b>व्युत्पत्तिः - </b>कुशूलपरिमितं धान्यं यस्य<br><br>

कुसूलधान्यक
कुसूलधान्यक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೂರು ವರ್ಷಗಳಿಗಾಗುವಷ್ಟು ಧಾನ್ಯವನ್ನು ಕೂಡಿಸಿಟ್ಟಿರುವವನು<br><b>निष्पत्तिः - </b>वा "कप्" (५-४-१५४)<br><br>

कुशेशय
कुशेशय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪದ್ಮ /ತಾವರೆ /ಕಮಲ<br><b>निष्पत्तिः - </b>शीङ् (स्वप्ने) - "अच्" (३-२-१५) ।<br><b>व्युत्पत्तिः - </b>कुशे जले शेते<br><b>प्रयोगाः - </b>"कुशेशयैरत्र जलाशयोषिता मुदा रमन्ते कलभा विकस्वरैः"<br><b>उल्लेखाः - </b>माघ० ४-३३<br><br>कुशेशय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಶ ದ್ವೀಪದ ಸಪ್ತ ಕುಲಪರ್ವತಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"कुशेशयो हरिश्चैव सप्तमो मन्थराचलः"<br><br>कुशेशय<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಾರಸ ಪಕ್ಷಿ /ನೀರು ಹಕ್ಕಿ /ತಾವರೆ ಹಕ್ಕಿ<br><br>

कुशोदक
कुशोदक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧರ್ಭೆಯ ನೀರು /ದಾನ ಮಾಡುವಾಗ ದರ್ಭೆಯೊಡನೆ ಬಿಡುವ ನೀರು<br><b>व्युत्पत्तिः - </b>कुशसहितमुदकम्<br><br>

कुष|निष्कर्षे|कुष्णाति
कुष - निष्कर्षे (क्र्या० पर० सक० से०) कुष्णाति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಇಷ್ಟೆಂದು ನಿಶ್ಚಯಿಸು<br><br>कुष - निष्कर्षे (क्र्या० पर० सक० से०) कुष्णाति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೊರಕ್ಕೆ ತಳ್ಳು /ಹೊರಕ್ಕೆ ಹೊರಡಿಸು<br><b>प्रयोगाः - </b>"ततोऽकुष्णाद्दशग्रीवः क्रुद्धः प्राणान् वनौकसान्"<br><b>उल्लेखाः - </b>भट्टि० १७-८०<br><br>

कुषाकु
कुषाकु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><br>कुषाकु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>निष्पत्तिः - </b>कुष (निष्कर्षे) - "काकुः" (उ० ३-७७)<br><br>कुषाकु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾನರ /ಕಪಿ<br><br>कुषाकु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀಚ /ಅಧಮ<br><br>कुषाकु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಹಿಸುವ /ಸುಡುವ<br><br>कुषाकु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಇತರರಿಗೆ ಖೇದವುಂಟುಮಾಡುವ /ಇತರರ ಮನ ನೋಯಿಸುವ<br><b>प्रयोगाः - </b>"कुषाकुर्मर्कटे भानौ परोत्तापिनि पावके" - विश्व० ।<br><br>

कुषीतक
कुषीतक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಋಷಿ<br><br>

कुषिन्
कुषिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೬೦ ವರ್ಷ ವಯಸ್ಸಿನ ಗಜ<br><b>प्रयोगाः - </b>"मदवृन्दः कुषी कम्बुः शुण्डालः षष्टिहायनः" - वैज० ।<br><br>

कुष्ठ
कुष्ठ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂಗಲುಕೋಷ್ಠ<br><b>निष्पत्तिः - </b>कुष (निष्कर्षे) - "क्थन्" (उ० २-२)<br><b>व्युत्पत्तिः - </b>कुष्णाति रोगम<br><br>कुष्ठ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ವಿತ್ರ /ಶ್ವೇತ /ತೊನ್ನು ರೋಗ<br><b>निष्पत्तिः - </b>कुष (निष्कर्षे) - "क्थन्" (उ० २-२)<br><b>व्युत्पत्तिः - </b>कुष्णात्यङ्गम्<br><b>प्रयोगाः - </b>"त्वं सर्वभक्षो भव भीमकर्मा कुष्ठाभिभूतोऽनल धुमगर्भः"<br><b>उल्लेखाः - </b>कुमा० ९-१६<br><br>

कुष्ठघ्न
कुष्ठघ्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಷ್ಠರೋಗವನ್ನು ನಾಶಪಡಿಸುವ ಔಷಧ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) - "टक्" (३-२-५३)<br><b>व्युत्पत्तिः - </b>कुष्ठं हन्ति<br><br>

कुष्ठनाशन
कुष्ठनाशन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಂದಿಗೆಡ್ಡೆ /ವಾರಾಹಿ ಗಿಡ<br><b>निष्पत्तिः - </b>णश (अदर्शने) + णिच् - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुष्ठं नाशयति<br><br>कुष्ठनाशन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿ ಸಾಸುವೆ<br><br>कुष्ठनाशन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಷ್ಠರೋಗವನ್ನು ವಾಸಿಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>णश (अदर्शने) + णिच् - भावे "ल्युट्" (३-३-११५)<br><br>कुष्ठनाशन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಷ್ಠರೋಗವನ್ನು ವಾಸಿಮಾಡುವ /ತೊನ್ನು ರೊಗವನ್ನು ಹೋಗಲಾಡಿಸುವ<br><br>

कुष्ठनाशिन्
कुष्ठनाशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಷ್ಠರೋಗವನ್ನು ಗುಣಪಡಿಸುವ<br><b>निष्पत्तिः - </b>णश (अदर्शने) + णिच् -"णिनिः" (३-१-१३४)<br><br>

कुष्ठनाशिनी
कुष्ठनाशिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कुष्ठनाशिन् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कुष्ठल
कुष्ठल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂತಲ /ಭೂಮಿ<br><b>निष्पत्तिः - </b>षत्वम् (८-३-९६)<br><b>व्युत्पत्तिः - </b>कोः स्थलम्<br><b>प्रयोगाः - </b>"शयानां कुष्ठले ताराम् दिविष्ठामिव निर्मलाम्"<br><b>उल्लेखाः - </b>भट्टि० ९-८४<br><br>

कुष्ठहृत्
कुष्ठहृत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಗ್ಗಲಿ ಮರ<br><b>निष्पत्तिः - </b>हृञ् (हरणे) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>कुष्ठं हरति<br><b>विस्तारः - </b>"खदिरो बालपत्रकः । यूपद्रुः कुष्ठहृत्" - त्रिकाण्ड० ।<br><br>कुष्ठहृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಷ್ಠರೋಗವನ್ನು ವಾಸಿಮಾಡುವ<br><br>

कुष्ठित
कुष्ठित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಷ್ಠರೋಗವುಂಟಾಗಿರುವ /ತೊನ್ನು ಹಿಡಿದಿರುವ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>कुष्ठमस्य सञ्जातम्<br><b>प्रयोगाः - </b>"दम्पत्योः स्नेहबाहुल्यात् दुष्टशोणितशुक्रयोः । यदपत्यं तयोर्जातं ज्ञेयं तदपि कुष्ठितम् ॥"<br><br>

कुष्ठिन्
कुष्ठिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಷ್ಠರೋಗಿ /ತೊನ್ನು ಹಿಡಿದಿರುವವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कुष्ठमास्यास्ति<br><br>

कुष्ठिनी
कुष्ठिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಷ್ಠರೋಗಿ /ತೊನ್ನು ಹಿಡಿದಿರುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कुष्मल
कुष्मल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವಿಕೆ<br><b>निष्पत्तिः - </b>कुष (निष्कर्षे) - "क्मलन्" (उ० ४-१८६)<br><br>कुष्मल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊದಿಕೆ<br><br>

कुष्माण्ड
कुष्माण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಬಳದ ಗಿಡ<br><b>व्युत्पत्तिः - </b>ईषत् ऊष्मा अण्डेष्वस्य<br><br>कुष्माण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರನ ಪ್ರಮಥಗಣಗಳಲ್ಲೊಬ್ಬ<br><br>

कुष्माण्डी
कुष्माण्डी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ<br><br>

कुष्माण्डकरिसायन
कुष्माण्डकरिसायन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಷ್ಮಾಂಡ ಲೇಹ್ಯ /ಕುಂಬಳಕಾಯಿ ಲೇಹ್ಯ<br><br>

कुस|श्लेषणे|कुस्यति
कुस - श्लेषणे (दिवा० पर० सक० से०) कुस्यति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಆಲಿಂಗಿಸು /ಅಪ್ಪಿಕೋ<br><br>

कुसित
कुसित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಶ /ಜನಪದ<br><b>निष्पत्तिः - </b>कुस (श्लेषणे) - "इतः" (उ० ४-१०६)<br><br>कुसित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದೇವತೆ<br><br>

कुसितायी
कुसितायी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಸಿತ ದೇವತೆಯ ಪತ್ನಿ<br><b>निष्पत्तिः - </b>"ऐ" आदेशः "ङीप्" च (४-१-३७)<br><b>व्युत्पत्तिः - </b>कुसितस्य पत्नी<br><br>

कुसिद
कुसिद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದೇವತೆ<br><br>कुसिद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಶ /ಜನಪದ<br><b>निष्पत्तिः - </b>कुस (श्लेषणे) -"इदः" (उ० ४-१०६)<br><br>

कुसिदायी
कुसिदायी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಸಿತ ದೇವತೆಯ ಪತ್ನಿ<br><b>निष्पत्तिः - </b>"ऐ" आदेशः "ङीप्" च (४-१-३७)<br><b>व्युत्पत्तिः - </b>कुसिदस्य पत्नी<br><br>

कुसीद
कुसीद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಡ್ಡಿಯಿಂದ ನಡೆಸುವ ಜೀವನ /ಸಾಲ ಕೊಟ್ಟು ಅದರಿಂದ ಬರುವ ಬಡ್ಡಿಯ ಹಣದಿಂದ ಜೀವಿಸುವುದು<br><br>कुसीद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಡ್ಡಿಯ ಹಣದಿಂದ ಜೀವಿಸುವವನು<br><b>विस्तारः - </b>"कुसीदं वृद्धिजीवने । वृद्ध्याजीवे" - हेम० ।<br><br>

कुसीदक
कुसीदक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಡ್ಡಿಯ ಹಣದಿಂದ ಜೀವಿಸುವವನು<br><b>निष्पत्तिः - </b>स्वार्थे "कः"<br><br>

कुसीदिन्
कुसीदिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಡ್ಡಿಗಾಗಿ ಹಣವನ್ನು ಸಾಲಕೊಡುವವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कुसीदमस्यास्ति<br><br>

कुसीदिनी
कुसीदिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಡ್ಡಿಗಾಗಿ ಹಣವನ್ನು ಸಾಲಕೊಡುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कुसीदपथ
कुसीदपथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನ್ಯಾಯವಾದುದಕ್ಕಿಂತ ಹೆಚ್ಚು ಬಡ್ದಿಗೆ ಸಾಲಕೊಡುವುದು<br><b>प्रयोगाः - </b>"कृतानुसारादधिका व्यतिरिक्ता न सिध्यति । कुसीदपथमाहुस्तं पञ्चकं शतमर्हति ॥"<br><b>उल्लेखाः - </b>मनु० ८-१५२<br><br>

कुसीदिक
कुसीदिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಡ್ಡಿಗಾಗಿ ಹಣವನ್ನು ಸಾಲಕೊಡುವವನು<br><b>निष्पत्तिः - </b>"ष्ठन्" ष्ठच्" वा (४-४-३१)<br><b>व्युत्पत्तिः - </b>कुसीदं वृद्धिः, तदर्थं द्रव्यं कुसीदं, तत्प्रयच्छति<br><br>

कुसीदिकी
कुसीदिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಡ್ಡಿಗಾಗಿ ಹಣವನ್ನು ಸಾಲಕೊಡುವವಳು<br><br>

कुसुम
कुसुम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಷ್ಪ /ಹೂವು<br><b>निष्पत्तिः - </b>कुस (श्लेषणे) - "उमः" (उ० ४-१०६)<br><b>व्युत्पत्तिः - </b>कुस्यति<br><b>प्रयोगाः - </b>"सुगन्धयद्दिशः शुभ्रमम्लानि कुसुमं दिवः । भूरि तत्रापतत्तस्मादुत्पपात दिवं यशः ॥"<br><b>उल्लेखाः - </b>माघ० १९-२०<br><br>कुसुम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ನೇತ್ರರೋಗ<br><br>कुसुम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸರ ರಜಸ್ಸು<br><br>कुसुम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಫಲ /ಹಣ್ಣು<br><b>विस्तारः - </b>"कुसुमं स्त्रीरजोनेत्ररोगयोः फलपुष्पयोः" - मेदि० ।<br><br>

कुसुमकार्मुक
कुसुमकार्मुक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥ /ಕಾಮದೇವ<br><b>व्युत्पत्तिः - </b>कुसुमं कार्मुकमस्य<br><b>प्रयोगाः - </b>"कुसुमकार्मुककार्मुकसंहितद्रुतशिलीमुखखण्डितविग्रहाः"<br><b>उल्लेखाः - </b>माघ० ६-१६<br><br>

कुसुमचाप
कुसुमचाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥ /ಕಾಮದೇವ<br><b>व्युत्पत्तिः - </b>कुसुमं चापो यस्य<br><b>प्रयोगाः - </b>"कुसुमचापतेजयदंशुभिर्हिमकरो मकरोर्जितकेतनम्"<br><b>उल्लेखाः - </b>रघु० ९-३९<br><br>

कुसुमबाण
कुसुमबाण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥ /ಕಾಮದೇವ<br><b>व्युत्पत्तिः - </b>कुसुमं बाणः यस्य<br><br>

कुसुमसायक
कुसुमसायक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥ /ಕಾಮದೇವ<br><b>व्युत्पत्तिः - </b>कुसुमं सायको यस्य<br><br>

कुसुमधन्वन्
कुसुमधन्वन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥ /ಕಾಮದೇವ<br><b>व्युत्पत्तिः - </b>कुसुमं धनुरस्य<br><br>

कुसुमपुर
कुसुमपुर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಟಲಿಪುತ್ರ ನಗರ /ಚಂದ್ರಗುಪ್ತನ ರಾಜಧಾನಿ<br><b>प्रयोगाः - </b>"अये, कुसुमपुरवृत्तान्तज्ञः । अहं भवत्प्रणिधिश्चेति गतार्थः"<br><b>उल्लेखाः - </b>मुद्रा० २<br><br>

कुसुममय
कुसुममय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹೂವಿನಿಂದ ತುಂಬಿದ /ಹೂವು ಹೆಚ್ಚಾಗಿರುವ<br><b>निष्पत्तिः - </b>कुसुम - "मयट्" (५-४-२१)<br><br>

कुसुममयी
कुसुममयी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೂವಿನಿಂದ ತುಂಬಿದ /ಹೂವು ಹೆಚ್ಚಾಗಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

कुसुमविचित्रा
कुसुमविचित्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೃತ್ತರತ್ನಾಕರೋಕ್ತವಾದ ೧೨ನೆಯ ಛಂದಸ್ಸಿನ ಒಂದು ವೃತ್ತ<br><b>प्रयोगाः - </b>"नयसहितौ न्यौ कुसुमविचित्रा"<br><b>उल्लेखाः - </b>वृ० र०<br><br>कुसुमविचित्रा<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುಷ್ಪಗಳಿಂದ ವಿಚಿತ್ರವಾಗಿರುವ /ಚಿತ್ರವಿಚಿತ್ರವಾಗಿರುವ<br><b>प्रयोगाः - </b>"उपवनभूमौ हिमगिरिपुत्री मणीमयभूषा मधुरतराक्षी । भ्रमरकदम्बैरकलयदिद्धां कुसुमविचित्रां कुरवकशाखाम्" ॥<br><br>

कुसुमशयन
कुसुमशयन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೂವಿನ ಹಾಸಿಗೆ<br><br>

कुसुमाकर
कुसुमाकर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುಷ್ಪಗಳಿಗೆ ಆಕರವಾಗಿರುವ ವಸಂತ ಋತು<br><b>व्युत्पत्तिः - </b>कुसुमानामाकरः<br><b>प्रयोगाः - </b>"मासानां मार्गशीर्षोऽहं ऋतूनां कुसुमाकरः"<br><b>उल्लेखाः - </b>गीता० १०-३५<br><br>

कुसुमागम
कुसुमागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುಷ್ಪಗಳ ಕಾಲವಾದ ವಸಂತ ಋತು<br><b>व्युत्पत्तिः - </b>कुसुमानामागमो यत्र<br><br>

कुसुमाञ्जन
कुसुमाञ्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿತ್ತಾಳೆ ಭಸ್ಮದಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ ಅಂಜನ<br><br>

कुसुमाञ्जलि
कुसुमाञ्जलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುಷ್ಪಗಳ ಅಂಜಲಿ /ಹೂವಿನ ಬೊಗಸೆ<br><b>व्युत्पत्तिः - </b>कुसुमानामञ्जलिः<br><br>कुसुमाञ्जलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉದಯನಾಚಾರ್ಯರಿಂದ ರಚಿತವಾದ ಪರಮಾತ್ಮನನ್ನು ನಿರೂಪಿಸುವ ಒಂದು ಗ್ರಂಥ<br><b>प्रयोगाः - </b>"कुसुमाञ्जलिरपर इव प्रकीर्यते काव्यबन्ध एषोऽत्र"<br><b>उल्लेखाः - </b>वेणी० १-५<br><br>

कुसुमायुध
कुसुमायुध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥ /ಕಾಮದೇವ<br><b>व्युत्पत्तिः - </b>कुसुमानि आयुधानि अस्य<br><b>प्रयोगाः - </b>"श्वासानिलामोदभरानुमेयां दधद्विवाणीं कुसुमायुधस्य"<br><b>उल्लेखाः - </b>नैष० ७-३६<br><br>

कुसुमावचय
कुसुमावचय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಿಡಗಳ ತುದಿಯಲ್ಲಿರುವ ಪುಷ್ಪಗಳನ್ನು ಕೋಲು ಮೊದಲಾದ ಸಾಧನಗಳ ಸಹಾಯದಿಂದ ಬಿಡಿಸುವುದು<br><br>कुसुमावचय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಿಡಗಳಲ್ಲಿ ಕಳ್ಳತನದಿಂದ ಹೂವನ್ನು ಬಿಡಿಸಿಕೊಳ್ಳುವುದು<br><b>निष्पत्तिः - </b>कुसुम + अव + चिञ् (चयने) - "अच्" (३-२-५६)<br><br>

कुसुमावचाय
कुसुमावचाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿಯಲ್ಲೇ ನಿಂತು ಕೈಯಿಂದ ಗಿಡಗಳ ಹೂವನ್ನು ಬಿಡಿಸುವುದು<br><b>निष्पत्तिः - </b>"घञ्" (३-३-४०)<br><br>

कुसुमाशुग
कुसुमाशुग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥ /ಕಾಮದೇವ<br><b>व्युत्पत्तिः - </b>कुस्मानि आशुगा अस्य<br><b>प्रयोगाः - </b>"तनोत्यकीर्तिं कुसुमाशुगस्य सैषा बतेन्दीवरकर्णपूरा"<br><b>उल्लेखाः - </b>नैष० १०-११८<br><br>

कुसुमासव
कुसुमासव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೇನುತುಪ್ಪ<br><br>कुसुमासव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುಷ್ಪದಿಂದ ತಯಾರಿಸಲ್ಪಟ್ಟ ಮದ್ಯ<br><br>

कुसुमित
कुसुमित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುಷ್ಪಿಸಿರುವ /ಹೂವು ಬಿಟ್ಟಿರುವ /ಹೂವುಗಳಿಂದ ತುಂಬಿರುವ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>कुसुमान्यस्य सञ्जातानि<br><b>प्रयोगाः - </b>"कुसुमिततरुजालसन्ततानि भ्रमरयुतानि समुद्रतीरजानि"<br><b>उल्लेखाः - </b>रामा०<br><br>

कुसुमेषु
कुसुमेषु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥ /ಕಾಮದೇವ<br><b>व्युत्पत्तिः - </b>कुसुमान् इषवोऽस्य<br><b>प्रयोगाः - </b>"अनिशं निजैरकरुणः करुणं कुसुमेषुरुत्तपति यद्विशिखैः"<br><b>उल्लेखाः - </b>माघ० ९-६७<br><br>

कुसुमोच्चय
कुसुमोच्चय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುಷ್ಪಗಳಸಮೂಹ /ಹೂವುಗಳ ರಾಶಿ<br><b>व्युत्पत्तिः - </b>कुसुमानामुच्चयः<br><br>कुसुमोच्चय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೂವಿನ ಗೊಂಚಲು<br><b>व्युत्पत्तिः - </b>कुसुमानामुच्चयो यत्र<br><br>

कुसुम्भ
कुसुम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಂಡಲು<br><b>निष्पत्तिः - </b>कुस (श्लेषणे) - "उम्भः" (उ० ४-१०६)<br><br>कुसुम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಕುಮದ ಹೂವು /ಕುಂಕುಮ ಕೇಸರಿ<br><br>कुसुम्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಸುಬೆ ಗಿಡ<br><br>कुसुम्भ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಸುಬೆ ಹೂವು<br><b>प्रयोगाः - </b>"विहिताञ्जलिर्जनतया दधती विकसत्कुसुम्भकुसुमारुणताम्"<br><b>उल्लेखाः - </b>माघ० ९-१४<br><b>विस्तारः - </b>"स्यात् कुसुम्भं वह्निशिखं महारजनमित्यपि" - अम० ।"स्यान्महारजने क्लीबं कुसुम्भं करके पुमान्" - अम० ।<br><br>कुसुम्भ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುವರ್ಣ /ಚಿನ್ನ<br><b>विस्तारः - </b>"कुसुम्भं हेमनि महारजने ना कमण्डलौ" - मेदि० ।<br><br>

कुसुम्भराग
कुसुम्भराग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಸುಬೆ ಹೂವಿನ ಬಣ್ಣ<br><b>व्युत्पत्तिः - </b>कुसुम्भस्य तत्पुरुषस्य रागः<br><br>कुसुम्भराग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಸುಬೆ ಹೂವಿನ ಬಣ್ಣದಂತಿರುವ ಪತಿ-ಪತ್ನಿಯರ ಅನುರಾಗ /ಗಂಡಹೆಂಡಿರ ಪ್ರೇಮ<br><b>व्युत्पत्तिः - </b>कुसुम्भस्तद्रस इव रागः<br><br>

कुसुम्भवत्
कुसुम्भवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಮಂಡಲುವನ್ನು ಹಿಡಿದಿರುವ ಸಂನ್ಯಾಸಿ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४) । मस्य वः (८-२-९)<br><b>व्युत्पत्तिः - </b>कुसुम्भोऽस्यास्ति<br><b>प्रयोगाः - </b>"क्लृप्तकेशनखश्मश्रुः पात्री दण्डी कुसुम्भवान्"<br><b>उल्लेखाः - </b>मनु० ६-५२<br><br>

कुसू
कुसू<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಸರಿನಲ್ಲಿರುವ ಎರುಬುಹುಳು<br><b>विस्तारः - </b>"गण्डूपदः किञ्चुलकः कुसूः" - अभि० चि० ।<br><br>

कुसूल
कुसूल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಣಜ /ಧಾನ್ಯವನ್ನು ಕೂಡಿಡುವ ಜಾಗ /ಉಗ್ರಾಣ<br><b>निष्पत्तिः - </b>कुस (श्लेषणे)- "ऊलच्" (उ० ४-९०)<br><br>कुसूल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುರಿಯುವ ಬಾಣಲೆ<br><br>

कुसूलधान्य
कुसूलधान्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>೩ ವರ್ಷಗಳಿಗಾಗುವಷ್ಟು ಕೂಡಿಸಿಟ್ಟಿರುವ ಧಾನ್ಯ<br><br>कुसूलधान्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>೩ ವರ್ಷಗಳಿಗಾಗುವಷ್ಟು ಧಾನ್ಯವನ್ನು ಕೂಡಿಸಿಟ್ಟಿರುವವನು<br><b>निष्पत्तिः - </b>वा "कप्" (५-४-१५४)<br><b>व्युत्पत्तिः - </b>कुसूलमितं धान्यं यस्य<br><br>

कुसूलधान्यक
कुसूलधान्यक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>೩ ವರ್ಷಗಳಿಗಾಗುವಷ್ಟು ಧಾನ್ಯವನ್ನು ಕೂಡಿಸಿಟ್ಟಿರುವವನು<br><b>प्रयोगाः - </b>"कुसूलधान्यको वा स्यात् कुम्भीधान्यक एव वा"<br><b>उल्लेखाः - </b>मनु० ४-७<br><br>

कुसूलपाद
कुसूलपाद<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾಣಲಿಯಂತೆ ಅಗಲವಾಗಿಯೂ ಗುಂಡಾಗಿಯೂ ಇರುವ ಕಾಲುಗಳುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>कुसूलाविव पादौ यस्य<br><br>

कुसृति
कुसृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಠ್ಯ /ಠಕ್ಕು /ವಂಚನೆ /ಮೋಸ<br><b>निष्पत्तिः - </b>सृ (गतौ) - "क्तिच्" (३-३-१७४)<br><b>व्युत्पत्तिः - </b>कुत्सिता सृतिः<br><b>विस्तारः - </b>"कुसृतिर्निकृतिः शाठ्यम्" - अम० ।<br><br>कुसृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಜಾಲ ವಿದ್ಯೆ /ಯಕ್ಷಿಣೀ ವಿದ್ಯೆ<br><b>विस्तारः - </b>"इन्द्रजालं तु कुहकं जालं कुसृतिरित्यपि" - अभि० चि० ।<br><br>कुसृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಮಾರ್ಗ /ತಪ್ಪು ದಾರಿ /ಶಾಸ್ತ್ರೀಯವಲ್ಲದ ದಾರಿ<br><br>कुसृति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಟಿ /ವಂಚಕ /ಮೋಸಗಾರ<br><b>व्युत्पत्तिः - </b>कुत्सिता वृत्तिः पदवी यस्य<br><b>प्रयोगाः - </b>"कस्माद्वयं कुसृतयः खलयोनयस्ते दाक्षिण्यदृष्टिपदवीं भवतः प्रणीताः"<br><b>उल्लेखाः - </b>भाग० ८-२३-७<br><br>

कुस्तुभ
कुस्तुभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ನಾರಾಯಣ<br><b>निष्पत्तिः - </b>ष्टुभु (स्तम्भे) - "कः" (वा० ३-२-५)<br><b>व्युत्पत्तिः - </b>कुं स्तोभते<br><br>कुस्तुभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ<br><b>व्युत्पत्तिः - </b>कुं भुवं स्तुभ्नाति<br><br>

कुस्तुम्बरी
कुस्तुम्बरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊತ್ತುಂಬರಿ<br><b>व्युत्पत्तिः - </b>कुत्सिता तुम्बरी<br><b>विस्तारः - </b>"छत्रा कुस्तुम्बरी धान्या धन्या धाना धनीयिका" - वैज० ।<br><br>

कुस्तुम्बुरु
कुस्तुम्बुरु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧನಿಯ /ಕೊತ್ತುಂಬರಿ<br><b>निष्पत्तिः - </b>तुबि (अर्दने) - "उरुः" बाहु० । सुट् (६-१-१४३)<br><b>व्युत्पत्तिः - </b>कुत्सितं तुम्बति<br><b>विस्तारः - </b>"कुस्तुम्बुरु च धान्यं च भृङ्गा स्यात् मातुलानिका" - वैज० ।<br><br>

कुह
कुह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರ<br><b>निष्पत्तिः - </b>कुह (विस्मापने) + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुहयते विस्मापयते<br><b>विस्तारः - </b>"श्रीदः सितोदरकुहेशसखाः" - अभि० चि० ।<br><br>कुह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಶ್ಚರ್ಯವುಂಟುಮಾಡುವ<br><br>

कुहक
कुहक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಐಂದ್ರಜಾಲಿಕ /ಮಾಯಾವಿ /ಯಕ್ಷಿಣಿಗಾರ<br><b>निष्पत्तिः - </b>कुह (विस्मापने) - "क्वुन्" (उ० २-३८)<br><b>प्रयोगाः - </b>"क्वचिदर्चनमिन्द्रजालतश्चेत् कुहकाः सन्ति परःशताः पृथिव्याम्"<br><b>उल्लेखाः - </b>याद० १५-५१<br><br>कुहक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದುಸರ್ಪ<br><b>प्रयोगाः - </b>"ततोऽधस्तान्महातले काद्रवेयाणां सर्पाणां नैकशिरसां क्रोधवशो नाम गणः कुहकतक्षककालियसुषेणादिप्रधानाः महाभोगवन्तः"<br><b>उल्लेखाः - </b>भाग० ५-२४-२९<br><br>कुहक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಜಾಲ ವಿದ್ಯೆ /ಯಕ್ಷಿಣೀ ವಿದ್ಯೆ /ಇಲ್ಲದಿರುವುದನ್ನು ಇರುವಂತೆ ತೋರಿಸುವ ವ್ಯಾಪಾರ<br><b>प्रयोगाः - </b>"तेजोवारिमृदां यथा विनिमयो यत्र त्रिसर्गोऽमृषा धाम्ना स्वेन सदा निरस्तकुहकं सत्यं परं धीमहि"<br><b>उल्लेखाः - </b>भाग० १-१-१<br><b>विस्तारः - </b>"इन्द्रजालं तु कुहकम्" - अभि० चि०<br><br>कुहक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಟ /ಮೋಸ<br><br>कुहक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಂಚಕ/ಮೋಸಗಾರ<br><b>विस्तारः - </b>"धूर्तस्तु वञ्चकः । व्यंसकः कुहको दाण्डाजिनिको मायिजालकौ" - अभि० चि० ।<br><br>

कुहिका
कुहिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कुहक ಪದದ ಅರ್ಥ<br><br>

कुहकस्वन
कुहकस्वन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವನಕುಕ್ಕುಟ /ಕಾಡುಕೋಳಿ<br><b>विस्तारः - </b>"कुम्भकारः कुक्कुटस्तु कुक्कुभः कुहकस्वनः" - अभि० चि० ।<br><br>

कुहन
कुहन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂಷಿಕ /ಇಲಿ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) - "अप्" बाहु० ।<br><b>व्युत्पत्तिः - </b>कु ईषत्प्रयत्नेन हन्यते<br><br>कुहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಮಣ್ಣಿನ ಪಾತ್ರೆ<br><br>कुहन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಜಿನ ಪಾತ್ರೆ<br><b>विस्तारः - </b>"कुहनं मृत्तिकाभाण्दविशेषे काचभाण्डने" - मेदि० ।<br><br>कुहन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸೂಯೆಯುಳ್ಳವನು /ಇತರರ ಅಭಿವೃದ್ಧಿಯನ್ನು ನೋಡಿ ಸಹಿಸಲಾರದವನು<br><b>विस्तारः - </b>"कुहनो मूषिके सेर्ष्ये" - हेम० ।<br><br>

कुहना
कुहना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಡಂಭಾಚಾರ /ಧನಸಂಪಾದನೆಗಾಗಿ ಧಾರ್ಮಿಕ ವೇಷ ಹಾಕುವುದು<br><b>विस्तारः - </b>"कुहना दम्भकर्मणि" - हेम० ।<br><br>कुहना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಟ /ವೇಷ /ಕಾರಣಾಂತರದಿಂದ ರೂಪಬದಲಾವಣೆ<br><b>प्रयोगाः - </b>"मनुष्यभावाभिनयव्यवस्थितां कुशीलवार्हां कुहनां वहन् प्रभुः"<br><b>उल्लेखाः - </b>याद० १४-६१<br><br>

कुहर
कुहर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸರ್ಪ<br><b>निष्पत्तिः - </b>हृञ् (हरणे) - "अच्" (३-२-९)<br><b>व्युत्पत्तिः - </b>कुं भूमिं हरति<br><br>कुहर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಲ /ರಂಧ್ರ /ತೂತು /ಹಳ್ಳ /ಗುಣಿ<br><b>प्रयोगाः - </b>"हाराग्रजाग्रद्गरुडाश्मरश्मिपीनाभनाभीकुहरान्धकारम्"<br><b>उल्लेखाः - </b>नैष० १०-१०४<br><br>कुहर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಹೆ /ಗವಿ<br><b>प्रयोगाः - </b>"तैः किं मत्तकरीन्द्रकुम्भकुहरे नारोपणीयाः कराः"<br><b>उल्लेखाः - </b>प्र० रा०<br><b>विस्तारः - </b>"कुहरं गह्वरे छिद्रे क्लीबं नागान्तरे पुमान्" - मेदि० ।<br><br>कुहर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಭೋಗ /ರತಿಕ್ರೀಡೆ<br><br>

कुहरित
कुहरित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಿಕಧ್ವನಿ /ಕೋಗಿಲೆಯ ಕೂಗು<br><br>कुहरित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರತಿಧ್ವನಿ /ಸಂಭೋಗಕಾಲದ ಶಬ್ದ<br><br>कुहरित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದ<br><b>विस्तारः - </b>"कुहरितं पिकालापे रटिते रतनिस्वने" - विश्व० ।<br><br>

कुहलि
कुहलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿವಾಹ ಮೊದಲಾದ ಶುಭಮಹೋತ್ಸವಗಳಲ್ಲಿ ಪುಡಿಯಡಕೆಯೊದನೆ ಕೊಡುವ ತಾಂಬೂಲ<br><b>विस्तारः - </b>"सैव वन्दनमाला स्यात् कुहलिः पूगपुष्पिका"- वैज० ।<br><br>

कुहिढ
कुहिढ<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಮದ ರಾಶಿ /ಮಂಜಿನ ಸಮೂಹ<br><b>विस्तारः - </b>"अथ हिमानी हिमसंहतिः । कुहिढोऽस्त्री कुहेलिः स्त्री कुहेढिर्धूमिका त्रयी"- वैज० ।<br><br>

कुहू
कुहू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರನ ಕಲೆಯು ಕಾಣಿಸದಿರುವ ಅಮಾವಾಸ್ಯೆ<br><b>निष्पत्तिः - </b>कुह (विस्मापने) + णिच् - "कूः" बाहु० ।<br><b>प्रयोगाः - </b>"कुहूषु दृश्येतरतां किमेत्य सायुज्यमाप्नोति भवन्मुखस्य"<br><b>उल्लेखाः - </b>नैष० ८-३७<br><br>कुहू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಮಾವಾಸ್ಯೆಯ ಅಧಿಷ್ಠಾನ ದೇವತೆ<br><br>कुहू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ಲಕ್ಷದ್ವೀಪದ ೭ ನದಿಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"अनुमतिः सिनीवाली सरस्वती कुहूः रजनी नन्दा राकेति"<br><b>उल्लेखाः - </b>भाग० ५-२०-१०<br><br>कुहू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆಯ ಕೂಗು /ಪಿಕಸ್ವರ<br><b>विस्तारः - </b>"कुहूः स्यात् कोकिलालापनष्टेन्दुकलयोरपि" - विश्व० ।<br><br>

कुहूकण्ठ
कुहूकण्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><b>व्युत्पत्तिः - </b>कुहूरिति शब्दः कण्ठेऽस्य<br><br>

कुहूकण्ठी
कुहूकण्ठी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><br>

कुहूरव
कुहूरव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><b>व्युत्पत्तिः - </b>कुहूरिति रवोऽस्य<br><br>कुहूरव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಹೂ ಎಂದು ಶಬ್ದ<br><b>प्रयोगाः - </b>"कुतूहलेनेव मुहुः कुहूरवं विडम्ब्य डिम्बेन पिकः प्रकोपितः"<br><b>उल्लेखाः - </b>नैष० ९-३८<br><br>

कुहूरुत्
कुहूरुत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><b>व्युत्पत्तिः - </b>कुहूरिति रुत् शब्दो यस्य<br><br>कुहूरुत्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಹೂ ಎಂದು ಶಬ್ದ /ಕೋಗಿಲೆಯ ಕೂಗು<br><b>प्रयोगाः - </b>"पिकेन रोषारुणचक्षुषा मुहुः कुहूरुताहूयत चन्द्रवैरिणी"<br><b>उल्लेखाः - </b>नैष० १-१००<br><br>

कुहूल
कुहूल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೂಟಗಳಿಂದ ತುಂಬಿದ ಹಳ್ಳ<br><br>

कुहेडि|कुहेलि
कुहेडि(लि)<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಮದ ರಾಶಿ /ಮಂಜಿನ ಸಮೂಹ /ಆಕಾಶದಲ್ಲಿ ಮಳೆಹನಿಗಿಂತಲೂ ಹನಿಯಾಗಿ ಬೀಳುವ ಮಂಜು/ಇಬ್ಬನಿ<br><b>विस्तारः - </b>"कुहिढोऽस्त्री कुहेलिः स्त्री कुहेडिर्धूमिका त्रयी" - वैज० ।<br><br>

कुह्वान
कुह्वान<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಶಬ್ದ<br><b>व्युत्पत्तिः - </b>कुत्सितं ह्वानम्<br><br>

कु|शब्दे|कुनाति
कु - शब्दे (क्र्या० उभ० अक० से०) कुनाति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸದ್ದುಮಾಡು /ಶಬ್ದ ಮಾಡು<br><br>

कू
कू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭೂಮಿ /ನೆಲ<br><b>विस्तारः - </b>"भूर्भूतधात्री गिरिकर्णिकाब्धिद्वीपा समुद्राम्बरमेखला कूः" - त्रिकाण्ड० ।<br><br>कू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದ /ಧ್ವನಿ /ಸದ್ದು<br><b>निष्पत्तिः - </b>कूङ् (शब्दे) - "क्विप्" (३-३-१०८)<br><br>कू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಪಿಶಾಚಿ<br><br>

कूकुद
कूकुद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸತ್ಕಾರಪೂರ್ವಕ ಸಾಲಂಕೃತ ಕನ್ಯೆಯನ್ನು ದಾನಮಾಡುವವನು /ಆಭರಣಗಳಿಂದ ಅಲಂಕರಿಸಿದ ಕನ್ಯೆಯನ್ನು ಕೊಟ್ಟು ಮದುವೆ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>डुदाञ् (दाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कूः शब्दः, कुवः शब्दस्य कुः भूः - कूकुं ददाति<br><b>विस्तारः - </b>"सत्कृत्यलङ्कृतां कन्यां यो ददाति स कूकुदः"- अम० ।<br><br>

कूङ्|शब्दे|कुवते
कूङ् - शब्दे (तुदा० आत्म० अक० से०) कुवते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸದ್ದು<br><br>

कूच
कूच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತನ /ಮೊಲೆ<br><b>निष्पत्तिः - </b>कु (शब्दे) - "चद्" दीर्घश्च (उ० ४-९१)<br><b>विस्तारः - </b>"कूचकुचौ स्तनौ मती" - अम० ।<br><br>

कूची
कूची<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರವನ್ನು ಬರೆಯುವ ಕೂರ್ಚ /ಕುಂಚ<br><b>विस्तारः - </b>"कूची चित्रलेखनिका" - सि० कौ० ।<br><br>

कूचिका
कूचिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಕುಂಚ<br><b>निष्पत्तिः - </b>अल्पे "कः"(५-३-८५)<br><br>कूचिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೀಗದ ಕೈ<br><b>विस्तारः - </b>"अथ तूलिका । कूचिका । कुञ्चिकायां तु कूचिका" - अभि० चि० ।<br><br>

कूचवार
कूचवार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದೇಶ<br><br>

कूज|अव्यक्ते|कूजति
कूज - अव्यक्ते शब्दे (भ्वा० पर० अक० से०) कूजति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅವ್ಯಕ್ತವಾಗಿ ಕೂಗು /ಅಸ್ಪಷ್ಟವಾಗಿ ಕೂಗು<br><b>प्रयोगाः - </b>"चूताङ्कुरास्वादकषायकण्ठः पुंस्कोकिलो यन्मधुरं चुकूज"<br><b>उल्लेखाः - </b>कुमा० ३-३२<br><br>

कूज
कूज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅವ್ಯಕ್ತ ವಚನ /ಅಸ್ಫುಟವಾದ ಮಾತು<br><b>प्रयोगाः - </b>"कण्ठास्यपूर्णत्वमतीव तोदः कूजश्च वायोरुतवाऽप्रवृत्तिः"<br><b>उल्लेखाः - </b>सुश्रुत० उत्तर० ५५-१३<br><br>

कूजत्
कूजत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವ್ಯಕ್ತವಾಗಿ ಶಬ್ದ ಮಾಡುತ್ತಿರುವ /ಅಸ್ಪಷ್ಟವಾಗಿ ಕೂಗುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कूज (अव्यक्ते शब्दे) - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"ततः स कूजस्त्कलहंसमेखलां सपाकसस्याहितपाण्डुतागुणाम्"<br><b>उल्लेखाः - </b>किरा० ४-१<br><br>कूजत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧ್ವನಿ ಮಾಡುತ್ತಿರುವ /ಶಬ್ದ ಮಾಡುತ್ತಿರುವ<br><b>प्रयोगाः - </b>"नृत्ते चक्षुः शून्यहस्तप्रयोगं काये कूजन् कम्बुरुच्चैर्जहास"<br><b>उल्लेखाः - </b>माघ० १८-५४<br><br>

कूजन्ती
कूजन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कूजत् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कूजन
कूजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಕ್ಕಿಯ ಕೂಗು /ಪಕ್ಷಿಯ ಶಬ್ದ<br><b>निष्पत्तिः - </b>कूज (अव्यक्ते शब्दे) - भावे "ल्युट्" (३-३-११५)<br><br>कूजन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಟ್ಟೆಯೊಳಗೆ ಆಗುವ ಮೊಟಮೊಟ ಶಬ್ದ<br><br>

कूजा
कूजा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಧುರವಾದ ಅವ್ಯಕ್ತ ಶಬ್ದ /ಅಸ್ಪಷ್ಟ ಶಬ್ದ<br><b>निष्पत्तिः - </b>कूज (अव्यक्ते शब्दे) - "अः" (३-३-१-३)<br><b>प्रयोगाः - </b>"कुजायुजा बहुलपक्षशितिम्नि सीम्ना स्पष्टं कुहूपदपदार्थमिथोऽन्वयेन"<br><b>उल्लेखाः - </b>नैष० २१-१२३<br><br>

कूजित
कूजित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಕ್ಕಿಗಳ ಶಬ್ದ<br><b>निष्पत्तिः - </b>कूज (अव्यक्ते शब्दे) - भावे "क्तः" (३-३-११४)<br><b>प्रयोगाः - </b>"मधुकरनिकरकरम्बितकोकिलकूजितकुञ्जकुटीरे" । "तनुरुहाणि पुरो विजितध्वनेर्धवलपक्षविहङ्गमकूजितैः" ।<br><b>उल्लेखाः - </b>गीतगो०, माघ० ६-४५<br><br>कूजित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಸ್ಪಷ್ಟವಾದ ಶಬ್ದ /ಅವ್ಯಕ್ತಮಧುರ ಶಬ್ದ<br><br>कूजित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವ್ಯಕ್ತ ಧ್ವನಿ ಮಾಡಿದ /ಅಸ್ಪಷ್ಟವಾಗಿ ಶಬ್ದ ಮಾಡಿದ<br><b>निष्पत्तिः - </b>कूज (अव्यक्ते शब्दे) - कर्त० "क्तः" (३-४-७२)<br><br>कूजित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸ್ಪಷ್ಟವಾಗಿ ಶಬ್ದ ಮಾಡಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कूज (अव्यक्ते शब्दे) + णिच् - "क्तः" (३-२-१०२)<br><br>

कूट|आप्रदाने|कूटयते
कूट - आप्रदाने (चुरा० आत्म० सक० से०) कूटयते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ದಾನ ಮಾಡದಿರು /ಕೊಡದಿರು /ಕೊಡುವುದನ್ನು ನಿಲ್ಲಿಸು<br><br>

कूट|परितापे|कूटयति
कूट - परितापे परिदाहे आमन्त्रणे च (चुरा० उभ० अक० से०) कूटयति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ನೋಯಿಸು<br><br>कूट - परितापे परिदाहे आमन्त्रणे च (चुरा० उभ० अक० से०) कूटयति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ದಹಿಸು /ಸುಡು<br><br>कूट - परितापे परिदाहे आमन्त्रणे च (चुरा० उभ० अक० से०) कूटयति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕರೆ /ಆಹ್ವಾನ ಕೊಡು<br><br>

कूट
कूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗಸ್ತ್ಯ ಮಹರ್ಷಿ<br><br>कूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಲುಕುಟ್ಟಿಗ /ಕಲ್ಲುಗಳನ್ನು ಒಡೆದು ಜೀವಿಸುವವನು<br><b>निष्पत्तिः - </b>कूट (परितापे) - "कः" (३-१-१३५)<br><b>विस्तारः - </b>"आभीराणां जीवधनं कूटानामश्मतक्षणम्" - वैज० ।<br><br>कूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರ್ವತದ ಶಿಖರ /ಬೆಟ್ಟದ ತುದಿ<br><br>कूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡದಿರುವ ವಸ್ತುಗಳ ಪುಂಜ /ರಾಶಿ /ಗುಂಪು<br><br>कूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಯೆ /ಇಂದ್ರಜಾಲ /ಯಕ್ಷಿಣಿ<br><br>कूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><br>कूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣದ ಬಾಣ<br><br>कूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣದ ಸುತ್ತಿಗೆ /ಚಮಟಿಗೆ ಅಥವಾ ಗದೆ<br><br>कूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯಂತ್ರ<br><b>प्रयोगाः - </b>"वागुराभिश्च पाशैश्च कूटैश्च विविधैस्तथा"<br><b>उल्लेखाः - </b>रामा०<br><br>कूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಂಕೆ ಮೊದಲಾದ ಮೃಗಗಳನ್ನು ಹಿಡಿಯುವ ಬೋನು<br><br>कूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನೃತ /ಸುಳ್ಳು<br><br>कूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೇಗಿಲಿನ ಒಂದು ಭಾಗ<br><br>कूट<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಂಭ /ವೇಷ /ಕಪಟ<br><br>कूट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಊರಿನ ಬಾಗಿಲಲ್ಲಿ ಹಾಕಿರುವ ಆನೆಯ ಉಗುರಿನಂತೆ ಇಳಿಜಾರಾದ ಮಣ್ಣಿನ ದಿಣ್ಣೆ<br><br>कूट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಟ /ಮೋಸ<br><b>प्रयोगाः - </b>"नैव धर्मेण तद्राज्यं नार्जवेन न चौजसा । अक्षकूटमधिष्ठाय हृतं दुर्योधनेन वै ॥"<br><b>उल्लेखाः - </b>भा० वन० ३३-३<br><br>कूट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಕೃಷ್ಟವಾದ ವ್ಯವಹಾರ<br><br>कूट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತುದಿ /ಅಗ್ರಭಾಗ<br><b>प्रयोगाः - </b>"किरीटकूटैर्ज्वलितं शृङ्गारं दीप्तकुण्डलम्"<br><b>उल्लेखाः - </b>रामा०<br><br>कूट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹ /ಮನೆ<br><br>कूट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಂಬು ಮುರಿದಿರುವ ಎತ್ತು<br><b>विस्तारः - </b>"भग्नशृङ्गपशुः कूटः" - वैज० ।<br><br>कूट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಲವಾದ /ಅಲುಗಾಡದಿರುವ<br><b>विस्तारः - </b>"कूटोऽस्त्री निश्चले राज्ञौ लोहमुद्गरदम्भयोः । मायाद्रिशृङ्गयोस्तुच्छे सीरावयवयन्त्रयोः । अनृते च" - मेदि० ।<br><br>कूट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಿಥ್ಯೆಯಾದ /ಸುಳ್ಳಾದ<br><b>प्रयोगाः - </b>"उक्तोऽपि साक्षिभिः साक्ष्ये यद्यन्ये गुणवत्तमाः । द्विगुणा वान्यथा ब्रूयुः कूटाः स्युः पूर्वसाक्षिणः ॥"<br><b>उल्लेखाः - </b>याज्ञ० २-८०<br><b>विस्तारः - </b>"कूटोऽस्त्री पुञ्जमायाघेष्वद्रिशृङ्गेषुभेदयोः । अयोघनेऽनृते फाले दम्भे निश्चलयन्त्रके" - वैज० । ಆದರೆ ವಿಶ್ವಪ್ರಕಾಶದಲ್ಲಿ ಎಲ್ಲಾ ಅರ್ಥಗಳಲ್ಲಿಯೂ ನಪುಂಸಕವಾಗಿ ಹೇಳಿರುತ್ತದೆ. "कूटं यन्त्रेऽनृते राशौ निश्चले लोहमुद्गरे । मायाद्रिशृङ्गयोस्तुच्छे सीरावयवदम्भयोः । पुरद्वारे च शंसन्ति" - विश्व० । "कूटं पूर्द्वारि यद्धस्तिनखस्तस्मिन्" - अम० ।<br><br>

कूटक
कूटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಾರತವರ್ಷದ ಒಂದು ಪರ್ವತ<br><b>प्रयोगाः - </b>"भारतेऽप्यस्मिन् वर्षे सरिच्छैलाः सन्ति बहवो मलयो मङ्गलप्रस्थो मैनाकस्त्रिकूटऋषयः कूटकः कोल्लकः सह्यो देवगिरिः ऋष्यमूकः" ।<br><br>कूटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಶಪಾಶ /ತುರುಬು<br><b>विस्तारः - </b>"कबरः केशगर्भकः । कबरी कूटकश्च" - त्रिकाण्ड० ।<br><br>कूटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೇಗಿಲ ಈಚುಮರ /ಗುಳವಿಲ್ಲದ ನೇಗಿಲಿನ ಉದ್ದದ ಮರ<br><br>कूटक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೆರೆಯೆಂಬ ಒಂದು ಸುಗಂಧವಸ್ತು<br><br>

कूटकर्मन्
कूटकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಸದ ಕಾರ್ಯ /ವಂಚನೆ /ಪ್ರತಾರಣ<br><br>कूटकर्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಂಚಕ /ಮೋಸಗಾರ<br><br>

कूटकारक
कूटकारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಿಥ್ಯಾವಾದಿ /ಸುಳ್ಳು ಸಾಕ್ಷ್ಯ ಹೇಳುವವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कूटं करोति<br><b>प्रयोगाः - </b>"समुद्रयायी बन्दी च तैलिकः कूटकारकः"<br><b>उल्लेखाः - </b>मनु० ३-१५८<br><br>कूटकारक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಂಚಕ /ಮೋಸಗಾರ /ಕಪಟಿ<br><br>

कूटकृत्
कूटकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಂಚಕ /ಮೋಸಗಾರ /ಕಪಟಿ<br><br>कूटकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಿವ /ಪರಮೇಶ್ವರ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>कूटं करोति<br><b>प्रयोगाः - </b>"तुलाशासनमानानां कूटकृन्नाणकस्य च"<br><b>उल्लेखाः - </b>याज्ञ० २-२४०<br><br>कूटकृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಯಸ್ಥ /ಗುಮಾಸ್ತ /ಲೆಕ್ಕ ಬರೆಯುವವನು<br><b>विस्तारः - </b>"पिङ्गाक्षः कठमर्दरैवतजटाटङ्काव्ययाः कूटकृत्" - त्रिकाण्ड० ।<br><br>

कूटतापस
कूटतापस<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಟ ಸಂನ್ಯಾಸಿ<br><b>विस्तारः - </b>"कायस्थे कूटकृत्पञ्जीकरौ" - त्रिकाण्ड० ।<br><br>

कूटपाकल
कूटपाकल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಿತ್ತ ಜ್ವರ<br><br>कूटपाकल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಯ ಜ್ವರ<br><b>प्रयोगाः - </b>"यथाभिहन्यात्कूटेन मृगयूथं वनेचरः । तथा पातात्मको नागं हन्ति वै कूटपालकः ॥" "अचिरेण वैकृतविवर्तदारुणः कलभं कठोर इव कूटपालकः" ।<br><b>उल्लेखाः - </b>२) मालती० १-४२<br><br>

कूटपालक
कूटपालक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಲಾಲ /ಕುಂಬಾರ /ಮಣ್ಣಿನ ರಾಶಿಯನ್ನಿಟ್ಟುಕೊಂಡು ಕೆಲಸ ಮಾಡುವವನು<br><br>कूटपालक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಬಾರನ ಆವಿಗೆ ಮನೆ /ಮಡಕೆ ಮೊದಲಾದುವನ್ನು ಬೇಯಿಸುವ ಆವಿಗೆ ಮನೆ<br><b>निष्पत्तिः - </b>पाल (रक्षणे) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>कूटं पालयति<br><br>

कूटपूर्व
कूटपूर्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆಗಳಿಗೆ ಬರುವ ತ್ರಿದೋಷ ಜ್ವರ<br><b>विस्तारः - </b>"पित्तज्वरः पाकलोऽस्य कूटपूर्वस्त्रिदोषजः" - त्रिकाण्ड० ।<br><br>

कूटयन्त्र
कूटयन्त्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಕ್ಷಿ ಮತ್ತು ಮೃಗಗಳನ್ನು ಹಿಡಿಯುವ ಬೋನು /ಬಲೆ<br><b>व्युत्पत्तिः - </b>कूटरूपं यन्त्रम्<br><b>विस्तारः - </b>"उन्माथः कूटयन्त्रं स्यात्" - अम० ।<br><br>

कूटयुद्ध
कूटयुद्ध<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಟ ಯುದ್ಧ /ಮೋಸದಿಂದ ಮಾಡುವ ಕದನ<br><b>प्रयोगाः - </b>"कूटयुद्धविधिज्ञोऽपि तस्मिन् सन्मार्गयोधिनि"<br><b>उल्लेखाः - </b>रघु० १७-६९<br><br>

कूटलेख
कूटलेख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತ್ರಿಮವಾದ ಪತ್ರ /ಮೋಸದ ದಸ್ತೈವೇಜು /ಸುಳ್ಳುಕಾಗದ<br><br>

कूटलेख्य
कूटलेख्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತ್ರಿಮವಾದ ಪತ್ರ /ಮೋಸದ ದಸ್ತೈವೇಜು /ಸುಳ್ಳುಕಾಗದ<br><br>

कूटव्यवहार
कूटव्यवहार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಸದ ವ್ಯವಹಾರ /ಮೋಸದ ನಡವಳಿಕೆ<br><br>

कूटव्यवहारिन्
कूटव्यवहारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಟದಿಂದ ವರ್ತಿಸುವವನು /ಮೋಸದಿಂದ ನಡೆದುಕೊಳ್ಳುವವನು<br><b>निष्पत्तिः - </b>वि + अव + हृञ् (हरणे) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>कूटेन व्यवहरति<br><br>

कूटशस्
कूटशस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ರಾಶಿರಾಶಿಯಾಗಿ /ಗುಂಪುಗುಂಪಾಗಿ<br><b>निष्पत्तिः - </b>कूट् - "शस्" (५-४-४३)<br><br>

कूटशासन
कूटशासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತ್ರಿಮವಾದ ಆಜ್ಞೆ /ಮೋಸದ ಆಜ್ಞೆ<br><br>

कूटसङ्क्रान्ति
कूटसङ्क्रान्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ನಾನ ತರ್ಪಣಾದಿಗಳಿಗೆ ಅವಕಾಶವಿಲ್ಲದ ಅರ್ಧರಾತ್ರಿಯ ನಂತರ ಸಂಭವಿಸುವ ಸಂಕ್ರಮಣ<br><b>विस्तारः - </b>"अर्धरात्रे व्यतीते तु यदा सङ्क्रमते रविः । सा ज्ञेया कूटसङ्क्रान्तिर्मुनिभिः परिकीर्तिता ॥"<br><br>

कूटसाक्षिन्
कूटसाक्षिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಳ್ಳು ಹೇಳುವವನು /ಸುಳ್ಳುಸಾಕ್ಷ್ಯ ಹೇಳುವವನು<br><b>व्युत्पत्तिः - </b>कूटः साक्षी<br><b>प्रयोगाः - </b>"न ददाति हि यः साक्ष्यं जानन्नपि नराधमः । स कूटसाक्षिणां पापैस्तुल्यो दण्डेन चैव हि ॥"<br><b>उल्लेखाः - </b>याज्ञ० २-७७<br><br>

कूटस्थ
कूटस्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಚಿತ್ಸಂಬಂಧವಿಲ್ಲದೆ ಸ್ವಸ್ವರೂಪದಿಂದಿರುವ ಮುಕ್ತಾತ್ಮ<br><b>निष्पत्तिः - </b>ष्ठा (गतिनिवृत्तौ) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कूटवत् निर्विकारेण निश्चलः सन् साधारणाकारेण तिष्ठति<br><b>प्रयोगाः - </b>"द्वाविमौ पुरुषौ लोके क्षरश्चाक्षर एव च । क्षरः सर्वाणि भूतानि कूटस्थोऽक्षर उच्यते ॥" "अक्षरशब्दनिर्दिष्टः कूटस्थः अचित्संसर्गवियुक्तः स्वेन रूपेणावस्थितो मुक्तात्मा" ।<br><b>उल्लेखाः - </b>गीता० १५-१६, रा० भा०<br><br>कूटस्थ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಘ್ರನಖ /ಹುಲಿಯುಗುರು ಗಿಡ<br><br>कूटस्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಗ್ರದಲ್ಲಿರುವ /ತುದಿಯಲ್ಲಿರುವ<br><br>

कूटस्थनित्य
कूटस्थनित्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಾವ ರೀತಿಯ ಪರಿಣಾಮವೂ ಇಲ್ಲದೆ ನಾಶವಿಲ್ಲದೆ ಸ್ವಸ್ವ ರೂಪದಿಂದಿರುವ ಪರಮಾತ್ಮ<br><br>

कूटागार
कूटागार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರಶಾಲೆ /ಉಪ್ಪರಿಗೆ ಮೇಲಿನ ಮನೆ /ಮಹಡಿಯ ಮೇಲಿನ ಕೊಠಡಿ<br><b>विस्तारः - </b>"वेडभी चन्द्रशालिका । कूटागारम्" - त्रिकाण्ड० ।<br><br>कूटागार<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರೀಡಾಗೃಹ /ಆಟದ ಮನೆ<br><br>

कूटार्थभाषा
कूटार्थभाषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂದಿಗ್ಧವಾದ ಅರ್ಥವುಳ್ಳ ಮಾತು /ಅಸ್ಪಷ್ಟಾರ್ಥವುಳ್ಳ ಭಾಷೆ<br><br>कूटार्थभाषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಪಿತ ಕಥೆ /ಪ್ರಬಂಧ<br><br>

कूटार्थभाषित
कूटार्थभाषित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಪಿತ ಕಥೆ /ಪ್ರಬಂಧ<br><br>

कूटार्थभाषिन्
कूटार्थभाषिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಲ್ಪಿತಕಥೆಗಳನ್ನು ಹೇಳುವವನು<br><b>निष्पत्तिः - </b>भाष (व्यक्तायां वाचि) -"णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>कूटार्थं भाषते<br><br>

कूटार्थभाषिणी
कूटार्थभाषिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಪಿತಕಥೆಗಳನ್ನು ಹೇಳುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कूण|सङ्कोचे|कूणयति|कूणयते
कूण - सङ्कोचे (चुरा० उभ० सक० से०) कूणयति-ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಂಕೋಚ ಹೊಂದು /ಚಿಕ್ಕದಾಗು /ಹಿಂದಕ್ಕೆ ಎಳೆದುಕೊ<br><br>

कूणि
कूणि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೋಗಾದಿಗಳಿಂದ ವಕ್ರವಾದ ತೋಳುಗಳುಳ್ಳವನು<br><b>निष्पत्तिः - </b>कूण (सङ्कोचे) - "इन्" (उ० ४-११९)<br><br>

कूणिका
कूणिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವೀಣೆಯ ಬುಡದಲ್ಲಿ ತಂತಿಗಳನ್ನು ಎಳೆದು ಕಟ್ಟುವ ಬಿದಿರಿನ ಗೂಟ<br><b>निष्पत्तिः - </b>कूण (सङ्कोचे) + णिच् - "ण्वुल्" (३-१-१३३)<br><b>विस्तारः - </b>"मूले वंशशलाका स्यात् कूणिका कलिकापि च" - अभि० चि० ।<br><br>कूणिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಂಬು /ವಿಷಾನ /ದನ ಎಮ್ಮೆ ಮೊದಲಾದ ಪ್ರಾಣಿಗಳ ತಲೆಯ ಮೇಲಿನ ಕೋಡು<br><b>विस्तारः - </b>"विषाणं कूणिका शृङ्गम्" - अभि० चि० ।<br><br>

कूणित
कूणित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಕೋಚ ಹೊಂದಿದ /ಹಿಂದಕ್ಕೆ ಎಳೆದುಕೊಂಡ<br><b>निष्पत्तिः - </b>कूण (सङ्कोचे) + णिच् - "क्तः" (३-४-७२)<br><br>कूणित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಕೋಚ ಹೊಂದಿಸಲ್ಪಟ್ಟ /ಚಿಕ್ಕದಾಗುವಂತೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कूण (सङ्कोचे) + णिच् - "क्तः" (३-२-१०२)<br><br>

कूणिताक्ष
कूणिताक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ಯೇನ /ಗಿಡುಗ ಹಕ್ಕಿ<br><b>निष्पत्तिः - </b>"षच्" (५-४-११३)<br><b>व्युत्पत्तिः - </b>कूणिते अक्षिणी यस्य<br><br>

कूणिताक्षण
कूणिताक्षण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ಯೇನ /ಗಿಡುಗ ಹಕ್ಕಿ<br><br>

कूदर
कूदर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಾಹ್ಮಣ ಹೆಂಗಸು ಋತುಮತಿಯಾಗಿರುವಾಗ ಮೊದಲನೆಯ ದಿನ ಋಷಿಯ ಸಂಗಮದಿಂದ ಹುಟ್ಟಿದವನು /ಋತುವಾಗಿದ್ದಾಗ ಮೊದಲನೆಯ ದಿನ ಋಷಿಯೊಡನೆ ಸಂಭೋಗದಿಂದ ಬ್ರಾಹ್ಮಣಸ್ತ್ರೀಯಲ್ಲಿ ಹುಟ್ಟಿದವನು<br><b>व्युत्पत्तिः - </b>कुत्सितमुदरं यस्य<br><b>विस्तारः - </b>"ब्राह्मण्यामृषिवीर्येण ऋतोः प्रथमवासरे । कुत्सिते चोदरे जात कूदरस्तेन कीर्तितः ॥" - ब्रह्मवै०<br><br>

कूप
कूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾವಿ<br><b>निष्पत्तिः - </b>कु (शब्दे) - "पः" दीर्घश्च (उ० ३-२७)<br><b>व्युत्पत्तिः - </b>कुवन्ति मण्डूका अत्र<br><b>प्रयोगाः - </b>"तद्धीरो भव वित्तवत्सु कृपणां वृत्तिं वृथा मा कृथाः कूपे पश्य पयोनिधावपि घटो गृह्णाति तुल्यं जलम्"<br><b>उल्लेखाः - </b>भर्तृ० १-४०<br><br>कूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಳ್ಳ /ಗುಳಿ /ರಂಧ್ರ<br><b>प्रयोगाः - </b>"त्वन्नाभिकूपस्य तटे निवासी न दृश्यते सम्प्रति मध्यभागः"<br><b>उल्लेखाः - </b>च० भा०<br><br>कूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಡಗಿನ ಧ್ವಜಸ್ತಂಭ /ಹಡಗಿನ ಪಟದ ಕಂಬ<br><br>कूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಡಗನ್ನು ಕಟ್ಟುವ ಮರದ ಅಥವಾ ಕಬ್ಬಿಣದ ಕಂಬ<br><br>कूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನದಿಯ ಮಧ್ಯದಲ್ಲಿರುವ ಮರ ಅಥವಾ ಬುಡ<br><b>विस्तारः - </b>"कूपः कूपकगर्ताम्बुमृण्मानगुणवृक्षके" - विश्व० ।<br><br>कूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೊಗಲಿನ ಎಣ್ಣೆಯ ಚೀಲ<br><br>

कूपक
कूपक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಗಸರ ಪಿರ್ರೆಗಳ ಮೇಲಿರುವ ಗುಳಿಗಳು /ಜಘನ ಕೂಪ<br><b>निष्पत्तिः - </b>"कन्" (५-३-९६)<br><b>व्युत्पत्तिः - </b>कूपाविव<br><b>विस्तारः - </b>द्विवचनान्तं रूपम् ।<br><br>कूपक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಡಗನ್ನು ಕಟ್ಟುವ ಕಂಬ<br><br>कूपक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಣ್ಣೆಯ ಪಾತ್ರೆ /ತೊಗಲಿನ ಎಣ್ಣೆಯ ಚೀಲ<br><br>कूपक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನದಿಯ ಮಧ್ಯದಲ್ಲಿರುವ ಮರ ಅಥವಾ ಬಂಡೆ<br><br>कूपक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾವಿ<br><br>कूपक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತೆ<br><b>विस्तारः - </b>"कूपको गुणवृक्षे स्यात् तैलपात्रे कुकुन्दरे । उपदाने चितायां च" - विश्व० ।<br><br>कूपक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ಬತ್ತಿಹೋದ ನದಿಯಲ್ಲಿ ತೋಡಿದ ಹಳ್ಳ /ಚಿಲುಮೆ<br><b>निष्पत्तिः - </b>"कन्" (५-३-८५)<br><b>व्युत्पत्तिः - </b>अल्पः कूपः<br><br>

कूपकच्छप
कूपकच्छप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾವಿಯೊಳಗಿನ ಆಮೆಯಂತೆ ಅಲ್ಪಜ್ಞನಾದವನು /ಬಾವಿಯೊಳಗೆ ಅಲ್ಪಪ್ರದೇಶದಲ್ಲಿರುವ ಆಮೆಯಂತೆ ಕೇವಲ ಅಲ್ಪಕ್ಷೇತ್ರದಲ್ಲಿ ವಾಸಿಸುತ್ತ ಅಷ್ಟೇ ಪ್ರಪಂಚವೆಂದು ತಿಳಿದಿರುವವನು /ಪ್ರಪಂಚದ ಅರಿವಿಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>कूपे कच्छप इव<br><br>

कूपकूर्म
कूपकूर्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾವಿಯೊಳಗಿನ ಆಮೆಯಂತೆ ಅಲ್ಪಜ್ಞನಾದವನು /ಬಾವಿಯೊಳಗೆ ಅಲ್ಪಪ್ರದೇಶದಲ್ಲಿರುವ ಆಮೆಯಂತೆ ಕೇವಲ ಅಲ್ಪಕ್ಷೇತ್ರದಲ್ಲಿ ವಾಸಿಸುತ್ತ ಅಷ್ಟೇ ಪ್ರಪಂಚವೆಂದು ತಿಳಿದಿರುವವನು /ಪ್ರಪಂಚದ ಅರಿವಿಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>कूपे कूर्म इव<br><br>

कूपमण्डूक
कूपमण्डूक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾವಿಯೊಳಗಿನ ಕಪ್ಪೆಯಂತೆ ಅಲ್ಪಜ್ಞನಾದವನು /ಬಾವಿಯೊಳಗೆ ಅಲ್ಪಪ್ರದೇಶದಲ್ಲಿರುವ ಕಪ್ಪೆಯಂತೆ ಕೇವಲ ಅಲ್ಪಕ್ಷೇತ್ರದಲ್ಲಿ ವಾಸಿಸುತ್ತ ಅಷ್ಟೇ ಪ್ರಪಂಚವೆಂದು ತಿಳಿದಿರುವವನು /ಪ್ರಪಂಚದ ಅರಿವಿಲ್ಲದವನು<br><b>व्युत्पत्तिः - </b>कूपे मण्डूक इव<br><br>

कूपचक्र
कूपचक्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾವಿಯ ರಾಟೆ /ಬಾವಿಯಿಂದ ನೀರನ್ನು ಎಳೆಯುವ ಚಕ್ರ<br><br>

कूपाङ्क
कूपाङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೋಮಾಂಚ /ಮೈಕೂದಲೇಳುವುದು<br><b>व्युत्पत्तिः - </b>कूपाकारो अङ्कः चिह्नमस्मिन्<br><br>

कूपिका
कूपिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಳೆಯ ಮಧ್ಯದಲ್ಲಿರುವ ಬಂಡೆ<br><b>विस्तारः - </b>"कूपिकाऽम्भोगतोपलेः" - मेदि० ।<br><br>

कूपी
कूपी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಳ್ಳ /ಗುಳಿ /ರಂಧ್ರ<br><br>कूपी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಭಿಕೂಪ /ಹೊಕ್ಕಳ ಗುಳಿ<br><br>कूपी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಜಿನ ಪಾತ್ರೆ<br><br>कूपी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಣ್ಣೆಯ ಪಾತ್ರೆ /ತೊಗಲಿನ ಎಣ್ಣೆಯ ಚೀಲ<br><br>

कूपोदक
कूपोदक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾವಿಯೊಳಗಿನ ನೀರು<br><b>व्युत्पत्तिः - </b>कूपस्य उदकम्<br><b>प्रयोगाः - </b>"कूपोदकप्रभवकूर्मनयेन जतावस्वामिकप्रभुपरिग्रहबुद्धिमौज्झन्"<br><b>उल्लेखाः - </b>याद० २०-९७<br><br>

कूप्य
कूप्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾವಿಯಲ್ಲಿರುವ<br><b>निष्पत्तिः - </b>"यत्" (५-१-२)<br><b>व्युत्पत्तिः - </b>कूपे भवः<br><br>कूप्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುಳಿಯಲ್ಲಿರುವ /ಹಳ್ಳದಲ್ಲಿರುವ<br><br>

कूबर
कूबर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಡಿಯ ಮೂಕಿ /ನೊಗವನ್ನಿಟ್ಟು ಕಟ್ಟುವ ಗಾಡಿಯ ಒಂದು ಉದ್ದದ ಮರ<br><b>निष्पत्तिः - </b>कूङ् (शब्दे) - "ष्वरच्" बाहु० ।<br><b>व्युत्पत्तिः - </b>कूवते<br><br>कूबर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬ್ಜ /ಬಗ್ಗಿದ ಬೆನ್ನುಗಳುಳ್ಳವನು /ಗೂನು ಬೆನ್ನಿನವನು<br><br>कूबर<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎತ್ತುಗಳು ಎಳೆಯುವ ಗಾಡಿ<br><b>विस्तारः - </b>"गन्त्री स्त्री कूबरं न स्त्रीरथे कम्बलवाह्यके" - वैज० ।<br><br>कूबर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರಮ್ಯವಾದ /ಸುಂದರವಾದ /ಅಂದವಾದ<br><b>विस्तारः - </b>"कूबरः कुब्जके चारौ कूबरश्च युगन्धरः" - विश्व० ।<br><br>

कूबरिन्
कूबरिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಥ /ಗಾಡಿ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कूबरोऽस्यास्ति<br><b>प्रयोगाः - </b>"पादैः पुरः कूबरिणां विदारिताः प्रकाममाक्रान्ततलास्ततो गजाः"<br><b>उल्लेखाः - </b>माघ० १२-२१<br><br>

कूम
कूम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸರೋವರ /ದೊಡ್ಡ ಕೊಳ<br><b>व्युत्पत्तिः - </b>कोः भूमेः उमा कान्तिर्यस्मात्<br><br>

कूर
कूर<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನ<br><b>निष्पत्तिः - </b>वेञ् (तन्तुसन्ताने) - "क्विप्" (३-२-७६) । ला (आदाने) - "कः" (३-२-४) । लस्य रः ।<br><b>व्युत्पत्तिः - </b>ऊः, कौ भूमौ उवं लाति ।<br><b>प्रयोगाः - </b>"इतश्च कूरच्युततैलमिश्रं पिण्डं हस्ती प्रतिग्राह्यते" । "स्थितेऽपि कूरे मुहुरेव याचते" ।<br><b>उल्लेखाः - </b>मृच्छ० ४, नैष० १६-९१<br><b>विस्तारः - </b>"भक्तमन्धः कूरमन्नं भिस्सा दीदिविरोचनः" - अभि० चि० ।<br><br>

कूर्च
कूर्च<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಚ /ಕೊಳೆಯನ್ನು ತೆಗೆಯಲು ಅನುಕೂಲವಾದ ಒರಟು ಕೂದಲಿನ ಗುಚ್ಛ /ಜಂಗು ಮೊದಲಾದುವುಗಳ ಗುಚ್ಛ<br><b>निष्पत्तिः - </b>कुर (शब्दे) - "चट्" दीर्घश्च बाहु० ।<br><b>व्युत्पत्तिः - </b>कुरति<br><br>कूर्च<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹುಬ್ಬುಗಳ ಮಧ್ಯಭಾಗ /ಮೂಗಿನ ಮೇಲುಭಾಗ<br><br>कूर्च<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಶಮುಷ್ಟಿ /ಧರ್ಭೆಯ ಒಂದು ಹಿಡಿ<br><br>कूर्च<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಂಭ /ವೇಷ /ಕಪಟ<br><br>कूर्च<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಮ ಶ್ಲಾಘನೆ<br><br>कूर्च<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಡ್ಡ /ಮೀಸೆ<br><b>प्रयोगाः - </b>"स्वागतमनेकप्रकाराणां जीर्णकूर्चानामनध्यायकारणानां तपोधनानाम्"<br><b>उल्लेखाः - </b>उ० रा० ४<br><br>कूर्च<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನವಿಲು ಗರಿ<br><br>कूर्च<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲಿನ ಹೆಬ್ಬೆರಳಿನ ಮಧ್ಯದ ಮೇಲುಭಾಗ<br><b>विस्तारः - </b>"गुल्फशीर्षस्त्विन्द्रबस्तिः कूर्चस्त्वङ्गुष्ठकान्तरम्" - वैज० ।<br><br>कूर्च<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪೀಠ /ಆಸನ<br><b>विस्तारः - </b>"पीठे श्मश्रुणि कूर्चोऽस्त्री भ्रुमध्ये कत्थने कुशे" - वैज० ।<br><br>कूर्च<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆ<br><br>कूर्च<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಟ /ವಂಚನೆ /ಮೋಸ<br><br>कूर्च<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಠಿನವಾದ /ಗಟ್ಟಿಯಾದ<br><b>विस्तारः - </b>"कूर्चमस्त्री भ्रुवोर्मध्ये कठिनश्मश्रुकैतवे" - मेदि० । "क्षिप्रं त्वङ्गुष्ठाङ्गुलिमध्यतः । कूर्चं क्षिप्रस्योपरि" - अभि० चि० ।<br><br>

कूर्चक
कूर्चक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಚ್ಛ /ಗೊಂಚಲು /ಕಂತೆ<br><b>निष्पत्तिः - </b>कूर्च - स्वार्थे "कः"<br><br>कूर्चक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಳೆಯನ್ನು ತೆಗೆಯಲು ಅನುಕೂಲವಾದ ಒರಟು ಕೂದಲಿನ ಕುಂಚ<br><br>कूर्चक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರಕಾರನ ಕುಂಚ /ವರ್ತಿಕೆ<br><br>कूर्चक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಡ್ದ /ಮೀಸೆ<br><br>

कूर्चल
कूर्चल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗಡ್ಡ ಮೀಸೆಗಳಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>"लच्" (५-२-९६)<br><b>व्युत्पत्तिः - </b>कूर्चमस्यास्ति<br><br>

कूर्चशिरस्
कूर्चशिरस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾದದ ಮೇಲುಭಾಗ /ಕಾಲಿನ ಅಡಿಯ ಮೇಲುಮೈ<br><b>व्युत्पत्तिः - </b>कूर्चस्य शिरः<br><br>

कूर्चशेखर
कूर्चशेखर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೆಂಗಿನ ಮರ<br><b>व्युत्पत्तिः - </b>कूर्चमिव शेखरमस्य<br><br>

कूर्चाल
कूर्चाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಜ್ಞಪಶು<br><b>विस्तारः - </b>"कूर्चालोलस्फटी पशुः" - वैज० ।<br><br>

कूर्चिका
कूर्चिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಯಿಸಿ ಗಟ್ಟಿಮಾಡಿದ ಹಾಲು /ಹಾಲು ಗಿಣ್ಣು<br><b>निष्पत्तिः - </b>कूर्च (विकारे) - सञ्ज्ञायां "ण्वुल्" (३-३-१०९)<br><b>व्युत्पत्तिः - </b>कूर्चति<br><b>विस्तारः - </b>एतत् तक्रकूर्चिका, दधिकूर्चिकेति द्विविधम् । "दध्ना सह यत् पक्वं क्षीरं सा दधिकूर्चिका । तक्रेण पक्वं यत् क्षीरं सा भवेत् तक्रकूर्चिका ॥"<br><br>कूर्चिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೂಜಿ<br><br>कूर्चिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೀಗದ ಕೈ<br><br>कूर्चिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರ ಬರೆಯುವ ತೂಲಿಕೆ /ಕುಂಚ<br><br>कूर्चिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಗ್ಗು<br><b>विस्तारः - </b>"कूर्चिका क्षीरविकृतौ कुञ्चिकायां च कुड्मले । आलेख्यकूर्चिका सूच्योः" - हेम० ।<br><br>

कूर्चिन्
कूर्चिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉದ್ದವಾದ ಗಡ್ಡ ಬೆಳೆಸಿರುವವನು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कूर्चमस्यास्ति<br><br>

कूर्दन
कूर्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾರುವುದು /ನೆಗೆಯುವುದು<br><b>निष्पत्तिः - </b>कुर्द (क्रीडायाम्) - भावे "ल्युट्" (३-३-११५)<br><br>कूर्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಟವಾಡುವುದು<br><b>विस्तारः - </b>"देवनं खूर्दनं खेला ललनं वर्करोऽपि च"- अभि० चि० ।<br><br>

कूर्दनी
कूर्दनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರಾಪೂರ್ಣಿಮಾ /ಚೈತ್ರ ಮಾಸದ ಹುಣ್ಣಿಮೆ /ಮದನಮಹೋತ್ಸವದ ದಿವಸ<br><b>निष्पत्तिः - </b>कुर्द (क्रीडायाम्) - अधि० "ल्युट्" (३-३-११७) । "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>कूर्द्यतेऽत्र<br><br>

कूर्प
कूर्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಬ್ಬುಗಳ ಮಧ್ಯಭಾಗ /ಮೂಗಿನ ಮೇಲುಭಾಗ<br><b>निष्पत्तिः - </b>पा (रक्षणे) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कुरं पाति<br><b>विस्तारः - </b>कूर्चं कूर्पं भ्रुवोर्मध्ये" - अभि० चि० ।<br><br>

कूर्पर
कूर्पर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಳಕೈ<br><b>निष्पत्तिः - </b>कुर (शब्दे) - "क्विप्" (३-२-१७८) । पॄ (पालनपूरणयोः) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>पिपर्ति<br><b>प्रयोगाः - </b>"प्रतिकुञ्चितकूर्परेण तेन श्रवणोपान्तिकनीयमानगव्यम्"<br><b>उल्लेखाः - </b>माघ० २०-१९<br><br>कूर्पर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಡಿ /ತೊಡೆಗೂ ಕೆಳಕಾಲಿಗೂ ಮಧ್ಯದಲ್ಲಿರುವ ಸಂಧಿ<br><b>विस्तारः - </b>"कूर्परः स्यात् कफोणौ च जानुन्यपि च पुंस्ययम्" - मेदि० ।<br><br>

कूर्पास
कूर्पास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಗಾಪು /ಗುತ್ತನಾಗಿರುವ ಹೆಂಗಸರ ಕುಪ್ಪಸ /ತೋಳಿಲ್ಲದ ರವಿಕೆ<br><b>निष्पत्तिः - </b>असु (क्षेपणे) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>कूर्परे अस्यते<br><b>विस्तारः - </b>"कूर्पासस्त्वर्धचोलकः" - हारा० ।<br><br>

कूर्पासक
कूर्पासक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೈಗಾಪು /ಗುತ್ತನಾಗಿರುವ ಹೆಂಗಸರ ಕುಪ್ಪಸ /ತೋಳಿಲ್ಲದ ರವಿಕೆ<br><b>निष्पत्तिः - </b>स्वार्थे "कः"<br><b>प्रयोगाः - </b>"मनोज्ञकूर्पासपीडितस्तनाः" । "कूर्पासकं क्षतनखक्षतमुत्क्षिपन्ती" ।<br><b>उल्लेखाः - </b>ऋतुसं० ५-८, माघ० ५-२३<br><br>

कूर्म
कूर्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಚ್ಛಪ /ಆಮೆ<br><b>निष्पत्तिः - </b>"अच्" (५-४-७५)<br><b>व्युत्पत्तिः - </b>कुत्सितः कौ वा ऊर्मिः वेगोऽस्य<br><b>प्रयोगाः - </b>"यदा संहरते छायं कूर्मोऽङ्गानीव सर्वशः । इन्द्रियाणीन्द्रियार्थेभ्यः तस्य प्रज्ञा प्रतिष्ठिता ॥"<br><b>उल्लेखाः - </b>गीता० २-५८<br><br>कूर्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾವಿಷ್ಣುವಿನ ೧೦ ಅವತಾರಗಳಲ್ಲಿ ಎರಡನೆಯದು<br><b>विस्तारः - </b>"सुरासुराणामुदधिं मथ्नतां मन्दराचलम् । दध्रे कमठरूपेण पृष्ठे एकादशे विभुः ॥" - भाग० १-३-१६<br><br>कूर्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹದೊಳಗೆ ಉನ್ಮೀಲನ ಮಾಡುವ ಒಂದು ವಾಯು<br><b>विस्तारः - </b>"वाग्द्वारे नाग आख्यातः कूर्मौन्मीलने स्मृतः" - अम० ।<br><br>कूर्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೂರ್ಮಮುದ್ರೆ /ದೇವರ ಧ್ಯಾನಕ್ಕಾಗಿ ಕೈಬೆರಳುಗಳ ಜೋಡಣೆಯಿಂದ ಮಾಡುವ ಒಂದು ಮುದ್ರೆ<br><b>विस्तारः - </b>"वामहस्तस्य तर्जन्यां दक्षिणस्य कनिष्ठया । तथा दक्षिणतर्जन्यां वामाङ्गुष्ठेन योजयेत् । उन्नतं दक्षिणाङ्गुष्ठं वामस्य मध्यमादिकाः । अङ्गुलीर्योजयेत् पृष्ठे दक्षिणस्य करस्य च । वामस्य पितृतीर्थेन मध्यमानामिके तथा । अधोमुखे च ते कुर्यात् दक्षिणस्य करस्य च । कूर्मपृष्ठसमं कुर्याद्दक्षपाणिं च सर्वतः । कूर्ममुद्रेयमाख्याता देवताध्यानकर्मणि ॥" - तन्त्रसा० ।<br><br>कूर्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕದ್ರುವಿನ ಮಕ್ಕಳಲ್ಲಿ ಒಂದು ಸರ್ಪ<br><b>प्रयोगाः - </b>"शेषोऽनन्तो वासुकिश्च तक्षकश्च भुजङ्गमः । कूर्मश्च कुलिकश्चैव काद्रवेयाः प्रकीर्तिताः ॥"<br><b>उल्लेखाः - </b>भा० आदि० ६५-४१<br><br>कूर्म<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರನ ೯ ನಿಧಿಗಳಲ್ಲೊಂದು<br><br>

कूर्मकल्प
कूर्मकल्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚತುರ್ಮುಖಬ್ರಹ್ಮನ ಒಂದು ತಿಂಗಳಲ್ಲಿ ಬರುವ ಶ್ವೇತವರಾಹಾದಿ ಪಿತೃಕಲ್ಪದ ವರೆಗಿನ ೩೦ ಕಲ್ಪಗಳಲ್ಲೊಂದು<br><br>

कूर्मचक्र
कूर्मचक्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಂತ್ರಸಾರದಲ್ಲಿ ಹೇಳಿರುವ ಕೂರ್ಮಾಕಾರದ ಒಂದು ಚಕ್ರ<br><br>कूर्मचक्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಕ್ಷತ್ರಭೇದದಿಂದ ದೇಶಭೇದಗಳ ಶುಭಾಶುಭ ಫಲಗಳನ್ನು ಸೂಚಿಸುವ ಒಂದು ಚಕ್ರ<br><br>

कूर्मपुराण
कूर्मपुराण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಸಮಹರ್ಷಿ ಪ್ರಣೀತವಾದ ೧೮ ಪುರಾಣಗಳಲ್ಲೊಂದು<br><b>व्युत्पत्तिः - </b>कूर्मेण प्रोक्तं पुराणम्<br><br>

कूर्मपृष्ठ
कूर्मपृष्ठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೊಡ್ಡ ಗೋರಂಟಿ ಗಿಡ<br><br>कूर्मपृष्ठ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಮೆಯ ಬೆನ್ನು /ಆಮೆಯ ಚಿಪ್ಪು<br><br>कूर्मपृष्ठ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರಾವೆ /ಮಣ್ಣಿನ ತಟ್ಟೆ<br><br>

कूर्मराज
कूर्मराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾವಿಷ್ಣುವಿನ ಕೂರ್ಮಾವತಾರ /ಕೂರ್ಮರೂಪದಿಂದ ಅವತರಿಸಿದ ಮಹಾವಿಷ್ಣು<br><br>कूर्मराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ ಆಮೆ<br><b>निष्पत्तिः - </b>"टच्" (५-४-९१)<br><b>व्युत्पत्तिः - </b>कूर्माणां राजा<br><br>

कूर्मावतार
कूर्मावतार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೂರ್ಮರೂಪದಿಂದ ಪರಮಾತ್ಮನ ಅವತಾರ<br><br>

कूल|आवरणे|कूलति
कूल - आवरणे (भ्वा० पर० सक० से०) कूलति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಆವರಿಸು /ಮುಚ್ಚು /ಮರೆ ಮಾಡು<br><br>

कूल
कूल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆರೆ ನದಿ ಮೊದಲಾದುವುಗಳ ತೀರ<br><b>निष्पत्तिः - </b>कूल (आवरणे) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>कूलति आवृणोति प्रवाहम्<br><b>प्रयोगाः - </b>"विदलितमहाकूलामुक्ष्णां विषाणविघट्टनैः"<br><b>उल्लेखाः - </b>माघ० १२-७७<br><br>कूल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸರಸ್ಸು /ಕೊಳ<br><br>कूल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೈನ್ಯದ ಹಿಂಭಾಗ<br><br>कूल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಟಾಕ /ಕೆರೆ /ಏರಿ<br><br>कूल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತೂಪ /ದಿಣ್ಣೆ /ದಿಬ್ಬ<br><br>कूल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೈನ್ಯದ ಮಧ್ಯಭಾಗ<br><b>विस्तारः - </b>"कूलं तीरे चमूकटौ" - वैज० ।<br><br>कूल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೀಪ /ಹತ್ತಿರದ ಪ್ರದೇಶ<br><b>प्रयोगाः - </b>"तवापि हा हा विरहात्क्षुधाकुलाः कुलायकूलेषु विलिठ्य तेषु ते"<br><b>उल्लेखाः - </b>नैष० १-१४१<br><b>विस्तारः - </b>"कूलं तटे सैन्यपृष्ठे तडागस्तूपयोरपि" - हेम० ।<br><br>

कूलक
कूलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೀರ /ದಡ<br><br>कूलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತೂಪ /ದಿಣ್ಣೆ /ದಿಬ್ಬ<br><b>निष्पत्तिः - </b>कूल - स्वार्थे "कः"<br><br>कूलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಲ್ಮೀಕ /ಹುತ್ತ<br><b>विस्तारः - </b>"कूलकः कृमिशैले च प्रतीरस्तूपयोरपि" - विश्व० । ಮೇದಿನೀಕೋಶದಲ್ಲಿ "कूलकं च स्त्रियाम्" ಎಂದು ಪುಂನಪುಂಸಕಲಿಂಗದಲ್ಲಿ ಹೇಳಿದೆ.<br><br>

कूलङ्कष
कूलङ्कष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ /ಕಡಲು<br><b>विस्तारः - </b>"पुमान् कचङ्गलो वाङ्कः कूलङ्कषपराङ्गवौ" - त्रिकाण्ड० ।<br><br>कूलङ्कष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೀರವನ್ನು ವ್ಯಾಪಿಸಿರುವ /ದಡವನ್ನು ಮುಟ್ಟುವ /ದಡವನ್ನು ಕೊರೆಯುವ<br><b>निष्पत्तिः - </b>कष (हिंसायाम्) - "खच्" (३-२-४२) । मुम् (६-३-६७)<br><b>व्युत्पत्तिः - </b>कूलं कषति<br><b>प्रयोगाः - </b>"कूलङ्कषौधाः सरितस्तथापराः प्रवर्तयामासुरिभा मदाम्बुभिः"<br><b>उल्लेखाः - </b>माघ० १२-६०<br><br>

कूलङ्कषा
कूलङ्कषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಳೆ /ನದಿ<br><br>

कूलचर
कूलचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೀರದಲ್ಲಿ ಸಂಚರಿಸುವ /ದಡದಲ್ಲಿ ತಿರುಗಾಡುವ<br><br>कूलचर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೀರದಲ್ಲಿ ಮೇಯುವ<br><b>निष्पत्तिः - </b>चर (गतिभक्षणयोः) - "टः" (३-२-१६)<br><b>व्युत्पत्तिः - </b>कूले चरति<br><br>

कूलभू
कूलभू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನದಿಯ ತೀರ /ದಡ /ತೀರಭೂಮಿ /ತೀರಪ್ರದೇಶ<br><br>

कूलभूमि
कूलभूमि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನದಿಯ ತೀರ /ದಡ /ತೀರಭೂಮಿ /ತೀರಪ್ರದೇಶ<br><br>

कूलमुद्रुज
कूलमुद्रुज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಡವನ್ನು ಭೇದಿಸುವ /ತೀರವನ್ನು ಕೊರೆಯುವ ನದಿ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>उद् + रुजो (भङ्गे) - "खश्" (३-२-३१) । मुम् (६-३-६७)<br><b>व्युत्पत्तिः - </b>कूलमुद्रुजति<br><b>प्रयोगाः - </b>"मदोदग्राः ककुद्मन्तः सरितां कूलमुद्रुजाः"<br><b>उल्लेखाः - </b>रघु० ४-२२<br><br>

कूलमुद्वह
कूलमुद्वह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೀರದವರೆಗೂ ತುಂಬಿ ಪ್ರವಹಿಸುವ /ದಡದವರೆಗೂ ತುಂಬಿ ಹರಿಯುವ<br><b>निष्पत्तिः - </b>उद् + वह (प्रापणे) - "खश्" (३-२-३१) । मुम् (६-३-६७)<br><b>व्युत्पत्तिः - </b>कूलमुद्वहति<br><b>प्रयोगाः - </b>"उत्तीर्णो वा कथं भीमाः सरितः कूलमुद्वहाः"<br><b>उल्लेखाः - </b>भट्टि० ६-९५<br><br>

कूलवत्
कूलवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಡಗಳಿಂದ ಕೂಡಿರುವ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४) । मस्य वः (८-२-९)<br><b>व्युत्पत्तिः - </b>कूलेऽस्य स्तः<br><br>

कूलवती
कूलवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನದಿ /ಹೊಳೆ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कूलिन्
कूलिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೀರಗಳಿಂದ ಕೂಡಿರುವ /ದಡಗಳಿರುವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-१३६)<br><b>व्युत्पत्तिः - </b>कूलेऽस्य स्तः<br><br>

कूलिनी
कूलिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನದಿ /ಹೊಳೆ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कूवर
कूवर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>कूबर ಪದದ ಅರ್ಥ<br><br>

कूष्माण्ड
कूष्माण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಈಶ್ವರನ ಪ್ರಮಥಗಣಗಳಲ್ಲೊಬ್ಬ<br><br>कूष्माण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಋಷಿ<br><b>प्रयोगाः - </b>"कूष्माण्डो राजपुत्रश्चेत्यन्ते स्वाहासमन्वितैः"<br><b>उल्लेखाः - </b>याज्ञ० १-२८५<br><br>कूष्माण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆ ಋಷಿ ದೃಷ್ಟವಾದ ಮಂತ್ರಗಳು<br><b>प्रयोगाः - </b>"कूष्माण्डैर्वापि जुहुयात् घृतमग्नौ यथाविधि"<br><b>उल्लेखाः - </b>मनु० ८-१०६<br><br>कूष्माण्ड<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಬಳ ಕಾಯಿ<br><b>प्रयोगाः - </b>"पित्तघ्नं तेषु कूष्माण्डं बालं मध्यं कफावहम् । शुक्लं लघूष्णं सक्षारं दीपनं बस्तिशोधनम् ॥"<br><b>उल्लेखाः - </b>सुश्रुत० सूत्र० ४६-२१३<br><br>

कूष्माण्डी
कूष्माण्डी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆ ಋಷಿ ದೃಷ್ಟವಾದ ಮಂತ್ರಗಳು<br><b>निष्पत्तिः - </b>गौरा० "ङीष्" (४-१-४१)<br><b>प्रयोगाः - </b>"त्रिरत्रोपोषितो हुत्वा कुष्माण्डीभिर्घृतं शुचिः"<br><b>उल्लेखाः - </b>याज्ञ० ३-३०३<br><br>कूष्माण्डी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಬಳದ ಗಿಡ<br><b>व्युत्पत्तिः - </b>कु ईषत् ऊष्मा अण्डेषु यस्य<br><br>कूष्माण्डी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ<br><br>कूष्माण्डी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಬಳದ ಗಿಡ<br><b>निष्पत्तिः - </b>गौरा० "ङीष्" (४-१-४१)<br><br>

कूष्माण्डक
कूष्माण्डक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಬಳ ಕಾಯಿ<br><b>निष्पत्तिः - </b>स्वार्थे "कः"<br><br>

कूषा
कूषा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಮದ ರಾಶಿ /ಹಿಮದ ಗೆಡ್ಡೆ<br><b>निष्पत्तिः - </b>ऊह (वितर्के) - अधि० घञर्थे "कः" (वा० ३-३-५८)<br><b>व्युत्पत्तिः - </b>कु ईषत् ऊह्यतेऽत्र<br><br>

कृक
कृक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಂಠಮಧ್ಯ /ಕುತ್ತಿಗೆಯ ಮಧ್ಯಭಾಗ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) "कक्" बाहु० ।<br><b>व्युत्पत्तिः - </b>क्रियतेऽसौ<br><b>विस्तारः - </b>"कृकस्तु कन्धरामध्यम्" - अभि० चि० ।<br><br>

कृकण
कृकण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಕ್ಕಿ /ತಿತ್ತಿರಿಪಕ್ಷಿಯ ಒಂದು ಭೇದ<br><b>निष्पत्तिः - </b>कण (शब्दे) - "अच्" (३-१-१३४) । अण (शब्दे)- "अच्" (३-१-१३४) शक० ।<br><b>व्युत्पत्तिः - </b>कृ इति कणति । कृकेण कण्ठेन अणति ।<br><b>विस्तारः - </b>"कृकणक्रकरौ समौ" - अम० ।<br><br>कृकण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಕೃಮಿ<br><b>विस्तारः - </b>"कृकणः कृमिरुद्दिष्टिः" - हारा० ।<br><br>कृकण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದೇಶ<br><br>

कृकणेय
कृकणेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಕಣ ದೇಶದಿಂದ ಬಂದ<br><br>कृकणेय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಕಣ ದೇಶದಲ್ಲಿ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>कृकण - "छः" (४-२-१४५)<br><br>

कृकर
कृकर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೀಸವನ್ನುಂಟುಮಾಡುವ ದೇಹದೊಳಗಿನ ಒಂದು ವಾಯು<br><b>विस्तारः - </b>"कृकराच्च क्षुतं ज्ञेयं देवदत्ताद्विजृम्भणम्"- अम० ।<br><br>

कृकला
कृकला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಪ್ಪಲಿ<br><b>निष्पत्तिः - </b>ला (आदाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कृकं कृकाकारं लाति<br><br>

कृकलास
कृकलास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಟೆಗೊದ್ದ /ಓತಿಕೇತ<br><b>निष्पत्तिः - </b>लस (शिल्पयोगे) + णिच् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कृकं कण्ठं लासयति<br><b>प्रयोगाः - </b>"श्रमेण महता युक्ताः तस्मिन् तोये सुसंवृते । ददृशुस्ते महाकायं कृकलासमवस्थितम् ॥"<br><b>उल्लेखाः - </b>भा० अनु० ७०-४<br><br>

कृकवाकु
कृकवाकु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಕ್ಕುಟ /ಕೋಳಿ<br><b>निष्पत्तिः - </b>वच (परिभाषणे) - "ञुण्" कक् च (उ० १-६)<br><b>व्युत्पत्तिः - </b>कृकेण वक्ति<br><b>प्रयोगाः - </b>"अनुनयमगृहीत्वा न्यायसुप्ता पराची रुतमथ कृकवाकोस्तारमाकर्ण्य कल्ये"<br><b>उल्लेखाः - </b>माघ० ११-९<br><br>कृकवाकु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಯೂರ /ನವಿಲು<br><br>कृकवाकु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಟೆಗೊದ್ದ /ಓತಿಕೇತ<br><b>विस्तारः - </b>"कृकवाकुस्ताम्रचूडे मयूरकृकलासयोः" - हेम० ।<br><br>

कृकवाकुध्वज
कृकवाकुध्वज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಯೂರವೇ ಧ್ವಜವಾಗಿರುವ ಕಾರ್ತಿಕೇಯ /ಸ್ಕಂದ /ಕುಮಾರ ಸ್ವಾಮಿ<br><b>व्युत्पत्तिः - </b>कृकवाकुर्मयूरो ध्वजचिह्नमस्य<br><b>विस्तारः - </b>"बालचर्यः सिद्धसेनः कृकवाकुध्वजश्च सः"- त्रिकाण्ड० ।<br><br>

कृकाटिका
कृकाटिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕುತ್ತಿಗೆಯ ಹಿಂಭಾಗ /ಹೆಕ್ಕತ್ತು<br><b>निष्पत्तिः - </b>अट (गतौ) - "इन्" (उ० ४-११७) । स्वार्थे "कन्"<br><b>व्युत्पत्तिः - </b>कृकं कण्ठमटति<br><b>प्रयोगाः - </b>"कृकाटिकान्ते छिन्ने तु गच्छत्यपि समीरणे । सम्यङ्निवेश्य बध्नीयात् सीव्येच्चापि निरन्तरम् ॥"<br><b>उल्लेखाः - </b>सुश्रुत० चिकित्सा० २-३२<br><br>

कृच्छ्र
कृच्छ्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಷ್ಟ /ತೊಂದರೆ<br><b>निष्पत्तिः - </b>कृती (छेदने) - "रक्" छकारादेशश्च (उ० २-२१)<br><b>व्युत्पत्तिः - </b>कृन्तति<br><b>प्रयोगाः - </b>"रामेण मैथिकसुतां दशकण्ठकृच्छ्रात् प्रत्यद्धृतां धृतिमतीं भरतो ववन्दे"<br><b>उल्लेखाः - </b>रघु० १३-७७<br><br>कृच्छ्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಜಾಪತ್ಯ ಚಾಂದ್ರಾಯಣ ಮುಂತಾದ ವ್ರತ<br><b>प्रयोगाः - </b>"प्राजापत्यं चरेत् कृच्छ्रं अब्दमेकं समाहितः"<br><b>उल्लेखाः - </b>मनु० ११-१०५<br><br>कृच्छ्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ<br><b>विस्तारः - </b>"कृच्छ्रमंहसि । कष्टे सान्तपने" - हेम० ।<br><br>कृच्छ्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಷ್ಟಸಾಧ್ಯವಾದ /ಕಷ್ಟದಿಂದ ಮಾಡಬಹುದಾದ<br><b>प्रयोगाः - </b>"अतोऽन्यथात्वसाध्यः स्यात् कृच्छ्रोऽयं मिश्रलक्षणः"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>कृच्छ्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೊಂದರೆಯನ್ನುಂಟುಮಾಡುವ /ಪೀಡಿಸುವ<br><b>प्रयोगाः - </b>"सदाहवेदनं कृच्छ्रं कुर्यातां मूत्रसङ्क्षयम्"<br><b>उल्लेखाः - </b>सुश्रुत० उत्तर० ५८-१७<br><br>कृच्छ्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಷ್ಟವನ್ನುಂಟುಮಾಡುವ /ಕಷ್ಟಕ್ಕೆ ಕಾರಣವಾದ<br><b>प्रयोगाः - </b>"कृच्छ्रं गतस्यापि दशाविपाकं धर्मान्न चेतः स्खलतु त्वदीयम्"<br><b>उल्लेखाः - </b>नैष० १४-८१<br><br>कृच्छ्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀಚ /ಪಾಪಿ<br><br>कृच्छ्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಷ್ಟವನ್ನು ಅನುಭವಿಸುತ್ತಿರುವ /ಕಷ್ಟಕ್ಕೆ ಒಳಗಾಗಿರುವ<br><br>

कृच्छ्रसान्तपन
कृच्छ्रसान्तपन<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಾಯಶ್ಚಿತ್ತಕ್ಕಾಗಿ ಆಚರಿಸಬೇಕಾದ ಒಂದು ವ್ರತ<br><b>प्रयोगाः - </b>"गोमूत्रं गोमयं क्षीरं दधि सर्पिः कुशोदकम् । एकरात्रोपवासश्च कृच्छ्रं सान्तपनं स्मृतम् ॥"<br><b>उल्लेखाः - </b>मनु० ११-२१२<br><br>

कूच्छ्रिन्
कूच्छ्रिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಷ್ಟದಿಂದ ಕೂಡಿರುವ /ಕಷ್ಟವನ್ನು ಅನುಭವಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-१३१)<br><b>व्युत्पत्तिः - </b>कूच्छ्रमस्यास्ति<br><br>

डुकृञ्|करणे|करोति|कुरुते
डुकृञ् - करणे (तना० उभ० सक० से०) करोति-कुरुते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>(ಈ ಧಾತುವು ಸಂದರ್ಭಾನುಸಾರ ಈ ಕೆಳಗಿನ ಅರ್ಥಗಳಲ್ಲಿ ಪ್ರಯೋಗಿಸಲ್ಪಡುವುದು) ಮಾಡು<br><b>प्रयोगाः - </b>"चक्रुरेव ललनोरुषु राजीः स्पर्शलोभवशलोलकराणाम्" । "तीर्थगामि करवै विधानतस्तज्जुषस्व जुहवानि चानले" ।<br><b>उल्लेखाः - </b>माघ० १०-६६, माघ० १४-९<br><br>डुकृञ् - करणे (तना० उभ० सक० से०) करोति-कुरुते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ತಯಾರಿಸು<br><b>प्रयोगाः - </b>"घटं करोति"<br><br>डुकृञ् - करणे (तना० उभ० सक० से०) करोति-कुरुते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ನೇಮಿಸು<br><b>प्रयोगाः - </b>"तं सेवकमकरोत्"<br><br>डुकृञ् - करणे (तना० उभ० सक० से०) करोति-कुरुते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಉಂಟುಮಾಡು<br><b>प्रयोगाः - </b>"अकृतार्थेऽपि मनसिजे रतिमुभयप्रार्थना कुरुते" । "कुर्यां हरस्यापि पिनाकपाणेः धैर्यच्युतिं के मम धन्विनोऽन्ये" ।<br><b>उल्लेखाः - </b>शाकु० २-१, कुमा० ३-१०<br><br>डुकृञ् - करणे (तना० उभ० सक० से०) करोति-कुरुते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ರಚಿಸು<br><b>प्रयोगाः - </b>"अञ्जलिं प्राङ्मुखः कुर्वन् पवनायात्मयोनये"<br><b>उल्लेखाः - </b>रामा०<br><br>डुकृञ् - करणे (तना० उभ० सक० से०) करोति-कुरुते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಂಕಲಿಸು /ಜೋಡಿಸು<br><b>प्रयोगाः - </b>"रसगङ्गाधरनाम्नीं करोति कुतुकेन काव्यमीमांसाम्"<br><b>उल्लेखाः - </b>रसगं०<br><br>डुकृञ् - करणे (तना० उभ० सक० से०) करोति-कुरुते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ನೆರವೇರಿಸು<br><b>प्रयोगाः - </b>"अर्हणामर्हते चक्रुर्मुनयो नयचक्षुषे"<br><b>उल्लेखाः - </b>रघु० १-५५<br><br>डुकृञ् - करणे (तना० उभ० सक० से०) करोति-कुरुते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೇಳು /ವಿವರಿಸು<br><b>प्रयोगाः - </b>"तास्ताः कथाः कुर्वन्"<br><br>डुकृञ् - करणे (तना० उभ० सक० से०) करोति-कुरुते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ನಡೆಸು /ಆಜ್ಞೆಪಾಲಿಸು<br><b>प्रयोगाः - </b>"शासनं मे कुरुष्व"<br><br>डुकृञ् - करणे (तना० उभ० सक० से०) करोति-कुरुते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಾಧಿಸು<br><b>प्रयोगाः - </b>"सत्सङ्गतिः कथय किं न करोति पुंसाम्"<br><br>डुकृञ् - करणे (तना० उभ० सक० से०) करोति-कुरुते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಉಚ್ಚರಿಸು /ಹೇಳು<br><b>प्रयोगाः - </b>"मानुषीं गिरं कृत्वा"<br><br>डुकृञ् - करणे (तना० उभ० सक० से०) करोति-कुरुते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಇಡು /ಇರಿಸು<br><b>प्रयोगाः - </b>"कुरु करे गुरुमेकमयोघनम्"<br><b>उल्लेखाः - </b>नैष० ४-५९<br><br>डुकृञ् - करणे (तना० उभ० सक० से०) करोति-कुरुते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ತೆಗೆದುಕೊ /ಹಿಡಿದುಕೊ<br><b>प्रयोगाः - </b>"बहिरतो मुकुरं च कुरुष्व मे"<br><b>उल्लेखाः - </b>नैष० ४-५९<br><br>डुकृञ् - करणे (तना० उभ० सक० से०) करोति-कुरुते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯಿಸು<br><b>प्रयोगाः - </b>"मनसि कृत्वा"<br><br>डुकृञ् - करणे (तना० उभ० सक० से०) करोति-कुरुते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಒಪ್ಪಿಕೊ /ಸಂಮತಿಸು<br><b>प्रयोगाः - </b>"उरसि कृत्वा"<br><br>

अधि + कृञ्|अधिकृञ्|अधिकरोति
अधि + कृञ् = अधिकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಧಿಕಾರ /ಯೋಗ್ಯತೆ<br><b>प्रयोगाः - </b>"हृताधिकारां मलिनां पिण्डमात्रोपजीविनाम्"<br><b>उल्लेखाः - </b>याज्ञ० १-७०<br><br>अधि + कृञ् = अधिकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪ್ರಭುತ್ವ /ಆಡಳಿತ<br><b>प्रयोगाः - </b>"क्षणादायुष्मान् स्वाधिकारभूमौ वर्तिष्यते"<br><b>उल्लेखाः - </b>शाकु० ७<br><br>अधि + कृञ् = अधिकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಗಣನೆ /ಎಣಿಕೆ<br><b>प्रयोगाः - </b>"संसत्सु जाते पुरुषाधिकारे न पूरणीं तं समुपैति सङ्ख्या"<br><b>उल्लेखाः - </b>किरा० ३-५१<br><br>अधि + कृञ् = अधिकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಯಾಜಮಾನ್ಯ<br><b>प्रयोगाः - </b>"अधिकारविलम्बितापवर्गस्थिरसङ्गात्"<br><b>उल्लेखाः - </b>याद० १५-७<br><br>

अनु + कृञ्|अनुकृञ्|अनुकरोति
अनु + कृञ् =अनुकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಾಮ್ಯ /ಹೋಲಿಕೆ<br><b>प्रयोगाः - </b>"आमोदमुपजिघ्रन्तौ स्वनिःश्वासानुकारिणम्"<br><b>उल्लेखाः - </b>रघु० १-४३<br><br>अनु + कृञ् =अनुकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅನುಕರಿಸು /ಅಣಕಿಸು /ಒಬ್ಬ ಮಾಡಿದಂತೆ ಮಾಡು<br><br>

अप + कृञ्|अपकृञ्|अपकरोति
अप + कृञ् =अपकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಪಕಾರ ಮಾಡು /ಕೆಡಕು ಮಾಡು<br><b>प्रयोगाः - </b>"अपकृतं वसुदेवममोचयद्दयितया सह दीनविलापया" । "त्वमिव कोऽपि परापकृतौ कृती न ददृशे न च मन्मथ शुश्रुवे" ।<br><b>उल्लेखाः - </b>याद० ३-५५, नैष० ४-९८<br><br>

अप + आ + कृञ्|अपाकृञ्|अपाकरोति
अप + आ + कृञ् = अपाकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅವಮಾನ<br><b>प्रयोगाः - </b>"निशम्य सिद्धिं द्विषतामपाकृतीः"<br><b>उल्लेखाः - </b>किरा० १-२७<br><br>अप + आ + कृञ् = अपाकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹಿಂದಕ್ಕೆ ಎಳೆದುಕೊಳ್ಳುವುದು<br><b>प्रयोगाः - </b>"वत्समपकरोति"<br><br>अप + आ + कृञ् = अपाकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ತಳ್ಳಿಹಾಕು /ತಿರಸ್ಕರಿಸು<br><br>

आ + कृञ्|आकृञ्|आकारः
आ + कृञ् = आकारः ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಆಕಾರ /ರೂಪ<br><b>प्रयोगाः - </b>"आकारसदृशप्रज्ञः प्रज्ञया सदृशागमः"<br><b>उल्लेखाः - </b>रघु० १-१५<br><br>

उप + कृञ्|उपकृञ्|उपकरोति|उपकारः
उप + कृञ् = उपकरोति । उपकारः ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಉಪಕಾರ ಮಾಡು /ಸಾಹಾಯ್ಯ ಮಾಡು<br><b>प्रयोगाः - </b>"शाम्येत् प्रत्यपकारेण नोपकारेण दुर्जनः" । "प्रतिकर्म कर्तुमुपचक्रमिरे समये हि सर्वमुपकारि कृतम्" ।<br><b>उल्लेखाः - </b>कुमा० २-४०, माघ० ९-४३<br><br>

उप + आ + कृञ्|उपाकृञ्|उपाकरणम्|उपाकृत्य
उप + आ + कृञ् = उपाकरणम् । उपाकृत्य ।<br><br><b>कन्नडार्थः - </b>ಉಪಕ್ರಮ /ಪ್ರಾರಂಭ<br><b>प्रयोगाः - </b>"श्रावण्यां प्रौष्ठपद्यां वाऽप्युपाकृत्य यथाविधि"<br><b>उल्लेखाः - </b>मनु० ४-९५<br><br>

दुर् + कृञ् , दुस् + कृञ्|दुष्कृञ्|दुष्कृतम्
दुर् + कृञ् , दुस् + कृञ् = दुष्कृतम् ।<br><br><b>कन्नडार्थः - </b>ಅಕಾರ್ಯ /ಕೆಟ್ಟ ಕೆಲಸ<br><br>

नि + कृञ्|निकृञ्|निकारः
नि + कृञ् = निकारः ।<br><br><b>कन्नडार्थः - </b>ಅವಮಾನ<br><b>प्रयोगाः - </b>"पुरःसराः धामवतां यशोधनाः सुदुःसहं प्राप्य निकारमीदृशम्"<br><b>उल्लेखाः - </b>किरा० १-४३<br><br>

निर् + आ + कृञ्|निराकृञ्|निराकृतिः
निर् + आ + कृञ् = निराकृतिः ।<br><br><b>कन्नडार्थः - </b>ತಿರಸ್ಕರಿಸು<br><b>प्रयोगाः - </b>"हृताशकीनाशजलेशदूतीर्निराकरिष्णोः कृतकाकुयाञ्चाः"<br><b>उल्लेखाः - </b>नैष० ६-७५<br><br>

निस् + कृञ्|निष्कृञ्|निष्कृतिः
निस् + कृञ् = निष्कृतिः ।<br><br><b>कन्नडार्थः - </b>ಶುದ್ಧಿಕಾರ್ಯ /ಪ್ರಾಯಶ್ಚಿತ್ತ<br><b>प्रयोगाः - </b>"एषा विचित्राभिहिता सुरापानस्य निष्कृतिः"<br><b>उल्लेखाः - </b>मनु० ११-९८<br><br>

परा + कृञ्|पराकृञ्|पराकरोति
परा + कृञ् =पराकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ತಿರಸ್ಕಾರ<br><b>प्रयोगाः - </b>"ता हनूमान् पराकुर्वन्नगमत् पुष्पकं प्रति"<br><b>उल्लेखाः - </b>भट्टि० ८-५०<br><br>

परि + कृञ्|परिकृञ्|परिष्करोति
परि + कृञ् = परिष्करोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಲಂಕರಿಸು /ಭೂಷಿಸು<br><b>प्रयोगाः - </b>"जज्ञे निवेशनविभागपरिष्कृतानां लक्ष्मीः पुरोपवनजा वनपादपानाम्"<br><b>उल्लेखाः - </b>किरा० ७-४०<br><br>

प्र + कृञ्|प्रकृञ्|प्रकरोति
प्र + कृञ् = प्रकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪ್ರಸ್ತಾವ /ಪ್ರಸ್ತುತ<br><b>प्रयोगाः - </b>"विषयात्मतयारोप्ये प्रकृतार्थोपयोगिनि"<br><b>उल्लेखाः - </b>सा० द०१०-३४<br><br>प्र + कृञ् = प्रकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪ್ರಾರಂಭ /ಉಪಕ್ರಮ<br><b>प्रयोगाः - </b>"प्रकृतजपविधीनामास्यमुद्रश्मिदन्तम्"<br><b>उल्लेखाः - </b>माघ० ११-४२<br><br>प्र + कृञ् = प्रकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪ್ರಕೃತಿ /ಸ್ವಭಾವ<br><b>प्रयोगाः - </b>"सिंहः शिशुरपि निपतति मदमलिनकपोलभित्तिषु गजेषु । प्रकृतिरियं सत्त्ववतां न खलु वयस्तेजसां हेतुः" । "यशसि चाभिरुचिर्व्यसनं श्रुतौ प्रकृतिसिद्धमिदं हि महात्मनाम्" ।<br><b>उल्लेखाः - </b>भर्तृ० १-३०, भर्तृ० १-५२<br><br>प्र + कृञ् = प्रकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕಾರಣ /ಹೇತು<br><b>प्रयोगाः - </b>"मूलप्रकृतिरविकृतिः"<br><b>उल्लेखाः - </b>सां० का० ३<br><br>प्र + कृञ् = प्रकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪರಸ್ತ್ರೀಯಲ್ಲಿ ಬಲಾತ್ಕಾರವಾಗಿ ಪ್ರವೇಶಿಸು<br><b>प्रयोगाः - </b>"परदारान् प्रकुरुते"<br><br>प्र + कृञ् = प्रकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ರೀತಿ /ಸಾದೃಶ್ಯ /ಪ್ರಕಾರ<br><b>प्रयोगाः - </b>"प्रकारवचने थाल्"<br><b>उल्लेखाः - </b>पा० सू० ५-३-२३<br><br>

प्रति + कृञ्|प्रतिकृञ्|प्रतिकरोति
प्रति + कृञ् = प्रतिकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಯಾಗಿ ಮಾಡು /ಬದಲಾಗಿ ಮಾಡು<br><b>प्रयोगाः - </b>"कृतप्रतिकृतप्रीतैस्तयोर्मुक्तां सुरासुरैः । परस्परशरव्राताः पुष्पवृष्टिं न सेहिरे ॥" "क्षययुक्तिमुपक्षते कृती कुरुते तत्प्रतिकारमन्यथा" ।<br><b>उल्लेखाः - </b>रघु० १२-९४, किरा० २-९<br><br>प्रति + कृञ् = प्रतिकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ನಿವಾರಣೆಯ ಉಪಾಯ /ಪರಿಹಾರೋಪಾಯ<br><b>प्रयोगाः - </b>"विकारं खलु परमार्थतोऽज्ञात्वा नारम्भः प्रतीकारस्य"<br><b>उल्लेखाः - </b>शाकु० ३<br><br>प्रति + कृञ् = प्रतिकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪ್ರತಿಬಿಂಬ /ವಿಗ್ರಹ<br><b>प्रयोगाः - </b>"तस्य एव प्रतिकृतिसखो यत्क्रतूनाजहार"<br><b>उल्लेखाः - </b>रघु० १४-८७<br><br>प्रति + कृञ् = प्रतिकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹಿಂತಿರುಗಿಸು /ಹಿಂದಕ್ಕೆ ಕೊಡು<br><b>प्रयोगाः - </b>"रिक्थभाज ऋणं प्रतिकुर्युः"<br><b>उल्लेखाः - </b>गौतमघ० १२-३७<br><br>

वि + कृञ्|विकृञ्|विकरोति
वि + कृञ् = विकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ವಿಕಾರ ಹೊಂದು /ಬದಲಾವಣೆ ಹೊಂದು<br><b>प्रयोगाः - </b>"विकारहेतौ सति विक्रियन्ते येषां न चेतांसि त एव धीराः"<br><b>उल्लेखाः - </b>कुमा० १-५९<br><br>वि + कृञ् = विकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕೋಪ /ಸಿಟ್ಟು<br><b>प्रयोगाः - </b>"सावलेपमुपलिप्सिते परैरभ्युपैति विकृतिं रजस्यपि"<br><b>उल्लेखाः - </b>किरा० १३-५६<br><br>वि + कृञ् = विकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸು /ತೊಂದರೆ ಕೊಡು<br><b>प्रयोगाः - </b>"हीनान्यनुपकर्तृणि प्रवृद्धानि विकुर्वते"<br><b>उल्लेखाः - </b>रघु० १७-५८<br><br>

वि + आ +कृञ्|व्याकृञ्|व्याकरोति
वि + आ +कृञ् = व्याकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ವ್ಯಾಖ್ಯಾನ /ವಿವರಣೆ /ವಿಸ್ತಾರವಾಗಿ ಹೇಳುವುದು /ಸ್ಪಷ್ಟಪಡಿಸುವುದು /ವಿಶದವಾಗಿ ಹೇಳುವುದು<br><b>प्रयोगाः - </b>"नामरूपे व्याकरवाणि"<br><b>उल्लेखाः - </b>छान्दोग्य०<br><br>

वि + प्र + कृञ्|विप्रकृञ्|विप्रकरोति
वि + प्र + कृञ् = विप्रकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಪೀಡಿಸು /ತೊಂದರೆ ಪಡಿಸು<br><b>प्रयोगाः - </b>"तस्मिन् विप्रकृतां काले तारकेण दिवौकसः"<br><b>उल्लेखाः - </b>कुमा० २-१<br><br>वि + प्र + कृञ् = विप्रकरोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಪಕಾರ ಮಾಡು /ಕೆಡಕು ಮಾಡು<br><b>प्रयोगाः - </b>"त्वया विप्रकृतश्चैद्यः"<br><b>उल्लेखाः - </b>माघ० २-३८<br><br>

सम् + कृञ्|सङ्स्कृञ्|संस्करोति
सम् + कृञ् = संस्करोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಲಂಕರಿಸು /ಭೂಷಿಸು<br><b>प्रयोगाः - </b>"स्फुरदंशुजालमथ शीतरुचः ककुभं समस्कुरुत माघवनीम्"<br><b>उल्लेखाः - </b>माघ० ९-२५<br><br>सम् + कृञ् = सस्करोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಶುದ್ಧಿ ಮಾಡು<br><b>प्रयोगाः - </b>"वाण्येका समलङ्करोति पुरुषं या संस्कृता धार्यते"<br><b>उल्लेखाः - </b>भर्तृ० १-१५<br><br>सम् + कृञ् = सस्करोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಶಿಕ್ಷಣ ಕೊಡು /ತರಬೇತು ಮಾಡು /ಪಳಗಿಸು<br><b>प्रयोगाः - </b>"अथवा शश्वदार्योपदेशसंस्क्रियमाणमतयः सदैव स्वतन्त्रा वयम्"<br><b>उल्लेखाः - </b>मुद्रा० ३<br><br>सम् + कृञ् = सस्करोति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ನಯಮಾಡು /ನಾಜೂಕು ಮಾಡು<br><b>प्रयोगाः - </b>"प्रयुक्तसंस्कार इवाधिकं बभौ"<br><b>उल्लेखाः - </b>रघु० ३-१८<br><br>

कृणु
कृणु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರಗಾರ /ಚಿತ್ರ ಬರೆಯುವವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "नुः" णत्वं च बाहु० ।<br><b>विस्तारः - </b>"चित्रकरे कृणुः" - त्रिकाण्ड० ।<br><br>

कृत्
कृत्<br><br><b>कन्नडार्थः - </b>धातोः ಸೂತ್ರದ ಅಧಿಕಾರದಲ್ಲಿ ಧಾತುಗಳ ಮುಂದೆ ವಿಹಿತವಾದ ಪ್ರತ್ಯಯ / ಧಾತ್ವಧಿಕಾರದಲ್ಲಿ ವಿಹಿತವಾದ तिङ् ಭಿನ್ನವಾದ ಪ್ರತ್ಯಯಗಳು<br><br>कृत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "क्विप्" (३-२-७६)<br><br>

कृत
कृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯ /ಕೆಲಸ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - भावे "क्तः" (३-३-११४)<br><br>कृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತಯುಗ /ಸತ್ಯ ಯುಗ /ಚತುರ್ಯುಗಗಳಲ್ಲಿ ಒಂದನೆಯದು<br><br>कृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ನ ಮೊದಲಾದ ಹವಿಸ್ಸು<br><b>विस्तारः - </b>"यावदित्वकृतं हव्यं तण्डुलास्तु कृताकृतम्" - वैज० ।<br><br>कृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಫಲ<br><br>कृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಲ್ಕು ಸಂಖ್ಯೆ<br><br>कृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಗಡೆಯ ದಾಳದಲ್ಲಿ ಬೀಳುವ ನಾಲ್ಕು ಅಂಕಗಳು<br><br>कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"प्रतिकर्म कर्तुमुपचक्रमिरे समये हि सर्वमुपकारि कृतम्"<br><b>उल्लेखाः - </b>माघ० ९-४३<br><br>कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸಲ್ಪಟ್ಟ /ಪೀಡಿಸಲ್ಪಟ್ಟ<br><br>कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪರ್ಯಾಪ್ತವಾದ /ಸಾಕಾಗುವಷ್ಟು<br><br>कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಹಿತವಾದ<br><b>विस्तारः - </b>"कृतं पर्याप्तयुगयोः विहिते हिंसिते फले" - हेम० ।<br><br>कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತು ಬೀಜ ಬಿತ್ತಲ್ಪಟ್ಟಿರುವ<br><b>प्रयोगाः - </b>"अकृतं च कृतात् क्षेत्रात् गौरजाविकमेव च । हिरण्यं धान्यमन्नं च पूर्वं पूर्वमदोषवत् ॥"<br><b>उल्लेखाः - </b>मनु० १०-११४<br><br>कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಂಟಾದ /ಹುಟ್ಟಿದ /ಸಂಭವಿಸಿದ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - कर्त० "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"जपहोमैरपैत्येनः याजनाध्यापनैः कृतम्"<br><b>उल्लेखाः - </b>मनु० १०-१११<br><br>कृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತನ್ನ ಊಟಕ್ಕಾಗಿ ಸೇವಕನಾಗಿ ಸೇರಿಕೊಂಡಿರುವ<br><b>विस्तारः - </b>"भक्तायैव स्थितः कृतः" - वैज० ।<br><br>

कृतम्
कृतम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಾಕು<br><br>कृतम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಾಕು ಮಾಡು /ನಿಲ್ಲಿಸು<br><b>प्रयोगाः - </b>"कृतं सन्देहेन"<br><br>कृतम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಸಾಕು /ಸಾಕು ಮಾಡು /ನಿಲ್ಲಿಸು<br><b>विस्तारः - </b>"कृतं युगेऽलमर्थे स्यात्"- मेदि० ।<br><br>

कृते
कृते<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅದಕ್ಕಾಗಿ /ಅದಕ್ಕೋಸ್ಕರ<br><b>प्रयोगाः - </b>"देवातिथ्यर्चनकृते गुरुभृत्यार्थमेव च । सर्वतः प्रतिगृह्णीयात् आत्मवृत्त्यर्थमेव च ॥"<br><b>उल्लेखाः - </b>याज्ञ० १-२१६<br><br>

कृतक
कृतक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃತ್ರಿಮವಾದ /ಸ್ವಭಾವದ್ದಲ್ಲದ /ಕಾರ್ಯದಿಂದ ಉಂಟಾದ /ಸಲಕರಣೆಗಳಿಂದ ತಯಾರಾದ<br><b>निष्पत्तिः - </b>कृतमेव - स्वार्थे "कन्" (५-४-५)<br><b>प्रयोगाः - </b>"लिम्पद्भिः कृतकं कृतोऽपि रजतं राज्ञां यशः पारदैः"<br><b>उल्लेखाः - </b>नैष० १२-९१<br><br>

कृतकम्
कृतकम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೃತ್ರಿಮವಾಗಿ /ಅಸ್ವಾಭಾವಿಕವಾಗಿ /ಅಸತ್ಯವಾಗಿ<br><b>प्रयोगाः - </b>"अपयाति सरोषया निरस्ते कृतकं कामिनि चुक्षुवे मृगाक्ष्या"<br><b>उल्लेखाः - </b>माघ० ९-८३<br><br>

कृतकर्तव्य
कृतकर्तव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಬೇಕಾದುದನ್ನು ಮಾಡಿರುವ /ಕರ್ತವ್ಯವನ್ನು ನೆರವೇರಿಸಿರುವ<br><b>व्युत्पत्तिः - </b>कृतं कर्तव्यं येन<br><b>प्रयोगाः - </b>"किन्त्वसौ स्वामिनः प्रत्यक्प्रवणतां विचिन्त्य कृतकर्तव्यमिवात्मानं मत्वा स्वयमेव धर्मः शून्यव्यापारोऽभूत्"<br><b>उल्लेखाः - </b>प्रबोध०<br><br>

कृतकर्मन्
कृतकर्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಮಾತ್ಮ /ವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>कृतं स्वयमनुष्ठितं कर्म तदाचारोऽनेन<br><b>प्रयोगाः - </b>"इन्द्रकर्मा महाकर्मा कृतकर्मा कृतागमः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"स्वानुष्ठिततदाचारः कृतकर्मेति कथ्यते" - निरुक्तिः<br><br>कृतकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಡಲ್ಪಟ್ಟ ಕಾರ್ಯ<br><b>व्युत्पत्तिः - </b>कृतं कर्म<br><br>कृतकर्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಲ್ಪಟ್ಟ ಕೆಲಸವುಳ್ಳ /ತನ್ನ ಕೆಲಸ ಮಾಡಿಕೊಂಡಿರುವ<br><b>व्युत्पत्तिः - </b>कृतं कर्म येन<br><br>कृतकर्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯಚತುರನಾದ /ದಕ್ಷನಾದ /ಕಾರ್ಯದಲ್ಲಿ ಸಮರ್ಥನಾದ<br><br>

कृतकार्य
कृतकार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಡಲ್ಪಟ್ಟ ಕೆಲಸ<br><b>व्युत्पत्तिः - </b>कृतं कार्यम्<br><br>कृतकार्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಲ್ಪಟ್ಟ ಕೆಲಸವುಳ್ಳ /ಕಾರ್ಯವನ್ನು ನೆರವೇರಿಸಿದ<br><b>व्युत्पत्तिः - </b>कृतं कार्यं येन<br><b>प्रयोगाः - </b>"समुहकार्यं आयातान् कृतकार्यान् विसर्जयेत्"<br><b>उल्लेखाः - </b>याज्ञ० २-१८९<br><br>

कृतकाल
कृतकाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೊತ್ತುಮಾಡಿರುವ ಸಮಯ /ನಿಗದಿಮಾಡಿರುವ ಕಾಲ<br><b>प्रयोगाः - </b>"कृतशिल्पोऽपि निवसेत् कृतकालं गुरोर्गृहे"<br><b>उल्लेखाः - </b>याज्ञ० २-१८४<br><br>

कृतकृत्य
कृतकृत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಡಲ್ಪಟ್ಟ ಕಾರ್ಯ /ನೆರವೇರಿಸಲ್ಪಟ್ಟ ಕೆಲಸ<br><b>व्युत्पत्तिः - </b>कृतं कृत्यम्<br><br>कृतकृत्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾದಲ್ಪಟ್ಟ ಕರ್ತವ್ಯವುಳ್ಳ /ಕರ್ತವ್ಯವನ್ನು ನೆರವೇರಿಸಿದ<br><b>व्युत्पत्तिः - </b>कृतं कृत्यं येन<br><b>प्रयोगाः - </b>"सम्पदा सुस्थिरम्मन्यो भवति स्वल्पयापि यः । कृतकृत्यो विधिर्मन्ये न वर्धयति तस्य ताम् ॥"<br><b>उल्लेखाः - </b>माघ० २-३२<br><br>

कृतकृत्यता
कृतकृत्यता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತಾರ್ಥನಾಗುವಿಕೆ /ಮಾದಬೇಕಾದುದನ್ನು ಮಾಡಿರುವುದು<br><b>प्रयोगाः - </b>"राज्यप्राप्तिकृतार्थमेकमपरं तीर्णप्रतिज्ञार्णवं सौहार्दात् कृतकृत्यतैव नियतं लब्धान्तरा भेत्स्यति"<br><b>उल्लेखाः - </b>मुद्रा० २-२३<br><br>

कृतकेतर
कृतकेतर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃತ್ರಿಮವಲ್ಲದ /ಸ್ವಭಾವವಾದ<br><b>व्युत्पत्तिः - </b>कृतकात् इतरः<br><br>कृतकेतर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪೌರುಷೇಯವಾದ /ಮನುಷ್ಯರಿಂದ ಮಾಡಲ್ಪಡದ<br><b>प्रयोगाः - </b>"उच्चैर्गतिर्जगति सिद्ध्यति धर्मतश्चेत् तस्य प्रमा च वचनैः कृतकेतरैश्चेत्"<br><b>उल्लेखाः - </b>चं० रा०<br><br>

कृतकोटि
कृतकोटि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಶ್ಯಪ ಮಹರ್ಷಿ<br><br>कृतकोटि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಪವರ್ಷ ಋಷಿ<br><b>विस्तारः - </b>"कृतकोटिस्तु काश्यपः" - त्रिकाण्ड० । "उपवर्षो हलभृतिः कृतकोटिरयाचितः" - त्रिकाण्ड० ।<br><br>

कृतक्रय
कृतक्रय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಲ್ಪಟ್ಟ ಕ್ರಯವುಳ್ಳ /ಕ್ರಯಕ್ಕೆ ತೆಗೆದುಕೊಂಡ /ಬೆಲೆಕೊಟ್ಟು ತೆಗೆದುಕೊಂಡ<br><b>व्युत्पत्तिः - </b>कृतः क्रयो येन<br><br>

कृतक्रिय
कृतक्रिय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಲ್ಪಟ್ಟ ಕೆಲಸವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कृता क्रिया येन<br><b>प्रयोगाः - </b>"विप्रः शुध्यत्यपः स्पृष्ट्वा क्षत्रियो वाहनायुधम् । वैश्यः प्रतोदं रश्मीन् वा यष्टिं शूद्रः कृतक्रियः ॥"<br><b>उल्लेखाः - </b>मनु० ५-९९<br><br>कृतक्रिय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಚರಿಸಲ್ಪಟ್ಟ ಕರ್ತವ್ಯವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कृतं कार्यं यस्य<br><b>प्रयोगाः - </b>"स बभूव दुरासदः परैर्गुरुणाथर्वविदा कृतक्रियः"<br><b>उल्लेखाः - </b>रघु० ८-४<br><br>

कृतक्षण
कृतक्षण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಕಾಶವನ್ನು ಹೊಂದಿರುವ<br><br>कृतक्षण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಯವನ್ನು ಕಾಯುವ /ಸರಿಯಾದ ಕಾಲವನ್ನು ನಿರೀಕ್ಷಿಸುವ /ಗೊತ್ತಾದ ಕಾಲವನ್ನು ಕಾದು ನೋಡುವ<br><b>व्युत्पत्तिः - </b>कृतः क्षणो येन<br><b>प्रयोगाः - </b>"वयं सर्वे कृतक्षणाः तिष्ठामः" । "तमुत्तङ्कः प्रत्युवाच कृतक्षण एवास्मि शीघ्रमिच्छामि यथोपपन्नमन्नमुपस्कृतम्" ।<br><b>उल्लेखाः - </b>पञ्चतं०, भा० आदि० ३<br><br>

कृतघ्न
कृतघ्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಿದ ಉಪಕಾರವನ್ನು ಮರೆತಿರುವ /ಮಾಡಿದ ಉಪಕಾರಕ್ಕೆ ಬದಲಾಗಿ ಅಪಕಾರ ಮಾಡುವ /ಉಪಕಾರ ಮಾಡಿದವನನ್ನು ಹಿಂಸಿಸುವ<br><b>प्रयोगाः - </b>"परलोकगतो देवः कृतघ्नैर्नानुगम्यते" । "बालघ्नांश्च कृतघ्नांश्च विशुद्धानपि धर्मतः । शरणागतहर्तॄंश्च स्त्रीहन्तॄंश्च न संवसेत् ॥"<br><b>उल्लेखाः - </b>मुद्रा० २-२०, मनु० ११-१९२<br><br>

कृतघ्नता
कृतघ्नता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತಘ್ನನಾಗಿರುವಿಕೆ /ಮಾಡಿದ ಉಪಕಾರವನ್ನು ಮರೆಯುವಿಕೆ /ಉಪಕಾರ ಮಾಡಿದವನಿಗೆ ಅಪಕಾರ ಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कृतघ्नस्य भावः<br><b>प्रयोगाः - </b>"निग्रहे यावत्पर्वतकोस्माभिः व्यापादित इति कृतघ्नतायाः स्वयं हस्तो दत्तः स्यात्"<br><b>उल्लेखाः - </b>मुद्रा० ३<br><br>

कृतघ्नत्व
कृतघ्नत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತಘ್ನನಾಗಿರುವಿಕೆ /ಮಾಡಿದ ಉಪಕಾರವನ್ನು ಮರೆಯುವಿಕೆ /ಉಪಕಾರ ಮಾಡಿದವನಿಗೆ ಅಪಕಾರ ಮಾಡುವಿಕೆ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

कृतज्ञ
कृतज्ञ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ಪರಮಾತ್ಮ<br><b>निष्पत्तिः - </b>ज्ञा (अवबोधने) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>कृतं सुकृतमानुकूल्यवज्जानाति<br><b>प्रयोगाः - </b>"अनुत्तमो दुराधर्षः कृतज्ञः कृतिरात्मवान्"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"प्राणिभिर्यत्कृतं कर्म तज्ज्ञात्वा फलदो यतः । पत्रपुष्पादिना तुष्टः कृतज्ञो मोक्षदानतः ॥" - निरुक्तिः ।<br><br>कृतज्ञ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಯಿ<br><br>कृतज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಿದ ಉಪಕಾರವನ್ನು ಸ್ಮರಿಸುವವನು /ಉಪಕಾರಕ್ಕೆ ತಕ್ಕ ಪ್ರತ್ಯುಪಕಾರವನ್ನು ಮಾಡುವವನು<br><b>विस्तारः - </b>"कृतज्ञः कुक्कुरे पुंसि मर्यादिन्यभिधेयवत्" - मेदि० ।<br><br>

कृतज्ञता
कृतज्ञता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಪಕಾರವನ್ನು ಸ್ಮರಿಸುವುದು<br><b>प्रयोगाः - </b>"कृतज्ञातामस्य वदन्ति सम्पदः"<br><b>उल्लेखाः - </b>किरा० १-१४<br><br>कृतज्ञता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರತ್ಯುಪಕಾರ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कृतज्ञस्य भावः<br><b>प्रयोगाः - </b>"तेनाप्यसौ ममानेन प्राणाः परिरक्षिता इति कृतज्ञतामनुरुध्यमानेन पैतृकं च परिचयं आत्मनोऽनन्तरं अमात्यपदं ग्राहितः"<br><b>उल्लेखाः - </b>मुद्रा० ३<br><br>

कृततीर्थ
कृततीर्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುಣ್ಯಕ್ಷೇತ್ರಗಳ ಯಾತ್ರೆ ಮಾಡಿದವನು<br><br>कृततीर्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠನಾದ ಆಚಾರ್ಯನಲ್ಲಿ ವಿದ್ಯೆ ಕಲಿತವನು<br><br>कृततीर्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಪಾಯವನ್ನು ತಿಳಿದವನು<br><br>कृततीर्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಲಾವತಾರ ಮಾಡಿದವನು /ನೀರಿನಲ್ಲಿ ಸರಿಯಾದ ತೊರೆಯಲ್ಲಿ ಇಳಿದವನು<br><b>व्युत्पत्तिः - </b>कृतं तीर्थं क्षेत्रं उपाध्यायः उपायः जलावतारो वा येन<br><b>प्रयोगाः - </b>"विषमोऽपि विगाह्यते नयः कृततीर्थः पयसामिवाशयः"<br><b>उल्लेखाः - </b>किरा० २-३<br><br>

कृतदार
कृतदार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮದುವೆಯಾದವನು /ಪತ್ನಿಯನ್ನು ಪಡೆದುಕೊಂಡಿರುವವನು<br><b>प्रयोगाः - </b>"कृतदारोऽपरान् दारान् भिक्षित्वा योऽधिगच्छति"<br><b>उल्लेखाः - </b>मनु० ११-५<br><br>

कृतदास
कृतदास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಲಪರಿಮಿತಿಯನ್ನು ನಿಗದಿಮಾಡಿ ಸೇವಕನಾಗಿರುವವನು /ಇನ್ನಷ್ಟು ಕಾಲ ನಿನ್ನಲ್ಲಿ ಸೇವಕನಾಗಿರುವೆನೆಂದು ಒಪ್ಪಿರುವವನು /೧೫ ವಿಧ ಸೇವಕರಲ್ಲೊಬ್ಬ<br><b>व्युत्पत्तिः - </b>कृतो दासः<br><br>

कृतधी
कृतधी<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿದ್ಯಾವಂತ /ವಿದ್ಯಾಭ್ಯಾಸದಿಂದ ಒಳ್ಳೆಯ ಸಂಸ್ಕೃತಿಯನ್ನು ಪಡೆದವನು<br><b>व्युत्पत्तिः - </b>कृता लब्धा धीर्येन<br><b>प्रयोगाः - </b>"महारम्भाः कृतधियस्तिष्ठन्ति च निराकुलाः"<br><b>उल्लेखाः - </b>माघ० २-७९<br><br>कृतधी<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಥಿರಚಿತ್ತನಾದ<br><br>कृतधी<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿವೇಕಶಾಲಿಯಾದ /ಯುಕ್ತಾಯುಕ್ತಪರಿಜ್ಞಾನವುಳ್ಳ<br><b>प्रयोगाः - </b>"पुत्रेभ्यः कृतवेदिनां कृतधियो येषामभिन्ना वयम्"<br><b>उल्लेखाः - </b>मुद्रा० ५-२०<br><br>

कृतध्वज
कृतध्वज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಶಧ್ವಜನ ಮೊಮ್ಮಗ /ಧರ್ಮಧ್ವಜನ ಮಗ<br><b>प्रयोगाः - </b>"कुशध्वजस्तस्य पुत्रस्ततो धर्मध्वजो नृपः । धर्मध्वजस्य द्वौ पुत्रौ कुशध्वजमितध्वजौ ॥"<br><b>उल्लेखाः - </b>भाग० ९-१३<br><br>

कृतनामधेय
कृतनामधेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಸರುವಾಸಿಯಾದವನು /ಪ್ರಸಿದ್ಧಿ ಪಡೆದವನು /ಪ್ರಖ್ಯಾತ /ಕೀರ್ತಿವಂತ<br><b>व्युत्पत्तिः - </b>कृतं नामधेयं यस्य<br><br>कृतनामधेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಸರಿಡಲ್ಪಟ್ಟ /ನಾಮಕರಣ ಮಾಡಲ್ಪಟ್ಟ<br><br>

कृतनिश्चय
कृतनिश्चय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯಿಸಿಕೊಂಡವನು /ತೀರ್ಮಾನ ಮಾಡಿಕೊಂಡವನು<br><b>व्युत्पत्तिः - </b>कृतो निश्चयो येन<br><b>प्रयोगाः - </b>"इहैव तावत् कृतनिश्चयोह्ययं यदि व्रजेयं प्लवगेश्वरालयम्" । "हतो वा प्राप्स्यसि स्वर्गं जित्वा वा भोक्ष्यसे महीम् । तस्मादुत्तिष्ठ कौन्तेय युद्धाय कृतनिश्चयः ॥"<br><b>उल्लेखाः - </b>रामा०, गीता० २-३७<br><br>कृतनिश्चय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ಥಿರಚಿತ್ತವುಳ್ಳ /ದೃಢವಾದ ಮನಸ್ಸುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कृतो निश्चयो येन<br><br>

कृतपुङ्ख
कृतपुङ्ख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾಣಪ್ರಯೋಗದಲ್ಲಿ ಚತುರನಾದ /ಬಾಣಗಳನ್ನು ಬಿಡುವುದರಲ್ಲಿ ಜಾಣನಾದ /ಬಾಣಪ್ರಯೋಗವನ್ನು ಚೆನ್ನಾಗಿ ಅಭ್ಯಾಸ ಮಾಡಿದ<br><b>व्युत्पत्तिः - </b>कृतः अभ्यस्तः पुङ्खो येन<br><br>

कृतप्रणाम
कृतप्रणाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಮಸ್ಕಾರ ಮಾಡಿದವನು<br><b>व्युत्पत्तिः - </b>कृतः प्रणामो येन<br><b>प्रयोगाः - </b>"कृतप्रणामस्य महीं महीभुजे जितां सपत्नेन निवेदयिष्यतः"<br><b>उल्लेखाः - </b>किरा० १-२<br><br>कृतप्रणाम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಮಸ್ಕಾರ ಮಾಡಲ್ಪಟ್ಟವನು<br><b>व्युत्पत्तिः - </b>कृतः प्रणामो यस्य<br><br>

कृतप्रतिज्ञ
कृतप्रतिज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರತಿಜ್ಞೆ ಮಾಡಿದವನು<br><b>व्युत्पत्तिः - </b>कृता प्रतिज्ञा येन<br><br>कृतप्रतिज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಿದ ಪ್ರತಿಜ್ಞೆಯನ್ನು ಈಡೇರಿಸಿದವನು /ಪ್ರತಿಜ್ಞೆಯನ್ನು ಪೂರ್ಣಗೊಳಿಸಿದವನು<br><br>

कृतबुद्धि
कृतबुद्धि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುಸಂಸ್ಕೃತ ಬುದ್ಧಿಯುಳ್ಳ /ಪಕ್ವವಾದ ಬುದ್ಧಿಯುಳ್ಳ<br><b>प्रयोगाः - </b>"पश्यत्यकृतबुद्धित्वान्न स पश्यति दुर्मतिः"<br><b>उल्लेखाः - </b>गीता० १८-१६<br><br>

कृतमति
कृतमति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನಸ್ಸಿನಲ್ಲಿ ನಿಶ್ಚಯಿಸಿಕೊಂಡ /ನಿರ್ಣಯಮಾಡಿಕೊಂಡ<br><b>व्युत्पत्तिः - </b>कृता मतिर्येन<br><b>प्रयोगाः - </b>"सत्त्वहितकृतमतिः सहसा तमसा विनाशयति सर्वमावृतः"<br><b>उल्लेखाः - </b>माघ० १५-१३<br><br>

कृतमाल
कृतमाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಕ್ಕೆಗಿಡ<br><b>व्युत्पत्तिः - </b>कृता मालास्य पुष्पैः<br><b>प्रयोगाः - </b>"काश्मर्याः कृतमालमुद्गतदलं कोयष्टिकष्टीकते"<br><b>उल्लेखाः - </b>मालती० ९-७<br><br>कृतमाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಣಗಿಲೆ ಗಿಡ<br><br>कृतमाल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಾರವನು ತಯಾರಿಸಿದವನು<br><b>व्युत्पत्तिः - </b>कृता माला येन<br><br>

कृतमुख
कृतमुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿದ್ಯಾವಂತ /ಜಾಣ /ಬುದ್ಧಿವಂತ /ನಿಪುಣ<br><b>व्युत्पत्तिः - </b>कृतं संस्कृतं मुखं यस्य<br><b>विस्तारः - </b>"वैज्ञानिकः कृतमुखः कृती कुशल इत्यपि" - अम० ।<br><br>

कृतयुग
कृतयुग<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚತುರ್ಯುಗಗಳಲ್ಲಿ ಒಂದು<br><br>

कृतलक्षण
कृतलक्षण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>कृतं लक्षणं चक्रादिलाञ्छनं येन<br><b>प्रयोगाः - </b>"अविज्ञाता सहस्रांशुः विधाता कृतलक्षणः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"कृतं हि लाञ्छनं येन उपादेयेषु जन्तुषु । परमात्मा हृषीकेशः स तु स्यात् कृतलक्षणः ॥" - निरुक्तिः ।<br><br>कृतलक्षण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸದ್ಗುಣಗಳಿಂದ ಕೂಡಿದ /ಒಳ್ಳೆಯ ಗುಣಗಳಿಂದ ಪ್ರಸಿದ್ಧನಾದ<br><b>व्युत्पत्तिः - </b>कृतानि लक्षणानि यस्य<br><br>कृतलक्षण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುರುತು ಮಾಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"ज्ञातिसम्बन्धिभिस्त्वेते त्यक्तव्याः कृतलक्षणाः"<br><b>उल्लेखाः - </b>मनु० ९-२३१<br><br>कृतलक्षण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮುದ್ರೆ ಹಾಕಲ್ಪಟ್ಟ<br><br>

कृतवत्
कृतवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಿದವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "क्तवतुः" (३-२-१०२)<br><b>प्रयोगाः - </b>"प्रयत्नं कृतवन्तोऽपि दृश्यन्तेह्यफलाः जनाः । मार्गत्यायशतैरर्थान् अमार्गश्चापरः सुखी ॥"<br><b>उल्लेखाः - </b>भा० अनु० १६३-५<br><br>

कृतवती
कृतवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಡಿದವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कृतवसति
कृतवसति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಸತಿಯನ್ನು ಕಲ್ಪಿಸಿಕೊಂಡ /ಮನೆಮಾಡಿಕೊಂಡ /ವಾಸಸ್ಥಾನವನ್ನು ಏರ್ಪಡಿಸಿಕೊಂಡ<br><b>व्युत्पत्तिः - </b>कृता वसतिर्येन<br><b>प्रयोगाः - </b>"अमृतकरशिरोमणिर्गिरीन्द्रे कृतवसतिर्वशिभिर्गणैर्ननन्द"<br><b>उल्लेखाः - </b>कुमा० ९-५२<br><br>

कृतविद्य
कृतविद्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿದ್ಯಾವಂತ /ವಿದ್ಯಾಭ್ಯಾಸ ಮಾಡಿದವನು /ವಿದ್ಯೆ ಕಲಿತವನು<br><b>व्युत्पत्तिः - </b>कृता अभ्यस्ता विद्या येन<br><b>प्रयोगाः - </b>"शूरश्च कृतविद्यश्च यश्च जानाति सेवितुम्"<br><b>उल्लेखाः - </b>पञ्चतं०<br><br>

कृतवीर्य
कृतवीर्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ತವೀರ್ಯಾರ್ಜುನನ ತಂದೆ /ಚಂದ್ರವಂಶದ ಧನಕರಾಜನ ಮಗ<br><br>

कृतवेतन
कृतवेतन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೂಲಿಕೊಡಲ್ಪಟ್ಟ ಆಳು /ಸಂಬಳ ತೆಗೆದುಕೊಂಡ ಸೇವಕ<br><b>व्युत्पत्तिः - </b>कृतं वेतनं यस्य<br><br>

कृतवेदिन्
कृतवेदिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಿದುದನ್ನು ನೆನಸಿಕೊಳ್ಳುವವನು /ಉಪಕಾರವನ್ನು ಸ್ಮರಿಸಿಕೊಳ್ಳುವವನು /ಕೃತಜ್ಞ /ಮಾಡಿದುದಕ್ಕೆ ಪ್ರತ್ಯುಪಕಾರ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>विद (ज्ञाने) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>कृतं वेत्ति<br><b>प्रयोगाः - </b>"पुत्रेभ्यः कृतवेदिनां कृतधियो येषामभिन्ना वयम्" । "न तथा कृतवेदिनां करिष्यन् प्रियतामेति यथा कृतावदानः" ।<br><b>उल्लेखाः - </b>मुद्रा० ५-२०, किरा० १३-३२<br><br>

कृतवेदिनी
कृतवेदिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಡಿದುದನ್ನು ನೆನಸಿಕೊಳ್ಳುವವಳು /ಉಪಕಾರವನ್ನು ಸ್ಮರಿಸಿಕೊಳ್ಳುವವಳು /ಮಾಡಿದುದಕ್ಕೆ ಪ್ರತ್ಯುಪಕಾರ ಮಾಡುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कृतशिल्प
कृतशिल्प<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಶಲವಿದ್ಯೆಯನ್ನು ಕಲಿತವನು /ಕಲಾಭ್ಯಾಸ ಮಾಡಿದವನು<br><b>व्युत्पत्तिः - </b>कृतमभ्यस्तं शिल्पं येन<br><b>प्रयोगाः - </b>"कृतशिल्पोऽपि निवसेत् कृतकालं गुरोर्गृहे । अन्तेवासी गुरुप्राप्तभोजनस्तत्फलप्रदः ॥"<br><b>उल्लेखाः - </b>याज्ञ० २-१८४<br><br>

कृतश्रम
कृतश्रम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಹಳ ಪರಿಶ್ರಮ ಹೊಂದಿರುವ /ಉತ್ಸಾಹದಿಂದಶ್ರಮಪಟ್ಟಿರುವ<br><b>व्युत्पत्तिः - </b>कृतः श्रमो येन<br><b>प्रयोगाः - </b>"शास्त्रेषु कृतश्रमः"<br><br>

कृतसञ्ज्ञ
कृतसञ्ज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಕೇತ ಮಾಡಲ್ಪಟ್ಟ /ಗುರುತು ಮಾಡಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>कृता सञ्ज्ञा सङ्केतो यस्य<br><b>प्रयोगाः - </b>"गुल्मांश्च स्यापयेदाप्तान् कृतसञ्ज्ञान् समन्ततः"<br><b>उल्लेखाः - </b>मनु० ७-१९०<br><br>

कृतसंस्कार
कृतसंस्कार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಜಾತಕರ್ಮ ನಾಮಕರಣ ಮೊದಲಾದ ಸಂಸ್ಕರಾಗಳನ್ನು ಪಡೆದಿರುವ<br><b>व्युत्पत्तिः - </b>कृतः संस्कारो यस्य<br><b>प्रयोगाः - </b>"कुमाराः कृतसंस्कारास्ते धात्रीस्तन्यपायिनः"<br><b>उल्लेखाः - </b>रघु० १०-७८<br><br>कृतसंस्कार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶುದ್ಧಿಕಾರ್ಯ ಮಾಡಲ್ಪಟ್ಟ<br><br>कृतसंस्कार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲಂಕಾರ ಮಾಡಲ್ಪಟ್ಟ<br><br>

कृतसन्नाह
कृतसन्नाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯುದ್ಧಕವಚ ತೊಟ್ಟು ಸಿದ್ಧನಾಗಿರುವವನು<br><br>

कृतसापत्निका
कृतसापत्निका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸವತಿಯನ್ನು ಹೊಂದಿರುವ ಹೆಂಗಸು /ಎರಡನೆಯ ಹೆಂಡತಿಯನ್ನು ಹೊಂದಿರುವವನ ಹಿರಿಯ ಹೆಂಡತಿ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४) । "ङीष्" (४-१-४१) । यलोपः (६-४-१५०) । स्वार्थे "कन्" (५-३-७५)<br><b>व्युत्पत्तिः - </b>सपत्न्याः भावः सापत्निका । कृता सापत्निका यस्याः ।<br><br>

कृतहस्त
कृतहस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾಣಸಂಧಾನ ಮತ್ತು ಉಪಸಂಹಾರಗಳಲ್ಲಿ ಕೈಚಟುವಟಿಕೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कृतो अभ्यस्तो हस्तो यस्य<br><br>कृतहस्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಕ್ಷನಾದ /ಎಲ್ಲಾ ಕಾರ್ಯಗಳಲ್ಲೂ ನಿಪುಣನಾದ<br><br>

कृताकृत
कृताकृत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>कृतश्च अकृतश्च<br><b>प्रयोगाः - </b>"लोकाध्यक्षः सुराध्यक्षः धर्माध्यक्षः कृताकृतः"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"अनित्यनित्यफलदौ प्रवर्तकनिवर्तकौ । ददौ यस्य स्वरूपं सः कृताकृत इतीरितः" - निरुक्तिः ।<br><br>कृताकृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯ ಮತ್ತು ಕಾರಣ<br><b>व्युत्पत्तिः - </b>कृतं कार्यं च अकृतं कारणं च अनयोः समाहारः<br><br>कृताकृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರಗಿಸಲ್ಪಟ್ಟ ಮತ್ತು ಕರಗಿಸಲ್ಪಡದಿರುವ ಚಿನ್ನ ಮತ್ತು ಬೆಳ್ಳಿ<br><br>कृताकृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಭರಣವಾಗಿ ಮಾಡಲ್ಪಟ್ಟ ಮತ್ತು ಮಾಡಲ್ಪಡದಿರುವ ಚಿನ್ನ ಮತ್ತು ಬೆಳ್ಳಿ<br><b>विस्तारः - </b>"स्यात् कोशश्च हिरण्यं च हेमरूप्ये कृताकृते" - अम० ।<br><br>कृताकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಾಗಶಃ ಮಾಡಲ್ಪಟ್ಟ ಮತ್ತು ಮಾಡಲ್ಪಡದಿರುವ<br><b>व्युत्पत्तिः - </b>कृतं चाकृतं च<br><br>

कृतागम
कृतागम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ಪರಮಾತ್ಮ<br><b>व्युत्पत्तिः - </b>कृतः आगमो वेदलक्षणो येन<br><b>प्रयोगाः - </b>"इन्द्रकर्मा महाकर्मा कृतकर्मा कृतागमः" । "अस्य महतोभूतस्य निःश्वसितमेदद्यदृग्वेदो यजुर्वेदः सामवेदश्चेति" ।<br><b>उल्लेखाः - </b>वि० स०, श्रुतिः<br><b>विस्तारः - </b>"कृतागमो येन कृता आगमा वेदलक्षणाः" - निरुक्तिः ।<br><br>

कृतागस्
कृतागस्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪರಾಧ ಮಾಡಿದವನು /ತಪ್ಪು ಮಾಡಿದವನು<br><b>व्युत्पत्तिः - </b>कृतमागो येन<br><b>प्रयोगाः - </b>"कृतागाः कौटिल्यो भुजग इव निर्याय नगरात्"<br><b>उल्लेखाः - </b>मुद्रा० ३-११<br><br>

कृताङ्क
कृताङ्क<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಲ್ಕು ಎಣಿಕೆಯುಳ್ಳ ಪಗಡೆಯ ದಾಳ<br><br>कृताङ्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಖ್ಯೆ ಹಾಕಿರುವ<br><br>कृताङ्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏನಾದರೊಂದು ಬರೆದು ಗುರುತು ಮಾಡಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>कृतोऽङ्को यस्य<br><br>कृताङ्क<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬರೆಹಾಕಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"कट्यां कृताङ्को निर्वास्यः स्फिचं चैवावकर्तयेत्"<br><b>उल्लेखाः - </b>मनु० ८-२८२<br><br>

कृताञ्जलि
कृताञ्जलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಟ್ಟಿದರೆ ಮುನಿಯೆಂಬ ಒಂದು ಗಿಡ<br><b>व्युत्पत्तिः - </b>कृतोऽञ्जलिरिव पत्रसङ्कोचोऽस्य<br><br>कृताञ्जलि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಭಕ್ತಿವಿನಯಗಳಿಂದ ಮನಸ್ಕರಿಸಲು ಕೈಜೋಡಿಸಿಕೊಂಡಿರುವ<br><b>व्युत्पत्तिः - </b>कृतोऽञ्जलिर्येन<br><b>प्रयोगाः - </b>"स्वरूपमास्थाय ततो हुताशनस्त्रसन् वलत्कम्पकृताञ्जलिः"<br><b>उल्लेखाः - </b>कुमा० ९-६<br><br>

कृतात्मन्
कृतात्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶುದ್ಧವಾದ ಆತ್ಮವುಳ್ಳ<br><br>कृतात्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರಗಳಿಂದ ಪರಿಶುದ್ಧವಾದ ಹೃದಯವುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कृतः शुद्धः संस्कृतः आत्मा हृदयं यस्य<br><br>

कृतात्यय
कृतात्यय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಡಿದ ಪುಣ್ಯಗಳ ನಾಶ /ಅನುಭವಿಸಿದ ಪುಣ್ಯಫಲಗಳ ನಾಶ<br><b>व्युत्पत्तिः - </b>कृतस्यात्ययः<br><b>विस्तारः - </b>"कृतात्ययेऽनुशयवान्"<br><br>

कृतादर
कृतादर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರೀತಿ ತೋರಿಸಲ್ಪಟ್ಟ /ಪ್ರೀತಿಯಿಂದ ನೋಡಲ್ಪಟ್ಟ<br><br>कृतादर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗೌರವಿಸಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>कृतः आदरो यस्य<br><br>

कृतानति
कृतानति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಮಸ್ಕಾರ ಮಾಡಿದವನು /ಗೌರವಿಸಿದವನು<br><b>व्युत्पत्तिः - </b>कृता आनतिर्येन<br><b>प्रयोगाः - </b>"कृतानतिर्व्याहृतसान्त्ववादे जातस्पृहः पुण्यजनः स जिष्णौ"<br><b>उल्लेखाः - </b>किरा० ३-३१<br><br>कृतानति<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಮಸ್ಕರಿಸಲ್ಪಟ್ಟವನು<br><b>व्युत्पत्तिः - </b>कृता आनतिर्यस्य<br><br>

कृतानुकम्प
कृतानुकम्प<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯೆ ತೋರಿಸಿದ /ಕರುಣೆ ತೋರಿಸಿದ<br><b>व्युत्पत्तिः - </b>कृता अनुकम्पा येन<br><b>प्रयोगाः - </b>"कृतानुकम्पः त्रिदशेषु तेषु भूयोपि भूताधिपतिर्बभाषे"<br><b>उल्लेखाः - </b>कुमा० १२-५३<br><br>कृतानुकम्प<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯೆ ತೋರಿಸಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>कृता अनुकम्पा यस्य<br><br>

कृतानुकर
कृतानुकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಮಾಡಿದುದನ್ನು ಅನುಕರಿಸುವವನು /ಒಬ್ಬ ಮಾಡಿದಂತೆ ಮಾಡುವವನು<br><b>निष्पत्तिः - </b>अनु + डुकृञ् (करणे) - "टः"(३-२-२०)<br><b>व्युत्पत्तिः - </b>कृतमनुकरोति<br><br>

कृतानुकरण
कृतानुकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಮಾಡಿದಂತೆ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>अनु + डुकृञ् (करणे) - भावे "ल्युट्" (३-३-११५)<br><b>व्युत्पत्तिः - </b>कृतस्यानुकरणम्<br><br>

कृतानुकार
कृतानुकार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಮಾಡಿದಂತೆ ಮಾಡುವುದು /ಒಬ್ಬ ಮಾಡಿದುದನ್ನು ಅನುಕರಿಸುವುದು<br><b>निष्पत्तिः - </b>अनु + डुकृञ् (करणे) - "घञ्" (३-३-१८)<br><b>व्युत्पत्तिः - </b>कृतस्यानुकारः<br><br>कृतानुकार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಕರಿಸಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>कृतोऽनुकारो यस्य<br><b>प्रयोगाः - </b>"ददर्श गोपानुपधेनु पाण्डवः कृतानुकारानिव गोभिरार्जवे"<br><b>उल्लेखाः - </b>किरा० ४-१३<br><br>

कृतानुकृत
कृतानुकृत<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಮಾಡಿದಂತೆ ಮಾಡುವುದು<br><b>व्युत्पत्तिः - </b>कृतस्यानुकृतम्<br><br>

कृतानुव्याध
कृतानुव्याध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಬಂಧ ಹೊಂದಿರುವ /ಬೆರೆತಿರುವ /ಒಟ್ಟಿಗೆ ಸೇರಿರುವ<br><b>व्युत्पत्तिः - </b>कृतः अनुव्याधो येन<br><b>प्रयोगाः - </b>"मुखामोदं मदिरया कृतानुव्याधमुद्धमन्"<br><b>उल्लेखाः - </b>माघ० २-२०<br><br>

कृतान्त
कृतान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಿದ್ಧಾಂತ /ತೀರ್ಮಾನ /ನಿರ್ಣಯ<br><b>व्युत्पत्तिः - </b>कृतोऽन्तो येन<br><br>कृतान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಧಿ /ದೈವ / ಅದೃಷ್ಟ<br><b>प्रयोगाः - </b>"क्रूरस्तस्मिन्नपि न सहते सङ्गमं नौ कृतान्तः"<br><b>उल्लेखाः - </b>मेघ० २-४२<br><br>कृतान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಯಮ<br><b>व्युत्पत्तिः - </b>कृतोऽन्तो नाशो येन<br><b>प्रयोगाः - </b>"रज्वेव पुरुषं बध्वा कृतान्तः परिकर्षति"<br><b>उल्लेखाः - </b>रामा०<br><br>

कृतान्त
कृतान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಮಂಗಳ ಕಾರ್ಯ /ಪಾಪ ಕಾರ್ಯ<br><br>कृतान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶನಿಗ್ರಹ<br><b>विस्तारः - </b>"कृतान्तो यमसिद्धान्तदैवाकुशलकर्मसु" - मेदि० ।<br><br>कृतान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶನಿವಾರ<br><b>प्रयोगाः - </b>"कृतान्तकुजयोर्वारे यस्य जन्मदिनं भवेत्"<br><br>कृतान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭರಣೀ ನಕ್ಷತ್ರ<br><br>कृतान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎರಡು ಸಂಖ್ಯೆ<br><br>

कृतान्न
कृतान्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಕ್ವ ಮಾಡಿದ ಅನ್ನ ರೊಟ್ಟಿ ಲಾಡು ಹೋಳಿಗೆ ಮೊದಲಾದುದು<br><b>व्युत्पत्तिः - </b>कृतं पक्वं च तदन्नं च<br><br>

कृतापराध
कृतापराध<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಪರಾಧ ಮಾಡಿದವನು /ತಪ್ಪು ಮಾಡಿದವನು<br><b>प्रयोगाः - </b>"नार्हति कृतापराधोऽप्युत्सवदिवसेषु परिजनो बन्धुम्"<br><b>उल्लेखाः - </b>माल० ४-१६<br><br>

कृताभिषेक
कृताभिषेक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಟ್ಟಾಭಿಷಿಕ್ತನಾದ ರಾಜಕುಮಾರ<br><b>व्युत्पत्तिः - </b>कृतोऽभिषेको यस्य<br><br>कृताभिषेक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಟ್ಟಾಭಿಷೇಕ ಮಾಡಲ್ಪಟ್ಟ<br><br>कृताभिषेक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸ್ನಾನ ಮಾಡಿದ<br><b>व्युत्पत्तिः - </b>कृतोऽभिषेको येन<br><b>प्रयोगाः - </b>"कृताभिषेकैर्दिव्यानां त्रिस्रोतसि च सप्तभिः" । "कृताभिषेकां हुतजातवेदसं त्वगुत्तरसङ्गवतीमधीतिनाम्" ।<br><b>उल्लेखाः - </b>रघु० १०-६३, कुमा० ५-१६<br><br>

कृताभिषेका
कृताभिषेका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಟ್ಟಾಭಿಷೇಕ ಮಾಡಲ್ಪಟ್ಟ<br><b>विस्तारः - </b>"कृताभिषेका महिषी" - अम० ।<br><br>

कृताभ्यनुज्ञ
कृताभ्यनुज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಮತಿ ಕೊಡಲ್ಪಟ್ಟ /ಅಪ್ಪಣೆ ಕೊಡಲ್ಪಟ್ಟ<br><b>प्रयोगाः - </b>"भ्रूसञ्ज्ञायानेन कृताभ्यनुज्ञः सुरेश्वरं तं जगदीश्वरेण"<br><b>उल्लेखाः - </b>कुमा० १२-७<br><br>कृताभ्यनुज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅನುಮತಿ ಕೊಟ್ಟವನು<br><b>व्युत्पत्तिः - </b>कृता अभ्यनुज्ञा येन<br><br>

कृताभ्यास
कृताभ्यास<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಭ್ಯಾಸ ಮಾಡಿದ /ಪಳಗಿದ /ಶಿಕ್ಷಣಪಡೆದ<br><b>व्युत्पत्तिः - </b>कृतोऽभ्यासो येन<br><br>

कृतारु
कृतारु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಮಾಲಯದ ಎತ್ತರಪ್ರದೇಶದಲ್ಲಿ ವಾಸಮಾಡುವ ಸುಂದರವಾದ ಕೊಂಬುಗಳುಳ್ಳ ಎತ್ತಿನ ಆಕಾರದ ಬಾಲವಿಲ್ಲದ ಒಂದು ಜಾತಿಯ ಜಿಂಕೆ<br><b>विस्तारः - </b>"कुचारुश्चारुपुच्छः स्यात् सुविषाणो वृषाकृतिः । कृतारुस्तु स निष्पुच्छो जायते हिमवत्तटे ॥" - वैज० ।<br><br>

कृतार्थ
कृतार्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯವನ್ನು ಮಾಡಿದವನು /ಕರ್ತವ್ಯವನ್ನು ನೆರವೇರಿಸಿದವನು /ಮಾದಬೇಕಾದುದನ್ನು ಮಾಡಿ ಪೂರೈಸಿದವನು<br><b>व्युत्पत्तिः - </b>कृतोऽर्थे येन<br><b>प्रयोगाः - </b>"प्रत्यागतं त्वास्मि कृतार्थमेव स्तनोपपीडं परिरब्धुकामा"<br><b>उल्लेखाः - </b>किरा० ३-५४<br><br>कृतार्थ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಫಲವಾದ /ಫಲ ಹೊಂದಿದ<br><b>प्रयोगाः - </b>"विलोकनेनैव तवामुना मुने कृतः कृतार्थोऽस्मि निबर्हितांहसा"<br><b>उल्लेखाः - </b>माघ० १-२९<br><br>

कृतार्थता
कृतार्थता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಫಲನಾಗಿರುವಿಕೆ /ಕೈಗೂಡುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कृतार्थस्य भावः<br><b>प्रयोगाः - </b>"विशदोच्छ्वसितेन मेदिनी कथयामास कृतार्थतामिव" । "निरीक्ष्य मेने शरदः कृतार्थता" ।<br><b>उल्लेखाः - </b>रघु० ८-३, किरा० ४-३<br><br>

कृतार्थन
कृतार्थन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಯಾಚನೆ ಮಾಡಿದವನು /ಬೇಡಿದವನು<br><b>व्युत्पत्तिः - </b>कृता अर्थना येन<br><b>प्रयोगाः - </b>"कृतार्थनश्चाटुभिरिङ्गितैः पुरा परासि यः किञ्चनकुञ्चितभ्रुवा"<br><b>उल्लेखाः - </b>नैष० १३-८८<br><br>

कृतार्थनीय
कृतार्थनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಫಲನನ್ನಾಗಿ ಮಾಡಬೇಕಾದ /ಪ್ರಯೋಜನವುಳ್ಳವನನ್ನಾಗಿ ಮಾದಬೇಕಾದ<br><b>निष्पत्तिः - </b>कृतार्थ + तत्करोति "णिच्" - "अनीयर्" (३-१-९६)<br><b>प्रयोगाः - </b>"त्रपामपाकृत्य मनाक्कुरु स्फुटं कृतार्थनीयः कतमः सुरोत्तमः"<br><b>उल्लेखाः - </b>नैष० ९-५१<br><br>

कृतार्थयत्
कृतार्थयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಫಲನನ್ನಾಗಿ ಮಾಡುತ್ತಿರುವ /ಪ್ರಯೋಜನ ಹೊಂದಿದವನನ್ನಾಗಿ ಮಾಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कृतार्थ + तत्करोति "णिच्" - "शतृ" (३-२-१२४)<br><b>प्रयोगाः - </b>"कृतार्थयन्नर्थिजनाननारतं बभूव तस्यामरभूरुहः करः" ।<br><b>उल्लेखाः - </b>नैष० १५-६८<br><br>

कृतार्थयन्ती
कृतार्थयन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಫಲಳನ್ನಾಗಿ ಮಾಡುತ್ತಿರುವ /ಪ್ರಯೋಜನ ಹೊಂದಿದವಳನ್ನಾಗಿ ಮಾಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्"(४-१-६)<br><b>प्रयोगाः - </b>"इयं शिवाया नियतेरिवायतिः कृतार्थयन्ती जगतः फलैः क्रियाः"<br><b>उल्लेखाः - </b>किरा० ४-२१<br><br>

कृतार्थीकरण
कृतार्थीकरण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಫಲನನ್ನಾಗಿ ಮಾಡುವುದು<br><b>निष्पत्तिः - </b>कृतार्थ + डुकृञ् (करणे) - "च्विः" (५-४-५०) । दीर्घः (७-४-२६) । भावे "ल्युट्" (३-३-११५)<br><br>

कृतार्थीकृत
कृतार्थीकृत<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಫಲನನ್ನಾಗಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कृतार्थ + डुकृञ् (करणे) - "च्विः" (५-४-५०) । दीर्घः (७-४-२६) । कर्म० "क्तः" (३-२-१०२)<br><br>

कृतालय
कृतालय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನೆ ಮಾಡಿಕೊಂಡಿರುವ /ವಸತಿಯನ್ನು ಕಲ್ಪಿಸಿಕೊಂಡಿರುವ<br><b>व्युत्पत्तिः - </b>कृतः आलयो येन<br><br>

कृतावदान
कृतावदान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಸಿದ್ಧಿಕಾರ್ಯಗಳನ್ನು ಮಾಡಿರುವ /ಕೀರ್ತಿಬರುವ ಕೆಲಸಗಳನ್ನು ಮಾಡಿರುವ<br><b>व्युत्पत्तिः - </b>कृतमवदानं येन<br><br>कृतावदान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡಿದವನು<br><b>प्रयोगाः - </b>"न तथा कृतवेदिनां करिष्यन् प्रियतामेति यथा कृतावदानः"<br><b>उल्लेखाः - </b>किरा० १३-३२<br><br>

कृतावधान
कृतावधान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಚ್ಚರಿಕೆ ತೆಗೆದುಕೊಂಡಿರುವ /ಜಾಗರೂಕನಾಗಿರುವ<br><b>व्युत्पत्तिः - </b>कृतमवधानं येन<br><br>कृतावधान<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏಕಾಗ್ರಚಿತ್ತನಾದ /ಒಂದೇ ವಿಷಯದಲ್ಲಿ ನೆಟ್ಟ ಮನಸ್ಸುಳ್ಳ<br><b>प्रयोगाः - </b>"कृतावधानं जितबर्हिणध्वनौ सुरक्तगोपीजनगीतनिःस्वने"<br><b>उल्लेखाः - </b>किरा० ४-३३<br><br>

कृतावधि
कृतावधि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಧಿ ನಿಶ್ಚಯಿಸಲ್ಪಟ್ಟ /ವಾಯಿದೆ ಕೊಡಲ್ಪಟ್ಟ /ಗಡು ನಿಗದಿ ಮಾಡಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>कृतः अवधिर्यस्य<br><b>प्रयोगाः - </b>"अभियोग इमान् महीभुजो भवता तस्य कृतः कृतावधेः"<br><b>उल्लेखाः - </b>किरा० २-४६<br><br>कृतावधि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲೆ ನಿಗದಿ ಮಾಡಲ್ಪಟ್ಟ<br><br>

कृतावसक्थिक
कृतावसक्थिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾಲುಮಡಿಸಿಕೊಂಡು ಬೆನ್ನು ಮತ್ತು ಮಂಡಿಗಳ ಸುತ್ತಲೂ ಬಟ್ಟೆಯನ್ನು ಕಟ್ಟಿ ಕುಳಿತುಕೊಂಡಿರುವವನು<br><b>व्युत्पत्तिः - </b>कृता अवसक्थिका येन<br><b>विस्तारः - </b>"कृतावसक्थिकः कृतपृष्ठजानुजङ्घाबन्धः" ।<br><br>

कृतास्त्र
कृतास्त्र<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬಾಣಗಳಸಂಧಾನ ಮತ್ತು ಪ್ರಯೋಗಗಳನ್ನು ಅಭ್ಯಾಸ ಮಾಡಿದವನು /ಬಾಣಪ್ರಯೋಗವನ್ನು ಚೆನ್ನಾಗಿ ಕಲಿತವನು<br><b>व्युत्पत्तिः - </b>कृतः शिक्षितमस्त्रं येन<br><b>प्रयोगाः - </b>"कृतस्त्रास्त्रविदां श्रेष्ठाः परस्परजयैषिणः"<br><b>उल्लेखाः - </b>रामा०<br><b>विस्तारः - </b>"कृतहस्तः सुहस्तश्च कृतास्त्रः कृतपुङ्खकः" - वैज० ।<br><br>

कृताहार
कृताहार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಆಹಾರವನ್ನು ತೆಗೆದುಕೊಂಡ /ಊಟಮಾಡಿದ<br><b>व्युत्पत्तिः - </b>कृतः आहारो येन<br><b>प्रयोगाः - </b>"देवादेशादेष वैशम्पायनः स्नातः कृताहारश्च देवपादमूलं प्रतीहार्यानीतः"<br><b>उल्लेखाः - </b>कादं०<br><br>

कृति
कृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯ /ಕೆಲಸ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) -"क्तिन्" (३-३-९४)<br><b>प्रयोगाः - </b>"जगतां कारकः कृष्णः कृतिर्मुररिपोरियम्"<br><br>कृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೃಷ್ಟಿ /ನಿರ್ಮಾಣ<br><b>प्रयोगाः - </b>"कृतिः स्मरस्यैव न धातुरेषा नास्या हि शिल्पीतरकारुजेयः"<br><b>उल्लेखाः - </b>नैष० १०-१३१<br><br>कृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕವಿರಚಿತವಾದ ಕಾವ್ಯ /ಪ್ರಬಂಧ<br><b>प्रयोगाः - </b>"भाससौमिल्लकविपुत्रादीनां प्रबन्धानतिक्रम्य वर्तमानकवेः कालिदासस्य कृतौ कथं बहुमानः" ?<br><b>उल्लेखाः - </b>माल० १<br><br>कृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಪ್ಪತ್ತನೆಯ ಛಂದಸ್ಸು<br><b>प्रयोगाः - </b>"धृतिश्चाधृतिश्चैव कृतिः प्रकृतिराकृतिः"<br><b>उल्लेखाः - </b>वृ० र०<br><br>कृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಪ್ಪತ್ತು ಸಂಖ್ಯೆ<br><br>कृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಸೆ<br><b>निष्पत्तिः - </b>कृञ् (हिंसायाम्) - "क्तिन्" (३-३-९४)<br><b>विस्तारः - </b>"कृतिः करणहिंसयोः" -मेदि० ।<br><br>कृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಟಕದಲ್ಲಿ ನಿರ್ವಹಣಸಂಧಿಯ ಒಂದು ಅಂಗ<br><b>प्रयोगाः - </b>"लब्धार्थशमनं कृतिः"<br><b>उल्लेखाः - </b>सा० द० ६-१११<br><br>कृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ಪರಮಾತ್ಮ<br><b>प्रयोगाः - </b>"अनुत्तमो दुराधर्षः कृतज्ञः कृतिरात्मवान्"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"यस्मात्प्रसन्नात्सुकृतं तेषां स कृतिरुच्यते" - निरुक्तिः ।<br><br>कृति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ದೊರೆ<br><b>प्रयोगाः - </b>"सप्ताश्वमेधानाहृत्य राजसूयं च पार्थिवः कृतिर्नामच्यवत्स्वर्गादसत्यवचनात्सकृत्"<br><b>उल्लेखाः - </b>मार्क०<br><br>

कृतिकर
कृतिकर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಪ್ಪತ್ತು ಕೈಗಳುಳ್ಳ ರಾವಣ<br><b>व्युत्पत्तिः - </b>कृतिसङ्ख्याः कराः यस्य<br><br>कृतिकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸ ಮಾಡುವವನು<br><b>व्युत्पत्तिः - </b>कृतेः करः<br><br>

कृतिन्
कृतिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯ ಮಾಡಿದವನು /ಕೆಲಸವನ್ನು ನಡೆಸಿದವನು<br><b>निष्पत्तिः - </b>कृत - "इनिः" (५-२-८८)<br><b>व्युत्पत्तिः - </b>कृतमनेन<br><b>प्रयोगाः - </b>"किमु चोदिताः प्रियहितार्थकृतः कृतिनो भवन्ति सुहृदः सुहृदाम्"<br><b>उल्लेखाः - </b>माघ०९-५७<br><br>कृतिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪುಣ್ಯಶಾಲಿ /ಅದೃಷ್ಟವಂತ<br><b>प्रयोगाः - </b>"करौ व्याधुन्वत्याः पिबति रतिसर्वस्वमधरं वयं तत्त्वान्वेषान्मधुकर हतास्त्वं खलु कृती" । "कृतिनः कार्तयुगेन कर्मणा ते" ।<br><b>उल्लेखाः - </b>शाकु० १-२१, याद० १५-६५<br><br>कृतिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಶಲ /ಬುದ್ಧಿವಂತ /ಜಾಣ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कृतं कर्म प्रशस्तमस्य<br><b>प्रयोगाः - </b>"क्षययुक्तिमुपक्षते कृती कुरुते तत्प्रतिकारमन्यथा"<br><b>उल्लेखाः - </b>किरा० २-९<br><br>कृतिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪಂಡಿತ /ಜ್ಞಾನಿ /ತಿಳುವಳಿಕೆಯುಳ್ಳವನು<br><br>कृतिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮರ್ಥ<br><b>प्रयोगाः - </b>"आत्मना कृतिना च त्वमात्मन्येव प्रलीयसे"<br><b>उल्लेखाः - </b>कुमा० २-१०<br><br>

कृती|छेदने|कृन्तति 
कृती- छेदने (तुदा० पर० सक० से०) कृन्तति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸು /ತುಂಡು ಮಾಡು<br><br>

कृती|वेष्टने|कृणत्ति 
कृती- वेष्टने (रुधा० पर० सक० से०) कृणत्ति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಆವರಿಸು /ಸುತ್ತುಗಟ್ಟು<br><br>

कृते
कृते<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ನಿಮಿತ್ತಾರ್ಥಕವಾದ ಒಂದು ಅವ್ಯಯ /ಅದಕ್ಕಾಗಿ /ಅದಕ್ಕೋಸ್ಕರ<br><b>प्रयोगाः - </b>"कृते कानिष्ठिनेयस्य ज्यैष्ठिनेयं विवासितम्"<br><b>उल्लेखाः - </b>भट्टि० ५-८४<br><br>

कृत्त
कृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸಲ್ಪಟ್ಟ /ತುಂಡುಮಾಡಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कृती (छेदने) - "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"कृत्तैः कीर्णा मही रेजे दन्तैर्गात्रैश्च दन्तिनाम्"<br><b>उल्लेखाः - </b>माघ० १९-८१<br><br>कृत्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುತ್ತುವರಿಯಲ್ಪಟ್ಟ /ಬಳಸಲ್ಪಟ್ಟ<br><b>विस्तारः - </b>"कृतं छिन्ने वेष्टिते च" - हेम० ।<br><br>

कृत्तवत्
कृत्तवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸಿದವನು /ತುಂಡುಮಾಡಿದವನು<br><b>निष्पत्तिः - </b>कृती (छेदने) - "क्तवतुः" (३-२-१०२)<br><br>कृत्तवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸುತ್ತುಗಟ್ಟಿದವನು<br><b>निष्पत्तिः - </b>कृती (वेष्टने) - "क्तः" (३-२-१०२)<br><br>

कृत्ति
कृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಂಕೆ ಹುಲಿ ಮೊದಲಾದುವುಗಳ ಚರ್ಮ<br><b>निष्पत्तिः - </b>कृती (छेदने) - "क्तिन्" (३-३-९४)<br><b>व्युत्पत्तिः - </b>कृत्यते<br><br>कृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚರ್ಮ /ತೊಗಲು<br><b>प्रयोगाः - </b>"क्षणं क्षणोत्क्षिप्तगजेन्द्रकृत्तिना स्फुटोपमं भूतिसितेन शम्भुना"<br><b>उल्लेखाः - </b>माघ० १-४<br><br>कृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭುಜಪತ್ರೆ ಗಿಡ<br><br>कृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತ್ತಿಕಾ ನಕ್ಷತ್ರ<br><br>कृत्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮನೆ /ವಾಸಸ್ಥಳ<br><b>विस्तारः - </b>"कृत्तिश्चर्मत्वचोर्भूर्जे कृत्तिकायां द्वयं स्त्रियाम्" - मेदि० ।<br><br>

कृतिका
कृतिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರನನ್ನು ಮದುವೆಯಾದ ದಕ್ಷಸುತೆಯರಾದ ಅಶ್ವಿನೀ ಮೊದಲಾದ ೨೭ ನಕ್ಷತ್ರಗಳಲ್ಲಿ ೩ನೆಯದು<br><b>प्रयोगाः - </b>"प्राप्याकृतिं कामपि षड्भिरेत्य निषेव्यमाणः खलु कृत्तिकाभिः"<br><b>उल्लेखाः - </b>कुमा० ११-२<br><br>

कृत्तिवास
कृत्तिवास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾದೇವ /ಗಜಚರ್ಮವನ್ನು ಧರಿಸಿದ ಪರಮೇಶ್ವರ<br><b>निष्पत्तिः - </b>वस (आच्छादने) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कृत्तिं गजचर्मं वस्ते<br><br>

कृत्तिवासस्
कृत्तिवासस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗಜಚರ್ಮವೇ ವಸ್ತ್ರವಾಗಿ ಉಳ್ಳ ಪರಮೇಶ್ವರ /ಪರಶಿವ<br><b>व्युत्पत्तिः - </b>कृत्तिः वासो यस्य<br><b>प्रयोगाः - </b>"एकैश्वर्ये स्थितोऽपि प्रणतबहुफले यः स्वयं कृत्तिवासाः कान्तासम्मिश्रदेहोऽप्यविषयमनसां यः परस्ताद्यतीनाम्"<br><b>उल्लेखाः - </b>माल० १-१<br><br>

कृत्तिवासेश्वर
कृत्तिवासेश्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶಿಯಲ್ಲಿರುವ ಒಂದು ಶಿವಲಿಂಗ<br><br>

कृत्नु
कृत्नु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿಲ್ಪಿ /ಚಿತ್ರಕಾರ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "क्स्नुः" (उ० ३-३०)<br><br>कृत्नु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷ /ಸಮರ್ಥ<br><br>कृत्नु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಾಣ /ಕುಶಲ<br><br>

कृत्य
कृत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯ /ಕೆಲಸ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "क्यप्"(३-१-११०)<br><br>कृत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣದಲ್ಲಿ तव्य अनीयर् क्यप् ण्यत् ಮೊದಲಾದ ಪ್ರತ್ಯಯಗಳು<br><br>कृत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕರ್ತವ್ಯ /ಅವಶ್ಯವಾಗಿ ಮಾಡಬೇಕಾದ ಕಾರ್ಯ /ವೇದವಿಹಿತವಾದ ಕರ್ಮಾಚರಣೆ<br><br>कृत्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕುಪಿತನಾದ /ಕೋಪಗೊಂಡ<br><b>विस्तारः - </b>"कृत्या क्रियादेवतयोः कार्ये क्ली कुपिते त्रिषु" - वैज० ।<br><br>

कृत्यज्ञ
कृत्यज्ञ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅವಶ್ಯವಾಗಿ ಮಾಡಬೇಕಾದುದನ್ನು ತಿಳಿದಿರುವ /ಕರ್ತವ್ಯವನ್ನು ಅರಿತಿರುವ<br><b>निष्पत्तिः - </b>ज्ञा (अवबोधने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कृत्यं जानाति<br><br>

कृत्यवत्
कृत्यवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯವುಳ್ಳವಳು /ಅವಶ್ಯವಾದ ಕಾರ್ಯವನ್ನು ಹೊಂದಿರುವವನು<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४) । मस्य वः (८-२-९)<br><br>

कृत्यवती
कृत्यवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯವುಳ್ಳವನು /ಅವಶ್ಯವಾದ ಕಾರ್ಯವನ್ನು ಹೊಂದಿರುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कृत्यवर्त्मन्
कृत्यवर्त्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯವಿಧಾನ ಮಾರ್ಗ /ಕಾರ್ಯವನ್ನು ಸಾಧಿಸುವ ಉಪಾಯ /ಕಾರ್ಯವನ್ನು ನಡೆಸುವ ರೀತಿ<br><b>व्युत्पत्तिः - </b>कृत्यस्य वर्त्म<br><b>प्रयोगाः - </b>"स तु तत्र विशेषदुर्लभः सदुपन्यस्यति कृत्यवर्त्म यः"<br><b>उल्लेखाः - </b>किरा० २-३<br><br>

कृत्यवस्तु
कृत्यवस्तु<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಶ್ಯವಾಗಿ ಮಾಡಬೇಕಾದ ಕೆಲಸ<br><b>व्युत्पत्तिः - </b>कृत्यस्य वस्तु<br><b>प्रयोगाः - </b>"शासनेऽपि गुरुणि व्यवस्थितं कृत्यवस्तुषु नियुङ्क्ष्व कामतः"<br><b>उल्लेखाः - </b>माघ० १४-१५<br><br>

कृत्यविद्
कृत्यविद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಲಸವನ್ನು ಬಲ್ಲವನು /ಕಾರ್ಯದ ವಿಧಾನವನ್ನು ಅರಿತಿರುವವನು<br><b>निष्पत्तिः - </b>विद (ज्ञाने) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>कृत्यं वेत्ति<br><b>प्रयोगाः - </b>"कृत्वा कृत्यविदस्तीर्थेष्वन्तः प्रणिधयः पदम्"<br><b>उल्लेखाः - </b>माघ० २-१११<br><br>

कृत्या
कृत्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾರ್ಯ /ಕೆಲಸ<br><br>कृत्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಭಿಚಾರಿಕ ದೇವತೆ /ಶೂನ್ಯದೇವತೆ /ಮಾಟದ ಗೊಂಬೆ<br><b>विस्तारः - </b>"कृत्या क्रियादेवतयोः" - वैज० ।<br><br>

कृत्याकृत्य
कृत्याकृत्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಡಬೇಕಾದ ಮತ್ತು ಮಾಡಬಾರದ ಕೆಲಸ<br><b>व्युत्पत्तिः - </b>कृत्यं च अकृत्यं च अनयोः समाहारः<br><br>

कृत्रिम
कृत्रिम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೧೨ ವಿಧ ಪುತ್ರರಲ್ಲೊಬ್ಬ<br><b>प्रयोगाः - </b>"सदृशं तु प्रकुर्याद्यं गुणदोषविचक्षणम् । पुत्रं पुत्रगुणैर्युक्तं स विज्ञेयश्च कृत्रिमः ॥"<br><b>उल्लेखाः - </b>मनु० ९-१६९<br><br>कृत्रिम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಡ್ಲವಣ<br><br>कृत्रिम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಚಲವಣ<br><br>कृत्रिम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರಸಾಂಜನ<br><br>कृत्रिम<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಾರ್ಯದಿಂದ ಉಂಟಾದ /ಉಪಾಧಿಯಿಂದ ಹುಟ್ಟಿದ /ಅಸ್ವಾಭಾವಿಕವಾದ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "क्त्रिः" (३-३-८८)<br><b>व्युत्पत्तिः - </b>कृत्या निवृत्तम्<br><b>प्रयोगाः - </b>"सखा गरीयान् शत्रुश्च कृत्रिमस्तौ हि कार्यतः"<br><b>उल्लेखाः - </b>माघ० २-३६<br><br>

कृत्रिमपुत्र
कृत्रिमपुत्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೧೨ ವಿಧ ಪುತ್ರರಲ್ಲಿ ನಾಲ್ಕನೆಯವನು<br><b>व्युत्पत्तिः - </b>कृत्रिमश्चासौ पुत्रश्च<br><br>

कृत्रिमपुत्रक
कृत्रिमपुत्रक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುತ್ಥಳಿಕೆ /ಬಟ್ಟೆಯಿಂದ ಮಾಡಿದ ಬೊಂಬೆ<br><b>निष्पत्तिः - </b>स्वार्थे "कः"<br><b>प्रयोगाः - </b>"मन्दाकिनीसैकतवेदिकाभिः सा कन्दुकैः कृत्रिमपुत्रकैश्च"<br><b>उल्लेखाः - </b>कुमा० १-२९<br><br>

कृत्वा
कृत्वा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಮಾಡಿ /ನಿರ್ಮಿಸಿ /ರಚಿಸಿ<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "क्त्वा" (३-४-२१)<br><b>प्रयोगाः - </b>"कृत्वा दृशौ ते बहुवर्णचित्रे किं कृष्णसारस्य तयोर्मृगस्य"<br><b>उल्लेखाः - </b>नैष० ८-३८<br><br>कृत्वा<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸಿ /ಪೀಡಿಸಿ /ತೊಂದರೆ ಪಡಿಸಿ<br><b>निष्पत्तिः - </b>कृञ् (हिंसायाम्) - "क्त्वा" (३-४-२१)<br><br>

कृत्स्न
कृत्स्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><br>कृत्स्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದರ /ಹೊಟ್ಟೆ<br><b>निष्पत्तिः - </b>कृती (छेदने) - "क्स्नः" (उ० ३-१७)<br><br>कृत्स्न<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಲ್ಲಾ /ಸಮಸ್ತ /ಸಕಲ /ಸಂಪೂರ್ಣ<br><b>प्रयोगाः - </b>"कृत्स्नापि सा तव रुचा विजितश्रि यस्याः"<br><b>उल्लेखाः - </b>नैष० ११-८६<br><br>

कृत्स्नविद्
कृत्स्नविद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸರ್ವಜ್ಞ /ಸಕಲವನ್ನೂ ತಿಳಿದವನು /ಎಲ್ಲವನ್ನೂ ಬಲ್ಲವನು<br><b>निष्पत्तिः - </b>विद (ज्ञाने) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>कृत्स्नं वेत्ति<br><b>प्रयोगाः - </b>"तानकृत्स्नविदो मन्दान् कृत्स्नविन्न विचालयेत्"<br><b>उल्लेखाः - </b>गीता० ३-२९<br><br>

कृदन्त
कृदन्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧಾತುವಿಗೆ ಪ್ರತ್ಯಯಗಳನ್ನು ಸೇರಿಸುವುದರಿಂದ ನಿಷ್ಪನ್ನವಾದ ಶಬ್ದ<br><b>व्युत्पत्तिः - </b>कृत् अन्ते यस्य<br><br>

कृदर
कृदर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಣಜ /ಧಾನ್ಯವನ್ನು ಕೂಡಿಡುವ ಜಾಗ /ಉಗ್ರಾಣ<br><br>कृदर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹ /ಮನೆ<br><b>निष्पत्तिः - </b>कृ +दॄ (विदारणे) - "अरः" (उ० ५-४१)<br><br>

कृन्तत्र
कृन्तत्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಾಂಗಲ /ನೇಗಿಲು<br><b>निष्पत्तिः - </b>कृती (छेदने) - "क्त्रः" (३-१०९)<br><br>

कृन्तन
कृन्तन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವುದು /ತುಂಡುಮಾಡುವುದು<br><b>निष्पत्तिः - </b>कृती (छेदने) - "ल्युट्" (३-३-११५) । मुम् बाहु० ।<br><b>प्रयोगाः - </b>"कृन्तनं नखकेशानां छेदनं च वनस्पतेः । शावाशौचे न कर्तव्यं पठनं पाठनं तथा ॥"<br><b>उल्लेखाः - </b>नारदः<br><br>कृन्तन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವವನು<br><b>निष्पत्तिः - </b>कृती - कर्त० "ल्युः" (३-१-१३४)<br><br>कृन्तन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕತ್ತರಿಸುವ ಸಾಧನ<br><b>निष्पत्तिः - </b>कृती- कर० "ल्युट्" (३-३-११७)<br><br>

कृन्तनी
कृन्तनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कृन्तन ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><br>

कृप
कृप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಪಾಚಾರ್ಯ /ಅಶ್ವತ್ಥಾಮನ ಸೋದರಮಾವ /ಗೌತಮವಂಶದ ಶಾರದ್ವತ ಋಷಿಯ ಮಗ<br><b>प्रयोगाः - </b>"अश्वत्थामा बलिर्व्यासो हनूमांश्च विभीषणः । कृपः परशुरामश्च सप्तैते चिरजीविनः ॥"<br><br>

कृपण
कृपण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಮಿ /ಹುಳು<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) - "क्युन्" बाहु० ।<br><br>कृपण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೋಭಿ /ಜಿಪುಣ<br><b>प्रयोगाः - </b>"कृपणेन समो दाता न कश्चित् भुवि जायते । अनश्यन्नेव वित्तानि यः परेभ्यः प्रयच्छति ॥"<br><br>कृपण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿವೇಕಶೂನ್ಯ /ಮನೋಬಲವಿಲ್ಲದವನು<br><b>प्रयोगाः - </b>"कामार्ता हि प्रकृतिकृपणाश्चेतनाचेतनेषु"<br><b>उल्लेखाः - </b>मेघ० १-५<br><br>कृपण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದರಿದ್ರ /ಬಡವ<br><b>प्रयोगाः - </b>"ततः स पुरुषव्याघ्रस्तद्धनं सहलक्ष्मणः । द्विजेभ्यो बालवृद्धेभ्यः कृपणेभ्यो ह्यदापयत् ॥"<br><b>उल्लेखाः - </b>रामा०<br><br>कृपण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೀನ /ದೊಡ್ಡ ಕಷ್ತದಲ್ಲಿ ಸಿಕ್ಕಿರುವವನು /ದುಃಖವನ್ನು ಅನುಭವಿಸುತ್ತಿರುವವನು<br><b>प्रयोगाः - </b>"राजन्नपत्यं रामस्ते पाल्याश्च कृपणा जनाः"<br><b>उल्लेखाः - </b>उ० रा० ४-२५<br><br>कृपण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀಚ /ಕೆಟ್ಟವನು<br><b>प्रयोगाः - </b>"किन्त्वङ्गीकृतमुत्सृजन् कृपणवत् श्लाघ्यो जनो लज्जते निर्वाहः प्रतिपन्नवस्तुषु सतामेतद्धि गोत्रव्रतम्"<br><b>उल्लेखाः - </b>मुद्रा० २-१८<br><br>कृपण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಯನೀಯ /ದಯೆ ತೋರಿಸಲು ಯೋಗ್ಯನಾದ<br><b>प्रयोगाः - </b>"कृपाश्रये यः कृपणे पतत्रिणि"<br><b>उल्लेखाः - </b>नैष० १-१३२<br><br>कृपण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಶುವಿನಂತೆ ಇತರರ ಸೇವೆ ಮಾಡುವವನು /ಆತ್ಮಸ್ವರೂಪವನ್ನು ತಿಳಿಯದೆ ಇತರರಿಗಾಗಿಯೇ ಜೀವಿಸಿರುವವನು<br><b>प्रयोगाः - </b>"एतदक्षरं गार्ग्य विदित्वाऽस्माल्लोकात् प्रैति, सकृपणः"<br><b>उल्लेखाः - </b>बृहदा०<br><br>

कृपणत्व
कृपणत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲೋಭಿತನ /ಕಾರ್ಪಣ್ಯ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कृपणस्य भावः<br><br>कृपणत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದಾರಿದ್ರ್ಯ /ಬಡತನ<br><br>कृपणत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನೀಚತನ<br><br>कृपणत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಜ್ಞಾನಿಯಾಗಿರುವಿಕೆ /ತಿಳಿಗೇಡಿತನ<br><br>

कृपणिन्
कृपणिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೋಭಿಗಳುಳ್ಳ ದೇಶ /ಜಿಪುಣರಿಂದ ಕೂಡಿದ ದೇಶ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-१३१)<br><b>व्युत्पत्तिः - </b>कृपणाः सन्त्यत्र देशे<br><br>

कृपा
कृपा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಯೆ /ಕನಿಕರ /ಕಷ್ಟವನ್ನು ಪರಿಹರಿಸಿ ಹಿತವನ್ನು ಮಾಡುವ ಬುದ್ಧಿ /ಮರುಕ<br><b>निष्पत्तिः - </b>कृपू (सामार्थ्ये) - "अङ्" (३-३-१०४)<br><b>प्रयोगाः - </b>"कृपा नृपाणामुपरि क्वचिन्न ते नतेन हा हा शिरसा रसादृशाम्"<br><b>उल्लेखाः - </b>नैष० १२-४३<br><br>कृपा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅನುಗ್ರಹಿಸುವ ಇಚ್ಛೆ<br><b>प्रयोगाः - </b>"ततःफलत्वेन हरेः कृपेयमिमं तपस्येव जनं नियुङ्क्ते"<br><b>उल्लेखाः - </b>नैष० ६-९३<br><br>

कृपाकर
कृपाकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯೆ ತೋರಿಸುವ /ಕನಿಕರ ಪಡುವ<br><b>व्युत्पत्तिः - </b>कृपायाः करः<br><br>

कृपामय
कृपामय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯೆಯಿಂದ ತುಂಬಿದ /ಕನಿಕರದಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>"मयट्" (५-४-२१)<br><b>व्युत्पत्तिः - </b>कृपायाः प्रचुरः<br><br>

कृपामयी
कृपामयी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಯೆಯಿಂದ ತುಂಬಿದ /ಕನಿಕರದಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-१५)<br><b>प्रयोगाः - </b>"अथान्यमुद्दिश्य नृपं कृपामयी मुखेन तद्दिङ्मुखसम्मुखेन सा"<br><b>उल्लेखाः - </b>नैष० १२-५२<br><br>

कृपाण
कृपाण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಖಡ್ಗ /ದೊಡ್ಡ ಕತ್ತಿ<br><b>प्रयोगाः - </b>"दैवाद्यदा प्रवितरन्ति न ते तदैव नेदङ्कृपा निजकृपाणकरग्रहाय"<br><b>उल्लेखाः - </b>नैष० ११-१२६<br><br>

कृपाणी
कृपाणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಕು /ಸಣ್ಣ ಕತ್ತಿ<br><br>कृपाणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿ<br><b>विस्तारः - </b>"कृपाणः खड्गे छुरिकाकर्तर्योरपि योषिति" - मेदि० ।<br><br>

कृपाणक
कृपाणक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿ<br><b>निष्पत्तिः - </b>स्वार्थे "कः"<br><br>

कृपाणिका
कृपाणिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्"<br><b>प्रयोगाः - </b>"कृपाणिकाभिः कुकुराः कम्पिताभिरकम्पयन्"<br><b>उल्लेखाः - </b>याद० २२-१३४<br><br>

कृपालु
कृपालु<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದಯಾಶೀಲ /ಕನಿಕರವುಳ್ಳವನು<br><b>निष्पत्तिः - </b>ला (आदाने) - "डुः" (वा० ३-२-१८०)<br><b>व्युत्पत्तिः - </b>कृपां लाति<br><br>

कृपी
कृपी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಾರದ್ವತ ಋಷಿಯ ಮಗಳು /ದ್ರೋಣಾಚಾರ್ಯರ ಹೆಂದತಿ /ಅಶ್ವತ್ಥಾಮನ ತಾಯಿ<br><br>

कृपीट
कृपीट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉದರ /ಹೊಟ್ಟೆ<br><br>कृपीट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) -"कीटन्" (उ० ४-१६४)<br><b>विस्तारः - </b>"कृपीटं कुक्षिवारिणोः" - सि० कौ० । "कृपीटं चोदरे जले" - हेम० ।<br><br>कृपीट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌದೆ<br><br>कृपीट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರಣ್ಯ /ಕಾಡು<br><br>

कृपीटपाल
कृपीटपाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಮುದ್ರ /ಕಡಲು<br><b>निष्पत्तिः - </b>पाल (रक्षणे) - "आण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कृपीटं पालयति<br><br>कृपीटपाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೋಣಿ ನಡೆಸುವ ಹುಟ್ಟುಗೋಲು<br><b>विस्तारः - </b>"कृपीटपाल उद्दिष्टः केनिपातसमुद्रयोः"- मेदि० ।<br><br>कृपीटपाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯು /ಗಾಳಿ<br><br>

कृपीटयोनि
कृपीटयोनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>व्युत्पत्तिः - </b>कृपीटस्य जलस्य योनिः<br><b>प्रयोगाः - </b>"किञ्चित् कृपीटयोनिं तं दिवस्पतिरभाषत" ।<br><b>उल्लेखाः - </b>कुमा० १०-१६<br><b>विस्तारः - </b>"आकाशादग्निः । अग्नेरापः" - श्रुतिः ।<br><br>

कृपू|सामर्थ्ये|कल्पते
कृपू - सामर्थ्ये (भ्वा० आत्म० अक० से०) कल्पते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕಲ್ಪಿಸು /ಏರ್ಪಡಿಸು /ಸಿದ್ಧಪಡಿಸು<br><b>प्रयोगाः - </b>"कल्पिष्यसे हरेः प्रीतिर्लङ्कां चोपहनिष्यते"<br><b>उल्लेखाः - </b>भट्टि० १६-१२<br><br>

अनु + कृपू|अनुकृपू|अनुकल्पः
अनु + कृपू = अनुकल्पः<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಮುಖ್ಯವಾದುದಕ್ಕಿಂತಲೂ ಹೀನವಾದ ನಿಯಮ /ಗೌಣವಿಧಿ<br><br>

अव + कृपू|अवकृपू|अवकल्पः
अव + कृपू = अवकल्पः ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅವಧಾರಣ /ನಿಶ್ಚಯ<br><br>

आ + कृपू|आकृपू|आकल्पः
आ + कृपू = आकल्पः ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಲಂಕಾರ /ಭೂಷಣ<br><b>प्रयोगाः - </b>"अवधिं दर्शनीयानामाकल्पमनघं दिवः"<br><b>उल्लेखाः - </b>याद० १६-१८<br><br>

उप + कृपू|उपकृपू|उपकल्पनम्
उप + कृपू = उपकल्पनम् ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಿದ್ಧಪಡಿಸುವುದು<br><br>

प्र + कृपू|प्रकृपू|प्रकल्पनम्
प्र + कृपू =प्रकल्पनम् ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಿದ್ಧಪಡಿಸುವುದು<br><br>प्र + कृपू =प्रकल्पनम् ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಉಂಟು ಮಾಡುವುದು<br><br>

वि + कृपू|विकृपू|विकल्पः
वि + कृपू = विकल्पः ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸಂಶಯಪಡು /ಸಂದೇಹಿಸು<br><b>प्रयोगाः - </b>"रात्रिन्दिवविभागेषु यदादिष्टं महीक्षिताम् । तत्सिषेवे नियोगेन स विकल्पपराङ्मुखः ॥"<br><b>उल्लेखाः - </b>रघु० १७-४९<br><br>वि + कृपू = विकल्पः ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಬದಲಾವಣೆ ಮಾಡು /ಪಕ್ಷಾಂತರವನ್ನು ಅಂಗೀಕಾರ ಮಾಡು /ಎರಡರಲ್ಲಿ ಯಾವುದಾದರೊಂದನ್ನು ಮಾಡು<br><b>प्रयोगाः - </b>"तस्य दण्डविकल्पः स्यात् यथेष्टं नृपतेस्तथा"<br><b>उल्लेखाः - </b>मनु० ९-२२८<br><br>

सम् + कृपू|सङ्कृपू|सङ्कल्पः
सम् + कृपू = सङ्कल्पः ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಮನೋವ್ಯಾಪಾರ /ಹೀಗೆ ಮಾಡುವೆನೆಂಬ ನಿರ್ಣಯರೂಪವಾದ ಮನಸ್ಸಿನ ವ್ಯಾಪಾರ<br><b>प्रयोगाः - </b>"सङ्कल्पितं प्रथममेव मया तवार्थे भर्तारमात्मसदृशं सुकृतिर्गता त्वम्"<br><b>उल्लेखाः - </b>शाकु० ४-१२<br><br>

कृमि
कृमि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹುಳು /ಜಂತು<br><b>निष्पत्तिः - </b>क्रमु (पादविक्षेपे) - "इत्" (उ० ४-१२१)<br><b>व्युत्पत्तिः - </b>क्रामति<br><b>प्रयोगाः - </b>"कृमिकीटपतङ्गाश्च यूकामक्षिकमत्कुणम्"<br><b>उल्लेखाः - </b>मनु० १-४०<br><br>कृमि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರಗು<br><br>कृमि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ದಭ /ಕತ್ತೆ<br><br>कृमि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹುಳುಗಳಿಂದ ಕೂಡಿದ<br><b>विस्तारः - </b>"कृमिर्ना क्रिमिवत् कीटे लाक्षायां कृमिले खरे" - मेदि० ।<br><br>

कृमिक
कृमिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಹುಳು<br><b>निष्पत्तिः - </b>"कन्" (५-३-८५)<br><b>व्युत्पत्तिः - </b>अल्पः कृमिः<br><b>प्रयोगाः - </b>"रुदन्तं विगतज्ञानं कृमयः कृमिकं यथा"<br><b>उल्लेखाः - </b>भाग० ३-३१-२७<br><br>कृमिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಡಕೆ<br><br>

कृमिकण्टक
कृमिकण्टक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಮಿಗಳನ್ನು ನಾಶಮಾಡುವ ವಾಯುವಿಳಂಗ<br><br>कृमिकण्टक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಮಿಗಳನ್ನು ನಾಶಮಾಡುವ ಇಲಿಯಾಲದ ಗಿಡ<br><br>कृमिकण्टक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಮಿಗಳನ್ನು ನಾಶಮಾಡುವ ಉದುಂಬರ ವೃಕ್ಷ /ಅತ್ತಿಮರ<br><br>

कृमिकर्णक
कृमिकर्णक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ಕಿವಿಯ ರೋಗ<br><b>निष्पत्तिः - </b>वा कप्<br><b>व्युत्पत्तिः - </b>कृमियुक्तः कर्णो यस्य<br><br>

कृमिकोशोत्थ
कृमिकोशोत्थ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರೇಷ್ಮೆಯ ವಸ್ತ್ರ /ಮಗುಟ<br><b>व्युत्पत्तिः - </b>कृमिकोशादुत्थम्<br><br>

कृमिग्रन्थि
कृमिग्रन्थि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಧಿರೋಗಗಳಲ್ಲೊಂದು /ಕಣ್ಣಿನ ರೆಪ್ಪೆ ಮತ್ತು ಕೂದಲುಗಳ ಮಧ್ಯೆ ಬರುವ ಒಂದು ರೋಗ<br><b>प्रयोगाः - </b>"कृमिग्रन्थिर्वर्त्मनः पक्ष्मणश्च कण्डूं कुर्युः कृमयः सन्धिजाताः । नानारूपा वर्त्मशुक्लस्य सन्धौ चरन्तोऽन्तर्नयनं दूषयन्ति"<br><b>उल्लेखाः - </b>सुश्रुत० उत्तर० २-९<br><br>

कृमिघ्न
कृमिघ्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯುವಿಳಂಗ<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) - "कः" (३-२-५३)<br><b>व्युत्पत्तिः - </b>कृमिं हन्ति<br><br>कृमिघ्न<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೇರುಮರ<br><br>

कृमिघ्ना
कृमिघ्ना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅರಿಶಿನ<br><br>

कृमिघ्नी
कृमिघ्नी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯುವಿಳಂಗ<br><br>

कृमिज
कृमिज<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗುರುಚಂದನ<br><br>कृमिज<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಮಿಯಿಂದ ಹುಟ್ಟಿದ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>कृमेर्जातः<br><br>

कृमिण
कृमिण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಮಿಗಳಿಂದ ಕೂಡಿದ /ಹುಳುಗಳು ಸೇರಿಕೊಂಡಿರುವ<br><b>निष्पत्तिः - </b>"नः" (३-२-१००)<br><b>व्युत्पत्तिः - </b>कृमयोऽस्त्यस्य<br><br>

कृमिदन्तक
कृमिदन्तक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ದಂತರೋಗ<br><b>प्रयोगाः - </b>"कृष्णच्छिद्री चलः स्रावी ससंरम्भो महारुजः । अनिमित्तरुजो वाताद्विजेयः कृमिदन्तकः ॥"<br><b>उल्लेखाः - </b>सुश्रुत० निदान० १६-२९<br><br>

कृमिपर्वत
कृमिपर्वत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಲ್ಮೀಕ /ಹುತ್ತ<br><b>व्युत्पत्तिः - </b>कृमीणां पर्वत इव<br><br>

कृमिपुरीषक
कृमिपुरीषक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುರೀಷದ ಮೇಲೆ ಓಡಾಡುವ ಒಂದು ವಿಧ ನೀಲಿನೊಣ<br><br>

कृमिफल
कृमिफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅತ್ತಿಮರ<br><b>व्युत्पत्तिः - </b>कृमयः फलेऽस्य<br><br>कृमिफल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅತ್ತಿಹಣ್ಣು<br><br>

कृमिभक्ष
कृमिभक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನರಕ<br><b>निष्पत्तिः - </b>भक्ष (अदने) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>कृमिभिर्भक्ष्यतेत्र<br><br>कृमिभक्ष<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಮಿಗಳನ್ನು ತಿನ್ನುವ<br><b>निष्पत्तिः - </b>भक्ष + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कृमीन् भक्षयति<br><br>

कृमिभोजन
कृमिभोजन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಮಿಯಾಗಿ ಹುಟ್ಟಿ ಕೃಮಿಗಳಿಂದಲೇ ತಿನ್ನಲ್ಪಟ್ಟು ಯಾತನೆ ಅನುಭವಿಸುವ ಒಂದು ನರಕ<br><b>निष्पत्तिः - </b>भुज (पालनाभ्यवहारयोः) - "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>कृमिभिर्भुज्यतेऽत्र<br><b>प्रयोगाः - </b>"यस्त्विहासंविभज्याश्नाति यत्किञ्चनोपनतमनिर्मितपञ्चयज्ञो वायससस्तुतः स परत्र कृमिभोजने नरकाधमे निपतति तत्र शतसहस्रयोजने कृमिकुण्डे कृमिभूतः स्वयं कृमिभिरेव भक्ष्यमाणः कृमिभोजनो यावत्तदप्रत्ताप्रहुतादोऽनिर्वेशमात्मानं यातयते"<br><b>उल्लेखाः - </b>भाग० ५-२६-१८<br><br>कृमिभोजन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಮಿಗಳನ್ನು ತಿನ್ನುವ /ಕೃಮಿಗಳೇ ಆಹಾರವಾಗಿ ಉಳ್ಳ<br><br>

कृमिमत्
कृमिमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಮಿಗಳಿಂದ ಕೂಡಿದ /ಹುಳುಗಳು ಸೇರಿಕೊಂಡಿರುವ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४) । मस्य वः (८-२-९)<br><b>व्युत्पत्तिः - </b>कृमयोऽत्र सन्ति<br><br>

कृमिमती
कृमिमती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಮಿಗಳಿಂದ ಕೂಡಿದ /ಹುಳುಗಳು ಸೇರಿಕೊಂಡಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कृमिरिपु
कृमिरिपु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯುವಿಳಂಗ<br><b>व्युत्पत्तिः - </b>कृमीणां रिपुः<br><br>

कृमिशैल
कृमिशैल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಲ್ಮೀಕ /ಹುತ್ತ<br><b>व्युत्पत्तिः - </b>कृमीणां शैल इव<br><br>

कृमीलक
कृमीलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಹೆಸರು<br><b>निष्पत्तिः - </b>ईर (गतौ) - "ण्वुल्" (३-१-१३३) । रस्य लः ।<br><b>व्युत्पत्तिः - </b>कृमीन् ईरयति<br><br>

कृवि
कृवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಗ್ಗದವನು ನೇಯ್ಗೆಗಾಗಿ ಉಪಯೋಗಿಸುವ ಒಂದು ವಸ್ತು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "क्विन्" (उ० ४-५६)<br><b>विस्तारः - </b>"कृविस्तन्तुवायद्रव्यम्" - सि० कौ० ।<br><br>

कृवी
कृवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತರಿ<br><b>विस्तारः - </b>"कर्त्रिका कर्तनी कृवी" - वैज० ।<br><br>

कृश|तनूकरणे|कृश्यति
कृश - तनूकरणे (दिवा० अपर० अक० से०) कृश्यति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕೃಶವಾಗು /ತೆಳ್ಳನಾಗು /ಸಣ್ಣದಾಗು<br><br>

कृश
कृश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು /ಪರಮಾತ್ಮ<br><b>निष्पत्तिः - </b>कृश (तनूकरणे) - "क्तः" (८-२-५५) । तलोपः इडभावश्च निपात्यते ।<br><b>प्रयोगाः - </b>"अणुर्बुहत् कृशः स्थूलः गुणभृन्निर्गुणो महान्"<br><b>उल्लेखाः - </b>वि० स०<br><b>विस्तारः - </b>"सर्वत्राव्याहतगतिः लघिम्ना कृश ईरितः" - निरुक्तिः ।<br><br>कृश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಉಷ್ಣ /ಬಿಸಿ /ಕಾವು<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>कृश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇತುಗ್ರಹ<br><b>विस्तारः - </b>"केतवो विकचाः कृशाः" - वैज० ।<br><br>कृश<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತೆಳ್ಳಗಿರುವಿಕೆ /ಸಣ್ಣಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>कृश भावे - "क्तः" (३-३-११४)<br><br>कृश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಣ್ಣದಾದ /ತೆಳುವಾದ<br><b>प्रयोगाः - </b>"कृशमपि कृशतां पुनर्नयन्ती विपुलतरोन्मुखलोचनावलग्नम्"<br><b>उल्लेखाः - </b>माघ० ७-३३<br><br>कृश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕದಾದ /ಪುಟ್ಟ<br><br>कृश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲ್ಪ<br><b>प्रयोगाः - </b>"वनानि दहतो वह्नेः नखा भवति मारुतः । त एव दीपनाशाय कृशे कस्यास्ति गौरवम् ॥"<br><br>कृश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ದುರ್ಬಲ /ಬಲಹೀನ<br><b>प्रयोगाः - </b>"क्षत्रियं चैव सर्पं च ब्राह्मणं वा बहुश्रुतम् । नावमन्येत वै भूष्णुः कृशानपि कदाचन ॥"<br><b>उल्लेखाः - </b>मनु० ४-१३५<br><br>कृश<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಷ್ಣವಾದ /ಬಿಸಿಯಾದ<br><b>विस्तारः - </b>"उष्णं ज्वलः करः क्रूरो बालस्तिग्मः कृशश्चुपः" - वैज० ।<br><br>

कृशता
कृशता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೆಳ್ಳಗಿರುವಿಕೆ /ಸಣ್ಣಗಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कृशस्य भावः<br><br>कृशता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕದಾಗಿರುವುದು /ಸಣ್ಣದಾಗಿರುವುದು<br><br>कृशता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಲ್ಪವಾಗಿರುವುದು<br><br>कृशता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಡಕಲಾಗಿರುವುದು /ಬಲಹೀನವಾಗಿರುವುದು<br><b>प्रयोगाः - </b>"कृशमपि कृशतां पुनर्नयन्ती"<br><b>उल्लेखाः - </b>माघ० ७-३३<br><br>

कृशत्व
कृशत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>कृशता ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

कृशधन
कृशधन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲ್ಪಧನವುಳ್ಳವನು /ಕೊಂಚ ಹಣವುಳ್ಳವನು /ದರಿದ್ರ /ಬಡವ<br><b>व्युत्पत्तिः - </b>कृशं धनं यस्य<br><br>

कृशबुद्धि
कृशबुद्धि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಲ್ಪಬುದ್ಧಿಯುಳ್ಳವನು<br><b>व्युत्पत्तिः - </b>कृशा बुद्धिर्यस्य<br><br>

कृशर
कृशर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಳ್ಳು ಅಕ್ಕಿ ಬೆರೆಸಿ ಪಕ್ವ ಮಾಡಿದ ಅನ್ನ<br><b>प्रयोगाः - </b>"गुडौदनं रवेर्दद्यात् सोमाय घृतपायसम् । संयावकं कुजे दद्यात् क्षीरान्नं सोमसूनवे । दध्योदनञ्च जीवस्य शुक्राय तु धृतौदनम् । शनैश्चराय कृशरमाजमांसं च राहवे । चित्रौदनञ्च केतुभ्यः सर्वभक्ष्यैः समर्चयेत् ॥"<br><br>

कृशला
कृशला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲು<br><b>निष्पत्तिः - </b>ला (आदाने) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>कृशं कार्श्यं लाति<br><br>

कृशाङ्ग
कृशाङ्ग<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಳುವಾದ ಮೈಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कृशमङ्गं यस्य<br><br>

कृशाङ्गी
कृशाङ्गी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೆಳುವಾದ ಮೈಯುಳ್ಳ ಹೆಂಗಸು<br><b>प्रयोगाः - </b>"उत्थस्थुरभ्युत्थितिवाञ्छयेव निजासनान्नैकरसाः कृशाङ्ग्यः"<br><b>उल्लेखाः - </b>नैष० ८-७<br><br>

कृशानु
कृशानु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>निष्पत्तिः - </b>कृश (तनूकरणे) - "आनुक्" (उ० ४-२)<br><b>व्युत्पत्तिः - </b>कृश्यति<br><b>प्रयोगाः - </b>"ऋचे कृशानोर्न हि मन्त्रपूरमर्हन्ति तेजांस्यपराणि हव्यम्"<br><b>उल्लेखाः - </b>कुमा० १-५१<br><br>कृशानु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿದೇವತೆ<br><b>प्रयोगाः - </b>"आखण्डलो दण्डधरः कृशानुः पाशीति नाथैः ककुभां चतुर्भिः"<br><b>उल्लेखाः - </b>नैष० १०-१०<br><br>कृशानु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರಮೂಲದ ಗಿಡ<br><br>कृशानु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹರಳು ಗಿಡ<br><br>कृशानु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿದೇವತಾಕವಾದ ಕೃತ್ತಿಕಾನಕ್ಷತ್ರ<br><br>कृशानु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೩ ಸಂಖ್ಯೆ<br><br>

कृशानुरेतस्
कृशानुरेतस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಶಿವ<br><b>व्युत्पत्तिः - </b>कृशानौ रेतो यस्य<br><br>कृशानुरेतस्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿಯ ತೇಜಸ್ಸು<br><br>

कृशात्व
कृशात्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ದೊರೆ<br><br>कृशात्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೆಳುವಾದ ಕುದುರೆ<br><b>व्युत्पत्तिः - </b>कृशोऽश्वः<br><br>कृशात्व<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ನಾಟ್ಯಾಚಾರ್ಯ<br><br>कृशात्व<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಳುವಾದ ಕುದುರೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कृशोऽश्वो यस्य<br><br>

कृशाश्विन्
कृशाश्विन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಟರು /ನಾಟ್ಯಾಚಾರ್ಯರಾದ ಕೃಷಾಶ್ವ ಮುನಿಯ ನಟಸೂತ್ರವನ್ನು ಅಧ್ಯಯನ ಮಾಡುವವರು<br><b>निष्पत्तिः - </b>"इनिः" (४-३-१११)<br><b>व्युत्पत्तिः - </b>कृशाश्वेन प्रोक्तं नटसूत्रमधीयते<br><b>विस्तारः - </b>"कृशाश्विनो नटाः" - सि० कौ० ।<br><br>

कृशिका
कृशिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಇಲಿಕಿವಿಯ ಗಿಡ<br><br>

कृशोदर
कृशोदर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೆಳುವಾದ ಹೊಟ್ಟೆಯುಳ್ಳ<br><b>निष्पत्तिः - </b>वा "ङीष्" (४-१-५५)<br><b>व्युत्पत्तिः - </b>कृशमुदरं यस्याः<br><br>

कृशोदरी
कृशोदरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೆಳುವಾದ ಹೊಟ್ಟೆಯುಳ್ಳ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>पक्षे<br><b>प्रयोगाः - </b>"सहामुना तत्र पयःपयोनिधौ कृशोदरि क्रीड यथामनोरथम्"<br><b>उल्लेखाः - </b>नैष० ९-५९<br><br>

कृशोदरा
कृशोदरा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತೆಳುವಾದ ಹೊಟ್ಟೆಯುಳ್ಳ ಹೆಂಗಸು<br><br>

कृश्यत्
कृश्यत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಣ್ಣಗಾಗುತ್ತಿರುವ /ತೆಳುವಾಗುತ್ತಿರುವ<br><br>कृश्यत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಕ್ಕದಾಗುತ್ತಿರುವ /ಪುಟ್ಟದಾಗುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कृश (तनूकरणे) - "शतृ" (३-२-१२४)<br><br>

कृश्यन्ती
कृश्यन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कृश्यत् ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कृष|विलेखने|कर्षति
कृष - विलेखने (भ्वा० पर० सक० अनि०) कर्षति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸೆಳೆ /ಎಳೆ<br><br>

अनु + कृष|अनुकृष|अनुकर्षति
अनु + कृष = अनुकर्षति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹಿಂದಿನಿಂದ ಎಳೆದುಕೊ /ಎಳೆದು ಮುಂದಕ್ಕೆ ಸಂಬಂಧಪಡಿಸು<br><b>विस्तारः - </b>ಒಂದು ವಾಕ್ಯದ ಅರ್ಥ ಹೇಳುವಾಗ ಅದಕ್ಕೆ ಬೇಕಾದ ಪದಗಳನ್ನು ಹಿಂದಿನ ವಾಕ್ಯದಿಂದ ತೆಗೆದುಕೊಳ್ಳುವುದು ಅಂದರೆ ಪ್ರಕೃತ ವಾಕ್ಯಾರ್ಥಕ್ಕೆ ಸಂಬಂಧಿಸಿದಂತೆ ಎಳೆದುಕೊಳ್ಳುವುದು ಅನುಕರ್ಷವು.<br><br>

अप + कृष|अपकृष|अपकर्षति
अप + कृष = अपकर्षति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕಡಮೆ ದರ್ಜೆಯದಾಗಿ ಮಾಡು ಗುಣತಗ್ಗಿಸು /ಹೀನವಾಗಿ ಮಾಡು /ಕೀಳಾಗಿ ಮಾಡು<br><br>अप + कृष = अपकर्षति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ವ್ಯಾಕರಣ ಶಾಸ್ತ್ರದಲ್ಲಿ ಮುಂದಿನ ಸೂತ್ರದಿಂದ ಹಿಂದಿನ ಸೂತ್ರದ ವಾಕ್ಯಾರ್ಥಕ್ಕೆ ಬೇಕಾಗುವ ಪದಗಳನ್ನು ಸೇರಿಸಿಕೊಳ್ಳುವುದು<br><br>

अप + आ + कृष|अपाकृष|अपाकर्षणम्
अप + आ + कृष = अपाकर्षणम् ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹಿಂತಿರುಗಿಸು /ಹಿಂದಕ್ಕೆ ಕಳುಹಿಸು<br><b>प्रयोगाः - </b>"तमशक्यमपाक्रष्टुं निदेशात् स्वर्गिणः पितुः"<br><b>उल्लेखाः - </b>रघु० १२-१७<br><br>

अभि +कृष|अभिकृष|अभिकर्षति
अभि +कृष = अभिकर्षति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಎದುರಾಗಿ ಎಳೆದುಕೋ<br><br>

अव + कृष|अवकृष|अवकर्षति
अव + कृष = अवकर्षति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಮೇಲಿನಿಂದ ಕೆಳಕ್ಕೆ ಎಳೆದುಕೋ<br><br>

आ + कृष|आकृष|आकृषति
आ + कृष = आकृषति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಎಳೆದುಕೋ<br><br>

उद् + कृष|उत्कृष|उत्कर्षः
उद् + कृष = उत्कर्षः ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹಿರಿಮೆಯುಂಟುಮಾಡು /ಮೇಲ್ಮೆ ಕೊಡು<br><br>उद् + कृष = उत्कर्षः ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎಳೆದುಕೋ<br><br>

निस् + कर्ष|निष्कर्ष|निष्कृष्टम्
निस् + कर्ष = निष्कृष्टम् ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಯ<br><br>निस् + कर्ष = निष्कृष्टम् ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಎಳೆದುಕೊ<br><b>प्रयोगाः - </b>"गामात्तसारां रघुरप्यवेक्ष्य निष्क्रष्टुमर्थं चकमे कुबेरात्"<br><b>उल्लेखाः - </b>रघु० ५-२६<br><br>

प्र + कृष|प्रकृष|प्रकर्षति
प्र + कृष = प्रकर्षति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೆಚ್ಚಿಸು /ಅಧಿಕಪಡಿಸು<br><br>प्र + कृष = प्रकर्षति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಎಳೆ /ಹೆಚ್ಚಾಗಿ ಎಳೆ<br><br>

सम् + कृष|सङ्कृष|सङ्कर्षति
सम् + कृष = सङ्कर्षति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಚೆನ್ನಾಗಿ ಎಳೆ /ಹೆಚ್ಚಾಗಿ ಎಳೆ<br><br>

सम् + आ + कृष|समाकृष|समाकर्षति
सम् + आ + कृष = समाकर्षति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಬಹಳ ದೂರದವರೆಗೂ ಚೆನ್ನಾಗಿ ಎಳೆ<br><br>

कृष|विलेखने|कृषति
कृष - विलेखने (तुदा० उभ० सक० अनि०) कृषति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಆಕರ್ಷಿಸು /ಎಳೆ /ಸೆಳೆ<br><br>कृष - विलेखने (तुदा० उभ० सक० अनि०) कृषति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಉಳು /ನೇಗಿಲು ಹೊಡೆ<br><br>

कृषक
कृषक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೃಷಭ /ಎತ್ತು<br><b>निष्पत्तिः - </b>कृष (विलेखने) - "क्वुन्" (उ० २-३९)<br><br>कृषक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೇಗಿಲಗುಳ<br><br>कृषक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೈತ /ಬೇಸಾಯಗಾರ<br><br>कृषक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆಯುವವನು<br><b>विस्तारः - </b>"कृषकः पुंसि फाले स्यात् कर्षके त्वभिधेयवत्" - मेदि० ।<br><br>

कृषाण
कृषाण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೈತ /ಬೇಸಾಯಗಾರ<br><b>निष्पत्तिः - </b>कृष (विलेखने) - "आनक्" बाहु० ।<br><b>प्रयोगाः - </b>"गोपाः सीमाकृषणाश्च सर्वे च वनगोचराः"<br><b>उल्लेखाः - </b>याज्ञ० २-१५०<br><br>

कृषि
कृषि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಸಾಯ /ವ್ಯವಸಾಯ /ಭೂಮಿಯನ್ನು ಉಳುವುದು /ಸಾಗುವಳಿ /ಪೈರು ಬೆಳೆಯಲು ಉಳುಮೆ<br><b>निष्पत्तिः - </b>कृष (विलेखने) - "इक्" (वा० ३-३-१०८)<br><b>प्रयोगाः - </b>"अन्नं तु धान्यसम्भूतं धान्यं कृष्या विना न च । तस्मात् सर्वं परित्यज्य कृषिं यत्नेन कारयेत् ॥"<br><b>उल्लेखाः - </b>कृषिपराशरः<br><br>

कृषिक
कृषिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೇಗಿಲಗುಳ<br><b>निष्पत्तिः - </b>कृष (विलेखने) - "किकन्" (उ० २-४१)<br><br>कृषिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೈತ /ಬೇಸಾಯಗಾರ<br><b>विस्तारः - </b>"कुटुम्बी कर्षकः क्षेत्री हली कृषिककार्षकौ" - अभि० चि० ।<br><br>

कृषिकर्मन्
कृषिकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬೇಸಾಯ /ಉಳುಮೆ /ಬೆಳೆಗಾಗಿ ಮಾಡುವ ವ್ಯವಸಾಯ<br><br>

कृषिजीविन्
कृषिजीविन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವ್ಯವಸಾಯದಿಂದ ಜೀವಿಸುವವನು<br><b>निष्पत्तिः - </b>जीव (प्राणधारणे) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>कृष्या जीवति<br><br>

कृषिपराशर
कृषिपराशर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯವಸಾಯದ ವಿಷಯವನ್ನು ಹೇಳುವ ಒಂದು ಗ್ರಂಥ<br><br>

कृषिफल
कृषिफल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಸ್ಯ /ಪೈರು /ಬೆಳೆ<br><b>व्युत्पत्तिः - </b>कृषेः फलम्<br><b>प्रयोगाः - </b>"त्वय्यायत्तं कृषिफलमिति भ्रूविलासानभिज्ञैः"<br><b>उल्लेखाः - </b>मेघ० १-१६<br><br>

कृषीवल
कृषीवल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೈತ /ಬೇಸಾಯಗಾರ<br><b>निष्पत्तिः - </b>"वलच्" (५-२-११२) । दीर्घः (६-३-११८)<br><b>व्युत्पत्तिः - </b>कृषिरस्यास्ति<br><b>प्रयोगाः - </b>"सुखेन लभ्या दधतः कृषीवलैरकृष्टपच्या इव सस्यसम्पदः"<br><b>उल्लेखाः - </b>किरा० १-१७<br><br>

कृष्ट
कृष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಳೆಯುವಿಕೆ<br><br>कृष्ट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಉಳುಮೆ<br><b>निष्पत्तिः - </b>कृष (विलेखने) - भावे "क्तः" (३-३-११४)<br><br>कृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कृष (विलेखने) - कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"नाभीमथैष श्लथवाससोऽनु मिमील दिक्षु क्रमकृष्टचक्षुः"<br><b>उल्लेखाः - </b>नैष० ६-२०<br><br>कृष्ट<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಳಲ್ಪಟ್ಟ ಭೂಮಿ<br><b>प्रयोगाः - </b>"भग्नोन्नतानन्तरपूरितान्तरा बभुर्भुवः कृष्टसमीकृता इव"<br><b>उल्लेखाः - </b>माघ० १२-२१<br><br>

कृष्टपच्य
कृष्टपच्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತಭೂಮಿಯಲ್ಲಿ ಬೆಳೆದು ತಾನಾಗಿಯೇ ಹಣ್ಣಾಗುವ ಧಾನ್ಯ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "क्यप्" (३-१-११४)<br><b>व्युत्पत्तिः - </b>कष्टेन स्वयमेव पच्यते<br><b>प्रयोगाः - </b>"सुखेन लभ्या दधतः कृषीवलैरकृष्टपच्या इव सस्यसम्पदः"<br><b>उल्लेखाः - </b>किरा० १-१७<br><br>

कृष्टि
कृष्टि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಂಡಿತ<br><b>निष्पत्तिः - </b>कृष (विलेखने) - कर्म० "क्तिच्" (३-३-१७४)<br><br>कृष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಕರ್ಷಣ /ಎಳೆಯುವುದು<br><b>निष्पत्तिः - </b>कृष (विलेखने) - भावे "क्तिन्" (३-३-९४)<br><br>कृष्टि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಳುಮೆ /ಬೇಸಾಯ<br><b>विस्तारः - </b>"अथ कृष्टिः स्यादाकर्षे स्त्री बुधे पुमान्" - मेदि० । कृष्टिः कर्षे बुधे पुमान्" - त्रिकाण्ड० ।<br><br>

कृष्टोप्त
कृष्टोप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತು ಬಿತ್ತಲ್ಪಟ್ಟ /ಉತ್ತಿರುವ ಭೂಮಿಯಲ್ಲಿ ಬಿತ್ತನೆ ಮಾಡಲ್ಪಟ್ಟ<br><b>व्युत्पत्तिः - </b>कृष्टे उप्तः<br><br>

कृष्ण
कृष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾವಿಷ್ಣುವಿನ ೧೦ ಅವತಾರಗಳಲ್ಲಿ ಒಂಬತ್ತನೆಯ ಅವತಾರ /ವೈಕುಂಠದಲ್ಲಿ ದ್ವಾರಪಾಲಕರಾಗಿದ್ದ ಜಯವಿಜಯರು ಸನಕಾದಿಮುನಿಗಳ ಶಾಪಕ್ಕೆ ಗುರಿಯಾಗಿ ಭೂಮಿಯಲ್ಲಿ ಮೂರನೆಯ ಜನ್ಮದಲ್ಲಿ ಶಿಶುಪಾಲ ದಂತವಕ್ತ್ರರಾಗಿ ಹುಟ್ಟಿದಾಗ ಅವರ ಸಂಹಾರಕ್ಕಾಗಿ ಅವತರಿಸಿದ ಮಹಾವಿಷ್ಣು /ದೇವಕಿ ವಸುದೇವರ ೮ ನೆಯ ಮಗ<br><b>निष्पत्तिः - </b>कृष (विलेखने) - "नक्" णत्वं च बाहु० ।<br><b>व्युत्पत्तिः - </b>कर्षत्यरीन्<br><b>प्रयोगाः - </b>"कृषिर्भूवाचकः शब्दो णश्च निर्वृतिवाचकः । कृषन्स्तद्भावयोगाच्च कृष्णो भवति सात्त्वतः ॥" "अग्राह्यः शाश्वतः कृष्णः" ।<br><b>उल्लेखाः - </b>भा० उद्योग० ७०, वि० स०<br><b>विस्तारः - </b>"एकान्तलीलारसतो निर्वृतः कृष्ण उच्यते" - निरुक्तिः ।<br><br>कृष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅರ್ಜುನ<br><b>प्रयोगाः - </b>"कृष्ण इत्येव दशमं नाम चक्रे पिता मम । कृष्णावदातस्य सतः प्रियत्वात् बालकस्य वै ॥"<br><b>उल्लेखाः - </b>भा० विरा० ४०-२२<br><br>कृष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾದೇವ<br><b>प्रयोगाः - </b>"दीर्घश्च हरिकेशश्च सुतीर्थः कृष्ण एव च"<br><b>उल्लेखाः - </b>भा०<br><br>कृष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಸಮಹರ್ಷಿ<br><b>प्रयोगाः - </b>"यो व्यस्य वेदान् चतुरो भगवांस्तपसा ऋषिः । लोके व्यासत्वमापेदे कृष्णत्वमेव च ॥"<br><b>उल्लेखाः - </b>भा० आदि० १०५<br><br>कृष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><br>कृष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಲಿಯುಗ<br><br>कृष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ<br><br>कृष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪುಬಣ್ಣ<br><br>कृष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರಮರ್ದಕ ವೃಕ್ಷ /ಕಮರಿಕೆ ಗಿಡ<br><br>कृष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಪಕ್ಷ /ತಿಂಗಳಿನ ಎರಡನೆಯ ಅರ್ಧಭಾಗ<br><b>प्रयोगाः - </b>"चन्द्रवृद्धिकरः शुक्लः कृष्णश्चन्द्रक्षयात्मकः"<br><b>उल्लेखाः - </b>तिथित०<br><br>कृष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಪಕ್ಷದ ದೇವತೆ<br><b>प्रयोगाः - </b>"धूमो रात्रिस्तथा कृष्णः षण्मासा दक्षिणायनम्"<br><b>उल्लेखाः - </b>गीता० ८-२५<br><br>कृष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೂದ್ರ<br><br>कृष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆನೆ<br><br>कृष्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><br>कृष्ण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾಪ /ದುರಿತ<br><br>कृष्ण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೆಣಸು<br><br>कृष्ण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣ /ಕೃಷ್ಣಲೋಹ<br><br>कृष्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಬಣ್ಣದ<br><br>

कृष्णा
कृष्णा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದ್ರೌಪದಿ /ಪಾಂಡವರ ಪತ್ನಿ<br><b>प्रयोगाः - </b>"कृष्णेत्येवाब्रुवन् कृष्णां कृष्णाभूत् सा हि वर्णतः । तथा तन्मिथुनं जज्ञे द्रुपदस्य महासखे ॥"<br><b>उल्लेखाः - </b>भा० आदि० १८१-५७<br><br>कृष्णा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಪ್ಪಲಿ<br><br>कृष्णा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದ್ರಾಕ್ಷಿ<br><br>कृष्णा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೀಲಿಗಿಡ<br><br>कृष्णा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿಜೀರಿಗೆ<br><br>कृष्णा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶೀವನೆಯ ಮರ<br><br>कृष्णा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಟುಕರೋಹಿಣಿ<br><br>कृष्णा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಹುಜಿಗೆ ಗಿಡ<br><b>विस्तारः - </b>"कृष्णः काके पिके वर्णे बिष्णौ व्यासेऽर्जुने कलौ । कृष्णा तु नील्यां द्रौपद्यां पिप्पलीद्राक्षयोरपि" - हेम० ।<br><br>कृष्णा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಾನದಿ<br><b>विस्तारः - </b>"व्यासार्जुनाग्निहरिकोकिलकाकशूद्रतामिस्रपक्षकरिनीलगुणेषु कृष्णः । द्रव्ये त्रिषु द्रुपदजातटिनीकणासु कृष्णाथ लोहमरिचे दुरितं च कृष्णम् " - नानार्थर० ।<br><br>कृष्णा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कृष्ण ಪದದ ದ್ರೌಪದಿ ಮೊದಲಾದ ಸ್ತ್ರೀಲಿಂಗದ ಅರ್ಥ<br><br>

कृष्णक
कृष्णक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿಎಳ್ಳು<br><b>निष्पत्तिः - </b>"कन्" (५-४-३)<br><b>व्युत्पत्तिः - </b>कृष्णप्रकारः<br><br>कृष्णक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಾಜಿನವೆಂಬ ಒಬ್ಬ ಮನುಷ್ಯ<br><b>निष्पत्तिः - </b>कृष्णाजिन - "कन्" अनिजपदलोपश्च (५-३-८२)<br><br>

कृष्णकन्द
कृष्णकन्द<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂದಾವರೆ /ರಕ್ತೋತ್ಪಲ<br><b>व्युत्पत्तिः - </b>कृ्ष्णः कन्दोऽस्य<br><br>

कृष्णकर्मन्
कृष्णकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಕೃತ್ಯ /ಕೆಟ್ಟ ಕೆಲಸ<br><b>व्युत्पत्तिः - </b>कृष्णं कर्म<br><br>कृष्णकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗಾಯವನ್ನು ಒಣಗಿಸಿ ಕಪ್ಪಾಗಿಸುವ ಕಾರ್ಯ<br><b>प्रयोगाः - </b>"दारुणासु शुक्लानां कृष्णकर्म हितं भवेत् । भल्लातकान् वासयेत्तु क्षीरे प्राङ्मूत्रभावितान् ॥"<br><b>उल्लेखाः - </b>सुश्रुत० चिकित्सा० १<br><br>कृष्णकर्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಟ್ಟ ಕೆಲಸ ಮಾಡುವ /ನಿಷಿದ್ಧವಾದ ಪಾಪ ಕಾರ್ಯ ಮಾಡುವ<br><b>व्युत्पत्तिः - </b>कृष्णं कर्म यस्य<br><br>

कृष्णकाक
कृष्णकाक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಕಾಗೆ /ಡೊಂಬ ಕಾಗೆ<br><br>

कृष्णकाय
कृष्णकाय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಿಷ /ಎಮ್ಮೆ<br><b>व्युत्पत्तिः - </b>कृष्णः कायोऽस्य<br><br>

कृष्णकाया
कृष्णकाया<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಿಷ /ಎಮ್ಮೆ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्" (४-१-४) (अत्र योपधात् न ङीष्)<br><br>

कृष्णकोहल
कृष्णकोहल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೂಜುಗಾರ /ಜೂಜಾಟದವನು<br><b>विस्तारः - </b>"द्यूतकृत् कृष्णकोहलः" - त्रिकाण्ड० ।<br><br>

कृष्णगङ्गा
कृष्णगङ्गा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಾನದಿ<br><br>

कृष्णगति
कृष्णगति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>व्युत्पत्तिः - </b>कृष्णा धूमरूपा गतिर्यस्य<br><b>प्रयोगाः - </b>"आयोधने कृष्णगतिं सहायमवाप्य यः क्षत्रियकालरात्रिम्"<br><b>उल्लेखाः - </b>रघु० ६-४२<br><br>

कृष्णगर्भ
कृष्णगर्भ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿಶೀವನೆಯ ಮರ<br><b>व्युत्पत्तिः - </b>कृष्णवर्णो गर्भोऽस्य<br><br>

कृष्णगिरि
कृष्णगिरि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಲಪರ್ವತ<br><br>कृष्णगिरि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೇಲಂ ಜಿಲ್ಲೆಯಲ್ಲಿ ಒಂದು ಗ್ರಾಮ<br><br>

कृष्णग्रीव
कृष्णग्रीव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀಲಕಂಠ /ಮಹಾದೇವ<br><b>व्युत्पत्तिः - </b>कृष्णा ग्रीवाऽस्य<br><br>कृष्णग्रीव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪ್ಪಾದ ಕುತ್ತಿಗೆಯುಳ್ಳ<br><b>व्युत्पत्तिः - </b>कृष्णा ग्रीवा यस्य<br><br>

कृष्णचञ्चु|कृष्णचञ्चुक
कृष्णचञ्चु(क)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಣಕ /ಕಡಲೆ<br><b>निष्पत्तिः - </b>वा "कप्" (५-४-१५४)<br><b>व्युत्पत्तिः - </b>कृष्णा चञ्चुरस्य<br><br>

कृष्णचतुर्दशी
कृष्णचतुर्दशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಪಕ್ಷದ ಚತುರ್ದಶಿ /ಮಾಸದ ಎರಡನೆಯ ಅರ್ಧದ ೧೪ ನೆಯ ದಿನ<br><br>

कृष्णचन्दन
कृष्णचन्दन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹರಿಚಂದನ /ಬಿಳಿಚಂದನ<br><b>व्युत्पत्तिः - </b>कृष्णप्रियं चन्दनम्<br><br>

कृष्णचन्द्र
कृष्णचन्द्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣ /ವಾಸುದೇವ<br><b>व्युत्पत्तिः - </b>कृष्णश्चन्द्र इव<br><br>

कृष्णचूर्ण
कृष्णचूर्ण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣದ ತುಕ್ಕು /ಕಬ್ಬಿಣದ ಕಿಲುಬು<br><br>कृष्णचूर्ण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅರದಿಂದ ಕಬ್ಬಿಣವನ್ನು ಉಜ್ಜಿ ಬಂದ ಪುಡಿ<br><b>व्युत्पत्तिः - </b>कृष्णं कृष्णवर्णं चूर्णम्, कृष्णलोहस्य चूर्ण वा ।<br><br>

कृष्णज
कृष्णज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣನ ಮಗ /ಪ್ರದ್ಯುಮ್ನ<br><b>निष्पत्तिः - </b>जनी (प्रादुर्भावे) - "डः" (३-२-९८)<br><b>व्युत्पत्तिः - </b>कृष्णात् जायते<br><br>

कृष्णजटा
कृष्णजटा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಟಾಮಾಂಸಿ<br><b>व्युत्पत्तिः - </b>कृष्णा जटा यस्याः<br><br>

कृष्णजन्मखण्ड
कृष्णजन्मखण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣ ಜನ್ಮವನ್ನು ವರ್ಣಿಸುವ ಬ್ರಹ್ಮವೈವರ್ತಪುರಾಣದ ಒಂದು ಭಾಗ<br><br>

कृष्णजन्माष्टमी
कृष्णजन्माष्टमी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣನು ಅವತರಿಸಿದ ಶ್ರಾವಣ ಕೃಷ್ಣಾಷ್ಟಮಿ /ಶ್ರೀಕೃಷ್ಣನು ಹುಟ್ಟಿದ ದಿವಸ /ಸಿಂಹಮಾಸದ ಕೃಷ್ಣಪಕ್ಷದ ಅಷ್ಟಮಿ<br><br>

कृष्णजीरक
कृष्णजीरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿಜೀರಿಗೆ<br><b>व्युत्पत्तिः - </b>कृष्णो जीरकः<br><br>

कृष्णता
कृष्णता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪಾಗಿರುವುದು<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><b>व्युत्पत्तिः - </b>कृष्णस्य भावः<br><br>

कृष्णत्व
कृष्णत्व<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪಾಗಿರುವುದು<br><b>निष्पत्तिः - </b>"त्वः" (५-१-११९)<br><br>

कृष्णत्वच्
कृष्णत्वच्<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಾಜಿನ /ಜಿಂಕೆಯ ಚರ್ಮ<br><b>व्युत्पत्तिः - </b>कृष्णस्य कृष्णमृगस्य त्वक्<br><b>प्रयोगाः - </b>"कण्ठप्रभासङ्गविशेषनीलां कृष्णत्वचं ग्रन्थिमतीं दधानम्"<br><b>उल्लेखाः - </b>कुमा० ३-४६<br><br>

कृष्णदेह
कृष्णदेह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಮೈ<br><br>कृष्णदेह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭ್ರಮರ /ದುಂಬಿ<br><br>कृष्णदेह<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ದೇಹವುಳ್ಳ<br><br>

कृष्णद्वादशी
कृष्णद्वादशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಪಕ್ಷದ ದ್ವಾದಶೀ ತಿಥಿ /ಕೃಷ್ಣಪಕ್ಷದ ಹನ್ನೆರಡನೆಯ ದಿನ<br><br>

कृष्णद्वैपायन
कृष्णद्वैपायन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಾಶರ ಮಹರ್ಷಿಯ ಪುತ್ರ /ವೇದವ್ಯಾಸಮಹರ್ಷಿ<br><b>निष्पत्तिः - </b>"अण्" (५-४-३८)<br><b>व्युत्पत्तिः - </b>द्वीपोऽयनं जन्मभूमिरस्य । द्विपायन एव<br><b>प्रयोगाः - </b>"तमहमरागमकृष्णं कृष्णद्वैपायनं वन्दे" । "कृष्णद्वैपायनं व्यासं विद्धि नारायणं विभुम् । कोह्यन्यः पुण्डरीकाक्षात् महाभारतकृद्भवेत् ॥"<br><b>उल्लेखाः - </b>वेणी० १-४, विष्णुपु०<br><br>

कृष्णधन
कृष्णधन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅನ್ಯಾಯದಿಂದ ಸಂಪಾದಿಸಿದ ಹಣ /ಕಳ್ಳತನ ಜೂಜು ಕಾಳಸಂತೆ ಮೊದಲಾದುವುಗಳಲ್ಲಿ ಸಂಪಾದಿಸಿದ ಹಣ<br><b>व्युत्पत्तिः - </b>कृष्णं अन्यायार्जितं धनम्<br><br>

कृष्णधान्य
कृष्णधान्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಧಾನ್ಯ /ಉದ್ದು ಎಳ್ಳು ರಾಗಿ ಮುಂತಾದುದು<br><br>

कृष्णपक्ष
कृष्णपक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರನ ಕಲೆಗಳು ಕಡಮೆಯಾಗುವ ತಿಂಗಳಿನ ಎರಡನೆ ಅರ್ಧಭಾಗ /ಕೃಷ್ಣಪ್ರತಿಪತ್ತಿನಿಂದ ಅಮಾವಾಸ್ಯೆಯವರೆಗಿನ ೧೫ ದಿನಗಳುಳ್ಳ ಪಕ್ಷ<br><b>व्युत्पत्तिः - </b>कृष्णः पक्षः<br><br>कृष्णपक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣನ ಪಕ್ಷ<br><br>

कृष्णपदी
कृष्णपदी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಕಾಲಿನ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>पादस्य लोपो "ङीप्" च (५-४-१३९)निपा० । "पादः पत्" (६-४-१३०) इति पदादेशः ।<br><b>व्युत्पत्तिः - </b>कृष्णः पादोऽस्याः<br><br>

कृष्णपर्णी
कृष्णपर्णी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣತುಲಸಿ<br><b>व्युत्पत्तिः - </b>कृष्णं पर्णमस्याः<br><br>

कृष्णपाकफल
कृष्णपाकफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರಮರ್ದವೃಕ್ಷ /ಕಮರಿಕೆ ಗಿಡ<br><b>विस्तारः - </b>"कृष्णपाकफलाविग्नसुषेणाः करमर्दके" - अम० ।<br><br>

कृष्णपुच्छ
कृष्णपुच्छ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರೋಹಿತವೆಂಬ ಕಪ್ಪು ಬಾಲದ ಒಂದು ಜಾತಿಯ ಮೀನು<br><b>व्युत्पत्तिः - </b>कृष्णः पुच्छोऽस्य<br><br>

कृष्णफल
कृष्णफल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಮರಿಕೆ ಗಿಡ<br><b>व्युत्पत्तिः - </b>कृष्णं फलमस्य<br><br>

कृष्णभक्त
कृष्णभक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣನನ್ನು ಪೂಜಿಸುವವನು /ಕೃಷ್ಣೋಪಾಸಕ<br><br>

कृष्णभूम
कृष्णभूम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಮಣ್ಣಿನ ಪ್ರದೇಶ<br><b>निष्पत्तिः - </b>"अच्" (वा० ५-४-७५)<br><b>व्युत्पत्तिः - </b>कृष्णा भूमिर्यस्य<br><b>विस्तारः - </b>"पाण्डूदक्कृष्णतो भूमः पाण्डूदक् कृष्णमृत्तिके" - अभि० चि० ।<br><br>

कृष्णभेदी
कृष्णभेदी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಟುಕರೋಹಿಣಿ<br><br>

कृष्णमुख
कृष्णमुख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಮುಖದ ಒಂದು ಜಾತಿಯ ಕಪಿ<br><br>कृष्णमुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಮುಖವುಳ್ಳ<br><br>कृष्णमुख<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ತುದಿಯುಳ್ಳ /ತುದಿಯಲ್ಲಿ ಕಪ್ಪಾಗಿರುವ<br><b>व्युत्पत्तिः - </b>कृष्णं मुखं वदनं अग्रभागो वा यस्य<br><br>

कृष्णमुखता
कृष्णमुखता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಮುಖದಿಂದ ಕೂಡಿರುವಿಕೆ<br><b>निष्पत्तिः - </b>"तल्" (५-१-११९)<br><br>कृष्णमुखता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ತುದಿಯಿಂದ ಕೂಡಿರುವಿಕೆ<br><b>प्रयोगाः - </b>"स्तनयोः कृष्णमुखता रोमराज्युद्गमस्तथा"<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

कृष्णमृग
कृष्णमृग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಚುಕ್ಕಿಯ ಜಿಂಕೆ /ಚಿಗರಿ<br><b>व्युत्पत्तिः - </b>कृष्णो मृगः<br><b>प्रयोगाः - </b>"रुरून् कृष्णमृगान् चैव मेध्यादन्यान् वनेचरान्"<br><b>उल्लेखाः - </b>भा० वन०<br><br>

कृष्णमृगी
कृष्णमृगी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಚುಕ್ಕಿಯ ಜಿಂಕೆ /ಚಿಗರಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६३)<br><br>

कृष्णयजुर्वेद
कृष्णयजुर्वेद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶುಕ್ಲ ಮತ್ತು ಕೃಷ್ಣಗಳೆಂಬ ೨ ಯಜುರ್ವೇದಗಳಲ್ಲಿ ಒಂದು ಭೇದ<br><br>

कृष्णयजुर्वेदीय
कृष्णयजुर्वेदीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಯಜುರ್ವೇದ ಸಂಬಂಧವಾದ<br><br>

कृष्णयाम
कृष्णयाम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>व्युत्पत्तिः - </b>कृष्णो यामो वर्त्म यस्य<br><br>

कृष्णरक्त
कृष्णरक्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಮತ್ತು ಕೆಂಪು ಬೆರೆತ ಬಣ್ಣ<br><b>व्युत्पत्तिः - </b>कृष्णमिश्रो रक्तः<br><br>कृष्णरक्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಮತ್ತು ಕೆಂಪು ಬೆರೆತ ಬಣ್ಣದ<br><b>व्युत्पत्तिः - </b>कृष्णश्चासौ रक्तश्च<br><br>

कृष्णल
कृष्णल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಲಗಂಜಿ ಗಿಡ<br><b>निष्पत्तिः - </b>ला (आदाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कृष्णं वर्णं लाति<br><br>कृष्णल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಲಗಂಜಿ ಕಾಯಿ<br><br>कृष्णल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಧ್ಯಯವದ ತೂಕ<br><b>प्रयोगाः - </b>"त्रसरेणवोऽष्टौ विज्ञेया लिक्षैषा परिमाणतः । ता राजसर्षपस्त्रिस्रः ते त्रयो गौरसर्षपः । सर्षपाः षट् यवो मध्यः त्रियवन्त्वेककृष्णलम् ॥"<br><b>उल्लेखाः - </b>मनु० ८-१३३, ३४<br><br>

कृष्णला
कृष्णला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಲಗಂಜಿ ಗಿಡ<br><br>

कृष्णलक
कृष्णलक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗುಲಗಂಜಿ ಗಿಡ<br><b>निष्पत्तिः - </b>स्वार्थे "कः"<br><br>

कृष्णलवण
कृष्णलवण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸೌವರ್ಚಲವೆಂಬ ಲವಣ<br><br>

कृष्णलोह
कृष्णलोह<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಯಸ್ಕಾಂತ /ಸೂಜಿಗಲ್ಲು<br><br>कृष्णलोह<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಬ್ಬಿಣ<br><br>

कृष्णलोहित
कृष्णलोहित<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಕೆಂಪು ಬೆರೆತ ಬಣ್ಣ<br><b>व्युत्पत्तिः - </b>कृष्णमिश्रो लोहः<br><br>कृष्णलोहित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಕೆಂಪು ಬೆರೆತ ಬಣ್ಣದ/ ಧೂಮ್ರವರ್ಣದ<br><br>

कृष्णवक्त्र
कृष्णवक्त्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಮುಖದ ವಾನರ /ಕಪಿ<br><b>व्युत्पत्तिः - </b>कृष्णं वक्त्रं यस्य<br><br>कृष्णवक्त्र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಮುಖವುಳ್ಳ<br><br>

कृष्णवक्त्रा
कृष्णवक्त्रा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಮುಖವುಳ್ಳ<br><b>निष्पत्तिः - </b>स्त्रियां "टाप्"<br><br>

कृष्णवर्ण
कृष्णवर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಬಣ್ಣ<br><b>व्युत्पत्तिः - </b>कृष्णो वर्णः<br><br>कृष्णवर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಹು<br><b>व्युत्पत्तिः - </b>कृष्णो वर्णः अस्य<br><br>कृष्णवर्ण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಬಣ್ಣದ<br><b>व्युत्पत्तिः - </b>कृष्णो वर्णः यस्य<br><br>

कृष्णवर्त्मन्
कृष्णवर्त्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ನಿ /ಬೆಂಕಿ<br><b>व्युत्पत्तिः - </b>कृष्णं वर्त्माऽस्य<br><b>प्रयोगाः - </b>"श्रद्दधे त्रिदशगोपमात्रके दाहशक्तिमिव कृष्णवर्त्मनि"<br><b>उल्लेखाः - </b>रघु० ११-४२<br><br>कृष्णवर्त्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರಕವೃಕ್ಷ /ಚಿತ್ರಮೂಲದ ಗಿಡ<br><br>कृष्णवर्त्मन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಾಹುಗ್ರಹ<br><br>कृष्णवर्त्मन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೀಚ ಕಾರ್ಯವನ್ನು ಮಾಡುವವನು<br><b>व्युत्पत्तिः - </b>कृष्णमशुद्धं वर्त्माचरणं यस्य<br><b>विस्तारः - </b>"कृष्णवर्त्मा पुमानग्नौ दुराचारे विधुन्तुदे" - मेदि० ।<br><br>

कृष्णवल्ली
कृष्णवल्ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣತುಲಸಿ<br><br>कृष्णवल्ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸೊಗದೆ ಗಿಡ<br><br>

कृष्णवानर
कृष्णवानर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೋಲಾಂಗೂಲವೆಂಬ ಒಂದು ಜಾತಿಯ ವಾನರ /ಒಂದು ಜಾತಿಯ ಕಪಿ<br><br>

कृष्णवृन्ता
कृष्णवृन्ता<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಸುರು ಪಾದರಿ ಗಿಡ<br><b>व्युत्पत्तिः - </b>कृष्णं वृन्तमस्याः<br><br>

कृष्णवृन्तिका
कृष्णवृन्तिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶೀವನೆಯ ಮರ<br><b>निष्पत्तिः - </b>कृष्णवृन्ता - सञ्ज्ञायां "कन्" (५-३-८७)<br><br>

कृष्णवेणी
कृष्णवेणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಭಾರತದೇಶದಲ್ಲಿ ಪ್ರಸಿದ್ಧವಾಗಿ ಪ್ರವಹಿಸುವ ಒಂದು ನದಿ /ಕೃಷ್ಣಾನದಿ<br><b>प्रयोगाः - </b>"ततो देवह्रदेऽरण्ये कृष्णवेणीजलोद्भवे । जातिस्मरह्रदे स्नात्वा भवेज्जातिस्मरो नरः ॥"<br><b>उल्लेखाः - </b>भा० वन० ८५-३८<br><br>

कृष्णव्रीहि
कृष्णव्रीहि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಬತ್ತ<br><b>व्युत्पत्तिः - </b>कृष्णो व्रीहिः<br><br>

कृष्णशकुनि
कृष्णशकुनि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಗೆ<br><b>व्युत्पत्तिः - </b>कृष्णः शकुनिः<br><br>

कृष्णशार
कृष्णशार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಮತ್ತು ಚಿತ್ರವರ್ಣದ ಜಿಂಕೆ<br><b>व्युत्पत्तिः - </b>कृष्णश्चासौ शारश्च<br><br>

कृष्णशालि
कृष्णशालि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಬತ್ತ<br><b>व्युत्पत्तिः - </b>कृष्णः शालिः<br><br>

कृष्णशृङ्ग
कृष्णशृङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಿಷ /ಎಮ್ಮೆ<br><b>व्युत्पत्तिः - </b>कृष्णं शृङ्गमस्य<br><br>

कृष्णसख
कृष्णसख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣನ ಗೆಳೆಯ /ಅರ್ಜುನ<br><b>निष्पत्तिः - </b>"टच्" (५-४-९१)<br><b>व्युत्पत्तिः - </b>कृष्णस्य सखा<br><br>

कृष्णसर्प
कृष्णसर्प<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಳಿಂಗ ಸರ್ಪ<br><b>व्युत्पत्तिः - </b>कृष्णः सर्पः<br><b>प्रयोगाः - </b>"आशीविषैः कृष्णसर्पैः सुप्तं चैनमदंशयत्"<br><b>उल्लेखाः - </b>भा० आदि० ६१<br><br>

कृष्णसर्षप
कृष्णसर्षप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕರಿ ಸಾಸವೆ<br><b>व्युत्पत्तिः - </b>कृष्णः सर्षपः<br><br>

कृष्णसार
कृष्णसार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಾರಗದ ಒಂದು ಭೇದ /ಒಂದು ಜಾತಿಯ ಜಿಂಕೆ /ಮೈಯಲ್ಲಿ ಕಪ್ಪು ಚುಕ್ಕಿಗಳುಳ್ಳ ಚಿತ್ರವರ್ಣದ ಜಿಂಕೆ<br><b>व्युत्पत्तिः - </b>कृष्णश्चासौ सारश्च<br><b>प्रयोगाः - </b>"कृष्णसारे ददच्चक्षुस्त्वयि चाधिज्यकार्मुके"<br><b>उल्लेखाः - </b>शाकु० १-६<br><br>

कृष्णसारङ्ग
कृष्णसारङ्ग<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಜಿಂಕೆ<br><b>व्युत्पत्तिः - </b>कृष्णश्चासौ सारङ्गश्च<br><br>

कृष्णसारथि
कृष्णसारथि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣನೇ ಸಾರಥಿಯಾಗಿ ಉಳ್ಳ ಅರ್ಜುನ<br><b>व्युत्पत्तिः - </b>कृष्णः सारथिर्यस्य<br><br>कृष्णसारथि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣನ ಸಾರಥಿ /ದಾರುಕ<br><b>व्युत्पत्तिः - </b>कृष्णस्य सारथिः<br><br>

कृष्णस्कन्ध
कृष्णस्कन्ध<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೊಂಗೆಮರ /ತಮಾಲವೃಕ್ಷ<br><b>व्युत्पत्तिः - </b>कृष्णः स्कन्धोऽस्य<br><br>

कृष्णागुरु
कृष्णागुरु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಗುರು ಚಂದನ /ಕಪ್ಪು ಜಾತಿಯ ಚಂದನವೃಕ್ಷ<br><br>

कृष्णाचल
कृष्णाचल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣನಿಗೆ ಪ್ರಿಯವಾದ ರೈವತಕ ಪರ್ವತ<br><b>व्युत्पत्तिः - </b>कृष्णप्रियः अचलः<br><br>कृष्णाचल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರನೀಲಪರ್ವತ<br><b>व्युत्पत्तिः - </b>कृष्णः अचलः<br><br>

कृष्णाजिन
कृष्णाजिन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಿಂಕೆಯ ಚರ್ಮ /ಕೃಷ್ಣಮೃಗದ ತೊಗಲು<br><b>व्युत्पत्तिः - </b>कृष्णस्य अजिनम्<br><br>

कृष्णायस
कृष्णायस<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಲೋಹ /ಕಬ್ಬಿಣ<br><b>निष्पत्तिः - </b>"टच्" (५-४-९४)<br><b>व्युत्पत्तिः - </b>कृष्णमयः<br><br>

कृष्णाष्टमी
कृष्णाष्टमी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣನು ಅವತರಿಸಿದ ಶ್ರಾವಣ ಕೃಷ್ಣಾಷ್ಟಮಿ /ಶ್ರೀಕೃಷ್ಣನು ಹುಟ್ಟಿದ ದಿವಸ /ಸಿಂಹಮಾಸದ ಕೃಷ್ಣಪಕ್ಷದ ಅಷ್ಟಮಿ<br><br>कृष्णाष्टमी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಪಕ್ಷದ ಅಷ್ಟಮಿ ತಿಥಿ<br><br>

कृष्णिका
कृष्णिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರಾಜಸಾಸವೆ /ಕರಿಸಾಸವೆ<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कृष्णवर्णो अतिशयेनास्त्यस्य<br><br>

कृष्णेक्षु
कृष्णेक्षु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಡುಕಬ್ಬು<br><b>व्युत्पत्तिः - </b>कृष्णश्चासौ इक्षुश्च<br><br>

कृष्णोदर
कृष्णोदर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಹೊಟ್ಟೆಯುಳ್ಳ ಒಂದು ಜಾತಿಯ ಸರ್ಪ<br><b>व्युत्पत्तिः - </b>कृ्ष्णमुदरमस्य<br><br>

कृष्णोदरी
कृष्णोदरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಹೊಟ್ಟೆಯುಳ್ಳ ಒಂದು ಜಾತಿಯ ಸರ್ಪ<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

कृष्णोदुम्बरिका
कृष्णोदुम्बरिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಹತ್ತಿ ಗಿಡ<br><b>व्युत्पत्तिः - </b>कृष्णस्य काकस्य प्रिया उदुम्बरिका<br><br>

कृष्य
कृष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯಲ್ಪಡುವ<br><br>कृष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯಲು ಯೋಗ್ಯವಾದ<br><br>कृष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯಲು ಶಕ್ಯವಾದ<br><b>निष्पत्तिः - </b>कृष (विलेखने) - "क्यप्" (३-१-११०)<br><br>कृष्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಳಲು ಯೋಗ್ಯವಾದ /ಉಳಲ್ಪಡುವ<br><b>प्रयोगाः - </b>"कृष्यां दहन्नपि खलु क्षितिमिन्धनेद्धो बीजप्ररोहजननीं ज्वलनः करोति"<br><b>उल्लेखाः - </b>रघु० ९-८०<br><br>

कृष्यमाण
कृष्यमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉಳಲ್ಪಡುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कृष (विलेखने) - कर्म० "शानच्" (३-२-१२४)<br><br>कृष्यमाण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಎಳೆಯಲ್ಪಡುತ್ತಿರುವ<br><b>प्रयोगाः - </b>"पुरो विलग्नैर्हरदृष्टिपातैः सुवर्णसूत्रैरिव कृष्यमाणः"<br><b>उल्लेखाः - </b>कुमा० ७-५०<br><br>

कृसर
कृसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿಲಾನ್ನ /ಎಳ್ಳಿನೊಡನೆ ಬೇಯಿಸಲ್ಪಟ್ಟ ಅನ್ನ<br><b>विस्तारः - </b>"तिलतण्डुलसम्पक्वः कृसरः सोऽभिधीयते"<br><br>

कॄ|विक्षेपे|किरति
कॄ - विक्षेपे (तुदा० पर० सक० से०) किरति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಎರಚು /ಎಸೆ /ಬಿಸಾಡು /ಚೆಲ್ಲು<br><b>प्रयोगाः - </b>"आविकिरन् बाललताः प्रसूनैराचारलाजैरिव पौरकन्याः"<br><b>उल्लेखाः - </b>रघु० २-१०<br><br>कॄ - विक्षेपे (तुदा० पर० सक० से०) किरति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹರಡು<br><br>

अनु + कॄ|अनुकॄ|अनुकिरति
अनु + कॄ = अनुकिरति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅನಂತರ ಎಸೆ /ಎಸೆ /ಎರಚು /ಚೆಲ್ಲು<br><br>

अप + कॄ|अपकॄ|अपस्किरति 
अप + कॄ - अपस्किरति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹರ್ಷ /ಆಶ್ರಯ /ಭಕ್ಷಣ<br><br>

अव + कॄ|अवकॄ|अवकिरति
अव + कॄ = अवकिरति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕೆಳಕ್ಕೆ ಚೆಲ್ಲು<br><br>अव + कॄ = अवकिरति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ದೂರಕ್ಕೆ ಎಸೆ<br><br>

आ + कॄ|आकॄ|आकिरति
आ + कॄ = आकिरति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ಎರಚು<br><br>आ + कॄ = आकिरति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸುತ್ತಲೂ ಹರಡು /ಎಲ್ಲಾ ಕಡೆಯಲ್ಲೂ ವ್ಯಾಪಿಸು<br><b>प्रयोगाः - </b>"आकीर्णमृषिपत्नीनामुटजद्वाररोधिभिः । अपत्यैरिव नीवारभागधेयोचितैर्मृगैः ॥"<br><b>उल्लेखाः - </b>रघु० १-५०<br><br>

उद् + कॄ|उत्कॄ|उत्किरति
उद् + कॄ = उत्किरति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಮೇಲಕ್ಕೆ ಎರಚು /ಮೇಲಕ್ಕೆ ಎಸೆ<br><br>उद् + कॄ = उत्किरति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕಲ್ಲು ಮೊದಲಾದುವುಗಳ ಮೇಲೆ ಚಿತ್ರವನ್ನು ಕೆತ್ತು /ಚಿತ್ರವನ್ನು ಕೊರೆ<br><b>प्रयोगाः - </b>"लीनेव प्रतिबिम्बितेव लिखितेवोत्कीर्णरूपेव च"<br><b>उल्लेखाः - </b>मालती० ५-१०<br><br>

सम् + उद् + कॄ|समुत्कॄ|समुत्किरति
सम् + उद् + कॄ = समुत्किरति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ರಂಧ್ರ ಮಾಡು /ವೆಜ್ಜ ಕೊರೆ<br><b>प्रयोगाः - </b>"मणौ वज्रसमुत्कीर्णे सूत्रस्येवास्ति मे गतिः"<br><b>उल्लेखाः - </b>रघु० १-४<br><br>

प्र + कॄ|प्रकॄ|प्रकिरति
प्र + कॄ = प्रकिरति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಬೆರಸು /ಕಲಕು<br><br>

प्रति + कॄ|प्रतिकॄ|प्रतिकिरति
प्रति + कॄ = प्रतिकिरति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸು /ಪೀಡಿಸು<br><b>प्रयोगाः - </b>"स मुग्धकान्तास्तनसङ्गभङ्गुरैरुरोविदारं प्रतिचस्करे नखैः"<br><b>उल्लेखाः - </b>माघ० १-४७<br><br>

सम् + कॄ|सङ्कॄ|सङ्किरति
सम् + कॄ = सङ्किरति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಮಿಶ್ರವಾಗು /ಬೆರೆ<br><br>

कॄ|हिंसायाम्|कृणाति
कॄ - हिंसायाम् (क्र्या० पर० सक० से०) कृणाति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸು /ಪೀಡಿಸು<br><br>

कृञ्|हिंसायाम्|कृणाति|कृणाते
कृञ् - हिंसायाम् (क्र्या० उभ० सक० से०) कृणाति-ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹಿಂಸಿಸು /ಪೀಡಿಸು<br><br>

कॄत|संशब्दने|कीर्तयति|कीर्तयते
कॄत - संशब्दने (चुरा० उभ० सक० से०) कीर्तयति-ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೇಳು<br><br>कॄत - संशब्दने (चुरा० उभ० सक० से०) कीर्तयति-ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೆಸರು ಹಿಡಿಸು ಕರೆ<br><br>कॄत - संशब्दने (चुरा० उभ० सक० से०) कीर्तयति-ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೊಗಳು<br><br>कॄत - संशब्दने (चुरा० उभ० सक० से०) कीर्तयति-ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ವರ್ಣಿಸು<br><br>कॄत - संशब्दने (चुरा० उभ० सक० से०) कीर्तयति-ते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸ್ತೋತ್ರಮಾಡು<br><br>

क्लृप्त
क्लृप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏರ್ಪಟ್ಟಿರುವ<br><br>क्लृप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಿದ್ಧವಾಗಿರುವ /ಸಜ್ಜಾಗಿರುವ<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) - "क्तः" (३-४-७२)<br><b>प्रयोगाः - </b>"क्लृप्तपुष्पशयनौल्लतागृहानेत्य दूतिकृतमार्गदर्शनः"<br><b>उल्लेखाः - </b>रघु० १९-१३<br><br>क्लृप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಾಡಿರುವ<br><br>क्लृप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸೃಷ್ಟಿಯಾಗಿರುವ /ಉತ್ಪತ್ತಿ ಹೊಂದಿದ<br><br>क्लृप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನಿಶ್ಚಿತವಾದ /ತೀರ್ಮಾನವಾದ<br><br>क्लृप्त<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಹಿತವಾದ /ಗೊತ್ತಾದ /ನಿಗದಿಯಾದ<br><b>प्रयोगाः - </b>"क्लृप्तानां पशुसोमानां निष्कृत्यर्थमसम्भवे"<br><b>उल्लेखाः - </b>मनु० ११-२७<br><br>

क्लृप्तलीला
क्लृप्तलीला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಕ್ಕುಪತ್ರ /ವ್ಯವಸ್ಥಾಪತ್ರ /ಮನೆ ಜಮೀನು ಮೊದಲಾದುವುಗಳ ಖಾತೆ ಪತ್ರ /ಪಟ್ಟೆ<br><b>निष्पत्तिः - </b>कील (बन्धने) + णिच् - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>क्लृप्तं कीलयति<br><b>विस्तारः - </b>"पट्टोलिका क्लृप्तकीला" - त्रिकाण्ड० ।<br><br>

क्लृप्तधूप
क्लृप्तधूप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಲೋಬಾನ /ಸಿಲ್ಹಕ /ಮ್ಲೇಚ್ಛ ದೇಶದ ಒಂದು ವಾಸನಾದ್ರವ್ಯ<br><b>व्युत्पत्तिः - </b>क्लृप्तो धूपो येन<br><br>

क्लृप्ति
क्लृप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಲ್ಪನ /ಏರ್ಪಾಡು<br><b>निष्पत्तिः - </b>कृपू (सामर्थ्ये) - "क्तिन्" (३-३-९४)<br><br>क्लृप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಧಾರಣ /ನಿಶ್ಚಯ<br><br>क्लृप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಿರ್ಮಾಣ /ತಯಾರಿಕೆ<br><br>क्लृप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಜ್ಜು /ಸಿದ್ಧತೆ<br><br>क्लृप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗೊತ್ತುವಳಿ /ವಿಧಿ<br><br>क्लृप्ति<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉತ್ಪತ್ತಿ /ಸೃಷ್ಟಿ<br><br>

केकय
केकय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಕಯ ದೇಶ<br><b>प्रयोगाः - </b>"उभौ भरतशत्रुघ्नौ केकयेषु परन्तपौ"<br><b>उल्लेखाः - </b>रामा०<br><br>केकय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಕಯ ದೇಶದ ದೊರೆ<br><b>प्रयोगाः - </b>"सत्कृत्य केकयो राजा भरतस्य दधौ धनम्"<br><b>उल्लेखाः - </b>रामा०<br><br>

केकयी
केकयी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಕಯ ರಾಜನ ಮಗಳು<br><b>निष्पत्तिः - </b>ಜನ್ಯಜನಕಭಾವರೂಪವಾದ ಪುಂಯೋಗವಿರುವುದರಿಂದ "पुंयोगादाख्यायाम्" (४-१-४८) इति "ङीष्" ।<br><br>

केकर
केकर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಾಲುಗಣ್ಣು<br><br>केकर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಹಳ್ಳ ತಿಟ್ಟುಗಳಿಂದ ಕೂಡಿದ ಕಣ್ಣುಗಳುಳ್ಳವನು /ವಿಕಾರವಾದ ಕಣ್ಣುಗಳುಳ್ಳವನು /ಮಾಲುಗಣ್ಣುಳ್ಳವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "टः" (३-२-२०)<br><b>व्युत्पत्तिः - </b>के मूर्ध्नि कर्तुं शीलमस्य<br><br>

केका
केका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಯೂರದ ಶಬ್ದ /ನವಿಲಿನ ಕೂಗು<br><b>निष्पत्तिः - </b>कै (शब्दे) - "डः" (३-२-१०१)<br><b>व्युत्पत्तिः - </b>के मूर्ध्नि कायति<br><b>प्रयोगाः - </b>"षड्जसंवादिनीः केका द्विधा भिन्नाः शिखण्डिभिः"<br><b>उल्लेखाः - </b>रघु० १-३९<br><br>

केकावल
केकावल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಯೂರ /ನವಿಲು<br><b>निष्पत्तिः - </b>वल (संवरणे) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>केकां वलते<br><br>

केकावली
केकावली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಯೂರ /ನವಿಲು<br><b>निष्पत्तिः - </b>स्त्रियां जाति० "ङीष्" (४-१-६३)<br><br>

केकिक
केकिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಯೂರ /ನವಿಲು<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५)<br><b>व्युत्पत्तिः - </b>केकास्यास्ति<br><br>

केकिन्
केकिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಯೂರ /ನವಿಲು<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>केकास्यास्ति<br><br>

केट
केट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತ್ರಾಸ /ಭಯ<br><b>निष्पत्तिः - </b>किट (त्रासे) - "घञ्" (३-३-१८)<br><br>

केणिका
केणिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಸ್ತ್ರಗೃಹ /ಡೇರೆ /ಗುಡಾರ<br><b>विस्तारः - </b>"स्थूलं दूष्ये केणिका पटकुड्यपि" - अभि० चि० ।<br><br>

केत
केत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹ /ಮನೆ /ವಾಸಸ್ಥಳ<br><b>निष्पत्तिः - </b>कित (निवासे) - अधि० "घञ्" (३-३-१२१)<br><b>प्रयोगाः - </b>"मत्स्यो युगान्तसमये मनुनोपलब्धः क्षोणीमयो निखिलजीवनिकायकेतः"<br><b>उल्लेखाः - </b>भाग० २-७-१२<br><br>केत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸ ಮಾಡುವುದು /ಇರುವುದು<br><b>प्रयोगाः - </b>"अवाङ्मुखाः पक्षिगणा दिनान्ते विशन्ति केतार्थमिवाशु वृक्षम्"<br><b>उल्लेखाः - </b>भा० कर्ण० ८९-१५<br><br>

केतक
केतक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾಳೆಮರ<br><b>निष्पत्तिः - </b>कित (निवासे) - "ण्वुल्" (३-१-१३३)<br><b>प्रयोगाः - </b>"विलासिनीविभ्रमदन्तपत्रमापाण्डुरं केतकबर्हमन्यः"<br><b>उल्लेखाः - </b>रघु० ६-१७<br><br>केतक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಳೆ ಹೂವು<br><b>निष्पत्तिः - </b>"अण्" (४-३-१३५) । अणो लुक् (वा० ४-३-१६६) । ङीषो लुक् (१-२-४९) ।<br><b>व्युत्पत्तिः - </b>केतक्याः पुष्पम्<br><b>प्रयोगाः - </b>"दधानमाशासु चरिष्णु दुर्यशः स कौतुकी तत्र ददर्श केतकम्"<br><b>उल्लेखाः - </b>नैष० १-७८<br><br>

केतकी
केतकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಳೆಮರ<br><b>निष्पत्तिः - </b>केतक - जाति० "ङीष्" (४-१-६३)<br><b>प्रयोगाः - </b>"सरजसमपहाय केतकीनां प्रसवमुपान्तिकनीपरेणुकीर्णम्"<br><b>उल्लेखाः - </b>किरा० १०-२६<br><br>केतकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಾಳೆ ಹೂವು<br><b>निष्पत्तिः - </b>बहुलग्रहणात् क्वचित् ङीषो न लुक् ।<br><br>

केतन
केतन<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧ್ವಜ /ಬಾವುಟ /ಪತಾಕೆ<br><b>निष्पत्तिः - </b>कित (निवासादौ) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>केत्यते ज्ञायतेऽनेन<br><b>प्रयोगाः - </b>"इत्यय तेने कदलीर्मधुश्रीः प्रभावनी केतनवैजयन्तीः" । "भग्नं भीमेन मरुता भवतो रथकेतनम्" ।<br><b>उल्लेखाः - </b>माघ० ६-६९, वेणी० २-२४<br><br>केतन<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಿಹ್ನೆ /ಗುರುತು<br><b>प्रयोगाः - </b>"अगणितमहिमानः केतनं मङ्गलानां कथमिव भुवनेऽस्मिन् तादृशाः सम्भवन्ति"<br><b>उल्लेखाः - </b>मालती० २-९<br><br>केतन<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿವಾಸ /ಗೃಹ /ವಾಸಸ್ಥಳ<br><b>प्रयोगाः - </b>"न तत्र वृक्षच्छाया वा पानीयं केतनानि च"<br><b>उल्लेखाः - </b>भा० वन०<br><br>केतन<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿಮಂತ್ರಣ /ಆಹ್ವಾನ /ಕರೆ<br><b>प्रयोगाः - </b>"यावन्तः पतिता विप्रा जडोन्मत्ताः तथैव च । दैवे वाप्यथवा पित्र्ये तावन्नार्हन्ति केतनम् ॥"<br><b>उल्लेखाः - </b>भा०<br><br>केतन<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃತ್ಯ<br><br>केतन<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ಥಾನ /ಜಾಗ<br><b>प्रयोगाः - </b>"एतद्राजासनं सर्वभूभृत्संश्रयकेतनम्"<br><b>उल्लेखाः - </b>विष्णुपु०<br><br>

केतु
केतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನವಗ್ರಹಗಳಲ್ಲೊಂದಾದ ಕೇತುಗ್ರಹ /ರಾಹುವಿನ ಶರೀರ<br><b>निष्पत्तिः - </b>चायृ (पूजानिशामनयोः) - "तुः" किः आदेशश्च (उ० १-७३)<br><b>प्रयोगाः - </b>"अर्धोनेन्द्वर्कसौराराः पापाः सौम्यास्तथापरे । पापयुक्तो बुधः पापो राहुकेतू च पापदौ ॥"<br><br>केतु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧೂಮಕೇತು<br><br>

केतुभ
केतुभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೇಘ /ಮೋಡ<br><b>निष्पत्तिः - </b>भा (दीप्तौ) - "कः" (३-२-४)<br><b>व्युत्पत्तिः - </b>केतुरिव भाति<br><br>

केतुमत्
केतुमत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಿವೋದಾಸರಾಜನ ವಂಶದ ಒಬ್ಬ ದೊರೆ<br><b>प्रयोगाः - </b>"क्षेमस्य केतुमान् पुत्रः सकेतुरस्य चात्मजः"<br><b>उल्लेखाः - </b>हरिवं०<br><br>केतुमत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧನ್ವಂತರಿಯ ಒಬ್ಬ ಮಗ<br><br>केतुमत्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಕ್ಷಸ<br><br>केतुमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಚಿಹ್ನೆಯಿಂದ ಕೂಡಿದವನು /ಗುರುತುಳ್ಳವನು<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>केतुरस्यास्ति<br><br>केतुमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಬುದ್ಧಿವಂತ /ಪ್ರಜ್ಞಾಶಾಲಿ<br><br>केतुमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಪ್ರಕಾಶಮಾನವಾದ<br><br>केतुमत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಧ್ವಜದಿಂದ ಕೂಡಿದ<br><br>

केतुमती
केतुमती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸುಮಾಲಿಯೆಂಬ ರಾಕ್ಷಸನ ಹೆಂಡತಿ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

केतुमाल
केतुमाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಗ್ನೀಧ್ರನ ಒಬ್ಬ ಮಗ<br><br>केतुमाल<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಗತ್ತಿನ ೯ ದ್ವೀಪಗಳಲ್ಲೊಂದಾದ ಜಂಬೂದ್ವೀಪದ ಪಶ್ಚಿಮ ಭಾಗ<br><b>प्रयोगाः - </b>"पश्चिमे केतुमालाख्ये रोमकाख्या प्रकीर्तिता"<br><b>उल्लेखाः - </b>सू० सि० १२-३९<br><br>

केतुमाला
केतुमाला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅವಂತೀದೇಶದಲ್ಲಿರುವ ಒಂದು ನದಿ<br><br>

केतुमालिन्
केतुमालिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ದಾನವ<br><b>प्रयोगाः - </b>"दुर्धरः केतुमाली च शत्रुहन्ता प्रमर्दनः"<br><b>उल्लेखाः - </b>हरिवं०<br><br>

केतुरत्न
केतुरत्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನವರತ್ನಗಳಲ್ಲೊಂದಾದ ವೈಡೂರ್ಯ<br><br>

केदर
केदर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ವಿಕಾರದೃಷ್ಟಿಯುಳ್ಳವನು<br><br>

केदार
केदार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗದ್ದೆ /ನೀರಿನ ಆಸರೆಯಿಂದ ಬತ್ತ ಮೊದಲಾದುವನ್ನು ಬೆಳೆಯತಕ್ಕ ಭೂಮಿ<br><b>निष्पत्तिः - </b>दॄ (विदारणे) - कर्म० "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>केन जलेन दीर्यते<br><b>प्रयोगाः - </b>"केदारभाजा शिशिरप्रवेशात् पुण्याय मन्ये मृतमुत्पलिन्या"<br><b>उल्लेखाः - </b>नैष० ७-३५<br><br>केदार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಲವಾಲ /ಗಿಡದ ಬುಡದಲ್ಲಿ ನೀರು ನಿಲ್ಲಲು ಸುತ್ತಲೂ ಕಟ್ಟೆ ಕಟ್ಟಿದ ಪಾತಿ<br><br>केदार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗದ್ದೆಯೊಳಗೆ ಮಾಡಿರುವ ಒಂದು ಸಣ್ಣ ಕುಂಟೆ<br><b>प्रयोगाः - </b>"वृषः पिबति केदारे निःश्वासकुलितं पयः"<br><b>उल्लेखाः - </b>रामा०<br><br>केदार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಮಾಚಲದ ಒಂದು ಭಾಗವಾದ ಕೇದಾರಕ್ಷೇತ್ರ<br><br>केदार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಶಿವ /ಪರಮೇಶ್ವರ<br><br>केदार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿವಲಿಂಗ<br><b>विस्तारः - </b>"केदारोऽद्रौ शिवे क्षेत्रे भूमिभेदालवालयोः" - मेदि० ।<br><br>

केदारनाथ
केदारनाथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಮಾಲಯದಲ್ಲಿ ಪೂಜಿಸಲ್ಪಡುವ ಪರಶಿವ<br><b>व्युत्पत्तिः - </b>केदारक्षेत्रस्य नाथः<br><br>

केदारेश्वर
केदारेश्वर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಶಿಯಲ್ಲಿ ನೆಲಸಿರುವ ಪರಶಿವ /ಪರಮೇಶ್ವರ<br><br>केदारेश्वर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಮಾಲಯದಲ್ಲಿರುವ ಒಂದು ಪುಣ್ಯತೀರ್ಥ<br><br>

केन
केन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇನೋಪನಿಷತ್ತು<br><br>

केनती
केनती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರತಿ /ಮನ್ಮಥನ ಪತ್ನಿ<br><b>निष्पत्तिः - </b>बाहु० "ङीप्"<br><b>व्युत्पत्तिः - </b>के सुखार्थं नतिः<br><b>विस्तारः - </b>"अस्य प्रिया रागलता केलिकलावती । सेः केतनी" - त्रिकाण्ड० ।<br><br>

केनार
केनार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಭಿಯೆಂಬ ಒಂದು ನರಕ<br><b>निष्पत्तिः - </b>नृ (नये) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>के मूर्ध्नि नारः<br><br>केनार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಿರಸ್ಸು /ತಲೆ<br><br>केनार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪೋಲ /ಕೆನ್ನೆ /ಗಂಡಸ್ಥಲ<br><br>केनार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಧಿ /ಸೇರಿಕೆ /ದೇಹದಲ್ಲಿ ೨ ಮೂಳೆಗಳು ಸೇರುವ ಜಾಗ<br><b>विस्तारः - </b>"केनारः कुम्भिनरके शिरःकपोलसन्धिषु" - मेदि० ।<br><br>

केनिपात
केनिपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದೋಣಿ ನಡೆಸುವ ಹುಟ್ಟುಗೋಲು<br><br>केनिपात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಡಗಿನ ಚುಕ್ಕಾಣಿ ಹಲಗೆ<br><b>व्युत्पत्तिः - </b>के निपातोऽस्य<br><br>

केनिपातक
केनिपातक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಡಗಿನ ಚುಕ್ಕಾಣಿ ಹಲಗೆ<br><b>निष्पत्तिः - </b>वा "कप्" (५-४-१५४)<br><br>

केन्दु
केन्दु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿಂದುಕ ವೃಕ್ಷ /ತೂಬರೆ ಗಿಡ<br><br>

केन्द्र
केन्द्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಮಂಡಲದ ಮಧ್ಯಭಾಗ /ಒಂದು ಆವರಣದ ಮಧ್ಯಭಾಗ<br><br>केन्द्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಲಗ್ನ ಮತ್ತು ಅದರಿಂದ ೪ ೭ ಮತ್ತು ೧೦ನೆಯ ಸ್ಥಾನಗಳು<br><br>केन्द्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಯಾಣಕ್ಕೆ ಸಂಬಂಧಿಸಿದ ಒಂದು ಶುಭಯೋಗ<br><b>विस्तारः - </b>"आपोक्लिमगते चन्द्रे केन्द्रस्थे सुरपूजिते । योगः केन्द्र इति ख्यातो यातुरिष्टार्थसिद्धिदः ॥"<br><br>

केन्द्रिन्
केन्द्रिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಂದ್ರದಲ್ಲಿರುವ ಗ್ರಹ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>केन्द्रं स्थानत्वेनास्त्यस्य<br><br>

केमद्रुम
केमद्रुम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜನ್ಮಕಾಲದಲ್ಲಿ ಗ್ರಹಗಳ ಒಂದು ಯೋಗ /ಫಲಭಂಗವುಂಟುಮಾಡುವ ಒಂದು ಅಶುಭಯೋಗ<br><b>प्रयोगाः - </b>"रविवर्जं द्वादशगैरनफा चन्द्रात् द्वितीयगैः सुनफा । उभस्थितैर्दुरधरा केमद्रुमसञ्ज्ञितोन्यः ॥"<br><br>

केयूर
केयूर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಂಕಿ /ತೋಳಿನ ಒಂದು ಆಭರಣ<br><b>निष्पत्तिः - </b>यु (मिश्रणे) - "ऊरः" (उ०४-९०) । सप्तम्या अलुक् (६-२-९)<br><b>व्युत्पत्तिः - </b>के बाहुशिरसि यौति<br><b>प्रयोगाः - </b>"वामेतरः संशयमस्य बाहुः केयूरबन्धोच्छ्वसितैर्नुनोद"<br><b>उल्लेखाः - </b>रघु० ६-६८<br><br>केयूर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ರತಿ ಬಂಧ<br><b>प्रयोगाः - </b>"स्त्रीजङ्घे चैव सम्पीड्य दोर्भ्यामालिङ्ग्य सुन्दरीम् । कारयेत् स्थापनं कामी बन्धः केयूरसञ्ज्ञितः ॥"<br><b>उल्लेखाः - </b>स्मरदी०<br><br>

केयूरिन्
केयूरिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತೋಳಿನಲ್ಲಿ ವಂಕಿಯನ್ನು ತೊಟ್ಟಿರುವ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>केयूरमस्यास्ति<br><br>

केरल
केरल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇರಳ ದೇಶ /ಮಲಬಾರ್ ಪ್ರದೇಶ<br><br>केरल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇರಳ ದೇಶದ ಜನರು<br><br>केरल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇರಳ ದೇಶದ ದೊರೆ<br><b>प्रयोगाः - </b>"भयोत्सृष्टविभूषाणां तेन केरलयोषिताम्"<br><b>उल्लेखाः - </b>रघु० ४-५४<br><br>

केरली
केरली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೇರಳ ದೇಶದ ಹೆಂಗಸು<br><br>केरली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೇರಳೀಯ ಜ್ಯೋತಿಷ ಗ್ರಂಥ<br><br>केरली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೋರೆ /ಲಗ್ನದ ಅರ್ಧಭಾಗ /ಸುಮಾರು ಒಂದು ಗಂಟೆ ಕಾಲ<br><br>

केलृ|चलने|केलति
केलृ - चलने (भ्वा० पर० अक० से०) केलति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಅಲುಗಾಡು /ಚಲಿಸು<br><br>केलृ - चलने (भ्वा० पर० अक० से०) केलति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಹೊೋಗು /ಮುಂದೆಸಾಗು /ಮುಂದಕ್ಕೆ ನಡೆ<br><br>

केलक
केलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನರ್ತಕ /ನರ್ತನ ಮಾಡುವವನು<br><br>केलक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತಿಯ ಅಲುಗಿನ ಮೇಲೆ ಕುಣಿಯುವವನು<br><b>निष्पत्तिः - </b>केलृ (चलने) - "ण्वुल्" (३-१-१३३)<br><b>विस्तारः - </b>"लयपुत्री नटी नर्तूः खड्गदारदिनर्तके । प्लवकः केलकश्च" - त्रिकाण्ड० ।<br><br>

केलि
केलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತ್ರೀಪುರುಷರ ಪರಿಹಾಸ /ರತಿಕ್ರೀಡೆಯ ಸಮಯದಲ್ಲಿ ನಾಯಿಕಾ ನಾಯಕರ ವಿನೋದ<br><b>निष्पत्तिः - </b>केलृ (चलने) - "इन्" (उ० ४-११७)<br><b>प्रयोगाः - </b>"उपचारक्रिया केलिः स्पर्शो भूषणवाससाम् । सह खट्वासनं चैव सर्वं सङ्ग्रहणं स्मृतम् ॥"<br><b>उल्लेखाः - </b>मनु० ८-३५७<br><b>विस्तारः - </b>स्रग्गन्धानुलेपनप्रेषणाद्युपचारकरणं केलिः परिहासालिङ्गनादिः - इति कुल्लूतभट्टः ।<br><br>केलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರೀಡೆ /ಆಟ<br><b>प्रयोगाः - </b>"मिलन्निमीलं ससृजुर्विलोकिताः नभस्वतस्तं कुसुमेषु केलयः" । "राधामाधवयोर्जयन्ति यमुनाकूले रहःकेलयः"।<br><b>उल्लेखाः - </b>नैष० १-९७, गीतगो० १<br><br>केलि<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ತ್ರೀಯರಿಗೆ ಸ್ವಭಾವ ಸಿದ್ಧವಾದ ೧೮ ವಿಧ ಅಲಂಕಾರಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"हसितं चकितं केलिरित्यष्टादशसङ्ख्यकाः । स्वभाजाश्च भावाद्या दश पुंसां भवन्त्यमी ॥"<br><b>उल्लेखाः - </b>सा० द० ३-९२<br><br>केलि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೃಥ್ವಿ /ಭೂಮಿ<br><br>केलि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಿಟ್ಟುಕೊಳ್ಳುವುದು /ಮರೆಸಿಕೊಳ್ಳುವುದು /ಬೇರೆ ವೇಷದಿಂದ ತನ್ನ ಸ್ವರೂಪವನ್ನು ಬಚ್ಚಿಟ್ಟುಕೊಳ್ಳುವುದು<br><br>

केलिक
केलिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶೊಕವೃಕ್ಷ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>केलिः प्रयोजनमस्त्यस्य<br><br>

केलिकला
केलिकला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರೀಡಾವಿದ್ಯೆ /ಆಟದ ಕಲೆ<br><b>व्युत्पत्तिः - </b>केलिरूपा कला<br><br>केलिकला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸರಸ್ವತಿಯ ವೀಣೆ<br><br>केलिकला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಆಟದಲ್ಲಿ ಜಾಣ್ಮೆ<br><br>केलिकला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷಯಾಸಕ್ತಿ /ವಿಷಯದಲ್ಲಿ ಲಾಲಸೆ<br><br>

केलिकलावती
केलिकलावती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರತಿ /ಮನ್ಮಥನ ಪತ್ನಿ<br><b>विस्तारः - </b>"अस्य प्रिया रागलता केलिकलावती" - त्रिकाण्ड० ।<br><br>

केलिकीर्ण
केलिकीर्ण<br><br><b>पदविभागः - </b>पुल्लिङ्गः /स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಉಷ್ಟ್ರ /ಒಂಟೆ<br><b>निष्पत्तिः - </b>कॄ (विक्षेपे) - "क्तः" (३-२-१०२)<br><b>व्युत्पत्तिः - </b>केल्या कीर्यते<br><b>विस्तारः - </b>"भूतघ्न उष्ट्रो दाशेरो रवणः कण्टकाशनः । दीर्घग्रीवः केलिकीर्णः" - अभि० चि०<br><br>

केलिकुञ्चिका
केलिकुञ्चिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾದಿನಿ /ಪತ್ನಿಯ ಕಿರಿಯ ಸಹೋದರಿ<br><b>निष्पत्तिः - </b>कुञ्च (कौटिल्ये) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>केल्यां कुञ्चति कुटिलीभवति<br><b>विस्तारः - </b>"पत्न्यास्तु भगिनी ज्येष्ठा ज्येष्ठश्वश्रूः कुली च सा । कनिष्ठा श्यालिका हाली यन्त्रणी केलिकुञ्चिका ॥" - अभि० चि० ।<br><br>

केलिकोश
केलिकोश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಟಗಾರ /ಅಭಿನಯಕಾರ /ನಟ<br><b>व्युत्पत्तिः - </b>केलीनां कोश इव<br><br>

केलिगृह
केलिगृह<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರೀಡಾಮಂದಿರ /ಆಟದ ಮನೆ<br><br>केलिगृह<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರತಿಗೃಹ /ಸಂಭೋಗ ಗೃಹ<br><b>व्युत्पत्तिः - </b>केल्याः गृहम्<br><br>

केलिनागर
केलिनागर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭೋಗಿ /ವಿಷಯಾಸಕ್ತ<br><b>व्युत्पत्तिः - </b>केलिप्रधानो नागरः<br><br>

केलिमण्डप
केलिमण्डप<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>केलिगृह ಪದದ ಅರ್ಥ<br><br>

केलिमन्दिर
केलिमन्दिर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>केलिगृह ಪದದ ಅರ್ಥ<br><br>

केलिमुख
केलिमुख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಿಹಾಸ್ಯ /ವಿನೋದ<br><br>केलिमुख<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರೀಡೆ /ಆಟ<br><b>व्युत्पत्तिः - </b>केलिः मुखमत्र<br><b>विस्तारः - </b>"परिहासः केलिमुखः" - त्रिकाण्ड० ।<br><br>

केलिसचिव
केलिसचिव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಟಕದಲ್ಲಿ ನಾಯಕನ ನರ್ಮಸಚಿವ /ಕ್ರೀಡಾಸಚಿವ /ವಿದೂಷಕ<br><b>व्युत्पत्तिः - </b>केलौ सचिवः<br><br>

केलिस्थली
केलिस्थली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರೀಡಾರಂಗ /ಆಟದ ಮೈದಾನ<br><br>

केवृ|सेवने|केवते
केवृ - सेवने (भ्वा० आत्म० सक० से०) केवते ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಸೇವಿಸು /ಸೇವೆ ಮಾಡು /ಊಳಿಗ ಮಾಡು<br><br>

केवर्त
केवर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಸ್ತರವನು /ಮೀನು ಹಿಡಿಯುವವನು<br><br>

केवल
केवल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸಹಾಯ /ಅದ್ವಿತೀಯ /ಒಂದು ಅಥವಾ ಒಬ್ಬ ಮಾತ್ರ<br><b>निष्पत्तिः - </b>केवृ (सेवने) - "कलः" (उ० १-१०६)<br><b>प्रयोगाः - </b>"नमः त्रिमूर्तये तुभ्यं प्राक्सृष्टेः केवलात्मने"<br><b>उल्लेखाः - </b>कुमा० २०४<br><br>केवल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಏಕಾಕಿ /ಒಬ್ಬಂಟಿಗ<br><br>केवल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಮಗ್ರವಾದ /ಸಂಪೂರ್ಣವಾದ<br><b>प्रयोगाः - </b>"अनन्यगुर्वास्तव केन केवलः पुराणमूर्तेर्महिमावगम्यते"<br><b>उल्लेखाः - </b>माघ० १-३५<br><br>केवल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶುದ್ಧವಾದ /ಮಿಶ್ರವಲ್ಲದ /ಬೆರಕೆಯಿಲ್ಲದ<br><br>केवल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಅಸೂಯೆಯುಳ್ಳವನು<br><br>केवल<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಒಂದು ಮಾತ್ರ /ಅದೊಂದೇ<br><b>प्रयोगाः - </b>"न केवलं गच्छति तस्य काले ययुः शरीरावयवा विवृद्धम्"<br><b>उल्लेखाः - </b>रघु० १८-४९<br><br>केवल<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಅವಧಾರಣ /ನಿಶ್ಚಯ<br><b>प्रयोगाः - </b>"न केवलं सद्मनि मागधीपतेः पथि व्यजृम्भन्त दिवौकसामपि" । "वचसस्तस्य सपदि क्रिया केवलमुत्तरम्" ।<br><b>उल्लेखाः - </b>रघु० ३-१९, माघ० २-२२<br><br>केवल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಿರ್ಣೀತ<br><b>विस्तारः - </b>"केवलः कुहने पुमान् । नपुंसकन्तु निर्णीते वाच्यवच्चैककृत्स्नयोः" - मेदि० ।<br><br>केवल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪ್ರಕೃತಿಪುರುಷ ವಿಶೇಷ ಜ್ಞಾನ<br><br>

केवला
केवला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>केवल ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>असञ्ज्ञायां "टाप्"<br><br>

केवली
केवली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>केवल ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>सञ्ज्ञायां छन्दसि च "ङीप्" (४-१-३०)<br><br>

केवलव्यतिरेकि
केवलव्यतिरेकि<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>೩ ವಿಧ ಲಿಂಗ ಅಥವಾ ಅನುಮಾನಗಳಲ್ಲಿ ಒಂದು ಭೇದ<br><br>

केवलान्वयि
केवलान्वयि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>೩ ವಿಧ ಲಿಂಗ ಅಥವಾ ಅನುಮಾನಗಳಲ್ಲಿ ಒಂದು ಭೇದ<br><br>

केश
केश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲು<br><b>निष्पत्तिः - </b>शीङ् (स्वप्ने) -"डः"(३-२-१०१)<br><b>व्युत्पत्तिः - </b>के शिरसि शेते<br><b>प्रयोगाः - </b>"लताप्रातानोद्ग्रथितैः स केशैरधिज्यधन्वा विचचार् दावम्"<br><b>उल्लेखाः - </b>रघु० २-८<br><br>केश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರುಣ /ಜಲಾಧಿಪತಿ<br><b>व्युत्पत्तिः - </b>कस्य जलस्य ईशः<br><br>केश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮುಡುವಾಳ<br><b>विस्तारः - </b>"केशः स्यत् पुंसि वरुणे ह्रीबेरे कुन्तलेऽपि च" - मेदि० ।<br><br>केश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಕ್ಷಸ<br><b>विस्तारः - </b>"केशः शिरसिजे पाशपाणौ ह्रीबेरदैत्ययोः" - हेम० ।<br><br>

केशकर्मन्
केशकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯನ್ನು ಬಾಚಿ ಜಡೆ ಹಣೆದು ಶೃಂಗರಿಸುವುದು<br><b>व्युत्पत्तिः - </b>केशानां कर्म रचना<br><b>प्रयोगाः - </b>"साहं ब्रुवाणा सैरन्ध्री कुशला केशकर्मणि"<br><b>उल्लेखाः - </b>भा० विरा० ३-१८<br><br>केशकर्मन्<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚೂಡಾಕರ್ಮ /ಜುಟ್ಟುಬಿಡಿಸುವುದು<br><br>

केशकलाप
केशकलाप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲಿನ ಸಮೂಹ<br><b>व्युत्पत्तिः - </b>केशानां कलापः<br><br>

केशकारिन्
केशकारिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲನ್ನು ಬಾಚಿ ಹಣೆದು ಶೃಂಗರಿಸುವವನು<br><b>निष्पत्तिः - </b>डुकृञ् (करणे) - "णिनिः" (३-२-७८)<br><b>व्युत्पत्तिः - </b>केशं तस्य रचनां करोति<br><br>

केशकारिणी
केशकारिणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲನ್ನು ಬಾಚಿ ಹಣೆದು ಶೃಂಗರಿಸುವವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><b>प्रयोगाः - </b>"निहीनवर्णां सैरन्ध्रीं बीभत्सां केशकारिणीम्"<br><b>उल्लेखाः - </b>भा० विरा० १४-४३<br><br>

केशकीट
केशकीट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲಿಗೆ ಸೇರುವ ಕೃಮಿ /ಹುಳು<br><b>व्युत्पत्तिः - </b>केशे कीटः<br><br>केशकीट<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲು ಮತ್ತು ಹೇನು<br><b>व्युत्पत्तिः - </b>केशश्च कीटश्च अनयोः समाहारः<br><b>प्रयोगाः - </b>"केशकीटावपन्नं च पदा स्पृष्टं च कामतः"<br><b>उल्लेखाः - </b>मनु० ४-२०७<br><br>

केशगर्भ|केशगर्भक
केशगर्भ(क)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೇಣಿ /ಜಡೆ<br><b>निष्पत्तिः - </b>वा "कप्" (५-४-१५४)<br><b>व्युत्पत्तिः - </b>केशः गर्भेऽस्य<br><b>विस्तारः - </b>"कबरः केशगर्भकः" - त्रिकाण्ड० ।<br><br>

केशग्रह
केशग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರತಿಕ್ರೀಡೆಯ ಕಾಲದಲ್ಲಿ ಮಾಡುವ ಕಳಗ್ರಹಣ<br><b>व्युत्पत्तिः - </b>केशस्य ग्रहः<br><b>प्रयोगाः - </b>"रतेषु केशग्रहः"<br><b>उल्लेखाः - </b>कादं०<br><br>केशग्रह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲನ್ನು ಹಿಡಿದೆಳೆಯುವುದು<br><b>प्रयोगाः - </b>"केशग्रहान् प्रहारांश्च शिरस्येतान् विवर्जयेत्"<br><b>उल्लेखाः - </b>मनु० ४-८३<br><br>

केशग्रहण
केशग्रहण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>केशग्रह ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>ग्रह (उपादाने) - भावे "ल्युट्" (३-३-११५)<br><b>व्युत्पत्तिः - </b>केशानां ग्रहणम्<br><br>

केशग्राहम्
केशग्राहम्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೂದಲನ್ನು ಹಿಡಿದುಕೊಂಡು<br><b>निष्पत्तिः - </b>हन (हिंसागत्योः) - "टक्" (३-२-५३)<br><b>व्युत्पत्तिः - </b>केशान् हन्ति<br><br>

केशघ्न
केशघ्न<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಲುಪ್ತಕವೆಂಬ ಒಂದು ರೋಗ /ತಲೆಯ ಕೂದಲನ್ನು ಉದುರಿಸುವ ಒಂದು ರೋಗ<br><b>निष्पत्तिः - </b>"चणप्" (५-२-२६)<br><b>व्युत्पत्तिः - </b>केशैः वित्तः<br><br>

केशचण
केशचण<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೂದಲಿನಿಂದ ಪ್ರಸಿದ್ಧವಾದ /ಒಳ್ಳೆಯ ಕೂದಲಿನಿಂದ ಪ್ರಸಿದ್ಧಿ ಹೊಂದಿದ<br><br>

केशच्छिद्
केशच्छिद्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಪಿತ /ಕ್ಷೌರಿಕ /ನಾಯಿಂದ<br><b>निष्पत्तिः - </b>छिदिर् (द्वैधीकरणे) - "क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>केशान् छिनत्ति<br><br>केशच्छिद्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೂದಲನ್ನು ಕತ್ತರಿಸುವವನು<br><br>

केशजाह
केशजाह<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಶಮೂಲ /ತಲೆಯ ಕೂದಲಿನ ಬುಡ<br><b>निष्पत्तिः - </b>"जाहच्" (५-२-२४)<br><b>व्युत्पत्तिः - </b>केशानां मूलम्<br><br>

केशट
केशट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>अट (गतौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>को ब्रह्मा ईशः महादेवः तौ अटतः यं प्रलयकाले<br><br>केशट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಜ /ಮೇಕೆ<br><b>व्युत्पत्तिः - </b>केशेषु काशादितृणजातेषु अटति<br><br>केशट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿಗಣೆ<br><b>व्युत्पत्तिः - </b>केशेषु शिरो गृहेषु अटति<br><br>केशट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಹೋದರ<br><br>केशट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಮ್ಮರ /ತಿಗಡುಮರ<br><br>केशट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮನ್ಮಥನ ಬಾಣ<br><b>विस्तारः - </b>"केशटः शोणके विष्णौ" - त्रिकाण्ड० ।<br><br>

केशपक्ष
केशपक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲಿನ ಸಮೂಹ<br><b>व्युत्पत्तिः - </b>केशानां पक्षः<br><b>प्रयोगाः - </b>"केशपक्षे परामृष्टा पापेन हतबुद्धिना"<br><b>उल्लेखाः - </b>भा० आदि०<br><br>

केशपाश
केशपाश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲಿನ ಸಮೂಹ<br><b>व्युत्पत्तिः - </b>केशानां पाशः<br><b>प्रयोगाः - </b>"तिमिरमिव दधानाः स्रंसिनः केशपाशान्"<br><b>उल्लेखाः - </b>माघ० ११-१०<br><br>

केशपर्णी
केशपर्णी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಪಾಮಾರ್ಗ /ಉತ್ತರಣೆ ಗಿಡ<br><br>

केशप्रसाधनी
केशप्रसाधनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲನ್ನು ಬಾಚಿ ಶೃಂಗರಿಸುವ ಬಾಚಣಿಗೆ<br><b>निष्पत्तिः - </b>प्र + साध (संसिद्धौ) - कर० "ल्युट्" (३-३-११७)<br><b>व्युत्पत्तिः - </b>केशः प्रसाध्यतेऽनया<br><b>प्रयोगाः - </b>"केशप्रसाधनी केश्या रजोजन्तुमलापहा"<br><b>उल्लेखाः - </b>सुश्रुत० चिकित्सा० २४-२९<br><br>

केशभू
केशभू<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿರಸ್ಸು /ತಲೆ<br><b>व्युत्पत्तिः - </b>केशानां भूः उत्पत्तिस्थानम्<br><br>

केशभूमि
केशभूमि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಿರಸ್ಸು /ತಲೆ<br><b>प्रयोगाः - </b>"दारुणा कण्डुरा रूक्षा केशभूमिः प्रजायते" ।<br><b>उल्लेखाः - </b>सुश्रुत०<br><br>

केशमार्जक
केशमार्जक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಚಣಿಗೆ<br><b>निष्पत्तिः - </b>मृजू (शुद्धौ) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>केशान् मार्ष्टि<br><br>

केशमार्जन
केशमार्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯನ್ನು ಬಾಚುವುದು<br><b>निष्पत्तिः - </b>मृजू (शुद्धौ) - "ल्युट्" (३-३-११५)<br><b>व्युत्पत्तिः - </b>केशानां मार्जनम्<br><br>केशमार्जन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಚಣಿಗೆ<br><b>निष्पत्तिः - </b>मृजू (शुद्धौ) - कर० "ल्युट्" (३-३-११७)<br><br>

केशर|केसर
केश(स)र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಕುಳ ವೃಕ್ಷ /ಪವಳದ ಗಿಡ<br><br>केश(स)र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುರಗಿ ಮರ /ಸುರಹೊನ್ನೆ ಮರ<br><b>निष्पत्तिः - </b>"अच्" (५-२-१२७)<br><b>व्युत्पत्तिः - </b>प्रशस्ताः केसराः सन्त्यस्य<br><br>केश(स)र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಗಸಂಪಿಗೆ ಮರ<br><br>केश(स)र<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆ ಮತ್ತು ಸಿಂಹದ ಹೆಗಲಿನ ಕೂದಲು<br><br>केश(स)र<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿಂಜಲ್ಕ /ಪದ್ಮ ಮೊದಲಾದುವುಗಳ ಒಳಗಿನ ಕುಸುರು<br><b>प्रयोगाः - </b>"सरजसारुणकेशरचारुभिः"<br><b>उल्लेखाः - </b>माघ० ६-४७<br><br>केश(स)र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಿಂದೂರ /ಇಂಗಲೀಕ<br><br>केश(स)र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಕುಳ ಪುಷ್ಪ<br><br>केश(स)र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುರಗಿ ಹೂವು<br><br>केश(स)र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಗಸಂಪಿಗೆ ಹೂವು<br><br>केश(स)र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಣ /ಚಿನ್ನ<br><br>केश(स)र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಕುಮಕೇಸರಿ<br><b>निष्पत्तिः - </b>शॄ (हिंसायाम्) - "अप्"(३-३-५७)<br><b>व्युत्पत्तिः - </b>के जले शिरसि वा शीर्यति<br><b>विस्तारः - </b>"केशरं हिङ्गुले क्लीबं किञ्जल्के न स्त्रियां पुमान् । सिंहसटायां पुन्नागे वकुले नागकेसरे"- मेदि० ।<br><br>केश(स)र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚಾಮರ<br><b>विस्तारः - </b>"चामरं रोमगुत्सं च केशरं चावचूलकम्" - त्रिकाण्ड० ।<br><br>

केशरचना
केशरचना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯನ್ನು ಬಾಚಿ ಜಡೆ ಹಣೆಯುವುದು<br><b>व्युत्पत्तिः - </b>केशानां रचना<br><br>

केशरञ्जन
केशरञ्जन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರಗದ ಮರ<br><b>निष्पत्तिः - </b>रञ्ज (रागे) +‍णिच् - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>केशान् रञ्जयति<br><br>केशरञ्जन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲಿಗೆ ಬಣ್ಣ ಹಾಕುವುದು<br><b>व्युत्पत्तिः - </b>केशानां रचनम्<br><br>

केशराज
केशराज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರಗದ ಸೊಪ್ಪು<br><b>निष्पत्तिः - </b>रञ्ज (रागे) - कर० "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>केशा रज्यन्तेऽनेन<br><b>विस्तारः - </b>"भृङ्गराजः केशराजो भृङ्गारः केशरञ्जनः" - भावप्र० ।<br><br>

केशलुञ्चक
केशलुञ्चक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೈನಸಂನ್ಯಾಸಿ<br><b>निष्पत्तिः - </b>लुञ्च (अपनयने) - "ण्वुल्" (३-१-१३३)<br><b>व्युत्पत्तिः - </b>केशान् लुञ्चति<br><b>प्रयोगाः - </b>"आः पाप पाषण्डापसद । चण्डालवेष, केशलुञ्चक"<br><b>उल्लेखाः - </b>प्रबोध०<br><br>

केशलुञ्चन
केशलुञ्चन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೈನಸಂನ್ಯಾಸಿ<br><b>निष्पत्तिः - </b>"ल्युः" (३-१-१३४)<br><br>

केशव
केशव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>"वः" (५-२-१०९)<br><b>व्युत्पत्तिः - </b>कश्च ईशश्च केशौ, तौ पुत्रपौत्रत्वेन स्तः अस्य । प्रशस्नोः केशाः सन्त्यस्य वा ।<br><b>प्रयोगाः - </b>"शम्भोः पितामहो ब्रह्मपिता शक्राद्यधीश्वरः" । "नारसिंहवपुः श्रीमान् केशवः पुरुषोत्तमः" । "प्रतिवाचमदत्त केशवः शपमानाय न चेदिभूभुजे" ।<br><b>उल्लेखाः - </b>पाद्मपु०, वि० स०, माघ० १६-२५<br><b>विस्तारः - </b>"प्रशस्तनीलकेशत्वात् केशवः परिकीर्तितः" - निरुक्तिः । "यस्मात् त्वयैव दुष्टात्मा हतः केशी जनार्दन । तस्मात् केशवनाम्ना त्वं लोके ज्ञेयो भविष्यसि" - विष्णुपु० ।<br><br>केशव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುರಗಿ ಮರ /ಸುರಹೊನ್ನೆ ಮರ<br><br>केशव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಉತ್ತಮವಾದ ಕೇಶಪಾಶವುಳ್ಳ /ಶ್ರೇಷ್ಠವಾದ ತುರುಬಿನಿಂದ ಕೂಡಿದ<br><b>विस्तारः - </b>"केशवः केशसंयुते । पुन्नागे वासुदेवे च" - हेम० ।<br><br>

केशवर्धन
केशवर्धन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲನ್ನು ಬೆಳೆಸುವುದು<br><b>व्युत्पत्तिः - </b>केशानां वर्धनम्<br><br>केशवर्धन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲನ್ನು ಕತ್ತರಿಸುವುದು<br><br>केशवर्धन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲನ್ನು ಬೆಳೆಸುವ<br><b>निष्पत्तिः - </b>वृधु (वृद्धौ) + णिच् - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>केशान् वर्धयति<br><br>केशवर्धन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲನ್ನು ಕತ್ತರಿಸುವ<br><b>निष्पत्तिः - </b>वर्ध (छेदने) + णिच् - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>केशान् वर्धयति<br><br>

केशवर्धना
केशवर्धना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>केशवर्धन ಪದದ ಸ್ತ್ರೀಲಿಂಗ ರೂಪ<br><br>

केशवर्धनी
केशवर्धनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಹದೇವಿಲತೆ<br><b>निष्पत्तिः - </b>वृधु (वृद्धौ) - कर० "ल्युट्" (३-३-११७) । स्त्रियां "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>केशा वर्धन्तेऽनया<br><br>

केशवर्धिनी
केशवर्धिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಹದೇವಿಲತೆ<br><b>निष्पत्तिः - </b>वृधु (वृद्धौ) + णिच् - "णिनिः" (३-१-१३४) । "ङीप्" (४-१-५)<br><b>व्युत्पत्तिः - </b>केशान् वर्धयति<br><br>

केशवालय
केशवालय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣುದೇವಸ್ಥಾನ<br><b>व्युत्पत्तिः - </b>केशवस्य आलयः<br><br>केशवालय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಶ್ವತ್ಥ ವೃಕ್ಷ /ಅರಳಿಮರ<br><br>

केशवेश
केशवेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆರಳು /ತುರುಬು<br><b>व्युत्पत्तिः - </b>केशानां वेशः<br><br>केशवेश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಶರಚನೆ /ಜಡೆ ಹಣೆಯುವುದು<br><b>प्रयोगाः - </b>"यथा कुलधर्म केशवेशान् कारयेत्"<br><b>उल्लेखाः - </b>आश्व० गृ०<br><br>

केशहस्त
केशहस्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಶಕಲಾಪ /ಕೂದಲಿನ ಸಮೂಹ<br><b>व्युत्पत्तिः - </b>केशानां हस्तः<br><b>प्रयोगाः - </b>"कस्याश्चित्विततचलच्छिखाङ्गुलीको लक्ष्मीवान् सरसि रराज केशहस्तः"<br><b>उल्लेखाः - </b>माघ० ८-२७<br><br>

केशाकेशि
केशाकेशि<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಪರಸ್ಪರ ಕೂದಲನ್ನು ಹಿಡಿದುಕೊಂಡು ನಡೆದ ಯುದ್ಧ<br><b>निष्पत्तिः - </b>"इच्" (५-४-१२७) । पूर्वपदस्य दीर्घः (६-३-१३७) ।<br><b>व्युत्पत्तिः - </b>केशेषु केशेषु गृहीत्वा इदं युद्धं प्रवृत्तम्<br><b>प्रयोगाः - </b>"केशाकेश्यभवद्युद्धं रक्षसां वानरैः सह"<br><b>उल्लेखाः - </b>भा० वन० २८४-३७<br><br>

केशाद
केशाद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲನ್ನು ತಿನ್ನುವ ಒಂದು ಕೃಮಿ<br><b>निष्पत्तिः - </b>अद (भक्षणे) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>केशान् अत्ति<br><br>

केशान्त
केशान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>೧೬ನೆಯ ವರ್ಷದಲ್ಲಿ ಮಾಡುವ ಕೇಶಖಂಡನ ಸಂಸ್ಕಾರ /ಗೋದಾನಕರ್ಮ<br><b>निष्पत्तिः - </b>अन्त + णिच् (नामधा०) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>केशान् अन्तयति छेदनात्<br><b>प्रयोगाः - </b>"केशान्तः षोडशे वर्षे ब्राह्मणस्य विधीयते । राजन्यबन्धोर्द्वाविंशे वैश्यस्य द्व्यधिके ततः ॥"<br><b>उल्लेखाः - </b>मनु० २-६५<br><br>केशान्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲಿನ ತುದಿ /ತುರುಬಿನ ತುದಿಯ ಭಾಗ<br><b>प्रयोगाः - </b>"घूपोष्मणा त्याजितमार्द्रभावं केशान्तमन्तःकुसुमं नदीयम्"<br><b>उल्लेखाः - </b>कुमा० ७-१४<br><br>

केशान्तिक
केशान्तिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲಿನ ತುದಿಯವರೆಗಿನ<br><b>निष्पत्तिः - </b>"ठन्" (५१-५७)<br><b>व्युत्पत्तिः - </b>केशान्तः परिमाणमस्य<br><b>प्रयोगाः - </b>"केशान्तिको ब्राह्मणस्य दण्डः कार्यः प्रमाणतः । ललाटसम्मितो राज्ञः स्यात्तु नासान्तिको विशः ॥"<br><b>उल्लेखाः - </b>मनु० २-४६<br><br>

केशारि
केशारि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲಿನ ಶತ್ರು<br><b>व्युत्पत्तिः - </b>केशानामरिः<br><br>

केशार्हा
केशार्हा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾನೀಲಿ ಗಿಡ<br><b>निष्पत्तिः - </b>अर्ह (पूजायाम्) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>केशं केशवर्णमर्हति<br><br>

केशि
केशि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ದಾನವ<br><br>

केशिक
केशिक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ ಕೇಶಪಾಶವುಳ್ಳ ಯಬಹಳ ಕೂದಲುಳ್ಳ<br><b>निष्पत्तिः - </b>"ठन्" (५-२-११५)<br><b>व्युत्पत्तिः - </b>प्रशस्ता केशा यस्य<br><br>

केशिका
केशिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶತಾವರಿ ಗಿಡ<br><br>

केशिध्वज
केशिध्वज<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಿಮಿವಂಶದ ಒಬ್ಬ ದೊರೆ<br><br>

केशिन्
केशिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ರಾಕ್ಷಸ<br><br>केशिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ದಾನವ<br><br>केशिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಶ್ರೇಷ್ಠವಾದ ಕೂದಲುಳ್ಳ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>प्रशस्ताः केशाः यस्य<br><br>

केशिनी
केशिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>केशिन् ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्"(४-१-५)<br><br>केशिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಡಿಯಾಲದ ಗಿಡ<br><br>केशिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಜಟಾಮಾಂಸಿ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>केशाः केशाकाराः जटाः सन्त्यस्य<br><br>केशिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದಮಯಂತಿಯ ಒಬ್ಬ ಗೆಳತಿ<br><b>प्रयोगाः - </b>"रचय चारुमति स्तनयोर्वृतिं कलय केशिनि कैश्यमसंयतम्"<br><b>उल्लेखाः - </b>नैष० ४-११४<br><br>केशिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಜಮೀಢನ ಪತ್ನಿ /ಜಹ್ನುವಿನ ತಾಯಿ<br><br>केशिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಗರಚಕ್ರವರ್ತಿಯ ಪತ್ನಿ<br><br>केशिनी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಅಪ್ಸರಸ್ಸು<br><br>

केशिनिषूदन
केशिनिषूदन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ರೀಕೃಷ್ಣ<br><b>निष्पत्तिः - </b>नि + षूद (क्षरणे) + णिच् - "ल्युः" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>केशिनं निषूदयति<br><br>

केशी
केशी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನೀಲಿ ಗಿಡ<br><br>

केशोच्चय
केशोच्चय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಶಪಾಶ /ತಲೆಯ ಕೂದಲಿನ ಸಮೂಹ<br><b>व्युत्पत्तिः - </b>केशानामुच्चयः<br><br>

केश्य
केश्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗರದಗ ಸೊಪ್ಪು<br><br>केश्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೃಷ್ಣಾಗುರು<br><br>केश्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲನ್ನು ಬಾಚಿ ಶೃಂಗರಿಸುವ ಸಾಧನವಾದ ಬಾಚಣಿಗೆ ಮುಂತಾದುದು<br><b>निष्पत्तिः - </b>"यत्" (५-१-५)<br><b>व्युत्पत्तिः - </b>केशाय हितः<br><b>प्रयोगाः - </b>"केशप्रसाधनी केश्या रजोजन्तुमलापहा"<br><b>उल्लेखाः - </b>सुश्रुत० चिकित्सा० २४-२९<br><br>

केसर
केसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆ ಮತ್ತು ಸಿಂಹದ ಹೆಗಲಿನ ಕೂದಲು<br><b>निष्पत्तिः - </b>सृ (गतौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>के सरति<br><b>प्रयोगाः - </b>"सितत्वितश्चञ्चलतामुपेयुषो मिषेण पुच्छस्य च केसरस्य च"<br><b>उल्लेखाः - </b>नैष० १-६२<br><br>केसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಲ ಮೊದಲಾದ ಹೂವುಗಳ ಕುಸುರು<br><b>निष्पत्तिः - </b>सृ (गतौ) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>के जले सरति<br><b>प्रयोगाः - </b>"नीपं दृष्ट्वा हरितकपिशं केसरैरर्धरूढैः" । "दुधुवुर्वाजिनः स्कन्धान् लग्नकुङ्कुमकेसरान्" ।<br><b>उल्लेखाः - </b>मेघ० १-२१, रघु० ४-६७<br><br>केसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುರಗಿ ಮರ /ಸುರಹೊನ್ನೆ ಮರ<br><b>व्युत्पत्तिः - </b>प्रशस्ताः केसराः अस्य<br><br>केसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಗಸಂಪಿಗೆ ಮರ<br><br>केसर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಕುಳ ವೃಕ್ಷ /ಪವಳದ ಗಿಡ<br><br>केसर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಂಗು<br><br>केसर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಕುಳ ಪುಷ್ಪ<br><b>प्रयोगाः - </b>"स्रस्तां नितम्बादवलम्बमाना पुनःपुनः केसरदामकाञ्चीम्"<br><b>उल्लेखाः - </b>कुमा० ३-५५<br><br>केसर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸುರಗಿ ಹೂವು<br><br>केसर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಗಸಂಪಿಗೆ ಹೂವು<br><b>विस्तारः - </b>"केसरो नागकेसरे । तुरङ्गसिंहयोः स्कन्धकेशेषु वकुलद्रुमे । पुन्नागवृक्षे किञ्जल्के स्यात् केसरं तु हिङ्गुनि" - हेम० ।<br><br>केसर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸ್ವರ್ಣ /ಚಿನ್ನ<br><br>

केसरवत्
केसरवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೇಸರಗಳಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>केसरा अस्य सन्ति<br><br>

केसरवती
केसरवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಸರಗಳಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्"(४-१-६)<br><br>

केसरवर
केसरवर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಂಕುಮಕೇಸರಿ<br><br>

केसराचल
केसराचल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುಮೇರುಪರ್ವತ<br><b>व्युत्पत्तिः - </b>भूपद्मस्य केसरे स्थितोऽचलः<br><br>

केसराम्ल
केसराम्ल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೇರಳೆ ಗಿಡ /ನಿಂಬೆ ಗಿಡ<br><br>केसराम्ल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೇರಳೆ ಹಣ್ಣು /ನಿಂಬೆ ಹಣ್ಣು<br><br>

केसरिन्
केसरिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಿಂಹ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>केसरोऽस्यास्ति<br><b>प्रयोगाः - </b>"स पाटलायां गवि तस्थिवांसं धनुर्धरः केसरिणं ददर्श" । "किं जीर्णं तृणमत्ति मानमहतामग्रेसरः केसरी" ।<br><b>उल्लेखाः - </b>रघु० २-२९, भर्तृ० १-२१<br><br>केसरिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುದುರೆ<br><br>केसरिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹನುಮಂತನ ತಂದೆಯಾದ ಒಬ್ಬ ವಾನರ<br><b>प्रयोगाः - </b>"सूर्यदत्तवरः स्वर्णः सुमेरुर्नाम पर्वतः । यत्र राज्यं प्रशास्त्यस्य केसरी नाम वै पिता ॥"<br><b>उल्लेखाः - </b>रामा०<br><br>केसरिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸುರಗಿ ಮರ<br><br>केसरिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಾಗಸಂಪಿಗೆ ಗಿಡ<br><b>विस्तारः - </b>"केसर्यर्वणि पुन्नागे नागकेसरसिंहयोः" - हेम० ।<br><br>केसरिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೋಟಮಾದಳದ ಗಿಡ<br><b>विस्तारः - </b>"मातुलुङ्गे तु रुचको वराल्मः केसरी शठः" - वैज० ।<br><br>

केसरिसुत
केसरिसुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಂಜನೇಯ /ಹನುಮಂತ<br><b>व्युत्पत्तिः - </b>केसरिणः सुतः<br><br>

कै|शब्दे|कायति
कै - शब्दे (भ्वा० पर० अक० अनि०) कायति ।<br><br><b>पदविभागः - </b>धातुः<br><b>कन्नडार्थः - </b>ಕೂಗು /ಶಬ್ದ ಮಾಡು<br><br>

कैङ्किरात
कैङ्किरात<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಶೋಕಕುಸುಮ /ಅಶೋಕವೃಕ್ಷದ ಹೂವು<br><b>निष्पत्तिः - </b>"अण्" (४-३-१३४)<br><b>व्युत्पत्तिः - </b>किङ्किरातानां विकारः<br><b>प्रयोगाः - </b>"कीर्णैः पिष्टातकौधैः कृतदिवसमुखैः कुङ्कुमक्षोदगौरैः हेमालङ्कारभाभिर्भरनमितशिरःशेखरैः केकिरातैः"<br><b>उल्लेखाः - </b>रत्ना० १-१०<br><br>

कैंशुक
कैंशुक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುತ್ತುಗದ ಹೂವು<br><b>निष्पत्तिः - </b>"अण्" (४-३-१३४)<br><b>व्युत्पत्तिः - </b>किंशुकस्य विकारः<br><br>

कैकसी
कैकसी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮನ ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದ ಸುಮಾಲಿಯೆಂಬ ರಾಕ್ಷಸನ ಮಗಳು /ರಾವಣನ ತಾಯಿ<br><b>प्रयोगाः - </b>"राका पुष्टोत्कटा चैव कैकसी च शुचिस्मिता । कुम्भीनसी च इत्येताः सुमालेः प्रसवाः सुताः ॥"<br><b>उल्लेखाः - </b>रामा०<br><br>

कैकेय
कैकेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಕಯ ದೇಶದ ದೊರೆ<br><b>निष्पत्तिः - </b>"अञ्" (वा० ४-१-१६६) । यादेरियादेशः (७-३-२)<br><b>व्युत्पत्तिः - </b>केकयानां राजा<br><br>

कैकेयी
कैकेयी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಕಯರಾಜನ ಮಗಳು /ದಶರಥಮಹಾರಾಜನ ಕಿರಿಯ ಹೆಂಡತಿ /ಭರತನ ತಾಯಿ<br><b>निष्पत्तिः - </b>"अञ्" (४-१-१६६) । "ङीप्" (४-१-१५)<br><b>व्युत्पत्तिः - </b>केकयस्यापत्यं स्त्री<br><b>प्रयोगाः - </b>"केकय्यास्तनयो जज्ञे भरतो नाम शीलवान् । जनयित्रीमलञ्चक्रे यः प्रश्रव इव श्रियम् ॥"<br><b>उल्लेखाः - </b>रघु० १०-७०<br><br>

कैटभ
कैटभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣುವಿನ ಕರ್ಣಸ್ರೋತಸ್ಸಿನಿಂದ ಹುಟ್ಟಿದ ಒಬ್ಬ ರಾಕ್ಷಸ /ಮಧುವೆಂಬ ಒಬ್ಬ ರಾಕ್ಷಸನತಮ್ಮ<br><br>

कैटभजित्
कैटभजित्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಟಭನೆಂಬ ರಾಕ್ಷಸನ್ನು ಕೊಂದ ವಿಷ್ಣು<br><b>निष्पत्तिः - </b>जि (जये) -"क्विप्" (३-२-६१)<br><b>व्युत्पत्तिः - </b>कैटभं जितवान्<br><br>

कैटभारि
कैटभारि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾವಿಷ್ಣು<br><b>व्युत्पत्तिः - </b>कैटभस्यारिः<br><br>

कैटभी
कैटभी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾಕಾಳಿ /ದುರ್ಗಾದೇವಿ<br><br>

कैटर्य
कैटर्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೇಗದ ಮರ<br><b>निष्पत्तिः - </b>रा (दाने) - "कः" (३-२-३) । "ष्यञ्" (वा० ५-१-१२४)<br><b>व्युत्पत्तिः - </b>केटं भयं राति अतितिक्तत्वात् । केटरस्य भावः<br><br>कैटर्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೆಲಬೇವು<br><br>कैटर्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಪಸಿ ಗಿಡ<br><br>

कैतक
कैतक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಾಳೆ ಹೂವು<br><b>निष्पत्तिः - </b>"अण्" (४-३-१३४)<br><b>व्युत्पत्तिः - </b>केतकस्य विकारः पुष्पम्<br><br>कैतक<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ತಾಳೆ ಹೂವಿನ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>केतकस्येदम्<br><b>प्रयोगाः - </b>"पुण्डरीकमुखि पूर्वदिङ्मुखं कैतकैरिव रजोभिराहतम्"<br><b>उल्लेखाः - </b>कुमा० ८-५८<br><br>

कैतव
कैतव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಕುನಿ /ದುರ್ಯೋಧನನ ಮಾವ<br><br>कैतव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಂಚಕ /ಮೋಸಗಾರ<br><br>कैतव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೂರ್ಖ /ತಿಳಿಗೇಡಿ<br><br>कैतव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜೂಜುಗಾರ<br><br>कैतव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದತ್ತೂರಿ ಗಿಡ<br><b>निष्पत्तिः - </b>कितव - स्वार्थे "अण्" (५-१-१३०)<br><br>कैतव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಸ /ವಂಚನೆ<br><br>कैतव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜೂಜಾಟ<br><b>निष्पत्तिः - </b>"अण्" (५-१-१३०)<br><b>व्युत्पत्तिः - </b>कितवस्य भावः कर्म वा<br><br>कैतव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವ್ಯಾಜ /ನೆಪ<br><b>प्रयोगाः - </b>"स्वदृशोर्जनयन्ति सान्त्वनां खुरकण्डूयनकैतवान्मृगाः"<br><b>उल्लेखाः - </b>नैष० २-२१<br><br>कैतव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಪಟ /ಅಲೀಕ /ಅಸತ್ಯ<br><b>प्रयोगाः - </b>"विशङ्कसे कैतवनर्तितं चेदन्तश्चरः पञ्चशरः प्रमाणम्"<br><b>उल्लेखाः - </b>नैष० ८-९४<br><br>

कैतवक
कैतवक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆಟದಲ್ಲಿ ನಡೆಯುವ ಮೋಸ<br><b>प्रयोगाः - </b>"मत्त कैतवकेनैव यज्जितोऽस्मि दुरोदरे"<br><b>उल्लेखाः - </b>भा० सभा० ८५-१०<br><br>

कैतवेय
कैतवेय<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಶುಮಂತನ ಮಗ ಉಲೂಕ<br><b>निष्पत्तिः - </b>"ढक्" (४-१-१२०)<br><b>व्युत्पत्तिः - </b>कितवाया अपत्यम्<br><b>प्रयोगाः - </b>"उलूकः कैतवेयश्च वीरश्चांशुमतः सुतः"<br><b>उल्लेखाः - </b>हरिवं०<br><br>

कैतव्य
कैतव्य<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಕುನಿಯ ಮಗ<br><b>प्रयोगाः - </b>"उलूक गच्छ कैतव्य पाण्डवान् सहसोमकान्"<br><b>उल्लेखाः - </b>भा० उद्योग० १६०-६<br><br>

कैदार
कैदार<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೇದಾರ ಸಂಬಂಧವಾದ /ಕೆಸರು ಗದ್ದೆಗಳಲ್ಲಿ ಬೆಳೆದ ಬತ್ತ ಗೋಧಿ ಮೊದಲಾದುದು<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>केदारस्येदम्<br><b>प्रयोगाः - </b>"कैदारा मधुरा वृष्या बल्याः पित्तनिबर्हणाः । ईषत्कषायाल्पमला गुरवः कफशुक्रलाः ॥"<br><b>उल्लेखाः - </b>सुश्रुत० सूत्र० ४६-१७<br><br>

कैदारक
कैदारक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗದ್ದೆಗಳಸಮೂಹ<br><b>निष्पत्तिः - </b>"वुञ्" (४-२-४०)<br><b>व्युत्पत्तिः - </b>केदाराणां समूहः<br><b>विस्तारः - </b>"कैदारकं स्यात् कैदार्यं क्षेत्रं कैदारिकं गणे"- अम० ।<br><br>

कैदारिक
कैदारिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗದ್ದೆಗಳಸಮೂಹ<br><b>निष्पत्तिः - </b>"ठञ्" (४-२-४१)<br><b>प्रयोगाः - </b>"कैदारिकाणामभितः समाकुलाः सहासमालोकयति स्म गोपिकाः"<br><b>उल्लेखाः - </b>माघ० १२-४२<br><br>

कैदार्य
कैदार्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗದ್ದೆಗಳಸಮೂಹ<br><b>निष्पत्तिः - </b>"यञ्" (४-२-४०)<br><br>

कैन्नर
कैन्नर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿನ್ನರ ಖಂಡದಲ್ಲಿ ವಾಸಮಾಡುವ<br><b>निष्पत्तिः - </b>"अञ्" (४-३-९३)<br><b>व्युत्पत्तिः - </b>किन्नरः किन्नरवर्षमभिजनोऽस्य<br><br>कैन्नर<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿಂಪುರುಷ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>किन्नरस्येदम्<br><br>

कैमुतिक
कैमुतिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಮುತಿಕ ನ್ಯಾಯ /ಅಧಿಕ ಪ್ರಯಾಸದಿಂದ ಸಾಧಿಸಬಹುದಾದ ಕಾರ್ಯವು ಅಲ್ಪ ಪ್ರಯತ್ನದಿಂದಲೇ ಸಾಧ್ಯವಾಗುವಲ್ಲಿ ಹೆಚ್ಚು ಪ್ರಯತ್ನದಿಂದ ಸಾಧ್ಯವೆಂಬುದನ್ನು ಬೇರೆ ಹೇಳಬೇಕೇ ಎಂಬ ಅರ್ಥದಲ್ಲಿ ಉಂಟಾದ ಒಂದು ನ್ಯಾ<br><b>निष्पत्तिः - </b>"ठक्" (४-३-७४)<br><b>व्युत्पत्तिः - </b>किमुत इत्यर्थादागतः<br><br>

कैयट
कैयट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಾತಂಜಲ ಮಹಾಭಾಷ್ಯದ ವ್ಯಾಖ್ಯಾನಕಾರರು /ಜೈಯಟರ ಮಗ<br><br>

कैरव
कैरव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶತ್ರು /ಹಗೆ<br><br>कैरव<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಮುದ /ಬಿಳಿ ನೈದಿಲೆ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>के रवो यस्य के जले रौति वा केरवो हंसः । तस्येदम्<br><br>कैरव<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಪಟಿ /ಮೋಸಗಾರ /ವಂಚಕ<br><b>विस्तारः - </b>"कैरवः कितवे रिपौ । नपुंसकं च कुमुदे" - मेदि० ।<br><br>

कैरवबन्धु
कैरवबन्धु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಮುದಗಳ ಬಂಧುವಾದ ಚಂದ್ರ<br><b>व्युत्पत्तिः - </b>कैरवस्य बन्धुः<br><br>

कैरविणी
कैरविणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿ ನೈದಿಲೆಯ ಬಳ್ಳಿ<br><br>कैरविणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸರೋವರ /ಬಿಳಿ ನೈದಿಲೆಗಳಿಂದ ಕೂಡಿದ ಪ್ರದೇಶ<br><br>कैरविणी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿ ನೈದಿಲೆಗಳಸಮೂಹ<br><b>निष्पत्तिः - </b>कैरव - "इनिः" "ङीप्" च (५-२-१३५)<br><br>

कैरविन्
कैरविन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कैरवं प्रकाश्यतयास्यास्ति<br><br>

कैरवी
कैरवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚಂದ್ರಿಕೆ /ಬೆಳದಿಂಗಳು<br><b>विस्तारः - </b>"नपुंसकं च कुमुदे चन्द्रिकायां तु कैरवी" - मेदि० ।<br><br>

कैरात
कैरात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಲಶಾಲಿಯಾದ ಪುರುಷ<br><br>कैरात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೆಲಬೇವು<br><b>निष्पत्तिः - </b>"अण्" (४-३-५३)<br><b>व्युत्पत्तिः - </b>किरातदेशे भवः<br><br>कैरात<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕಿರಾತನ ಸಂಬಂಧವಾದ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>किरातस्येदम्<br><b>प्रयोगाः - </b>"कैरातं वेशमास्थाय काञ्चनद्रुमसन्निभम्"<br><b>उल्लेखाः - </b>भा० वन० ३९-२<br><br>

कैराल
कैराल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯುವಿಳಂಗ<br><b>निष्पत्तिः - </b>अल (भूषणादौ) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>किरं पर्यन्तभूमिमलति<br><br>

कैराली
कैराली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಾಯುವಿಳಂಗ<br><b>निष्पत्तिः - </b>कैराल - गौरा० "ङीष्" (४-१-४१)<br><br>

कैलास
कैलास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಲಾಸ ಪರ್ವತ /ಬೆಳ್ಳಿಯ ಬೆಟ್ಟ<br><b>निष्पत्तिः - </b>"अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>के जले लासो लसनं दीप्तिरस्य केलसः स्फटिकः तस्यायम्<br><b>प्रयोगाः - </b>"अलकां समया चैषः कैलासः शङ्करालयः" । "कैलासस्य त्रिदशवनितादर्पणस्यातिथिः स्याः" ।<br><b>उल्लेखाः - </b>काशीखं०, मेघ० १-५८<br><br>

कैलासनाथ
कैलासनाथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಶಿವ /ಪರಮೇಶ್ವರ<br><br>कैलासनाथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರ<br><b>व्युत्पत्तिः - </b>कैलासस्य नाथः<br><b>प्रयोगाः - </b>"सामन्तसम्भावनयैव धीरः कैलासनाथं तरसा जिगीषुः" ।<br><b>उल्लेखाः - </b>रघु० ५-२८<br><br>

कैलासपति
कैलासपति<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಬೇರ<br><br>

कैलासौकस्
कैलासौकस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಲಾಸವೇ ವಾಸಸ್ಥಾನವಾಗಿ ಉಳ್ಳ ಪರಮೇಶ್ವರ<br><br>कैलासौकस्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಲಾಸವೇ ವಾಸಸ್ಥಾನವಾಗಿ ಉಳ್ಳ ಕುಬೇರ<br><b>व्युत्पत्तिः - </b>कैलासः ओको यस्य<br><br>

कैलासनिकेतन
कैलासनिकेतन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೈಲಾಸವೇ ವಾಸಸ್ಥಾನವಾಗಿ ಉಳ್ಳ ಕುಬೇರ<br><br>

कैवर्त
कैवर्त<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಸ್ತರವನು /ಮೀನು ಹಿಡಿಯುವವನು<br><b>निष्पत्तिः - </b>वृतु (वर्तने) - "अच्" (३-१-१३४) । "अण्" (४-३-१२०)<br><b>व्युत्पत्तिः - </b>के जले वर्तते । केवर्ताः मत्स्याः । तेषामयं घातकः ।<br><b>प्रयोगाः - </b>"निषादो मार्गवं सूते दाशं नौकर्मजीविनम् । कैवर्तमिति यं प्राहुः आर्यावर्तनिवासिनः ॥"<br><b>उल्लेखाः - </b>मनु० १०-३४<br><b>विस्तारः - </b>"कैवर्ते दाशधीवरौ" - अम० ।<br><br>

कैवर्ती
कैवर्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಸ್ತರವನ ಹೆಂಡತಿ<br><br>

कैवर्तीमुस्त
कैवर्तीमुस्त<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನ್ನಾರಿಗೆಡ್ಡೆಯ ಒಂದು ಭೇದ<br><br>

कैवर्तीमुस्तक
कैवर्तीमुस्तक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೊನ್ನಾರಿಗೆಡ್ಡೆಯ ಒಂದು ಭೇದ<br><b>निष्पत्तिः - </b>स्वार्थे "कः"<br><br>

कैवल्य
कैवल्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಆತ್ಯಂತಿಕ ದುಃಖನಾಶರೂಪವಾದ ಮೋಕ್ಷ /ಸಂಸಾರಬಂಧವಿಮೋಚನೆ<br><b>निष्पत्तिः - </b>"ष्यञ्" (५-१-१२४)<br><b>व्युत्पत्तिः - </b>बन्धविरहात् केवलस्य भावः<br><br>

कैशिक
कैशिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೃಂಗಾರ ರಸ<br><br>कैशिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅನುರಾಗ /ಪ್ರೇಮ<br><b>निष्पत्तिः - </b>"ठक्" (४-४-१०२)<br><b>व्युत्पत्तिः - </b>केशेषु केशविन्यासादौ साधुः<br><br>कैशिक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕ್ರಥನ ಸಹೋದರ /ವಿದರ್ಭ ರಾಜನ ಮಗ<br><br>कैशिक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೇಶಸಮೂಹ /ತಲೆಯ ಕೂದಲಿನ ಸಮೂಹ<br><b>निष्पत्तिः - </b>"ठक्" (४-२-४७)<br><b>व्युत्पत्तिः - </b>केशानां समूहः<br><br>

कैशिकी
कैशिकी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಾಟಕಾದಿ ರೂಪಕಗಳಲ್ಲಿ ಬರುವ ೪ ವೃತ್ತಿಗಳಲ್ಲೊಂದು<br><b>प्रयोगाः - </b>"शृङ्गारी कैशिकी वीरे सात्वत्त्यारभटी पुनः । रसे रौद्रे च बीभत्से वृत्तिः सर्वत्र भारती ॥"<br><b>उल्लेखाः - </b>सा० द० ६-१२२<br><br>

कैशोर
कैशोर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಿಶೋರಭಾವ /ಬಾಲ್ಯ /೧೧ ರಿಂದ ೧೫ ರೊಳಗಿನ ವಯಸ್ಸು<br><b>निष्पत्तिः - </b>"अञ्" (५-१-१२९)<br><b>व्युत्पत्तिः - </b>किशोरस्य भावः<br><b>प्रयोगाः - </b>"कौमारं पञ्चमाब्दान्तं पौगण्डं दशमावधि । कैशोरमापञ्चदशात् यौवनं तु ततः परम् ॥"<br><br>

कैश्य
कैश्य<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಲೆಯ ಕೂದಲಿನ ಸಮೂಹ /ತುರುಬು<br><b>निष्पत्तिः - </b>"यञ्"(४-२-४८)<br><b>व्युत्पत्तिः - </b>केशानां समूहः<br><b>प्रयोगाः - </b>"रचय चारुमति स्तनयोर्वृतिं कलय केशिनि कैश्यमसंयतम्" ।<br><b>उल्लेखाः - </b>नैष० ४-११४<br><br>

कोक
कोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಕ್ರವಾಕ ಪಕ್ಷಿ<br><b>निष्पत्तिः - </b>कुक (आदाने) - "अच्" (३-१-१३४)<br><br>कोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿಷ್ಣು<br><b>विस्तारः - </b>"कोकः पुराणपुरुषः" - त्रिकाण्ड० ।<br><br>कोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೋಳ<br><b>प्रयोगाः - </b>"वने यूथपरिभ्रष्टा मृगी कोकैरिवार्दिता"<br><b>उल्लेखाः - </b>रामा०<br><br>कोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><br>कोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಡೂಕ /ಕಪ್ಪೆ<br><br>कोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಖರ್ಜೂರದ ಮರ<br><br>कोक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಲ್ಲಿ /ಗೌಳಿ<br><b>विस्तारः - </b>"कोकश्चक्रे वृके ज्येष्ठ्यां खर्जूरीद्रुमदर्दुरे" - मेदि० ।<br><br>

कोकदेव
कोकदेव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪೋತ /ಪಾರಿವಾಳದ ಹಕ್ಕಿ<br><b>निष्पत्तिः - </b>दिवु (क्रीडायाम्) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कोक इव दीव्यति<br><br>

कोकनद
कोकनद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಪು ನೈದಿಲೆ<br><b>निष्पत्तिः - </b>णद (अव्यक्ते शब्दे) - "कः" (वा० ३-२-५)<br><b>व्युत्पत्तिः - </b>कोकान् नदति नादयति (अन्तर्भावितण्यर्थः)<br><b>प्रयोगाः - </b>"दरोद्गतैः कोकनदौघकोरकैः धृतप्रवालाङ्कुरसञ्चयश्च यः"<br><b>उल्लेखाः - </b>नैष० १-११२<br><br>कोकनद<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂದಾವರೆ /ರಕ್ತೋತ್ಪಲ<br><b>प्रयोगाः - </b>"व्याकोशकोकनदतां दधते नलिन्यः"<br><b>उल्लेखाः - </b>माघ० ४-४६<br><b>विस्तारः - </b>"अथ कोकनदं रक्तकुमुदे रक्तपङ्कजे" - मेदि० ।<br><br>

कोकनदच्छवि
कोकनदच्छवि<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಪು ಬಣ್ಣ<br><br>कोकनदच्छवि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೆಂಪು ಬಣ್ಣದ<br><b>व्युत्पत्तिः - </b>कोकनदस्य छविरिव छविर्यस्य<br><br>

कोकबन्धु
कोकबन्धु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸೂರ್ಯ<br><b>व्युत्पत्तिः - </b>कोकयोः चक्रवाकयोः बन्धुरिव (मेलनकारित्वात्)<br><br>

कोकाह
कोकाह<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶ್ವೇತಾಶ್ವ /ಬಿಳಿಯ ಕುದುರೆ<br><b>विस्तारः - </b>"सिते तु कर्ककोकाहौ" - अभि० चि० ।<br><br>

कोकिल
कोकिल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆ<br><b>निष्पत्तिः - </b>कुक (आदाने) - "इलच्" (उ० १-५४)<br><b>प्रयोगाः - </b>"चूताङ्कुरास्वादकषायकण्ठः पुंस्कोकिलो यन्मधुरं चुकूज"<br><b>उल्लेखाः - </b>कुमा० ३-३२<br><br>

कोकिला
कोकिला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಣ್ಣು ಕೋಗಿಲೆ<br><b>प्रयोगाः - </b>""विधुविरोधितिथेरभिधायिनीं ननु न किं पुनरिच्छसि कोकिलाम्"<br><b>उल्लेखाः - </b>नैष० ४-१०७<br><br>कोकिला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಗಾರ /ಅರ್ಧ ಬೆಂದಿರುವ ಕೊಳ್ಳಿ<br><b>विस्तारः - </b>"स्तादङ्गारे कोलिलाज्झलौ" - त्रिकाण्ड० ।<br><br>

कोकिलक
कोकिलक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>೧೭ನೆಯ ಛಂದಸ್ಸಿನ ಒಂದು ವೃತ್ತ<br><b>प्रयोगाः - </b>"हयदशभिर्नजौ भजजलागिति नत्कुटकम् । मुनिगुहकार्णवैः कृतयतिं वद कोकिलकम् ॥"<br><b>उल्लेखाः - </b>वृ० र०<br><br>

कोकिलाक्ष
कोकिलाक्ष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಳವಳಿಕೆ ಗಿಡ<br><b>निष्पत्तिः - </b>"अच्" (५-४-७६)<br><b>व्युत्पत्तिः - </b>कोकिलस्याक्षीव रक्तपुष्पमस्य<br><br>

कोकिलावास
कोकिलावास<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಗಿಲೆಗಳಿಗೆ ವಾಸಸ್ಥಾನವಾದ ಮಾವಿನ ಮರ<br><b>व्युत्पत्तिः - </b>कोकिलानामावासः<br><br>

कोकिलासन
कोकिलासन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರುದ್ರಯಾಮಲದಲ್ಲಿ ಹೇಳಿರುವ ಆಸನಗಳಲ್ಲೊಂದು ಭೇದ<br><b>प्रयोगाः - </b>"निरुन्ध्यात् वायुसञ्चारं कोकिलाख्यासनेन च । ऊर्ध्वं हस्तद्वयं कृत्वा तदग्रे पादयोः सुधीः । बद्ध्वाङ्गुष्ठद्वयं नाथ शनैः शनैः प्रकारयेत् । पद्मासनं समाकृत्य कूर्परोपरि संस्थितः ॥"<br><br>

कोलिलेक्षु
कोलिलेक्षु<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಪ್ಪು ಬಣ್ಣದ ಒಂದು ಜಾತಿಯ ಕಬ್ಬು<br><b>व्युत्पत्तिः - </b>कोकिल इव कृष्णः इक्षुः<br><br>

कोङ्कण
कोङ्कण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಂಕಣ ದೇಶ<br><b>प्रयोगाः - </b>"अथापरे जनपदा दक्षिणा भरतर्षभ । कौकुट्टस्तथा चोलाः कोङ्कणा मालवा नराः ॥"<br><b>उल्लेखाः - </b>भा० भीष्म० ९-६०<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>कोङ्कण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಂಕಣ ದೇಶದ ದೊರೆಗಳು<br><b>निष्पत्तिः - </b>"अञ्" (४-१-१६६) । अञो लुक् (२-४-६२)<br><b>व्युत्पत्तिः - </b>कोङ्कणानां राजानः<br><b>प्रयोगाः - </b>"शरैरभ्यार्चितास्तेन कोङ्कणाः समराङ्गणे"<br><b>उल्लेखाः - </b>याद० २२-२१२<br><br>कोङ्कण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೊಂಕಣ ದೇಶದ ಜನರು<br><b>विस्तारः - </b>"कोङ्कणः स्यात् जनपदे कोङ्कणन्त्वायुधान्तरे" - हेम० ।<br><br>कोङ्कण<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಆಯುಧ<br><br>

कोङ्कणा
कोङ्कणा<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ರೇಣುಕಾದೇವಿ /ಪರಶುರಾಮನ ತಾಯಿ<br><br>

कोङ्कणासुत
कोङ्कणासुत<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪರಶುರಾಮ<br><br>

कोच
कोच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಸ್ತರವನಿಂದ ಕಟುಕರ ಹೆಂಗಸಿನಲ್ಲಿ ಹುಟ್ಟಿದವನು /ಒಬ್ಬ ಬೆರಕೆ ಜಾತಿಯವನು<br><br>कोच<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಕೋಚ ಹೊಂದುವುದು /ಚಿಕ್ಕದಗುವುದು /ಇಂಗುವುದು<br><b>निष्पत्तिः - </b>कुच (सम्पर्चनादौ) - भावे "घञ्" (३-३-१८)<br><br>कोच<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಸಂಕೋಚ ಹೊಂದುವ /ಚಿಕ್ಕದಾಗುವ /ಇಂಗುವ<br><b>निष्पत्तिः - </b>कुच - कर्त० "णः" (३-२-१४०)<br><br>

कोजागर
कोजागर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಶ್ವಯುಜಮಾಸದ ಹುಣ್ಣಿಮೆ<br><br>

कोट
कोट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗ /ಕೋಟೆ<br><b>निष्पत्तिः - </b>कुट (कौटिल्ये) - अधि० "घञ्" (३-३-१२१)<br><br>कोट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೌಟಿಲ್ಯ /ವಕ್ರವಾಗಿರುವುದು<br><b>निष्पत्तिः - </b>कुट - भावे "घञ्"<br><br>कोट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಅಡಕೆಮರ<br><b>विस्तारः - </b>"करमट्टस्तन्तुसारो गुवाकः कोट इत्यपि" - त्रिकाण्ड० ।<br><br>

कोटर
कोटर<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮರದ ಪೊಟರೆ<br><b>निष्पत्तिः - </b>रा (दाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कोटं राति<br><b>प्रयोगाः - </b>"विदूरथः प्रतिभयमास्यकन्दरं चलत्फणाधरमिव कोटरं तरुः"<br><b>उल्लेखाः - </b>माघ० १७-१७<br><br>कोटर<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಂದರ /ಗುಹೆ<br><br>कोटर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರ<br><br>कोटर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನಕುಲ /ಮುಂಗುಸಿ<br><br>कोटर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಇಂದ್ರಗೋಪಕೀಟ<br><br>कोटर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಟೆ<br><b>निष्पत्तिः - </b>रा (दाने) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कोटिं राति<br><b>विस्तारः - </b>"कोटिरः स्यात् जटासटा" -त्रिकाण्ड० । "कोटिरः पुंसि नकुले शक्रगोपकशक्रयोः" - मेदि० ।<br><br>

कोटरी
कोटरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಗ್ನಳಾದ ಹೆಂಗಸು /ಬೆತ್ತಲೆಯ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>री (गतौ) - "क्विप्" (३-२-७६)<br><b>व्युत्पत्तिः - </b>कोटं कौटिल्यं रिणाति<br><br>कोटरी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ<br><br>

कोटवी
कोटवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಗ್ನಳಾದ ಹೆಂಗಸು /ಬೆತ್ತಲೆಯ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>वा (गतौ) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कोटं कौटिल्यं दुर्गं वा वाति<br><br>कोटवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ<br><br>

कोटि
कोटि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅಗ್ರಭಾಗ /ತುದಿ<br><b>निष्पत्तिः - </b>कुट (कौटिल्ये) - "इः" (उ० ४-१३८)<br><b>प्रयोगाः - </b>"नुनुदे तनुकण्डुपण्डितः पटुचञ्चत्पुटकोटिकुट्टनैः"<br><b>उल्लेखाः - </b>नैष० २-४<br><br>कोटि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಲ್ಲಿನ ತುದಿ<br><b>प्रयोगाः - </b>"तेन भूमिनिहितैककोटि तत्कार्मुकं च बलिनाधिरोपितम्"<br><b>उल्लेखाः - </b>रघु० ११-८१<br><br>कोटि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ನೂರು ಲಕ್ಷ ಸಂಖ್ಯೆ<br><b>प्रयोगाः - </b>"आलोकितामपि पुनः पिबतां दृशैनामिच्छापि गच्छति न वत्सरकोटिभिर्वः"<br><b>उल्लेखाः - </b>नैष० ११-२४<br><br>कोटि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಅತ್ಯುತ್ಕರ್ಷ /ಅತಿಶಯ<br><b>प्रयोगाः - </b>"अनेन सार्धं तव यौवनेन कोटिं परामच्छिदुरोऽध्यरोहत्"<br><b>उल्लेखाः - </b>नैष० ८-६१<br><br>कोटि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಶಸ್ತ್ರಾಸ್ತ್ರಗಳ ಅಂಚು /ಕತ್ತಿ ಮೊದಲಾದುವುಗಳ ಅಲಗು<br><b>प्रयोगाः - </b>"हुतान्यपि श्येननखाग्रकोटिव्यासक्तकेशानि चिरेण पेतुः"<br><b>उल्लेखाः - </b>रघु० ७-४६<br><br>कोटि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕಮಾನಿನ ಆಕಾರದಲ್ಲಿರುವ ಒಂದು ವಸ್ತುವಿನ ಎರಡೂ ಕಡೆಗಳ ಕೋಡುಗಳು /ಅರ್ಧಚಂದ್ರನ ಎರಡು ಕಡೆಗಳ ತುದಿಯ ಭಾಗ<br><b>प्रयोगाः - </b>"आवर्जितजटामौलिविलम्बिंशशिकोटयः"<br><b>उल्लेखाः - </b>कुमा० २-२६<br><br>कोटि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ತ್ರಿಕೋಣಮಿತಿಯ ಒಂದು ರೇಖೆ<br><b>प्रयोगाः - </b>"कोटिज्यया विभज्याप्ते छाया कर्णवहर्दले"<br><b>उल्लेखाः - </b>सू० सि० ३-२१<br><br>कोटि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪೂರ್ವಪಕ್ಷ /ವಿಷಯನಿರ್ಣಯಕ್ಕಾಗಿ ಮಾಡುವ ಏಕಪಕ್ಷವಾದ<br><br>कोटि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಂಶಯದ ಪ್ರಕಾರ<br><b>प्रयोगाः - </b>"विप्रतिपत्तिवाक्यजन्यकोट्युपस्थितिः"<br><br>कोटि<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ವಸ್ತುವಿನ ವಿಭಾಗ /ವಸ್ತುವಿನ ವರ್ಗ<br><b>प्रयोगाः - </b>"प्रजाकोटिः, शिष्यकोटिः"<br><br>

कोटिजित्
कोटिजित्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಳಿದಾಸ ಕವಿ<br><b>व्युत्पत्तिः - </b>कोटिं जितवान्<br><b>विस्तारः - </b>"रघुकारः कालिदासो मेधारुद्रश्च कोटिजित्" - त्रिकाण्ड० ।<br><br>

कोटितीर्थ
कोटितीर्थ<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾಕಾಳೇಶ್ವರ ಸನ್ನಿಧಿಯಲ್ಲಿರುವ ಒಂದು ತೀರ್ಥ<br><b>व्युत्पत्तिः - </b>कोटिस्तीर्थान्यत्र<br><br>

कोटिपात्र
कोटिपात्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೋಣಿ ನಡೆಸುವ ಜಲ್ಲೆ<br><br>कोटिपात्र<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಚುಕ್ಕಾಣಿ ಹಲಗೆ<br><b>व्युत्पत्तिः - </b>कोटिरग्रं पात्रे जलाशयेऽस्य<br><br>

कोटिवर्ष
कोटिवर्ष<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣಪುರ /ದೇವಿಕೋಟೆ /ಬಾಣಾಸುರನ ನಗರ<br><b>विस्तारः - </b>"देवीकोटो बाणपुरं कोटिवर्षमुषावनम् । स्याच्छोणितपुरं च" - त्रिकाण्ड० ।<br><br>

कोटिश
कोटिश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹೆಂಟೆಯನ್ನು ಒಡೆಯುವ ಮರದ ಕೊಡತಿ<br><b>विस्तारः - </b>"कोटिशो लोष्ठभेदनः" - अम०<br><br>कोटिश<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಾಸುಕಿಯ ವಂಶದಲ್ಲಿ ಹುಟ್ಟಿದ ಒಂದು ಸರ್ಪ<br><br>

कोटिशस्
कोटिशस्<br><br><b>पदविभागः - </b>अव्ययम्<br><b>कन्नडार्थः - </b>ಕೋಟಿಗಟ್ಟಲೆಯಲ್ಲಿ /ಕೋಟಿಸಂಖ್ಯೆಯಲ್ಲಿ<br><b>निष्पत्तिः - </b>कोटि - "शस्" (५-४-४३)<br><b>प्रयोगाः - </b>"शक्योऽस्य मन्युर्भवता विनेतुं गाः कोटिशः स्पर्शयता घटोघ्नीः"<br><b>उल्लेखाः - </b>रघु० २-४९<br><br>

कोटी
कोटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಟಿಸಂಖ್ಯೆ /ಒಂದು ನೂರು ಲಕ್ಷ<br><b>प्रयोगाः - </b>"प्रतोदैश्चापकोटिभिः हुकारैः साधु वाहितैः"<br><b>उल्लेखाः - </b>भा० द्रोण० ८९-३०<br><br>

कोटीर
कोटीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಜಟೆ<br><br>कोटीर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕಿರೀಟ<br><b>निष्पत्तिः - </b>ईर (गतौ) - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कोटिमीरयति<br><b>प्रयोगाः - </b>"कठोरे कोटीरे स्खलसि जहि जम्भारिमुकुटम्"<br><b>उल्लेखाः - </b>आनन्दल०<br><br>

कोट्ट
कोट्ट<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗ /ಕೋಟೆ<br><b>निष्पत्तिः - </b>कुट्ट (प्रतापने) - "घञ्" (३-३-१९) बाहु० गुणः ।<br><br>

कोट्टवी
कोट्टवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ನಗ್ನಳಾದ ಹೆಂಗಸು /ಬೆತ್ತಲೆಯ ಹೆಂಗಸು<br><b>निष्पत्तिः - </b>वा (गतौ) - "कः" (३-२-३)<br><b>व्युत्पत्तिः - </b>कोट्टं वाति<br><br>कोट्टवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಾದೇವಿ /ಪಾರ್ವತಿ<br><b>विस्तारः - </b>"कोट्टवी बाभ्रवी कैटभी कैटभा यादवी कर्बुरी चेश्वरी चेश्वरा" - त्रिकाण्ड० ।<br><br>कोट्टवी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಬಾಣಾಸುರನ ತಾಯಿ<br><br>

कोट्टार
कोट्टार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಾವಿ<br><b>निष्पत्तिः - </b>कुट्ट (छेदने)- "आरक्" बाहु० ।<br><br>कोट्टार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭದ್ರಮುಸ್ತೆ /ಕೊನ್ನಾರಿ ಗೆಡ್ಡೆ<br><b>विस्तारः - </b>"कोट्टारौ कूपनागरौ" - त्रिकाण्ड० ।<br><br>कोट्टार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪುಷ್ಕರಿಣಿಯ ತೀರ /ಸರೋವರದ ಸೋಪಾನ<br><b>विस्तारः - </b>"कोट्टारो नागरे कूपे पुष्करिण्याश्च पाटके" - हेम० ।<br><br>कोट्टार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಟಿಂಗ /ಕಾಮುಕ /ಸ್ತ್ರೀಲೋಲ<br><br>कोट्टार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಟೆಯಿಂದ ಭದ್ರವಾದ ನಗರ<br><br>

कोठ
कोठ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮಂಡಲಾಕಾರವಾಗಿ ಏಳುವ ಒಂದು ವಿಧ ಚರ್ಮವ್ಯಾಧಿ /ಹುಳುಕಡ್ಡಿ /ದದ್ರುಕುಷ್ಠ<br><b>निष्पत्तिः - </b>कुठि (प्रतिघाते) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुण्ठति<br><br>

कोण
कोण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಿಟೀಲು /ನಗಾರಿ ಮೊದಲಾದುವನ್ನು ನುಡಿಯಿಸುವ ಸಾಧನ<br><b>निष्पत्तिः - </b>कुण (शब्दोपकरणयोः) - "घञ्" (३-३-१२१)<br><b>व्युत्पत्तिः - </b>कुण्यते<br><b>प्रयोगाः - </b>"सुवर्णकोणाभिहतः प्राणदद्यामदुन्दुभिः"<br><b>उल्लेखाः - </b>रामा०<br><br>कोण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಣೆ /ಕೊಠಡಿ /ಮನೆ ಮೊದಲಾದುವುಗಳ ಒಂದು ಭಾಗ<br><br>कोण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶಸ್ತ್ರ ಮತ್ತು ಅಸ್ತ್ರಗಳ ತುದಿ /ಕತ್ತಿ ಮೊದಲಾದುವುಗಳ ತುದಿ<br><br>कोण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ವಾದ್ಯ<br><br>कोण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಲು /ದೊಣ್ಣೆ<br><b>विस्तारः - </b>"कोणो वाद्यप्रभेदे स्यात् वीणादीनां च वादने । एकदेशे गृहादीनामश्रौ च लगुडेऽपि च" - मेदि० ।<br><br>कोण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕುಜಗ್ರಹ<br><b>विस्तारः - </b>"कोणो वीणादिवादने । लगुडेऽश्रौ लोहिताङ्गे" - हेम० ।<br><br>कोण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶನಿಗ್ರಹ<br><b>विस्तारः - </b>"कोणोऽश्रौ लगुडेऽर्कजे" - नानार्थर० ।<br><br>कोण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವಿದಿಕ್ಕು /ಎರಡು ದಿಕ್ಕುಗಳ ಮಧ್ಯಭಾಗ<br><br>कोण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಮೂಲೆ /ಭಿನ್ನ ಭಿನ್ನ ದಿಕ್ಕುಗಳಿಗೆ ಹೋಗುವ ರೇಖೆಗಳ ಸಂಧಿಸ್ಥಾನ<br><br>

कोणकुण
कोणकुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿಗಣೆ<br><b>निष्पत्तिः - </b>कुण (शब्दोपकरणयोः) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कोणे मस्तकैकदेशे कुणति<br><br>

कोणाघात
कोणाघात<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಲಕ್ಷ ಡವಣೆಗಳನ್ನೂ ಹತ್ತು ಸಾವಿರ ನಗಾರಿಗಳನ್ನೂ ಒಂದೇ ಸಮಯದಲ್ಲಿ ಬಾರಿಸುವುದು<br><b>विस्तारः - </b>"ढक्काशतसहस्राणि भेरीशतशतानि च । एकदा यत्र वाद्यन्ते कोणाघातः स उच्यते ॥" - भरतः ।<br><br>

कोणि
कोणि<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊಂಡು ಕೈಯುಳ್ಳವನು /ಹಸ್ತವಿಲ್ಲದವನು<br><br>

कोथ
कोथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ವಿಧ ನೇತ್ರರೋಗ<br><b>निष्पत्तिः - </b>कुथ (पूतीभावे) - "घञ्" (३-३-१९)<br><br>कोथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಮಾಂಸ /ಕೊಳೆತ ಮಾಂಸ<br><br>कोथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದುರ್ಗಂಧ /ಕೆಟ್ಟ ವಾಸನೆ<br><br>कोथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಭಗಂದರ ರೋಗ<br><b>निष्पत्तिः - </b>कुथ - कर्त० "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कुथ्नति क्षिणोति गुदम्<br><br>कोथ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮೊಸರನ್ನು ಕಡೆಯುವುದು<br><br>कोथ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ನೋವಿನಿಂದ ಪೀಡಿಸಲ್ಪಟ್ಟ<br><b>विस्तारः - </b>"कोथस्तु मथने नेत्ररुग्भेदे शठिते त्रिषु" - हेम० ।<br><br>

कोदण्ड
कोदण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದೇಶ<br><br>कोदण्ड<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಧನೂರಾಶಿ<br><br>कोदण्ड<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧನಸ್ಸು /ಬಿಲ್ಲು<br><b>निष्पत्तिः - </b>कु (शब्दे) - "विच्" (३-२-७५)<br><b>व्युत्पत्तिः - </b>कौर्दण्डोऽस्य<br><b>प्रयोगाः - </b>"कोदण्डपाणि निनदत्प्रतिरोधकानामापातदुष्प्रसहमाविरभूदनीकम्" । "उद्दण्डे भुजदण्डे तव कोदण्डे परिस्थुरति । अरिमण्डलरविमण्डलरम्भाकुचमण्डलानि वेपन्ते" ।<br><b>उल्लेखाः - </b>१) माल० ५-१०<br><br>कोदण्ड<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಧನುಸ್ಸಿನಂತಿರುವ ಭ್ರೂಲತೆ /ಹುಬ್ಬು<br><b>विस्तारः - </b>"अथ कोदण्डं चापे ना नीवृदन्तरे । भ्रुव्यथो" - मेदि० ।<br><br>

कोद्रव
कोद्रव<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾರಕಧಾನ್ಯ<br><b>निष्पत्तिः - </b>द्रु (गतौ) - "अप्" (३-३-५७) पृषो० ।<br><b>व्युत्पत्तिः - </b>केन वायुना द्रवति<br><b>प्रयोगाः - </b>"अश्राद्धीयानि धान्यानि कोद्रवाः पुलकास्तथा"<br><b>उल्लेखाः - </b>भा०<br><br>

कोप
कोप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪ /ಸಿಟ್ಟು<br><b>प्रयोगाः - </b>"पौनःपुन्यादस्रगन्धेन मत्तो मूद्नन् कोपाल्लोकमायोधनोर्व्याम्"<br><b>उल्लेखाः - </b>माघ० १८-५७<br><br>कोप<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶೃಂಗಾರರಸಕ್ಕೆ ಅಂಗವಾದ ಪ್ರಣಯ ಮತ್ತು ಈರ್ಷ್ಯೆಗಳಿಂದ ಉಂಟಾಗುವ ಮುನಿಸು<br><b>प्रयोगाः - </b>"मानः कोपः स तु द्वेधा प्रणयेर्ष्यासमुद्भवः । द्वयोः प्रणयमानः स्यात् प्रमोदे सुमहत्यपि ॥"<br><b>उल्लेखाः - </b>सा० द० १-१९७<br><br>

कोपक्रम
कोपक्रम<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪದ ಕ್ರಮ /ಕೋಪದ ರೀತಿ<br><br>कोपक्रम<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಬ್ರಹ್ಮನಿಂದ ಪ್ರಾರಂಭಿಸಲ್ಪಡುವ ಜಗತ್ತಿನ ಸೃಷ್ಟಿ<br><b>निष्पत्तिः - </b>उप + क्रमु (पादविक्षेपे) - कर्म० "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>कस्य ब्रह्मणः उपक्रमः<br><br>

कोपन
कोपन<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ಅಸುರ<br><b>प्रयोगाः - </b>"शरभः शलभश्चैव कुपनः कोपनः क्रथः"<br><b>उल्लेखाः - </b>हरिवं०<br><br>कोपन<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪವನ್ನುಂಟುಮಾಡುವುದು /ರೇಗಿಸುವುದು<br><b>निष्पत्तिः - </b>कुप +‍णिच् - भावे "ल्युट्" (३-३-११७)<br><br>कोपन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪವನ್ನುಂಟುಮಾಡುವ /ಸಿಟ್ಟಿಗೆಬ್ಬಿಸುವ /ರೇಗಿಸುವ<br><b>निष्पत्तिः - </b>कुप +‍णिच् - "ल्युः" (३-१-१३४)<br><br>कोपन<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪದ ಸ್ವಭಾವದ<br><b>निष्पत्तिः - </b>कुप - ताच्छील्ये "युच्" (३-२-१५१)<br><b>प्रयोगाः - </b>"आसीत् विभावसुर्नाम महर्षिः कोपनो भृशम्"<br><b>उल्लेखाः - </b>भा० आदि० २९-१६<br><br>

कोपना
कोपना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪ ಸ್ವಭಾವದ ಹೆಂಗಸು<br><b>प्रयोगाः - </b>"कयासि कामिन् सुरतापराधात् पादानतः कोपनयावधतः"<br><b>उल्लेखाः - </b>कुमा० ३-८<br><br>

कोपनीय
कोपनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪಗೊಳಿಸಲ್ಪಡುವ<br><br>कोपनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪಗೊಳಿಸಲ್ಪಡಲು ಯೋಗ್ಯವಾದ<br><br>कोपनीय<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪಗೊಳಿಸಲ್ಪಡಲು ಶಕ್ಯವಾದ<br><b>निष्पत्तिः - </b>कुप (क्रोधे) + णिच् - "अनीयर्" (३-१-९६)<br><br>

कोपयितव्य
कोपयितव्य<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>कोपनीय ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>कुप (क्रोधे) + णिच् - "तव्यः" (३-१-९६)<br><br>

कोपयत्
कोपयत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪವನ್ನುಂಟುಮಾಡುತ್ತಿರುವ /ಸಿಟ್ಟಿಗೆಬ್ಬಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कुप (क्रोधे) + णिच् - "शतृ" (३-२-१२४)<br><br>

कोपयन्ती
कोपयन्ती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪವನ್ನುಂಟುಮಾಡುತ್ತಿರುವ /ಸಿಟ್ಟಿಗೆಬ್ಬಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कोपयमाना
कोपयमाना<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪವನ್ನುಂಟುಮಾಡುತ್ತಿರುವ /ಸಿಟ್ಟಿಗೆಬ್ಬಿಸುತ್ತಿರುವ<br><b>निष्पत्तिः - </b>कुप (क्रोधे) + णिच् - "शानच्" (३-२-१२४)<br><br>

कोपयितृ
कोपयितृ<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪವುಂಟುಮಾಡುವ /ರೇಗಿಸುವ<br><b>निष्पत्तिः - </b>कुप (क्रोधे) + णिच् - "तृच्" (३-१-१३३)<br><br>

कोपयित्री
कोपयित्री<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪವುಂಟುಮಾಡುವ /ರೇಗಿಸುವ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-५)<br><br>

कोपवत्
कोपवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪವುಳ್ಳ /ರೇಗಿದ<br><b>निष्पत्तिः - </b>"मतुप्" (५-२-९४)<br><b>व्युत्पत्तिः - </b>कोपोऽस्यास्ति<br><br>

कोपवती
कोपवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪವುಳ್ಳ /ರೇಗಿದ<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><b>प्रयोगाः - </b>"कोपवत्यनुनयानगृहीत्वा"<br><b>उल्लेखाः - </b>माघ० १०-२९<br><br>

कोपित
कोपित<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರೇಗುವುದು /ಸಿಟ್ಟೆಬ್ಬಿಸುವುದು<br><b>निष्पत्तिः - </b>कुप (क्रोधे) + णिच् - भावे "क्तः" (३-३-११४)<br><br>कोपित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ರೇಗಿಸಲ್ಪಟ್ಟ /ಕೋಪಗೊಳಿಸಲ್ಪಟ್ಟ<br><b>निष्पत्तिः - </b>कुप (क्रोधे) + णिच् - कर्म० "क्तः" (३-२-१०२)<br><b>प्रयोगाः - </b>"कोपितं विरहखेदितचित्ता कान्तमेव कलयन्त्यनुनिन्ये"<br><b>उल्लेखाः - </b>माघ० १०-२९<br><br>

कोपितवत्
कोपितवत्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪಗೊಳಿಸಿದವನು /ರೇಗಿಸಿದವನು<br><b>निष्पत्तिः - </b>कुप (क्रोधे) + णिच् - "क्तवतुः" (३-२-१०२)<br><br>

कोपितवती
कोपितवती<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಕೋಪಗೊಳಿಸಿದವಳು<br><b>निष्पत्तिः - </b>स्त्रियां "ङीप्" (४-१-६)<br><br>

कोपिन्
कोपिन्<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ಪಾರಿವಾಳದ ಹಕ್ಕಿ<br><br>कोपिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪಿಸಿಕೊಳ್ಳತಕ್ಕವನು<br><b>निष्पत्तिः - </b>कुप (क्रोधे) - "णिनिः" (३-३-१७०)<br><b>व्युत्पत्तिः - </b>अवश्यं कुप्यति<br><br>कोपिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಕೋಪವುಂಟುಮಾಡುವ<br><b>निष्पत्तिः - </b>कुप + णिच् - "णिनिः"(३-१-१३४)<br><b>व्युत्पत्तिः - </b>कोपयति<br><br>

कोमल
कोमल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಲ /ನೀರು<br><b>निष्पत्तिः - </b>कु (शब्दे) - "कलः" मुडागमश्च (उ० १-१०६)<br><br>कोमल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೃದುವಾದ /ಮೆದುವಾದ /ಮೆತ್ತನೆಯ<br><br>कोमल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮನೋಹರವಾದ /ರಮಣೀಯವಾದ<br><b>प्रयोगाः - </b>"निशा च शय्या च शशाङ्ककोमला"<br><b>उल्लेखाः - </b>नैष० १-४९<br><br>कोमल<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮಧುರವಾದ /ಇಂಪಾದ<br><b>प्रयोगाः - </b>"अनवद्यवाद्यलयगामि कोमलं नवगीतमप्यनवगीततां दधत्"<br><b>उल्लेखाः - </b>माघ० १३-६६<br><br>

कोमला
कोमला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಾಲೆಗಿಡ<br><br>

कोमलक
कोमलक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಾವರೆಯ ದಂಟು<br><b>निष्पत्तिः - </b>कोमल - सञ्ज्ञायां "कन्"<br><br>कोमलक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>कोमल ಪದದ ಅರ್ಥ<br><b>निष्पत्तिः - </b>स्वार्थे "कः"<br><br>

कोमासिका
कोमासिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಪಕ್ಷಿಗಳನ್ನು ಹಿಡಿಯುವ ಬಲೆ<br><b>निष्पत्तिः - </b>आस (उपवेशने) - "ण्वुल्" (३-१-१३३) । स्त्रियां "टाप्"<br><b>व्युत्पत्तिः - </b>कु ईषत् उमेव अतसीवृक्ष इव आस्ते<br><br>

कोयष्टि|कोयष्टिक
कोयष्टि (क)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ನೀರು ನಡಗೆಯ ಉದ್ದದ ಕಾಲುಗಳುಳ್ಳ ಬಿಳಿಯ ಕೊಕ್ಕರೆ /ಬಕಪಕ್ಷಿ<br><b>निष्पत्तिः - </b>पृषो० । स्वार्थे "कन्" (५-३-७५)<br><b>व्युत्पत्तिः - </b>कं जलं यष्टिरिवास्य<br><b>प्रयोगाः - </b>"प्रतुदान् जालपादांश्च कोयष्टिनखविष्किरान्" । "काश्मर्याः कृतमालमुद्गतजलं कोयष्टिकष्टीकते" ।<br><b>उल्लेखाः - </b>मनु० ५-१३, मालती० ९-७<br><br>

कोयष्टिभ
कोयष्टिभ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬಿಳಿಯ ಕೊಕ್ಕರೆ /ಬಕಪಕ್ಷಿ<br><br>

कोर
कोर<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶರೀರಚಲನೆಯನ್ನುಂಟುಮಾಡುವ ಬೆರಳು ಮಂಡಿ ಮೊಣಕೈ ಮುಂತಾದುವುಗಳ ೮ ವಿಧ ಸಂಧಿಗಳಲ್ಲೊಂದು<br><b>निष्पत्तिः - </b>कुल (संस्त्याने) - "अच्" (३-१-१३४) । लस्य रः ।<br><br>

कोरक
कोरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹೂವಿನ ಮೊಗ್ಗು<br><b>निष्पत्तिः - </b>कुर (शब्दे) - "वुन्" (उ० ५-३५)<br><b>व्युत्पत्तिः - </b>कुर्यते<br><b>प्रयोगाः - </b>"मरुदवनिरुहां रजो वधूभ्यः समुपहरन् चिचकार कोरकाणि"<br><b>उल्लेखाः - </b>माघ० ७-२६<br><br>कोरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ತಕ್ಕೋಲವೃಕ್ಷದ ಪರಿಮಳ ದ್ರವ್ಯ<br><br>कोरक<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೃಣಾಲ /ತಾವರೆಯ ದಂಟು<br><b>विस्तारः - </b>"कोरकोऽस्त्री कुड्मले स्यात् कक्कोलकमृणालयोः" - मेदि० ।<br><br>

कोरकित
कोरकित<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಮೊಗ್ಗು ಬಿಟ್ಟಿರುವ /ಮೊಗ್ಗು ಕಾಣಿಸಿಕೊಂಡಿರುವ<br><b>निष्पत्तिः - </b>"इतच्" (५-२-३६)<br><b>व्युत्पत्तिः - </b>कोरका अस्य सञ्जाताः<br><b>प्रयोगाः - </b>"यस्ते नवः पल्लवितः कराभ्यां स्मितेन यः कोरकितस्तवास्ते"<br><b>उल्लेखाः - </b>नैष० ३-१२१<br><br>

कोरङ्गी
कोरङ्गी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಸಣ್ಣ ಜಾತಿಯ ಯಾಲಕ್ಕಿ<br><b>विस्तारः - </b>"सूक्ष्मोपकुञ्चिका तुत्था कोरङ्गी त्रिपुटा त्रुटिः" - अम० ।<br><br>कोरङ्गी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಪ್ಪಲಿ<br><br>

कोरदूष
कोरदूष<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಹಾರಕ ಧಾನ್ಯ<br><b>निष्पत्तिः - </b>दुष (वैकृत्ये) + णिच् - "अण्" (३-२-१)<br><b>व्युत्पत्तिः - </b>कोरं दूषयति<br><b>प्रयोगाः - </b>"सकोरदूषः श्यामकः कषायमधुरो लघुः । वातलः कफपित्तघ्नः शीतसङ्ग्राहिशोषणः ॥"<br><b>उल्लेखाः - </b>चरक० सूत्र० २७-१५<br><br>

कोल
कोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವರಾಹ /ಹಂದಿ<br><b>निष्पत्तिः - </b>कुल (संस्त्याने) - "अच्" (३-१-१३४) ।<br><b>प्रयोगाः - </b>"कोले घृतघटो देय उष्ट्रे गुञ्जा हर्येऽशुकम्"<br><b>उल्लेखाः - </b>याज्ञ० ३-२७३<br><br>कोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೆಪ್ಪ /ಹರಿಗೋಲು<br><br>कोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಎದೆ /ಭುಜಗಳ ಮಧ್ಯಭಾಗ<br><br>कोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಶನಿಗ್ರಹ<br><br>कोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಆಲಿಂಗನ<br><br>कोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಚಿತ್ರಮೂಲದ ಗಿಡ<br><br>कोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತೊಡೆ /ಮಡಿಲು<br><br>कोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಬೆಸ್ತರ ಜಾತಿಯ ಕನ್ಯೆಯಲ್ಲಿ ಹುಟ್ಟಿದ ಒಬ್ಬ ಬೆರಕೆ ಜಾತಿಯವನು<br><br>कोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಬ್ಬ ದೊರೆ<br><br>कोल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ದೇಶ<br><b>प्रयोगाः - </b>"करुत्थमादथाक्रीडश्चत्वारस्तस्य चात्मजाः । पाण्ड्यश्च केरलश्चैव कोलश्चोलश्च पार्थिवः । तेषां जनपदाः स्फीताः पाण्ड्याः कोलाः सकेरलाः ॥"<br><b>उल्लेखाः - </b>हरिवं०<br><b>विस्तारः - </b>बहुवचनान्तं रूपम् ।<br><br>कोल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಎಲಚಿ ಹಣ್ಣು<br><b>निष्पत्तिः - </b>"अण्" (४-३-१३५) ।<br><b>व्युत्पत्तिः - </b>कोल्याः फलम्<br><br>कोल<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೆಣಸು<br><br>

कोला
कोला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಪ್ಪಲಿ<br><br>कोला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಚವ್ಯ<br><b>विस्तारः - </b>"कोलं कोलिफले क्लीबं पिप्पलीचव्ययोः स्त्रियाम् । नाऽङ्कपालौ शनौ चित्रे वराहोत्सङ्गभेलके" - मेदि० ।<br><br>कोला<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>कोल ಪದದ ಅರ್ಥ<br><br>

कोलक
कोलक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಸುಗಂಧದ್ರವ್ಯ<br><br>कोलक<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೆಣಸು<br><br>

कोलकर्कटिका
कोलकर्कटिका<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಖರ್ಜೂರ<br><b>व्युत्पत्तिः - </b>कोल इव कर्कटिका<br><br>

कोलकर्कटी
कोलकर्कटी<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಒಂದು ಜಾತಿಯ ಖರ್ಜೂರ<br><br>

कोलकुण
कोलकुण<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಮತ್ಕುಣ /ತಿಗಣೆ<br><br>

कोलपुच्छ
कोलपुच्छ<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ರಣಹದ್ದು<br><b>व्युत्पत्तिः - </b>कोलस्येव पुच्छोऽस्य<br><br>

कोलम्बक
कोलम्बक<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ವೀಣೆಯ ಮೈ /ತಂತಿಯಿಲ್ಲದ ವೀಣೆಯ ಶರೀರ /ತಂತಿಯಿಲ್ಲದ ವೀಣಾದಂಡ ಬುರುಡೆ ಮತ್ತು ಕಿವಿಗಳು<br><b>निष्पत्तिः - </b>कुल (संस्त्याने) - "अम्बच्" बाहु० ।<br><b>विस्तारः - </b>"कोलम्बकस्तु कायोऽस्याः" - अम० ।<br><br>

कोलवल्ली
कोलवल्ली<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಗಜ ಹಿಪ್ಪಲಿ<br><br>

कोलापुर
कोलापुर<br><br><b>पदविभागः - </b>नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮಹಾಲಕ್ಷ್ಮಿಯ ವಾಸಸ್ಥಾನವಾದ ಒಂದು ಪಟ್ಟಣ<br><br>

कोलाहल
कोलाहल<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಗುಂಪಿನ ಗಲಭೆ /ಗದ್ದಲ<br><b>निष्पत्तिः - </b>आ + हल (विलेखने) - "अच्" (३-१-१३४)<br><b>व्युत्पत्तिः - </b>कोलमाहलति<br><b>प्रयोगाः - </b>"कोलाहलेनोच्चलतां दिवौकसां महाचमूनां गुरुभिर्ध्वजव्रजैः"<br><b>उल्लेखाः - </b>कुमा० १४-१६<br><br>

कोलाहलिन्
कोलाहलिन्<br><br><b>पदविभागः - </b>विशेष्यनिघ्नम्<br><b>कन्नडार्थः - </b>ಗುಂಪಿನ ಗಲಭೆಯಿಂದ ಕೂಡಿದ /ಗದ್ದಲದಿಂದ ಕೂಡಿದ<br><b>निष्पत्तिः - </b>"इनिः" (५-२-११५)<br><b>व्युत्पत्तिः - </b>कोलाहलोऽस्यास्ति<br><br>

कोलि|कोली
कोलि (ली)<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಎಲಚಿ ಮರ /ಬೋರೆ ಗಿಡ<br><b>निष्पत्तिः - </b>कुल (संस्त्याने) - "इन्" (उ० ४-११७) । वा "ङीप्" (ग० ४-१-४५)<br><br>

कोल्या
कोल्या<br><br><b>पदविभागः - </b>स्त्रीलिङ्गः<br><b>कन्नडार्थः - </b>ಹಿಪ್ಪಲಿ<br><b>निष्पत्तिः - </b>"यत्" (५-१-६६)<br><b>व्युत्पत्तिः - </b>कोल्मर्हति<br><br>

कोल्ल|कोल्लक
कोल्ल (क)<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ದಕ್ಷಿಣಭಾರತದಲ್ಲಿ ಇರುವ ಒಂದು ಪರ್ವತ<br><b>प्रयोगाः - </b>"कर्णाटकमहाटविचित्रकूटनासिककोल्लगिरिचोलाः" । "ऋषभः कूटकः कोल्लकः सह्यो देवगिरिः" ।<br><b>उल्लेखाः - </b>२) भाग० ५-१९-१६<br><br>

कोविद
कोविद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಪಂಡಿತ /ವಿದ್ವಾಂಸ<br><b>निष्पत्तिः - </b>विद (ज्ञाने) - "कः" (३-१-१३५)<br><b>व्युत्पत्तिः - </b>कौर्वेदः, तं वेत्ति<br><b>प्रयोगाः - </b>"श्रौतमार्गसुखगानकोविदब्रह्मषट्चरणगर्भमुज्ज्वलम्" ।<br><b>उल्लेखाः - </b>माघ० १४-६९<br><br>कोविद<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ತಿಳಿದವನು /ಬಲ್ಲವನು<br><b>प्रयोगाः - </b>"आत्मनैव गुणदोषकोविदः किं न वेत्सि करणीयवस्तुषु"<br><b>उल्लेखाः - </b>माघ० १४-५४<br><br>

कोविदार
कोविदार<br><br><b>पदविभागः - </b>पुल्लिङ्गः<br><b>कन्नडार्थः - </b>ಕೆಂಗಾಂಚಾಳದ ಗಿಡ<br><b>निष्पत्तिः - </b>वि + दॄ (विदारणे) - "अण्" (३-२-१) पृषो० ।<br><b>व्युत्पत्तिः - </b>कुं भूमिं विदृणाति<br><b>प्रयोगाः - </b>"कोविदारकलिकाऽतिकोमला तक्रसिद्धतिलतैलपाचिता"<br><b>उल्लेखाः - </b>पाकशास्त्रम्<br><br>

कोश|कोष
कोश (ष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಅಂಡ /ಮೊಟ್ಟೆ<br><b>निष्पत्तिः - </b>कुष (निष्कर्षे) - "घञ्" (३-३-१९)<br><b>व्युत्पत्तिः - </b>कुष्यति निष्क्रामत्यस्मात्<br><br>कोश (ष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪಾನಪಾತ್ರೆ /ಕುಡಿಯುವ ಪಾತ್ರೆ<br><br>कोश (ष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕತ್ತಿಯ ಒರೆ<br><br>कोश (ष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮುಚ್ಚಳ<br><br>कोश (ष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಬ್ದಕೋಶ /ಅಮರ ಮೊದಲಾದ ನಿಘಂಟು<br><br>कोश (ष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಖಜಾನೆ /ಬೊಕ್ಕಸ /ಧನರಾಶಿ<br><b>प्रयोगाः - </b>"तमध्वरे विश्वजिति क्षितीशं निःशेषविश्राणितकोशजातम्"<br><b>उल्लेखाः - </b>रघु० ५-१<br><br>कोश (ष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಸಮೂಹ<br><br>कोश (ष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕಾಯಿ ಧಾನ್ಯ ಮೊದಲಾದುವುಗಳ ಸಿಪ್ಪೆ<br><br>कोश (ष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಕುಡ್ಮಲ /ಮೊಗ್ಗು<br><b>प्रयोगाः - </b>"आसारसिक्तक्षितिबाष्पयोगात् मामक्षिणोद्यत्र विभिन्नकोशैः"<br><b>उल्लेखाः - </b>रघु० १३-२९<br><br>कोश (ष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಹಲಸು ತೆಂಗು ಮೊದಲಾದುವುಗಳ ಒಳಭಾಗ<br><br>कोश (ष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಮೋಡ /ಮೇಘ<br><br>कोश (ष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ವೇದಾಂತಿಗಳ ಮತದಲ್ಲಿ ಜೀವನಿಗೆ ಆವರಣವಾಗಿರುವ ೧)ಅನ್ನಮಯ ೨)ಪ್ರಾಣಮಯ ೩)ಮನೋಮಯ ೪)ವಿಜ್ಞಾನಮಯ ೫)ಆನಂದಮಯಗಳೆಂಬ ೫ ಕೋಶಗಳು<br><br>कोश (ष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೋಳ/ವರ್ತುಲ /ಗುಂಡು<br><br>कोश (ष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಯೋನಿ /ಸ್ತ್ರೀಯರ ಜನನೇಂದ್ರಿಯ<br><br>कोश (ष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಜಾಯಿಕಾಯಿ<br><b>विस्तारः - </b>"कोशः कोष इवाण्डके । कुड्मले चषके दिव्येऽर्थचये योनिशिम्बयोः । जातीकोषेऽसिपिधाने" - हेम० ।<br><br>कोश (ष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಶಾಸ್ತ್ರ<br><br>कोश (ष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗೃಹ /ಮನೆ /ವಾಸಸ್ಥಳ<br><br>कोश (ष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪುಸ್ತಕಗಳ ರಾಶಿ<br><br>कोश (ष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ದೇಹ /ಶರೀರ<br><b>विस्तारः - </b>"कोशोऽस्त्री कुड्मलेऽर्थौघे गुह्येऽङ्गे शास्त्रदिव्ययोः । गृहे देहे पुस्तकौघे पेश्यामसिपिधानके" - नानार्थर० ।<br><br>कोश (ष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ರೇಷ್ಮೆ ಹುಳುವಿನ ಗೂಡು<br><br>कोश (ष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಗರ್ಭಕೋಶ<br><br>कोश (ष)<br><br><b>पदविभागः - </b>पुल्लिङ्गः / नपुंसकलिङ्गः<br><b>कन्नडार्थः - </b>ಪರಸ್ಪರ ಸಂಬಂಧವಿಲ್ಲದ ಅನೇಕ ಶ್ಲೋಕಗಳ ಸಮುದಾಯ<br><br>

