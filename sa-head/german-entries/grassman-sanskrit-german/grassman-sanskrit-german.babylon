नमस्
námas, n., Verbeugung [von nam], Ehrerweisung, Verehrung, Anbetung; vgl. die Adj.: ugrá, bṛhát, máhi.<BR>-as {65,1}; {227,6}; {285,4}; {317,5}; {319,4}; {403,5}; {830,7}; {918,4}; mit astu {841,2}; {991,4}; astu zu ergänzen {27,13}; {267,8}; {401,7}; {492,8}; {516,15}; {552,5}; {681,15}; {840,15}; mit vac {51,15}; {114,11}; {136,6}; {212,2}; {219,8}; {427,10}; {693,5}; mit gir (gṛṇanti) {684,10}; mit bhṛ {1,7}; {779,29}; {886,1}; prá bhṛ {62,2}; {136,1}; sapary {288,3}; {863,1}; mit kṛ {860,8}; {894,12}; {911,17}; dāś {71,6}; yam {340,3}; mit ā́ īr {610,4}. — námas námas (erg. astu vas) {941,9}.<BR>-asā {57,3}; {62,11}; {63,9}; {84,12}; {114,2}. _{114,5}; {128,2}; {152,7}; {158,2}; {171,1}. _{171,2}; {185,7}; {186,4}; {214,13}; {221,11}; {225,14}; {226,12}; {235,2}; {236,14}; {237,8}; {248,5}; {265,5}. _{265,19}; {266,7}; {293,5}; {295,5}; {301,11}; {303,7}; {315,6}; {330,6}; {346,6}; {355,12}; {358,9}; {362,4}; {366,6}; {394,8}; {395,16}; {397,2}. _{397,6}. _{397,14}; {403,2}; {437,1}; {442,4}. _{442,6}; {452,4}. _{452,5}; {456,8}; {457,46}; {492,8}; {493,17}; {508,2}. _{508,3}; {510,6}; {518,4}; {528,1}; {532,1}; {560,2}; {599,8}; {602,4}; {607,1}; {609,7}; {613,3}; {639,5}; {641,6}; {643,22}. _{643,26}; {663,12}; {666,17}; {680,10}; {681,10}; {705,12}; {723,6}; {801,5}; {857,2}; {873,6}; {887,26}; {889,5}; {895,12}; {896,2}; {905,2}; {911,21}. _{911,22}; {918,9}; {1018,6}.<BR>-ase {645,7}.<BR>-asas [G.] vṛdhā́sas {171,2}; údyatim {190,3}; padé {643,9}.<BR>-asi {317,5}.<BR>-obhis {24,14}; {27,1}; {77,2}; {153,1}; {194,5}; {224,4}. _{224,8}; {229,9}; {238,3}; {259,3}; {338,9}; {354,2}; {355,7}; {382,1}; {395,2}. _{395,8}; {396,11}; {414,1}; {442,9}. _{442,10}; [<a href="https://dub.sh/cslp?dict=GRA&page=712" target="_blank">Page712</a>] {491,1}; {492,9}; {501,3}; {523,1}; {524,1}; {549,13}; {550,14}; {558,3}; {559,1}; {569,1}; {577,6}; {579,5}; {600,1}; {611,5}; {639,13}; {642,3}. _{642,13}; {671,5}; {705,6}; {728,5}; {808,2}; {832,5}; {839,1}; {872,2}. _{872,4}.<B